# OpenAI chat completion via raw HTTP call
#
# RustCsgModelChat sends a chat completion request to the OpenAI API
# using the C-provider HTTP POST, and returns the assistant response.

import std/rawmem_support
import std/system
import cheng/codex/protocol/wire as wire

@importc("driver_c_new_string")
fn chat_driver_c_new_string(size: int32): ptr

@importc("ptr_add")
fn chat_ptr_add(p: ptr, off: int32): ptr

fn chatLen(s: str): int32 =
    if s.data == nil:
        return 0
    if s.len <= 0:
        return 0
    return s.len

fn chatNewStringAlloc(count: int32): str =
    var out: str
    if count <= 0:
        return out
    let raw: ptr = chat_driver_c_new_string(count)
    if raw != nil:
        out.data = raw
        out.len = count
        out.flags = 1
    return out

fn chatSlice(s: str, start: int32, count: int32): str =
    var out: str
    let n: int32 = chatLen(s)
    var start0: int32 = start
    if count <= 0 || n <= 0:
        return out
    if start0 < 0:
        start0 = 0
    if start0 >= n:
        return out
    var kept: int32 = count
    if start0 + kept > n:
        kept = n - start0
    if kept <= 0:
        return out
    out.data = chat_ptr_add(s.data, start0)
    out.len = kept
    out.store_id = s.store_id
    return out

fn chatCat(a: str, b: str): str =
    let leftLen: int32 = chatLen(a)
    let rightLen: int32 = chatLen(b)
    let total: int32 = leftLen + rightLen
    if total <= 0:
        return ""
    let out: str = chatNewStringAlloc(total)
    let raw: ptr = out.data
    if raw == nil:
        return ""
    if leftLen > 0:
        rawmem_support.RawmemCopy(raw, a.data, leftLen)
    if rightLen > 0:
        rawmem_support.RawmemCopy(chat_ptr_add(raw, leftLen), b.data, rightLen)
    rawmem_support.RawmemWriteI8(raw, total, Int8(0))
    return out

fn chatHasPrefix(s: str, prefix: str): bool =
    let n: int32 = chatLen(s)
    let m: int32 = chatLen(prefix)
    if m == 0:
        return true
    if n < m:
        return false
    var i: int32
    while i < m:
        if s[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn chatCat3(a: str, b: str, c: str): str =
    return chatCat(chatCat(a, b), c)

fn chatCat4(a: str, b: str, c: str, d: str): str =
    return chatCat(chatCat3(a, b, c), d)

fn chatPositiveIntToStr(value: int32): str =
    if value == 0:
        return "0"
    let digits = "0123456789"
    var n: int32 = value
    var divisor: int32 = 1000000000
    var started: bool
    var out: str
    while divisor > 0:
        let digit: int32 = n / divisor
        if digit > 0 || started:
            out = chatCat(out, chatSlice(digits, digit, 1))
            started = true
        n = n % divisor
        divisor = divisor / 10
    return out

fn chatIntToStr(value: int32): str =
    if value < 0:
        return chatCat("-", chatPositiveIntToStr(0 - value))
    return chatPositiveIntToStr(value)

# ── Chat response model ──────────────────────────────────────────────────

type
    ChatResponse =
        ok: bool
        content: str
        finishReason: str
        error: str

fn NewChatResponse(): ChatResponse =
    var response: ChatResponse
    return response

# ── JSON message builders ────────────────────────────────────────────────

fn BuildSystemMessage(content: str): str =
    return chatCat3("{\"role\":\"system\",\"content\":", wire.RustCsgJsonQuote(content), "}")

fn BuildUserMessage(content: str): str =
    return chatCat3("{\"role\":\"user\",\"content\":", wire.RustCsgJsonQuote(content), "}")

fn BuildToolMessage(content: str, toolCallId: str): str =
    var out = "{\"role\":\"tool\",\"tool_call_id\":"
    out = chatCat(out, wire.RustCsgJsonQuote(toolCallId))
    out = chatCat(out, ",\"content\":")
    out = chatCat(out, wire.RustCsgJsonQuote(content))
    return chatCat(out, "}")

fn BuildTool(name: str, description: str, params: str): str =
    var out = "{\"type\":\"function\",\"function\":{\"name\":"
    out = chatCat(out, wire.RustCsgJsonQuote(name))
    out = chatCat(out, ",\"description\":")
    out = chatCat(out, wire.RustCsgJsonQuote(description))
    out = chatCat4(out, ",\"parameters\":", params, "}}")
    return out

fn BuildToolsArray(count: int32, t0: str, t1: str, t2: str, t3: str): str =
    var out = "["
    if count >= 1: out = chatCat(out, t0)
    if count >= 2: out = chatCat3(out, ",", t1)
    if count >= 3: out = chatCat3(out, ",", t2)
    if count >= 4: out = chatCat3(out, ",", t3)
    return chatCat(out, "]")

fn BuildMessagesArray(count: int32, m0: str, m1: str, m2: str, m3: str, m4: str, m5: str, m6: str, m7: str): str =
    var out = "["
    if count >= 1: out = chatCat(out, m0)
    if count >= 2: out = chatCat3(out, ",", m1)
    if count >= 3: out = chatCat3(out, ",", m2)
    if count >= 4: out = chatCat3(out, ",", m3)
    if count >= 5: out = chatCat3(out, ",", m4)
    if count >= 6: out = chatCat3(out, ",", m5)
    if count >= 7: out = chatCat3(out, ",", m6)
    if count >= 8: out = chatCat3(out, ",", m7)
    return chatCat(out, "]")

fn BuildChatRequestBody(model: str, messages: str, tools: str, stream: bool, maxTokens: int32, temperature: str): str =
    var body = chatCat3("{\"model\":", wire.RustCsgJsonQuote(model), ",\"messages\":")
    body = chatCat(body, messages)
    if tools != "":
        body = chatCat3(body, ",\"tools\":", tools)
    if stream:
        body = chatCat(body, ",\"stream\":true")
    else:
        body = chatCat(body, ",\"stream\":false")
    if maxTokens > 0:
        body = chatCat3(body, ",\"max_tokens\":", chatIntToStr(maxTokens))
    if temperature != "":
        body = chatCat3(body, ",\"temperature\":", temperature)
    return chatCat(body, "}")

fn BuildGlmChatRequestBody(model: str,
                            messages: str,
                            tools: str,
                            stream: bool,
                            toolStream: bool,
                            maxTokens: int32,
                            temperature: str,
                            thinkingEnabled: bool,
                            reasoningEffort: str,
                            jsonMode: bool): str =
    var body = chatCat3("{\"model\":", wire.RustCsgJsonQuote(model), ",\"messages\":")
    body = chatCat(body, messages)
    if tools != "":
        body = chatCat3(body, ",\"tools\":", tools)
    if stream:
        body = chatCat(body, ",\"stream\":true")
    else:
        body = chatCat(body, ",\"stream\":false")
    if toolStream:
        body = chatCat(body, ",\"tool_stream\":true")
    if maxTokens > 0:
        body = chatCat3(body, ",\"max_tokens\":", chatIntToStr(maxTokens))
    if temperature != "":
        body = chatCat3(body, ",\"temperature\":", temperature)
    if thinkingEnabled:
        body = chatCat(body, ",\"thinking\":{\"type\":\"enabled\"}")
    if reasoningEffort != "":
        body = chatCat3(body, ",\"reasoning_effort\":", wire.RustCsgJsonQuote(reasoningEffort))
    if jsonMode:
        body = chatCat(body, ",\"response_format\":{\"type\":\"json_object\"}")
    return chatCat(body, "}")

fn BuildAnthropicMessagesRequestBody(model: str,
                                      systemPrompt: str,
                                      messages: str,
                                      tools: str,
                                      stream: bool,
                                      maxTokens: int32,
                                      thinkingEnabled: bool,
                                      reasoningEffort: str): str =
    var body = chatCat3("{\"model\":", wire.RustCsgJsonQuote(model), ",\"max_tokens\":")
    if maxTokens > 0:
        body = chatCat(body, chatIntToStr(maxTokens))
    else:
        body = chatCat(body, "131072")
    if systemPrompt != "":
        body = chatCat3(body, ",\"system\":", wire.RustCsgJsonQuote(systemPrompt))
    body = chatCat3(body, ",\"messages\":", messages)
    if tools != "":
        body = chatCat3(body, ",\"tools\":", tools)
    if stream:
        body = chatCat(body, ",\"stream\":true")
    if thinkingEnabled:
        body = chatCat(body, ",\"thinking\":{\"type\":\"enabled\"}")
    if reasoningEffort != "":
        body = chatCat3(body, ",\"reasoning_effort\":", wire.RustCsgJsonQuote(reasoningEffort))
    return chatCat(body, "}")

fn ParseChatResponse(json: str): ChatResponse =
    var response: ChatResponse = NewChatResponse()
    if json == "":
        response.error = "empty chat response"
        return response

    let errObj: str = wire.RustCsgJsonFindOptionalObject(json, "error")
    if errObj != "":
        response.error = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if response.error == "":
            response.error = "chat response contains error"
        return response

    response.content = wire.RustCsgJsonFindOptionalStr(json, "content")
    response.finishReason = wire.RustCsgJsonFindOptionalStr(json, "finish_reason")
    if response.content == "":
        response.error = "missing content in chat response"
        return response

    response.ok = true
    return response

@importc("cheng_http_post")
fn rawHttpPostAbi(url: cstring, body: cstring, headers: cstring): cstring

@importc("strlen")
fn modelChatCStringLen(raw: ptr): int64

@importc("calloc")
fn modelChatCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn modelChatMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn modelChatFree(raw: ptr)

fn modelChatCString(text: str): cstring =
    let raw = modelChatCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        modelChatMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn modelChatFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        modelChatFree(ptr(raw))

fn modelChatCStringToStr(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    let count = int32(modelChatCStringLen(ptr(raw)))
    if count <= 0:
        modelChatFreeCString(raw)
        return ""
    let out = system.StrFromBytesCopy(ptr(raw), count)
    modelChatFreeCString(raw)
    return out

fn rawHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = modelChatCString(url)
    let bodyRaw = modelChatCString(body)
    let headersRaw = modelChatCString(headers)
    let outRaw = rawHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    modelChatFreeCString(urlRaw)
    modelChatFreeCString(bodyRaw)
    modelChatFreeCString(headersRaw)
    return modelChatCStringToStr(outRaw)

# Extract HTTP status from C provider JSON response: {"status":200,...} or {"error":"..."}
fn parseHttpStatus(json: str): int32 =
    if json == "":
        return 0
    if chatHasPrefix(json, "{\"error\":"):
        return 0
    if chatHasPrefix(json, "{\"status\":"):
        var i: int32 = 10
        var code: int32
        let n: int32 = chatLen(json)
        while i < n:
            let cv: int32 = int32(json[i])
            if cv >= 48 && cv <= 57:
                code = code * 10 + (cv - 48)
                i = i + 1
            else:
                break
        return code
    return 0

fn RustCsgModelChatWithUrl(model: str, messagesJson: str, apiKey: str, apiUrl: str, outResponse: var str, outError: var str) =
    var url: str = apiUrl
    if url == "":
        url = "https://api.openai.com/v1/chat/completions"
    let body: str = BuildChatRequestBody(model, messagesJson, "", false, 0, "")
    let headers: str = chatCat(chatCat(
        "[\"Content-Type: application/json\",\"Authorization: Bearer ", apiKey), "\"]")

    # Send HTTP POST to OpenAI
    let raw: str = rawHttpPost(url, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    # Check HTTP status
    let status: int32 = parseHttpStatus(raw)
    if status != 200:
        # Transport error from C provider: {"error":"..."}
        let cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        # API error from response body
        let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if respBody != "":
            let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    # Extract response body (JSON string)
    let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    # Check for API-level error object
    let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
    if errObj != "":
        outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = "API returned error object"
        return

    # Extract content from choices[0].message.content
    outResponse = wire.RustCsgJsonFindOptionalStr(respBody, "content")
    if outResponse == "":
        outError = "missing content in response"

fn RustCsgModelGlmChatWithUrl(model: str,
                               messagesJson: str,
                               apiKey: str,
                               apiUrl: str,
                               thinkingEnabled: bool,
                               reasoningEffort: str,
                               maxTokens: int32,
                               jsonMode: bool,
                               outResponse: var str,
                               outError: var str) =
    var url: str = apiUrl
    if url == "":
        url = "https://api.z.ai/api/coding/paas/v4/chat/completions"
    let body: str = BuildGlmChatRequestBody(model, messagesJson, "", false, false, maxTokens, "1.0", thinkingEnabled, reasoningEffort, jsonMode)
    let headers: str = chatCat(chatCat(
        "[\"Content-Type: application/json\",\"Authorization: Bearer ", apiKey), "\"]")

    let raw: str = rawHttpPost(url, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    let status: int32 = parseHttpStatus(raw)
    if status != 200:
        let cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if respBody != "":
            let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
    if errObj != "":
        outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = "API returned error object"
        return

    outResponse = wire.RustCsgJsonFindOptionalStr(respBody, "content")
    if outResponse == "":
        outError = "missing content in GLM response"

fn RustCsgModelAnthropicMessagesWithUrl(model: str,
                                         systemPrompt: str,
                                         messagesJson: str,
                                         apiKey: str,
                                         apiUrl: str,
                                         maxTokens: int32,
                                         thinkingEnabled: bool,
                                         reasoningEffort: str,
                                         outResponse: var str,
                                         outError: var str) =
    var url: str = apiUrl
    if url == "":
        url = "https://api.z.ai/api/anthropic/v1/messages"
    let body: str = BuildAnthropicMessagesRequestBody(model, systemPrompt, messagesJson, "", false, maxTokens, thinkingEnabled, reasoningEffort)
    var headers: str = "[\"Content-Type: application/json\",\"anthropic-version: 2023-06-01\",\"Authorization: Bearer "
    headers = chatCat(headers, apiKey)
    headers = chatCat(headers, "\",\"x-api-key: ")
    headers = chatCat(headers, apiKey)
    headers = chatCat(headers, "\"]")

    let raw: str = rawHttpPost(url, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    let status: int32 = parseHttpStatus(raw)
    if status != 200:
        let cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if respBody != "":
            let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    let respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    let errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
    if errObj != "":
        outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = "API returned error object"
        return

    outResponse = wire.RustCsgJsonFindOptionalStr(respBody, "text")
    if outResponse == "":
        outError = "missing text in Anthropic Messages response"

# ── Stream chat completion ──────────────────────────────────────────
#
# Sends a chat completion request with "stream":true.  Because the C
# HTTP provider (libcurl) returns the complete response, we buffer the
# full SSE payload and parse it line by line to aggregate all delta
# content into a single response string.
#
# apiUrl: full URL like "https://api.openai.com/v1/chat/completions"
#         if empty, defaults to OpenAI.
#
fn RustCsgModelChatStream(model: str, messagesJson: str, apiKey: str, apiUrl: str, outResponse: var str, outError: var str) =
    var effectiveUrl: str = apiUrl
    if effectiveUrl == "":
        effectiveUrl = "https://api.openai.com/v1/chat/completions"

    var body: str = BuildChatRequestBody(model, messagesJson, "", true, 0, "")

    var headers: str = chatCat("[\"Content-Type: application/json\",\"Authorization: Bearer ", apiKey)
    headers = chatCat(headers, "\"]")

    var raw: str = rawHttpPost(effectiveUrl, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    var status: int32 = parseHttpStatus(raw)
    if status != 200:
        var cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        var errBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if errBody != "":
            var errObj: str = wire.RustCsgJsonFindOptionalObject(errBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    var respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    var fullContent: str
    var lineStart: int32
    var i: int32
    while i <= chatLen(respBody):
        if i == chatLen(respBody) || respBody[i] == '\n':
            if i > lineStart:
                var line: str = chatSlice(respBody, lineStart, i - lineStart)
                if chatLen(line) >= 6:
                    if line[0] == 'd' && line[1] == 'a' && line[2] == 't' && line[3] == 'a' && line[4] == ':' && line[5] == ' ':
                        var payload: str = chatSlice(line, 6, chatLen(line) - 6)
                        if payload != "[DONE]":
                            var content: str = wire.RustCsgJsonFindOptionalStr(payload, "content")
                            if content != "":
                                fullContent = chatCat(fullContent, content)
            lineStart = i + 1
        i = i + 1

    if fullContent == "":
        var errObj: str = wire.RustCsgJsonFindOptionalObject(respBody, "error")
        if errObj != "":
            outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
            if outError == "":
                outError = "API returned error in stream response"
            return
        outResponse = ""
        return

    outResponse = fullContent

fn RustCsgModelGlmChatStream(model: str,
                              messagesJson: str,
                              apiKey: str,
                              apiUrl: str,
                              thinkingEnabled: bool,
                              reasoningEffort: str,
                              toolStream: bool,
                              maxTokens: int32,
                              outResponse: var str,
                              outError: var str) =
    var effectiveUrl: str = apiUrl
    if effectiveUrl == "":
        effectiveUrl = "https://api.z.ai/api/coding/paas/v4/chat/completions"

    let body: str = BuildGlmChatRequestBody(model, messagesJson, "", true, toolStream, maxTokens, "1.0", thinkingEnabled, reasoningEffort, false)
    var headers: str = chatCat("[\"Content-Type: application/json\",\"Authorization: Bearer ", apiKey)
    headers = chatCat(headers, "\"]")

    var raw: str = rawHttpPost(effectiveUrl, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    var status: int32 = parseHttpStatus(raw)
    if status != 200:
        var cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        var errBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if errBody != "":
            var errObj: str = wire.RustCsgJsonFindOptionalObject(errBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    var respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    var fullContent: str
    var lineStart: int32
    var i: int32
    while i <= chatLen(respBody):
        if i == chatLen(respBody) || respBody[i] == '\n':
            if i > lineStart:
                var line: str = chatSlice(respBody, lineStart, i - lineStart)
                if chatLen(line) >= 6:
                    if line[0] == 'd' && line[1] == 'a' && line[2] == 't' && line[3] == 'a' && line[4] == ':' && line[5] == ' ':
                        var payload: str = chatSlice(line, 6, chatLen(line) - 6)
                        if payload != "[DONE]":
                            var content: str = wire.RustCsgJsonFindOptionalStr(payload, "content")
                            if content != "":
                                fullContent = chatCat(fullContent, content)
            lineStart = i + 1
        i = i + 1

    outResponse = fullContent

fn RustCsgModelAnthropicMessagesStreamWithUrl(model: str,
                                               systemPrompt: str,
                                               messagesJson: str,
                                               apiKey: str,
                                               apiUrl: str,
                                               maxTokens: int32,
                                               thinkingEnabled: bool,
                                               reasoningEffort: str,
                                               outResponse: var str,
                                               outError: var str) =
    var effectiveUrl: str = apiUrl
    if effectiveUrl == "":
        effectiveUrl = "https://api.z.ai/api/anthropic/v1/messages"

    let body: str = BuildAnthropicMessagesRequestBody(model, systemPrompt, messagesJson, "", true, maxTokens, thinkingEnabled, reasoningEffort)
    var headers: str = "[\"Content-Type: application/json\",\"anthropic-version: 2023-06-01\",\"Authorization: Bearer "
    headers = chatCat(headers, apiKey)
    headers = chatCat(headers, "\",\"x-api-key: ")
    headers = chatCat(headers, apiKey)
    headers = chatCat(headers, "\"]")

    var raw: str = rawHttpPost(effectiveUrl, body, headers)
    if raw == "":
        outError = "HTTP provider returned empty response"
        return

    var status: int32 = parseHttpStatus(raw)
    if status != 200:
        var cErr: str = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if cErr != "":
            outError = cErr
            return
        var errBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
        if errBody != "":
            var errObj: str = wire.RustCsgJsonFindOptionalObject(errBody, "error")
            if errObj != "":
                outError = wire.RustCsgJsonFindOptionalStr(errObj, "message")
        if outError == "":
            outError = chatCat("HTTP ", chatIntToStr(status))
        return

    var respBody: str = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if respBody == "":
        outError = "empty response body from API"
        return

    var fullContent: str
    var lineStart: int32
    var i: int32
    while i <= chatLen(respBody):
        if i == chatLen(respBody) || respBody[i] == '\n':
            if i > lineStart:
                var line: str = chatSlice(respBody, lineStart, i - lineStart)
                if chatLen(line) >= 6:
                    if line[0] == 'd' && line[1] == 'a' && line[2] == 't' && line[3] == 'a' && line[4] == ':' && line[5] == ' ':
                        var payload: str = chatSlice(line, 6, chatLen(line) - 6)
                        if payload != "[DONE]":
                            var text: str = wire.RustCsgJsonFindOptionalStr(payload, "text")
                            if text != "":
                                fullContent = chatCat(fullContent, text)
            lineStart = i + 1
        i = i + 1

    outResponse = fullContent
