# Sandbox execution layer — connects process execution with sandbox policy.
#
# On macOS: Seatbelt execution is enforced through the process provider's
# dedicated sandbox-exec entry.  A Seatbelt policy without an explicit profile
# is a hard error.
#
# The exec layer provides:
#   - SandboxedExec(command, args, cwd, env, sandboxType) -> ProcessResult
#     which runs a command respecting the given sandbox type.
#   - SandboxedExecValidate(policyType) -> bool
#     which checks whether a given sandbox type can be enforced.

import std/strings
import cheng/codex/std/process
import cheng/codex/crates/sandboxing/sandboxing

# ── Sandbox exec result ─────────────────────────────────────────────────

type SandboxExecResult =
    ok: bool
    pid: int32
    exitCode: int32
    stdout: str
    stderr: str
    error: str

# ── Validate sandbox type for current platform ──────────────────────────
# On macOS, only RustCsgSandboxTypeNone and RustCsgSandboxTypeSeatbelt
# are valid.  Seatbelt is detected but not enforced at this layer.
# Returns true if the policy is acceptable for this platform.

fn SandboxedExecValidate(policyType: int32): bool =
    if policyType == sandboxing.RustCsgSandboxTypeNone:
        return true  # No sandbox is always valid

    # On macOS the platform sandbox is Seatbelt
    let platformType: int32 = sandboxing.RustCsgSandboxingDetectPlatformSandbox()
    if platformType == sandboxing.RustCsgSandboxTypeSeatbelt:
        # Accept Seatbelt policy on macOS
        if policyType == sandboxing.RustCsgSandboxTypeSeatbelt:
            return true

    # Bubblewrap is Linux-only, not available on macOS
    if policyType == sandboxing.RustCsgSandboxTypeBubblewrap:
        return false

    # Landlock is Linux-only
    if policyType == sandboxing.RustCsgSandboxTypeLandlock:
        return false

    # Custom sandboxing requires platform-specific setup
    if policyType == sandboxing.RustCsgSandboxTypeCustom:
        return false

    return false

# ── Execute a command with sandbox policy ───────────────────────────────
fn SandboxedExec(command: str, args: str[], cwd: str, env: str[], policyType: int32): SandboxExecResult =
    if policyType == sandboxing.RustCsgSandboxTypeSeatbelt:
        var result: SandboxExecResult
        result.error = "seatbelt profile required"
        return result
    return SandboxedExecWithSeatbeltProfile(command, args, cwd, env, policyType, "")

fn SandboxedExecWithSeatbeltProfile(command: str, args: str[], cwd: str, env: str[], policyType: int32, profile: str): SandboxExecResult =
    var result: SandboxExecResult

    if policyType == sandboxing.RustCsgSandboxTypeSeatbelt:
        if profile == "":
            result.error = "seatbelt profile required"
            return result
        var seatbeltPr: process.ProcessResult = process.ProcessSpawnSeatbelt(command, args, cwd, env, profile)
        if !seatbeltPr.ok:
            result.error = seatbeltPr.error
            return result
        result.ok = true
        result.pid = seatbeltPr.pid
        result.exitCode = seatbeltPr.exitCode
        result.stdout = seatbeltPr.stdout
        result.stderr = seatbeltPr.stderr
        return result

    # Validate the sandbox policy
    if !SandboxedExecValidate(policyType):
        result.error = "unsupported sandbox type for this platform"
        return result

    var pr: process.ProcessResult = process.ProcessSpawn(command, args, cwd, env)

    if !pr.ok:
        result.error = pr.error
        return result

    result.ok = true
    result.pid = pr.pid
    result.exitCode = pr.exitCode
    result.stdout = pr.stdout
    result.stderr = pr.stderr
    return result

# ── Direct exec (no sandbox policy) ────────────────────────────────────
# Convenience wrapper that uses RustCsgSandboxTypeNone.

fn DirectExec(command: str, args: str[], cwd: str, env: str[]): SandboxExecResult =
    return SandboxedExec(command, args, cwd, env, sandboxing.RustCsgSandboxTypeNone)

# ── Policy to string (for logging/display) ─────────────────────────────

fn SandboxPolicyToStr(policyType: int32): str =
    if policyType == sandboxing.RustCsgSandboxTypeNone:
        return "none"
    elif policyType == sandboxing.RustCsgSandboxTypeBubblewrap:
        return "bubblewrap"
    elif policyType == sandboxing.RustCsgSandboxTypeSeatbelt:
        return "seatbelt"
    elif policyType == sandboxing.RustCsgSandboxTypeLandlock:
        return "landlock"
    elif policyType == sandboxing.RustCsgSandboxTypeCustom:
        return "custom"
    return "unknown"
