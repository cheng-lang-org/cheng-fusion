fn RustCsgAccountLoginCompletedNotificationToJson(notification: types.RustCsgAccountLoginCompletedNotification): str =
    var loginIdJson = notification.loginIdJson
    if loginIdJson == "":
        loginIdJson = "null"
    var errorJson = notification.errorJson
    if errorJson == "":
        errorJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("loginId", loginIdJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgAccountFieldBool("success", notification.success))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", errorJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAccountLoginCompletedNotificationFromJson(text: str): types.RustCsgAccountLoginCompletedNotification =
    var result: types.RustCsgAccountLoginCompletedNotification
    result.loginIdJson = wire.RustCsgJsonFindValueRaw(text, "loginId")
    result.success = wire.RustCsgJsonFindBool(text, "success")
    result.errorJson = wire.RustCsgJsonFindValueRaw(text, "error")
    return result
