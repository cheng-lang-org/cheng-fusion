import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgAccountFieldBool(key: str, value: bool): str =
    if value:
        return wire.RustCsgJsonFieldRaw(key, "true")
    return wire.RustCsgJsonFieldRaw(key, "false")

fn RustCsgGetAccountParamsToJson(params: types.RustCsgGetAccountParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, RustCsgAccountFieldBool("refreshToken", params.tokenMode))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgGetAccountParamsFromJson(text: str): types.RustCsgGetAccountParams =
    var result: types.RustCsgGetAccountParams
    result.tokenMode = wire.RustCsgJsonFindBool(text, "refreshToken")
    return result

fn RustCsgGetAccountResponseToJson(response: types.RustCsgGetAccountResponse): str =
    var accountJson = response.accountJson
    if accountJson == "":
        accountJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("account", accountJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgAccountFieldBool("requiresOpenaiAuth", response.requiresOpenaiAuth))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgGetAccountResponseFromJson(text: str): types.RustCsgGetAccountResponse =
    var result: types.RustCsgGetAccountResponse
    result.accountJson = wire.RustCsgJsonFindValueRaw(text, "account")
    result.requiresOpenaiAuth = wire.RustCsgJsonFindBool(text, "requiresOpenaiAuth")
    return result

fn RustCsgLoginAccountParamsToJson(params: types.RustCsgLoginAccountParams): str =
    assert(params.payloadJson != "", "account/login/start params requires payloadJson")
    wire.RustCsgJsonAssertRawValue(params.payloadJson)
    return params.payloadJson

fn RustCsgLoginAccountParamsFromJson(text: str): types.RustCsgLoginAccountParams =
    wire.RustCsgJsonAssertRawValue(text)
    var result: types.RustCsgLoginAccountParams
    result.payloadJson = text
    return result

fn RustCsgLoginAccountResponseToJson(response: types.RustCsgLoginAccountResponse): str =
    assert(response.payloadJson != "", "account/login/start response requires payloadJson")
    wire.RustCsgJsonAssertRawValue(response.payloadJson)
    return response.payloadJson

fn RustCsgLoginAccountResponseFromJson(text: str): types.RustCsgLoginAccountResponse =
    wire.RustCsgJsonAssertRawValue(text)
    var result: types.RustCsgLoginAccountResponse
    result.payloadJson = text
    return result

