fn RustCsgChatgptAuthTokensRefreshParamsToJson(params: types.RustCsgChatgptAuthTokensRefreshParams): str =
    var previousAccountIdJson = params.previousAccountIdJson
    if previousAccountIdJson == "":
        previousAccountIdJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reason", params.reason))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("previousAccountId", previousAccountIdJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgChatgptAuthTokensRefreshParamsFromJson(text: str): types.RustCsgChatgptAuthTokensRefreshParams =
    var result: types.RustCsgChatgptAuthTokensRefreshParams
    result.reason = wire.RustCsgJsonFindStr(text, "reason")
    result.previousAccountIdJson = wire.RustCsgJsonFindValueRaw(text, "previousAccountId")
    return result

fn RustCsgChatgptAuthTokensRefreshResponseToJson(response: types.RustCsgChatgptAuthTokensRefreshResponse): str =
    var planJson = response.chatgptPlanTypeJson
    if planJson == "":
        planJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("accessToken", response.accessToken))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("chatgptAccountId", response.chatgptAccountId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("chatgptPlanType", planJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgChatgptAuthTokensRefreshResponseFromJson(text: str): types.RustCsgChatgptAuthTokensRefreshResponse =
    var result: types.RustCsgChatgptAuthTokensRefreshResponse
    result.accessToken = wire.RustCsgJsonFindStr(text, "accessToken")
    result.chatgptAccountId = wire.RustCsgJsonFindStr(text, "chatgptAccountId")
    result.chatgptPlanTypeJson = wire.RustCsgJsonFindValueRaw(text, "chatgptPlanType")
    return result

fn RustCsgGetAccountRateLimitsResponseToJson(response: types.RustCsgGetAccountRateLimitsResponse): str =
    assert(response.rateLimitsJson != "", "account rate limit response requires rateLimitsJson")
    var byLimitJson = response.rateLimitsMapJson
    if byLimitJson == "":
        byLimitJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", response.rateLimitsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimitsByLimitId", byLimitJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgGetAccountRateLimitsResponseFromJson(text: str): types.RustCsgGetAccountRateLimitsResponse =
    var result: types.RustCsgGetAccountRateLimitsResponse
    result.rateLimitsJson = wire.RustCsgJsonFindObject(text, "rateLimits")
    result.rateLimitsMapJson = wire.RustCsgJsonFindValueRaw(text, "rateLimitsByLimitId")
    return result

