import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgTurnStartParamsToJson(params: types.RustCsgTurnStartParams): str =
    assert(params.inputJson != "", "turn start params requires inputJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("input", params.inputJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("responsesapiClientMetadata", params.responsesapiClientMetadataJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("additionalContext", params.additionalContextJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("environments", params.environmentsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("cwd", params.cwd))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("runtimeWorkspaceRoots", params.runtimeWorkspaceRootsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("approvalPolicy", params.approvalPolicyJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("approvalsReviewer", params.approvalsReviewer))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("sandboxPolicy", params.sandboxPolicyJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("permissions", params.permissionsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("model", params.model))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("serviceTier", params.serviceTierJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("effort", params.effort))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("summary", params.summary))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("personality", params.personalityJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("outputSchema", params.outputSchemaJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("collaborationMode", params.collaborationModeJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTurnStartParamsFromJson(text: str): types.RustCsgTurnStartParams =
    var result: types.RustCsgTurnStartParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.inputJson = wire.RustCsgJsonFindArray(text, "input")
    result.responsesapiClientMetadataJson = wire.RustCsgJsonFindOptionalObject(text, "responsesapiClientMetadata")
    result.additionalContextJson = wire.RustCsgJsonFindOptionalObject(text, "additionalContext")
    result.environmentsJson = wire.RustCsgJsonFindOptionalArray(text, "environments")
    result.cwd = wire.RustCsgJsonFindOptionalStr(text, "cwd")
    result.runtimeWorkspaceRootsJson = wire.RustCsgJsonFindOptionalArray(text, "runtimeWorkspaceRoots")
    result.approvalPolicyJson = wire.RustCsgJsonFindOptionalValueRaw(text, "approvalPolicy")
    result.approvalsReviewer = wire.RustCsgJsonFindOptionalStr(text, "approvalsReviewer")
    result.sandboxPolicyJson = wire.RustCsgJsonFindOptionalObject(text, "sandboxPolicy")
    result.permissionsJson = wire.RustCsgJsonFindOptionalValueRaw(text, "permissions")
    result.model = wire.RustCsgJsonFindOptionalStr(text, "model")
    result.serviceTierJson = wire.RustCsgJsonFindOptionalValueRaw(text, "serviceTier")
    result.effort = wire.RustCsgJsonFindOptionalStr(text, "effort")
    result.summary = wire.RustCsgJsonFindOptionalStr(text, "summary")
    result.personalityJson = wire.RustCsgJsonFindOptionalValueRaw(text, "personality")
    result.outputSchemaJson = wire.RustCsgJsonFindOptionalValueRaw(text, "outputSchema")
    if result.outputSchemaJson == "null":
        result.outputSchemaJson = ""
    result.collaborationModeJson = wire.RustCsgJsonFindOptionalValueRaw(text, "collaborationMode")
    return result

fn RustCsgTurnStartResponseToJson(response: var types.RustCsgTurnStartResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("turn", wire.RustCsgAppTurnToJson(response.turn)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTurnStartResponseFromJson(text: str): types.RustCsgTurnStartResponse =
    var result: types.RustCsgTurnStartResponse
    result.turn = wire.RustCsgAppTurnFromJson(wire.RustCsgJsonFindObject(text, "turn"))
    return result

fn RustCsgTurnSteerParamsToJson(params: types.RustCsgTurnSteerParams): str =
    assert(params.inputJson != "", "turn steer params requires inputJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("input", params.inputJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("responsesapiClientMetadata", params.responsesapiClientMetadataJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("additionalContext", params.additionalContextJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("expectedTurnId", params.expectedTurnId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTurnSteerParamsFromJson(text: str): types.RustCsgTurnSteerParams =
    var result: types.RustCsgTurnSteerParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.inputJson = wire.RustCsgJsonFindArray(text, "input")
    result.responsesapiClientMetadataJson = wire.RustCsgJsonFindOptionalObject(text, "responsesapiClientMetadata")
    result.additionalContextJson = wire.RustCsgJsonFindOptionalObject(text, "additionalContext")
    result.expectedTurnId = wire.RustCsgJsonFindStr(text, "expectedTurnId")
    return result

fn RustCsgTurnSteerResponseToJson(response: types.RustCsgTurnSteerResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", response.turnId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgTurnSteerResponseFromJson(text: str): types.RustCsgTurnSteerResponse =
    var result: types.RustCsgTurnSteerResponse
    result.turnId = wire.RustCsgJsonFindStr(text, "turnId")
    return result
