import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgThreadReadParamsToJson(params: types.RustCsgThreadReadParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    if params.includeTurns:
        out = wire.RustCsgCat(out, ",\"includeTurns\":true")
    else:
        out = wire.RustCsgCat(out, ",\"includeTurns\":false")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadReadParamsFromJson(text: str): types.RustCsgThreadReadParams =
    var result: types.RustCsgThreadReadParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.includeTurns = wire.RustCsgJsonFindOptionalBool(text, "includeTurns")
    return result

fn RustCsgThreadReadResponseToJson(response: var types.RustCsgThreadReadResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("thread", wire.RustCsgAppThreadToJson(response.thread)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadReadResponseFromJson(text: str): types.RustCsgThreadReadResponse =
    var result: types.RustCsgThreadReadResponse
    result.thread = wire.RustCsgAppThreadFromJson(wire.RustCsgJsonFindObject(text, "thread"))
    return result

fn RustCsgThreadTurnsListParamsToJson(params: types.RustCsgThreadTurnsListParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("cursor", params.cursor))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("limit", params.limitJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("sortDirection", params.sortDirection))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("itemsView", params.itemsViewJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadTurnsListParamsFromJson(text: str): types.RustCsgThreadTurnsListParams =
    var result: types.RustCsgThreadTurnsListParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.cursor = wire.RustCsgJsonFindOptionalStr(text, "cursor")
    result.limitJson = wire.RustCsgJsonFindOptionalValueRaw(text, "limit")
    result.sortDirection = wire.RustCsgJsonFindOptionalStr(text, "sortDirection")
    result.itemsViewJson = wire.RustCsgJsonFindOptionalValueRaw(text, "itemsView")
    return result

fn RustCsgThreadTurnsListResponseToJson(response: var types.RustCsgThreadTurnsListResponse): str =
    var dataJson = response.dataJson
    if dataJson == "":
        dataJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("data", dataJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("nextCursor", response.nextCursor))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("backwardsCursor", response.backwardsCursor))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadTurnsListResponseFromJson(text: str): types.RustCsgThreadTurnsListResponse =
    var result: types.RustCsgThreadTurnsListResponse
    result.dataJson = wire.RustCsgJsonFindArray(text, "data")
    result.nextCursor = wire.RustCsgJsonFindOptionalStr(text, "nextCursor")
    result.backwardsCursor = wire.RustCsgJsonFindOptionalStr(text, "backwardsCursor")
    return result
