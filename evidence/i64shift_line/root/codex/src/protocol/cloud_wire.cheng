import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgCloudNullIfEmpty(value: str): str =
    if value == "":
        return "null"
    return value

fn RustCsgCloudBoolField(key: str, value: bool): str =
    if value:
        return wire.RustCsgJsonFieldRaw(key, "true")
    return wire.RustCsgJsonFieldRaw(key, "false")

fn RustCsgCloudDiffSummaryToJson(summary: types.RustCsgCloudDiffSummary): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("files_changed", summary.filesChanged))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("lines_added", summary.linesAdded))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("lines_removed", summary.linesRemoved))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudDiffSummaryFromJson(text: str): types.RustCsgCloudDiffSummary =
    var result: types.RustCsgCloudDiffSummary
    result.filesChanged = wire.RustCsgJsonFindInt64(text, "files_changed")
    result.linesAdded = wire.RustCsgJsonFindInt64(text, "lines_added")
    result.linesRemoved = wire.RustCsgJsonFindInt64(text, "lines_removed")
    return result

fn RustCsgCloudTaskSummaryToJson(task: types.RustCsgCloudTaskSummary): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", task.id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("title", task.title))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", task.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("updated_at", task.updatedAt))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("environment_id", RustCsgCloudNullIfEmpty(task.environmentIdJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("environment_label", RustCsgCloudNullIfEmpty(task.environmentLabelJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("summary", RustCsgCloudDiffSummaryToJson(task.summary)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgCloudBoolField("is_review", task.isReview))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("attempt_total", RustCsgCloudNullIfEmpty(task.attemptTotalJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudTaskSummaryFromJson(text: str): types.RustCsgCloudTaskSummary =
    var result: types.RustCsgCloudTaskSummary
    result.id = wire.RustCsgJsonFindStr(text, "id")
    result.title = wire.RustCsgJsonFindStr(text, "title")
    result.status = wire.RustCsgJsonFindStr(text, "status")
    result.updatedAt = wire.RustCsgJsonFindStr(text, "updated_at")
    result.environmentIdJson = wire.RustCsgJsonFindValueRaw(text, "environment_id")
    result.environmentLabelJson = wire.RustCsgJsonFindValueRaw(text, "environment_label")
    result.summary = RustCsgCloudDiffSummaryFromJson(wire.RustCsgJsonFindObject(text, "summary"))
    result.isReview = wire.RustCsgJsonFindBool(text, "is_review")
    result.attemptTotalJson = wire.RustCsgJsonFindValueRaw(text, "attempt_total")
    return result

fn RustCsgCloudTaskListPageToJson(page: types.RustCsgCloudTaskListPage): str =
    assert(page.tasksJson != "", "cloud task list page requires tasksJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tasks", page.tasksJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cursor", RustCsgCloudNullIfEmpty(page.cursorJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudTaskListPageFromJson(text: str): types.RustCsgCloudTaskListPage =
    var result: types.RustCsgCloudTaskListPage
    result.tasksJson = wire.RustCsgJsonFindArray(text, "tasks")
    result.cursorJson = wire.RustCsgJsonFindValueRaw(text, "cursor")
    return result

fn RustCsgCloudCreatedTaskToJson(task: types.RustCsgCloudCreatedTask): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", task.id))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudCreatedTaskFromJson(text: str): types.RustCsgCloudCreatedTask =
    var result: types.RustCsgCloudCreatedTask
    result.id = wire.RustCsgJsonFindStr(text, "id")
    return result

fn RustCsgCloudTaskTextToJson(task: types.RustCsgCloudTaskText): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("prompt", RustCsgCloudNullIfEmpty(task.promptJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("messages", task.messages))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("turn_id", RustCsgCloudNullIfEmpty(task.turnIdJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("sibling_turn_ids", task.siblingTurnIds))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("attempt_placement", RustCsgCloudNullIfEmpty(task.attemptPlacementJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("attempt_status", task.attemptStatus))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudTaskTextFromJson(text: str): types.RustCsgCloudTaskText =
    var result: types.RustCsgCloudTaskText
    result.promptJson = wire.RustCsgJsonFindValueRaw(text, "prompt")
    result.messages = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "messages"))
    result.turnIdJson = wire.RustCsgJsonFindValueRaw(text, "turn_id")
    result.siblingTurnIds = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "sibling_turn_ids"))
    result.attemptPlacementJson = wire.RustCsgJsonFindValueRaw(text, "attempt_placement")
    result.attemptStatus = wire.RustCsgJsonFindStr(text, "attempt_status")
    return result

fn RustCsgCloudTurnAttemptToJson(attempt: types.RustCsgCloudTurnAttempt): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", attempt.turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("attempt_placement", RustCsgCloudNullIfEmpty(attempt.attemptPlacementJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("created_at", RustCsgCloudNullIfEmpty(attempt.createdAtJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", attempt.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("diff", RustCsgCloudNullIfEmpty(attempt.diffJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("messages", attempt.messages))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudTurnAttemptFromJson(text: str): types.RustCsgCloudTurnAttempt =
    var result: types.RustCsgCloudTurnAttempt
    result.turnId = wire.RustCsgJsonFindStr(text, "turn_id")
    result.attemptPlacementJson = wire.RustCsgJsonFindValueRaw(text, "attempt_placement")
    result.createdAtJson = wire.RustCsgJsonFindValueRaw(text, "created_at")
    result.status = wire.RustCsgJsonFindStr(text, "status")
    result.diffJson = wire.RustCsgJsonFindValueRaw(text, "diff")
    result.messages = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "messages"))
    return result

fn RustCsgCloudApplyOutcomeToJson(outcome: types.RustCsgCloudApplyOutcome): str =
    var out = "{"
    out = wire.RustCsgCat(out, RustCsgCloudBoolField("applied", outcome.applied))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", outcome.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", outcome.message))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("skipped_paths", outcome.skippedPaths))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("conflict_paths", outcome.conflictPaths))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudApplyOutcomeFromJson(text: str): types.RustCsgCloudApplyOutcome =
    var result: types.RustCsgCloudApplyOutcome
    result.applied = wire.RustCsgJsonFindBool(text, "applied")
    result.status = wire.RustCsgJsonFindStr(text, "status")
    result.message = wire.RustCsgJsonFindStr(text, "message")
    result.skippedPaths = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "skipped_paths"))
    result.conflictPaths = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "conflict_paths"))
    return result

fn RustCsgCloudCreateTaskRequestToJson(request: types.RustCsgCloudCreateTaskRequest): str =
    var out = "{\"new_task\":{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("environment_id", request.environmentId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("branch", request.gitRef))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgCloudBoolField("run_environment_in_qa_mode", request.qaMode))
    out = wire.RustCsgCat(out, "},\"input_items\":[{\"type\":\"message\",\"role\":\"user\",\"content\":[{")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("content_type", "text"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", request.prompt))
    out = wire.RustCsgCat(out, "}]}")
    if request.startingDiffJson != "":
        out = wire.RustCsgCat(out, ",{\"type\":\"pre_apply_patch\",\"output_diff\":")
        out = wire.RustCsgCat(out, request.startingDiffJson)
        out = wire.RustCsgCat(out, "}")
    out = wire.RustCsgCat(out, "]")
    if request.bestOfN > 1:
        out = wire.RustCsgCat(out, ",\"metadata\":{")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("best_of_n", request.bestOfN))
        out = wire.RustCsgCat(out, "}")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCloudCreateTaskRequestFromJson(text: str): types.RustCsgCloudCreateTaskRequest =
    var result: types.RustCsgCloudCreateTaskRequest
    result.environmentId = wire.RustCsgJsonFindStr(text, "environment_id")
    result.gitRef = wire.RustCsgJsonFindStr(text, "branch")
    result.qaMode = wire.RustCsgJsonFindBool(text, "run_environment_in_qa_mode")
    result.prompt = wire.RustCsgJsonFindStr(text, "text")
    result.bestOfN = wire.RustCsgJsonFindInt32(text, "best_of_n")
    if wire.RustCsgContains(text, "\"output_diff\""):
        result.startingDiffJson = wire.RustCsgJsonFindObject(text, "output_diff")
    return result
