fn RustCsgJsonRpcErrorToJson(response: types.RustCsgJsonRpcError): str =
    assert(response.idJson != "", "JSON-RPC error requires idJson")
    var errorJson = "{"
    errorJson = RustCsgCat(errorJson, RustCsgJsonFieldInt64("code", response.code))
    if response.dataJson != "":
        errorJson = RustCsgCat(errorJson, ",")
        errorJson = RustCsgCat(errorJson, RustCsgJsonFieldRaw("data", response.dataJson))
    errorJson = RustCsgCat(errorJson, ",")
    errorJson = RustCsgCat(errorJson, RustCsgJsonFieldStr("message", response.message))
    errorJson = RustCsgCat(errorJson, "}")
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldRaw("error", errorJson))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("id", response.idJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgJsonRpcErrorFromJson(text: str): types.RustCsgJsonRpcError =
    var result: types.RustCsgJsonRpcError
    let errorJson = RustCsgJsonFindObject(text, "error")
    result.code = RustCsgJsonFindInt64(errorJson, "code")
    result.message = RustCsgJsonFindStr(errorJson, "message")
    result.dataJson = RustCsgJsonFindOptionalValueRaw(errorJson, "data")
    result.idJson = RustCsgJsonFindValueRaw(text, "id")
    return result

