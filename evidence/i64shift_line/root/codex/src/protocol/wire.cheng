fn RustCsgThreadLifecycleResponseToJson(response: types.RustCsgThreadLifecycleResponse): str =
    assert(response.approvalPolicyJson != "", "thread lifecycle response requires approvalPolicyJson")
    assert(response.sandboxJson != "", "thread lifecycle response requires sandboxJson")
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldRaw("thread", RustCsgAppThreadToJson(response.thread)))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("model", response.model))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("modelProvider", response.modelProvider))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("serviceTier", response.serviceTier))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("cwd", response.cwd))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStringArray("runtimeWorkspaceRoots", response.runtimeWorkspaceRoots))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStringArray("instructionSources", response.instructionSources))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("approvalPolicy", response.approvalPolicyJson))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("approvalsReviewer", response.approvalsReviewer))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("sandbox", response.sandboxJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("activePermissionProfile", response.activePermissionProfileJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("reasoningEffort", response.reasoningEffort))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgThreadLifecycleResponseFromJson(text: str): types.RustCsgThreadLifecycleResponse =
    var result: types.RustCsgThreadLifecycleResponse
    result.thread = RustCsgAppThreadFromJson(RustCsgJsonFindObject(text, "thread"))
    result.model = RustCsgJsonFindStr(text, "model")
    result.modelProvider = RustCsgJsonFindStr(text, "modelProvider")
    result.serviceTier = RustCsgJsonFindOptionalStr(text, "serviceTier")
    result.cwd = RustCsgJsonFindStr(text, "cwd")
    let runtimeWorkspaceRootsRaw = RustCsgJsonFindOptionalArray(text, "runtimeWorkspaceRoots")
    if runtimeWorkspaceRootsRaw != "":
        result.runtimeWorkspaceRoots = RustCsgJsonStringArrayFromRaw(runtimeWorkspaceRootsRaw)
    result.instructionSources = RustCsgJsonStringArrayFromRaw(RustCsgJsonFindArray(text, "instructionSources"))
    result.approvalPolicyJson = RustCsgJsonFindValueRaw(text, "approvalPolicy")
    result.approvalsReviewer = RustCsgJsonFindStr(text, "approvalsReviewer")
    result.sandboxJson = RustCsgJsonFindObject(text, "sandbox")
    result.permissionProfileJson = RustCsgJsonFindOptionalObject(text, "permissionProfile")
    result.activePermissionProfileJson = RustCsgJsonFindOptionalObject(text, "activePermissionProfile")
    result.reasoningEffort = RustCsgJsonFindOptionalStr(text, "reasoningEffort")
    return result

