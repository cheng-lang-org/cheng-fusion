fn RustCsgThreadTokenUsageUpdatedNotificationToJson(notification: types.RustCsgThreadTokenUsageUpdatedNotification): str =
    var params = "{"
    params = RustCsgCat(params, RustCsgJsonFieldStr("threadId", notification.threadId))
    params = RustCsgCat(params, ",")
    params = RustCsgCat(params, RustCsgJsonFieldStr("turnId", notification.turnId))
    params = RustCsgCat(params, ",")
    params = RustCsgCat(params, RustCsgJsonFieldRaw("tokenUsage", RustCsgThreadTokenUsageToJson(notification.tokenUsage)))
    params = RustCsgCat(params, "}")
    return RustCsgCat3("{\"method\":\"thread/tokenUsage/updated\",\"params\":", params, "}")

