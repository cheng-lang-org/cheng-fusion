    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("thread_source", meta.threadSource))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("agent_nickname", meta.agentNickname))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("agent_role", meta.agentRole))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("agent_path", meta.agentPath))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("model_provider", meta.modelProvider))
    if meta.baseInstructionsPresent:
        out = RustCsgCat(out, ",\"base_instructions\":{\"text\":")
        out = RustCsgCat(out, RustCsgJsonQuote(meta.baseInstructions))
        out = RustCsgCat(out, "}")
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("memory_mode", meta.memoryMode))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgSessionMetaFromJson(text: str): types.RustCsgSessionMeta =
    var result: types.RustCsgSessionMeta
    result.id = RustCsgJsonFindStr(text, "id")
    result.forkedFromId = RustCsgJsonFindOptionalStr(text, "forked_from_id")
    result.timestamp = RustCsgJsonFindStr(text, "timestamp")
    result.cwd = RustCsgJsonFindStr(text, "cwd")
    result.originator = RustCsgJsonFindStr(text, "originator")
    result.cliVersion = RustCsgJsonFindStr(text, "cli_version")
    result.source = RustCsgJsonFindStr(text, "source")
    result.threadSource = RustCsgJsonFindOptionalStr(text, "thread_source")
    result.agentNickname = RustCsgJsonFindOptionalStr(text, "agent_nickname")
    result.agentRole = RustCsgJsonFindOptionalStr(text, "agent_role")
    result.agentPath = RustCsgJsonFindOptionalStr(text, "agent_path")
    result.modelProvider = RustCsgJsonFindOptionalStr(text, "model_provider")
    let baseInstructionsRaw = RustCsgJsonFindOptionalObject(text, "base_instructions")
    if baseInstructionsRaw != "":
        result.baseInstructionsPresent = true
        result.baseInstructions = RustCsgJsonFindOptionalStr(baseInstructionsRaw, "text")
    result.memoryMode = RustCsgJsonFindOptionalStr(text, "memory_mode")
    return result

fn RustCsgTurnContextToJson(context: types.RustCsgTurnContext): str =
    var sandbox = RustCsgCat3("{\"type\":", RustCsgJsonQuote(context.sandboxType), "}")
    if context.sandboxType == "read-only" || context.sandboxType == "workspace-write":
        sandbox = RustCsgCat3("{\"type\":", RustCsgJsonQuote(context.sandboxType), ",")
        sandbox = RustCsgCat(sandbox, RustCsgJsonFieldBool("network_access", context.sandboxNetworkAccess))
        sandbox = RustCsgCat(sandbox, "}")
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("turn_id", context.turnId))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("trace_id", context.traceId))
    out = RustCsgCat(out, RustCsgJsonFieldStr("cwd", context.cwd))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("current_date", context.currentDate))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("timezone", context.timezone))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("approval_policy", context.approvalPolicy))
    out = RustCsgCat(out, ",\"sandbox_policy\":")
    out = RustCsgCat(out, sandbox)
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("model", context.model))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("personality", context.personality))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("collaboration_mode", context.collaborationMode))
    if context.realtimeActive:
        out = RustCsgCat(out, ",\"realtime_active\":true")
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("effort", context.effort))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("summary", context.summary))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("user_instructions", context.userInstructions))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("developer_instructions", context.developerInstructions))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgTurnContextFromJson(text: str): types.RustCsgTurnContext =
    var result: types.RustCsgTurnContext
    var sandboxType = RustCsgJsonFindStr(text, "type")
    if sandboxType == RustCsgWireTurnContext:
        if RustCsgContains(text, "\"sandbox_policy\":{\"type\":\"workspace-write\""):
            sandboxType = "workspace-write"
        elif RustCsgContains(text, "\"sandbox_policy\":{\"type\":\"read-only\""):
            sandboxType = "read-only"
        elif RustCsgContains(text, "\"sandbox_policy\":{\"type\":\"danger-full-access\""):
            sandboxType = "danger-full-access"
        else:
            assert(false, "missing sandbox_policy type")
    result.turnId = RustCsgJsonFindOptionalStr(text, "turn_id")
    result.traceId = RustCsgJsonFindOptionalStr(text, "trace_id")
    result.cwd = RustCsgJsonFindStr(text, "cwd")
    result.currentDate = RustCsgJsonFindOptionalStr(text, "current_date")
    result.timezone = RustCsgJsonFindOptionalStr(text, "timezone")
    result.approvalPolicy = RustCsgJsonFindStr(text, "approval_policy")
    result.sandboxType = sandboxType
    result.sandboxNetworkAccess = RustCsgJsonFindOptionalBool(text, "network_access")
    result.model = RustCsgJsonFindStr(text, "model")
    result.personality = RustCsgJsonFindOptionalStr(text, "personality")
    result.collaborationMode = RustCsgJsonFindOptionalStr(text, "collaboration_mode")
    result.realtimeActive = RustCsgJsonFindOptionalBool(text, "realtime_active")
    result.effort = RustCsgJsonFindOptionalStr(text, "effort")
    result.summary = RustCsgJsonFindStr(text, "summary")
    result.userInstructions = RustCsgJsonFindOptionalStr(text, "user_instructions")
    result.developerInstructions = RustCsgJsonFindOptionalStr(text, "developer_instructions")
    return result

fn RustCsgRolloutLineToJson(line: types.RustCsgRolloutLine): str =
    var payload = "null"
    if line.itemType == RustCsgWireSessionMeta:
        payload = RustCsgSessionMetaToJson(line.sessionMeta)
    elif line.itemType == RustCsgWireTurnContext:
        payload = RustCsgTurnContextToJson(line.turnContext)
    elif line.itemType == RustCsgWireEventMsg:
        payload = RustCsgEventToJson(line.event)
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("timestamp", line.timestamp))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("type", line.itemType))
    out = RustCsgCat(out, ",\"payload\":")
    out = RustCsgCat(out, payload)
    out = RustCsgCat(out, "}")
    return out

fn RustCsgRolloutLineFromJson(text: str): types.RustCsgRolloutLine =
    var result: types.RustCsgRolloutLine
    let timestamp = RustCsgJsonFindStr(text, "timestamp")
    let itemType = RustCsgJsonFindStr(text, "type")
    let payload = RustCsgJsonFindObject(text, "payload")
    result.timestamp = timestamp
    result.itemType = itemType
    if itemType == RustCsgWireSessionMeta:
        result.sessionMeta = RustCsgSessionMetaFromJson(payload)
        return result
    if itemType == RustCsgWireTurnContext:
        result.turnContext = RustCsgTurnContextFromJson(payload)
        return result
    if itemType == RustCsgWireEventMsg:
        result.event = RustCsgEventFromJson(payload)
        return result
    assert(false, RustCsgCat("unsupported rollout item type: ", itemType))
    return result

fn RustCsgAppThreadToJson(thread: var types.RustCsgAppThread): str =
    assert(thread.sessionId != "", "app thread requires sessionId")
    assert(thread.statusJson != "", "app thread requires statusJson")
    var turnsJson = thread.turnsJson
    if turnsJson == "":
        turnsJson = "[]"
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("id", thread.id))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("sessionId", thread.sessionId))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("forkedFromId", thread.forkedFromId))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("preview", thread.preview))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldBool("ephemeral", thread.ephemeral))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("modelProvider", thread.modelProvider))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldInt64("createdAt", thread.createdAt))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldInt64("updatedAt", thread.updatedAt))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("status", thread.statusJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("path", thread.path))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("cwd", thread.cwd))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("cliVersion", thread.cliVersion))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("source", thread.source))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("threadSource", thread.threadSource))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("boundAccountEmail", thread.boundAccountEmail))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("agentNickname", thread.agentNickname))
    out = RustCsgCat(out, RustCsgJsonNullableFieldStr("agentRole", thread.agentRole))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("gitInfo", thread.gitInfoJson))
    out = RustCsgCat(out, ",")
    if thread.name == "":
        out = RustCsgCat(out, "\"name\":null")
    else:
        out = RustCsgCat(out, RustCsgJsonFieldStr("name", thread.name))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("turns", turnsJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgAppThreadFromJson(text: str): types.RustCsgAppThread =
    var result: types.RustCsgAppThread
    result.id = RustCsgJsonFindStr(text, "id")
    result.sessionId = RustCsgJsonFindStr(text, "sessionId")
    result.forkedFromId = RustCsgJsonFindOptionalStr(text, "forkedFromId")
    result.preview = RustCsgJsonFindStr(text, "preview")
    result.ephemeral = RustCsgJsonFindBool(text, "ephemeral")
    result.modelProvider = RustCsgJsonFindStr(text, "modelProvider")
    result.createdAt = RustCsgJsonFindInt64(text, "createdAt")
    result.updatedAt = RustCsgJsonFindInt64(text, "updatedAt")
    result.statusJson = RustCsgJsonFindObject(text, "status")
    result.path = RustCsgJsonFindOptionalStr(text, "path")
    result.cwd = RustCsgJsonFindStr(text, "cwd")
    result.cliVersion = RustCsgJsonFindStr(text, "cliVersion")
    result.source = RustCsgJsonFindStr(text, "source")
    result.threadSource = RustCsgJsonFindOptionalStr(text, "threadSource")
    result.boundAccountEmail = RustCsgJsonFindOptionalStr(text, "boundAccountEmail")
    result.agentNickname = RustCsgJsonFindOptionalStr(text, "agentNickname")
    result.agentRole = RustCsgJsonFindOptionalStr(text, "agentRole")
    result.gitInfoJson = RustCsgJsonFindOptionalObject(text, "gitInfo")
    result.name = RustCsgJsonFindOptionalStr(text, "name")
    result.turnsJson = RustCsgJsonFindArray(text, "turns")
    return result

fn RustCsgAppTurnToJson(turn: var types.RustCsgAppTurn): str =
    var itemsJson = turn.itemsJson
    if itemsJson == "":
        itemsJson = "[]"
    var itemsView = turn.itemsView
    if itemsView == "":
        itemsView = "full"
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("id", turn.id))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("items", itemsJson))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("itemsView", itemsView))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("status", turn.status))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("error", turn.errorJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("startedAt", turn.startedAtJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("completedAt", turn.completedAtJson))
    out = RustCsgCat(out, RustCsgJsonNullableFieldRaw("durationMs", turn.durationMsJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgAppTurnFromJson(text: str): types.RustCsgAppTurn =
    var result: types.RustCsgAppTurn
    result.id = RustCsgJsonFindStr(text, "id")
    result.itemsJson = RustCsgJsonFindArray(text, "items")
    result.itemsView = RustCsgJsonFindOptionalStr(text, "itemsView")
    if result.itemsView == "":
        result.itemsView = "full"
    result.status = RustCsgJsonFindStr(text, "status")
    result.errorJson = RustCsgJsonFindOptionalValueRaw(text, "error")
    result.startedAtJson = RustCsgJsonFindOptionalValueRaw(text, "startedAt")
    result.completedAtJson = RustCsgJsonFindOptionalValueRaw(text, "completedAt")
    result.durationMsJson = RustCsgJsonFindOptionalValueRaw(text, "durationMs")
    return result

