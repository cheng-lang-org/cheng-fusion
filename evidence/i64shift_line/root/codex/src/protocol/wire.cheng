import std/strings as strings
import codex/protocol/types

const
    RustCsgWireSessionMeta: str = "session_meta"
    RustCsgWireTurnContext: str = "turn_context"
    RustCsgWireEventMsg: str = "event_msg"

fn RustCsgSliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn RustCsgCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn RustCsgCat3(a: str, b: str, c: str): str =
    return RustCsgCat(RustCsgCat(a, b), c)

fn RustCsgCat4(a: str, b: str, c: str, d: str): str =
    return RustCsgCat(RustCsgCat3(a, b, c), d)

fn RustCsgJsonAssertSafeString(value: str) =
    var i: int32
    while i < value.len:
        let ch = value[i]
        assert(ch != '"' && ch != '\\' && ch != '\n' && ch != '\r' && ch != '\t',
               "json string escaping not implemented")
        i = i + 1

fn RustCsgJsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = RustCsgCat(out, "\\\"")
        elif ch == '\\':
            out = RustCsgCat(out, "\\\\")
        elif ch == '\n':
            out = RustCsgCat(out, "\\n")
        elif ch == '\r':
            out = RustCsgCat(out, "\\r")
        elif ch == '\t':
            out = RustCsgCat(out, "\\t")
        else:
            out = RustCsgCat(out, RustCsgSliceBytes(value, i, 1))
    return RustCsgCat(out, "\"")

fn RustCsgJsonFieldStr(key: str, value: str): str =
    return RustCsgCat4("\"", key, "\":", RustCsgJsonQuote(value))

fn RustCsgJsonFieldBool(key: str, value: bool): str =
    if value:
        return RustCsgCat4("\"", key, "\":true", "")
    return RustCsgCat4("\"", key, "\":false", "")

fn RustCsgJsonFieldInt32(key: str, value: int32): str =
    return RustCsgCat4("\"", key, "\":", strings.IntToStr(value))

fn RustCsgJsonFieldInt64(key: str, value: int64): str =
    return RustCsgCat4("\"", key, "\":", strings.Int64ToStr(value))

fn RustCsgJsonAssertRawValue(value: str) =
    let p = RustCsgSkipJsonSpace(value, 0)
    if p >= value.len:
        assert(false, "empty raw json value")
        return
    let ch = value[p]
    if ch == '{':
        return
    if ch == '[':
        return
    if ch == '"':
        return
    if ch == 't':
        return
    if ch == 'f':
        return
    if ch == 'n':
        return
    if ch == '-':
        return
    if ch >= '0':
        if ch <= '9':
            return
    assert(false, "unsupported raw json value")

fn RustCsgJsonFieldRaw(key: str, value: str): str =
    let p = RustCsgSkipJsonSpace(value, 0)
    if p >= value.len:
        assert(false, "empty raw json value")
        return ""
    let ch = value[p]
    if ch == '{':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == '[':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == '"':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == 't':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == 'f':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == 'n':
        return RustCsgCat4("\"", key, "\":", value)
    if ch == '-':
        return RustCsgCat4("\"", key, "\":", value)
    if ch >= '0':
        if ch <= '9':
            return RustCsgCat4("\"", key, "\":", value)
    assert(false, "unsupported raw json value")
    return RustCsgCat4("\"", key, "\":", value)

fn RustCsgJsonOptionalFieldStr(key: str, value: str): str =
    if value == "":
        return ""
    return RustCsgCat(",", RustCsgJsonFieldStr(key, value))

fn RustCsgJsonOptionalFieldRaw(key: str, value: str): str =
    if value == "":
        return ""
    return RustCsgCat(",", RustCsgJsonFieldRaw(key, value))

fn RustCsgJsonNullableFieldStr(key: str, value: str): str =
    if value == "":
        return RustCsgCat4(",\"", key, "\":null", "")
    return RustCsgCat(",", RustCsgJsonFieldStr(key, value))

fn RustCsgJsonNullableFieldRaw(key: str, value: str): str =
    if value == "" || value == "null":
        return RustCsgCat4(",\"", key, "\":null", "")
    return RustCsgCat(",", RustCsgJsonFieldRaw(key, value))

fn RustCsgMatchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0:
        return false
    if pos + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if int32(text[pos + i]) != int32(needle[i]):
            return false
    return true

fn RustCsgStartsWith(text: str, prefix: str): bool =
    return RustCsgMatchesAt(text, 0, prefix)

fn RustCsgContains(text: str, needle: str): bool =
    var i: int32
    while i < text.len:
        if RustCsgMatchesAt(text, i, needle):
            return true
        i = i + 1
    return false

fn RustCsgSkipJsonSpace(text: str, pos: int32): int32 =
    var i: int32
    i = pos
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return i
        i = i + 1
    return i

fn RustCsgJsonValueStart(text: str, key: str): int32 =
    let pattern = RustCsgCat3("\"", key, "\"")
    var i: int32
    while i < text.len:
        if RustCsgMatchesAt(text, i, pattern):
            var p: int32
            p = i + pattern.len
            p = RustCsgSkipJsonSpace(text, p)
            if p < text.len && text[p] == ':':
                p = RustCsgSkipJsonSpace(text, p + 1)
                return p
        i = i + 1
    assert(false, RustCsgCat("missing json field: ", key))
    return -1

fn RustCsgJsonFindStr(text: str, key: str): str =
    let p = RustCsgJsonValueStart(text, key)
    if p >= text.len || text[p] != '"':
        assert(false, RustCsgCat("json field is not string: ", key))
    var out: str
    var i: int32
    i = p + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                assert(false, RustCsgCat("unterminated json escape in field: ", key))
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = RustCsgCat(out, RustCsgSliceBytes(text, i + 1, 1))
            elif escaped == 'n':
                out = RustCsgCat(out, "\n")
            elif escaped == 'r':
                out = RustCsgCat(out, "\r")
            elif escaped == 't':
                out = RustCsgCat(out, "\t")
            else:
                assert(false, RustCsgCat("unsupported json string escape in field: ", key))
            i = i + 2
            continue
        elif ch == '"':
            return out
        out = RustCsgCat(out, RustCsgSliceBytes(text, i, 1))
        i = i + 1
    assert(false, RustCsgCat("unterminated json string field: ", key))
    return ""

fn RustCsgJsonFindOptionalStr(text: str, key: str): str =
    if RustCsgContains(text, RustCsgCat3("\"", key, "\"")):
        let p = RustCsgJsonValueStart(text, key)
        if RustCsgMatchesAt(text, p, "null"):
            return ""
        return RustCsgJsonFindStr(text, key)
    return ""

fn RustCsgJsonFindBool(text: str, key: str): bool =
    let p = RustCsgJsonValueStart(text, key)
    if RustCsgMatchesAt(text, p, "true"):
        return true
    if RustCsgMatchesAt(text, p, "false"):
        return false
    assert(false, RustCsgCat("json field is not bool: ", key))
    return false

fn RustCsgJsonFindOptionalBool(text: str, key: str): bool =
    if RustCsgContains(text, RustCsgCat3("\"", key, "\"")):
        return RustCsgJsonFindBool(text, key)
    return false

fn RustCsgDigitValue(text: str): int32 =
    if text == "0":
        return 0
    if text == "1":
        return 1
    if text == "2":
        return 2
    if text == "3":
        return 3
    if text == "4":
        return 4
    if text == "5":
        return 5
    if text == "6":
        return 6
    if text == "7":
        return 7
    if text == "8":
        return 8
    if text == "9":
        return 9
    return -1

fn RustCsgParsePositiveInt32(raw: str): int32 =
    assert(raw.len > 0, "empty int32")
    var out: int32
    for i in 0..<raw.len:
        let digit = RustCsgDigitValue(RustCsgSliceBytes(raw, i, 1))
        assert(digit >= 0, "invalid int32 digit")
        out = out * 10 + digit
    return out

fn RustCsgParseInt32(raw: str): int32 =
    assert(raw.len > 0, "empty int32")
    if raw[0] == '-':
        return 0 - RustCsgParsePositiveInt32(RustCsgSliceBytes(raw, 1, raw.len - 1))
    return RustCsgParsePositiveInt32(raw)

fn RustCsgParsePositiveInt64(raw: str): int64 =
    assert(raw.len > 0, "empty int64")
    var out: int64
    for i in 0..<raw.len:
        let digit = RustCsgDigitValue(RustCsgSliceBytes(raw, i, 1))
        assert(digit >= 0, "invalid int64 digit")
        out = out * int64(10) + int64(digit)
    return out

fn RustCsgParseInt64(raw: str): int64 =
    assert(raw.len > 0, "empty int64")
    if raw[0] == '-':
        return int64(0) - RustCsgParsePositiveInt64(RustCsgSliceBytes(raw, 1, raw.len - 1))
    return RustCsgParsePositiveInt64(raw)

fn RustCsgJsonFindInt32(text: str, key: str): int32 =
    let p = RustCsgJsonValueStart(text, key)
    var endPos: int32
    endPos = p
    if endPos < text.len && text[endPos] == '-':
        endPos = endPos + 1
    var sawDigit: bool
    while endPos < text.len:
        let digit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
        if digit < 0:
            break
        sawDigit = true
        endPos = endPos + 1
    assert(sawDigit, RustCsgCat("json field is not int32: ", key))
    return RustCsgParseInt32(RustCsgSliceBytes(text, p, endPos - p))

fn RustCsgJsonFindInt64(text: str, key: str): int64 =
    let p = RustCsgJsonValueStart(text, key)
    var endPos: int32
    endPos = p
    if endPos < text.len && text[endPos] == '-':
        endPos = endPos + 1
    var sawDigit: bool
    while endPos < text.len:
        let digit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
        if digit < 0:
            break
        sawDigit = true
        endPos = endPos + 1
    assert(sawDigit, RustCsgCat("json field is not int64: ", key))
    return RustCsgParseInt64(RustCsgSliceBytes(text, p, endPos - p))

fn RustCsgJsonFindObject(text: str, key: str): str =
    let p = RustCsgJsonValueStart(text, key)
    if p >= text.len || text[p] != '{':
        assert(false, RustCsgCat("json field is not object: ", key))
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = p
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return RustCsgSliceBytes(text, p, i - p + 1)
        i = i + 1
    assert(false, RustCsgCat("unterminated json object field: ", key))
    return ""

fn RustCsgJsonFindOptionalObject(text: str, key: str): str =
    if RustCsgContains(text, RustCsgCat3("\"", key, "\"")):
        let p = RustCsgJsonValueStart(text, key)
        if RustCsgMatchesAt(text, p, "null"):
            return ""
        return RustCsgJsonFindObject(text, key)
    return ""

fn RustCsgJsonFindArray(text: str, key: str): str =
    let p = RustCsgJsonValueStart(text, key)
    if p >= text.len || text[p] != '[':
        assert(false, RustCsgCat("json field is not array: ", key))
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = p
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                return RustCsgSliceBytes(text, p, i - p + 1)
        i = i + 1
    assert(false, RustCsgCat("unterminated json array field: ", key))
    return ""

fn RustCsgJsonFindOptionalArray(text: str, key: str): str =
    if RustCsgContains(text, RustCsgCat3("\"", key, "\"")):
        return RustCsgJsonFindArray(text, key)
    return ""

fn RustCsgJsonFindValueRaw(text: str, key: str): str =
    let p = RustCsgJsonValueStart(text, key)
    if p >= text.len:
        assert(false, RustCsgCat("missing json value: ", key))
    let ch = text[p]
    if ch == '{':
        return RustCsgJsonFindObject(text, key)
    if ch == '[':
        return RustCsgJsonFindArray(text, key)
    if ch == '"':
        let value = RustCsgJsonFindStr(text, key)
        return RustCsgJsonQuote(value)
    if RustCsgMatchesAt(text, p, "true"):
        return "true"
    if RustCsgMatchesAt(text, p, "false"):
        return "false"
    if RustCsgMatchesAt(text, p, "null"):
        return "null"
    var endPos: int32
    endPos = p
    if endPos < text.len && text[endPos] == '-':
        endPos = endPos + 1
    if endPos >= text.len:
        assert(false, RustCsgCat("invalid json number: ", key))
    let firstDigit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
    if firstDigit == 0:
        endPos = endPos + 1
    elif firstDigit > 0:
        endPos = endPos + 1
        while endPos < text.len:
            let digit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
            if digit < 0:
                break
            endPos = endPos + 1
    else:
        assert(false, RustCsgCat("unsupported json value: ", key))
    if endPos < text.len && text[endPos] == '.':
        endPos = endPos + 1
        if endPos >= text.len || RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1)) < 0:
            assert(false, RustCsgCat("invalid json number fraction: ", key))
        while endPos < text.len:
            let digit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
            if digit < 0:
                break
            endPos = endPos + 1
    if endPos < text.len && (text[endPos] == 'e' || text[endPos] == 'E'):
        endPos = endPos + 1
        if endPos < text.len && (text[endPos] == '+' || text[endPos] == '-'):
            endPos = endPos + 1
        if endPos >= text.len || RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1)) < 0:
            assert(false, RustCsgCat("invalid json number exponent: ", key))
        while endPos < text.len:
            let digit = RustCsgDigitValue(RustCsgSliceBytes(text, endPos, 1))
            if digit < 0:
                break
            endPos = endPos + 1
    if endPos < text.len:
        let next = text[endPos]
        let boundary = next == ' ' || next == '\n' || next == '\r' || next == '\t' || next == ',' || next == '}' || next == ']'
        assert(boundary, RustCsgCat("invalid json number boundary: ", key))
    return RustCsgSliceBytes(text, p, endPos - p)
    assert(false, RustCsgCat("unsupported json value: ", key))
    return ""

fn RustCsgJsonFindOptionalValueRaw(text: str, key: str): str =
    if RustCsgContains(text, RustCsgCat3("\"", key, "\"")):
        return RustCsgJsonFindValueRaw(text, key)
    return ""

fn RustCsgJsonStringArray(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            out = RustCsgCat(out, ",")
        out = RustCsgCat(out, RustCsgJsonQuote(values[i]))
    out = RustCsgCat(out, "]")
    return out

fn RustCsgJsonFieldStringArray(key: str, values: str[]): str =
    return RustCsgCat4("\"", key, "\":", RustCsgJsonStringArray(values))

fn RustCsgJsonStringArrayFromRaw(raw: str): str[] =
    var out: str[]
    var pos: int32
    pos = RustCsgSkipJsonSpace(raw, 0)
    if pos >= raw.len:
        assert(false, "json string array must start with [")
    if raw[pos] != '[':
        assert(false, "json string array must start with [")
    pos = RustCsgSkipJsonSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        return out
    while pos < raw.len:
        if raw[pos] != '"':
            assert(false, "json array item is not string")
        var value: str
        var i: int32
        var itemDone: bool
        i = pos + 1
        while i < raw.len:
            let ch = raw[i]
            if ch == '\\':
                if i + 1 >= raw.len:
                    assert(false, "unterminated json string escape")
                let escaped = raw[i + 1]
                var simpleEscape: bool
                if escaped == '"':
                    simpleEscape = true
                elif escaped == '\\':
                    simpleEscape = true
                elif escaped == '/':
                    simpleEscape = true
                if simpleEscape:
                    value = RustCsgCat(value, RustCsgSliceBytes(raw, i + 1, 1))
                elif escaped == 'n':
                    value = RustCsgCat(value, "\n")
                elif escaped == 'r':
                    value = RustCsgCat(value, "\r")
                elif escaped == 't':
                    value = RustCsgCat(value, "\t")
                else:
                    assert(false, "unsupported json string escape")
                i = i + 2
            elif ch == '"':
                add(out, value)
                pos = RustCsgSkipJsonSpace(raw, i + 1)
                if pos < raw.len && raw[pos] == ',':
                    pos = RustCsgSkipJsonSpace(raw, pos + 1)
                    itemDone = true
                    i = raw.len
                elif pos < raw.len && raw[pos] == ']':
                    return out
                else:
                    assert(false, "malformed json string array")
            else:
                value = RustCsgCat(value, RustCsgSliceBytes(raw, i, 1))
                i = i + 1
        if itemDone == false:
            assert(false, "unterminated json string array item")
    assert(false, "unterminated json string array")
    return out

fn RustCsgSubmissionToJson(submission: types.RustCsgSubmission): str =
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("id", submission.id))
    out = RustCsgCat(out, ",\"op\":{")
    out = RustCsgCat(out, RustCsgJsonFieldStr("type", submission.opType))
    out = RustCsgCat(out, "}")
    if submission.traceparent != "" || submission.tracestate != "":
        out = RustCsgCat(out, ",\"trace\":{")
        out = RustCsgCat(out, RustCsgJsonFieldStr("traceparent", submission.traceparent))
        out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("tracestate", submission.tracestate))
        out = RustCsgCat(out, "}")
    out = RustCsgCat(out, "}")
    return out

fn RustCsgSubmissionFromJson(text: str): types.RustCsgSubmission =
    var result: types.RustCsgSubmission
    result.id = RustCsgJsonFindStr(text, "id")
    result.opType = RustCsgJsonFindStr(text, "type")
    result.traceparent = RustCsgJsonFindOptionalStr(text, "traceparent")
    result.tracestate = RustCsgJsonFindOptionalStr(text, "tracestate")
    return result

fn RustCsgEventToJson(event: types.RustCsgEvent): str =
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("id", event.id))
    out = RustCsgCat(out, ",\"msg\":{")
    out = RustCsgCat(out, RustCsgJsonFieldStr("type", event.msgType))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("message", event.message))
    out = RustCsgCat(out, "}}")
    return out

fn RustCsgEventFromJson(text: str): types.RustCsgEvent =
    var result: types.RustCsgEvent
    result.id = RustCsgJsonFindStr(text, "id")
    result.msgType = RustCsgJsonFindStr(text, "type")
    result.message = RustCsgJsonFindOptionalStr(text, "message")
    return result

fn RustCsgMcpInvocationToJson(invocation: types.RustCsgMcpInvocation): str =
    var argumentsJson = invocation.argumentsJson
    if argumentsJson == "":
        argumentsJson = "null"
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("server", invocation.server))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("tool", invocation.tool))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("arguments", argumentsJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgMcpInvocationFromJson(text: str): types.RustCsgMcpInvocation =
    var result: types.RustCsgMcpInvocation
    result.server = RustCsgJsonFindStr(text, "server")
    result.tool = RustCsgJsonFindStr(text, "tool")
    let argumentsJson = RustCsgJsonFindValueRaw(text, "arguments")
    if argumentsJson != "null":
        result.argumentsJson = argumentsJson
    return result

fn RustCsgMcpToolToJson(tool: types.RustCsgMcpTool): str =
    var inputSchemaJson = tool.inputSchemaJson
    if inputSchemaJson == "":
        inputSchemaJson = "null"
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("name", tool.name))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("title", tool.title))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("description", tool.description))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("inputSchema", inputSchemaJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("outputSchema", tool.outputSchemaJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("annotations", tool.annotationsJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("icons", tool.iconsJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("_meta", tool.metaJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgMcpToolFromJson(text: str): types.RustCsgMcpTool =
    var result: types.RustCsgMcpTool
    result.name = RustCsgJsonFindStr(text, "name")
    result.title = RustCsgJsonFindOptionalStr(text, "title")
    result.description = RustCsgJsonFindOptionalStr(text, "description")
    result.inputSchemaJson = RustCsgJsonFindValueRaw(text, "inputSchema")
    result.outputSchemaJson = RustCsgJsonFindOptionalValueRaw(text, "outputSchema")
    result.annotationsJson = RustCsgJsonFindOptionalValueRaw(text, "annotations")
    result.iconsJson = RustCsgJsonFindOptionalValueRaw(text, "icons")
    result.metaJson = RustCsgJsonFindOptionalValueRaw(text, "_meta")
    return result

fn RustCsgMcpResourceToJson(resource: types.RustCsgMcpResource): str =
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("name", resource.name))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("uri", resource.uri))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("title", resource.title))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("description", resource.description))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("mimeType", resource.mimeType))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("size", resource.sizeJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("annotations", resource.annotationsJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("icons", resource.iconsJson))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldRaw("_meta", resource.metaJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgMcpResourceFromJson(text: str): types.RustCsgMcpResource =
    var result: types.RustCsgMcpResource
    result.name = RustCsgJsonFindStr(text, "name")
    result.uri = RustCsgJsonFindStr(text, "uri")
    result.title = RustCsgJsonFindOptionalStr(text, "title")
    result.description = RustCsgJsonFindOptionalStr(text, "description")
    result.mimeType = RustCsgJsonFindOptionalStr(text, "mimeType")
    result.sizeJson = RustCsgJsonFindOptionalValueRaw(text, "size")
    result.annotationsJson = RustCsgJsonFindOptionalValueRaw(text, "annotations")
    result.iconsJson = RustCsgJsonFindOptionalValueRaw(text, "icons")
    result.metaJson = RustCsgJsonFindOptionalValueRaw(text, "_meta")
    return result

fn RustCsgMcpToolCallBeginToJson(event: types.RustCsgMcpToolCallBeginEvent): str =
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("call_id", event.callId))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("invocation", RustCsgMcpInvocationToJson(event.invocation)))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("mcp_app_resource_uri", event.mcpAppResourceUri))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgMcpToolCallBeginFromJson(text: str): types.RustCsgMcpToolCallBeginEvent =
    var result: types.RustCsgMcpToolCallBeginEvent
    result.callId = RustCsgJsonFindStr(text, "call_id")
    result.invocation = RustCsgMcpInvocationFromJson(RustCsgJsonFindObject(text, "invocation"))
    result.mcpAppResourceUri = RustCsgJsonFindOptionalStr(text, "mcp_app_resource_uri")
    return result

fn RustCsgMcpToolCallEndToJson(event: types.RustCsgMcpToolCallEndEvent): str =
    var resultJson = ""
    if event.resultOk:
        assert(event.resultJson != "", "MCP ok result requires resultJson")
        resultJson = RustCsgCat3("{", RustCsgJsonFieldRaw("Ok", event.resultJson), "}")
    else:
        resultJson = RustCsgCat3("{", RustCsgJsonFieldStr("Err", event.error), "}")
    var out = "{"
    out = RustCsgCat(out, RustCsgJsonFieldStr("call_id", event.callId))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("invocation", RustCsgMcpInvocationToJson(event.invocation)))
    out = RustCsgCat(out, RustCsgJsonOptionalFieldStr("mcp_app_resource_uri", event.mcpAppResourceUri))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldStr("duration", event.duration))
    out = RustCsgCat(out, ",")
    out = RustCsgCat(out, RustCsgJsonFieldRaw("result", resultJson))
    out = RustCsgCat(out, "}")
    return out

fn RustCsgMcpToolCallEndFromJson(text: str): types.RustCsgMcpToolCallEndEvent =
    var result: types.RustCsgMcpToolCallEndEvent
    result.callId = RustCsgJsonFindStr(text, "call_id")
    result.invocation = RustCsgMcpInvocationFromJson(RustCsgJsonFindObject(text, "invocation"))
    result.mcpAppResourceUri = RustCsgJsonFindOptionalStr(text, "mcp_app_resource_uri")
    result.duration = RustCsgJsonFindStr(text, "duration")
    let resultRaw = RustCsgJsonFindObject(text, "result")
    if RustCsgContains(resultRaw, "\"Ok\""):
        result.resultOk = true
        result.resultJson = RustCsgJsonFindValueRaw(resultRaw, "Ok")
    elif RustCsgContains(resultRaw, "\"Err\""):
        result.resultOk = false
        result.error = RustCsgJsonFindStr(resultRaw, "Err")
    else:
        assert(false, "MCP result missing Ok or Err")
    return result

fn RustCsgMcpAuthStatusToJson(status: types.RustCsgMcpAuthStatus): str =
    return RustCsgJsonQuote(status.status)

fn RustCsgMcpAuthStatusFromJson(text: str): types.RustCsgMcpAuthStatus =
    var result: types.RustCsgMcpAuthStatus
    assert(text.len >= 2 && text[0] == '"' && text[text.len - 1] == '"', "RustCsgMcpAuthStatus must be JSON string")
    result.status = RustCsgSliceBytes(text, 1, text.len - 2)
    return result

