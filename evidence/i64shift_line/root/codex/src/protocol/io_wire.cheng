fn RustCsgFsCreateDirectoryParamsToJson(params: types.RustCsgFsCreateDirectoryParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", params.path))
    if params.recursiveJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("recursive", params.recursiveJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgFsCreateDirectoryParamsFromJson(text: str): types.RustCsgFsCreateDirectoryParams =
    var result: types.RustCsgFsCreateDirectoryParams
    result.path = wire.RustCsgJsonFindStr(text, "path")
    result.recursiveJson = wire.RustCsgJsonFindOptionalValueRaw(text, "recursive")
    return result

fn RustCsgFsGetMetadataResponseToJson(response: types.RustCsgFsGetMetadataResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, RustCsgIoFieldBool("isDirectory", response.isDirectory))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgIoFieldBool("isFile", response.isFile))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgIoFieldBool("isSymlink", response.isSymlink))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("createdAtMs", response.createdAtMs))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("modifiedAtMs", response.modifiedAtMs))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgFsGetMetadataResponseFromJson(text: str): types.RustCsgFsGetMetadataResponse =
    var result: types.RustCsgFsGetMetadataResponse
    result.isDirectory = wire.RustCsgJsonFindBool(text, "isDirectory")
    result.isFile = wire.RustCsgJsonFindBool(text, "isFile")
    result.isSymlink = wire.RustCsgJsonFindBool(text, "isSymlink")
    result.createdAtMs = wire.RustCsgJsonFindInt64(text, "createdAtMs")
    result.modifiedAtMs = wire.RustCsgJsonFindInt64(text, "modifiedAtMs")
    return result

