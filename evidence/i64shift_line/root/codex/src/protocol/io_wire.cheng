    result.cols = wire.RustCsgJsonFindInt32(text, "cols")
    return result

fn RustCsgCommandExecParamsToJson(params: types.RustCsgCommandExecParams): str =
    assert(params.command.len > 0, "command/exec params requires command")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("command", params.command))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("processId", params.processId))
    out = wire.RustCsgCat(out, RustCsgIoOptionalFieldBool("tty", params.tty))
    out = wire.RustCsgCat(out, RustCsgIoOptionalFieldBool("streamStdin", params.streamStdin))
    out = wire.RustCsgCat(out, RustCsgIoOptionalFieldBool("streamStdoutStderr", params.streamStdoutStderr))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("outputBytesCap", params.outputBytesCapJson))
    out = wire.RustCsgCat(out, RustCsgIoOptionalFieldBool("disableOutputCap", params.disableOutputCap))
    out = wire.RustCsgCat(out, RustCsgIoOptionalFieldBool("disableTimeout", params.disableTimeout))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("timeoutMs", params.timeoutMsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("cwd", params.cwd))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("env", params.envJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("size", params.sizeJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("sandboxPolicy", params.sandboxPolicyJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("permissionProfile", params.permissionProfileJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCommandExecParamsFromJson(text: str): types.RustCsgCommandExecParams =
    var result: types.RustCsgCommandExecParams
    result.command = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "command"))
    result.processId = wire.RustCsgJsonFindOptionalStr(text, "processId")
    result.tty = wire.RustCsgJsonFindOptionalBool(text, "tty")
    result.streamStdin = wire.RustCsgJsonFindOptionalBool(text, "streamStdin")
    result.streamStdoutStderr = wire.RustCsgJsonFindOptionalBool(text, "streamStdoutStderr")
    result.outputBytesCapJson = wire.RustCsgJsonFindOptionalValueRaw(text, "outputBytesCap")
    result.disableOutputCap = wire.RustCsgJsonFindOptionalBool(text, "disableOutputCap")
    result.disableTimeout = wire.RustCsgJsonFindOptionalBool(text, "disableTimeout")
    result.timeoutMsJson = wire.RustCsgJsonFindOptionalValueRaw(text, "timeoutMs")
    result.cwd = wire.RustCsgJsonFindOptionalStr(text, "cwd")
    result.envJson = wire.RustCsgJsonFindOptionalValueRaw(text, "env")
    result.sizeJson = wire.RustCsgJsonFindOptionalValueRaw(text, "size")
    result.sandboxPolicyJson = wire.RustCsgJsonFindOptionalValueRaw(text, "sandboxPolicy")
    result.permissionProfileJson = wire.RustCsgJsonFindOptionalValueRaw(text, "permissionProfile")
    return result

fn RustCsgCommandExecResponseToJson(response: types.RustCsgCommandExecResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("exitCode", response.exitCode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("stdout", response.stdout))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("stderr", response.stderr))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCommandExecResponseFromJson(text: str): types.RustCsgCommandExecResponse =
    var result: types.RustCsgCommandExecResponse
    result.exitCode = wire.RustCsgJsonFindInt32(text, "exitCode")
    result.stdout = wire.RustCsgJsonFindStr(text, "stdout")
    result.stderr = wire.RustCsgJsonFindStr(text, "stderr")
    return result

