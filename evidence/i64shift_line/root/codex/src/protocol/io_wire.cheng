fn RustCsgCommandExecutionRequestApprovalParamsToJson(params: types.RustCsgCommandExecutionRequestApprovalParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", params.turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("itemId", params.itemId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("approvalId", params.approvalId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("reason", params.reason))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("networkApprovalContext", params.networkApprovalContextJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("command", params.command))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("cwd", params.cwd))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("commandActions", params.commandActionsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("additionalPermissions", params.additionalPermissionsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("proposedExecpolicyAmendment", params.proposedExecpolicyAmendmentJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("proposedNetworkPolicyAmendments", params.proposedNetworkPolicyAmendmentsJson))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("availableDecisions", params.availableDecisionsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgCommandExecutionRequestApprovalParamsFromJson(text: str): types.RustCsgCommandExecutionRequestApprovalParams =
    var result: types.RustCsgCommandExecutionRequestApprovalParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.turnId = wire.RustCsgJsonFindStr(text, "turnId")
    result.itemId = wire.RustCsgJsonFindStr(text, "itemId")
    result.approvalId = wire.RustCsgJsonFindOptionalStr(text, "approvalId")
    result.reason = wire.RustCsgJsonFindOptionalStr(text, "reason")
    result.networkApprovalContextJson = wire.RustCsgJsonFindOptionalObject(text, "networkApprovalContext")
    result.command = wire.RustCsgJsonFindOptionalStr(text, "command")
    result.cwd = wire.RustCsgJsonFindOptionalStr(text, "cwd")
    result.commandActionsJson = wire.RustCsgJsonFindOptionalArray(text, "commandActions")
    result.additionalPermissionsJson = wire.RustCsgJsonFindOptionalObject(text, "additionalPermissions")
    result.proposedExecpolicyAmendmentJson = wire.RustCsgJsonFindOptionalValueRaw(text, "proposedExecpolicyAmendment")
    result.proposedNetworkPolicyAmendmentsJson = wire.RustCsgJsonFindOptionalArray(text, "proposedNetworkPolicyAmendments")
    result.availableDecisionsJson = wire.RustCsgJsonFindOptionalArray(text, "availableDecisions")
    return result

