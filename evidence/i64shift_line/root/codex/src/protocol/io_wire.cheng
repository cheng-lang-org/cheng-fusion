import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgIoFieldBool(key: str, value: bool): str =
    if value:
        return wire.RustCsgJsonFieldRaw(key, "true")
    return wire.RustCsgJsonFieldRaw(key, "false")

fn RustCsgIoOptionalFieldBool(key: str, value: bool): str =
    if value:
        return wire.RustCsgCat(",", wire.RustCsgJsonFieldRaw(key, "true"))
    return ""

fn RustCsgFsPathParamsToJson(params: types.RustCsgFsPathParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", params.path))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgFsPathParamsFromJson(text: str): types.RustCsgFsPathParams =
    var result: types.RustCsgFsPathParams
    result.path = wire.RustCsgJsonFindStr(text, "path")
    return result

fn RustCsgFsReadFileResponseToJson(response: types.RustCsgFsReadFileResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("dataBase64", response.dataBase64))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgFsReadFileResponseFromJson(text: str): types.RustCsgFsReadFileResponse =
    var result: types.RustCsgFsReadFileResponse
    result.dataBase64 = wire.RustCsgJsonFindStr(text, "dataBase64")
    return result

fn RustCsgFsWriteFileParamsToJson(params: types.RustCsgFsWriteFileParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", params.path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("dataBase64", params.dataBase64))
    out = wire.RustCsgCat(out, "}")
