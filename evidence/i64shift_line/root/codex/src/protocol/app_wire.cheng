import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgAppOptionalFieldBool(key: str, value: bool): str =
    if value:
        return wire.RustCsgCat(",", wire.RustCsgJsonFieldRaw(key, "true"))
    return ""

fn RustCsgAppsListParamsToJson(params: types.RustCsgAppsListParams): str =
    var cursorJson = "null"
    if params.cursor != "":
        cursorJson = wire.RustCsgJsonQuote(params.cursor)
    var limitJson = "null"
    if params.limitJson != "":
        limitJson = params.limitJson
    var threadIdJson = "null"
    if params.threadId != "":
        threadIdJson = wire.RustCsgJsonQuote(params.threadId)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cursor", cursorJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("limit", limitJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadId", threadIdJson))
    out = wire.RustCsgCat(out, RustCsgAppOptionalFieldBool("forceRefetch", params.forceRefetch))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppsListParamsFromJson(text: str): types.RustCsgAppsListParams =
    var result: types.RustCsgAppsListParams
    let cursorJson = wire.RustCsgJsonFindOptionalValueRaw(text, "cursor")
    if cursorJson != "" && cursorJson != "null":
        result.cursor = wire.RustCsgJsonFindStr(text, "cursor")
    result.limitJson = wire.RustCsgJsonFindOptionalValueRaw(text, "limit")
    let threadIdJson = wire.RustCsgJsonFindOptionalValueRaw(text, "threadId")
    if threadIdJson != "" && threadIdJson != "null":
        result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.forceRefetch = wire.RustCsgJsonFindOptionalBool(text, "forceRefetch")
    return result

fn RustCsgAppsListResponseToJson(response: types.RustCsgAppsListResponse): str =
    assert(response.dataJson != "", "app/list response requires dataJson")
    var nextCursorJson = response.nextCursorJson
    if nextCursorJson == "":
        nextCursorJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("data", response.dataJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("nextCursor", nextCursorJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppsListResponseFromJson(text: str): types.RustCsgAppsListResponse =
    var result: types.RustCsgAppsListResponse
    result.dataJson = wire.RustCsgJsonFindArray(text, "data")
    result.nextCursorJson = wire.RustCsgJsonFindValueRaw(text, "nextCursor")
    return result

fn RustCsgAppListUpdatedNotificationToJson(notification: types.RustCsgAppListUpdatedNotification): str =
    assert(notification.dataJson != "", "app/list updated notification requires dataJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("data", notification.dataJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppListUpdatedNotificationFromJson(text: str): types.RustCsgAppListUpdatedNotification =
    var result: types.RustCsgAppListUpdatedNotification
    result.dataJson = wire.RustCsgJsonFindArray(text, "data")
    return result
