import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgExecServerNullIfEmpty(value: str): str =
    if value == "":
        return "null"
    return value

fn RustCsgExecServerBoolField(key: str, value: bool): str =
    if value:
        return wire.RustCsgJsonFieldRaw(key, "true")
    return wire.RustCsgJsonFieldRaw(key, "false")

fn RustCsgExecServerInitializeParamsToJson(params: types.RustCsgExecServerInitializeParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("clientName", params.clientName))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("resumeSessionId", RustCsgExecServerNullIfEmpty(params.resumeSessionIdJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerInitializeParamsFromJson(text: str): types.RustCsgExecServerInitializeParams =
    var result: types.RustCsgExecServerInitializeParams
    result.clientName = wire.RustCsgJsonFindStr(text, "clientName")
    result.resumeSessionIdJson = wire.RustCsgJsonFindValueRaw(text, "resumeSessionId")
    return result

fn RustCsgExecServerInitializeResponseToJson(response: types.RustCsgExecServerInitializeResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sessionId", response.sessionId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerInitializeResponseFromJson(text: str): types.RustCsgExecServerInitializeResponse =
    var result: types.RustCsgExecServerInitializeResponse
    result.sessionId = wire.RustCsgJsonFindStr(text, "sessionId")
    return result

fn RustCsgExecServerExecParamsToJson(params: types.RustCsgExecServerExecParams): str =
    var envPolicyJson = params.envPolicyJson
    if envPolicyJson == "":
        envPolicyJson = "null"
    var envJson = params.envJson
    if envJson == "":
        envJson = "{}"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("processId", params.processId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("argv", params.argv))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", params.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("envPolicy", envPolicyJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("env", envJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("tty", params.tty))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("pipeStdin", params.pipeStdin))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("arg0", RustCsgExecServerNullIfEmpty(params.arg0Json)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerExecParamsFromJson(text: str): types.RustCsgExecServerExecParams =
    var result: types.RustCsgExecServerExecParams
    result.processId = wire.RustCsgJsonFindStr(text, "processId")
    result.argv = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "argv"))
    result.cwd = wire.RustCsgJsonFindStr(text, "cwd")
    result.envPolicyJson = wire.RustCsgJsonFindValueRaw(text, "envPolicy")
    result.envJson = wire.RustCsgJsonFindObject(text, "env")
    result.tty = wire.RustCsgJsonFindBool(text, "tty")
    result.pipeStdin = wire.RustCsgJsonFindBool(text, "pipeStdin")
    result.arg0Json = wire.RustCsgJsonFindValueRaw(text, "arg0")
    return result

fn RustCsgExecServerExecResponseToJson(response: types.RustCsgExecServerExecResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("processId", response.processId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerExecResponseFromJson(text: str): types.RustCsgExecServerExecResponse =
    var result: types.RustCsgExecServerExecResponse
    result.processId = wire.RustCsgJsonFindStr(text, "processId")
    return result

fn RustCsgExecServerReadParamsToJson(params: types.RustCsgExecServerReadParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("processId", params.processId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("afterSeq", RustCsgExecServerNullIfEmpty(params.afterSeqJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("maxBytes", RustCsgExecServerNullIfEmpty(params.maxBytesJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("waitMs", RustCsgExecServerNullIfEmpty(params.waitMsJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerReadParamsFromJson(text: str): types.RustCsgExecServerReadParams =
    var result: types.RustCsgExecServerReadParams
    result.processId = wire.RustCsgJsonFindStr(text, "processId")
    result.afterSeqJson = wire.RustCsgJsonFindValueRaw(text, "afterSeq")
    result.maxBytesJson = wire.RustCsgJsonFindValueRaw(text, "maxBytes")
    result.waitMsJson = wire.RustCsgJsonFindValueRaw(text, "waitMs")
    return result

fn RustCsgExecServerReadResponseToJson(response: types.RustCsgExecServerReadResponse): str =
    assert(response.chunksJson != "", "exec-server read response requires chunksJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("chunks", response.chunksJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("nextSeq", response.nextSeq))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("exited", response.exited))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("exitCode", RustCsgExecServerNullIfEmpty(response.exitCodeJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("closed", response.closed))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("failure", RustCsgExecServerNullIfEmpty(response.failureJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerReadResponseFromJson(text: str): types.RustCsgExecServerReadResponse =
    var result: types.RustCsgExecServerReadResponse
    result.chunksJson = wire.RustCsgJsonFindArray(text, "chunks")
    result.nextSeq = wire.RustCsgJsonFindInt64(text, "nextSeq")
    result.exited = wire.RustCsgJsonFindBool(text, "exited")
    result.exitCodeJson = wire.RustCsgJsonFindValueRaw(text, "exitCode")
    result.closed = wire.RustCsgJsonFindBool(text, "closed")
    result.failureJson = wire.RustCsgJsonFindValueRaw(text, "failure")
    return result

