fn RustCsgExecServerHttpRequestParamsToJson(params: types.RustCsgExecServerHttpRequestParams): str =
    var headersJson = params.headersJson
    if headersJson == "":
        headersJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", params.method))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", params.url))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("headers", headersJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("bodyBase64", RustCsgExecServerNullIfEmpty(params.bodyBase64Json)))
    if params.timeoutMsJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("timeoutMs", params.timeoutMsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("requestId", params.requestId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("streamResponse", params.streamResponse))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerHttpRequestParamsFromJson(text: str): types.RustCsgExecServerHttpRequestParams =
    var result: types.RustCsgExecServerHttpRequestParams
    result.method = wire.RustCsgJsonFindStr(text, "method")
    result.url = wire.RustCsgJsonFindStr(text, "url")
    result.headersJson = wire.RustCsgJsonFindArray(text, "headers")
    result.bodyBase64Json = wire.RustCsgJsonFindValueRaw(text, "bodyBase64")
    result.timeoutMsJson = wire.RustCsgJsonFindOptionalValueRaw(text, "timeoutMs")
    result.requestId = wire.RustCsgJsonFindStr(text, "requestId")
    result.streamResponse = wire.RustCsgJsonFindBool(text, "streamResponse")
    return result

fn RustCsgExecServerHttpRequestResponseToJson(response: types.RustCsgExecServerHttpRequestResponse): str =
    var headersJson = response.headersJson
    if headersJson == "":
        headersJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("status", response.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("headers", headersJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("bodyBase64", response.bodyBase64))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerHttpRequestResponseFromJson(text: str): types.RustCsgExecServerHttpRequestResponse =
    var result: types.RustCsgExecServerHttpRequestResponse
    result.status = wire.RustCsgJsonFindInt32(text, "status")
    result.headersJson = wire.RustCsgJsonFindArray(text, "headers")
    result.bodyBase64 = wire.RustCsgJsonFindStr(text, "bodyBase64")
    return result

fn RustCsgExecServerHttpBodyDeltaNotificationToJson(notification: types.RustCsgExecServerHttpBodyDeltaNotification): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("requestId", notification.requestId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("seq", notification.seq))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("deltaBase64", notification.deltaBase64))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecServerBoolField("done", notification.done))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", RustCsgExecServerNullIfEmpty(notification.errorJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecServerHttpBodyDeltaNotificationFromJson(text: str): types.RustCsgExecServerHttpBodyDeltaNotification =
    var result: types.RustCsgExecServerHttpBodyDeltaNotification
    result.requestId = wire.RustCsgJsonFindStr(text, "requestId")
    result.seq = wire.RustCsgJsonFindInt64(text, "seq")
    result.deltaBase64 = wire.RustCsgJsonFindStr(text, "deltaBase64")
    result.done = wire.RustCsgJsonFindBool(text, "done")
    result.errorJson = wire.RustCsgJsonFindValueRaw(text, "error")
    return result
