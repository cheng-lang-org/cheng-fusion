import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgExternalNullIfEmpty(value: str): str =
    if value == "":
        return "null"
    return value

fn RustCsgExternalAppendComma(out: str, needsComma: bool): str =
    if needsComma:
        return wire.RustCsgCat(out, ",")
    return out

fn RustCsgExternalAgentConfigDetectParamsToJson(params: types.RustCsgExternalAgentConfigDetectParams): str =
    var out = "{"
    var needsComma: bool
    if params.includeHome:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("includeHome", "true"))
        needsComma = true
    out = RustCsgExternalAppendComma(out, needsComma)
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwds", RustCsgExternalNullIfEmpty(params.cwdsJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExternalAgentConfigDetectParamsFromJson(text: str): types.RustCsgExternalAgentConfigDetectParams =
    var result: types.RustCsgExternalAgentConfigDetectParams
    result.includeHome = wire.RustCsgJsonFindOptionalBool(text, "includeHome")
    result.cwdsJson = wire.RustCsgJsonFindValueRaw(text, "cwds")
    return result

fn RustCsgExternalAgentConfigDetectResponseToJson(response: types.RustCsgExternalAgentConfigDetectResponse): str =
    assert(response.itemsJson != "", "external-agent-config detect response requires itemsJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("items", response.itemsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExternalAgentConfigDetectResponseFromJson(text: str): types.RustCsgExternalAgentConfigDetectResponse =
    var result: types.RustCsgExternalAgentConfigDetectResponse
    result.itemsJson = wire.RustCsgJsonFindArray(text, "items")
    return result

fn RustCsgExternalAgentConfigImportParamsToJson(params: types.RustCsgExternalAgentConfigImportParams): str =
    assert(params.migrationItemsJson != "", "external-agent-config import params requires migrationItemsJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("migrationItems", params.migrationItemsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExternalAgentConfigImportParamsFromJson(text: str): types.RustCsgExternalAgentConfigImportParams =
    var result: types.RustCsgExternalAgentConfigImportParams
    result.migrationItemsJson = wire.RustCsgJsonFindArray(text, "migrationItems")
    return result

fn RustCsgExternalAgentConfigImportResponseToJson(): str =
    return "{}"

fn RustCsgExternalAgentConfigImportCompletedNotificationToJson(): str =
    return "{}"

fn RustCsgHooksListParamsToJson(params: types.RustCsgHooksListParams): str =
    if params.cwdsJson == "":
        return "{}"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwds", params.cwdsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgHooksListParamsFromJson(text: str): types.RustCsgHooksListParams =
    var result: types.RustCsgHooksListParams
    result.cwdsJson = wire.RustCsgJsonFindOptionalArray(text, "cwds")
    return result

fn RustCsgHooksListResponseToJson(response: types.RustCsgHooksListResponse): str =
    assert(response.dataJson != "", "hooks/list response requires dataJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("data", response.dataJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgHooksListResponseFromJson(text: str): types.RustCsgHooksListResponse =
    var result: types.RustCsgHooksListResponse
    result.dataJson = wire.RustCsgJsonFindArray(text, "data")
    return result

fn RustCsgMcpServerElicitationRequestParamsToJson(params: types.RustCsgMcpServerElicitationRequestParams): str =
    var turnIdJson = params.turnIdJson
    if turnIdJson == "":
        turnIdJson = "null"
    var metaJson = params.metaJson
    if metaJson == "":
        metaJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("turnId", turnIdJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverName", params.serverName))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("mode", params.mode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("_meta", metaJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", params.message))
    if params.mode == "form":
        assert(params.requestedSchemaJson != "", "elicitation form requires requestedSchemaJson")
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("requestedSchema", params.requestedSchemaJson))
    elif params.mode == "url":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", params.url))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("elicitationId", params.elicitationId))
    else:
        assert(false, "unsupported elicitation mode")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgMcpServerElicitationRequestParamsFromJson(text: str): types.RustCsgMcpServerElicitationRequestParams =
    var result: types.RustCsgMcpServerElicitationRequestParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.turnIdJson = wire.RustCsgJsonFindValueRaw(text, "turnId")
    result.serverName = wire.RustCsgJsonFindStr(text, "serverName")
    result.mode = wire.RustCsgJsonFindStr(text, "mode")
    result.metaJson = wire.RustCsgJsonFindValueRaw(text, "_meta")
    result.message = wire.RustCsgJsonFindStr(text, "message")
    if result.mode == "form":
        result.requestedSchemaJson = wire.RustCsgJsonFindObject(text, "requestedSchema")
    elif result.mode == "url":
        result.url = wire.RustCsgJsonFindStr(text, "url")
        result.elicitationId = wire.RustCsgJsonFindStr(text, "elicitationId")
    else:
        assert(false, "unsupported elicitation mode")
    return result

fn RustCsgMcpServerElicitationRequestResponseToJson(response: types.RustCsgMcpServerElicitationRequestResponse): str =
    var contentJson = response.contentJson
    if contentJson == "":
        contentJson = "null"
    var metaJson = response.metaJson
    if metaJson == "":
        metaJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("action", response.action))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", contentJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("_meta", metaJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgMcpServerElicitationRequestResponseFromJson(text: str): types.RustCsgMcpServerElicitationRequestResponse =
    var result: types.RustCsgMcpServerElicitationRequestResponse
    result.action = wire.RustCsgJsonFindStr(text, "action")
    result.contentJson = wire.RustCsgJsonFindValueRaw(text, "content")
    result.metaJson = wire.RustCsgJsonFindValueRaw(text, "_meta")
    return result
