import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgRateLimitDashboardReadParamsToJson(): str =
    return "{}"

fn RustCsgRateLimitDashboardRefreshParamsToJson(): str =
    return "{}"

fn RustCsgRateLimitDashboardRefreshOneParamsToJson(params: types.RustCsgRateLimitDashboardRefreshOneParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", params.email))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRateLimitDashboardRefreshOneParamsFromJson(text: str): types.RustCsgRateLimitDashboardRefreshOneParams =
    var result: types.RustCsgRateLimitDashboardRefreshOneParams
    result.email = wire.RustCsgJsonFindStr(text, "email")
    return result

fn RustCsgRateLimitDashboardResponseToJson(response: types.RustCsgRateLimitDashboardResponse): str =
    assert(response.accountsJson != "", "rate-limit-dashboard response requires accountsJson")
    var lastUpdatedAtJson = response.lastUpdatedAtJson
    if lastUpdatedAtJson == "":
        lastUpdatedAtJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("accounts", response.accountsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("lastUpdatedAt", lastUpdatedAtJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", response.source))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRateLimitDashboardResponseFromJson(text: str): types.RustCsgRateLimitDashboardResponse =
    var result: types.RustCsgRateLimitDashboardResponse
    result.accountsJson = wire.RustCsgJsonFindArray(text, "accounts")
    result.lastUpdatedAtJson = wire.RustCsgJsonFindValueRaw(text, "lastUpdatedAt")
    result.source = wire.RustCsgJsonFindStr(text, "source")
    return result
