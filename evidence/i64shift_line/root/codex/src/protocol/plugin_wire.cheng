fn RustCsgPluginListResponseToJson(response: types.RustCsgPluginListResponse): str =
    assert(response.marketplacesJson != "", "plugin/list response requires marketplacesJson")
    var marketplaceLoadErrorsJson = response.marketplaceLoadErrorsJson
    if marketplaceLoadErrorsJson == "":
        marketplaceLoadErrorsJson = "[]"
    var featuredPluginIdsJson = response.featuredPluginIdsJson
    if featuredPluginIdsJson == "":
        featuredPluginIdsJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("marketplaces", response.marketplacesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("marketplaceLoadErrors", marketplaceLoadErrorsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("featuredPluginIds", featuredPluginIdsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgPluginListResponseFromJson(text: str): types.RustCsgPluginListResponse =
    var result: types.RustCsgPluginListResponse
    result.marketplacesJson = wire.RustCsgJsonFindArray(text, "marketplaces")
    result.marketplaceLoadErrorsJson = wire.RustCsgJsonFindArray(text, "marketplaceLoadErrors")
    result.featuredPluginIdsJson = wire.RustCsgJsonFindArray(text, "featuredPluginIds")
    return result

