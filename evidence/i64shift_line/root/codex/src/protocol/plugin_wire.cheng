import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgPluginNullIfEmpty(value: str): str =
    if value == "":
        return "null"
    return value

fn RustCsgPluginBoolField(key: str, value: bool): str =
    if value:
        return wire.RustCsgJsonFieldRaw(key, "true")
    return wire.RustCsgJsonFieldRaw(key, "false")

fn RustCsgPluginAppendComma(out: str, needsComma: bool): str =
    if needsComma:
        return wire.RustCsgCat(out, ",")
    return out

fn RustCsgSkillsListParamsToJson(params: types.RustCsgSkillsListParams): str =
    var out = "{"
    var needsComma: bool
    if params.cwdsJson != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwds", params.cwdsJson))
        needsComma = true
    if params.forceReload:
        out = RustCsgPluginAppendComma(out, needsComma)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("forceReload", "true"))
        needsComma = true
    out = RustCsgPluginAppendComma(out, needsComma)
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("perCwdExtraUserRoots", RustCsgPluginNullIfEmpty(params.extraRootsJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgSkillsListParamsFromJson(text: str): types.RustCsgSkillsListParams =
    var result: types.RustCsgSkillsListParams
    result.cwdsJson = wire.RustCsgJsonFindOptionalArray(text, "cwds")
    result.forceReload = wire.RustCsgJsonFindOptionalBool(text, "forceReload")
    result.extraRootsJson = wire.RustCsgJsonFindValueRaw(text, "perCwdExtraUserRoots")
    return result

fn RustCsgSkillsListResponseToJson(response: types.RustCsgSkillsListResponse): str =
    assert(response.dataJson != "", "skills/list response requires dataJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("data", response.dataJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgSkillsListResponseFromJson(text: str): types.RustCsgSkillsListResponse =
    var result: types.RustCsgSkillsListResponse
    result.dataJson = wire.RustCsgJsonFindArray(text, "data")
    return result

