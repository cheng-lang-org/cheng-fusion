import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgRealtimeNullIfEmpty(value: str): str =
    if value == "":
        return "null"
    return value

fn RustCsgRemoteControlStatusChangedNotificationToJson(notification: types.RustCsgRemoteControlStatusChangedNotification): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", notification.status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("environmentId", RustCsgRealtimeNullIfEmpty(notification.envJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRemoteControlStatusChangedNotificationFromJson(text: str): types.RustCsgRemoteControlStatusChangedNotification =
    var result: types.RustCsgRemoteControlStatusChangedNotification
    result.status = wire.RustCsgJsonFindStr(text, "status")
    result.envJson = wire.RustCsgJsonFindValueRaw(text, "environmentId")
    return result

fn RustCsgRealtimeAudioChunkToJson(audio: types.RustCsgRealtimeAudioChunk): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("data", audio.data))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("sampleRate", audio.sampleRate))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("numChannels", audio.channels))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("samplesPerChannel", RustCsgRealtimeNullIfEmpty(audio.samplesJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("itemId", RustCsgRealtimeNullIfEmpty(audio.itemIdJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRealtimeAudioChunkFromJson(text: str): types.RustCsgRealtimeAudioChunk =
    var result: types.RustCsgRealtimeAudioChunk
    result.data = wire.RustCsgJsonFindStr(text, "data")
    result.sampleRate = wire.RustCsgJsonFindInt32(text, "sampleRate")
    result.channels = wire.RustCsgJsonFindInt32(text, "numChannels")
    result.samplesJson = wire.RustCsgJsonFindValueRaw(text, "samplesPerChannel")
    result.itemIdJson = wire.RustCsgJsonFindValueRaw(text, "itemId")
    return result

fn RustCsgThreadRealtimeStartParamsToJson(params: types.RustCsgThreadRealtimeStartParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outputModality", params.outputMode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("prompt", RustCsgRealtimeNullIfEmpty(params.promptJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("realtimeSessionId", RustCsgRealtimeNullIfEmpty(params.sessionIdJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("transport", RustCsgRealtimeNullIfEmpty(params.transportJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("voice", RustCsgRealtimeNullIfEmpty(params.voiceJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadRealtimeStartParamsFromJson(text: str): types.RustCsgThreadRealtimeStartParams =
    var result: types.RustCsgThreadRealtimeStartParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.outputMode = wire.RustCsgJsonFindStr(text, "outputModality")
    result.promptJson = wire.RustCsgJsonFindValueRaw(text, "prompt")
    result.sessionIdJson = wire.RustCsgJsonFindValueRaw(text, "realtimeSessionId")
    result.transportJson = wire.RustCsgJsonFindValueRaw(text, "transport")
    result.voiceJson = wire.RustCsgJsonFindValueRaw(text, "voice")
    return result

fn RustCsgThreadRealtimeAppendAudioParamsToJson(params: types.RustCsgThreadRealtimeAppendAudioParams): str =
    assert(params.audioJson != "", "thread realtime append audio requires audioJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", params.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("audio", params.audioJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadRealtimeAppendAudioParamsFromJson(text: str): types.RustCsgThreadRealtimeAppendAudioParams =
    var result: types.RustCsgThreadRealtimeAppendAudioParams
    result.threadId = wire.RustCsgJsonFindStr(text, "threadId")
    result.audioJson = wire.RustCsgJsonFindObject(text, "audio")
    return result

