import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgDeviceKeyCreateParamsToJson(params: types.RustCsgDeviceKeyCreateParams): str =
    var protectionPolicyJson = params.protectionPolicyJson
    if protectionPolicyJson == "":
        protectionPolicyJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("protectionPolicy", protectionPolicyJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("accountUserId", params.accountUserId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("clientId", params.clientId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgDeviceKeyCreateParamsFromJson(text: str): types.RustCsgDeviceKeyCreateParams =
    var result: types.RustCsgDeviceKeyCreateParams
    result.protectionPolicyJson = wire.RustCsgJsonFindValueRaw(text, "protectionPolicy")
    result.accountUserId = wire.RustCsgJsonFindStr(text, "accountUserId")
    result.clientId = wire.RustCsgJsonFindStr(text, "clientId")
    return result

fn RustCsgDeviceKeyMaterialResponseToJson(response: types.RustCsgDeviceKeyMaterialResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("keyId", response.keyId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("publicKeySpkiDerBase64", response.publicKeyBase64))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("algorithm", response.algorithm))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("protectionClass", response.protectionClass))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgDeviceKeyMaterialResponseFromJson(text: str): types.RustCsgDeviceKeyMaterialResponse =
    var result: types.RustCsgDeviceKeyMaterialResponse
    result.keyId = wire.RustCsgJsonFindStr(text, "keyId")
    result.publicKeyBase64 = wire.RustCsgJsonFindStr(text, "publicKeySpkiDerBase64")
    result.algorithm = wire.RustCsgJsonFindStr(text, "algorithm")
    result.protectionClass = wire.RustCsgJsonFindStr(text, "protectionClass")
    return result

fn RustCsgDeviceKeyPublicParamsToJson(params: types.RustCsgDeviceKeyPublicParams): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("keyId", params.keyId))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgDeviceKeyPublicParamsFromJson(text: str): types.RustCsgDeviceKeyPublicParams =
    var result: types.RustCsgDeviceKeyPublicParams
    result.keyId = wire.RustCsgJsonFindStr(text, "keyId")
    return result

fn RustCsgDeviceKeySignParamsToJson(params: types.RustCsgDeviceKeySignParams): str =
    assert(params.payloadJson != "", "device/key/sign params requires payloadJson")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("keyId", params.keyId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("payload", params.payloadJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgDeviceKeySignParamsFromJson(text: str): types.RustCsgDeviceKeySignParams =
    var result: types.RustCsgDeviceKeySignParams
    result.keyId = wire.RustCsgJsonFindStr(text, "keyId")
    result.payloadJson = wire.RustCsgJsonFindObject(text, "payload")
    return result

fn RustCsgDeviceKeySignResponseToJson(response: types.RustCsgDeviceKeySignResponse): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("signatureDerBase64", response.signatureDerBase64))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("signedPayloadBase64", response.signedPayloadBase64))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("algorithm", response.algorithm))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgDeviceKeySignResponseFromJson(text: str): types.RustCsgDeviceKeySignResponse =
    var result: types.RustCsgDeviceKeySignResponse
    result.signatureDerBase64 = wire.RustCsgJsonFindStr(text, "signatureDerBase64")
    result.signedPayloadBase64 = wire.RustCsgJsonFindStr(text, "signedPayloadBase64")
    result.algorithm = wire.RustCsgJsonFindStr(text, "algorithm")
    return result
