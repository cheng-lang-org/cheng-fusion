import std/strings
import cheng/codex/cli/tui_session_command as command
import cheng/codex/config/home as config_home
import cheng/codex/config/user_config
import cheng/codex/protocol/wire
import cheng/codex/state/state_db
import cheng/codex/state/state_db_sqlite
import cheng/codex/tui/session_bootstrap as bootstrap
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_resume as resume
import cheng/codex/tui/session_root_flow as root_flow
import cheng/codex/tui/session_root_terminal_flow as terminal_flow

@importc("RustCsgGetCurrentTimeMs")
fn RustCsgCliTuiSessionRuntimeNowMs(): int64

type
    RustCsgCliTuiSessionRuntimeConfig =
        dbPath: str
        codexHomePath: str
        currentCwd: str
        currentConfigJson: str
        requestIdJson: str
        allowPrompt: bool
        promptChoice: str
        explicitPromptChoice: str
        threadParamsMode: str
        model: str
        modelProviderId: str
        serviceTierJson: str
        runtimeWorkspaceRootsJson: str
        approvalPolicyJson: str
        approvalsReviewer: str
        permissionsJson: str
        modelOverride: str
        approvalPolicyJsonOverride: str
        permissionsJsonOverride: str
        configJson: str
        baseInstructions: str
        developerInstructions: str
        permissionProfileJson: str
        personalityJson: str
        messageHistoryLogId: int64
        messageHistoryEntryCount: int32
        appTermWidth: int32
        appTermHeight: int32
        pickerSelectedIndex: int32
        pickerQuery: str
        pickerCwdFilter: str
        pickerSortKey: str
        pickerLimit: int32
        pickerDense: bool
        pickerShowCwd: bool
        pickerWidth: int32
        pickerListHeight: int32
        pickerViewRows: int32
        cwdPromptWidth: int32
        nowMs: int64

    RustCsgCliTuiSessionRuntimeResult =
        ok: bool
        exitCode: int32
        outcome: str
        command: str
        action: str
        sessionId: str
        rootJson: str
        flowJson: str
        appFirstFrameText: str
        error: str

fn RustCsgCliTuiSessionRuntimeFillDefaultConfig(config: var RustCsgCliTuiSessionRuntimeConfig) =
    config.dbPath = ""
    config.codexHomePath = ""
    config.currentCwd = ""
    config.currentConfigJson = "{}"
    config.requestIdJson = ""
    config.allowPrompt = true
    config.promptChoice = ""
    config.explicitPromptChoice = ""
    config.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.model = "gpt-5"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = ""
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.permissionsJson = "\":workspace\""
    config.modelOverride = ""
    config.approvalPolicyJsonOverride = ""
    config.permissionsJsonOverride = ""
    config.configJson = "{}"
    config.baseInstructions = ""
    config.developerInstructions = ""
    config.permissionProfileJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.personalityJson = "null"
    config.messageHistoryLogId = int64(0)
    config.messageHistoryEntryCount = 0
    config.appTermWidth = 80
    config.appTermHeight = 24
    config.pickerSelectedIndex = 0
    config.pickerQuery = ""
    config.pickerCwdFilter = ""
    config.pickerSortKey = "updated_at"
    config.pickerLimit = 25
    config.pickerDense = false
    config.pickerShowCwd = true
    config.pickerWidth = 80
    config.pickerListHeight = 12
    config.pickerViewRows = 8
    config.cwdPromptWidth = 80
    config.nowMs = int64(0)

fn RustCsgCliTuiSessionRuntimeDefaultConfig(): RustCsgCliTuiSessionRuntimeConfig =
    var config: RustCsgCliTuiSessionRuntimeConfig
    RustCsgCliTuiSessionRuntimeFillDefaultConfig(config)
    return config

fn RustCsgCliTuiSessionRuntimeConfigJsonForReasoning(reasoningEffort: str): str =
    if reasoningEffort == "":
        return "{}"
    return wire.RustCsgCat3("{\"model_reasoning_effort\":", wire.RustCsgJsonQuote(reasoningEffort), "}")

fn RustCsgCliTuiSessionRuntimeApprovalPolicyValid(value: str): bool =
    if value == "untrusted" || value == "on-failure" || value == "on-request":
        return true
    return value == "never"

fn RustCsgCliTuiSessionRuntimeSandboxValueValid(value: str): bool =
    if value == "read-only" || value == "workspace-write":
        return true
    return value == "danger-full-access"

fn RustCsgCliTuiSessionRuntimePermissionsJsonForSandbox(value: str): str =
    if value == "read-only":
        return "\":read-only\""
    if value == "workspace-write":
        return "\":workspace\""
    if value == "danger-full-access":
        return "\":danger-full-access\""
    return ""

fn RustCsgCliTuiSessionRuntimePermissionProfileJsonForPermissions(permissionsJson: str): str =
    if permissionsJson == "\":read-only\"":
        return "{\"type\":\"readOnly\"}"
    if permissionsJson == "\":danger-full-access\"":
        return "{\"type\":\"dangerFullAccess\"}"
    return "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"

fn RustCsgCliTuiSessionRuntimeApplyCurrentConfig(config: var RustCsgCliTuiSessionRuntimeConfig,
                                                 currentConfigJson: str) =
    config.currentConfigJson = currentConfigJson
    let model = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "model")
    if model != "":
        config.model = model
    let modelProvider = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "modelProvider")
    if modelProvider != "":
        config.modelProviderId = modelProvider
    let approvalPolicy = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "approvalPolicy")
    if approvalPolicy != "":
        config.approvalPolicyJson = wire.RustCsgJsonQuote(approvalPolicy)
    let approvalsReviewer = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "approvalsReviewer")
    if approvalsReviewer != "":
        config.approvalsReviewer = approvalsReviewer
    let defaultPermissions = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "defaultPermissions")
    if defaultPermissions != "":
        config.permissionsJson = wire.RustCsgJsonQuote(defaultPermissions)
    let reasoningEffort = wire.RustCsgJsonFindOptionalStr(currentConfigJson, "modelReasoningEffort")
    config.configJson = RustCsgCliTuiSessionRuntimeConfigJsonForReasoning(reasoningEffort)

fn RustCsgCliTuiSessionRuntimeApplyPlanOverrides(config: var RustCsgCliTuiSessionRuntimeConfig,
                                                 plan: var command.RustCsgCliTuiSessionCommandPlan,
                                                 outError: var str) =
    outError = ""
    if plan.configOverrides.len > 0:
        outError = "TUI --config runtime overrides not ported"
        return
    if plan.askForApproval != "":
        if !RustCsgCliTuiSessionRuntimeApprovalPolicyValid(plan.askForApproval):
            outError = wire.RustCsgCat("invalid --ask-for-approval value: ", plan.askForApproval)
            return
        config.approvalPolicyJson = wire.RustCsgJsonQuote(plan.askForApproval)
        config.approvalPolicyJsonOverride = config.approvalPolicyJson
    if plan.bypassApprovalsAndSandbox:
        config.approvalPolicyJson = "\"never\""
        config.permissionsJson = "\":danger-full-access\""
        config.permissionProfileJson = RustCsgCliTuiSessionRuntimePermissionProfileJsonForPermissions(config.permissionsJson)
        config.approvalPolicyJsonOverride = config.approvalPolicyJson
        config.permissionsJsonOverride = config.permissionsJson
    if plan.model != "":
        config.model = plan.model
        config.modelOverride = plan.model
    if plan.cwd != "":
        let resolved = config_home.RustCsgRealPath(plan.cwd)
        if resolved == "":
            outError = wire.RustCsgCat("failed to resolve --cwd: ", plan.cwd)
            return
        config.currentCwd = resolved
        config.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(resolved), "]")

fn RustCsgCliTuiSessionRuntimeSelectedProfileFromPlan(plan: var command.RustCsgCliTuiSessionCommandPlan,
                                                      outError: var str): str =
    outError = ""
    if plan.profile != "":
        return plan.profile
    return ""

fn RustCsgCliTuiSessionRuntimeConfigFromEnvironmentInto(outConfig: var RustCsgCliTuiSessionRuntimeConfig,
                                                        outError: var str) =
    outError = ""
    RustCsgCliTuiSessionRuntimeFillDefaultConfig(outConfig)
    var codexHomePath: str
    var homeError: str
    config_home.RustCsgFindCodexHomeInto(codexHomePath, homeError)
    if homeError != "":
        outError = homeError
        return
    let currentCwd = config_home.RustCsgRealPath(".")
    if currentCwd == "":
        outError = "failed to resolve current working directory"
        return
    let sqliteHome = state_db.RustCsgResolveSqliteHome("", currentCwd)
    if sqliteHome.error != "":
        outError = sqliteHome.error
        return
    var configError: str
    let currentConfigJson = user_config.RustCsgLoadUserConfigJsonFromCodexHome(codexHomePath,
                                                                                false,
                                                                                configError)
    if configError != "":
        outError = configError
        return
    let nowMs = RustCsgCliTuiSessionRuntimeNowMs()
    outConfig.codexHomePath = codexHomePath
    outConfig.currentCwd = currentCwd
    outConfig.dbPath = state_db.RustCsgStateDbPath(sqliteHome.path)
    outConfig.requestIdJson = strings.Int64ToStr(nowMs)
    outConfig.nowMs = nowMs
    outConfig.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(currentCwd), "]")
    RustCsgCliTuiSessionRuntimeApplyCurrentConfig(outConfig, currentConfigJson)

fn RustCsgCliTuiSessionRuntimeConfigFromEnvironmentForPlanInto(outConfig: var RustCsgCliTuiSessionRuntimeConfig,
                                                               plan: var command.RustCsgCliTuiSessionCommandPlan,
                                                               outError: var str) =
    var configError: str
    let selectedProfile = RustCsgCliTuiSessionRuntimeSelectedProfileFromPlan(plan, configError)
    if configError != "":
        outError = configError
        return
    RustCsgCliTuiSessionRuntimeConfigFromEnvironmentWithProfileInto(outConfig, selectedProfile, plan.cwd, outError)

fn RustCsgCliTuiSessionRuntimeConfigFromEnvironmentWithProfileInto(outConfig: var RustCsgCliTuiSessionRuntimeConfig,
                                                                   selectedProfile: str,
                                                                   cwdOverride: str,
                                                                   outError: var str) =
    outError = ""
    RustCsgCliTuiSessionRuntimeFillDefaultConfig(outConfig)
    var codexHomePath: str
    var homeError: str
    config_home.RustCsgFindCodexHomeInto(codexHomePath, homeError)
    if homeError != "":
        outError = homeError
        return
    var currentCwd = config_home.RustCsgRealPath(".")
    if currentCwd == "":
        outError = "failed to resolve current working directory"
        return
    if cwdOverride != "":
        let plannedCwd = config_home.RustCsgRealPath(cwdOverride)
        if plannedCwd == "":
            outError = wire.RustCsgCat("failed to resolve --cwd: ", cwdOverride)
            return
        currentCwd = plannedCwd
    let sqliteHome = state_db.RustCsgResolveSqliteHome("", currentCwd)
    if sqliteHome.error != "":
        outError = sqliteHome.error
        return
    var configError: str
    let currentConfigJson = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath,
                                                                                           false,
                                                                                           selectedProfile,
                                                                                           configError)
    if configError != "":
        outError = configError
        return
    let nowMs = RustCsgCliTuiSessionRuntimeNowMs()
    outConfig.codexHomePath = codexHomePath
    outConfig.currentCwd = currentCwd
    outConfig.dbPath = state_db.RustCsgStateDbPath(sqliteHome.path)
    outConfig.requestIdJson = strings.Int64ToStr(nowMs)
    outConfig.nowMs = nowMs
    outConfig.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(currentCwd), "]")
    RustCsgCliTuiSessionRuntimeApplyCurrentConfig(outConfig, currentConfigJson)

fn RustCsgCliTuiSessionRuntimeError(message: str): RustCsgCliTuiSessionRuntimeResult =
    var result: RustCsgCliTuiSessionRuntimeResult
    result.exitCode = 1
    result.outcome = "error"
    result.error = message
    return result

fn RustCsgCliTuiSessionRuntimeOk(outcome: str,
                                 plan: var command.RustCsgCliTuiSessionCommandPlan,
                                 rootJson: str,
                                 flowJson: str,
                                 appFirstFrameText: str): RustCsgCliTuiSessionRuntimeResult =
    var result: RustCsgCliTuiSessionRuntimeResult
    result.ok = true
    result.exitCode = 0
    result.outcome = outcome
    result.command = plan.command
    result.action = plan.action
    result.sessionId = plan.sessionId
    result.rootJson = rootJson
    result.flowJson = flowJson
    result.appFirstFrameText = appFirstFrameText
    return result

fn RustCsgCliTuiSessionRuntimeBuildHandoffConfig(config: var RustCsgCliTuiSessionRuntimeConfig): lifecycle.RustCsgTuiThreadHandoffConfig =
    var result: lifecycle.RustCsgTuiThreadHandoffConfig
    result.cwd = config.currentCwd
    result.model = config.model
    result.modelProviderId = config.modelProviderId
    result.serviceTierJson = config.serviceTierJson
    if config.runtimeWorkspaceRootsJson != "":
        result.runtimeWorkspaceRootsJson = config.runtimeWorkspaceRootsJson
    else:
        result.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(config.currentCwd), "]")
    result.approvalPolicyJson = config.approvalPolicyJson
    result.approvalsReviewer = config.approvalsReviewer
    result.permissionsJson = config.permissionsJson
    result.modelOverride = config.modelOverride
    result.approvalPolicyJsonOverride = config.approvalPolicyJsonOverride
    result.permissionsJsonOverride = config.permissionsJsonOverride
    result.configJson = config.configJson
    result.baseInstructions = config.baseInstructions
    result.developerInstructions = config.developerInstructions
    return result

fn RustCsgCliTuiSessionRuntimeBuildBootstrapConfig(config: var RustCsgCliTuiSessionRuntimeConfig): bootstrap.RustCsgTuiSessionBootstrapConfig =
    var result: bootstrap.RustCsgTuiSessionBootstrapConfig
    result.threadParamsMode = config.threadParamsMode
    result.terminalResizeReflowEnabled = true
    result.initialUserMessagePending = true
    result.stateConfig.permissionProfileJson = config.permissionProfileJson
    result.stateConfig.personalityJson = config.personalityJson
    result.stateConfig.messageHistoryLogId = config.messageHistoryLogId
    result.stateConfig.messageHistoryEntryCount = config.messageHistoryEntryCount
    return result

fn RustCsgCliTuiSessionRuntimeBuildRootConfig(config: var RustCsgCliTuiSessionRuntimeConfig): root_flow.RustCsgTuiSessionRootFlowConfig =
    var result: root_flow.RustCsgTuiSessionRootFlowConfig
    result.handoffContext.dbPath = config.dbPath
    result.handoffContext.codexHomePath = config.codexHomePath
    result.handoffContext.currentCwd = config.currentCwd
    result.handoffContext.currentConfigJson = resume.RustCsgTuiSessionResumeConfigJson(config.currentCwd,
                                                                                       config.currentConfigJson)
    result.handoffContext.allowPrompt = config.allowPrompt
    result.handoffContext.promptChoice = config.promptChoice
    result.handoffContext.threadParamsMode = config.threadParamsMode
    result.handoffContext.requestIdJson = config.requestIdJson
    result.handoffConfig = RustCsgCliTuiSessionRuntimeBuildHandoffConfig(config)
    result.bootstrapConfig = RustCsgCliTuiSessionRuntimeBuildBootstrapConfig(config)
    result.appTermWidth = config.appTermWidth
    result.appTermHeight = config.appTermHeight
    return result

fn RustCsgCliTuiSessionRuntimeBuildPickerConfig(config: var RustCsgCliTuiSessionRuntimeConfig,
                                                action: str): terminal_flow.RustCsgTuiSessionRootTerminalPickerConfig =
    var result: terminal_flow.RustCsgTuiSessionRootTerminalPickerConfig
    result.action = action
    result.selectedIndex = config.pickerSelectedIndex
    result.query = config.pickerQuery
    result.cwdFilter = config.pickerCwdFilter
    result.sortKey = config.pickerSortKey
    result.limit = config.pickerLimit
    result.dense = config.pickerDense
    result.showCwd = config.pickerShowCwd
    result.width = config.pickerWidth
    result.listHeight = config.pickerListHeight
    result.viewRows = config.pickerViewRows
    result.cwdPromptWidth = config.cwdPromptWidth
    result.nowMs = config.nowMs
    return result

fn RustCsgCliTuiSessionRuntimeSelectionFromSessionId(config: var RustCsgCliTuiSessionRuntimeConfig,
                                                     plan: var command.RustCsgCliTuiSessionCommandPlan): root_flow.RustCsgTuiSessionRootFlowSelection =
    var empty: root_flow.RustCsgTuiSessionRootFlowSelection
    let row = state_db_sqlite.RustCsgStateDbThreadById(config.dbPath, plan.sessionId)
    if !row.ok:
        return empty
    var displayLabel = row.rolloutPath
    if displayLabel == "":
        displayLabel = wire.RustCsgCat("thread ", row.id)
    return root_flow.RustCsgTuiSessionRootFlowMakeSelection(plan.action,
                                                             row.id,
                                                             row.rolloutPath,
                                                             displayLabel,
                                                             "",
                                                             0)

fn RustCsgCliTuiSessionRuntimeRunPlan(config: var RustCsgCliTuiSessionRuntimeConfig,
                                      plan: var command.RustCsgCliTuiSessionCommandPlan,
                                      pickerSequenceStream: str,
                                      cwdPromptSequenceStream: str): RustCsgCliTuiSessionRuntimeResult =
    if plan.showHelp:
        return RustCsgCliTuiSessionRuntimeOk("help", plan, "", "", "")
    if !plan.ok:
        return RustCsgCliTuiSessionRuntimeError(plan.error)
    var overrideError: str
    RustCsgCliTuiSessionRuntimeApplyPlanOverrides(config, plan, overrideError)
    if overrideError != "":
        return RustCsgCliTuiSessionRuntimeError(overrideError)
    if config.dbPath == "":
        return RustCsgCliTuiSessionRuntimeError("CLI TUI session runtime requires state db path")
    if config.codexHomePath == "":
        return RustCsgCliTuiSessionRuntimeError("CLI TUI session runtime requires codex home path")
    if config.currentCwd == "":
        return RustCsgCliTuiSessionRuntimeError("CLI TUI session runtime requires current cwd")
    if config.requestIdJson == "":
        return RustCsgCliTuiSessionRuntimeError("CLI TUI session runtime requires request id")

    var rootConfig = RustCsgCliTuiSessionRuntimeBuildRootConfig(config)
    if plan.sessionId != "":
        let selection = RustCsgCliTuiSessionRuntimeSelectionFromSessionId(config, plan)
        if selection.threadId == "":
            return RustCsgCliTuiSessionRuntimeError(wire.RustCsgCat("no rollout found for thread id ", plan.sessionId))
        rootConfig.handoffContext.promptChoice = config.explicitPromptChoice
        let rootResult = root_flow.RustCsgTuiSessionRootFlowRunSelected(rootConfig, selection)
        if !rootResult.ok:
            return RustCsgCliTuiSessionRuntimeError(rootResult.error)
        let rootJson = root_flow.RustCsgTuiSessionRootFlowResultToJson(rootResult)
        return RustCsgCliTuiSessionRuntimeOk(rootResult.outcome, plan, rootJson, "", rootResult.appFirstFrameText)

    var pickerConfig = RustCsgCliTuiSessionRuntimeBuildPickerConfig(config, plan.action)
    let flowResult = terminal_flow.RustCsgTuiSessionRootTerminalFlowRun(rootConfig,
                                                                        pickerConfig,
                                                                        pickerSequenceStream,
                                                                        cwdPromptSequenceStream)
    if !flowResult.ok:
        return RustCsgCliTuiSessionRuntimeError(flowResult.error)
    let flowJson = terminal_flow.RustCsgTuiSessionRootTerminalFlowResultToJson(flowResult)
    return RustCsgCliTuiSessionRuntimeOk(flowResult.outcome, plan, flowResult.rootJson, flowJson, flowResult.appFirstFrameText)

fn RustCsgCliTuiSessionRuntimeRunArgs(args: str[],
                                      commandName: str,
                                      config: var RustCsgCliTuiSessionRuntimeConfig,
                                      pickerSequenceStream: str,
                                      cwdPromptSequenceStream: str): RustCsgCliTuiSessionRuntimeResult =
    var plan = command.RustCsgCliTuiSessionCommandParse(args, commandName)
    return RustCsgCliTuiSessionRuntimeRunPlan(config, plan, pickerSequenceStream, cwdPromptSequenceStream)

fn RustCsgCliTuiSessionRuntimeRunArgsFromEnvironment(args: str[],
                                                     commandName: str,
                                                     pickerSequenceStream: str,
                                                     cwdPromptSequenceStream: str): RustCsgCliTuiSessionRuntimeResult =
    var plan = command.RustCsgCliTuiSessionCommandParse(args, commandName)
    if plan.showHelp:
        var emptyConfig = RustCsgCliTuiSessionRuntimeDefaultConfig()
        return RustCsgCliTuiSessionRuntimeRunPlan(emptyConfig, plan, pickerSequenceStream, cwdPromptSequenceStream)
    if !plan.ok:
        return RustCsgCliTuiSessionRuntimeError(plan.error)
    var config: RustCsgCliTuiSessionRuntimeConfig
    var err: str
    RustCsgCliTuiSessionRuntimeConfigFromEnvironmentForPlanInto(config, plan, err)
    if err != "":
        return RustCsgCliTuiSessionRuntimeError(err)
    return RustCsgCliTuiSessionRuntimeRunPlan(config, plan, pickerSequenceStream, cwdPromptSequenceStream)

fn RustCsgCliTuiSessionRuntimeResultToJson(result: var RustCsgCliTuiSessionRuntimeResult): str =
    if !result.ok:
        return wire.RustCsgCat(wire.RustCsgCat("{\"ok\":false,\"exitCode\":1,\"outcome\":\"error\",\"error\":", wire.RustCsgJsonQuote(result.error)), "}")
    var out = "{\"ok\":true,"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("exitCode", result.exitCode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", result.outcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", result.command))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("action", result.action))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonNullableFieldStr("sessionId", result.sessionId))
    if result.rootJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("root", result.rootJson))
    if result.flowJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("flow", result.flowJson))
    out = wire.RustCsgCat(out, "}")
    return out
