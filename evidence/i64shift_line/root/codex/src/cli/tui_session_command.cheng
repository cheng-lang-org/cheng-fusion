import std/strutils as strutil
import cheng/codex/crates/cli/cli

type
    RustCsgCliTuiSessionCommandPlan =
        ok: bool
        command: str
        action: str
        sessionId: str
        last: bool
        all: bool
        includeNonInteractive: bool
        showHelp: bool
        model: str
        cwd: str
        profile: str
        color: str
        askForApproval: str
        configOverrides: str[]
        json: bool
        experimentalJson: bool
        search: bool
        noAltScreen: bool
        skipGitRepoCheck: bool
        bypassApprovalsAndSandbox: bool
        error: str

fn RustCsgCliTuiSessionCommandSetError(plan: var RustCsgCliTuiSessionCommandPlan,
                                       message: str) =
    if plan.error == "":
        plan.error = message
    plan.ok = false

fn RustCsgCliTuiSessionCommandConsumeSharedOption(args: str[],
                                                  index: int32,
                                                  plan: var RustCsgCliTuiSessionCommandPlan,
                                                  outNextIndex: var int32): bool =
    outNextIndex = index
    let arg = args[index]
    if arg == "--json":
        plan.json = true
        return true
    if arg == "--experimental-json":
        plan.experimentalJson = true
        return true
    if arg == "--search":
        plan.search = true
        return true
    if arg == "--no-alt-screen":
        plan.noAltScreen = true
        return true
    if arg == "--skip-git-repo-check":
        plan.skipGitRepoCheck = true
        return true
    if arg == "--dangerously-bypass-approvals-and-sandbox" || arg == "--yolo":
        if plan.askForApproval != "":
            RustCsgCliTuiSessionCommandSetError(plan, "--dangerously-bypass-approvals-and-sandbox conflicts with --ask-for-approval")
        plan.bypassApprovalsAndSandbox = true
        return true

    var value: str
    var nextIndex: int32
    if cli.RustCsgCliReadNextArg(args, index, "--model", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "-m", value, nextIndex):
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--model requires a value")
        plan.model = value
        outNextIndex = nextIndex
        return true
    if cli.RustCsgCliReadNextArg(args, index, "--cwd", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "-C", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "--cd", value, nextIndex):
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--cwd requires a value")
        plan.cwd = value
        outNextIndex = nextIndex
        return true
    if cli.RustCsgCliReadNextArg(args, index, "--profile", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "-p", value, nextIndex):
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--profile requires a value")
        plan.profile = value
        outNextIndex = nextIndex
        return true
    if cli.RustCsgCliReadNextArg(args, index, "--config", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "-c", value, nextIndex):
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--config requires a value")
        else:
            add(plan.configOverrides, value)
        outNextIndex = nextIndex
        return true
    if cli.RustCsgCliReadNextArg(args, index, "--color", value, nextIndex):
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--color requires a value")
        plan.color = value
        outNextIndex = nextIndex
        return true
    if cli.RustCsgCliReadNextArg(args, index, "--ask-for-approval", value, nextIndex) ||
       cli.RustCsgCliReadNextArg(args, index, "-a", value, nextIndex):
        if plan.bypassApprovalsAndSandbox:
            RustCsgCliTuiSessionCommandSetError(plan, "--dangerously-bypass-approvals-and-sandbox conflicts with --ask-for-approval")
        if value == "":
            RustCsgCliTuiSessionCommandSetError(plan, "--ask-for-approval requires a value")
        plan.askForApproval = value
        outNextIndex = nextIndex
        return true
    return false

fn RustCsgCliTuiSessionCommandParse(args: str[], command: str): RustCsgCliTuiSessionCommandPlan =
    var result: RustCsgCliTuiSessionCommandPlan
    result.ok = true
    result.command = command
    result.action = command
    result.color = "auto"
    if command != "resume" && command != "fork":
        RustCsgCliTuiSessionCommandSetError(result,
                                            strutil.Join(["unsupported TUI session command: ", command], ""))
        return result

    var stopOptions: bool
    var i: int32 = 2
    while i < args.len:
        let arg = args[i]
        if !stopOptions && arg == "--":
            stopOptions = true
            i = i + 1
            continue
        if !stopOptions && (arg == "--help" || arg == "-h"):
            result.showHelp = true
            return result
        if !stopOptions && arg == "--last":
            result.last = true
            i = i + 1
            continue
        if !stopOptions && arg == "--all":
            result.all = true
            i = i + 1
            continue
        if !stopOptions && command == "resume" && arg == "--include-non-interactive":
            result.includeNonInteractive = true
            i = i + 1
            continue
        if !stopOptions && cli.RustCsgCliIsFlag(arg):
            var nextIndex: int32
            if RustCsgCliTuiSessionCommandConsumeSharedOption(args, i, result, nextIndex):
                if result.error != "":
                    return result
                i = nextIndex + 1
                continue
            RustCsgCliTuiSessionCommandSetError(result,
                                                strutil.Join(["unknown ", command, " flag: ", arg], ""))
            return result
        if result.sessionId == "":
            result.sessionId = arg
            i = i + 1
            continue
        RustCsgCliTuiSessionCommandSetError(result,
                                            strutil.Join(["unexpected ", command, " positional: ", arg], ""))
        return result
    if command == "fork" && result.last && result.sessionId != "":
        RustCsgCliTuiSessionCommandSetError(result, "--last conflicts with SESSION_ID")
        return result
    return result
