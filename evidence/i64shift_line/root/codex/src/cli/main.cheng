    if args.len < 2:
        return false
    return args[1] == "features"

fn RustCsgCliPrintFeaturesHelp() =
    echo("Usage: codex features <list|enable|disable> [FEATURE]")

@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgCliWriteFile(path: str, content: str): int32

@abi_internal
@importc("RustCsgMkdir")
fn RustCsgCliMkdir(path: str): int32

fn RustCsgCliTomlBoolLine(key: str, enabled: bool): str =
    if enabled:
        return wire.RustCsgCat(key, " = true")
    return wire.RustCsgCat(key, " = false")

fn RustCsgCliTomlLineIsAnySection(line: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    return pos < line.len && line[pos] == '['

fn RustCsgCliTomlLineIsSection(line: str, section: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    var endPos: int32 = line.len
    while endPos > pos && (line[endPos - 1] == ' ' || line[endPos - 1] == '\t' || line[endPos - 1] == '\r'):
        endPos = endPos - 1
    if endPos - pos != section.len + 2:
        return false
    if line[pos] != '[' || line[endPos - 1] != ']':
        return false
    return strings.SliceBytes(line, pos + 1, section.len) == section

fn RustCsgCliTomlLineMatchesBareKey(line: str, key: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    if pos >= line.len || line[pos] == '[' || line[pos] == '#':
        return false
    let trimmed = strings.SliceBytes(line, pos, line.len - pos)
    if trimmed.len <= key.len:
        return false
    if strings.SliceBytes(trimmed, 0, key.len) != key:
        return false
    var afterKey: int32 = key.len
    while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
        afterKey = afterKey + 1
    return afterKey < trimmed.len && trimmed[afterKey] == '='

fn RustCsgCliSetFeatureLineInText(currentToml: str, key: str, enabled: bool): str =
    let section = "features"
    let header = "[features]"
    let newLine = RustCsgCliTomlBoolLine(key, enabled)
    if currentToml == "":
        return wire.RustCsgCat4(header, "\n", newLine, "\n")
    var outContent: str
    var i: int32
    var lineStart: int32
    var inSection: bool
    var seenSection: bool
    var replaced: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if RustCsgCliTomlLineIsAnySection(line):
                if inSection && !replaced:
                    outContent = wire.RustCsgCat(outContent, newLine)
                    outContent = wire.RustCsgCat(outContent, "\n")
                    replaced = true
                inSection = RustCsgCliTomlLineIsSection(line, section)
                if inSection:
                    seenSection = true
            elif inSection && !replaced && RustCsgCliTomlLineMatchesBareKey(line, key):
                outContent = wire.RustCsgCat(outContent, newLine)
                outContent = wire.RustCsgCat(outContent, "\n")
                replaced = true
                i = i + 1
                lineStart = i
                continue
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if RustCsgCliTomlLineIsAnySection(line):
            if inSection && !replaced:
                outContent = wire.RustCsgCat(outContent, newLine)
                outContent = wire.RustCsgCat(outContent, "\n")
                replaced = true
            inSection = RustCsgCliTomlLineIsSection(line, section)
            if inSection:
                seenSection = true
        elif inSection && !replaced && RustCsgCliTomlLineMatchesBareKey(line, key):
            outContent = wire.RustCsgCat(outContent, newLine)
            outContent = wire.RustCsgCat(outContent, "\n")
            replaced = true
            lineStart = currentToml.len
        if lineStart < currentToml.len:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    if seenSection && inSection && !replaced:
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
        replaced = true
    if !seenSection:
        outContent = wire.RustCsgCat(outContent, header)
        outContent = wire.RustCsgCat(outContent, "\n")
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn RustCsgCliRemoveFeatureLineInText(currentToml: str, key: str): str =
    if currentToml == "":
        return currentToml
    var outContent: str
    var i: int32
    var lineStart: int32
    var inSection: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if RustCsgCliTomlLineIsAnySection(line):
                inSection = RustCsgCliTomlLineIsSection(line, "features")
            if !(inSection && RustCsgCliTomlLineMatchesBareKey(line, key)):
                outContent = wire.RustCsgCat(outContent, line)
                outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if RustCsgCliTomlLineIsAnySection(line):
            inSection = RustCsgCliTomlLineIsSection(line, "features")
        if !(inSection && RustCsgCliTomlLineMatchesBareKey(line, key)):
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn RustCsgCliWriteFeatureConfig(configPath: str, codexHome: str, key: str, enabled: bool, outError: var str): bool =
    let currentToml = home.RustCsgReadFile(configPath)
    var nextToml: str
    if !enabled && features_crate.RustCsgFeatureCanonicalDefaultFalse(key):
        nextToml = RustCsgCliRemoveFeatureLineInText(currentToml, key)
    else:
        nextToml = RustCsgCliSetFeatureLineInText(currentToml, key, enabled)
    if nextToml == currentToml:
        return true
    let homeKind = home.RustCsgPathMetadataKind(codexHome)
    if homeKind == 0:
        let made = RustCsgCliMkdir(codexHome)
        if made == 0:
            outError = "failed to create CODEX_HOME"
            return false
    elif homeKind != 1:
        outError = "CODEX_HOME is not a directory"
        return false
    if RustCsgCliWriteFile(configPath, nextToml) == 0:
        outError = "failed to write config.toml"
        return false
    return true

fn RustCsgCliRunFeatureSet(sub: str, feature: str): int32 =
    if !features_crate.RustCsgFeatureKnown(feature):
        echo(wire.RustCsgCat("Unknown feature flag: ", feature))
        return 1
    var codexHome: str
    var pathErr: str
    home.RustCsgFindCodexHomeInto(codexHome, pathErr)
    if pathErr != "":
        echo(wire.RustCsgCat("Error: ", pathErr))
        return 1
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let enabled = sub == "enable"
    var writeError: str
    if !RustCsgCliWriteFeatureConfig(configPath, codexHome, feature, enabled, writeError):
        echo(wire.RustCsgCat("Error: ", writeError))
        return 1
    if enabled:
        echo(wire.RustCsgCat3("Enabled feature `", feature, "` in config.toml."))
        if features_crate.RustCsgFeatureUnderDevelopment(feature):
            let warn = wire.RustCsgCat3("Under-development features enabled: ", feature, ". Under-development features are incomplete and may behave unpredictably. To suppress this warning, set `suppress_unstable_features_warning = true` in ")
            echo(wire.RustCsgCat3(warn, configPath, "."))
    else:
        echo(wire.RustCsgCat3("Disabled feature `", feature, "` in config.toml."))
    return 0

fn RustCsgCliRunFeatures(args: str[]): int32 =
    if args.len < 3:
        RustCsgCliPrintFeaturesHelp()
        return 1
    let sub = args[2]
    if sub == "--help" || sub == "-h":
        RustCsgCliPrintFeaturesHelp()
        return 0
    if sub == "list":
        if args.len != 3:
            RustCsgCliPrintFeaturesHelp()
            return 1
        var configPath: str
        var pathErr: str
        if !RustCsgCliConfigPath(configPath, pathErr):
            echo(wire.RustCsgCat("Error: ", pathErr))
            return 1
        echo(features_crate.RustCsgFeaturesListTextWithConfig(home.RustCsgReadFile(configPath)))
        return 0
    if sub == "enable" || sub == "disable":
        if args.len != 4:
            RustCsgCliPrintFeaturesHelp()
            return 1
        return RustCsgCliRunFeatureSet(sub, args[3])
    RustCsgCliPrintFeaturesHelp()
    return 1

fn RustCsgCliAppendExecConfigOverride(execArgs: var str[], overrideValue: str) =
    add(execArgs, "--config")
    add(execArgs, overrideValue)

fn RustCsgCliRootArgsToExecArgs(args: str[], extraPrompt: str): str[] =
    var execArgs: str[]
    if args.len > 0:
        add(execArgs, args[0])
    else:
        add(execArgs, "codex")
    add(execArgs, "exec")
    var i: int32 = 1
    var stopOptions: bool
    while i < args.len:
        let arg = args[i]
        if !stopOptions && arg == "--":
            stopOptions = true
            add(execArgs, arg)
            i = i + 1
            continue
        if !stopOptions && arg == "--search":
            RustCsgCliAppendExecConfigOverride(execArgs, "web_search=live")
            i = i + 1
            continue
        if !stopOptions && arg == "--no-alt-screen":
            i = i + 1
            continue
        if !stopOptions:
            var approvalValue: str
            var nextIndex: int32
            if cli.RustCsgCliReadNextArg(args, i, "--ask-for-approval", approvalValue, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-a", approvalValue, nextIndex):
                if approvalValue != "":
                    RustCsgCliAppendExecConfigOverride(execArgs, strings.ConcatStr("approval_policy=", approvalValue))
                    i = nextIndex + 1
                    continue
        add(execArgs, arg)
        i = i + 1
    if extraPrompt != "":
        add(execArgs, extraPrompt)
    return execArgs

fn RustCsgCliIsAppServerCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "app-server"

fn RustCsgCliIsConfigCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "config"

fn RustCsgCliConfigPath(outPath: var str, outError: var str): bool =
    var codexHome: str
    home.RustCsgFindCodexHomeInto(codexHome, outError)
    if outError != "":
        return false
    outPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    return true

# Trim leading/trailing spaces and tabs from a string.
fn RustCsgCliTrim(s: str): str =
    if s == "":
        return s
    var start: int32 = 0
    while start < s.len && (s[start] == ' ' || s[start] == '\t'):
        start = start + 1
    if start == s.len:
        return ""
    var end: int32 = s.len - 1
    while end > start && (s[end] == ' ' || s[end] == '\t' || s[end] == '\r'):
        end = end - 1
    let count = end - start + 1
    if start == 0 && count == s.len:
        return s
    return wire.RustCsgSliceBytes(s, start, count)

fn RustCsgCliTrimSecret(s: str): str =
    if s == "":
        return s
    var start: int32 = 0
    while start < s.len && (s[start] == ' ' || s[start] == '\t' || s[start] == '\n' || s[start] == '\r'):
        start = start + 1
    if start == s.len:
        return ""
    var end: int32 = s.len - 1
    while end > start && (s[end] == ' ' || s[end] == '\t' || s[end] == '\n' || s[end] == '\r'):
        end = end - 1
    return wire.RustCsgSliceBytes(s, start, end - start + 1)

# Find a key in simple key=value config.toml content.
# Supports: key = "value" and key = unquoted_value (same line).
fn RustCsgCliConfigFindKey(content: str, key: str, outValue: var str): bool =
    let lines = strutil.Split(content, '\n')
    for i in 0..<lines.len:
        let raw = lines[i]
        var trimmed = RustCsgCliTrim(raw)
        if trimmed == "" || trimmed[0] == '#':
            continue
        var eqPos: int32 = -1
        for j in 0..<trimmed.len:
            if trimmed[j] == '=':
                eqPos = j
                break
        if eqPos < 0:
            continue
        # Build line key (non-whitespace chars before '=')
        var lineKey: str
        for j in 0..<eqPos:
            let ch = trimmed[j]
            if ch != ' ' && ch != '\t':
                lineKey = wire.RustCsgCat(lineKey, wire.RustCsgSliceBytes(trimmed, j, 1))
        if lineKey != key:
            continue
        # Extract value after '='
        var vs: int32 = eqPos + 1
        while vs < trimmed.len && (trimmed[vs] == ' ' || trimmed[vs] == '\t'):
            vs = vs + 1
        if vs >= trimmed.len:
            outValue = ""
            return true
        if trimmed[vs] == '"':
            # Quoted value: find closing double-quote
            var ve: int32 = vs + 1
            while ve < trimmed.len && trimmed[ve] != '"':
                ve = ve + 1
            let valLen = ve - vs - 1
            if valLen > 0:
                outValue = wire.RustCsgSliceBytes(trimmed, vs + 1, valLen)
            else:
                outValue = ""
            return true
        else:
            # Unquoted value: read until whitespace
            var ve: int32 = vs
            while ve < trimmed.len && trimmed[ve] != ' ' && trimmed[ve] != '\t' && trimmed[ve] != '\r':
                ve = ve + 1
            outValue = wire.RustCsgSliceBytes(trimmed, vs, ve - vs)
            return true
    outValue = ""
    return false

fn RustCsgCliHandleAppServer(args: str[]): int32 =
    var listen: str = "stdio://"
    let listenPrefix = "--listen="
    for i in 2..<args.len:
        if args[i] == "--listen" && i + 1 < args.len:
            listen = args[i + 1]
        else:
            var isListenEq = true
            if args[i].len < listenPrefix.len:
                isListenEq = false
            if isListenEq:
                for j in 0..<listenPrefix.len:
                    if args[i][j] != listenPrefix[j]:
                        isListenEq = false
                        break
            if isListenEq:
                listen = wire.RustCsgSliceBytes(args[i], listenPrefix.len, args[i].len - listenPrefix.len)
    echo("App server can be started with:")
    echo(strutil.Join(["  codex-app-server --listen ", listen, "  (requested)"], ""))
    echo("  codex-app-server --listen stdio://     (default, for MCP/CLI clients)")
    echo("  codex-app-server --listen ws://127.0.0.1:4096  (for WebSocket clients)")
    echo("  codex-app-server --listen unix:///tmp/codex.sock  (for local clients)")
    return 0

fn RustCsgCliHandleConfig(args: str[]): int32 =
    if args.len < 3:
        echo("Usage: codex config <show|get|set> [args]")
        return 1
    var configPath: str
    var pathErr: str
    if !RustCsgCliConfigPath(configPath, pathErr):
        echo(strutil.Join(["Error: ", pathErr], ""))
        return 1
    let sub = args[2]
    if sub == "show":
        let content = home.RustCsgReadFile(configPath)
        if content == "":
            echo(strutil.Join(["Config file not found: ", configPath], ""))
            return 1
        echo(content)
        return 0
    if sub == "get":
        if args.len < 4:
            echo("Usage: codex config get <key>")
            return 1
        let key = args[3]
        let content = home.RustCsgReadFile(configPath)
        if content == "":
            echo("Config file not found")
            return 1
        var val: str
        if RustCsgCliConfigFindKey(content, key, val):
            echo(strutil.Join([key, " = ", val], ""))
        else:
            echo(strutil.Join(["key not found: ", key], ""))
            return 1
        return 0
    if sub == "set":
        echo("use 'codex app-server' and send config/write request")
        return 0
    echo(strutil.Join(["Unknown config subcommand: ", sub], ""))
    return 1

fn RustCsgCliIsLoginCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "login"

fn RustCsgCliIsLogoutCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "logout"

@importc("RustCsgStdinIsTerminal")
fn RustCsgCliStdinIsTerminal(): int32

fn RustCsgCliReadStdin(): str =
    let stdin = os.Get_stdin()
    var out: str
    var c = os.C_fgetc(stdin)
    while c >= 0:
        out = strings.ConcatStr(out, strings.CharToStr(Char(c)))
        c = os.C_fgetc(stdin)
    return out

fn RustCsgCliReadLine(): str =
    os.Write(os.Get_stdout(), "> ")
    let _flush = os.C_fflush(os.Get_stdout())
    let stdin = os.Get_stdin()
    var out: str
    var c = os.C_fgetc(stdin)
    while c >= 0:
        if c == 10:
            break
        out = strings.ConcatStr(out, strings.CharToStr(Char(c)))
        c = os.C_fgetc(stdin)
    return out

fn RustCsgCliGetCodexHome(): str =
    let codexHomeEnv = os.GetEnv("CODEX_HOME")
    if codexHomeEnv != "":
        return codexHomeEnv
    let homeEnv = os.GetEnv("HOME")
    if homeEnv != "":
        return home.RustCsgPathJoinChild(homeEnv, ".codex")
    return ""

fn RustCsgCliHandleLogin(args: str[]): int32 =
    var sub: str
    if args.len >= 3:
        sub = args[2]
    let codexHome = RustCsgCliGetCodexHome()
    if codexHome == "":
        echo("Not logged in")
        return 0

    if sub == "--api-key":
        echo("The --api-key flag is no longer supported. Pipe the key instead, e.g. `printenv OPENAI_API_KEY | codex login --with-api-key`.")
        return 1

    if sub == "--with-api-key":
        if RustCsgCliStdinIsTerminal() != 0:
            echo("--with-api-key expects the API key on stdin. Try piping it, e.g. `printenv OPENAI_API_KEY | codex login --with-api-key`.")
            return 1
        echo("Reading API key from stdin...")
        let apiKey = RustCsgCliTrimSecret(RustCsgCliReadStdin())
        if apiKey == "":
            echo("No API key provided via stdin.")
            return 1
        var content = "{\"auth_mode\":\"ApiKey\",\"openai_api_key\":\""
        content = strings.ConcatStr(content, apiKey)
        content = strings.ConcatStr(content, "\"}")
        let path = home.RustCsgPathJoinChild(codexHome, "auth.json")
        var wrote: int32 = auth.authWriteFile(path, content)
        if wrote == 0:
            echo("Error: failed to save auth.json")
            return 1
        echo("Login successful")
        return 0

    # login status
    if sub == "status" || sub == "":
        let path = home.RustCsgPathJoinChild(codexHome, "auth.json")
        # Read auth.json directly (LoadAuth has cold compiler struct issues)
        let raw = auth.authReadFile(path)
        if raw == "":
            echo("Not logged in")
            return 0
        # Parse auth mode from JSON
        var mode: str
        if strutil.Contains(raw, "\"auth_mode\":\"ApiKey\""):
            mode = "ApiKey"
        elif strutil.Contains(raw, "\"auth_mode\":\"Chatgpt\""):
            mode = "Chatgpt"
        if mode == "":
            echo("Not logged in")
            return 0
        echo(strutil.Join(["Auth mode: ", mode], ""))
        # Show masked API key
        var keyLen: int32
        var ks: int32
        var found: bool
        for i in 0..<strings.Len(raw):
            if strings.Len(raw) - i >= 19:
                if raw[i] == '"' && raw[i+1] == 'o' && raw[i+2] == 'p' && raw[i+3] == 'e' && raw[i+4] == 'n':
                    ks = i + 19
                    while ks + keyLen < strings.Len(raw) && raw[ks + keyLen] != '"':
                        keyLen = keyLen + 1
                    if keyLen > 8:
                        found = true
                    break
        if found:
            var masked = strings.SliceBytes(raw, ks, 4)
            masked = strutil.Join([masked, "****"], "")
            masked = strutil.Join([masked, strings.SliceBytes(raw, ks + keyLen - 4, 4)], "")
            echo(strutil.Join(["API key: ", masked], ""))
        return 0

    echo(strutil.Join(["Unknown login subcommand: ", sub], ""))
    return 1

fn RustCsgCliHandleLogout(args: str[]): int32 =
    let codexHome = RustCsgCliGetCodexHome()
    if codexHome == "":
        echo("Logged out")
        return 0
    let path = home.RustCsgPathJoinChild(codexHome, "auth.json")
    auth.authRemoveFile(path)
    echo("Logged out")
    return 0

fn RustCsgCliPrintHelp() =
    echo("Usage: codex [OPTIONS] [PROMPT]")
    echo("       codex [OPTIONS] <COMMAND> [ARGS]")
    echo("")
    echo("Commands:")
    echo("  exec [options] [<prompt>]     Execute a prompt")
    echo("  review [options]              Run a code review")
    echo("  resume [options] [session]    Resume an interactive session")
    echo("  fork [options] [session]      Fork an interactive session")
    echo("  completion [shell]            Generate shell completion script")
    echo("  features <list|enable|disable> Inspect feature flags")
    echo("  app-server                    Start the app server")
    echo("  config <show|get|set>        Manage configuration")
    echo("  login [status]               Show login status")
    echo("  login --with-api-key         Login with API key from stdin")
    echo("  logout                       Log out")
    echo("")
    echo("Arguments:")
    echo("  [PROMPT]                     Optional user prompt to start the session")
    echo("")
    echo("Options:")
    echo("  --model, -m <name>           Set the model name")
    echo("  --cwd, -C, --cd <path>       Set working directory")
    echo("  --profile, -p <name>         Set profile name")
    echo("  --config, -c <key=val>       Set config override")
    echo("  --color <auto|always|never>  Set color mode")
    echo("  --json                       Enable JSON output")
    echo("  --ask-for-approval, -a <mode> Configure command approval policy")
    echo("  --search                     Enable live web search")
    echo("  --no-alt-screen              Disable alternate screen mode")
    echo("  --dangerously-bypass-approvals-and-sandbox  Disable approval and sandbox protections")
    echo("  --resume [session-id]        Resume a session")
    echo("  --skip-git-repo-check        Skip git repo check")
    echo("  --help, -h                   Show this help")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var args: str[]
    let count = cmdline.paramCount()
    for i in 0..<count:
        add(args, cmdline.paramStr(i))

    if RustCsgCliIsExecCommand(args):
        return RustCsgCliRunExec(args)

    if RustCsgCliIsReviewCommand(args):
        return RustCsgCliRunReview(args)

    if RustCsgCliIsResumeCommand(args):
        return RustCsgCliRunTuiSessionCommand(args, "resume")

    if RustCsgCliIsForkCommand(args):
        return RustCsgCliRunTuiSessionCommand(args, "fork")

    if RustCsgCliIsCompletionCommand(args):
        return RustCsgCliRunCompletion(args)

    if RustCsgCliIsFeaturesCommand(args):
        return RustCsgCliRunFeatures(args)

    if RustCsgCliIsAppServerCommand(args):
        return RustCsgCliHandleAppServer(args)

    if RustCsgCliIsConfigCommand(args):
        return RustCsgCliHandleConfig(args)

    if RustCsgCliIsLoginCommand(args):
        return RustCsgCliHandleLogin(args)

    if RustCsgCliIsLogoutCommand(args):
        return RustCsgCliHandleLogout(args)

    if args.len >= 2 && args[1] == "help":
        RustCsgCliPrintHelp()
        return 0

    var unportedCommand: str
    if RustCsgCliFindKnownUnportedCommand(args, unportedCommand):
        echo(strutil.Join(["codex ", unportedCommand, " runtime not ported"], ""))
        return 78

    let config = cli.RustCsgParseCliArgs(args)

    if config.version:
        echo("codex 0.0.0")
        return 0

    if config.help:
        RustCsgCliPrintHelp()
        return 0

    if config.parseError != "":
        echo(config.parseError)
        return 1

    if config.resumeSessionId != "":
        let execArgs = RustCsgCliRootArgsToExecArgs(args, "")
        return RustCsgCliRunExec(execArgs)

    # Interactive mode: when stdin is piped, read it as the prompt and forward to exec.
    # When stdin is a terminal, start an interactive read-eval loop.
    let isTerminal = RustCsgCliStdinIsTerminal() != 0
    if !isTerminal:
        let stdinPrompt = RustCsgCliReadStdin()
        if stdinPrompt != "":
            let execArgs = RustCsgCliRootArgsToExecArgs(args, stdinPrompt)
            return RustCsgCliRunExec(execArgs)
        echo("No input provided via stdin.")
        return 78

    # Terminal interactive mode: prompt, read line, exec, repeat
    echo("codex CLI interactive mode")
    echo("Enter your prompt (empty line to exit):")
    while true:
        let line = RustCsgCliReadLine()
        if line == "":
            break
        let execArgs = RustCsgCliRootArgsToExecArgs(args, line)
        let result = RustCsgCliRunExec(execArgs)
        if result != 0:
            return result
    return 0
