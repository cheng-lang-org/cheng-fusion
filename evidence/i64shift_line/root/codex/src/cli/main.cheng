fn RustCsgCliPrintResumeHelp() =
    echo("Usage: codex resume [OPTIONS] [SESSION_ID]")
    echo("")
    echo("Options:")
    echo("  --last                       Continue the most recent session")
    echo("  --all                        Show all sessions")
    echo("  --include-non-interactive    Include non-interactive sessions")
    echo("  --help, -h                   Show this help")

fn RustCsgCliPrintForkHelp() =
