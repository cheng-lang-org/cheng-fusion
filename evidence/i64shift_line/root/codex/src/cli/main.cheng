    echo("  --last                       Fork the most recent session")
    echo("  --all                        Show all sessions")
    echo("  --help, -h                   Show this help")

fn RustCsgCliTuiAppendSequenceToken(stream: str, token: str): str =
    if stream == "":
        return token
    return strings.ConcatStr(strings.ConcatStr(stream, "|"), token)

fn RustCsgCliTuiSequenceStopsRootPicker(token: str): bool =
    if strings.Len(token) != 1:
        return false
    let code = Int32(token[0])
    return code == 10 || code == 13 || code == 27 || code == 3

fn RustCsgCliReadTuiTerminalSequence(maxTokens: int32): str =
    var stream: str
    var count: int32
    while count < maxTokens:
        let token = tui_terminal.TerminalReadKeySequence()
        if token == "":
            return stream
        stream = RustCsgCliTuiAppendSequenceToken(stream, token)
        if RustCsgCliTuiSequenceStopsRootPicker(token):
            return stream
        count = count + 1
    return stream

fn RustCsgCliRunTuiSessionCommand(args: str[], command: str): int32 =
    let plan = tui_session_command.RustCsgCliTuiSessionCommandParse(args, command)
    if plan.showHelp:
        if command == "resume":
            RustCsgCliPrintResumeHelp()
        else:
            RustCsgCliPrintForkHelp()
        return 0
    if !plan.ok:
        echo(plan.error)
        return 1
    var pickerSequence = os.GetEnv("CODEX_TUI_SESSION_PICKER_SEQUENCE")
    var cwdPromptSequence = os.GetEnv("CODEX_TUI_SESSION_CWD_PROMPT_SEQUENCE")
    if plan.sessionId == "" && pickerSequence == "":
        pickerSequence = RustCsgCliReadTuiTerminalSequence(64)
        if pickerSequence == "":
            echo("TUI picker input required")
            return 1
    var result = tui_session_runtime.RustCsgCliTuiSessionRuntimeRunArgsFromEnvironment(args,
                                                                                       command,
                                                                                       pickerSequence,
                                                                                       cwdPromptSequence)
    if !result.ok && result.error == "cwd prompt sequence required after prompt_required" && cwdPromptSequence == "":
        cwdPromptSequence = RustCsgCliReadTuiTerminalSequence(8)
        if cwdPromptSequence == "":
            echo("TUI cwd prompt input required")
            return 1
        result = tui_session_runtime.RustCsgCliTuiSessionRuntimeRunArgsFromEnvironment(args,
                                                                                       command,
                                                                                       pickerSequence,
                                                                                       cwdPromptSequence)
    if !result.ok:
        echo(result.error)
        return result.exitCode
    if result.outcome == "picker_idle":
        echo("TUI picker input required")
        return 1
    if result.outcome == "prompt_required":
        echo("TUI cwd prompt input required")
        return 1
    echo(tui_session_runtime.RustCsgCliTuiSessionRuntimeResultToJson(result))
    return result.exitCode

fn RustCsgCliCanonicalKnownUnportedCommand(command: str): str =
    if command == "a":
        return "apply"
    if command == "cloud-tasks":
        return "cloud"
    return command

fn RustCsgCliIsKnownUnportedCommand(command: str): bool =
    return command == "mcp" || command == "plugin" ||
           command == "mcp-server" || command == "remote-control" ||
           command == "app" || command == "update" ||
           command == "doctor" || command == "sandbox" ||
           command == "debug" || command == "execpolicy" ||
           command == "apply" || command == "a" ||
           command == "cloud" || command == "cloud-tasks" ||
           command == "responses-api-proxy" || command == "stdio-to-uds" ||
           command == "exec-server"

fn RustCsgCliFindKnownUnportedCommand(args: str[], outCommand: var str): bool =
    outCommand = ""
    var i: int32 = 1
    while i < args.len:
        let arg = args[i]
        if arg == "--":
            return false
        if cli.RustCsgCliIsFlag(arg):
            var value: str
            var nextIndex: int32
            if cli.RustCsgCliReadNextArg(args, i, "--model", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-m", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--cwd", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-C", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--cd", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--profile", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-p", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--config", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-c", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--color", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "--ask-for-approval", value, nextIndex) ||
               cli.RustCsgCliReadNextArg(args, i, "-a", value, nextIndex):
                i = nextIndex + 1
                continue
            if arg == "--json" || arg == "--experimental-json" || arg == "--search" ||
               arg == "--no-alt-screen" || arg == "--skip-git-repo-check" ||
               arg == "--dangerously-bypass-approvals-and-sandbox" || arg == "--yolo" ||
               arg == "--help" || arg == "-h" || arg == "--version" || arg == "-V":
                i = i + 1
                continue
            return false
        if RustCsgCliIsKnownUnportedCommand(arg):
            outCommand = RustCsgCliCanonicalKnownUnportedCommand(arg)
            return true
        return false
    return false

fn RustCsgCliIsCompletionCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "completion"

fn RustCsgCliRunCompletion(args: str[]): int32 =
    var shell: str = "bash"
    if args.len >= 3:
        shell = args[2]
    if args.len > 3:
        echo("Usage: codex completion [bash|fish|zsh]")
        return 1
    let script = cli.cliGenerateCompletion("codex", shell)
    if script == "":
        echo(strutil.Join(["invalid shell: ", shell], ""))
        return 1
    echo(script)
    return 0

