fn RustCsgCliIsExecCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "exec" || args[1] == "e"

fn RustCsgCliPrintExecHelp() =
    echo("Usage: codex exec [options] [<prompt>]")
    echo("")
    echo("Options:")
    echo("  --model, -m <name>            Set the model name")
    echo("  --resume <session-id>         Resume a previous session")
    echo("  --last                        Resume the most recent session")
    echo("  --review                      Review uncommitted changes (cannot use with --resume)")
    echo("  --json                        Enable JSON output")
    echo("  --help, -h                    Show this help")

fn RustCsgCliRunExec(args: str[]): int32 =
    var p = exec_plan.RustCsgExecParseArgs(args)
    if p.parseError != "":
        echo(p.parseError)
        return 1
    if p.help:
        RustCsgCliPrintExecHelp()
        return 0

    if p.resumeSessionId != "":
        echo(strutil.Join(["Resuming session: ", p.resumeSessionId], ""))
    elif p.resumeLast:
        echo("Resuming last session")

    var requestPlan: exec_session.RustCsgExecRequestPlan
    exec_session.RustCsgExecRequestPlanFromPlanWithEnvironmentInto(p, "", requestPlan)
    if requestPlan.parseError != "":
        echo(requestPlan.parseError)
        return 1
    if requestPlan.blockedReason != "":
        echo(requestPlan.blockedReason)
        return 1

    let json = exec_session.RustCsgExecRequestPlanToJson(requestPlan)
    if p.appServerUrl != "":
        return exec_run.ExecRunStart(p.appServerUrl, json)
    echo(json)
    return 0

fn RustCsgCliIsReviewCommand(args: str[]): bool =
    if args.len < 2:
        return false
    return args[1] == "review"

fn RustCsgCliRunReview(args: str[]): int32 =
    var execArgs: str[]
    add(execArgs, args[0])
    add(execArgs, "exec")
    add(execArgs, "review")
    for i in 2..<args.len:
        add(execArgs, args[i])
    return RustCsgCliRunExec(execArgs)

