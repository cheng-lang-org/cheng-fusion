import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/exec/plan
import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite
import cheng/codex/state/thread_store
import std/rawmem_support

@abi_internal
@importc("RustCsgNormalizePathRelativeToCurrentDir")
fn RustCsgNormalizePathRelativeToCurrentDir(path: str): str

@abi_internal
@importc("RustCsgRealPath")
fn RustCsgRealPath(path: str): str

@importc("calloc")
fn RustCsgExecResumeSqliteCalloc(count: int64, size: int64): ptr

type
    RustCsgExecResumeSqliteResult =
        ok: bool
        threadId: str
        responseJson: str
        error: str
        blockedReason: str

fn RustCsgExecResumeSqliteStableStr(value: str): str =
    if value == "":
        return ""
    let raw = RustCsgExecResumeSqliteCalloc(int64(value.len) + int64(1), int64(1))
    if raw == nil:
        return ""
    var i: int32
    while i < value.len:
        rawmem_support.RawmemWriteI8(raw, i, Int8(int32(value[i]) & 255))
        i = i + 1
    var out: str
    out.data = raw
    out.len = value.len
    return out

fn RustCsgExecResumeSqliteError(message: str): RustCsgExecResumeSqliteResult =
    var result: RustCsgExecResumeSqliteResult
    result.error = RustCsgExecResumeSqliteStableStr(message)
    return result

fn RustCsgExecResumeSqliteBlocked(message: str): RustCsgExecResumeSqliteResult =
    var result: RustCsgExecResumeSqliteResult
    result.blockedReason = RustCsgExecResumeSqliteStableStr(message)
    return result

fn RustCsgExecResumeSqliteOk(threadId: str): RustCsgExecResumeSqliteResult =
    var result: RustCsgExecResumeSqliteResult
    result.ok = true
    result.threadId = RustCsgExecResumeSqliteStableStr(threadId)
    result.responseJson = "{}"
    return result

fn RustCsgExecResumeSqliteSetError(outResult: var RustCsgExecResumeSqliteResult, message: str) =
    outResult = RustCsgExecResumeSqliteResult()
    outResult.error = RustCsgExecResumeSqliteStableStr(message)

fn RustCsgExecResumeSqliteSetBlocked(outResult: var RustCsgExecResumeSqliteResult, message: str) =
    outResult = RustCsgExecResumeSqliteResult()
    outResult.blockedReason = RustCsgExecResumeSqliteStableStr(message)

fn RustCsgExecResumeSqliteSetOk(outResult: var RustCsgExecResumeSqliteResult, threadId: str) =
    outResult = RustCsgExecResumeSqliteResult()
    outResult.ok = true
    outResult.threadId = RustCsgExecResumeSqliteStableStr(threadId)
    outResult.responseJson = "{}"

fn RustCsgExecResumeSqliteHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return 1
    if ch >= 'a' && ch <= 'f':
        return 1
    if ch >= 'A' && ch <= 'F':
        return 1
    return 0

fn RustCsgExecResumeSqliteIsUuid(value: str): bool =
    if value.len != 36:
        return false
    var i: int32
    while i < value.len:
        let ch = value[i]
        if i == 8 || i == 13 || i == 18 || i == 23:
            if ch != '-':
                return false
        elif RustCsgExecResumeSqliteHexValue(ch) == 0:
            return false
        i = i + 1
    return true

fn RustCsgExecResumeSqliteLookupFromParams(dbPath: str,
                                           params: var types.RustCsgThreadListParams,
                                           configModelProviderId: str,
                                           emptyReason: str): RustCsgExecResumeSqliteResult =
    var listResult = thread_list_sqlite.RustCsgThreadListFromSqlite(dbPath, params, configModelProviderId)
    if listResult.error != "":
        return RustCsgExecResumeSqliteError(listResult.error)
    if !listResult.ok:
        return RustCsgExecResumeSqliteBlocked(listResult.blockedReason)
    if listResult.rowCount < 1:
        return RustCsgExecResumeSqliteBlocked(emptyReason)

    var result: RustCsgExecResumeSqliteResult
    result.ok = true
    let responseJson = wire.RustCsgThreadListResponseToJson(listResult.response)
    let dataJson = listResult.response.dataJson
    let threadId = wire.RustCsgJsonFindStr(dataJson, "id")
    result.responseJson = RustCsgExecResumeSqliteStableStr(responseJson)
    result.threadId = RustCsgExecResumeSqliteStableStr(threadId)
    return result

fn RustCsgExecResumeSqliteLookupMatchingFromParams(dbPath: str,
                                                   params: var types.RustCsgThreadListParams,
                                                   configModelProviderId: str,
                                                   expectedName: str,
                                                   requireExactName: bool,
                                                   emptyReason: str): RustCsgExecResumeSqliteResult =
    let plan = thread_list_sqlite.RustCsgThreadListSqlitePlanFromParams(params, configModelProviderId)
    if plan.parseError != "":
        return RustCsgExecResumeSqliteBlocked(plan.parseError)
    var cwdFilterError: str
    let cwdFilterValue = thread_list_sqlite.RustCsgThreadListSqliteCwdFilterValue(plan.cwdFiltersJson,
                                                                                  cwdFilterError)
    if cwdFilterError != "":
        return RustCsgExecResumeSqliteBlocked(cwdFilterError)
    var modelProviderError: str
    let modelProvidersJson = thread_list_sqlite.RustCsgThreadListSqliteValidateModelProvidersJson(plan.modelProviderFilterJson,
                                                                                                  modelProviderError)
    if modelProviderError != "":
        return RustCsgExecResumeSqliteBlocked(modelProviderError)
    if plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteAllInteractiveSourcesJson() &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("cli") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("vscode") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("exec") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("mcp") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("unknown") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("subagent") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("subagent_review") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("subagent_compact") &&
       plan.allowedSourcesJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("subagent_thread_spawn") &&
       plan.allowedSourcesJson != "[]":
        return RustCsgExecResumeSqliteBlocked("thread/list sqlite source execution only supports concrete sourceKind SQL slices: subAgentOther post-filter not ported")

    var cursorMillisText: str
    while true:
        var pageRows = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwd(dbPath,
                                                                                           plan.sortKey,
                                                                                           plan.sortDirection,
                                                                                           plan.archived,
                                                                                           plan.allowedSourcesJson,
                                                                                           modelProvidersJson,
                                                                                           cwdFilterValue,
                                                                                           plan.searchTerm,
                                                                                           cursorMillisText,
                                                                                           plan.pageSize + 1)
        if !pageRows.ok:
            return RustCsgExecResumeSqliteError(pageRows.error)

        var consumedRows: int32
        var lastIncludedSortValue: int64
        for i in 0..<pageRows.rows.len:
            var row = pageRows.rows[i]
            if !row.ok:
                return RustCsgExecResumeSqliteError(row.error)
            if consumedRows >= plan.pageSize:
                break
            lastIncludedSortValue = thread_list_sqlite.RustCsgThreadListSqliteSortValueFromStateRow(row, plan.sortKey)
            consumedRows = consumedRows + 1
            if !requireExactName || row.title == expectedName:
                return RustCsgExecResumeSqliteResultFromStateRow(row)

        if pageRows.rows.len <= plan.pageSize:
            return RustCsgExecResumeSqliteBlocked(emptyReason)
        let nextCursorMillisText = thread_list_sqlite.RustCsgRfc3339ToMillisText(thread_list_sqlite.RustCsgThreadListSqliteCursor(lastIncludedSortValue))
        if nextCursorMillisText == "":
            return RustCsgExecResumeSqliteError("resume sqlite pagination cursor conversion failed")
        cursorMillisText = nextCursorMillisText

fn RustCsgExecResumeSqliteResultFromStateRow(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): RustCsgExecResumeSqliteResult =
    var response: types.RustCsgThreadListResponse
    response.dataJson = wire.RustCsgCat3("[",
                                         wire.RustCsgAppThreadToJson(thread_list_sqlite.RustCsgThreadListSqliteThreadFromStateRow(row)),
                                         "]")
    var result: RustCsgExecResumeSqliteResult
    result.ok = true
    result.responseJson = RustCsgExecResumeSqliteStableStr(wire.RustCsgThreadListResponseToJson(response))
    let rowId = row.id
    result.threadId = RustCsgExecResumeSqliteStableStr(rowId)
    return result

fn RustCsgExecResumeSqliteResultFromStateRowInto(row: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                                 outResult: var RustCsgExecResumeSqliteResult) =
    var response: types.RustCsgThreadListResponse
    response.dataJson = wire.RustCsgCat3("[",
                                         wire.RustCsgAppThreadToJson(thread_list_sqlite.RustCsgThreadListSqliteThreadFromStateRow(row)),
                                         "]")
    let responseJson = wire.RustCsgThreadListResponseToJson(response)
    let rowId = row.id
    outResult = RustCsgExecResumeSqliteResult()
    outResult.ok = true
    outResult.responseJson = RustCsgExecResumeSqliteStableStr(responseJson)
    outResult.threadId = RustCsgExecResumeSqliteStableStr(rowId)

fn RustCsgExecResumeSqlitePathsMatchAfterNormalization(left: str, right: str): bool =
    if left == "" || right == "":
        return false
    let realLeft = RustCsgRealPath(left)
    let realRight = RustCsgRealPath(right)
    if realLeft != "" && realRight != "":
        return realLeft == realRight
    return left == right

fn RustCsgExecResumeSqliteRowCwdMatches(row: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                        expectedCwd: str): bool =
    if expectedCwd == "":
        return true
    let rolloutPath = wire.RustCsgCat(row.rolloutPath, "")
    var rowCwd = reader.RustCsgRolloutLatestTurnCwd(rolloutPath)
    if rowCwd == "":
        rowCwd = wire.RustCsgCat(row.cwd, "")
    if rowCwd == "":
        return false
    let normalizedRowCwd = RustCsgNormalizePathRelativeToCurrentDir(rowCwd)
    if normalizedRowCwd == "":
        return false
    return RustCsgExecResumeSqlitePathsMatchAfterNormalization(expectedCwd, normalizedRowCwd)

fn RustCsgExecResumeSqliteDbParentDir(dbPath: str): str =
    var i: int32
    i = dbPath.len - 1
    while i >= 0:
        if dbPath[i] == '/':
            if i == 0:
                return "/"
            return wire.RustCsgSliceBytes(dbPath, 0, i)
        i = i - 1
    return ""

fn RustCsgExecResumeSqliteSessionMetaCwdMatchResult(row: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                                    expectedCwd: str): RustCsgExecResumeSqliteResult =
    let sessionCwd = reader.RustCsgRolloutLatestSessionMetaCwd(row.rolloutPath)
    if sessionCwd == "":
        return RustCsgExecResumeSqliteBlocked("session_index rollout session_meta missing")
    if expectedCwd == "":
        return RustCsgExecResumeSqliteOk(row.id)
    let normalizedSessionCwd = RustCsgNormalizePathRelativeToCurrentDir(sessionCwd)
    if normalizedSessionCwd == "":
        return RustCsgExecResumeSqliteBlocked("session_index rollout session_meta cwd invalid")
    if !RustCsgExecResumeSqlitePathsMatchAfterNormalization(expectedCwd, normalizedSessionCwd):
        return RustCsgExecResumeSqliteBlocked("session_index cwd mismatch")
    return RustCsgExecResumeSqliteOk(row.id)

fn RustCsgExecResumeSqliteSessionIndexEntryByName(dbPath: str,
                                                  entry: var types.RustCsgSessionIndexEntry,
                                                  expectedName: str,
                                                  expectedCwd: str,
                                                  outMatchedName: var bool): RustCsgExecResumeSqliteResult =
    outMatchedName = false
    if thread_store.RustCsgSessionIndexEntryEmpty(entry):
        return RustCsgExecResumeSqliteBlocked("session_index entry is empty")
    if entry.threadName != expectedName:
        return RustCsgExecResumeSqliteBlocked("session_index name not matched")
    outMatchedName = true
    var row = state_db_sqlite.RustCsgStateDbThreadById(dbPath, entry.id)
    if row.error != "":
        return RustCsgExecResumeSqliteError(row.error)
    if row.notFound:
        return RustCsgExecResumeSqliteBlocked("session_index thread id not in state db")
    let cwdMatch = RustCsgExecResumeSqliteSessionMetaCwdMatchResult(row, expectedCwd)
    if !cwdMatch.ok:
        return cwdMatch
    return RustCsgExecResumeSqliteResultFromStateRow(row)

fn RustCsgExecResumeSqliteSessionIndexByName(dbPath: str,
                                              sessionId: str,
                                              expectedCwd: str): RustCsgExecResumeSqliteResult =
    if sessionId == "":
        return RustCsgExecResumeSqliteBlocked("session_index name is empty")
    let codexHome = RustCsgExecResumeSqliteDbParentDir(dbPath)
    if codexHome == "":
        return RustCsgExecResumeSqliteBlocked("cannot derive codex home from db path")
    var loadError: str
    let text = thread_store.RustCsgSessionIndexLoadText(codexHome, loadError)
    if loadError != "":
        return RustCsgExecResumeSqliteError(loadError)
    if text == "":
        return RustCsgExecResumeSqliteBlocked("session_index name not found")
    var sawMatchingName: bool
    var foundLoadable: bool
    var best: RustCsgExecResumeSqliteResult
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let line = wire.RustCsgSliceBytes(text, lineStart, pos - lineStart)
                var entry: types.RustCsgSessionIndexEntry
                thread_store.RustCsgSessionIndexParseLineInto(line, entry)
                if !thread_store.RustCsgSessionIndexEntryEmpty(entry):
                    if foundLoadable && entry.id == best.threadId && entry.threadName != sessionId:
                        foundLoadable = false
                        best.ok = false
                        best.threadId = ""
                        best.responseJson = ""
                        best.error = ""
                        best.blockedReason = ""
                    if entry.threadName == sessionId:
                        sawMatchingName = true
                        var matchedName: bool
                        var candidate = RustCsgExecResumeSqliteSessionIndexEntryByName(dbPath,
                                                                                       entry,
                                                                                       sessionId,
                                                                                       expectedCwd,
                                                                                       matchedName)
                        if candidate.error != "":
                            return candidate
                        if candidate.ok:
                            let candidateThreadId = candidate.threadId
                            let candidateResponseJson = candidate.responseJson
                            let candidateError = candidate.error
                            let candidateBlockedReason = candidate.blockedReason
                            foundLoadable = true
                            best.ok = candidate.ok
                            best.threadId = RustCsgExecResumeSqliteStableStr(candidateThreadId)
                            best.responseJson = RustCsgExecResumeSqliteStableStr(candidateResponseJson)
                            best.error = RustCsgExecResumeSqliteStableStr(candidateError)
                            best.blockedReason = RustCsgExecResumeSqliteStableStr(candidateBlockedReason)
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let line = wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart)
        var entry: types.RustCsgSessionIndexEntry
        thread_store.RustCsgSessionIndexParseLineInto(line, entry)
        if !thread_store.RustCsgSessionIndexEntryEmpty(entry):
            if foundLoadable && entry.id == best.threadId && entry.threadName != sessionId:
                foundLoadable = false
                best.ok = false
                best.threadId = ""
                best.responseJson = ""
                best.error = ""
                best.blockedReason = ""
            if entry.threadName == sessionId:
                sawMatchingName = true
                var matchedName: bool
                var candidate = RustCsgExecResumeSqliteSessionIndexEntryByName(dbPath,
                                                                               entry,
                                                                               sessionId,
                                                                               expectedCwd,
                                                                               matchedName)
                if candidate.error != "":
                    return candidate
                if candidate.ok:
                    let candidateThreadId = candidate.threadId
                    let candidateResponseJson = candidate.responseJson
                    let candidateError = candidate.error
                    let candidateBlockedReason = candidate.blockedReason
                    foundLoadable = true
                    best.ok = candidate.ok
                    best.threadId = RustCsgExecResumeSqliteStableStr(candidateThreadId)
                    best.responseJson = RustCsgExecResumeSqliteStableStr(candidateResponseJson)
                    best.error = RustCsgExecResumeSqliteStableStr(candidateError)
                    best.blockedReason = RustCsgExecResumeSqliteStableStr(candidateBlockedReason)
    if foundLoadable:
        return best
    if sawMatchingName:
        return RustCsgExecResumeSqliteBlocked("session_index matched no loadable thread")
    return RustCsgExecResumeSqliteBlocked("session_index name not found")

fn RustCsgExecResumeSqliteSessionIndexByNameInto(dbPath: str,
                                                 sessionId: str,
                                                 expectedCwd: str,
                                                 outResult: var RustCsgExecResumeSqliteResult) =
    outResult = RustCsgExecResumeSqliteResult()
    var result = RustCsgExecResumeSqliteSessionIndexByName(dbPath,
                                                           sessionId,
                                                           expectedCwd)
    let resultThreadId = result.threadId
    let resultResponseJson = result.responseJson
    let resultError = result.error
    let resultBlockedReason = result.blockedReason
    outResult.ok = result.ok
    outResult.threadId = RustCsgExecResumeSqliteStableStr(resultThreadId)
    outResult.responseJson = RustCsgExecResumeSqliteStableStr(resultResponseJson)
    outResult.error = RustCsgExecResumeSqliteStableStr(resultError)
    outResult.blockedReason = RustCsgExecResumeSqliteStableStr(resultBlockedReason)

fn RustCsgExecResumeSqliteLookupLastFromParams(dbPath: str,
                                               params: var types.RustCsgThreadListParams,
                                               configModelProviderId: str,
                                               emptyReason: str): RustCsgExecResumeSqliteResult =
    var cwdFilterError: str
    let expectedCwdParsed = thread_list_sqlite.RustCsgThreadListSqliteCwdFilterValue(params.cwdJson,
                                                                                     cwdFilterError)
    if cwdFilterError != "":
        return RustCsgExecResumeSqliteBlocked(cwdFilterError)
    let expectedCwd = wire.RustCsgCat(expectedCwdParsed, "")
    var modelProviderError: str
    let modelProvidersJson = thread_list_sqlite.RustCsgThreadListSqliteValidateModelProvidersJson(params.modelProvidersJson,
                                                                                                  modelProviderError)
    if modelProviderError != "":
        return RustCsgExecResumeSqliteBlocked(modelProviderError)
    if configModelProviderId == "":
        return RustCsgExecResumeSqliteBlocked("resume --last requires config model provider id")
    if modelProvidersJson != thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne(configModelProviderId):
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite only supports the active config model provider")

    var sortKey = params.sortKey
    if sortKey == "":
        sortKey = "updated_at"
    var sortDirection = params.sortDirection
    if sortDirection == "":
        sortDirection = "desc"
    if sortKey != "updated_at" || sortDirection != "desc":
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite only supports updated_at desc")
    if params.searchTerm != "":
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite search term not ported")
    if params.cursor != "":
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite cursor not ported")
    if params.archivedJson != "" && params.archivedJson != "false":
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite archived lookup not ported")
    if params.sourceKindsJson != "" &&
       params.sourceKindsJson != thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson():
        return RustCsgExecResumeSqliteBlocked("resume --last sqlite source filter not ported")

    let allowedSourcesJson = thread_list_sqlite.RustCsgThreadListSqliteAllInteractiveSourcesJson()
    var offset: int32
    while true:
        var row = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                                             sortKey,
                                                                             sortDirection,
                                                                             false,
                                                                             offset,
                                                                             allowedSourcesJson,
                                                                             configModelProviderId,
                                                                             "",
                                                                             "",
                                                                             "")
        if row.error != "":
            return RustCsgExecResumeSqliteError(row.error)
        if row.notFound:
            return RustCsgExecResumeSqliteBlocked(emptyReason)
        if !row.ok:
            return RustCsgExecResumeSqliteError("resume sqlite candidate query returned no row")
        var stableRow = row
        if expectedCwd != "":
            stableRow = state_db_sqlite.RustCsgStateDbThreadById(dbPath, row.id)
            if stableRow.error != "":
                return RustCsgExecResumeSqliteError(stableRow.error)
            if !stableRow.ok:
                return RustCsgExecResumeSqliteError("resume sqlite candidate disappeared during by-id reload")
        if RustCsgExecResumeSqliteRowCwdMatches(stableRow, expectedCwd):
            return RustCsgExecResumeSqliteResultFromStateRow(stableRow)
        offset = offset + 1

fn RustCsgExecResumeSqliteCwdFilter(execPlan: var plan.RustCsgExecPlan,
                                    requireCwd: bool,
                                    outBlockedReason: var str): str =
    outBlockedReason = ""
    if !requireCwd:
        return ""
    if execPlan.cwd == "":
        outBlockedReason = "resume sqlite lookup requires canonical absolute cwd"
        return ""
    if wire.RustCsgContains(execPlan.cwd, "\"") || wire.RustCsgContains(execPlan.cwd, "\\"):
        outBlockedReason = "resume sqlite lookup cwd escaping not ported"
        return ""
    let normalizedCwd = RustCsgNormalizePathRelativeToCurrentDir(execPlan.cwd)
    if normalizedCwd == "" || !thread_list_sqlite.RustCsgThreadListSqliteCanonicalAbsolutePath(normalizedCwd):
        outBlockedReason = "resume sqlite lookup requires canonical absolute cwd"
        return ""
    let realCwd = RustCsgRealPath(normalizedCwd)
    if realCwd == "":
        outBlockedReason = "resume sqlite lookup cwd canonicalize failed: existing path required"
        return ""
    return realCwd

fn RustCsgExecResumeLastFromSqlite(dbPath: str,
                                   execPlan: var plan.RustCsgExecPlan,
                                   configModelProviderId: str): RustCsgExecResumeSqliteResult =
    if execPlan.parseError != "":
        return RustCsgExecResumeSqliteBlocked(execPlan.parseError)
    if execPlan.command != "resume":
        return RustCsgExecResumeSqliteBlocked("resume sqlite lookup requires exec resume command")
    if execPlan.resumeLast && configModelProviderId == "":
        return RustCsgExecResumeSqliteBlocked("resume --last requires config model provider id")
    if !execPlan.resumeLast:
        if execPlan.resumeSessionId == "":
            return RustCsgExecResumeSqliteBlocked("resume sqlite lookup requires --last or explicit session id")
        if RustCsgExecResumeSqliteIsUuid(execPlan.resumeSessionId):
            var explicitResult: RustCsgExecResumeSqliteResult
            let resumeSessionId = execPlan.resumeSessionId
            explicitResult.ok = true
            explicitResult.threadId = RustCsgExecResumeSqliteStableStr(resumeSessionId)
            explicitResult.responseJson = "{}"
            return explicitResult

    var cwdBlockedReason: str
    let cwdFilter = RustCsgExecResumeSqliteCwdFilter(execPlan, !execPlan.resumeAll, cwdBlockedReason)
    if cwdBlockedReason != "":
        return RustCsgExecResumeSqliteBlocked(cwdBlockedReason)

    var params: types.RustCsgThreadListParams
    params.limitJson = "100"
    params.sortKey = "updated_at"
    params.sortDirection = "desc"
    params.archivedJson = "false"
    params.sourceKindsJson = thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson()
    if cwdFilter != "":
        params.cwdJson = wire.RustCsgJsonQuote(cwdFilter)

    if execPlan.resumeLast:
        params.modelProvidersJson = thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne(configModelProviderId)
        return RustCsgExecResumeSqliteLookupLastFromParams(dbPath,
                                                           params,
                                                           configModelProviderId,
                                                           "resume --last found no thread")

    var exactTitle = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath,
                                                                            execPlan.resumeSessionId,
                                                                            cwdFilter)
    if exactTitle.error != "":
        return RustCsgExecResumeSqliteError(exactTitle.error)
    if exactTitle.ok:
        return RustCsgExecResumeSqliteResultFromStateRow(exactTitle)

    let sessionIndexResult = RustCsgExecResumeSqliteSessionIndexByName(dbPath,
                                                                        execPlan.resumeSessionId,
                                                                        cwdFilter)
    if sessionIndexResult.error != "":
        return sessionIndexResult
    if sessionIndexResult.ok:
        return sessionIndexResult
    if sessionIndexResult.blockedReason != "" &&
       sessionIndexResult.blockedReason != "session_index name not found":
        return RustCsgExecResumeSqliteBlocked("explicit resume name found no thread")

    params.modelProvidersJson = "[]"
    params.searchTerm = execPlan.resumeSessionId
    return RustCsgExecResumeSqliteLookupMatchingFromParams(dbPath,
                                                           params,
                                                           configModelProviderId,
                                                           execPlan.resumeSessionId,
                                                           true,
                                                           "explicit resume name found no thread")

fn RustCsgExecResumeLastFromSqliteInto(dbPath: str,
                                       execPlan: var plan.RustCsgExecPlan,
                                       configModelProviderId: str,
                                       outResult: var RustCsgExecResumeSqliteResult) =
    outResult = RustCsgExecResumeSqliteResult()
    if execPlan.parseError != "":
        RustCsgExecResumeSqliteSetBlocked(outResult, execPlan.parseError)
        return
    if execPlan.command != "resume":
        RustCsgExecResumeSqliteSetBlocked(outResult, "resume sqlite lookup requires exec resume command")
        return
    if execPlan.resumeLast && configModelProviderId == "":
        RustCsgExecResumeSqliteSetBlocked(outResult, "resume --last requires config model provider id")
        return
    if !execPlan.resumeLast:
        if execPlan.resumeSessionId == "":
            RustCsgExecResumeSqliteSetBlocked(outResult, "resume sqlite lookup requires --last or explicit session id")
            return
        if RustCsgExecResumeSqliteIsUuid(execPlan.resumeSessionId):
            let resumeSessionId = execPlan.resumeSessionId
            RustCsgExecResumeSqliteSetOk(outResult, resumeSessionId)
            return

    var cwdBlockedReason: str
    let cwdFilter = RustCsgExecResumeSqliteCwdFilter(execPlan, !execPlan.resumeAll, cwdBlockedReason)
    if cwdBlockedReason != "":
        RustCsgExecResumeSqliteSetBlocked(outResult, cwdBlockedReason)
        return

    var params: types.RustCsgThreadListParams
    params.limitJson = "100"
    params.sortKey = "updated_at"
    params.sortDirection = "desc"
    params.archivedJson = "false"
    params.sourceKindsJson = thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson()
    if cwdFilter != "":
        params.cwdJson = wire.RustCsgJsonQuote(cwdFilter)

    if execPlan.resumeLast:
        params.modelProvidersJson = thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne(configModelProviderId)
        var lastResult = RustCsgExecResumeSqliteLookupLastFromParams(dbPath,
                                                                     params,
                                                                     configModelProviderId,
                                                                     "resume --last found no thread")
        outResult.ok = lastResult.ok
        let lastThreadId = lastResult.threadId
        let lastResponseJson = lastResult.responseJson
        let lastError = lastResult.error
        let lastBlockedReason = lastResult.blockedReason
        outResult.threadId = RustCsgExecResumeSqliteStableStr(lastThreadId)
        outResult.responseJson = RustCsgExecResumeSqliteStableStr(lastResponseJson)
        outResult.error = RustCsgExecResumeSqliteStableStr(lastError)
        outResult.blockedReason = RustCsgExecResumeSqliteStableStr(lastBlockedReason)
        return

    var exactTitle = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath,
                                                                            execPlan.resumeSessionId,
                                                                            cwdFilter)
    if exactTitle.error != "":
        RustCsgExecResumeSqliteSetError(outResult, exactTitle.error)
        return
    if exactTitle.ok:
        RustCsgExecResumeSqliteResultFromStateRowInto(exactTitle, outResult)
        return

    var sessionIndexResult: RustCsgExecResumeSqliteResult
    RustCsgExecResumeSqliteSessionIndexByNameInto(dbPath,
                                                  execPlan.resumeSessionId,
                                                  cwdFilter,
                                                  sessionIndexResult)
    if sessionIndexResult.error != "":
        RustCsgExecResumeSqliteSetError(outResult, sessionIndexResult.error)
        return
    if sessionIndexResult.ok:
        outResult.ok = true
        let sessionThreadId = sessionIndexResult.threadId
        let sessionResponseJson = sessionIndexResult.responseJson
        outResult.threadId = RustCsgExecResumeSqliteStableStr(sessionThreadId)
        outResult.responseJson = RustCsgExecResumeSqliteStableStr(sessionResponseJson)
        return
    RustCsgExecResumeSqliteSetBlocked(outResult, "explicit resume name found no thread")
