import cheng/codex/config/home
import cheng/codex/config/user_config
import cheng/codex/exec/config
import cheng/codex/exec/operation
import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup
import cheng/codex/exec/schema
import cheng/codex/protocol/wire

type
    RustCsgExecRequestPlan =
        kind: str
        threadId: str
        threadStartJson: str
        threadResumeJson: str
        turnStartJson: str
        reviewStartJson: str
        requestSequenceJson: str
        parseError: str
        blockedReason: str

fn RustCsgExecJsonAppendComma(out: var str, first: var bool) =
    if first:
        first = false
    else:
        out = wire.RustCsgCat(out, ",")

fn RustCsgExecJsonAppendStr(out: var str, first: var bool, key: str, value: str) =
    RustCsgExecJsonAppendComma(out, first)
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr(key, value))

fn RustCsgExecJsonAppendRaw(out: var str, first: var bool, key: str, value: str) =
    RustCsgExecJsonAppendComma(out, first)
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw(key, value))

fn RustCsgExecJsonAppendOptionalStr(out: var str, first: var bool, key: str, value: str) =
    if value != "":
        RustCsgExecJsonAppendStr(out, first, key, value)

fn RustCsgExecJsonAppendOptionalRaw(out: var str, first: var bool, key: str, value: str) =
    if value != "":
        RustCsgExecJsonAppendRaw(out, first, key, value)

fn RustCsgExecEffectiveStringOverride(execPlan: var plan.RustCsgExecPlan,
                                      key: str,
                                      outError: var str): str =
    return config.RustCsgExecConfigOverrideStringForKey(execPlan, key, outError)

fn RustCsgExecUserConfigString(userConfigJson: str, field: str): str =
    if userConfigJson == "":
        return ""
    return wire.RustCsgJsonFindOptionalStr(userConfigJson, field)

fn RustCsgExecSelectedProfileOverrideFromPlan(execPlan: var plan.RustCsgExecPlan,
                                             outError: var str): str =
    outError = ""
    if execPlan.configProfile != "":
        return execPlan.configProfile
    return config.RustCsgExecConfigOverrideStringForKey(execPlan, "profile", outError)

fn RustCsgExecDefaultModelForOssProvider(provider: str): str =
    if provider == "lmstudio":
        return "openai/gpt-oss-20b"
    if provider == "ollama":
        return "gpt-oss:20b"
    return ""

fn RustCsgExecEffectiveModelFromPlan(execPlan: var plan.RustCsgExecPlan,
                                     outError: var str): str =
    return RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                   userConfigJson: str,
                                                   outError: var str): str =
    outError = ""
    if execPlan.model != "":
        return execPlan.model
    let overrideModel = RustCsgExecEffectiveStringOverride(execPlan, "model", outError)
    if outError != "" || overrideModel != "":
        return overrideModel
    if execPlan.oss:
        let provider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan,
                                                                               userConfigJson,
                                                                               outError)
        if outError != "":
            return ""
        let defaultModel = RustCsgExecDefaultModelForOssProvider(provider)
        if defaultModel != "":
            return defaultModel
    return RustCsgExecUserConfigString(userConfigJson, "model")

fn RustCsgExecEffectiveCwdFromPlan(execPlan: var plan.RustCsgExecPlan,
                                   outError: var str): str =
    outError = ""
    if execPlan.cwd != "":
        return execPlan.cwd
    return RustCsgExecEffectiveStringOverride(execPlan, "cwd", outError)

fn RustCsgExecEffectiveModelProviderFromPlan(execPlan: var plan.RustCsgExecPlan,
                                             outError: var str): str =
    return RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                           userConfigJson: str,
                                                           outError: var str): str =
    outError = ""
    if execPlan.ossProvider != "":
        return execPlan.ossProvider
    var provider = config.RustCsgExecConfigOverrideStringForKey(execPlan, "local_provider", outError)
    if outError != "" || provider != "":
        return provider
    provider = config.RustCsgExecConfigOverrideStringForKey(execPlan, "oss_provider", outError)
    if outError != "" || provider != "":
        return provider
    if execPlan.oss:
        provider = RustCsgExecUserConfigString(userConfigJson, "ossProvider")
        if provider != "":
            return provider
    provider = config.RustCsgExecConfigOverrideStringForKey(execPlan, "model_provider", outError)
    if outError != "" || provider != "":
        return provider
    provider = config.RustCsgExecConfigOverrideStringForKey(execPlan, "model_provider_id", outError)
    if outError != "" || provider != "":
        return provider
    if !execPlan.oss:
        return RustCsgExecUserConfigString(userConfigJson, "modelProvider")
    return ""

fn RustCsgExecApprovalPolicyValueValid(value: str): bool =
    if value == "untrusted" || value == "on-failure" || value == "on-request":
        return true
    return value == "never"

fn RustCsgExecApprovalPolicyJsonFromPlan(execPlan: var plan.RustCsgExecPlan,
                                         outError: var str): str =
    outError = ""
    let value = config.RustCsgExecConfigOverrideStringForKey(execPlan, "approval_policy", outError)
    if outError != "":
        return ""
    if value == "":
        return "\"never\""
    if !RustCsgExecApprovalPolicyValueValid(value):
        outError = wire.RustCsgCat("invalid approval_policy config override: ", value)
        return ""
    return wire.RustCsgJsonQuote(value)

fn RustCsgExecApprovalsReviewerCanonical(value: str): str =
    if value == "user":
        return "user"
    if value == "guardian_subagent" || value == "auto_review":
        return "guardian_subagent"
    return ""

fn RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                      userConfigJson: str,
                                                      outError: var str): str =
    outError = ""
    let overrideReviewer = config.RustCsgExecConfigOverrideStringForKey(execPlan,
                                                                        "approvals_reviewer",
                                                                        outError)
    if outError != "":
        return ""
    if overrideReviewer != "":
        let canonicalOverride = RustCsgExecApprovalsReviewerCanonical(overrideReviewer)
        if canonicalOverride == "":
            outError = wire.RustCsgCat("invalid approvals_reviewer config override: ", overrideReviewer)
            return ""
        return canonicalOverride
    let userReviewer = RustCsgExecUserConfigString(userConfigJson, "approvalsReviewer")
    if userReviewer != "":
        let canonicalUser = RustCsgExecApprovalsReviewerCanonical(userReviewer)
        if canonicalUser == "":
            outError = wire.RustCsgCat("invalid approvals_reviewer config value: ", userReviewer)
            return ""
        return canonicalUser
    return "user"

fn RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                    userConfigJson: str,
                                                    outError: var str): str =
    outError = ""
    var profileId = config.RustCsgExecConfigOverrideStringForKey(execPlan,
                                                                 "default_permissions",
                                                                 outError)
    if outError != "":
        return ""
    if profileId == "":
        profileId = RustCsgExecUserConfigString(userConfigJson, "defaultPermissions")
    if profileId == "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "profile"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", profileId))
    if execPlan.addDirs.len > 0:
        out = wire.RustCsgCat(out, ",\"modifications\":[")
        for i in 0..<execPlan.addDirs.len:
            if i > 0:
                out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, "{\"type\":\"additionalWritableRoot\",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", execPlan.addDirs[i]))
            out = wire.RustCsgCat(out, "}")
        out = wire.RustCsgCat(out, "]")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecUserConfigSemanticError(userConfigJson: str): str =
    let approval = RustCsgExecUserConfigString(userConfigJson, "approvalPolicy")
    if approval != "" && !RustCsgExecApprovalPolicyValueValid(approval):
        return wire.RustCsgCat("invalid approval_policy config value: ", approval)
    let reviewer = RustCsgExecUserConfigString(userConfigJson, "approvalsReviewer")
    if reviewer != "" && RustCsgExecApprovalsReviewerCanonical(reviewer) == "":
        return wire.RustCsgCat("invalid approvals_reviewer config value: ", reviewer)
    let sandbox = RustCsgExecUserConfigString(userConfigJson, "sandboxMode")
    if sandbox != "" && !RustCsgExecSandboxValueValid(sandbox):
        return wire.RustCsgCat("invalid sandbox_mode config value: ", sandbox)
    return ""

fn RustCsgExecWebSearchValueValid(value: str): bool =
    if value == "live" || value == "cached" || value == "disabled":
        return true
    return false

fn RustCsgExecSandboxValueValid(value: str): bool =
    if value == "read-only" || value == "workspace-write":
        return true
    return value == "danger-full-access"

fn RustCsgExecSandboxJsonFromPlan(execPlan: var plan.RustCsgExecPlan,
                                  outError: var str): str =
    return RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                userConfigJson: str,
                                                outError: var str): str =
    outError = ""
    if execPlan.removedFullAuto:
        return "\"workspace-write\""
    if execPlan.dangerouslyBypassApprovalsAndSandbox:
        return "\"danger-full-access\""
    if execPlan.sandbox != "":
        if !RustCsgExecSandboxValueValid(execPlan.sandbox):
            outError = wire.RustCsgCat("invalid --sandbox value: ", execPlan.sandbox)
            return ""
        return wire.RustCsgJsonQuote(execPlan.sandbox)
    var sandbox = config.RustCsgExecConfigFirstStringOverride(execPlan, "sandbox", "sandbox_mode", outError)
    if outError != "":
        return ""
    if sandbox != "" && !RustCsgExecSandboxValueValid(sandbox):
        outError = wire.RustCsgCat("invalid sandbox_mode config override: ", sandbox)
        return ""
    if sandbox != "":
        return wire.RustCsgJsonQuote(sandbox)
    sandbox = RustCsgExecUserConfigString(userConfigJson, "sandboxMode")
    if sandbox == "":
        return ""
    if !RustCsgExecSandboxValueValid(sandbox):
        outError = wire.RustCsgCat("invalid sandbox_mode config value: ", sandbox)
        return ""
    return wire.RustCsgJsonQuote(sandbox)

fn RustCsgExecEphemeralJsonFromPlan(execPlan: var plan.RustCsgExecPlan,
                                    outError: var str): str =
    outError = ""
    if execPlan.ephemeral:
        return "true"
    let valueJson = config.RustCsgExecConfigOverrideBoolJsonForKey(execPlan, "ephemeral", outError)
    if outError != "":
        return ""
    if valueJson != "":
        return valueJson
    return "false"

fn RustCsgExecConfigSemanticErrorFromPlan(execPlan: var plan.RustCsgExecPlan): str =
    return RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                        userConfigJson: str): str =
    let userConfigError = RustCsgExecUserConfigSemanticError(userConfigJson)
    if userConfigError != "":
        return userConfigError
    var err: str
    RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    if err != "":
        return err
    RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    if err != "":
        return err
    RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEphemeralJsonFromPlan(execPlan, err)
    if err != "":
        return err
    let webSearch = config.RustCsgExecConfigOverrideStringForKey(execPlan, "web_search", err)
    if err != "":
        return err
    if webSearch != "" && !RustCsgExecWebSearchValueValid(webSearch):
        return wire.RustCsgCat("invalid web_search config override: ", webSearch)
    config.RustCsgExecConfigProfileJsonFromPlan(execPlan, err)
    if err != "":
        return err
    return ""

fn RustCsgExecBlockedReasonFromPlan(execPlan: var plan.RustCsgExecPlan): str =
    return RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                  userConfigJson: str): str =
    var err: str
    let provider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    err
    if execPlan.oss && provider == "":
        return "OSS provider resolution from config not ported"
    let configBlocked = config.RustCsgExecConfigOverridesBlockedReason(execPlan)
    if configBlocked != "":
        return configBlocked
    return ""

fn RustCsgExecThreadStartParamsJsonFromPlan(execPlan: var plan.RustCsgExecPlan): str =
    return RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                          userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let model = RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let modelProvider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    let approvalsReviewer = RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let permissionsJson = RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    var sandboxJson: str
    if permissionsJson == "":
        sandboxJson = RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let configJson = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let ephemeralJson = RustCsgExecEphemeralJsonFromPlan(execPlan, err)
    err
    RustCsgExecJsonAppendOptionalStr(out, first, "model", model)
    RustCsgExecJsonAppendOptionalStr(out, first, "modelProvider", modelProvider)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendStr(out, first, "approvalsReviewer", approvalsReviewer)
    RustCsgExecJsonAppendOptionalRaw(out, first, "sandbox", sandboxJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "permissions", permissionsJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "config", configJson)
    RustCsgExecJsonAppendRaw(out, first, "ephemeral", ephemeralJson)
    RustCsgExecJsonAppendRaw(out, first, "sessionStartSource", "\"cli\"")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecThreadResumeParamsJsonFromPlan(execPlan: var plan.RustCsgExecPlan, threadId: str): str =
    return RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan, threadId, "")

fn RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                           threadId: str,
                                                           userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let model = RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let modelProvider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    let approvalsReviewer = RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let permissionsJson = RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    var sandboxJson: str
    if permissionsJson == "":
        sandboxJson = RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let configJson = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    err
    RustCsgExecJsonAppendStr(out, first, "threadId", threadId)
    RustCsgExecJsonAppendOptionalStr(out, first, "model", model)
    RustCsgExecJsonAppendOptionalStr(out, first, "modelProvider", modelProvider)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendStr(out, first, "approvalsReviewer", approvalsReviewer)
    RustCsgExecJsonAppendOptionalRaw(out, first, "sandbox", sandboxJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "permissions", permissionsJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "config", configJson)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecTurnStartParamsJsonFromPlan(execPlan: var plan.RustCsgExecPlan,
                                          threadId: str,
                                          inputJson: str,
                                          outputSchemaJson: str): str =
    return RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan, threadId, inputJson, outputSchemaJson, "")

fn RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                        threadId: str,
                                                        inputJson: str,
                                                        outputSchemaJson: str,
                                                        userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    err
    RustCsgExecJsonAppendStr(out, first, "threadId", threadId)
    RustCsgExecJsonAppendRaw(out, first, "input", inputJson)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "outputSchema", outputSchemaJson)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                      userConfigJson: str,
                                                      outError: var str): str =
    outError = ""
    let configJson = config.RustCsgExecConfigProfileJsonFromPlan(execPlan, outError)
    if outError != "" || configJson != "":
        return configJson
    let profile = RustCsgExecUserConfigString(userConfigJson, "profile")
    if profile == "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("profile", profile))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecReviewStartParamsJson(threadId: str, reviewTargetJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("target", reviewTargetJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecRequestEntryJson(method: str, paramsJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", method))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("params", paramsJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecBuildStartUserTurnSequence(threadStartJson: str, turnStartJson: str): str =
    var out = "["
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("thread/start", threadStartJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("turn/start", turnStartJson))
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgExecBuildResumeUserTurnSequence(threadResumeJson: str, turnStartJson: str): str =
    var out = "["
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("thread/resume", threadResumeJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("turn/start", turnStartJson))
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgExecBuildReviewSequence(threadStartJson: str, reviewStartJson: str): str =
    var out = "["
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("thread/start", threadStartJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecRequestEntryJson("review/start", reviewStartJson))
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgExecRequestPlanFromPlan(execPlan: var plan.RustCsgExecPlan,
                                  threadId: str): RustCsgExecRequestPlan =
    return RustCsgExecRequestPlanFromPlanWithUserConfig(execPlan, threadId, "")

fn RustCsgExecRequestPlanFromPlanWithUserConfig(execPlan: var plan.RustCsgExecPlan,
                                                threadId: str,
                                                userConfigJson: str): RustCsgExecRequestPlan =
    var out: RustCsgExecRequestPlan
    RustCsgExecRequestPlanFromPlanWithUserConfigInto(execPlan, threadId, userConfigJson, out)
    return out

fn RustCsgExecRequestPlanFromPlanWithUserConfigInto(execPlan: var plan.RustCsgExecPlan,
                                                    threadId: str,
                                                    userConfigJson: str,
                                                    outResult: var RustCsgExecRequestPlan) =
    outResult.threadId = threadId
    if execPlan.parseError != "":
        outResult.parseError = execPlan.parseError
        return
    let configParseError = config.RustCsgExecConfigOverridesParseError(execPlan)
    if configParseError != "":
        outResult.parseError = configParseError
        return
    let configSemanticError = RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan, userConfigJson)
    if configSemanticError != "":
        outResult.parseError = configSemanticError
        return
    let configBlockedReason = RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan, userConfigJson)
    if configBlockedReason != "":
        outResult.blockedReason = configBlockedReason
    var initial: operation.RustCsgExecInitialOperation
    operation.RustCsgExecInitialOperationFromPlanInto(execPlan, initial)
    if initial.parseError != "":
        outResult.parseError = initial.parseError
        return
    if initial.blockedReason != "":
        outResult.blockedReason = initial.blockedReason
    var resolvedResumeThreadId: str
    if initial.kind == "resumeUserTurn":
        var providerError: str
        let configModelProviderId = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan,
                                                                                            userConfigJson,
                                                                                            providerError)
        if providerError != "":
            outResult.parseError = providerError
            return
        var lookupPlan: resume_lookup.RustCsgExecResumeLookupPlan
        resume_lookup.RustCsgExecResumeLookupPlanFromExecPlanInto(execPlan,
                                                                  configModelProviderId,
                                                                  lookupPlan)
        if lookupPlan.parseError != "":
            outResult.parseError = lookupPlan.parseError
            return
        if lookupPlan.kind != "explicitId":
            outResult.blockedReason = lookupPlan.blockedReason
            return
        resolvedResumeThreadId = lookupPlan.directThreadId
    var outputSchemaJson: str
    if initial.kind == "userTurn" || initial.kind == "resumeUserTurn":
        var schemaError: str
        outputSchemaJson = schema.RustCsgExecLoadOutputSchemaJson(execPlan.outputSchema, schemaError)
        if schemaError != "":
            outResult.parseError = schemaError
            return
    if initial.kind == "userTurn":
        outResult.kind = "startUserTurn"
        outResult.threadStartJson = RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan, userConfigJson)
        outResult.turnStartJson = RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan, threadId, initial.inputJson, outputSchemaJson, userConfigJson)
        outResult.requestSequenceJson = RustCsgExecBuildStartUserTurnSequence(outResult.threadStartJson, outResult.turnStartJson)
        return
    if initial.kind == "resumeUserTurn":
        outResult.kind = "resumeUserTurn"
        outResult.threadResumeJson = RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan, resolvedResumeThreadId, userConfigJson)
        outResult.turnStartJson = RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan, resolvedResumeThreadId, initial.inputJson, outputSchemaJson, userConfigJson)
        outResult.requestSequenceJson = RustCsgExecBuildResumeUserTurnSequence(outResult.threadResumeJson, outResult.turnStartJson)
        return
    if initial.kind == "review":
        outResult.kind = "review"
        outResult.threadStartJson = RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan, userConfigJson)
        outResult.reviewStartJson = RustCsgExecReviewStartParamsJson(threadId, initial.reviewTargetJson)
        outResult.requestSequenceJson = RustCsgExecBuildReviewSequence(outResult.threadStartJson, outResult.reviewStartJson)
        return
    outResult.parseError = wire.RustCsgCat("unsupported exec initial operation: ", initial.kind)

fn RustCsgExecRequestPlanFromPlanWithCodexHome(execPlan: var plan.RustCsgExecPlan,
                                               threadId: str,
                                               codexHomePath: str): RustCsgExecRequestPlan =
    var out: RustCsgExecRequestPlan
    RustCsgExecRequestPlanFromPlanWithCodexHomeInto(execPlan, threadId, codexHomePath, out)
    return out

fn RustCsgExecRequestPlanFromPlanWithCodexHomeInto(execPlan: var plan.RustCsgExecPlan,
                                                   threadId: str,
                                                   codexHomePath: str,
                                                   outResult: var RustCsgExecRequestPlan) =
    var err: str
    let selectedProfile = RustCsgExecSelectedProfileOverrideFromPlan(execPlan, err)
    if err != "":
        outResult.threadId = threadId
        outResult.parseError = err
        return
    let userConfigJson = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath,
                                                                                       execPlan.ignoreUserConfig,
                                                                                       selectedProfile,
                                                                                       err)
    if err != "":
        outResult.threadId = threadId
        outResult.parseError = err
        return
    RustCsgExecRequestPlanFromPlanWithUserConfigInto(execPlan, threadId, userConfigJson, outResult)

fn RustCsgExecRequestPlanFromPlanWithEnvironment(execPlan: var plan.RustCsgExecPlan,
                                                 threadId: str): RustCsgExecRequestPlan =
    var out: RustCsgExecRequestPlan
    RustCsgExecRequestPlanFromPlanWithEnvironmentInto(execPlan, threadId, out)
    return out

fn RustCsgExecRequestPlanFromPlanWithEnvironmentInto(execPlan: var plan.RustCsgExecPlan,
                                                     threadId: str,
                                                     outResult: var RustCsgExecRequestPlan) =
    var codexHomePath: str
    var codexHomeError: str
    home.RustCsgFindCodexHomeInto(codexHomePath, codexHomeError)
    if codexHomeError != "":
        outResult.threadId = threadId
        outResult.parseError = wire.RustCsgCat("Error finding codex home: ", codexHomeError)
        return
    RustCsgExecRequestPlanFromPlanWithCodexHomeInto(execPlan, threadId, codexHomePath, outResult)

fn RustCsgExecRequestPlanToJson(requestPlan: var RustCsgExecRequestPlan): str =
    var sequenceJson = requestPlan.requestSequenceJson
    if sequenceJson == "":
        sequenceJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", requestPlan.kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", requestPlan.threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("requestSequence", sequenceJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", requestPlan.parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", requestPlan.blockedReason))
    out = wire.RustCsgCat(out, "}")
    return out
