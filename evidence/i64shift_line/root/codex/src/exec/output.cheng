# exec/output.cheng — Rich event output formatting for exec/run.cheng
#
# All functions return formatted str (no side effects).
# Only depends on std/strings (no codex modules).
# No use of strutil.Join (avoid cold compiler compatibility).
import std/strings

# ── Internal helpers ────────────────────────────────────────────

fn execOutputTruncate(text: str, maxLen: int32): str =
    if strings.Len(text) > maxLen:
        return strings.ConcatStr(strings.SliceBytes(text, 0, maxLen), "...")
    return text

fn execOutputIndentLines(text: str, indent: str): str =
    let n: int32 = strings.Len(text)
    if n == 0:
        return ""
    var out: str = ""
    var lineStart: int32 = 0
    var i: int32 = 0
    while i < n:
        if text[i] == '\n':
            let lineLen: int32 = i - lineStart
            if lineLen > 0:
                let line: str = strings.SliceBytes(text, lineStart, lineLen)
                out = strings.ConcatStr(strings.ConcatStr(out, indent), line)
            out = strings.ConcatStr(out, strings.CharToStr('\n'))
            lineStart = i + 1
        i = i + 1
    let remaining: int32 = n - lineStart
    if remaining > 0:
        let lastLine: str = strings.SliceBytes(text, lineStart, remaining)
        out = strings.ConcatStr(strings.ConcatStr(out, indent), lastLine)
    return out

# ── Color formatting ────────────────────────────────────────────────

fn ExecFormatColorGreen(text: str): str =
    if strings.Len(text) == 0:
        return ""
    return strings.ConcatStr(strings.ConcatStr("\x1b[32m", text), "\x1b[0m")

fn ExecFormatColorRed(text: str): str =
    if strings.Len(text) == 0:
        return ""
    return strings.ConcatStr(strings.ConcatStr("\x1b[31m", text), "\x1b[0m")

fn ExecFormatColorYellow(text: str): str =
    if strings.Len(text) == 0:
        return ""
    return strings.ConcatStr(strings.ConcatStr("\x1b[33m", text), "\x1b[0m")

# ── Tool call formatting ───────────────────────────────────────

fn ExecFormatToolCall(toolName: str, argsJson: str): str =
    if strings.Len(toolName) == 0:
        return "[tool] (unknown)"
    let namePart: str = strings.ConcatStr("[tool] ", toolName)
    if strings.Len(argsJson) == 0:
        return namePart
    let nl: str = strings.CharToStr('\n')
    let truncated: str = execOutputTruncate(argsJson, 200)
    return strings.ConcatStr(
        strings.ConcatStr(namePart, nl),
        strings.ConcatStr("   args: ", truncated)
    )

# ── Tool result/error formatting ───────────────────────────────

fn ExecFormatToolResult(toolName: str, resultText: str, isError: bool): str =
    if strings.Len(toolName) == 0:
        if isError:
            return "[tool] error"
        return "[tool] result"
    let namePart: str = strings.ConcatStr("[tool] ", toolName)
    if strings.Len(resultText) == 0:
        if isError:
            return strings.ConcatStr(namePart, " error")
        return namePart
    let truncated: str = execOutputTruncate(resultText, 200)
    if isError:
        let errPrefix: str = strings.ConcatStr(namePart, " error: ")
        return strings.ConcatStr(errPrefix, truncated)
    let colonPrefix: str = strings.ConcatStr(namePart, ": ")
    return strings.ConcatStr(colonPrefix, truncated)

# ── Review mode formatting ─────────────────────────────────────

fn ExecFormatReviewEntered(reviewTarget: str): str =
    if strings.Len(reviewTarget) == 0:
        return "[REVIEW] Reviewing"
    return strings.ConcatStr("[REVIEW] Reviewing: ", reviewTarget)

fn ExecFormatReviewExited(summary: str): str =
    if strings.Len(summary) == 0:
        return "[REVIEW] Review complete"
    return strings.ConcatStr("[REVIEW] Review complete: ", summary)

# ── Task formatting ────────────────────────────────────────────

fn ExecFormatTaskStarted(name: str, description: str): str =
    if strings.Len(name) == 0:
        if strings.Len(description) == 0:
            return "[TASK] started"
        return strings.ConcatStr("[TASK] ", description)
    if strings.Len(description) == 0:
        return strings.ConcatStr("[TASK] ", name)
    let a: str = strings.ConcatStr("[TASK] ", name)
    let b: str = strings.ConcatStr(a, ": ")
    return strings.ConcatStr(b, description)

fn ExecFormatTaskCompleted(name: str): str =
    if strings.Len(name) == 0:
        return "[TASK] done"
    let a: str = strings.ConcatStr("[TASK] ", name)
    return strings.ConcatStr(a, " done")

# ── Command formatting ─────────────────────────────────────────

fn ExecFormatCommandExec(command: str): str =
    if strings.Len(command) == 0:
        return "$"
    return strings.ConcatStr("$ ", command)

fn ExecFormatCommandOutput(output: str): str =
    return execOutputIndentLines(output, "  | ")

# ── Patch formatting ───────────────────────────────────────────

fn ExecFormatApplyPatch(file: str): str =
    if strings.Len(file) == 0:
        return "[PATCH] Applying changes"
    return strings.ConcatStr("[PATCH] Applying changes to ", file)

# ── Search formatting ──────────────────────────────────────────

fn ExecFormatSearch(query: str): str =
    if strings.Len(query) == 0:
        return "[SEARCH]"
    return strings.ConcatStr("[SEARCH] ", query)

# ── Thread/turn formatting ─────────────────────────────────────

fn ExecFormatThreadStarted(threadId: str): str =
    if strings.Len(threadId) == 0:
        return "# Thread"
    return strings.ConcatStr("# Thread: ", threadId)

fn ExecFormatTurnStarted(turnId: str): str =
    if strings.Len(turnId) == 0:
        return "## Turn"
    return strings.ConcatStr("## Turn: ", turnId)

fn ExecFormatTurnCompleted(turnId: str): str =
    if strings.Len(turnId) == 0:
        return "## Turn complete"
    return strings.ConcatStr("## Turn complete: ", turnId)

# ── Progress/time formatting ─────────────────────────────────────

fn ExecFormatElapsed(ms: int32): str =
    if ms < 1000:
        return strings.ConcatStr("(", strings.ConcatStr(strings.IntToStr(ms), "ms)"))
    if ms < 60000:
        let seconds: int32 = ms / 1000
        let tenths: int32 = (ms % 1000) / 100
        return strings.ConcatStr("(", strings.ConcatStr(strings.IntToStr(seconds), strings.ConcatStr(".", strings.ConcatStr(strings.IntToStr(tenths), "s)"))))
    let totalSec: int32 = ms / 1000
    let minutes: int32 = totalSec / 60
    let secs: int32 = totalSec % 60
    return strings.ConcatStr("(", strings.ConcatStr(strings.IntToStr(minutes), strings.ConcatStr("m", strings.ConcatStr(strings.IntToStr(secs), "s)"))))

fn ExecFormatProgress(current: int32, total: int32): str =
    if total == 0:
        return ""
    return strings.ConcatStr("[", strings.ConcatStr(strings.IntToStr(current), strings.ConcatStr("/", strings.ConcatStr(strings.IntToStr(total), "]"))))

fn ExecFormatAgentDelta(delta: str): str =
    return delta

fn ExecFormatSeparator(): str =
    return "---"

# ── Error formatting ────────────────────────────────────────────

fn ExecFormatError(message: str): str =
    return strings.ConcatStr("[ERROR] ", message)

fn ExecFormatHttpError(statusCode: int32, url: str): str =
    let codeStr: str = strings.IntToStr(statusCode)
    let prefix: str = strings.ConcatStr("[ERROR] HTTP ", codeStr)
    return strings.ConcatStr(prefix, strings.ConcatStr(" from ", url))

fn ExecFormatWarning(message: str): str =
    return strings.ConcatStr("[WARN] ", message)

fn ExecFormatEventCount(count: int32): str =
    return strings.ConcatStr("[events: ", strings.ConcatStr(strings.IntToStr(count), "]"))

fn ExecFormatConnectionError(url: str, detail: str): str =
    let prefix: str = strings.ConcatStr("[ERROR] Cannot connect to ", url)
    return strings.ConcatStr(prefix, strings.ConcatStr(": ", detail))

# ── Header formatting ───────────────────────────────────────────────

fn ExecFormatHeader(title: str): str =
    if strings.Len(title) == 0:
        return "=========="
    let a: str = strings.ConcatStr("=== ", title)
    return strings.ConcatStr(a, " ===")

# ── Summary formatting ──────────────────────────────────────────────

fn ExecFormatSummary(threadId: str, turnCount: int32, elapsedMs: int32): str =
    let elapsed: str = ExecFormatElapsed(elapsedMs)
    let a: str = strings.ConcatStr("--- Session Summary ---\n", "Thread: ")
    let b: str = strings.ConcatStr(a, threadId)
    let c: str = strings.ConcatStr(b, "\nTurns: ")
    let d: str = strings.ConcatStr(c, strings.IntToStr(turnCount))
    let e: str = strings.ConcatStr(d, "\nElapsed: ")
    return strings.ConcatStr(e, elapsed)

fn ExecFormatStats(deltaCount: int32, toolCount: int32, itemCount: int32, elapsedMs: int32): str =
    let a: str = strings.ConcatStr("[", strings.ConcatStr(strings.IntToStr(deltaCount), " deltas, "))
    let b: str = strings.ConcatStr(a, strings.ConcatStr(strings.IntToStr(toolCount), " tools, "))
    let c: str = strings.ConcatStr(b, strings.ConcatStr(strings.IntToStr(itemCount), " items in "))
    let d: str = strings.ConcatStr(c, strings.ConcatStr(strings.IntToStr(elapsedMs), "ms]"))
    return d
