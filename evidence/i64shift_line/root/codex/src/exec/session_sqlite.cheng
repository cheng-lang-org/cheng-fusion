import cheng/codex/exec/operation
import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/exec/schema
import cheng/codex/exec/session
import cheng/codex/protocol/wire

fn RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(execPlan: var plan.RustCsgExecPlan,
                                                         threadId: str,
                                                         userConfigJson: str,
                                                         dbPath: str): session.RustCsgExecRequestPlan =
    var initial: operation.RustCsgExecInitialOperation
    operation.RustCsgExecInitialOperationFromPlanInto(execPlan, initial)
    var shouldResolveViaSqlite: bool
    if initial.kind == "resumeUserTurn":
        if execPlan.resumeLast:
            shouldResolveViaSqlite = true
        elif execPlan.resumeSessionId != "":
            if !resume_lookup_sqlite.RustCsgExecResumeSqliteIsUuid(execPlan.resumeSessionId):
                shouldResolveViaSqlite = true
    if !shouldResolveViaSqlite:
        return session.RustCsgExecRequestPlanFromPlanWithUserConfig(execPlan, threadId, userConfigJson)

    var result: session.RustCsgExecRequestPlan
    result.threadId = threadId
    if execPlan.parseError != "":
        result.parseError = execPlan.parseError
        return result
    if initial.parseError != "":
        result.parseError = initial.parseError
        return result
    if dbPath == "" && execPlan.resumeLast:
        result.blockedReason = "resume --last sqlite lookup requires state db path"
        return result
    if dbPath == "":
        result.blockedReason = "explicit resume name sqlite lookup requires state db path"
        return result

    var providerError: str
    let modelProvider = session.RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan,
                                                                                       userConfigJson,
                                                                                       providerError)
    if providerError != "":
        result.parseError = providerError
        return result
    var lookup: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(dbPath,
                                                             execPlan,
                                                             modelProvider,
                                                             lookup)
    if lookup.error != "":
        result.parseError = lookup.error
        return result
    if !lookup.ok:
        result.blockedReason = lookup.blockedReason
        return result

    let configSemanticError = session.RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan,
                                                                                          userConfigJson)
    if configSemanticError != "":
        result.parseError = configSemanticError
        return result
    let configBlockedReason = session.RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan,
                                                                                     userConfigJson)
    if configBlockedReason != "":
        result.blockedReason = configBlockedReason

    var outputSchemaJson: str
    var schemaError: str
    outputSchemaJson = schema.RustCsgExecLoadOutputSchemaJson(execPlan.outputSchema, schemaError)
    if schemaError != "":
        result.parseError = schemaError
        return result

    result.kind = "resumeUserTurn"
    result.threadId = lookup.threadId
    result.threadResumeJson = session.RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan,
                                                                                              lookup.threadId,
                                                                                              userConfigJson)
    result.turnStartJson = session.RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan,
                                                                                       lookup.threadId,
                                                                                       initial.inputJson,
                                                                                       outputSchemaJson,
                                                                                       userConfigJson)
    result.requestSequenceJson = session.RustCsgExecBuildResumeUserTurnSequence(result.threadResumeJson,
                                                                                result.turnStartJson)
    if !wire.RustCsgContains(lookup.responseJson, wire.RustCsgJsonQuote(lookup.threadId)):
        result.parseError = "resume sqlite response did not contain resolved thread id"
    return result
