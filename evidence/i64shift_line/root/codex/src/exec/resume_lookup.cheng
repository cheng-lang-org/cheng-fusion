import cheng/codex/app_server/thread_list
import cheng/codex/exec/plan
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

type
    RustCsgExecResumeLookupPlan =
        kind: str
        method: str
        directThreadId: str
        threadListParamsJson: str
        threadListPlanJson: str
        parseError: str
        blockedReason: str

fn RustCsgExecResumeLookupJsonStringArrayOne(value: str): str =
    return wire.RustCsgCat3("[", wire.RustCsgJsonQuote(value), "]")

fn RustCsgExecResumeLookupHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return 1
    if ch >= 'a' && ch <= 'f':
        return 1
    if ch >= 'A' && ch <= 'F':
        return 1
    return 0

fn RustCsgExecResumeLookupIsUuid(value: str): bool =
    if value.len != 36:
        return false
    var i: int32
    while i < value.len:
        let ch = value[i]
        if i == 8 || i == 13 || i == 18 || i == 23:
            if ch != '-':
                return false
        elif RustCsgExecResumeLookupHexValue(ch) == 0:
            return false
        i = i + 1
    return true

fn RustCsgExecResumeLookupFillBaseThreadListParams(params: var types.RustCsgThreadListParams) =
    params.limitJson = "100"
    params.sortKey = "updated_at"
    params.sourceKindsJson = thread_list.RustCsgThreadListAllSourceKindsJson()
    params.archivedJson = "false"

fn RustCsgExecResumeLookupFillLastParams(params: var types.RustCsgThreadListParams,
                                         configModelProviderId: str) =
    RustCsgExecResumeLookupFillBaseThreadListParams(params)
    params.modelProvidersJson = RustCsgExecResumeLookupJsonStringArrayOne(configModelProviderId)

fn RustCsgExecResumeLookupFillNameParams(params: var types.RustCsgThreadListParams,
                                         sessionName: str) =
    RustCsgExecResumeLookupFillBaseThreadListParams(params)
    params.searchTerm = sessionName

fn RustCsgExecResumeLookupPlanFromParamsInto(kind: str,
                                             params: var types.RustCsgThreadListParams,
                                             fallbackProvider: str,
                                             blockedReason: str,
                                             result: var RustCsgExecResumeLookupPlan) =
    result = RustCsgExecResumeLookupPlan()
    result.kind = kind
    result.method = "thread/list"
    result.threadListParamsJson = wire.RustCsgThreadListParamsToJson(params)
    let listPlan = thread_list.RustCsgThreadListPlanFromParams(params, fallbackProvider)
    result.threadListPlanJson = thread_list.RustCsgThreadListPlanToJson(listPlan)
    if listPlan.parseError != "":
        result.parseError = listPlan.parseError
        return
    result.blockedReason = blockedReason

fn RustCsgExecResumeLookupPlanFromExecPlanInto(execPlan: var plan.RustCsgExecPlan,
                                               configModelProviderId: str,
                                               result: var RustCsgExecResumeLookupPlan) =
    result = RustCsgExecResumeLookupPlan()
    if execPlan.parseError != "":
        result.parseError = execPlan.parseError
        return
    if execPlan.command != "resume":
        result.parseError = "resume lookup requires exec resume command"
        return
    if execPlan.resumeLast:
        if configModelProviderId == "":
            result.kind = "last"
            result.blockedReason = "resume --last requires config model provider id before thread/list request planning"
            return
        var lastParams: types.RustCsgThreadListParams
        RustCsgExecResumeLookupFillLastParams(lastParams, configModelProviderId)
        RustCsgExecResumeLookupPlanFromParamsInto("last",
                                                  lastParams,
                                                  configModelProviderId,
                                                  "resume --last thread/list execution not ported",
                                                  result)
        return
    if execPlan.resumeSessionId == "":
        result.kind = "none"
        result.blockedReason = "resume lookup requires --last or explicit session id"
        return
    if RustCsgExecResumeLookupIsUuid(execPlan.resumeSessionId):
        result.kind = "explicitId"
        result.directThreadId = execPlan.resumeSessionId
        return
    var nameParams: types.RustCsgThreadListParams
    RustCsgExecResumeLookupFillNameParams(nameParams, execPlan.resumeSessionId)
    RustCsgExecResumeLookupPlanFromParamsInto("explicitName",
                                              nameParams,
                                              configModelProviderId,
                                              "explicit resume name thread/list execution not ported",
                                              result)

fn RustCsgExecResumeLookupPlanToJson(lookupPlan: var RustCsgExecResumeLookupPlan): str =
    var out = "{"
    var paramsJson = lookupPlan.threadListParamsJson
    if paramsJson == "":
        paramsJson = "null"
    var listPlanJson = lookupPlan.threadListPlanJson
    if listPlanJson == "":
        listPlanJson = "null"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", lookupPlan.kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", lookupPlan.method))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("directThreadId", lookupPlan.directThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", lookupPlan.parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", lookupPlan.blockedReason))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadListParams", paramsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadListPlan", listPlanJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecResumeLookupJson(kind: str,
                               method: str,
                               directThreadId: str,
                               paramsJson: str,
                               listPlanJson: str,
                               parseError: str,
                               blockedReason: str): str =
    var safeParamsJson = paramsJson
    if safeParamsJson == "":
        safeParamsJson = "null"
    var safeListPlanJson = listPlanJson
    if safeListPlanJson == "":
        safeListPlanJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", method))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("directThreadId", directThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", blockedReason))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadListParams", safeParamsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("threadListPlan", safeListPlanJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecResumeLookupJsonFromParams(kind: str,
                                         params: var types.RustCsgThreadListParams,
                                         fallbackProvider: str,
                                         blockedReason: str): str =
    let paramsJson = wire.RustCsgThreadListParamsToJson(params)
    let listPlan = thread_list.RustCsgThreadListPlanFromParams(params, fallbackProvider)
    let listPlanJson = thread_list.RustCsgThreadListPlanToJson(listPlan)
    if listPlan.parseError != "":
        return RustCsgExecResumeLookupJson(kind, "thread/list", "", paramsJson, listPlanJson, listPlan.parseError, "")
    return RustCsgExecResumeLookupJson(kind, "thread/list", "", paramsJson, listPlanJson, "", blockedReason)

fn RustCsgExecResumeLookupJsonFromExecPlan(execPlan: var plan.RustCsgExecPlan,
                                           configModelProviderId: str): str =
    if execPlan.parseError != "":
        return RustCsgExecResumeLookupJson("", "", "", "", "", execPlan.parseError, "")
    if execPlan.command != "resume":
        return RustCsgExecResumeLookupJson("", "", "", "", "", "resume lookup requires exec resume command", "")
    if execPlan.resumeLast:
        if configModelProviderId == "":
            return RustCsgExecResumeLookupJson("last",
                                               "",
                                               "",
                                               "",
                                               "",
                                               "",
                                               "resume --last requires config model provider id before thread/list request planning")
        var lastParams: types.RustCsgThreadListParams
        RustCsgExecResumeLookupFillLastParams(lastParams, configModelProviderId)
        return RustCsgExecResumeLookupJsonFromParams("last",
                                                     lastParams,
                                                     configModelProviderId,
                                                     "resume --last thread/list execution not ported")
    if execPlan.resumeSessionId == "":
        return RustCsgExecResumeLookupJson("none",
                                           "",
                                           "",
                                           "",
                                           "",
                                           "",
                                           "resume lookup requires --last or explicit session id")
    if RustCsgExecResumeLookupIsUuid(execPlan.resumeSessionId):
        return RustCsgExecResumeLookupJson("explicitId",
                                           "",
                                           execPlan.resumeSessionId,
                                           "",
                                           "",
                                           "",
                                           "")
    var nameParams: types.RustCsgThreadListParams
    RustCsgExecResumeLookupFillNameParams(nameParams, execPlan.resumeSessionId)
    return RustCsgExecResumeLookupJsonFromParams("explicitName",
                                                 nameParams,
                                                 configModelProviderId,
                                                 "explicit resume name thread/list execution not ported")
