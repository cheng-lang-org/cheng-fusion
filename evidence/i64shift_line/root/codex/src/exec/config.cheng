import cheng/codex/exec/plan
import cheng/codex/protocol/wire

fn RustCsgExecConfigIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn RustCsgExecConfigTrim(raw: str): str =
    if raw.len == 0:
        return ""
    var start: int32
    while start < raw.len && RustCsgExecConfigIsSpace(raw[start]):
        start = start + 1
    if start >= raw.len:
        return ""
    var stop: int32
    stop = raw.len
    while stop > start && RustCsgExecConfigIsSpace(raw[stop - 1]):
        stop = stop - 1
    return wire.RustCsgSliceBytes(raw, start, stop - start)

fn RustCsgExecConfigFindEquals(raw: str): int32 =
    for i in 0..<raw.len:
        if raw[i] == '=':
            return i
    return -1

fn RustCsgExecConfigCanonicalKey(key: str): str =
    if key == "use_legacy_landlock":
        return "features.use_legacy_landlock"
    return key

fn RustCsgExecConfigOverrideKey(raw: str, outError: var str): str =
    outError = ""
    let eq = RustCsgExecConfigFindEquals(raw)
    if eq <= 0:
        outError = wire.RustCsgCat("invalid config override: ", raw)
        return ""
    let key = RustCsgExecConfigTrim(wire.RustCsgSliceBytes(raw, 0, eq))
    if key == "":
        outError = wire.RustCsgCat("empty config override key: ", raw)
        return ""
    return RustCsgExecConfigCanonicalKey(key)

fn RustCsgExecConfigOverrideRawValue(raw: str, outError: var str): str =
    outError = ""
    let eq = RustCsgExecConfigFindEquals(raw)
    if eq <= 0:
        outError = wire.RustCsgCat("invalid config override: ", raw)
        return ""
    return RustCsgExecConfigTrim(wire.RustCsgSliceBytes(raw, eq + 1, raw.len - eq - 1))

fn RustCsgExecConfigIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn RustCsgExecConfigIsNumber(raw: str): bool =
    if raw.len == 0:
        return false
    var start: int32
    if raw[0] == '-':
        if raw.len == 1:
            return false
        start = 1
    var sawDigit: bool
    var sawDot: bool
    for i in start..<raw.len:
        let ch = raw[i]
        if RustCsgExecConfigIsDigit(ch):
            sawDigit = true
        elif ch == '.':
            if sawDot:
                return false
            sawDot = true
        else:
            return false
    return sawDigit

fn RustCsgExecConfigIsSafeBareChar(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '-' || ch == '_' || ch == '.' || ch == '/' || ch == ':' || ch == '@'

fn RustCsgExecConfigIsSafeBareString(raw: str): bool =
    if raw.len == 0:
        return false
    for i in 0..<raw.len:
        if !RustCsgExecConfigIsSafeBareChar(raw[i]):
            return false
    return true

fn RustCsgExecConfigQuotedValue(raw: str, quote: char, outError: var str): str =
    outError = ""
    if raw.len < 2 || raw[raw.len - 1] != quote:
        outError = wire.RustCsgCat("unterminated config override string: ", raw)
        return ""
    let inner = wire.RustCsgSliceBytes(raw, 1, raw.len - 2)
    for i in 0..<inner.len:
        let ch = inner[i]
        if ch == '\\' || ch == '"' || ch == '\n' || ch == '\r' || ch == '\t':
            outError = "config override string escaping not ported"
            return ""
    return wire.RustCsgJsonQuote(inner)

fn RustCsgExecConfigValueJsonFromRaw(rawValue: str, outError: var str): str =
    outError = ""
    let value = RustCsgExecConfigTrim(rawValue)
    if value == "":
        outError = "empty config override value"
        return ""
    if value == "true" || value == "false" || value == "null":
        return value
    if RustCsgExecConfigIsNumber(value):
        return value
    if value[0] == '"':
        return RustCsgExecConfigQuotedValue(value, '"', outError)
    if value[0] == '\'':
        return RustCsgExecConfigQuotedValue(value, '\'', outError)
    if value[0] == '[' || value[0] == '{':
        outError = "complex TOML config override values not ported"
        return ""
    if RustCsgExecConfigIsSafeBareString(value):
        return wire.RustCsgJsonQuote(value)
    outError = wire.RustCsgCat("unsupported config override value: ", value)
    return ""

fn RustCsgExecConfigOverrideValueJson(raw: str, outError: var str): str =
    outError = ""
    let value = RustCsgExecConfigOverrideRawValue(raw, outError)
    if outError != "":
        return ""
    return RustCsgExecConfigValueJsonFromRaw(value, outError)

fn RustCsgExecConfigSupportedKey(key: str): bool =
    if key == "model" || key == "model_provider" || key == "model_provider_id":
        return true
    if key == "oss_provider" || key == "local_provider" || key == "cwd":
        return true
    if key == "web_search":
        return true
    if key == "approval_policy" || key == "approvals_reviewer":
        return true
    if key == "sandbox" || key == "sandbox_mode":
        return true
    if key == "ephemeral" || key == "profile":
        return true
    if key == "default_permissions":
        return true
    return false

fn RustCsgExecConfigOverridesParseError(execPlan: var plan.RustCsgExecPlan): str =
    for i in 0..<execPlan.configOverrides.len:
        var err: str
        let key = RustCsgExecConfigOverrideKey(execPlan.configOverrides[i], err)
        if err != "":
            return err
        let valueJson = RustCsgExecConfigOverrideValueJson(execPlan.configOverrides[i], err)
        valueJson
        if err != "":
            return err
    return ""

fn RustCsgExecConfigOverridesBlockedReason(execPlan: var plan.RustCsgExecPlan): str =
    for i in 0..<execPlan.configOverrides.len:
        var err: str
        let key = RustCsgExecConfigOverrideKey(execPlan.configOverrides[i], err)
        if err != "":
            return ""
        if !RustCsgExecConfigSupportedKey(key):
            return wire.RustCsgCat("config override key not ported: ", key)
    return ""

fn RustCsgExecConfigOverrideJsonForKey(execPlan: var plan.RustCsgExecPlan,
                                       key: str,
                                       outError: var str): str =
    outError = ""
    var result: str
    for i in 0..<execPlan.configOverrides.len:
        var err: str
        let foundKey = RustCsgExecConfigOverrideKey(execPlan.configOverrides[i], err)
        if err != "":
            outError = err
            return ""
        if foundKey == key:
            let valueJson = RustCsgExecConfigOverrideValueJson(execPlan.configOverrides[i], err)
            if err != "":
                outError = err
                return ""
            result = valueJson
    return result

fn RustCsgExecConfigJsonStringPayload(valueJson: str, outError: var str): str =
    outError = ""
    if valueJson == "":
        return ""
    if valueJson.len < 2 || valueJson[0] != '"' || valueJson[valueJson.len - 1] != '"':
        outError = wire.RustCsgCat("config override value must be string: ", valueJson)
        return ""
    return wire.RustCsgSliceBytes(valueJson, 1, valueJson.len - 2)

fn RustCsgExecConfigOverrideStringForKey(execPlan: var plan.RustCsgExecPlan,
                                         key: str,
                                         outError: var str): str =
    let valueJson = RustCsgExecConfigOverrideJsonForKey(execPlan, key, outError)
    if outError != "" || valueJson == "":
        return ""
    return RustCsgExecConfigJsonStringPayload(valueJson, outError)

fn RustCsgExecConfigOverrideBoolJsonForKey(execPlan: var plan.RustCsgExecPlan,
                                           key: str,
                                           outError: var str): str =
    let valueJson = RustCsgExecConfigOverrideJsonForKey(execPlan, key, outError)
    if outError != "" || valueJson == "":
        return ""
    if valueJson != "true" && valueJson != "false":
        outError = wire.RustCsgCat("config override value must be bool: ", valueJson)
        return ""
    return valueJson

fn RustCsgExecConfigFirstStringOverride(execPlan: var plan.RustCsgExecPlan,
                                        keyA: str,
                                        keyB: str,
                                        outError: var str): str =
    outError = ""
    let first = RustCsgExecConfigOverrideStringForKey(execPlan, keyA, outError)
    if outError != "" || first != "":
        return first
    if keyB == "":
        return ""
    return RustCsgExecConfigOverrideStringForKey(execPlan, keyB, outError)

fn RustCsgExecConfigAppendComma(out: var str, first: var bool) =
    if first:
        first = false
    else:
        out = wire.RustCsgCat(out, ",")

fn RustCsgExecConfigProfileJsonFromPlan(execPlan: var plan.RustCsgExecPlan, outError: var str): str =
    outError = ""
    var profile = execPlan.configProfile
    if profile == "":
        profile = RustCsgExecConfigOverrideStringForKey(execPlan, "profile", outError)
    if outError != "":
        return ""
    let webSearch = RustCsgExecConfigOverrideStringForKey(execPlan, "web_search", outError)
    if outError != "":
        return ""
    if profile == "" && webSearch == "":
        return ""
    var out = "{"
    var first: bool
    first = true
    if profile != "":
        RustCsgExecConfigAppendComma(out, first)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("profile", profile))
    if webSearch != "":
        RustCsgExecConfigAppendComma(out, first)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("web_search", webSearch))
    out = wire.RustCsgCat(out, "}")
    return out
