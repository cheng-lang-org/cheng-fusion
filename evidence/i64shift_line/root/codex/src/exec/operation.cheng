import cheng/codex/exec/prompt
import cheng/codex/exec/plan
import cheng/codex/protocol/wire

type
    RustCsgExecInitialOperation =
        kind: str
        promptText: str
        inputJson: str
        outputSchemaPath: str
        reviewTargetJson: str
        parseError: str
        blockedReason: str

fn RustCsgExecTextInputJson(text: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "text"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", text))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("textElements", "[]"))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecLocalImageInputJson(path: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "localImage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecBuildInputJson(promptText: str, images: str[]): str =
    var out = "["
    for i in 0..<images.len:
        if i > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, RustCsgExecLocalImageInputJson(images[i]))
    if images.len > 0:
        out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, RustCsgExecTextInputJson(promptText))
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgExecReviewTargetUncommittedJson(): str =
    return "{\"type\":\"uncommittedChanges\"}"

fn RustCsgExecReviewTargetBaseJson(branch: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "baseBranch"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("branch", branch))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecReviewTargetCommitJson(sha: str, title: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "commit"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sha", sha))
    if title != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("title", title))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecReviewTargetCustomJson(instructions: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "custom"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("instructions", instructions))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecBuildReviewTargetJson(execPlan: var plan.RustCsgExecPlan, outError: var str): str =
    outError = ""
    if execPlan.reviewUncommitted:
        return RustCsgExecReviewTargetUncommittedJson()
    if execPlan.reviewBase != "":
        return RustCsgExecReviewTargetBaseJson(execPlan.reviewBase)
    if execPlan.reviewCommit != "":
        return RustCsgExecReviewTargetCommitJson(execPlan.reviewCommit, execPlan.reviewTitle)
    if execPlan.prompt != "":
        return RustCsgExecReviewTargetCustomJson(execPlan.prompt)
    outError = "exec review requires --uncommitted, --base, --commit, or custom instructions"
    return ""

fn RustCsgExecInitialOperationFromPlanInto(execPlan: var plan.RustCsgExecPlan,
                                           result: var RustCsgExecInitialOperation) =
    result = RustCsgExecInitialOperation()
    if execPlan.parseError != "":
        result.parseError = execPlan.parseError
        return
    result.outputSchemaPath = execPlan.outputSchema
    if execPlan.command == "review":
        var reviewError: str
        let targetJson = RustCsgExecBuildReviewTargetJson(execPlan, reviewError)
        if reviewError != "":
            result.parseError = reviewError
            return
        result.kind = "review"
        result.reviewTargetJson = targetJson
        result.promptText = execPlan.prompt
        return
    var promptText: str
    if execPlan.disableStdinContext:
        if execPlan.prompt == "" || execPlan.prompt == "-":
            result.parseError = "No prompt provided. MCP stdin is reserved for JSON-RPC frames."
            return
        promptText = execPlan.prompt
    else:
        var promptError: str
        promptText = prompt.RustCsgPromptResolveRoot(execPlan.prompt, promptError)
        if promptError != "":
            result.parseError = promptError
            return
    result.kind = "userTurn"
    if execPlan.command == "resume":
        result.kind = "resumeUserTurn"
    result.promptText = promptText
    result.inputJson = RustCsgExecBuildInputJson(promptText, execPlan.images)
    return

fn RustCsgExecInitialOperationFromPlan(execPlan: var plan.RustCsgExecPlan): RustCsgExecInitialOperation =
    var result: RustCsgExecInitialOperation
    RustCsgExecInitialOperationFromPlanInto(execPlan, result)
    return result

fn RustCsgExecInitialOperationToJson(operation: RustCsgExecInitialOperation): str =
    var inputJson = operation.inputJson
    if inputJson == "":
        inputJson = "null"
    var reviewTargetJson = operation.reviewTargetJson
    if reviewTargetJson == "":
        reviewTargetJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", operation.kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("promptText", operation.promptText))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("input", inputJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outputSchemaPath", operation.outputSchemaPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("reviewTarget", reviewTargetJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", operation.parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", operation.blockedReason))
    out = wire.RustCsgCat(out, "}")
    return out
