import std/strings
import std/strutils as strutil
import cheng/codex/app_server/stream_parser as sp
import cheng/codex/net/http_client as http_client
import cheng/codex/protocol/wire as wire
import cheng/codex/exec/output as out

@importc("RustCsgGetCurrentTimeMs")
fn getCurrentTimeMs(): int64

fn ExecRunHandleItemStarted(itemJson: str, agentText: var str, sawAgentDelta: var bool): bool =
    if itemJson.len == 0 || itemJson == "null":
        return false
    let itemType = wire.RustCsgJsonFindStr(itemJson, "type")
    if itemType == "userMessage":
        let contentArr = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "content")
        if contentArr.len > 0:
            let text = wire.RustCsgJsonFindStr(contentArr, "text")
            if text.len > 0:
                echo(strutil.Join(["User: ", text], ""))
        else:
            echo("User: (message received)")
        return true
    if itemType == "agentMessage":
        let phase = wire.RustCsgJsonFindOptionalStr(itemJson, "phase")
        if phase.len > 0:
            echo(strutil.Join(["Agent (phase: ", phase, ")"], ""))
        else:
            echo("Agent: (message started)")
        let contentArr = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "content")
        if contentArr.len > 0:
            let text = wire.RustCsgJsonFindStr(contentArr, "text")
            if text.len > 0:
                agentText = text
        return true
    if itemType == "commandExecution":
        echo("Command executed")
        return true
    if itemType == "mcpToolCall":
        let toolName = wire.RustCsgJsonFindStr(itemJson, "tool")
        let argsRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "arguments")
        echo(out.ExecFormatToolCall(toolName, argsRaw))
        return true
    if itemType == "dynamicToolCall":
        let toolName = wire.RustCsgJsonFindStr(itemJson, "tool")
        let argsRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "arguments")
        echo(out.ExecFormatToolCall(toolName, argsRaw))
        return true
    if itemType == "enteredReviewMode":
        echo(out.ExecFormatReviewEntered(""))
        return true
    if itemType == "collabAgentToolCall":
        let taskTool = wire.RustCsgJsonFindStr(itemJson, "tool")
        if taskTool.len > 0:
            echo(out.ExecFormatTaskStarted(taskTool, ""))
        else:
            echo("[task] started")
        return true
    if itemType == "applyPatch":
        let filePath = wire.RustCsgJsonFindOptionalStr(itemJson, "path")
        if filePath.len == 0: filePath = wire.RustCsgJsonFindOptionalStr(itemJson, "file")
        if filePath.len > 0: echo(strutil.Join(["[apply] ", filePath], ""))
        else: echo("[apply] (changes pending)")
        return true
    if itemType == "task":
        let desc = wire.RustCsgJsonFindOptionalStr(itemJson, "description")
        if desc.len > 0: echo(strutil.Join(["[task] ", desc], ""))
        else: echo("[task] started")
        return true
    if itemType == "toolSearch":
        echo("[search] searching for tools...")
        return true
    if itemType == "reasoning":
        let summaryRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "summary")
        if summaryRaw.len > 0 and summaryRaw[0] == '"' and summaryRaw.len > 2:
            echo(strutil.Join(["[reasoning] ", wire.RustCsgSliceBytes(summaryRaw, 1, summaryRaw.len - 2)], ""))
        else:
            echo("[reasoning] ...")
        return true
    return true

fn ExecRunHandleItemCompleted(itemJson: str): bool =
    if itemJson.len == 0 || itemJson == "null":
        return false
    let itemType = wire.RustCsgJsonFindStr(itemJson, "type")
    if itemType == "mcpToolCall":
        let toolName = wire.RustCsgJsonFindStr(itemJson, "tool")
        let resultRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "result")
        if resultRaw.len > 0 && resultRaw != "null":
            let text = wire.RustCsgJsonFindOptionalStr(resultRaw, "text")
            if text.len > 0:
                echo(out.ExecFormatToolResult(toolName, text, false))
            else:
                echo(out.ExecFormatToolResult(toolName, "", false))
        else:
            let errorRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "error")
            if errorRaw.len > 0 && errorRaw != "null":
                let errMsg = wire.RustCsgJsonFindOptionalStr(errorRaw, "message")
                if errMsg.len > 0:
                    echo(out.ExecFormatToolResult(toolName, errMsg, true))
                else:
                    echo(out.ExecFormatToolResult(toolName, "", true))
            else:
                echo(out.ExecFormatToolResult(toolName, "", false))
        return true
    if itemType == "dynamicToolCall":
        let toolName = wire.RustCsgJsonFindStr(itemJson, "tool")
        echo(out.ExecFormatToolResult(toolName, "", false))
        return true
    if itemType == "exitedReviewMode":
        echo(out.ExecFormatReviewExited(""))
        return true
    if itemType == "collabAgentToolCall":
        let taskTool = wire.RustCsgJsonFindStr(itemJson, "tool")
        if taskTool.len > 0:
            echo(out.ExecFormatTaskCompleted(taskTool))
        else:
            echo(out.ExecFormatTaskCompleted(""))
        return true
    if itemType == "contextCompaction":
        echo("[compaction] Thread context compressed")
        return true
    if itemType == "applyPatch":
        echo("[apply] done")
        return true
    if itemType == "task":
        echo("[task] done")
        return true
    if itemType == "toolSearch":
        echo("[search] done")
        return true
    if itemType == "reasoning":
        let summaryRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "summary")
        if summaryRaw.len > 0 and summaryRaw[0] == '"':
            echo(strutil.Join(["[reasoning] completed: ", wire.RustCsgSliceBytes(summaryRaw, 1, summaryRaw.len - 2)], ""))
        else:
            echo("[reasoning] completed")
        return true
    if itemType.len > 0:
        echo(strutil.Join(["Item completed: ", itemType], ""))
    else:
        echo("Item completed")
    return true

fn ExecRunStart(appServerUrl: str, planJson: str): int32 =
    var totalStartMs: int64 = getCurrentTimeMs()
    var httpStartMs: int64 = getCurrentTimeMs()
    let response = http_client.HttpClientPost(appServerUrl, planJson, "")
    var httpElapsedMs: int32 = int32(getCurrentTimeMs() - httpStartMs)
    if response.statusCode != 200:
        if response.statusCode == 0:
            if response.body.len > 0:
                echo(out.ExecFormatConnectionError(appServerUrl, response.body))
            else:
                echo(out.ExecFormatConnectionError(appServerUrl, "no response received"))
        else:
            echo(out.ExecFormatHttpError(response.statusCode, appServerUrl))
            if response.body.len > 0:
                echo(out.ExecFormatError(response.body))
        return 1
    if response.body.len == 0:
        echo(out.ExecFormatError("Server returned HTTP 200 with empty body"))
        return 1

    echo(out.ExecFormatElapsed(httpElapsedMs))

    var remaining: str = response.body
    var turnCompleted: bool = false
    var hasError: bool = false
    var agentText: str = ""
    var sawAgentDelta: bool = false
    var lastEventCat: str = ""
    var startMs: int64 = getCurrentTimeMs()
    var sawThreadStarted: bool = false
    var eventCount: int32 = 0
    var deltaCount: int32 = 0
    var toolCallCount: int32 = 0
    var itemStartedCount: int32 = 0
    var itemCompletedCount: int32 = 0

    while !turnCompleted && remaining.len > 0:
        eventCount = eventCount + 1
        if eventCount > 1000:
            echo(out.ExecFormatWarning("Exceeded maximum event count (1000)"))
            echo(out.ExecFormatEventCount(eventCount))
            return 1
        let resultJson = sp.AppServerParseStreamEventJson(remaining)
        let found = wire.RustCsgJsonFindBool(resultJson, "found")
        if !found:
            let pos: int32 = response.body.len - remaining.len
            var snippet: str = remaining
            if snippet.len > 120:
                snippet = strings.ConcatStr(strings.SliceBytes(snippet, 0, 120), "...")
            let posStr: str = strings.IntToStr(pos)
            let failMsg: str = strings.ConcatStr("Stream parse failure at byte ", strings.ConcatStr(posStr, strings.ConcatStr(": ", snippet)))
            echo(out.ExecFormatError(failMsg))
            return 1

        let eventCat = wire.RustCsgJsonFindStr(resultJson, "eventCat")
        let method = wire.RustCsgJsonFindStr(resultJson, "method")
        let threadId = wire.RustCsgJsonFindStr(resultJson, "threadId")
        let turnId = wire.RustCsgJsonFindStr(resultJson, "turnId")
        let delta = wire.RustCsgJsonFindStr(resultJson, "delta")
        let itemJson = wire.RustCsgJsonFindValueRaw(resultJson, "item")
        let errorJson = wire.RustCsgJsonFindValueRaw(resultJson, "error")
        let itemType = wire.RustCsgJsonFindOptionalStr(resultJson, "itemType")
        let consumed = wire.RustCsgJsonFindInt32(resultJson, "consumed")
        if consumed <= 0:
            let pos: int32 = response.body.len - remaining.len
            echo(out.ExecFormatError(strings.ConcatStr("Stream parser stuck at byte ", strings.IntToStr(pos))))
            return 1

        lastEventCat = eventCat

        if eventCat == "invalid":
            echo(out.ExecFormatWarning("Skipping non-JSON line in stream"))
        elif eventCat == "thread/started":
            if sawThreadStarted:
                echo(out.ExecFormatWarning("Duplicate thread/started before turn/completed"))
            sawThreadStarted = true
            echo(out.ExecFormatThreadStarted(threadId))
        elif eventCat == "turn/started":
            if !sawThreadStarted:
                echo(out.ExecFormatWarning("Received turn/started before thread/started"))
            echo(out.ExecFormatTurnStarted(turnId))
        elif eventCat == "turn/completed":
            if !sawThreadStarted:
                echo(out.ExecFormatWarning("Received turn/completed before thread/started"))
            echo(out.ExecFormatTurnCompleted(turnId))
            let elapsedMs: int32 = int32(getCurrentTimeMs() - startMs)
            echo(out.ExecFormatElapsed(elapsedMs))
            if agentText.len > 0 && !sawAgentDelta:
                echo(strutil.Join(["Agent: ", agentText], ""))
            turnCompleted = true
        elif eventCat == "turn/interrupted":
            if !sawThreadStarted:
                echo(out.ExecFormatWarning("Received turn/interrupted before thread/started"))
            echo(strutil.Join(["Turn interrupted: ", turnId], ""))
            hasError = true
            turnCompleted = true
        elif eventCat == "thread/compacted":
            echo("Thread compacted")
        elif eventCat == "thread/status":
            echo(strutil.Join(["[thread status] ", delta], ""))
        elif eventCat == "error":
            let errMsg = wire.RustCsgJsonFindStr(errorJson, "message")
            if errMsg.len > 0:
                echo(strutil.Join(["Error: ", errMsg], ""))
            else:
                echo(strutil.Join(["Error: ", method], ""))
            hasError = true
            turnCompleted = true
        elif eventCat == "item/delta":
            deltaCount = deltaCount + 1
            if delta.len > 0:
                if itemType == "reasoning":
                    echo(strutil.Join(["[reasoning] ", delta], ""))
                else:
                    agentText = strutil.Join([agentText, delta], "")
                    sawAgentDelta = true
                    echo(strutil.Join(["[delta] ", delta], ""))
        elif eventCat == "item/completed":
            itemCompletedCount = itemCompletedCount + 1
            if itemJson.len > 0 && itemJson != "null":
                ExecRunHandleItemCompleted(itemJson)
            else:
                echo("Item completed")
        elif eventCat == "item/started":
            itemStartedCount = itemStartedCount + 1
            if itemType == "mcpToolCall" || itemType == "dynamicToolCall":
                toolCallCount = toolCallCount + 1
            if itemJson.len > 0 && itemJson != "null":
                ExecRunHandleItemStarted(itemJson, agentText, sawAgentDelta)

        if consumed >= remaining.len:
            remaining = ""
        else:
            remaining = wire.RustCsgSliceBytes(remaining, consumed, remaining.len - consumed)

    if hasError:
        return 1
    if !turnCompleted:
        let lastMsg: str = strings.ConcatStr("Stream ended before turn completed (last event: ", strings.ConcatStr(lastEventCat, ")"))
        echo(out.ExecFormatError(lastMsg))
        return 1
    if eventCount > 0:
        echo(out.ExecFormatEventCount(eventCount))
    let totalElapsedMs: int32 = int32(getCurrentTimeMs() - totalStartMs)
    echo(out.ExecFormatStats(deltaCount, toolCallCount, itemStartedCount, totalElapsedMs))
    return 0

fn ExecRunStartCollect(appServerUrl: str, planJson: str, outThreadId: var str, outContent: var str): int32 =
    let response = http_client.HttpClientPost(appServerUrl, planJson, "")
    if response.statusCode != 200:
        outContent = strutil.Join(["HTTP error: status=", strings.IntToStr(response.statusCode)], "")
        return 1
    if response.body.len == 0:
        outContent = "HTTP response body is empty"
        return 1

    var remaining: str = response.body
    var turnCompleted: bool = false
    var hasError: bool = false
    var agentText: str = ""
    var extractedThreadId: str = ""

    while !turnCompleted && remaining.len > 0:
        let resultJson = sp.AppServerParseStreamEventJson(remaining)
        let found = wire.RustCsgJsonFindBool(resultJson, "found")
        if !found:
            outContent = "Invalid app-server stream event"
            return 1

        let eventCat = wire.RustCsgJsonFindStr(resultJson, "eventCat")
        let threadId = wire.RustCsgJsonFindStr(resultJson, "threadId")
        let delta = wire.RustCsgJsonFindStr(resultJson, "delta")
        let itemJson = wire.RustCsgJsonFindValueRaw(resultJson, "item")
        let errorJson = wire.RustCsgJsonFindValueRaw(resultJson, "error")
        let itemType = wire.RustCsgJsonFindOptionalStr(resultJson, "itemType")
        let consumed = wire.RustCsgJsonFindInt32(resultJson, "consumed")
        if consumed <= 0:
            outContent = "Invalid app-server stream cursor"
            return 1

        if extractedThreadId == "" && threadId != "":
            extractedThreadId = threadId

        if eventCat == "turn/completed":
            turnCompleted = true
        elif eventCat == "turn/interrupted":
            hasError = true
            turnCompleted = true
        elif eventCat == "error":
            let errMsg = wire.RustCsgJsonFindStr(errorJson, "message")
            if errMsg.len > 0:
                outContent = errMsg
            else:
                let method = wire.RustCsgJsonFindStr(resultJson, "method")
                outContent = method
            hasError = true
            turnCompleted = true
        elif eventCat == "item/delta":
            if delta.len > 0 and itemType != "reasoning":
                agentText = strutil.Join([agentText, delta], "")
        elif eventCat == "item/completed":
            if itemJson.len > 0 && itemJson != "null":
                let itemType = wire.RustCsgJsonFindStr(itemJson, "type")
                if itemType == "agentMessage":
                    let contentArr = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "content")
                    if contentArr.len > 0:
                        let text = wire.RustCsgJsonFindStr(contentArr, "text")
                        if text.len > 0:
                            agentText = text

        if consumed >= remaining.len:
            remaining = ""
        else:
            remaining = wire.RustCsgSliceBytes(remaining, consumed, remaining.len - consumed)

    outThreadId = extractedThreadId
    if hasError:
        if outContent == "":
            outContent = "Unknown app-server error"
        return 1
    if !turnCompleted:
        outContent = "App-server stream ended before turn completed"
        return 1
    outContent = agentText
    if outContent == "":
        outContent = "(empty response)"
    return 0

fn ExecRunStartWithTimeout(appServerUrl: str, planJson: str, timeoutMs: int32): int32 =
    var startMs: int64 = getCurrentTimeMs()
    let result: int32 = ExecRunStart(appServerUrl, planJson)
    let elapsedMs: int32 = int32(getCurrentTimeMs() - startMs)
    if elapsedMs > timeoutMs:
        let msg: str = strings.ConcatStr("Execution exceeded ", strings.ConcatStr(strings.IntToStr(timeoutMs), "ms timeout"))
        echo(out.ExecFormatWarning(msg))
    return result
