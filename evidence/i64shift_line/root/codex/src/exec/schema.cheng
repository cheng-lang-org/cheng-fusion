import cheng/codex/config/home
import cheng/codex/protocol/wire

fn RustCsgExecSchemaIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn RustCsgExecSchemaSkipSpace(raw: str, pos: int32): int32 =
    var i: int32
    i = pos
    while i < raw.len && RustCsgExecSchemaIsSpace(raw[i]):
        i = i + 1
    return i

fn RustCsgExecSchemaTrim(raw: str): str =
    var start: int32
    start = RustCsgExecSchemaSkipSpace(raw, 0)
    if start >= raw.len:
        return ""
    var stop: int32
    stop = raw.len
    while stop > start && RustCsgExecSchemaIsSpace(raw[stop - 1]):
        stop = stop - 1
    return wire.RustCsgSliceBytes(raw, start, stop - start)

fn RustCsgExecSchemaIsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn RustCsgExecSchemaIsNonZeroDigit(ch: char): bool =
    return ch >= '1' && ch <= '9'

fn RustCsgExecSchemaIsHexDigit(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    return ch >= 'A' && ch <= 'F'

fn RustCsgExecSchemaParseString(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '"':
        outError = "json string expected"
        return false
    pos = pos + 1
    while pos < raw.len:
        let ch = raw[pos]
        if ch == '"':
            pos = pos + 1
            return true
        if ch == '\\':
            pos = pos + 1
            if pos >= raw.len:
                outError = "unterminated json string escape"
                return false
            let esc = raw[pos]
            if esc == '"' || esc == '\\' || esc == '/' || esc == 'b':
                pos = pos + 1
                continue
            if esc == 'f' || esc == 'n' || esc == 'r' || esc == 't':
                pos = pos + 1
                continue
            if esc == 'u':
                pos = pos + 1
                for i in 0..<4:
                    if pos >= raw.len || !RustCsgExecSchemaIsHexDigit(raw[pos]):
                        outError = "invalid json unicode escape"
                        return false
                    pos = pos + 1
                continue
            outError = "invalid json string escape"
            return false
        if ch == '\n' || ch == '\r' || ch == '\t':
            outError = "control character in json string"
            return false
        pos = pos + 1
    outError = "unterminated json string"
    return false

fn RustCsgExecSchemaParseNumber(raw: str, pos: var int32, outError: var str): bool =
    if pos < raw.len && raw[pos] == '-':
        pos = pos + 1
    if pos >= raw.len:
        outError = "json number missing digits"
        return false
    if raw[pos] == '0':
        pos = pos + 1
    elif RustCsgExecSchemaIsNonZeroDigit(raw[pos]):
        while pos < raw.len && RustCsgExecSchemaIsDigit(raw[pos]):
            pos = pos + 1
    else:
        outError = "json number missing digits"
        return false
    if pos < raw.len && raw[pos] == '.':
        pos = pos + 1
        if pos >= raw.len || !RustCsgExecSchemaIsDigit(raw[pos]):
            outError = "json number missing fractional digits"
            return false
        while pos < raw.len && RustCsgExecSchemaIsDigit(raw[pos]):
            pos = pos + 1
    if pos < raw.len && (raw[pos] == 'e' || raw[pos] == 'E'):
        pos = pos + 1
        if pos < raw.len && (raw[pos] == '+' || raw[pos] == '-'):
            pos = pos + 1
        if pos >= raw.len || !RustCsgExecSchemaIsDigit(raw[pos]):
            outError = "json number missing exponent digits"
            return false
        while pos < raw.len && RustCsgExecSchemaIsDigit(raw[pos]):
            pos = pos + 1
    return true

fn RustCsgExecSchemaParseLiteral(raw: str,
                                 pos: var int32,
                                 literal: str,
                                 outError: var str): bool =
    if !wire.RustCsgMatchesAt(raw, pos, literal):
        outError = wire.RustCsgCat("json literal expected: ", literal)
        return false
    pos = pos + literal.len
    return true

fn RustCsgExecSchemaParseArray(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '[':
        outError = "json array expected"
        return false
    pos = RustCsgExecSchemaSkipSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
        return true
    while pos < raw.len:
        if !RustCsgExecSchemaParseValue(raw, pos, outError):
            return false
        pos = RustCsgExecSchemaSkipSpace(raw, pos)
        if pos < raw.len && raw[pos] == ',':
            pos = RustCsgExecSchemaSkipSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == ']':
            pos = pos + 1
            return true
        outError = "malformed json array"
        return false
    outError = "unterminated json array"
    return false

fn RustCsgExecSchemaParseObject(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '{':
        outError = "json object expected"
        return false
    pos = RustCsgExecSchemaSkipSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == '}':
        pos = pos + 1
        return true
    while pos < raw.len:
        if !RustCsgExecSchemaParseString(raw, pos, outError):
            return false
        pos = RustCsgExecSchemaSkipSpace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            outError = "json object missing colon"
            return false
        pos = RustCsgExecSchemaSkipSpace(raw, pos + 1)
        if !RustCsgExecSchemaParseValue(raw, pos, outError):
            return false
        pos = RustCsgExecSchemaSkipSpace(raw, pos)
        if pos < raw.len && raw[pos] == ',':
            pos = RustCsgExecSchemaSkipSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == '}':
            pos = pos + 1
            return true
        outError = "malformed json object"
        return false
    outError = "unterminated json object"
    return false

fn RustCsgExecSchemaParseValue(raw: str, pos: var int32, outError: var str): bool =
    pos = RustCsgExecSchemaSkipSpace(raw, pos)
    if pos >= raw.len:
        outError = "json value expected"
        return false
    let ch = raw[pos]
    if ch == '{':
        return RustCsgExecSchemaParseObject(raw, pos, outError)
    if ch == '[':
        return RustCsgExecSchemaParseArray(raw, pos, outError)
    if ch == '"':
        return RustCsgExecSchemaParseString(raw, pos, outError)
    if ch == 't':
        return RustCsgExecSchemaParseLiteral(raw, pos, "true", outError)
    if ch == 'f':
        return RustCsgExecSchemaParseLiteral(raw, pos, "false", outError)
    if ch == 'n':
        return RustCsgExecSchemaParseLiteral(raw, pos, "null", outError)
    if ch == '-' || RustCsgExecSchemaIsDigit(ch):
        return RustCsgExecSchemaParseNumber(raw, pos, outError)
    outError = "unsupported json value"
    return false

fn RustCsgExecSchemaValidateJson(raw: str, outError: var str): bool =
    outError = ""
    var pos: int32
    if !RustCsgExecSchemaParseValue(raw, pos, outError):
        return false
    pos = RustCsgExecSchemaSkipSpace(raw, pos)
    if pos != raw.len:
        outError = "trailing data after json value"
        return false
    return true

fn RustCsgExecLoadOutputSchemaJson(path: str, outError: var str): str =
    outError = ""
    if path == "":
        return ""
    let raw = home.RustCsgReadFile(path)
    let trimmed = RustCsgExecSchemaTrim(raw)
    if trimmed == "":
        outError = wire.RustCsgCat("output schema file is empty or unreadable: ", path)
        return ""
    var parseError: str
    if !RustCsgExecSchemaValidateJson(trimmed, parseError):
        outError = wire.RustCsgCat(wire.RustCsgCat("Output schema file ", path),
                                  wire.RustCsgCat(" is not valid JSON: ", parseError))
        return ""
    return trimmed
