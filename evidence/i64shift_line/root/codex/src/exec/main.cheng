import std/cmdline as cmdline
import cheng/codex/exec/plan as plan
import cheng/codex/exec/session as session
import cheng/codex/exec/run as exec_run

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var args: str[]
    let count = cmdline.paramCount()
    for i in 0..<count:
        add(args, cmdline.paramStr(i))

    var p = plan.RustCsgExecParseArgs(args)
    if p.parseError != "":
        echo(p.parseError)
        return 1

    var requestPlan: session.RustCsgExecRequestPlan
    session.RustCsgExecRequestPlanFromPlanWithEnvironmentInto(p, "", requestPlan)
    if requestPlan.parseError != "":
        echo(requestPlan.parseError)
        return 1
    if requestPlan.blockedReason != "":
        echo(requestPlan.blockedReason)
        return 1

    let json = session.RustCsgExecRequestPlanToJson(requestPlan)
    if p.appServerUrl != "":
        return exec_run.ExecRunStart(p.appServerUrl, json)
    else:
        echo(json)
    return 0
