import cheng/codex/protocol/wire

type
    RustCsgExecPlan =
        command: str
        prompt: str
        resumeSessionId: str
        resumeLast: bool
        resumeAll: bool
        images: str[]
        model: str
        cwd: str
        sandbox: str
        color: str
        json: bool
        help: bool
        outputLastMessage: str
        outputSchema: str
        disableStdinContext: bool
        skipGitRepoCheck: bool
        ephemeral: bool
        ignoreUserConfig: bool
        ignoreRules: bool
        removedFullAuto: bool
        dangerouslyBypassApprovalsAndSandbox: bool
        oss: bool
        ossProvider: str
        configProfile: str
        configOverrides: str[]
        addDirs: str[]
        reviewUncommitted: bool
        reviewBase: str
        reviewCommit: str
        reviewTitle: str
        reasoningEffort: str
        reasoningSummary: str
        maxTurns: int32
        appServerUrl: str
        parseError: str

fn RustCsgExecPlanDefault(): RustCsgExecPlan =
    var result: RustCsgExecPlan
    result.command = "run"
    result.color = "auto"
    result.maxTurns = 0
    return result

fn RustCsgExecSetParseError(plan: var RustCsgExecPlan, message: str) =
    if plan.parseError == "":
        plan.parseError = message

fn RustCsgExecSetUnknownFlag(plan: var RustCsgExecPlan, flag: str) =
    RustCsgExecSetParseError(plan, wire.RustCsgCat("unknown exec flag: ", flag))

fn RustCsgExecMatchesPrefix(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn RustCsgExecInlineValue(arg: str, key: str): str =
    if arg.len <= key.len:
        return ""
    if !RustCsgExecMatchesPrefix(arg, key):
        return ""
    let sep = arg[key.len]
    if sep != '=' && sep != ':':
        return ""
    return wire.RustCsgSliceBytes(arg, key.len + 1, arg.len - key.len - 1)

fn RustCsgExecReadValueAt(args: str[],
                          index: int32,
                          keyA: str,
                          keyB: str,
                          outValue: var str,
                          outNextIndex: var int32): bool =
    outValue = ""
    outNextIndex = index
    let arg = args[index]
    let inlineA = RustCsgExecInlineValue(arg, keyA)
    if inlineA != "":
        outValue = inlineA
        return true
    if keyB != "":
        let inlineB = RustCsgExecInlineValue(arg, keyB)
        if inlineB != "":
            outValue = inlineB
            return true
    if arg != keyA && (keyB == "" || arg != keyB):
        return false
    let valueIndex = index + 1
    if valueIndex >= args.len:
        outNextIndex = index
        outValue = ""
        return true
    if RustCsgExecIsFlag(args[valueIndex]):
        outNextIndex = index
        outValue = ""
        return true
    outValue = args[valueIndex]
    outNextIndex = valueIndex
    return true

fn RustCsgExecIsFlag(arg: str): bool =
    if arg.len < 2:
        return false
    return arg[0] == '-'

fn RustCsgExecConsumeValueFlag(plan: var RustCsgExecPlan,
                               args: str[],
                               index: int32,
                               outNextIndex: var int32): bool =
    var value: str
    outNextIndex = index
    if RustCsgExecReadValueAt(args, index, "--model", "-m", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--model requires a value")
        plan.model = value
        return true
    if RustCsgExecReadValueAt(args, index, "--resume", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--resume requires a value")
        else:
            plan.command = "resume"
            plan.resumeSessionId = value
        return true
    if RustCsgExecReadValueAt(args, index, "--local-provider", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--local-provider requires a value")
        plan.ossProvider = value
        return true
    if RustCsgExecReadValueAt(args, index, "--profile", "-p", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--profile requires a value")
        plan.configProfile = value
        return true
    if RustCsgExecReadValueAt(args, index, "--sandbox", "-s", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--sandbox requires a value")
        plan.sandbox = value
        return true
    if RustCsgExecReadValueAt(args, index, "--cd", "-C", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--cd requires a value")
        plan.cwd = value
        return true
    if RustCsgExecReadValueAt(args, index, "--add-dir", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--add-dir requires a value")
        add(plan.addDirs, value)
        return true
    if RustCsgExecReadValueAt(args, index, "--config", "-c", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--config requires a value")
        add(plan.configOverrides, value)
        return true
    if RustCsgExecReadValueAt(args, index, "--output-schema", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--output-schema requires a value")
        plan.outputSchema = value
        return true
    if RustCsgExecReadValueAt(args, index, "--color", "", value, outNextIndex):
        if value != "auto" && value != "always" && value != "never":
            RustCsgExecSetParseError(plan, wire.RustCsgCat("invalid --color value: ", value))
        plan.color = value
        return true
    if RustCsgExecReadValueAt(args, index, "--output-last-message", "-o", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--output-last-message requires a value")
        plan.outputLastMessage = value
        return true
    if RustCsgExecReadValueAt(args, index, "--image", "-i", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--image requires a value")
        add(plan.images, value)
        return true
    if RustCsgExecReadValueAt(args, index, "--base", "", value, outNextIndex):
        if plan.command != "review":
            RustCsgExecSetParseError(plan, "--base is only valid for exec review")
        if value == "":
            RustCsgExecSetParseError(plan, "--base requires a value")
        plan.reviewBase = value
        return true
    if RustCsgExecReadValueAt(args, index, "--commit", "", value, outNextIndex):
        if plan.command != "review":
            RustCsgExecSetParseError(plan, "--commit is only valid for exec review")
        if value == "":
            RustCsgExecSetParseError(plan, "--commit requires a value")
        plan.reviewCommit = value
        return true
    if RustCsgExecReadValueAt(args, index, "--title", "", value, outNextIndex):
        if plan.command != "review":
            RustCsgExecSetParseError(plan, "--title is only valid for exec review")
        if value == "":
            RustCsgExecSetParseError(plan, "--title requires a value")
        plan.reviewTitle = value
        return true
    if RustCsgExecReadValueAt(args, index, "--app-server-url", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--app-server-url requires a value")
        plan.appServerUrl = value
        return true
    if RustCsgExecReadValueAt(args, index, "--reasoning-effort", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--reasoning-effort requires a value")
        plan.reasoningEffort = value
        return true
    if RustCsgExecReadValueAt(args, index, "--reasoning-summary", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--reasoning-summary requires a value")
        plan.reasoningSummary = value
        return true
    if RustCsgExecReadValueAt(args, index, "--max-turns", "", value, outNextIndex):
        if value == "":
            RustCsgExecSetParseError(plan, "--max-turns requires a value")
        plan.maxTurns = wire.RustCsgParseInt32(value)
        return true
    return false

fn RustCsgExecConsumeBoolFlag(plan: var RustCsgExecPlan, arg: str): bool =
    if arg == "--oss":
        plan.oss = true
        return true
    if arg == "--dangerously-bypass-approvals-and-sandbox" || arg == "--yolo":
        plan.dangerouslyBypassApprovalsAndSandbox = true
        return true
    if arg == "--skip-git-repo-check":
        plan.skipGitRepoCheck = true
        return true
    if arg == "--ephemeral":
        plan.ephemeral = true
        return true
    if arg == "--ignore-user-config":
        plan.ignoreUserConfig = true
        return true
    if arg == "--ignore-rules":
        plan.ignoreRules = true
        return true
    if arg == "--full-auto":
        plan.removedFullAuto = true
        return true
    if arg == "--json" || arg == "--experimental-json":
        plan.json = true
        return true
    if arg == "--last":
        if plan.command == "review":
            RustCsgExecSetParseError(plan, "--last conflicts with --review")
            return true
        plan.command = "resume"
        plan.resumeLast = true
        return true
    if arg == "--all":
        if plan.command != "resume":
            RustCsgExecSetParseError(plan, "--all is only valid for exec resume")
        plan.resumeAll = true
        return true
    if arg == "--review":
        plan.command = "review"
        plan.reviewUncommitted = true
        return true
    if arg == "--uncommitted":
        if plan.command != "review":
            RustCsgExecSetParseError(plan, "--uncommitted is only valid for exec review")
        plan.reviewUncommitted = true
        return true
    if arg == "--help" || arg == "-h":
        plan.help = true
        return true
    return false

fn RustCsgExecConsumePositional(plan: var RustCsgExecPlan, value: str, allowCommand: bool) =
    if plan.command == "run":
        if allowCommand && plan.prompt == "" && (value == "resume" || value == "review"):
            plan.command = value
            return
        if plan.prompt == "":
            plan.prompt = value
            return
        RustCsgExecSetParseError(plan, wire.RustCsgCat("unexpected exec positional: ", value))
        return
    if plan.command == "resume":
        if plan.resumeSessionId == "" && plan.prompt == "":
            plan.resumeSessionId = value
            return
        if plan.prompt == "":
            plan.prompt = value
            return
        RustCsgExecSetParseError(plan, wire.RustCsgCat("unexpected exec resume positional: ", value))
        return
    if plan.command == "review":
        if plan.prompt == "":
            plan.prompt = value
            return
        RustCsgExecSetParseError(plan, wire.RustCsgCat("unexpected exec review positional: ", value))
        return
    RustCsgExecSetParseError(plan, wire.RustCsgCat("unknown exec command: ", plan.command))

fn RustCsgExecFinalizePlan(plan: var RustCsgExecPlan) =
    if plan.resumeLast && plan.prompt == "" && plan.resumeSessionId != "":
        plan.prompt = plan.resumeSessionId
        plan.resumeSessionId = ""
    if plan.removedFullAuto && plan.dangerouslyBypassApprovalsAndSandbox:
        RustCsgExecSetParseError(plan, "--full-auto conflicts with --dangerously-bypass-approvals-and-sandbox")
    # Mutual exclusion: resume vs review
    if plan.resumeSessionId != "" || plan.resumeLast:
        if plan.command == "review" || plan.reviewUncommitted || plan.reviewBase != "" || plan.reviewCommit != "":
            RustCsgExecSetParseError(plan, "cannot combine resume (--resume/--last) with review (--review) options")
            return
    if plan.reviewUncommitted || plan.reviewBase != "" || plan.reviewCommit != "":
        if plan.resumeSessionId != "" || plan.resumeLast:
            RustCsgExecSetParseError(plan, "cannot combine review with resume (--resume/--last) options")
            return
    var reviewTargetCount: int32
    if plan.reviewUncommitted:
        reviewTargetCount = reviewTargetCount + 1
    if plan.reviewBase != "":
        reviewTargetCount = reviewTargetCount + 1
    if plan.reviewCommit != "":
        reviewTargetCount = reviewTargetCount + 1
    if plan.command == "review" && reviewTargetCount > 1:
        RustCsgExecSetParseError(plan, "exec review target flags conflict")
    if plan.reviewTitle != "" && plan.reviewCommit == "":
        RustCsgExecSetParseError(plan, "--title requires --commit")

fn RustCsgExecParseArgs(args: str[]): RustCsgExecPlan =
    var plan = RustCsgExecPlanDefault()
    var index: int32
    if args.len > 0:
        index = 1
    if index < args.len && (args[index] == "exec" || args[index] == "e"):
        index = index + 1
    var stopOptions: bool
    while index < args.len:
        let arg = args[index]
        if !stopOptions && arg == "--":
            stopOptions = true
            index = index + 1
            continue
        if !stopOptions && RustCsgExecIsFlag(arg):
            var nextIndex: int32
            if RustCsgExecConsumeValueFlag(plan, args, index, nextIndex):
                if plan.parseError != "":
                    break
                index = nextIndex + 1
                continue
            if RustCsgExecConsumeBoolFlag(plan, arg):
                if plan.parseError != "":
                    break
                index = index + 1
                continue
            RustCsgExecSetUnknownFlag(plan, arg)
            break
        RustCsgExecConsumePositional(plan, arg, !stopOptions)
        if plan.parseError != "":
            break
        index = index + 1
    RustCsgExecFinalizePlan(plan)
    return plan

fn RustCsgExecPlanToJson(plan: RustCsgExecPlan): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", plan.command))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("prompt", plan.prompt))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("resumeSessionId", plan.resumeSessionId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("resumeLast", plan.resumeLast))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("resumeAll", plan.resumeAll))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("images", plan.images))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", plan.model))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", plan.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sandbox", plan.sandbox))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("color", plan.color))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("json", plan.json))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outputLastMessage", plan.outputLastMessage))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outputSchema", plan.outputSchema))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("skipGitRepoCheck", plan.skipGitRepoCheck))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ephemeral", plan.ephemeral))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ignoreUserConfig", plan.ignoreUserConfig))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ignoreRules", plan.ignoreRules))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("removedFullAuto", plan.removedFullAuto))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("dangerouslyBypassApprovalsAndSandbox", plan.dangerouslyBypassApprovalsAndSandbox))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("oss", plan.oss))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("ossProvider", plan.ossProvider))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("configProfile", plan.configProfile))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("configOverrides", plan.configOverrides))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("addDirs", plan.addDirs))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("reviewUncommitted", plan.reviewUncommitted))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reviewBase", plan.reviewBase))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reviewCommit", plan.reviewCommit))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reviewTitle", plan.reviewTitle))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("appServerUrl", plan.appServerUrl))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reasoningEffort", plan.reasoningEffort))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reasoningSummary", plan.reasoningSummary))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("maxTurns", plan.maxTurns))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", plan.parseError))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgExecPlanFromJson(text: str): RustCsgExecPlan =
    var result: RustCsgExecPlan
    result.command = wire.RustCsgJsonFindStr(text, "command")
    result.prompt = wire.RustCsgJsonFindStr(text, "prompt")
    result.resumeSessionId = wire.RustCsgJsonFindStr(text, "resumeSessionId")
    result.resumeLast = wire.RustCsgJsonFindBool(text, "resumeLast")
    result.resumeAll = wire.RustCsgJsonFindBool(text, "resumeAll")
    result.images = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "images"))
    result.model = wire.RustCsgJsonFindStr(text, "model")
    result.cwd = wire.RustCsgJsonFindStr(text, "cwd")
    result.sandbox = wire.RustCsgJsonFindStr(text, "sandbox")
    result.color = wire.RustCsgJsonFindStr(text, "color")
    result.json = wire.RustCsgJsonFindBool(text, "json")
    result.outputLastMessage = wire.RustCsgJsonFindStr(text, "outputLastMessage")
    result.outputSchema = wire.RustCsgJsonFindStr(text, "outputSchema")
    result.skipGitRepoCheck = wire.RustCsgJsonFindBool(text, "skipGitRepoCheck")
    result.ephemeral = wire.RustCsgJsonFindBool(text, "ephemeral")
    result.ignoreUserConfig = wire.RustCsgJsonFindBool(text, "ignoreUserConfig")
    result.ignoreRules = wire.RustCsgJsonFindBool(text, "ignoreRules")
    result.removedFullAuto = wire.RustCsgJsonFindBool(text, "removedFullAuto")
    result.dangerouslyBypassApprovalsAndSandbox = wire.RustCsgJsonFindBool(text, "dangerouslyBypassApprovalsAndSandbox")
    result.oss = wire.RustCsgJsonFindBool(text, "oss")
    result.ossProvider = wire.RustCsgJsonFindStr(text, "ossProvider")
    result.configProfile = wire.RustCsgJsonFindStr(text, "configProfile")
    result.configOverrides = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "configOverrides"))
    result.addDirs = wire.RustCsgJsonStringArrayFromRaw(wire.RustCsgJsonFindArray(text, "addDirs"))
    result.reviewUncommitted = wire.RustCsgJsonFindBool(text, "reviewUncommitted")
    result.reviewBase = wire.RustCsgJsonFindStr(text, "reviewBase")
    result.reviewCommit = wire.RustCsgJsonFindStr(text, "reviewCommit")
    result.reviewTitle = wire.RustCsgJsonFindStr(text, "reviewTitle")
    result.appServerUrl = wire.RustCsgJsonFindStr(text, "appServerUrl")
    result.reasoningEffort = wire.RustCsgJsonFindOptionalStr(text, "reasoningEffort")
    result.reasoningSummary = wire.RustCsgJsonFindOptionalStr(text, "reasoningSummary")
    if wire.RustCsgContains(text, "\"maxTurns\""):
        result.maxTurns = wire.RustCsgJsonFindInt32(text, "maxTurns")
    result.parseError = wire.RustCsgJsonFindStr(text, "parseError")
    return result

fn RustCsgExecPlanRuntimeMissingReason(plan: RustCsgExecPlan): str =
    if plan.parseError != "":
        return plan.parseError
    if plan.help:
        return ""
    if plan.command == "run" || plan.command == "resume" || plan.command == "review":
        return ""
    return wire.RustCsgCat("unsupported exec command: ", plan.command)
