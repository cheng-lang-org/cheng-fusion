import cheng/codex/protocol/wire

@abi_internal
@importc("RustCsgReadStdin")
fn RustCsgReadStdin(): str

@importc("RustCsgStdinIsTerminal")
fn RustCsgStdinIsTerminal(): int32

const
    RustCsgPromptRequiredIfPiped: str = "required-if-piped"
    RustCsgPromptForced: str = "forced"
    RustCsgPromptOptionalAppend: str = "optional-append"

fn RustCsgPromptIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn RustCsgPromptTrimmedEmpty(text: str): bool =
    for i in 0..<text.len:
        if !RustCsgPromptIsSpace(text[i]):
            return false
    return true

fn RustCsgPromptEndsWithNewline(text: str): bool =
    if text.len == 0:
        return false
    return text[text.len - 1] == '\n'

fn RustCsgPromptWithStdinContext(prompt: str, stdinText: str): str =
    var out = wire.RustCsgCat(prompt, "\n\n<stdin>\n")
    out = wire.RustCsgCat(out, stdinText)
    if !RustCsgPromptEndsWithNewline(stdinText):
        out = wire.RustCsgCat(out, "\n")
    return wire.RustCsgCat(out, "</stdin>")

fn RustCsgPromptReadFromStdin(behavior: str, outError: var str): str =
    outError = ""
    let terminal = RustCsgStdinIsTerminal() != 0
    if terminal && behavior == RustCsgPromptOptionalAppend:
        return ""
    if terminal && behavior == RustCsgPromptRequiredIfPiped:
        outError = "No prompt provided. Either specify one as an argument or pipe the prompt into stdin."
        return ""
    let buffer = RustCsgReadStdin()
    if RustCsgPromptTrimmedEmpty(buffer):
        if behavior == RustCsgPromptOptionalAppend:
            return ""
        outError = "No prompt provided via stdin."
        return ""
    return buffer

fn RustCsgPromptResolve(promptArg: str, outError: var str): str =
    outError = ""
    if promptArg != "" && promptArg != "-":
        return promptArg
    let behavior = promptArg == "-" ? RustCsgPromptForced : RustCsgPromptRequiredIfPiped
    return RustCsgPromptReadFromStdin(behavior, outError)

fn RustCsgPromptResolveRoot(promptArg: str, outError: var str): str =
    outError = ""
    if promptArg != "" && promptArg != "-":
        let stdinText = RustCsgPromptReadFromStdin(RustCsgPromptOptionalAppend, outError)
        if outError != "":
            return ""
        if stdinText == "":
            return promptArg
        return RustCsgPromptWithStdinContext(promptArg, stdinText)
    return RustCsgPromptResolve(promptArg, outError)
