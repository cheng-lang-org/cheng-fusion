# OpenAI OAuth2 device code flow (RFC 8628)

import std/strings

# ── C provider bindings ─────────────────────────────────────────

@importc("cheng_auth_sleep")
fn oauthSleep(seconds: int32)

@abi_internal
@importc("cheng_auth_url_encode")
fn oauthUrlEncode(s: str): str

@ffi_owned_result(free = free)
@importc("cheng_http_post")
fn rawHttpPostAbi(url: cstring, body: cstring, headers: cstring): owned_cstring

@importc("calloc")
fn oauthCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn oauthMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn oauthFree(raw: ptr)

fn oauthCString(text: str): cstring =
    let raw = oauthCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        oauthMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn oauthFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        oauthFree(ptr(raw))

fn rawHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = oauthCString(url)
    let bodyRaw = oauthCString(body)
    let headersRaw = oauthCString(headers)
    let out: str = rawHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    oauthFreeCString(urlRaw)
    oauthFreeCString(bodyRaw)
    oauthFreeCString(headersRaw)
    return out

# ── Constants ───────────────────────────────────────────────────
# NOTE: Workaround for compiler bug: module-level `let` str constants
# are empty when compiled with system-link-exec. Use functions instead.

fn openaiClientId(): str = "app_EMoamEEZ73f0CkXaXp7hrann"
fn openaiDeviceCodeUrl(): str = "https://auth.openai.com/oauth/device/code"
fn openaiTokenUrl(): str = "https://auth.openai.com/oauth/token"
let MAX_POLL_SECONDS: int32 = 900
let DEFAULT_POLL_INTERVAL: int32 = 5

# ── Types ───────────────────────────────────────────────────────

type
    OAuth2Config =
        clientId: str
        tokenUrl: str
        deviceCodeUrl: str

type
    OAuth2Token =
        accessToken: str
        refreshToken: str
        expiresIn: int32
        tokenType: str

# ── Default OpenAI config ───────────────────────────────────────

fn OpenAIDefaultConfig(): OAuth2Config =
    var config: OAuth2Config
    config.clientId = openaiClientId()
    config.tokenUrl = openaiTokenUrl()
    config.deviceCodeUrl = openaiDeviceCodeUrl()
    return config

# ── String helpers (local) ──────────────────────────────────────

fn oauthConcat3(a: str, b: str, c: str): str =
    var tmp: str = strings.ConcatStr(a, b)
    return strings.ConcatStr(tmp, c)

# ── Substring search (local) ────────────────────────────────────

fn oauthFindSub(text: str, needle: str, start: int32): int32 =
    let n: int32 = strings.Len(text)
    let nl: int32 = strings.Len(needle)
    if nl == 0:
        return -1
    if start + nl > n:
        return -1
    var i: int32 = start
    while i <= n - nl:
        var foundMatch: bool = true
        var j: int32 = 0
        while j < nl:
            let tc: int32 = int32(text[i + j])
            let nc: int32 = int32(needle[j])
            if tc != nc:
                foundMatch = false
                break
            j = j + 1
        if foundMatch:
            return i
        i = i + 1
    return -1

fn oauthSkipWs(text: str, i: int32): int32 =
    var pos: int32 = i
    let n: int32 = strings.Len(text)
    while pos < n:
        let ch: int32 = int32(text[pos])
        if ch == 32:
            pos = pos + 1
        elif ch == 9:
            pos = pos + 1
        elif ch == 10:
            pos = pos + 1
        elif ch == 13:
            pos = pos + 1
        else:
            break
    return pos

# ── JSON string extraction (local) ──────────────────────────────

fn oauthJsonGetStr(json: str, key: str): str =
    let n: int32 = strings.Len(json)
    if n == 0:
        return ""
    if key == "":
        return ""

    var keyPat: str = oauthConcat3("\"", key, "\":")
    var pos: int32 = oauthFindSub(json, keyPat, 0)
    if pos < 0:
        keyPat = strings.ConcatStr(oauthConcat3("\"", key, "\":"), " ")
        pos = oauthFindSub(json, keyPat, 0)
        if pos < 0:
            return ""

    var i: int32 = pos + strings.Len(keyPat)
    i = oauthSkipWs(json, i)
    if i >= n:
        return ""
    let ch: int32 = int32(json[i])
    if ch == 110:
        return ""
    if ch != 34:
        return ""

    i = i + 1
    var result: str = ""
    while i < n:
        let c: int32 = int32(json[i])
        if c == 92:
            i = i + 1
            if i >= n:
                break
            let esc: int32 = int32(json[i])
            if esc == 34:
                result = strings.ConcatStr(result, "\"")
            elif esc == 92:
                result = strings.ConcatStr(result, "\\")
            elif esc == 110:
                result = strings.ConcatStr(result, "\n")
            elif esc == 116:
                result = strings.ConcatStr(result, "\t")
            elif esc == 47:
                result = strings.ConcatStr(result, "/")
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
        elif c == 34:
            break
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
    return result

# ── JSON integer extraction (local) ─────────────────────────────

fn oauthJsonGetInt(json: str, key: str): int32 =
    let n: int32 = strings.Len(json)
    if n == 0:
        return 0
    if key == "":
        return 0

    var keyPat: str = oauthConcat3("\"", key, "\":")
    var pos: int32 = oauthFindSub(json, keyPat, 0)
    if pos < 0:
        keyPat = strings.ConcatStr(oauthConcat3("\"", key, "\":"), " ")
        pos = oauthFindSub(json, keyPat, 0)
        if pos < 0:
            return 0

    var i: int32 = pos + strings.Len(keyPat)
    i = oauthSkipWs(json, i)
    if i >= n:
        return 0
    let firstCh: int32 = int32(json[i])
    if firstCh < 48:
        return 0
    if firstCh > 57:
        return 0

    var val: int32 = 0
    while i < n:
        let digit: int32 = int32(json[i])
        if digit < 48:
            break
        if digit > 57:
            break
        val = val * 10 + (digit - 48)
        i = i + 1
    return val

# ── JSON string escaping (local) ────────────────────────────────

fn oauthJsonEscape(s: str): str =
    let n: int32 = strings.Len(s)
    if n == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < n:
        let ch: char = s[i]
        let cv: int32 = int32(ch)
        if cv == 34:
            result = strings.ConcatStr(result, "\\\"")
        elif cv == 92:
            result = strings.ConcatStr(result, "\\\\")
        elif cv == 8:
            result = strings.ConcatStr(result, "\\b")
        elif cv == 12:
            result = strings.ConcatStr(result, "\\f")
        elif cv == 10:
            result = strings.ConcatStr(result, "\\n")
        elif cv == 13:
            result = strings.ConcatStr(result, "\\r")
        elif cv == 9:
            result = strings.ConcatStr(result, "\\t")
        elif cv < 32:
            let hexTable: str = "0123456789abcdef"
            var nv: int32 = cv
            var d4: int32 = nv / 4096
            nv = nv % 4096
            var d3: int32 = nv / 256
            nv = nv % 256
            var d2: int32 = nv / 16
            var d1: int32 = nv % 16
            result = strings.ConcatStr(result, "\\u")
            result = strings.ConcatStr(result, strings.ConcatStr(strings.ConcatStr(strings.SliceBytes(hexTable, d4, 1), strings.SliceBytes(hexTable, d3, 1)), strings.ConcatStr(strings.SliceBytes(hexTable, d2, 1), strings.SliceBytes(hexTable, d1, 1))))
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(s, i, 1))
        i = i + 1
    return result

# ── HTTP response helpers ───────────────────────────────────────

fn oauthHttpPostJson(url: str, body: str): str =
    let headers: str = "[\"Content-Type: application/x-www-form-urlencoded\"]"
    return rawHttpPost(url, body, headers)

fn oauthHttpCheckError(json: str): bool =
    let err: str = oauthJsonGetStr(json, "error")
    if err != "":
        echo(strings.ConcatStr("OAuth HTTP error: ", err))
        let errDesc: str = oauthJsonGetStr(json, "error_description")
        if errDesc != "":
            echo(strings.ConcatStr("  description: ", errDesc))
        return true
    return false

# ── Step 1: Start device code flow ──────────────────────────────
#
# POST to device code URL with form body:
#   client_id=<id>&scope=openid%20profile%20email
# Response JSON:
#   {"device_code":"...","user_code":"...","verification_uri":"...","interval":5}

fn OAuth2StartDeviceFlow(config: OAuth2Config,
                          outDeviceCode: var str,
                          outUserCode: var str,
                          outVerificationUri: var str): bool =
    let scope: str = "openid%20profile%20email"
    let body: str = oauthConcat3(
        oauthConcat3("client_id=", oauthUrlEncode(config.clientId), ""),
        "&scope=",
        scope)
    let raw: str = oauthHttpPostJson(config.deviceCodeUrl, body)
    if raw == "":
        echo("OAuthStartDeviceFlow: empty response")
        return false
    if oauthHttpCheckError(raw):
        return false
    outDeviceCode = oauthJsonGetStr(raw, "device_code")
    outUserCode = oauthJsonGetStr(raw, "user_code")
    outVerificationUri = oauthJsonGetStr(raw, "verification_uri")
    return true

# ── Step 2: Poll token endpoint ─────────────────────────────────
#
# POST to token URL with form body:
#   client_id=<id>&device_code=<code>&grant_type=urn:ietf:params:oauth:grant-type:device_code
# Response JSON (success):
#   {"access_token":"...","refresh_token":"...","expires_in":3600,"token_type":"Bearer"}
# Response JSON (pending):
#   {"error":"authorization_pending"}
# Response JSON (slow_down):
#   {"error":"slow_down"}

fn OAuth2PollToken(config: OAuth2Config, deviceCode: str,
                    outToken: var OAuth2Token): bool =
    let grantType: str = "urn:ietf:params:oauth:grant-type:device_code"
    let body: str = oauthConcat3(
        oauthConcat3(
            oauthConcat3("client_id=", oauthUrlEncode(config.clientId), ""),
            "&device_code=",
            oauthUrlEncode(deviceCode)),
        "&grant_type=",
        grantType)

    var pollInterval: int32 = DEFAULT_POLL_INTERVAL
    var elapsed: int32 = 0

    while elapsed < MAX_POLL_SECONDS:
        let raw: str = oauthHttpPostJson(config.tokenUrl, body)
        if raw == "":
            echo("OAuthPollToken: empty response")
            return false

        let err: str = oauthJsonGetStr(raw, "error")
        if err == "authorization_pending":
            echo("Authorization pending, waiting...")
            oauthSleep(pollInterval)
            elapsed = elapsed + pollInterval
            # continue
        elif err == "slow_down":
            echo("Server requested slow down, increasing interval")
            pollInterval = pollInterval * 2
            if pollInterval > 60:
                pollInterval = 60
            oauthSleep(pollInterval)
            elapsed = elapsed + pollInterval
            # continue
        elif err != "":
            echo(strings.ConcatStr("OAuth poll error: ", err))
            let errDesc: str = oauthJsonGetStr(raw, "error_description")
            if errDesc != "":
                echo(strings.ConcatStr("  description: ", errDesc))
            return false
        else:
            outToken.accessToken = oauthJsonGetStr(raw, "access_token")
            outToken.refreshToken = oauthJsonGetStr(raw, "refresh_token")
            outToken.expiresIn = oauthJsonGetInt(raw, "expires_in")
            outToken.tokenType = oauthJsonGetStr(raw, "token_type")
            if outToken.tokenType == "":
                outToken.tokenType = "Bearer"
            return true

    echo("OAuthPollToken: timeout after 900 seconds")
    return false

# ── Step 3: Refresh token ───────────────────────────────────────
#
# POST to token URL with form body:
#   client_id=<id>&refresh_token=<token>&grant_type=refresh_token

fn OAuth2RefreshToken(config: OAuth2Config, refreshToken: str,
                       outToken: var OAuth2Token): bool =
    let body: str = oauthConcat3(
        oauthConcat3(
            oauthConcat3("client_id=", oauthUrlEncode(config.clientId), ""),
            "&refresh_token=",
            oauthUrlEncode(refreshToken)),
        "&grant_type=",
        "refresh_token")

    let raw: str = oauthHttpPostJson(config.tokenUrl, body)
    if raw == "":
        echo("OAuthRefreshToken: empty response")
        return false
    if oauthHttpCheckError(raw):
        return false
    outToken.accessToken = oauthJsonGetStr(raw, "access_token")
    outToken.refreshToken = oauthJsonGetStr(raw, "refresh_token")
    outToken.expiresIn = oauthJsonGetInt(raw, "expires_in")
    outToken.tokenType = oauthJsonGetStr(raw, "token_type")
    if outToken.tokenType == "":
        outToken.tokenType = "Bearer"
    return true

# ── Serialization ───────────────────────────────────────────────

fn OAuth2TokenToJson(token: OAuth2Token): str =
    var json: str = "{\"access_token\":\""
    json = strings.ConcatStr(json, oauthJsonEscape(token.accessToken))
    json = strings.ConcatStr(json, "\",\"refresh_token\":\"")
    json = strings.ConcatStr(json, oauthJsonEscape(token.refreshToken))
    json = strings.ConcatStr(json, "\",\"expires_in\":")
    json = strings.ConcatStr(json, strings.IntToStr(token.expiresIn))
    json = strings.ConcatStr(json, ",\"token_type\":\"")
    json = strings.ConcatStr(json, oauthJsonEscape(token.tokenType))
    json = strings.ConcatStr(json, "\"}")
    return json

fn OAuth2TokenFromJson(json: str): OAuth2Token =
    var token: OAuth2Token
    token.accessToken = oauthJsonGetStr(json, "access_token")
    token.refreshToken = oauthJsonGetStr(json, "refresh_token")
    token.expiresIn = oauthJsonGetInt(json, "expires_in")
    token.tokenType = oauthJsonGetStr(json, "token_type")
    if token.tokenType == "":
        token.tokenType = "Bearer"
    return token
