# OpenAI OAuth2 login binary entrypoint
#
# Usage: login_bin [--provider openai]
#
# Starts the device code flow, prints the verification URI and user code,
# polls for token, and saves credentials to ~/.codex/credentials.json.

import std/strings
import std/cmdline as cmdline
import cheng/codex/login/oauth
import cheng/codex/config/home

# ── C provider bindings ─────────────────────────────────────────

@abi_internal
@importc("cheng_auth_write_file")
fn writeFile(path: str, content: str): int32

@abi_internal
@importc("cheng_auth_mkdir")
fn mkdirP(path: str): int32

# ── Helpers ─────────────────────────────────────────────────────

fn findFlag(args: str[], flag: str): str =
    var i: int32 = 0
    while i < args.len:
        if args[i] == flag:
            if i + 1 < args.len:
                return args[i + 1]
            return ""
        i = i + 1
    return ""

fn saveCredentials(path: str, token: oauth.OAuth2Token): bool =
    let json: str = oauth.OAuth2TokenToJson(token)
    if writeFile(path, json) != 0:
        return true
    echo(strings.ConcatStr("Failed to write credentials to ", path))
    return false

# ── Entry point ─────────────────────────────────────────────────

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)

    # Parse args
    var args: str[]
    let count: int32 = cmdline.paramCount()
    var i: int32 = 0
    while i < count:
        add(args, cmdline.paramStr(i))
        i = i + 1

    let providerFlag: str = findFlag(args, "--provider")

    if providerFlag == "":
        echo("Usage: login_bin --provider openai")
        return 1

    if providerFlag != "openai":
        echo(strings.ConcatStr("Unsupported provider: ", providerFlag))
        return 1

    # Get home directory
    let homeDir: str = home.RustCsgGetEnv("HOME")
    if homeDir == "":
        echo("HOME environment variable not set")
        return 1

    # Ensure ~/.codex directory exists
    let codexDir: str = strings.ConcatStr(homeDir, "/.codex")
    mkdirP(codexDir)

    # ── Start device code flow ──────────────────────────────────
    let config: oauth.OAuth2Config = oauth.OpenAIDefaultConfig()

    var deviceCode: str
    var userCode: str
    var verificationUri: str

    echo("Starting OpenAI OAuth2 device code login...")
    if !oauth.OAuth2StartDeviceFlow(config, deviceCode, userCode, verificationUri):
        echo("Failed to start device code flow")
        return 1

    # ── Print prompt ────────────────────────────────────────────
    echo("")
    echo("To sign in, open this link in your browser:")
    echo(strings.ConcatStr("  ", verificationUri))
    echo("")
    echo("And enter the following code:")
    echo(strings.ConcatStr("  ", userCode))
    echo("")
    echo("(Code expires in 15 minutes)")
    echo("")

    # ── Poll for token ──────────────────────────────────────────
    var token: oauth.OAuth2Token
    if !oauth.OAuth2PollToken(config, deviceCode, token):
        echo("Failed to obtain token")
        return 1

    echo("Login successful!")

    # ── Save credentials ────────────────────────────────────────
    let credPath: str = strings.ConcatStr(codexDir, "/credentials.json")
    if !saveCredentials(credPath, token):
        return 1

    echo(strings.ConcatStr("Credentials saved to ", credPath))
    return 0
