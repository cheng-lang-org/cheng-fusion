# CLI device code step functions
# Each function is small and compiles independently.
# Called individually by CliLoginDeviceCode in cli_login.cheng.

import std/strings

# ── C provider bindings ───────────────────────────────────────────────

@ffi_owned_result(free = free)
@importc("cheng_http_post")
fn rawHttpPostAbi(url: cstring, body: cstring, headers: cstring): owned_cstring

@importc("calloc")
fn cliDeviceCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn cliDeviceMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn cliDeviceFree(raw: ptr)

fn cliDeviceCString(text: str): cstring =
    let raw = cliDeviceCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        cliDeviceMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn cliDeviceFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        cliDeviceFree(ptr(raw))

fn rawHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = cliDeviceCString(url)
    let bodyRaw = cliDeviceCString(body)
    let headersRaw = cliDeviceCString(headers)
    let out: str = rawHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    cliDeviceFreeCString(urlRaw)
    cliDeviceFreeCString(bodyRaw)
    cliDeviceFreeCString(headersRaw)
    return out

@abi_internal
@importc("cheng_auth_url_encode")
fn authUrlEncode(s: str): str

@importc("cheng_auth_sleep")
fn authSleep(seconds: int32)

let DEFAULT_INTERVAL: int32 = 5

# ── Helpers ───────────────────────────────────────────────────────────

fn jsonFindKey(json: str, key: str): int32 =
    let n: int32 = strings.Len(json)
    let kl: int32 = strings.Len(key)
    if kl == 0 || kl > n:
        return -1
    var i: int32 = 0
    while i <= n - kl:
        var matched: bool = true
        var j: int32 = 0
        while j < kl:
            if json[i + j] != key[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return i
        i = i + 1
    return -1

fn jsonReadStr(json: str, start: int32, outVal: var str): bool =
    let n: int32 = strings.Len(json)
    var i: int32 = start
    if i >= n:
        return false
    if int32(json[i]) != 34:
        return false
    i = i + 1
    var result: str = ""
    while i < n:
        let cv: int32 = int32(json[i])
        if cv == 34:
            outVal = result
            return true
        if cv == 92:
            i = i + 1
            if i >= n:
                outVal = result
                return true
            let ecv: int32 = int32(json[i])
            if ecv == 110:
                result = strings.ConcatStr(result, "\n")
            elif ecv == 114:
                result = strings.ConcatStr(result, "\r")
            elif ecv == 116:
                result = strings.ConcatStr(result, "\t")
            elif ecv == 34:
                result = strings.ConcatStr(result, "\"")
            elif ecv == 92:
                result = strings.ConcatStr(result, "\\")
            elif ecv == 47:
                result = strings.ConcatStr(result, "/")
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(json, i, 1))
            i = i + 1
    outVal = result
    return true

fn parseHttpCode(raw: str): int32 =
    if raw == "" || strings.HasPrefix(raw, "{\"error\":"):
        return 0
    if strings.HasPrefix(raw, "{\"status\":"):
        var i: int32 = 10
        var code: int32 = 0
        let n: int32 = strings.Len(raw)
        while i < n:
            let cv: int32 = int32(raw[i])
            if cv >= 48 && cv <= 57:
                code = code * 10 + (cv - 48)
                i = i + 1
            else:
                break
        return code
    return 0

fn parseHttpBody(raw: str): str =
    if raw == "" || strings.HasPrefix(raw, "{\"error\":"):
        return ""
    let marker: str = "\"body\":\""
    var pos: int32 = -1
    var i: int32 = 0
    let n: int32 = strings.Len(raw)
    while i <= n - strings.Len(marker):
        var matched: bool = true
        var j: int32 = 0
        while j < strings.Len(marker):
            if raw[i + j] != marker[j]:
                matched = false
                break
            j = j + 1
        if matched:
            pos = i + strings.Len(marker)
            break
        i = i + 1
    if pos < 0:
        return ""
    var result: str = ""
    i = pos
    while i < n:
        let cv: int32 = int32(raw[i])
        if cv == 34:
            break
        if cv == 92:
            i = i + 1
            if i >= n:
                break
            let ecv: int32 = int32(raw[i])
            if ecv == 110:
                result = strings.ConcatStr(result, "\n")
            elif ecv == 114:
                result = strings.ConcatStr(result, "\r")
            elif ecv == 116:
                result = strings.ConcatStr(result, "\t")
            elif ecv == 34:
                result = strings.ConcatStr(result, "\"")
            elif ecv == 92:
                result = strings.ConcatStr(result, "\\")
            elif ecv == 47:
                result = strings.ConcatStr(result, "/")
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(raw, i, 1))
            i = i + 1
        else:
            result = strings.ConcatStr(result, strings.SliceBytes(raw, i, 1))
            i = i + 1
    return result

fn devicePostJson(url: str, body: str): str =
    let headers: str = "[\"Content-Type: application/json\"]"
    let raw: str = rawHttpPost(url, body, headers)
    if raw == "":
        return ""
    let code: int32 = parseHttpCode(raw)
    if code == 0:
        return ""
    return parseHttpBody(raw)

# ── Step 1: Request user code ────────────────────────────────────────

fn deviceRequestUserCode(apiBaseUrl: str, clientId: str,
                          outDeviceAuthId: var str,
                          outUserCode: var str,
                          outInterval: var int32): bool =
    let url: str = strings.ConcatStr(apiBaseUrl, "/deviceauth/usercode")
    var reqBody: str = "{\"client_id\":\""
    reqBody = strings.ConcatStr(reqBody, clientId)
    reqBody = strings.ConcatStr(reqBody, "\"}")
    let respBody: str = devicePostJson(url, reqBody)
    if respBody == "":
        return false
    let daKey: str = "\"device_auth_id\":\""
    if jsonFindKey(respBody, daKey) < 0:
        return false
    var daPos: int32 = jsonFindKey(respBody, daKey)
    if daPos >= 0:
        if !jsonReadStr(respBody, daPos + strings.Len(daKey), outDeviceAuthId):
            return false
    var ucPos: int32 = jsonFindKey(respBody, "\"user_code\":\"")
    if ucPos >= 0:
        if !jsonReadStr(respBody, ucPos + strings.Len("\"user_code\":\""), outUserCode):
            return false
    outInterval = DEFAULT_INTERVAL
    if outDeviceAuthId == "" || outUserCode == "":
        return false
    return true

# ── Step 2: Poll for token ───────────────────────────────────────────

fn devicePollForToken(apiBaseUrl: str, deviceAuthId: str, userCode: str,
                       outAuthCode: var str,
                       outCodeVerifier: var str): bool =
    let url: str = strings.ConcatStr(apiBaseUrl, "/deviceauth/token")
    var reqBody: str = "{\"device_auth_id\":\""
    reqBody = strings.ConcatStr(reqBody, deviceAuthId)
    reqBody = strings.ConcatStr(reqBody, "\",\"user_code\":\"")
    reqBody = strings.ConcatStr(reqBody, userCode)
    reqBody = strings.ConcatStr(reqBody, "\"}")
    var elapsed: int32 = 0
    while elapsed < 900:
        let respBody: str = devicePostJson(url, reqBody)
        if respBody == "":
            return false
        let acKey: str = "\"authorization_code\":\""
        if jsonFindKey(respBody, acKey) >= 0:
            var acPos: int32 = jsonFindKey(respBody, acKey)
            if acPos >= 0:
                if jsonReadStr(respBody, acPos + strings.Len(acKey), outAuthCode):
                    var cvKey: str = "\"code_verifier\":\""
                    var cvPos: int32 = jsonFindKey(respBody, cvKey)
                    if cvPos >= 0:
                        jsonReadStr(respBody, cvPos + strings.Len(cvKey), outCodeVerifier)
                    return true
            return false
        let errKey: str = "\"error\":\""
        if jsonFindKey(respBody, errKey) >= 0:
            var errVal: str = ""
            var errPos: int32 = jsonFindKey(respBody, errKey)
            if errPos >= 0:
                jsonReadStr(respBody, errPos + strings.Len(errKey), errVal)
            if errVal != "" && errVal != "authorization_pending" && errVal != "slow_down":
                return false
        elapsed = elapsed + DEFAULT_INTERVAL
        if elapsed < 900:
            authSleep(DEFAULT_INTERVAL)
    return false

# ── Step 3: Exchange code for tokens ─────────────────────────────────

fn deviceExchangeCode(issuer: str, clientId: str, redirectUri: str,
                       codeVerifier: str, authCode: str,
                       outAccessToken: var str,
                       outRefreshToken: var str,
                       outIdToken: var str): bool =
    let tokenEndpoint: str = strings.ConcatStr(issuer, "/oauth/token")
    var body: str = "grant_type=authorization_code"
    body = strings.ConcatStr(body, "&code=")
    body = strings.ConcatStr(body, authUrlEncode(authCode))
    body = strings.ConcatStr(body, "&redirect_uri=")
    body = strings.ConcatStr(body, authUrlEncode(redirectUri))
    body = strings.ConcatStr(body, "&client_id=")
    body = strings.ConcatStr(body, authUrlEncode(clientId))
    body = strings.ConcatStr(body, "&code_verifier=")
    body = strings.ConcatStr(body, authUrlEncode(codeVerifier))
    let headers: str = "[\"Content-Type: application/x-www-form-urlencoded\"]"
    let raw: str = rawHttpPost(tokenEndpoint, body, headers)
    if raw == "":
        return false
    let code: int32 = parseHttpCode(raw)
    if code == 0:
        return false
    let respBody: str = parseHttpBody(raw)
    if respBody == "":
        return false
    let atKey: str = "\"access_token\":\""
    if jsonFindKey(respBody, atKey) < 0:
        return false
    var atPos: int32 = jsonFindKey(respBody, atKey)
    if atPos >= 0:
        jsonReadStr(respBody, atPos + strings.Len(atKey), outAccessToken)
    var rtPos: int32 = jsonFindKey(respBody, "\"refresh_token\":\"")
    if rtPos >= 0:
        jsonReadStr(respBody, rtPos + strings.Len("\"refresh_token\":\""), outRefreshToken)
    var itPos: int32 = jsonFindKey(respBody, "\"id_token\":\"")
    if itPos >= 0:
        jsonReadStr(respBody, itPos + strings.Len("\"id_token\":\""), outIdToken)
    if outAccessToken == "":
        return false
    return true
