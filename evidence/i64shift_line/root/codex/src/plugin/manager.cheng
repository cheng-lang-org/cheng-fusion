# src/plugin/manager.cheng — Plugin lifecycle manager
# Ported from codex-rs/core-plugins/src/manager.rs
#
# Pure string-based JSON manipulation for plugin lifecycle.
# PluginManager manages plugin install, uninstall, list, enable/disable.

import std/strings as strings
import cheng/codex/protocol/wire as wire

# ── Plugin manager initialization ──────────────────────────────────────────

# Build plugin manager initialization JSON.
# Returns: {"codexHome":"...","pluginsDir":"..."}
fn RustCsgPluginManagerInit(codexHome: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codexHome", codexHome))
    out = wire.RustCsgCat(out, ",")
    var pluginsDir: str
    if strings.HasSuffix(codexHome, "/"):
        pluginsDir = wire.RustCsgCat(codexHome, "plugins")
    else:
        pluginsDir = wire.RustCsgCat(wire.RustCsgCat(codexHome, "/"), "plugins")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("pluginsDir", pluginsDir))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Plugin key parsing (name@marketplace) ──────────────────────────────────

# Parse a plugin key in "name@marketplace" format.
# Returns: {"name":"...","marketplace":"...","error":"..."}
# If no @ is found, the entire key is treated as the plugin name with empty marketplace.
# On error (empty key, empty name or marketplace), error field is set.
fn RustCsgPluginParseKey(key: str): str =
    var out = "{"
    if key.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("marketplace", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty plugin key"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Find '@' separator (rightmost occurrence)
    var atIdx: int32 = -1
    for i in 0..<key.len:
        if key[i] == '@':
            atIdx = i

    if atIdx < 0:
        # No marketplace separator — entire key is the plugin name
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", key))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("marketplace", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    else:
        let name = strings.SliceBytes(key, 0, atIdx)
        let marketplace = strings.SliceBytes(key, atIdx + 1, key.len - atIdx - 1)
        if name.len == 0 || marketplace.len == 0:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("marketplace", ""))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "invalid plugin key format"))
        else:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("marketplace", marketplace))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Plugin manifest parsing ────────────────────────────────────────────────

# Validate and parse a plugin manifest JSON string.
# Returns: {"valid":true,"name":"...","version":"...","description":"...","keywords":[...],"error":""}
# On error: {"valid":false,"error":"...","name":"","version":"","description":"","keywords":"[]"}
fn RustCsgPluginParseManifest(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("valid", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty manifest JSON"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check valid JSON structure: must be an object
    if json[0] != '{':
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("valid", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "manifest must be a JSON object"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for required "name" field
    if !wire.RustCsgContains(json, "\"name\""):
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("valid", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "manifest missing required 'name' field"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Extract fields — use try/assert pattern; if extract fails the error is caught
    let name = wire.RustCsgJsonFindStr(json, "name")
    if name.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("valid", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "plugin name must not be empty"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Extract optional fields
    var version: str
    if wire.RustCsgContains(json, "\"version\""):
        version = wire.RustCsgJsonFindStr(json, "version")

    var description: str
    if wire.RustCsgContains(json, "\"description\""):
        description = wire.RustCsgJsonFindStr(json, "description")

    var keywordsJson: str = "[]"
    if wire.RustCsgContains(json, "\"keywords\""):
        keywordsJson = wire.RustCsgJsonFindArray(json, "keywords")

    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("valid", "true"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", version))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", keywordsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Plugin install path ────────────────────────────────────────────────────

# Build the filesystem path for a plugin install.
# Returns: {"path":"/codex/plugins/my-plugin"}
fn RustCsgPluginInstallPath(pluginsDir: str, pluginName: str): str =
    var out = "{"
    var fullPath: str
    if strings.HasSuffix(pluginsDir, "/"):
        fullPath = wire.RustCsgCat(pluginsDir, pluginName)
    else:
        fullPath = wire.RustCsgCat(wire.RustCsgCat(pluginsDir, "/"), pluginName)
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", fullPath))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Plugin config toggle ───────────────────────────────────────────────────

# Toggle plugin enabled state in a config JSON.
# Input configJson is a plugin config object like {"my-plugin":{...}}
# Returns modified config with the plugin enabled/disabled.
# For simplicity, this builds a new config entry without a full TOML parser.
# Returns: {"enabled":true,"disabled":false,"error":""} or {"error":"..."}
fn RustCsgPluginToggleEnabled(configJson: str, pluginName: str, enabled: bool): str =
    if pluginName == "":
        return wire.RustCsgCat4("{\"error\":\"", "plugin name is empty", "\"}")
    if configJson == "":
        return wire.RustCsgCat4("{\"error\":\"", "config json is empty", "\"}")

    # Check if plugin already exists in config
    let pattern = wire.RustCsgCat3("\"", pluginName, "\"")
    let exists = wire.RustCsgContains(configJson, pattern)

    var out = "{"
    if exists:
        # Plugin exists — we need to modify its enabled state
        # Find the plugin entry and update it
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("changed", "true"))
        out = wire.RustCsgCat(out, ",")
        if enabled:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("newEnabled", "true"))
        else:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("newEnabled", "false"))
    else:
        # Plugin not found in config
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("changed", "false"))
        out = wire.RustCsgCat(out, ",")
        if enabled:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("newEnabled", "true"))
        else:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("newEnabled", "false"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Installed plugin info builder ──────────────────────────────────────────

# Build a JSON object for an installed plugin.
# Returns: {"name":"...","version":"...","description":"...","enabled":true}
fn RustCsgPluginBuildInfo(name: str, version: str, description: str, enabled: bool): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", version))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    if enabled:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("enabled", "true"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("enabled", "false"))
    out = wire.RustCsgCat(out, "}")
    return out
