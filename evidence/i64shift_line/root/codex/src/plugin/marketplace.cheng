# src/plugin/marketplace.cheng — Plugin marketplace
# Ported from codex-rs/core-plugins/src/marketplace.rs
#
# Marketplace URL building and response parsing for plugin discovery.
# Uses HTTP GET to interact with marketplace APIs.

import std/strings as strings
import std/strutils as strutil
import cheng/codex/protocol/wire as wire

# ── URL builders ───────────────────────────────────────────────────────────

# Build a marketplace search URL.
# apiBase: base URL like "https://api.example.com/v1"
# query: search query string
# Returns: {"url":"https://api.example.com/v1/plugins?q=query"}
fn RustCsgMarketplaceBuildSearchUrl(apiBase: str, query: str): str =
    var out = "{"
    var url: str
    # Strip trailing slash from apiBase
    var base: str = apiBase
    if strings.HasSuffix(base, "/"):
        base = strings.SliceBytes(base, 0, base.len - 1)

    if query.len == 0:
        url = strutil.Join([base, "/plugins"], "")
    else:
        # URL-encode the query (simple version: replace spaces with %20)
        var encodedQuery: str
        for i in 0..<query.len:
            if query[i] == ' ':
                encodedQuery = strutil.Join([encodedQuery, "%20"], "")
            elif query[i] == '"':
                encodedQuery = strutil.Join([encodedQuery, "%22"], "")
            elif query[i] == '&':
                encodedQuery = strutil.Join([encodedQuery, "%26"], "")
            elif query[i] == '=':
                encodedQuery = strutil.Join([encodedQuery, "%3D"], "")
            elif query[i] == '?':
                encodedQuery = strutil.Join([encodedQuery, "%3F"], "")
            elif query[i] == '#':
                encodedQuery = strutil.Join([encodedQuery, "%23"], "")
            else:
                encodedQuery = strutil.Join([encodedQuery, strings.SliceBytes(query, i, 1)], "")
        url = strutil.Join([base, "/plugins?q=", encodedQuery], "")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", url))
    out = wire.RustCsgCat(out, "}")
    return out

# Build a plugin details URL.
# apiBase: base URL
# pluginName: name of the plugin
# Returns: {"url":"https://api.example.com/v1/plugins/plugin-name"}
fn RustCsgMarketplaceBuildDetailsUrl(apiBase: str, pluginName: str): str =
    var out = "{"
    var base: str = apiBase
    if strings.HasSuffix(base, "/"):
        base = strings.SliceBytes(base, 0, base.len - 1)
    var url: str
    if pluginName.len == 0:
        url = strutil.Join([base, "/plugins"], "")
    else:
        url = strutil.Join([base, "/plugins/", pluginName], "")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", url))
    out = wire.RustCsgCat(out, "}")
    return out

# Build a plugin download URL.
# apiBase: base URL
# pluginName: name of the plugin
# version: optional version string (empty for latest)
# Returns: {"url":"https://api.example.com/v1/plugins/plugin-name/download"}
fn RustCsgMarketplaceBuildDownloadUrl(apiBase: str, pluginName: str, version: str): str =
    var out = "{"
    var base: str = apiBase
    if strings.HasSuffix(base, "/"):
        base = strings.SliceBytes(base, 0, base.len - 1)
    var url: str
    if version.len == 0:
        url = strutil.Join([base, "/plugins/", pluginName, "/download"], "")
    else:
        url = strutil.Join([base, "/plugins/", pluginName, "/download?version=", version], "")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", url))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Response parsing ───────────────────────────────────────────────────────

# Parse a marketplace search response JSON.
# Expected format: {"plugins":[{"name":"...","version":"...","description":"..."}]}
# Returns: {"plugins":[...],"count":N,"error":""} on success
# On error: {"plugins":[],"count":0,"error":"..."}
fn RustCsgMarketplaceParseSearchResponse(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("plugins", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("count", "0"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty response"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Parse plugins array if present
    if wire.RustCsgContains(json, "\"plugins\""):
        let pluginsJson = wire.RustCsgJsonFindArray(json, "plugins")
        # Count plugins by counting objects in the array
        var count: int32
        if pluginsJson.len > 2:
            # Simple count: count occurrences of "name": in the array
            var searchPos: int32 = 1
            while searchPos < pluginsJson.len - 1:
                if wire.RustCsgMatchesAt(pluginsJson, searchPos, "\"name\""):
                    count = count + 1
                    searchPos = searchPos + 6
                else:
                    searchPos = searchPos + 1
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("plugins", pluginsJson))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("count", count))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    else:
        # No plugins array — check for error
        var errMsg: str
        if wire.RustCsgContains(json, "\"error\""):
            if wire.RustCsgContains(json, "\"message\""):
                errMsg = wire.RustCsgJsonFindStr(json, "message")
            else:
                errMsg = "marketplace error in response"
        else:
            errMsg = "no plugins in response"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("plugins", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("count", "0"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", errMsg))
    out = wire.RustCsgCat(out, "}")
    return out

# Parse a marketplace plugin details response.
# Expected format: {"name":"...","version":"...","description":"...","keywords":[...],...}
# Returns: {"name":"...","version":"...","description":"...","keywords":[...],"error":""}
fn RustCsgMarketplaceParsePluginDetails(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty response"))
        out = wire.RustCsgCat(out, "}")
        return out

    if !wire.RustCsgContains(json, "\"name\""):
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "missing name field"))
        out = wire.RustCsgCat(out, "}")
        return out

    let name = wire.RustCsgJsonFindStr(json, "name")

    var version: str
    if wire.RustCsgContains(json, "\"version\""):
        version = wire.RustCsgJsonFindStr(json, "version")

    var description: str
    if wire.RustCsgContains(json, "\"description\""):
        description = wire.RustCsgJsonFindStr(json, "description")

    var keywordsJson: str = "[]"
    if wire.RustCsgContains(json, "\"keywords\""):
        keywordsJson = wire.RustCsgJsonFindArray(json, "keywords")

    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("version", version))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("keywords", keywordsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Local marketplace manifest parsing ─────────────────────────────────────

# Parse a local marketplace manifest JSON (the marketplace.json file).
# Expected format: {"name":"...","displayName":"...","plugins":[...]}
# Returns: {"name":"...","displayName":"...","pluginCount":N,"error":""}
fn RustCsgMarketplaceParseManifest(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("displayName", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("pluginCount", "0"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty manifest"))
        out = wire.RustCsgCat(out, "}")
        return out

    if json[0] != '{':
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("displayName", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("pluginCount", "0"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "not a JSON object"))
        out = wire.RustCsgCat(out, "}")
        return out

    var name: str
    if wire.RustCsgContains(json, "\"name\""):
        name = wire.RustCsgJsonFindStr(json, "name")

    var displayName: str
    if wire.RustCsgContains(json, "\"displayName\""):
        displayName = wire.RustCsgJsonFindStr(json, "displayName")

    var pluginCount: int32
    if wire.RustCsgContains(json, "\"plugins\""):
        let pluginsJson = wire.RustCsgJsonFindArray(json, "plugins")
        if pluginsJson.len > 2:
            var count: int32
            var searchPos: int32 = 1
            while searchPos < pluginsJson.len - 1:
                if wire.RustCsgMatchesAt(pluginsJson, searchPos, "\"name\""):
                    count = count + 1
                    searchPos = searchPos + 6
                else:
                    searchPos = searchPos + 1
            pluginCount = count

    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("displayName", displayName))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pluginCount", pluginCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out
