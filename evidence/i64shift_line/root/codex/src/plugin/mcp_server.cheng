# src/plugin/mcp_server.cheng — MCP server process management
# Ported from codex-rs/rmcp-client/src/stdio_server_launcher.rs and rmcp_client.rs
#
# MCP (Model Context Protocol) JSON-RPC 2.0 message building and parsing.
# MCP protocol version: 2024-11-05

import std/strings as strings
import std/strutils as strutil
import cheng/codex/protocol/wire as wire

# ── MCP server config builder ──────────────────────────────────────────────

# Build an MCP server configuration JSON.
# Returns: {"name":"...","command":"...","args":[...],"env":{...},"cwd":"..."}
fn RustCsgMcpServerBuildConfig(
    name: str,
    command: str,
    argsJson: str,
    envJson: str,
    cwd: str
): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", command))
    out = wire.RustCsgCat(out, ",")
    if argsJson == "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("args", "[]"))
    else:
        wire.RustCsgJsonAssertRawValue(argsJson)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("args", argsJson))
    out = wire.RustCsgCat(out, ",")
    if envJson == "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("env", "{}"))
    else:
        wire.RustCsgJsonAssertRawValue(envJson)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("env", envJson))
    out = wire.RustCsgCat(out, ",")
    if cwd == "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwd", "null"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    out = wire.RustCsgCat(out, "}")
    return out

# ── JSON-RPC 2.0 helpers ───────────────────────────────────────────────────

# Build a JSON-RPC 2.0 request with a given id, method, and optional params.
# Returns a valid JSON-RPC 2.0 request string.
fn RustCsgMcpServerBuildRequest(id: int32, method: str, paramsJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("jsonrpc", "2.0"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", method))
    if paramsJson != "":
        out = wire.RustCsgCat(out, ",")
        wire.RustCsgJsonAssertRawValue(paramsJson)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("params", paramsJson))
    out = wire.RustCsgCat(out, "}")
    return out

# Build a JSON-RPC 2.0 notification (no "id" field).
# Returns the JSON string, or "" if method is empty.
fn RustCsgMcpServerBuildNotification(method: str, paramsJson: str): str =
    if method.len == 0:
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("jsonrpc", "2.0"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("method", method))
    if paramsJson != "":
        out = wire.RustCsgCat(out, ",")
        wire.RustCsgJsonAssertRawValue(paramsJson)
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("params", paramsJson))
    out = wire.RustCsgCat(out, "}")
    return out

# ── MCP initialize request/response ────────────────────────────────────────

# Build MCP initialize request (JSON-RPC 2.0).
# Protocol version: 2024-11-05
# Returns the full initialize request JSON.
fn RustCsgMcpServerBuildInitializeRequest(clientName: str, version: str): str =
    # Build clientInfo: {"name":"clientName","version":"version"}
    let namePart = wire.RustCsgCat4(
        "{\"name\":", wire.RustCsgJsonQuote(clientName),
        ",\"version\":", wire.RustCsgJsonQuote(version))
    let clientInfo = wire.RustCsgCat(namePart, "}")
    # Build params: {"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{...}}
    var params = wire.RustCsgCat4(
        "{\"protocolVersion\":\"2024-11-05\",",
        "\"capabilities\":{},",
        "\"clientInfo\":",
        clientInfo)
    params = wire.RustCsgCat(params, "}")
    return RustCsgMcpServerBuildRequest(1, "initialize", params)

# Parse MCP initialize response.
# Returns: {"serverName":"...","serverVersion":"...","protocolVersion":"...","error":""}
# On error: {"serverName":"","serverVersion":"","protocolVersion":"","error":"message"}
fn RustCsgMcpServerParseInitializeResponse(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverName", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("protocolVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty response"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for error first
    if wire.RustCsgContains(json, "\"error\""):
        var errMsg: str
        if wire.RustCsgContains(json, "\"message\""):
            errMsg = wire.RustCsgJsonFindStr(json, "message")
        else:
            errMsg = "MCP initialize failed"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverName", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("protocolVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", errMsg))
        out = wire.RustCsgCat(out, "}")
        return out

    # Parse result
    if wire.RustCsgContains(json, "\"result\""):
        let resultJson = wire.RustCsgJsonFindObject(json, "result")
        var serverName: str
        var serverVersion: str
        var protocolVersion: str

        if wire.RustCsgContains(resultJson, "\"serverInfo\""):
            let serverInfoJson = wire.RustCsgJsonFindObject(resultJson, "serverInfo")
            if wire.RustCsgContains(serverInfoJson, "\"name\""):
                serverName = wire.RustCsgJsonFindStr(serverInfoJson, "name")
            if wire.RustCsgContains(serverInfoJson, "\"version\""):
                serverVersion = wire.RustCsgJsonFindStr(serverInfoJson, "version")

        if wire.RustCsgContains(resultJson, "\"protocolVersion\""):
            protocolVersion = wire.RustCsgJsonFindStr(resultJson, "protocolVersion")

        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverName", serverName))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverVersion", serverVersion))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("protocolVersion", protocolVersion))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverName", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("serverVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("protocolVersion", ""))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "no result in response"))
    out = wire.RustCsgCat(out, "}")
    return out

# ── MCP tools/list request/response ────────────────────────────────────────

# Build MCP tools/list request (JSON-RPC 2.0).
# Returns: {"jsonrpc":"2.0","id":1,"method":"tools/list"}
fn RustCsgMcpServerBuildToolsListRequest(): str =
    return RustCsgMcpServerBuildRequest(1, "tools/list", "")

# Parse MCP tools/list response.
# Extracts the tools array from the JSON-RPC result.
# Returns: {"tools":[...],"error":""} on success, {"tools":"[]","error":"message"} on error
fn RustCsgMcpServerParseToolsList(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tools", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty response"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for error
    if wire.RustCsgContains(json, "\"error\""):
        var errMsg: str
        if wire.RustCsgContains(json, "\"message\""):
            errMsg = wire.RustCsgJsonFindStr(json, "message")
        else:
            errMsg = "unknown MCP error"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tools", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", errMsg))
        out = wire.RustCsgCat(out, "}")
        return out

    # Parse result.tools array
    if wire.RustCsgContains(json, "\"result\""):
        let resultJson = wire.RustCsgJsonFindObject(json, "result")
        if wire.RustCsgContains(resultJson, "\"tools\""):
            let toolsJson = wire.RustCsgJsonFindArray(resultJson, "tools")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tools", toolsJson))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
        else:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tools", "[]"))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "no tools array in result"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tools", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "no result in response"))
    out = wire.RustCsgCat(out, "}")
    return out

# ── MCP tools/call request/response ────────────────────────────────────────

# Build MCP tools/call request (JSON-RPC 2.0).
# Returns: {"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"toolName","arguments":{...}}}
fn RustCsgMcpServerBuildToolCallRequest(toolName: str, argumentsJson: str): str =
    var argsObj: str
    if argumentsJson == "" || argumentsJson == "{}":
        argsObj = "{}"
    else:
        argsObj = argumentsJson
    var params = strutil.Join([
        "{\"name\":", wire.RustCsgJsonQuote(toolName),
        ",\"arguments\":", argsObj, "}"
    ], "")
    return RustCsgMcpServerBuildRequest(1, "tools/call", params)

# Parse MCP tools/call response.
# Returns: {"content":[...],"isError":false,"error":""} or {"content":[],"isError":true,"error":"..."}
fn RustCsgMcpServerParseToolCall(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("isError", "true"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "empty response"))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for JSON-RPC error
    if wire.RustCsgContains(json, "\"error\""):
        var errMsg: str
        if wire.RustCsgContains(json, "\"message\""):
            errMsg = wire.RustCsgJsonFindStr(json, "message")
        else:
            errMsg = "unknown MCP error"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("isError", "true"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", errMsg))
        out = wire.RustCsgCat(out, "}")
        return out

    # Parse result
    if wire.RustCsgContains(json, "\"result\""):
        let resultJson = wire.RustCsgJsonFindObject(json, "result")

        var contentJson: str = "[]"
        if wire.RustCsgContains(resultJson, "\"content\""):
            contentJson = wire.RustCsgJsonFindArray(resultJson, "content")

        var isError: bool = false
        if wire.RustCsgContains(resultJson, "\"isError\""):
            isError = wire.RustCsgJsonFindBool(resultJson, "isError")

        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", contentJson))
        out = wire.RustCsgCat(out, ",")
        if isError:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("isError", "true"))
        else:
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("isError", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", "[]"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("isError", "true"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", "no result in response"))
    out = wire.RustCsgCat(out, "}")
    return out

# ── MCP shutdown ───────────────────────────────────────────────────────────

# Build MCP shutdown request (JSON-RPC 2.0 request).
# Returns: {"jsonrpc":"2.0","id":1,"method":"shutdown"}
fn RustCsgMcpServerBuildShutdownRequest(): str =
    return RustCsgMcpServerBuildRequest(1, "shutdown", "")

# Build MCP exit notification (JSON-RPC 2.0 notification, no response expected).
# Returns: {"jsonrpc":"2.0","method":"notifications/exit"}
fn RustCsgMcpServerBuildExitNotification(): str =
    return RustCsgMcpServerBuildNotification("notifications/exit", "")

# ── MCP response parsing (generic) ─────────────────────────────────────────

# Generic MCP JSON-RPC response parser.
# Extracts result or error from a JSON-RPC response.
# Returns: {"found":true,"result":"...","error":"..."}
# If found is true and there's no error, result contains the result object.
# If found is true and there's an error, error contains the error message.
fn RustCsgMcpServerParseResponse(json: str): str =
    var out = "{"
    if json.len == 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("found", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", "null"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for error
    if wire.RustCsgContains(json, "\"error\""):
        var errObj: str
        if wire.RustCsgContains(json, "\"message\""):
            errObj = wire.RustCsgJsonFindStr(json, "message")
        else:
            errObj = "unknown error"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("found", "true"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", "null"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", errObj))
        out = wire.RustCsgCat(out, "}")
        return out

    # Check for result
    if wire.RustCsgContains(json, "\"result\""):
        let resultValue = wire.RustCsgJsonFindValueRaw(json, "result")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("found", "true"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", resultValue))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("found", "false"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", "null"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", ""))
    out = wire.RustCsgCat(out, "}")
    return out

# ── Tool info builders ─────────────────────────────────────────────────────

# Build a tool info JSON object from individual fields.
# Returns: {"name":"...","description":"...","inputSchema":{...}}
fn RustCsgMcpServerBuildToolInfo(name: str, description: str, inputSchemaJson: str): str =
    var schema = inputSchemaJson
    if schema == "":
        schema = "{}"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("inputSchema", schema))
    out = wire.RustCsgCat(out, "}")
    return out
