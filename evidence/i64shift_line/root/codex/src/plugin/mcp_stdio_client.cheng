import std/strings
import cheng/codex/std/process
import cheng/codex/plugin/mcp_server
import cheng/codex/protocol/wire

type RustCsgMcpStdioClientResult =
    ok: bool
    pid: int32
    exitCode: int32
    serverName: str
    protocolVersion: str
    toolsJson: str
    toolCallJson: str
    toolCallContentJson: str
    toolCallIsError: bool
    resourceReadJson: str
    resourceContentsJson: str
    initializeJson: str
    toolsListJson: str
    error: str

type RustCsgMcpStdioFrameReadResult =
    ok: bool
    body: str
    error: str

fn rustCsgMcpStdioBuildFrame(body: str): str =
    return wire.RustCsgCat4("Content-Length: ", strings.IntToStr(body.len), "\r\n\r\n", body)

fn rustCsgMcpStdioFindHeaderEnd(text: str): int32 =
    var i: int32
    while i + 4 <= text.len:
        if text[i] == '\r' && text[i + 1] == '\n' && text[i + 2] == '\r' && text[i + 3] == '\n':
            return i
        i = i + 1
    return -1

fn rustCsgMcpStdioParseContentLength(header: str): int32 =
    let prefix: str = "Content-Length:"
    var i: int32
    while i + prefix.len <= header.len:
        var matched: bool = true
        for j in 0..<prefix.len:
            if header[i + j] != prefix[j]:
                matched = false
                break
        if matched:
            i = i + prefix.len
            while i < header.len && header[i] == ' ':
                i = i + 1
            var value: int32
            var saw: bool
            while i < header.len && header[i] >= '0' && header[i] <= '9':
                value = value * 10 + (int32(header[i]) - int32('0'))
                saw = true
                i = i + 1
            if !saw:
                return -1
            return value
        i = i + 1
    return -1

fn rustCsgMcpStdioReadFrame(stdoutFd: int32): RustCsgMcpStdioFrameReadResult =
    var out: RustCsgMcpStdioFrameReadResult
    var buffer: str
    var attempts: int32
    while attempts < 100:
        let chunk = process.ProcessReadFdBlocking(stdoutFd, 500)
        if chunk.len > 0:
            buffer = wire.RustCsgCat(buffer, chunk)
            let headerEnd = rustCsgMcpStdioFindHeaderEnd(buffer)
            if headerEnd >= 0:
                let header = strings.SliceBytes(buffer, 0, headerEnd)
                let contentLength = rustCsgMcpStdioParseContentLength(header)
                if contentLength < 0:
                    out.error = "MCP stdio frame missing valid Content-Length"
                    return out
                let bodyStart = headerEnd + 4
                if buffer.len >= bodyStart + contentLength:
                    out.body = strings.SliceBytes(buffer, bodyStart, contentLength)
                    out.ok = true
                    return out
        attempts = attempts + 1
    out.error = "timed out reading MCP stdio frame"
    return out

fn rustCsgMcpStdioWriteAll(fd: int32, data: str): bool =
    var offset: int32
    while offset < data.len:
        let chunk = strings.SliceBytes(data, offset, data.len - offset)
        let wrote = process.ProcessWriteFd(fd, chunk)
        if wrote <= 0:
            return false
        offset = offset + wrote
    return true

fn rustCsgMcpStdioWriteFrame(fd: int32, body: str): bool =
    return rustCsgMcpStdioWriteAll(fd, rustCsgMcpStdioBuildFrame(body))

fn rustCsgMcpStdioBuildToolsListRequest(): str =
    return mcp_server.RustCsgMcpServerBuildRequest(2, "tools/list", "")

fn rustCsgMcpStdioBuildToolCallRequest(name: str, argumentsJson: str): str =
    var argsObj: str
    if argumentsJson == "" || argumentsJson == "{}":
        argsObj = "{}"
    else:
        argsObj = argumentsJson
    let namePart = wire.RustCsgCat3("{\"name\":", wire.RustCsgJsonQuote(name), ",")
    let params = wire.RustCsgCat4(namePart, "\"arguments\":", argsObj, "}")
    return mcp_server.RustCsgMcpServerBuildRequest(3, "tools/call", params)

fn rustCsgMcpStdioBuildResourceReadRequest(uri: str): str =
    let params = wire.RustCsgCat3("{\"uri\":", wire.RustCsgJsonQuote(uri), "}")
    return mcp_server.RustCsgMcpServerBuildRequest(4, "resources/read", params)

fn rustCsgMcpStdioAbort(pid: int32) =
    process.ProcessKill(pid, 15)
    process.ProcessWait(pid)

fn rustCsgMcpStdioClientRun(command: str, args: str[], cwd: str, env: str[], callTool: bool, toolName: str, argumentsJson: str, readResource: bool, resourceUri: str): RustCsgMcpStdioClientResult =
    var out: RustCsgMcpStdioClientResult
    out.toolsJson = "[]"
    out.toolCallContentJson = "[]"
    out.resourceContentsJson = "[]"

    let handle = process.ProcessSpawnRaw(command, args, cwd, env)
    if !handle.ok:
        out.error = wire.RustCsgCat("spawn failed: ", handle.error)
        return out
    out.pid = handle.pid

    let initializeReq = mcp_server.RustCsgMcpServerBuildInitializeRequest("codex", "0.1.0")
    if !rustCsgMcpStdioWriteFrame(handle.stdinFd, initializeReq):
        out.error = "write initialize failed"
        rustCsgMcpStdioAbort(handle.pid)
        return out

    let initializeFrame = rustCsgMcpStdioReadFrame(handle.stdoutFd)
    if !initializeFrame.ok:
        out.error = initializeFrame.error
        rustCsgMcpStdioAbort(handle.pid)
        return out
    out.initializeJson = initializeFrame.body
    let initParsed = mcp_server.RustCsgMcpServerParseInitializeResponse(out.initializeJson)
    let initError = wire.RustCsgJsonFindStr(initParsed, "error")
    if initError != "":
        out.error = wire.RustCsgCat("initialize failed: ", initError)
        rustCsgMcpStdioAbort(handle.pid)
        return out
    out.serverName = wire.RustCsgJsonFindStr(initParsed, "serverName")
    out.protocolVersion = wire.RustCsgJsonFindStr(initParsed, "protocolVersion")
    if out.serverName == "" || out.protocolVersion == "":
        out.error = "initialize response missing server name or protocol version"
        rustCsgMcpStdioAbort(handle.pid)
        return out

    let initialized = mcp_server.RustCsgMcpServerBuildNotification("notifications/initialized", "")
    if !rustCsgMcpStdioWriteFrame(handle.stdinFd, initialized):
        out.error = "write initialized notification failed"
        rustCsgMcpStdioAbort(handle.pid)
        return out

    if !rustCsgMcpStdioWriteFrame(handle.stdinFd, rustCsgMcpStdioBuildToolsListRequest()):
        out.error = "write tools/list failed"
        rustCsgMcpStdioAbort(handle.pid)
        return out

    let toolsListFrame = rustCsgMcpStdioReadFrame(handle.stdoutFd)
    if !toolsListFrame.ok:
        out.error = toolsListFrame.error
        rustCsgMcpStdioAbort(handle.pid)
        return out
    out.toolsListJson = toolsListFrame.body
    let toolsParsed = mcp_server.RustCsgMcpServerParseToolsList(out.toolsListJson)
    let toolsError = wire.RustCsgJsonFindStr(toolsParsed, "error")
    if toolsError != "":
        out.error = wire.RustCsgCat("tools/list failed: ", toolsError)
        rustCsgMcpStdioAbort(handle.pid)
        return out
    out.toolsJson = wire.RustCsgJsonFindArray(toolsParsed, "tools")
    if out.toolsJson == "[]":
        out.error = "tools/list returned empty tools array"
        rustCsgMcpStdioAbort(handle.pid)
        return out

    if callTool:
        if !rustCsgMcpStdioWriteFrame(handle.stdinFd, rustCsgMcpStdioBuildToolCallRequest(toolName, argumentsJson)):
            out.error = "write tools/call failed"
            rustCsgMcpStdioAbort(handle.pid)
            return out

        let toolCallFrame = rustCsgMcpStdioReadFrame(handle.stdoutFd)
        if !toolCallFrame.ok:
            out.error = toolCallFrame.error
            rustCsgMcpStdioAbort(handle.pid)
            return out
        out.toolCallJson = toolCallFrame.body
        let callParsed = mcp_server.RustCsgMcpServerParseToolCall(out.toolCallJson)
        let callError = wire.RustCsgJsonFindStr(callParsed, "error")
        if callError != "":
            out.error = wire.RustCsgCat("tools/call failed: ", callError)
            rustCsgMcpStdioAbort(handle.pid)
            return out
        out.toolCallContentJson = wire.RustCsgJsonFindArray(callParsed, "content")
        out.toolCallIsError = wire.RustCsgJsonFindBool(callParsed, "isError")
        if out.toolCallIsError:
            out.error = "tools/call returned isError"
            rustCsgMcpStdioAbort(handle.pid)
            return out

    if readResource:
        if !rustCsgMcpStdioWriteFrame(handle.stdinFd, rustCsgMcpStdioBuildResourceReadRequest(resourceUri)):
            out.error = "write resources/read failed"
            rustCsgMcpStdioAbort(handle.pid)
            return out

        let resourceFrame = rustCsgMcpStdioReadFrame(handle.stdoutFd)
        if !resourceFrame.ok:
            out.error = resourceFrame.error
            rustCsgMcpStdioAbort(handle.pid)
            return out
        out.resourceReadJson = resourceFrame.body
        let resourceParsed = mcp_server.RustCsgMcpServerParseResponse(out.resourceReadJson)
        let resourceError = wire.RustCsgJsonFindStr(resourceParsed, "error")
        if resourceError != "":
            out.error = wire.RustCsgCat("resources/read failed: ", resourceError)
            rustCsgMcpStdioAbort(handle.pid)
            return out
        let resourceResultJson = wire.RustCsgJsonFindValueRaw(resourceParsed, "result")
        if !wire.RustCsgContains(resourceResultJson, "\"contents\""):
            out.error = "resources/read response missing contents array"
            rustCsgMcpStdioAbort(handle.pid)
            return out
        out.resourceContentsJson = wire.RustCsgJsonFindArray(resourceResultJson, "contents")
        if out.resourceContentsJson == "[]":
            out.error = "resources/read returned empty contents array"
            rustCsgMcpStdioAbort(handle.pid)
            return out

    if process.ProcessCloseFd(handle.stdinFd) != 0:
        out.error = "close stdin failed"
        rustCsgMcpStdioAbort(handle.pid)
        return out
    out.exitCode = process.ProcessWait(handle.pid)
    if out.exitCode != 0:
        out.error = wire.RustCsgCat("MCP stdio server exited nonzero: ", strings.IntToStr(out.exitCode))
        return out
    out.ok = true
    return out

fn RustCsgMcpStdioClientInitializeAndListTools(command: str, args: str[], cwd: str, env: str[]): RustCsgMcpStdioClientResult =
    return rustCsgMcpStdioClientRun(command, args, cwd, env, false, "", "", false, "")

fn RustCsgMcpStdioClientCallTool(command: str, args: str[], cwd: str, env: str[], name: str, argumentsJson: str): RustCsgMcpStdioClientResult =
    return rustCsgMcpStdioClientRun(command, args, cwd, env, true, name, argumentsJson, false, "")

fn RustCsgMcpStdioClientCallToolAndReadResource(command: str, args: str[], cwd: str, env: str[], name: str, argumentsJson: str, uri: str): RustCsgMcpStdioClientResult =
    return rustCsgMcpStdioClientRun(command, args, cwd, env, true, name, argumentsJson, true, uri)

fn RustCsgMcpStdioClientReadResource(command: str, args: str[], cwd: str, env: str[], uri: str): RustCsgMcpStdioClientResult =
    return rustCsgMcpStdioClientRun(command, args, cwd, env, false, "", "", true, uri)

fn RustCsgMcpStdioClientSamplingCreateMessage(paramsJson: str): str =
    paramsJson
    assert(false, "MCP stdio sampling is unsupported")
    return ""

fn RustCsgMcpStdioClientOauthLogin(server: str): str =
    server
    assert(false, "MCP stdio OAuth is unsupported")
    return ""
