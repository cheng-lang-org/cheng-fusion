import cheng/codex/core/inventory_static as inventory
import cheng/codex/core/module_map
import cheng/codex/protocol/wire
import cheng/codex/translate/plan as translate_plan

fn RustCsgTranslateOneCrate(crateName: str): str =
    var plan = translate_plan.RustCsgTranslatePlanForCrate(crateName)
    var out = wire.RustCsgCat("RUST_CSG_TRANSLATE_FACTS\n", translate_plan.RustCsgTranslatePlanToFact(plan))
    if plan.status == "ported":
        out = wire.RustCsgCat(out, "\n")
        out = wire.RustCsgCat(out, plan.crateName)
        out = wire.RustCsgCat(out, " ")
        out = wire.RustCsgCat(out, translate_plan.RustCsgTranslatePlanOk)
    return out

fn RustCsgTranslateAllCrates(): str =
    return translate_plan.RustCsgTranslatePlanAllFacts()

fn RustCsgTranslateStatusSummary(): str =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var portedCount: int32
    var blockedCount: int32
    var coreCount: int32
    var coreVerifiedCount: int32
    var corePendingCount: int32
    for i in 0..<members.len:
        if module_map.RustCsgCargoMemberPorted(members[i]) ||
           module_map.RustCsgCargoMemberNonRuntime(members[i]):
            portedCount = portedCount + 1
        else:
            blockedCount = blockedCount + 1
        if module_map.RustCsgCargoMemberInTranslationCore(members[i]):
            coreCount = coreCount + 1
            if module_map.RustCsgCargoMemberRelfactsVerified(members[i]):
                coreVerifiedCount = coreVerifiedCount + 1
            else:
                corePendingCount = corePendingCount + 1
    var out = wire.RustCsgCat3("RUST_CSG_TRANSLATE_DRIVER", "\nschema\t", "translate_driver_v1")
    out = wire.RustCsgCat(out, "\ntotal\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(int32(members.len)))
    out = wire.RustCsgCat(out, "\tported\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(portedCount))
    out = wire.RustCsgCat(out, "\tblocked\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(blockedCount))
    out = wire.RustCsgCat(out, "\ttranslation_core\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(coreCount))
    out = wire.RustCsgCat(out, "\tcore_relfacts\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(coreVerifiedCount))
    out = wire.RustCsgCat(out, "\n")
    out = wire.RustCsgCat(out, "total=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(int32(members.len)))
    out = wire.RustCsgCat(out, "\nported=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(portedCount))
    out = wire.RustCsgCat(out, "\nblocked=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(blockedCount))
    out = wire.RustCsgCat(out, "\ntranslation_core_verified=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(coreVerifiedCount))
    out = wire.RustCsgCat(out, "\ntranslation_core_pending=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(corePendingCount))
    return out

fn RustCsgTranslateCrateSmokePath(crateName: str): str =
    let plan = translate_plan.RustCsgTranslatePlanForCrate(crateName)
    if plan.status != "ported" && plan.status != translate_plan.RustCsgTranslatePlanMarker:
        return ""
    let smokeFile = wire.RustCsgCat3(plan.smokeName, ".cheng", "")
    return wire.RustCsgCat4("codex/src/tests/", smokeFile, "", "")

fn RustCsgTranslateBuildManifestFact(plan: var translate_plan.RustCsgTranslatePlan): str =
    var out = wire.RustCsgCat("build_crate\t", plan.smokeName)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, wire.RustCsgCat3("codex/src/tests/", plan.smokeName, ".cheng"))
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, wire.RustCsgCat("codex/src/crates/", plan.crateFileName))
    out = wire.RustCsgCat(out, "\t")
    if plan.inCore:
        out = wire.RustCsgCat(out, "core\t")
    else:
        out = wire.RustCsgCat(out, "marker\t")
    out = wire.RustCsgCat(out, plan.status)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.reason)
    return out

fn RustCsgTranslateOneClickReady(): str =
    # one_click_ready = 无 blocked 且核心 member 全部通过 relfacts 验证
    let members = inventory.RustCsgExpectedCargoMembersList()
    for i in 0..<members.len:
        if module_map.RustCsgCargoMemberInTranslationCore(members[i]) &&
           !module_map.RustCsgCargoMemberRelfactsVerified(members[i]):
            return wire.RustCsgCat3("not_ready\t", members[i], "\ttranslation_core_pending")
        if !module_map.RustCsgCargoMemberPorted(members[i]) &&
           !module_map.RustCsgCargoMemberNonRuntime(members[i]):
            let plan = translate_plan.RustCsgTranslatePlanForCrate(members[i])
            return wire.RustCsgCat4("not_ready\t", plan.crateName, "\t", plan.reason)
    return "one_click_ready"

fn RustCsgTranslateBuildManifest(): str =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var out = "RUST_CSG_BUILD_MANIFEST\nschema\tbuild_manifest_v1\n"
    var buildable: int32
    var blocked: int32
    for i in 0..<members.len:
        let plan = translate_plan.RustCsgTranslatePlanForCrate(members[i])
        if plan.status == "ported" || plan.status == translate_plan.RustCsgTranslatePlanMarker:
            out = wire.RustCsgCat(out, "\n")
            var manifestPlan = plan
            out = wire.RustCsgCat(out, RustCsgTranslateBuildManifestFact(manifestPlan))
            buildable = buildable + 1
        else:
            blocked = blocked + 1
    out = wire.RustCsgCat4(out, "\nbuildable\t", inventory.RustCsgInt32Text(buildable), "\tblocked\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(blocked))
    return out

fn RustCsgTranslateCoreReady(): str =
    # core_ready = 所有核心 member 都通过了 relfacts 验证
    let members = inventory.RustCsgExpectedCargoMembersList()
    var pendingCount: int32
    var pendingList: str
    for i in 0..<members.len:
        if module_map.RustCsgCargoMemberInTranslationCore(members[i]):
            if !module_map.RustCsgCargoMemberRelfactsVerified(members[i]):
                pendingCount = pendingCount + 1
                if pendingList == "":
                    pendingList = members[i]
                else:
                    pendingList = wire.RustCsgCat3(pendingList, ",", members[i])
    if pendingCount > 0:
        return wire.RustCsgCat4("core_not_ready\t", inventory.RustCsgInt32Text(pendingCount), "\t", pendingList)
    return "core_ready"

fn main(argc: int32, argv: str*): int32 =
    let status = RustCsgTranslateStatusSummary()
    echo(status)
    echo("")

    let oneClick = RustCsgTranslateOneClickReady()
    echo(oneClick)
    echo("")

    let coreReady = RustCsgTranslateCoreReady()
    echo(coreReady)
    echo("")

    let allFacts = RustCsgTranslateAllCrates()
    echo(allFacts)
    echo("")

    let buildManifest = RustCsgTranslateBuildManifest()
    echo(buildManifest)

    if oneClick != "one_click_ready":
        return 1
    if coreReady != "core_ready":
        return 1
    return 0
