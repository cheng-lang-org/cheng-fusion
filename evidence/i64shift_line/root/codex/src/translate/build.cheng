import cheng/codex/translate/plan as translate_plan
import cheng/codex/core/module_map
import cheng/codex/protocol/wire

type
    RustCsgBuildPlan =
        smokePath: str
        cratePath: str
        hasProvider: bool
        providerSource: str
        markerName: str
        status: str
        inCore: bool
        reason: str

fn RustCsgBuildPlanForCrate(crateName: str): RustCsgBuildPlan =
    var result: RustCsgBuildPlan
    let plan = translate_plan.RustCsgTranslatePlanForCrate(crateName)
    result.status = plan.status
    result.reason = plan.reason
    result.markerName = plan.smokeName
    result.inCore = plan.inCore

    if plan.status == "ported" || plan.status == translate_plan.RustCsgTranslatePlanMarker:
        # 核心 member（marker 状态）和非核心 member（ported 状态）都有 crate path
        result.smokePath = wire.RustCsgCat(
            wire.RustCsgCat("codex/src/tests/", plan.smokeName),
            ".cheng"
        )
        result.cratePath = wire.RustCsgCat("codex/src/crates/", plan.crateFileName)
        result.hasProvider = false
        result.providerSource = ""
    return result

fn RustCsgBuildPlanToFact(plan: var RustCsgBuildPlan): str =
    var out = wire.RustCsgCat("build_crate\t", plan.markerName)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.smokePath)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.cratePath)
    out = wire.RustCsgCat(out, "\t")
    if plan.inCore:
        out = wire.RustCsgCat(out, "core\t")
    else:
        out = wire.RustCsgCat(out, "marker\t")
    out = wire.RustCsgCat(out, plan.status)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.reason)
    return out