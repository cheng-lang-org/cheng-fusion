import cheng/codex/core/inventory_static as inventory
import cheng/codex/core/module_map
import cheng/codex/protocol/wire

type
    RustCsgTranslatePlan =
        crateName: str
        chengModule: str
        status: str
        inCore: bool
        relfacts: bool
        reason: str
        smokeName: str
        crateFileName: str

const
    RustCsgTranslatePlanOk: str = "translate_plan_ok"
    RustCsgTranslatePlanBlocked: str = "translate_plan_blocked"
    RustCsgTranslatePlanMarker: str = "translation_core_pending"

fn RustCsgTranslateSmokeName(crateName: str): str =
    if crateName == "debug-client":
        return "rust_csg_debug_client_types_smoke"
    elif crateName == "apply-patch":
        return "rust_csg_apply_patch_parser_smoke"
    elif crateName == "codex-backend-openapi-models":
        return "rust_csg_openapi_models_smoke"
    elif crateName == "cloud-tasks-client":
        return "rust_csg_cloud_tasks_client_types_smoke"
    elif crateName == "cloud-tasks-mock-client":
        return "rust_csg_cloud_tasks_mock_client_types_smoke"
    elif crateName == "collaboration-mode-templates":
        return "rust_csg_collab_templates_smoke"
    elif crateName == "connectors":
        return "rust_csg_connector_types_smoke"
    elif crateName == "config":
        return "rust_csg_config_crate_smoke"
    elif crateName == "exec":
        return "rust_csg_exec_crate_smoke"
    elif crateName == "exec-server":
        return "rust_csg_exec_server_types_smoke"
    elif crateName == "ext/extension-api":
        return "rust_csg_extension_api_smoke"
    elif crateName == "ext/goal":
        return "rust_csg_goal_smoke"
    elif crateName == "ext/guardian":
        return "rust_csg_guardian_smoke"
    elif crateName == "memories/mcp":
        return "rust_csg_mcp_memories_smoke"
    elif crateName == "protocol":
        return "rust_csg_protocol_roundtrip_smoke"
    elif crateName == "rollout":
        return "rust_csg_rollout_reader_smoke"
    elif crateName == "rollout-trace":
        return "rust_csg_rollout_trace_relfacts_smoke"
    elif crateName == "utils/readiness":
        return "rust_csg_readiness_smoke"
    elif crateName == "utils/rustls-provider":
        return "rust_csg_rustls_provider_smoke"
    elif crateName == "utils/sandbox-summary":
        return "rust_csg_sandbox_summary_smoke"
    elif crateName == "utils/sleep-inhibitor":
        return "rust_csg_sleep_inhibitor_smoke"
    elif crateName == "utils/approval-presets":
        return "rust_csg_approval_presets_smoke"
    elif crateName == "utils/output-truncation":
        return "rust_csg_output_truncation_smoke"
    elif crateName == "utils/fuzzy-match":
        return "rust_csg_fuzzy_match_smoke"
    elif crateName == "utils/stream-parser":
        return "rust_csg_stream_parser_smoke"
    elif crateName == "utils/template":
        return "rust_csg_template_smoke"
    elif crateName == "codex-api":
        return "rust_csg_codex_api_relfacts_smoke"
    elif crateName == "test-binary-support":
        return "rust_csg_test_binary_support_types_smoke"
    elif crateName == "thread-manager-sample":
        return "rust_csg_thread_manager_sample_types_smoke"
    elif crateName == "codex-experimental-api-macros":
        return "rust_csg_experimental_api_macros_smoke"
    var out = "rust_csg_"
    for i in 0..<crateName.len:
        let ch = crateName[i]
        if ch == '/' || ch == '-':
            out = wire.RustCsgCat(out, "_")
        else:
            out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(crateName, i, 1))
    out = wire.RustCsgCat(out, "_smoke")
    return out

fn RustCsgTranslateCrateFileNameForMember(crateName: str, chengModule: str): str =
    if crateName == "tools":
        return "tools.cheng"
    elif crateName == "utils/json-to-toml":
        return "utils_json_to_toml/json_to_toml.cheng"
    elif crateName == "utils/string":
        return "utils_string/string.cheng"
    elif crateName == "utils/elapsed":
        return "utils_elapsed/elapsed.cheng"
    elif crateName == "utils/sleep-inhibitor":
        return "utils_sleep_inhibitor/sleep_inhibitor.cheng"
    elif crateName == "utils/oss":
        return "utils_oss/oss.cheng"
    elif crateName == "utils/plugins":
        return "utils_plugins/mention_syntax.cheng"
    elif crateName == "codex-experimental-api-macros":
        return "experimental_api_macros/experimental_api_macros.cheng"
    return RustCsgTranslateCrateFileName(chengModule)

fn RustCsgTranslateCrateFileName(chengModule: str): str =
    var name = chengModule
    let prefix = module_map.RustCsgCrateModulePrefix
    if name.len > prefix.len:
        var tail: str
        for i in prefix.len..<name.len:
            tail = wire.RustCsgCat(tail, wire.RustCsgSliceBytes(name, i, 1))
        # Crate file is at <dir>/<name>.cheng (e.g. "shell_command/shell_command.cheng")
        return wire.RustCsgCat4(tail, "/", tail, ".cheng")
    return ""

fn RustCsgTranslatePlanForCrate(crateName: str): RustCsgTranslatePlan =
    var result: RustCsgTranslatePlan
    result.crateName = crateName
    result.chengModule = module_map.RustCsgCargoMemberModule(crateName)
    result.inCore = module_map.RustCsgCargoMemberInTranslationCore(crateName)
    result.relfacts = module_map.RustCsgCargoMemberRelfactsVerified(crateName)

    if module_map.RustCsgCargoMemberNonRuntime(crateName):
        # non-runtime asset：不需要转译，标记为 ported
        result.status = "ported"
        result.reason = ""
    elif result.inCore && result.relfacts:
        # 核心 member 且已通过 relfacts 验证 -> 真正就绪
        result.status = "ported"
        result.reason = ""
    elif result.inCore:
        # 核心 member 但未通过 relfacts 验证 -> 需要深度转译
        result.status = RustCsgTranslatePlanMarker
        result.reason = "in translation core but relfacts not verified"
    elif module_map.RustCsgCargoMemberPorted(crateName):
        # 非核心 member -> marker 级别 ported
        result.status = "ported"
        result.reason = ""
    else:
        result.status = module_map.RustCsgExplicitlyBlocked
        result.reason = module_map.RustCsgBlockedUntilPorted

    result.smokeName = RustCsgTranslateSmokeName(crateName)
    result.crateFileName = RustCsgTranslateCrateFileNameForMember(crateName, result.chengModule)
    return result

fn RustCsgTranslatePlanValidate(plan: RustCsgTranslatePlan, outReason: var str): bool =
    outReason = ""
    if plan.crateName == "":
        outReason = "empty crate name"
        return false
    if plan.chengModule == "":
        outReason = wire.RustCsgCat("empty cheng module for crate: ", plan.crateName)
        return false
    if plan.status != "ported" && plan.status != module_map.RustCsgExplicitlyBlocked &&
       plan.status != RustCsgTranslatePlanMarker:
        outReason = wire.RustCsgCat("invalid status: ", plan.status)
        return false
    if plan.status == module_map.RustCsgExplicitlyBlocked && plan.reason == "":
        outReason = "blocked unit missing reason"
        return false
    return true

fn RustCsgTranslatePlanToFact(plan: RustCsgTranslatePlan): str =
    var out = wire.RustCsgCat("translate_crate\t", plan.crateName)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.chengModule)
    out = wire.RustCsgCat(out, "\t")
    if plan.inCore:
        out = wire.RustCsgCat(out, "core\t")
        if plan.relfacts:
            out = wire.RustCsgCat(out, "relfacts_ok")
        else:
            out = wire.RustCsgCat(out, "relfacts_pending")
    else:
        out = wire.RustCsgCat(out, "marker")
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.status)
    if plan.status == module_map.RustCsgExplicitlyBlocked:
        out = wire.RustCsgCat(out, "\t")
        out = wire.RustCsgCat(out, plan.reason)
        out = wire.RustCsgCat(out, "\t")
        out = wire.RustCsgCat(out, plan.smokeName)
    else:
        out = wire.RustCsgCat3(out, "\t\t", plan.smokeName)
    out = wire.RustCsgCat(out, "\t")
    out = wire.RustCsgCat(out, plan.crateFileName)
    out = wire.RustCsgCat(out, "\tporter")
    return out

fn RustCsgTranslatePlanFactsOutput(plan: RustCsgTranslatePlan): str =
    var outReason: str
    if !RustCsgTranslatePlanValidate(plan, outReason):
        return wire.RustCsgCat("translate_error\t", outReason)

    var out = wire.RustCsgCat("RUST_CSG_TRANSLATE_FACTS\n", RustCsgTranslatePlanToFact(plan))

    if plan.status == RustCsgTranslatePlanMarker:
        out = wire.RustCsgCat(out, "\n")
        out = wire.RustCsgCat4(plan.crateName, " ", RustCsgTranslatePlanMarker, "")
        return out

    if plan.status == "ported":
        out = wire.RustCsgCat(out, "\n")
        out = wire.RustCsgCat(out, plan.crateName)
        out = wire.RustCsgCat(out, " ")
        out = wire.RustCsgCat(out, RustCsgTranslatePlanOk)
    else:
        out = wire.RustCsgCat(out, "\n")
        out = wire.RustCsgCat(out, plan.crateName)
        out = wire.RustCsgCat(out, " ")
        out = wire.RustCsgCat(out, RustCsgTranslatePlanBlocked)
        out = wire.RustCsgCat3(out, ": ", plan.reason)
    return out

# 分批处理：冷编译器大函数（>~50次迭代）触发 SIGTRAP
# 拆成多批，每批 ≤25 member，独立函数避免代码生成溢出
fn RustCsgTranslatePlanBatchProcess(members: var str[], start: int32, end: int32,
                                     outFacts: var str, outPorted: var int32,
                                     outBlocked: var int32, outCore: var int32,
                                     outCoreVerified: var int32,
                                     outCorePending: var int32) =
    for i in start..<end:
        var plan = RustCsgTranslatePlanForCrate(members[i])
        outFacts = wire.RustCsgCat(outFacts, "\n")
        outFacts = wire.RustCsgCat(outFacts, RustCsgTranslatePlanToFact(plan))
        if plan.status == "ported":
            outPorted = outPorted + 1
        elif plan.status == module_map.RustCsgExplicitlyBlocked:
            outBlocked = outBlocked + 1
        if plan.inCore:
            outCore = outCore + 1
            if plan.relfacts:
                outCoreVerified = outCoreVerified + 1
            else:
                outCorePending = outCorePending + 1

fn RustCsgTranslatePlanBatchEnd(totalCount: int32, requestedEnd: int32): int32 =
    if requestedEnd > totalCount:
        return totalCount
    return requestedEnd

fn RustCsgTranslatePlanAllFacts(): str =
    let members = inventory.RustCsgExpectedCargoMembersList()
    let totalCount = int32(members.len)
    var out = wire.RustCsgCat(
        "RUST_CSG_TRANSLATE_ALL_FACTS\nschema\ttranslate_all\tmember_count\t",
        inventory.RustCsgInt32Text(totalCount)
    )

    var portedCount: int32
    var blockedCount: int32
    var coreCount: int32
    var coreVerifiedCount: int32
    var corePendingCount: int32

    # 5 批 × 23 member，避免冷编译器大函数崩溃
    if totalCount > 0:
        RustCsgTranslatePlanBatchProcess(members, 0, RustCsgTranslatePlanBatchEnd(totalCount, 23), out, portedCount, blockedCount, coreCount, coreVerifiedCount, corePendingCount)
    if totalCount > 23:
        RustCsgTranslatePlanBatchProcess(members, 23, RustCsgTranslatePlanBatchEnd(totalCount, 46), out, portedCount, blockedCount, coreCount, coreVerifiedCount, corePendingCount)
    if totalCount > 46:
        RustCsgTranslatePlanBatchProcess(members, 46, RustCsgTranslatePlanBatchEnd(totalCount, 69), out, portedCount, blockedCount, coreCount, coreVerifiedCount, corePendingCount)
    if totalCount > 69:
        RustCsgTranslatePlanBatchProcess(members, 69, RustCsgTranslatePlanBatchEnd(totalCount, 92), out, portedCount, blockedCount, coreCount, coreVerifiedCount, corePendingCount)
    if totalCount > 92:
        RustCsgTranslatePlanBatchProcess(members, 92, totalCount, out, portedCount, blockedCount, coreCount, coreVerifiedCount, corePendingCount)

    out = wire.RustCsgCat(out, "\nported_count\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(portedCount))
    out = wire.RustCsgCat(out, "\tblocked_count\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(blockedCount))
    out = wire.RustCsgCat(out, "\ttranslation_core\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(coreCount))
    out = wire.RustCsgCat(out, "\tcore_relfacts_pending\t")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(corePendingCount))
    out = wire.RustCsgCat(out, "\ntotal=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(totalCount))
    out = wire.RustCsgCat(out, "\nported=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(portedCount))
    out = wire.RustCsgCat(out, "\nblocked=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(blockedCount))
    out = wire.RustCsgCat(out, "\ntranslation_core_verified=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(coreVerifiedCount))
    out = wire.RustCsgCat(out, "\ntranslation_core_pending=")
    out = wire.RustCsgCat(out, inventory.RustCsgInt32Text(corePendingCount))
    return out
