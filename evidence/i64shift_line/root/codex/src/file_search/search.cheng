# File content search — real process execution via grep/ripgrep.
#
# Provides:
#   SearchFiles — search file contents using grep || rg
#   FindFile    — locate files by name using find || mdfind
#   ParseGrepOutput — parse grep output lines into structured fields
#
# Dependencies:
#   - grep (always available on macOS)
#   - rg (ripgrep, optional — faster but not required)
#   - find (always available on POSIX systems)
#   - mdfind (macOS Spotlight, optional)
#
# This module uses ProcessSpawn for real process execution.
# NO mocks, NO fallbacks — tools must be available.

import std/strings
import std/strutils as strutil
import cheng/codex/std/process

# ═══════════════════════════════════════════════════════════════════════════
# Types
# ═══════════════════════════════════════════════════════════════════════════

# Search parameters for file content search.
# includePatterns/excludePatterns are comma-separated glob patterns ("" = no filter).
type SearchQuery =
    pattern: str
    path: str
    includePatterns: str
    excludePatterns: str
    maxResults: int32
    caseSensitive: bool

# A single search match parsed from grep output.
type SearchMatch =
    filePath: str
    lineNumber: int32
    lineContent: str
    matchStart: int32
    matchEnd: int32

# ═══════════════════════════════════════════════════════════════════════════
# Config
# ═══════════════════════════════════════════════════════════════════════════

const RUST_CSG_SEARCH_DEFAULT_MAX_RESULTS: int32 = 100
const RUST_CSG_SEARCH_MAX_DEPTH: int32 = 50

# ═══════════════════════════════════════════════════════════════════════════
# SearchQuery helpers
# ═══════════════════════════════════════════════════════════════════════════

fn makeSearchQuery(pattern: str, path: str, includePatterns: str,
                   excludePatterns: str, maxResults: int32,
                   caseSensitive: bool): SearchQuery =
    var q: SearchQuery
    q.pattern = pattern
    q.path = path
    q.includePatterns = includePatterns
    q.excludePatterns = excludePatterns
    q.maxResults = maxResults
    q.caseSensitive = caseSensitive
    return q

fn makeDefaultSearchQuery(pattern: str, path: str): SearchQuery =
    var q: SearchQuery
    q.pattern = pattern
    q.path = path
    q.includePatterns = ""
    q.excludePatterns = ""
    q.maxResults = RUST_CSG_SEARCH_DEFAULT_MAX_RESULTS
    q.caseSensitive = false
    return q

# ═══════════════════════════════════════════════════════════════════════════
# SearchFiles — search file contents using grep (or rg)
#
# Returns raw grep output: one line per match in "file:line:content" format.
# Returns empty string if no matches found.
# Returns "ERROR:" prefixed string on error (tool not found, permission, etc).
# ═══════════════════════════════════════════════════════════════════════════

fn SearchFiles(query: SearchQuery): str =
    if query.pattern.len == 0:
        return ""
    if query.path.len == 0:
        return "ERROR: search path is empty"
    if query.maxResults <= 0:
        query.maxResults = RUST_CSG_SEARCH_DEFAULT_MAX_RESULTS

    # Try ripgrep first (faster), fall back to grep
    var result: process.ProcessResult
    var rgResult: int32 = tryRipgrep(query, result)

    if rgResult == 0:
        # rg succeeded with matches
        return result.stdout
    elif rgResult == 1:
        # rg succeeded but no matches
        return ""
    elif rgResult == -1:
        # rg not found — fall back to grep
        return tryGrep(query)
    else:
        # rg found but had an error
        return strutil.Join(["ERROR: rg failed: ", result.stderr], "")


# Try ripgrep search — returns 0=ok with results, 1=ok no results, -1=not found, -2=error
fn tryRipgrep(query: SearchQuery, outResult: var process.ProcessResult): int32 =
    var args: str[]

    # Build rg arguments
    if !query.caseSensitive:
        add(args, "-i")          # case insensitive
    add(args, "-n")              # line numbers
    add(args, "--no-heading")    # file:line format, not grouped
    add(args, "--with-filename") # force file:line:content with one searched file
    add(args, "-m")              # max matches per file
    add(args, strings.IntToStr(query.maxResults))

    # Include/exclude patterns
    if query.includePatterns.len > 0:
        var inclPatterns: str[] = strutil.Split(query.includePatterns, ',')
        var pi: int32 = 0
        while pi < inclPatterns.len:
            if inclPatterns[pi].len > 0:
                add(args, "-g")
                add(args, inclPatterns[pi])
            pi = pi + 1

    if query.excludePatterns.len > 0:
        var exclPatterns: str[] = strutil.Split(query.excludePatterns, ',')
        var pi: int32 = 0
        while pi < exclPatterns.len:
            if exclPatterns[pi].len > 0:
                add(args, "-g")
                var exclPat: str = strutil.Join(["!", exclPatterns[pi]], "")
                add(args, exclPat)
            pi = pi + 1

    add(args, "--")
    add(args, query.pattern)
    add(args, query.path)

    var env: str[]
    var result: process.ProcessResult = process.ProcessSpawn("rg", args, "", env)

    outResult = result
    if !result.ok:
        # Command not found || spawn failed
        if strutil.Contains(result.error, "No such file") || strutil.Contains(result.error, "not found"):
            return -1
        return -2

    if result.exitCode == 0:
        return 0     # matches found
    elif result.exitCode == 1:
        return 1     # no matches (rg exit code 1 = no match)
    else:
        return -2    # error


# Try grep search — returns grep output || error string
fn tryGrep(query: SearchQuery): str =
    var args: str[]

    # Build grep arguments
    if !query.caseSensitive:
        add(args, "-i")
    add(args, "-rn")          # recursive, line numbers
    add(args, "-H")           # force filename with one searched file
    add(args, "-m")
    add(args, strings.IntToStr(query.maxResults))
    add(args, "-I")           # skip binary
    add(args, "-s")           # suppress error messages about nonexistent files

    # Include/exclude patterns (grep uses --include/--exclude with glob patterns)
    if query.includePatterns.len > 0:
        var inclPatterns: str[] = strutil.Split(query.includePatterns, ',')
        var pi: int32 = 0
        while pi < inclPatterns.len:
            if inclPatterns[pi].len > 0:
                add(args, "--include")
                add(args, inclPatterns[pi])
            pi = pi + 1

    if query.excludePatterns.len > 0:
        var exclPatterns: str[] = strutil.Split(query.excludePatterns, ',')
        var pi: int32 = 0
        while pi < exclPatterns.len:
            if exclPatterns[pi].len > 0:
                add(args, "--exclude")
                add(args, exclPatterns[pi])
            pi = pi + 1

    add(args, "--")
    add(args, query.pattern)
    add(args, query.path)

    var env: str[]
    var result: process.ProcessResult = process.ProcessSpawn("grep", args, "", env)

    if !result.ok:
        return strutil.Join(["ERROR: grep spawn failed: ", result.error], "")
    if result.exitCode == 0:
        return result.stdout
    elif result.exitCode == 1:
        return ""   # no matches — grep exit code 1 = no match
    else:
        return strutil.Join(["ERROR: grep exited with code ", strings.IntToStr(result.exitCode),
                             ", stderr: ", result.stderr], "")


# ═══════════════════════════════════════════════════════════════════════════
# ParseGrepOutput — parse grep output into structured match fields
#
# Input format: "file:line:content"
# Returns individual fields via out parameters.
# Returns true if parsing succeeded.
# ═══════════════════════════════════════════════════════════════════════════

fn ParseGrepOutputLine(line: str, outFile: var str, outLine: var int32, outContent: var str): bool =
    if line.len == 0:
        return false

    # Find first ':' — this separates file path from rest
    var firstColon: int32 = -1
    var i: int32 = 0
    while i < line.len:
        if line[i] == ':':
            firstColon = i
            break
        i = i + 1

    if firstColon < 0:
        return false

    outFile = strings.SliceBytes(line, 0, firstColon)

    # Find second ':' — this separates line number from content
    var secondColon: int32 = -1
    i = firstColon + 1
    while i < line.len:
        if line[i] == ':':
            secondColon = i
            break
        i = i + 1

    if secondColon < 0:
        # No content, just file:line
        var lineNumStr: str = strings.SliceBytes(line, firstColon + 1, line.len - firstColon - 1)
        outLine = parsePositiveInt(lineNumStr)
        outContent = ""
        return outLine >= 0

    var lineNumStr: str = strings.SliceBytes(line, firstColon + 1, secondColon - firstColon - 1)
    outLine = parsePositiveInt(lineNumStr)
    outContent = strings.SliceBytes(line, secondColon + 1, line.len - secondColon - 1)
    return outLine >= 0


# Parse a positive integer from a string. Returns -1 on failure.
fn parsePositiveInt(s: str): int32 =
    if s.len == 0:
        return -1
    var val: int32 = 0
    var i: int32 = 0
    while i < s.len:
        if s[i] >= '0' && s[i] <= '9':
            val = val * 10 + (int32(s[i]) - int32('0'))
        else:
            return -1
        i = i + 1
    return val


# ═══════════════════════════════════════════════════════════════════════════
# FindFile — locate files by name
#
# Uses `find` on POSIX systems. On macOS, also tries `mdfind` for Spotlight
# search if find returns no results.
#
# Returns newline-separated list of matching file paths.
# Returns empty string if no files found.
# Returns "ERROR:" prefixed string on tool failure.
# ═══════════════════════════════════════════════════════════════════════════

fn FindFile(name: str, searchPath: str): str =
    if name.len == 0 || searchPath.len == 0:
        return ""

    var args: str[]
    add(args, searchPath)
    add(args, "-name")
    add(args, name)
    add(args, "-type")
    add(args, "f")
    add(args, "-maxdepth")
    add(args, strings.IntToStr(RUST_CSG_SEARCH_MAX_DEPTH))

    var env: str[]
    var result: process.ProcessResult = process.ProcessSpawn("find", args, "", env)

    if result.ok && result.exitCode == 0:
        return result.stdout

    # find failed || returned nothing — try mdfind on macOS
    return tryMdfind(name, searchPath)


# Try mdfind (macOS Spotlight index) as fallback for file finding
fn tryMdfind(name: str, searchPath: str): str =
    var args: str[]
    add(args, "-onlyin")
    add(args, searchPath)
    add(args, "-name")
    add(args, name)

    var env: str[]
    var result: process.ProcessResult = process.ProcessSpawn("mdfind", args, "", env)

    if result.ok && result.exitCode == 0 && result.stdout.len > 0:
        return result.stdout

    return ""


# ═══════════════════════════════════════════════════════════════════════════
# CountSearchResults — count number of lines in search output
# (excluding empty lines)
# ═══════════════════════════════════════════════════════════════════════════

fn CountSearchResults(output: str): int32 =
    if output.len == 0:
        return 0
    var count: int32 = 0
    var i: int32 = 0
    while i < output.len:
        var lineStart: int32 = i
        while i < output.len:
            if output[i] == '\n':
                break
            i = i + 1
        if i > lineStart:
            count = count + 1
        if i < output.len:
            if output[i] == '\n':
                i = i + 1
    return count


# ═══════════════════════════════════════════════════════════════════════════
# GetNthSearchResult — get the Nth line from search output (0-indexed)
# Returns empty string if N is out of range.
# ═══════════════════════════════════════════════════════════════════════════

fn GetNthSearchResult(output: str, n: int32): str =
    if output.len == 0 || n < 0:
        return ""
    var currentIdx: int32 = 0
    var i: int32 = 0
    var lineStart: int32 = 0
    while i <= output.len:
        if i == output.len:
            if currentIdx == n:
                return strings.SliceBytes(output, lineStart, i - lineStart)
            currentIdx = currentIdx + 1
            lineStart = i + 1
        elif output[i] == '\n':
            if currentIdx == n:
                return strings.SliceBytes(output, lineStart, i - lineStart)
            currentIdx = currentIdx + 1
            lineStart = i + 1
        i = i + 1
    return ""
