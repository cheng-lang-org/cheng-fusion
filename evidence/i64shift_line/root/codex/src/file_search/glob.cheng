# Glob pattern matching — pure Cheng implementation for file search.
#
# Supports:
#   *       — matches any sequence of characters except /
#   **      — matches any sequence of characters INCLUDING / (any directory depth)
#   ?       — matches any single character except /
#   [abc]   — character class (one of)
#   [a-z]   — character range
#   [!abc]  — negated character class (via ! ||^)
# All other characters match literally.
#
# NOTE: Cheng `&&` evaluates BOTH operands regardless of the first result
# (no short-circuit). All bounds-guarded array accesses use nested `if`
# to avoid out-of-bounds reads.

import std/strings

# ═══════════════════════════════════════════════════════════════════════════
# GlobToRegex — convert glob pattern to grep-compatible regex pattern
#
# Rules:
#   *   → [^/]*       (any chars except /)
#   **  → .*          (any chars including /) — requires `grep -E`
#   ?   → [^/]        (single char except /)
#   [..]→ [..]        (char class, passed through; ! prefix becomes ^)
#   regex special chars (.+^${}()|\) are escaped with backslash
#
# Returns empty string for empty input.
# ═══════════════════════════════════════════════════════════════════════════

fn GlobToRegex(pattern: str): str =
    if pattern.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < pattern.len:
        let c = pattern[i]
        if c == '*':
            if i + 1 < pattern.len:
                if pattern[i + 1] == '*':
                    # ** — match everything including directory separators
                    result = strings.ConcatStr(result, ".*")
                    i = i + 2
                    # Consume trailing / — "**/foo" → ".*foo" not ".*/foo"
                    if i < pattern.len:
                        if pattern[i] == '/':
                            i = i + 1
                else:
                    # * — match everything except /
                    result = strings.ConcatStr(result, "[^/]*")
                    i = i + 1
            else:
                # Trailing * at end of pattern
                result = strings.ConcatStr(result, "[^/]*")
                i = i + 1
        elif c == '?':
            result = strings.ConcatStr(result, "[^/]")
            i = i + 1
        elif c == '[':
            result = strings.ConcatStr(result, "[")
            i = i + 1
            if i < pattern.len:
                var negated: bool = false
                if pattern[i] == '!':
                    negated = true
                if pattern[i] == '^':
                    negated = true
                if negated:
                    result = strings.ConcatStr(result, "^")
                    i = i + 1
            if i < pattern.len:
                if pattern[i] == ']':
                    result = strings.ConcatStr(result, "]")
                    i = i + 1
            while i < pattern.len:
                if pattern[i] == ']':
                    break
                if i + 2 < pattern.len:
                    if pattern[i + 1] == '-':
                        if pattern[i + 2] != ']':
                            result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
                            result = strings.ConcatStr(result, "-")
                            result = strings.ConcatStr(result, strings.SliceBytes(pattern, i + 2, 1))
                            i = i + 3
                        else:
                            # '-' at end of range, treat as literal
                            result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
                            i = i + 1
                    else:
                        result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
                        i = i + 1
                else:
                    result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
                    i = i + 1
            if i < pattern.len:
                if pattern[i] == ']':
                    result = strings.ConcatStr(result, "]")
                    i = i + 1
        else:
            var special: bool = false
            if c == '.':
                special = true
            if c == '+':
                special = true
            if c == '^':
                special = true
            if c == '$':
                special = true
            if c == '{':
                special = true
            if c == '}':
                special = true
            if c == '(':
                special = true
            if c == ')':
                special = true
            if c == '|':
                special = true
            if c == '\\':
                special = true
            if special:
                result = strings.ConcatStr(result, "\\")
                result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
            else:
                result = strings.ConcatStr(result, strings.SliceBytes(pattern, i, 1))
            i = i + 1
    return result


# ═══════════════════════════════════════════════════════════════════════════
# GlobMatch — match a path against a glob pattern
#
# Uses iterative backtracking for correct * matching.
# ** matches zero ||more directory levels (including /).
# Returns true if path matches the pattern.
# ═══════════════════════════════════════════════════════════════════════════

fn GlobMatch(path: str, pattern: str): bool =
    # Fast path: no ** in pattern -> use basic matcher
    var hasDS: bool = false
    var i: int32 = 0
    while i < pattern.len - 1:
        if pattern[i] == '*' and pattern[i + 1] == '*':
            hasDS = true
            break
        i = i + 1

    if !hasDS:
        return basicGlobMatch(path, pattern)

    # Pattern contains ** -> split on first ** and match independently
    # Find the ** position
    var dsPos: int32 = -1
    i = 0
    while i < pattern.len - 1:
        if pattern[i] == '*' and pattern[i + 1] == '*':
            dsPos = i
            break
        i = i + 1

    # Prefix: everything before ** (trim trailing /)
    var prefix: str = ""
    if dsPos > 0:
        prefix = strings.SliceBytes(pattern, 0, dsPos)

    # Suffix: everything after ** and optional /
    var suffixStart: int32 = dsPos + 2
    if suffixStart < pattern.len:
        if pattern[suffixStart] == '/':
            suffixStart = suffixStart + 1
    var suffix: str = strings.SliceBytes(pattern, suffixStart, pattern.len - suffixStart)

    # Case analysis:
    # 1. prefix="" suffix="foo"   -> match "foo" at any depth          (pattern: **/foo)
    # 2. prefix="foo" suffix=""   -> match "foo" prefix at any depth   (pattern: foo/**)
    # 3. prefix="foo" suffix="bar" -> match foo prefix then bar suffix (pattern: foo/**/bar)
    # 4. prefix="" suffix=""      -> match everything                  (pattern: **)

    if prefix.len == 0 and suffix.len == 0:
        # ** alone matches everything
        return true

    if prefix.len == 0:
        # Pattern starts with ** -> suffix can match at any position
        # The match must consume the full path
        var tryPos: int32 = 0
        while tryPos <= path.len:
            if tryMatchFull(path, tryPos, suffix):
                return true
            tryPos = tryPos + 1
        return false

    if suffix.len == 0:
        # Pattern ends with ** -> prefix must match a prefix of path
        return tryMatchPrefix(path, prefix)

    # Both prefix and suffix -> prefix must match at start, suffix at end
    # with anything in between
    if !tryMatchPrefix(path, prefix):
        return false

    # Try matching suffix at end of path (with anything in between)
    return tryMatchSuffix(path, suffix)


# ═══════════════════════════════════════════════════════════════════════════
# CharClassMatch — shared helper for character class matching
#
# Checks if pathChar matches pattern[...] starting at pi+1.
# Returns:
#   result = true if the character matches
#   endPi  = updated pattern index (past the closing ])
#
# This function uses nested ifs to avoid unsafe pattern[oob] access
# since Cheng && does not short-circuit.
# ═══════════════════════════════════════════════════════════════════════════

fn charClassMatch(pathChar: int32, pattern: str, pi: int32, endPi: var int32): bool =
    var cp: int32 = pi + 1
    var neg: bool = false
    var cm: bool = false

    if cp < pattern.len:
        if pattern[cp] == '!' ||pattern[cp] == '^':
            neg = true
            cp = cp + 1

    while cp < pattern.len:
        if pattern[cp] == ']':
            break
        if cp + 2 < pattern.len:
            if pattern[cp + 1] == '-':
                if pattern[cp + 2] != ']':
                    if pathChar >= pattern[cp] and pathChar <= pattern[cp + 2]:
                        cm = true
                    cp = cp + 3
                else:
                    if pathChar == pattern[cp]:
                        cm = true
                    cp = cp + 1
            else:
                if pathChar == pattern[cp]:
                    cm = true
                cp = cp + 1
        else:
            if pathChar == pattern[cp]:
                cm = true
            cp = cp + 1

    if cp < pattern.len:
        if pattern[cp] == ']':
            cp = cp + 1

    if neg:
        cm = !cm

    endPi = cp
    return cm


# ═══════════════════════════════════════════════════════════════════════════
# Basic glob matching (no ** support)
# ═══════════════════════════════════════════════════════════════════════════

fn basicGlobMatch(path: str, pattern: str): bool =
    var si: int32
    var pi: int32
    var bsi: int32
    var bpi: int32
    var hasStar: bool

    si = 0
    pi = 0
    bsi = -1
    bpi = -1
    hasStar = false

    while si < path.len:
        var did_match: bool
        did_match = false

        if pi < pattern.len:
            let pc = pattern[pi]
            if pc == '*':
                # Skip consecutive stars
                while pi < pattern.len:
                    if pattern[pi] != '*':
                        break
                    pi = pi + 1
                bsi = si
                bpi = pi
                hasStar = true
                did_match = true
            elif pc == '?':
                if path[si] != '/':
                    pi = pi + 1
                    si = si + 1
                    did_match = true
            elif pc == '[':
                var endPi: int32
                var cm: bool = charClassMatch(path[si], pattern, pi, endPi)
                if cm and path[si] != '/':
                    pi = endPi
                    si = si + 1
                    did_match = true
            else:
                if path[si] == pc:
                    pi = pi + 1
                    si = si + 1
                    did_match = true

        if !did_match:
            if hasStar:
                bsi = bsi + 1
                if bsi < path.len:
                    if path[bsi] == '/' and bpi >= pattern.len:
                        return false
                si = bsi
                pi = bpi
            else:
                return false

    while pi < pattern.len:
        if pattern[pi] != '*':
            break
        pi = pi + 1
    return pi == pattern.len


# ═══════════════════════════════════════════════════════════════════════════
# Helpers for ** matching
# ═══════════════════════════════════════════════════════════════════════════

# tryMatchPrefix — check if pattern matches a prefix of path
fn tryMatchPrefix(path: str, pattern: str): bool =
    var si: int32 = 0
    var pi: int32 = 0
    var bsi: int32 = -1
    var bpi: int32 = -1
    var hasStar: bool = false

    while si < path.len:
        if pi >= pattern.len:
            break
        var did_match: bool = false
        let pc = pattern[pi]
        if pc == '*':
            while pi < pattern.len:
                if pattern[pi] != '*':
                    break
                pi = pi + 1
            bsi = si
            bpi = pi
            hasStar = true
            did_match = true
        elif pc == '?':
            if path[si] != '/':
                pi = pi + 1
                si = si + 1
                did_match = true
        elif pc == '[':
            var endPi: int32
            var cm: bool = charClassMatch(path[si], pattern, pi, endPi)
            if cm and path[si] != '/':
                pi = endPi
                si = si + 1
                did_match = true
        else:
            if path[si] == pc:
                pi = pi + 1
                si = si + 1
                did_match = true

        if !did_match:
            if hasStar:
                bsi = bsi + 1
                if bsi < path.len:
                    if path[bsi] == '/' and bpi >= pattern.len:
                        return false
                si = bsi
                pi = bpi
            else:
                return false

    # Pattern must be fully consumed (allow trailing *)
    while pi < pattern.len:
        if pattern[pi] != '*':
            break
        pi = pi + 1
    return pi == pattern.len


# tryMatchSuffix — check if pattern matches a suffix of path (ending at path.len)
fn tryMatchSuffix(path: str, pattern: str): bool =
    var si: int32 = 0
    var pi: int32 = 0
    var lastMatchEnd: int32 = -1
    var bsi: int32 = -1
    var bpi: int32 = -1
    var hasStar: bool = false

    while si < path.len:
        var did_match: bool = false
        if pi < pattern.len:
            let pc = pattern[pi]
            if pc == '*':
                while pi < pattern.len:
                    if pattern[pi] != '*':
                        break
                    pi = pi + 1
                bsi = si
                bpi = pi
                hasStar = true
                did_match = true
            elif pc == '?':
                if path[si] != '/':
                    pi = pi + 1
                    si = si + 1
                    did_match = true
            elif pc == '[':
                var endPi: int32
                var cm: bool = charClassMatch(path[si], pattern, pi, endPi)
                if cm and path[si] != '/':
                    pi = endPi
                    si = si + 1
                    did_match = true
            else:
                if path[si] == pc:
                    pi = pi + 1
                    si = si + 1
                    did_match = true

        if !did_match:
            if hasStar:
                bsi = bsi + 1
                if bsi < path.len:
                    if path[bsi] == '/' and bpi >= pattern.len:
                        return false
                si = bsi
                pi = bpi
            else:
                return false

        # Track last position where we finished matching
        if pi == pattern.len:
            lastMatchEnd = si

    # Allow trailing * in pattern
    while pi < pattern.len:
        if pattern[pi] != '*':
            break
        pi = pi + 1
    if pi == pattern.len:
        lastMatchEnd = si

    return lastMatchEnd == path.len


# tryMatchFull — check if pattern matches exactly from startPos to end of path
fn tryMatchFull(path: str, startPos: int32, pattern: str): bool =
    var si: int32 = startPos
    var pi: int32 = 0
    var bsi: int32 = -1
    var bpi: int32 = -1
    var hasStar: bool = false

    while si < path.len:
        var did_match: bool = false
        if pi < pattern.len:
            let pc = pattern[pi]
            if pc == '*':
                while pi < pattern.len:
                    if pattern[pi] != '*':
                        break
                    pi = pi + 1
                bsi = si
                bpi = pi
                hasStar = true
                did_match = true
            elif pc == '?':
                if path[si] != '/':
                    pi = pi + 1
                    si = si + 1
                    did_match = true
            elif pc == '[':
                var endPi: int32
                var cm: bool = charClassMatch(path[si], pattern, pi, endPi)
                if cm and path[si] != '/':
                    pi = endPi
                    si = si + 1
                    did_match = true
            else:
                if path[si] == pc:
                    pi = pi + 1
                    si = si + 1
                    did_match = true

        if !did_match:
            if hasStar:
                bsi = bsi + 1
                if bsi < path.len:
                    if path[bsi] == '/' and bpi >= pattern.len:
                        return false
                si = bsi
                pi = bpi
            else:
                return false

    while pi < pattern.len:
        if pattern[pi] != '*':
            break
        pi = pi + 1
    return pi == pattern.len
