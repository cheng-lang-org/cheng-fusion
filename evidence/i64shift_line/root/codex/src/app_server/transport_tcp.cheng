# TCP transport layer for app-server.
#
# Provides TCP listen/accept/read/write/close operations backed by
# pure Cheng socket provider exports.
#
# Usage:
#   let fd = transport_tcp.RustCsgTcpListen("127.0.0.1", 4096)
#   if fd >= 0:
#       let clientFd = transport_tcp.RustCsgTcpAccept(fd)
#       ...
#       transport_tcp.RustCsgSocketClose(clientFd)
#       transport_tcp.RustCsgSocketClose(fd)

@abi_internal
@importc("RustCsgTcpListen")
fn RustCsgTcpListen(host: str, port: int32): int32

@importc("RustCsgTcpLocalPort")
fn RustCsgTcpLocalPort(listenFd: int32): int32

@importc("RustCsgTcpAccept")
fn RustCsgTcpAccept(listenFd: int32): int32

@abi_internal
@importc("RustCsgUnixListen")
fn RustCsgUnixListen(path: str): int32

@importc("RustCsgUnixAccept")
fn RustCsgUnixAccept(listenFd: int32): int32

@abi_internal
@importc("RustCsgSocketRead")
fn RustCsgSocketRead(fd: int32, maxBytes: int32): str

@abi_internal
@importc("RustCsgSocketWrite")
fn RustCsgSocketWrite(fd: int32, data: str): int32

@importc("RustCsgSocketClose")
fn RustCsgSocketClose(fd: int32): int32

@importc("RustCsgSocketReadable")
fn RustCsgSocketReadable(fd: int32, timeoutMs: int32): int32

@importc("RustCsgWebSocketAccept")
fn RustCsgWebSocketAccept(clientFd: int32): int32

@abi_internal
@importc("RustCsgHttpReadRequest")
fn RustCsgHttpReadRequest(clientFd: int32): str

@abi_internal
@importc("RustCsgWebSocketAcceptRequest")
fn RustCsgWebSocketAcceptRequest(clientFd: int32, request: str): int32

@abi_internal
@importc("RustCsgWebSocketReadFrame")
fn RustCsgWebSocketReadFrame(fd: int32): str

@abi_internal
@importc("RustCsgWebSocketTryReadFrame")
fn RustCsgWebSocketTryReadFrame(fd: int32, timeoutMs: int32): str

@abi_internal
@importc("RustCsgWebSocketWriteFrame")
fn RustCsgWebSocketWriteFrame(fd: int32, data: str): int32
