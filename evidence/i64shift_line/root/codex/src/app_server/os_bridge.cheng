# OS bridge: direct libc @importc replacements for retired provider symbols.
# Keeps app-server runtime wired through Cheng-owned bindings.
# All functions match the signatures expected by main.cheng.

@importc("getpid")
fn libc_getpid(): int32
@importc("gettimeofday")
fn libc_gettimeofday(tv: ptr, tz: ptr): int32
@importc("time")
fn libc_time(out: ptr): int64
@importc("getenv")
fn libc_getenv(name: ptr): ptr
@importc("fopen")
fn libc_fopen(path: ptr, mode: ptr): ptr
@importc("fread")
fn libc_fread(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fwrite")
fn libc_fwrite(buf: ptr, size: int64, count: int64, stream: ptr): int64
@importc("fclose")
fn libc_fclose(stream: ptr): int32
@importc("fseek")
fn libc_fseek(stream: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn libc_ftell(stream: ptr): int64
@importc("stat")
fn libc_stat(path: ptr, out: ptr): int32
@importc("mkdir")
fn libc_mkdir(path: ptr, mode: int32): int32
@importc("unlink")
fn libc_unlink(path: ptr): int32
@importc("rmdir")
fn libc_rmdir(path: ptr): int32
@importc("rename")
fn libc_rename(old: ptr, new: ptr): int32
@importc("opendir")
fn libc_opendir(path: ptr): ptr
@importc("readdir")
fn libc_readdir(dir: ptr): ptr
@importc("closedir")
fn libc_closedir(dir: ptr): int32
@importc("realpath")
fn libc_realpath(path: ptr, resolved: ptr): ptr
@importc("access")
fn libc_access(path: ptr, mode: int32): int32
@importc("tmpfile")
fn libc_tmpfile(): ptr
@importc("fgets")
fn libc_fgets(buf: ptr, size: int32, stream: ptr): ptr
@importc("memcpy")
fn libc_memcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("memset")
fn libc_memset(s: ptr, c: int32, n: int64): ptr
@importc("malloc")
fn libc_malloc(size: int64): ptr
@importc("free")
fn libc_free(p: ptr)
@importc("strlen")
fn libc_strlen(s: ptr): int64
@importc("strcmp")
fn libc_strcmp(a: ptr, b: ptr): int32
@importc("strcpy")
fn libc_strcpy(dst: ptr, src: ptr): ptr
@importc("remove")
fn libc_remove(path: ptr): int32
@importc("getcwd")
fn libc_getcwd(buf: ptr, size: int64): ptr
