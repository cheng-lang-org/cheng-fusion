import cheng/codex/protocol/wire
import cheng/codex/std/strings
import cheng/codex/app_server/rate_limit_dashboard_webdriver

# WebDriver JS injection scripts and OpenAI login pipeline.
# Aligns with Rust cf64150e9c codex-rs/app-server/src/rate_limit_dashboard/webdriver.rs.

# -- Common visibility helper (prepended to all scripts) --
const RustCsgWebDriverIsVisibleJs: str = "const isVisible=(e)=>{if(!(e instanceof Element)){return false}const s=window.getComputedStyle(e);if(s.display==='none'||s.visibility==='hidden'||s.pointerEvents==='none'){return false}if('disabled' in e&&e.disabled){return false}const r=e.getBoundingClientRect();return r.width>0&&r.height>0};"

# Getter functions below own the real script text. Keep legacy constants short so cold
# import parsing never pays for unused multiline JavaScript.
const RustCsgWebDriverFillVisibleInputScript: str = ""
const RustCsgWebDriverFillAndSubmitScript: str = ""
const RustCsgWebDriverClickVisibleTextScript: str = ""
const RustCsgWebDriverHasVisibleInputScript: str = ""
const RustCsgWebDriverFindFirstVisibleElementScript: str = ""
const RustCsgWebDriverSimplePageStateScript: str = ""

# -- Const getters (work around cold compiler multiline const bug) --

fn RustCsgWebDriverGetIsVisibleJs(): str = RustCsgWebDriverIsVisibleJs
fn RustCsgWebDriverGetFillAndSubmitScript(): str =
    return "const selectors=arguments[0],submitSelectors=arguments[1],text=arguments[2];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(!isVisible(el)){continue}const desc=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');if(desc&&desc.set){desc.set.call(el,text)}else{el.value=text}el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));for(const bs of submitSelectors){for(const btn of document.querySelectorAll(bs)){if(isVisible(btn)){btn.scrollIntoView({block:'center',inline:'center'});btn.click();return {status:'submitted'}}}}const form=el.form||el.closest('form');if(form&&form.requestSubmit){form.requestSubmit();return {status:'submitted'}}el.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true}));el.dispatchEvent(new KeyboardEvent('keyup',{key:'Enter',bubbles:true}));return {status:'submitted'}}}return {status:'missing'};"

fn RustCsgWebDriverGetFillVisibleInputScript(): str =
    return "const selectors=arguments[0],text=arguments[1];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(!isVisible(el)){continue}el.scrollIntoView({block:'center',inline:'center'});el.focus();const proto=el instanceof HTMLInputElement?window.HTMLInputElement?.prototype:window.HTMLTextAreaElement?.prototype;const desc=proto&&Object.getOwnPropertyDescriptor(proto,'value');if(desc&&desc.set){desc.set.call(el,text)}else{el.value=text}el.dispatchEvent(new Event('input',{bubbles:true,composed:true}));el.dispatchEvent(new Event('change',{bubbles:true}));return {status:'filled',value:text}}}return {status:'missing'};"

fn RustCsgWebDriverGetClickVisibleTextScript(): str =
    return "const selectors=arguments[0],texts=arguments[1];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(!isVisible(el)){continue}const txt=(el.innerText||el.textContent||el.value||el.getAttribute('aria-label')||'').trim().toLowerCase();for(const wanted of texts){if(txt.indexOf(wanted.toLowerCase())>=0){el.scrollIntoView({block:'center',inline:'center'});el.click();return {status:'clicked',text:wanted}}}}}return {status:'missing'};"

fn RustCsgWebDriverGetHasVisibleInputScript(): str =
    return "const selectors=arguments[0];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(isVisible(el)){return true}}}return false;"

fn RustCsgWebDriverGetFindFirstVisibleElementScript(): str =
    return "const selectors=arguments[0];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(isVisible(el)){return el}}}return null;"

fn RustCsgWebDriverGetSimplePageStateScript(): str =
    return "return{url:window.location.href||'',title:document.title||'',bodyText:(document.body?.innerText||'').trim()};"

# -- Script builders (prepend isVisible helper) --

fn RustCsgWebDriverScriptWithIsVisible(core: str): str =
    return wire.RustCsgCat(RustCsgWebDriverGetIsVisibleJs(), core)

fn RustCsgWebDriverStripWrappingQuotes(value: str): str =
    if value.len >= 2:
        let first = value[0]
        let last = value[value.len - 1]
        if first == '"' && last == '"':
            return strings.SliceBytes(value, 1, value.len - 2)
        if first == '\'' && last == '\'':
            return strings.SliceBytes(value, 1, value.len - 2)
    return value

# -- OpenAI login pipeline helpers --

fn RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl: str, sessionId: str, selectorsJson: str, submitSelectorsJson: str, text: str, fieldName: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var elapsed: int32
    var lastClickError: str
    while elapsed < timeoutMs:
        if RustCsgWebDriverOpenaiIdentityPageIsAuthError(baseUrl, sessionId):
            outError = wire.RustCsgCat("OpenAI returned an auth error page before the ", wire.RustCsgCat(fieldName, " step"))
            return false
        var fillError: str
        if !RustCsgWebDriverFillVisibleInput(baseUrl, sessionId, selectorsJson, text, fieldName, rate_limit_dashboard_webdriver.RustCsgWebDriverPollIntervalMs, fillError):
            rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
            elapsed = elapsed + rate_limit_dashboard_webdriver.RustCsgWebDriverPollIntervalMs
            continue
        var elementResult: str
        var elementError: str
        let findScript = RustCsgWebDriverScriptWithIsVisible(RustCsgWebDriverGetFindFirstVisibleElementScript())
        let findArgs = wire.RustCsgCat(wire.RustCsgCat("[", submitSelectorsJson), "]")
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, findScript, findArgs, elementResult, elementError):
            outError = elementError
            return false
        if elementResult != "null" && elementResult != "":
            let elementRef = rate_limit_dashboard_webdriver.RustCsgWebDriverElementReferenceId(elementResult)
            if elementRef != "":
                var clickError: str
                if rate_limit_dashboard_webdriver.RustCsgWebDriverClickElement(baseUrl, sessionId, elementRef, clickError):
                    return true
                if wire.RustCsgContains(clickError, "invalid element state") ||
                   wire.RustCsgContains(clickError, "not currently interactable") ||
                   wire.RustCsgContains(clickError, "element click intercepted"):
                    lastClickError = clickError
                    rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
                    elapsed = elapsed + rate_limit_dashboard_webdriver.RustCsgWebDriverPollIntervalMs
                    continue
                outError = clickError
                return false
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + rate_limit_dashboard_webdriver.RustCsgWebDriverPollIntervalMs
    if lastClickError != "":
        outError = wire.RustCsgCat("timed out clicking ", wire.RustCsgCat(fieldName, wire.RustCsgCat(" submit control after transient webdriver errors: ", lastClickError)))
        return false
    outError = wire.RustCsgCat("timed out waiting for visible ", wire.RustCsgCat(fieldName, " input"))
    return false

fn RustCsgWebDriverFillVisibleInput(baseUrl: str, sessionId: str, selectorsJson: str, text: str, fieldName: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var script = RustCsgWebDriverScriptWithIsVisible(RustCsgWebDriverGetFillVisibleInputScript())
    var args = "["
    args = wire.RustCsgCat(args, selectorsJson)
    args = wire.RustCsgCat(args, ",")
    var textJson2 = wire.RustCsgJsonQuote(text)
    args = wire.RustCsgCat(args, textJson2)
    args = wire.RustCsgCat(args, "]")
    var result: str
    return rate_limit_dashboard_webdriver.RustCsgWebDriverPollScriptResult(baseUrl, sessionId, script, args, "filled", timeoutMs, result, outError)

fn RustCsgWebDriverClickVisibleText(baseUrl: str, sessionId: str, selectorsJson: str, textsJson: str, timeoutMs: int32, outWasClicked: var bool, outError: var str): bool =
    outWasClicked = false
    outError = ""
    var script = RustCsgWebDriverScriptWithIsVisible(RustCsgWebDriverGetClickVisibleTextScript())
    var args = "["
    args = wire.RustCsgCat(args, selectorsJson)
    args = wire.RustCsgCat(args, ",")
    args = wire.RustCsgCat(args, textsJson)
    args = wire.RustCsgCat(args, "]")
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, args, result, outError):
            return false
        var status = wire.RustCsgJsonFindOptionalStr(result, "status")
        if status == "clicked":
            outWasClicked = true
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    return true

fn RustCsgWebDriverHasVisibleInput(baseUrl: str, sessionId: str, selectorsJson: str, timeoutMs: int32, outFound: var bool, outError: var str): bool =
    outFound = false
    outError = ""
    var script = RustCsgWebDriverScriptWithIsVisible(RustCsgWebDriverGetHasVisibleInputScript())
    var args = "["
    args = wire.RustCsgCat(args, selectorsJson)
    args = wire.RustCsgCat(args, "]")
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, args, result, outError):
            return false
        if result == "true":
            outFound = true
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    return true

# -- Page inspection helpers --

fn RustCsgWebDriverOpenaiIdentityPageNeedsReload(baseUrl: str, sessionId: str): bool =
    var url: str
    var title: str
    var bodyText: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverSimplePageState(baseUrl, sessionId, url, title, bodyText, error):
        return false
    if !wire.RustCsgContains(url, "auth.openai.com/log-in"):
        return false
    return wire.RustCsgContains(bodyText, "Operation timed out") ||
           wire.RustCsgContains(bodyText, "操作超时") ||
           wire.RustCsgContains(bodyText, "Something went wrong") ||
           wire.RustCsgContains(bodyText, "出了点问题")

fn RustCsgWebDriverOpenaiIdentityPageIsAuthError(baseUrl: str, sessionId: str): bool =
    var url: str
    var title: str
    var bodyText: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverSimplePageState(baseUrl, sessionId, url, title, bodyText, error):
        return false
    if !wire.RustCsgContains(url, "auth.openai.com/error"):
        return false
    return wire.RustCsgContains(title, "身份验证错误") ||
           wire.RustCsgContains(title, "Authentication Error") ||
           wire.RustCsgContains(title, "authentication error") ||
           wire.RustCsgContains(bodyText, "unknown_error") ||
           wire.RustCsgContains(bodyText, "验证过程中出错") ||
           wire.RustCsgContains(bodyText, "something went wrong during verification") ||
           wire.RustCsgContains(bodyText, "Something went wrong during verification") ||
           wire.RustCsgContains(bodyText, "There was an error") ||
           wire.RustCsgContains(bodyText, "出现错误")

fn RustCsgWebDriverIsEmailVerificationSuccessPage(baseUrl: str, sessionId: str): bool =
    var url: str
    var title: str
    var bodyText: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverSimplePageState(baseUrl, sessionId, url, title, bodyText, error):
        return false
    if !wire.RustCsgContains(url, "auth.openai.com"):
        return false
    return wire.RustCsgContains(bodyText, "Email verified") ||
           wire.RustCsgContains(bodyText, "email has been verified") ||
           wire.RustCsgContains(bodyText, "email address has been verified") ||
           wire.RustCsgContains(bodyText, "验证成功") ||
           wire.RustCsgContains(bodyText, "邮箱已验证")

fn RustCsgWebDriverWaitForEmailVerificationSuccessPage(baseUrl: str, sessionId: str, timeoutMs: int32, outFound: var bool, outError: var str): bool =
    outFound = false
    outError = ""
    var elapsed: int32
    while elapsed < timeoutMs:
        if RustCsgWebDriverIsEmailVerificationSuccessPage(baseUrl, sessionId):
            outFound = true
            return true
        if RustCsgWebDriverOpenaiIdentityPageIsAuthError(baseUrl, sessionId):
            outError = "OpenAI returned an auth error page after email verification"
            return false
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    return true

# -- Consent page handling --

fn RustCsgWebDriverIsOpenaiConsentPage(baseUrl: str, sessionId: str): bool =
    var url: str
    var title: str
    var bodyText: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverSimplePageState(baseUrl, sessionId, url, title, bodyText, error):
        return false
    if !wire.RustCsgContains(url, "auth.openai.com"):
        return false
    let lowerBody = wire.RustCsgContains(bodyText, "sign in to codex") ||
                    wire.RustCsgContains(bodyText, "登录到 Codex") ||
                    wire.RustCsgContains(bodyText, "登录 Codex") ||
                    wire.RustCsgContains(bodyText, "Sign in to Codex")
    return lowerBody

fn RustCsgWebDriverConfirmOpenaiConsent(baseUrl: str, sessionId: str, outError: var str): bool =
    outError = ""
    let selectors = "[\"button\",\"a\",\"[role='button']\",\"div\",\"span\"]"
    let texts = "[\"Continue\",\"Allow\",\"Authorize\",\"继续\",\"允许\",\"授权\"]"
    var elapsed: int32
    var sawConsentPage: bool
    while elapsed < 20000:
        if RustCsgWebDriverIsOpenaiConsentPage(baseUrl, sessionId):
            sawConsentPage = true
            var wasClicked: bool
            if !RustCsgWebDriverClickVisibleText(baseUrl, sessionId, selectors, texts, 3000, wasClicked, outError):
                return false
            if wasClicked:
                return true
        elif sawConsentPage:
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    if sawConsentPage:
        outError = "timed out confirming OpenAI consent page"
        return false
    return true

# -- OpenAI login pipeline --

fn RustCsgWebDriverCompleteOpenaiLogin(baseUrl: str,
                                        sessionId: str,
                                        authUrl: str,
                                        email: str,
                                        password: str,
                                        mailboxPassword: str,
                                        outError: var str): bool =
    outError = ""
    let cleanPassword = RustCsgWebDriverStripWrappingQuotes(password)
    let emailSelectors = "[\"input[type='email']\",\"input[name='email']\",\"input[name='username']\",\"input#username\"]"
    let emailSubmitSelectors = "[\"button[type='submit']\",\"input[type='submit']\",\"#identifierNext button\",\"#identifierNext [role='button']\"]"
    let passwordSelectors = "[\"input[type='password']\",\"input[name='password']\",\"input[name='Passwd']\",\"input[autocomplete='current-password']\"]"
    let passwordSubmitSelectors = "[\"#passwordNext\",\"button[type='submit']\",\"input[type='submit']\",\"#passwordNext button\",\"#passwordNext [role='button']\"]"

    if !rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, authUrl, outError):
        outError = wire.RustCsgCat("failed to navigate to auth url: ", outError)
        return false

    if !RustCsgWebDriverFillVisibleInput(baseUrl, sessionId, emailSelectors, email, "email", 45000, outError):
        outError = wire.RustCsgCat("failed to fill email: ", outError)
        return false
    var submitError: str
    if !RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId, emailSelectors, emailSubmitSelectors, email, "email", 45000, submitError):
        if !wire.RustCsgContains(submitError, "submitted"):
            outError = wire.RustCsgCat("failed to submit email: ", submitError)
            return false

    if !RustCsgWebDriverSettleOpenaiIdentityStep(baseUrl, sessionId, authUrl, email, outError):
        return false

    if !RustCsgWebDriverWaitForOpenaiPasswordStep(baseUrl, sessionId, authUrl, email, outError):
        return false

    if !RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId, passwordSelectors, passwordSubmitSelectors, cleanPassword, "password", 45000, outError):
        outError = wire.RustCsgCat("failed to fill password: ", outError)
        return false

    if !RustCsgWebDriverConfirmOpenaiConsent(baseUrl, sessionId, outError):
        return false

    return true

fn RustCsgWebDriverSettleOpenaiIdentityStep(baseUrl: str, sessionId: str, authUrl: str, email: str, outError: var str): bool =
    outError = ""
    let emailSelectors = "[\"input[type='email']\",\"input[name='email']\",\"input[name='username']\",\"input#username\"]"
    let passwordSelectors = "[\"input[type='password']\"]"
    let googleSelectors = "[\"input#identifierId\",\"input[name='identifier']\",\"input[type='email']\"]"
    let actionSelectors = "[\"button[type='submit']\",\"input[type='submit']\",\"button\",\"a\",\"[role='button']\"]"
    let actionTexts = "[\"重试\",\"Retry\",\"登录\",\"Log in\"]"
    var reloadCount: int32
    var elapsed: int32
    var resubmittedEmail: bool
    while elapsed < 45000:
        var passwordFound: bool
        if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, passwordSelectors, 500, passwordFound, outError):
            return false
        if passwordFound:
            return true
        var googleFound: bool
        if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, googleSelectors, 500, googleFound, outError):
            return false
        if googleFound:
            return true
        if RustCsgWebDriverOpenaiIdentityPageNeedsReload(baseUrl, sessionId):
            if reloadCount >= 5:
                outError = "OpenAI identity page timed out after max reloads"
                return false
            rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, authUrl, outError)
            var submitErr: str
            RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId,
                emailSelectors,
                "[\"button[type='submit']\",\"input[type='submit']\"]",
                email, "email", 45000, submitErr)
            reloadCount = reloadCount + 1
            continue
        var actionClicked: bool
        if !RustCsgWebDriverClickVisibleText(baseUrl, sessionId, actionSelectors, actionTexts, 500, actionClicked, outError):
            return false
        if actionClicked:
            continue
        if !resubmittedEmail:
            var emailFound: bool
            if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, emailSelectors, 500, emailFound, outError):
                return false
            if emailFound:
                var resubmitErr: str
                RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId,
                    emailSelectors,
                    "[\"button[type='submit']\",\"input[type='submit']\"]",
                    email, "email", 45000, resubmitErr)
                resubmittedEmail = true
                continue
        if RustCsgWebDriverOpenaiIdentityPageIsAuthError(baseUrl, sessionId):
            outError = "OpenAI returned an auth error page before the password step"
            return false
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outError = "timed out waiting for visible password input"
    return false

fn RustCsgWebDriverWaitForOpenaiPasswordStep(baseUrl: str, sessionId: str, authUrl: str, email: str, outError: var str): bool =
    outError = ""
    let passwordSelectors = "[\"input[type='password']\"]"
    let googleSelectors = "[\"input[type='email']\",\"input[name='identifier']\",\"input#identifierId\"]"
    let emailSelectors = "[\"input[type='email']\",\"input[name='email']\",\"input[name='username']\",\"input#username\"]"
    var reloadCount: int32
    var elapsed: int32
    while elapsed < 45000:
        var found: bool
        if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, passwordSelectors, 500, found, outError):
            return false
        if found:
            return true
        if RustCsgWebDriverOpenaiIdentityPageIsAuthError(baseUrl, sessionId):
            outError = "OpenAI returned an auth error page before the password step"
            return false
        var googleFound: bool
        if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, googleSelectors, 500, googleFound, outError):
            return false
        if googleFound:
            var submitErr: str
            RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId, googleSelectors,
                "[\"#identifierNext\",\"#identifierNext button\",\"#identifierNext [role='button']\",\"button[type='submit']\",\"input[type='submit']\"]",
                email, "google-email", 45000, submitErr)
            rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
            continue
        if RustCsgWebDriverOpenaiIdentityPageNeedsReload(baseUrl, sessionId):
            if reloadCount >= 5:
                outError = "OpenAI identity page timed out after max reloads"
                return false
            rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, authUrl, outError)
            var submitErr2: str
            RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId,
                emailSelectors,
                "[\"button[type='submit']\",\"input[type='submit']\"]",
                email, "email", 45000, submitErr2)
            reloadCount = reloadCount + 1
            continue
        var emailFound: bool
        if !RustCsgWebDriverHasVisibleInput(baseUrl, sessionId, emailSelectors, 500, emailFound, outError):
            return false
        if emailFound:
            var submitErr3: str
            RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId,
                emailSelectors,
                "[\"button[type='submit']\",\"input[type='submit']\"]",
                email, "email", 45000, submitErr3)
            continue
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outError = "timed out waiting for visible password input"
    return false
