# ── StateDbPath helper ──────────────────────────────────────────────────────────

fn rustCsgAppServerStateDbPath(outError: var str): str =
    outError = ""
    let sqliteHome = state_db.RustCsgResolveSqliteHome("", "")
    if sqliteHome.error != "":
        outError = sqliteHome.error
        return ""
    return state_db.RustCsgStateDbPath(sqliteHome.path)

# ── Count JSON array items helper ──────────────────────────────────────────────

fn rustCsgAppServerCountJsonArrayItems(jsonArray: str): int32 =
    if jsonArray == "":
        return 0
    var depth: int32
    var count: int32
    var inString: bool
    var escaped: bool
    for i in 0..<jsonArray.len:
        let ch = jsonArray[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{' || ch == '[':
            if depth == 1:
                count = count + 1
            depth = depth + 1
        elif ch == '}' || ch == ']':
            depth = depth - 1
    return count

# ── Response helpers (duplicated from main.cheng for module self-containment) ──

fn rustCsgAppServerRequestId(body: str): int32 =
    if wire.RustCsgContains(body, "\"id\""):
        return wire.RustCsgJsonFindInt32(body, "id")
    return 0

fn rustCsgAppServerResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgAppServerError(id: int32, code: int32, message: str): str =
    let errorHead = wire.RustCsgCat3("{\"error\":{\"code\":", strings.IntToStr(code), ",\"message\":")
    let errorBody = wire.RustCsgCat3(errorHead, wire.RustCsgJsonQuote(message), "}")
    return wire.RustCsgCat3(errorBody, wire.RustCsgCat3(",\"id\":", strings.IntToStr(id), ""), "}")

fn rustCsgAppServerThreadAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgAppServerNormalizeThreadName(name: str): str =
    var start: int32
    var end: int32
    end = name.len
    while start < end && rustCsgAppServerThreadAsciiSpace(name[start]):
        start = start + 1
    while end > start && rustCsgAppServerThreadAsciiSpace(name[end - 1]):
        end = end - 1
    return strings.SliceBytes(name, start, end - start)

fn RustCsgAppServerThreadNameUpdatedNotification(threadId: str, threadName: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadName", threadName))
    params = wire.RustCsgCat(params, "}")
    var out = "{\"method\":\"thread/name/updated\",\"params\":"
    out = wire.RustCsgCat(out, params)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppServerThreadArchivedNotification(threadId: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, "}")
    var out = "{\"method\":\"thread/archived\",\"params\":"
    out = wire.RustCsgCat(out, params)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppServerThreadStartedNotification(threadJson: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("thread", threadJson))
    params = wire.RustCsgCat(params, "}")
    var out = "{\"method\":\"thread/started\",\"params\":"
    out = wire.RustCsgCat(out, params)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppServerThreadStartedNotificationFromResponse(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let threadJson = wire.RustCsgJsonFindObject(resultJson, "thread")
    if threadJson == "":
        return ""
    return RustCsgAppServerThreadStartedNotification(threadJson)

fn RustCsgAppServerThreadStartedNotificationFromResponseClearingTurns(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let threadJson = wire.RustCsgJsonFindObject(resultJson, "thread")
    if threadJson == "":
        return ""
    var thread = wire.RustCsgAppThreadFromJson(threadJson)
    thread.turnsJson = "[]"
    return RustCsgAppServerThreadStartedNotification(wire.RustCsgAppThreadToJson(thread))

fn RustCsgAppServerThreadIdFromLifecycleResponse(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let threadJson = wire.RustCsgJsonFindObject(resultJson, "thread")
    if threadJson == "":
        return ""
    return wire.RustCsgJsonFindStr(threadJson, "id")

fn RustCsgAppServerThreadPathFromLifecycleResponse(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let threadJson = wire.RustCsgJsonFindObject(resultJson, "thread")
    if threadJson == "":
        return ""
    return wire.RustCsgJsonFindOptionalStr(threadJson, "path")

fn RustCsgAppServerThreadTurnsFromLifecycleResponse(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let threadJson = wire.RustCsgJsonFindObject(resultJson, "thread")
    if threadJson == "":
        return ""
    return wire.RustCsgJsonFindArray(threadJson, "turns")

fn rustCsgAppServerExistingRolloutPathOrError(requestPath: str, outError: var str): str =
    outError = ""
    if requestPath == "":
        return ""
    let kind = home.RustCsgPathMetadataKind(requestPath)
    if kind == 2:
        return requestPath
    if kind == 1:
        outError = wire.RustCsgCat("rollout path is not a file: ", requestPath)
        return ""
    if kind < 0:
        outError = wire.RustCsgCat("failed to read rollout path metadata: ", requestPath)
        return ""
    outError = wire.RustCsgCat("no rollout found at path ", requestPath)
    return ""

fn rustCsgAppServerSourceRolloutPathFromLifecycleRequest(body: str, outError: var str): str =
    outError = ""
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        outError = pathError
        return ""
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let requestPath = wire.RustCsgJsonFindOptionalStr(paramsJson, "path")
    if requestPath != "":
        let row = state_db_sqlite.RustCsgStateDbThreadByRolloutPathIncludingArchived(dbPath, requestPath)
        if !row.ok:
            if row.notFound:
                return rustCsgAppServerExistingRolloutPathOrError(requestPath, outError)
            else:
                outError = row.error
            return ""
        return row.rolloutPath
    let sourceThreadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    if sourceThreadId == "":
        return ""
    let row = state_db_sqlite.RustCsgStateDbThreadByIdIncludingArchived(dbPath, sourceThreadId)
    if !row.ok:
        if row.notFound:
            outError = wire.RustCsgCat("no rollout found for thread id ", sourceThreadId)
        else:
            outError = row.error
        return ""
    return row.rolloutPath

fn rustCsgAppServerThreadRowFromPathOnlyRollout(requestPath: str,
                                                fallbackThreadId: str,
                                                outError: var str): state_db_sqlite.RustCsgStateDbThreadRowResult =
    var row: state_db_sqlite.RustCsgStateDbThreadRowResult
    let path = rustCsgAppServerExistingRolloutPathOrError(requestPath, outError)
    if outError != "":
        return row
    let text = home.RustCsgReadFile(path)
    if text == "":
        outError = wire.RustCsgCat("no rollout found at path ", requestPath)
        return row
    row.id = reader.RustCsgRolloutLatestSessionMetaId(path)
    if row.id == "":
        row.id = fallbackThreadId
    row.rolloutPath = path
    row.cwd = reader.RustCsgRolloutLatestSessionMetaCwd(path)
    if row.cwd == "":
        row.cwd = reader.RustCsgRolloutLatestTurnCwd(path)
    row.modelProvider = reader.RustCsgRolloutLatestSessionMetaModelProvider(path)
    row.source = "cli"
    row.cliVersion = reader.RustCsgRolloutLatestSessionMetaCliVersion(path)
    row.firstUserMessage = reader.RustCsgRolloutFirstUserMessageFromText(text)
    let timestamp = reader.RustCsgRolloutLatestSessionMetaTimestamp(path)
    if timestamp != "":
        let millisText = thread_list_sqlite.RustCsgRfc3339ToMillisText(timestamp)
        if millisText != "":
            row.createdAtMs = wire.RustCsgParseInt64(millisText)
            row.updatedAtMs = row.createdAtMs
    row.ok = true
    return row

fn RustCsgAppServerTokenUsageReplayNotificationFromRequestResponse(body: str, response: str, outError: var str): str =
    outError = ""
    if !wire.RustCsgContains(response, "\"result\""):
        return ""
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    if wire.RustCsgJsonFindOptionalBool(paramsJson, "excludeTurns"):
        return ""
    let threadId = RustCsgAppServerThreadIdFromLifecycleResponse(response)
    if threadId == "":
        return ""
    let turnsJson = RustCsgAppServerThreadTurnsFromLifecycleResponse(response)
    if turnsJson == "" || turnsJson == "[]":
        return ""
    let method = wire.RustCsgJsonFindStr(body, "method")
    var rolloutPath: str
    if method == "thread/fork":
        rolloutPath = rustCsgAppServerSourceRolloutPathFromLifecycleRequest(body, outError)
        if outError != "":
            return ""
    else:
        rolloutPath = RustCsgAppServerThreadPathFromLifecycleResponse(response)
        if rolloutPath == "":
            rolloutPath = rustCsgAppServerSourceRolloutPathFromLifecycleRequest(body, outError)
            if outError != "":
                return ""
    if rolloutPath == "":
        return ""
    return reader.RustCsgRolloutTokenUsageUpdatedNotificationFromFile(threadId, rolloutPath, outError)

fn RustCsgAppServerTurnStartedNotification(threadId: str, turnJson: str): str =
    let paramsHead = wire.RustCsgCat3("{\"threadId\":", wire.RustCsgJsonQuote(threadId), ",\"turn\":")
    let params = wire.RustCsgCat3(paramsHead, turnJson, "}")
    return wire.RustCsgCat3("{\"method\":\"turn/started\",\"params\":", params, "}")

fn RustCsgAppServerTurnStartedNotificationFromResponse(threadId: str, response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let turnJson = wire.RustCsgJsonFindObject(resultJson, "turn")
    if turnJson == "":
        return ""
    return RustCsgAppServerTurnStartedNotification(threadId, turnJson)

fn RustCsgAppServerTurnIdFromTurnStartResponse(response: str): str =
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    if resultJson == "":
        return ""
    let turnJson = wire.RustCsgJsonFindObject(resultJson, "turn")
    if turnJson == "":
        return ""
    return wire.RustCsgJsonFindStr(turnJson, "id")

fn rustCsgAppServerDefaultCwd(): str =
    let cwd = home.RustCsgRealPath(".")
    if cwd != "":
        return cwd
    return "/"

fn rustCsgAppServerBoolFromOptionalRaw(raw: str): bool =
    return raw == "true"

fn rustCsgAppServerServiceTierFromParamsJson(paramsJson: str): str =
    let raw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "serviceTier")
    if raw == "":
        return ""
    if raw == "null":
        return ""
    if raw.len > 0 && raw[0] == '"':
        return wire.RustCsgJsonFindStr(paramsJson, "serviceTier")
    return ""

fn rustCsgAppServerConfigOverrideStr(configJson: str, key: str): str =
    if configJson == "":
        return ""
    return wire.RustCsgJsonFindOptionalStr(configJson, key)

fn rustCsgAppServerPermissionProfileIdFromJson(permissionsJson: str, outError: var str): str =
    outError = ""
    if permissionsJson == "":
        return ""
    if permissionsJson[0] != '"':
        outError = "permissions must be string"
        return ""
    let wrapper = wire.RustCsgCat3("{\"id\":", permissionsJson, "}")
    let profileId = wire.RustCsgJsonFindStr(wrapper, "id")
    if profileId == "":
        outError = "permissions must not be empty"
        return ""
    return profileId

fn rustCsgAppServerActivePermissionProfileJson(profileId: str): str =
    return wire.RustCsgCat3("{\"id\":", wire.RustCsgJsonQuote(profileId), "}")

fn rustCsgAppServerSandboxJsonForPermissionProfileId(profileId: str): str =
    if profileId == ":read-only":
        return "{\"type\":\"readOnly\"}"
    if profileId == ":workspace":
        return "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    if profileId == ":danger-full-access":
        return "{\"type\":\"dangerFullAccess\"}"
    return ""

fn rustCsgAppServerRolloutPath(codexHome: str, threadId: str): str =
    let sessionsDir = home.RustCsgPathJoinChild(codexHome, "sessions")
    let fileName = wire.RustCsgCat3("rollout-", threadId, ".jsonl")
    return home.RustCsgPathJoinChild(sessionsDir, fileName)

fn rustCsgAppServerStripSessionMetaLines(text: str): str =
    var out: str
    var lineStart: int32
    var i: int32
    while i <= text.len:
        if i == text.len || text[i] == '\n':
            let lineLen = i - lineStart
            if lineLen > 0:
                let line = wire.RustCsgSliceBytes(text, lineStart, lineLen)
                if reader.RustCsgRolloutParseRolloutLine(line) != wire.RustCsgWireSessionMeta:
                    out = wire.RustCsgCat(out, line)
                    out = wire.RustCsgCat(out, "\n")
            lineStart = i + 1
        i = i + 1
    return out

fn rustCsgAppServerForkSessionMetaLine(threadId: str,
                                       sourceThreadId: str,
                                       timestamp: str,
                                       cwd: str,
                                       source: str,
                                       threadSource: str,
                                       modelProvider: str,
                                       cliVersion: str,
                                       baseInstructions: str,
                                       baseInstructionsPresent: bool): str =
    var meta: types.RustCsgSessionMeta
    meta.id = threadId
    meta.forkedFromId = sourceThreadId
    meta.timestamp = timestamp
    meta.cwd = cwd
    meta.originator = "codex-app-server"
    meta.cliVersion = cliVersion
    meta.source = source
    meta.threadSource = threadSource
    meta.modelProvider = modelProvider
    meta.baseInstructions = baseInstructions
    meta.baseInstructionsPresent = baseInstructionsPresent
    var line: types.RustCsgRolloutLine
    line.timestamp = timestamp
    line.itemType = wire.RustCsgWireSessionMeta
    line.sessionMeta = meta
    return wire.RustCsgCat(wire.RustCsgRolloutLineToJson(line), "\n")

fn rustCsgAppServerRequestHasBaseInstructions(paramsJson: str): bool =
    let raw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "baseInstructions")
    return raw != "" && raw != "null"

fn rustCsgAppServerForkSessionMetaBaseInstructions(paramsJson: str,
                                                   sourceRolloutPath: str,
                                                   outPresent: var bool): str =
    if rustCsgAppServerRequestHasBaseInstructions(paramsJson):
        outPresent = true
        return wire.RustCsgJsonFindOptionalStr(paramsJson, "baseInstructions")
    let raw = reader.RustCsgRolloutLatestSessionMetaBaseInstructionsRaw(sourceRolloutPath)
    if raw != "":
        outPresent = true
        return reader.RustCsgRolloutSessionMetaBaseInstructionsText(raw)
    outPresent = false
    return ""

fn rustCsgAppServerJsonStringEnd(text: str, start: int32): int32 =
    if start >= text.len || text[start] != '"':
        return -1
    var i = start + 1
    var escaped: bool
    while i < text.len:
        let ch = text[i]
        if escaped:
            escaped = false
        elif ch == '\\':
            escaped = true
        elif ch == '"':
            return i + 1
        i = i + 1
    return -1

fn rustCsgAppServerJsonCompositeEnd(text: str, start: int32, openCh: char, closeCh: char): int32 =
    if start >= text.len || text[start] != openCh:
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == openCh:
            depth = depth + 1
        elif ch == closeCh:
            depth = depth - 1
            if depth == 0:
                return i + 1
        i = i + 1
    return -1

fn rustCsgAppServerJsonValueEnd(text: str, start: int32): int32 =
    let p = wire.RustCsgSkipJsonSpace(text, start)
    if p >= text.len:
        return -1
    let ch = text[p]
    if ch == '{':
        return rustCsgAppServerJsonCompositeEnd(text, p, '{', '}')
    if ch == '[':
        return rustCsgAppServerJsonCompositeEnd(text, p, '[', ']')
    if ch == '"':
        return rustCsgAppServerJsonStringEnd(text, p)
    var i = p
    while i < text.len:
        let c = text[i]
        if c == ',' || c == '}' || c == ']' || c == ' ' || c == '\n' || c == '\r' || c == '\t':
            return i
        i = i + 1
    return i

fn rustCsgAppServerJsonTopLevelValueRaw(objectJson: str, key: str): str =
    let start = wire.RustCsgSkipJsonSpace(objectJson, 0)
    if start >= objectJson.len || objectJson[start] != '{':
        return ""
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < objectJson.len:
        let ch = objectJson[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            if depth == 1 && wire.RustCsgMatchesAt(objectJson, i, pattern):
                let colon = wire.RustCsgSkipJsonSpace(objectJson, i + pattern.len)
                if colon < objectJson.len && objectJson[colon] == ':':
                    let valueStart = wire.RustCsgSkipJsonSpace(objectJson, colon + 1)
                    let valueEnd = rustCsgAppServerJsonValueEnd(objectJson, valueStart)
                    if valueEnd >= valueStart:
                        return wire.RustCsgSliceBytes(objectJson, valueStart, valueEnd - valueStart)
                    return ""
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return ""
        i = i + 1
    return ""

fn rustCsgAppServerJsonStringFromRaw(raw: str): str =
    return wire.RustCsgJsonFindStr(wire.RustCsgCat3("{\"value\":", raw, "}"), "value")

fn rustCsgAppServerReadJsonArrayObject(arrayJson: str, pos: var int32, outObject: var str, outError: var str): bool =
    outObject = ""
    outError = ""
    var p = wire.RustCsgSkipJsonSpace(arrayJson, pos)
    if pos == 0:
        if p >= arrayJson.len || arrayJson[p] != '[':
            outError = "dynamicTools must be json array"
            return false
        p = wire.RustCsgSkipJsonSpace(arrayJson, p + 1)
    if p < arrayJson.len && arrayJson[p] == ',':
        p = wire.RustCsgSkipJsonSpace(arrayJson, p + 1)
    if p < arrayJson.len && arrayJson[p] == ']':
        pos = p + 1
        return false
    if p >= arrayJson.len || arrayJson[p] != '{':
        outError = "dynamicTools item must be object"
        return false
    let endPos = rustCsgAppServerJsonCompositeEnd(arrayJson, p, '{', '}')
    if endPos < 0:
        outError = "unterminated dynamicTools item"
        return false
    outObject = wire.RustCsgSliceBytes(arrayJson, p, endPos - p)
    pos = endPos
    return true

fn rustCsgAppServerDynamicToolTrimAscii(value: str): str =
    var start: int32
    var end = value.len
    while start < end && rustCsgAppServerThreadAsciiSpace(value[start]):
        start = start + 1
    while end > start && rustCsgAppServerThreadAsciiSpace(value[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(value, start, end - start)

fn rustCsgAppServerDynamicToolEscapeIdentifierForError(value: str): str =
    var out: str
    var i: int32
    while i < value.len:
        let ch = value[i]
        if ch == '\\':
            out = wire.RustCsgCat(out, "\\\\")
        elif ch == '\n':
            out = wire.RustCsgCat(out, "\\n")
        elif ch == '\r':
            out = wire.RustCsgCat(out, "\\r")
        elif ch == '\t':
            out = wire.RustCsgCat(out, "\\t")
        elif ch == '"':
            out = wire.RustCsgCat(out, "\\\"")
        else:
            out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(value, i, 1))
        i = i + 1
    return out

fn rustCsgAppServerDynamicToolIdentifierCharOk(ch: char): bool =
    let code = int32(ch)
    if code >= 48 && code <= 57:
        return true
    if code >= 65 && code <= 90:
        return true
    if code >= 97 && code <= 122:
        return true
    return ch == '_' || ch == '-'

fn rustCsgAppServerDynamicToolValidateIdentifier(value: str,
                                                 label: str,
                                                 maxLen: int32,
                                                 outError: var str): bool =
    var i: int32
    while i < value.len:
        if !rustCsgAppServerDynamicToolIdentifierCharOk(value[i]):
            outError = wire.RustCsgCat4(label, " must match ^[a-zA-Z0-9_-]+$ to match Responses API: ", rustCsgAppServerDynamicToolEscapeIdentifierForError(value), "")
            return false
        i = i + 1
    if value.len > maxLen:
        outError = wire.RustCsgCat4(label, " must be at most ", strings.IntToStr(maxLen), " characters to match Responses API: ")
        outError = wire.RustCsgCat(outError, rustCsgAppServerDynamicToolEscapeIdentifierForError(value))
        return false
    return true

fn rustCsgAppServerDynamicToolReservedResponsesNamespace(namespace: str): bool =
    return namespace == "api_tool" ||
        namespace == "browser" ||
        namespace == "computer" ||
        namespace == "container" ||
        namespace == "file_search" ||
        namespace == "functions" ||
        namespace == "image_gen" ||
        namespace == "multi_tool_use" ||
        namespace == "python" ||
        namespace == "python_user_visible" ||
        namespace == "submodel_delegator" ||
        namespace == "terminal" ||
        namespace == "tool_search" ||
        namespace == "web"

fn rustCsgAppServerDynamicToolSeenIndex(seenNamespaces: str[], seenNames: str[], namespace: str, name: str): int32 =
    var i: int32
    while i < seenNames.len:
        if seenNamespaces[i] == namespace && seenNames[i] == name:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerDynamicToolDeferred(toolJson: str): bool =
    let deferRaw = rustCsgAppServerJsonTopLevelValueRaw(toolJson, "deferLoading")
    if deferRaw != "":
        return deferRaw == "true"
    let exposeRaw = rustCsgAppServerJsonTopLevelValueRaw(toolJson, "exposeToContext")
    if exposeRaw != "":
        return exposeRaw == "false"
    return false

fn rustCsgAppServerDynamicToolPrimitiveTypeSupported(value: str): bool =
    return value == "string" ||
        value == "number" ||
        value == "boolean" ||
        value == "integer" ||
        value == "object" ||
        value == "array" ||
        value == "null"

fn rustCsgAppServerDynamicToolSingletonNullTypeRaw(raw: str): bool =
    let p = wire.RustCsgSkipJsonSpace(raw, 0)
    if p >= raw.len:
        return false
    if raw[p] == '"':
        return rustCsgAppServerJsonStringFromRaw(wire.RustCsgSliceBytes(raw, p, raw.len - p)) == "null"
    if raw[p] != '[':
        return false
    var validCount: int32
    var hasNull: bool
    var hasSupportedNonNull: bool
    var pos = wire.RustCsgSkipJsonSpace(raw, p + 1)
    while pos < raw.len:
        if raw[pos] == ']':
            if validCount != 1:
                return false
            if !hasNull:
                return false
            if hasSupportedNonNull:
                return false
            return true
        if raw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(raw, pos + 1)
            continue
        let valueEnd = rustCsgAppServerJsonValueEnd(raw, pos)
        if valueEnd <= pos:
            return false
        if raw[pos] == '"':
            let itemValue = rustCsgAppServerJsonStringFromRaw(wire.RustCsgSliceBytes(raw, pos, valueEnd - pos))
            if itemValue == "null":
                validCount = validCount + 1
                hasNull = true
            elif rustCsgAppServerDynamicToolPrimitiveTypeSupported(itemValue):
                validCount = validCount + 1
                hasSupportedNonNull = true
        pos = wire.RustCsgSkipJsonSpace(raw, valueEnd)
    return false

fn rustCsgAppServerDynamicToolInputSchemaOk(name: str, toolJson: str, outError: var str): bool =
    let schemaRaw = rustCsgAppServerJsonTopLevelValueRaw(toolJson, "inputSchema")
    if schemaRaw == "":
        outError = wire.RustCsgCat("dynamic tool spec missing inputSchema: ", name)
        return false
    let p = wire.RustCsgSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len:
        outError = wire.RustCsgCat("dynamic tool input schema is not supported for ", name)
        return false
    if schemaRaw[p] == '{':
        let typeRaw = rustCsgAppServerJsonTopLevelValueRaw(schemaRaw, "type")
        if rustCsgAppServerDynamicToolSingletonNullTypeRaw(typeRaw):
            outError = wire.RustCsgCat3("dynamic tool input schema is not supported for ", name, ": tool input schema must not be a singleton null type")
            return false
        return true
    if schemaRaw == "true" || schemaRaw == "false":
        return true
    outError = wire.RustCsgCat("dynamic tool input schema is not supported for ", name)
    return false

fn rustCsgAppServerDynamicToolNameNamespaceOk(toolJson: str,
                                              outName: var str,
                                              outNamespace: var str,
                                              outNamespacePresent: var bool,
                                              outError: var str): bool =
    let nameRaw = rustCsgAppServerJsonTopLevelValueRaw(toolJson, "name")
    if nameRaw == "" || nameRaw == "null":
        outError = "dynamic tool name must not be empty"
        return false
    if nameRaw[0] != '"':
        outError = "dynamic tool name must be string"
        return false
    let originalName = rustCsgAppServerJsonStringFromRaw(nameRaw)
    let name = rustCsgAppServerDynamicToolTrimAscii(originalName)
    if name == "":
        outError = "dynamic tool name must not be empty"
        return false
    if name != originalName:
        outError = wire.RustCsgCat("dynamic tool name has leading/trailing whitespace: ", rustCsgAppServerDynamicToolEscapeIdentifierForError(originalName))
        return false
    if !rustCsgAppServerDynamicToolValidateIdentifier(name, "dynamic tool name", 128, outError):
        return false
    if name == "mcp" || wire.RustCsgStartsWith(name, "mcp__"):
        outError = wire.RustCsgCat("dynamic tool name is reserved: ", name)
        return false

    let namespaceRaw = rustCsgAppServerJsonTopLevelValueRaw(toolJson, "namespace")
    var namespacePresent = namespaceRaw != "" && namespaceRaw != "null"
    var namespace: str
    if namespacePresent:
        if namespaceRaw[0] != '"':
            outError = wire.RustCsgCat("dynamic tool namespace must be string for ", name)
            return false
        let originalNamespace = rustCsgAppServerJsonStringFromRaw(namespaceRaw)
        namespace = rustCsgAppServerDynamicToolTrimAscii(originalNamespace)
        if namespace == "":
            outError = wire.RustCsgCat("dynamic tool namespace must not be empty for ", name)
            return false
        if namespace != originalNamespace:
            outError = wire.RustCsgCat4("dynamic tool namespace has leading/trailing whitespace for ", rustCsgAppServerDynamicToolEscapeIdentifierForError(name), ": ", rustCsgAppServerDynamicToolEscapeIdentifierForError(namespace))
            return false
        if !rustCsgAppServerDynamicToolValidateIdentifier(namespace, "dynamic tool namespace", 64, outError):
            return false
        if namespace == "mcp" || wire.RustCsgStartsWith(namespace, "mcp__"):
            outError = wire.RustCsgCat4("dynamic tool namespace is reserved for ", name, ": ", namespace)
            return false
        if rustCsgAppServerDynamicToolReservedResponsesNamespace(namespace):
            outError = wire.RustCsgCat4("dynamic tool namespace collides with a reserved Responses API namespace for ", name, ": ", namespace)
            return false
    outName = name
    outNamespace = namespace
    outNamespacePresent = namespacePresent
    return true

fn rustCsgAppServerValidateDynamicTools(dynamicToolsJson: str, outError: var str): bool =
    outError = ""
    if dynamicToolsJson == "":
        return true
    let p = wire.RustCsgSkipJsonSpace(dynamicToolsJson, 0)
    if p >= dynamicToolsJson.len:
        return true
    if dynamicToolsJson[p] != '[':
        outError = "dynamicTools must be json array"
        return false
    var pos: int32
    var toolCount: int32
    var seenNamespaces: str[]
    var seenNames: str[]
    while true:
        var toolJson: str
        var readError: str
        let beforePos = pos
        if !rustCsgAppServerReadJsonArrayObject(dynamicToolsJson, pos, toolJson, readError):
            if readError != "":
                outError = readError
                return false
            break
        if pos <= beforePos:
            outError = "dynamicTools parser did not advance"
            return false
        toolCount = toolCount + 1
        if toolCount > 128:
            outError = "dynamicTools must contain at most 128 tools"
            return false
        var namespace: str
        var name: str
        var namespacePresent: bool
        if !rustCsgAppServerDynamicToolNameNamespaceOk(toolJson, name, namespace, namespacePresent, outError):
            return false
        if rustCsgAppServerDynamicToolSeenIndex(seenNamespaces, seenNames, namespace, name) >= 0:
            if namespacePresent:
                outError = wire.RustCsgCat4("duplicate dynamic tool name in namespace ", namespace, ": ", name)
                return false
            outError = wire.RustCsgCat("duplicate dynamic tool name: ", name)
            return false
        add(seenNamespaces, namespace)
        add(seenNames, name)
        if rustCsgAppServerDynamicToolDeferred(toolJson) && !namespacePresent:
            outError = wire.RustCsgCat("deferred dynamic tool must include a namespace: ", name)
            return false
        if !rustCsgAppServerDynamicToolInputSchemaOk(name, toolJson, outError):
            return false
    return true

# ── thread/read ────────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadRead(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    var params = thread_wire.RustCsgThreadReadParamsFromJson(paramsJson)
    var result = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, params, "openai")
    if result.ok:
        return rustCsgAppServerResponse(id, thread_wire.RustCsgThreadReadResponseToJson(result.response))
    if result.blockedReason != "":
        return rustCsgAppServerError(id, -32602, result.blockedReason)
    return rustCsgAppServerError(id, -32603, result.error)

# ── thread/list ────────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadList(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    var params = wire.RustCsgThreadListParamsFromJson(paramsJson)
    var result = thread_list_sqlite.RustCsgThreadListFromSqlite(dbPath, params, "openai")
    if result.ok:
        return rustCsgAppServerResponse(id, wire.RustCsgThreadListResponseToJson(result.response))
    if result.blockedReason != "":
        return rustCsgAppServerError(id, -32602, result.blockedReason)
    return rustCsgAppServerError(id, -32603, result.error)

# ── thread/loaded/list ─────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadLoadedList(id: int32): str =
    return rustCsgAppServerResponse(id, "{\"data\":[],\"nextCursor\":null}")

# ── thread/turns/list ──────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadTurnsList(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    var params = thread_wire.RustCsgThreadTurnsListParamsFromJson(paramsJson)
    var readParams: types.RustCsgThreadReadParams
    readParams.threadId = params.threadId
    readParams.includeTurns = true
    var readResult = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
    if !readResult.ok:
        if readResult.blockedReason != "":
            return rustCsgAppServerError(id, -32602, readResult.blockedReason)
        return rustCsgAppServerError(id, -32603, readResult.error)

    var listResult = thread_turns_list.RustCsgThreadTurnsListFromTurnsJson(readResult.response.thread.turnsJson, params)
    if listResult.ok:
        return rustCsgAppServerResponse(id, thread_wire.RustCsgThreadTurnsListResponseToJson(listResult.response))
    if listResult.blockedReason != "":
        return rustCsgAppServerError(id, -32602, listResult.blockedReason)
    return rustCsgAppServerError(id, -32603, listResult.error)

# ── thread/delete ─────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadDelete(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError == "" && codexHome != "":
        let rolloutDir = home.RustCsgPathJoinChild(codexHome, "rollout")
        let rolloutFile = wire.RustCsgCat(threadId, ".jsonl")
        let rolloutPath = home.RustCsgPathJoinChild(rolloutDir, rolloutFile)
        rustCsgAppServerFileDelete(rolloutPath)
    return rustCsgAppServerResponse(id, "{\"deleted\":false,\"reason\":\"thread deletion partially implemented: rollout files can be removed but SQLite records persist\"}")

# ── thread/summary ─────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadSummary(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "")

    var readParams: types.RustCsgThreadReadParams
    readParams.threadId = threadId
    readParams.includeTurns = false
    let result = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
    if !result.ok:
        if result.blockedReason != "":
            return rustCsgAppServerError(id, -32602, result.blockedReason)
        return rustCsgAppServerError(id, -32603, result.error)

    let thread = result.response.thread

    var messageCount: int32
    readParams.includeTurns = true
    let turnsResult = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
    if turnsResult.ok:
        let turnsJson = turnsResult.response.thread.turnsJson
        if turnsJson != "" && turnsJson != "[]":
            messageCount = rustCsgAppServerCountJsonArrayItems(turnsJson)

    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", thread.id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("title", thread.name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("createdAt", thread.createdAt))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("updatedAt", thread.updatedAt))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("modelProvider", thread.modelProvider))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("messageCount", messageCount))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── thread/status ────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadStatus(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "")

    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "idle"))
    out = wire.RustCsgCat(out, ",\"activeTurnId\":null")
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("agentRunning", false))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── thread/resume ─────────────────────────────────────────────────────────

fn RustCsgAppServerHandleThreadStart(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        return rustCsgAppServerError(id, -32603, homeError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let params = wire.RustCsgThreadStartParamsFromJson(paramsJson)
    if params.sandboxJson != "" && params.permissionsJson != "":
        return rustCsgAppServerError(id, -32600, "`permissions` cannot be combined with `sandbox`")
    var permissionsError: str
    let permissionProfileId = rustCsgAppServerPermissionProfileIdFromJson(params.permissionsJson, permissionsError)
    if permissionsError != "":
        return rustCsgAppServerError(id, -32600, permissionsError)
    var dynamicToolsError: str
    if !rustCsgAppServerValidateDynamicTools(params.dynamicToolsJson, dynamicToolsError):
        return rustCsgAppServerError(id, -32600, dynamicToolsError)

    let threadId = rustCsgUuidV4()
    if threadId == "":
        return rustCsgAppServerError(id, -32603, "failed to generate thread id")
    let nowMs = rustCsgGetCurrentTimeMs()
    var model = params.model
    if model == "":
        model = "gpt-5"
    var modelProvider = params.modelProvider
    if modelProvider == "":
        modelProvider = "openai"
    var cwd = params.cwd
    if cwd == "":
        cwd = rustCsgAppServerDefaultCwd()
    var approvalPolicyJson = params.approvalPolicyJson
    if approvalPolicyJson == "":
        approvalPolicyJson = "\"never\""
    var approvalsReviewer = params.approvalsReviewer
    if approvalsReviewer == "":
        approvalsReviewer = "user"
    var sandboxJson = params.sandboxJson
    var activePermissionProfileJson = "null"
    if permissionProfileId != "":
        activePermissionProfileJson = rustCsgAppServerActivePermissionProfileJson(permissionProfileId)
        sandboxJson = rustCsgAppServerSandboxJsonForPermissionProfileId(permissionProfileId)
        if sandboxJson == "":
            return rustCsgAppServerError(id, -32600, wire.RustCsgCat("unsupported permissions profile: ", permissionProfileId))
    elif sandboxJson == "":
        sandboxJson = "{\"type\":\"dangerFullAccess\"}"
    let rolloutPath = rustCsgAppServerRolloutPath(codexHome, threadId)
    let insert = state_db_sqlite.RustCsgStateDbInsertThread(dbPath,
                                                            threadId,
                                                            rolloutPath,
                                                            nowMs,
                                                            "vscode",
                                                            modelProvider,
                                                            cwd,
                                                            "1.0.0",
                                                            "",
                                                            "danger-full-access",
                                                            approvalsReviewer,
                                                            "")
    if !insert.ok:
        return rustCsgAppServerError(id, -32603, insert.error)

    var thread: types.RustCsgAppThread
    thread.id = threadId
    thread.sessionId = threadId
    thread.preview = ""
    thread.ephemeral = rustCsgAppServerBoolFromOptionalRaw(params.ephemeralJson)
    thread.modelProvider = modelProvider
    thread.createdAt = nowMs / int64(1000)
    thread.updatedAt = nowMs / int64(1000)
    thread.statusJson = "{\"type\":\"idle\"}"
    thread.path = rolloutPath
    thread.cwd = cwd
    thread.cliVersion = "1.0.0"
    thread.source = "vscode"
    thread.threadSource = params.threadSource
    thread.name = ""
    thread.turnsJson = "[]"

    var response: types.RustCsgThreadLifecycleResponse
    response.thread = thread
    response.model = model
    response.modelProvider = modelProvider
    response.serviceTier = rustCsgAppServerServiceTierFromParamsJson(paramsJson)
    response.cwd = cwd
    response.runtimeWorkspaceRoots = []
    if params.runtimeWorkspaceRootsJson != "":
        response.runtimeWorkspaceRoots = wire.RustCsgJsonStringArrayFromRaw(params.runtimeWorkspaceRootsJson)
    response.instructionSources = []
    response.approvalPolicyJson = approvalPolicyJson
    response.approvalsReviewer = approvalsReviewer
    response.sandboxJson = sandboxJson
    response.activePermissionProfileJson = activePermissionProfileJson
    response.reasoningEffort = rustCsgAppServerConfigOverrideStr(params.configJson, "model_reasoning_effort")
    return rustCsgAppServerResponse(id, wire.RustCsgThreadStartResponseToJson(response))

fn RustCsgAppServerHandleThreadFork(id: int32, body: str): str =
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        return rustCsgAppServerError(id, -32000, homeError)
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "threadId")
    if threadIdRaw == "" || threadIdRaw == "null":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    if threadIdRaw[0] != '"':
        return rustCsgAppServerError(id, -32602, "threadId must be string")
    let params = wire.RustCsgThreadForkParamsFromJson(paramsJson)
    if params.threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId must not be empty")
    if params.sandboxJson != "" && params.permissionsJson != "":
        return rustCsgAppServerError(id, -32600, "`permissions` cannot be combined with `sandbox`")
    var permissionsError: str
    let permissionProfileId = rustCsgAppServerPermissionProfileIdFromJson(params.permissionsJson, permissionsError)
    if permissionsError != "":
        return rustCsgAppServerError(id, -32600, permissionsError)

    var sourceRow = state_db_sqlite.RustCsgStateDbThreadByIdIncludingArchived(dbPath, params.threadId)
    if params.path != "":
        sourceRow = state_db_sqlite.RustCsgStateDbThreadByRolloutPathIncludingArchived(dbPath, params.path)
        if !sourceRow.ok && sourceRow.notFound:
            var pathOnlyError: str
            sourceRow = rustCsgAppServerThreadRowFromPathOnlyRollout(params.path, params.threadId, pathOnlyError)
            if pathOnlyError != "":
                return rustCsgAppServerError(id, -32600, pathOnlyError)
    if !sourceRow.ok:
        if sourceRow.notFound:
            if params.path != "":
                return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found at path ", params.path))
            return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found for thread id ", params.threadId))
        return rustCsgAppServerError(id, -32603, sourceRow.error)

    if home.RustCsgPathMetadataKind(sourceRow.rolloutPath) != 2:
        return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found for thread id ", sourceRow.id))
    let sourceText = home.RustCsgReadFile(sourceRow.rolloutPath)
    if sourceText == "":
        return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found for thread id ", sourceRow.id))

    let threadId = rustCsgUuidV4()
    if threadId == "":
        return rustCsgAppServerError(id, -32603, "failed to generate thread id")
    let nowMs = rustCsgGetCurrentTimeMs()
    let now = thread_list_sqlite.RustCsgMillisToRfc3339(nowMs)
    var model = params.model
    if model == "":
        model = "gpt-5"
    var modelProvider = params.modelProvider
    if modelProvider == "":
        modelProvider = sourceRow.modelProvider
    if modelProvider == "":
        modelProvider = "openai"
    var cwd = params.cwd
    if cwd == "":
        cwd = sourceRow.cwd
    if cwd == "":
        cwd = rustCsgAppServerDefaultCwd()
    var approvalPolicyJson = params.approvalPolicyJson
    if approvalPolicyJson == "":
        approvalPolicyJson = "\"never\""
    var approvalsReviewer = params.approvalsReviewer
    if approvalsReviewer == "":
        approvalsReviewer = "user"
    var sandboxJson = params.sandboxJson
    var activePermissionProfileJson = "null"
    if permissionProfileId != "":
        activePermissionProfileJson = rustCsgAppServerActivePermissionProfileJson(permissionProfileId)
        sandboxJson = rustCsgAppServerSandboxJsonForPermissionProfileId(permissionProfileId)
        if sandboxJson == "":
            return rustCsgAppServerError(id, -32600, wire.RustCsgCat("unsupported permissions profile: ", permissionProfileId))
    elif sandboxJson == "":
        sandboxJson = "{\"type\":\"dangerFullAccess\"}"
    var cliVersion = sourceRow.cliVersion
    if cliVersion == "":
        cliVersion = "1.0.0"

    var turnsJson = "[]"
    if !params.excludeTurns:
        var historyError: str
        turnsJson = reader.RustCsgRolloutTurnsJsonFromFile(sourceRow.rolloutPath, historyError)
        if historyError != "":
            return rustCsgAppServerError(id, -32600, wire.RustCsgCat3("failed to load thread ", sourceRow.id, wire.RustCsgCat(": ", historyError)))

    var rolloutPath: str
    if !params.ephemeral:
        let sessionsDir = home.RustCsgPathJoinChild(codexHome, "sessions")
        let sessionsKind = home.RustCsgPathMetadataKind(sessionsDir)
        if sessionsKind == 0:
            let mkdirOk = rustCsgAppServerMkdir(sessionsDir)
            if mkdirOk == 0:
                return rustCsgAppServerError(id, -32603, "failed to create sessions directory")
        elif sessionsKind != 1:
            return rustCsgAppServerError(id, -32603, "sessions path is not a directory")
        rolloutPath = rustCsgAppServerRolloutPath(codexHome, threadId)
        let forkHistory = rustCsgAppServerStripSessionMetaLines(sourceText)
        var baseInstructionsPresent: bool
        let baseInstructions = rustCsgAppServerForkSessionMetaBaseInstructions(paramsJson, sourceRow.rolloutPath, baseInstructionsPresent)
        let metaLine = rustCsgAppServerForkSessionMetaLine(threadId,
                                                          sourceRow.id,
                                                          now,
                                                          cwd,
                                                          "vscode",
                                                          params.threadSource,
                                                          modelProvider,
                                                          cliVersion,
                                                          baseInstructions,
                                                          baseInstructionsPresent)
        let writeOk = rustCsgAppServerWriteFile(rolloutPath, wire.RustCsgCat(metaLine, forkHistory))
        if writeOk == 0:
            return rustCsgAppServerError(id, -32603, "failed to write fork rollout")
        let insert = state_db_sqlite.RustCsgStateDbInsertThread(dbPath,
                                                                threadId,
                                                                rolloutPath,
                                                                nowMs,
                                                                "vscode",
                                                                modelProvider,
                                                                cwd,
                                                                cliVersion,
                                                                "",
                                                                "danger-full-access",
                                                                approvalsReviewer,
                                                                sourceRow.firstUserMessage)
        if !insert.ok:
            return rustCsgAppServerError(id, -32603, insert.error)

    var thread: types.RustCsgAppThread
    thread.id = threadId
    thread.sessionId = threadId
    thread.forkedFromId = sourceRow.id
    thread.preview = sourceRow.firstUserMessage
    thread.ephemeral = params.ephemeral
    thread.modelProvider = modelProvider
    thread.createdAt = nowMs / int64(1000)
    thread.updatedAt = nowMs / int64(1000)
    thread.statusJson = "{\"type\":\"idle\"}"
    thread.path = rolloutPath
    thread.cwd = cwd
    thread.cliVersion = cliVersion
    thread.source = "vscode"
    thread.threadSource = params.threadSource
    thread.name = ""
    thread.turnsJson = turnsJson

    var response: types.RustCsgThreadLifecycleResponse
    response.thread = thread
    response.model = model
    response.modelProvider = modelProvider
    response.serviceTier = rustCsgAppServerServiceTierFromParamsJson(paramsJson)
    response.cwd = cwd
    response.runtimeWorkspaceRoots = []
    if params.runtimeWorkspaceRootsJson != "":
        response.runtimeWorkspaceRoots = wire.RustCsgJsonStringArrayFromRaw(params.runtimeWorkspaceRootsJson)
    response.instructionSources = []
    response.approvalPolicyJson = approvalPolicyJson
    response.approvalsReviewer = approvalsReviewer
    response.sandboxJson = sandboxJson
    response.activePermissionProfileJson = activePermissionProfileJson
    response.reasoningEffort = rustCsgAppServerConfigOverrideStr(params.configJson, "model_reasoning_effort")
    return rustCsgAppServerResponse(id, wire.RustCsgThreadForkResponseToJson(response))

fn RustCsgAppServerHandleTurnStart(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "threadId")
    if threadIdRaw == "" || threadIdRaw == "null":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    if threadIdRaw[0] != '"':
        return rustCsgAppServerError(id, -32602, "threadId must be string")
    var params = wire.RustCsgTurnStartParamsFromJson(paramsJson)
    if params.threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId must not be empty")
    if params.inputJson == "":
        return rustCsgAppServerError(id, -32602, "input is required")
    if params.sandboxPolicyJson != "" && params.permissionsJson != "":
        return rustCsgAppServerError(id, -32600, "`permissions` cannot be combined with `sandboxPolicy`")
    var turn: types.RustCsgAppTurn
    turn.id = rustCsgUuidV4()
    turn.itemsJson = "[]"
    turn.itemsView = "notLoaded"
    turn.status = "inProgress"
    turn.errorJson = "null"
    turn.startedAtJson = "null"
    turn.completedAtJson = "null"
    turn.durationMsJson = "null"
    var response: types.RustCsgTurnStartResponse
    response.turn = turn
    return rustCsgAppServerResponse(id, wire.RustCsgTurnStartResponseToJson(response))

fn RustCsgAppServerHandleTurnSteer(id: int32, body: str, activeTurnId: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "threadId")
    if threadIdRaw == "" || threadIdRaw == "null":
        return rustCsgAppServerError(id, -32600, "threadId is required")
    if threadIdRaw[0] != '"':
        return rustCsgAppServerError(id, -32600, "threadId must be string")
    let expectedTurnIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "expectedTurnId")
    if expectedTurnIdRaw == "" || expectedTurnIdRaw == "null":
        return rustCsgAppServerError(id, -32600, "expectedTurnId must not be empty")
    if expectedTurnIdRaw[0] != '"':
        return rustCsgAppServerError(id, -32600, "expectedTurnId must be string")
    var params = wire.RustCsgTurnSteerParamsFromJson(paramsJson)
    if params.threadId == "":
        return rustCsgAppServerError(id, -32600, "threadId must not be empty")
    if params.expectedTurnId == "":
        return rustCsgAppServerError(id, -32600, "expectedTurnId must not be empty")
    if params.inputJson == "":
        return rustCsgAppServerError(id, -32600, "input is required")
    if params.inputJson == "[]":
        return rustCsgAppServerError(id, -32600, "input must not be empty")
    if activeTurnId == "":
        return rustCsgAppServerError(id, -32600, "no active turn to steer")
    if params.expectedTurnId != activeTurnId:
        let messageHead = wire.RustCsgCat3("expected active turn id `", params.expectedTurnId, "` but found `")
        let message = wire.RustCsgCat3(messageHead, activeTurnId, "`")
        return rustCsgAppServerError(id, -32600, message)
    var response: types.RustCsgTurnSteerResponse
    response.turnId = activeTurnId
    return rustCsgAppServerResponse(id, wire.RustCsgTurnSteerResponseToJson(response))

fn RustCsgAppServerHandleThreadResume(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let params = wire.RustCsgThreadResumeParamsFromJson(paramsJson)
    if params.threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    if params.sandboxJson != "" && params.permissionsJson != "":
        return rustCsgAppServerError(id, -32600, "`permissions` cannot be combined with `sandbox`")
    var permissionsError: str
    let permissionProfileId = rustCsgAppServerPermissionProfileIdFromJson(params.permissionsJson, permissionsError)
    if permissionsError != "":
        return rustCsgAppServerError(id, -32600, permissionsError)
    if params.historyJson != "":
        if rustCsgAppServerCountJsonArrayItems(params.historyJson) == 0:
            return rustCsgAppServerError(id, -32600, "history must not be empty")
        var codexHome: str
        var homeError: str
        home.RustCsgFindCodexHomeInto(codexHome, homeError)
        if homeError != "":
            return rustCsgAppServerError(id, -32603, homeError)
        let threadId = rustCsgUuidV4()
        if threadId == "":
            return rustCsgAppServerError(id, -32603, "failed to generate thread id")
        let nowMs = rustCsgGetCurrentTimeMs()
        var model = params.model
        if model == "":
            model = "gpt-5"
        var modelProvider = params.modelProvider
        if modelProvider == "":
            modelProvider = "openai"
        var cwd = params.cwd
        if cwd == "":
            cwd = rustCsgAppServerDefaultCwd()
        let sessionsDir = home.RustCsgPathJoinChild(codexHome, "sessions")
        let sessionsKind = home.RustCsgPathMetadataKind(sessionsDir)
        if sessionsKind == 0:
            let mkdirOk = rustCsgAppServerMkdir(sessionsDir)
            if mkdirOk == 0:
                return rustCsgAppServerError(id, -32603, "failed to create sessions directory")
        elif sessionsKind != 1:
            return rustCsgAppServerError(id, -32603, "sessions path is not a directory")
        let rolloutPath = rustCsgAppServerRolloutPath(codexHome, threadId)
        let insert = state_db_sqlite.RustCsgStateDbInsertThread(dbPath,
                                                                threadId,
                                                                rolloutPath,
                                                                nowMs,
                                                                "vscode",
                                                                modelProvider,
                                                                cwd,
                                                                "1.0.0",
                                                                "",
                                                                "danger-full-access",
                                                                "user",
                                                                "")
        if !insert.ok:
            return rustCsgAppServerError(id, -32603, insert.error)
        var thread: types.RustCsgAppThread
        thread.id = threadId
        thread.sessionId = threadId
        thread.preview = ""
        thread.ephemeral = false
        thread.modelProvider = modelProvider
        thread.createdAt = nowMs / int64(1000)
        thread.updatedAt = nowMs / int64(1000)
        thread.statusJson = "{\"type\":\"idle\"}"
        thread.path = rolloutPath
        thread.cwd = cwd
        thread.cliVersion = "1.0.0"
        thread.source = "vscode"
        thread.threadSource = ""
        thread.name = ""
        thread.turnsJson = "[]"
        var responseFromHistory: types.RustCsgThreadLifecycleResponse
        responseFromHistory.thread = thread
        responseFromHistory.model = model
        responseFromHistory.modelProvider = modelProvider
        responseFromHistory.serviceTier = rustCsgAppServerServiceTierFromParamsJson(paramsJson)
        responseFromHistory.cwd = cwd
        responseFromHistory.runtimeWorkspaceRoots = []
        if params.runtimeWorkspaceRootsJson != "":
            responseFromHistory.runtimeWorkspaceRoots = wire.RustCsgJsonStringArrayFromRaw(params.runtimeWorkspaceRootsJson)
        responseFromHistory.instructionSources = []
        responseFromHistory.approvalPolicyJson = params.approvalPolicyJson
        if responseFromHistory.approvalPolicyJson == "":
            responseFromHistory.approvalPolicyJson = "\"never\""
        responseFromHistory.approvalsReviewer = params.approvalsReviewer
        if responseFromHistory.approvalsReviewer == "":
            responseFromHistory.approvalsReviewer = "user"
        responseFromHistory.sandboxJson = params.sandboxJson
        responseFromHistory.activePermissionProfileJson = "null"
        if permissionProfileId != "":
            responseFromHistory.activePermissionProfileJson = rustCsgAppServerActivePermissionProfileJson(permissionProfileId)
            responseFromHistory.sandboxJson = rustCsgAppServerSandboxJsonForPermissionProfileId(permissionProfileId)
            if responseFromHistory.sandboxJson == "":
                return rustCsgAppServerError(id, -32600, wire.RustCsgCat("unsupported permissions profile: ", permissionProfileId))
        elif responseFromHistory.sandboxJson == "":
            responseFromHistory.sandboxJson = "{\"type\":\"dangerFullAccess\"}"
        responseFromHistory.reasoningEffort = rustCsgAppServerConfigOverrideStr(params.configJson, "model_reasoning_effort")
        return rustCsgAppServerResponse(id, wire.RustCsgThreadResumeResponseToJson(responseFromHistory))

    var responseThread: types.RustCsgAppThread
    if params.path != "":
        var sourceRow = state_db_sqlite.RustCsgStateDbThreadByRolloutPathIncludingArchived(dbPath, params.path)
        if !sourceRow.ok && sourceRow.notFound:
            var pathOnlyError: str
            sourceRow = rustCsgAppServerThreadRowFromPathOnlyRollout(params.path, params.threadId, pathOnlyError)
            if pathOnlyError != "":
                return rustCsgAppServerError(id, -32600, pathOnlyError)
        if !sourceRow.ok:
            if sourceRow.notFound:
                return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found at path ", params.path))
            return rustCsgAppServerError(id, -32603, sourceRow.error)
        responseThread = thread_row.RustCsgThreadRowToAppThread(sourceRow)
        if responseThread.modelProvider == "":
            responseThread.modelProvider = "openai"
        if !params.excludeTurns:
            var historyError: str
            responseThread.turnsJson = reader.RustCsgRolloutTurnsJsonFromFile(sourceRow.rolloutPath, historyError)
            if historyError == "rollout history file is missing or empty":
                return rustCsgAppServerError(id, -32602, wire.RustCsgCat3("thread ",
                                                                          sourceRow.id,
                                                                          " is not materialized yet; includeTurns is unavailable before first user message"))
            if historyError != "":
                return rustCsgAppServerError(id, -32602, historyError)
    else:
        var readParams: types.RustCsgThreadReadParams
        readParams.threadId = params.threadId
        readParams.includeTurns = !params.excludeTurns
        var readResult = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
        if !readResult.ok:
            if readResult.blockedReason != "":
                return rustCsgAppServerError(id, -32602, readResult.blockedReason)
            return rustCsgAppServerError(id, -32603, readResult.error)
        responseThread = readResult.response.thread

    var response: types.RustCsgThreadLifecycleResponse
    response.thread = responseThread
    response.thread.statusJson = "{\"type\":\"idle\"}"
    response.model = params.model
    if response.model == "":
        response.model = "gpt-5"
    response.modelProvider = params.modelProvider
    if response.modelProvider == "":
        response.modelProvider = response.thread.modelProvider
    if response.modelProvider == "":
        response.modelProvider = "openai"
    response.serviceTier = wire.RustCsgJsonFindOptionalStr(paramsJson, "serviceTier")
    response.cwd = params.cwd
    if response.cwd == "":
        response.cwd = response.thread.cwd
    response.runtimeWorkspaceRoots = []
    if params.runtimeWorkspaceRootsJson != "":
        response.runtimeWorkspaceRoots = wire.RustCsgJsonStringArrayFromRaw(params.runtimeWorkspaceRootsJson)
    response.instructionSources = []
    response.approvalPolicyJson = params.approvalPolicyJson
    if response.approvalPolicyJson == "":
        response.approvalPolicyJson = "\"never\""
    response.approvalsReviewer = params.approvalsReviewer
    if response.approvalsReviewer == "":
        response.approvalsReviewer = "user"
    response.sandboxJson = params.sandboxJson
    response.activePermissionProfileJson = "null"
    if permissionProfileId != "":
        response.activePermissionProfileJson = rustCsgAppServerActivePermissionProfileJson(permissionProfileId)
        response.sandboxJson = rustCsgAppServerSandboxJsonForPermissionProfileId(permissionProfileId)
        if response.sandboxJson == "":
            return rustCsgAppServerError(id, -32600, wire.RustCsgCat("unsupported permissions profile: ", permissionProfileId))
    elif response.sandboxJson == "":
        response.sandboxJson = "{\"type\":\"dangerFullAccess\"}"
    response.reasoningEffort = rustCsgAppServerConfigOverrideStr(params.configJson, "model_reasoning_effort")
    return rustCsgAppServerResponse(id, wire.RustCsgThreadResumeResponseToJson(response))

# ── thread/export ───────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadExport(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    var readParams: types.RustCsgThreadReadParams
    readParams.threadId = threadId
    readParams.includeTurns = true
    let result = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
    if !result.ok:
        if result.blockedReason != "":
            return rustCsgAppServerError(id, -32602, result.blockedReason)
        return rustCsgAppServerError(id, -32603, result.error)
    let nowMs = rustCsgGetCurrentTimeMs()
    let exportedAt = thread_list_sqlite.RustCsgMillisToRfc3339(nowMs)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("exportedAt", exportedAt))
    out = wire.RustCsgCat(out, ",\"version\":\"1.0\"")
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("thread", wire.RustCsgAppThreadToJson(result.response.thread)))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── thread/name/set ─────────────────────────────────────────────────────────

fn RustCsgAppServerHandleThreadNameSet(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    let nameRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "name")
    if nameRaw == "":
        return rustCsgAppServerError(id, -32602, "name is required")
    let name = RustCsgAppServerNormalizeThreadName(wire.RustCsgJsonFindStr(paramsJson, "name"))
    if name == "":
        return rustCsgAppServerError(id, -32600, "thread name must not be empty")
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let result = state_db_sqlite.RustCsgStateDbUpdateThreadTitle(dbPath, threadId, name, rustCsgGetCurrentTimeMs())
    if result.ok:
        return rustCsgAppServerResponse(id, "{}")
    if result.notFound:
        return rustCsgAppServerError(id, -32600, wire.RustCsgCat("thread not found: ", threadId))
    return rustCsgAppServerError(id, -32603, result.error)

# ── thread/archive ──────────────────────────────────────────────────────────

fn RustCsgAppServerHandleThreadArchive(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let result = state_db_sqlite.RustCsgStateDbArchiveThread(dbPath, threadId, rustCsgGetCurrentTimeMs())
    if result.ok:
        return rustCsgAppServerResponse(id, "{}")
    if result.notFound:
        return rustCsgAppServerError(id, -32600, wire.RustCsgCat("no rollout found for thread id ", threadId))
    return rustCsgAppServerError(id, -32603, result.error)

# ── thread/import ───────────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadImport(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadData = wire.RustCsgJsonFindObject(paramsJson, "data")
    if threadData == "":
        return rustCsgAppServerError(id, -32602, "data is required")
    return rustCsgAppServerResponse(id, "{\"imported\":false,\"reason\":\"thread import requires SQLite write support (not yet available)\"}")

# ── thread/rename ────────────────────────────────────────────

fn rustCsgAppServerHandleThreadRename(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    let title = wire.RustCsgJsonFindStr(paramsJson, "title")
    if title == "":
        return rustCsgAppServerError(id, -32602, "title is required")
    return rustCsgAppServerResponse(id, "{\"renamed\":false,\"reason\":\"thread rename requires SQLite write support (not yet available)\"}")

# ── thread/history ─────────────────────────────────────────────────────

fn rustCsgAppServerHandleThreadHistory(id: int32, body: str): str =
    var pathError: str
    let dbPath = rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerError(id, -32602, "threadId is required")
    var readParams: types.RustCsgThreadReadParams
    readParams.threadId = threadId
    readParams.includeTurns = false
    let result = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
    if !result.ok:
        if result.blockedReason != "":
            return rustCsgAppServerError(id, -32602, result.blockedReason)
        return rustCsgAppServerError(id, -32603, result.error)
    let nowMs = rustCsgGetCurrentTimeMs()
    let exportedAt = thread_list_sqlite.RustCsgMillisToRfc3339(nowMs)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("exportedAt", exportedAt))
    out = wire.RustCsgCat(out, ",\"version\":\"1.0\"")
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("thread", wire.RustCsgAppThreadToJson(result.response.thread)))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)
