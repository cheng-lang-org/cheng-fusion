import std/strings
import cheng/codex/config/home
import cheng/codex/protocol/wire

const ChengAgentTraceMagic: str = "CHENG_AGENT_TRACE"
const ChengAgentTraceVersion: int32 = 1
const ChengAgentTraceDefaultCompression: str = "none"

@abi_internal
@importc("RustCsgWriteFile")
fn ChengTrainingTraceWriteFile(path: str, content: str): int32

type ChengTrainingTrace =
    traceId: str
    instruction: str
    evidenceJson: str
    diffSummary: str
    checksJson: str
    outcome: str
    validationCommand: str
    validationStatus: str
    trainable: bool
    timestampMs: int64

type ChengEvalCase =
    evalId: str
    traceId: str
    instruction: str
    evidenceJson: str
    replayCommand: str
    expectedOutcome: str
    validationCommand: str
    cwd: str
    toolchainSnapshotJson: str
    sourceRevision: str
    manifestRefsJson: str
    validationStatus: str
    validationResult: str
    replayFixtureRefsJson: str
    timestampMs: int64

type ChengAgentTraceVerifyResult =
    ok: bool
    error: str
    manifestPath: str
    rootCid: str
    rawShardPath: str
    primaryPath: str
    compression: str
    payloadBytes: int32
    payload: str

type ChengTrainingTraceFileCacheEntry =
    path: str
    content: str

var ChengTrainingTraceEntries: ChengTrainingTrace[]
var ChengTrainingTraceJsonCache: str
var ChengEvalCaseEntries: ChengEvalCase[]
var ChengEvalCaseJsonCache: str
var ChengTrainingTraceFileCacheEntries: ChengTrainingTraceFileCacheEntry[]

fn ChengTrainingTraceReset() =
    ChengTrainingTraceEntries = []
    ChengTrainingTraceJsonCache = ""
    ChengEvalCaseEntries = []
    ChengEvalCaseJsonCache = ""
    ChengTrainingTraceFileCacheEntries = []

fn ChengTrainingTraceRedact(text: str): str =
    if text == "":
        return ""
    if strings.StrContains(text, "sk-") ||
       strings.StrContains(text, "api_key") ||
       strings.StrContains(text, "API_KEY") ||
       strings.StrContains(text, "token=") ||
       strings.StrContains(text, "Authorization:"):
        return "[REDACTED_SECRET]"
    if strings.StrContains(text, "/root/") ||
       strings.StrContains(text, "/Users/") ||
       strings.StrContains(text, "\\Users\\"):
        return "[REDACTED_PATH]"
    return text

fn ChengTrainingTraceOutputDirAllowed(path: str): bool =
    return path == "/tmp" ||
           path == "/var/tmp" ||
           strings.HasPrefix(path, "/tmp/") ||
           strings.HasPrefix(path, "/var/tmp/")

fn ChengTrainingTracePathJoin(dir: str, file: str): str =
    if dir == "":
        return file
    if dir[dir.len - 1] == '/':
        return wire.RustCsgCat(dir, file)
    return wire.RustCsgCat3(dir, "/", file)

fn ChengTrainingTracePayloadCid(payload: str): str =
    return wire.RustCsgCat("sha256:", strings.Sha256(payload))

fn ChengTrainingTraceCidFileStem(cid: str): str =
    if strings.HasPrefix(cid, "sha256:"):
        return wire.RustCsgSliceBytes(cid, 7, cid.len - 7)
    return cid

fn ChengTrainingTraceShardFileName(kind: str, cid: str): str =
    return wire.RustCsgCat4(ChengTrainingTraceCidFileStem(cid), ".", kind, ".cagt")

fn ChengTrainingTraceManifestFileName(kind: str, cid: str): str =
    return wire.RustCsgCat4(ChengTrainingTraceCidFileStem(cid), ".", kind, ".manifest.json")

fn ChengTrainingTraceShardPath(outDir: str, kind: str, cid: str): str =
    return ChengTrainingTracePathJoin(outDir, ChengTrainingTraceShardFileName(kind, cid))

fn ChengTrainingTraceManifestPath(outDir: str, kind: str, cid: str): str =
    return ChengTrainingTracePathJoin(outDir, ChengTrainingTraceManifestFileName(kind, cid))

fn ChengTrainingTraceShardBytes(payload: str, cid: str): str =
    var out = wire.RustCsgCat(ChengAgentTraceMagic, "\n")
    out = wire.RustCsgCat(out, wire.RustCsgCat("version=", strings.IntToStr(ChengAgentTraceVersion)))
    out = wire.RustCsgCat(out, "\nencoding=utf8-json-payload\n")
    out = wire.RustCsgCat(out, "compression=none\n")
    out = wire.RustCsgCat(out, wire.RustCsgCat("payloadSha256=", cid))
    out = wire.RustCsgCat(out, "\n")
    out = wire.RustCsgCat(out, wire.RustCsgCat("payloadBytes=", strings.IntToStr(payload.len)))
    out = wire.RustCsgCat(out, "\n\n")
    out = wire.RustCsgCat(out, payload)
    return out

fn ChengTrainingTraceManifestJson(kind: str,
                                  cid: str,
                                  shardPath: str,
                                  compressedPath: str,
                                  compression: str,
                                  payload: str): str =
    var primaryPath = shardPath
    if compressedPath != "":
        primaryPath = compressedPath
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("schema", "cheng.agent_trace.manifest.v1"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("format", ChengAgentTraceMagic))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("version", ChengAgentTraceVersion))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rootCid", cid))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("compression", compression))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("primaryPath", primaryPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rawShardPath", shardPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("compressedPath", compressedPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("uncompressedBytes", payload.len))
    out = wire.RustCsgCat(out, ",")
    var shards = "[{\"cid\":"
    shards = wire.RustCsgCat(shards, wire.RustCsgJsonQuote(cid))
    shards = wire.RustCsgCat(shards, ",\"path\":")
    shards = wire.RustCsgCat(shards, wire.RustCsgJsonQuote(primaryPath))
    shards = wire.RustCsgCat(shards, "}]")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("shards", shards))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengTrainingTraceWriteProductionShard(outDir: str, kind: str, payload: str): str =
    assert(ChengTrainingTraceOutputDirAllowed(outDir), "agent trace output dir must be under /tmp or /var/tmp")
    let cid = ChengTrainingTracePayloadCid(payload)
    let shardPath = ChengTrainingTraceShardPath(outDir, kind, cid)
    let bytes = ChengTrainingTraceShardBytes(payload, cid)
    assert(ChengTrainingTraceWriteFile(shardPath, bytes) != 0, "failed to write agent trace shard")
    ChengTrainingTraceCacheFile(shardPath, bytes)
    return shardPath

fn ChengTrainingTraceWriteProductionManifest(outDir: str,
                                             kind: str,
                                             payload: str,
                                             compression: str,
                                             compressedPath: str): str =
    assert(ChengTrainingTraceOutputDirAllowed(outDir), "agent trace output dir must be under /tmp or /var/tmp")
    let cid = ChengTrainingTracePayloadCid(payload)
    let shardPath = ChengTrainingTraceShardPath(outDir, kind, cid)
    let manifestPath = ChengTrainingTraceManifestPath(outDir, kind, cid)
    let manifest = ChengTrainingTraceManifestJson(kind, cid, shardPath, compressedPath, compression, payload)
    assert(ChengTrainingTraceWriteFile(manifestPath, manifest) != 0, "failed to write agent trace manifest")
    ChengTrainingTraceCacheFile(manifestPath, manifest)
    return manifest

fn ChengTrainingTraceWriteDebugJsonl(outDir: str, kind: str, payload: str): str =
    assert(ChengTrainingTraceOutputDirAllowed(outDir), "agent trace output dir must be under /tmp or /var/tmp")
    let cid = ChengTrainingTracePayloadCid(payload)
    let path = ChengTrainingTracePathJoin(outDir, wire.RustCsgCat4(ChengTrainingTraceCidFileStem(cid), ".", kind, ".jsonl"))
    let bytes = wire.RustCsgCat(payload, "\n")
    assert(ChengTrainingTraceWriteFile(path, bytes) != 0, "failed to write debug jsonl export")
    ChengTrainingTraceCacheFile(path, bytes)
    return path

fn ChengTrainingTraceShardPayload(raw: str): str =
    var i: int32
    while i + 1 < raw.len:
        if raw[i] == '\n' && raw[i + 1] == '\n':
            return wire.RustCsgSliceBytes(raw, i + 2, raw.len - i - 2)
        i = i + 1
    return ""

fn ChengAgentTraceVerifyResultJson(result: ChengAgentTraceVerifyResult): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ok", result.ok))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", result.error))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("manifestPath", result.manifestPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rootCid", result.rootCid))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rawShardPath", result.rawShardPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("primaryPath", result.primaryPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("compression", result.compression))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("payloadBytes", result.payloadBytes))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengAgentTraceVerifyError(manifestPath: str, message: str): ChengAgentTraceVerifyResult =
    var out: ChengAgentTraceVerifyResult
    out.ok = false
    out.error = message
    out.manifestPath = manifestPath
    return out

fn ChengAgentTraceVerifyErrorInto(out: var ChengAgentTraceVerifyResult,
                                   manifestPath: str,
                                   message: str) =
    out.ok = false
    out.error = message
    out.manifestPath = manifestPath
    out.rootCid = ""
    out.rawShardPath = ""
    out.primaryPath = ""
    out.compression = ""
    out.payloadBytes = 0
    out.payload = ""

fn ChengTrainingTraceCacheFile(path: str, content: str) =
    let entry = ChengTrainingTraceFileCacheEntry(path: path, content: content)
    add(ChengTrainingTraceFileCacheEntries, entry)

fn ChengTrainingTraceReadFile(path: str): str =
    var i = ChengTrainingTraceFileCacheEntries.len
    while i > 0:
        i = i - 1
        if ChengTrainingTraceFileCacheEntries[i].path == path:
            return ChengTrainingTraceFileCacheEntries[i].content
    return ""

fn ChengTrainingTraceLastSlash(path: str): int32 =
    var i = path.len
    while i > 0:
        i = i - 1
        if path[i] == '/':
            return i
    return -1

fn ChengTrainingTraceFirstDotAfter(path: str, start: int32): int32 =
    var i = start
    while i < path.len:
        if path[i] == '.':
            return i
        i = i + 1
    return -1

fn ChengTrainingTraceManifestDir(path: str): str =
    let slash = ChengTrainingTraceLastSlash(path)
    if slash <= 0:
        return ""
    return strings.SliceBytes(path, 0, slash)

fn ChengTrainingTraceManifestStem(path: str): str =
    if !strings.HasSuffix(path, ".manifest.json"):
        return ""
    let slash = ChengTrainingTraceLastSlash(path)
    let start = slash + 1
    let dot = ChengTrainingTraceFirstDotAfter(path, start)
    if dot <= start:
        return ""
    return strings.SliceBytes(path, start, dot - start)

fn ChengTrainingTraceManifestKind(path: str): str =
    let suffix = ".manifest.json"
    if !strings.HasSuffix(path, suffix):
        return ""
    let slash = ChengTrainingTraceLastSlash(path)
    let start = slash + 1
    let dot = ChengTrainingTraceFirstDotAfter(path, start)
    if dot <= start:
        return ""
    let kindStart = dot + 1
    let kindEnd = path.len - suffix.len
    if kindEnd <= kindStart:
        return ""
    return strings.SliceBytes(path, kindStart, kindEnd - kindStart)

fn ChengTrainingTraceManifestCid(path: str): str =
    let stem = ChengTrainingTraceManifestStem(path)
    if stem == "":
        return ""
    return wire.RustCsgCat("sha256:", stem)

fn ChengTrainingTraceManifestRawShardPath(path: str): str =
    let dir = ChengTrainingTraceManifestDir(path)
    let stem = ChengTrainingTraceManifestStem(path)
    let kind = ChengTrainingTraceManifestKind(path)
    if dir == "" || stem == "" || kind == "":
        return ""
    return ChengTrainingTracePathJoin(dir, wire.RustCsgCat4(stem, ".", kind, ".cagt"))

fn ChengAgentTracePayloadForManifest(manifestPath: str): str =
    let rawShardPath = ChengTrainingTraceManifestRawShardPath(manifestPath)
    if rawShardPath == "":
        return ""
    let raw = ChengTrainingTraceReadFile(rawShardPath)
    if raw == "":
        return ""
    return ChengTrainingTraceShardPayload(raw)

fn ChengAgentTraceManifestPayloadContains(manifestPath: str, needle: str): bool =
    let payload = ChengAgentTracePayloadForManifest(manifestPath)
    if payload == "":
        return false
    return strings.StrContains(payload, needle)

fn ChengAgentTraceVerifyManifestInto(manifestPath: str,
                                      out: var ChengAgentTraceVerifyResult): bool =
    let manifest = ChengTrainingTraceReadFile(manifestPath)
    if manifest == "":
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "manifest not readable")
        return false
    if !strings.HasPrefix(manifest, "{\"schema\":\"cheng.agent_trace.manifest.v1\""):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "bad manifest schema")
        return false
    if !strings.StrContains(manifest, "\"format\":\"CHENG_AGENT_TRACE\""):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "bad trace format")
        return false
    if !strings.StrContains(manifest, "\"version\":1"):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "bad trace version")
        return false
    let cid = ChengTrainingTraceManifestCid(manifestPath)
    let rawShardPath = ChengTrainingTraceManifestRawShardPath(manifestPath)
    var primaryPath = rawShardPath
    var compression = ""
    if strings.StrContains(manifest, "\"compression\":\"none\""):
        compression = "none"
    elif strings.StrContains(manifest, "\"compression\":\"brotli\""):
        compression = "brotli"
        primaryPath = wire.RustCsgCat(rawShardPath, ".br")
    else:
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "bad trace compression")
        return false
    if cid == "" || rawShardPath == "":
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "manifest missing rootCid or rawShardPath")
        return false
    if !strings.StrContains(manifest, wire.RustCsgJsonFieldStr("rootCid", cid)):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "manifest rootCid mismatch")
        return false
    if !strings.StrContains(manifest, wire.RustCsgJsonFieldStr("rawShardPath", rawShardPath)):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "manifest raw shard path mismatch")
        return false
    if !strings.StrContains(manifest, wire.RustCsgJsonFieldStr("primaryPath", primaryPath)):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "manifest primary path mismatch")
        return false
    if home.RustCsgPathMetadataKind(rawShardPath) == 0:
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "raw shard missing")
        return false
    if primaryPath != "" && home.RustCsgPathMetadataKind(primaryPath) == 0:
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "primary shard missing")
        return false
    let raw = ChengTrainingTraceReadFile(rawShardPath)
    if !strings.HasPrefix(raw, wire.RustCsgCat(ChengAgentTraceMagic, "\n")):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "bad shard magic")
        return false
    if !strings.StrContains(raw, wire.RustCsgCat("payloadSha256=", cid)):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "shard cid mismatch")
        return false
    let payload = ChengTrainingTraceShardPayload(raw)
    if payload == "":
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "shard payload missing")
        return false
    if ChengTrainingTracePayloadCid(payload) != cid:
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "payload hash mismatch")
        return false
    if !strings.StrContains(manifest, wire.RustCsgCat("\"uncompressedBytes\":", strings.IntToStr(payload.len))):
        ChengAgentTraceVerifyErrorInto(out, manifestPath, "payload byte count mismatch")
        return false
    out.ok = true
    out.error = ""
    out.manifestPath = manifestPath
    out.rootCid = cid
    out.rawShardPath = rawShardPath
    out.primaryPath = primaryPath
    out.compression = compression
    out.payloadBytes = payload.len
    out.payload = ""
    return true

fn ChengAgentTraceVerifyManifest(manifestPath: str): ChengAgentTraceVerifyResult =
    var out: ChengAgentTraceVerifyResult
    let _ = ChengAgentTraceVerifyManifestInto(manifestPath, out)
    return out

fn ChengAgentTraceExportJsonl(manifestPath: str, outPath: str): str =
    var result: ChengAgentTraceVerifyResult
    let _ = ChengAgentTraceVerifyManifestInto(manifestPath, result)
    if !result.ok:
        return ChengAgentTraceVerifyResultJson(result)
    assert(ChengTrainingTraceOutputDirAllowed(outPath), "agent trace export path must be under /tmp or /var/tmp")
    let payload = ChengAgentTracePayloadForManifest(manifestPath)
    assert(payload != "", "agent trace payload missing after verification")
    assert(ChengTrainingTraceWriteFile(outPath, wire.RustCsgCat(payload, "\n")) != 0, "failed to write agent trace JSONL export")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ok", true))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("out", outPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rootCid", result.rootCid))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("payloadBytes", payload.len))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengTrainingTraceEvidenceJson(raw: str): str =
    if raw == "":
        return "[]"
    return raw

fn ChengTrainingTraceIsTrainable(outcome: str, validationStatus: str): bool =
    return outcome == "success" &&
           (validationStatus == "compiled" ||
            validationStatus == "tested" ||
            validationStatus == "verified" ||
            validationStatus == "passed")

fn ChengTrainingTraceToJson(entry: ChengTrainingTrace): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("schema", "cheng.training_trace.v1"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("traceId", entry.traceId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("instruction", entry.instruction))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("evidence", ChengTrainingTraceEvidenceJson(entry.evidenceJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("diffSummary", entry.diffSummary))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("checks", ChengTrainingTraceEvidenceJson(entry.checksJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", entry.outcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationCommand", entry.validationCommand))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationStatus", entry.validationStatus))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("trainable", entry.trainable))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("timestampMs", entry.timestampMs))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengTrainingTraceRecord(traceId: str,
                            instruction: str,
                            evidenceJson: str,
                            diffSummary: str,
                            checksJson: str,
                            outcome: str,
                            validationCommand: str,
                            validationStatus: str,
                            timestampMs: int64): str =
    let cleanInstruction = ChengTrainingTraceRedact(instruction)
    let cleanDiff = ChengTrainingTraceRedact(diffSummary)
    let cleanCommand = ChengTrainingTraceRedact(validationCommand)
    let trainable = ChengTrainingTraceIsTrainable(outcome, validationStatus)
    let entry = ChengTrainingTrace(traceId: traceId,
                                   instruction: cleanInstruction,
                                   evidenceJson: evidenceJson,
                                   diffSummary: cleanDiff,
                                   checksJson: checksJson,
                                   outcome: outcome,
                                   validationCommand: cleanCommand,
                                   validationStatus: validationStatus,
                                   trainable: trainable,
                                   timestampMs: timestampMs)
    let json = ChengTrainingTraceToJson(entry)
    add(ChengTrainingTraceEntries, entry)
    if ChengTrainingTraceJsonCache == "":
        ChengTrainingTraceJsonCache = json
    else:
        ChengTrainingTraceJsonCache = wire.RustCsgCat3(ChengTrainingTraceJsonCache, ",", json)
    return json

fn ChengTrainingTraceJson(): str =
    if ChengTrainingTraceJsonCache == "":
        return "[]"
    return wire.RustCsgCat3("[", ChengTrainingTraceJsonCache, "]")

fn ChengEvalCaseToJson(entry: ChengEvalCase): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("schema", "cheng.eval_case.v1"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("evalId", entry.evalId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("traceId", entry.traceId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("instruction", entry.instruction))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("evidence", ChengTrainingTraceEvidenceJson(entry.evidenceJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("replayCommand", entry.replayCommand))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("expectedOutcome", entry.expectedOutcome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationCommand", entry.validationCommand))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", entry.cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("toolchainSnapshot", ChengTrainingTraceEvidenceJson(entry.toolchainSnapshotJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sourceRevision", entry.sourceRevision))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("manifestRefs", ChengTrainingTraceEvidenceJson(entry.manifestRefsJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationStatus", entry.validationStatus))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationResult", entry.validationResult))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("replayFixtureRefs", ChengTrainingTraceEvidenceJson(entry.replayFixtureRefsJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("timestampMs", entry.timestampMs))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengEvalCaseRecord(evalId: str,
                       traceId: str,
                       instruction: str,
                       evidenceJson: str,
                       replayCommand: str,
                       expectedOutcome: str,
                       validationCommand: str,
                       timestampMs: int64): str =
    return ChengEvalCaseRecordWithMetadata(evalId,
                                           traceId,
                                           instruction,
                                           evidenceJson,
                                           replayCommand,
                                           expectedOutcome,
                                           validationCommand,
                                           "",
                                           "[]",
                                           "",
                                           "[]",
                                           "",
                                           "",
                                           "[]",
                                           timestampMs)

fn ChengEvalCaseRecordWithMetadata(evalId: str,
                                   traceId: str,
                                   instruction: str,
                                   evidenceJson: str,
                                   replayCommand: str,
                                   expectedOutcome: str,
                                   validationCommand: str,
                                   cwd: str,
                                   toolchainSnapshotJson: str,
                                   sourceRevision: str,
                                   manifestRefsJson: str,
                                   validationStatus: str,
                                   validationResult: str,
                                   replayFixtureRefsJson: str,
                                   timestampMs: int64): str =
    let entry = ChengEvalCase(evalId: evalId,
                              traceId: traceId,
                              instruction: ChengTrainingTraceRedact(instruction),
                              evidenceJson: evidenceJson,
                              replayCommand: ChengTrainingTraceRedact(replayCommand),
                              expectedOutcome: expectedOutcome,
                              validationCommand: ChengTrainingTraceRedact(validationCommand),
                              cwd: ChengTrainingTraceRedact(cwd),
                              toolchainSnapshotJson: toolchainSnapshotJson,
                              sourceRevision: sourceRevision,
                              manifestRefsJson: manifestRefsJson,
                              validationStatus: validationStatus,
                              validationResult: validationResult,
                              replayFixtureRefsJson: replayFixtureRefsJson,
                              timestampMs: timestampMs)
    let json = ChengEvalCaseToJson(entry)
    add(ChengEvalCaseEntries, entry)
    if ChengEvalCaseJsonCache == "":
        ChengEvalCaseJsonCache = json
    else:
        ChengEvalCaseJsonCache = wire.RustCsgCat3(ChengEvalCaseJsonCache, ",", json)
    return json

fn ChengEvalCaseJson(): str =
    if ChengEvalCaseJsonCache == "":
        return "[]"
    return wire.RustCsgCat3("[", ChengEvalCaseJsonCache, "]")
