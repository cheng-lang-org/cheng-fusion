import std/strings
import cheng/codex/app_server/transport_tcp as tcp
import cheng/codex/auth/login
import cheng/codex/auth/oauth
import cheng/codex/auth/pkce
import cheng/codex/config/home
import cheng/codex/protocol/wire
import cheng/codex/std/http

@abi_internal
@importc("cheng_auth_random_bytes")
fn authRandomBytes(count: int32): str

@abi_internal
@importc("cheng_auth_base64url_encode")
fn authBase64urlEncode(data: str): str

@abi_internal
@importc("RustCsgRandomBytes")
fn rustCsgDashboardOAuthHostRandomBytes(count: int32): str

@abi_internal
@importc("RustCsgBase64UrlEncode")
fn rustCsgDashboardOAuthHostBase64UrlEncode(data: str): str

@abi_internal
@importc("RustCsgPkceChallenge")
fn rustCsgDashboardOAuthHostPkceChallenge(verifier: str): str

const RustCsgDashboardOAuthClientId: str = "app_EMoamEEZ73f0CkXaXp7hrann"
const RustCsgDashboardOAuthScope: str = "openid profile email offline_access api.connectors.read api.connectors.invoke"

type
    RustCsgDashboardOAuthServer =
        listenFd: int32 = -1
        actualPort: int32
        issuer: str
        redirectUri: str
        authUrl: str
        state: str
        codeVerifier: str

fn rustCsgDashboardOAuthNormalizeBase(issuer: str): str =
    if issuer.len > 0 && issuer[issuer.len - 1] == '/':
        return strings.SliceBytes(issuer, 0, issuer.len - 1)
    return issuer

fn RustCsgDashboardOAuthOriginator(): str =
    let overrideValue = home.RustCsgGetEnv("CODEX_INTERNAL_ORIGINATOR_OVERRIDE")
    if overrideValue != "":
        return overrideValue
    return "codex_cli_rs"

fn rustCsgDashboardOAuthPercentEncode(value: str): str =
    var out: str
    let hex = "0123456789ABCDEF"
    var i: int32
    while i < value.len:
        let ch = value[i]
        let cv = int32(ch)
        let unreserved = (ch >= 'A' && ch <= 'Z') ||
                         (ch >= 'a' && ch <= 'z') ||
                         (ch >= '0' && ch <= '9') ||
                         ch == '-' || ch == '.' || ch == '_' || ch == '~'
        if unreserved:
            out = wire.RustCsgCat(out, strings.SliceBytes(value, i, 1))
        else:
            out = wire.RustCsgCat(out, "%")
            out = wire.RustCsgCat(out, strings.SliceBytes(hex, cv / 16, 1))
            out = wire.RustCsgCat(out, strings.SliceBytes(hex, cv % 16, 1))
        i = i + 1
    return out

fn rustCsgDashboardOAuthAppendQuery(url: str, key: str, value: str): str =
    var out = url
    if wire.RustCsgContains(out, "?"):
        out = wire.RustCsgCat(out, "&")
    else:
        out = wire.RustCsgCat(out, "?")
    out = wire.RustCsgCat(out, key)
    out = wire.RustCsgCat(out, "=")
    return wire.RustCsgCat(out, rustCsgDashboardOAuthPercentEncode(value))

fn RustCsgDashboardOAuthBuildAuthorizeUrl(issuer: str, redirectUri: str, codeChallenge: str, state: str, workspaceId: str): str =
    var out = wire.RustCsgCat(rustCsgDashboardOAuthNormalizeBase(issuer), "/oauth/authorize")
    out = rustCsgDashboardOAuthAppendQuery(out, "response_type", "code")
    out = rustCsgDashboardOAuthAppendQuery(out, "client_id", RustCsgDashboardOAuthClientId)
    out = rustCsgDashboardOAuthAppendQuery(out, "redirect_uri", redirectUri)
    out = rustCsgDashboardOAuthAppendQuery(out, "scope", RustCsgDashboardOAuthScope)
    out = rustCsgDashboardOAuthAppendQuery(out, "code_challenge", codeChallenge)
    out = rustCsgDashboardOAuthAppendQuery(out, "code_challenge_method", "S256")
    out = rustCsgDashboardOAuthAppendQuery(out, "id_token_add_organizations", "true")
    out = rustCsgDashboardOAuthAppendQuery(out, "codex_cli_simplified_flow", "true")
    out = rustCsgDashboardOAuthAppendQuery(out, "state", state)
    out = rustCsgDashboardOAuthAppendQuery(out, "originator", RustCsgDashboardOAuthOriginator())
    if workspaceId != "":
        out = rustCsgDashboardOAuthAppendQuery(out, "allowed_workspace_id", workspaceId)
    return out

fn rustCsgDashboardOAuthHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return -1

fn RustCsgDashboardOAuthUrlDecode(value: str): str =
    var out: str
    let valueLen = strings.Len(value)
    var i: int32
    while i < valueLen:
        let ch = value[i]
        if ch == '+':
            out = wire.RustCsgCat(out, " ")
            i = i + 1
        elif ch == '%' && i + 2 < valueLen:
            let hi = rustCsgDashboardOAuthHexValue(value[i + 1])
            let lo = rustCsgDashboardOAuthHexValue(value[i + 2])
            if hi >= 0 && lo >= 0:
                out = wire.RustCsgCat(out, strings.CharToStr(Char(hi * 16 + lo)))
                i = i + 3
            else:
                out = wire.RustCsgCat(out, strings.SliceBytes(value, i, 1))
                i = i + 1
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(value, i, 1))
            i = i + 1
    return out

fn rustCsgDashboardOAuthAsciiLower(text: str): str =
    var out: str
    var i: int32
    while i < text.len:
        let ch = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = wire.RustCsgCat(out, strings.CharToStr(char(int32(ch) + 32)))
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(text, i, 1))
        i = i + 1
    return out

fn rustCsgDashboardOAuthFindSub(text: str, needle: str, start: int32): int32 =
    let textLen = strings.Len(text)
    let needleLen = strings.Len(needle)
    if needleLen <= 0 || start < 0:
        return -1
    var i = start
    while i + needleLen <= textLen:
        var matched = true
        var j: int32
        while j < needleLen:
            if text[i + j] != needle[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return i
        i = i + 1
    return -1

fn rustCsgDashboardOAuthSliceAscii(text: str, start: int32, count: int32): str =
    if count <= 0:
        return ""
    return strings.SliceBytes(text, start, count)

fn rustCsgDashboardOAuthAsciiEquals(left: str, right: str): bool =
    let leftLen = strings.Len(left)
    let rightLen = strings.Len(right)
    if leftLen != rightLen:
        return false
    var i: int32
    while i < leftLen:
        if left[i] != right[i]:
            return false
        i = i + 1
    return true

fn rustCsgDashboardOAuthRequestPathQuery(request: str, path: str, outFound: var bool): str =
    outFound = false
    var lineEnd = rustCsgDashboardOAuthFindSub(request, "\r\n", 0)
    if lineEnd < 0:
        lineEnd = strings.Len(request)
    let queryMarker = wire.RustCsgCat(path, "?")
    var markerAt = rustCsgDashboardOAuthFindSub(request, queryMarker, 0)
    if markerAt >= 0 && markerAt < lineEnd:
        outFound = true
        let queryStart = markerAt + strings.Len(queryMarker)
        let queryEnd = rustCsgDashboardOAuthFindSub(request, " HTTP/", queryStart)
        if queryEnd >= queryStart && queryEnd <= lineEnd:
            return rustCsgDashboardOAuthSliceAscii(request, queryStart, queryEnd - queryStart)
        return ""
    let pathMarker = wire.RustCsgCat(path, " ")
    markerAt = rustCsgDashboardOAuthFindSub(request, pathMarker, 0)
    if markerAt >= 0 && markerAt < lineEnd:
        outFound = true
    return ""

fn rustCsgDashboardOAuthRequestHasPath(request: str, path: str): bool =
    var found: bool
    let query = rustCsgDashboardOAuthRequestPathQuery(request, path, found)
    if query != "":
        return found
    return found

fn rustCsgDashboardOAuthMinPositive(current: int32, candidate: int32): int32 =
    if candidate < 0:
        return current
    if current < 0 || candidate < current:
        return candidate
    return current

fn rustCsgDashboardOAuthValueAfterMarker(source: str, marker: str): str =
    let markerAt = rustCsgDashboardOAuthFindSub(source, marker, 0)
    if markerAt < 0:
        return ""
    let valueStart = markerAt + strings.Len(marker)
    var valueEnd: int32 = -1
    valueEnd = rustCsgDashboardOAuthMinPositive(valueEnd, rustCsgDashboardOAuthFindSub(source, "&", valueStart))
    valueEnd = rustCsgDashboardOAuthMinPositive(valueEnd, rustCsgDashboardOAuthFindSub(source, " HTTP/", valueStart))
    valueEnd = rustCsgDashboardOAuthMinPositive(valueEnd, rustCsgDashboardOAuthFindSub(source, "\r", valueStart))
    valueEnd = rustCsgDashboardOAuthMinPositive(valueEnd, rustCsgDashboardOAuthFindSub(source, "\n", valueStart))
    if valueEnd < 0:
        valueEnd = strings.Len(source)
    return RustCsgDashboardOAuthUrlDecode(rustCsgDashboardOAuthSliceAscii(source, valueStart, valueEnd - valueStart))

fn rustCsgDashboardOAuthPad2(value: int64): str =
    let raw = strings.Int64ToStr(value)
    if value < int64(10):
        return wire.RustCsgCat("0", raw)
    return raw

fn rustCsgDashboardOAuthPad4(value: int64): str =
    let raw = strings.Int64ToStr(value)
    if value < int64(10):
        return wire.RustCsgCat("000", raw)
    if value < int64(100):
        return wire.RustCsgCat("00", raw)
    if value < int64(1000):
        return wire.RustCsgCat("0", raw)
    return raw

fn rustCsgDashboardOAuthUnixSecondsToRfc3339(seconds: int64): str =
    var days: int64 = seconds / int64(86400)
    var secondsOfDay: int64 = seconds % int64(86400)
    if secondsOfDay < int64(0):
        secondsOfDay = secondsOfDay + int64(86400)
        days = days - int64(1)
    var z: int64 = days + int64(719468)
    var era: int64
    if z >= int64(0):
        era = z / int64(146097)
    else:
        era = (z - int64(146096)) / int64(146097)
    let doe: int64 = z - era * int64(146097)
    let yoe: int64 = (doe - doe / int64(1460) + doe / int64(36524) - doe / int64(146096)) / int64(365)
    var year: int64 = yoe + era * int64(400)
    let doy: int64 = doe - (int64(365) * yoe + yoe / int64(4) - yoe / int64(100))
    let mp: int64 = (int64(5) * doy + int64(2)) / int64(153)
    let day: int64 = doy - (int64(153) * mp + int64(2)) / int64(5) + int64(1)
    var month: int64
    if mp < int64(10):
        month = mp + int64(3)
    else:
        month = mp - int64(9)
    if month <= int64(2):
        year = year + int64(1)
    let hour: int64 = secondsOfDay / int64(3600)
    let minute: int64 = (secondsOfDay % int64(3600)) / int64(60)
    let second: int64 = secondsOfDay % int64(60)
    var out: str = rustCsgDashboardOAuthPad4(year)
    out = wire.RustCsgCat(out, "-")
    out = wire.RustCsgCat(out, rustCsgDashboardOAuthPad2(month))
    out = wire.RustCsgCat(out, "-")
    out = wire.RustCsgCat(out, rustCsgDashboardOAuthPad2(day))
    out = wire.RustCsgCat(out, "T")
    out = wire.RustCsgCat(out, rustCsgDashboardOAuthPad2(hour))
    out = wire.RustCsgCat(out, ":")
    out = wire.RustCsgCat(out, rustCsgDashboardOAuthPad2(minute))
    out = wire.RustCsgCat(out, ":")
    out = wire.RustCsgCat(out, rustCsgDashboardOAuthPad2(second))
    return wire.RustCsgCat(out, "Z")

fn rustCsgDashboardOAuthWriteResponse(fd: int32, status: int32, reason: str, extraHeaders: str, body: str): bool =
    var response = "HTTP/1.1 "
    response = wire.RustCsgCat(response, strings.IntToStr(status))
    response = wire.RustCsgCat(response, " ")
    response = wire.RustCsgCat(response, reason)
    response = wire.RustCsgCat(response, "\r\nContent-Length: ")
    response = wire.RustCsgCat(response, strings.IntToStr(body.len))
    response = wire.RustCsgCat(response, "\r\nConnection: close\r\n")
    if extraHeaders != "":
        response = wire.RustCsgCat(response, extraHeaders)
    response = wire.RustCsgCat(response, "\r\n")
    response = wire.RustCsgCat(response, body)
    return tcp.RustCsgSocketWrite(fd, response) >= 0

fn rustCsgDashboardOAuthExchangeCode(issuer: str, redirectUri: str, codeVerifier: str, authCode: str, outAuth: var login.AuthDotJson, outError: var str): bool =
    outAuth = login.NewAuthDotJson()
    outError = ""
    if authCode == "":
        outError = "missing authorization code"
        return false
    let tokenEndpoint = wire.RustCsgCat(rustCsgDashboardOAuthNormalizeBase(issuer), "/oauth/token")
    let headers = "[\"Content-Type: application/x-www-form-urlencoded\"]"
    var body = "grant_type=authorization_code"
    body = wire.RustCsgCat(body, "&code=")
    body = wire.RustCsgCat(body, rustCsgDashboardOAuthPercentEncode(authCode))
    body = wire.RustCsgCat(body, "&redirect_uri=")
    body = wire.RustCsgCat(body, rustCsgDashboardOAuthPercentEncode(redirectUri))
    body = wire.RustCsgCat(body, "&client_id=")
    body = wire.RustCsgCat(body, rustCsgDashboardOAuthPercentEncode(RustCsgDashboardOAuthClientId))
    body = wire.RustCsgCat(body, "&code_verifier=")
    body = wire.RustCsgCat(body, rustCsgDashboardOAuthPercentEncode(codeVerifier))
    let resp = http.HttpPost(tokenEndpoint, body, headers)
    if !resp.ok:
        outError = wire.RustCsgCat("OAuth token exchange transport error: ", resp.error)
        return false
    if resp.statusCode != 200:
        outError = wire.RustCsgCat("OAuth token exchange failed with status ", strings.IntToStr(resp.statusCode))
        return false
    outAuth.rawIdToken = login.jsonGetStr(resp.body, "id_token")
    outAuth.accessToken = login.jsonGetStr(resp.body, "access_token")
    outAuth.refreshToken = login.jsonGetStr(resp.body, "refresh_token")
    outAuth.accountId = login.jsonGetStr(resp.body, "account_id")
    if outAuth.accountId == "":
        outAuth.accountId = login.jsonGetStr(resp.body, "chatgpt_account_id")
    if outAuth.rawIdToken == "":
        outError = "OAuth token exchange response is missing id_token"
        return false
    if outAuth.accessToken == "":
        outError = "OAuth token exchange response is missing access_token"
        return false
    if outAuth.refreshToken == "":
        outError = "OAuth token exchange response is missing refresh_token"
        return false
    return true

fn RustCsgDashboardOAuthStartServer(issuer: str, port: int32, forceState: str, workspaceId: str, outServer: var RustCsgDashboardOAuthServer, outError: var str): bool =
    outServer = RustCsgDashboardOAuthServer()
    outError = ""
    let base = rustCsgDashboardOAuthNormalizeBase(issuer)
    if base == "":
        outError = "OAuth issuer is empty"
        return false
    let fd = tcp.RustCsgTcpListen("127.0.0.1", port)
    if fd < 0:
        outError = "failed to listen for OAuth callback"
        return false
    let actualPort = tcp.RustCsgTcpLocalPort(fd)
    if actualPort <= 0:
        tcp.RustCsgSocketClose(fd)
        outError = "failed to determine OAuth callback port"
        return false
    let codes = pkce.GeneratePkce()
    var state = forceState
    if state == "":
        state = authBase64urlEncode(authRandomBytes(32))
    let redirectUri = wire.RustCsgCat(wire.RustCsgCat("http://localhost:", strings.IntToStr(actualPort)), "/auth/callback")
    outServer.listenFd = fd
    outServer.actualPort = actualPort
    outServer.issuer = base
    outServer.redirectUri = redirectUri
    outServer.state = state
    outServer.codeVerifier = codes.codeVerifier
    outServer.authUrl = RustCsgDashboardOAuthBuildAuthorizeUrl(base, redirectUri, codes.codeChallenge, state, workspaceId)
    return true

fn RustCsgDashboardOAuthStartServerHostPkce(issuer: str, port: int32, forceState: str, workspaceId: str, outServer: var RustCsgDashboardOAuthServer, outError: var str): bool =
    outServer = RustCsgDashboardOAuthServer()
    outError = ""
    let base = rustCsgDashboardOAuthNormalizeBase(issuer)
    if base == "":
        outError = "OAuth issuer is empty"
        return false
    let fd = tcp.RustCsgTcpListen("127.0.0.1", port)
    if fd < 0:
        outError = "failed to listen for OAuth callback"
        return false
    let actualPort = tcp.RustCsgTcpLocalPort(fd)
    if actualPort <= 0:
        tcp.RustCsgSocketClose(fd)
        outError = "failed to determine OAuth callback port"
        return false
    var state = forceState
    if state == "":
        state = rustCsgDashboardOAuthHostBase64UrlEncode(rustCsgDashboardOAuthHostRandomBytes(32))
    let codeVerifier = rustCsgDashboardOAuthHostBase64UrlEncode(rustCsgDashboardOAuthHostRandomBytes(64))
    let codeChallenge = rustCsgDashboardOAuthHostPkceChallenge(codeVerifier)
    if state == "" || codeVerifier == "" || codeChallenge == "":
        tcp.RustCsgSocketClose(fd)
        outError = "failed to generate OAuth PKCE state"
        return false
    let redirectUri = wire.RustCsgCat(wire.RustCsgCat("http://localhost:", strings.IntToStr(actualPort)), "/auth/callback")
    outServer.listenFd = fd
    outServer.actualPort = actualPort
    outServer.issuer = base
    outServer.redirectUri = redirectUri
    outServer.state = state
    outServer.codeVerifier = codeVerifier
    outServer.authUrl = RustCsgDashboardOAuthBuildAuthorizeUrl(base, redirectUri, codeChallenge, state, workspaceId)
    return true

fn rustCsgDashboardOAuthPersistCallbackAuth(codexHome: str,
                                            expectedEmail: str,
                                            expectedWorkspaceId: str,
                                            nowSeconds: int64,
                                            server: var RustCsgDashboardOAuthServer,
                                            query: str,
                                            outError: var str): bool =
    let state = rustCsgDashboardOAuthValueAfterMarker(query, "state=")
    if state != server.state:
        outError = "State mismatch"
        return false
    let oauthError = rustCsgDashboardOAuthValueAfterMarker(query, "error=")
    if oauthError != "":
        outError = wire.RustCsgCat("OAuth callback error: ", oauthError)
        return false
    let code = rustCsgDashboardOAuthValueAfterMarker(query, "code=")
    if code == "":
        outError = "Missing authorization code. Sign-in could not be completed."
        return false
    var exchanged: login.AuthDotJson
    if !rustCsgDashboardOAuthExchangeCode(server.issuer, server.redirectUri, server.codeVerifier, code, exchanged, outError):
        return false
    let authEmail = oauth.IdTokenEmail(exchanged.rawIdToken)
    if authEmail != "" && expectedEmail != "" && rustCsgDashboardOAuthAsciiLower(authEmail) != rustCsgDashboardOAuthAsciiLower(expectedEmail):
        outError = wire.RustCsgCat(wire.RustCsgCat("cached auth email mismatch for ", expectedEmail), wire.RustCsgCat(": got ", authEmail))
        return false
    var actualWorkspaceId = oauth.IdTokenAccountId(exchanged.rawIdToken)
    if actualWorkspaceId == "":
        actualWorkspaceId = exchanged.accountId
    if expectedWorkspaceId != "":
        if actualWorkspaceId == "":
            outError = "Login is restricted to a specific workspace, but the token did not include an chatgpt_account_id claim."
            return false
        if actualWorkspaceId != expectedWorkspaceId:
            outError = wire.RustCsgCat(wire.RustCsgCat("Login is restricted to workspace id ", expectedWorkspaceId), ".")
            return false
    var result = login.NewAuthDotJson()
    result.authMode = "Chatgpt"
    result.rawIdToken = exchanged.rawIdToken
    result.accessToken = exchanged.accessToken
    result.refreshToken = exchanged.refreshToken
    result.accountId = actualWorkspaceId
    result.lastRefresh = rustCsgDashboardOAuthUnixSecondsToRfc3339(nowSeconds)
    if !login.SaveAuth(codexHome, result):
        outError = "Sign-in completed but credentials could not be saved locally."
        return false
    return true

fn rustCsgDashboardOAuthServeOne(clientFd: int32,
                                 codexHome: str,
                                 expectedEmail: str,
                                 expectedWorkspaceId: str,
                                 nowSeconds: int64,
                                 server: var RustCsgDashboardOAuthServer,
                                 outDone: var bool,
                                 outSuccess: var bool,
                                 outError: var str): bool =
    outDone = false
    outSuccess = false
    outError = ""
    let request = tcp.RustCsgHttpReadRequest(clientFd)
    if request == "":
        outError = "empty OAuth callback request"
        return false
    if rustCsgDashboardOAuthRequestHasPath(request, "/auth/callback"):
        var persistError: str
        if !rustCsgDashboardOAuthPersistCallbackAuth(codexHome, expectedEmail, expectedWorkspaceId, nowSeconds, server, request, persistError):
            outDone = true
            outError = persistError
            rustCsgDashboardOAuthWriteResponse(clientFd, 400, "Bad Request", "Content-Type: text/plain; charset=utf-8\r\n", persistError)
            return false
        let location = wire.RustCsgCat(wire.RustCsgCat("Location: http://localhost:", strings.IntToStr(server.actualPort)), "/success\r\n")
        rustCsgDashboardOAuthWriteResponse(clientFd, 302, "Found", location, "")
        return true
    if rustCsgDashboardOAuthRequestHasPath(request, "/success"):
        outDone = true
        outSuccess = true
        rustCsgDashboardOAuthWriteResponse(clientFd, 200, "OK", "Content-Type: text/html; charset=utf-8\r\n", "<html><body>Login successful</body></html>")
        return true
    if rustCsgDashboardOAuthRequestHasPath(request, "/cancel"):
        outDone = true
        outError = "Login cancelled"
        rustCsgDashboardOAuthWriteResponse(clientFd, 200, "OK", "Content-Type: text/plain; charset=utf-8\r\n", "Login cancelled")
        return false
    rustCsgDashboardOAuthWriteResponse(clientFd, 404, "Not Found", "Content-Type: text/plain; charset=utf-8\r\n", "Not Found")
    return true

fn RustCsgDashboardOAuthRunUntilDone(codexHome: str,
                                     expectedEmail: str,
                                     expectedWorkspaceId: str,
                                     nowSeconds: int64,
                                     server: var RustCsgDashboardOAuthServer,
                                     outError: var str): bool =
    outError = ""
    var handled: int32
    while handled < 4:
        let clientFd = tcp.RustCsgTcpAccept(server.listenFd)
        if clientFd < 0:
            outError = "failed to accept OAuth callback request"
            tcp.RustCsgSocketClose(server.listenFd)
            server.listenFd = -1
            return false
        var done: bool
        var success: bool
        var requestError: str
        let requestOk = rustCsgDashboardOAuthServeOne(clientFd, codexHome, expectedEmail, expectedWorkspaceId, nowSeconds, server, done, success, requestError)
        tcp.RustCsgSocketClose(clientFd)
        if done:
            tcp.RustCsgSocketClose(server.listenFd)
            server.listenFd = -1
            if success:
                return true
            outError = requestError
            return false
        if !requestOk && requestError != "":
            outError = requestError
            tcp.RustCsgSocketClose(server.listenFd)
            server.listenFd = -1
            return false
        handled = handled + 1
    tcp.RustCsgSocketClose(server.listenFd)
    server.listenFd = -1
    outError = "OAuth callback did not complete"
    return false
