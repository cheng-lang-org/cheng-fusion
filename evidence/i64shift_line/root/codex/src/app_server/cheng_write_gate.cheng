import std/strings
import cheng/codex/app_server/cheng_evidence_ledger as ledger

@importc("RustCsgGetCurrentTimeMs")
fn ChengWriteGateNowMs(): int64

type ChengWriteGateDecision =
    allowed: bool
    reason: str

fn ChengWriteGateIsChengSourcePath(path: str): bool =
    if path == "":
        return false
    if strings.HasSuffix(path, ".cheng"):
        return true
    if strings.HasSuffix(path, "/src") || strings.HasSuffix(path, "/src/"):
        return true
    if strings.StrContains(path, "/src/core/") || strings.StrContains(path, "/codex/src/"):
        return true
    return false

fn ChengWriteGateIsTsCsgSourcePath(path: str): bool =
    if strings.StrContains(path, "/ts-csg/src/"):
        return true
    return false

fn ChengWriteGateIsChengRuntimeProviderPath(path: str): bool =
    if strings.StrContains(path, "/src/core/runtime/") ||
       strings.StrContains(path, "/src/runtime/"):
        return true
    return false

fn ChengWriteGateIsDebugOrProfilePath(path: str): bool =
    if strings.StrContains(path, "debug") ||
       strings.StrContains(path, "crash") ||
       strings.StrContains(path, "profile") ||
       strings.StrContains(path, "panic") ||
       strings.StrContains(path, "trace") ||
       strings.StrContains(path, "perf"):
        return true
    return false

fn ChengWriteGateTsCsgNeedsRuntimeClosure(path: str): bool =
    if strings.HasSuffix(path, "/runtime-providers.ts") ||
       strings.HasSuffix(path, "/csg-core.ts") ||
       strings.HasSuffix(path, "/cheng-source.ts") ||
       strings.HasSuffix(path, "/cheng-csg.ts"):
        return true
    return false

fn ChengWriteGateNeedsCsg(action: str, path: str): bool =
    if action == "remove" || action == "copy" || action == "createDirectory":
        return true
    if strings.StrContains(path, "/src/core/") || strings.StrContains(path, "/codex/src/"):
        return true
    return false

fn ChengWriteGateCheckAllowedAt(action: str, path: str, nowMs: int64, outReason: var str): bool =
    outReason = ""
    if ChengWriteGateIsTsCsgSourcePath(path):
        if !ledger.ChengEvidenceHasFreshAnyPath("ts_csg_emit", nowMs):
            outReason = "blocked: missing fresh TS-CSG emit evidence"
            return false
        if ChengWriteGateTsCsgNeedsRuntimeClosure(path) &&
           !ledger.ChengEvidenceHasFreshAnyPath("ts_csg_runtime_closure", nowMs):
            outReason = "blocked: missing fresh TS-CSG runtime closure evidence"
            return false
        outReason = "fresh TS-CSG evidence present"
        return true
    if !ChengWriteGateIsChengSourcePath(path):
        outReason = "non-Cheng path"
        return true
    if ledger.ChengEvidenceHasViolation(path, nowMs):
        outReason = "blocked by Cheng ownership/no-pointer evidence"
        return false
    if !ledger.ChengEvidenceHasFresh("cheng.lsp", path, nowMs):
        outReason = "blocked: missing fresh Cheng LSP evidence for target path"
        return false
    if ChengWriteGateNeedsCsg(action, path):
        outReason = "blocked: canonical CSGC authority receipt unavailable"
        return false
    if ChengWriteGateIsChengRuntimeProviderPath(path) &&
       !ledger.ChengEvidenceHasFreshAnyPath("ts_csg_runtime_closure", nowMs):
        outReason = "blocked: missing fresh TS-CSG runtime closure evidence"
        return false
    if ChengWriteGateIsDebugOrProfilePath(path) &&
       !ledger.ChengEvidenceHasFreshAnyPath("cheng.debugger", nowMs) &&
       !ledger.ChengEvidenceHasFreshAnyPath("cheng.profile", nowMs):
        outReason = "blocked: missing fresh Cheng debugger/profile evidence"
        return false
    outReason = "fresh Cheng evidence present"
    return true

fn ChengWriteGateCheckAllowed(action: str, path: str, outReason: var str): bool =
    return ChengWriteGateCheckAllowedAt(action, path, ChengWriteGateNowMs(), outReason)

fn ChengWriteGateCheckAt(action: str, path: str, nowMs: int64): ChengWriteGateDecision =
    var out: ChengWriteGateDecision
    var reason: str
    out.allowed = ChengWriteGateCheckAllowedAt(action, path, nowMs, reason)
    out.reason = reason
    return out

fn ChengWriteGateCheck(action: str, path: str): ChengWriteGateDecision =
    return ChengWriteGateCheckAt(action, path, ChengWriteGateNowMs())
