# codex app-server: model/completion handlers — moved from main.cheng for compiler stability

import std/strings
import std/system
import cheng/codex/protocol/wire as wire
import cheng/codex/config/home as home
import cheng/codex/model_provider/chat as model_chat

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

@importc("strlen")
fn rustCsgAppServerModelCStringLen(raw: ptr): int64

@importc("calloc")
fn rustCsgAppServerModelCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn rustCsgAppServerModelMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn rustCsgAppServerModelCStringFree(raw: ptr)

@importc("RustCsgModelEmbedding")
fn RustCsgModelEmbeddingAbi(model: cstring, input: cstring, apiKey: cstring, apiUrl: cstring): cstring

@importc("RustCsgModelImageGenerate")
fn RustCsgModelImageGenerateAbi(model: cstring, prompt: cstring, apiKey: cstring, apiUrl: cstring): cstring

fn rustCsgAppServerModelCString(text: str): cstring =
    let raw = rustCsgAppServerModelCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        rustCsgAppServerModelMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn rustCsgAppServerModelFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        rustCsgAppServerModelCStringFree(ptr(raw))

fn rustCsgAppServerModelCStringToOwnedStr(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    let count = int32(rustCsgAppServerModelCStringLen(ptr(raw)))
    if count <= 0:
        rustCsgAppServerModelCStringFree(ptr(raw))
        return ""
    let out = system.StrFromBytesCopy(ptr(raw), count)
    rustCsgAppServerModelCStringFree(ptr(raw))
    return out

fn RustCsgModelEmbedding(model: str, input: str, apiKey: str, apiUrl: str): str =
    let modelRaw = rustCsgAppServerModelCString(model)
    let inputRaw = rustCsgAppServerModelCString(input)
    let apiKeyRaw = rustCsgAppServerModelCString(apiKey)
    let apiUrlRaw = rustCsgAppServerModelCString(apiUrl)
    let raw = RustCsgModelEmbeddingAbi(modelRaw, inputRaw, apiKeyRaw, apiUrlRaw)
    rustCsgAppServerModelFreeCString(modelRaw)
    rustCsgAppServerModelFreeCString(inputRaw)
    rustCsgAppServerModelFreeCString(apiKeyRaw)
    rustCsgAppServerModelFreeCString(apiUrlRaw)
    return rustCsgAppServerModelCStringToOwnedStr(raw)

fn RustCsgModelImageGenerate(model: str, prompt: str, apiKey: str, apiUrl: str): str =
    let modelRaw = rustCsgAppServerModelCString(model)
    let promptRaw = rustCsgAppServerModelCString(prompt)
    let apiKeyRaw = rustCsgAppServerModelCString(apiKey)
    let apiUrlRaw = rustCsgAppServerModelCString(apiUrl)
    let raw = RustCsgModelImageGenerateAbi(modelRaw, promptRaw, apiKeyRaw, apiUrlRaw)
    rustCsgAppServerModelFreeCString(modelRaw)
    rustCsgAppServerModelFreeCString(promptRaw)
    rustCsgAppServerModelFreeCString(apiKeyRaw)
    rustCsgAppServerModelFreeCString(apiUrlRaw)
    return rustCsgAppServerModelCStringToOwnedStr(raw)

# ── Response helpers (duplicated from main.cheng for module self-containment) ──

fn rustCsgAppServerRequestId(body: str): int32 =
    if wire.RustCsgContains(body, "\"id\""):
        return wire.RustCsgJsonFindInt32(body, "id")
    return 0

fn rustCsgAppServerResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgAppServerError(id: int32, code: int32, message: str): str =
    let errorHead = wire.RustCsgCat3("{\"error\":{\"code\":", strings.IntToStr(code), ",\"message\":")
    let errorBody = wire.RustCsgCat3(errorHead, wire.RustCsgJsonQuote(message), "}")
    return wire.RustCsgCat3(errorBody, wire.RustCsgCat3(",\"id\":", strings.IntToStr(id), ""), "}")

# ── Parse config string values ─────────────────────────────────────────────

fn rustCsgAppServerParseConfigStringValue(configContent: str, key: str): str =
    let keyLen: int32 = strings.Len(key)
    if keyLen <= 0:
        return ""
    var i: int32
    while i < configContent.len:
        # Line start check: i == 0 or after newline
        if i > 0:
            let prev = configContent[i - 1]
            if prev != '\n' && prev != '\r':
                i = i + 1
                continue
        # Skip leading whitespace
        var pos: int32 = i
        while pos < configContent.len && (configContent[pos] == ' ' || configContent[pos] == '\t'):
            pos = pos + 1
        # Check for key at this position
        if pos + keyLen <= configContent.len:
            if strings.SliceBytes(configContent, pos, keyLen) == key:
                var p: int32 = pos + keyLen
                while p < configContent.len && (configContent[p] == ' ' || configContent[p] == '\t'):
                    p = p + 1
                if p < configContent.len && configContent[p] == '=':
                    p = p + 1
                    while p < configContent.len && (configContent[p] == ' ' || configContent[p] == '\t'):
                        p = p + 1
                    if p < configContent.len && configContent[p] == '"':
                        var start: int32 = p + 1
                        var end: int32 = start
                        while end < configContent.len && configContent[end] != '"':
                            end = end + 1
                        if end < configContent.len:
                            return strings.SliceBytes(configContent, start, end - start)
        # Skip to next line
        while i < configContent.len && configContent[i] != '\n':
            i = i + 1
        if i < configContent.len:
            i = i + 1  # skip '\n'
    return ""

# ── Parse config model value ───────────────────────────────────────────────

fn rustCsgAppServerParseConfigModelValue(configContent: str): str =
    return rustCsgAppServerParseConfigStringValue(configContent, "model")

fn rustCsgAppServerReadOpenAiBaseUrl(): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return ""
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return ""
    return rustCsgAppServerParseConfigStringValue(configContent, "openai_base_url")

fn rustCsgAppServerOpenAiEndpoint(path: str): str =
    var baseUrl: str = rustCsgAppServerReadOpenAiBaseUrl()
    if baseUrl == "":
        return ""
    while strings.Len(baseUrl) > 0 && baseUrl[strings.Len(baseUrl) - 1] == '/':
        baseUrl = strings.SliceBytes(baseUrl, 0, strings.Len(baseUrl) - 1)
    return wire.RustCsgCat(baseUrl, path)

fn rustCsgAppServerIsGlmModel(model: str): bool =
    return strings.HasPrefix(model, "glm-")

fn rustCsgAppServerReadGlmBaseUrl(): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return ""
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return ""
    return rustCsgAppServerParseConfigStringValue(configContent, "glm_base_url")

fn rustCsgAppServerReadGlmAnthropicBaseUrl(): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return ""
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return ""
    return rustCsgAppServerParseConfigStringValue(configContent, "glm_anthropic_base_url")

fn rustCsgAppServerGlmEndpoint(path: str): str =
    var baseUrl: str = rustCsgAppServerReadGlmBaseUrl()
    if baseUrl == "":
        baseUrl = "https://api.z.ai/api/coding/paas/v4"
    while strings.Len(baseUrl) > 0 && baseUrl[strings.Len(baseUrl) - 1] == '/':
        baseUrl = strings.SliceBytes(baseUrl, 0, strings.Len(baseUrl) - 1)
    return wire.RustCsgCat(baseUrl, path)

fn rustCsgAppServerGlmAnthropicEndpoint(path: str): str =
    var baseUrl: str = rustCsgAppServerReadGlmAnthropicBaseUrl()
    if baseUrl == "":
        baseUrl = "https://api.z.ai/api/anthropic"
    while strings.Len(baseUrl) > 0 && baseUrl[strings.Len(baseUrl) - 1] == '/':
        baseUrl = strings.SliceBytes(baseUrl, 0, strings.Len(baseUrl) - 1)
    return wire.RustCsgCat(baseUrl, path)

fn rustCsgAppServerFillGlmAuth(endpointPath: str, outApiKey: var str, outApiUrl: var str) =
    if outApiKey != "":
        return
    outApiKey = RustCsgGetEnv("ZAI_API_KEY")
    if outApiKey != "":
        outApiUrl = rustCsgAppServerGlmEndpoint(endpointPath)

fn rustCsgAppServerFillGlmAnthropicAuth(endpointPath: str, outApiKey: var str, outApiUrl: var str) =
    if outApiKey != "":
        return
    outApiKey = RustCsgGetEnv("ZAI_API_KEY")
    if outApiKey != "":
        outApiUrl = rustCsgAppServerGlmAnthropicEndpoint(endpointPath)

fn rustCsgAppServerFillOpenAiAuthFromHome(endpointPath: str, outApiKey: var str, outApiUrl: var str) =
    if outApiKey != "":
        return
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "" || codexHome == "":
        return
    let authPath = home.RustCsgPathJoinChild(codexHome, "auth.json")
    let authJson = home.RustCsgReadFile(authPath)
    if authJson == "":
        return
    outApiKey = wire.RustCsgJsonFindOptionalStr(authJson, "openai_api_key")
    if outApiKey != "":
        outApiUrl = rustCsgAppServerOpenAiEndpoint(endpointPath)

# ── Append model to JSON helper ───────────────────────────────────────────

fn rustCsgAppServerAppendModelToJson(outJson: var str, outCount: var int32, id: str, name: str, provider: str) =
    if id == "" || provider == "":
        return
    if outCount > 0:
        outJson = wire.RustCsgCat(outJson, ",")
    var entry = "{"
    entry = wire.RustCsgCat(entry, wire.RustCsgJsonFieldStr("id", id))
    entry = wire.RustCsgCat(entry, ",")
    if name != "":
        entry = wire.RustCsgCat(entry, wire.RustCsgJsonFieldStr("name", name))
    else:
        entry = wire.RustCsgCat(entry, wire.RustCsgJsonFieldStr("name", id))
    entry = wire.RustCsgCat(entry, ",")
    entry = wire.RustCsgCat(entry, wire.RustCsgJsonFieldStr("provider", provider))
    entry = wire.RustCsgCat(entry, "}")
    outJson = wire.RustCsgCat(outJson, entry)
    outCount = outCount + 1

# ── models/list ────────────────────────────────────────────────────────

fn rustCsgAppServerHandleModelsList(id: int32): str =
    var modelsJson: str = "["
    var count: int32

    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)

    var configModel: str
    if pathError == "" && codexHome != "":
        let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
        let configContent = home.RustCsgReadFile(configPath)
        if configContent != "":
            configModel = rustCsgAppServerParseConfigModelValue(configContent)

    # Add configured model first if it is not one of the defaults
    if configModel != "":
        var isDefault: bool
        if configModel == "gpt-5" || configModel == "gpt-5-codex" || configModel == "glm-5.2" || configModel == "glm-5.2[1m]" || configModel == "gpt-oss-20b":
            isDefault = true
        if !isDefault:
            var configProvider = "openai"
            if rustCsgAppServerIsGlmModel(configModel):
                configProvider = "glm"
            rustCsgAppServerAppendModelToJson(modelsJson, count, configModel, configModel, configProvider)

    # Default models (always included)
    rustCsgAppServerAppendModelToJson(modelsJson, count, "gpt-5", "GPT-5", "openai")
    rustCsgAppServerAppendModelToJson(modelsJson, count, "gpt-5-codex", "GPT-5 Codex", "openai")
    rustCsgAppServerAppendModelToJson(modelsJson, count, "glm-5.2", "GLM-5.2", "glm")
    rustCsgAppServerAppendModelToJson(modelsJson, count, "glm-5.2[1m]", "GLM-5.2 1M", "glm")
    rustCsgAppServerAppendModelToJson(modelsJson, count, "gpt-oss-20b", "GPT-OSS 20B", "lmstudio")

    modelsJson = wire.RustCsgCat(modelsJson, "]")
    var out = "{\"models\":"
    out = wire.RustCsgCat(out, modelsJson)
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── models/providers ───────────────────────────────────────────────────────

fn rustCsgAppServerHandleModelsProviders(id: int32): str =
    var out = "{\"providers\":["
    out = wire.RustCsgCat(out, "{\"id\":\"openai\",\"name\":\"OpenAI\",\"capabilities\":[\"chat\",\"reasoning\"]},")
    out = wire.RustCsgCat(out, "{\"id\":\"glm\",\"name\":\"GLM\",\"capabilities\":[\"chat\",\"reasoning\",\"streaming\",\"tools\",\"structured_output\",\"context_cache\"]},")
    out = wire.RustCsgCat(out, "{\"id\":\"lmstudio\",\"name\":\"LM Studio\",\"capabilities\":[\"chat\"]}")
    out = wire.RustCsgCat(out, "]}")
    return rustCsgAppServerResponse(id, out)

# ── model_provider/capabilities ─────────────────────────────────

fn rustCsgAppServerHandleModelProviderCapabilities(id: int32, body: str): str =
    let provider = wire.RustCsgJsonFindStr(wire.RustCsgJsonFindObject(body, "params"), "provider")
    if provider == "":
        return rustCsgAppServerError(id, -32602, "provider is required")
    if provider == "openai":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "openai"))
        out = wire.RustCsgCat(out, ",\"capabilities\":[\"chat\",\"reasoning\",\"streaming\"],")
        out = wire.RustCsgCat(out, "\"models\":[\"gpt-5\",\"gpt-5-codex\"]")
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)
    if provider == "glm":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "glm"))
        out = wire.RustCsgCat(out, ",\"capabilities\":[\"chat\",\"reasoning\",\"streaming\",\"tools\",\"structured_output\",\"context_cache\"],")
        out = wire.RustCsgCat(out, "\"models\":[\"glm-5.2\",\"glm-5.2[1m]\"]")
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)
    if provider == "lmstudio":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "lmstudio"))
        out = wire.RustCsgCat(out, ",\"capabilities\":[\"chat\"],")
        out = wire.RustCsgCat(out, "\"models\":[\"gpt-oss-20b\"]")
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)
    return rustCsgAppServerError(id, -32602, "unknown provider")

# ── model_provider/models ───────────────────────────────────────

fn rustCsgAppServerHandleModelProviderModels(id: int32, body: str): str =
    let provider = wire.RustCsgJsonFindStr(wire.RustCsgJsonFindObject(body, "params"), "provider")
    if provider == "":
        return rustCsgAppServerError(id, -32602, "provider is required")
    if provider == "openai":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "openai"))
        out = wire.RustCsgCat(out, ",\"models\":[")
        out = wire.RustCsgCat(out, "{\"id\":\"gpt-5\",\"name\":\"GPT-5\",\"contextWindow\":128000,\"supportsReasoning\":true},")
        out = wire.RustCsgCat(out, "{\"id\":\"gpt-5-codex\",\"name\":\"GPT-5 Codex\",\"contextWindow\":128000,\"supportsReasoning\":true}")
        out = wire.RustCsgCat(out, "]}")
        return rustCsgAppServerResponse(id, out)
    if provider == "glm":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "glm"))
        out = wire.RustCsgCat(out, ",\"models\":[")
        out = wire.RustCsgCat(out, "{\"id\":\"glm-5.2\",\"name\":\"GLM-5.2\",\"contextWindow\":1000000,\"maxOutputTokens\":131072,\"supportsReasoning\":true},")
        out = wire.RustCsgCat(out, "{\"id\":\"glm-5.2[1m]\",\"name\":\"GLM-5.2 1M\",\"contextWindow\":1000000,\"maxOutputTokens\":131072,\"supportsReasoning\":true}")
        out = wire.RustCsgCat(out, "]}")
        return rustCsgAppServerResponse(id, out)
    if provider == "lmstudio":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("provider", "lmstudio"))
        out = wire.RustCsgCat(out, ",\"models\":[")
        out = wire.RustCsgCat(out, "{\"id\":\"gpt-oss-20b\",\"name\":\"GPT-OSS 20B\",\"contextWindow\":128000,\"supportsReasoning\":false}")
        out = wire.RustCsgCat(out, "]}")
        return rustCsgAppServerResponse(id, out)
    return rustCsgAppServerError(id, -32602, "unknown provider")

# ── completion/stream ────────────────────────────────────────────

fn rustCsgAppServerHandleCompletionStream(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let prompt = wire.RustCsgJsonFindStr(paramsJson, "prompt")
    if prompt == "":
        return rustCsgAppServerError(id, -32602, "prompt must not be empty")
    var model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        model = "gpt-5"
    # Build messages from prompt
    var messagesJson: str = wire.RustCsgCat3("[{\"role\":\"user\",\"content\":", wire.RustCsgJsonQuote(prompt), "}]")
    if rustCsgAppServerIsGlmModel(model):
        var glmApiKey: str
        var glmApiUrl: str
        rustCsgAppServerFillGlmAuth("/chat/completions", glmApiKey, glmApiUrl)
        if glmApiKey == "":
            var out = wire.RustCsgCat("{\"completionId\":\"comp-1\",\"model\":", wire.RustCsgJsonQuote(model))
            out = wire.RustCsgCat(out, ",\"choices\":[{\"text\":\"\",\"index\":0}],\"status\":\"not_available\",\"reason\":\"no API key configured (set ZAI_API_KEY)\"}")
            return rustCsgAppServerResponse(id, out)
        var glmResponse: str
        var glmError: str
        model_chat.RustCsgModelGlmChatStream(model, messagesJson, glmApiKey, glmApiUrl, true, "max", false, 131072, glmResponse, glmError)
        if glmError == "":
            var out = "{"
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("completionId", "comp-1"))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, "\"choices\":[{\"text\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(glmResponse))
            out = wire.RustCsgCat(out, ",\"index\":0}],")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
            out = wire.RustCsgCat(out, "}")
            return rustCsgAppServerResponse(id, out)
        var glmErrOut = "{\"status\":\"error\",\"reason\":"
        glmErrOut = wire.RustCsgCat(glmErrOut, wire.RustCsgJsonQuote(wire.RustCsgCat("GLM API call failed: ", glmError)))
        glmErrOut = wire.RustCsgCat(glmErrOut, "}")
        return rustCsgAppServerResponse(id, glmErrOut)
    # Resolve API key: DEEPSEEK first, then OPENAI
    var apiKey: str = RustCsgGetEnv("DEEPSEEK_API_KEY")
    var apiUrl: str
    if apiKey != "":
        apiUrl = "https://api.deepseek.com/v1/chat/completions"
        if model == "gpt-5":
            model = "deepseek-chat"
    if apiKey == "":
        apiKey = RustCsgGetEnv("OPENAI_API_KEY")
        if apiKey != "":
            apiUrl = rustCsgAppServerOpenAiEndpoint("/chat/completions")
    rustCsgAppServerFillOpenAiAuthFromHome("/chat/completions", apiKey, apiUrl)
    if apiKey == "":
        var out = wire.RustCsgCat("{\"completionId\":\"comp-1\",\"model\":", wire.RustCsgJsonQuote(model))
        out = wire.RustCsgCat(out, ",\"choices\":[{\"text\":\"\",\"index\":0}],\"status\":\"not_available\",\"reason\":\"no API key configured (set DEEPSEEK_API_KEY or OPENAI_API_KEY)\"}")
        return rustCsgAppServerResponse(id, out)
    # Call model with real API key
    var outResponse: str
    var outError: str
    model_chat.RustCsgModelChatStream(model, messagesJson, apiKey, apiUrl, outResponse, outError)
    if outError == "" && outResponse != "":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("completionId", "comp-1"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, "\"choices\":[{\"text\":")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(outResponse))
        out = wire.RustCsgCat(out, ",\"index\":0}],")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)
    var errOut = "{\"status\":\"error\",\"reason\":"
    errOut = wire.RustCsgCat(errOut, wire.RustCsgJsonQuote(wire.RustCsgCat("API call failed: ", outError)))
    errOut = wire.RustCsgCat(errOut, "}")
    return rustCsgAppServerResponse(id, errOut)

# ── completion/chat ───────────────────────────────────────────────

fn rustCsgAppServerHandleCompletionChat(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let messagesJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "messages")
    if messagesJson == "" || messagesJson == "[]":
        return rustCsgAppServerError(id, -32602, "messages must not be empty")
    var model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        model = "gpt-5"

    if rustCsgAppServerIsGlmModel(model):
        var glmApiKey: str
        var glmApiUrl: str
        rustCsgAppServerFillGlmAuth("/chat/completions", glmApiKey, glmApiUrl)
        if glmApiKey == "":
            var out = wire.RustCsgCat("{\"completionId\":\"chat-1\",\"model\":", wire.RustCsgJsonQuote(model))
            out = wire.RustCsgCat(out, ",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"\"},\"index\":0}],\"status\":\"not_available\",\"reason\":\"no API key configured (set ZAI_API_KEY)\"}")
            return rustCsgAppServerResponse(id, out)
        var glmResponse: str
        var glmError: str
        model_chat.RustCsgModelGlmChatWithUrl(model, messagesJson, glmApiKey, glmApiUrl, true, "max", 131072, false, glmResponse, glmError)
        if glmError == "" && glmResponse != "":
            var out = "{"
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("completionId", "chat-1"))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("content", glmResponse))
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
            out = wire.RustCsgCat(out, "}")
            return rustCsgAppServerResponse(id, out)
        var glmErrOut = "{\"status\":\"error\",\"reason\":"
        glmErrOut = wire.RustCsgCat(glmErrOut, wire.RustCsgJsonQuote(wire.RustCsgCat("GLM API call failed: ", glmError)))
        glmErrOut = wire.RustCsgCat(glmErrOut, "}")
        return rustCsgAppServerResponse(id, glmErrOut)

    # Resolve API key: DEEPSEEK first, then OPENAI, then auth.json
    var apiKey: str = RustCsgGetEnv("DEEPSEEK_API_KEY")
    var apiUrl: str
    if apiKey != "":
        apiUrl = "https://api.deepseek.com/v1/chat/completions"
        if model == "gpt-5":
            model = "deepseek-chat"
    if apiKey == "":
        apiKey = RustCsgGetEnv("OPENAI_API_KEY")
        if apiKey != "":
            apiUrl = rustCsgAppServerOpenAiEndpoint("/chat/completions")
    rustCsgAppServerFillOpenAiAuthFromHome("/chat/completions", apiKey, apiUrl)

    if apiKey == "":
        # No API key — return not_available
        var out = wire.RustCsgCat("{\"completionId\":\"chat-1\",\"model\":", wire.RustCsgJsonQuote(model))
        out = wire.RustCsgCat(out, ",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"\"},\"index\":0}],\"status\":\"not_available\",\"reason\":\"no API key configured (set DEEPSEEK_API_KEY or OPENAI_API_KEY)\"}")
        return rustCsgAppServerResponse(id, out)

    # Call model provider with real API key
    var outResponse: str
    var outError: str
    model_chat.RustCsgModelChatWithUrl(model, messagesJson, apiKey, apiUrl, outResponse, outError)
    if outError == "" && outResponse != "":
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("completionId", "chat-1"))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("content", outResponse))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)

    # API call failed or no response
    var errOut = "{\"status\":\"error\",\"reason\":"
    errOut = wire.RustCsgCat(errOut, wire.RustCsgJsonQuote(wire.RustCsgCat("API call failed: ", outError)))
    errOut = wire.RustCsgCat(errOut, "}")
    return rustCsgAppServerResponse(id, errOut)

# ── completion/anthropic_messages ─────────────────────────────────

fn rustCsgAppServerHandleCompletionAnthropicMessages(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let messagesJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "messages")
    if messagesJson == "" || messagesJson == "[]":
        return rustCsgAppServerError(id, -32602, "messages must not be empty")

    var model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        model = "glm-5.2[1m]"
    if !rustCsgAppServerIsGlmModel(model):
        return rustCsgAppServerError(id, -32602, "completion/anthropic_messages only supports GLM models")

    let systemPrompt = wire.RustCsgJsonFindOptionalStr(paramsJson, "system")
    var maxTokens: int32 = 131072
    if wire.RustCsgContains(paramsJson, "\"max_tokens\""):
        maxTokens = wire.RustCsgJsonFindInt32(paramsJson, "max_tokens")
    if maxTokens <= 0:
        maxTokens = 131072

    var thinkingEnabled: bool = true
    if wire.RustCsgContains(paramsJson, "\"thinking_enabled\""):
        thinkingEnabled = wire.RustCsgJsonFindOptionalBool(paramsJson, "thinking_enabled")
    var reasoningEffort = wire.RustCsgJsonFindOptionalStr(paramsJson, "reasoning_effort")
    if reasoningEffort == "":
        reasoningEffort = "max"

    var glmApiKey: str
    var glmApiUrl: str
    rustCsgAppServerFillGlmAnthropicAuth("/v1/messages", glmApiKey, glmApiUrl)
    if glmApiKey == "":
        var missing = "{\"messageId\":\"msg-1\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"\"}],"
        missing = wire.RustCsgCat(missing, wire.RustCsgJsonFieldStr("model", model))
        missing = wire.RustCsgCat(missing, ",\"status\":\"not_available\",\"reason\":\"no API key configured (set ZAI_API_KEY)\"}")
        return rustCsgAppServerResponse(id, missing)

    var glmResponse: str
    var glmError: str
    model_chat.RustCsgModelAnthropicMessagesWithUrl(model, systemPrompt, messagesJson, glmApiKey, glmApiUrl, maxTokens, thinkingEnabled, reasoningEffort, glmResponse, glmError)
    if glmError == "" && glmResponse != "":
        var out = "{\"messageId\":\"msg-1\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":"
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(glmResponse))
        out = wire.RustCsgCat(out, "}],")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
        out = wire.RustCsgCat(out, ",\"stop_reason\":\"end_turn\",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)

    var errOut = "{\"status\":\"error\",\"reason\":"
    errOut = wire.RustCsgCat(errOut, wire.RustCsgJsonQuote(wire.RustCsgCat("GLM Anthropic API call failed: ", glmError)))
    errOut = wire.RustCsgCat(errOut, "}")
    return rustCsgAppServerResponse(id, errOut)

# ── embedding/create ─────────────────────────────────────────────

fn rustCsgAppServerHandleEmbeddingCreate(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let input = wire.RustCsgJsonFindStr(paramsJson, "input")
    if input == "":
        return rustCsgAppServerError(id, -32602, "input must not be empty")
    var model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        model = "text-embedding-3-small"

    # Resolve API key: DEEPSEEK first, then OPENAI, then auth.json
    var apiKey: str = RustCsgGetEnv("DEEPSEEK_API_KEY")
    var apiUrl: str
    if apiKey != "":
        apiUrl = "https://api.deepseek.com/v1/embeddings"
    if apiKey == "":
        apiKey = RustCsgGetEnv("OPENAI_API_KEY")
        if apiKey != "":
            apiUrl = rustCsgAppServerOpenAiEndpoint("/embeddings")
    rustCsgAppServerFillOpenAiAuthFromHome("/embeddings", apiKey, apiUrl)

    if apiKey == "":
        var out = "{\"embeddingId\":\"emb-1\",\"model\":"
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(model))
        out = wire.RustCsgCat(out, ",\"embedding\":[],\"status\":\"error\",\"reason\":\"no API key configured (set DEEPSEEK_API_KEY or OPENAI_API_KEY)\"}")
        return rustCsgAppServerResponse(id, out)

    let result: str = RustCsgModelEmbedding(model, input, apiKey, apiUrl)
    # Check for error response from C function
    if strings.HasPrefix(result, "{\"error\""):
        let reason = wire.RustCsgJsonFindOptionalStr(result, "error")
        if reason == "":
            reason = "embedding API call failed"
        var out = "{\"embeddingId\":\"emb-1\",\"model\":"
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(model))
        out = wire.RustCsgCat(out, ",\"embedding\":[],\"status\":\"error\",\"reason\":")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(reason))
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)

    # Success: result is the embedding JSON array
    var out = "{\"embeddingId\":\"emb-1\",\"model\":"
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(model))
    out = wire.RustCsgCat(out, ",\"embedding\":")
    out = wire.RustCsgCat(out, result)
    out = wire.RustCsgCat(out, ",\"status\":\"success\"}")
    return rustCsgAppServerResponse(id, out)

# ── image/generate ───────────────────────────────────────────────

fn rustCsgAppServerHandleImageGenerate(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let prompt = wire.RustCsgJsonFindStr(paramsJson, "prompt")
    if prompt == "":
        return rustCsgAppServerError(id, -32602, "prompt must not be empty")
    var model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        model = "dall-e-3"
    let size = wire.RustCsgJsonFindOptionalStr(paramsJson, "size")

    # Resolve API key: OPENAI first, then DEEPSEEK, then auth.json
    var apiKey: str = RustCsgGetEnv("OPENAI_API_KEY")
    var apiUrl: str
    if apiKey != "":
        apiUrl = rustCsgAppServerOpenAiEndpoint("/images/generations")
    if apiKey == "":
        apiKey = RustCsgGetEnv("DEEPSEEK_API_KEY")
        if apiKey != "":
            # DeepSeek does not support image generation; skip
            apiKey = ""
    rustCsgAppServerFillOpenAiAuthFromHome("/images/generations", apiKey, apiUrl)

    if apiKey == "":
        var out = "{\"imageId\":\"img-1\",\"images\":[],\"status\":\"error\",\"reason\":\"no API key configured (set OPENAI_API_KEY)\"}"
        return rustCsgAppServerResponse(id, out)

    let result: str = RustCsgModelImageGenerate(model, prompt, apiKey, apiUrl)
    # Check for error response from C function
    if strings.HasPrefix(result, "{\"error\""):
        let reason = wire.RustCsgJsonFindOptionalStr(result, "error")
        if reason == "":
            reason = "image generation API call failed"
        var out = "{\"imageId\":\"img-1\",\"images\":[],\"status\":\"error\",\"reason\":"
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(reason))
        out = wire.RustCsgCat(out, "}")
        return rustCsgAppServerResponse(id, out)

    # Success: result contains image JSON {"url":"...","b64_json":"..."}
    var out = "{\"imageId\":\"img-1\",\"images\":["
    out = wire.RustCsgCat(out, result)
    out = wire.RustCsgCat(out, "],\"status\":\"success\"}")
    return rustCsgAppServerResponse(id, out)
