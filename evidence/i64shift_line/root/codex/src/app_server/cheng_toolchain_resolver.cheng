import std/os
import std/strutils as strutil
import cheng/codex/config/home
import cheng/codex/protocol/wire

type ChengToolchainResolution =
    ok: bool
    path: str
    source: str
    error: str

fn ChengToolchainPathJoin(root: str, path: str): str =
    if path == "":
        return root
    if path.len > 0 && path[0] == '/':
        return path
    if root == "":
        return path
    if root[root.len - 1] == '/':
        return wire.RustCsgCat(root, path)
    return wire.RustCsgCat3(root, "/", path)

fn ChengToolchainExecutable(path: str): bool =
    if path == "":
        return false
    return home.RustCsgPathMetadataKind(path) == 2

fn ChengToolchainResolveOne(root: str,
                            envName: str,
                            fallbackRel: str,
                            label: str): ChengToolchainResolution =
    var out: ChengToolchainResolution
    let envPath = home.RustCsgGetEnv(envName)
    if envPath != "":
        if ChengToolchainExecutable(envPath):
            out.ok = true
            out.path = envPath
            out.source = envName
            return out
        out.error = strutil.Join([label, " is not a regular file: ", envPath], "")
        return out
    let fallback = ChengToolchainPathJoin(root, fallbackRel)
    if ChengToolchainExecutable(fallback):
        out.ok = true
        out.path = fallback
        out.source = fallbackRel
        return out
    out.error = strutil.Join([label, " not found as a regular file; set ", envName, " or build ", fallbackRel], "")
    return out

fn ChengToolchainResolveStage3(root: str): ChengToolchainResolution =
    return ChengToolchainResolveOne(root,
                                    "CHENG_STAGE3",
                                    "artifacts/bootstrap/cheng.stage3",
                                    "cheng.stage3")

fn ChengToolchainResolveBackendDriver(root: str): ChengToolchainResolution =
    return ChengToolchainResolveOne(root,
                                    "CHENG_BACKEND_DRIVER",
                                    "artifacts/backend_driver/cheng",
                                    "backend_driver/cheng")

fn ChengToolchainResolveLspCommand(root: str): ChengToolchainResolution =
    return ChengToolchainResolveOne(root,
                                    "CHENG_LSP_COMMAND",
                                    "artifacts/bootstrap/cheng-lsp",
                                    "Cheng LSP command")

fn ChengToolchainResolveNodeCommand(root: str): ChengToolchainResolution =
    return ChengToolchainResolveOne(root,
                                    "CHENG_NODE",
                                    "/usr/bin/node",
                                    "Node.js command")

fn ChengToolchainResolveTsCsgCli(root: str): ChengToolchainResolution =
    return ChengToolchainResolveOne(root,
                                    "CHENG_TS_CSG_CLI",
                                    "ts-csg/dist/cli.js",
                                    "ts-csg CLI")

fn ChengToolchainCurrentRoot(): str =
    return os.GetCurrentDir()

fn ChengToolchainResolutionToJson(res: ChengToolchainResolution): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ok", res.ok))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", res.path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", res.source))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", res.error))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengToolchainSnapshotJson(root: str): str =
    let stage3 = ChengToolchainResolveStage3(root)
    let backend = ChengToolchainResolveBackendDriver(root)
    let lsp = ChengToolchainResolveLspCommand(root)
    let node = ChengToolchainResolveNodeCommand(root)
    let tsCsg = ChengToolchainResolveTsCsgCli(root)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("stage3", ChengToolchainResolutionToJson(stage3)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("backendDriver", ChengToolchainResolutionToJson(backend)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("lspCommand", ChengToolchainResolutionToJson(lsp)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("nodeCommand", ChengToolchainResolutionToJson(node)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("tsCsgCli", ChengToolchainResolutionToJson(tsCsg)))
    out = wire.RustCsgCat(out, "}")
    return out
