import cheng/codex/protocol/thread_wire
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

const
    RustCsgThreadTurnsListDefaultLimit: int32 = 25
    RustCsgThreadTurnsListMaxLimit: int32 = 100

type
    RustCsgThreadTurnsListResult =
        ok: bool
        response: types.RustCsgThreadTurnsListResponse
        rowCount: int32
        error: str
        blockedReason: str

fn RustCsgThreadTurnsListError(message: str): RustCsgThreadTurnsListResult =
    var result: RustCsgThreadTurnsListResult
    result.error = message
    return result

fn RustCsgThreadTurnsListBlocked(message: str): RustCsgThreadTurnsListResult =
    var result: RustCsgThreadTurnsListResult
    result.blockedReason = message
    return result

fn RustCsgThreadTurnsListJsonLooksInt(value: str): bool =
    if value == "":
        return false
    var i: int32
    if value[0] == '-':
        i = 1
    if i >= value.len:
        return false
    while i < value.len:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(value, i, 1))
        if digit < 0:
            return false
        i = i + 1
    return true

fn RustCsgThreadTurnsListLimit(limitJson: str, outError: var str): int32 =
    outError = ""
    if limitJson == "":
        return RustCsgThreadTurnsListDefaultLimit
    if !RustCsgThreadTurnsListJsonLooksInt(limitJson):
        outError = wire.RustCsgCat("invalid thread/turns/list limit: ", limitJson)
        return 0
    var value = wire.RustCsgParseInt32(limitJson)
    if value < 1:
        value = 1
    if value > RustCsgThreadTurnsListMaxLimit:
        value = RustCsgThreadTurnsListMaxLimit
    return value

fn RustCsgThreadTurnsListSortDirection(raw: str, outError: var str): str =
    outError = ""
    if raw == "":
        return "desc"
    if raw == "asc" || raw == "desc":
        return raw
    outError = wire.RustCsgCat("invalid thread/turns/list sortDirection: ", raw)
    return ""

fn RustCsgThreadTurnsListItemsView(raw: str, outError: var str): str =
    outError = ""
    if raw == "":
        return "summary"
    if raw == "\"notLoaded\"":
        return "notLoaded"
    if raw == "\"summary\"":
        return "summary"
    if raw == "\"full\"":
        return "full"
    outError = wire.RustCsgCat("invalid thread/turns/list itemsView: ", raw)
    return ""

fn RustCsgThreadTurnsListJsonObjectEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '{':
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    return -1

fn RustCsgThreadTurnsListArrayObjectAt(arrayJson: str, targetIndex: int32): str =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(arrayJson, 0)
    if pos >= arrayJson.len || arrayJson[pos] != '[':
        return ""
    pos = wire.RustCsgSkipJsonSpace(arrayJson, pos + 1)
    var index: int32
    while pos < arrayJson.len:
        if arrayJson[pos] == ']':
            return ""
        if arrayJson[pos] != '{':
            return ""
        let endPos = RustCsgThreadTurnsListJsonObjectEnd(arrayJson, pos)
        if endPos < 0:
            return ""
        if index == targetIndex:
            return wire.RustCsgSliceBytes(arrayJson, pos, endPos - pos + 1)
        index = index + 1
        pos = wire.RustCsgSkipJsonSpace(arrayJson, endPos + 1)
        if pos < arrayJson.len && arrayJson[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(arrayJson, pos + 1)
        elif pos < arrayJson.len && arrayJson[pos] == ']':
            return ""
        else:
            return ""
    return ""

fn RustCsgThreadTurnsListArrayLen(arrayJson: str): int32 =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(arrayJson, 0)
    if pos >= arrayJson.len || arrayJson[pos] != '[':
        return -1
    pos = wire.RustCsgSkipJsonSpace(arrayJson, pos + 1)
    var count: int32
    while pos < arrayJson.len:
        if arrayJson[pos] == ']':
            return count
        if arrayJson[pos] != '{':
            return -1
        let endPos = RustCsgThreadTurnsListJsonObjectEnd(arrayJson, pos)
        if endPos < 0:
            return -1
        count = count + 1
        pos = wire.RustCsgSkipJsonSpace(arrayJson, endPos + 1)
        if pos < arrayJson.len && arrayJson[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(arrayJson, pos + 1)
        elif pos < arrayJson.len && arrayJson[pos] == ']':
            return count
        else:
            return -1
    return -1

fn RustCsgThreadTurnsListItemArraySummary(itemsJson: str): str =
    let itemCount = RustCsgThreadTurnsListArrayLen(itemsJson)
    if itemCount <= 0:
        return "[]"
    var firstUser: str
    var firstUserId: str
    var finalAgent: str
    var finalAgentId: str
    for i in 0..<itemCount:
        let item = RustCsgThreadTurnsListArrayObjectAt(itemsJson, i)
        let itemType = wire.RustCsgJsonFindStr(item, "type")
        if itemType == "userMessage" && firstUser == "":
            firstUser = item
            firstUserId = wire.RustCsgJsonFindStr(item, "id")
        if itemType == "agentMessage":
            finalAgent = item
            finalAgentId = wire.RustCsgJsonFindStr(item, "id")
    if firstUser != "" && finalAgent != "" && firstUserId != finalAgentId:
        return wire.RustCsgCat3("[", wire.RustCsgCat3(firstUser, ",", finalAgent), "]")
    if firstUser != "":
        return wire.RustCsgCat3("[", firstUser, "]")
    if finalAgent != "":
        return wire.RustCsgCat3("[", finalAgent, "]")
    return "[]"

fn RustCsgThreadTurnsListTurnWithItemsView(turnJson: str, itemsView: str): str =
    var turn = wire.RustCsgAppTurnFromJson(turnJson)
    if itemsView == "notLoaded":
        turn.itemsJson = "[]"
        turn.itemsView = "notLoaded"
    elif itemsView == "summary":
        turn.itemsJson = RustCsgThreadTurnsListItemArraySummary(turn.itemsJson)
        turn.itemsView = "summary"
    elif itemsView == "full":
        turn.itemsView = "full"
    else:
        assert(false, wire.RustCsgCat("unsupported thread/turns/list itemsView: ", itemsView))
    return wire.RustCsgAppTurnToJson(turn)

fn RustCsgThreadTurnsListCursorWithIncludeAnchor(turnId: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", turnId))
    out = wire.RustCsgCat(out, ",\"includeAnchor\":true")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadTurnsListCursorAfterAnchor(turnId: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", turnId))
    out = wire.RustCsgCat(out, ",\"includeAnchor\":false")
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadTurnsListFindTurnIndex(turnsJson: str, count: int32, turnId: str): int32 =
    for i in 0..<count:
        let turnJson = RustCsgThreadTurnsListArrayObjectAt(turnsJson, i)
        if wire.RustCsgJsonFindStr(turnJson, "id") == turnId:
            return i
    return -1

fn RustCsgThreadTurnsListFromTurnsJson(turnsJson: str,
                                       params: var types.RustCsgThreadTurnsListParams): RustCsgThreadTurnsListResult =
    if params.threadId == "":
        return RustCsgThreadTurnsListBlocked("invalid thread id: empty")
    var error: str
    let pageSize = RustCsgThreadTurnsListLimit(params.limitJson, error)
    if error != "":
        return RustCsgThreadTurnsListBlocked(error)
    let sortDirection = RustCsgThreadTurnsListSortDirection(params.sortDirection, error)
    if error != "":
        return RustCsgThreadTurnsListBlocked(error)
    let itemsView = RustCsgThreadTurnsListItemsView(params.itemsViewJson, error)
    if error != "":
        return RustCsgThreadTurnsListBlocked(error)

    let count = RustCsgThreadTurnsListArrayLen(turnsJson)
    if count < 0:
        return RustCsgThreadTurnsListBlocked("thread/turns/list input turns must be a JSON object array")
    if count == 0:
        var emptyResponse: types.RustCsgThreadTurnsListResponse
        emptyResponse.dataJson = "[]"
        var emptyResult: RustCsgThreadTurnsListResult
        emptyResult.ok = true
        emptyResult.response = emptyResponse
        return emptyResult

    var anchorIndex: int32
    anchorIndex = -1
    var includeAnchor: bool
    if params.cursor != "":
        let anchorTurnId = wire.RustCsgJsonFindStr(params.cursor, "turnId")
        includeAnchor = wire.RustCsgJsonFindBool(params.cursor, "includeAnchor")
        anchorIndex = RustCsgThreadTurnsListFindTurnIndex(turnsJson, count, anchorTurnId)
        if anchorIndex < 0:
            return RustCsgThreadTurnsListBlocked("invalid cursor: anchor turn is no longer present")

    var dataJson = "["
    var firstData: bool
    firstData = true
    var rowCount: int32
    var firstIncludedId: str
    var lastIncludedId: str
    var moreAvailable: bool

    var scanPos: int32
    while scanPos < count:
        var index: int32
        if sortDirection == "desc":
            index = count - 1 - scanPos
        else:
            index = scanPos
        scanPos = scanPos + 1

        var include: bool
        include = true
        if params.cursor != "":
            if sortDirection == "asc":
                if includeAnchor:
                    include = index >= anchorIndex
                else:
                    include = index > anchorIndex
            else:
                if includeAnchor:
                    include = index <= anchorIndex
                else:
                    include = index < anchorIndex
        if !include:
            continue

        let turnJson = RustCsgThreadTurnsListArrayObjectAt(turnsJson, index)
        if rowCount >= pageSize:
            moreAvailable = true
            break
        let turnId = wire.RustCsgJsonFindStr(turnJson, "id")
        if rowCount == 0:
            firstIncludedId = turnId
        lastIncludedId = turnId
        if !firstData:
            dataJson = wire.RustCsgCat(dataJson, ",")
        dataJson = wire.RustCsgCat(dataJson, RustCsgThreadTurnsListTurnWithItemsView(turnJson, itemsView))
        firstData = false
        rowCount = rowCount + 1

    dataJson = wire.RustCsgCat(dataJson, "]")

    var response: types.RustCsgThreadTurnsListResponse
    response.dataJson = dataJson
    if moreAvailable:
        response.nextCursor = RustCsgThreadTurnsListCursorAfterAnchor(lastIncludedId)
    if firstIncludedId != "":
        response.backwardsCursor = RustCsgThreadTurnsListCursorWithIncludeAnchor(firstIncludedId)

    var result: RustCsgThreadTurnsListResult
    result.ok = true
    result.response = response
    result.rowCount = rowCount
    return result

fn RustCsgThreadTurnsListResponseJsonFromTurnsJson(turnsJson: str,
                                                   params: var types.RustCsgThreadTurnsListParams): str =
    var result = RustCsgThreadTurnsListFromTurnsJson(turnsJson, params)
    if !result.ok:
        return ""
    return thread_wire.RustCsgThreadTurnsListResponseToJson(result.response)
