import cheng/codex/app_server/thread_row
import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite

type
    RustCsgThreadReadSqliteResult =
        ok: bool
        response: types.RustCsgThreadReadResponse
        error: str
        blockedReason: str

fn RustCsgThreadReadSqliteError(message: str): RustCsgThreadReadSqliteResult =
    var result: RustCsgThreadReadSqliteResult
    result.error = message
    return result

fn RustCsgThreadReadSqliteBlocked(message: str): RustCsgThreadReadSqliteResult =
    var result: RustCsgThreadReadSqliteResult
    result.blockedReason = message
    return result

fn RustCsgThreadReadSqliteThreadNotLoaded(threadId: str): str =
    return wire.RustCsgCat("thread not loaded: ", threadId)

fn RustCsgThreadReadSqliteFromStateDb(dbPath: str,
                                      params: var types.RustCsgThreadReadParams,
                                      fallbackProvider: str): RustCsgThreadReadSqliteResult =
    if params.threadId == "":
        return RustCsgThreadReadSqliteBlocked("invalid thread id: empty")

    let row = state_db_sqlite.RustCsgStateDbThreadByIdIncludingArchived(dbPath, params.threadId)
    if !row.ok:
        if row.notFound:
            return RustCsgThreadReadSqliteBlocked(RustCsgThreadReadSqliteThreadNotLoaded(params.threadId))
        return RustCsgThreadReadSqliteError(row.error)

    var thread = thread_row.RustCsgThreadRowToAppThread(row)
    if thread.modelProvider == "":
        thread.modelProvider = fallbackProvider
    if params.includeTurns:
        var historyError: str
        let turnsJson = reader.RustCsgRolloutTurnsJsonFromFile(row.rolloutPath, historyError)
        if historyError == "rollout history file is missing or empty":
            return RustCsgThreadReadSqliteBlocked(
                wire.RustCsgCat3("thread ",
                                 params.threadId,
                                 " is not materialized yet; includeTurns is unavailable before first user message"))
        if historyError != "":
            return RustCsgThreadReadSqliteBlocked(historyError)
        thread.turnsJson = turnsJson

    var response: types.RustCsgThreadReadResponse
    response.thread = thread

    var result: RustCsgThreadReadSqliteResult
    result.ok = true
    result.response = response
    return result
