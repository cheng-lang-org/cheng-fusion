import cheng/codex/app_server/cheng_agent_runtime as agent_runtime
import cheng/codex/app_server/cheng_write_gate as gate
import cheng/codex/protocol/wire

@importc("RustCsgGetCurrentTimeMs")
fn ChengWriteGatewayNowMs(): int64

var ChengWriteGatewayEventsJsonCache: str
var ChengWriteGatewayValidationRequirementsJsonCache: str

fn ChengWriteGatewayReset() =
    ChengWriteGatewayEventsJsonCache = ""
    ChengWriteGatewayValidationRequirementsJsonCache = ""

fn ChengWriteGatewayAppendJson(cache: var str, item: str) =
    if cache == "":
        cache = item
    else:
        cache = wire.RustCsgCat3(cache, ",", item)

fn ChengWriteGatewayValidationChecksJson(action: str, path: str): str =
    if gate.ChengWriteGateIsTsCsgSourcePath(path):
        if gate.ChengWriteGateTsCsgNeedsRuntimeClosure(path):
            return "[\"ts_csg_emit\",\"ts_csg_runtime_closure\"]"
        return "[\"ts_csg_emit\"]"
    if gate.ChengWriteGateIsChengSourcePath(path):
        var checks = "[\"cheng.lsp\""
        if gate.ChengWriteGateNeedsCsg(action, path):
            checks = wire.RustCsgCat(checks, ",\"cheng.csgc.authority\"")
        if gate.ChengWriteGateIsChengRuntimeProviderPath(path):
            checks = wire.RustCsgCat(checks, ",\"ts_csg_runtime_closure\"")
        if gate.ChengWriteGateIsDebugOrProfilePath(path):
            checks = wire.RustCsgCat(checks, ",\"cheng.debugger\",\"cheng.profile\"")
        return wire.RustCsgCat(checks, "]")
    return "[]"

fn ChengWriteGatewayRequirementJson(action: str,
                                    path: str,
                                    phase: str,
                                    required: bool,
                                    checksJson: str,
                                    reason: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("schema", "cheng.write_validation_requirement.v1"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("action", action))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("phase", phase))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("required", required))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("checks", checksJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reason", reason))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("timestampMs", ChengWriteGatewayNowMs()))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengWriteGatewayAppendEvent(action: str, path: str, phase: str, allowed: bool, reason: str, requirementJson: str) =
    var item = "{"
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("action", action))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("path", path))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("phase", phase))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldBool("allowed", allowed))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("reason", reason))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldRaw("validationRequirement", requirementJson))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldInt64("timestampMs", ChengWriteGatewayNowMs()))
    item = wire.RustCsgCat(item, "}")
    ChengWriteGatewayAppendJson(ChengWriteGatewayEventsJsonCache, item)

fn ChengWriteGatewayCheckAllowed(action: str, path: str, outReason: var str): bool =
    outReason = ""
    let allowed = gate.ChengWriteGateCheckAllowed(action, path, outReason)
    let checks = ChengWriteGatewayValidationChecksJson(action, path)
    let required = checks != "[]"
    let requirement = ChengWriteGatewayRequirementJson(action, path, "beforeWrite", required, checks, outReason)
    ChengWriteGatewayAppendEvent(action, path, "beforeWrite", allowed, outReason, requirement)
    if required && !allowed:
        ChengWriteGatewayAppendJson(ChengWriteGatewayValidationRequirementsJsonCache, requirement)
        agent_runtime.ChengAgentRuntimeRecordValidationRequirement(action, path, checks)
    agent_runtime.ChengAgentRuntimeRecordWriteAttempt(action, path, allowed, outReason)
    return allowed

fn ChengWriteGatewayRecordAfter(action: str, path: str, ok: bool, detail: str) =
    let checks = ok ? ChengWriteGatewayValidationChecksJson(action, path) : "[]"
    let required = ok && checks != "[]"
    let requirement = ChengWriteGatewayRequirementJson(action, path, "afterWrite", required, checks, detail)
    ChengWriteGatewayAppendEvent(action, path, "afterWrite", ok, detail, requirement)
    if required:
        ChengWriteGatewayAppendJson(ChengWriteGatewayValidationRequirementsJsonCache, requirement)
        agent_runtime.ChengAgentRuntimeRecordValidationRequirement(action, path, checks)

fn ChengWriteGatewayEventsJson(): str =
    if ChengWriteGatewayEventsJsonCache == "":
        return "[]"
    return wire.RustCsgCat3("[", ChengWriteGatewayEventsJsonCache, "]")

fn ChengWriteGatewayValidationRequirementsJson(): str =
    if ChengWriteGatewayValidationRequirementsJsonCache == "":
        return "[]"
    return wire.RustCsgCat3("[", ChengWriteGatewayValidationRequirementsJsonCache, "]")
