import std/strings
import cheng/codex/app_server/cheng_evidence_ledger as ledger
import cheng/codex/app_server/cheng_training_trace as training
import cheng/codex/config/home
import cheng/codex/protocol/wire

@importc("RustCsgGetCurrentTimeMs")
fn ChengAgentRuntimeNowMs(): int64

var ChengAgentRuntimeActive: bool
var ChengAgentRuntimeThreadId: str
var ChengAgentRuntimeTurnId: str
var ChengAgentRuntimeInputSummary: str
var ChengAgentRuntimeSelectedToolsJson: str
var ChengAgentRuntimeToolCallsJsonCache: str
var ChengAgentRuntimeWriteAttemptsJsonCache: str
var ChengAgentRuntimeValidationRequirementsJsonCache: str
var ChengAgentRuntimeFinalSnapshotJsonCache: str
var ChengAgentRuntimeTraceOutDirConfig: str
var ChengAgentRuntimeLastTraceManifestJsonCache: str
var ChengAgentRuntimeLastTraceManifestPathCache: str
var ChengAgentRuntimeToolFailureCount: int32
var ChengAgentRuntimeWriteDeniedCount: int32
var ChengAgentRuntimeWriteAllowedCount: int32

fn ChengAgentRuntimeReset() =
    ChengAgentRuntimeActive = false
    ChengAgentRuntimeThreadId = ""
    ChengAgentRuntimeTurnId = ""
    ChengAgentRuntimeInputSummary = ""
    ChengAgentRuntimeSelectedToolsJson = "[]"
    ChengAgentRuntimeToolCallsJsonCache = ""
    ChengAgentRuntimeWriteAttemptsJsonCache = ""
    ChengAgentRuntimeValidationRequirementsJsonCache = ""
    ChengAgentRuntimeFinalSnapshotJsonCache = ""
    ChengAgentRuntimeLastTraceManifestJsonCache = ""
    ChengAgentRuntimeLastTraceManifestPathCache = ""
    ChengAgentRuntimeToolFailureCount = 0
    ChengAgentRuntimeWriteDeniedCount = 0
    ChengAgentRuntimeWriteAllowedCount = 0

fn ChengAgentRuntimeBeginTurn(threadId: str, turnId: str, inputSummary: str) =
    ChengAgentRuntimeReset()
    ChengAgentRuntimeActive = true
    ChengAgentRuntimeThreadId = threadId
    ChengAgentRuntimeTurnId = turnId
    ChengAgentRuntimeInputSummary = inputSummary
    ledger.ChengEvidenceBeginScope(wire.RustCsgCat3(threadId, ":", turnId))

fn ChengAgentRuntimeEnsureActive() =
    if !ChengAgentRuntimeActive:
        ChengAgentRuntimeBeginTurn("", "", "")

fn ChengAgentRuntimeNoteToolInjection(threadId: str, turnId: str, toolsJson: str) =
    ChengAgentRuntimeEnsureActive()
    if ChengAgentRuntimeThreadId == "" && threadId != "":
        ChengAgentRuntimeThreadId = threadId
    if ChengAgentRuntimeTurnId == "" && turnId != "":
        ChengAgentRuntimeTurnId = turnId
    if toolsJson == "":
        ChengAgentRuntimeSelectedToolsJson = "[]"
    else:
        ChengAgentRuntimeSelectedToolsJson = toolsJson

fn ChengAgentRuntimeAppendJson(cache: var str, item: str) =
    if cache == "":
        cache = item
    else:
        cache = wire.RustCsgCat3(cache, ",", item)

fn ChengAgentRuntimeRecordNativeToolCall(tool: str, argumentsRaw: str, responseJson: str) =
    ChengAgentRuntimeEnsureActive()
    let ok = strings.StrContains(responseJson, "\"success\":true")
    if !ok:
        ChengAgentRuntimeToolFailureCount = ChengAgentRuntimeToolFailureCount + 1
    var item = "{"
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("tool", tool))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldBool("success", ok))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("argumentsPreview", ChengAgentRuntimePreview(argumentsRaw)))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldInt64("timestampMs", ChengAgentRuntimeNowMs()))
    item = wire.RustCsgCat(item, "}")
    ChengAgentRuntimeAppendJson(ChengAgentRuntimeToolCallsJsonCache, item)

fn ChengAgentRuntimeRecordWriteAttempt(action: str, path: str, allowed: bool, reason: str) =
    ChengAgentRuntimeEnsureActive()
    if allowed:
        ChengAgentRuntimeWriteAllowedCount = ChengAgentRuntimeWriteAllowedCount + 1
    else:
        ChengAgentRuntimeWriteDeniedCount = ChengAgentRuntimeWriteDeniedCount + 1
    var item = "{"
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("action", action))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("path", path))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldBool("allowed", allowed))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("reason", reason))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldInt64("timestampMs", ChengAgentRuntimeNowMs()))
    item = wire.RustCsgCat(item, "}")
    ChengAgentRuntimeAppendJson(ChengAgentRuntimeWriteAttemptsJsonCache, item)

fn ChengAgentRuntimeRecordValidationRequirement(action: str, path: str, checksJson: str) =
    ChengAgentRuntimeEnsureActive()
    if checksJson == "" || checksJson == "[]":
        return
    var item = "{"
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("schema", "cheng.write_validation_requirement.v1"))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("action", action))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("path", path))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldRaw("checks", checksJson))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldInt64("timestampMs", ChengAgentRuntimeNowMs()))
    item = wire.RustCsgCat(item, "}")
    ChengAgentRuntimeAppendJson(ChengAgentRuntimeValidationRequirementsJsonCache, item)

fn ChengAgentRuntimePreview(text: str): str =
    if text.len <= 160:
        return text
    return wire.RustCsgCat(wire.RustCsgSliceBytes(text, 0, 160), "...")

fn ChengAgentRuntimeJsonArray(cache: str): str =
    if cache == "":
        return "[]"
    return wire.RustCsgCat3("[", cache, "]")

fn ChengAgentRuntimeClassify(validationStatus: str): str =
    if ChengAgentRuntimeWriteDeniedCount > 0 || ChengAgentRuntimeToolFailureCount > 0:
        return "failed"
    if validationStatus == "completed" ||
       validationStatus == "compiled" ||
       validationStatus == "tested" ||
       validationStatus == "verified" ||
       validationStatus == "passed":
        return "success"
    if ledger.ChengEvidenceHasFreshAnyPath("cheng.lsp", ChengAgentRuntimeNowMs()) ||
       ledger.ChengEvidenceHasFreshAnyPath("ts_csg_emit", ChengAgentRuntimeNowMs()) ||
       ledger.ChengEvidenceHasFreshAnyPath("ts_csg_runtime_closure", ChengAgentRuntimeNowMs()):
        return "unverified"
    return "unverified"

fn ChengAgentRuntimeSnapshotJson(validationStatus: str): str =
    ChengAgentRuntimeEnsureActive()
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("schema", "cheng.agent_runtime.v1"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", ChengAgentRuntimeThreadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", ChengAgentRuntimeTurnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("inputSummary", ChengAgentRuntimePreview(ChengAgentRuntimeInputSummary)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("selectedTools", ChengAgentRuntimeSelectedToolsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("toolCalls", ChengAgentRuntimeJsonArray(ChengAgentRuntimeToolCallsJsonCache)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("writeAttempts", ChengAgentRuntimeJsonArray(ChengAgentRuntimeWriteAttemptsJsonCache)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("validationRequirements", ChengAgentRuntimeJsonArray(ChengAgentRuntimeValidationRequirementsJsonCache)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("evidenceScope", ledger.ChengEvidenceScopeJson()))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("outcome", ChengAgentRuntimeClassify(validationStatus)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("validationStatus", validationStatus))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("toolFailureCount", ChengAgentRuntimeToolFailureCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("writeDeniedCount", ChengAgentRuntimeWriteDeniedCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("writeAllowedCount", ChengAgentRuntimeWriteAllowedCount))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengAgentRuntimeConfigureTraceOutDir(outDir: str) =
    ChengAgentRuntimeTraceOutDirConfig = outDir

fn ChengAgentRuntimeTraceOutDir(): str =
    if ChengAgentRuntimeTraceOutDirConfig != "":
        return ChengAgentRuntimeTraceOutDirConfig
    return home.RustCsgGetEnv("CHENG_AGENT_TRACE_OUT_DIR")

fn ChengAgentRuntimeTraceId(): str =
    let key = wire.RustCsgCat3(ChengAgentRuntimeThreadId, ":", ChengAgentRuntimeTurnId)
    return wire.RustCsgCat("runtime-", strings.Sha256(key))

fn ChengAgentRuntimePersistFinalSnapshot(validationStatus: str, snapshot: str): str =
    let outDir = ChengAgentRuntimeTraceOutDir()
    if outDir == "":
        return ""
    let payload = training.ChengTrainingTraceRecord(ChengAgentRuntimeTraceId(),
                                                    ChengAgentRuntimeInputSummary,
                                                    wire.RustCsgCat3("[", snapshot, "]"),
                                                    "",
                                                    ChengAgentRuntimeJsonArray(ChengAgentRuntimeValidationRequirementsJsonCache),
                                                    ChengAgentRuntimeClassify(validationStatus),
                                                    "cheng agent runtime finalize",
                                                    validationStatus,
                                                    ChengAgentRuntimeNowMs())
    let kind = "agent-runtime"
    let cid = training.ChengTrainingTracePayloadCid(payload)
    let _shardPath = training.ChengTrainingTraceWriteProductionShard(outDir, kind, payload)
    let manifest = training.ChengTrainingTraceWriteProductionManifest(outDir, kind, payload, "none", "")
    ChengAgentRuntimeLastTraceManifestJsonCache = manifest
    ChengAgentRuntimeLastTraceManifestPathCache = training.ChengTrainingTraceManifestPath(outDir, kind, cid)
    return manifest

fn ChengAgentRuntimeFinalizeTurn(validationStatus: str): str =
    let snapshot = ChengAgentRuntimeSnapshotJson(validationStatus)
    ChengAgentRuntimeFinalSnapshotJsonCache = snapshot
    let _manifest = ChengAgentRuntimePersistFinalSnapshot(validationStatus, snapshot)
    ledger.ChengEvidenceEndScope()
    ChengAgentRuntimeActive = false
    return snapshot

fn ChengAgentRuntimeFinalizeTurnIfActive(validationStatus: str): str =
    if !ChengAgentRuntimeActive:
        return ChengAgentRuntimeLastSnapshotJson()
    return ChengAgentRuntimeFinalizeTurn(validationStatus)

fn ChengAgentRuntimeLastSnapshotJson(): str =
    if ChengAgentRuntimeFinalSnapshotJsonCache == "":
        return "{}"
    return ChengAgentRuntimeFinalSnapshotJsonCache

fn ChengAgentRuntimeLastTraceManifestJson(): str =
    return ChengAgentRuntimeLastTraceManifestJsonCache

fn ChengAgentRuntimeLastTraceManifestPath(): str =
    return ChengAgentRuntimeLastTraceManifestPathCache

fn ChengAgentRuntimeSnapshotEvidenceJson(validationStatus: str): str =
    if ChengAgentRuntimeActive:
        return wire.RustCsgCat3("[", ChengAgentRuntimeSnapshotJson(validationStatus), "]")
    let last = ChengAgentRuntimeLastSnapshotJson()
    if last == "{}":
        return "[]"
    return wire.RustCsgCat3("[", last, "]")
