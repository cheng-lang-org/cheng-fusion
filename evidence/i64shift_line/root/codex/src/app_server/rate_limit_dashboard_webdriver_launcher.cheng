import cheng/codex/std/process
import cheng/codex/std/http
import cheng/codex/std/strings
import cheng/codex/protocol/wire
import cheng/codex/app_server/rate_limit_dashboard_webdriver
import cheng/codex/app_server/transport_tcp as tcp
import cheng/codex/config/home

# WebDriver browser launcher for rate limit dashboard.
# Manages chromedriver/safaridriver process lifecycle.
# Aligns with Rust cf64150e9c codex-rs/app-server/src/rate_limit_dashboard/webdriver/launcher.rs.

const RustCsgWebDriverChromePort: int32 = 9517
const RustCsgWebDriverSafariPort: int32 = 7055
const RustCsgWebDriverChromeReadyTimeoutMs: int32 = 45000
const RustCsgWebDriverSafariReadyTimeoutMs: int32 = 8000
const RustCsgWebDriverDefaultChromeBinary: str = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
const RustCsgWebDriverBrowserEnv: str = "CODEX_RATE_LIMIT_DASHBOARD_BROWSER"
const RustCsgWebDriverBrowserOverrideEnv: str = "CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_BROWSER"
const RustCsgWebDriverUrlEnv: str = "CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_URL"
const RustCsgWebDriverChromeBinaryEnv: str = "CODEX_RATE_LIMIT_DASHBOARD_CHROME_BINARY"

var rustCsgWebDriverLauncherLocalBaseUrl: str
var rustCsgWebDriverLauncherLocalPid: int32
var rustCsgWebDriverLauncherLocalPort: int32
var rustCsgWebDriverLauncherLocalIsSafari: bool

@abi_internal
@importc("RustCsgFileExists")
fn RustCsgFileExists(path: str): int32

@abi_internal
@importc("RustCsgEnvIsSet")
fn RustCsgEnvIsSet(name: str): int32

@abi_internal
@importc("RustCsgCommandInPathIsFile")
fn RustCsgCommandInPathIsFile(command: str): int32

@importc("RustCsgSleepMs")
fn RustCsgSleepMs(ms: int32): int32

fn RustCsgWebDriverEnvIsSet(key: str): bool =
    return RustCsgEnvIsSet(key) == 1

fn RustCsgWebDriverPathIsFile(path: str): bool =
    return home.RustCsgPathMetadataKind(path) == 2

fn RustCsgWebDriverTrimAscii(value: str): str =
    var start: int32
    var end: int32
    end = value.len
    while start < end:
        let ch = value[start]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            break
        start = start + 1
    while end > start:
        let ch = value[end - 1]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            break
        end = end - 1
    return strings.SliceBytes(value, start, end - start)

fn RustCsgWebDriverLowerAscii(value: str): str =
    var out: str
    for i in 0..<value.len:
        let ch = value[i]
        if ch >= 'A' && ch <= 'Z':
            out = wire.RustCsgCat(out, strings.SliceBytes("abcdefghijklmnopqrstuvwxyz", int32(ch) - int32('A'), 1))
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(value, i, 1))
    return out

fn RustCsgWebDriverNormalizeBrowserName(value: str): str =
    return RustCsgWebDriverLowerAscii(RustCsgWebDriverTrimAscii(value))

fn RustCsgWebDriverLocalChromeBinaryPath(): str =
    let envPath = home.RustCsgGetEnv(RustCsgWebDriverChromeBinaryEnv)
    if RustCsgWebDriverEnvIsSet(RustCsgWebDriverChromeBinaryEnv) && RustCsgWebDriverPathIsFile(envPath):
        return envPath
    if RustCsgWebDriverPathIsFile(RustCsgWebDriverDefaultChromeBinary):
        return RustCsgWebDriverDefaultChromeBinary
    return ""

fn RustCsgWebDriverCommandInPath(command: str): bool =
    return RustCsgCommandInPathIsFile(command) == 1

fn RustCsgWebDriverBrowserFromEnvValue(key: str, value: str, isPresent: bool, outIsSet: var bool, outIsSafari: var bool, outError: var str): bool =
    outIsSet = false
    outIsSafari = false
    outError = ""
    if !isPresent:
        return true
    outIsSet = true
    let normalized = RustCsgWebDriverNormalizeBrowserName(value)
    if normalized == "chrome":
        outIsSafari = false
        return true
    if normalized == "safari":
        outIsSafari = true
        return true
    outError = wire.RustCsgCat(key, wire.RustCsgCat(" must be `chrome` or `safari`, got `", wire.RustCsgCat(normalized, "`")))
    return false

fn RustCsgWebDriverSelectedBrowser(outIsSafari: var bool, outChromeBinary: var str, outError: var str): bool =
    outIsSafari = false
    outChromeBinary = ""
    outError = ""
    var envIsSet: bool
    if !RustCsgWebDriverBrowserFromEnvValue(RustCsgWebDriverBrowserOverrideEnv,
                                            home.RustCsgGetEnv(RustCsgWebDriverBrowserOverrideEnv),
                                            RustCsgWebDriverEnvIsSet(RustCsgWebDriverBrowserOverrideEnv),
                                            envIsSet,
                                            outIsSafari,
                                            outError):
        return false
    if envIsSet:
        if !outIsSafari:
            outChromeBinary = RustCsgWebDriverLocalChromeBinaryPath()
        return true
    if !RustCsgWebDriverBrowserFromEnvValue(RustCsgWebDriverBrowserEnv,
                                            home.RustCsgGetEnv(RustCsgWebDriverBrowserEnv),
                                            RustCsgWebDriverEnvIsSet(RustCsgWebDriverBrowserEnv),
                                            envIsSet,
                                            outIsSafari,
                                            outError):
        return false
    if envIsSet:
        if !outIsSafari:
            outChromeBinary = RustCsgWebDriverLocalChromeBinaryPath()
        return true
    let chromeBinary = RustCsgWebDriverLocalChromeBinaryPath()
    if chromeBinary != "" && RustCsgWebDriverCommandInPath("npx"):
        outIsSafari = false
        outChromeBinary = chromeBinary
        return true
    outIsSafari = true
    return true

fn RustCsgWebDriverLauncherUsesExternalWebDriver(): bool =
    return RustCsgWebDriverEnvIsSet(RustCsgWebDriverUrlEnv)

fn RustCsgWebDriverLauncherChooseLocalPort(outPort: var int32, outError: var str): bool =
    outPort = 0
    outError = ""
    let listenFd = tcp.RustCsgTcpListen("127.0.0.1", 0)
    if listenFd < 0:
        outError = "failed to reserve local WebDriver TCP port"
        return false
    outPort = tcp.RustCsgTcpLocalPort(listenFd)
    tcp.RustCsgSocketClose(listenFd)
    if outPort <= 0:
        outError = "failed to read reserved local WebDriver TCP port"
        return false
    return true

fn RustCsgWebDriverLauncherBuildLocalBaseUrl(port: int32): str =
    return wire.RustCsgCat("http://127.0.0.1:", strings.IntToStr(port))

fn RustCsgWebDriverLauncherStopOwnedLocalDriver() =
    if rustCsgWebDriverLauncherLocalPid > 0:
        let pid = rustCsgWebDriverLauncherLocalPid
        process.ProcessKillGroup(rustCsgWebDriverLauncherLocalPid, 15)
        process.ProcessKill(rustCsgWebDriverLauncherLocalPid, 15)
        var elapsed: int32
        while elapsed < 2000 && process.ProcessTryWait(pid) == -2:
            RustCsgSleepMs(100)
            elapsed = elapsed + 100
        if process.ProcessTryWait(pid) == -2:
            process.ProcessKillGroup(pid, 9)
            process.ProcessKill(pid, 9)
            elapsed = 0
            while elapsed < 1000 && process.ProcessTryWait(pid) == -2:
                RustCsgSleepMs(100)
                elapsed = elapsed + 100
        if process.ProcessTryWait(pid) != -2:
            process.ProcessWait(pid)
    rustCsgWebDriverLauncherLocalPid = 0
    rustCsgWebDriverLauncherLocalPort = 0
    rustCsgWebDriverLauncherLocalBaseUrl = ""

fn RustCsgWebDriverLauncherResolveSpec(outBaseUrl: var str, outIsSafari: var bool, outChromeBinary: var str, outError: var str): bool =
    outBaseUrl = ""
    outIsSafari = false
    outChromeBinary = ""
    outError = ""
    if !RustCsgWebDriverSelectedBrowser(outIsSafari, outChromeBinary, outError):
        return false
    if RustCsgWebDriverLauncherUsesExternalWebDriver():
        outBaseUrl = home.RustCsgGetEnv(RustCsgWebDriverUrlEnv)
        return true
    if rustCsgWebDriverLauncherLocalBaseUrl != "" && rustCsgWebDriverLauncherLocalIsSafari == outIsSafari:
        outBaseUrl = rustCsgWebDriverLauncherLocalBaseUrl
        return true
    if rustCsgWebDriverLauncherLocalBaseUrl != "":
        RustCsgWebDriverLauncherStopOwnedLocalDriver()
    var port: int32
    if !RustCsgWebDriverLauncherChooseLocalPort(port, outError):
        return false
    let baseUrl = RustCsgWebDriverLauncherBuildLocalBaseUrl(port)
    rustCsgWebDriverLauncherLocalBaseUrl = baseUrl
    rustCsgWebDriverLauncherLocalPort = port
    rustCsgWebDriverLauncherLocalIsSafari = outIsSafari
    outBaseUrl = baseUrl
    return true

fn RustCsgWebDriverLauncherSpawnLocalDriver(baseUrl: str, isSafari: bool, chromeBinary: str, outError: var str): bool =
    outError = ""
    if RustCsgWebDriverLauncherUsesExternalWebDriver():
        return true
    if isSafari:
        return RustCsgWebDriverLauncherSpawnSafaridriver(outError)
    return RustCsgWebDriverLauncherSpawnChromeDriver(chromeBinary, outError)

fn RustCsgWebDriverLauncherSpawnChromeDriver(chromeBinary: str, outError: var str): bool =
    outError = ""
    let port = rustCsgWebDriverLauncherLocalPort
    if port <= 0:
        outError = "local ChromeDriver port was not selected"
        return false
    if chromeBinary == "":
        outError = "Google Chrome is not installed; set CODEX_RATE_LIMIT_DASHBOARD_BROWSER=safari to keep using Safari automation"
        return false
    if !RustCsgWebDriverCommandInPath("npx"):
        outError = "Chrome automation requires `npx` on PATH to launch a matching chromedriver"
        return false
    var versionArgs: str[]
    add(versionArgs, "--version")
    var versionResult = process.ProcessSpawn(chromeBinary, versionArgs, "", [])
    if !versionResult.ok || versionResult.exitCode != 0:
        outError = wire.RustCsgCat("failed to inspect Chrome version from ", chromeBinary)
        return false
    var chromeMajor = RustCsgWebDriverParseChromeMajorVersion(versionResult.stdout, outError)
    if chromeMajor == "":
        return false
    var args: str[]
    add(args, "--yes")
    add(args, "--package")
    add(args, wire.RustCsgCat("chromedriver@", chromeMajor))
    add(args, "chromedriver")
    add(args, wire.RustCsgCat("--port=", strings.IntToStr(port)))
    var result = process.ProcessSpawnRaw("npx", args, "", [])
    if !result.ok:
        outError = wire.RustCsgCat("failed to start chromedriver: ", result.error)
        return false
    rustCsgWebDriverLauncherLocalPid = result.pid
    rustCsgWebDriverLauncherLocalIsSafari = false
    return true

fn RustCsgWebDriverLauncherSpawnSafaridriver(outError: var str): bool =
    outError = ""
    let port = rustCsgWebDriverLauncherLocalPort
    if port <= 0:
        outError = "local Safari WebDriver port was not selected"
        return false
    var args: str[]
    add(args, "-p")
    add(args, strings.IntToStr(port))
    var result = process.ProcessSpawnRaw("safaridriver", args, "", [])
    if !result.ok:
        outError = wire.RustCsgCat("failed to start safaridriver: ", result.error)
        return false
    rustCsgWebDriverLauncherLocalPid = result.pid
    rustCsgWebDriverLauncherLocalIsSafari = true
    return true

fn RustCsgWebDriverParseChromeMajorVersion(rawVersion: str, outError: var str): str =
    outError = ""
    var out: str
    let trimmed = RustCsgWebDriverTrimAscii(rawVersion)
    if trimmed == "":
        outError = "Chrome --version did not return a version number"
        return ""
    var tokenStart: int32
    var i = trimmed.len - 1
    while i >= 0:
        let ch = trimmed[i]
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            tokenStart = i + 1
            break
        i = i - 1
    i = tokenStart
    while i < trimmed.len:
        let piece = strings.SliceBytes(trimmed, i, 1)
        let digit = wire.RustCsgDigitValue(piece)
        if digit >= 0:
            out = wire.RustCsgCat(out, piece)
        elif out != "":
            if piece == ".":
                return out
            outError = wire.RustCsgCat("failed to parse Chrome major version from `", wire.RustCsgCat(rawVersion, "`"))
            return ""
        else:
            outError = wire.RustCsgCat("failed to parse Chrome major version from `", wire.RustCsgCat(rawVersion, "`"))
            return ""
        i = i + 1
    if out != "":
        return out
    outError = wire.RustCsgCat("failed to parse Chrome major version from `", wire.RustCsgCat(rawVersion, "`"))
    return ""

fn RustCsgWebDriverLauncherBrowserLabel(isSafari: bool): str =
    if isSafari:
        return "Safari"
    return "Chrome"

fn RustCsgWebDriverLauncherReadyTimeoutMs(isSafari: bool): int32 =
    if isSafari:
        return RustCsgWebDriverSafariReadyTimeoutMs
    return RustCsgWebDriverChromeReadyTimeoutMs

fn RustCsgWebDriverLauncherUnavailableMessage(isSafari: bool): str =
    if isSafari:
        return "Safari WebDriver is unavailable; on macOS enable Safari Settings > Developer > Allow Remote Automation, or set CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_URL with CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_BROWSER=safari"
    return "Chrome WebDriver is unavailable; install Google Chrome and ensure `npx` is on PATH, or set CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_URL with CODEX_RATE_LIMIT_DASHBOARD_WEBDRIVER_BROWSER=chrome"

fn RustCsgWebDriverLauncherEnsureDriverReady(outBaseUrl: var str, outIsSafari: var bool, outChromeBinary: var str, outError: var str): bool =
    outBaseUrl = ""
    outIsSafari = false
    outChromeBinary = ""
    outError = ""
    if !RustCsgWebDriverLauncherResolveSpec(outBaseUrl, outIsSafari, outChromeBinary, outError):
        return false
    var activeBaseUrl = outBaseUrl
    if !RustCsgWebDriverLauncherUsesExternalWebDriver() && rustCsgWebDriverLauncherLocalPort > 0:
        activeBaseUrl = RustCsgWebDriverLauncherBuildLocalBaseUrl(rustCsgWebDriverLauncherLocalPort)
        outBaseUrl = activeBaseUrl
    if rate_limit_dashboard_webdriver.RustCsgWebDriverIsReady(activeBaseUrl):
        outBaseUrl = activeBaseUrl
        return true
    if RustCsgWebDriverLauncherUsesExternalWebDriver():
        outError = wire.RustCsgCat(RustCsgWebDriverLauncherBrowserLabel(outIsSafari),
                                   wire.RustCsgCat(" webdriver at ", wire.RustCsgCat(activeBaseUrl, " is not reachable")))
        return false
    if rustCsgWebDriverLauncherLocalPid > 0:
        RustCsgWebDriverLauncherStopOwnedLocalDriver()
        var localPort: int32
        if !RustCsgWebDriverLauncherChooseLocalPort(localPort, outError):
            return false
        let localBaseUrl = RustCsgWebDriverLauncherBuildLocalBaseUrl(localPort)
        rustCsgWebDriverLauncherLocalBaseUrl = localBaseUrl
        rustCsgWebDriverLauncherLocalPort = localPort
        rustCsgWebDriverLauncherLocalIsSafari = outIsSafari
        activeBaseUrl = localBaseUrl
        outBaseUrl = activeBaseUrl
    if !RustCsgWebDriverLauncherSpawnLocalDriver(activeBaseUrl, outIsSafari, outChromeBinary, outError):
        rustCsgWebDriverLauncherLocalBaseUrl = ""
        return false
    var elapsed: int32
    let readyTimeout = RustCsgWebDriverLauncherReadyTimeoutMs(outIsSafari)
    while elapsed < readyTimeout:
        activeBaseUrl = RustCsgWebDriverLauncherBuildLocalBaseUrl(rustCsgWebDriverLauncherLocalPort)
        if rate_limit_dashboard_webdriver.RustCsgWebDriverIsReady(activeBaseUrl):
            outBaseUrl = activeBaseUrl
            return true
        if rustCsgWebDriverLauncherLocalPid > 0 && process.ProcessTryWait(rustCsgWebDriverLauncherLocalPid) != -2:
            outError = wire.RustCsgCat(RustCsgWebDriverLauncherBrowserLabel(outIsSafari),
                                       wire.RustCsgCat(" WebDriver exited before becoming ready at ", activeBaseUrl))
            rustCsgWebDriverLauncherLocalPid = 0
            rustCsgWebDriverLauncherLocalBaseUrl = ""
            return false
        RustCsgSleepMs(500)
        elapsed = elapsed + 500
    outError = wire.RustCsgCat(RustCsgWebDriverLauncherUnavailableMessage(outIsSafari),
                               wire.RustCsgCat(" at ", activeBaseUrl))
    RustCsgWebDriverLauncherStopOwnedLocalDriver()
    return false

fn RustCsgWebDriverLauncherEnsureReady(outBaseUrl: var str, outIsSafari: var bool, outChromeBinary: var str, outSessionId: var str, outError: var str): bool =
    outSessionId = ""
    return RustCsgWebDriverLauncherEnsureDriverReady(outBaseUrl, outIsSafari, outChromeBinary, outError)
