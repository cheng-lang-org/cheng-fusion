import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/state/state_db

const
    RustCsgThreadListDefaultLimit: int32 = 25
    RustCsgThreadListMaxLimit: int32 = 100

type
    RustCsgThreadListPlan =
        pageSize: int32
        sortKey: str
        sortDirection: str
        modelProviderFilterJson: str
        allowedSourcesJson: str
        sourceKindPostFilterJson: str
        archived: bool
        cwdFiltersJson: str
        searchTerm: str
        useStateDbOnly: bool
        parseError: str
        blockedReason: str

fn RustCsgThreadListAllInteractiveSourcesJson(): str =
    return "[\"cli\",\"vscode\",\"{\\\"custom\\\":\\\"atlas\\\"}\",\"{\\\"custom\\\":\\\"chatgpt\\\"}\"]"

fn RustCsgThreadListAllSourceKindsJson(): str =
    return "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]"

fn RustCsgThreadListJsonStringArrayOne(value: str): str =
    return wire.RustCsgCat3("[", wire.RustCsgJsonQuote(value), "]")

fn RustCsgThreadListJsonLooksInt(value: str): bool =
    if value == "":
        return false
    var i: int32
    if value[0] == '-':
        i = 1
    if i >= value.len:
        return false
    while i < value.len:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(value, i, 1))
        if digit < 0:
            return false
        i = i + 1
    return true

fn RustCsgThreadListLimitFromJson(limitJson: str, outError: var str): int32 =
    outError = ""
    if limitJson == "":
        return RustCsgThreadListDefaultLimit
    if !RustCsgThreadListJsonLooksInt(limitJson):
        outError = wire.RustCsgCat("invalid thread/list limit: ", limitJson)
        return 0
    var value = wire.RustCsgParseInt32(limitJson)
    if value < 1:
        value = 1
    if value > RustCsgThreadListMaxLimit:
        value = RustCsgThreadListMaxLimit
    return value

fn RustCsgThreadListSortKeyFromParams(params: var types.RustCsgThreadListParams,
                                      outError: var str): str =
    outError = ""
    if params.sortKey == "":
        return "created_at"
    if params.sortKey == "created_at" || params.sortKey == "updated_at":
        return params.sortKey
    outError = wire.RustCsgCat("invalid thread/list sortKey: ", params.sortKey)
    return ""

fn RustCsgThreadListSortDirectionFromParams(params: var types.RustCsgThreadListParams,
                                            outError: var str): str =
    outError = ""
    if params.sortDirection == "":
        return "desc"
    if params.sortDirection == "asc" || params.sortDirection == "desc":
        return params.sortDirection
    outError = wire.RustCsgCat("invalid thread/list sortDirection: ", params.sortDirection)
    return ""

fn RustCsgThreadListModelProviderFilterJson(params: var types.RustCsgThreadListParams,
                                            fallbackProvider: str): str =
    if params.modelProvidersJson == "":
        return RustCsgThreadListJsonStringArrayOne(fallbackProvider)
    if params.modelProvidersJson == "[]":
        return ""
    return params.modelProvidersJson

fn RustCsgThreadListSourceKindRequiresPostFilter(sourceKindsJson: str): bool =
    if wire.RustCsgContains(sourceKindsJson, "\"exec\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"appServer\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgent\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentReview\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentCompact\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentThreadSpawn\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentOther\""):
        return true
    return wire.RustCsgContains(sourceKindsJson, "\"unknown\"")

fn RustCsgThreadListAllowedSourcesJson(params: var types.RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return RustCsgThreadListAllInteractiveSourcesJson()
    if RustCsgThreadListSourceKindRequiresPostFilter(params.sourceKindsJson):
        return "[]"
    var out = "["
    var first: bool
    first = true
    if wire.RustCsgContains(params.sourceKindsJson, "\"cli\""):
        out = wire.RustCsgCat(out, "\"cli\"")
        first = false
    if wire.RustCsgContains(params.sourceKindsJson, "\"vscode\""):
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, "\"vscode\"")
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgThreadListSourceKindPostFilterJson(params: var types.RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return ""
    return params.sourceKindsJson

fn RustCsgThreadListArchived(params: var types.RustCsgThreadListParams): bool =
    return params.archivedJson == "true"

fn RustCsgThreadListPlanFromParams(params: var types.RustCsgThreadListParams,
                                  fallbackProvider: str): RustCsgThreadListPlan =
    var result: RustCsgThreadListPlan
    var err: str
    result.pageSize = RustCsgThreadListLimitFromJson(params.limitJson, err)
    if err != "":
        result.parseError = err
        return result
    result.sortKey = RustCsgThreadListSortKeyFromParams(params, err)
    if err != "":
        result.parseError = err
        return result
    result.sortDirection = RustCsgThreadListSortDirectionFromParams(params, err)
    if err != "":
        result.parseError = err
        return result
    result.modelProviderFilterJson = RustCsgThreadListModelProviderFilterJson(params, fallbackProvider)
    result.allowedSourcesJson = RustCsgThreadListAllowedSourcesJson(params)
    result.sourceKindPostFilterJson = RustCsgThreadListSourceKindPostFilterJson(params)
    result.archived = RustCsgThreadListArchived(params)
    result.cwdFiltersJson = params.cwdJson
    result.searchTerm = params.searchTerm
    result.useStateDbOnly = params.useStateDbOnly
    return result

fn RustCsgThreadListPlanToJson(plan: RustCsgThreadListPlan): str =
    var out = "{"
    var modelProviderJson = plan.modelProviderFilterJson
    if modelProviderJson == "":
        modelProviderJson = "null"
    var allowedSourcesJson = plan.allowedSourcesJson
    if allowedSourcesJson == "":
        allowedSourcesJson = "[]"
    var sourceKindFilterJson = plan.sourceKindPostFilterJson
    if sourceKindFilterJson == "":
        sourceKindFilterJson = "null"
    var cwdFiltersJson = plan.cwdFiltersJson
    if cwdFiltersJson == "":
        cwdFiltersJson = "null"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("pageSize", plan.pageSize))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sortKey", plan.sortKey))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sortDirection", plan.sortDirection))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("modelProviderFilter", modelProviderJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("allowedSources", allowedSourcesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("sourceKindPostFilter", sourceKindFilterJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("archived", plan.archived))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("cwdFilters", cwdFiltersJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("searchTerm", plan.searchTerm))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("useStateDbOnly", plan.useStateDbOnly))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("parseError", plan.parseError))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("blockedReason", plan.blockedReason))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgThreadListStateDbQueryPlanFromParams(params: var types.RustCsgThreadListParams,
                                               fallbackProvider: str,
                                               sqliteHome: str,
                                               resolvedCwd: str): state_db.RustCsgStateDbThreadListQueryPlan =
    var result: state_db.RustCsgStateDbThreadListQueryPlan
    let plan = RustCsgThreadListPlanFromParams(params, fallbackProvider)
    if plan.parseError != "":
        result.parseError = plan.parseError
        result.blockedReason = state_db.RustCsgStateDbQueryBlockedReason()
        return result
    return state_db.RustCsgStateDbThreadListQueryPlanFromValues(sqliteHome,
                                                                plan.pageSize,
                                                                plan.sortKey,
                                                                plan.sortDirection,
                                                                plan.allowedSourcesJson,
                                                                plan.modelProviderFilterJson,
                                                                plan.cwdFiltersJson,
                                                                plan.searchTerm,
                                                                params.cursor,
                                                                plan.archived,
                                                                plan.sourceKindPostFilterJson,
                                                                resolvedCwd)
