# codex app-server: config handlers — moved from main.cheng for compiler stability

import std/strings
import cheng/codex/protocol/wire as wire
import cheng/codex/config/home as home

@abi_internal
@importc("RustCsgWriteFile")
fn rustCsgAppServerWriteFile(path: str, content: str): int32

# ── Response helpers (duplicated from main.cheng for module self-containment) ──

fn rustCsgAppServerRequestId(body: str): int32 =
    if wire.RustCsgContains(body, "\"id\""):
        return wire.RustCsgJsonFindInt32(body, "id")
    return 0

fn rustCsgAppServerResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgAppServerError(id: int32, code: int32, message: str): str =
    let errorHead = wire.RustCsgCat3("{\"error\":{\"code\":", strings.IntToStr(code), ",\"message\":")
    let errorBody = wire.RustCsgCat3(errorHead, wire.RustCsgJsonQuote(message), "}")
    return wire.RustCsgCat3(errorBody, wire.RustCsgCat3(",\"id\":", strings.IntToStr(id), ""), "}")

# ── config/read ───────────────────────────────────────────────────────────

fn rustCsgAppServerHandleConfigRead(id: int32, body: str): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32000, pathError)
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    let filePathJson = wire.RustCsgJsonQuote(configPath)
    let layerEntry = wire.RustCsgCat3(
        "{\"name\":{\"type\":\"user\",\"file\":", filePathJson,
        "},\"version\":\"1\"}")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("config", wire.RustCsgJsonQuote(configContent)))
    out = wire.RustCsgCat(out, ",\"configWriteable\":true,\"layers\":[")
    out = wire.RustCsgCat(out, layerEntry)
    out = wire.RustCsgCat(out, "]}")
    return rustCsgAppServerResponse(id, out)

# ── config/write ──────────────────────────────────────────────────────────

fn rustCsgAppServerConfigTargetPath(paramsJson: str, outPath: var str, outError: var str): bool =
    let explicitPathRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "filePath")
    if explicitPathRaw != "" && explicitPathRaw != "null":
        let explicitPath = wire.RustCsgJsonFindStr(paramsJson, "filePath")
        outPath = explicitPath
        return true
    var codexHome: str
    home.RustCsgFindCodexHomeInto(codexHome, outError)
    if outError != "":
        return false
    outPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    return true

fn rustCsgAppServerConfigTomlLine(key: str, valueRaw: str): str =
    if valueRaw == "":
        return wire.RustCsgCat3(key, " = ", "\"\"")
    if valueRaw[0] == '[':
        var arrayValue: str
        var arrayError: str
        if rustCsgAppServerConfigArrayToToml(valueRaw, arrayValue, arrayError):
            return wire.RustCsgCat3(key, " = ", arrayValue)
        return wire.RustCsgCat3(key, " = ", valueRaw)
    if valueRaw[0] == '"' || valueRaw[0] == '{' || valueRaw[0] == '[' || valueRaw == "true" || valueRaw == "false":
        return wire.RustCsgCat3(key, " = ", valueRaw)
    if valueRaw[0] == '-' || (valueRaw[0] >= '0' && valueRaw[0] <= '9'):
        return wire.RustCsgCat3(key, " = ", valueRaw)
    return wire.RustCsgCat4(key, " = \"", valueRaw, "\"")

fn rustCsgAppServerConfigArrayNumberToken(token: str): bool =
    if token == "":
        return false
    var i: int32
    if token[i] == '-':
        i = i + 1
    if i >= token.len:
        return false
    if token[i] == '0':
        i = i + 1
    elif token[i] >= '1' && token[i] <= '9':
        i = i + 1
        while i < token.len && token[i] >= '0' && token[i] <= '9':
            i = i + 1
    else:
        return false
    if i < token.len && token[i] == '.':
        i = i + 1
        if i >= token.len || token[i] < '0' || token[i] > '9':
            return false
        while i < token.len && token[i] >= '0' && token[i] <= '9':
            i = i + 1
    if i < token.len && (token[i] == 'e' || token[i] == 'E'):
        i = i + 1
        if i < token.len && (token[i] == '+' || token[i] == '-'):
            i = i + 1
        if i >= token.len || token[i] < '0' || token[i] > '9':
            return false
        while i < token.len && token[i] >= '0' && token[i] <= '9':
            i = i + 1
    return i == token.len

fn rustCsgAppServerStringLexLess(left: str, right: str): bool =
    var i: int32
    while i < left.len:
        if i >= right.len:
            return false
        if left[i] < right[i]:
            return true
        if left[i] > right[i]:
            return false
        i = i + 1
    return left.len < right.len

fn rustCsgAppServerStringLexGreater(left: str, right: str): bool =
    if left == right:
        return false
    return rustCsgAppServerStringLexLess(right, left)

fn rustCsgAppServerInlineTableKeyAfter(key: str, afterKey: str): bool =
    if afterKey == "":
        return true
    return rustCsgAppServerStringLexGreater(key, afterKey)

fn rustCsgAppServerConfigValueToToml(valueRaw: str, outValue: var str, outError: var str): bool =
    if valueRaw == "":
        outError = "config value is empty"
        return false
    if valueRaw == "null":
        outError = "config values currently do not support nested null"
        return false
    if valueRaw[0] == '"':
        outValue = valueRaw
        return true
    if valueRaw == "true" || valueRaw == "false":
        outValue = valueRaw
        return true
    if valueRaw[0] == '[':
        return rustCsgAppServerConfigArrayToToml(valueRaw, outValue, outError)
    if valueRaw[0] == '{':
        return rustCsgAppServerConfigInlineTableToToml(valueRaw, outValue, outError)
    if valueRaw[0] == '-' || (valueRaw[0] >= '0' && valueRaw[0] <= '9'):
        if !rustCsgAppServerConfigArrayNumberToken(valueRaw):
            outError = "config numeric value is invalid"
            return false
        outValue = valueRaw
        return true
    outError = "config value cannot be represented as TOML"
    return false

fn rustCsgAppServerConfigInlineTableToToml(valueRaw: str, outValue: var str, outError: var str): bool =
    var pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '{':
        outError = "config inline table must be a JSON object"
        return false
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    var sortKeys: str[]
    sortKeys = []
    var tomlKeys: str[]
    tomlKeys = []
    var values: str[]
    values = []
    while pos < valueRaw.len:
        if valueRaw[pos] == '}':
            var out = "{ "
            var first: bool = true
            var afterKey: str
            var emitted: int32
            while emitted < sortKeys.len:
                var found: bool
                var bestIndex: int32
                var scan: int32
                while scan < sortKeys.len:
                    if rustCsgAppServerInlineTableKeyAfter(sortKeys[scan], afterKey):
                        if !found || rustCsgAppServerStringLexLess(sortKeys[scan], sortKeys[bestIndex]):
                            found = true
                            bestIndex = scan
                    scan = scan + 1
                if !found:
                    outError = "config inline table key sort failed"
                    return false
                var childValue: str
                if !rustCsgAppServerConfigValueToToml(values[bestIndex], childValue, outError):
                    return false
                if !first:
                    out = wire.RustCsgCat(out, ", ")
                out = wire.RustCsgCat(out, tomlKeys[bestIndex])
                out = wire.RustCsgCat(out, " = ")
                out = wire.RustCsgCat(out, childValue)
                first = false
                afterKey = sortKeys[bestIndex]
                emitted = emitted + 1
            if first:
                outValue = "{}"
            else:
                outValue = wire.RustCsgCat(out, " }")
            return true
        if valueRaw[pos] != '"':
            outError = "config inline table keys must be strings"
            return false
        let keyEnd = rustCsgAppServerJsonStringEnd(valueRaw, pos)
        if keyEnd < 0:
            outError = "config inline table key is unterminated"
            return false
        let key = strings.SliceBytes(valueRaw, pos + 1, keyEnd - pos - 2)
        var keyError: str
        let tomlKey = rustCsgAppServerTomlSectionSegment(key, keyError)
        if keyError != "":
            outError = keyError
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, keyEnd)
        if pos >= valueRaw.len || valueRaw[pos] != ':':
            outError = "config inline table entry missing colon"
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        let valueEnd = rustCsgAppServerJsonValueEnd(valueRaw, pos)
        if valueEnd < 0:
            outError = "config inline table value is malformed"
            return false
        let rawChild = strings.SliceBytes(valueRaw, pos, valueEnd - pos)
        var duplicate: bool
        var duplicateIndex: int32
        var keyIndex: int32
        while keyIndex < sortKeys.len:
            if sortKeys[keyIndex] == key:
                duplicate = true
                duplicateIndex = keyIndex
            keyIndex = keyIndex + 1
        if duplicate:
            values[duplicateIndex] = rawChild
        else:
            add(sortKeys, key)
            add(tomlKeys, tomlKey)
            add(values, rawChild)
        pos = wire.RustCsgSkipJsonSpace(valueRaw, valueEnd)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == '}':
            continue
        else:
            outError = "config inline table is malformed"
            return false
    outError = "config inline table is unterminated"
    return false

fn rustCsgAppServerConfigArrayToToml(valueRaw: str, outValue: var str, outError: var str): bool =
    var pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '[':
        outError = "config array value must be a JSON array"
        return false
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    var out = "["
    var first: bool = true
    while pos < valueRaw.len:
        if valueRaw[pos] == ']':
            outValue = wire.RustCsgCat(out, "]")
            return true
        var itemValue: str
        if valueRaw[pos] == '{':
            let objectEnd = rustCsgAppServerJsonObjectEnd(valueRaw, pos)
            if objectEnd < 0:
                outError = "config array object value is unterminated"
                return false
            let objectRaw = strings.SliceBytes(valueRaw, pos, objectEnd - pos + 1)
            if !rustCsgAppServerConfigInlineTableToToml(objectRaw, itemValue, outError):
                return false
            pos = objectEnd + 1
        else:
            let valueEnd = rustCsgAppServerJsonValueEnd(valueRaw, pos)
            if valueEnd < 0:
                outError = "config array value is malformed"
                return false
            let childRaw = strings.SliceBytes(valueRaw, pos, valueEnd - pos)
            if !rustCsgAppServerConfigValueToToml(childRaw, itemValue, outError):
                return false
            pos = valueEnd
        if !first:
            out = wire.RustCsgCat(out, ", ")
        out = wire.RustCsgCat(out, itemValue)
        first = false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == ']':
            continue
        else:
            outError = "config array is malformed"
            return false
    outError = "config array is unterminated"
    return false

fn rustCsgAppServerConfigArraySupported(valueRaw: str, outError: var str): bool =
    var tomlValue: str
    return rustCsgAppServerConfigArrayToToml(valueRaw, tomlValue, outError)

fn rustCsgAppServerConfigSimpleKeyPath(key: str): bool =
    if key == "":
        return false
    var i: int32 = 0
    while i < key.len:
        let ch = key[i]
        if !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '-'):
            return false
        i = i + 1
    return true

fn rustCsgAppServerConfigQuotableSectionSegment(segment: str): bool =
    if segment == "":
        return false
    var i: int32
    while i < segment.len:
        let ch = segment[i]
        if ch < ' ':
            return false
        i = i + 1
    return true

fn rustCsgAppServerTomlQuotedSectionSegment(segment: str, outError: var str): str =
    if !rustCsgAppServerConfigQuotableSectionSegment(segment):
        outError = "config path segment cannot be represented as a TOML quoted section"
        return ""
    var out: str = "\""
    var i: int32
    while i < segment.len:
        let ch = segment[i]
        if ch == '"':
            out = wire.RustCsgCat(out, "\\\"")
        elif ch == '\\':
            out = wire.RustCsgCat(out, "\\\\")
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(segment, i, 1))
        i = i + 1
    return wire.RustCsgCat(out, "\"")

fn rustCsgAppServerTomlSectionSegment(segment: str, outError: var str): str =
    if rustCsgAppServerConfigSimpleKeyPath(segment):
        return segment
    return rustCsgAppServerTomlQuotedSectionSegment(segment, outError)

fn rustCsgAppServerConfigParsedSegment(keyPath: str, targetIndex: int32, outError: var str): str =
    if keyPath == "":
        outError = "keyPath must not be empty"
        return ""
    var index: int32
    var segment: str
    var quoted: bool
    var i: int32
    while i < keyPath.len:
        let ch = keyPath[i]
        if ch == '"' && segment == "" && !quoted:
            quoted = true
            i = i + 1
            continue
        if ch == '"' && quoted:
            quoted = false
            i = i + 1
            continue
        if ch == '\\' && quoted:
            if i + 1 >= keyPath.len:
                outError = "unterminated escape in keyPath"
                return ""
            segment = wire.RustCsgCat(segment, strings.SliceBytes(keyPath, i + 1, 1))
            i = i + 2
            continue
        if ch == '.' && !quoted:
            if segment == "":
                outError = "keyPath segments must not be empty"
                return ""
            if index == targetIndex:
                return segment
            segment = ""
            index = index + 1
            i = i + 1
            continue
        if ch == '"':
            outError = "invalid quoted keyPath segment"
            return ""
        segment = wire.RustCsgCat(segment, strings.SliceBytes(keyPath, i, 1))
        i = i + 1
    if quoted:
        outError = "unterminated quoted keyPath segment"
        return ""
    if segment == "":
        outError = "keyPath segments must not be empty"
        return ""
    if index == targetIndex:
        return segment
    return ""

fn rustCsgAppServerConfigParsedSegmentCount(keyPath: str, outError: var str): int32 =
    if keyPath == "":
        outError = "keyPath must not be empty"
        return 0
    var count: int32 = 1
    var segment: str
    var quoted: bool
    var i: int32
    while i < keyPath.len:
        let ch = keyPath[i]
        if ch == '"' && segment == "" && !quoted:
            quoted = true
            i = i + 1
            continue
        if ch == '"' && quoted:
            quoted = false
            i = i + 1
            continue
        if ch == '\\' && quoted:
            if i + 1 >= keyPath.len:
                outError = "unterminated escape in keyPath"
                return 0
            segment = wire.RustCsgCat(segment, strings.SliceBytes(keyPath, i + 1, 1))
            i = i + 2
            continue
        if ch == '.' && !quoted:
            if segment == "":
                outError = "keyPath segments must not be empty"
                return 0
            segment = ""
            count = count + 1
            i = i + 1
            continue
        if ch == '"':
            outError = "invalid quoted keyPath segment"
            return 0
        segment = wire.RustCsgCat(segment, strings.SliceBytes(keyPath, i, 1))
        i = i + 1
    if quoted:
        outError = "unterminated quoted keyPath segment"
        return 0
    if segment == "":
        outError = "keyPath segments must not be empty"
        return 0
    return count

fn rustCsgAppServerConfigPathKind(keyPath: str): str =
    var parseError: str
    let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, parseError)
    if parseError != "":
        return ""
    let first = rustCsgAppServerConfigParsedSegment(keyPath, 0, parseError)
    if parseError != "":
        return ""
    if count == 2 && first == "hooks":
        let secondForHooks = rustCsgAppServerConfigParsedSegment(keyPath, 1, parseError)
        if parseError != "":
            return ""
        if secondForHooks == "state":
            return "hooks_state"
    if count == 1:
        if rustCsgAppServerConfigSimpleKeyPath(first):
            return "top"
        return ""
    if count == 2:
        let leaf = rustCsgAppServerConfigParsedSegment(keyPath, 1, parseError)
        if parseError != "":
            return ""
        if first == "desktop" && rustCsgAppServerConfigSimpleKeyPath(leaf):
            return "desktop"
        if first == "plugins" && rustCsgAppServerConfigQuotableSectionSegment(leaf):
            return "plugins"
    if rustCsgAppServerConfigPathSupportedGeneric(keyPath):
        return "generic"
    return ""

fn rustCsgAppServerConfigPathSection(keyPath: str, segmentCount: int32, outError: var str): str =
    if segmentCount <= 0:
        outError = "config section requires at least one segment"
        return ""
    var out: str
    var index: int32
    while index < segmentCount:
        let segment = rustCsgAppServerConfigParsedSegment(keyPath, index, outError)
        if outError != "":
            return ""
        let tomlSegment = rustCsgAppServerTomlSectionSegment(segment, outError)
        if outError != "":
            return ""
        if index > 0:
            out = wire.RustCsgCat(out, ".")
        out = wire.RustCsgCat(out, tomlSegment)
        index = index + 1
    return out

fn rustCsgAppServerConfigPathLastSegment(keyPath: str, outError: var str): str =
    let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, outError)
    if outError != "":
        return ""
    return rustCsgAppServerConfigParsedSegment(keyPath, count - 1, outError)

fn rustCsgAppServerConfigPathParentSection(keyPath: str, outError: var str): str =
    let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, outError)
    if outError != "":
        return ""
    if count <= 1:
        outError = "config parent section requires a dotted keyPath"
        return ""
    return rustCsgAppServerConfigPathSection(keyPath, count - 1, outError)

fn rustCsgAppServerConfigPathSupportedGeneric(keyPath: str): bool =
    var parseError: str
    let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, parseError)
    if parseError != "" || count < 2:
        return false
    let section = rustCsgAppServerConfigPathSection(keyPath, count - 1, parseError)
    if parseError != "" || section == "":
        return false
    let last = rustCsgAppServerConfigParsedSegment(keyPath, count - 1, parseError)
    if parseError != "":
        return false
    return rustCsgAppServerConfigQuotableSectionSegment(last)

fn rustCsgAppServerConfigObjectKeySupported(key: str): bool =
    return rustCsgAppServerConfigSimpleKeyPath(key) || rustCsgAppServerConfigQuotableSectionSegment(key)

fn rustCsgAppServerTomlLineSectionName(line: str): str =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    if pos >= line.len || line[pos] != '[':
        return ""
    var endPos: int32 = line.len
    while endPos > pos && (line[endPos - 1] == ' ' || line[endPos - 1] == '\t' || line[endPos - 1] == '\r'):
        endPos = endPos - 1
    if endPos <= pos + 1 || line[endPos - 1] != ']':
        return ""
    return strings.SliceBytes(line, pos + 1, endPos - pos - 2)

fn rustCsgAppServerTomlSectionIsPrefix(sectionName: str, section: str): bool =
    if sectionName == section:
        return true
    if sectionName.len <= section.len:
        return false
    if strings.SliceBytes(sectionName, 0, section.len) != section:
        return false
    return sectionName[section.len] == '.'

fn rustCsgAppServerConfigPathLeaf(keyPath: str): str =
    var parseError: str
    let leaf = rustCsgAppServerConfigParsedSegment(keyPath, 1, parseError)
    if parseError != "":
        return ""
    return leaf

fn rustCsgAppServerTomlLineMatchesBareKey(line: str, key: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    if pos >= line.len || line[pos] == '[' || line[pos] == '#':
        return false
    let trimmed = strings.SliceBytes(line, pos, line.len - pos)
    if trimmed.len <= key.len:
        return false
    if strings.SliceBytes(trimmed, 0, key.len) != key:
        return false
    var afterKey: int32 = key.len
    while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
        afterKey = afterKey + 1
    return afterKey < trimmed.len && trimmed[afterKey] == '='

fn rustCsgAppServerTomlLineIsAnySection(line: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    return pos < line.len && line[pos] == '['

fn rustCsgAppServerTomlLineIsSection(line: str, section: str): bool =
    var pos: int32
    while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
        pos = pos + 1
    var endPos: int32 = line.len
    while endPos > pos && (line[endPos - 1] == ' ' || line[endPos - 1] == '\t' || line[endPos - 1] == '\r'):
        endPos = endPos - 1
    if endPos - pos != section.len + 2:
        return false
    if line[pos] != '[' || line[endPos - 1] != ']':
        return false
    return strings.SliceBytes(line, pos + 1, section.len) == section

fn rustCsgAppServerJsonStringEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var escaped: bool
    var i: int32 = start + 1
    while i < text.len:
        if escaped:
            escaped = false
        elif text[i] == '\\':
            escaped = true
        elif text[i] == '"':
            return i + 1
        i = i + 1
    return -1

fn rustCsgAppServerJsonArrayEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '[':
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32 = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                return i + 1
        i = i + 1
    return -1

fn rustCsgAppServerJsonValueEnd(text: str, start: int32): int32 =
    let pos = wire.RustCsgSkipJsonSpace(text, start)
    if pos >= text.len:
        return -1
    if text[pos] == '"':
        return rustCsgAppServerJsonStringEnd(text, pos)
    if text[pos] == '[':
        return rustCsgAppServerJsonArrayEnd(text, pos)
    if text[pos] == '{':
        let objectEnd = rustCsgAppServerJsonObjectEnd(text, pos)
        if objectEnd < 0:
            return -1
        return objectEnd + 1
    var i: int32 = pos
    while i < text.len && text[i] != ',' && text[i] != '}':
        i = i + 1
    return i

fn rustCsgAppServerJsonObjectToTomlSectionBody(valueRaw: str, outError: var str): str =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '{':
        outError = "desktop object value must be a JSON object"
        return ""
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    var body: str
    while pos < valueRaw.len:
        if valueRaw[pos] == '}':
            return body
        if valueRaw[pos] != '"':
            outError = "desktop object keys must be strings"
            return ""
        let keyEnd = rustCsgAppServerJsonStringEnd(valueRaw, pos)
        if keyEnd < 0:
            outError = "desktop object key is unterminated"
            return ""
        let key = strings.SliceBytes(valueRaw, pos + 1, keyEnd - pos - 2)
        if !rustCsgAppServerConfigSimpleKeyPath(key):
            outError = "desktop object keys must be bare TOML keys"
            return ""
        pos = wire.RustCsgSkipJsonSpace(valueRaw, keyEnd)
        if pos >= valueRaw.len || valueRaw[pos] != ':':
            outError = "desktop object entry missing colon"
            return ""
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        let valueEnd = rustCsgAppServerJsonValueEnd(valueRaw, pos)
        if valueEnd < 0:
            outError = "desktop object values must be scalar"
            return ""
        let rawValue = strings.SliceBytes(valueRaw, pos, valueEnd - pos)
        if rawValue == "" || rawValue == "null" || rawValue[0] == '{':
            outError = "desktop object values must be scalar"
            return ""
        if rawValue[0] == '[':
            var arrayError: str
            if !rustCsgAppServerConfigArraySupported(rawValue, arrayError):
                outError = arrayError
                return ""
        body = wire.RustCsgCat(body, rustCsgAppServerConfigTomlLine(key, rawValue))
        body = wire.RustCsgCat(body, "\n")
        pos = wire.RustCsgSkipJsonSpace(valueRaw, valueEnd)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == '}':
            continue
        else:
            outError = "desktop object is malformed"
            return ""
    outError = "desktop object is unterminated"
    return ""

fn rustCsgAppServerUpsertScalarObjectIntoSection(currentToml: str, section: str, valueRaw: str, outToml: var str, outError: var str): bool =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '{':
        outError = "upsert value must be a JSON object"
        return false
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    outToml = currentToml
    while pos < valueRaw.len:
        if valueRaw[pos] == '}':
            return true
        if valueRaw[pos] != '"':
            outError = "upsert object keys must be strings"
            return false
        let keyEnd = rustCsgAppServerJsonStringEnd(valueRaw, pos)
        if keyEnd < 0:
            outError = "upsert object key is unterminated"
            return false
        let key = strings.SliceBytes(valueRaw, pos + 1, keyEnd - pos - 2)
        if !rustCsgAppServerConfigSimpleKeyPath(key):
            outError = "upsert object keys must be bare TOML keys"
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, keyEnd)
        if pos >= valueRaw.len || valueRaw[pos] != ':':
            outError = "upsert object entry missing colon"
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        let valueEnd = rustCsgAppServerJsonValueEnd(valueRaw, pos)
        if valueEnd < 0:
            outError = "upsert object values must be scalar"
            return false
        let rawValue = strings.SliceBytes(valueRaw, pos, valueEnd - pos)
        if rawValue == "" || rawValue == "null" || rawValue[0] == '{':
            outError = "upsert object values must be scalar"
            return false
        if rawValue[0] == '[':
            var arrayError: str
            if !rustCsgAppServerConfigArraySupported(rawValue, arrayError):
                outError = arrayError
                return false
        outToml = rustCsgAppServerSetConfigSectionLineInText(outToml, section, key, rawValue)
        pos = wire.RustCsgSkipJsonSpace(valueRaw, valueEnd)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == '}':
            continue
        else:
            outError = "upsert object is malformed"
            return false
    outError = "upsert object is unterminated"
    return false

fn rustCsgAppServerSetConfigLineInText(currentToml: str, key: str, valueRaw: str): str =
    let newLine = rustCsgAppServerConfigTomlLine(key, valueRaw)
    if currentToml == "":
        return wire.RustCsgCat(newLine, "\n")

    var outContent: str = ""
    var i: int32 = 0
    var lineStart: int32 = 0
    var replaced: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if !replaced:
                var pos: int32
                while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
                    pos = pos + 1
                if pos < line.len && line[pos] == '[':
                    outContent = wire.RustCsgCat(outContent, newLine)
                    replaced = true
                    outContent = wire.RustCsgCat(outContent, "\n")
                if pos < line.len && line[pos] != '[' && line[pos] != '#':
                    let trimmed = strings.SliceBytes(line, pos, line.len - pos)
                    if trimmed.len > key.len:
                        if strings.SliceBytes(trimmed, 0, key.len) == key:
                            var afterKey: int32 = key.len
                            while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
                                afterKey = afterKey + 1
                            if afterKey < trimmed.len && trimmed[afterKey] == '=':
                                outContent = wire.RustCsgCat(outContent, newLine)
                                replaced = true
                                outContent = wire.RustCsgCat(outContent, "\n")
                                i = i + 1
                                lineStart = i
                                continue
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if !replaced:
            var pos: int32
            while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
                pos = pos + 1
            if pos < line.len && line[pos] == '[':
                outContent = wire.RustCsgCat(outContent, newLine)
                replaced = true
                outContent = wire.RustCsgCat(outContent, "\n")
            if pos < line.len && line[pos] != '[' && line[pos] != '#':
                let trimmed = strings.SliceBytes(line, pos, line.len - pos)
                if trimmed.len > key.len:
                    if strings.SliceBytes(trimmed, 0, key.len) == key:
                        var afterKey: int32 = key.len
                        while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
                            afterKey = afterKey + 1
                        if afterKey < trimmed.len && trimmed[afterKey] == '=':
                            outContent = wire.RustCsgCat(outContent, newLine)
                            replaced = true
                            outContent = wire.RustCsgCat(outContent, "\n")
                            lineStart = currentToml.len
        if lineStart < currentToml.len:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    if !replaced:
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn rustCsgAppServerRemoveConfigLineInText(currentToml: str, key: str): str =
    if currentToml == "":
        return currentToml
    var outContent: str
    var i: int32
    var lineStart: int32
    var inRoot: bool = true
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if rustCsgAppServerTomlLineIsAnySection(line):
                inRoot = false
            if !(inRoot && rustCsgAppServerTomlLineMatchesBareKey(line, key)):
                outContent = wire.RustCsgCat(outContent, line)
                outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if rustCsgAppServerTomlLineIsAnySection(line):
            inRoot = false
        if !(inRoot && rustCsgAppServerTomlLineMatchesBareKey(line, key)):
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn rustCsgAppServerSetConfigSectionLineInText(currentToml: str, section: str, key: str, valueRaw: str): str =
    let header = wire.RustCsgCat3("[", section, "]")
    let newLine = rustCsgAppServerConfigTomlLine(key, valueRaw)
    if currentToml == "":
        return wire.RustCsgCat4(header, "\n", newLine, "\n")
    var outContent: str
    var i: int32
    var lineStart: int32
    var inSection: bool
    var seenSection: bool
    var replaced: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if rustCsgAppServerTomlLineIsAnySection(line):
                if inSection && !replaced:
                    outContent = wire.RustCsgCat(outContent, newLine)
                    outContent = wire.RustCsgCat(outContent, "\n")
                    replaced = true
                inSection = rustCsgAppServerTomlLineIsSection(line, section)
                if inSection:
                    seenSection = true
            elif inSection && !replaced && rustCsgAppServerTomlLineMatchesBareKey(line, key):
                outContent = wire.RustCsgCat(outContent, newLine)
                outContent = wire.RustCsgCat(outContent, "\n")
                replaced = true
                i = i + 1
                lineStart = i
                continue
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if rustCsgAppServerTomlLineIsAnySection(line):
            if inSection && !replaced:
                outContent = wire.RustCsgCat(outContent, newLine)
                outContent = wire.RustCsgCat(outContent, "\n")
                replaced = true
            inSection = rustCsgAppServerTomlLineIsSection(line, section)
            if inSection:
                seenSection = true
        elif inSection && !replaced && rustCsgAppServerTomlLineMatchesBareKey(line, key):
            outContent = wire.RustCsgCat(outContent, newLine)
            outContent = wire.RustCsgCat(outContent, "\n")
            replaced = true
            lineStart = currentToml.len
        if lineStart < currentToml.len:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    if seenSection && inSection && !replaced:
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
        replaced = true
    if !seenSection:
        outContent = wire.RustCsgCat(outContent, header)
        outContent = wire.RustCsgCat(outContent, "\n")
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn rustCsgAppServerRemoveConfigSectionLineInText(currentToml: str, section: str, key: str): str =
    if currentToml == "":
        return currentToml
    var outContent: str
    var i: int32
    var lineStart: int32
    var inSection: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if rustCsgAppServerTomlLineIsAnySection(line):
                inSection = rustCsgAppServerTomlLineIsSection(line, section)
            if !(inSection && rustCsgAppServerTomlLineMatchesBareKey(line, key)):
                outContent = wire.RustCsgCat(outContent, line)
                outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if rustCsgAppServerTomlLineIsAnySection(line):
            inSection = rustCsgAppServerTomlLineIsSection(line, section)
        if !(inSection && rustCsgAppServerTomlLineMatchesBareKey(line, key)):
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn rustCsgAppServerSetConfigSectionBodyInText(currentToml: str, section: str, body: str): str =
    let header = wire.RustCsgCat3("[", section, "]")
    if currentToml == "":
        return wire.RustCsgCat4(header, "\n", body, "")
    var outContent: str
    var i: int32
    var lineStart: int32
    var inTarget: bool
    var seenTarget: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if rustCsgAppServerTomlLineIsAnySection(line):
                inTarget = rustCsgAppServerTomlLineIsSection(line, section)
                if inTarget:
                    if !seenTarget:
                        outContent = wire.RustCsgCat(outContent, header)
                        outContent = wire.RustCsgCat(outContent, "\n")
                        outContent = wire.RustCsgCat(outContent, body)
                        seenTarget = true
                    i = i + 1
                    lineStart = i
                    continue
            if !inTarget:
                outContent = wire.RustCsgCat(outContent, line)
                outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if rustCsgAppServerTomlLineIsAnySection(line):
            inTarget = rustCsgAppServerTomlLineIsSection(line, section)
            if inTarget:
                if !seenTarget:
                    outContent = wire.RustCsgCat(outContent, header)
                    outContent = wire.RustCsgCat(outContent, "\n")
                    outContent = wire.RustCsgCat(outContent, body)
                    seenTarget = true
                lineStart = currentToml.len
        if lineStart < currentToml.len && !inTarget:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    if !seenTarget:
        outContent = wire.RustCsgCat(outContent, header)
        outContent = wire.RustCsgCat(outContent, "\n")
        outContent = wire.RustCsgCat(outContent, body)
    return outContent

fn rustCsgAppServerRemoveConfigSectionTreeInText(currentToml: str, section: str): str =
    if currentToml == "":
        return currentToml
    var outContent: str
    var i: int32
    var lineStart: int32
    var inRemovedTree: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            let sectionName = rustCsgAppServerTomlLineSectionName(line)
            if sectionName != "":
                inRemovedTree = rustCsgAppServerTomlSectionIsPrefix(sectionName, section)
            if !inRemovedTree:
                outContent = wire.RustCsgCat(outContent, line)
                outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        let sectionName = rustCsgAppServerTomlLineSectionName(line)
        if sectionName != "":
            inRemovedTree = rustCsgAppServerTomlSectionIsPrefix(sectionName, section)
        if !inRemovedTree:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    return outContent

fn rustCsgAppServerSectionAppendObjectKey(section: str, key: str, outError: var str): str =
    if !rustCsgAppServerConfigObjectKeySupported(key):
        outError = "object key cannot be represented as a TOML section segment"
        return ""
    let segment = rustCsgAppServerTomlSectionSegment(key, outError)
    if outError != "":
        return ""
    return wire.RustCsgCat3(section, ".", segment)

fn rustCsgAppServerWriteObjectIntoSections(currentToml: str, section: str, valueRaw: str, outToml: var str, outError: var str): bool =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '{':
        outError = "config object value must be a JSON object"
        return false
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    outToml = currentToml
    while pos < valueRaw.len:
        if valueRaw[pos] == '}':
            return true
        if valueRaw[pos] != '"':
            outError = "config object keys must be strings"
            return false
        let keyEnd = rustCsgAppServerJsonStringEnd(valueRaw, pos)
        if keyEnd < 0:
            outError = "config object key is unterminated"
            return false
        let key = strings.SliceBytes(valueRaw, pos + 1, keyEnd - pos - 2)
        pos = wire.RustCsgSkipJsonSpace(valueRaw, keyEnd)
        if pos >= valueRaw.len || valueRaw[pos] != ':':
            outError = "config object entry missing colon"
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        if pos >= valueRaw.len:
            outError = "config object value is missing"
            return false
        if valueRaw[pos] == '{':
            let objectEnd = rustCsgAppServerJsonObjectEnd(valueRaw, pos)
            if objectEnd < 0:
                outError = "config object child is unterminated"
                return false
            let childValue = strings.SliceBytes(valueRaw, pos, objectEnd - pos + 1)
            let childSection = rustCsgAppServerSectionAppendObjectKey(section, key, outError)
            if outError != "":
                return false
            var nextToml: str
            if !rustCsgAppServerWriteObjectIntoSections(outToml, childSection, childValue, nextToml, outError):
                return false
            outToml = nextToml
            pos = wire.RustCsgSkipJsonSpace(valueRaw, objectEnd + 1)
        else:
            let valueEnd = rustCsgAppServerJsonValueEnd(valueRaw, pos)
            if valueEnd < 0:
                outError = "config object scalar value is malformed"
                return false
            let rawValue = strings.SliceBytes(valueRaw, pos, valueEnd - pos)
            if rawValue == "" || rawValue == "null":
                outError = "config object scalar values must not be null"
                return false
            if rawValue[0] == '[':
                var arrayError: str
                if !rustCsgAppServerConfigArraySupported(rawValue, arrayError):
                    outError = arrayError
                    return false
            if !rustCsgAppServerConfigSimpleKeyPath(key):
                outError = "config object scalar keys must be bare TOML keys"
                return false
            outToml = rustCsgAppServerSetConfigSectionLineInText(outToml, section, key, rawValue)
            pos = wire.RustCsgSkipJsonSpace(valueRaw, valueEnd)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == '}':
            continue
        else:
            outError = "config object is malformed"
            return false
    outError = "config object is unterminated"
    return false

fn rustCsgAppServerUpsertNestedObjectSections(currentToml: str, baseSection: str, valueRaw: str, outToml: var str, outError: var str): bool =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(valueRaw, 0)
    if pos >= valueRaw.len || valueRaw[pos] != '{':
        outError = "nested upsert value must be a JSON object"
        return false
    pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
    outToml = currentToml
    while pos < valueRaw.len:
        if valueRaw[pos] == '}':
            return true
        if valueRaw[pos] != '"':
            outError = "nested upsert object keys must be strings"
            return false
        let keyEnd = rustCsgAppServerJsonStringEnd(valueRaw, pos)
        if keyEnd < 0:
            outError = "nested upsert key is unterminated"
            return false
        let key = strings.SliceBytes(valueRaw, pos + 1, keyEnd - pos - 2)
        var quoteError: str
        let quotedKey = rustCsgAppServerTomlQuotedSectionSegment(key, quoteError)
        if quoteError != "":
            outError = quoteError
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, keyEnd)
        if pos >= valueRaw.len || valueRaw[pos] != ':':
            outError = "nested upsert entry missing colon"
            return false
        pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        if pos >= valueRaw.len || valueRaw[pos] != '{':
            outError = "nested upsert entries must be objects"
            return false
        let valueEnd = rustCsgAppServerJsonObjectEnd(valueRaw, pos)
        if valueEnd < 0:
            outError = "nested upsert entry object is unterminated"
            return false
        let childValue = strings.SliceBytes(valueRaw, pos, valueEnd - pos + 1)
        let section = wire.RustCsgCat3(baseSection, ".", quotedKey)
        var nextToml: str
        if !rustCsgAppServerUpsertScalarObjectIntoSection(outToml, section, childValue, nextToml, outError):
            return false
        outToml = nextToml
        pos = wire.RustCsgSkipJsonSpace(valueRaw, valueEnd + 1)
        if pos < valueRaw.len && valueRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(valueRaw, pos + 1)
        elif pos < valueRaw.len && valueRaw[pos] == '}':
            continue
        else:
            outError = "nested upsert object is malformed"
            return false
    outError = "nested upsert object is unterminated"
    return false

fn rustCsgAppServerClearConfigPathInText(currentToml: str, keyPath: str, outToml: var str, outError: var str): bool =
    let kind = rustCsgAppServerConfigPathKind(keyPath)
    if kind == "top":
        outToml = rustCsgAppServerRemoveConfigLineInText(currentToml, keyPath)
        return true
    var parseError: str
    let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, parseError)
    if parseError != "":
        outError = parseError
        return false
    let fullSection = rustCsgAppServerConfigPathSection(keyPath, count, parseError)
    if parseError != "":
        outError = parseError
        return false
    var cleanToml = rustCsgAppServerRemoveConfigSectionTreeInText(currentToml, fullSection)
    if count >= 2:
        let parentSection = rustCsgAppServerConfigPathSection(keyPath, count - 1, parseError)
        if parseError != "":
            outError = parseError
            return false
        let leaf = rustCsgAppServerConfigPathLastSegment(keyPath, parseError)
        if parseError != "":
            outError = parseError
            return false
        if rustCsgAppServerConfigSimpleKeyPath(leaf):
            cleanToml = rustCsgAppServerRemoveConfigSectionLineInText(cleanToml, parentSection, leaf)
    outToml = cleanToml
    return true

fn rustCsgAppServerSetConfigPathInTextWithStrategy(currentToml: str, keyPath: str, valueRaw: str, mergeStrategy: str, outToml: var str, outError: var str): bool =
    let kind = rustCsgAppServerConfigPathKind(keyPath)
    if valueRaw == "null":
        return rustCsgAppServerClearConfigPathInText(currentToml, keyPath, outToml, outError)
    if kind == "top":
        if valueRaw[0] == '{':
            var baseToml = rustCsgAppServerRemoveConfigLineInText(currentToml, keyPath)
            if mergeStrategy == "replace":
                baseToml = rustCsgAppServerRemoveConfigSectionTreeInText(baseToml, keyPath)
            return rustCsgAppServerWriteObjectIntoSections(baseToml, keyPath, valueRaw, outToml, outError)
        outToml = rustCsgAppServerSetConfigLineInText(currentToml, keyPath, valueRaw)
        return true
    if kind == "desktop":
        let leaf = rustCsgAppServerConfigPathLeaf(keyPath)
        if valueRaw[0] == '{':
            if mergeStrategy == "upsert":
                let childSectionForUpsert = wire.RustCsgCat3("desktop", ".", leaf)
                return rustCsgAppServerUpsertScalarObjectIntoSection(currentToml, childSectionForUpsert, valueRaw, outToml, outError)
            let body = rustCsgAppServerJsonObjectToTomlSectionBody(valueRaw, outError)
            if outError != "":
                return false
            let cleanToml = rustCsgAppServerRemoveConfigSectionLineInText(currentToml, "desktop", leaf)
            let childSection = wire.RustCsgCat3("desktop", ".", leaf)
            outToml = rustCsgAppServerSetConfigSectionBodyInText(cleanToml, childSection, body)
            return true
        outToml = rustCsgAppServerSetConfigSectionLineInText(currentToml, "desktop", leaf, valueRaw)
        return true
    if kind == "plugins":
        if valueRaw[0] != '{':
            outError = "plugins.* value must be a JSON object"
            return false
        let leaf = rustCsgAppServerConfigPathLeaf(keyPath)
        var quoteError: str
        let quotedLeaf = rustCsgAppServerTomlQuotedSectionSegment(leaf, quoteError)
        if quoteError != "":
            outError = quoteError
            return false
        let section = wire.RustCsgCat("plugins.", quotedLeaf)
        if mergeStrategy == "upsert":
            return rustCsgAppServerUpsertScalarObjectIntoSection(currentToml, section, valueRaw, outToml, outError)
        let body = rustCsgAppServerJsonObjectToTomlSectionBody(valueRaw, outError)
        if outError != "":
            return false
        outToml = rustCsgAppServerSetConfigSectionBodyInText(currentToml, section, body)
        return true
    if kind == "hooks_state":
        if valueRaw[0] != '{':
            outError = "hooks.state value must be a JSON object"
            return false
        if mergeStrategy != "upsert":
            outError = "hooks.state supports mergeStrategy upsert only"
            return false
        return rustCsgAppServerUpsertNestedObjectSections(currentToml, "hooks.state", valueRaw, outToml, outError)
    if kind == "generic":
        if valueRaw[0] == '{':
            var sectionError: str
            let count = rustCsgAppServerConfigParsedSegmentCount(keyPath, sectionError)
            if sectionError != "":
                outError = sectionError
                return false
            let section = rustCsgAppServerConfigPathSection(keyPath, count, sectionError)
            if sectionError != "":
                outError = sectionError
                return false
            var baseToml = currentToml
            if mergeStrategy == "replace":
                baseToml = rustCsgAppServerRemoveConfigSectionTreeInText(currentToml, section)
            return rustCsgAppServerWriteObjectIntoSections(baseToml, section, valueRaw, outToml, outError)
        var scalarError: str
        let parentSection = rustCsgAppServerConfigPathParentSection(keyPath, scalarError)
        if scalarError != "":
            outError = scalarError
            return false
        let key = rustCsgAppServerConfigPathLastSegment(keyPath, scalarError)
        if scalarError != "":
            outError = scalarError
            return false
        if !rustCsgAppServerConfigSimpleKeyPath(key):
            outError = "config scalar keyPath leaf must be a bare TOML key"
            return false
        outToml = rustCsgAppServerSetConfigSectionLineInText(currentToml, parentSection, key, valueRaw)
        return true
    outError = "unsupported config keyPath"
    return false

fn rustCsgAppServerSetConfigPathInText(currentToml: str, keyPath: str, valueRaw: str, outToml: var str, outError: var str): bool =
    return rustCsgAppServerSetConfigPathInTextWithStrategy(currentToml, keyPath, valueRaw, "replace", outToml, outError)

fn rustCsgAppServerWriteConfigLine(configPath: str, key: str, valueRaw: str): int32 =
    var currentToml: str = home.RustCsgReadFile(configPath)
    var outContent: str
    var pathError: str
    if !rustCsgAppServerSetConfigPathInText(currentToml, key, valueRaw, outContent, pathError):
        return 0
    return rustCsgAppServerWriteFile(configPath, outContent)

fn rustCsgAppServerConfigWriteResponse(id: int32, configPath: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, "\"status\":\"ok\"")
    out = wire.RustCsgCat(out, ",\"version\":\"1\"")
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("filePath", wire.RustCsgJsonQuote(configPath)))
    out = wire.RustCsgCat(out, ",\"overriddenMetadata\":null")
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerHandleConfigWrite(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let key = wire.RustCsgJsonFindStr(paramsJson, "key")
    if key == "":
        return rustCsgAppServerError(id, -32602, "config/write requires key")
    var value = wire.RustCsgJsonFindOptionalStr(paramsJson, "value")
    if value == "":
        value = wire.RustCsgJsonFindOptionalStr(paramsJson, "valueJson")
    if value == "":
        return rustCsgAppServerError(id, -32602, "config/write requires value or valueJson")
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        return rustCsgAppServerError(id, -32603, homeError)
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    var currentToml: str = home.RustCsgReadFile(configPath)
    var newLine: str
    if value[0] == '"':
        newLine = wire.RustCsgCat3(key, " = ", value)
    else:
        newLine = wire.RustCsgCat4(key, " = \"", value, "\"")
    if currentToml == "":
        let writeOk = rustCsgAppServerWriteFile(configPath, wire.RustCsgCat(newLine, "\n"))
        if writeOk == 0:
            return rustCsgAppServerError(id, -32603, "failed to write config file")
        return rustCsgAppServerResponse(id, "{\"written\":true}")
    var outContent: str = ""
    var i: int32 = 0
    var lineStart: int32 = 0
    var replaced: bool
    while i < currentToml.len:
        if currentToml[i] == '\n':
            let line = strings.SliceBytes(currentToml, lineStart, i - lineStart)
            if !replaced:
                var pos: int32
                while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
                    pos = pos + 1
                if pos < line.len && line[pos] == '[':
                    outContent = wire.RustCsgCat(outContent, newLine)
                    replaced = true
                    outContent = wire.RustCsgCat(outContent, "\n")
                if pos < line.len && line[pos] != '[' && line[pos] != '#':
                    let trimmed = strings.SliceBytes(line, pos, line.len - pos)
                    if trimmed.len > key.len:
                        if strings.SliceBytes(trimmed, 0, key.len) == key:
                            var afterKey: int32 = key.len
                            while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
                                afterKey = afterKey + 1
                            if afterKey < trimmed.len && trimmed[afterKey] == '=':
                                outContent = wire.RustCsgCat(outContent, newLine)
                                replaced = true
                                outContent = wire.RustCsgCat(outContent, "\n")
                                i = i + 1
                                lineStart = i
                                continue
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
            i = i + 1
            lineStart = i
            continue
        i = i + 1
    if lineStart < currentToml.len:
        let line = strings.SliceBytes(currentToml, lineStart, currentToml.len - lineStart)
        if !replaced:
            var pos: int32
            while pos < line.len && (line[pos] == ' ' || line[pos] == '\t'):
                pos = pos + 1
            if pos < line.len && line[pos] == '[':
                outContent = wire.RustCsgCat(outContent, newLine)
                replaced = true
                outContent = wire.RustCsgCat(outContent, "\n")
            if pos < line.len && line[pos] != '[' && line[pos] != '#':
                let trimmed = strings.SliceBytes(line, pos, line.len - pos)
                if trimmed.len > key.len:
                    if strings.SliceBytes(trimmed, 0, key.len) == key:
                        var afterKey: int32 = key.len
                        while afterKey < trimmed.len && (trimmed[afterKey] == ' ' || trimmed[afterKey] == '\t'):
                            afterKey = afterKey + 1
                        if afterKey < trimmed.len && trimmed[afterKey] == '=':
                            outContent = wire.RustCsgCat(outContent, newLine)
                            replaced = true
                            outContent = wire.RustCsgCat(outContent, "\n")
                            lineStart = currentToml.len
        if lineStart < currentToml.len:
            outContent = wire.RustCsgCat(outContent, line)
            outContent = wire.RustCsgCat(outContent, "\n")
    if !replaced:
        outContent = wire.RustCsgCat(outContent, newLine)
        outContent = wire.RustCsgCat(outContent, "\n")
    let writeOk = rustCsgAppServerWriteFile(configPath, outContent)
    if writeOk == 0:
        return rustCsgAppServerError(id, -32603, "failed to write config file")
    return rustCsgAppServerResponse(id, "{\"written\":true}")

fn rustCsgAppServerValidateConfigEdit(method: str, editJson: str, outKeyPath: var str, outValueRaw: var str, outMergeStrategy: var str, outError: var str): bool =
    let keyPathRaw = wire.RustCsgJsonFindOptionalValueRaw(editJson, "keyPath")
    if keyPathRaw == "" || keyPathRaw == "null":
        outError = wire.RustCsgCat(method, " requires keyPath")
        return false
    if keyPathRaw[0] != '"':
        outError = wire.RustCsgCat(method, " keyPath must be string")
        return false
    let keyPath = wire.RustCsgJsonFindStr(editJson, "keyPath")
    let pathKind = rustCsgAppServerConfigPathKind(keyPath)
    if pathKind == "":
        outError = wire.RustCsgCat(method, " supports TOML-compatible keyPath segments only")
        return false
    let mergeStrategyRaw = wire.RustCsgJsonFindOptionalValueRaw(editJson, "mergeStrategy")
    if mergeStrategyRaw == "" || mergeStrategyRaw == "null":
        outError = wire.RustCsgCat(method, " requires mergeStrategy")
        return false
    if mergeStrategyRaw[0] != '"':
        outError = wire.RustCsgCat(method, " mergeStrategy must be string")
        return false
    let mergeStrategy = wire.RustCsgJsonFindStr(editJson, "mergeStrategy")
    if mergeStrategy != "replace" && mergeStrategy != "upsert":
        outError = wire.RustCsgCat(method, " supports mergeStrategy replace or upsert")
        return false
    let valueRaw = wire.RustCsgJsonFindOptionalValueRaw(editJson, "value")
    if valueRaw == "":
        outError = wire.RustCsgCat(method, " requires value")
        return false
    if valueRaw != "null":
        var legacyParseError: str
        let legacyCount = rustCsgAppServerConfigParsedSegmentCount(keyPath, legacyParseError)
        if legacyParseError != "":
            outError = wire.RustCsgCat(method, " supports TOML-compatible keyPath segments only")
            return false
        let firstSegment = rustCsgAppServerConfigParsedSegment(keyPath, 0, legacyParseError)
        if legacyParseError != "":
            outError = wire.RustCsgCat(method, " supports TOML-compatible keyPath segments only")
            return false
        if legacyCount == 1 && firstSegment == "profile":
            outError = wire.RustCsgCat(method, " `profile` is a legacy config selector and can no longer be written; use `--profile <name>` with `<name>.config.toml` instead")
            return false
        if firstSegment == "profiles":
            outError = wire.RustCsgCat(method, " `profiles` contains legacy config profile tables and can no longer be written; use `--profile <name>` with `<name>.config.toml` instead")
            return false
    if valueRaw[0] == '[':
        var arrayError: str
        if !rustCsgAppServerConfigArraySupported(valueRaw, arrayError):
            outError = wire.RustCsgCat3(method, " ", arrayError)
            return false
    outKeyPath = keyPath
    outValueRaw = valueRaw
    outMergeStrategy = mergeStrategy
    return true

fn rustCsgAppServerHandleConfigValueWrite(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    var keyPath: str
    var valueRaw: str
    var mergeStrategy: str
    var editError: str
    if !rustCsgAppServerValidateConfigEdit("config/value/write", paramsJson, keyPath, valueRaw, mergeStrategy, editError):
        return rustCsgAppServerError(id, -32602, editError)
    let expectedVersionRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "expectedVersion")
    var expectedVersion: str
    if expectedVersionRaw != "" && expectedVersionRaw != "null":
        expectedVersion = wire.RustCsgJsonFindStr(paramsJson, "expectedVersion")
    if expectedVersion != "" && expectedVersion != "1":
        return rustCsgAppServerError(id, -32602, "config version conflict")
    var configPath: str
    var pathError: str
    if !rustCsgAppServerConfigTargetPath(paramsJson, configPath, pathError):
        return rustCsgAppServerError(id, -32603, pathError)
    let currentToml = home.RustCsgReadFile(configPath)
    var outToml: str
    var setError: str
    if !rustCsgAppServerSetConfigPathInTextWithStrategy(currentToml, keyPath, valueRaw, mergeStrategy, outToml, setError):
        return rustCsgAppServerError(id, -32602, setError)
    var writeOk: int32 = 1
    if outToml != currentToml:
        writeOk = rustCsgAppServerWriteFile(configPath, outToml)
    if writeOk == 0:
        return rustCsgAppServerError(id, -32603, "failed to write config file")
    return rustCsgAppServerConfigWriteResponse(id, configPath)

fn rustCsgAppServerJsonObjectEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '{':
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32 = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return i
        i = i + 1
    return -1

fn rustCsgAppServerApplyBatchEdits(editsJson: str, initialToml: str, outToml: var str, outError: var str): bool =
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(editsJson, 0)
    if pos >= editsJson.len || editsJson[pos] != '[':
        outError = "config/batchWrite requires edits array"
        return false
    pos = wire.RustCsgSkipJsonSpace(editsJson, pos + 1)
    outToml = initialToml
    while pos < editsJson.len:
        if editsJson[pos] == ']':
            return true
        if editsJson[pos] != '{':
            outError = "config/batchWrite edits must be objects"
            return false
        let endPos = rustCsgAppServerJsonObjectEnd(editsJson, pos)
        if endPos < 0:
            outError = "config/batchWrite edit object is unterminated"
            return false
        let editJson = strings.SliceBytes(editsJson, pos, endPos - pos + 1)
        var keyPath: str
        var valueRaw: str
        var mergeStrategy: str
        if !rustCsgAppServerValidateConfigEdit("config/batchWrite", editJson, keyPath, valueRaw, mergeStrategy, outError):
            return false
        var nextToml: str
        var pathError: str
        if !rustCsgAppServerSetConfigPathInTextWithStrategy(outToml, keyPath, valueRaw, mergeStrategy, nextToml, pathError):
            outError = pathError
            return false
        outToml = nextToml
        pos = wire.RustCsgSkipJsonSpace(editsJson, endPos + 1)
        if pos < editsJson.len && editsJson[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(editsJson, pos + 1)
        elif pos < editsJson.len && editsJson[pos] == ']':
            return true
        else:
            outError = "config/batchWrite edits array is malformed"
            return false
    outError = "config/batchWrite edits array is unterminated"
    return false

fn rustCsgAppServerHandleConfigBatchWrite(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let expectedVersionRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "expectedVersion")
    var expectedVersion: str
    if expectedVersionRaw != "" && expectedVersionRaw != "null":
        expectedVersion = wire.RustCsgJsonFindStr(paramsJson, "expectedVersion")
    if expectedVersion != "" && expectedVersion != "1":
        return rustCsgAppServerError(id, -32602, "config version conflict")
    var configPath: str
    var pathError: str
    if !rustCsgAppServerConfigTargetPath(paramsJson, configPath, pathError):
        return rustCsgAppServerError(id, -32603, pathError)
    let editsJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "edits")
    if editsJson == "":
        return rustCsgAppServerError(id, -32602, "config/batchWrite requires edits array")
    let currentToml = home.RustCsgReadFile(configPath)
    var outToml: str
    var editError: str
    if !rustCsgAppServerApplyBatchEdits(editsJson, currentToml, outToml, editError):
        return rustCsgAppServerError(id, -32602, editError)
    var writeOk: int32 = 1
    if outToml != currentToml:
        writeOk = rustCsgAppServerWriteFile(configPath, outToml)
    if writeOk == 0:
        return rustCsgAppServerError(id, -32603, "failed to write config file")
    return rustCsgAppServerConfigWriteResponse(id, configPath)

# ── config/requirements ───────────────────────────────────────────────────

fn rustCsgAppServerHandleConfigRequirements(id: int32): str =
    return rustCsgAppServerResponse(id, "{\"requirements\":{}}")

# ── config/reset ──────────────────────────────────────────────────────────

fn rustCsgAppServerHandleConfigReset(id: int32, body: str): str =
    return rustCsgAppServerResponse(id, "{\"reset\":false,\"reason\":\"config reset requires config write support\"}")

# ── config/reload ───────────────────────────────────────────────────────

fn rustCsgAppServerHandleConfigReload(id: int32): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerResponse(id, wire.RustCsgCat3(
            "{\"reloaded\":false,\"reason\":", wire.RustCsgJsonQuote(pathError), "}"))
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return rustCsgAppServerResponse(id, "{\"reloaded\":false,\"reason\":\"config.toml not found or empty\"}")
    return rustCsgAppServerResponse(id, "{\"reloaded\":true}")
