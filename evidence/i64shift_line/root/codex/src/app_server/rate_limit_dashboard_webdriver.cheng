import cheng/codex/std/http
import cheng/codex/std/strings
import cheng/codex/protocol/wire

# W3C WebDriver client for rate limit dashboard browser-based login.
# Communicates with chromedriver/safaridriver via HTTP REST API.
# Aligns with Rust cf64150e9c codex-rs/app-server/src/rate_limit_dashboard/webdriver.rs.

const RustCsgWebDriverPollIntervalMs: int32 = 500
const RustCsgWebDriverRequestTimeoutSeconds: int32 = 120
const RustCsgWebDriverSessionRequestTimeoutSeconds: int32 = 25

@importc("RustCsgSleepMs")
fn RustCsgSleepMs(ms: int32): int32

fn RustCsgWebDriverSleepPoll(): bool =
    RustCsgSleepMs(RustCsgWebDriverPollIntervalMs)
    return true

# -- Browser capabilities for session creation --

fn RustCsgWebDriverChromeCapabilities(chromeBinary: str): str =
    var caps = wire.RustCsgCat(
        "{\"capabilities\":{\"alwaysMatch\":{",
        "\"browserName\":\"chrome\",\"acceptInsecureCerts\":true,\"pageLoadStrategy\":\"eager\"")
    if chromeBinary != "":
        caps = wire.RustCsgCat(caps,
            wire.RustCsgCat(",\"goog:chromeOptions\":{\"args\":[\"--disable-blink-features=AutomationControlled\",\"--remote-debugging-pipe\"],",
            wire.RustCsgCat("\"excludeSwitches\":[\"enable-automation\"],",
            wire.RustCsgCat("\"binary\":", wire.RustCsgCat(wire.RustCsgJsonQuote(chromeBinary), "}}")))))
    else:
        caps = wire.RustCsgCat(caps,
            ",\"goog:chromeOptions\":{\"args\":[\"--disable-blink-features=AutomationControlled\",\"--remote-debugging-pipe\"],\"excludeSwitches\":[\"enable-automation\"]}}")
    caps = wire.RustCsgCat(caps, "}}")
    return caps

fn RustCsgWebDriverSafariCapabilities(): str =
    return "{\"capabilities\":{\"alwaysMatch\":{\"browserName\":\"Safari\",\"acceptInsecureCerts\":true,\"pageLoadStrategy\":\"eager\"}}}"

# -- WebDriver HTTP helpers --

fn RustCsgWebDriverRequestJsonWithTimeout(baseUrl: str, sessionId: str, method: str, path: str, body: str, timeoutSeconds: int32, outValue: var str, outError: var str): bool =
    outValue = ""
    outError = ""
    var url = baseUrl
    if sessionId != "":
        url = wire.RustCsgCat(url, wire.RustCsgCat("/session/", wire.RustCsgCat(sessionId, path)))
    else:
        url = wire.RustCsgCat(url, path)
    var headers = "[\"Content-Type: application/json\"]"
    var result: http.HttpResult
    result = http.HttpRequestWithTimeout(method, url, body, headers, timeoutSeconds)
    if !result.ok:
        outError = wire.RustCsgCat("webdriver request failed: ", result.error)
        return false
    return RustCsgWebDriverDecodeResponseValue(result.statusCode, result.body, outValue, outError)

fn RustCsgWebDriverRequestJson(baseUrl: str, sessionId: str, method: str, path: str, body: str, outValue: var str, outError: var str): bool =
    return RustCsgWebDriverRequestJsonWithTimeout(baseUrl, sessionId, method, path, body, RustCsgWebDriverRequestTimeoutSeconds, outValue, outError)

fn RustCsgWebDriverDecodeResponseValue(statusCode: int32, body: str, outValue: var str, outError: var str): bool =
    outValue = ""
    outError = ""
    if body == "":
        outError = "failed to decode webdriver response: empty response body"
        return false
    let trimmedBody = RustCsgWebDriverTrimJsonResponse(body)
    if !RustCsgWebDriverJsonResponseStartIsValid(trimmedBody):
        outError = "failed to decode webdriver response: expected JSON value"
        return false
    var valueRaw = wire.RustCsgJsonFindOptionalValueRaw(body, "value")
    if valueRaw == "":
        valueRaw = "null"
    if valueRaw != "null":
        var webdriverError = wire.RustCsgJsonFindOptionalStr(valueRaw, "error")
        if webdriverError != "":
            var errMessage = wire.RustCsgJsonFindOptionalStr(valueRaw, "message")
            if errMessage == "":
                errMessage = "webdriver command failed"
            if wire.RustCsgContains(errMessage, "Allow remote automation"):
                outError = "Safari WebDriver requires Safari Settings > Developer > Allow Remote Automation"
                return false
            outError = wire.RustCsgCat("webdriver ", wire.RustCsgCat(webdriverError, wire.RustCsgCat(": ", errMessage)))
            return false
    if statusCode < 200 || statusCode >= 300:
        outError = wire.RustCsgCat("webdriver command failed with status ", strings.IntToStr(statusCode))
        return false
    outValue = valueRaw
    return true

fn RustCsgWebDriverTrimJsonResponse(value: str): str =
    var start: int32
    var end: int32 = value.len
    while start < end:
        let ch = value[start]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            break
        start = start + 1
    while end > start:
        let ch = value[end - 1]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            break
        end = end - 1
    return strings.SliceBytes(value, start, end - start)

fn RustCsgWebDriverJsonResponseStartIsValid(value: str): bool =
    if value == "":
        return false
    let first = value[0]
    if first == '{':
        var i: int32 = 1
        while i < value.len:
            let ch = value[i]
            if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
                return ch == '}' || ch == '"'
            i = i + 1
        return false
    if first == '[' || first == '"' || first == '-':
        return true
    if first >= '0' && first <= '9':
        return true
    if wire.RustCsgContains(value, "true"):
        return strings.SliceBytes(value, 0, 4) == "true"
    if wire.RustCsgContains(value, "false"):
        return strings.SliceBytes(value, 0, 5) == "false"
    if wire.RustCsgContains(value, "null"):
        return strings.SliceBytes(value, 0, 4) == "null"
    return false

fn RustCsgWebDriverGetJson(baseUrl: str, sessionId: str, path: str, outValue: var str, outError: var str): bool =
    return RustCsgWebDriverRequestJson(baseUrl, sessionId, "GET", path, "", outValue, outError)

fn RustCsgWebDriverPostJson(baseUrl: str, sessionId: str, path: str, body: str, outValue: var str, outError: var str): bool =
    return RustCsgWebDriverRequestJson(baseUrl, sessionId, "POST", path, body, outValue, outError)

fn RustCsgWebDriverPostJsonWithTimeout(baseUrl: str, sessionId: str, path: str, body: str, timeoutSeconds: int32, outValue: var str, outError: var str): bool =
    return RustCsgWebDriverRequestJsonWithTimeout(baseUrl, sessionId, "POST", path, body, timeoutSeconds, outValue, outError)

fn RustCsgWebDriverDelete(baseUrl: str, sessionId: str, path: str, outValue: var str, outError: var str): bool =
    return RustCsgWebDriverRequestJson(baseUrl, sessionId, "DELETE", path, "", outValue, outError)

# -- Session management --

fn RustCsgWebDriverIsReady(baseUrl: str): bool =
    var result = http.HttpGet(wire.RustCsgCat(baseUrl, "/status"), "[]")
    return result.ok && result.statusCode >= 200 && result.statusCode < 300

fn RustCsgWebDriverCreateSession(baseUrl: str, chromeBinary: str, isSafari: bool, outSessionId: var str, outError: var str): bool =
    outSessionId = ""
    outError = ""
    var caps: str
    if isSafari:
        caps = RustCsgWebDriverSafariCapabilities()
    else:
        caps = RustCsgWebDriverChromeCapabilities(chromeBinary)
    var valueRaw: str
    if !RustCsgWebDriverPostJsonWithTimeout(baseUrl, "", "/session", caps, RustCsgWebDriverSessionRequestTimeoutSeconds, valueRaw, outError):
        return false
    outSessionId = wire.RustCsgJsonFindOptionalStr(valueRaw, "sessionId")
    if outSessionId == "":
        outError = "webdriver did not return a session id"
        return false
    return true

fn RustCsgWebDriverDeleteSession(baseUrl: str, sessionId: str): bool =
    var outValue: str
    var outError: str
    return RustCsgWebDriverDelete(baseUrl, sessionId, "", outValue, outError)

# -- Navigation --

fn RustCsgWebDriverNavigateTo(baseUrl: str, sessionId: str, url: str, outError: var str): bool =
    outError = ""
    var body = wire.RustCsgCat("{\"url\":", wire.RustCsgCat(wire.RustCsgJsonQuote(url), "}"))
    var outValue: str
    return RustCsgWebDriverPostJson(baseUrl, sessionId, "/url", body, outValue, outError)

# -- Script execution --

fn RustCsgWebDriverExecuteScript(baseUrl: str, sessionId: str, script: str, args: str, outResult: var str, outError: var str): bool =
    outResult = ""
    outError = ""
    var body = wire.RustCsgCat(wire.RustCsgCat("{\"script\":", wire.RustCsgJsonQuote(script)), wire.RustCsgCat(",\"args\":", wire.RustCsgCat(args, "}")))
    return RustCsgWebDriverPostJson(baseUrl, sessionId, "/execute/sync", body, outResult, outError)

fn RustCsgWebDriverExecuteScriptJsonArgs(baseUrl: str, sessionId: str, script: str, argsJson: str, outResult: var str, outError: var str): bool =
    return RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, argsJson, outResult, outError)

fn RustCsgWebDriverRawStringValue(raw: str): str =
    if raw.len >= 2 && raw[0] == '"' && raw[raw.len - 1] == '"':
        return strings.SliceBytes(raw, 1, raw.len - 2)
    return raw

# -- Simple page state (for error detection) --

fn RustCsgWebDriverSimplePageState(baseUrl: str, sessionId: str, outUrl: var str, outTitle: var str, outBodyText: var str, outError: var str): bool =
    outUrl = ""
    outTitle = ""
    outBodyText = ""
    outError = ""
    var result: str
    if !RustCsgWebDriverExecuteScript(baseUrl, sessionId,
        "const isVisible=(e)=>{if(!(e instanceof Element))return false;const s=window.getComputedStyle(e);if(s.display==='none'||s.visibility==='hidden'||s.pointerEvents==='none')return false;if('disabled' in e&&e.disabled)return false;const r=e.getBoundingClientRect();return r.width>0&&r.height>0};return{url:window.location.href||'',title:document.title||'',bodyText:(document.body?.innerText||'').replace(/\\s+/g,' ').trim()};",
        "[]", result, outError):
        return false
    outUrl = wire.RustCsgJsonFindOptionalStr(result, "url")
    outTitle = wire.RustCsgJsonFindOptionalStr(result, "title")
    outBodyText = wire.RustCsgJsonFindOptionalStr(result, "bodyText")
    return true

# -- Element interaction helpers --

fn RustCsgWebDriverClickElement(baseUrl: str, sessionId: str, elementRef: str, outError: var str): bool =
    outError = ""
    var outValue: str
    return RustCsgWebDriverPostJson(baseUrl, sessionId,
        wire.RustCsgCat("/element/", wire.RustCsgCat(elementRef, "/click")),
        "{}", outValue, outError)

# Extract element reference ID (W3C key or legacy ELEMENT)
fn RustCsgWebDriverElementReferenceId(element: str): str =
    let w3cKey = "element-6066-11e4-a52e-4f735466cecf"
    var id = wire.RustCsgJsonFindOptionalStr(element, w3cKey)
    if id != "":
        return id
    id = wire.RustCsgJsonFindOptionalStr(element, "ELEMENT")
    return id

# -- Window/tab management --

fn RustCsgWebDriverCurrentWindowHandle(baseUrl: str, sessionId: str, outHandle: var str, outError: var str): bool =
    outHandle = ""
    outError = ""
    var raw: str
    if !RustCsgWebDriverGetJson(baseUrl, sessionId, "/window", raw, outError):
        return false
    outHandle = RustCsgWebDriverRawStringValue(raw)
    return true

fn RustCsgWebDriverSwitchToWindow(baseUrl: str, sessionId: str, handle: str, outError: var str): bool =
    outError = ""
    var body = wire.RustCsgCat("{\"handle\":", wire.RustCsgCat(wire.RustCsgJsonQuote(handle), "}"))
    var outValue: str
    return RustCsgWebDriverPostJson(baseUrl, sessionId, "/window", body, outValue, outError)

fn RustCsgWebDriverOpenNewTab(baseUrl: str, sessionId: str, outHandle: var str, outError: var str): bool =
    outHandle = ""
    outError = ""
    var outValue: str
    if !RustCsgWebDriverPostJson(baseUrl, sessionId, "/window/new", "{\"type\":\"tab\"}", outValue, outError):
        return false
    outHandle = wire.RustCsgJsonFindOptionalStr(outValue, "handle")
    return outHandle != ""

fn RustCsgWebDriverWindowHandles(baseUrl: str, sessionId: str, outHandles: var str, outError: var str): bool =
    outHandles = ""
    outError = ""
    return RustCsgWebDriverGetJson(baseUrl, sessionId, "/window/handles", outHandles, outError)

# -- Frame management --

fn RustCsgWebDriverSwitchToFrame(baseUrl: str, sessionId: str, frameId: str, outError: var str): bool =
    outError = ""
    var body = wire.RustCsgCat("{\"id\":", wire.RustCsgCat(wire.RustCsgJsonQuote(frameId), "}"))
    var outValue: str
    return RustCsgWebDriverPostJson(baseUrl, sessionId, "/frame", body, outValue, outError)

fn RustCsgWebDriverSwitchToDefaultContent(baseUrl: str, sessionId: str, outError: var str): bool =
    outError = ""
    var outValue: str
    return RustCsgWebDriverPostJson(baseUrl, sessionId, "/frame", "{\"id\":null}", outValue, outError)

# -- Polling helpers --

fn RustCsgWebDriverPollUntilTrue(baseUrl: str, sessionId: str, script: str, argsJson: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, argsJson, result, outError):
            return false
        if result == "true":
            return true
        RustCsgWebDriverSleepPoll()
        elapsed = elapsed + RustCsgWebDriverPollIntervalMs
    outError = "poll timed out"
    return false

fn RustCsgWebDriverPollScriptResult(baseUrl: str, sessionId: str, script: str, argsJson: str, expectedStatus: str, timeoutMs: int32, outResult: var str, outError: var str): bool =
    outResult = ""
    outError = ""
    var elapsed: int32
    while elapsed < timeoutMs:
        if !RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, argsJson, outResult, outError):
            return false
        var status = wire.RustCsgJsonFindOptionalStr(outResult, "status")
        if status == expectedStatus:
            return true
        RustCsgWebDriverSleepPoll()
        elapsed = elapsed + RustCsgWebDriverPollIntervalMs
    outError = wire.RustCsgCat("poll timed out waiting for status: ", expectedStatus)
    return false
