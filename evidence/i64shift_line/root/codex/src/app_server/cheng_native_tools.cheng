@abi_internal
@importc("RustCsgCreateTempFile")
fn ChengNativeCreateTempFile(prefix: str): str

@importc("RustCsgGetCurrentTimeMs")
fn ChengNativeNowMs(): int64

@abi_internal
@importc("RustCsgWriteFile")
fn ChengNativeWriteFile(path: str, content: str): int32

@importc("RustCsgFileExists")
fn ChengNativeFileExists(path: str): int32

fn ChengNativeToolSpec(name: str, description: str, schema: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("inputSchema", schema))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengNativeObjectSchema(requiredRaw: str, propertiesRaw: str): str =
    var out = "{\"type\":\"object\",\"properties\":"
    out = wire.RustCsgCat(out, propertiesRaw)
    out = wire.RustCsgCat(out, ",\"required\":")
    out = wire.RustCsgCat(out, requiredRaw)
    out = wire.RustCsgCat(out, ",\"additionalProperties\":false}")
    return out

fn ChengNativeToolSpecsJson(): str =
    return registry.ChengToolRegistryCoreSpecsJson("control")

fn ChengNativeToolSpecsArrayRaw(): str =
    let specs = ChengNativeToolSpecsJson()
    return specs

fn ChengNativeDataLoopToolSpecsJson(): str =
    return registry.ChengToolRegistryDataLoopSpecsJson("control")

fn ChengNativeIsTool(tool: str): bool =
    return registry.ChengToolRegistryIsTool(tool)

fn ChengNativeIsReadOnlyTool(tool: str): bool =
    return registry.ChengToolRegistryIsReadOnly(tool)

fn ChengNativeToolAllowedForRole(tool: str, role: str): bool =
    return registry.ChengToolRegistryToolAllowedForRole(tool, role)

fn ChengNativeInputLooksRelevant(inputRaw: str): bool =
    return strings.StrContains(inputRaw, ".cheng") ||
           strings.StrContains(inputRaw, "Cheng") ||
           strings.StrContains(inputRaw, "CSGC") ||
           strings.StrContains(inputRaw, "cheng_") ||
           strings.StrContains(inputRaw, "ts-csg") ||
           strings.StrContains(inputRaw, "TS-CSG") ||
           strings.StrContains(inputRaw, "TypeScript") ||
           strings.StrContains(inputRaw, "training trace") ||
           strings.StrContains(inputRaw, "eval case") ||
           strings.StrContains(inputRaw, "agent trace")

fn ChengNativeAppendToolsForInput(dynamicToolsJson: str, inputRaw: str): str =
    return ChengNativeAppendToolsForRole(dynamicToolsJson, inputRaw, "control")

fn ChengNativeAppendToolsForRole(dynamicToolsJson: str, inputRaw: str, role: str): str =
    if !ChengNativeInputLooksRelevant(inputRaw):
        return dynamicToolsJson
    var specs = registry.ChengToolRegistryCoreSpecsJson(role)
    if strings.StrContains(inputRaw, "training trace") ||
       strings.StrContains(inputRaw, "eval case") ||
       strings.StrContains(inputRaw, "agent trace"):
        specs = registry.ChengToolRegistryDataLoopSpecsJson(role)
    if dynamicToolsJson == "" || dynamicToolsJson == "[]":
        return specs
    let p = dynamicToolsJson.len - 1
    if p >= 0 && dynamicToolsJson[p] == ']':
        let prefix = strings.SliceBytes(dynamicToolsJson, 0, p)
        if prefix == "[":
            return specs
        let specBody = strings.SliceBytes(specs, 1, specs.len - 2)
        return wire.RustCsgCat3(prefix, ",", wire.RustCsgCat(specBody, "]"))
    return dynamicToolsJson

fn ChengNativeSuccessText(id: int32, text: str): str =
    var result = "{\"contentItems\":[{\"type\":\"inputText\",\"text\":"
    result = wire.RustCsgCat(result, wire.RustCsgJsonQuote(text))
    result = wire.RustCsgCat(result, "}],\"success\":true}")
    return wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), wire.RustCsgCat(",\"result\":", wire.RustCsgCat(result, "}")))

fn ChengNativeFailureText(id: int32, message: str): str =
    var result = "{\"contentItems\":[{\"type\":\"inputText\",\"text\":"
    result = wire.RustCsgCat(result, wire.RustCsgJsonQuote(message))
    result = wire.RustCsgCat(result, "}],\"success\":false}")
    return wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), wire.RustCsgCat(",\"result\":", wire.RustCsgCat(result, "}")))

fn ChengNativeTextStartsWith(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn ChengNativeTempArtifactPath(path: str): bool =
    return ChengNativeTextStartsWith(path, "/tmp/") ||
           ChengNativeTextStartsWith(path, "/var/tmp/")

fn ChengNativeResolveRoot(args: str): str =
    let root = wire.RustCsgJsonFindOptionalStr(args, "root")
    if root != "":
        return root
    return resolver.ChengToolchainCurrentRoot()

fn ChengNativeRootAvailable(root: str): bool =
    return root != "" && ChengNativeFileExists(root) == 1

fn ChengNativeTsCsgEvidenceSource(emit: str): str =
    if emit == "cheng-source":
        return "ts_csg_cheng_source"
    if emit == "cheng-csg":
        return "ts_csg_cheng_csg"
    return "ts_csg_emit"

fn ChengNativeTsCsgCwd(root: str): str =
    return resolver.ChengToolchainPathJoin(root, "ts-csg")

fn ChengNativeHandleTsCsgEmit(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let projectPath = wire.RustCsgJsonFindOptionalStr(args, "project")
    if projectPath == "":
        return ChengNativeFailureText(requestId, "ts_csg_emit: missing project")
    var emit = wire.RustCsgJsonFindOptionalStr(args, "emit")
    if emit == "":
        emit = "csg-core"
    var outputPath = wire.RustCsgJsonFindOptionalStr(args, "out")
    if outputPath == "":
        outputPath = ChengNativeCreateTempFile("ts-csg-")
        if outputPath == "":
            return ChengNativeFailureText(requestId, "ts_csg_emit: failed to allocate temporary output")
    elif !ChengNativeTempArtifactPath(outputPath):
        return ChengNativeFailureText(requestId, "ts_csg_emit: out must be a temporary artifact path")
    var reportPath = wire.RustCsgJsonFindOptionalStr(args, "reportOut")
    if reportPath == "":
        reportPath = wire.RustCsgCat(outputPath, ".report.json")
    elif !ChengNativeTempArtifactPath(reportPath):
        return ChengNativeFailureText(requestId, "ts_csg_emit: reportOut must be a temporary artifact path")
    var runtime = wire.RustCsgJsonFindOptionalStr(args, "runtime")
    if runtime == "":
        runtime = "node,browser"
    let node = resolver.ChengToolchainResolveNodeCommand(root)
    if !node.ok:
        return ChengNativeFailureText(requestId, node.error)
    let cli = resolver.ChengToolchainResolveTsCsgCli(root)
    if !cli.ok:
        return ChengNativeFailureText(requestId, cli.error)
    var procArgs: str[]
    add(procArgs, cli.path)
    add(procArgs, "--emit")
    add(procArgs, emit)
    add(procArgs, "--project")
    add(procArgs, projectPath)
    add(procArgs, "--runtime")
    add(procArgs, runtime)
    let entryRoot = wire.RustCsgJsonFindOptionalStr(args, "entryRoot")
    if entryRoot != "":
        add(procArgs, "--entry-root")
        add(procArgs, entryRoot)
    add(procArgs, "--out")
    add(procArgs, outputPath)
    add(procArgs, "--report-out")
    add(procArgs, reportPath)
    let result = process.ProcessSpawn(node.path, procArgs, ChengNativeTsCsgCwd(root), [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("ts_csg_emit failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("ts_csg_emit failed: ", result.stderr))
    let evidence = ledger.ChengEvidenceLedgerAdd(ChengNativeTsCsgEvidenceSource(emit),
                                                 projectPath,
                                                 0,
                                                 0,
                                                 "",
                                                 "",
                                                 "",
                                                 reportPath,
                                                 wire.RustCsgCat("ts-csg --emit ", emit),
                                                 "ok",
                                                 outputPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleTsCsgRuntimeClosure(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let projectPath = wire.RustCsgJsonFindOptionalStr(args, "project")
    if projectPath == "":
        return ChengNativeFailureText(requestId, "ts_csg_runtime_closure: missing project")
    var outputPath = wire.RustCsgJsonFindOptionalStr(args, "out")
    if outputPath == "":
        outputPath = ChengNativeCreateTempFile("ts-csg-runtime-closure-")
        if outputPath == "":
            return ChengNativeFailureText(requestId, "ts_csg_runtime_closure: failed to allocate temporary output")
    elif !ChengNativeTempArtifactPath(outputPath):
        return ChengNativeFailureText(requestId, "ts_csg_runtime_closure: out must be a temporary artifact path")
    var runtime = wire.RustCsgJsonFindOptionalStr(args, "runtime")
    if runtime == "":
        runtime = "node,browser"
    let node = resolver.ChengToolchainResolveNodeCommand(root)
    if !node.ok:
        return ChengNativeFailureText(requestId, node.error)
    let cli = resolver.ChengToolchainResolveTsCsgCli(root)
    if !cli.ok:
        return ChengNativeFailureText(requestId, cli.error)
    var procArgs: str[]
    add(procArgs, cli.path)
    add(procArgs, "--emit")
    add(procArgs, "runtime-closure")
    add(procArgs, "--project")
    add(procArgs, projectPath)
    add(procArgs, "--runtime")
    add(procArgs, runtime)
    let entryRoot = wire.RustCsgJsonFindOptionalStr(args, "entryRoot")
    if entryRoot != "":
        add(procArgs, "--entry-root")
        add(procArgs, entryRoot)
    add(procArgs, "--out")
    add(procArgs, outputPath)
    let result = process.ProcessSpawn(node.path, procArgs, ChengNativeTsCsgCwd(root), [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("ts_csg_runtime_closure failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("ts_csg_runtime_closure failed: ", result.stderr))
    let evidence = ledger.ChengEvidenceLedgerAdd("ts_csg_runtime_closure",
                                                 projectPath,
                                                 0,
                                                 0,
                                                 "",
                                                 "",
                                                 "",
                                                 outputPath,
                                                 "ts-csg --emit runtime-closure",
                                                 "ok",
                                                 outputPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleChengNativeCompileRun(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let sourcePath = wire.RustCsgJsonFindOptionalStr(args, "in")
    if sourcePath == "":
        return ChengNativeFailureText(requestId, "cheng_native_compile_run: missing in")
    var outputPath = wire.RustCsgJsonFindOptionalStr(args, "out")
    if outputPath == "":
        outputPath = ChengNativeCreateTempFile("cheng-native-compile-run-")
        if outputPath == "":
            return ChengNativeFailureText(requestId, "cheng_native_compile_run: failed to allocate temporary output")
    elif !ChengNativeTempArtifactPath(outputPath):
        return ChengNativeFailureText(requestId, "cheng_native_compile_run: out must be a temporary artifact path")
    var reportPath = wire.RustCsgJsonFindOptionalStr(args, "reportOut")
    if reportPath == "":
        reportPath = wire.RustCsgCat(outputPath, ".report.txt")
    elif !ChengNativeTempArtifactPath(reportPath):
        return ChengNativeFailureText(requestId, "cheng_native_compile_run: reportOut must be a temporary artifact path")
    var target = wire.RustCsgJsonFindOptionalStr(args, "target")
    if target == "":
        target = "arm64-apple-darwin"
    let backend = resolver.ChengToolchainResolveBackendDriver(root)
    if !backend.ok:
        return ChengNativeFailureText(requestId, backend.error)
    var procArgs: str[]
    add(procArgs, "system-link-exec")
    add(procArgs, wire.RustCsgCat("--root:", root))
    add(procArgs, wire.RustCsgCat("--in:", sourcePath))
    add(procArgs, "--emit:exe")
    add(procArgs, wire.RustCsgCat("--target:", target))
    add(procArgs, wire.RustCsgCat("--out:", outputPath))
    add(procArgs, wire.RustCsgCat("--report-out:", reportPath))
    let result = process.ProcessSpawn(backend.path, procArgs, root, [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_native_compile_run failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_native_compile_run failed: ", result.stderr))
    let runResult = process.ProcessSpawn(outputPath, [], root, [])
    if !runResult.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_native_compile_run executable failed to start: ", runResult.error))
    if runResult.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_native_compile_run executable failed: ", runResult.stderr))
    let evidence = ledger.ChengEvidenceLedgerAdd("cheng_native_compile_run",
                                                 sourcePath,
                                                 0,
                                                 0,
                                                 "",
                                                 "",
                                                 "",
                                                 reportPath,
                                                 "backend_driver/cheng system-link-exec",
                                                 "ok",
                                                 outputPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeCompressBrotli(root: str, inputPath: str, outputPath: str): str =
    let node = resolver.ChengToolchainResolveNodeCommand(root)
    if !node.ok:
        return node.error
    var args: str[]
    add(args, "-e")
    add(args, "const fs=require(\"fs\"),zlib=require(\"zlib\");fs.writeFileSync(process.argv[2],zlib.brotliCompressSync(fs.readFileSync(process.argv[1])));")
    add(args, inputPath)
    add(args, outputPath)
    let result = process.ProcessSpawn(node.path, args, "", [])
    if !result.ok:
        return wire.RustCsgCat("brotli compression failed to start: ", result.error)
    if result.exitCode != 0:
        return wire.RustCsgCat("brotli compression failed with exit code ", strings.IntToStr(result.exitCode))
    return ""

fn ChengNativePersistAgentTrace(root: str,
                                outDir: str,
                                kind: str,
                                payload: str,
                                compression: str,
                                debugJsonl: bool): str =
    if outDir == "":
        return "{\"ok\":false,\"error\":\"missing outDir\"}"
    if !training.ChengTrainingTraceOutputDirAllowed(outDir):
        return "{\"ok\":false,\"error\":\"agent trace output dir must be under /tmp or /var/tmp\"}"
    var requestedCompression = compression
    if requestedCompression == "":
        requestedCompression = "brotli"
    if requestedCompression != "none" && requestedCompression != "brotli":
        return "{\"ok\":false,\"error\":\"unsupported compression\"}"
    let shardPath = training.ChengTrainingTraceWriteProductionShard(outDir, kind, payload)
    let cid = training.ChengTrainingTracePayloadCid(payload)
    let manifestPath = training.ChengTrainingTraceManifestPath(outDir, kind, cid)
    var compressedPath = ""
    if requestedCompression == "brotli":
        compressedPath = wire.RustCsgCat(shardPath, ".br")
        let err = ChengNativeCompressBrotli(root, shardPath, compressedPath)
        if err != "":
            return wire.RustCsgCat("{\"ok\":false,\"error\":", wire.RustCsgCat(wire.RustCsgJsonQuote(err), "}"))
    let manifest = training.ChengTrainingTraceWriteProductionManifest(outDir,
                                                                      kind,
                                                                      payload,
                                                                      requestedCompression,
                                                                      compressedPath)
    var debugPath = ""
    if debugJsonl:
        debugPath = training.ChengTrainingTraceWriteDebugJsonl(outDir, kind, payload)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("ok", true))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("manifest", manifest))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("manifestPath", manifestPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("shardPath", shardPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("compressedPath", compressedPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("debugJsonlPath", debugPath))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengNativeEvidenceJsonOrRuntime(args: str, validationStatus: str): str =
    let evidenceJson = wire.RustCsgJsonFindOptionalStr(args, "evidence")
    if evidenceJson != "":
        return evidenceJson
    return agent_runtime.ChengAgentRuntimeSnapshotEvidenceJson(validationStatus)

fn ChengNativeHandleTrainingTraceRecord(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let outDir = wire.RustCsgJsonFindOptionalStr(args, "outDir")
    let traceId = wire.RustCsgJsonFindOptionalStr(args, "traceId")
    let instruction = wire.RustCsgJsonFindOptionalStr(args, "instruction")
    let outcome = wire.RustCsgJsonFindOptionalStr(args, "outcome")
    let validationStatus = wire.RustCsgJsonFindOptionalStr(args, "validationStatus")
    if outDir == "" || traceId == "" || instruction == "" || outcome == "" || validationStatus == "":
        return ChengNativeFailureText(requestId, "cheng_training_trace_record: missing required field")
    let compression = wire.RustCsgJsonFindOptionalStr(args, "compression")
    if !training.ChengTrainingTraceOutputDirAllowed(outDir):
        return ChengNativeFailureText(requestId, "agent trace output dir must be under /tmp or /var/tmp")
    if compression != "" && compression != "none" && compression != "brotli":
        return ChengNativeFailureText(requestId, "unsupported compression")
    let evidenceJson = ChengNativeEvidenceJsonOrRuntime(args, validationStatus)
    let checksJson = wire.RustCsgJsonFindOptionalStr(args, "checks")
    let payload = training.ChengTrainingTraceRecord(traceId,
                                                    instruction,
                                                    evidenceJson,
                                                    wire.RustCsgJsonFindOptionalStr(args, "diffSummary"),
                                                    checksJson,
                                                    outcome,
                                                    wire.RustCsgJsonFindOptionalStr(args, "validationCommand"),
                                                    validationStatus,
                                                    ChengNativeNowMs())
    let persisted = ChengNativePersistAgentTrace(root,
                                                 outDir,
                                                 "training-trace",
                                                 payload,
                                                 compression,
                                                 wire.RustCsgJsonFindOptionalBool(args, "debugJsonl"))
    if !strings.StrContains(persisted, "\"ok\":true"):
        return ChengNativeFailureText(requestId, persisted)
    return ChengNativeSuccessText(requestId, persisted)

fn ChengNativeHandleEvalCaseRecord(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let outDir = wire.RustCsgJsonFindOptionalStr(args, "outDir")
    let evalId = wire.RustCsgJsonFindOptionalStr(args, "evalId")
    let traceId = wire.RustCsgJsonFindOptionalStr(args, "traceId")
    let instruction = wire.RustCsgJsonFindOptionalStr(args, "instruction")
    let expectedOutcome = wire.RustCsgJsonFindOptionalStr(args, "expectedOutcome")
    if outDir == "" || evalId == "" || traceId == "" || instruction == "" || expectedOutcome == "":
        return ChengNativeFailureText(requestId, "cheng_eval_case_record: missing required field")
    let compression = wire.RustCsgJsonFindOptionalStr(args, "compression")
    if !training.ChengTrainingTraceOutputDirAllowed(outDir):
        return ChengNativeFailureText(requestId, "agent trace output dir must be under /tmp or /var/tmp")
    if compression != "" && compression != "none" && compression != "brotli":
        return ChengNativeFailureText(requestId, "unsupported compression")
    let payload = training.ChengEvalCaseRecordWithMetadata(evalId,
                                                           traceId,
                                                           instruction,
                                                           ChengNativeEvidenceJsonOrRuntime(args, wire.RustCsgJsonFindOptionalStr(args, "validationStatus")),
                                                           wire.RustCsgJsonFindOptionalStr(args, "replayCommand"),
                                                           expectedOutcome,
                                                           wire.RustCsgJsonFindOptionalStr(args, "validationCommand"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "cwd"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "toolchainSnapshot"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "sourceRevision"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "manifestRefs"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "validationStatus"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "validationResult"),
                                                           wire.RustCsgJsonFindOptionalStr(args, "replayFixtureRefs"),
                                                           ChengNativeNowMs())
    let persisted = ChengNativePersistAgentTrace(root,
                                                 outDir,
                                                 "eval-case",
                                                 payload,
                                                 compression,
                                                 wire.RustCsgJsonFindOptionalBool(args, "debugJsonl"))
    if !strings.StrContains(persisted, "\"ok\":true"):
        return ChengNativeFailureText(requestId, persisted)
    return ChengNativeSuccessText(requestId, persisted)

fn ChengNativeHandleAgentTraceVerify(requestId: int32, args: str): str =
    let manifestPath = wire.RustCsgJsonFindOptionalStr(args, "manifest")
    if manifestPath == "":
        return ChengNativeFailureText(requestId, "cheng_agent_trace_verify: missing manifest")
    var result: training.ChengAgentTraceVerifyResult
    let _ = training.ChengAgentTraceVerifyManifestInto(manifestPath, result)
    let json = training.ChengAgentTraceVerifyResultJson(result)
    if !result.ok:
        return ChengNativeFailureText(requestId, json)
    return ChengNativeSuccessText(requestId, json)

fn ChengNativeHandleAgentTraceExportJsonl(requestId: int32, args: str): str =
    let manifestPath = wire.RustCsgJsonFindOptionalStr(args, "manifest")
    let outPath = wire.RustCsgJsonFindOptionalStr(args, "out")
    if manifestPath == "" || outPath == "":
        return ChengNativeFailureText(requestId, "cheng_agent_trace_export_jsonl: missing manifest or out")
    if !training.ChengTrainingTraceOutputDirAllowed(outPath):
        return ChengNativeFailureText(requestId, "agent trace export path must be under /tmp or /var/tmp")
    let json = training.ChengAgentTraceExportJsonl(manifestPath, outPath)
    if !strings.StrContains(json, "\"ok\":true"):
        return ChengNativeFailureText(requestId, json)
    return ChengNativeSuccessText(requestId, json)

fn ChengNativeLspInput(path: str,
                       text: str,
                       codeAction: bool,
                       startLine: int32,
                       startCharacter: int32,
                       endLine: int32,
                       endCharacter: int32): str =
    let uri = wire.RustCsgCat("file://", path)
    let init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}"
    var didOpen = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":"
    didOpen = wire.RustCsgCat(didOpen, wire.RustCsgJsonQuote(uri))
    didOpen = wire.RustCsgCat(didOpen, ",\"languageId\":\"cheng\",\"version\":1,\"text\":")
    didOpen = wire.RustCsgCat(didOpen, wire.RustCsgJsonQuote(text))
    didOpen = wire.RustCsgCat(didOpen, "}}}")
    var request = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/diagnostic\",\"params\":{\"textDocument\":{\"uri\":"
    request = wire.RustCsgCat(request, wire.RustCsgJsonQuote(uri))
    request = wire.RustCsgCat(request, "}}}")
    if codeAction:
        request = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":"
        request = wire.RustCsgCat(request, wire.RustCsgJsonQuote(uri))
        request = wire.RustCsgCat(request, "},\"range\":{\"start\":{\"line\":")
        request = wire.RustCsgCat(request, strings.IntToStr(startLine))
        request = wire.RustCsgCat(request, ",\"character\":")
        request = wire.RustCsgCat(request, strings.IntToStr(startCharacter))
        request = wire.RustCsgCat(request, "},\"end\":{\"line\":")
        request = wire.RustCsgCat(request, strings.IntToStr(endLine))
        request = wire.RustCsgCat(request, ",\"character\":")
        request = wire.RustCsgCat(request, strings.IntToStr(endCharacter))
        request = wire.RustCsgCat(request, "}},\"context\":{\"diagnostics\":[]}}}")
    let shutdown = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\",\"params\":null}"
    let exitMsg = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}"
    return wire.RustCsgCat(ChengNativeLspFrame(init),
                           wire.RustCsgCat(ChengNativeLspFrame(didOpen),
                                           wire.RustCsgCat(ChengNativeLspFrame(request),
                                                           wire.RustCsgCat(ChengNativeLspFrame(shutdown), ChengNativeLspFrame(exitMsg)))))

fn ChengNativeLspFrame(payload: str): str =
    return strutil.Join(["Content-Length: ", strings.IntToStr(payload.len), "\r\n\r\n", payload], "")

fn ChengNativeRunLsp(root: str,
                     path: str,
                     text: str,
                     codeAction: bool,
                     startLine: int32,
                     startCharacter: int32,
                     endLine: int32,
                     endCharacter: int32,
                     requestId: int32): str =
    let lsp = resolver.ChengToolchainResolveLspCommand(root)
    if !lsp.ok:
        return ChengNativeFailureText(requestId, lsp.error)
    let input = ChengNativeLspInput(path, text, codeAction, startLine, startCharacter, endLine, endCharacter)
    let inputPath = ChengNativeCreateTempFile("cheng-lsp-input-")
    if inputPath == "":
        return ChengNativeFailureText(requestId, "Cheng LSP failed to allocate stdin payload")
    if ChengNativeWriteFile(inputPath, input) == 0:
        return ChengNativeFailureText(requestId, "Cheng LSP failed to write stdin payload")
    var args: str[]
    add(args, "-c")
    add(args, "\"$1\" < \"$2\"")
    add(args, "sh")
    add(args, lsp.path)
    add(args, inputPath)
    var env: str[]
    let result = process.ProcessSpawn("/bin/sh", args, root, env)
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("Cheng LSP failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("Cheng LSP failed: ", result.stderr))
    if result.stdout == "" || !strings.StrContains(result.stdout, "\"jsonrpc\""):
        return ChengNativeFailureText(requestId, "Cheng LSP produced no JSON-RPC output")
    let source = "cheng.lsp"
    let evidence = ledger.ChengEvidenceLedgerAdd(source,
                                                 path,
                                                 0,
                                                 0,
                                                 "",
                                                 "",
                                                 "",
                                                 "",
                                                 lsp.path,
                                                 "ok",
                                                 result.stdout,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleLspSnapshot(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let path = wire.RustCsgJsonFindOptionalStr(args, "path")
    if path == "":
        return ChengNativeFailureText(requestId, "cheng_lsp_snapshot: missing path")
    var text = wire.RustCsgJsonFindOptionalStr(args, "text")
    if text == "":
        text = ChengNativeReportFileText(path)
    if text == "":
        return ChengNativeFailureText(requestId, "cheng_lsp_snapshot: missing source text")
    return ChengNativeRunLsp(root, path, text, false, 0, 0, 0, 0, requestId)

fn ChengNativeHandleLspCodeAction(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    let path = wire.RustCsgJsonFindOptionalStr(args, "path")
    if path == "":
        return ChengNativeFailureText(requestId, "cheng_lsp_code_action_preview: missing path")
    var text = wire.RustCsgJsonFindOptionalStr(args, "text")
    if text == "":
        text = ChengNativeReportFileText(path)
    if text == "":
        return ChengNativeFailureText(requestId, "cheng_lsp_code_action_preview: missing source text")
    var startLine: int32
    var startCharacter: int32
    var endLine: int32
    var endCharacter: int32
    if strings.StrContains(args, "\"line\""):
        startLine = wire.RustCsgJsonFindInt32(args, "line")
        endLine = startLine
    if strings.StrContains(args, "\"character\""):
        startCharacter = wire.RustCsgJsonFindInt32(args, "character")
        endCharacter = startCharacter
    if strings.StrContains(args, "\"range\""):
        let range = wire.RustCsgJsonFindObject(args, "range")
        if !strings.StrContains(range, "\"start\"") || !strings.StrContains(range, "\"end\""):
            return ChengNativeFailureText(requestId, "cheng_lsp_code_action_preview: range requires start and end")
        let start = wire.RustCsgJsonFindObject(range, "start")
        let end = wire.RustCsgJsonFindObject(range, "end")
        if !strings.StrContains(start, "\"line\"") ||
           !strings.StrContains(start, "\"character\"") ||
           !strings.StrContains(end, "\"line\"") ||
           !strings.StrContains(end, "\"character\""):
            return ChengNativeFailureText(requestId, "cheng_lsp_code_action_preview: range endpoints require line and character")
        startLine = wire.RustCsgJsonFindInt32(start, "line")
        startCharacter = wire.RustCsgJsonFindInt32(start, "character")
        endLine = wire.RustCsgJsonFindInt32(end, "line")
        endCharacter = wire.RustCsgJsonFindInt32(end, "character")
    return ChengNativeRunLsp(root, path, text, true, startLine, startCharacter, endLine, endCharacter, requestId)

fn ChengNativeOptionalLine(args: str): int32 =
    if strings.StrContains(args, "\"line\""):
        return wire.RustCsgJsonFindInt32(args, "line")
    return 0

fn ChengNativeEvidencePath(args: str, fallback: str): str =
    let sourcePath = wire.RustCsgJsonFindOptionalStr(args, "sourcePath")
    if sourcePath != "":
        return sourcePath
    return fallback

fn ChengNativeTempReportOut(args: str, prefix: str, suffix: str, outError: var str): str =
    outError = ""
    var reportPath = wire.RustCsgJsonFindOptionalStr(args, "reportOut")
    if reportPath == "":
        let base = ChengNativeCreateTempFile(prefix)
        if base == "":
            outError = "failed to allocate temporary report path"
            return ""
        reportPath = wire.RustCsgCat(base, suffix)
    elif !ChengNativeTempArtifactPath(reportPath):
        outError = "reportOut must be a temporary artifact path"
        return ""
    return reportPath

fn ChengNativeRawPath(args: str, prefix: str, toolName: str, outError: var str): str =
    outError = ""
    let rawPath = wire.RustCsgJsonFindOptionalStr(args, "rawPath")
    if rawPath != "":
        if home.RustCsgPathMetadataKind(rawPath) != 2:
            outError = wire.RustCsgCat3(toolName, ": missing rawPath: ", rawPath)
            return ""
        return rawPath
    let rawText = wire.RustCsgJsonFindOptionalStr(args, "rawText")
    if rawText == "":
        outError = wire.RustCsgCat(toolName, ": missing rawText or rawPath")
        return ""
    let tempPath = ChengNativeCreateTempFile(prefix)
    if tempPath == "":
        outError = wire.RustCsgCat(toolName, ": failed to allocate temporary raw input")
        return ""
    if ChengNativeWriteFile(tempPath, rawText) == 0:
        outError = wire.RustCsgCat(toolName, ": failed to write temporary raw input")
        return ""
    return tempPath

fn ChengNativeReportFileText(path: str): str =
    if path == "":
        return ""
    if home.RustCsgPathMetadataKind(path) != 2:
        return ""
    var args: str[]
    add(args, path)
    let result = process.ProcessSpawn("/bin/cat", args, "/", [])
    if !result.ok || result.exitCode != 0:
        return ""
    return result.stdout

fn ChengNativeProfileRawPathFromReport(reportPath: str): str =
    if reportPath == "":
        return ""
    if strings.HasSuffix(reportPath, ".txt"):
        return wire.RustCsgCat(strings.SliceBytes(reportPath, 0, reportPath.len - 4), ".raw.txt")
    return wire.RustCsgCat(reportPath, ".raw.txt")

fn ChengNativeHandleDebugTextCommand(requestId: int32,
                                      args: str,
                                      toolName: str,
                                      commandName: str,
                                      header: str): str =
    let root = ChengNativeResolveRoot(args)
    if !ChengNativeRootAvailable(root):
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, ": root not found: ", root))
    let sourcePath = wire.RustCsgJsonFindOptionalStr(args, "in")
    if sourcePath == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat(toolName, ": missing in"))
    var reportError: str
    let reportPath = ChengNativeTempReportOut(args, wire.RustCsgCat(toolName, "-"), ".report.txt", reportError)
    if reportError != "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, ": ", reportError))
    var target = wire.RustCsgJsonFindOptionalStr(args, "target")
    if target == "":
        target = "arm64-apple-darwin"
    let backend = resolver.ChengToolchainResolveBackendDriver(root)
    if !backend.ok:
        return ChengNativeFailureText(requestId, backend.error)
    var procArgs: str[]
    add(procArgs, commandName)
    add(procArgs, wire.RustCsgCat("--root:", root))
    add(procArgs, wire.RustCsgCat("--in:", sourcePath))
    add(procArgs, wire.RustCsgCat("--target:", target))
    add(procArgs, "--emit:obj")
    add(procArgs, wire.RustCsgCat("--report-out:", reportPath))
    var shellArgs: str[]
    add(shellArgs, "-c")
    add(shellArgs, "\"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\" \"$7\" >/dev/null 2>/dev/null")
    add(shellArgs, "sh")
    add(shellArgs, backend.path)
    for i in 0..<procArgs.len:
        add(shellArgs, procArgs[i])
    let result = process.ProcessSpawn("/bin/sh", shellArgs, root, [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, " failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, " failed with exit code ", strings.IntToStr(result.exitCode)))
    let reportText = ChengNativeReportFileText(reportPath)
    if reportText == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, ": missing report file: ", reportPath))
    if !ChengNativeTextStartsWith(reportText, wire.RustCsgCat(header, "\n")) &&
       reportText != header:
        return ChengNativeFailureText(requestId, wire.RustCsgCat3(toolName, ": report missing stable header: ", header))
    let evidence = ledger.ChengEvidenceLedgerAdd("cheng.debugger",
                                                 ChengNativeEvidencePath(args, sourcePath),
                                                 ChengNativeOptionalLine(args),
                                                 ChengNativeOptionalLine(args),
                                                 wire.RustCsgJsonFindOptionalStr(args, "symbol"),
                                                 "",
                                                 "",
                                                 reportPath,
                                                 commandName,
                                                 "ok",
                                                 reportPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleDebugReport(requestId: int32, args: str): str =
    return ChengNativeHandleDebugTextCommand(requestId, args, "cheng_debug_report", "debug-report", "cheng_debug_report_v1")

fn ChengNativeHandlePrintLineMap(requestId: int32, args: str): str =
    return ChengNativeHandleDebugTextCommand(requestId, args, "cheng_print_line_map", "print-line-map", "cheng_line_map")

fn ChengNativeHandlePrintSymbols(requestId: int32, args: str): str =
    return ChengNativeHandleDebugTextCommand(requestId, args, "cheng_print_symbols", "print-symbols", "cheng_symbols")

fn ChengNativeHandleCrashReport(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    if !ChengNativeRootAvailable(root):
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_crash_report: root not found: ", root))
    var rawError: str
    let rawPath = ChengNativeRawPath(args, "cheng-crash-raw-", "cheng_crash_report", rawError)
    if rawError != "":
        return ChengNativeFailureText(requestId, rawError)
    var reportError: str
    let reportPath = ChengNativeTempReportOut(args, "cheng-crash-report-", ".txt", reportError)
    if reportError != "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_crash_report: ", reportError))
    let backend = resolver.ChengToolchainResolveBackendDriver(root)
    if !backend.ok:
        return ChengNativeFailureText(requestId, backend.error)
    var procArgs: str[]
    add(procArgs, "crash-report")
    add(procArgs, wire.RustCsgCat("--in:", rawPath))
    add(procArgs, wire.RustCsgCat("--out:", reportPath))
    var shellArgs: str[]
    add(shellArgs, "-c")
    add(shellArgs, "\"$1\" \"$2\" \"$3\" \"$4\" >/dev/null 2>/dev/null")
    add(shellArgs, "sh")
    add(shellArgs, backend.path)
    for i in 0..<procArgs.len:
        add(shellArgs, procArgs[i])
    let result = process.ProcessSpawn("/bin/sh", shellArgs, root, [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_crash_report failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_crash_report failed with exit code ", strings.IntToStr(result.exitCode)))
    let reportText = ChengNativeReportFileText(reportPath)
    if reportText == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_crash_report: missing report file: ", reportPath))
    if !strings.StrContains(reportText, "cheng_crash_report_v1"):
        return ChengNativeFailureText(requestId, "cheng_crash_report: report missing stable header: cheng_crash_report_v1")
    let evidence = ledger.ChengEvidenceLedgerAdd("cheng.debugger",
                                                 ChengNativeEvidencePath(args, rawPath),
                                                 ChengNativeOptionalLine(args),
                                                 ChengNativeOptionalLine(args),
                                                 wire.RustCsgJsonFindOptionalStr(args, "symbol"),
                                                 "",
                                                 "",
                                                 reportPath,
                                                 "crash-report",
                                                 "ok",
                                                 reportPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleProfileReport(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    if !ChengNativeRootAvailable(root):
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_report: root not found: ", root))
    var rawError: str
    let rawPath = ChengNativeRawPath(args, "cheng-profile-raw-", "cheng_profile_report", rawError)
    if rawError != "":
        return ChengNativeFailureText(requestId, rawError)
    var reportError: str
    let reportPath = ChengNativeTempReportOut(args, "cheng-profile-report-", ".txt", reportError)
    if reportError != "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_report: ", reportError))
    let backend = resolver.ChengToolchainResolveBackendDriver(root)
    if !backend.ok:
        return ChengNativeFailureText(requestId, backend.error)
    var procArgs: str[]
    add(procArgs, "profile-report")
    add(procArgs, wire.RustCsgCat("--in:", rawPath))
    add(procArgs, wire.RustCsgCat("--out:", reportPath))
    var shellArgs: str[]
    add(shellArgs, "-c")
    add(shellArgs, "\"$1\" \"$2\" \"$3\" \"$4\" >/dev/null 2>/dev/null")
    add(shellArgs, "sh")
    add(shellArgs, backend.path)
    for i in 0..<procArgs.len:
        add(shellArgs, procArgs[i])
    let result = process.ProcessSpawn("/bin/sh", shellArgs, root, [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_report failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_report failed with exit code ", strings.IntToStr(result.exitCode)))
    let reportText = ChengNativeReportFileText(reportPath)
    if reportText == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_report: missing report file: ", reportPath))
    if !ChengNativeTextStartsWith(reportText, "cheng_profile\n") && reportText != "cheng_profile":
        return ChengNativeFailureText(requestId, "cheng_profile_report: report missing stable header: cheng_profile")
    let evidence = ledger.ChengEvidenceLedgerAdd("cheng.profile",
                                                 ChengNativeEvidencePath(args, rawPath),
                                                 ChengNativeOptionalLine(args),
                                                 ChengNativeOptionalLine(args),
                                                 wire.RustCsgJsonFindOptionalStr(args, "symbol"),
                                                 "",
                                                 "",
                                                 reportPath,
                                                 "profile-report",
                                                 "ok",
                                                 reportPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleProfileRun(requestId: int32, args: str): str =
    let root = ChengNativeResolveRoot(args)
    if !ChengNativeRootAvailable(root):
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_run: root not found: ", root))
    let sourcePath = wire.RustCsgJsonFindOptionalStr(args, "in")
    if sourcePath == "":
        return ChengNativeFailureText(requestId, "cheng_profile_run: missing in")
    var outputPath = wire.RustCsgJsonFindOptionalStr(args, "out")
    if outputPath == "":
        outputPath = ChengNativeCreateTempFile("cheng-profile-run-")
        if outputPath == "":
            return ChengNativeFailureText(requestId, "cheng_profile_run: failed to allocate temporary output")
    elif !ChengNativeTempArtifactPath(outputPath):
        return ChengNativeFailureText(requestId, "cheng_profile_run: out must be a temporary artifact path")
    var reportPath = wire.RustCsgJsonFindOptionalStr(args, "reportOut")
    if reportPath == "":
        reportPath = wire.RustCsgCat(outputPath, ".profile.txt")
    elif !ChengNativeTempArtifactPath(reportPath):
        return ChengNativeFailureText(requestId, "cheng_profile_run: reportOut must be a temporary artifact path")
    var target = wire.RustCsgJsonFindOptionalStr(args, "target")
    if target == "":
        target = "arm64-apple-darwin"
    var profileHz = wire.RustCsgJsonFindOptionalStr(args, "profileHz")
    if profileHz == "":
        profileHz = "200"
    let backend = resolver.ChengToolchainResolveBackendDriver(root)
    if !backend.ok:
        return ChengNativeFailureText(requestId, backend.error)
    var procArgs: str[]
    add(procArgs, "profile-run")
    add(procArgs, wire.RustCsgCat("--root:", root))
    add(procArgs, wire.RustCsgCat("--in:", sourcePath))
    add(procArgs, "--emit:exe")
    add(procArgs, wire.RustCsgCat("--target:", target))
    add(procArgs, wire.RustCsgCat("--out:", outputPath))
    add(procArgs, wire.RustCsgCat("--report-out:", reportPath))
    add(procArgs, wire.RustCsgCat("--profile-hz:", profileHz))
    var shellArgs: str[]
    add(shellArgs, "-c")
    add(shellArgs, "\"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\" \"$7\" \"$8\" \"$9\" >/dev/null 2>/dev/null")
    add(shellArgs, "sh")
    add(shellArgs, backend.path)
    for i in 0..<procArgs.len:
        add(shellArgs, procArgs[i])
    let result = process.ProcessSpawn("/bin/sh", shellArgs, root, [])
    if !result.ok:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_run failed to start: ", result.error))
    if result.exitCode != 0:
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_run failed with exit code ", strings.IntToStr(result.exitCode)))
    let reportText = ChengNativeReportFileText(reportPath)
    if reportText == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_run: missing report file: ", reportPath))
    if !ChengNativeTextStartsWith(reportText, "cheng_profile\n") && reportText != "cheng_profile":
        return ChengNativeFailureText(requestId, "cheng_profile_run: report missing stable header: cheng_profile")
    let rawPath = ChengNativeProfileRawPathFromReport(reportPath)
    if ChengNativeReportFileText(rawPath) == "":
        return ChengNativeFailureText(requestId, wire.RustCsgCat("cheng_profile_run: missing raw profile file: ", rawPath))
    let evidence = ledger.ChengEvidenceLedgerAdd("cheng.profile",
                                                 ChengNativeEvidencePath(args, sourcePath),
                                                 0,
                                                 0,
                                                 wire.RustCsgJsonFindOptionalStr(args, "symbol"),
                                                 "",
                                                 "",
                                                 reportPath,
                                                 "profile-run",
                                                 "ok",
                                                 rawPath,
                                                 ChengNativeNowMs())
    return ChengNativeSuccessText(requestId, wire.RustCsgCat("{\"evidence\":", wire.RustCsgCat(evidence, "}")))

fn ChengNativeHandleToolCall(requestId: int32, tool: str, argumentsRaw: str): str =
    let handlerKind = registry.ChengToolRegistryHandlerKind(tool)
    if handlerKind == 4:
        return ChengNativeHandleLspSnapshot(requestId, argumentsRaw)
    if handlerKind == 5:
        return ChengNativeHandleLspCodeAction(requestId, argumentsRaw)
    if handlerKind == 6:
        return ChengNativeHandleDebugReport(requestId, argumentsRaw)
    if handlerKind == 7:
        return ChengNativeHandlePrintLineMap(requestId, argumentsRaw)
    if handlerKind == 8:
        return ChengNativeHandlePrintSymbols(requestId, argumentsRaw)
    if handlerKind == 9:
        return ChengNativeHandleCrashReport(requestId, argumentsRaw)
    if handlerKind == 10:
        return ChengNativeHandleProfileReport(requestId, argumentsRaw)
    if handlerKind == 11:
        return ChengNativeHandleProfileRun(requestId, argumentsRaw)
    if handlerKind == 13:
        return ChengNativeHandleTsCsgEmit(requestId, argumentsRaw)
    if handlerKind == 14:
        return ChengNativeHandleTsCsgRuntimeClosure(requestId, argumentsRaw)
    if handlerKind == 15:
        return ChengNativeHandleChengNativeCompileRun(requestId, argumentsRaw)
    if handlerKind == 16:
        return ChengNativeHandleTrainingTraceRecord(requestId, argumentsRaw)
    if handlerKind == 17:
        return ChengNativeHandleEvalCaseRecord(requestId, argumentsRaw)
    if handlerKind == 18:
        return ChengNativeHandleAgentTraceVerify(requestId, argumentsRaw)
    if handlerKind == 19:
        return ChengNativeHandleAgentTraceExportJsonl(requestId, argumentsRaw)
    return ChengNativeFailureText(requestId, wire.RustCsgCat("unknown Cheng native tool: ", tool))

fn ChengNativeHandleToolCallForRole(requestId: int32, tool: str, argumentsRaw: str, role: str): str =
    if !ChengNativeToolAllowedForRole(tool, role):
        return ChengNativeFailureText(requestId, wire.RustCsgCat3("tool ", tool, " is not allowed for model role"))
    return ChengNativeHandleToolCall(requestId, tool, argumentsRaw)
