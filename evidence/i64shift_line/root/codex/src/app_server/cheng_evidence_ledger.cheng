import std/strings
import cheng/codex/protocol/wire

const ChengEvidenceFreshMs: int64 = 600000

type ChengEvidenceEntry =
    evidenceId: str
    source: str
    path: str
    startLine: int32
    endLine: int32
    symbol: str
    csgNode: str
    diagnosticCode: str
    reportPath: str
    command: str
    status: str
    detail: str
    timestampMs: int64

var ChengEvidenceLedgerEntries: ChengEvidenceEntry[]
var ChengEvidenceLedgerJsonCache: str
var ChengEvidenceLedgerCounter: int32
var ChengEvidenceViolationPath: str
var ChengEvidenceViolationTimestamp: int64
var ChengEvidenceFreshLspPath: str
var ChengEvidenceFreshLspTimestamp: int64
var ChengEvidenceFreshDebuggerTimestamp: int64
var ChengEvidenceFreshProfileTimestamp: int64
var ChengEvidenceFreshTsCsgEmitTimestamp: int64
var ChengEvidenceFreshTsCsgRuntimeClosureTimestamp: int64
var ChengEvidenceScopeActive: bool
var ChengEvidenceScopeId: str
var ChengEvidenceScopeJsonCache: str
var ChengEvidenceScopeCount: int32

fn ChengEvidenceLedgerReset() =
    ChengEvidenceLedgerEntries = []
    ChengEvidenceLedgerJsonCache = ""
    ChengEvidenceLedgerCounter = 0
    ChengEvidenceViolationPath = ""
    ChengEvidenceViolationTimestamp = int64(0)
    ChengEvidenceFreshLspPath = ""
    ChengEvidenceFreshLspTimestamp = int64(0)
    ChengEvidenceFreshDebuggerTimestamp = int64(0)
    ChengEvidenceFreshProfileTimestamp = int64(0)
    ChengEvidenceFreshTsCsgEmitTimestamp = int64(0)
    ChengEvidenceFreshTsCsgRuntimeClosureTimestamp = int64(0)
    ChengEvidenceScopeActive = false
    ChengEvidenceScopeId = ""
    ChengEvidenceScopeJsonCache = ""
    ChengEvidenceScopeCount = 0

fn ChengEvidenceBeginScope(scopeId: str) =
    ChengEvidenceScopeActive = true
    ChengEvidenceScopeId = scopeId
    ChengEvidenceScopeJsonCache = ""
    ChengEvidenceScopeCount = 0

fn ChengEvidenceEndScope() =
    ChengEvidenceScopeActive = false

fn ChengEvidenceScopeJson(): str =
    var entries = "[]"
    if ChengEvidenceScopeJsonCache != "":
        entries = wire.RustCsgCat3("[", ChengEvidenceScopeJsonCache, "]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("scopeId", ChengEvidenceScopeId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("active", ChengEvidenceScopeActive))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("count", ChengEvidenceScopeCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("entries", entries))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengEvidenceLedgerAdd(source: str,
                          path: str,
                          startLine: int32,
                          endLine: int32,
                          symbol: str,
                          csgNode: str,
                          diagnosticCode: str,
                          reportPath: str,
                          command: str,
                          status: str,
                          detail: str,
                          timestampMs: int64): str =
    ChengEvidenceLedgerCounter = ChengEvidenceLedgerCounter + 1
    let evidenceId = wire.RustCsgCat("cheng-evidence-", strings.IntToStr(ChengEvidenceLedgerCounter))
    let entry = ChengEvidenceEntry(evidenceId: evidenceId,
                                   source: source,
                                   path: path,
                                   startLine: startLine,
                                   endLine: endLine,
                                   symbol: symbol,
                                   csgNode: csgNode,
                                   diagnosticCode: diagnosticCode,
                                   reportPath: reportPath,
                                   command: command,
                                   status: status,
                                   detail: detail,
                                   timestampMs: timestampMs)
    let entryJson = ChengEvidenceFieldsToJson(evidenceId,
                                             source,
                                             path,
                                             startLine,
                                             endLine,
                                             symbol,
                                             csgNode,
                                             diagnosticCode,
                                             reportPath,
                                             command,
                                             status,
                                             detail,
                                             timestampMs)
    add(ChengEvidenceLedgerEntries, entry)
    if ChengEvidenceLedgerJsonCache == "":
        ChengEvidenceLedgerJsonCache = entryJson
    else:
        ChengEvidenceLedgerJsonCache = wire.RustCsgCat3(ChengEvidenceLedgerJsonCache, ",", entryJson)
    if ChengEvidenceScopeActive:
        if ChengEvidenceScopeJsonCache == "":
            ChengEvidenceScopeJsonCache = entryJson
        else:
            ChengEvidenceScopeJsonCache = wire.RustCsgCat3(ChengEvidenceScopeJsonCache, ",", entryJson)
        ChengEvidenceScopeCount = ChengEvidenceScopeCount + 1
    if ChengEvidenceIsStructuredViolation(status, diagnosticCode):
        ChengEvidenceViolationPath = path
        ChengEvidenceViolationTimestamp = timestampMs
    if source == "cheng.lsp" && status == "ok":
        ChengEvidenceFreshLspPath = path
        ChengEvidenceFreshLspTimestamp = timestampMs
    elif source == "cheng.debugger" && status == "ok":
        ChengEvidenceFreshDebuggerTimestamp = timestampMs
    elif source == "cheng.profile" && status == "ok":
        ChengEvidenceFreshProfileTimestamp = timestampMs
    elif source == "ts_csg_emit" && status == "ok":
        ChengEvidenceFreshTsCsgEmitTimestamp = timestampMs
    elif source == "ts_csg_runtime_closure" && status == "ok":
        ChengEvidenceFreshTsCsgRuntimeClosureTimestamp = timestampMs
    return entryJson

fn ChengEvidenceSourceKnown(source: str): bool =
    return source == "cheng.lsp" ||
           source == "cheng.debugger" ||
           source == "cheng.profile" ||
           source == "ts_csg_emit" ||
           source == "ts_csg_runtime_closure" ||
           source == "ts_csg_cheng_source" ||
           source == "ts_csg_cheng_csg" ||
           source == "cheng_native_compile_run"

fn ChengEvidenceJsonQuote(text: str): str =
    return wire.RustCsgJsonQuote(text)

fn ChengEvidenceJsonFieldStr(name: str, value: str): str =
    return wire.RustCsgJsonFieldStr(name, value)

fn ChengEvidenceFieldsToJson(evidenceId: str,
                             source: str,
                             path: str,
                             startLine: int32,
                             endLine: int32,
                             symbol: str,
                             csgNode: str,
                             diagnosticCode: str,
                             reportPath: str,
                             command: str,
                             status: str,
                             detail: str,
                             timestampMs: int64): str =
    var out = "{"
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("evidenceId", evidenceId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("source", source))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("startLine", startLine))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("endLine", endLine))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("symbol", symbol))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("csgNode", csgNode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("diagnosticCode", diagnosticCode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("reportPath", reportPath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("command", command))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengEvidenceJsonFieldStr("detail", detail))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt64("timestampMs", timestampMs))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengEvidenceEntryToJson(entry: ChengEvidenceEntry): str =
    return ChengEvidenceFieldsToJson(entry.evidenceId,
                                     entry.source,
                                     entry.path,
                                     entry.startLine,
                                     entry.endLine,
                                     entry.symbol,
                                     entry.csgNode,
                                     entry.diagnosticCode,
                                     entry.reportPath,
                                     entry.command,
                                     entry.status,
                                     entry.detail,
                                     entry.timestampMs)

fn ChengEvidenceLedgerJson(): str =
    if ChengEvidenceLedgerJsonCache == "":
        return "[]"
    return wire.RustCsgCat3("[", ChengEvidenceLedgerJsonCache, "]")

fn ChengEvidencePathMatches(evidencePath: str, targetPath: str): bool =
    if evidencePath == targetPath:
        return true
    if evidencePath == "":
        return false
    if targetPath == "":
        return false
    if strings.HasPrefix(targetPath, wire.RustCsgCat(evidencePath, "/")):
        return true
    return false

fn ChengEvidenceTimestampFresh(timestampMs: int64, nowMs: int64): bool =
    if timestampMs <= int64(0):
        return false
    if nowMs < timestampMs:
        return false
    return nowMs - timestampMs <= ChengEvidenceFreshMs

fn ChengEvidenceFresh(entry: ChengEvidenceEntry, nowMs: int64): bool =
    if entry.status != "ok":
        return false
    return ChengEvidenceTimestampFresh(entry.timestampMs, nowMs)

fn ChengEvidenceIsStructuredViolation(status: str, diagnosticCode: str): bool =
    if status == "ownership_violation" || status == "no_pointer_violation":
        return true
    if status == "violation" &&
       (diagnosticCode == "ownership" || diagnosticCode == "no_pointer"):
        return true
    return false

fn ChengEvidenceViolationFresh(entry: ChengEvidenceEntry, nowMs: int64): bool =
    return ChengEvidenceIsStructuredViolation(entry.status, entry.diagnosticCode) &&
           ChengEvidenceTimestampFresh(entry.timestampMs, nowMs)

fn ChengEvidenceHasFresh(source: str, path: str, nowMs: int64): bool =
    if source == "cheng.lsp" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshLspTimestamp, nowMs) &&
       ChengEvidencePathMatches(ChengEvidenceFreshLspPath, path):
        return true
    return false

fn ChengEvidenceHasFreshAnyPath(source: str, nowMs: int64): bool =
    if source == "cheng.lsp" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshLspTimestamp, nowMs):
        return true
    if source == "cheng.debugger" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshDebuggerTimestamp, nowMs):
        return true
    if source == "cheng.profile" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshProfileTimestamp, nowMs):
        return true
    if source == "ts_csg_emit" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshTsCsgEmitTimestamp, nowMs):
        return true
    if source == "ts_csg_runtime_closure" &&
       ChengEvidenceTimestampFresh(ChengEvidenceFreshTsCsgRuntimeClosureTimestamp, nowMs):
        return true
    return false

fn ChengEvidenceHasViolation(path: str, nowMs: int64): bool =
    if ChengEvidenceTimestampFresh(ChengEvidenceViolationTimestamp, nowMs) &&
       ChengEvidencePathMatches(ChengEvidenceViolationPath, path):
        return true
    return false
