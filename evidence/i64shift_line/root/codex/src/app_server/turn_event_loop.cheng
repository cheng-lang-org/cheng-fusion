# codex app-server turn event loop slice.

import std/strings
import std/system
import cheng/codex/std/process
import cheng/codex/app_server/transport_tcp as tcp
import cheng/codex/protocol/wire as wire
import cheng/codex/config/home as home
import cheng/codex/core/thread_runtime as core_runtime
import cheng/codex/app_server/cheng_agent_runtime
import cheng/codex/app_server/cheng_native_tools

@importc("calloc")
fn rustCsgTurnEventCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn rustCsgTurnEventMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("free")
fn rustCsgTurnEventFree(raw: ptr)

@ffi_owned_result(free = free)
@importc("cheng_http_post")
fn rustCsgTurnEventHttpPostAbi(url: cstring, body: cstring, headers: cstring): owned_cstring

@importc("cheng_http_sse_post_start")
fn rustCsgTurnEventSsePostStartAbi(url: cstring, body: cstring, headers: cstring): int32

@ffi_owned_result(free = free)
@importc("cheng_http_sse_poll")
fn rustCsgTurnEventSsePollAbi(handle: int32, timeoutMs: int32): owned_cstring

@importc("cheng_http_sse_close")
fn rustCsgTurnEventSseClose(handle: int32): int32

@ffi_owned_result(free = free)
@importc("cheng_http_last_error")
fn rustCsgTurnEventHttpLastErrorAbi(): owned_cstring

fn rustCsgTurnEventCString(text: str): cstring =
    let raw = rustCsgTurnEventCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        rustCsgTurnEventMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn rustCsgTurnEventFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        rustCsgTurnEventFree(ptr(raw))

fn rustCsgTurnEventHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = rustCsgTurnEventCString(url)
    let bodyRaw = rustCsgTurnEventCString(body)
    let headersRaw = rustCsgTurnEventCString(headers)
    let out: str = rustCsgTurnEventHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    rustCsgTurnEventFreeCString(urlRaw)
    rustCsgTurnEventFreeCString(bodyRaw)
    rustCsgTurnEventFreeCString(headersRaw)
    return out

fn rustCsgTurnEventSsePostStart(url: str, body: str, headers: str): int32 =
    let urlRaw = rustCsgTurnEventCString(url)
    let bodyRaw = rustCsgTurnEventCString(body)
    let headersRaw = rustCsgTurnEventCString(headers)
    let handle = rustCsgTurnEventSsePostStartAbi(urlRaw, bodyRaw, headersRaw)
    rustCsgTurnEventFreeCString(urlRaw)
    rustCsgTurnEventFreeCString(bodyRaw)
    rustCsgTurnEventFreeCString(headersRaw)
    return handle

fn rustCsgTurnEventSsePoll(handle: int32, timeoutMs: int32): str =
    let out: str = rustCsgTurnEventSsePollAbi(handle, timeoutMs)
    return out

fn rustCsgTurnEventHttpLastError(): str =
    let out: str = rustCsgTurnEventHttpLastErrorAbi()
    return out

@abi_internal
@importc("RustCsgGetEnv")
fn rustCsgTurnEventGetEnv(name: str): str

@importc("RustCsgGetCurrentTimeMs")
fn rustCsgTurnEventNowMs(): int64

@abi_internal
@importc("RustCsgUuidV4")
fn rustCsgTurnEventUuidV4(): str

fn rustCsgTurnEventUuidV7(): str =
    assert(false, "RustCsgUuidV7 provider is not wired")
    return ""

@abi_internal
@importc("RustCsgWriteFile")
fn rustCsgTurnEventWriteFile(path: str, content: str): int32

var TurnEventAdditionalContextThreadIds: str[]
var TurnEventAdditionalContextKeys: str[]
var TurnEventAdditionalContextValues: str[]
var TurnEventAdditionalContextKinds: str[]

fn turnEventStartsWith(text: str, prefix: str): bool =
    if text.len < prefix.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn turnEventPreview(text: str): str =
    if text.len <= 240:
        return text
    return strings.SliceBytes(text, 0, 240)

fn turnEventMatchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0:
        return false
    if pos + needle.len > text.len:
        return false
    var i: int32
    while i < needle.len:
        if text[pos + i] != needle[i]:
            return false
        i = i + 1
    return true

fn turnEventCountMatches(text: str, needle: str): int32 =
    if needle == "":
        return 0
    var count: int32
    var i: int32
    while i < text.len:
        if turnEventMatchesAt(text, i, needle):
            count = count + 1
            i = i + needle.len
        else:
            i = i + 1
    return count

fn turnEventSkipJsonSpace(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len:
        let code = int32(text[i])
        if code != 32 && code != 10 && code != 13 && code != 9:
            return i
        i = i + 1
    return i

fn turnEventSkipJsonSpaceStable(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len:
        let one = strings.SliceBytes(text, i, 1)
        if one != " " && one != "\n" && one != "\r" && one != "\t":
            return i
        i = i + 1
    return i

fn turnEventJsonStringAt(text: str, start: int32): str =
    var out: str
    var i = start
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                return ""
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = wire.RustCsgCat(out, strings.SliceBytes(text, i + 1, 1))
            elif escaped == 'n':
                out = wire.RustCsgCat(out, "\n")
            elif escaped == 'r':
                out = wire.RustCsgCat(out, "\r")
            elif escaped == 't':
                out = wire.RustCsgCat(out, "\t")
            else:
                return ""
            i = i + 2
            continue
        if ch == '"':
            return out
        out = wire.RustCsgCat(out, strings.SliceBytes(text, i, 1))
        i = i + 1
    return ""

fn turnEventJsonFindString(text: str, key: str): str =
    return turnEventJsonFindStringNth(text, key, 0)

fn turnEventJsonFindStringNth(text: str, key: str, targetIndex: int32): str =
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var i: int32
    var found: int32
    while i < text.len:
        if turnEventMatchesAt(text, i, pattern):
            var p = turnEventSkipJsonSpace(text, i + pattern.len)
            if p < text.len && text[p] == ':':
                p = turnEventSkipJsonSpace(text, p + 1)
                if p < text.len && text[p] == '"':
                    let value = turnEventJsonStringAt(text, p + 1)
                    if found == targetIndex:
                        return value
                    found = found + 1
        i = i + 1
    return ""

fn turnEventDigitValue(ch: char): int32 =
    if ch == '0': return 0
    if ch == '1': return 1
    if ch == '2': return 2
    if ch == '3': return 3
    if ch == '4': return 4
    if ch == '5': return 5
    if ch == '6': return 6
    if ch == '7': return 7
    if ch == '8': return 8
    if ch == '9': return 9
    return -1

fn turnEventJsonFindInt64(text: str, key: str): int64 =
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var i: int32
    while i < text.len:
        if turnEventMatchesAt(text, i, pattern):
            var p = turnEventSkipJsonSpace(text, i + pattern.len)
            if p < text.len && text[p] == ':':
                p = turnEventSkipJsonSpace(text, p + 1)
                var sign: int64 = int64(1)
                if p < text.len && text[p] == '-':
                    sign = int64(0) - int64(1)
                    p = p + 1
                var out: int64
                var sawDigit: bool
                while p < text.len:
                    let digit = turnEventDigitValue(text[p])
                    if digit < 0:
                        break
                    sawDigit = true
                    out = out * int64(10) + int64(digit)
                    p = p + 1
                if sawDigit:
                    return out * sign
        i = i + 1
    return int64(0)

fn turnEventParsePositiveInt32(raw: str): int32 =
    var out: int32
    var i: int32
    while i < raw.len:
        let digit = turnEventDigitValue(raw[i])
        if digit < 0:
            return -1
        out = out * 10 + digit
        i = i + 1
    return out

fn turnEventIsTrimSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn turnEventTrimAscii(text: str): str =
    var start: int32
    var end: int32 = text.len
    while start < text.len && turnEventIsTrimSpace(text[start]):
        start = start + 1
    while end > start && turnEventIsTrimSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn turnEventHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return 1
    if ch >= 'a' && ch <= 'f':
        return 1
    if ch >= 'A' && ch <= 'F':
        return 1
    return 0

fn turnEventIsUuid(value: str): bool =
    if value.len != 36:
        return false
    var i: int32
    while i < value.len:
        let ch = value[i]
        if i == 8 || i == 13 || i == 18 || i == 23:
            if ch != '-':
                return false
        elif turnEventHexValue(ch) == 0:
            return false
        i = i + 1
    return true

fn turnEventHasField(text: str, key: str): bool =
    return wire.RustCsgContains(text, wire.RustCsgCat3("\"", key, "\""))

fn turnEventAppendNotification(out: str, notification: str): str =
    if notification == "":
        return out
    if out != "":
        return wire.RustCsgCat3(out, "\n", notification)
    return notification

fn turnEventWriteAll(fd: int32, data: str): bool =
    var offset: int32
    while offset < data.len:
        let chunk = strings.SliceBytes(data, offset, data.len - offset)
        let wrote = process.ProcessWriteFd(fd, chunk)
        if wrote <= 0:
            return false
        offset = offset + wrote
    return true

fn turnEventWriteJsonLine(fd: int32, body: str): bool =
    if body == "":
        return true
    return turnEventWriteAll(fd, wire.RustCsgCat(body, "\n"))

fn turnEventWriteWebSocketFrameToAll(clientFds: int32[], body: str): bool =
    var i: int32
    while i < clientFds.len:
        if tcp.RustCsgWebSocketWriteFrame(clientFds[i], body) != 0:
            return false
        i = i + 1
    return true

fn turnEventWriteTarget(fd: int32, clientFds: int32[], targetKind: int32, body: str): bool =
    if body == "":
        return true
    if targetKind == 2:
        return turnEventWriteWebSocketFrameToAll(clientFds, body)
    return turnEventWriteJsonLine(fd, body)

fn turnEventWriteServerRequestTarget(fd: int32, requestFds: int32[], targetKind: int32, body: str): bool =
    if body == "":
        return true
    if targetKind == 2:
        return turnEventWriteWebSocketFrameToAll(requestFds, body)
    return turnEventWriteJsonLine(fd, body)

fn turnEventFindHeaderEnd(text: str): int32 =
    var i: int32
    while i + 4 <= text.len:
        if text[i] == '\r' && text[i + 1] == '\n' && text[i + 2] == '\r' && text[i + 3] == '\n':
            return i
        i = i + 1
    return -1

fn turnEventParseContentLength(header: str): int32 =
    let prefix = "Content-Length:"
    var i: int32
    while i + prefix.len <= header.len:
        if turnEventMatchesAt(header, i, prefix):
            i = i + prefix.len
            while i < header.len && (header[i] == ' ' || header[i] == '\t'):
                i = i + 1
            var start = i
            while i < header.len && header[i] >= '0' && header[i] <= '9':
                i = i + 1
            if i == start:
                return -1
            return turnEventParsePositiveInt32(strings.SliceBytes(header, start, i - start))
        i = i + 1
    return -1

fn turnEventTryReadContentLengthFrame(buffer: str,
                                      outBody: var str,
                                      outRest: var str,
                                      outBlocked: var bool): bool =
    outBody = ""
    outRest = ""
    outBlocked = false
    let headerEnd = turnEventFindHeaderEnd(buffer)
    if headerEnd < 0:
        outBlocked = true
        return false
    let header = strings.SliceBytes(buffer, 0, headerEnd)
    let contentLength = turnEventParseContentLength(header)
    if contentLength < 0:
        return false
    let bodyStart = headerEnd + 4
    if buffer.len < bodyStart + contentLength:
        outBlocked = true
        return false
    outBody = strings.SliceBytes(buffer, bodyStart, contentLength)
    outRest = strings.SliceBytes(buffer, bodyStart + contentLength, buffer.len - bodyStart - contentLength)
    return true

fn turnEventTryReadJsonLineFrame(buffer: str,
                                 outBody: var str,
                                 outRest: var str,
                                 outBlocked: var bool): bool =
    outBody = ""
    outRest = ""
    outBlocked = false
    var newlineAt: int32 = -1
    var i: int32
    while i < buffer.len:
        if buffer[i] == '\n':
            newlineAt = i
            break
        i = i + 1
    if newlineAt < 0:
        outBlocked = true
        return false
    var lineLen = newlineAt
    if lineLen > 0 && buffer[lineLen - 1] == '\r':
        lineLen = lineLen - 1
    outBody = strings.SliceBytes(buffer, 0, lineLen)
    outRest = strings.SliceBytes(buffer, newlineAt + 1, buffer.len - newlineAt - 1)
    return true

fn turnEventTryReadStdioFrame(buffer: str,
                              outBody: var str,
                              outRest: var str,
                              outBlocked: var bool): bool =
    if turnEventStartsWith(buffer, "Content-Length:"):
        return turnEventTryReadContentLengthFrame(buffer, outBody, outRest, outBlocked)
    return turnEventTryReadJsonLineFrame(buffer, outBody, outRest, outBlocked)

fn turnEventJsonRpcFrameId(frame: str, outError: var str): int32 =
    outError = ""
    if !turnEventHasField(frame, "id"):
        outError = wire.RustCsgCat("dynamic tool client frame missing id: ", turnEventPreview(frame))
        return -1
    return int32(turnEventJsonFindInt64(frame, "id"))

fn turnEventJsonRpcResponseMatches(frame: str, requestId: int32, outError: var str): bool =
    outError = ""
    var idError: str
    let seenId = turnEventJsonRpcFrameId(frame, idError)
    if idError != "":
        outError = idError
        return false
    if seenId != requestId:
        outError = "dynamic tool client response id mismatch: expected "
        outError = wire.RustCsgCat(outError, strings.IntToStr(requestId))
        outError = wire.RustCsgCat(outError, " got ")
        outError = wire.RustCsgCat(outError, strings.IntToStr(seenId))
        return false
    return true

fn turnEventJsonRpcResponseTransportDrop(frame: str): bool =
    if turnEventHasField(frame, "result"):
        return false
    if turnEventHasField(frame, "error"):
        return false
    return true

fn turnEventReadStdioServerResponseWithBuffer(requestId: int32,
                                              ioBuffer: var str,
                                              outResponse: var str,
                                              outError: var str): bool =
    outResponse = ""
    outError = ""
    var idlePolls: int32
    while idlePolls <= 1800:
        if ioBuffer.len > 0:
            var frame: str
            var rest: str
            var blocked: bool
            if turnEventTryReadStdioFrame(ioBuffer, frame, rest, blocked):
                ioBuffer = rest
                if frame == "":
                    continue
                if !turnEventJsonRpcResponseMatches(frame, requestId, outError):
                    return false
                if turnEventJsonRpcResponseTransportDrop(frame):
                    continue
                outResponse = frame
                return true
            if !blocked:
                outError = wire.RustCsgCat("invalid dynamic tool stdio response frame: ", turnEventPreview(ioBuffer))
                return false
        let chunk = process.ProcessReadFdBlocking(0, 100)
        if chunk.len == 0:
            idlePolls = idlePolls + 1
        else:
            idlePolls = 0
            ioBuffer = wire.RustCsgCat(ioBuffer, chunk)
    outError = "dynamic tool client response timed out"
    return false

fn turnEventReadStdioServerResponse(requestId: int32, outResponse: var str, outError: var str): bool =
    var buffer: str
    return turnEventReadStdioServerResponseWithBuffer(requestId, buffer, outResponse, outError)

fn turnEventReadWebSocketServerResponse(requestFds: int32[],
                                        requestId: int32,
                                        outResponse: var str,
                                        outError: var str): bool =
    outResponse = ""
    outError = ""
    if requestFds.len == 0:
        outError = "dynamic tool websocket response has no request connection"
        return false
    var idlePolls: int32
    while idlePolls <= 1800:
        var sawBlocked: bool
        var i: int32
        while i < requestFds.len:
            let frame = tcp.RustCsgWebSocketTryReadFrame(requestFds[i], 10)
            if frame == "__RUST_CSG_WS_FRAME_BLOCKED__":
                sawBlocked = true
            elif frame == "":
                outError = "dynamic tool websocket request connection closed"
                return false
            else:
                if !turnEventJsonRpcResponseMatches(frame, requestId, outError):
                    return false
                if turnEventJsonRpcResponseTransportDrop(frame):
                    continue
                outResponse = frame
                return true
            i = i + 1
        if sawBlocked:
            idlePolls = idlePolls + 1
        else:
            idlePolls = idlePolls + 1
    outError = "dynamic tool websocket client response timed out"
    return false

fn turnEventReadServerResponseTarget(requestFds: int32[],
                                     targetKind: int32,
                                     requestId: int32,
                                     stdioBuffer: var str,
                                     outResponse: var str,
                                     outError: var str): bool =
    if targetKind == 2:
        return turnEventReadWebSocketServerResponse(requestFds, requestId, outResponse, outError)
    return turnEventReadStdioServerResponseWithBuffer(requestId, stdioBuffer, outResponse, outError)

fn turnEventParseHttpStatus(raw: str): int32 =
    if raw == "":
        return 0
    if turnEventHasField(raw, "status"):
        return wire.RustCsgJsonFindInt32(raw, "status")
    return 0

fn turnEventReadOpenAiBaseUrl(): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return ""
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return ""
    let providerBaseUrl = turnEventParseSelectedProviderStringValue(configContent, "base_url")
    if providerBaseUrl != "":
        return providerBaseUrl
    return turnEventParseConfigStringValue(configContent, "openai_base_url")

fn turnEventParseConfigStringValue(configContent: str, key: str): str =
    let keyLen: int32 = strings.Len(key)
    if keyLen <= 0:
        return ""
    var i: int32
    while i < configContent.len:
        if i > 0:
            let prev = configContent[i - 1]
            if prev != '\n' && prev != '\r':
                i = i + 1
                continue
        var pos: int32 = i
        while pos < configContent.len && (configContent[pos] == ' ' || configContent[pos] == '\t'):
            pos = pos + 1
        if pos + keyLen < configContent.len:
            let candidate = strings.SliceBytes(configContent, pos, keyLen)
            if candidate == key:
                var valuePos = pos + keyLen
                while valuePos < configContent.len && (configContent[valuePos] == ' ' || configContent[valuePos] == '\t'):
                    valuePos = valuePos + 1
                if valuePos < configContent.len && configContent[valuePos] == '=':
                    valuePos = valuePos + 1
                    while valuePos < configContent.len && (configContent[valuePos] == ' ' || configContent[valuePos] == '\t'):
                        valuePos = valuePos + 1
                    if valuePos < configContent.len && configContent[valuePos] == '"':
                        var endPos = valuePos + 1
                        while endPos < configContent.len && configContent[endPos] != '"':
                            endPos = endPos + 1
                        if endPos < configContent.len:
                            return strings.SliceBytes(configContent, valuePos + 1, endPos - valuePos - 1)
        while i < configContent.len && configContent[i] != '\n':
            i = i + 1
        if i < configContent.len:
            i = i + 1
    return ""

fn turnEventFindLineEnd(text: str, start: int32): int32 =
    var i = start
    while i < text.len:
        if text[i] == '\n':
            return i
        i = i + 1
    return text.len

fn turnEventTomlStripComment(line: str): str =
    var quote: char
    var i: int32
    while i < line.len:
        let ch = line[i]
        if quote != '\0':
            if ch == quote:
                quote = '\0'
        elif ch == '"' || ch == '\'':
            quote = ch
        elif ch == '#':
            return turnEventTrimAscii(strings.SliceBytes(line, 0, i))
        i = i + 1
    return turnEventTrimAscii(line)

fn turnEventTomlFindEquals(line: str): int32 =
    var quote: char
    var i: int32
    while i < line.len:
        let ch = line[i]
        if quote != '\0':
            if ch == quote:
                quote = '\0'
        elif ch == '"' || ch == '\'':
            quote = ch
        elif ch == '=':
            return i
        i = i + 1
    return -1

fn turnEventTomlStringFromRaw(valueRaw: str): str =
    let value = turnEventTrimAscii(valueRaw)
    if value.len < 2:
        return ""
    let quote = value[0]
    if quote != '"' && quote != '\'':
        return ""
    if value[value.len - 1] != quote:
        return ""
    return strings.SliceBytes(value, 1, value.len - 2)

fn turnEventTomlParseNonNegativeInt32(valueRaw: str, fieldName: str, outError: var str): int32 =
    outError = ""
    let value = turnEventTrimAscii(valueRaw)
    if value == "":
        outError = wire.RustCsgCat3("invalid config.toml ", fieldName, ": empty integer")
        return 0
    var out: int32
    var i: int32
    while i < value.len:
        let digit = turnEventDigitValue(value[i])
        if digit < 0:
            outError = wire.RustCsgCat3("invalid config.toml ", fieldName, ": expected non-negative integer")
            return 0
        if out <= 100:
            out = out * 10 + digit
        i = i + 1
    return out

fn turnEventParseRootConfigValueRaw(configContent: str, key: str, outFound: var bool): str =
    outFound = false
    var pos: int32
    while pos < configContent.len:
        let lineEnd = turnEventFindLineEnd(configContent, pos)
        let line = strings.SliceBytes(configContent, pos, lineEnd - pos)
        let trimmed = turnEventTomlStripComment(line)
        if turnEventStartsWith(trimmed, "["):
            return ""
        let eq = turnEventTomlFindEquals(trimmed)
        if eq > 0:
            let keyRaw = turnEventTrimAscii(strings.SliceBytes(trimmed, 0, eq))
            if keyRaw == key:
                outFound = true
                return turnEventTrimAscii(strings.SliceBytes(trimmed, eq + 1, trimmed.len - eq - 1))
        pos = lineEnd + 1
    return ""

fn turnEventConfiguredModelProviderId(configContent: str): str =
    var found: bool
    let valueRaw = turnEventParseRootConfigValueRaw(configContent, "model_provider", found)
    if found:
        let providerId = turnEventTomlStringFromRaw(valueRaw)
        if providerId != "":
            return providerId
    return "openai"

fn turnEventParseProviderConfigValueRaw(configContent: str, providerId: str, key: str, outFound: var bool): str =
    outFound = false
    if providerId == "":
        return ""
    let header = wire.RustCsgCat3("[model_providers.", providerId, "]")
    var inProvider: bool
    var pos: int32
    while pos < configContent.len:
        let lineEnd = turnEventFindLineEnd(configContent, pos)
        let line = strings.SliceBytes(configContent, pos, lineEnd - pos)
        let trimmed = turnEventTomlStripComment(line)
        if turnEventStartsWith(trimmed, "["):
            if trimmed == header:
                inProvider = true
            elif inProvider:
                return ""
        elif inProvider:
            let eq = turnEventTomlFindEquals(trimmed)
            if eq > 0:
                let keyRaw = turnEventTrimAscii(strings.SliceBytes(trimmed, 0, eq))
                if keyRaw == key:
                    outFound = true
                    return turnEventTrimAscii(strings.SliceBytes(trimmed, eq + 1, trimmed.len - eq - 1))
        pos = lineEnd + 1
    return ""

fn turnEventParseSelectedProviderStringValue(configContent: str, key: str): str =
    let providerId = turnEventConfiguredModelProviderId(configContent)
    var found: bool
    let valueRaw = turnEventParseProviderConfigValueRaw(configContent, providerId, key, found)
    if !found:
        return ""
    return turnEventTomlStringFromRaw(valueRaw)

fn turnEventTomlKeyName(keyRaw: str): str =
    let trimmed = turnEventTrimAscii(keyRaw)
    let quoted = turnEventTomlStringFromRaw(trimmed)
    if quoted != "":
        return quoted
    return trimmed

fn turnEventTomlInlineTableStringValue(tableRaw: str, key: str): str =
    let table = turnEventTrimAscii(tableRaw)
    if table.len < 2:
        return ""
    if table[0] != '{' || table[table.len - 1] != '}':
        return ""
    let inner = turnEventTrimAscii(strings.SliceBytes(table, 1, table.len - 2))
    let eq = turnEventTomlFindEquals(inner)
    if eq <= 0:
        return ""
    let entryKey = turnEventTomlKeyName(strings.SliceBytes(inner, 0, eq))
    if entryKey != key:
        return ""
    return turnEventTomlStringFromRaw(strings.SliceBytes(inner, eq + 1, inner.len - eq - 1))

fn turnEventReadSelectedProviderQueryParam(key: str): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return ""
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return ""
    let providerId = turnEventConfiguredModelProviderId(configContent)
    var found: bool
    let valueRaw = turnEventParseProviderConfigValueRaw(configContent, providerId, "query_params", found)
    if !found:
        return ""
    return turnEventTomlInlineTableStringValue(valueRaw, key)

fn turnEventReadSelectedProviderApiVersion(): str =
    return turnEventReadSelectedProviderQueryParam("api-version")

fn turnEventEffectiveStreamMaxRetries(configValue: int32): int32 =
    if configValue < 0:
        return 5
    if configValue > 100:
        return 100
    return configValue

fn turnEventReadStreamMaxRetries(outError: var str): int32 =
    outError = ""
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return turnEventEffectiveStreamMaxRetries(-1)
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return turnEventEffectiveStreamMaxRetries(-1)
    let providerId = turnEventConfiguredModelProviderId(configContent)
    var found: bool
    let valueRaw = turnEventParseProviderConfigValueRaw(configContent, providerId, "stream_max_retries", found)
    if !found:
        return turnEventEffectiveStreamMaxRetries(-1)
    let configuredValue = turnEventTomlParseNonNegativeInt32(valueRaw, "stream_max_retries", outError)
    if outError != "":
        return 0
    return turnEventEffectiveStreamMaxRetries(configuredValue)

fn turnEventResponsesEndpoint(): str =
    var baseUrl = turnEventReadOpenAiBaseUrl()
    if baseUrl == "":
        return ""
    while strings.Len(baseUrl) > 0 && baseUrl[strings.Len(baseUrl) - 1] == '/':
        baseUrl = strings.SliceBytes(baseUrl, 0, strings.Len(baseUrl) - 1)
    var endpoint = wire.RustCsgCat(baseUrl, "/responses")
    let apiVersion = turnEventReadSelectedProviderApiVersion()
    if apiVersion != "":
        endpoint = wire.RustCsgCat(endpoint, "?api-version=")
        endpoint = wire.RustCsgCat(endpoint, apiVersion)
    return endpoint

fn turnEventConfiguredProviderId(): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "" || codexHome == "":
        return "openai"
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let configContent = home.RustCsgReadFile(configPath)
    if configContent == "":
        return "openai"
    return turnEventConfiguredModelProviderId(configContent)

fn turnEventAsciiLowerChar(ch: char): str =
    if ch == 'A': return "a"
    if ch == 'B': return "b"
    if ch == 'C': return "c"
    if ch == 'D': return "d"
    if ch == 'E': return "e"
    if ch == 'F': return "f"
    if ch == 'G': return "g"
    if ch == 'H': return "h"
    if ch == 'I': return "i"
    if ch == 'J': return "j"
    if ch == 'K': return "k"
    if ch == 'L': return "l"
    if ch == 'M': return "m"
    if ch == 'N': return "n"
    if ch == 'O': return "o"
    if ch == 'P': return "p"
    if ch == 'Q': return "q"
    if ch == 'R': return "r"
    if ch == 'S': return "s"
    if ch == 'T': return "t"
    if ch == 'U': return "u"
    if ch == 'V': return "v"
    if ch == 'W': return "w"
    if ch == 'X': return "x"
    if ch == 'Y': return "y"
    if ch == 'Z': return "z"
    return ""

fn turnEventAsciiLower(text: str): str =
    var out: str
    for i in 0..<text.len:
        let ch = text[i]
        let lower = turnEventAsciiLowerChar(ch)
        if lower != "":
            out = wire.RustCsgCat(out, lower)
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(text, i, 1))
    return out

fn turnEventResponsesStoreRaw(): str =
    let providerId = turnEventAsciiLower(turnEventConfiguredProviderId())
    if providerId == "azure":
        return "true"
    let baseUrl = turnEventAsciiLower(turnEventReadOpenAiBaseUrl())
    if wire.RustCsgContains(baseUrl, "openai.azure.") || wire.RustCsgContains(baseUrl, "cognitiveservices.azure."):
        return "true"
    if wire.RustCsgContains(baseUrl, "aoai.azure.") || wire.RustCsgContains(baseUrl, "azure-api."):
        return "true"
    if wire.RustCsgContains(baseUrl, "azurefd.") || wire.RustCsgContains(baseUrl, "windows.net/openai"):
        return "true"
    return "false"

fn turnEventInputText(paramsJson: str): str =
    let inputJson = wire.RustCsgJsonFindArray(paramsJson, "input")
    return wire.RustCsgJsonFindOptionalStr(inputJson, "text")

fn turnEventModelSupportsParallelToolCalls(model: str): bool =
    if model == "gpt-5.3-codex": return true
    if model == "gpt-5.4": return true
    if model == "gpt-5.2-codex": return true
    if model == "gpt-5.2": return true
    if model == "gpt-5.1": return true
    return false

fn turnEventModelSupportsReasoningSummaries(model: str): bool =
    if model == "gpt-5.3-codex": return true
    if model == "gpt-5.4": return true
    if model == "gpt-5.2-codex": return true
    if model == "gpt-5.1-codex-max": return true
    if model == "gpt-5.1-codex": return true
    if model == "gpt-5.2": return true
    if model == "gpt-5.1": return true
    if model == "gpt-5-codex": return true
    if model == "gpt-5": return true
    if model == "gpt-oss-120b": return true
    if model == "gpt-oss-20b": return true
    if model == "gpt-5.1-codex-mini": return true
    if model == "gpt-5-codex-mini": return true
    return false

fn turnEventModelDefaultReasoningLevel(model: str): str =
    if turnEventModelSupportsReasoningSummaries(model):
        return "medium"
    return ""

fn turnEventModelDefaultReasoningSummary(model: str): str =
    if model == "gpt-5.3-codex": return "none"
    if model == "gpt-5.4": return "none"
    if turnEventModelSupportsReasoningSummaries(model):
        return "auto"
    return ""

fn turnEventReasoningRaw(model: str, paramsJson: str): str =
    if !turnEventModelSupportsReasoningSummaries(model):
        return "null"
    var effort = wire.RustCsgJsonFindOptionalStr(paramsJson, "effort")
    if effort == "":
        effort = turnEventModelDefaultReasoningLevel(model)
    var summary = wire.RustCsgJsonFindOptionalStr(paramsJson, "summary")
    if summary == "":
        summary = turnEventModelDefaultReasoningSummary(model)
    var out = "{"
    var first: bool = true
    if effort != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("effort", effort))
        first = false
    if summary != "" && summary != "none":
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("summary", summary))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventIncludeRaw(reasoningRaw: str): str =
    if reasoningRaw == "null":
        return "[]"
    return "[\"reasoning.encrypted_content\"]"

fn turnEventModelSupportsServiceTier(model: str, serviceTier: str): bool =
    if serviceTier != "priority":
        return false
    return model == "gpt-5.4"

fn turnEventServiceTierForRequest(model: str, serviceTierJson: str): str =
    if serviceTierJson == "" || serviceTierJson == "null":
        return ""
    if serviceTierJson.len < 2 || serviceTierJson[0] != '"':
        return ""
    let serviceTier = wire.RustCsgJsonFindOptionalStr(wire.RustCsgCat3("{\"serviceTier\":", serviceTierJson, "}"), "serviceTier")
    if serviceTier == "" || serviceTier == "default":
        return ""
    if !turnEventModelSupportsServiceTier(model, serviceTier):
        return ""
    return serviceTier

fn turnEventModelDefaultVerbosity(model: str): str =
    if model == "gpt-5.3-codex": return "low"
    if model == "gpt-5.4": return "low"
    if model == "gpt-5.2": return "low"
    if model == "gpt-5.1": return "low"
    return ""

fn turnEventTextControlsRaw(model: str, paramsJson: str): str =
    let verbosity = turnEventModelDefaultVerbosity(model)
    var outputSchemaJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "outputSchema")
    if outputSchemaJson == "null":
        outputSchemaJson = ""
    if verbosity == "" && outputSchemaJson == "":
        return ""
    var out = "{"
    var first: bool = true
    if verbosity != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("verbosity", verbosity))
        first = false
    if outputSchemaJson != "":
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, "\"format\":{\"type\":\"json_schema\",\"strict\":true,\"schema\":")
        out = wire.RustCsgCat(out, outputSchemaJson)
        out = wire.RustCsgCat(out, ",\"name\":\"codex_output_schema\"}")
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventResolveInstallationId(outError: var str): str =
    outError = ""
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        outError = homeError
        return ""
    let path = home.RustCsgPathJoinChild(codexHome, "installation_id")
    let existing = turnEventTrimAscii(home.RustCsgReadFile(path))
    if turnEventIsUuid(existing):
        return existing
    let generated = rustCsgTurnEventUuidV4()
    if !turnEventIsUuid(generated):
        outError = "failed to generate valid installation_id"
        return ""
    let writeOk = rustCsgTurnEventWriteFile(path, generated)
    if writeOk == 0:
        outError = "failed to write installation_id"
        return ""
    return generated

fn turnEventClientMetadataRaw(outError: var str): str =
    let installationId = turnEventResolveInstallationId(outError)
    if outError != "":
        return ""
    return wire.RustCsgCat3("{\"x-codex-installation-id\":", wire.RustCsgJsonQuote(installationId), "}")

fn turnEventDynamicToolDeferred(toolJson: str): bool =
    if turnEventHasField(toolJson, "deferLoading"):
        return wire.RustCsgJsonFindOptionalBool(toolJson, "deferLoading")
    if turnEventHasField(toolJson, "exposeToContext"):
        return !wire.RustCsgJsonFindOptionalBool(toolJson, "exposeToContext")
    return false

fn turnEventJsonStringEnd(text: str, start: int32): int32 =
    if start >= text.len || text[start] != '"':
        return -1
    var i = start + 1
    var escaped: bool
    while i < text.len:
        let ch = text[i]
        if escaped:
            escaped = false
        elif ch == '\\':
            escaped = true
        elif ch == '"':
            return i + 1
        i = i + 1
    return -1

fn turnEventJsonCompositeEnd(text: str, start: int32, openCh: char, closeCh: char): int32 =
    if start >= text.len || text[start] != openCh:
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == openCh:
            depth = depth + 1
        elif ch == closeCh:
            depth = depth - 1
            if depth == 0:
                return i + 1
        i = i + 1
    return -1

fn turnEventJsonValueEnd(text: str, start: int32): int32 =
    let p = turnEventSkipJsonSpace(text, start)
    if p >= text.len:
        return -1
    let ch = text[p]
    if ch == '{':
        return turnEventJsonCompositeEnd(text, p, '{', '}')
    if ch == '[':
        return turnEventJsonCompositeEnd(text, p, '[', ']')
    if ch == '"':
        return turnEventJsonStringEnd(text, p)
    var i = p
    while i < text.len:
        let c = text[i]
        if c == ',' || c == '}' || c == ']' || c == ' ' || c == '\n' || c == '\r' || c == '\t':
            return i
        i = i + 1
    return i

fn turnEventJsonTopLevelValueRaw(objectJson: str, key: str): str =
    let start = turnEventSkipJsonSpace(objectJson, 0)
    if start >= objectJson.len || objectJson[start] != '{':
        return ""
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < objectJson.len:
        let ch = objectJson[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            if depth == 1 && turnEventMatchesAt(objectJson, i, pattern):
                let colon = turnEventSkipJsonSpace(objectJson, i + pattern.len)
                if colon < objectJson.len && objectJson[colon] == ':':
                    let valueStart = turnEventSkipJsonSpace(objectJson, colon + 1)
                    let valueEnd = turnEventJsonValueEnd(objectJson, valueStart)
                    if valueEnd >= valueStart:
                        return strings.SliceBytes(objectJson, valueStart, valueEnd - valueStart)
                    return ""
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return ""
        i = i + 1
    return ""

fn turnEventJsonStringFromRaw(raw: str): str =
    return wire.RustCsgJsonFindStr(wire.RustCsgCat3("{\"value\":", raw, "}"), "value")

fn turnEventJsonArrayContainsString(arrayRaw: str, value: str): bool =
    let start = turnEventSkipJsonSpace(arrayRaw, 0)
    if start >= arrayRaw.len || arrayRaw[start] != '[':
        return false
    var pos = turnEventSkipJsonSpace(arrayRaw, start + 1)
    while pos < arrayRaw.len:
        if arrayRaw[pos] == ']':
            return false
        if arrayRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(arrayRaw, pos + 1)
            continue
        if arrayRaw[pos] != '"':
            return false
        let endPos = turnEventJsonStringEnd(arrayRaw, pos)
        if endPos < 0:
            return false
        if turnEventJsonStringFromRaw(strings.SliceBytes(arrayRaw, pos, endPos - pos)) == value:
            return true
        pos = turnEventSkipJsonSpace(arrayRaw, endPos)
    return false

fn turnEventDynamicToolSchemaTypeIs(typeRaw: str, value: str): bool =
    let p = turnEventSkipJsonSpace(typeRaw, 0)
    if p >= typeRaw.len:
        return false
    if typeRaw[p] == '"':
        return turnEventJsonStringFromRaw(strings.SliceBytes(typeRaw, p, typeRaw.len - p)) == value
    if typeRaw[p] == '[':
        return turnEventJsonArrayContainsString(typeRaw, value)
    return false

fn turnEventDynamicToolSchemaAppendField(out: var str, first: var bool, fieldRaw: str) =
    if !first:
        out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, fieldRaw)
    first = false

fn turnEventDynamicToolSchemaPrimitiveTypeRaw(name: str): str =
    if name == "string": return "\"string\""
    if name == "number": return "\"number\""
    if name == "boolean": return "\"boolean\""
    if name == "integer": return "\"integer\""
    if name == "object": return "\"object\""
    if name == "array": return "\"array\""
    if name == "null": return "\"null\""
    return ""

fn turnEventDynamicToolSchemaNormalizeTypeRaw(typeRaw: str): str =
    let p = turnEventSkipJsonSpace(typeRaw, 0)
    if p >= typeRaw.len:
        return ""
    if typeRaw[p] == '"':
        return turnEventDynamicToolSchemaPrimitiveTypeRaw(turnEventJsonStringFromRaw(strings.SliceBytes(typeRaw, p, typeRaw.len - p)))
    if typeRaw[p] != '[':
        return ""
    var out = "["
    var first = true
    var count: int32
    var single: str
    var pos = turnEventSkipJsonSpace(typeRaw, p + 1)
    while pos < typeRaw.len:
        if typeRaw[pos] == ']':
            if count == 0:
                return ""
            if count == 1:
                return single
            out = wire.RustCsgCat(out, "]")
            return out
        if typeRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(typeRaw, pos + 1)
            continue
        let valueEnd = turnEventJsonValueEnd(typeRaw, pos)
        if valueEnd < pos:
            return ""
        if typeRaw[pos] == '"':
            let valueRaw = strings.SliceBytes(typeRaw, pos, valueEnd - pos)
            let primitiveRaw = turnEventDynamicToolSchemaPrimitiveTypeRaw(turnEventJsonStringFromRaw(valueRaw))
            if primitiveRaw != "":
                count = count + 1
                if count == 1:
                    single = primitiveRaw
                turnEventDynamicToolSchemaAppendField(out, first, primitiveRaw)
        pos = turnEventSkipJsonSpace(typeRaw, valueEnd)
    return ""

fn turnEventDynamicToolSchemaSanitizeArray(arrayRaw: str): str =
    let p = turnEventSkipJsonSpace(arrayRaw, 0)
    if p >= arrayRaw.len || arrayRaw[p] != '[':
        return "[]"
    var out = "["
    var first = true
    var pos = turnEventSkipJsonSpace(arrayRaw, p + 1)
    while pos < arrayRaw.len:
        if arrayRaw[pos] == ']':
            out = wire.RustCsgCat(out, "]")
            return out
        if arrayRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(arrayRaw, pos + 1)
            continue
        let valueEnd = turnEventJsonValueEnd(arrayRaw, pos)
        if valueEnd < pos:
            return "[]"
        let childRaw = strings.SliceBytes(arrayRaw, pos, valueEnd - pos)
        let child = turnEventDynamicToolSchemaSanitizeRaw(childRaw)
        turnEventDynamicToolSchemaAppendField(out, first, child)
        pos = turnEventSkipJsonSpace(arrayRaw, valueEnd)
    return "[]"

fn turnEventHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    return -1

fn turnEventAsciiByteString(code: int32): str =
    if code == 32: return " "
    if code == 35: return "#"
    if code == 36: return "$"
    if code == 37: return "%"
    if code == 45: return "-"
    if code == 46: return "."
    if code == 47: return "/"
    if code >= 48 && code <= 57:
        return strings.SliceBytes("0123456789", code - 48, 1)
    if code >= 65 && code <= 90:
        return strings.SliceBytes("ABCDEFGHIJKLMNOPQRSTUVWXYZ", code - 65, 1)
    if code == 95: return "_"
    if code >= 97 && code <= 122:
        return strings.SliceBytes("abcdefghijklmnopqrstuvwxyz", code - 97, 1)
    if code == 126: return "~"
    return ""

fn turnEventPercentDecodeAscii(text: str): str =
    var out: str
    var i: int32
    while i < text.len:
        if text[i] == '%' && i + 2 < text.len:
            let hi = turnEventHexValue(text[i + 1])
            let lo = turnEventHexValue(text[i + 2])
            if hi >= 0 && lo >= 0:
                let decoded = turnEventAsciiByteString(hi * 16 + lo)
                if decoded != "":
                    out = wire.RustCsgCat(out, decoded)
                    i = i + 3
                    continue
        out = wire.RustCsgCat(out, strings.SliceBytes(text, i, 1))
        i = i + 1
    return out

fn turnEventJsonPointerDecodeToken(token: str): str =
    var out: str
    var i: int32
    while i < token.len:
        if token[i] == '~' && i + 1 < token.len:
            let next = token[i + 1]
            if next == '0':
                out = wire.RustCsgCat(out, "~")
                i = i + 2
                continue
            if next == '1':
                out = wire.RustCsgCat(out, "/")
                i = i + 2
                continue
        out = wire.RustCsgCat(out, strings.SliceBytes(token, i, 1))
        i = i + 1
    return out

fn turnEventDynamicToolSchemaLocalDefinitionRefValueName(refValue: str, tableKey: str): str =
    if refValue.len < 4 || refValue[0] != '#':
        return ""
    let fragment = turnEventPercentDecodeAscii(strings.SliceBytes(refValue, 1, refValue.len - 1))
    if fragment.len < 2 || fragment[0] != '/':
        return ""
    var tableEnd = 1
    while tableEnd < fragment.len && fragment[tableEnd] != '/':
        tableEnd = tableEnd + 1
    if tableEnd >= fragment.len:
        return ""
    let tableToken = strings.SliceBytes(fragment, 1, tableEnd - 1)
    let tableDecoded = turnEventJsonPointerDecodeToken(tableToken)
    if tableDecoded != tableKey:
        return ""
    var nameEnd = tableEnd + 1
    while nameEnd < fragment.len && fragment[nameEnd] != '/':
        nameEnd = nameEnd + 1
    let nameToken = strings.SliceBytes(fragment, tableEnd + 1, nameEnd - tableEnd - 1)
    if nameToken == "":
        return ""
    return turnEventJsonPointerDecodeToken(nameToken)

fn turnEventJsonStringLiteralContent(raw: str): str =
    let p = turnEventSkipJsonSpace(raw, 0)
    if p >= raw.len || raw[p] != '"':
        return ""
    let endPos = turnEventJsonStringEnd(raw, p)
    if endPos <= p + 1:
        return ""
    return strings.SliceBytes(raw, p + 1, endPos - p - 2)

fn turnEventDynamicToolSchemaLocalDefinitionRefName(refRaw: str, tableKey: str): str =
    let literalValue = turnEventJsonStringLiteralContent(refRaw)
    if literalValue != "":
        let literalName = turnEventDynamicToolSchemaLocalDefinitionRefValueName(literalValue, tableKey)
        if literalName != "":
            return literalName
    return turnEventDynamicToolSchemaLocalDefinitionRefValueName(turnEventJsonStringFromRaw(refRaw), tableKey)

fn turnEventDynamicToolSchemaEncodePointerTokenForRef(token: str): str =
    var out: str
    var i: int32
    while i < token.len:
        let ch = token[i]
        if ch == '~':
            out = wire.RustCsgCat(out, "~0")
        elif ch == '/':
            out = wire.RustCsgCat(out, "~1")
        elif ch == ' ':
            out = wire.RustCsgCat(out, "%20")
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(token, i, 1))
        i = i + 1
    return out

fn turnEventDynamicToolSchemaTextReferencesDefinition(text: str, tableKey: str, name: str): bool =
    if name == "":
        return false
    var prefix: str
    if tableKey == "$defs":
        prefix = "\"#/$defs/"
    else:
        prefix = "\"#/definitions/"
    let exact = wire.RustCsgCat3(prefix, name, "\"")
    if wire.RustCsgContains(text, exact):
        return true
    let nested = wire.RustCsgCat3(prefix, name, "/")
    if wire.RustCsgContains(text, nested):
        return true
    let encodedName = turnEventDynamicToolSchemaEncodePointerTokenForRef(name)
    if encodedName != name:
        let encodedExact = wire.RustCsgCat3(prefix, encodedName, "\"")
        if wire.RustCsgContains(text, encodedExact):
            return true
        let encodedNested = wire.RustCsgCat3(prefix, encodedName, "/")
        if wire.RustCsgContains(text, encodedNested):
            return true
    if tableKey == "$defs":
        let encodedPrefix = "\"#/%24defs/"
        let encodedExact2 = wire.RustCsgCat3(encodedPrefix, encodedName, "\"")
        if wire.RustCsgContains(text, encodedExact2):
            return true
        let encodedNested2 = wire.RustCsgCat3(encodedPrefix, encodedName, "/")
        if wire.RustCsgContains(text, encodedNested2):
            return true
    var i: int32
    while i < text.len:
        if turnEventMatchesAt(text, i, "\"$ref\""):
            let colon = turnEventSkipJsonSpace(text, i + 6)
            if colon < text.len && text[colon] == ':':
                let valueStart = turnEventSkipJsonSpace(text, colon + 1)
                let valueEnd = turnEventJsonValueEnd(text, valueStart)
                if valueEnd > valueStart:
                    let refRaw = strings.SliceBytes(text, valueStart, valueEnd - valueStart)
                    if turnEventDynamicToolSchemaLocalDefinitionRefName(refRaw, tableKey) == name:
                        return true
        i = i + 1
    return false

fn turnEventDynamicToolSchemaRootReferencesDefinition(valueRaw: str, tableKey: str, name: str): bool =
    if name == "":
        return false
    let p = turnEventSkipJsonSpace(valueRaw, 0)
    if p >= valueRaw.len:
        return false
    if valueRaw[p] == '[':
        var pos = turnEventSkipJsonSpace(valueRaw, p + 1)
        while pos < valueRaw.len:
            if valueRaw[pos] == ']':
                return false
            if valueRaw[pos] == ',':
                pos = turnEventSkipJsonSpace(valueRaw, pos + 1)
                continue
            let childEnd = turnEventJsonValueEnd(valueRaw, pos)
            if childEnd < pos:
                return false
            let childRaw = strings.SliceBytes(valueRaw, pos, childEnd - pos)
            if turnEventDynamicToolSchemaRootReferencesDefinition(childRaw, tableKey, name):
                return true
            pos = turnEventSkipJsonSpace(valueRaw, childEnd)
        return false
    if valueRaw[p] != '{':
        return false
    let schemaRefRaw = turnEventJsonTopLevelValueRaw(valueRaw, "$ref")
    if schemaRefRaw != "":
        let schemaRefObjectRaw = wire.RustCsgCat3("{\"$ref\":", schemaRefRaw, "}")
        if turnEventDynamicToolSchemaTextReferencesDefinition(schemaRefObjectRaw, tableKey, name):
            return true
    let propertiesRaw = turnEventJsonTopLevelValueRaw(valueRaw, "properties")
    if propertiesRaw != "" && turnEventDynamicToolSchemaRootPropertiesReferenceDefinition(propertiesRaw, tableKey, name):
        return true
    let itemsRaw = turnEventJsonTopLevelValueRaw(valueRaw, "items")
    if itemsRaw != "" && turnEventDynamicToolSchemaRootReferencesDefinition(itemsRaw, tableKey, name):
        return true
    let anyOfRaw = turnEventJsonTopLevelValueRaw(valueRaw, "anyOf")
    if anyOfRaw != "" && turnEventDynamicToolSchemaRootReferencesDefinition(anyOfRaw, tableKey, name):
        return true
    let additionalRaw = turnEventJsonTopLevelValueRaw(valueRaw, "additionalProperties")
    if additionalRaw != "":
        let ap = turnEventSkipJsonSpace(additionalRaw, 0)
        if ap < additionalRaw.len && additionalRaw[ap] != 't' && additionalRaw[ap] != 'f':
            if turnEventDynamicToolSchemaRootReferencesDefinition(additionalRaw, tableKey, name):
                return true
    return false

fn turnEventDynamicToolSchemaRootPropertiesReferenceDefinition(propertiesRaw: str, tableKey: str, name: str): bool =
    let p = turnEventSkipJsonSpace(propertiesRaw, 0)
    if p >= propertiesRaw.len || propertiesRaw[p] != '{':
        return false
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(propertiesRaw, pos, key, valueRaw):
            break
        if turnEventDynamicToolSchemaRootReferencesDefinition(valueRaw, tableKey, name):
            return true
    return false

fn turnEventDynamicToolSchemaIsLocalDefinitionRef(refRaw: str): bool =
    if turnEventDynamicToolSchemaLocalDefinitionRefName(refRaw, "$defs") != "":
        return true
    if turnEventDynamicToolSchemaLocalDefinitionRefName(refRaw, "definitions") != "":
        return true
    return false

fn turnEventDynamicToolSchemaReachableContains(reachable: str, name: str): bool =
    if name == "":
        return false
    return wire.RustCsgContains(reachable, wire.RustCsgCat3("|", name, "|"))

fn turnEventDynamicToolSchemaRemoveTopLevelDefinitionTables(schemaRaw: str): str =
    let p = turnEventSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len || schemaRaw[p] != '{':
        return schemaRaw
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(schemaRaw, pos, key, valueRaw):
            break
        if key != "$defs" && key != "definitions":
            let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", valueRaw)
            turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaMarkReachableFromText(text: str,
                                                   tableRaw: str,
                                                   tableKey: str,
                                                   reachable: var str) =
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(tableRaw, pos, key, valueRaw):
            break
        if turnEventDynamicToolSchemaRootReferencesDefinition(text, tableKey, key):
            if !turnEventDynamicToolSchemaReachableContains(reachable, key):
                reachable = wire.RustCsgCat3(reachable, key, "|")

fn turnEventDynamicToolSchemaMarkRefsInText(text: str,
                                            targetTableKey: str,
                                            targetReachable: var str,
                                            changed: var bool) =
    var i: int32
    while i < text.len:
        if turnEventMatchesAt(text, i, "\"$ref\""):
            let colon = turnEventSkipJsonSpace(text, i + 6)
            if colon < text.len && text[colon] == ':':
                let valueStart = turnEventSkipJsonSpace(text, colon + 1)
                let valueEnd = turnEventJsonValueEnd(text, valueStart)
                if valueEnd > valueStart:
                    let refRaw = strings.SliceBytes(text, valueStart, valueEnd - valueStart)
                    let refName = turnEventDynamicToolSchemaLocalDefinitionRefName(refRaw, targetTableKey)
                    if refName != "" && !turnEventDynamicToolSchemaReachableContains(targetReachable, refName):
                        targetReachable = wire.RustCsgCat3(targetReachable, refName, "|")
                        changed = true
        i = i + 1

fn turnEventDynamicToolSchemaPropagateReachableFromTable(sourceTableRaw: str,
                                                         targetTableRaw: str,
                                                         targetTableKey: str,
                                                         sourceReachable: str,
                                                         targetReachable: var str,
                                                         changed: var bool) =
    var posSource: int32
    while true:
        var sourceKey: str
        var sourceValueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(sourceTableRaw, posSource, sourceKey, sourceValueRaw):
            break
        if turnEventDynamicToolSchemaReachableContains(sourceReachable, sourceKey):
            turnEventDynamicToolSchemaMarkRefsInText(sourceValueRaw, targetTableKey, targetReachable, changed)
            if wire.RustCsgContains(sourceValueRaw, "%"):
                var posTarget: int32
                while true:
                    var targetKey: str
                    var targetValueRaw: str
                    if !turnEventDynamicToolSchemaReadObjectEntry(targetTableRaw, posTarget, targetKey, targetValueRaw):
                        break
                    if turnEventDynamicToolSchemaTextReferencesDefinition(sourceValueRaw, targetTableKey, targetKey):
                        if !turnEventDynamicToolSchemaReachableContains(targetReachable, targetKey):
                            targetReachable = wire.RustCsgCat3(targetReachable, targetKey, "|")
                            changed = true

fn turnEventDynamicToolSchemaReachableForTable(schemaRaw: str, targetTableKey: str): str =
    let rootWithoutDefinitions = turnEventDynamicToolSchemaRemoveTopLevelDefinitionTables(schemaRaw)
    let defsRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "$defs")
    let definitionsRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "definitions")
    var defsReachable = "|"
    var definitionsReachable = "|"
    if defsRaw != "":
        turnEventDynamicToolSchemaMarkReachableFromText(rootWithoutDefinitions, defsRaw, "$defs", defsReachable)
    if definitionsRaw != "":
        turnEventDynamicToolSchemaMarkReachableFromText(rootWithoutDefinitions, definitionsRaw, "definitions", definitionsReachable)
    while true:
        var changed: bool
        if defsRaw != "":
            turnEventDynamicToolSchemaPropagateReachableFromTable(defsRaw, defsRaw, "$defs", defsReachable, defsReachable, changed)
            if definitionsRaw != "":
                turnEventDynamicToolSchemaPropagateReachableFromTable(defsRaw, definitionsRaw, "definitions", defsReachable, definitionsReachable, changed)
        if definitionsRaw != "":
            if defsRaw != "":
                turnEventDynamicToolSchemaPropagateReachableFromTable(definitionsRaw, defsRaw, "$defs", definitionsReachable, defsReachable, changed)
            turnEventDynamicToolSchemaPropagateReachableFromTable(definitionsRaw, definitionsRaw, "definitions", definitionsReachable, definitionsReachable, changed)
        if !changed:
            break
    if targetTableKey == "$defs":
        return defsReachable
    return definitionsReachable

fn turnEventDynamicToolSchemaSanitizeDefinitionTable(tableRaw: str, tableKey: str, rootRaw: str): str =
    let p = turnEventSkipJsonSpace(tableRaw, 0)
    if p >= tableRaw.len || tableRaw[p] != '{':
        return ""
    let reachable = turnEventDynamicToolSchemaReachableForTable(rootRaw, tableKey)
    var out = "{"
    var first = true
    var posOut: int32
    while true:
        var keyOut: str
        var valueOutRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(tableRaw, posOut, keyOut, valueOutRaw):
            break
        if turnEventDynamicToolSchemaReachableContains(reachable, keyOut):
            let child = turnEventDynamicToolSchemaSanitizeRaw(valueOutRaw)
            let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(keyOut), ":", child)
            turnEventDynamicToolSchemaAppendField(out, first, field)
    if first:
        return ""
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaAppendDefinitionTables(out: var str, first: var bool, schemaRaw: str) =
    let defsRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "$defs")
    if defsRaw != "":
        let defsSanitized = turnEventDynamicToolSchemaSanitizeDefinitionTable(defsRaw, "$defs", schemaRaw)
        if defsSanitized != "":
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"$defs\":", defsSanitized, ""))
    let definitionsRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "definitions")
    if definitionsRaw != "":
        let definitionsSanitized = turnEventDynamicToolSchemaSanitizeDefinitionTable(definitionsRaw, "definitions", schemaRaw)
        if definitionsSanitized != "":
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"definitions\":", definitionsSanitized, ""))

fn turnEventDynamicToolSchemaSanitizeObject(schemaRaw: str): str =
    let constRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "const")
    let typeRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "type")
    let anyOfRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "anyOf")
    let schemaRefRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "$ref")
    let descriptionRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "description")
    let requiredRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "required")
    let additionalRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "additionalProperties")
    var inferredType: str
    if typeRaw != "":
        inferredType = turnEventDynamicToolSchemaNormalizeTypeRaw(typeRaw)
    if inferredType == "":
        if turnEventJsonTopLevelValueRaw(schemaRaw, "properties") != "" ||
           requiredRaw != "" ||
           additionalRaw != "":
            inferredType = "\"object\""
        elif turnEventJsonTopLevelValueRaw(schemaRaw, "items") != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "prefixItems") != "":
            inferredType = "\"array\""
        elif turnEventJsonTopLevelValueRaw(schemaRaw, "enum") != "" ||
             constRaw != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "format") != "":
            inferredType = "\"string\""
        elif turnEventJsonTopLevelValueRaw(schemaRaw, "minimum") != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "maximum") != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "exclusiveMinimum") != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "exclusiveMaximum") != "" ||
             turnEventJsonTopLevelValueRaw(schemaRaw, "multipleOf") != "":
            inferredType = "\"number\""
        else:
            if anyOfRaw != "" || schemaRefRaw != "":
                var outRef = "{"
                var firstRef = true
                if schemaRefRaw != "":
                    turnEventDynamicToolSchemaAppendField(outRef, firstRef, wire.RustCsgCat3("\"$ref\":", schemaRefRaw, ""))
                if descriptionRaw != "":
                    turnEventDynamicToolSchemaAppendField(outRef, firstRef, wire.RustCsgCat3("\"description\":", descriptionRaw, ""))
                if anyOfRaw != "":
                    turnEventDynamicToolSchemaAppendField(outRef, firstRef, wire.RustCsgCat3("\"anyOf\":", turnEventDynamicToolSchemaSanitizeArray(anyOfRaw), ""))
                turnEventDynamicToolSchemaAppendDefinitionTables(outRef, firstRef, schemaRaw)
                outRef = wire.RustCsgCat(outRef, "}")
                return outRef
            return "{}"
    var out = "{"
    var first = true
    if schemaRefRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"$ref\":", schemaRefRaw, ""))
    turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"type\":", inferredType, ""))
    if descriptionRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"description\":", descriptionRaw, ""))
    let enumRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "enum")
    if constRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"enum\":[", constRaw, "]"))
    elif enumRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"enum\":", enumRaw, ""))
    if turnEventDynamicToolSchemaTypeIs(inferredType, "array"):
        let itemsRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "items")
        if itemsRaw == "":
            turnEventDynamicToolSchemaAppendField(out, first, "\"items\":{\"type\":\"string\"}")
        else:
            let itemsSanitized = turnEventDynamicToolSchemaSanitizeRaw(itemsRaw)
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"items\":", itemsSanitized, ""))
    if turnEventDynamicToolSchemaTypeIs(inferredType, "object"):
        let propertiesRaw = turnEventJsonTopLevelValueRaw(schemaRaw, "properties")
        if propertiesRaw == "":
            turnEventDynamicToolSchemaAppendField(out, first, "\"properties\":{}")
        else:
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"properties\":", turnEventDynamicToolSchemaSanitizeProperties(propertiesRaw), ""))
    if requiredRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"required\":", requiredRaw, ""))
    if additionalRaw != "":
        let ap = turnEventSkipJsonSpace(additionalRaw, 0)
        if ap < additionalRaw.len && additionalRaw[ap] == '{':
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"additionalProperties\":", turnEventDynamicToolSchemaSanitizeRaw(additionalRaw), ""))
        else:
            turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"additionalProperties\":", additionalRaw, ""))
    if anyOfRaw != "":
        turnEventDynamicToolSchemaAppendField(out, first, wire.RustCsgCat3("\"anyOf\":", turnEventDynamicToolSchemaSanitizeArray(anyOfRaw), ""))
    turnEventDynamicToolSchemaAppendDefinitionTables(out, first, schemaRaw)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaReadObjectEntry(objectJson: str,
                                             pos: var int32,
                                             outKey: var str,
                                             outValue: var str): bool =
    outKey = ""
    outValue = ""
    var p = turnEventSkipJsonSpace(objectJson, pos)
    if pos == 0:
        if p >= objectJson.len || objectJson[p] != '{':
            return false
        p = turnEventSkipJsonSpace(objectJson, p + 1)
    if p < objectJson.len && objectJson[p] == ',':
        p = turnEventSkipJsonSpace(objectJson, p + 1)
    if p < objectJson.len && objectJson[p] == '}':
        pos = p + 1
        return false
    if p >= objectJson.len || objectJson[p] != '"':
        return false
    let keyEnd = turnEventJsonStringEnd(objectJson, p)
    if keyEnd < 0:
        return false
    outKey = strings.SliceBytes(objectJson, p + 1, keyEnd - p - 2)
    p = turnEventSkipJsonSpace(objectJson, keyEnd)
    if p >= objectJson.len || objectJson[p] != ':':
        return false
    let valueStart = turnEventSkipJsonSpace(objectJson, p + 1)
    let valueEnd = turnEventJsonValueEnd(objectJson, valueStart)
    if valueEnd < valueStart:
        return false
    outValue = strings.SliceBytes(objectJson, valueStart, valueEnd - valueStart)
    pos = valueEnd
    return true

fn turnEventDynamicToolSchemaSanitizeProperties(propertiesRaw: str): str =
    let p = turnEventSkipJsonSpace(propertiesRaw, 0)
    if p >= propertiesRaw.len || propertiesRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(propertiesRaw, pos, key, valueRaw):
            break
        let child = turnEventDynamicToolSchemaSanitizeRaw(valueRaw)
        let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", child)
        turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaStripDescriptionsArray(arrayRaw: str): str =
    let p = turnEventSkipJsonSpace(arrayRaw, 0)
    if p >= arrayRaw.len || arrayRaw[p] != '[':
        return "[]"
    var out = "["
