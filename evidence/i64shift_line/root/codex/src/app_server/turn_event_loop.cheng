fn RustCsgAppServerTurnEventNotificationsFromResponseWithDynamicToolsAndBaseInstructions(body: str,
                                                                                         response: str,
                                                                                         dynamicToolsJson: str,
                                                                                         baseInstructions: str,
                                                                                         outError: var str): str =
    return RustCsgAppServerTurnEventNotificationsFromResponseWithSession(body, response, dynamicToolsJson, baseInstructions, "", "", outError)

fn RustCsgAppServerTurnEventNotificationsFromResponseWithSession(body: str,
                                                                 response: str,
                                                                 dynamicToolsJson: str,
                                                                 baseInstructions: str,
                                                                 developerInstructions: str,
                                                                 historyJson: str,
                                                                 outError: var str): str =
    outError = ""
    var notifications: str
    if !wire.RustCsgContains(response, "\"result\""):
        return notifications
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        return notifications
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    let turnJson = wire.RustCsgJsonFindObject(resultJson, "turn")
    let turnId = wire.RustCsgJsonFindStr(turnJson, "id")
    var responsesBody: str
    var postError: str
    turnEventPostResponsesWithSession(model, threadId, paramsJson, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, responsesBody, postError)
    if postError != "":
        outError = postError
        return notifications
    return turnEventHandleResponsesSse(threadId, turnId, responsesBody, outError)
