fn turnEventTokenUsageNotification(threadId: str, turnId: str, usageJson: str): str =
    let inputTokens = wire.RustCsgJsonFindInt64(usageJson, "input_tokens")
    let outputTokens = wire.RustCsgJsonFindInt64(usageJson, "output_tokens")
    let totalTokens = wire.RustCsgJsonFindInt64(usageJson, "total_tokens")
    var cachedInputTokens: int64
    let inputDetails = wire.RustCsgJsonFindOptionalObject(usageJson, "input_tokens_details")
    if inputDetails != "" && turnEventHasField(inputDetails, "cached_tokens"):
        cachedInputTokens = wire.RustCsgJsonFindInt64(inputDetails, "cached_tokens")
    var reasoningOutputTokens: int64
    let outputDetails = wire.RustCsgJsonFindOptionalObject(usageJson, "output_tokens_details")
    if outputDetails != "" && turnEventHasField(outputDetails, "reasoning_tokens"):
        reasoningOutputTokens = wire.RustCsgJsonFindInt64(outputDetails, "reasoning_tokens")
    let part = turnEventUsagePart(totalTokens, inputTokens, cachedInputTokens, outputTokens, reasoningOutputTokens)
    return turnEventTokenUsageNotificationFromPartsRaw(threadId, turnId, part, part)

fn turnEventTokenUsageNotificationFromPartsRaw(threadId: str, turnId: str, totalPart: str, lastPart: str): str =
    var usage = "{"
    usage = wire.RustCsgCat(usage, wire.RustCsgJsonFieldRaw("total", totalPart))
    usage = wire.RustCsgCat(usage, ",")
    usage = wire.RustCsgCat(usage, wire.RustCsgJsonFieldRaw("last", lastPart))
    usage = wire.RustCsgCat(usage, ",\"modelContextWindow\":null}")
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("turnId", turnId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("tokenUsage", usage))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3("{\"method\":\"thread/tokenUsage/updated\",\"params\":", params, "}")

fn turnEventTokenUsageNotificationFromValues(threadId: str,
                                             turnId: str,
                                             totalTokens: int64,
                                             inputTokens: int64,
                                             cachedInputTokens: int64,
                                             outputTokens: int64,
                                             reasoningOutputTokens: int64): str =
    let part = turnEventUsagePart(totalTokens, inputTokens, cachedInputTokens, outputTokens, reasoningOutputTokens)
    return turnEventTokenUsageNotificationFromPartsRaw(threadId, turnId, part, part)

fn turnEventRateLimitWindowFromEvent(windowJson: str): str =
    if windowJson == "":
        return "null"
    var usedPercentJson = wire.RustCsgJsonFindOptionalValueRaw(windowJson, "used_percent")
    if usedPercentJson == "" || usedPercentJson == "null":
        return "null"
    usedPercentJson = turnEventRoundedPercentJson(usedPercentJson)
    var windowMinutesJson = wire.RustCsgJsonFindOptionalValueRaw(windowJson, "window_minutes")
    if windowMinutesJson == "":
        windowMinutesJson = "null"
    var resetsAtJson = wire.RustCsgJsonFindOptionalValueRaw(windowJson, "reset_at")
    if resetsAtJson == "":
        resetsAtJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("usedPercent", usedPercentJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("windowDurationMins", windowMinutesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("resetsAt", resetsAtJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventRateLimitWindowFromHeaders(headersJson: str,
                                       usedHeader: str,
                                       windowHeader: str,
                                       resetHeader: str): str =
    let usedPercent = wire.RustCsgJsonFindOptionalStr(headersJson, usedHeader)
    if usedPercent == "":
        return "null"
    var windowMinutesJson = "null"
    let windowMinutes = wire.RustCsgJsonFindOptionalStr(headersJson, windowHeader)
    if windowMinutes != "":
        windowMinutesJson = windowMinutes
    var resetsAtJson = "null"
    let resetsAt = wire.RustCsgJsonFindOptionalStr(headersJson, resetHeader)
    if resetsAt != "":
        resetsAtJson = resetsAt
    let roundedUsedPercent = turnEventRoundedPercentJson(usedPercent)
    if roundedUsedPercent == "0" && windowMinutesJson == "null" && resetsAtJson == "null":
        return "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("usedPercent", roundedUsedPercent))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("windowDurationMins", windowMinutesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("resetsAt", resetsAtJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventRateLimitCreditsFromEvent(creditsJson: str): str =
    if creditsJson == "":
        return "null"
    var balanceJson = wire.RustCsgJsonFindOptionalValueRaw(creditsJson, "balance")
    if balanceJson == "":
        balanceJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("hasCredits", wire.RustCsgJsonFindOptionalBool(creditsJson, "has_credits")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("unlimited", wire.RustCsgJsonFindOptionalBool(creditsJson, "unlimited")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("balance", balanceJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventPlanTypeJson(rawPlanType: str): str =
    if rawPlanType == "":
        return "null"
    if rawPlanType == "free" || rawPlanType == "go" || rawPlanType == "plus" || rawPlanType == "pro":
        return wire.RustCsgJsonQuote(rawPlanType)
    if rawPlanType == "prolite" || rawPlanType == "team" || rawPlanType == "business":
        return wire.RustCsgJsonQuote(rawPlanType)
    if rawPlanType == "enterprise" || rawPlanType == "edu" || rawPlanType == "education":
        return wire.RustCsgJsonQuote(rawPlanType)
    if rawPlanType == "self_serve_business_usage_based" || rawPlanType == "enterprise_cbp_usage_based":
        return wire.RustCsgJsonQuote(rawPlanType)
    return wire.RustCsgJsonQuote("unknown")

fn turnEventRoundedPercentJson(rawValue: str): str =
    let raw = turnEventTrimAscii(rawValue)
    assert(raw != "", "empty rate limit used_percent")
    assert(raw[0] != '-', "negative rate limit used_percent")
    var i: int32
    var whole: int32
    var sawDigit: bool
    while i < raw.len:
        let digit = turnEventDigitValue(raw[i])
        if digit < 0:
            break
        sawDigit = true
        whole = whole * 10 + digit
        i = i + 1
    assert(sawDigit, wire.RustCsgCat("invalid rate limit used_percent: ", raw))
    var roundUp: bool
    if i < raw.len && raw[i] == '.':
        i = i + 1
        assert(i < raw.len, wire.RustCsgCat("invalid rate limit used_percent fraction: ", raw))
        let firstFractionDigit = turnEventDigitValue(raw[i])
        assert(firstFractionDigit >= 0, wire.RustCsgCat("invalid rate limit used_percent fraction: ", raw))
        if firstFractionDigit >= 5:
            roundUp = true
        i = i + 1
        while i < raw.len:
            let digit = turnEventDigitValue(raw[i])
            assert(digit >= 0, wire.RustCsgCat("invalid rate limit used_percent fraction: ", raw))
            i = i + 1
    assert(i == raw.len, wire.RustCsgCat("unsupported rate limit used_percent number: ", raw))
    if roundUp:
        whole = whole + 1
    return strings.IntToStr(whole)

fn turnEventNormalizeLimitId(rawName: str): str =
    let trimmed = turnEventTrimAscii(rawName)
    var out: str
    var i: int32
    while i < trimmed.len:
        let ch = trimmed[i]
        if ch == '-':
            out = wire.RustCsgCat(out, "_")
        else:
            let lower = turnEventAsciiLowerChar(ch)
            if lower != "":
                out = wire.RustCsgCat(out, lower)
            else:
                out = wire.RustCsgCat(out, strings.SliceBytes(trimmed, i, 1))
        i = i + 1
    return out

fn turnEventRateLimitSnapshot(limitId: str,
                              primaryJson: str,
                              secondaryJson: str,
                              creditsJson: str,
                              planTypeJson: str,
                              reachedTypeJson: str): str =
    if primaryJson == "null" && secondaryJson == "null":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("limitId", limitId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("limitName", "null"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("primary", primaryJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("secondary", secondaryJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("credits", creditsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("planType", planTypeJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimitReachedType", reachedTypeJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventRateLimitSnapshotFromEvent(data: str): str =
    let rateLimitsJson = wire.RustCsgJsonFindOptionalObject(data, "rate_limits")
    if rateLimitsJson == "":
        return ""
    let primaryJson = turnEventRateLimitWindowFromEvent(wire.RustCsgJsonFindOptionalObject(rateLimitsJson, "primary"))
    let secondaryJson = turnEventRateLimitWindowFromEvent(wire.RustCsgJsonFindOptionalObject(rateLimitsJson, "secondary"))
    let creditsJson = turnEventRateLimitCreditsFromEvent(wire.RustCsgJsonFindOptionalObject(data, "credits"))
    let planTypeJson = turnEventPlanTypeJson(wire.RustCsgJsonFindOptionalStr(data, "plan_type"))
    var limitId = turnEventNormalizeLimitId(wire.RustCsgJsonFindOptionalStr(data, "metered_limit_name"))
    if limitId == "":
        limitId = turnEventNormalizeLimitId(wire.RustCsgJsonFindOptionalStr(data, "limit_name"))
    if limitId == "":
        limitId = "codex"
    return turnEventRateLimitSnapshot(limitId, primaryJson, secondaryJson, creditsJson, planTypeJson, "null")

fn turnEventRateLimitSnapshotFromHeaders(headersJson: str): str =
    if headersJson == "":
        return ""
    let primaryJson = turnEventRateLimitWindowFromHeaders(headersJson,
                                                          "x-codex-primary-used-percent",
                                                          "x-codex-primary-window-minutes",
                                                          "x-codex-primary-reset-at")
    let secondaryJson = turnEventRateLimitWindowFromHeaders(headersJson,
                                                            "x-codex-secondary-used-percent",
                                                            "x-codex-secondary-window-minutes",
                                                            "x-codex-secondary-reset-at")
    return turnEventRateLimitSnapshot("codex", primaryJson, secondaryJson, "null", "null", "null")

fn turnEventRateLimitSnapshotFromFailureEvent(data: str): str =
    return turnEventRateLimitSnapshotFromHeaders(wire.RustCsgJsonFindOptionalObject(data, "headers"))

fn turnEventRateLimitsUpdatedNotification(snapshotJson: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("rateLimits", snapshotJson))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3("{\"method\":\"account/rateLimits/updated\",\"params\":", params, "}")

fn turnEventTurnFinishedNotification(threadId: str,
                                     turnId: str,
                                     startedAtMs: int64,
                                     completedAtMs: int64,
                                     status: str,
                                     errorJson: str): str =
    let startedAtSec = startedAtMs / 1000
    let completedAtSec = completedAtMs / 1000
    var turn = "{"
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldStr("id", turnId))
    turn = wire.RustCsgCat(turn, ",\"items\":[],\"itemsView\":\"notLoaded\",")
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldStr("status", status))
    turn = wire.RustCsgCat(turn, ",")
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldRaw("error", errorJson))
    turn = wire.RustCsgCat(turn, ",")
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldInt64("startedAt", startedAtSec))
    turn = wire.RustCsgCat(turn, ",")
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldInt64("completedAt", completedAtSec))
    turn = wire.RustCsgCat(turn, ",")
    turn = wire.RustCsgCat(turn, wire.RustCsgJsonFieldInt64("durationMs", completedAtMs - startedAtMs))
    turn = wire.RustCsgCat(turn, "}")
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("turn", turn))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3("{\"method\":\"turn/completed\",\"params\":", params, "}")

fn turnEventTurnErrorJsonWithInfo(message: str, codexErrorInfoRaw: str): str =
    return turnEventTurnErrorJsonWithDetails(message, codexErrorInfoRaw, "null")

fn turnEventTurnErrorJsonWithDetails(message: str, codexErrorInfoRaw: str, additionalDetailsRaw: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", message))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("codexErrorInfo", codexErrorInfoRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("additionalDetails", additionalDetailsRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventTurnErrorJson(message: str): str =
    return turnEventTurnErrorJsonWithInfo(message, "null")

fn turnEventTurnCompletedNotification(threadId: str,
                                      turnId: str,
                                      startedAtMs: int64,
                                      completedAtMs: int64): str =
    return turnEventTurnFinishedNotification(threadId, turnId, startedAtMs, completedAtMs, "completed", "null")

fn turnEventTurnFailedNotification(threadId: str,
                                   turnId: str,
                                   startedAtMs: int64,
                                   completedAtMs: int64,
                                   message: str): str =
    return turnEventTurnFinishedNotification(threadId, turnId, startedAtMs, completedAtMs, "failed", turnEventTurnErrorJson(message))

fn turnEventTurnFailedNotificationWithInfo(threadId: str,
                                           turnId: str,
                                           startedAtMs: int64,
                                           completedAtMs: int64,
                                           message: str,
                                           codexErrorInfoRaw: str): str =
    return turnEventTurnFinishedNotification(threadId, turnId, startedAtMs, completedAtMs, "failed", turnEventTurnErrorJsonWithInfo(message, codexErrorInfoRaw))

fn turnEventErrorNotificationWithInfo(threadId: str,
                                      turnId: str,
                                      message: str,
                                      willRetry: bool,
                                      codexErrorInfoRaw: str): str =
    return turnEventErrorNotificationWithDetails(threadId, turnId, message, willRetry, codexErrorInfoRaw, "null")

fn turnEventErrorNotificationWithDetails(threadId: str,
                                         turnId: str,
                                         message: str,
                                         willRetry: bool,
                                         codexErrorInfoRaw: str,
                                         additionalDetailsRaw: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("error", turnEventTurnErrorJsonWithDetails(message, codexErrorInfoRaw, additionalDetailsRaw)))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("willRetry", turnEventBoolRaw(willRetry)))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("turnId", turnId))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3("{\"method\":\"error\",\"params\":", params, "}")

fn turnEventErrorNotification(threadId: str, turnId: str, message: str, willRetry: bool): str =
    return turnEventErrorNotificationWithInfo(threadId, turnId, message, willRetry, "null")

fn turnEventAsciiBlank(text: str): bool =
    var i: int32
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return false
        i = i + 1
    return true

fn turnEventResponseFailureErrorJson(data: str): str =
    let responseJson = wire.RustCsgJsonFindOptionalObject(data, "response")
    if responseJson != "":
        let responseErrorJson = wire.RustCsgJsonFindOptionalObject(responseJson, "error")
        if responseErrorJson != "":
            return responseErrorJson
    return wire.RustCsgJsonFindOptionalObject(data, "error")

fn turnEventResponseFailureCode(data: str): str =
    let errorJson = turnEventResponseFailureErrorJson(data)
    if errorJson == "":
        return ""
    let code = wire.RustCsgJsonFindOptionalStr(errorJson, "code")
    if code != "":
        return code
    return wire.RustCsgJsonFindOptionalStr(errorJson, "type")

fn turnEventResponseFailureCodexErrorInfoRaw(data: str, eventType: str): str =
    if eventType == "response.incomplete":
        return wire.RustCsgJsonQuote("other")
    if eventType == "error":
        if turnEventResponseFailureCode(data) == "usage_limit_reached":
            return wire.RustCsgJsonQuote("usageLimitExceeded")
        return wire.RustCsgJsonQuote("other")
    if eventType != "response.failed":
        return "null"
    let errorCode = turnEventResponseFailureCode(data)
    if errorCode == "":
        return "null"
    if errorCode == "context_length_exceeded":
        return wire.RustCsgJsonQuote("contextWindowExceeded")
    if errorCode == "insufficient_quota" || errorCode == "usage_not_included" || errorCode == "usage_limit_reached":
        return wire.RustCsgJsonQuote("usageLimitExceeded")
    if errorCode == "server_is_overloaded" || errorCode == "slow_down":
        return wire.RustCsgJsonQuote("serverOverloaded")
    if errorCode == "cyber_policy":
        return wire.RustCsgJsonQuote("cyberPolicy")
    if errorCode == "invalid_prompt":
        return wire.RustCsgJsonQuote("badRequest")
    return wire.RustCsgJsonQuote("other")

fn turnEventCodexErrorInfoWithHttpStatusRaw(kind: str, httpStatusCodeRaw: str): str =
    var out = "{\""
    out = wire.RustCsgCat(out, kind)
    out = wire.RustCsgCat(out, "\":{")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("httpStatusCode", httpStatusCodeRaw))
    out = wire.RustCsgCat(out, "}}")
    return out

fn turnEventResponseStreamDisconnectedInfoRaw(): str =
    return turnEventCodexErrorInfoWithHttpStatusRaw("responseStreamDisconnected", "null")

fn turnEventResponseStreamConnectionFailedInfoRaw(): str =
    return turnEventCodexErrorInfoWithHttpStatusRaw("responseStreamConnectionFailed", "null")

fn turnEventHttpConnectionFailedInfoRaw(): str =
    return turnEventCodexErrorInfoWithHttpStatusRaw("httpConnectionFailed", "null")

fn turnEventResponseTooManyFailedAttemptsInfoRaw(): str =
    return turnEventCodexErrorInfoWithHttpStatusRaw("responseTooManyFailedAttempts", "null")

fn turnEventResponseFailureIsFatal(data: str, eventType: str): bool =
    let errorCode = turnEventResponseFailureCode(data)
    if errorCode == "context_length_exceeded":
        return true
    if errorCode == "insufficient_quota" || errorCode == "usage_not_included" || errorCode == "usage_limit_reached":
        return true
    if errorCode == "server_is_overloaded" || errorCode == "slow_down":
        return true
    if errorCode == "cyber_policy" || errorCode == "invalid_prompt":
        return true
    return false

fn turnEventFailureEventIsRetryable(data: str, eventType: str): bool =
    if eventType == "response.failed":
        return !turnEventResponseFailureIsFatal(data, eventType)
    if eventType == "response.incomplete" || eventType == "error":
        return !turnEventResponseFailureIsFatal(data, eventType)
    return false

fn turnEventStreamDisconnectedDetail(message: str): str =
    if turnEventStartsWith(message, "stream disconnected before completion: "):
        return message
    return wire.RustCsgCat("stream disconnected before completion: ", message)

fn turnEventRetryMessage(retryCount: int32, maxRetries: int32): str =
    return wire.RustCsgCat4("Reconnecting... ", strings.IntToStr(retryCount), "/", strings.IntToStr(maxRetries))

fn turnEventResponseFailureMessage(data: str, eventType: str): str =
    if eventType == "response.incomplete":
        let incompleteDetails = wire.RustCsgJsonFindOptionalObject(data, "incomplete_details")
        var reason = "unknown"
        if incompleteDetails != "":
            let foundReason = wire.RustCsgJsonFindOptionalStr(incompleteDetails, "reason")
            if foundReason != "":
                reason = foundReason
        return wire.RustCsgCat("stream disconnected before completion: Incomplete response returned, reason: ", reason)
    let errorJson = turnEventResponseFailureErrorJson(data)
    if errorJson != "":
        let errorMessage = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
        let errorCode = wire.RustCsgJsonFindOptionalStr(errorJson, "code")
        if errorCode == "context_length_exceeded":
            return "Codex ran out of room in the model's context window. Start a new thread or clear earlier history before retrying."
        if errorCode == "insufficient_quota":
            return "Quota exceeded. Check your plan and billing details."
        if errorCode == "usage_not_included":
            return "To use Codex with your ChatGPT plan, upgrade to Plus: https://chatgpt.com/explore/plus."
        if errorCode == "usage_limit_reached":
            if errorMessage != "":
                return errorMessage
            return "Usage limit reached."
        if errorCode == "server_is_overloaded" || errorCode == "slow_down":
            return "Selected model is at capacity. Please try a different model."
        if errorCode == "cyber_policy":
            if errorMessage != "" && !turnEventAsciiBlank(errorMessage):
                return errorMessage
            return "This request has been flagged for possible cybersecurity risk."
        if errorCode == "invalid_prompt":
            if errorMessage != "":
                return errorMessage
            return "Invalid request."
        if errorMessage != "":
            return wire.RustCsgCat("stream disconnected before completion: ", errorMessage)
        if errorCode != "":
            return wire.RustCsgCat("stream disconnected before completion: ", errorCode)
    let message = wire.RustCsgJsonFindOptionalStr(data, "message")
    if message != "":
        return message
    if eventType == "response.incomplete":
        return "stream disconnected before completion: Incomplete response returned, reason: unknown"
    if eventType == "error":
        return "responses stream error"
    return "responses stream failed"

fn turnEventIsFailureEvent(eventType: str): bool =
    return eventType == "response.failed" || eventType == "response.incomplete" || eventType == "error"

fn turnEventResponseItemJson(body: str): str =
    return wire.RustCsgJsonFindOptionalObject(body, "item")

fn turnEventResponseItemType(body: str): str =
    let itemJson = turnEventResponseItemJson(body)
    if itemJson == "":
        return ""
    return wire.RustCsgJsonFindOptionalStr(itemJson, "type")

fn turnEventResponseMessageItemId(body: str): str =
    let itemJson = turnEventResponseItemJson(body)
    if itemJson == "":
        return ""
    let itemType = wire.RustCsgJsonFindOptionalStr(itemJson, "type")
    if itemType != "" && itemType != "message":
        return ""
    return wire.RustCsgJsonFindOptionalStr(itemJson, "id")

fn turnEventHandleResponsesSse(threadId: str,
                               turnId: str,
                               body: str,
                               outError: var str): str =
    outError = ""
    var notifications: str
    let startedAtMs = rustCsgTurnEventNowMs()
    var itemId = turnEventResponseMessageItemId(body)
    if itemId == "":
        itemId = rustCsgTurnEventUuidV4()
    var deltaText: str
    var deltaNotifications: str
    var finalText: str
    var sawUsage: bool
    var inputTokens: int64
    var cachedInputTokens: int64
    var outputTokens: int64
    var reasoningOutputTokens: int64
    var totalTokens: int64
    var rateLimitSnapshotJson: str
    var dataLines: int32
    var deltaEvents: int32
    var itemDoneEvents: int32
    var completedEvents: int32
    var failureType: str
    var failureData: str
    var pos: int32
    while pos < body.len:
        var lineEnd = pos
        while lineEnd < body.len && body[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        var line = strings.SliceBytes(body, pos, lineEnd - pos)
        if line.len > 0 && line[line.len - 1] == '\r':
            line = strings.SliceBytes(line, 0, line.len - 1)
        if turnEventStartsWith(line, "data: "):
            dataLines = dataLines + 1
            let data = strings.SliceBytes(line, 6, line.len - 6)
            let eventType = turnEventJsonFindString(data, "type")
            if rateLimitSnapshotJson == "" && eventType == "codex.rate_limits":
                rateLimitSnapshotJson = turnEventRateLimitSnapshotFromEvent(data)
            if failureType == "" && turnEventIsFailureEvent(eventType):
                failureType = eventType
                failureData = data
                if rateLimitSnapshotJson == "":
                    rateLimitSnapshotJson = turnEventRateLimitSnapshotFromFailureEvent(data)
        pos = lineEnd + 1
    deltaEvents = turnEventCountMatches(body, "\"response.output_text.delta\"")
    itemDoneEvents = turnEventCountMatches(body, "\"response.output_item.done\"")
    itemDoneEvents = itemDoneEvents + turnEventCountMatches(body, "\"conversation.item.done\"")
    completedEvents = turnEventCountMatches(body, "\"response.completed\"")
    if failureType != "":
        let completedAtMs = rustCsgTurnEventNowMs()
        let message = turnEventResponseFailureMessage(failureData, failureType)
        let codexErrorInfoRaw = turnEventResponseFailureCodexErrorInfoRaw(failureData, failureType)
        if rateLimitSnapshotJson != "":
            notifications = turnEventAppendNotification(notifications, turnEventRateLimitsUpdatedNotification(rateLimitSnapshotJson))
        notifications = turnEventAppendNotification(notifications, turnEventErrorNotificationWithInfo(threadId, turnId, message, false, codexErrorInfoRaw))
        notifications = turnEventAppendNotification(notifications, turnEventTurnFailedNotificationWithInfo(threadId, turnId, startedAtMs, completedAtMs, message, codexErrorInfoRaw))
        return notifications
    var deltaIndex: int32
    while deltaIndex < deltaEvents:
        let delta = turnEventJsonFindStringNth(body, "delta", deltaIndex)
        if delta == "":
            outError = "responses stream missing delta value at index "
            outError = wire.RustCsgCat(outError, strings.IntToStr(deltaIndex))
            outError = wire.RustCsgCat(outError, ": ")
            outError = wire.RustCsgCat(outError, turnEventPreview(body))
            return notifications
        deltaText = wire.RustCsgCat(deltaText, delta)
        deltaNotifications = turnEventAppendNotification(deltaNotifications, turnEventAgentDeltaNotification(threadId, turnId, itemId, delta))
        deltaIndex = deltaIndex + 1
    finalText = turnEventJsonFindString(body, "text")
    if completedEvents > 0:
        sawUsage = true
        inputTokens = turnEventJsonFindInt64(body, "input_tokens")
        cachedInputTokens = turnEventJsonFindInt64(body, "cached_tokens")
        outputTokens = turnEventJsonFindInt64(body, "output_tokens")
        reasoningOutputTokens = turnEventJsonFindInt64(body, "reasoning_tokens")
        totalTokens = turnEventJsonFindInt64(body, "total_tokens")
    if finalText == "":
        outError = "responses stream missing final assistant message: dataLines="
        outError = wire.RustCsgCat(outError, strings.IntToStr(dataLines))
        outError = wire.RustCsgCat(outError, " deltaEvents=")
        outError = wire.RustCsgCat(outError, strings.IntToStr(deltaEvents))
        outError = wire.RustCsgCat(outError, " itemDoneEvents=")
        outError = wire.RustCsgCat(outError, strings.IntToStr(itemDoneEvents))
        outError = wire.RustCsgCat(outError, " completedEvents=")
        outError = wire.RustCsgCat(outError, strings.IntToStr(completedEvents))
        outError = wire.RustCsgCat(outError, " preview=")
        outError = wire.RustCsgCat(outError, turnEventPreview(body))
        return notifications
    if deltaNotifications == "":
        outError = wire.RustCsgCat("responses stream missing text delta: ", turnEventPreview(body))
        return notifications
    if deltaText != finalText:
        outError = "responses stream delta/text mismatch: delta="
        outError = wire.RustCsgCat(outError, turnEventPreview(deltaText))
        outError = wire.RustCsgCat(outError, " final=")
        outError = wire.RustCsgCat(outError, turnEventPreview(finalText))
        return notifications
    notifications = turnEventAppendNotification(notifications, turnEventItemStartedNotification(threadId, turnId, turnEventAgentMessageItem(itemId, ""), startedAtMs))
    notifications = turnEventAppendNotification(notifications, deltaNotifications)
    let completedAtMs = rustCsgTurnEventNowMs()
    let itemJson = turnEventAgentMessageItem(itemId, finalText)
    notifications = turnEventAppendNotification(notifications, turnEventItemCompletedNotification(threadId, turnId, itemJson, completedAtMs))
    if sawUsage:
        notifications = turnEventAppendNotification(notifications, turnEventTokenUsageNotificationFromValues(threadId, turnId, totalTokens, inputTokens, cachedInputTokens, outputTokens, reasoningOutputTokens))
    if rateLimitSnapshotJson != "":
        notifications = turnEventAppendNotification(notifications, turnEventRateLimitsUpdatedNotification(rateLimitSnapshotJson))
    notifications = turnEventAppendNotification(notifications, turnEventTurnCompletedNotification(threadId, turnId, startedAtMs, completedAtMs))
    return notifications

fn turnEventEnsureItemStartedTarget(threadId: str,
                                    turnId: str,
                                    fd: int32,
                                    clientFds: int32[],
                                    targetKind: int32,
                                    startedAtMs: int64,
                                    itemId: var str,
                                    itemStarted: var bool): bool =
    if itemStarted:
        return true
    if itemId == "":
        itemId = rustCsgTurnEventUuidV4()
    itemStarted = true
    return turnEventWriteTarget(fd, clientFds, targetKind, turnEventItemStartedNotification(threadId, turnId, turnEventAgentMessageItem(itemId, ""), startedAtMs))

fn turnEventFunctionCallArgumentsRaw(itemJson: str, outError: var str): str =
    outError = ""
    let argumentsRawString = wire.RustCsgJsonFindOptionalStr(itemJson, "arguments")
    if argumentsRawString == "":
        outError = "dynamic tool function_call missing arguments"
        return ""
    let p = turnEventSkipJsonSpace(argumentsRawString, 0)
    if p >= argumentsRawString.len:
        outError = "dynamic tool function_call arguments empty"
        return ""
    let ch = argumentsRawString[p]
    if ch != '{' && ch != '[':
        outError = wire.RustCsgCat("dynamic tool function_call arguments are not json: ", turnEventPreview(argumentsRawString))
        return ""
    return strings.SliceBytes(argumentsRawString, p, argumentsRawString.len - p)

fn turnEventQueueDynamicToolCall(data: str, outPendingCallRaw: var str, outError: var str): bool =
    outPendingCallRaw = ""
    outError = ""
    let itemJson = turnEventResponseItemJson(data)
    if itemJson == "":
        outError = wire.RustCsgCat("dynamic tool function_call missing item: ", turnEventPreview(data))
        return false
    let callId = wire.RustCsgJsonFindOptionalStr(itemJson, "call_id")
    if callId == "":
        outError = wire.RustCsgCat("dynamic tool function_call missing call_id: ", turnEventPreview(itemJson))
        return false
    let tool = wire.RustCsgJsonFindOptionalStr(itemJson, "name")
    if tool == "":
        outError = wire.RustCsgCat("dynamic tool function_call missing name: ", turnEventPreview(itemJson))
        return false
    var argumentsError: str
    let argumentsRaw = turnEventFunctionCallArgumentsRaw(itemJson, argumentsError)
    if argumentsError != "":
        outError = argumentsError
        return false
    var namespaceRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "namespace")
    if namespaceRaw == "":
        namespaceRaw = "null"
    outPendingCallRaw = turnEventPendingDynamicToolCallItem(-1, callId, namespaceRaw, tool, argumentsRaw, 0)
    return true

fn turnEventStartPendingDynamicToolCallTarget(threadId: str,
                                             turnId: str,
                                             pendingCallJson: str,
                                             fd: int32,
                                             notificationFds: int32[],
                                             requestFds: int32[],
                                             targetKind: int32,
                                             requestIdCounter: var int32,
                                             outStartedPendingCallRaw: var str,
                                             outError: var str): bool =
    outStartedPendingCallRaw = ""
    outError = ""
    let callId = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "callId")
    if callId == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing callId: ", turnEventPreview(pendingCallJson))
        return false
    let tool = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "tool")
    if tool == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing tool: ", turnEventPreview(pendingCallJson))
        return false
    var namespaceRaw = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "namespace")
    if namespaceRaw == "":
        namespaceRaw = "null"
    let argumentsRaw = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "arguments")
    if argumentsRaw == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing arguments: ", turnEventPreview(pendingCallJson))
        return false
    if cheng_native_tools.ChengNativeIsTool(tool):
        outStartedPendingCallRaw = turnEventPendingDynamicToolCallItem(-1, callId, namespaceRaw, tool, argumentsRaw, 0)
        return true
    let toolStartedAtMs = rustCsgTurnEventNowMs()
    let startedItem = turnEventDynamicToolCallItem(callId, namespaceRaw, tool, argumentsRaw, "inProgress", "null", "null", "null")
    if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemStartedNotification(threadId, turnId, startedItem, toolStartedAtMs)):
        outError = "failed to write dynamic tool item/started"
        return false
    var requestId: int32 = requestIdCounter
    let request = turnEventDynamicToolCallRequest(requestId, threadId, turnId, callId, namespaceRaw, tool, argumentsRaw)
    requestIdCounter = requestIdCounter + 1
    if !turnEventWriteServerRequestTarget(fd, requestFds, targetKind, request):
        outError = "failed to write dynamic tool item/tool/call request"
        return false
    outStartedPendingCallRaw = turnEventPendingDynamicToolCallItem(requestId, callId, namespaceRaw, tool, argumentsRaw, toolStartedAtMs)
    return true

fn turnEventStartDynamicToolCallTarget(threadId: str,
                                       turnId: str,
                                       data: str,
                                       fd: int32,
                                       notificationFds: int32[],
                                       requestFds: int32[],
                                       targetKind: int32,
                                       requestIdCounter: var int32,
                                       outPendingCallRaw: var str,
                                       outError: var str): bool =
    outPendingCallRaw = ""
    outError = ""
    var queuedPendingCallRaw: str
    var queueError: str
    if !turnEventQueueDynamicToolCall(data, queuedPendingCallRaw, queueError):
        outError = queueError
        return false
    return turnEventStartPendingDynamicToolCallTarget(threadId,
                                                     turnId,
                                                     queuedPendingCallRaw,
                                                     fd,
                                                     notificationFds,
                                                     requestFds,
                                                     targetKind,
                                                     requestIdCounter,
                                                     outPendingCallRaw,
                                                     outError)

fn turnEventCompleteDynamicToolCallTarget(threadId: str,
                                          turnId: str,
                                          pendingCallJson: str,
                                          response: str,
                                          fd: int32,
                                          notificationFds: int32[],
                                          targetKind: int32,
                                          outInputItemRaw: var str,
                                          outError: var str): bool =
    outInputItemRaw = ""
    outError = ""
    let requestId = int32(turnEventJsonFindInt64(pendingCallJson, "requestId"))
    let callId = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "callId")
    if callId == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing callId: ", turnEventPreview(pendingCallJson))
        return false
    let tool = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "tool")
    if tool == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing tool: ", turnEventPreview(pendingCallJson))
        return false
    var namespaceRaw = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "namespace")
    if namespaceRaw == "":
        namespaceRaw = "null"
    let argumentsRaw = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "arguments")
    if argumentsRaw == "":
        outError = wire.RustCsgCat("pending dynamic tool call missing arguments: ", turnEventPreview(pendingCallJson))
        return false
    let toolStartedAtMs = turnEventJsonFindInt64(pendingCallJson, "startedAtMs")
    var idError: str
    let responseId = turnEventJsonRpcFrameId(response, idError)
    if idError != "":
        outError = idError
        return false
    if responseId != requestId:
        outError = "dynamic tool client response id mismatch while completing pending tool: expected "
        outError = wire.RustCsgCat(outError, strings.IntToStr(requestId))
        outError = wire.RustCsgCat(outError, " got ")
        outError = wire.RustCsgCat(outError, strings.IntToStr(responseId))
        return false
    var contentItemsRaw: str
    var responseOutputRaw: str
    var success: bool
    var invalidResponse: bool
    var fallbackMessage: str
    var singleText: str
    if !turnEventHasField(response, "result"):
        let errorJson = wire.RustCsgJsonFindOptionalObject(response, "error")
        if errorJson != "":
            fallbackMessage = "dynamic tool request failed"
            invalidResponse = true
        else:
            outError = wire.RustCsgCat("dynamic tool client response missing result: ", turnEventPreview(response))
            return false
    if invalidResponse:
        contentItemsRaw = wire.RustCsgCat3("[{\"type\":\"inputText\",\"text\":", wire.RustCsgJsonQuote(fallbackMessage), "}]")
        responseOutputRaw = wire.RustCsgJsonQuote(fallbackMessage)
        success = false
    else:
        let resultJson = wire.RustCsgJsonFindObject(response, "result")
        contentItemsRaw = wire.RustCsgJsonFindOptionalArray(resultJson, "contentItems")
        if contentItemsRaw == "":
            fallbackMessage = "dynamic tool response was invalid"
            invalidResponse = true
        elif !turnEventHasField(resultJson, "success"):
            fallbackMessage = "dynamic tool response was invalid"
            invalidResponse = true
        if invalidResponse:
            contentItemsRaw = wire.RustCsgCat3("[{\"type\":\"inputText\",\"text\":", wire.RustCsgJsonQuote(fallbackMessage), "}]")
            responseOutputRaw = wire.RustCsgJsonQuote(fallbackMessage)
            success = false
        else:
            success = wire.RustCsgJsonFindBool(resultJson, "success")
            responseOutputRaw = "["
            var contentPos: int32 = 0
            var contentCount: int32 = 0
            var sawImage: bool = false
            var singleTextRaw: str
            while true:
                var contentItemJson: str
                var contentReadError: str
                if !turnEventReadArrayObject(contentItemsRaw, contentPos, contentItemJson, contentReadError):
                    if contentReadError != "":
                        fallbackMessage = "dynamic tool response was invalid"
                        invalidResponse = true
                    break
                let contentType = turnEventJsonFindString(contentItemJson, "type")
                var converted: str
                if contentType == "inputText":
                    let text = turnEventJsonFindString(contentItemJson, "text")
                    if contentCount == 0:
                        singleTextRaw = wire.RustCsgJsonQuote(text)
                        singleText = text
                    converted = "{"
                    converted = wire.RustCsgCat(converted, wire.RustCsgJsonFieldStr("type", "input_text"))
                    converted = wire.RustCsgCat(converted, ",")
                    converted = wire.RustCsgCat(converted, wire.RustCsgJsonFieldStr("text", text))
                    converted = wire.RustCsgCat(converted, "}")
                elif contentType == "inputImage":
                    sawImage = true
                    let imageUrl = turnEventJsonFindString(contentItemJson, "imageUrl")
                    if imageUrl == "":
                        fallbackMessage = "dynamic tool response was invalid"
                        invalidResponse = true
                        break
                    converted = "{"
                    converted = wire.RustCsgCat(converted, wire.RustCsgJsonFieldStr("type", "input_image"))
                    converted = wire.RustCsgCat(converted, ",")
                    converted = wire.RustCsgCat(converted, wire.RustCsgJsonFieldStr("image_url", imageUrl))
                    converted = wire.RustCsgCat(converted, ",")
                    converted = wire.RustCsgCat(converted, wire.RustCsgJsonFieldStr("detail", "high"))
                    converted = wire.RustCsgCat(converted, "}")
                else:
                    fallbackMessage = "dynamic tool response was invalid"
                    invalidResponse = true
                    break
                if contentCount > 0:
                    responseOutputRaw = wire.RustCsgCat(responseOutputRaw, ",")
                responseOutputRaw = wire.RustCsgCat(responseOutputRaw, converted)
                contentCount = contentCount + 1
            if invalidResponse:
                contentItemsRaw = wire.RustCsgCat3("[{\"type\":\"inputText\",\"text\":", wire.RustCsgJsonQuote(fallbackMessage), "}]")
                responseOutputRaw = wire.RustCsgJsonQuote(fallbackMessage)
                success = false
            else:
                responseOutputRaw = wire.RustCsgCat(responseOutputRaw, "]")
                if contentCount == 1 && !sawImage:
                    responseOutputRaw = singleTextRaw
    let completedAtMs = rustCsgTurnEventNowMs()
    var status = "failed"
    if success:
        status = "completed"
    let durationRaw = strings.Int64ToStr(completedAtMs - toolStartedAtMs)
    let completedItem = turnEventDynamicToolCallItem(callId, namespaceRaw, tool, argumentsRaw, status, contentItemsRaw, turnEventBoolRaw(success), durationRaw)
    if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemCompletedNotification(threadId, turnId, completedItem, completedAtMs)):
        outError = "failed to write dynamic tool item/completed"
        return false
    var inputItemRaw = "{"
    inputItemRaw = wire.RustCsgCat(inputItemRaw, wire.RustCsgJsonFieldStr("type", "function_call_output"))
    inputItemRaw = wire.RustCsgCat(inputItemRaw, ",")
    inputItemRaw = wire.RustCsgCat(inputItemRaw, wire.RustCsgJsonFieldStr("call_id", callId))
    inputItemRaw = wire.RustCsgCat(inputItemRaw, ",")
    inputItemRaw = wire.RustCsgCat(inputItemRaw, wire.RustCsgJsonFieldRaw("output", responseOutputRaw))
    inputItemRaw = wire.RustCsgCat(inputItemRaw, "}")
    outInputItemRaw = inputItemRaw
    return true

fn turnEventDrainDynamicToolCallsTarget(threadId: str,
                                        turnId: str,
                                        pendingCallsRaw: str,
                                        pendingCallCount: int32,
                                        fd: int32,
                                        notificationFds: int32[],
                                        requestFds: int32[],
                                        targetKind: int32,
                                        requestIdCounter: var int32,
                                        stdioBuffer: var str,
                                        outInputItemsRaw: var str,
                                        outError: var str): bool =
    outInputItemsRaw = ""
    outError = ""
    let pendingArray = wire.RustCsgCat3("[", pendingCallsRaw, "]")
    var pos: int32 = 0
    var seen: int32 = 0
    while seen < pendingCallCount:
        var pendingCallJson: str
        var parseError: str
        if !turnEventReadArrayObject(pendingArray, pos, pendingCallJson, parseError):
            if parseError != "":
                outError = parseError
                return false
            outError = "pending dynamic tool call list ended early"
            return false
        let pendingToolName = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "tool")
        if cheng_native_tools.ChengNativeIsTool(pendingToolName):
            let callId = wire.RustCsgJsonFindOptionalStr(pendingCallJson, "callId")
            if callId == "":
                outError = wire.RustCsgCat("pending Cheng native tool call missing callId: ", turnEventPreview(pendingCallJson))
                return false
            var namespaceRawNative = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "namespace")
            if namespaceRawNative == "":
                namespaceRawNative = "null"
            let argumentsRawNative = wire.RustCsgJsonFindOptionalValueRaw(pendingCallJson, "arguments")
            if argumentsRawNative == "":
                outError = wire.RustCsgCat("pending Cheng native tool call missing arguments: ", turnEventPreview(pendingCallJson))
                return false
            let toolStartedAtMs = rustCsgTurnEventNowMs()
            let startedItem = turnEventDynamicToolCallItem(callId, namespaceRawNative, pendingToolName, argumentsRawNative, "inProgress", "null", "null", "null")
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemStartedNotification(threadId, turnId, startedItem, toolStartedAtMs)):
                outError = "failed to write Cheng native dynamic tool item/started"
                return false
            let nativeRequestId = requestIdCounter
            requestIdCounter = requestIdCounter + 1
            let activeNativePending = turnEventPendingDynamicToolCallItem(nativeRequestId,
                                                                         callId,
                                                                         namespaceRawNative,
                                                                         pendingToolName,
                                                                         argumentsRawNative,
                                                                         toolStartedAtMs)
            let nativeResponse = cheng_native_tools.ChengNativeHandleToolCall(nativeRequestId, pendingToolName, argumentsRawNative)
            cheng_agent_runtime.ChengAgentRuntimeRecordNativeToolCall(pendingToolName, argumentsRawNative, nativeResponse)
            var nativeInputItemRaw: str
            var nativeCompleteError: str
            if !turnEventCompleteDynamicToolCallTarget(threadId,
                                                      turnId,
                                                      activeNativePending,
                                                      nativeResponse,
                                                      fd,
                                                      notificationFds,
                                                      targetKind,
                                                      nativeInputItemRaw,
                                                      nativeCompleteError):
                outError = nativeCompleteError
                return false
            if seen > 0:
                outInputItemsRaw = wire.RustCsgCat(outInputItemsRaw, ",")
            outInputItemsRaw = wire.RustCsgCat(outInputItemsRaw, nativeInputItemRaw)
            seen = seen + 1
            continue
        var activePendingCallJson: str = pendingCallJson
        var requestId = int32(turnEventJsonFindInt64(activePendingCallJson, "requestId"))
        if requestId < 0:
            var startedPendingCallRaw: str
            var startError: str
            if !turnEventStartPendingDynamicToolCallTarget(threadId,
                                                          turnId,
                                                          pendingCallJson,
                                                          fd,
                                                          notificationFds,
                                                          requestFds,
                                                          targetKind,
                                                          requestIdCounter,
                                                          startedPendingCallRaw,
                                                          startError):
                outError = startError
                return false
            activePendingCallJson = startedPendingCallRaw
            requestId = int32(turnEventJsonFindInt64(activePendingCallJson, "requestId"))
        var responseJson: str
        var responseError: str
        if !turnEventReadServerResponseTarget(requestFds, targetKind, requestId, stdioBuffer, responseJson, responseError):
            outError = responseError
            return false
        var inputItemRaw: str
        var completeError: str
        if !turnEventCompleteDynamicToolCallTarget(threadId,
                                                  turnId,
                                                  activePendingCallJson,
                                                  responseJson,
                                                  fd,
                                                  notificationFds,
                                                  targetKind,
                                                  inputItemRaw,
                                                  completeError):
            outError = completeError
            return false
        if seen > 0:
            outInputItemsRaw = wire.RustCsgCat(outInputItemsRaw, ",")
            outInputItemsRaw = wire.RustCsgCat(outInputItemsRaw, inputItemRaw)
        else:
            outInputItemsRaw = inputItemRaw
        seen = seen + 1
    return true

fn turnEventLiveFail(handle: int32, message: str, outError: var str): bool =
    outError = message
    let _agentRuntimeFailedSnapshot = cheng_agent_runtime.ChengAgentRuntimeFinalizeTurnIfActive("failed")
    if handle > 0:
        rustCsgTurnEventSseClose(handle)
    return false

fn turnEventResetResponseAttemptState(itemId: var str,
                                      itemStarted: var bool,
                                      itemCompleted: var bool,
                                      finalText: var str,
                                      deltaText: var str,
                                      reasoningItemId: var str,
                                      reasoningItemStarted: var bool,
                                      reasoningItemCompleted: var bool,
                                      pendingToolCallsRaw: var str,
                                      pendingToolCallCount: var int32,
                                      idlePolls: var int32) =
    itemId = ""
    itemStarted = false
    itemCompleted = false
    finalText = ""
    deltaText = ""
    reasoningItemId = ""
    reasoningItemStarted = false
    reasoningItemCompleted = false
    pendingToolCallsRaw = ""
    pendingToolCallCount = 0
    idlePolls = 0

fn turnEventTryRetryStream(handle: var int32,
                           requestBody: str,
                           threadId: str,
                           turnId: str,
                           threadSource: str,
                           fd: int32,
                           notificationFds: int32[],
                           targetKind: int32,
                           detailMessage: str,
                           retryCount: var int32,
                           maxRetries: int32,
                           outError: var str): int32 =
    outError = ""
    if retryCount >= maxRetries:
        return 0
    retryCount = retryCount + 1
    let retryMessage = turnEventRetryMessage(retryCount, maxRetries)
    let detailRaw = wire.RustCsgJsonQuote(detailMessage)
    let notification = turnEventErrorNotificationWithDetails(threadId, turnId, retryMessage, true, turnEventResponseStreamDisconnectedInfoRaw(), detailRaw)
    if !turnEventWriteTarget(fd, notificationFds, targetKind, notification):
        outError = "failed to write stream retry error notification"
        rustCsgTurnEventSseClose(handle)
        return -1
    rustCsgTurnEventSseClose(handle)
    var retryError: str
    let nextHandle = turnEventStartResponsesStreamBodyWithThreadSource(requestBody, threadId, turnId, threadSource, retryError)
    if retryError != "":
        outError = retryError
        return -1
    handle = nextHandle
    return 1

fn turnEventWriteFailureNotificationsTarget(threadId: str,
                                            turnId: str,
                                            fd: int32,
                                            notificationFds: int32[],
                                            targetKind: int32,
                                            startedAtMs: int64,
                                            completedAtMs: int64,
                                            message: str,
                                            codexErrorInfoRaw: str): bool =
    if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventErrorNotificationWithInfo(threadId, turnId, message, false, codexErrorInfoRaw)):
        return false
    return turnEventWriteTarget(fd, notificationFds, targetKind, turnEventTurnFailedNotificationWithInfo(threadId, turnId, startedAtMs, completedAtMs, message, codexErrorInfoRaw))

fn turnEventCloseWithTerminalFailure(handle: int32,
                                     threadId: str,
                                     turnId: str,
                                     fd: int32,
                                     notificationFds: int32[],
                                     targetKind: int32,
                                     startedAtMs: int64,
                                     message: str,
                                     codexErrorInfoRaw: str,
                                     outError: var str): bool =
    let completedAtMs = rustCsgTurnEventNowMs()
    if !turnEventWriteFailureNotificationsTarget(threadId, turnId, fd, notificationFds, targetKind, startedAtMs, completedAtMs, message, codexErrorInfoRaw):
        return turnEventLiveFail(handle, "failed to write terminal stream failure", outError)
    let _agentRuntimeFailedSnapshot = cheng_agent_runtime.ChengAgentRuntimeFinalizeTurnIfActive("failed")
    rustCsgTurnEventSseClose(handle)
    return true

fn turnEventWriteLiveFromResponseTarget(body: str,
                                        response: str,
                                        dynamicToolsJson: str,
                                        baseInstructions: str,
                                        developerInstructions: str,
                                        historyJson: str,
                                        threadSource: str,
                                        fd: int32,
                                        notificationFds: int32[],
                                        requestFds: int32[],
                                        targetKind: int32,
                                        stdioBuffer: var str,
                                        outError: var str): bool =
    outError = ""
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model == "":
        return true
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    let resultJson = wire.RustCsgJsonFindObject(response, "result")
    let turnJson = wire.RustCsgJsonFindObject(resultJson, "turn")
    let turnId = wire.RustCsgJsonFindStr(turnJson, "id")
    cheng_agent_runtime.ChengAgentRuntimeBeginTurn(threadId, turnId, turnEventInputText(paramsJson))
    var initialInputError: str
    var modelInputItemsRaw = turnEventBuildInitialInputItemsRaw(threadId, paramsJson, developerInstructions, historyJson, initialInputError)
    if initialInputError != "":
        outError = initialInputError
        return false
    var initialBuildError: str
    var currentRequestBody = turnEventBuildResponsesBodyFromInputRaw(model, threadId, paramsJson, modelInputItemsRaw, dynamicToolsJson, baseInstructions, initialBuildError)
    if initialBuildError != "":
        outError = initialBuildError
        return false
    var retryConfigError: str
    let streamMaxRetries: int32 = turnEventReadStreamMaxRetries(retryConfigError)
    if retryConfigError != "":
        outError = retryConfigError
        return false
    var startError: str
    var handle = turnEventStartResponsesStreamBodyWithThreadSource(currentRequestBody, threadId, turnId, threadSource, startError)
    if startError != "":
        outError = startError
        return false

    let startedAtMs = rustCsgTurnEventNowMs()
    var itemId: str
    var itemStarted: bool
    var itemCompleted: bool
    var streamCompleted: bool
    var finalText: str
    var deltaText: str
    var reasoningItemId: str
    var reasoningItemStarted: bool
    var reasoningItemCompleted: bool
    var idlePolls: int32
    var serverRequestId: int32 = 0
    var pendingToolCallsRaw: str
    var pendingToolCallCount: int32 = 0
    var accumulatedInputTokens: int64
    var accumulatedCachedInputTokens: int64
    var accumulatedOutputTokens: int64
    var accumulatedReasoningOutputTokens: int64
    var accumulatedTotalTokens: int64
    var rateLimitSnapshotJson: str
    var streamRetryCount: int32
    while true:
        let poll = rustCsgTurnEventSsePoll(handle, 100)
        if poll == "":
            idlePolls = idlePolls + 1
            if idlePolls > 1800:
                let detail = turnEventStreamDisconnectedDetail("responses stream timed out before response.completed")
                let retryResult = turnEventTryRetryStream(handle, currentRequestBody, threadId, turnId, threadSource, fd, notificationFds, targetKind, detail, streamRetryCount, streamMaxRetries, outError)
                if retryResult == 1:
                    turnEventResetResponseAttemptState(itemId, itemStarted, itemCompleted, finalText, deltaText, reasoningItemId, reasoningItemStarted, reasoningItemCompleted, pendingToolCallsRaw, pendingToolCallCount, idlePolls)
                    rateLimitSnapshotJson = ""
                    continue
                if retryResult < 0:
                    return false
                return turnEventCloseWithTerminalFailure(handle, threadId, turnId, fd, notificationFds, targetKind, startedAtMs, detail, wire.RustCsgJsonQuote("other"), outError)
            continue
        idlePolls = 0
        let kind = poll[0]
        if kind == 'E':
            let message = strings.SliceBytes(poll, 1, poll.len - 1)
            let detail = turnEventStreamDisconnectedDetail(message)
            let retryResult = turnEventTryRetryStream(handle, currentRequestBody, threadId, turnId, threadSource, fd, notificationFds, targetKind, detail, streamRetryCount, streamMaxRetries, outError)
            if retryResult == 1:
                turnEventResetResponseAttemptState(itemId, itemStarted, itemCompleted, finalText, deltaText, reasoningItemId, reasoningItemStarted, reasoningItemCompleted, pendingToolCallsRaw, pendingToolCallCount, idlePolls)
                rateLimitSnapshotJson = ""
                continue
            if retryResult < 0:
                return false
            return turnEventCloseWithTerminalFailure(handle, threadId, turnId, fd, notificationFds, targetKind, startedAtMs, detail, wire.RustCsgJsonQuote("other"), outError)
        if kind == 'S':
            let statusText = strings.SliceBytes(poll, 1, poll.len - 1)
            if !streamCompleted:
                var status = turnEventJsonFindInt64(wire.RustCsgCat3("{\"status\":", statusText, "}"), "status")
                if status != int64(200):
                    let detail = turnEventStreamDisconnectedDetail(wire.RustCsgCat("responses provider returned HTTP ", statusText))
                    let retryResult = turnEventTryRetryStream(handle, currentRequestBody, threadId, turnId, threadSource, fd, notificationFds, targetKind, detail, streamRetryCount, streamMaxRetries, outError)
                    if retryResult == 1:
                        turnEventResetResponseAttemptState(itemId, itemStarted, itemCompleted, finalText, deltaText, reasoningItemId, reasoningItemStarted, reasoningItemCompleted, pendingToolCallsRaw, pendingToolCallCount, idlePolls)
                        rateLimitSnapshotJson = ""
                        continue
                    if retryResult < 0:
                        return false
                    return turnEventCloseWithTerminalFailure(handle, threadId, turnId, fd, notificationFds, targetKind, startedAtMs, detail, turnEventResponseStreamConnectionFailedInfoRaw(), outError)
                let detail = turnEventStreamDisconnectedDetail("responses stream ended before response.completed")
                let retryResult = turnEventTryRetryStream(handle, currentRequestBody, threadId, turnId, threadSource, fd, notificationFds, targetKind, detail, streamRetryCount, streamMaxRetries, outError)
                if retryResult == 1:
                    turnEventResetResponseAttemptState(itemId, itemStarted, itemCompleted, finalText, deltaText, reasoningItemId, reasoningItemStarted, reasoningItemCompleted, pendingToolCallsRaw, pendingToolCallCount, idlePolls)
                    rateLimitSnapshotJson = ""
                    continue
                if retryResult < 0:
                    return false
                return turnEventCloseWithTerminalFailure(handle, threadId, turnId, fd, notificationFds, targetKind, startedAtMs, detail, wire.RustCsgJsonQuote("other"), outError)
            rustCsgTurnEventSseClose(handle)
            return true
        if kind != 'D':
            return turnEventLiveFail(handle, "responses streaming provider returned invalid poll frame", outError)
        let data = strings.SliceBytes(poll, 1, poll.len - 1)
        let eventType = turnEventJsonFindString(data, "type")
        if eventType == "codex.rate_limits":
            rateLimitSnapshotJson = turnEventRateLimitSnapshotFromEvent(data)
            continue
        elif turnEventIsFailureEvent(eventType):
            let message = turnEventResponseFailureMessage(data, eventType)
            let codexErrorInfoRaw = turnEventResponseFailureCodexErrorInfoRaw(data, eventType)
            if rateLimitSnapshotJson == "":
                rateLimitSnapshotJson = turnEventRateLimitSnapshotFromFailureEvent(data)
            if turnEventFailureEventIsRetryable(data, eventType):
                let detail = turnEventStreamDisconnectedDetail(message)
                let retryResult = turnEventTryRetryStream(handle, currentRequestBody, threadId, turnId, threadSource, fd, notificationFds, targetKind, detail, streamRetryCount, streamMaxRetries, outError)
                if retryResult == 1:
                    turnEventResetResponseAttemptState(itemId, itemStarted, itemCompleted, finalText, deltaText, reasoningItemId, reasoningItemStarted, reasoningItemCompleted, pendingToolCallsRaw, pendingToolCallCount, idlePolls)
                    rateLimitSnapshotJson = ""
                    continue
                if retryResult < 0:
                    return false
            if rateLimitSnapshotJson != "":
                if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventRateLimitsUpdatedNotification(rateLimitSnapshotJson)):
                    return turnEventLiveFail(handle, "failed to write account/rateLimits/updated", outError)
            if !turnEventWriteFailureNotificationsTarget(threadId, turnId, fd, notificationFds, targetKind, startedAtMs, rustCsgTurnEventNowMs(), message, codexErrorInfoRaw):
                return turnEventLiveFail(handle, "failed to write failed response notification", outError)
            streamCompleted = true
            rustCsgTurnEventSseClose(handle)
            return true
        elif eventType == "response.output_item.added":
            let itemType = turnEventResponseItemType(data)
            if itemType == "function_call":
                continue
            if itemType == "reasoning":
                var seenReasoningItemId: str
                var reasoningItemJson: str
                var reasoningError: str
                if !turnEventReasoningItemFromResponseData(data, seenReasoningItemId, reasoningItemJson, reasoningError):
                    return turnEventLiveFail(handle, reasoningError, outError)
                if reasoningItemId != "" && reasoningItemId != seenReasoningItemId:
                    return turnEventLiveFail(handle, "responses stream changed reasoning item id", outError)
                reasoningItemId = seenReasoningItemId
                if !reasoningItemStarted:
                    reasoningItemStarted = true
                    if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemStartedNotification(threadId, turnId, reasoningItemJson, startedAtMs)):
                        return turnEventLiveFail(handle, "failed to write reasoning item/started", outError)
                continue
            if itemType != "" && itemType != "message":
                return turnEventLiveFail(handle, wire.RustCsgCat("unsupported responses output item type: ", itemType), outError)
            let seenItemId = turnEventResponseMessageItemId(data)
            if seenItemId != "":
                if itemId != "" && itemId != seenItemId:
                    return turnEventLiveFail(handle, "responses stream changed message item id", outError)
                itemId = seenItemId
            if !turnEventEnsureItemStartedTarget(threadId, turnId, fd, notificationFds, targetKind, startedAtMs, itemId, itemStarted):
                return turnEventLiveFail(handle, "failed to write item/started", outError)
        elif eventType == "response.output_text.delta":
            let delta = turnEventJsonFindString(data, "delta")
            if delta == "":
                return turnEventLiveFail(handle, wire.RustCsgCat("responses stream missing delta value: ", turnEventPreview(data)), outError)
            if !turnEventEnsureItemStartedTarget(threadId, turnId, fd, notificationFds, targetKind, startedAtMs, itemId, itemStarted):
                return turnEventLiveFail(handle, "failed to write item/started", outError)
            deltaText = wire.RustCsgCat(deltaText, delta)
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventAgentDeltaNotification(threadId, turnId, itemId, delta)):
                return turnEventLiveFail(handle, "failed to write item/agentMessage/delta", outError)
        elif eventType == "response.reasoning_summary_text.delta":
            if !reasoningItemStarted || reasoningItemId == "":
                return turnEventLiveFail(handle, "ReasoningSummaryDelta without active item", outError)
            if !turnEventHasField(data, "delta"):
                return turnEventLiveFail(handle, wire.RustCsgCat("responses stream missing reasoning summary delta: ", turnEventPreview(data)), outError)
            let delta = turnEventJsonFindString(data, "delta")
            let summaryIndex = turnEventJsonFindInt64(data, "summary_index")
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventReasoningSummaryTextDeltaNotification(threadId, turnId, reasoningItemId, delta, summaryIndex)):
                return turnEventLiveFail(handle, "failed to write item/reasoning/summaryTextDelta", outError)
        elif eventType == "response.reasoning_summary_part.added":
            if !reasoningItemStarted || reasoningItemId == "":
                return turnEventLiveFail(handle, "ReasoningSummaryPartAdded without active item", outError)
            let summaryIndex = turnEventJsonFindInt64(data, "summary_index")
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventReasoningSummaryPartAddedNotification(threadId, turnId, reasoningItemId, summaryIndex)):
                return turnEventLiveFail(handle, "failed to write item/reasoning/summaryPartAdded", outError)
        elif eventType == "response.reasoning_text.delta":
            if !reasoningItemStarted || reasoningItemId == "":
                return turnEventLiveFail(handle, "ReasoningRawContentDelta without active item", outError)
            if !turnEventHasField(data, "delta"):
                return turnEventLiveFail(handle, wire.RustCsgCat("responses stream missing reasoning text delta: ", turnEventPreview(data)), outError)
            let delta = turnEventJsonFindString(data, "delta")
            let contentIndex = turnEventJsonFindInt64(data, "content_index")
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventReasoningTextDeltaNotification(threadId, turnId, reasoningItemId, delta, contentIndex)):
                return turnEventLiveFail(handle, "failed to write item/reasoning/textDelta", outError)
        elif eventType == "response.output_item.done" || eventType == "conversation.item.done":
            let itemType = turnEventResponseItemType(data)
            if itemType == "function_call":
                var pendingToolCallRaw: str
                var toolError: str
                if pendingToolCallCount == 0:
                    if !turnEventStartDynamicToolCallTarget(threadId,
                                                           turnId,
                                                           data,
                                                           fd,
                                                           notificationFds,
                                                           requestFds,
                                                           targetKind,
                                                           serverRequestId,
                                                           pendingToolCallRaw,
                                                           toolError):
                        return turnEventLiveFail(handle, toolError, outError)
                else:
                    if !turnEventQueueDynamicToolCall(data, pendingToolCallRaw, toolError):
                        return turnEventLiveFail(handle, toolError, outError)
                if pendingToolCallCount > 0:
                    pendingToolCallsRaw = wire.RustCsgCat(pendingToolCallsRaw, ",")
                    pendingToolCallsRaw = wire.RustCsgCat(pendingToolCallsRaw, pendingToolCallRaw)
                else:
                    pendingToolCallsRaw = pendingToolCallRaw
                pendingToolCallCount = pendingToolCallCount + 1
                continue
            if itemType == "exec_approval_request":
                var approvalError: str
                if !turnEventHandleCommandExecutionApprovalRequestTarget(threadId,
                                                                         data,
                                                                         fd,
                                                                         notificationFds,
                                                                         requestFds,
                                                                         targetKind,
                                                                         serverRequestId,
                                                                         stdioBuffer,
                                                                         approvalError):
                    return turnEventLiveFail(handle, approvalError, outError)
                continue
            if itemType == "apply_patch_approval_request":
                var approvalError: str
                if !turnEventHandleFileChangeApprovalRequestTarget(threadId,
                                                                   data,
                                                                   fd,
                                                                   notificationFds,
                                                                   requestFds,
                                                                   targetKind,
                                                                   serverRequestId,
                                                                   stdioBuffer,
                                                                   approvalError):
                    return turnEventLiveFail(handle, approvalError, outError)
                continue
            if itemType == "reasoning":
                var seenReasoningItemId: str
                var reasoningItemJson: str
                var reasoningError: str
                if !turnEventReasoningItemFromResponseData(data, seenReasoningItemId, reasoningItemJson, reasoningError):
                    return turnEventLiveFail(handle, reasoningError, outError)
                if reasoningItemId != "" && reasoningItemId != seenReasoningItemId:
                    return turnEventLiveFail(handle, "responses stream changed reasoning item id", outError)
                reasoningItemId = seenReasoningItemId
                if !reasoningItemStarted:
                    reasoningItemStarted = true
                    if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemStartedNotification(threadId, turnId, turnEventReasoningItem(reasoningItemId, "[]", "[]"), startedAtMs)):
                        return turnEventLiveFail(handle, "failed to write reasoning item/started", outError)
                reasoningItemCompleted = true
                let completedAtMs = rustCsgTurnEventNowMs()
                if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemCompletedNotification(threadId, turnId, reasoningItemJson, completedAtMs)):
                    return turnEventLiveFail(handle, "failed to write reasoning item/completed", outError)
                continue
            if itemType != "" && itemType != "message":
                return turnEventLiveFail(handle, wire.RustCsgCat("unsupported responses output item type: ", itemType), outError)
            let seenItemId = turnEventResponseMessageItemId(data)
            if seenItemId != "":
                if itemId != "" && itemId != seenItemId:
                    return turnEventLiveFail(handle, "responses stream changed message item id", outError)
                itemId = seenItemId
            if !turnEventEnsureItemStartedTarget(threadId, turnId, fd, notificationFds, targetKind, startedAtMs, itemId, itemStarted):
                return turnEventLiveFail(handle, "failed to write item/started", outError)
            finalText = turnEventJsonFindString(data, "text")
            if finalText == "":
                return turnEventLiveFail(handle, wire.RustCsgCat("responses stream missing final assistant message: ", turnEventPreview(data)), outError)
            if deltaText != finalText:
                var mismatch = "responses stream delta/text mismatch: delta="
                mismatch = wire.RustCsgCat(mismatch, turnEventPreview(deltaText))
                mismatch = wire.RustCsgCat(mismatch, " final=")
                mismatch = wire.RustCsgCat(mismatch, turnEventPreview(finalText))
                return turnEventLiveFail(handle, mismatch, outError)
            itemCompleted = true
            let completedAtMs = rustCsgTurnEventNowMs()
            let itemJson = turnEventAgentMessageItem(itemId, finalText)
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventItemCompletedNotification(threadId, turnId, itemJson, completedAtMs)):
                return turnEventLiveFail(handle, "failed to write item/completed", outError)
        elif eventType == "response.completed":
            let responseJson = wire.RustCsgJsonFindOptionalObject(data, "response")
            if pendingToolCallCount > 0 && itemCompleted:
                return turnEventLiveFail(handle, "responses stream completed with assistant item and pending dynamic tool outputs", outError)
            if pendingToolCallCount > 0:
                let previousResponseId = wire.RustCsgJsonFindOptionalStr(responseJson, "id")
                if previousResponseId == "":
                    return turnEventLiveFail(handle, wire.RustCsgCat("responses stream missing response id for dynamic tool follow-up: ", turnEventPreview(data)), outError)
                rustCsgTurnEventSseClose(handle)
                var followUpInputItemsRaw: str
                var drainError: str
                if !turnEventDrainDynamicToolCallsTarget(threadId,
                                                        turnId,
                                                        pendingToolCallsRaw,
                                                        pendingToolCallCount,
                                                        fd,
                                                        notificationFds,
                                                        requestFds,
                                                        targetKind,
                                                        serverRequestId,
                                                        stdioBuffer,
                                                        followUpInputItemsRaw,
                                                        drainError):
                    outError = drainError
                    return false
                var followUpBuildError: str
                let followUpBody = turnEventBuildFunctionCallOutputsBody(model, threadId, paramsJson, previousResponseId, followUpInputItemsRaw, dynamicToolsJson, baseInstructions, followUpBuildError)
                if followUpBuildError != "":
                    outError = followUpBuildError
                    return false
                var followUpError: str
                currentRequestBody = followUpBody
                handle = turnEventStartResponsesStreamBodyWithThreadSource(currentRequestBody, threadId, turnId, threadSource, followUpError)
                if followUpError != "":
                    outError = followUpError
                    return false
                itemId = ""
                itemStarted = false
                itemCompleted = false
                finalText = ""
                deltaText = ""
                reasoningItemId = ""
                reasoningItemStarted = false
                reasoningItemCompleted = false
                pendingToolCallsRaw = ""
                pendingToolCallCount = 0
                rateLimitSnapshotJson = ""
                idlePolls = 0
                streamRetryCount = 0
                continue
            if !itemCompleted && !reasoningItemCompleted:
                return turnEventLiveFail(handle, "responses stream completed before item/completed", outError)
            let usageJson = wire.RustCsgJsonFindOptionalObject(responseJson, "usage")
            let completedAtMs = rustCsgTurnEventNowMs()
            if usageJson != "":
                let inputTokens = wire.RustCsgJsonFindInt64(usageJson, "input_tokens")
                let outputTokens = wire.RustCsgJsonFindInt64(usageJson, "output_tokens")
                let totalTokens = wire.RustCsgJsonFindInt64(usageJson, "total_tokens")
                var cachedInputTokens: int64
                let inputDetails = wire.RustCsgJsonFindOptionalObject(usageJson, "input_tokens_details")
                if inputDetails != "":
                    cachedInputTokens = wire.RustCsgJsonFindInt64(inputDetails, "cached_tokens")
                var reasoningOutputTokens: int64
                let outputDetails = wire.RustCsgJsonFindOptionalObject(usageJson, "output_tokens_details")
                if outputDetails != "":
                    reasoningOutputTokens = wire.RustCsgJsonFindInt64(outputDetails, "reasoning_tokens")
                accumulatedInputTokens = accumulatedInputTokens + inputTokens
                accumulatedCachedInputTokens = accumulatedCachedInputTokens + cachedInputTokens
                accumulatedOutputTokens = accumulatedOutputTokens + outputTokens
                accumulatedReasoningOutputTokens = accumulatedReasoningOutputTokens + reasoningOutputTokens
                accumulatedTotalTokens = accumulatedTotalTokens + totalTokens
                let totalPart = turnEventUsagePart(accumulatedTotalTokens, accumulatedInputTokens, accumulatedCachedInputTokens, accumulatedOutputTokens, accumulatedReasoningOutputTokens)
                let lastPart = turnEventUsagePart(totalTokens, inputTokens, cachedInputTokens, outputTokens, reasoningOutputTokens)
                if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventTokenUsageNotificationFromPartsRaw(threadId, turnId, totalPart, lastPart)):
                    return turnEventLiveFail(handle, "failed to write thread/tokenUsage/updated", outError)
            if rateLimitSnapshotJson != "":
                if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventRateLimitsUpdatedNotification(rateLimitSnapshotJson)):
                    return turnEventLiveFail(handle, "failed to write account/rateLimits/updated", outError)
            if turnEventHasField(responseJson, "end_turn") && !wire.RustCsgJsonFindOptionalBool(responseJson, "end_turn"):
                if finalText == "":
                    return turnEventLiveFail(handle, "responses stream end_turn=false without model-visible assistant message", outError)
                rustCsgTurnEventSseClose(handle)
                modelInputItemsRaw = wire.RustCsgCat3(modelInputItemsRaw, ",", turnEventResponsesAssistantTextInputItemRaw(finalText))
                var followUpBuildError: str
                let followUpBody = turnEventBuildResponsesBodyFromInputRaw(model, threadId, paramsJson, modelInputItemsRaw, dynamicToolsJson, baseInstructions, followUpBuildError)
                if followUpBuildError != "":
                    outError = followUpBuildError
                    return false
                var followUpError: str
                currentRequestBody = followUpBody
                handle = turnEventStartResponsesStreamBodyWithThreadSource(currentRequestBody, threadId, turnId, threadSource, followUpError)
                if followUpError != "":
                    outError = followUpError
                    return false
                itemId = ""
                itemStarted = false
                itemCompleted = false
                finalText = ""
                deltaText = ""
                reasoningItemId = ""
                reasoningItemStarted = false
                reasoningItemCompleted = false
                pendingToolCallsRaw = ""
                pendingToolCallCount = 0
                rateLimitSnapshotJson = ""
                idlePolls = 0
                streamRetryCount = 0
                continue
            if !turnEventWriteTarget(fd, notificationFds, targetKind, turnEventTurnCompletedNotification(threadId, turnId, startedAtMs, completedAtMs)):
                return turnEventLiveFail(handle, "failed to write turn/completed", outError)
            let _agentRuntimeSnapshot = cheng_agent_runtime.ChengAgentRuntimeFinalizeTurn("completed")
            streamCompleted = true
            rustCsgTurnEventSseClose(handle)
            return true
    return turnEventLiveFail(handle, "responses stream loop exited unexpectedly", outError)

fn RustCsgAppServerTurnEventWriteLiveFromResponse(body: str,
                                                  response: str,
                                                  fd: int32,
                                                  outError: var str): bool =
    var clientFds: int32[]
    var requestFds: int32[]
    var stdioBuffer: str
    return turnEventWriteLiveFromResponseTarget(body, response, "", "", "", "", "", fd, clientFds, requestFds, 1, stdioBuffer, outError)

