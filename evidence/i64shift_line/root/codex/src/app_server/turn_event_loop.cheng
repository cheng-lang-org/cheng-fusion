fn RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse(response: str,
                                                                            outPayload: var str,
                                                                            outError: var str): str =
    outPayload = ""
    outError = ""
    let resultJson = wire.RustCsgJsonFindOptionalObject(response, "result")
    if resultJson == "":
        outError = "command execution approval response missing result"
        return ""
    let decisionRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "decision")
    if decisionRaw == "":
        outError = "command execution approval response missing decision"
        return ""
    if decisionRaw[0] == '"':
        let decision = wire.RustCsgJsonFindStr(resultJson, "decision")
        if decision == "accept":
            return "approved"
        if decision == "acceptForSession":
            return "approved_for_session"
        if decision == "decline":
            return "denied"
        if decision == "cancel":
            return "abort"
        outError = wire.RustCsgCat("unsupported command execution approval decision: ", decision)
        return ""
    if wire.RustCsgContains(decisionRaw, "\"acceptWithExecpolicyAmendment\""):
        let payloadObj = wire.RustCsgJsonFindObject(decisionRaw, "acceptWithExecpolicyAmendment")
        let amendment = wire.RustCsgJsonFindOptionalValueRaw(payloadObj, "execpolicy_amendment")
        if amendment == "":
            outError = "approved_execpolicy_amendment response missing execpolicy_amendment payload"
            return ""
        outPayload = wire.RustCsgCat3("{\"execpolicy_amendment\":", amendment, "}")
        return "approved_execpolicy_amendment"
    if wire.RustCsgContains(decisionRaw, "\"applyNetworkPolicyAmendment\""):
        let payloadObj = wire.RustCsgJsonFindObject(decisionRaw, "applyNetworkPolicyAmendment")
        let amendment = wire.RustCsgJsonFindOptionalObject(payloadObj, "network_policy_amendment")
        if amendment == "":
            outError = "network_policy_amendment response missing network_policy_amendment payload"
            return ""
        let action = wire.RustCsgJsonFindOptionalStr(amendment, "action")
        if action != "" && action != "allow" && action != "deny":
            outError = wire.RustCsgCat("unsupported network_policy_amendment action: ", action)
            return ""
        outPayload = wire.RustCsgCat3("{\"network_policy_amendment\":", amendment, "}")
        return "network_policy_amendment"
    outError = wire.RustCsgCat("unsupported command execution approval decision object: ", turnEventPreview(decisionRaw))
    return ""

fn RustCsgAppServerTurnEventFileChangeApprovalDecisionKindFromResponse(response: str,
                                                                       outError: var str): str =
    outError = ""
    let resultJson = wire.RustCsgJsonFindOptionalObject(response, "result")
    if resultJson == "":
        outError = "file change approval response missing result"
        return ""
    let decisionRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "decision")
    if decisionRaw == "":
        outError = "file change approval response missing decision"
        return ""
    if decisionRaw[0] != '"':
        outError = wire.RustCsgCat("unsupported file change approval decision object: ", turnEventPreview(decisionRaw))
        return ""
    let decision = wire.RustCsgJsonFindStr(resultJson, "decision")
    if decision == "accept":
        return "approved"
    if decision == "acceptForSession":
        return "approved_for_session"
    if decision == "decline":
        return "denied"
    if decision == "cancel":
        return "abort"
    outError = wire.RustCsgCat("unsupported file change approval decision: ", decision)
    return ""

fn RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse(response: str,
                                                                       approvalId: str,
                                                                       itemId: str,
                                                                       turnId: str,
                                                                       outError: var str): str =
    outError = ""
    var opId = approvalId
    if opId == "":
        opId = itemId
    if opId == "":
        outError = "command execution approval core op missing approval id"
        return ""
    if turnId == "":
        outError = "command execution approval core op missing turn id"
        return ""
    var payload: str
    var kindError: str
    let kind = RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse(response, payload, kindError)
    if kindError != "":
        outError = kindError
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "exec_approval"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", opId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",\"decision\":")
    if kind == "approved_execpolicy_amendment":
        let amendment = wire.RustCsgJsonFindOptionalValueRaw(payload, "execpolicy_amendment")
        out = wire.RustCsgCat(out, "{\"approved_execpolicy_amendment\":{\"proposed_execpolicy_amendment\":")
        out = wire.RustCsgCat(out, amendment)
        out = wire.RustCsgCat(out, "}}")
    elif kind == "network_policy_amendment":
        out = wire.RustCsgCat(out, wire.RustCsgCat3("{\"network_policy_amendment\":", payload, "}"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(kind))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppServerTurnEventFileChangeApprovalCoreOpFromResponse(response: str,
                                                                 itemId: str,
                                                                 outError: var str): str =
    outError = ""
    if itemId == "":
        outError = "file change approval core op missing item id"
        return ""
    let kind = RustCsgAppServerTurnEventFileChangeApprovalDecisionKindFromResponse(response, outError)
    if outError != "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "patch_approval"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", itemId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("decision", kind))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pendingJson: str,
                                                                 clientFrame: str,
                                                                 outResolved: var bool,
                                                                 outError: var str): str =
    outResolved = false
    outError = ""
    let requestId = wire.RustCsgJsonFindInt32(pendingJson, "requestId")
    var idError: str
    let responseId = turnEventJsonRpcFrameId(clientFrame, idError)
    if idError != "":
        if turnEventJsonRpcResponseTransportDrop(clientFrame):
            return ""
        outError = idError
        return ""
    if responseId != requestId:
        outError = "approval client response id mismatch: expected "
        outError = wire.RustCsgCat(outError, strings.IntToStr(requestId))
        outError = wire.RustCsgCat(outError, " got ")
        outError = wire.RustCsgCat(outError, strings.IntToStr(responseId))
        return ""
    if turnEventJsonRpcResponseTransportDrop(clientFrame):
        return ""
    outResolved = true
    let kind = wire.RustCsgJsonFindOptionalStr(pendingJson, "kind")
    if kind == "commandExecution":
        if wire.RustCsgJsonFindOptionalObject(clientFrame, "error") != "":
            if wire.RustCsgContains(clientFrame, "turnTransition"):
                return ""
            let approvalId = wire.RustCsgJsonFindOptionalStr(pendingJson, "approvalId")
            var opId = approvalId
            if opId == "":
                opId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
            let turnId = wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId")
            return wire.RustCsgCat3(wire.RustCsgCat3("{\"type\":\"exec_approval\",\"id\":", wire.RustCsgJsonQuote(opId), ",\"turn_id\":"), wire.RustCsgJsonQuote(turnId), ",\"decision\":\"denied\"}")
        let op = RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse(clientFrame,
                                                                                     wire.RustCsgJsonFindOptionalStr(pendingJson, "approvalId"),
                                                                                     wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId"),
                                                                                     wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId"),
                                                                                     outError)
        if outError != "":
            outError = ""
            return RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":0,\"result\":{\"decision\":\"decline\"}}",
                                                                                      wire.RustCsgJsonFindOptionalStr(pendingJson, "approvalId"),
                                                                                      wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId"),
                                                                                      wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId"),
                                                                                      outError)
        return op
    if kind == "fileChange":
        let itemId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
        if wire.RustCsgJsonFindOptionalObject(clientFrame, "error") != "":
            if wire.RustCsgContains(clientFrame, "turnTransition"):
                return ""
            return wire.RustCsgCat3("{\"type\":\"patch_approval\",\"id\":", wire.RustCsgJsonQuote(itemId), ",\"decision\":\"denied\"}")
        let op = RustCsgAppServerTurnEventFileChangeApprovalCoreOpFromResponse(clientFrame, itemId, outError)
        if outError != "":
            outError = ""
            return RustCsgAppServerTurnEventFileChangeApprovalCoreOpFromResponse("{\"id\":0,\"result\":{\"decision\":\"decline\"}}", itemId, outError)
        return op
    outError = wire.RustCsgCat("unsupported approval pending kind: ", kind)
    return ""

fn RustCsgAppServerTurnEventApprovalCoreSubmitRequiredError(coreOpsRaw: str,
                                                            generatedCoreOpCount: int32): str =
    if generatedCoreOpCount <= 0:
        return ""
    return wire.RustCsgCat3("approval core submit requires same-process CodexThread.submit(Op::ExecApproval/PatchApproval); generated core op count=",
                            strings.IntToStr(generatedCoreOpCount),
                            wire.RustCsgCat("; generated core ops=", coreOpsRaw))

fn turnEventJsonRpcTurnTransitionErrorResponse(requestId: int32): str =
    return wire.RustCsgCat3("{\"id\":", strings.IntToStr(requestId), ",\"error\":{\"code\":-32800,\"message\":\"turn changed\",\"data\":{\"reason\":\"turnTransition\"}}}")

fn RustCsgAppServerTurnEventCommandExecutionApprovalCompletionStatusFromClientFrame(pendingJson: str,
                                                                                   clientFrame: str,
                                                                                   outResolved: var bool,
                                                                                   outError: var str): str =
    outResolved = false
    outError = ""
    let requestId = wire.RustCsgJsonFindInt32(pendingJson, "requestId")
    var idError: str
    let responseId = turnEventJsonRpcFrameId(clientFrame, idError)
    if idError != "":
        outError = idError
        return ""
    if responseId != requestId:
        return ""
    outResolved = true
    if turnEventJsonRpcResponseTransportDrop(clientFrame):
        return "failed"
    if wire.RustCsgJsonFindOptionalObject(clientFrame, "error") != "":
        if wire.RustCsgContains(clientFrame, "turnTransition"):
            return ""
        return "failed"
    let resultJson = wire.RustCsgJsonFindOptionalObject(clientFrame, "result")
    if resultJson == "":
        return "failed"
    let decisionRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "decision")
    if decisionRaw == "":
        return "declined"
    if decisionRaw[0] == '"':
        let decision = wire.RustCsgJsonFindStr(resultJson, "decision")
        if decision == "accept" || decision == "acceptForSession":
            return ""
        if decision == "decline":
            return "declined"
        if decision == "cancel":
            return "failed"
        return "declined"
    var payload: str
    var kindError: str
    let kind = RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse(clientFrame, payload, kindError)
    if kindError != "":
        return "declined"
    if kind == "approved_execpolicy_amendment" || kind == "network_policy_amendment":
        return ""
    return "declined"

fn RustCsgAppServerTurnEventApprovalPendingCompletionNotificationFromClientFrame(threadId: str,
                                                                                pendingJson: str,
                                                                                clientFrame: str,
                                                                                completedAtMs: int64,
                                                                                outResolved: var bool,
                                                                                outError: var str): str =
    outResolved = false
    outError = ""
    let kind = wire.RustCsgJsonFindOptionalStr(pendingJson, "kind")
    if kind != "commandExecution":
        return ""
    let status = RustCsgAppServerTurnEventCommandExecutionApprovalCompletionStatusFromClientFrame(pendingJson, clientFrame, outResolved, outError)
    if outError != "" || !outResolved || status == "":
        return ""
    let command = wire.RustCsgJsonFindOptionalStr(pendingJson, "command")
    if command == "":
        return ""
    let itemId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
    let turnId = wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId")
    let cwd = wire.RustCsgJsonFindOptionalStr(pendingJson, "cwd")
    var commandActionsRaw = wire.RustCsgJsonFindOptionalArray(pendingJson, "commandActions")
    if commandActionsRaw == "":
        commandActionsRaw = "[]"
    var item = "{"
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("type", "commandExecution"))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("id", itemId))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("command", command))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("cwd", cwd))
    item = wire.RustCsgCat(item, ",\"processId\":null,\"source\":\"agent\",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldStr("status", status))
    item = wire.RustCsgCat(item, ",")
    item = wire.RustCsgCat(item, wire.RustCsgJsonFieldRaw("commandActions", commandActionsRaw))
    item = wire.RustCsgCat(item, ",\"aggregatedOutput\":null,\"exitCode\":null,\"durationMs\":null}")
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldRaw("item", item))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("turnId", turnId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldInt64("completedAtMs", completedAtMs))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3("{\"method\":\"item/completed\",\"params\":", params, "}")

fn turnEventApprovalPendingDeniedCoreOp(pendingJson: str,
                                        outError: var str): str =
    outError = ""
    let kind = wire.RustCsgJsonFindOptionalStr(pendingJson, "kind")
    if kind == "commandExecution":
        var opId = wire.RustCsgJsonFindOptionalStr(pendingJson, "approvalId")
        if opId == "":
            opId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
        let turnId = wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId")
        if opId == "":
            outError = "command execution approval core op missing approval id"
            return ""
        if turnId == "":
            outError = "command execution approval core op missing turn id"
            return ""
        return wire.RustCsgCat3(wire.RustCsgCat3("{\"type\":\"exec_approval\",\"id\":", wire.RustCsgJsonQuote(opId), ",\"turn_id\":"), wire.RustCsgJsonQuote(turnId), ",\"decision\":\"denied\"}")
    if kind == "fileChange":
        let itemId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
        if itemId == "":
            outError = "file change approval core op missing item id"
            return ""
        return wire.RustCsgCat3("{\"type\":\"patch_approval\",\"id\":", wire.RustCsgJsonQuote(itemId), ",\"decision\":\"denied\"}")
    outError = wire.RustCsgCat("unsupported approval pending kind: ", kind)
    return ""

fn RustCsgAppServerTurnEventApprovalPendingLiveReceiverErrorFrame(pendingJson: str,
                                                                  message: str): str =
    let requestId = wire.RustCsgJsonFindInt32(pendingJson, "requestId")
    return wire.RustCsgCat3(wire.RustCsgCat3("{\"id\":", strings.IntToStr(requestId), ",\"error\":{\"code\":-1,\"message\":"), wire.RustCsgJsonQuote(message), ",\"data\":{\"reason\":\"receiverError\"}}}")

fn RustCsgAppServerTurnEventApprovalPendingLiveClientFrame(threadId: str,
                                                           pendingJson: str,
                                                           clientFrame: str,
                                                           completedAtMs: int64,
                                                           outResolved: var bool,
                                                           outCoreOp: var str,
                                                           outError: var str): str =
    outResolved = false
    outCoreOp = ""
    outError = ""
    let requestId = wire.RustCsgJsonFindInt32(pendingJson, "requestId")
    var idError: str
    let responseId = turnEventJsonRpcFrameId(clientFrame, idError)
    if idError != "":
        outError = idError
        return ""
    if responseId != requestId:
        outError = "approval client response id mismatch: expected "
        outError = wire.RustCsgCat(outError, strings.IntToStr(requestId))
        outError = wire.RustCsgCat(outError, " got ")
        outError = wire.RustCsgCat(outError, strings.IntToStr(responseId))
        return ""
    var effectiveFrame = clientFrame
    if turnEventJsonRpcResponseTransportDrop(clientFrame):
        effectiveFrame = RustCsgAppServerTurnEventApprovalPendingLiveReceiverErrorFrame(pendingJson, "approval transport dropped")
        var deniedError: str
        outCoreOp = turnEventApprovalPendingDeniedCoreOp(pendingJson, deniedError)
        if deniedError != "":
            outError = deniedError
            return ""
        outResolved = true
    else:
        var resolved: bool
        var opError: str
        outCoreOp = RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pendingJson, clientFrame, resolved, opError)
        if opError != "":
            outError = opError
            return ""
        outResolved = resolved
    var notificationResolved: bool
    var notificationError: str
    let notification = RustCsgAppServerTurnEventApprovalPendingCompletionNotificationFromClientFrame(threadId,
                                                                                                    pendingJson,
                                                                                                    effectiveFrame,
                                                                                                    completedAtMs,
                                                                                                    notificationResolved,
                                                                                                    notificationError)
    if notificationError != "":
        outError = notificationError
        return ""
    return notification

fn RustCsgAppServerTurnEventApprovalStartedCommandExecutionSetAppend(startedCommandExecutionItemIdsRaw: str,
                                                                     itemId: str): str =
    if itemId == "":
        return startedCommandExecutionItemIdsRaw
    if startedCommandExecutionItemIdsRaw == "":
        return wire.RustCsgCat3("|", itemId, "|")
    if wire.RustCsgContains(startedCommandExecutionItemIdsRaw, wire.RustCsgCat3("|", itemId, "|")):
        return startedCommandExecutionItemIdsRaw
    return wire.RustCsgCat3(startedCommandExecutionItemIdsRaw, itemId, "|")

fn RustCsgAppServerTurnEventApprovalShouldSuppressCompletion(pendingApprovalRaw: str,
                                                             startedCommandExecutionItemIdsRaw: str): bool =
    if wire.RustCsgJsonFindOptionalStr(pendingApprovalRaw, "kind") != "commandExecution":
        return false
    if wire.RustCsgJsonFindOptionalStr(pendingApprovalRaw, "approvalId") == "":
        return false
    let itemId = wire.RustCsgJsonFindOptionalStr(pendingApprovalRaw, "itemId")
    if itemId == "":
        return false
    return wire.RustCsgContains(startedCommandExecutionItemIdsRaw, wire.RustCsgCat3("|", itemId, "|"))

fn RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrameWithStartedSet(threadId: str,
                                                                            pendingApprovalRaw: str,
                                                                            clientFrame: str,
                                                                            completedAtMs: int64,
                                                                            startedCommandExecutionItemIdsRaw: str,
                                                                            outNextPendingApprovalRaw: var str,
                                                                            outCoreOp: var str,
                                                                            outHandled: var bool,
                                                                            outResolved: var bool,
                                                                            outError: var str): str =
    outNextPendingApprovalRaw = pendingApprovalRaw
    outCoreOp = ""
    outHandled = false
    outResolved = false
    outError = ""
    let requestId = wire.RustCsgJsonFindInt32(pendingApprovalRaw, "requestId")
    var idError: str
    let responseId = turnEventJsonRpcFrameId(clientFrame, idError)
    if idError != "":
        outError = idError
        return ""
    if responseId != requestId:
        return ""
    outHandled = true
    var liveResolved: bool
    var liveCoreOp: str
    var liveError: str
    var notification = RustCsgAppServerTurnEventApprovalPendingLiveClientFrame(threadId,
                                                                               pendingApprovalRaw,
                                                                               clientFrame,
                                                                               completedAtMs,
                                                                               liveResolved,
                                                                               liveCoreOp,
                                                                               liveError)
    if liveError != "":
        outError = liveError
        return ""
    outResolved = liveResolved
    outCoreOp = liveCoreOp
    if liveResolved:
        outNextPendingApprovalRaw = ""
    if RustCsgAppServerTurnEventApprovalShouldSuppressCompletion(pendingApprovalRaw, startedCommandExecutionItemIdsRaw):
        notification = ""
    return notification

fn RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrame(threadId: str,
                                                              pendingApprovalRaw: str,
                                                              clientFrame: str,
                                                              completedAtMs: int64,
                                                              outNextPendingApprovalRaw: var str,
                                                              outCoreOp: var str,
                                                              outHandled: var bool,
                                                              outResolved: var bool,
                                                              outError: var str): str =
    return RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrameWithStartedSet(threadId,
                                                                                   pendingApprovalRaw,
                                                                                   clientFrame,
                                                                                   completedAtMs,
                                                                                   "",
                                                                                   outNextPendingApprovalRaw,
                                                                                   outCoreOp,
                                                                                   outHandled,
                                                                                   outResolved,
                                                                                   outError)

fn turnEventApprovalClientResponseTimedOutError(): str =
    return "approval client response timed out"

fn turnEventPendingApprovalStreamCompletedError(): str =
    return "responses stream completed with pending approval request"

fn turnEventStartApprovalRequestTarget(fd: int32,
                                       requestFds: int32[],
                                       targetKind: int32,
                                       requestJson: str,
                                       outError: var str): bool =
    outError = ""
    if !turnEventWriteServerRequestTarget(fd, requestFds, targetKind, requestJson):
        outError = "failed to write command execution approval request"
        return false
    return true

fn turnEventResolvePendingApprovalTurnTransitionTarget(threadId: str,
                                                       pendingApprovalRaw: str,
                                                       fd: int32,
                                                       notificationFds: int32[],
                                                       targetKind: int32,
                                                       outError: var str): bool =
    outError = ""
    let requestId = wire.RustCsgJsonFindInt32(pendingApprovalRaw, "requestId")
    if !turnEventWriteTarget(fd, notificationFds, targetKind, RustCsgAppServerTurnEventServerRequestResolvedNotification(threadId, requestId)):
        outError = "failed to write serverRequest/resolved"
        return false
    return true

fn turnEventTryResolveLiveApprovalClientFrameTarget(threadId: str,
                                                    pendingApprovalRaw: str,
                                                    clientFrame: str,
                                                    completedAtMs: int64,
                                                    fd: int32,
                                                    notificationFds: int32[],
                                                    targetKind: int32,
                                                    startedCommandExecutionItemIdsRaw: str,
                                                    outNextPendingApprovalRaw: var str,
                                                    outCoreOp: var str,
                                                    outHandled: var bool,
                                                    outResolved: var bool,
                                                    outError: var str): bool =
    var stateError: str
    let notification = RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrameWithStartedSet(threadId,
                                                                                                pendingApprovalRaw,
                                                                                                clientFrame,
                                                                                                completedAtMs,
                                                                                                startedCommandExecutionItemIdsRaw,
                                                                                                outNextPendingApprovalRaw,
                                                                                                outCoreOp,
                                                                                                outHandled,
                                                                                                outResolved,
                                                                                                stateError)
    if stateError != "":
        outError = stateError
        return false
    if !outHandled:
        outError = ""
        return true
    if outCoreOp != "":
        var submitError: str
        if !core_runtime.RustCsgCoreThreadSubmitApprovalOp(threadId, outCoreOp, submitError):
            outError = submitError
            return false
        if !core_runtime.RustCsgCoreThreadDispatchAllSubmissions(submitError):
            outError = submitError
            return false
    if notification != "":
        if !turnEventWriteTarget(fd, notificationFds, targetKind, notification):
            outError = "failed to write item/completed approval notification"
            return false
    if outResolved:
        return turnEventResolvePendingApprovalTurnTransitionTarget(threadId,
                                                                  pendingApprovalRaw,
                                                                  fd,
                                                                  notificationFds,
                                                                  targetKind,
                                                                  outError)
    outError = ""
    return true

fn RustCsgAppServerTurnEventApprovalClientFrameFromResolveParams(requestId: int32,
                                                                 paramsJson: str,
                                                                 outError: var str): str =
    outError = ""
    if requestId < 0:
        outError = "serverRequest/resolve requires non-negative requestId"
        return ""
    var out = wire.RustCsgCat3("{\"id\":", strings.IntToStr(requestId), ",")
    let resultRaw = wire.RustCsgJsonFindOptionalObject(paramsJson, "result")
    if resultRaw != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", resultRaw))
        out = wire.RustCsgCat(out, "}")
        return out
    let errorRaw = wire.RustCsgJsonFindOptionalObject(paramsJson, "error")
    if errorRaw != "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", errorRaw))
        out = wire.RustCsgCat(out, "}")
        return out
    outError = "serverRequest/resolve requires result or error"
    return ""

fn RustCsgAppServerTurnEventPendingApprovalFromResolveParams(paramsJson: str,
                                                            outError: var str): str =
    outError = ""
    let kind = wire.RustCsgJsonFindOptionalStr(paramsJson, "kind")
    if !turnEventHasField(paramsJson, "requestId"):
        outError = "serverRequest/resolve requires requestId"
        return ""
    let requestId = wire.RustCsgJsonFindInt32(paramsJson, "requestId")
    if kind == "commandExecution":
        let itemId = wire.RustCsgJsonFindOptionalStr(paramsJson, "itemId")
        if itemId == "":
            outError = "serverRequest/resolve commandExecution requires itemId"
            return ""
        let turnId = wire.RustCsgJsonFindOptionalStr(paramsJson, "turnId")
        if turnId == "":
            outError = "serverRequest/resolve commandExecution requires turnId"
            return ""
        return RustCsgAppServerTurnEventPendingCommandExecutionApproval(requestId,
                                                                        wire.RustCsgJsonFindOptionalStr(paramsJson, "approvalId"),
                                                                        itemId,
                                                                        turnId)
    if kind == "fileChange":
        let itemId = wire.RustCsgJsonFindOptionalStr(paramsJson, "itemId")
        if itemId == "":
            outError = "serverRequest/resolve fileChange requires itemId"
            return ""
        return RustCsgAppServerTurnEventPendingFileChangeApproval(requestId, itemId)
    outError = wire.RustCsgCat("serverRequest/resolve unsupported approval kind: ", kind)
    return ""

fn RustCsgAppServerTurnEventSubmitServerRequestApprovalResponse(paramsJson: str,
                                                               outCoreOp: var str,
                                                               outResolved: var bool,
                                                               outError: var str): bool =
    outCoreOp = ""
    outResolved = false
    outError = ""
    let threadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    if threadId == "":
        outError = "serverRequest/resolve requires threadId"
        return false
    if !turnEventHasField(paramsJson, "requestId"):
        outError = "serverRequest/resolve requires requestId"
        return false
    let requestId = wire.RustCsgJsonFindInt32(paramsJson, "requestId")
    var pendingError: str
    let pending = RustCsgAppServerTurnEventPendingApprovalFromResolveParams(paramsJson, pendingError)
    if pendingError != "":
        outError = pendingError
        return false
    var frameError: str
    let clientFrame = RustCsgAppServerTurnEventApprovalClientFrameFromResolveParams(requestId, paramsJson, frameError)
    if frameError != "":
        outError = frameError
        return false
    var opError: str
    let coreOp = RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pending, clientFrame, outResolved, opError)
    if opError != "":
        outError = opError
        return false
    outCoreOp = coreOp
    if outResolved && coreOp != "":
        var submitError: str
        if !core_runtime.RustCsgCoreThreadSubmitApprovalOp(threadId, coreOp, submitError):
            outError = submitError
            return false
        if !core_runtime.RustCsgCoreThreadDispatchAllSubmissions(submitError):
            outError = submitError
            return false
    return true

fn RustCsgAppServerTurnEventRegisterPendingApprovalCoreWaiter(threadId: str,
                                                              pendingJson: str,
                                                              outError: var str): bool =
    outError = ""
    let kind = wire.RustCsgJsonFindOptionalStr(pendingJson, "kind")
    if kind == "commandExecution":
        var approvalId = wire.RustCsgJsonFindOptionalStr(pendingJson, "approvalId")
        if approvalId == "":
            approvalId = wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId")
        let turnId = wire.RustCsgJsonFindOptionalStr(pendingJson, "turnId")
        if turnId == "":
            outError = "command execution approval pending state missing turn id"
            return false
        return core_runtime.RustCsgCoreThreadRegisterPendingApproval(threadId, "exec_approval", approvalId, turnId, outError)
    if kind == "fileChange":
        return core_runtime.RustCsgCoreThreadRegisterPendingApproval(threadId, "patch_approval", wire.RustCsgJsonFindOptionalStr(pendingJson, "itemId"), "", outError)
    outError = wire.RustCsgCat("unsupported approval pending kind: ", kind)
    return false

fn turnEventHandleCommandExecutionApprovalRequestTarget(threadId: str,
                                                        data: str,
                                                        fd: int32,
                                                        notificationFds: int32[],
                                                        requestFds: int32[],
                                                        targetKind: int32,
                                                        requestIdCounter: var int32,
                                                        stdioBuffer: var str,
                                                        outError: var str): bool =
    outError = ""
    let itemJson = turnEventResponseItemJson(data)
    if itemJson == "":
        outError = wire.RustCsgCat("exec approval request missing item: ", turnEventPreview(data))
        return false
    var requestId: int32 = requestIdCounter
    var requestError: str
    let request = RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(requestId, threadId, itemJson, requestError)
    if requestError != "":
        outError = requestError
        return false
    var pendingError: str
    let pending = RustCsgAppServerTurnEventPendingCommandExecutionApprovalFromCoreEvent(requestId, itemJson, pendingError)
    if pendingError != "":
        outError = pendingError
        return false
    if !RustCsgAppServerTurnEventRegisterPendingApprovalCoreWaiter(threadId, pending, outError):
        return false
    requestIdCounter = requestIdCounter + 1
    if !turnEventWriteServerRequestTarget(fd, requestFds, targetKind, request):
        outError = "failed to write command execution approval request"
        return false
    var responseJson: str
    var responseError: str
    if !turnEventReadServerResponseTarget(requestFds, targetKind, requestId, stdioBuffer, responseJson, responseError):
        outError = responseError
        return false
    var resolved: bool
    var opError: str
    let coreOp = RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pending, responseJson, resolved, opError)
    if opError != "":
        outError = opError
        return false
    if resolved && coreOp != "":
        var submitError: str
        if !core_runtime.RustCsgCoreThreadSubmitApprovalOp(threadId, coreOp, submitError):
            outError = submitError
            return false
        if !core_runtime.RustCsgCoreThreadDispatchAllSubmissions(submitError):
            outError = submitError
            return false
    if resolved:
        if !turnEventWriteTarget(fd, notificationFds, targetKind, RustCsgAppServerTurnEventServerRequestResolvedNotification(threadId, requestId)):
            outError = "failed to write serverRequest/resolved"
            return false
    return true

