        outError = responseError
        return false
    var resolved: bool
    var opError: str
    let coreOp = RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pending, responseJson, resolved, opError)
    if opError != "":
        outError = opError
        return false
    if resolved && coreOp != "":
        var submitError: str
        if !core_runtime.RustCsgCoreThreadSubmitApprovalOp(threadId, coreOp, submitError):
            outError = submitError
            return false
        if !core_runtime.RustCsgCoreThreadDispatchAllSubmissions(submitError):
            outError = submitError
            return false
    if resolved:
        if !turnEventWriteTarget(fd, notificationFds, targetKind, RustCsgAppServerTurnEventServerRequestResolvedNotification(threadId, requestId)):
            outError = "failed to write serverRequest/resolved"
            return false
    return true

fn turnEventReadArrayObject(arrayJson: str, pos: var int32, outObject: var str, outError: var str): bool =
    outObject = ""
    outError = ""
    var p: int32 = turnEventSkipJsonSpace(arrayJson, pos)
    if pos == 0:
        if p >= arrayJson.len || arrayJson[p] != '[':
            outError = "json array must start with ["
            return false
        p = turnEventSkipJsonSpace(arrayJson, p + 1)
    if p < arrayJson.len && arrayJson[p] == ',':
        p = turnEventSkipJsonSpace(arrayJson, p + 1)
    if p < arrayJson.len && arrayJson[p] == ']':
        pos = p + 1
        return false
    if p >= arrayJson.len || arrayJson[p] != '{':
        outError = wire.RustCsgCat("json array item is not object: ", turnEventPreview(arrayJson))
        return false
    var depth: int32 = 0
    var inString: bool = false
    var escaped: bool = false
    var i: int32 = p
    while i < arrayJson.len:
        let ch = arrayJson[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                outObject = strings.SliceBytes(arrayJson, p, i - p + 1)
                pos = i + 1
                return true
        i = i + 1
    outError = "unterminated json object in array"
    return false

fn turnEventJsonArrayItemsRaw(arrayJson: str, outError: var str): str =
    outError = ""
    if arrayJson == "":
        return ""
    var pos: int32
    var out: str
    var count: int32
    while true:
        var entryJson: str
        var readError: str
        if !turnEventReadArrayObject(arrayJson, pos, entryJson, readError):
            if readError != "":
                outError = readError
                return ""
            break
        if count > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, entryJson)
        count = count + 1
    return out

