    var pos = turnEventSkipJsonSpace(arrayRaw, p + 1)
    while pos < arrayRaw.len:
        if arrayRaw[pos] == ']':
            out = wire.RustCsgCat(out, "]")
            return out
        if arrayRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(arrayRaw, pos + 1)
            continue
        let valueEnd = turnEventJsonValueEnd(arrayRaw, pos)
        if valueEnd < pos:
            return "[]"
        let childRaw = strings.SliceBytes(arrayRaw, pos, valueEnd - pos)
        let child = turnEventDynamicToolSchemaStripDescriptionsRaw(childRaw)
        turnEventDynamicToolSchemaAppendField(out, first, child)
        pos = turnEventSkipJsonSpace(arrayRaw, valueEnd)
    return "[]"

fn turnEventDynamicToolSchemaStripDescriptionsMapValues(objectRaw: str): str =
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        let child = turnEventDynamicToolSchemaStripDescriptionsRaw(valueRaw)
        let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", child)
        turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaStripDescriptionsObject(objectRaw: str): str =
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        if key != "description":
            var valueOut = valueRaw
            if key == "properties" || key == "$defs" || key == "definitions":
                valueOut = turnEventDynamicToolSchemaStripDescriptionsMapValues(valueRaw)
            elif key == "items" || key == "additionalProperties":
                let childPos = turnEventSkipJsonSpace(valueRaw, 0)
                if childPos < valueRaw.len && (valueRaw[childPos] == '{' || valueRaw[childPos] == '['):
                    valueOut = turnEventDynamicToolSchemaStripDescriptionsRaw(valueRaw)
            elif key == "anyOf":
                valueOut = turnEventDynamicToolSchemaStripDescriptionsArray(valueRaw)
            let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", valueOut)
            turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaStripDescriptionsRaw(schemaRaw: str): str =
    let p = turnEventSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len:
        return "{}"
    if schemaRaw[p] == '{':
        return turnEventDynamicToolSchemaStripDescriptionsObject(schemaRaw)
    if schemaRaw[p] == '[':
        return turnEventDynamicToolSchemaStripDescriptionsArray(schemaRaw)
    return schemaRaw

fn turnEventDynamicToolSchemaDropDefinitionsArray(arrayRaw: str): str =
    let p = turnEventSkipJsonSpace(arrayRaw, 0)
    if p >= arrayRaw.len || arrayRaw[p] != '[':
        return "[]"
    var out = "["
    var first = true
    var pos = turnEventSkipJsonSpace(arrayRaw, p + 1)
    while pos < arrayRaw.len:
        if arrayRaw[pos] == ']':
            out = wire.RustCsgCat(out, "]")
            return out
        if arrayRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(arrayRaw, pos + 1)
            continue
        let valueEnd = turnEventJsonValueEnd(arrayRaw, pos)
        if valueEnd < pos:
            return "[]"
        let childRaw = strings.SliceBytes(arrayRaw, pos, valueEnd - pos)
        let child = turnEventDynamicToolSchemaDropDefinitionsRaw(childRaw)
        turnEventDynamicToolSchemaAppendField(out, first, child)
        pos = turnEventSkipJsonSpace(arrayRaw, valueEnd)
    return "[]"

fn turnEventDynamicToolSchemaDropDefinitionsMapValues(objectRaw: str): str =
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        let child = turnEventDynamicToolSchemaDropDefinitionsRaw(valueRaw)
        let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", child)
        turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaDropDefinitionsObject(objectRaw: str): str =
    let schemaRefRaw = turnEventJsonTopLevelValueRaw(objectRaw, "$ref")
    if schemaRefRaw != "" && turnEventDynamicToolSchemaIsLocalDefinitionRef(schemaRefRaw):
        return "{}"
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        if key != "$defs" && key != "definitions":
            var valueOut = valueRaw
            if key == "properties":
                valueOut = turnEventDynamicToolSchemaDropDefinitionsMapValues(valueRaw)
            elif key == "items" || key == "additionalProperties":
                let childPos = turnEventSkipJsonSpace(valueRaw, 0)
                if childPos < valueRaw.len && (valueRaw[childPos] == '{' || valueRaw[childPos] == '['):
                    valueOut = turnEventDynamicToolSchemaDropDefinitionsRaw(valueRaw)
            elif key == "anyOf":
                valueOut = turnEventDynamicToolSchemaDropDefinitionsArray(valueRaw)
            let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", valueOut)
            turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaDropDefinitionsRaw(schemaRaw: str): str =
    let p = turnEventSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len:
        return "{}"
    if schemaRaw[p] == '{':
        return turnEventDynamicToolSchemaDropDefinitionsObject(schemaRaw)
    if schemaRaw[p] == '[':
        return turnEventDynamicToolSchemaDropDefinitionsArray(schemaRaw)
    return schemaRaw

fn turnEventDynamicToolSchemaObjectIsComplex(objectRaw: str): bool =
    if turnEventJsonTopLevelValueRaw(objectRaw, "properties") != "":
        return true
    if turnEventJsonTopLevelValueRaw(objectRaw, "additionalProperties") != "":
        return true
    if turnEventJsonTopLevelValueRaw(objectRaw, "items") != "":
        return true
    if turnEventJsonTopLevelValueRaw(objectRaw, "anyOf") != "":
        return true
    if turnEventJsonTopLevelValueRaw(objectRaw, "$ref") != "":
        return true
    return false

fn turnEventDynamicToolSchemaCollapseDeepArray(arrayRaw: str, depth: int32): str =
    let p = turnEventSkipJsonSpace(arrayRaw, 0)
    if p >= arrayRaw.len || arrayRaw[p] != '[':
        return "[]"
    var out = "["
    var first = true
    var pos = turnEventSkipJsonSpace(arrayRaw, p + 1)
    while pos < arrayRaw.len:
        if arrayRaw[pos] == ']':
            out = wire.RustCsgCat(out, "]")
            return out
        if arrayRaw[pos] == ',':
            pos = turnEventSkipJsonSpace(arrayRaw, pos + 1)
            continue
        let valueEnd = turnEventJsonValueEnd(arrayRaw, pos)
        if valueEnd < pos:
            return "[]"
        let childRaw = strings.SliceBytes(arrayRaw, pos, valueEnd - pos)
        let child = turnEventDynamicToolSchemaCollapseDeepRaw(childRaw, depth)
        turnEventDynamicToolSchemaAppendField(out, first, child)
        pos = turnEventSkipJsonSpace(arrayRaw, valueEnd)
    return "[]"

fn turnEventDynamicToolSchemaCollapseDeepMapValues(objectRaw: str, depth: int32): str =
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        let child = turnEventDynamicToolSchemaCollapseDeepRaw(valueRaw, depth)
        let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", child)
        turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaCollapseDeepObject(objectRaw: str, depth: int32): str =
    if depth >= 2 && turnEventDynamicToolSchemaObjectIsComplex(objectRaw):
        return "{}"
    let p = turnEventSkipJsonSpace(objectRaw, 0)
    if p >= objectRaw.len || objectRaw[p] != '{':
        return "{}"
    var out = "{"
    var first = true
    var pos: int32
    while true:
        var key: str
        var valueRaw: str
        if !turnEventDynamicToolSchemaReadObjectEntry(objectRaw, pos, key, valueRaw):
            break
        var valueOut = valueRaw
        if key == "properties":
            valueOut = turnEventDynamicToolSchemaCollapseDeepMapValues(valueRaw, depth + 1)
        elif key == "items" || key == "additionalProperties":
            let childPos = turnEventSkipJsonSpace(valueRaw, 0)
            if childPos < valueRaw.len && (valueRaw[childPos] == '{' || valueRaw[childPos] == '['):
                valueOut = turnEventDynamicToolSchemaCollapseDeepRaw(valueRaw, depth + 1)
        elif key == "anyOf":
            valueOut = turnEventDynamicToolSchemaCollapseDeepArray(valueRaw, depth + 1)
        let field = wire.RustCsgCat3(wire.RustCsgJsonQuote(key), ":", valueOut)
        turnEventDynamicToolSchemaAppendField(out, first, field)
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventDynamicToolSchemaCollapseDeepRaw(schemaRaw: str, depth: int32): str =
    let p = turnEventSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len:
        return "{}"
    if schemaRaw[p] == '{':
        return turnEventDynamicToolSchemaCollapseDeepObject(schemaRaw, depth)
    if schemaRaw[p] == '[':
        return turnEventDynamicToolSchemaCollapseDeepArray(schemaRaw, depth)
    return schemaRaw

fn turnEventDynamicToolSchemaCompactLarge(schemaRaw: str): str =
    if schemaRaw.len <= 4000:
        return schemaRaw
    var out = turnEventDynamicToolSchemaStripDescriptionsRaw(schemaRaw)
    if out.len <= 4000:
        return out
    out = turnEventDynamicToolSchemaDropDefinitionsRaw(out)
    if out.len <= 4000:
        return out
    return turnEventDynamicToolSchemaCollapseDeepRaw(out, 0)

fn turnEventDynamicToolSchemaSanitizeRaw(schemaRaw: str): str =
    let p = turnEventSkipJsonSpace(schemaRaw, 0)
    if p >= schemaRaw.len:
        return "{}"
    if turnEventMatchesAt(schemaRaw, p, "true") || turnEventMatchesAt(schemaRaw, p, "false"):
        return "{\"type\":\"string\"}"
    if schemaRaw[p] == '{':
        return turnEventDynamicToolSchemaSanitizeObject(schemaRaw)
    return schemaRaw

fn turnEventResponsesFunctionToolFromDynamicTool(toolJson: str, outError: var str): str =
    outError = ""
    let name = wire.RustCsgJsonFindOptionalStr(toolJson, "name")
    if name == "":
        outError = wire.RustCsgCat("dynamic tool spec missing name: ", turnEventPreview(toolJson))
        return ""
    var parametersRaw = wire.RustCsgJsonFindOptionalValueRaw(toolJson, "inputSchema")
    if parametersRaw == "":
        outError = wire.RustCsgCat("dynamic tool spec missing inputSchema: ", turnEventPreview(toolJson))
        return ""
    let p = turnEventSkipJsonSpace(parametersRaw, 0)
    if p >= parametersRaw.len || (parametersRaw[p] != '{' && !turnEventMatchesAt(parametersRaw, p, "true") && !turnEventMatchesAt(parametersRaw, p, "false")):
        outError = wire.RustCsgCat("dynamic tool inputSchema is not supported: ", turnEventPreview(toolJson))
        return ""
    parametersRaw = turnEventDynamicToolSchemaSanitizeRaw(parametersRaw)
    parametersRaw = turnEventDynamicToolSchemaCompactLarge(parametersRaw)
    let description = wire.RustCsgJsonFindOptionalStr(toolJson, "description")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "function"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("parameters", parametersRaw))
    out = wire.RustCsgCat(out, ",\"strict\":false")
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventNamespaceIndex(names: str[], namespace: str): int32 =
    var i: int32
    while i < names.len:
        if names[i] == namespace:
            return i
        i = i + 1
    return -1

fn turnEventResponsesNamespaceToolRaw(namespace: str, toolsRaw: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "namespace"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", namespace))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", wire.RustCsgCat3("Tools in the ", namespace, " namespace.")))
    out = wire.RustCsgCat(out, ",\"tools\":[")
    out = wire.RustCsgCat(out, toolsRaw)
    out = wire.RustCsgCat(out, "]}")
    return out

fn turnEventResponsesToolsRaw(dynamicToolsJson: str, outError: var str): str =
    outError = ""
    if dynamicToolsJson == "":
        return "[]"
    let p = turnEventSkipJsonSpace(dynamicToolsJson, 0)
    if p >= dynamicToolsJson.len:
        return "[]"
    if dynamicToolsJson[p] != '[':
        outError = wire.RustCsgCat("dynamicTools must be json array: ", turnEventPreview(dynamicToolsJson))
        return ""
    var pos: int32 = 0
    var entryKinds: str[]
    var entryValues: str[]
    var namespaceNames: str[]
    var namespaceToolsRaw: str[]
    while true:
        var toolJson: str
        var parseError: str
        if !turnEventReadArrayObject(dynamicToolsJson, pos, toolJson, parseError):
            if parseError != "":
                outError = parseError
                return ""
            break
        if turnEventDynamicToolDeferred(toolJson):
            continue
        var toolError: str
        let toolRaw = turnEventResponsesFunctionToolFromDynamicTool(toolJson, toolError)
        if toolError != "":
            outError = toolError
            return ""
        let namespace = wire.RustCsgJsonFindOptionalStr(toolJson, "namespace")
        if namespace == "":
            add(entryKinds, "function")
            add(entryValues, toolRaw)
        else:
            let namespaceIndex = turnEventNamespaceIndex(namespaceNames, namespace)
            if namespaceIndex < 0:
                add(namespaceNames, namespace)
                add(namespaceToolsRaw, toolRaw)
                add(entryKinds, "namespace")
                add(entryValues, namespace)
            else:
                namespaceToolsRaw[namespaceIndex] = wire.RustCsgCat3(namespaceToolsRaw[namespaceIndex], ",", toolRaw)
    var out = "["
    var i: int32
    while i < entryKinds.len:
        if i > 0:
            out = wire.RustCsgCat(out, ",")
        if entryKinds[i] == "namespace":
            let namespaceIndex = turnEventNamespaceIndex(namespaceNames, entryValues[i])
            if namespaceIndex < 0:
                outError = wire.RustCsgCat("dynamic tool namespace lost while building tools: ", entryValues[i])
                return ""
            out = wire.RustCsgCat(out, turnEventResponsesNamespaceToolRaw(entryValues[i], namespaceToolsRaw[namespaceIndex]))
        else:
            out = wire.RustCsgCat(out, entryValues[i])
        i = i + 1
    out = wire.RustCsgCat(out, "]")
    return out

fn turnEventResponsesUserTextInputItemRaw(inputText: str): str =
    return turnEventResponsesTextInputItemRaw("user", inputText)

fn turnEventResponsesTextInputItemRaw(role: str, inputText: str): str =
    var out = "{\"type\":\"message\",\"role\":"
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(role))
    out = wire.RustCsgCat(out, ",\"content\":[{\"type\":\"input_text\",\"text\":")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(inputText))
    out = wire.RustCsgCat(out, "}]}")
    return out

fn turnEventAppendInputItemRaw(itemsRaw: str, itemRaw: str): str =
    if itemRaw == "":
        return itemsRaw
    if itemsRaw == "":
        return itemRaw
    return wire.RustCsgCat3(itemsRaw, ",", itemRaw)

fn turnEventStrLess(left: str, right: str): bool =
    var i: int32
    while i < left.len && i < right.len:
        if left[i] < right[i]:
            return true
        if left[i] > right[i]:
            return false
        i = i + 1
    return left.len < right.len

fn turnEventAdditionalContextEntryIndex(threadId: str, key: str): int32 =
    var i: int32
    while i < TurnEventAdditionalContextThreadIds.len && i < TurnEventAdditionalContextKeys.len:
        if TurnEventAdditionalContextThreadIds[i] == threadId && TurnEventAdditionalContextKeys[i] == key:
            return i
        i = i + 1
    return -1

fn turnEventAdditionalContextEntryUnchanged(threadId: str, key: str, value: str, kind: str): bool =
    let index = turnEventAdditionalContextEntryIndex(threadId, key)
    if index < 0:
        return false
    if index >= TurnEventAdditionalContextValues.len || index >= TurnEventAdditionalContextKinds.len:
        return false
    return TurnEventAdditionalContextValues[index] == value && TurnEventAdditionalContextKinds[index] == kind

fn turnEventClearAdditionalContextThread(threadId: str) =
    var nextThreadIds: str[]
    var nextKeys: str[]
    var nextValues: str[]
    var nextKinds: str[]
    var i: int32
    while i < TurnEventAdditionalContextThreadIds.len && i < TurnEventAdditionalContextKeys.len && i < TurnEventAdditionalContextValues.len && i < TurnEventAdditionalContextKinds.len:
        if TurnEventAdditionalContextThreadIds[i] != threadId:
            add(nextThreadIds, TurnEventAdditionalContextThreadIds[i])
            add(nextKeys, TurnEventAdditionalContextKeys[i])
            add(nextValues, TurnEventAdditionalContextValues[i])
            add(nextKinds, TurnEventAdditionalContextKinds[i])
        i = i + 1
    TurnEventAdditionalContextThreadIds = nextThreadIds
    TurnEventAdditionalContextKeys = nextKeys
    TurnEventAdditionalContextValues = nextValues
    TurnEventAdditionalContextKinds = nextKinds

fn turnEventReplaceAdditionalContextThread(threadId: str, keys: str[], values: str[], kinds: str[]) =
    turnEventClearAdditionalContextThread(threadId)
    var i: int32
    while i < keys.len && i < values.len && i < kinds.len:
        add(TurnEventAdditionalContextThreadIds, threadId)
        add(TurnEventAdditionalContextKeys, keys[i])
        add(TurnEventAdditionalContextValues, values[i])
        add(TurnEventAdditionalContextKinds, kinds[i])
        i = i + 1

fn turnEventAdditionalContextInputItemRaw(key: str, value: str, kind: str, outError: var str): str =
    outError = ""
    if kind == "application":
        return turnEventResponsesTextInputItemRaw("developer", wire.RustCsgCat4("<", key, ">", wire.RustCsgCat4(value, "</", key, ">")))
    if kind == "untrusted":
        return turnEventResponsesTextInputItemRaw("user", wire.RustCsgCat4("<external_", key, ">", wire.RustCsgCat4(value, "</external_", key, ">")))
    outError = wire.RustCsgCat("additionalContext kind must be application or untrusted: ", kind)
    return ""

fn turnEventAdditionalContextInputItemsRaw(threadId: str, paramsJson: str, outError: var str): str =
    outError = ""
    let additionalContextJson = wire.RustCsgJsonFindOptionalObject(paramsJson, "additionalContext")
    var keys: str[]
    var values: str[]
    var kinds: str[]
    if additionalContextJson != "":
        var pos = turnEventSkipJsonSpaceStable(additionalContextJson, 0)
        if pos >= additionalContextJson.len || additionalContextJson[pos] != '{':
            outError = "additionalContext must be object"
            return ""
        pos = turnEventSkipJsonSpaceStable(additionalContextJson, pos + 1)
        while pos < additionalContextJson.len:
            if additionalContextJson[pos] == '}':
                break
            if additionalContextJson[pos] == ',':
                pos = turnEventSkipJsonSpaceStable(additionalContextJson, pos + 1)
            if pos >= additionalContextJson.len || additionalContextJson[pos] != '"':
                outError = wire.RustCsgCat("additionalContext key is not string: ", turnEventPreview(additionalContextJson))
                return ""
            var keyEnd: int32 = -1
            var keyScan = pos + 1
            while keyScan < additionalContextJson.len:
                if additionalContextJson[keyScan] == ':':
                    keyEnd = keyScan - 1
                    break
                keyScan = keyScan + 1
            if keyEnd < 0:
                outError = "unterminated additionalContext key"
                return ""
            let key = strings.SliceBytes(additionalContextJson, pos + 1, keyEnd - pos - 1)
            pos = turnEventSkipJsonSpaceStable(additionalContextJson, keyEnd + 1)
            if pos >= additionalContextJson.len || additionalContextJson[pos] != ':':
                outError = wire.RustCsgCat("additionalContext key missing colon: ", key)
                return ""
            pos = turnEventSkipJsonSpaceStable(additionalContextJson, pos + 1)
            let entryJson = wire.RustCsgJsonFindOptionalObject(additionalContextJson, key)
            if entryJson == "":
                outError = wire.RustCsgCat("additionalContext entry missing object: ", key)
                return ""
            var matchPos = pos
            while matchPos < additionalContextJson.len && !turnEventMatchesAt(additionalContextJson, matchPos, entryJson):
                matchPos = matchPos + 1
            if matchPos >= additionalContextJson.len:
                outError = wire.RustCsgCat("additionalContext entry raw not found: ", key)
                return ""
            pos = turnEventSkipJsonSpaceStable(additionalContextJson, matchPos + entryJson.len)
            let value = wire.RustCsgJsonFindOptionalStr(entryJson, "value")
            let kind = wire.RustCsgJsonFindOptionalStr(entryJson, "kind")
            add(keys, key)
            add(values, value)
            add(kinds, kind)
    var used: int32[]
    var i: int32
    while i < keys.len:
        add(used, 0)
        i = i + 1
    var out: str
    var processed: int32
    while processed < keys.len:
        var best: int32 = -1
        var j: int32
        while j < keys.len:
            if used[j] == 0 && (best < 0 || turnEventStrLess(keys[j], keys[best])):
                best = j
            j = j + 1
        if best < 0:
            break
        used[best] = 1
        if !turnEventAdditionalContextEntryUnchanged(threadId, keys[best], values[best], kinds[best]):
            var itemError: str
            let itemRaw = turnEventAdditionalContextInputItemRaw(keys[best], values[best], kinds[best], itemError)
            if itemError != "":
                outError = itemError
                return ""
            out = turnEventAppendInputItemRaw(out, itemRaw)
        processed = processed + 1
    turnEventReplaceAdditionalContextThread(threadId, keys, values, kinds)
    return out

fn turnEventInputHasItems(paramsJson: str): bool =
    let inputJson = wire.RustCsgJsonFindArray(paramsJson, "input")
    var itemError: str
    return turnEventJsonArrayItemsRaw(inputJson, itemError) != ""

fn turnEventBuildInitialInputItemsRaw(threadId: str,
                                      paramsJson: str,
                                      developerInstructions: str,
                                      historyJson: str,
                                      outError: var str): str =
    outError = ""
    var out: str
    var historyError: str
    out = turnEventAppendInputItemRaw(out, turnEventJsonArrayItemsRaw(historyJson, historyError))
    if historyError != "":
        outError = historyError
        return ""
    if developerInstructions != "":
        out = turnEventAppendInputItemRaw(out, turnEventResponsesTextInputItemRaw("developer", developerInstructions))
    var contextError: str
    out = turnEventAppendInputItemRaw(out, turnEventAdditionalContextInputItemsRaw(threadId, paramsJson, contextError))
    if contextError != "":
        outError = contextError
        return ""
    if turnEventInputHasItems(paramsJson):
        out = turnEventAppendInputItemRaw(out, turnEventResponsesUserTextInputItemRaw(turnEventInputText(paramsJson)))
    return out

fn turnEventResponsesAssistantTextInputItemRaw(text: str): str =
    var out = "{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":"
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(text))
    out = wire.RustCsgCat(out, "}]}")
    return out

fn turnEventBuildResponsesBodyFromInputRaw(model: str,
                                           threadId: str,
                                           paramsJson: str,
                                           inputItemsRaw: str,
                                           dynamicToolsJson: str,
                                           baseInstructions: str,
                                           outError: var str): str =
    outError = ""
    let routedDynamicToolsJson = cheng_native_tools.ChengNativeAppendToolsForInput(dynamicToolsJson, inputItemsRaw)
    cheng_agent_runtime.ChengAgentRuntimeNoteToolInjection(threadId, "", routedDynamicToolsJson)
    let toolsRaw = turnEventResponsesToolsRaw(routedDynamicToolsJson, outError)
    if outError != "":
        return ""
    let reasoningRaw = turnEventReasoningRaw(model, paramsJson)
    let includeRaw = turnEventIncludeRaw(reasoningRaw)
    let serviceTier = turnEventServiceTierForRequest(model, wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "serviceTier"))
    let textRaw = turnEventTextControlsRaw(model, paramsJson)
    let clientMetadataRaw = turnEventClientMetadataRaw(outError)
    if outError != "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("instructions", baseInstructions))
    out = wire.RustCsgCat(out, ",\"input\":[")
    out = wire.RustCsgCat(out, inputItemsRaw)
    out = wire.RustCsgCat(out, "],\"tools\":")
    out = wire.RustCsgCat(out, toolsRaw)
    out = wire.RustCsgCat(out, ",\"tool_choice\":\"auto\",\"parallel_tool_calls\":")
    out = wire.RustCsgCat(out, turnEventBoolRaw(turnEventModelSupportsParallelToolCalls(model)))
    out = wire.RustCsgCat(out, ",\"reasoning\":")
    out = wire.RustCsgCat(out, reasoningRaw)
    out = wire.RustCsgCat(out, ",\"store\":")
    out = wire.RustCsgCat(out, turnEventResponsesStoreRaw())
    out = wire.RustCsgCat(out, ",\"stream\":true,\"include\":")
    out = wire.RustCsgCat(out, includeRaw)
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("service_tier", serviceTier))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("prompt_cache_key", threadId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("text", textRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("client_metadata", clientMetadataRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventBuildResponsesBody(model: str,
                               threadId: str,
                               paramsJson: str,
                               inputText: str,
                               dynamicToolsJson: str,
                               baseInstructions: str,
                               outError: var str): str =
    let inputItemsRaw = turnEventResponsesUserTextInputItemRaw(inputText)
    return turnEventBuildResponsesBodyFromInputRaw(model, threadId, paramsJson, inputItemsRaw, dynamicToolsJson, baseInstructions, outError)

fn turnEventFunctionCallOutputItem(callId: str, outputItemsRaw: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "function_call_output"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("call_id", callId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("output", outputItemsRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventBuildFunctionCallOutputsBody(model: str,
                                         threadId: str,
                                         paramsJson: str,
                                         previousResponseId: str,
                                         inputItemsRaw: str,
                                         dynamicToolsJson: str,
                                         baseInstructions: str,
                                         outError: var str): str =
    outError = ""
    let routedDynamicToolsJson = cheng_native_tools.ChengNativeAppendToolsForInput(dynamicToolsJson, inputItemsRaw)
    cheng_agent_runtime.ChengAgentRuntimeNoteToolInjection(threadId, "", routedDynamicToolsJson)
    let toolsRaw = turnEventResponsesToolsRaw(routedDynamicToolsJson, outError)
    if outError != "":
        return ""
    let reasoningRaw = turnEventReasoningRaw(model, paramsJson)
    let includeRaw = turnEventIncludeRaw(reasoningRaw)
    let serviceTier = turnEventServiceTierForRequest(model, wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "serviceTier"))
    let textRaw = turnEventTextControlsRaw(model, paramsJson)
    let clientMetadataRaw = turnEventClientMetadataRaw(outError)
    if outError != "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("instructions", baseInstructions))
    out = wire.RustCsgCat(out, ",\"input\":[")
    out = wire.RustCsgCat(out, inputItemsRaw)
    out = wire.RustCsgCat(out, "],\"tools\":")
    out = wire.RustCsgCat(out, toolsRaw)
    out = wire.RustCsgCat(out, ",\"tool_choice\":\"auto\",\"parallel_tool_calls\":")
    out = wire.RustCsgCat(out, turnEventBoolRaw(turnEventModelSupportsParallelToolCalls(model)))
    out = wire.RustCsgCat(out, ",\"reasoning\":")
    out = wire.RustCsgCat(out, reasoningRaw)
    out = wire.RustCsgCat(out, ",\"store\":")
    out = wire.RustCsgCat(out, turnEventResponsesStoreRaw())
    out = wire.RustCsgCat(out, ",\"stream\":true,\"include\":")
    out = wire.RustCsgCat(out, includeRaw)
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldStr("service_tier", serviceTier))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("prompt_cache_key", threadId))
    out = wire.RustCsgCat(out, wire.RustCsgJsonOptionalFieldRaw("text", textRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("client_metadata", clientMetadataRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventBuildFunctionCallOutputBody(model: str,
                                        threadId: str,
                                        paramsJson: str,
                                        previousResponseId: str,
                                        callId: str,
                                        outputItemsRaw: str,
                                        dynamicToolsJson: str,
                                        baseInstructions: str,
                                        outError: var str): str =
    let inputItem = turnEventFunctionCallOutputItem(callId, outputItemsRaw)
    return turnEventBuildFunctionCallOutputsBody(model, threadId, paramsJson, previousResponseId, inputItem, dynamicToolsJson, baseInstructions, outError)

fn turnEventAppendHeaderRaw(headers: str, rawHeader: str): str =
    var out = headers
    if out != "[":
        out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(rawHeader))
    return out

fn turnEventAppendHeader(headers: str, name: str, value: str): str =
    return turnEventAppendHeaderRaw(headers, wire.RustCsgCat3(name, ": ", value))

fn turnEventTurnMetadataHeaderValue(threadId: str, turnId: str, threadSource: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("session_id", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", threadId))
    if threadSource != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_source", threadSource))
    if turnId != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventBuildResponsesHeadersForTurnWithThreadSource(apiKey: str, threadId: str, turnId: str, threadSource: str): str =
    var headers = "["
    headers = turnEventAppendHeader(headers, "Content-Type", "application/json")
    headers = turnEventAppendHeader(headers, "Accept", "text/event-stream")
    headers = turnEventAppendHeader(headers, "Authorization", wire.RustCsgCat("Bearer ", apiKey))
    if threadId != "":
        headers = turnEventAppendHeader(headers, "x-client-request-id", threadId)
        headers = turnEventAppendHeader(headers, "session-id", threadId)
        headers = turnEventAppendHeader(headers, "thread-id", threadId)
        headers = turnEventAppendHeader(headers, "x-codex-window-id", wire.RustCsgCat(threadId, ":0"))
        if turnId != "":
            headers = turnEventAppendHeader(headers, "x-codex-turn-metadata", turnEventTurnMetadataHeaderValue(threadId, turnId, threadSource))
    headers = wire.RustCsgCat(headers, "]")
    return headers

fn turnEventBuildResponsesHeadersForTurn(apiKey: str, threadId: str, turnId: str): str =
    return turnEventBuildResponsesHeadersForTurnWithThreadSource(apiKey, threadId, turnId, "")

fn turnEventBuildResponsesHeaders(apiKey: str): str =
    return turnEventBuildResponsesHeadersForTurn(apiKey, "", "")

fn turnEventPostResponses(model: str, threadId: str, paramsJson: str, inputText: str, dynamicToolsJson: str, baseInstructions: str, outBody: var str, outError: var str) =
    turnEventPostResponsesWithSession(model, threadId, paramsJson, dynamicToolsJson, baseInstructions, "", "", outBody, outError)

fn turnEventPostResponsesWithSession(model: str,
                                     threadId: str,
                                     paramsJson: str,
                                     dynamicToolsJson: str,
                                     baseInstructions: str,
                                     developerInstructions: str,
                                     historyJson: str,
                                     outBody: var str,
                                     outError: var str) =
    outBody = ""
    outError = ""
    let apiKey = rustCsgTurnEventGetEnv("OPENAI_API_KEY")
    if apiKey == "":
        outError = "turn/start event loop requires OPENAI_API_KEY"
        return
    let url = turnEventResponsesEndpoint()
    if url == "":
        outError = "turn/start event loop requires openai_base_url"
        return
    var buildError: str
    let inputItemsRaw = turnEventBuildInitialInputItemsRaw(threadId, paramsJson, developerInstructions, historyJson, buildError)
    if buildError != "":
        outError = buildError
        return
    let requestBody = turnEventBuildResponsesBodyFromInputRaw(model, threadId, paramsJson, inputItemsRaw, dynamicToolsJson, baseInstructions, buildError)
    if buildError != "":
        outError = buildError
        return
    let headers = turnEventBuildResponsesHeaders(apiKey)
    let raw = rustCsgTurnEventHttpPost(url, requestBody, headers)
    if raw == "":
        outError = "responses provider returned empty response"
        return
    let status = turnEventParseHttpStatus(raw)
    if status != 200:
        let providerError = wire.RustCsgJsonFindOptionalStr(raw, "error")
        if providerError != "":
            outError = providerError
            return
        outError = wire.RustCsgCat("responses provider returned HTTP ", strings.IntToStr(status))
        return
    outBody = wire.RustCsgJsonFindOptionalStr(raw, "body")
    if outBody == "":
        outError = "responses provider returned empty body"

fn turnEventStartResponsesStreamBodyWithThreadSource(requestBody: str, threadId: str, turnId: str, threadSource: str, outError: var str): int32 =
    outError = ""
    let apiKey = rustCsgTurnEventGetEnv("OPENAI_API_KEY")
    if apiKey == "":
        outError = "turn/start event loop requires OPENAI_API_KEY"
        return -1
    let url = turnEventResponsesEndpoint()
    if url == "":
        outError = "turn/start event loop requires openai_base_url"
        return -1
    let headers = turnEventBuildResponsesHeadersForTurnWithThreadSource(apiKey, threadId, turnId, threadSource)
    let handle = rustCsgTurnEventSsePostStart(url, requestBody, headers)
    if handle <= 0:
        let providerError = rustCsgTurnEventHttpLastError()
        if providerError != "":
            outError = wire.RustCsgCat("responses streaming provider failed to start: ", providerError)
            return -1
        outError = "responses streaming provider failed to start"
        return -1
    return handle

fn turnEventStartResponsesStreamBody(requestBody: str, threadId: str, turnId: str, outError: var str): int32 =
    return turnEventStartResponsesStreamBodyWithThreadSource(requestBody, threadId, turnId, "", outError)

fn turnEventStartResponsesStream(model: str, threadId: str, paramsJson: str, inputText: str, dynamicToolsJson: str, baseInstructions: str, outError: var str): int32 =
    var buildError: str
    let requestBody = turnEventBuildResponsesBody(model, threadId, paramsJson, inputText, dynamicToolsJson, baseInstructions, buildError)
    if buildError != "":
        outError = buildError
        return -1
    return turnEventStartResponsesStreamBody(requestBody, threadId, "", outError)

fn turnEventAgentMessageItem(itemId: str, text: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "agentMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", itemId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", text))
    out = wire.RustCsgCat(out, ",\"phase\":null,\"memoryCitation\":null}")
    return out

fn turnEventReasoningItem(itemId: str, summaryRaw: str, contentRaw: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "reasoning"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", itemId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("summary", summaryRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", contentRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventReasoningTextArray(sourceRaw: str, expectedType: str, outError: var str): str =
    outError = ""
    if sourceRaw == "":
        return "[]"
    var out = "["
    var pos: int32 = 0
    var count: int32 = 0
    while true:
        var entryJson: str
        var readError: str
        if !turnEventReadArrayObject(sourceRaw, pos, entryJson, readError):
            if readError != "":
                outError = readError
                return ""
            break
        let entryType = wire.RustCsgJsonFindOptionalStr(entryJson, "type")
        if entryType != "" && entryType != expectedType:
            outError = wire.RustCsgCat("reasoning item entry type mismatch: ", turnEventPreview(entryJson))
            return ""
        if !turnEventHasField(entryJson, "text"):
            outError = wire.RustCsgCat("reasoning item entry missing text: ", turnEventPreview(entryJson))
            return ""
        let text = wire.RustCsgJsonFindOptionalStr(entryJson, "text")
        if count > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(text))
        count = count + 1
    out = wire.RustCsgCat(out, "]")
    return out

fn turnEventReasoningItemFromResponseData(data: str, outItemId: var str, outItemJson: var str, outError: var str): bool =
    outItemId = ""
    outItemJson = ""
    outError = ""
    let itemJson = turnEventResponseItemJson(data)
    if itemJson == "":
        outError = wire.RustCsgCat("reasoning output item missing item: ", turnEventPreview(data))
        return false
    let itemType = wire.RustCsgJsonFindOptionalStr(itemJson, "type")
    if itemType != "reasoning":
        outError = wire.RustCsgCat("reasoning output item type mismatch: ", turnEventPreview(itemJson))
        return false
    let itemId = wire.RustCsgJsonFindOptionalStr(itemJson, "id")
    if itemId == "":
        outError = wire.RustCsgCat("reasoning output item missing id: ", turnEventPreview(itemJson))
        return false
    let summarySource = wire.RustCsgJsonFindOptionalArray(itemJson, "summary")
    var summaryError: str
    let summaryRaw = turnEventReasoningTextArray(summarySource, "summary_text", summaryError)
    if summaryError != "":
        outError = summaryError
        return false
    let contentSource = wire.RustCsgJsonFindOptionalArray(itemJson, "content")
    var contentError: str
    let contentRaw = turnEventReasoningTextArray(contentSource, "reasoning_text", contentError)
    if contentError != "":
        outError = contentError
        return false
    outItemId = itemId
    outItemJson = turnEventReasoningItem(itemId, summaryRaw, contentRaw)
    return true

fn turnEventBoolRaw(value: bool): str =
    if value:
        return "true"
    return "false"

