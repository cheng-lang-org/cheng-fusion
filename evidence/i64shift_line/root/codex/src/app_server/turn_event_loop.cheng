    return out

fn turnEventCommandArrayToDisplay(commandRaw: str): str =
    if commandRaw == "":
        return ""
    let parts = wire.RustCsgJsonStringArrayFromRaw(commandRaw)
    var out: str
    var i: int32
    while i < parts.len:
        if i > 0:
            out = wire.RustCsgCat(out, " ")
        out = wire.RustCsgCat(out, parts[i])
        i = i + 1
    return out

fn turnEventJsonAppendRawField(out: str, key: str, raw: str): str =
    if raw == "":
        return out
    return wire.RustCsgCat3(wire.RustCsgCat(out, ","), wire.RustCsgJsonFieldRaw(key, raw), "")

fn turnEventJsonAppendStrField(out: str, key: str, value: str): str =
    if value == "":
        return out
    return wire.RustCsgCat3(wire.RustCsgCat(out, ","), wire.RustCsgJsonFieldStr(key, value), "")

fn turnEventDecisionAppend(out: str, count: var int32, decisionRaw: str): str =
    var next = out
    if count > 0:
        next = wire.RustCsgCat(next, ",")
    next = wire.RustCsgCat(next, decisionRaw)
    count = count + 1
    return next

fn turnEventPathJoinForCommandAction(cwd: str, path: str): str =
    if path == "":
        return ""
    if path[0] == '/':
        return path
    if cwd == "":
        return path
    if cwd[cwd.len - 1] == '/':
        return wire.RustCsgCat(cwd, path)
    return wire.RustCsgCat3(cwd, "/", path)

fn turnEventCommandActionFromParsedCommand(parsedJson: str,
                                           cwd: str,
                                           outError: var str): str =
    outError = ""
    let actionType = wire.RustCsgJsonFindOptionalStr(parsedJson, "type")
    if actionType == "":
        outError = wire.RustCsgCat("parsed command action missing type: ", turnEventPreview(parsedJson))
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", actionType))
    let command = wire.RustCsgJsonFindOptionalStr(parsedJson, "cmd")
    if command != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", command))
    let name = wire.RustCsgJsonFindOptionalStr(parsedJson, "name")
    if name != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", name))
    let path = turnEventPathJoinForCommandAction(cwd, wire.RustCsgJsonFindOptionalStr(parsedJson, "path"))
    if path != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, "}")
    return out

fn turnEventCommandActionsFromParsedCommands(parsedRaw: str,
                                             cwd: str,
                                             outError: var str): str =
    outError = ""
    if parsedRaw == "" || parsedRaw == "[]":
        return ""
    var out = "["
    var pos: int32 = 0
    var count: int32
    while true:
        var parsedJson: str
        var readError: str
        if !turnEventReadArrayObject(parsedRaw, pos, parsedJson, readError):
            if readError != "":
                outError = readError
                return ""
            break
        var actionError: str
        let action = turnEventCommandActionFromParsedCommand(parsedJson, cwd, actionError)
        if actionError != "":
            outError = actionError
            return ""
        if count > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, action)
        count = count + 1
    if count == 0:
        return ""
    out = wire.RustCsgCat(out, "]")
    return out

fn turnEventNetworkPolicyAmendmentFromAvailableDecisions(raw: str): str =
    if raw == "":
        return ""
    let wrapper = wire.RustCsgJsonFindOptionalObject(raw, "network_policy_amendment")
    if wrapper == "":
        return ""
    let nested = wire.RustCsgJsonFindOptionalObject(wrapper, "network_policy_amendment")
    if nested != "":
        return nested
    return wrapper

fn turnEventNetworkPolicyAmendmentFromProposals(raw: str): str =
    if raw == "":
        return ""
    var pos: int32 = 0
    var selected: str
    var fallback: str
    while true:
        var proposal: str
        var readError: str
        if !turnEventReadArrayObject(raw, pos, proposal, readError):
            break
        if fallback == "":
            fallback = proposal
        let action = wire.RustCsgJsonFindOptionalStr(proposal, "action")
        if action == "allow":
            selected = proposal
    if selected != "":
        return selected
    return fallback

fn turnEventAcceptWithExecpolicyDecision(execpolicyRaw: str): str =
    return wire.RustCsgCat3("{\"acceptWithExecpolicyAmendment\":{\"execpolicy_amendment\":", execpolicyRaw, "}}")

fn turnEventApplyNetworkPolicyDecision(networkRaw: str): str =
    return wire.RustCsgCat3("{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":", networkRaw, "}}")

fn turnEventDefaultAvailableDecisionsToV2(eventJson: str): str =
    let raw = wire.RustCsgJsonFindOptionalArray(eventJson, "available_decisions")
    let execpolicyRaw = wire.RustCsgJsonFindOptionalArray(eventJson, "proposed_execpolicy_amendment")
    let proposedNetworkRaw = wire.RustCsgJsonFindOptionalArray(eventJson, "proposed_network_policy_amendments")
    var out = "["
    var count: int32
    if raw == "":
        out = wire.RustCsgCat(out, "\"accept\"")
        count = count + 1
        if proposedNetworkRaw != "":
            out = turnEventDecisionAppend(out, count, "\"acceptForSession\"")
            let networkProposal = turnEventNetworkPolicyAmendmentFromProposals(proposedNetworkRaw)
            if networkProposal != "":
                out = turnEventDecisionAppend(out, count, turnEventApplyNetworkPolicyDecision(networkProposal))
            out = turnEventDecisionAppend(out, count, "\"cancel\"")
        elif execpolicyRaw != "":
            out = turnEventDecisionAppend(out, count, turnEventAcceptWithExecpolicyDecision(execpolicyRaw))
            out = turnEventDecisionAppend(out, count, "\"cancel\"")
        else:
            out = turnEventDecisionAppend(out, count, "\"decline\"")
            out = turnEventDecisionAppend(out, count, "\"cancel\"")
        out = wire.RustCsgCat(out, "]")
        return out
    if wire.RustCsgContains(raw, "\"approved\""):
        out = turnEventDecisionAppend(out, count, "\"accept\"")
    if wire.RustCsgContains(raw, "approved_for_session"):
        out = turnEventDecisionAppend(out, count, "\"acceptForSession\"")
    if wire.RustCsgContains(raw, "approved_execpolicy_amendment") || execpolicyRaw != "":
        var decisionExecpolicy = execpolicyRaw
        if decisionExecpolicy == "":
            decisionExecpolicy = wire.RustCsgJsonFindOptionalArray(raw, "proposed_execpolicy_amendment")
        if decisionExecpolicy != "":
            out = turnEventDecisionAppend(out, count, turnEventAcceptWithExecpolicyDecision(decisionExecpolicy))
    if wire.RustCsgContains(raw, "network_policy_amendment"):
        let decisionNetwork = turnEventNetworkPolicyAmendmentFromAvailableDecisions(raw)
        if decisionNetwork != "":
            out = turnEventDecisionAppend(out, count, turnEventApplyNetworkPolicyDecision(decisionNetwork))
    if wire.RustCsgContains(raw, "\"denied\"") || wire.RustCsgContains(raw, "\"rejected\"") || wire.RustCsgContains(raw, "\"timed_out\"") || wire.RustCsgContains(raw, "\"abort\""):
        out = turnEventDecisionAppend(out, count, "\"decline\"")
    if wire.RustCsgContains(raw, "\"timed_out\"") || wire.RustCsgContains(raw, "\"abort\"") || wire.RustCsgContains(raw, "\"cancel\""):
        out = turnEventDecisionAppend(out, count, "\"cancel\"")
    if count == 0:
        out = turnEventDecisionAppend(out, count, "\"accept\"")
        out = turnEventDecisionAppend(out, count, "\"decline\"")
        out = turnEventDecisionAppend(out, count, "\"cancel\"")
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgAppServerTurnEventCommandExecutionApprovalRequest(requestId: int32,
                                                            threadId: str,
                                                            turnId: str,
                                                            itemId: str,
                                                            startedAtMs: int64,
                                                            approvalId: str,
                                                            reason: str,
                                                            networkApprovalContextRaw: str,
                                                            command: str,
                                                            cwd: str,
                                                            commandActionsRaw: str,
                                                            additionalPermissionsRaw: str,
                                                            proposedExecpolicyAmendmentRaw: str,
                                                            proposedNetworkPolicyAmendmentsRaw: str,
                                                            availableDecisionsRaw: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("turnId", turnId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("itemId", itemId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldInt64("startedAtMs", startedAtMs))
    params = turnEventJsonAppendStrField(params, "approvalId", approvalId)
    params = turnEventJsonAppendStrField(params, "reason", reason)
    params = turnEventJsonAppendRawField(params, "networkApprovalContext", networkApprovalContextRaw)
    params = turnEventJsonAppendStrField(params, "command", command)
    params = turnEventJsonAppendStrField(params, "cwd", cwd)
    params = turnEventJsonAppendRawField(params, "commandActions", commandActionsRaw)
    params = turnEventJsonAppendRawField(params, "additionalPermissions", additionalPermissionsRaw)
    params = turnEventJsonAppendRawField(params, "proposedExecpolicyAmendment", proposedExecpolicyAmendmentRaw)
    params = turnEventJsonAppendRawField(params, "proposedNetworkPolicyAmendments", proposedNetworkPolicyAmendmentsRaw)
    params = turnEventJsonAppendRawField(params, "availableDecisions", availableDecisionsRaw)
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3(wire.RustCsgCat3("{\"id\":", strings.IntToStr(requestId), ",\"method\":\"item/commandExecution/requestApproval\",\"params\":"), params, "}")

fn RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(requestId: int32,
                                                                         threadId: str,
                                                                         eventJson: str,
                                                                         outError: var str): str =
    outError = ""
    let itemId = wire.RustCsgJsonFindOptionalStr(eventJson, "call_id")
    if itemId == "":
        outError = "command execution approval core event missing call_id"
        return ""
    let turnId = wire.RustCsgJsonFindOptionalStr(eventJson, "turn_id")
    if turnId == "":
        outError = "command execution approval core event missing turn_id"
        return ""
    if !turnEventHasField(eventJson, "started_at_ms"):
        outError = "command execution approval core event missing started_at_ms"
        return ""
    let startedAtMs = wire.RustCsgJsonFindInt64(eventJson, "started_at_ms")
    let approvalId = wire.RustCsgJsonFindOptionalStr(eventJson, "approval_id")
    let reason = wire.RustCsgJsonFindOptionalStr(eventJson, "reason")
    let commandRaw = wire.RustCsgJsonFindOptionalArray(eventJson, "command")
    var command = turnEventCommandArrayToDisplay(commandRaw)
    var cwd = wire.RustCsgJsonFindOptionalStr(eventJson, "cwd")
    let networkApprovalContextRaw = wire.RustCsgJsonFindOptionalObject(eventJson, "network_approval_context")
    if networkApprovalContextRaw != "":
        command = ""
        cwd = ""
    let proposedExecpolicyRaw = wire.RustCsgJsonFindOptionalArray(eventJson, "proposed_execpolicy_amendment")
    let proposedNetworkRaw = wire.RustCsgJsonFindOptionalArray(eventJson, "proposed_network_policy_amendments")
    var actionsError: str
    let commandActionsRaw = turnEventCommandActionsFromParsedCommands(wire.RustCsgJsonFindOptionalArray(eventJson, "parsed_cmd"), cwd, actionsError)
    if actionsError != "":
        outError = actionsError
        return ""
    let decisionsRaw = turnEventDefaultAvailableDecisionsToV2(eventJson)
    return RustCsgAppServerTurnEventCommandExecutionApprovalRequest(requestId,
                                                                    threadId,
                                                                    turnId,
                                                                    itemId,
                                                                    startedAtMs,
                                                                    approvalId,
                                                                    reason,
                                                                    networkApprovalContextRaw,
                                                                    command,
                                                                    cwd,
                                                                    commandActionsRaw,
                                                                    "",
                                                                    proposedExecpolicyRaw,
                                                                    proposedNetworkRaw,
                                                                    decisionsRaw)

fn RustCsgAppServerTurnEventFileChangeApprovalRequest(requestId: int32,
                                                       threadId: str,
                                                       turnId: str,
                                                       itemId: str,
                                                       startedAtMs: int64,
                                                       reason: str,
                                                       grantRoot: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("threadId", threadId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("turnId", turnId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("itemId", itemId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldInt64("startedAtMs", startedAtMs))
    if reason != "":
        params = wire.RustCsgCat(params, ",")
        params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("reason", reason))
    if grantRoot != "":
        params = wire.RustCsgCat(params, ",")
        params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("grantRoot", grantRoot))
    params = wire.RustCsgCat(params, "}")
    return wire.RustCsgCat3(wire.RustCsgCat3("{\"id\":", strings.IntToStr(requestId), ",\"method\":\"item/fileChange/requestApproval\",\"params\":"), params, "}")

fn RustCsgAppServerTurnEventFileChangeApprovalRequestFromCoreEvent(requestId: int32,
                                                                   threadId: str,
                                                                   eventJson: str,
                                                                   outError: var str): str =
    outError = ""
    let itemId = wire.RustCsgJsonFindOptionalStr(eventJson, "call_id")
    if itemId == "":
        outError = "file change approval core event missing call_id"
        return ""
    let turnId = wire.RustCsgJsonFindOptionalStr(eventJson, "turn_id")
    if turnId == "":
        outError = "file change approval core event missing turn_id"
        return ""
    if !turnEventHasField(eventJson, "started_at_ms"):
        outError = "file change approval core event missing started_at_ms"
        return ""
    let startedAtMs = wire.RustCsgJsonFindInt64(eventJson, "started_at_ms")
    let reason = wire.RustCsgJsonFindOptionalStr(eventJson, "reason")
    let grantRoot = wire.RustCsgJsonFindOptionalStr(eventJson, "grant_root")
    return RustCsgAppServerTurnEventFileChangeApprovalRequest(requestId, threadId, turnId, itemId, startedAtMs, reason, grantRoot)

