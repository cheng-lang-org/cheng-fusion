fn RustCsgAppServerTurnEventWriteLiveWebSocketFromResponseWithSession(body: str,
                                                                      response: str,
                                                                      dynamicToolsJson: str,
                                                                      baseInstructions: str,
                                                                      developerInstructions: str,
                                                                      historyJson: str,
                                                                      notificationFds: int32[],
                                                                      requestFds: int32[],
