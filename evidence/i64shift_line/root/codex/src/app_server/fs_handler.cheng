# codex app-server: fs handlers — moved from main.cheng for compiler stability

import std/strings
import cheng/codex/protocol/wire as wire
import cheng/codex/config/home as home
import cheng/codex/app_server/cheng_write_gateway

@abi_internal
@importc("RustCsgPathStat")
fn rustCsgAppServerPathStat(path: str): str

@abi_internal
@importc("RustCsgReadDir")
fn rustCsgAppServerReadDir(path: str): str

@abi_internal
@importc("RustCsgBase64Encode")
fn rustCsgAppServerBase64Encode(data: str): str

@abi_internal
@importc("RustCsgBase64Decode")
fn rustCsgAppServerBase64DecodeProvider(data: str): str

@abi_internal
@importc("RustCsgCreateTempFile")
fn rustCsgAppServerCreateTempFile(prefix: str): str

@abi_internal
@importc("RustCsgWriteFile")
fn rustCsgAppServerWriteFile(path: str, content: str): int32

@abi_internal
@importc("RustCsgFileDelete")
fn rustCsgAppServerFileDelete(path: str): int32

@abi_internal
@importc("RustCsgMkdir")
fn rustCsgAppServerMkdir(path: str): int32

@abi_internal
@importc("RustCsgFileCopy")
fn rustCsgAppServerFileCopy(src: str, dst: str): int32

# ── Base64 char value ─────────────────────────────────────────────────────

fn rustCsgAppServerBase64CharValue(ch: char): int32 =
    if ch >= 'A' && ch <= 'Z':
        return int32(ch) - int32('A')
    if ch >= 'a' && ch <= 'z':
        return int32(ch) - int32('a') + 26
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0') + 52
    if ch == '+':
        return 62
    if ch == '/':
        return 63
    return -1

# ── Base64 decode ─────────────────────────────────────────────────────────

fn rustCsgAppServerBase64Decode(b64: str): str =
    return rustCsgAppServerBase64DecodeProvider(b64)

fn rustCsgAppServerBase64DecodeChengFallback(b64: str): str =
    var out: str = ""
    var i: int32
    var q0: int32
    var q1: int32
    var q2: int32
    var q3: int32
    var qCount: int32
    var padCount: int32
    while i < b64.len:
        let ch = b64[i]
        i = i + 1
        if ch == '=':
            padCount = padCount + 1
            if qCount == 0:
                q0 = 0
            elif qCount == 1:
                q1 = 0
            elif qCount == 2:
                q2 = 0
            else:
                q3 = 0
            qCount = qCount + 1
        else:
            var bv: int32 = rustCsgAppServerBase64CharValue(ch)
            if bv >= 0:
                if qCount == 0:
                    q0 = bv
                elif qCount == 1:
                    q1 = bv
                elif qCount == 2:
                    q2 = bv
                else:
                    q3 = bv
                qCount = qCount + 1
        if qCount == 4:
            let b0v = (q0 << 2) | (q1 >> 4)
            out = wire.RustCsgCat(out, strings.CharToStr(Char(b0v)))
            if padCount <= 1:
                let b1v = ((q1 << 4) & 0xFF) | (q2 >> 2)
                out = wire.RustCsgCat(out, strings.CharToStr(Char(b1v)))
            if padCount == 0:
                let b2v = ((q2 << 6) & 0xFF) | q3
                out = wire.RustCsgCat(out, strings.CharToStr(Char(b2v)))
            qCount = 0
            padCount = 0
    if qCount == 2:
        let b0vTail = (q0 << 2) | (q1 >> 4)
        out = wire.RustCsgCat(out, strings.CharToStr(Char(b0vTail)))
    elif qCount == 3:
        let b0vTail3 = (q0 << 2) | (q1 >> 4)
        out = wire.RustCsgCat(out, strings.CharToStr(Char(b0vTail3)))
        let b1vTail3 = ((q1 << 4) & 0xFF) | (q2 >> 2)
        out = wire.RustCsgCat(out, strings.CharToStr(Char(b1vTail3)))
    return out

# ── Response helpers (duplicated from main.cheng for module self-containment) ──

fn rustCsgAppServerRequestId(body: str): int32 =
    if wire.RustCsgContains(body, "\"id\""):
        return wire.RustCsgJsonFindInt32(body, "id")
    return 0

fn rustCsgAppServerResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgAppServerError(id: int32, code: int32, message: str): str =
    let errorHead = wire.RustCsgCat3("{\"error\":{\"code\":", strings.IntToStr(code), ",\"message\":")
    let errorBody = wire.RustCsgCat3(errorHead, wire.RustCsgJsonQuote(message), "}")
    return wire.RustCsgCat3(errorBody, wire.RustCsgCat3(",\"id\":", strings.IntToStr(id), ""), "}")

# ── Validate required params ──────────────────────────────────────────────

fn rustCsgAppServerValidateRequiredParams(params: str, keys: str[]): str =
    for i in 0..<keys.len:
        let key = keys[i]
        let value = wire.RustCsgJsonFindStr(params, key)
        if value == "":
            return key
    return ""

# ── fs/readFile ─────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsReadFile(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    let data = home.RustCsgReadFile(path)
    if data == "":
        return rustCsgAppServerError(id, -32603, "failed to read file")
    let b64 = rustCsgAppServerBase64Encode(data)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("dataBase64", wire.RustCsgJsonQuote(b64)))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── fs/getMetadata ───────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsGetMetadata(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    let statJson = rustCsgAppServerPathStat(path)
    if statJson == "":
        return rustCsgAppServerError(id, -32603, "failed to stat path")
    return rustCsgAppServerResponse(id, statJson)

# ── fs/readDirectory ─────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsReadDirectory(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    let entriesJson = rustCsgAppServerReadDir(path)
    if entriesJson == "":
        return rustCsgAppServerError(id, -32603, "failed to read directory")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("entries", entriesJson))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── fs/writeFile ─────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsWriteFile(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path", "dataBase64"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    var gateReason: str
    if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("writeFile", path, gateReason):
        return rustCsgAppServerError(id, -32603, gateReason)
    let dataBase64 = wire.RustCsgJsonFindStr(paramsJson, "dataBase64")
    let content = rustCsgAppServerBase64Decode(dataBase64)
    let ok = rustCsgAppServerWriteFile(path, content)
    var detail = "failed to write file"
    if ok != 0:
        detail = "ok"
    cheng_write_gateway.ChengWriteGatewayRecordAfter("writeFile", path, ok != 0, detail)
    if ok == 0:
        return rustCsgAppServerError(id, -32603, "failed to write file")
    return rustCsgAppServerResponse(id, "{}")

# ── fs/createDirectory ─────────────────────────────────────────────────

fn rustCsgAppServerHandleFsCreateDirectory(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    var gateReason: str
    if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("createDirectory", path, gateReason):
        return rustCsgAppServerError(id, -32603, gateReason)
    let ok = rustCsgAppServerMkdir(path)
    var detail = "failed to create directory"
    if ok != 0:
        detail = "ok"
    cheng_write_gateway.ChengWriteGatewayRecordAfter("createDirectory", path, ok != 0, detail)
    if ok == 0:
        return rustCsgAppServerError(id, -32603, "failed to create directory")
    return rustCsgAppServerResponse(id, "{}")

# ── fs/remove ─────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsRemove(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    var gateReason: str
    if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("remove", path, gateReason):
        return rustCsgAppServerError(id, -32603, gateReason)
    let ok = rustCsgAppServerFileDelete(path)
    var detail = "failed to remove file or directory"
    if ok != 0:
        detail = "ok"
    cheng_write_gateway.ChengWriteGatewayRecordAfter("remove", path, ok != 0, detail)
    if ok == 0:
        return rustCsgAppServerError(id, -32603, "failed to remove file or directory")
    return rustCsgAppServerResponse(id, "{}")

# ── fs/copy ───────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsCopy(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["src", "dst"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let src = wire.RustCsgJsonFindStr(paramsJson, "src")
    let dst = wire.RustCsgJsonFindStr(paramsJson, "dst")
    var gateReason: str
    if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("copy", dst, gateReason):
        return rustCsgAppServerError(id, -32603, gateReason)
    let ok = rustCsgAppServerFileCopy(src, dst)
    var detail = "failed to copy file"
    if ok != 0:
        detail = "ok"
    cheng_write_gateway.ChengWriteGatewayRecordAfter("copy", dst, ok != 0, detail)
    if ok == 0:
        return rustCsgAppServerError(id, -32603, "failed to copy file")
    return rustCsgAppServerResponse(id, "{}")

# ── fs/watch ──────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsWatch(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["path", "watchId"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    if path == "":
        return rustCsgAppServerError(id, -32602, "path must not be empty")
    let watchId = wire.RustCsgJsonFindStr(paramsJson, "watchId")
    if watchId == "":
        return rustCsgAppServerError(id, -32602, "watchId must not be empty")
    return rustCsgAppServerError(id, -32601, "fs/watch requires connection-scoped writer transport")

# ── fs/unwatch ────────────────────────────────────────────────────────

fn rustCsgAppServerHandleFsUnwatch(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let missing = rustCsgAppServerValidateRequiredParams(paramsJson, ["watchId"])
    if missing != "":
        return rustCsgAppServerError(id, -32602, wire.RustCsgCat(missing, " is required"))
    let watchId = wire.RustCsgJsonFindStr(paramsJson, "watchId")
    if watchId == "":
        return rustCsgAppServerError(id, -32602, "watchId must not be empty")
    return rustCsgAppServerError(id, -32601, "fs/unwatch requires connection-scoped writer transport")
