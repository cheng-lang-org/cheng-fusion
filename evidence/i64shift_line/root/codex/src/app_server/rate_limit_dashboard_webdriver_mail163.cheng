import cheng/codex/protocol/wire
import cheng/codex/std/strings
import cheng/codex/app_server/rate_limit_dashboard_webdriver
import cheng/codex/app_server/rate_limit_dashboard_webdriver_login

# 163.com email verification via WebDriver for rate limit dashboard.
# Navigates mail.163.com, logs in, scans for OpenAI verification codes.
# Aligns with Rust cf64150e9c codex-rs/app-server/src/rate_limit_dashboard/webdriver/mail163.rs.

# Getter functions below own the real script text. Keep legacy constants short so cold
# import parsing never pays for unused multiline JavaScript.
const RustCsgWebDriverCollectDocumentsJs: str = ""
const RustCsgWebDriverFrameAwareClickTextScript: str = ""
const RustCsgWebDriverFrameAwareExtractCodesScript: str = ""
const RustCsgWebDriverOpenLatestMailScript: str = ""

# -- Simple scripts for mail163 context --

const RustCsgWebDriverCurrentUrlScript: str = "return window.location.href||'';"

const RustCsgWebDriverFindFirstElementScript: str = ""
const RustCsgWebDriverFillVisibleInputInContextScript: str = ""
const RustCsgWebDriverClickVisibleElementScript: str = ""

# -- 163 Mail URL constants --

fn RustCsgWebDriverMail163Url(): str = "https://mail.163.com/"

fn RustCsgWebDriverMail163UnreadInboxHash(): str =
    return "#module=mbox.ListModule%7C%7B%22filter%22%3A%7B%22flags%22%3A%7B%22read%22%3Afalse%7D%7D%2C%22order%22%3A%22date%22%2C%22desc%22%3Atrue%2C%22fids%22%3A%5B1%2C3%5D%7D"

fn RustCsgWebDriverMail163CodeSelectorsJson(): str =
    return "[\"input[name='code']\",\"input[id*='code']\",\"input[placeholder*='验证码']\"]"

fn RustCsgWebDriverMail163SubmitCodeSelectorsJson(): str =
    return "[\"input[name='code']\",\"input[id*='code']\",\"input[placeholder*='验证码']\",\"input[type='text']\"]"

fn RustCsgWebDriverMail163SubmitSelectorsJson(): str =
    return "[\"button[type='submit']\",\"input[type='submit']\",\"button\"]"

fn RustCsgWebDriverMail163ResendSelectorsJson(): str =
    return "[\"button\",\"a\",\"[role='button']\"]"

fn RustCsgWebDriverMail163ResendTextsJson(): str =
    return "[\"重新发送电子邮件\",\"Resend email\"]"

fn RustCsgWebDriverMail163IsMissingOpenaiVerificationEmailError(error: str): bool =
    return wire.RustCsgContains(error, "verification code not found in 163 mailbox") ||
           wire.RustCsgContains(error, "timed out waiting for OpenAI verification email in 163 mailbox")

# -- 163 mailbox login detection --

fn RustCsgWebDriverMail163IsLoggedIn(baseUrl: str, sessionId: str): bool =
    var result: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, RustCsgWebDriverGetCurrentUrlScript(), "[]", result, error):
        return false
    return wire.RustCsgContains(result, "mail.163.com/js6/main.jsp?sid=")

# -- Const getters (avoid cold compiler multiline const bug) --

fn RustCsgWebDriverGetCollectDocumentsJs(): str =
    return "const collectDocuments=(root)=>{const docs=[root];for(const frame of root.querySelectorAll('iframe')){try{const fd=frame.contentDocument;if(fd){docs.push(...collectDocuments(fd))}}catch(e){}}return docs;};"

fn RustCsgWebDriverGetFrameAwareClickTextScript(): str =
    return "const selectors=arguments[0],texts=arguments[1];function clickableAncestor(el){while(el){const t=el.tagName?el.tagName.toLowerCase():'';if(['button','a','li','tr','td','div'].indexOf(t)>=0||el.getAttribute('role')==='button'){return el}el=el.parentElement}return null}const docs=collectDocuments(document);for(const doc of docs){for(const s of selectors){for(const el of doc.querySelectorAll(s)){if(!isVisible(el)){continue}const txt=(el.innerText||el.textContent||el.value||'').trim().toLowerCase();for(const wanted of texts){if(txt.indexOf(wanted.toLowerCase())>=0){const ca=clickableAncestor(el)||el;ca.scrollIntoView({block:'center',inline:'center'});ca.click();return {status:'clicked',text:wanted}}}}}}return {status:'missing'};"

fn RustCsgWebDriverGetFrameAwareExtractCodesScript(): str =
    return "const docs=collectDocuments(document),codes=[],seen={};for(const doc of docs){const text=(doc.body?.innerText||'');const lower=text.toLowerCase();if(lower.indexOf('openai')<0&&lower.indexOf('chatgpt')<0&&lower.indexOf('codex')<0&&text.indexOf('验证码')<0){continue}for(let i=0;i+5<text.length;i++){let c='',ok=true;for(let j=0;j<6;j++){const ch=text.charCodeAt(i+j);if(ch<48||ch>57){ok=false;break}c+=text[i+j]}if(ok&&!seen[c]){seen[c]=true;codes.push(c);i+=5}}}return codes;"

fn RustCsgWebDriverGetOpenLatestMailScript(): str =
    return "const keywords=['openai','chatgpt','codex','verification code','验证码'],selectors=['[data-mid]','[role=row]','tr','li','a','div'],docs=collectDocuments(document);function clickableAncestor(el){while(el){if(el.matches&&selectors.some(s=>el.matches(s))){return el}el=el.parentElement}return null}for(const doc of docs){for(const s of selectors){for(const el of doc.querySelectorAll(s)){if(!isVisible(el)){continue}const txt=(el.innerText||el.textContent||'').toLowerCase();for(const wanted of keywords){if(txt.indexOf(wanted)>=0){const ca=clickableAncestor(el)||el;ca.scrollIntoView({block:'center',inline:'center'});ca.click();return {status:'clicked',text:wanted}}}}}}return {status:'missing'};"

fn RustCsgWebDriverGetCurrentUrlScript(): str = RustCsgWebDriverCurrentUrlScript
fn RustCsgWebDriverGetFindFirstElementScript(): str =
    return "const selectors=arguments[0];for(const s of selectors){const el=document.querySelector(s);if(el){return el}}return null;"

fn RustCsgWebDriverGetFillVisibleInputInContextScript(): str =
    return "const selectors=arguments[0],text=arguments[1];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(!isVisible(el)){continue}const desc=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');if(desc&&desc.set){desc.set.call(el,text)}else{el.value=text}el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));el.blur();return {status:'filled',value:text}}}return {status:'missing'};"

fn RustCsgWebDriverGetClickVisibleElementScript(): str =
    return "const selectors=arguments[0];for(const s of selectors){for(const el of document.querySelectorAll(s)){if(isVisible(el)){el.click();return {status:'clicked'}}}}return {status:'missing'};"

# -- 163 login flow helpers --

fn RustCsgWebDriverMail163ClickTextInFrames(baseUrl: str, sessionId: str, selectorsJson: str, textsJson: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var script = wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(),
        wire.RustCsgCat(RustCsgWebDriverGetCollectDocumentsJs(), RustCsgWebDriverGetFrameAwareClickTextScript()))
    var args = wire.RustCsgCat("[", wire.RustCsgCat(selectorsJson, wire.RustCsgCat(",", wire.RustCsgCat(textsJson, "]"))))
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, args, result, outError):
            return false
        if wire.RustCsgJsonFindOptionalStr(result, "status") == "clicked":
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    return true

fn RustCsgWebDriverMail163ExtractCodesFromFrames(baseUrl: str, sessionId: str, outCodes: var str[], outError: var str): bool =
    outCodes = []
    outError = ""
    var script = wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(),
        wire.RustCsgCat(RustCsgWebDriverGetCollectDocumentsJs(), RustCsgWebDriverGetFrameAwareExtractCodesScript()))
    var result: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, "[]", result, outError):
        return false
    var pos: int32
    while pos < result.len:
        var digitStart: int32 = -1
        while pos < result.len:
            let ch = result[pos]
            if ch >= '0' && ch <= '9':
                digitStart = pos
                break
            pos = pos + 1
        if digitStart < 0:
            break
        var digitEnd: int32 = digitStart
        while digitEnd < result.len && result[digitEnd] >= '0' && result[digitEnd] <= '9':
            digitEnd = digitEnd + 1
        let codeLen = digitEnd - digitStart
        if codeLen == 6:
            let code = strings.SliceBytes(result, digitStart, 6)
            var alreadySeen: bool
            var k: int32
            while k < outCodes.len:
                if outCodes[k] == code:
                    alreadySeen = true
                    break
                k = k + 1
            if !alreadySeen:
                add(outCodes, code)
        pos = digitEnd
    return true

fn RustCsgWebDriverMail163OpenLatestOpenaiMail(baseUrl: str, sessionId: str): bool =
    var script = wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(),
        wire.RustCsgCat(RustCsgWebDriverGetCollectDocumentsJs(), RustCsgWebDriverGetOpenLatestMailScript()))
    var result: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, "[]", result, error):
        return false
    return wire.RustCsgJsonFindOptionalStr(result, "status") == "clicked"

fn RustCsgWebDriverMail163CurrentUrl(baseUrl: str, sessionId: str): str =
    var result: str
    var error: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, RustCsgWebDriverGetCurrentUrlScript(), "[]", result, error):
        return ""
    return rate_limit_dashboard_webdriver.RustCsgWebDriverRawStringValue(result)

# -- 163 unread inbox view --

fn RustCsgWebDriverMail163EnsureUnreadInboxView(baseUrl: str, sessionId: str, outError: var str): bool =
    outError = ""
    let currentUrl = RustCsgWebDriverMail163CurrentUrl(baseUrl, sessionId)
    if wire.RustCsgContains(currentUrl, "mail.163.com/js6/main.jsp?sid="):
        var base = currentUrl
        var hashPos: int32
        while hashPos < base.len:
            if base[hashPos] == '#':
                break
            hashPos = hashPos + 1
        if hashPos < base.len:
            base = strings.SliceBytes(base, 0, hashPos)
        let targetUrl = wire.RustCsgCat(base, RustCsgWebDriverMail163UnreadInboxHash())
        return rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, targetUrl, outError)
    return rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, RustCsgWebDriverMail163Url(), outError)

# -- Core: fetch verification code from 163 mailbox --

fn RustCsgWebDriverMail163FetchCode(baseUrl: str,
                                     sessionId: str,
                                     email: str,
                                     mailboxPassword: str,
                                     rejectedCodes: str[],
                                     outCode: var str,
                                     outError: var str): bool =
    outCode = ""
    outError = ""
    var mailboxAccount = email
    var atPos: int32
    while atPos < mailboxAccount.len:
        if mailboxAccount[atPos] == '@':
            break
        atPos = atPos + 1
    if atPos < mailboxAccount.len:
        mailboxAccount = strings.SliceBytes(mailboxAccount, 0, atPos)

    if !rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, RustCsgWebDriverMail163Url(), outError):
        return false

    rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToDefaultContent(baseUrl, sessionId, outError)

    if !RustCsgWebDriverMail163EnsureUnreadInboxView(baseUrl, sessionId, outError):
        return false

    if RustCsgWebDriverMail163IsLoggedIn(baseUrl, sessionId):
        return RustCsgWebDriverMail163WaitForCodeInMailbox(baseUrl, sessionId, rejectedCodes, outCode, outError)

    var clickSelectors = "[\"#switchAccountLogin\",\"#lbNormal\",\"button\",\"a\",\"[role='button']\",\"div\",\"span\",\"li\"]"
    var clickTexts = "[\"账号登录\",\"密码登录\",\"Account Login\",\"Password Login\"]"
    RustCsgWebDriverMail163ClickTextInFrames(baseUrl, sessionId, clickSelectors, clickTexts, 5000, outError)

    var loginFrameSelectors = "[\"#loginDiv iframe\",\"iframe[id^='x-URS-iframe']\",\"iframe[src*='dl.reg.163.com']\",\"iframe[src*='passport']\"]"
    var frameResult: str
    var frameError: str
    var elapsed: int32
    while elapsed < 45000:
        rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToDefaultContent(baseUrl, sessionId, outError)
        if rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId,
            wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(), RustCsgWebDriverGetFindFirstElementScript()),
            wire.RustCsgCat("[", wire.RustCsgCat(loginFrameSelectors, "]")), frameResult, frameError):
            if frameResult != "null" && frameResult != "":
                break
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    if elapsed >= 45000:
        outError = "163 mailbox login iframe not found"
        return false

    let frameId = rate_limit_dashboard_webdriver.RustCsgWebDriverElementReferenceId(frameResult)
    if frameId != "":
        rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToFrame(baseUrl, sessionId, frameId, outError)

    RustCsgWebDriverMail163ClickTextInFrames(baseUrl, sessionId, clickSelectors, clickTexts, 3000, outError)

    var emailSelectors = "[\"input[name='email']\",\".dlemail\",\"input[type='email']\",\"input[name*='email']\",\"input[name*='account']\",\"input[name*='user']\",\"input[placeholder*='邮箱']\",\"input[placeholder*='账号']\",\"input[placeholder*='帐号']\",\"input[type='text']\"]"
    if !RustCsgWebDriverMail163FillInputInContext(baseUrl, sessionId, emailSelectors, mailboxAccount, "mailbox-email", 45000, outError):
        return false

    var passwordSelectors = "[\"input[name='password']\",\".dlpwd\",\"input[type='password']\",\"input[name*='password']\",\"input[placeholder*='密码']\"]"
    if !RustCsgWebDriverMail163FillInputInContext(baseUrl, sessionId, passwordSelectors, mailboxPassword, "mailbox-password", 45000, outError):
        return false

    var submitSelectors = "[\"#dologin\",\"button[type='submit']\",\"input[type='submit']\",\"button\",\"a\",\"[role='button']\",\"div\",\"span\",\"li\"]"
    if !RustCsgWebDriverMail163ClickElementInContext(baseUrl, sessionId, submitSelectors, "163 mailbox submit button", 45000, outError):
        return false

    var loginErrorFound: bool
    if !RustCsgWebDriverMail163CheckLoginError(baseUrl, sessionId, loginErrorFound, outError):
        return false
    if loginErrorFound:
        return false

    rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToDefaultContent(baseUrl, sessionId, outError)
    if !RustCsgWebDriverMail163EnsureUnreadInboxView(baseUrl, sessionId, outError):
        return false

    return RustCsgWebDriverMail163WaitForCodeInMailbox(baseUrl, sessionId, rejectedCodes, outCode, outError)

fn RustCsgWebDriverMail163FillInputInContext(baseUrl: str, sessionId: str, selectorsJson: str, text: str, fieldName: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var script = wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(), RustCsgWebDriverGetFillVisibleInputInContextScript())
    var args = wire.RustCsgCat("[", wire.RustCsgCat(selectorsJson, wire.RustCsgCat(",", wire.RustCsgCat(wire.RustCsgJsonQuote(text), "]"))))
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, args, result, outError):
            return false
        if wire.RustCsgJsonFindOptionalStr(result, "status") == "filled":
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outError = wire.RustCsgCat("163 mailbox ", wire.RustCsgCat(fieldName, " input not found"))
    return false

fn RustCsgWebDriverMail163ClickElementInContext(baseUrl: str, sessionId: str, selectorsJson: str, elementName: str, timeoutMs: int32, outError: var str): bool =
    outError = ""
    var script = wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(), RustCsgWebDriverGetClickVisibleElementScript())
    var args = wire.RustCsgCat("[", wire.RustCsgCat(selectorsJson, "]"))
    var elapsed: int32
    while elapsed < timeoutMs:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId, script, args, result, outError):
            return false
        if wire.RustCsgJsonFindOptionalStr(result, "status") == "clicked":
            return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outError = wire.RustCsgCat("timed out waiting for ", elementName)
    return false

fn RustCsgWebDriverMail163CheckLoginError(baseUrl: str, sessionId: str, outHasError: var bool, outError: var str): bool =
    outHasError = false
    outError = ""
    var result: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId,
        "return(document.body?.innerText||'').replace(/\\s+/g,' ').trim();", "[]", result, outError):
        return false
    if wire.RustCsgContains(result, "请输入账号"):
        outError = "163 mailbox did not accept the account name input"
        outHasError = true
        return true
    if wire.RustCsgContains(result, "账号或密码错误"):
        outError = "163 mailbox rejected the credentials; set MAILBOX_PASSWORD in .env if the mailbox password differs from PASSWORD"
        outHasError = true
        return true
    if wire.RustCsgContains(result, "验证码错误"):
        outError = "163 mailbox requested an extra verification step; the current automation only supports direct password login"
        outHasError = true
        return true
    return true

fn RustCsgWebDriverMail163WaitForCodeInMailbox(baseUrl: str, sessionId: str, rejectedCodes: str[], outCode: var str, outError: var str): bool =
    outCode = ""
    outError = ""
    var elapsed: int32
    while elapsed < 60000:
        if !RustCsgWebDriverMail163EnsureUnreadInboxView(baseUrl, sessionId, outError):
            return false
        var loginErr: bool
        RustCsgWebDriverMail163CheckLoginError(baseUrl, sessionId, loginErr, outError)
        if RustCsgWebDriverMail163OpenLatestOpenaiMail(baseUrl, sessionId):
            var codes: str[]
            if RustCsgWebDriverMail163ExtractCodesFromFrames(baseUrl, sessionId, codes, outError):
                var j: int32
                while j < codes.len:
                    var rejected: bool
                    var k: int32
                    while k < rejectedCodes.len:
                        if rejectedCodes[k] == codes[j]:
                            rejected = true
                            break
                        k = k + 1
                    if !rejected:
                        outCode = codes[j]
                        return true
                    j = j + 1
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outError = "timed out waiting for OpenAI verification email in 163 mailbox"
    return false

# -- Email verification submission outcome detection --

fn RustCsgWebDriverMail163SubmitCodeAndWait(baseUrl: str,
                                              sessionId: str,
                                              code: str,
                                              outAccepted: var bool,
                                              outRejected: var bool,
                                              outExhausted: var bool,
                                              outError: var str): bool =
    outAccepted = false
    outRejected = false
    outExhausted = false
    outError = ""
    var codeSelectors = RustCsgWebDriverMail163SubmitCodeSelectorsJson()
    var submitSelectors = RustCsgWebDriverMail163SubmitSelectorsJson()
    rate_limit_dashboard_webdriver_login.RustCsgWebDriverFillVisibleInputAndSubmit(baseUrl, sessionId, codeSelectors, submitSelectors, code, "verification-code", 45000, outError)

    var elapsed: int32
    while elapsed < 12000:
        var result: str
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId,
            "return(document.body?.innerText||'').replace(/\\s+/g,' ').trim();", "[]", result, outError):
            return false
        if wire.RustCsgContains(result, "max_check_attempts") || wire.RustCsgContains(result, "验证过程中出错"):
            outExhausted = true
            return true
        if wire.RustCsgContains(result, "please retry") && wire.RustCsgContains(result, "verification"):
            outExhausted = true
            return true
        if wire.RustCsgContains(result, "代码不正确") || wire.RustCsgContains(result, "code is incorrect"):
            outRejected = true
            return true
        var codeFieldMissing: bool
        var findResult: str
        if rate_limit_dashboard_webdriver.RustCsgWebDriverExecuteScript(baseUrl, sessionId,
            wire.RustCsgCat(rate_limit_dashboard_webdriver_login.RustCsgWebDriverGetIsVisibleJs(), RustCsgWebDriverGetFindFirstElementScript()),
            wire.RustCsgCat("[", wire.RustCsgCat(codeSelectors, "]")), findResult, outError):
            if findResult == "null" || findResult == "":
                outAccepted = true
                return true
        rate_limit_dashboard_webdriver.RustCsgWebDriverSleepPoll()
        elapsed = elapsed + 500
    outAccepted = true
    return true

fn RustCsgWebDriverMail163CompleteEmailVerificationIfNeeded(baseUrl: str,
                                                             sessionId: str,
                                                             email: str,
                                                             mailboxPassword: str,
                                                             outError: var str): bool =
    outError = ""
    if !strings.HasSuffix(email, "@163.com"):
        return true
    var codeInputFound: bool
    if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverHasVisibleInput(
        baseUrl, sessionId, RustCsgWebDriverMail163CodeSelectorsJson(), 15000, codeInputFound, outError):
        return false
    if !codeInputFound:
        return true
    var originalHandle: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverCurrentWindowHandle(baseUrl, sessionId, originalHandle, outError):
        return false
    var mailHandle: str
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverOpenNewTab(baseUrl, sessionId, mailHandle, outError):
        return false
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToWindow(baseUrl, sessionId, mailHandle, outError):
        return false
    let cleanMailboxPassword = rate_limit_dashboard_webdriver_login.RustCsgWebDriverStripWrappingQuotes(mailboxPassword)
    var rejectedCodes: str[]
    var attempt: int32
    while attempt < 3:
        var code: str
        var fetchError: str
        if !RustCsgWebDriverMail163FetchCode(baseUrl, sessionId, email, cleanMailboxPassword, rejectedCodes, code, fetchError):
            rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToWindow(baseUrl, sessionId, originalHandle, outError)
            if attempt == 2 || !RustCsgWebDriverMail163IsMissingOpenaiVerificationEmailError(fetchError):
                outError = fetchError
                return false
            var resendClicked: bool
            if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverClickVisibleText(
                baseUrl, sessionId, RustCsgWebDriverMail163ResendSelectorsJson(), RustCsgWebDriverMail163ResendTextsJson(), 5000, resendClicked, outError):
                return false
            if !resendClicked:
                outError = "OpenAI verification resend email button not found"
                return false
            if !rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToWindow(baseUrl, sessionId, mailHandle, outError):
                return false
            attempt = attempt + 1
            continue
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToWindow(baseUrl, sessionId, originalHandle, outError):
            return false
        var accepted: bool
        var rejected: bool
        var exhausted: bool
        if !RustCsgWebDriverMail163SubmitCodeAndWait(baseUrl, sessionId, code, accepted, rejected, exhausted, outError):
            return false
        if accepted:
            return true
        if exhausted:
            outError = "OpenAI email verification reached max_check_attempts after submitting code from 163 mailbox"
            return false
        add(rejectedCodes, code)
        if attempt == 2:
            break
        var resendClicked2: bool
        if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverClickVisibleText(
            baseUrl, sessionId, RustCsgWebDriverMail163ResendSelectorsJson(), RustCsgWebDriverMail163ResendTextsJson(), 5000, resendClicked2, outError):
            return false
        if !resendClicked2:
            outError = "OpenAI verification resend email button not found"
            return false
        if !rate_limit_dashboard_webdriver.RustCsgWebDriverSwitchToWindow(baseUrl, sessionId, mailHandle, outError):
            return false
        attempt = attempt + 1
    outError = "OpenAI rejected every verification code fetched from the 163 mailbox"
    return false

fn RustCsgWebDriverCompleteOpenaiLoginWithMail163(baseUrl: str,
                                                   sessionId: str,
                                                   authUrl: str,
                                                   email: str,
                                                   password: str,
                                                   mailboxPassword: str,
                                                   outError: var str): bool =
    return RustCsgWebDriverCompleteOpenaiLoginWithMail163Inner(
        baseUrl, sessionId, authUrl, email, password, mailboxPassword, true, outError)

fn RustCsgWebDriverCompleteOpenaiLoginWithMail163Inner(baseUrl: str,
                                                        sessionId: str,
                                                        authUrl: str,
                                                        email: str,
                                                        password: str,
                                                        mailboxPassword: str,
                                                        allowEmailVerificationRestart: bool,
                                                        outError: var str): bool =
    outError = ""
    let cleanPassword = rate_limit_dashboard_webdriver_login.RustCsgWebDriverStripWrappingQuotes(password)
    let cleanMailboxPassword = rate_limit_dashboard_webdriver_login.RustCsgWebDriverStripWrappingQuotes(mailboxPassword)
    let emailSelectors = "[\"input[type='email']\",\"input[name='email']\",\"input[name='username']\",\"input#username\"]"
    let emailSubmitSelectors = "[\"button[type='submit']\",\"input[type='submit']\",\"#identifierNext button\",\"#identifierNext [role='button']\"]"
    let passwordSelectors = "[\"input[type='password']\",\"input[name='password']\",\"input[name='Passwd']\",\"input[autocomplete='current-password']\"]"
    let passwordSubmitSelectors = "[\"#passwordNext\",\"button[type='submit']\",\"input[type='submit']\",\"#passwordNext button\",\"#passwordNext [role='button']\"]"
    if !rate_limit_dashboard_webdriver.RustCsgWebDriverNavigateTo(baseUrl, sessionId, authUrl, outError):
        outError = wire.RustCsgCat("failed to navigate to auth url: ", outError)
        return false
    if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverFillVisibleInputAndSubmit(
        baseUrl, sessionId, emailSelectors, emailSubmitSelectors, email, "email", 45000, outError):
        outError = wire.RustCsgCat("failed to submit email: ", outError)
        return false
    if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverSettleOpenaiIdentityStep(baseUrl, sessionId, authUrl, email, outError):
        return false
    if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverWaitForOpenaiPasswordStep(baseUrl, sessionId, authUrl, email, outError):
        return false
    if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverFillVisibleInputAndSubmit(
        baseUrl, sessionId, passwordSelectors, passwordSubmitSelectors, cleanPassword, "password", 45000, outError):
        outError = wire.RustCsgCat("failed to fill password: ", outError)
        return false
    if !RustCsgWebDriverMail163CompleteEmailVerificationIfNeeded(baseUrl, sessionId, email, cleanMailboxPassword, outError):
        return false
    if allowEmailVerificationRestart:
        var successFound: bool
        if !rate_limit_dashboard_webdriver_login.RustCsgWebDriverWaitForEmailVerificationSuccessPage(baseUrl, sessionId, 8000, successFound, outError):
            return false
        if successFound:
            return RustCsgWebDriverCompleteOpenaiLoginWithMail163Inner(
                baseUrl, sessionId, authUrl, email, cleanPassword, cleanMailboxPassword, false, outError)
    return rate_limit_dashboard_webdriver_login.RustCsgWebDriverConfirmOpenaiConsent(baseUrl, sessionId, outError)
