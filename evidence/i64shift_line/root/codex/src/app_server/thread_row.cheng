import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite

fn RustCsgThreadRowAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgThreadRowTrimAsciiSpace(text: str): str =
    var start: int32
    while start < text.len && RustCsgThreadRowAsciiSpace(text[start]):
        start = start + 1
    var end: int32
    end = text.len
    while end > start && RustCsgThreadRowAsciiSpace(text[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(text, start, end - start)

fn RustCsgThreadRowDistinctTitle(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): str =
    let title = RustCsgThreadRowTrimAsciiSpace(row.title)
    if title == "":
        return ""
    if RustCsgThreadRowTrimAsciiSpace(row.firstUserMessage) == title:
        return ""
    return title

fn RustCsgThreadRowToAppThread(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): types.RustCsgAppThread =
    var thread: types.RustCsgAppThread
    thread.id = row.id
    thread.sessionId = row.id
    thread.name = RustCsgThreadRowDistinctTitle(row)
    thread.cwd = row.cwd
    thread.modelProvider = row.modelProvider
    thread.source = row.source
    thread.path = row.rolloutPath
    thread.createdAt = row.createdAtMs / int64(1000)
    thread.updatedAt = row.updatedAtMs / int64(1000)
    thread.cliVersion = row.cliVersion
    thread.preview = row.firstUserMessage
    thread.forkedFromId = reader.RustCsgRolloutLatestSessionMetaForkedFromId(row.rolloutPath)
    thread.threadSource = reader.RustCsgRolloutLatestSessionMetaThreadSource(row.rolloutPath)
    thread.statusJson = "{\"type\":\"notLoaded\"}"
    thread.turnsJson = "[]"
    return thread
