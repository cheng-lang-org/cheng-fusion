import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite
@abi_internal
@importc("RustCsgMillisToRfc3339")
fn RustCsgMillisToRfc3339(millis: int64): str

@abi_internal
@importc("RustCsgRfc3339ToMillisText")
fn RustCsgRfc3339ToMillisText(text: str): str

@abi_internal
@importc("RustCsgNormalizePathRelativeToCurrentDir")
fn RustCsgNormalizePathRelativeToCurrentDir(path: str): str

const
    RustCsgThreadListSqliteDefaultLimit: int32 = 25
    RustCsgThreadListSqliteMaxLimit: int32 = 100

fn RustCsgThreadListSqliteRowIsSubAgentOther(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): bool =
    if !wire.RustCsgStartsWith(row.source, "subagent_"):
        return false
    if row.rolloutPath == "":
        return false
    return reader.RustCsgRolloutLatestSessionMetaSourceIsSubAgentOther(row.rolloutPath)

fn RustCsgThreadListSqliteRowMatchesSourcePostFilter(row: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                                       sourceKindPostFilterJson: str): bool =
    if sourceKindPostFilterJson == "":
        return true
    if sourceKindPostFilterJson == "[\"subAgentOther\"]":
        return RustCsgThreadListSqliteRowIsSubAgentOther(row)
    return true

type
    RustCsgThreadListSqlitePlan =
        pageSize: int32
        sortKey: str
        sortDirection: str
        modelProviderFilterJson: str
        allowedSourcesJson: str
        sourceKindPostFilterJson: str
        archived: bool
        cwdFiltersJson: str
        searchTerm: str
        parseError: str

    RustCsgThreadListSqliteResult =
        ok: bool
        response: types.RustCsgThreadListResponse
        rowCount: int32
        error: str
        blockedReason: str

fn RustCsgThreadListSqliteError(message: str): RustCsgThreadListSqliteResult =
    var result: RustCsgThreadListSqliteResult
    result.error = message
    return result

fn RustCsgThreadListSqliteBlocked(message: str): RustCsgThreadListSqliteResult =
    var result: RustCsgThreadListSqliteResult
    result.blockedReason = message
    return result

fn RustCsgThreadListSqliteJsonStringArrayOne(value: str): str =
    return wire.RustCsgCat3("[", wire.RustCsgJsonQuote(value), "]")

fn RustCsgThreadListSqliteValidateModelProvidersJson(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "[]":
        return raw
    if raw.len < 2 || raw[0] != '[' || raw[raw.len - 1] != ']':
        outError = "thread/list sqlite model provider filter must be a JSON string array"
        return ""
    let values = wire.RustCsgJsonStringArrayFromRaw(raw)
    for i in 0..<values.len:
        if values[i] == "":
            outError = "thread/list sqlite model provider filter contains an empty provider"
            return ""
    return raw

fn RustCsgThreadListSqliteCanonicalAbsolutePath(value: str): bool =
    if value == "/":
        return true
    if value.len < 2:
        return false
    if value[0] != '/':
        return false
    if value[value.len - 1] == '/':
        return false
    if wire.RustCsgContains(value, "//"):
        return false
    if wire.RustCsgContains(value, "/./"):
        return false
    if wire.RustCsgContains(value, "/../"):
        return false
    if value.len >= 2 && value[value.len - 2] == '/' && value[value.len - 1] == '.':
        return false
    if value.len >= 3 && value[value.len - 3] == '/' && value[value.len - 2] == '.' && value[value.len - 1] == '.':
        return false
    return true

const
    RustCsgThreadListSqlitePrintableAscii: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn RustCsgThreadListSqliteHexValueAt(text: str, pos: int32): int32 =
    if pos >= text.len:
        return -1
    let value = wire.RustCsgSliceBytes(text, pos, 1)
    let digit = wire.RustCsgDigitValue(value)
    if digit >= 0:
        return digit
    if value == "a" || value == "A":
        return 10
    if value == "b" || value == "B":
        return 11
    if value == "c" || value == "C":
        return 12
    if value == "d" || value == "D":
        return 13
    if value == "e" || value == "E":
        return 14
    if value == "f" || value == "F":
        return 15
    return -1

fn RustCsgThreadListSqlitePrintableAsciiFromCode(code: int32): str =
    if code < 32 || code > 126:
        return ""
    return wire.RustCsgSliceBytes(RustCsgThreadListSqlitePrintableAscii, code - 32, 1)

fn RustCsgThreadListSqliteJsonStringAt(text: str,
                                       start: int32,
                                       outOk: var bool,
                                       outEnd: var int32,
                                       outError: var str): str =
    outOk = false
    outEnd = start
    outError = ""
    if start >= text.len || text[start] != '"':
        outError = "thread/list sqlite cwd filter expects JSON string"
        return ""
    var out: str
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                outError = "thread/list sqlite cwd filter has unterminated string escape"
                return ""
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(text, i + 1, 1))
            elif escaped == 'n':
                out = wire.RustCsgCat(out, "\n")
            elif escaped == 'r':
                out = wire.RustCsgCat(out, "\r")
            elif escaped == 't':
                out = wire.RustCsgCat(out, "\t")
            elif escaped == 'u':
                if i + 5 >= text.len:
                    outError = "thread/list sqlite cwd filter has invalid unicode escape"
                    return ""
                let h1 = RustCsgThreadListSqliteHexValueAt(text, i + 2)
                let h2 = RustCsgThreadListSqliteHexValueAt(text, i + 3)
                let h3 = RustCsgThreadListSqliteHexValueAt(text, i + 4)
                let h4 = RustCsgThreadListSqliteHexValueAt(text, i + 5)
                if h1 < 0 || h2 < 0 || h3 < 0 || h4 < 0:
                    outError = "thread/list sqlite cwd filter has invalid unicode escape"
                    return ""
                let code = h1 * 4096 + h2 * 256 + h3 * 16 + h4
                let decoded = RustCsgThreadListSqlitePrintableAsciiFromCode(code)
                if decoded == "":
                    outError = "thread/list sqlite cwd filter unicode escape outside printable ASCII"
                    return ""
                out = wire.RustCsgCat(out, decoded)
                i = i + 6
                continue
            elif escaped == 'b' || escaped == 'f':
                outError = "thread/list sqlite cwd filter control escape not ported"
                return ""
            else:
                outError = "thread/list sqlite cwd filter has invalid string escape"
                return ""
            i = i + 2
            continue
        if ch == '"':
            outOk = true
            outEnd = i
            return out
        if ch == '\n' || ch == '\r' || ch == '\t':
            outError = "thread/list sqlite cwd filter contains raw control character"
            return ""
        out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(text, i, 1))
        i = i + 1
    outError = "thread/list sqlite cwd filter has unterminated string"
    return ""

fn RustCsgThreadListSqliteCwdFilterStringRaw(raw: str, outError: var str): str =
    outError = ""
    var ok: bool
    var endPos: int32
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    let value = RustCsgThreadListSqliteJsonStringAt(raw, start, ok, endPos, outError)
    if !ok:
        return ""
    let trailing = wire.RustCsgSkipJsonSpace(raw, endPos + 1)
    if trailing != raw.len:
        outError = "thread/list sqlite cwd filter has trailing JSON after string"
        return ""
    return value

fn RustCsgThreadListSqliteCwdFilterValue(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "null":
        return ""
    let value = RustCsgThreadListSqliteCwdFilterStringRaw(raw, outError)
    if outError != "":
        return ""
    let normalized = RustCsgNormalizePathRelativeToCurrentDir(value)
    if normalized == "" || !RustCsgThreadListSqliteCanonicalAbsolutePath(normalized):
        outError = "thread/list sqlite cwd filter normalization failed"
        return ""
    return normalized

fn RustCsgThreadListSqliteCwdFilterValuesRaw(raw: str, outError: var str): str[] =
    outError = ""
    var values: str[]
    values = []
    var pos: int32
    pos = wire.RustCsgSkipJsonSpace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        outError = "thread/list sqlite cwd filter only supports JSON string or string array"
        return values
    pos = wire.RustCsgSkipJsonSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        let trailing = wire.RustCsgSkipJsonSpace(raw, pos + 1)
        if trailing != raw.len:
            outError = "thread/list sqlite cwd filter has trailing JSON after array"
        return values
    while pos < raw.len:
        var ok: bool
        var endPos: int32
        let value = RustCsgThreadListSqliteJsonStringAt(raw, pos, ok, endPos, outError)
        if !ok:
            return values
        add(values, value)
        pos = wire.RustCsgSkipJsonSpace(raw, endPos + 1)
        if pos < raw.len && raw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(raw, pos + 1)
        elif pos < raw.len && raw[pos] == ']':
            let trailing = wire.RustCsgSkipJsonSpace(raw, pos + 1)
            if trailing != raw.len:
                outError = "thread/list sqlite cwd filter has trailing JSON after array"
            return values
        else:
            outError = "thread/list sqlite cwd filter malformed string array"
            return values
    outError = "thread/list sqlite cwd filter has unterminated string array"
    return values

fn RustCsgThreadListSqliteCwdFiltersJson(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "null" || raw == "[]":
        return ""
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start < raw.len && raw[start] == '"':
        let value = RustCsgThreadListSqliteCwdFilterValue(raw, outError)
        if outError != "":
            return ""
        return RustCsgThreadListSqliteJsonStringArrayOne(value)
    let values = RustCsgThreadListSqliteCwdFilterValuesRaw(raw, outError)
    if outError != "":
        return ""
    if values.len == 0:
        return ""
    var out = "["
    var first: bool
    first = true
    for i in 0..<values.len:
        let normalized = RustCsgNormalizePathRelativeToCurrentDir(values[i])
        if normalized == "" || !RustCsgThreadListSqliteCanonicalAbsolutePath(normalized):
            outError = "thread/list sqlite cwd filter normalization failed"
            return ""
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(normalized))
        first = false
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgThreadListSqliteJsonLooksInt(value: str): bool =
    if value == "":
        return false
    var i: int32
    if value[0] == '-':
        i = 1
    if i >= value.len:
        return false
    while i < value.len:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(value, i, 1))
        if digit < 0:
            return false
        i = i + 1
    return true

fn RustCsgThreadListSqliteLimit(limitJson: str, outError: var str): int32 =
    outError = ""
    if limitJson == "":
        return RustCsgThreadListSqliteDefaultLimit
    if !RustCsgThreadListSqliteJsonLooksInt(limitJson):
        outError = wire.RustCsgCat("invalid thread/list limit: ", limitJson)
        return 0
    var value = wire.RustCsgParseInt32(limitJson)
    if value < 1:
        value = 1
    if value > RustCsgThreadListSqliteMaxLimit:
        value = RustCsgThreadListSqliteMaxLimit
    return value

fn RustCsgThreadListSqliteSortKey(sortKey: str, outError: var str): str =
    outError = ""
    if sortKey == "":
        return "created_at"
    if sortKey == "created_at" || sortKey == "updated_at":
        return sortKey
    outError = wire.RustCsgCat("invalid thread/list sortKey: ", sortKey)
    return ""

fn RustCsgThreadListSqliteSortDirection(sortDirection: str, outError: var str): str =
    outError = ""
    if sortDirection == "":
        return "desc"
    if sortDirection == "asc" || sortDirection == "desc":
        return sortDirection
    outError = wire.RustCsgCat("invalid thread/list sortDirection: ", sortDirection)
    return ""

fn RustCsgThreadListSqliteAllInteractiveSourcesJson(): str =
    return "[\"cli\",\"vscode\",\"{\\\"custom\\\":\\\"atlas\\\"}\",\"{\\\"custom\\\":\\\"chatgpt\\\"}\"]"

fn RustCsgThreadListSqliteAllSourceKindsJson(): str =
    return "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]"

fn RustCsgThreadListSqliteSourceKindRequiresPostFilter(sourceKindsJson: str): bool =
    if sourceKindsJson == "[\"exec\"]":
        return false
    if sourceKindsJson == "[\"appServer\"]":
        return false
    if sourceKindsJson == "[\"unknown\"]":
        return false
    if sourceKindsJson == "[\"subAgent\"]":
        return false
    if sourceKindsJson == "[\"subAgentReview\"]":
        return false
    if sourceKindsJson == "[\"subAgentCompact\"]":
        return false
    if sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return false
    if wire.RustCsgContains(sourceKindsJson, "\"exec\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"appServer\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgent\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentReview\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentCompact\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentThreadSpawn\""):
        return true
    if wire.RustCsgContains(sourceKindsJson, "\"subAgentOther\""):
        return true
    return wire.RustCsgContains(sourceKindsJson, "\"unknown\"")

fn RustCsgThreadListSqliteAllowedSourcesJson(params: var types.RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return RustCsgThreadListSqliteAllInteractiveSourcesJson()
    if params.sourceKindsJson == "[\"exec\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("exec")
    if params.sourceKindsJson == "[\"appServer\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("mcp")
    if params.sourceKindsJson == "[\"unknown\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("unknown")
    if params.sourceKindsJson == "[\"subAgent\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("subagent")
    if params.sourceKindsJson == "[\"subAgentReview\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("subagent_review")
    if params.sourceKindsJson == "[\"subAgentCompact\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("subagent_compact")
    if params.sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("subagent_thread_spawn")
    if params.sourceKindsJson == "[\"subAgentOther\"]":
        return RustCsgThreadListSqliteJsonStringArrayOne("subagent")
    if RustCsgThreadListSqliteSourceKindRequiresPostFilter(params.sourceKindsJson):
        return "[]"
    var out = "["
    var first: bool
    first = true
    if wire.RustCsgContains(params.sourceKindsJson, "\"cli\""):
        out = wire.RustCsgCat(out, "\"cli\"")
        first = false
    if wire.RustCsgContains(params.sourceKindsJson, "\"vscode\""):
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, "\"vscode\"")
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgThreadListSqliteSourceKindPostFilterJson(params: var types.RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return ""
    if params.sourceKindsJson == "[\"exec\"]":
        return ""
    if params.sourceKindsJson == "[\"appServer\"]":
        return ""
    if params.sourceKindsJson == "[\"unknown\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgent\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentReview\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentCompact\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return ""
    return params.sourceKindsJson

fn RustCsgThreadListSqliteModelProviderFilterJson(params: var types.RustCsgThreadListParams,
                                                  fallbackProvider: str): str =
    if params.modelProvidersJson == "":
        return RustCsgThreadListSqliteJsonStringArrayOne(fallbackProvider)
    if params.modelProvidersJson == "[]":
        return ""
    return params.modelProvidersJson

fn RustCsgThreadListSqliteSingleModelProvider(raw: str, outProvider: var str): bool =
    outProvider = ""
    if raw == "" || raw == "[]":
        return true
    let providers = wire.RustCsgJsonStringArrayFromRaw(raw)
    if providers.len == 1:
        outProvider = providers[0]
        return true
    return false

fn RustCsgThreadListSqlitePlanFromParams(params: var types.RustCsgThreadListParams,
                                         fallbackProvider: str): RustCsgThreadListSqlitePlan =
    var result: RustCsgThreadListSqlitePlan
    var err: str
    result.pageSize = RustCsgThreadListSqliteLimit(params.limitJson, err)
    if err != "":
        result.parseError = err
        return result
    result.sortKey = RustCsgThreadListSqliteSortKey(params.sortKey, err)
    if err != "":
        result.parseError = err
        return result
    result.sortDirection = RustCsgThreadListSqliteSortDirection(params.sortDirection, err)
    if err != "":
        result.parseError = err
        return result
    result.modelProviderFilterJson = RustCsgThreadListSqliteModelProviderFilterJson(params, fallbackProvider)
    result.allowedSourcesJson = RustCsgThreadListSqliteAllowedSourcesJson(params)
    result.sourceKindPostFilterJson = RustCsgThreadListSqliteSourceKindPostFilterJson(params)
    result.archived = params.archivedJson == "true"
    result.cwdFiltersJson = params.cwdJson
    result.searchTerm = params.searchTerm
    return result

fn RustCsgThreadListSqliteOrderSql(sortKey: str, sortDirection: str): str =
    if sortKey == "created_at" && sortDirection == "asc":
        return " ORDER BY created_at_ms ASC"
    if sortKey == "created_at" && sortDirection == "desc":
        return " ORDER BY created_at_ms DESC"
    if sortKey == "updated_at" && sortDirection == "asc":
        return " ORDER BY updated_at_ms ASC"
    if sortKey == "updated_at" && sortDirection == "desc":
        return " ORDER BY updated_at_ms DESC"
    return ""

fn RustCsgThreadListSqliteCursor(sortValueMs: int64): str =
    return RustCsgMillisToRfc3339(sortValueMs)

fn RustCsgThreadListSqliteBackwardsCursor(firstSortValueMs: int64, sortDirection: str): str =
    if sortDirection == "desc":
        return RustCsgThreadListSqliteCursor(firstSortValueMs - int64(1))
    return RustCsgThreadListSqliteCursor(firstSortValueMs + int64(1))

fn RustCsgThreadListSqliteAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgThreadListSqliteTrimAsciiSpace(text: str): str =
    var start: int32
    while start < text.len && RustCsgThreadListSqliteAsciiSpace(text[start]):
        start = start + 1
    var end: int32
    end = text.len
    while end > start && RustCsgThreadListSqliteAsciiSpace(text[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(text, start, end - start)

fn RustCsgThreadListSqliteDistinctTitle(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): str =
    let title = RustCsgThreadListSqliteTrimAsciiSpace(row.title)
    if title == "":
        return ""
    if RustCsgThreadListSqliteTrimAsciiSpace(row.firstUserMessage) == title:
        return ""
    return title

fn RustCsgThreadListSqliteThreadFromStateRow(row: var state_db_sqlite.RustCsgStateDbThreadRowResult): types.RustCsgAppThread =
    var thread: types.RustCsgAppThread
    thread.id = row.id
    thread.sessionId = row.id
    thread.name = RustCsgThreadListSqliteDistinctTitle(row)
    thread.cwd = row.cwd
    thread.modelProvider = row.modelProvider
    thread.source = row.source
    thread.path = row.rolloutPath
    thread.createdAt = row.createdAtMs / int64(1000)
    thread.updatedAt = row.updatedAtMs / int64(1000)
    thread.cliVersion = row.cliVersion
    thread.preview = row.firstUserMessage
    thread.statusJson = "{\"type\":\"notLoaded\"}"
    thread.turnsJson = "[]"
    return thread

fn RustCsgThreadListSqliteSortValueFromStateRow(row: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                                sortKey: str): int64 =
    if sortKey == "created_at":
        return row.createdAtMs
    return row.updatedAtMs

fn RustCsgThreadListSqliteAppendRow(dataJson: str,
                                    firstData: bool,
                                    row: var state_db_sqlite.RustCsgStateDbThreadRowResult): str =
    var out = dataJson
    if !firstData:
        out = wire.RustCsgCat(out, ",")
    return wire.RustCsgCat(out, wire.RustCsgAppThreadToJson(RustCsgThreadListSqliteThreadFromStateRow(row)))

fn RustCsgThreadListRowsToResponse(params: var types.RustCsgThreadListParams,
                                   fallbackProvider: str,
                                   row0: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                   row1: var state_db_sqlite.RustCsgStateDbThreadRowResult,
                                   row2: var state_db_sqlite.RustCsgStateDbThreadRowResult): RustCsgThreadListSqliteResult =
    let plan = RustCsgThreadListSqlitePlanFromParams(params, fallbackProvider)
    if plan.parseError != "":
        return RustCsgThreadListSqliteBlocked(plan.parseError)
    if params.cursor != "":
        let cursorMillisText = RustCsgRfc3339ToMillisText(params.cursor)
        if cursorMillisText == "":
            return RustCsgThreadListSqliteBlocked("invalid thread/list sqlite cursor")
    if plan.cwdFiltersJson != "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite cwd filter not ported")
    if plan.sourceKindPostFilterJson != "" &&
       plan.sourceKindPostFilterJson != "[\"cli\"]" &&
       plan.sourceKindPostFilterJson != "[\"vscode\"]" &&
       plan.sourceKindPostFilterJson != "[\"exec\"]" &&
       plan.sourceKindPostFilterJson != "[\"subAgentOther\"]" &&
       plan.sourceKindPostFilterJson != RustCsgThreadListSqliteAllSourceKindsJson():
        return RustCsgThreadListSqliteBlocked("thread/list sqlite source kind post-filter not ported")
    if plan.allowedSourcesJson != RustCsgThreadListSqliteAllInteractiveSourcesJson() &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("cli") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("vscode") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("exec") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("mcp") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("unknown") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_review") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_compact") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_thread_spawn") &&
       plan.allowedSourcesJson != "[]":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite source execution only supports concrete sourceKind SQL slices")
    if RustCsgThreadListSqliteOrderSql(plan.sortKey, plan.sortDirection) == "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite sort not ported")

    var dataJson = "["
    var firstData: bool
    firstData = true
    var appendedRows: int32
    var nextCursor: str
    var backwardsCursor: str
    var firstIncludedSortValue: int64
    var lastIncludedSortValue: int64

    if !row0.ok && !row0.notFound:
        return RustCsgThreadListSqliteError(row0.error)
    if row0.ok && plan.pageSize >= 1 &&
       RustCsgThreadListSqliteRowMatchesSourcePostFilter(row0, plan.sourceKindPostFilterJson):
        firstIncludedSortValue = RustCsgThreadListSqliteSortValueFromStateRow(row0, plan.sortKey)
        lastIncludedSortValue = firstIncludedSortValue
        dataJson = RustCsgThreadListSqliteAppendRow(dataJson, firstData, row0)
        firstData = false
        appendedRows = 1

    if !row1.ok && !row1.notFound:
        return RustCsgThreadListSqliteError(row1.error)
    if row1.ok &&
       RustCsgThreadListSqliteRowMatchesSourcePostFilter(row1, plan.sourceKindPostFilterJson):
        if plan.pageSize == 1:
            nextCursor = RustCsgThreadListSqliteCursor(lastIncludedSortValue)
        elif plan.pageSize >= 2:
            lastIncludedSortValue = RustCsgThreadListSqliteSortValueFromStateRow(row1, plan.sortKey)
            dataJson = RustCsgThreadListSqliteAppendRow(dataJson, firstData, row1)
            firstData = false
            appendedRows = appendedRows + 1

    if plan.pageSize >= 2:
        if !row2.ok && !row2.notFound:
            return RustCsgThreadListSqliteError(row2.error)
        if row2.ok &&
           RustCsgThreadListSqliteRowMatchesSourcePostFilter(row2, plan.sourceKindPostFilterJson):
            if plan.pageSize == 2:
                nextCursor = RustCsgThreadListSqliteCursor(lastIncludedSortValue)
            else:
                lastIncludedSortValue = RustCsgThreadListSqliteSortValueFromStateRow(row2, plan.sortKey)
                dataJson = RustCsgThreadListSqliteAppendRow(dataJson, firstData, row2)
                firstData = false
                appendedRows = appendedRows + 1

    dataJson = wire.RustCsgCat(dataJson, "]")

    var response: types.RustCsgThreadListResponse
    response.dataJson = dataJson
    response.nextCursor = nextCursor
    if appendedRows > 0:
        backwardsCursor = RustCsgThreadListSqliteBackwardsCursor(firstIncludedSortValue, plan.sortDirection)
    response.backwardsCursor = backwardsCursor
    var result: RustCsgThreadListSqliteResult
    result.ok = true
    result.response = response
    result.rowCount = appendedRows
    return result

fn RustCsgThreadListPageToResponse(params: var types.RustCsgThreadListParams,
                                   fallbackProvider: str,
                                   page: var state_db_sqlite.RustCsgStateDbThreadPageResult): RustCsgThreadListSqliteResult =
    let plan = RustCsgThreadListSqlitePlanFromParams(params, fallbackProvider)
    if plan.parseError != "":
        return RustCsgThreadListSqliteBlocked(plan.parseError)
    if params.cursor != "":
        let cursorMillisText = RustCsgRfc3339ToMillisText(params.cursor)
        if cursorMillisText == "":
            return RustCsgThreadListSqliteBlocked("invalid thread/list sqlite cursor")
    if plan.cwdFiltersJson != "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite cwd filter not ported")
    if plan.sourceKindPostFilterJson != "" &&
       plan.sourceKindPostFilterJson != "[\"cli\"]" &&
       plan.sourceKindPostFilterJson != "[\"vscode\"]" &&
       plan.sourceKindPostFilterJson != "[\"exec\"]" &&
       plan.sourceKindPostFilterJson != "[\"subAgentOther\"]" &&
       plan.sourceKindPostFilterJson != RustCsgThreadListSqliteAllSourceKindsJson():
        return RustCsgThreadListSqliteBlocked("thread/list sqlite source kind post-filter not ported")
    if plan.allowedSourcesJson != RustCsgThreadListSqliteAllInteractiveSourcesJson() &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("cli") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("vscode") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("exec") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("mcp") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("unknown") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_review") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_compact") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_thread_spawn") &&
       plan.allowedSourcesJson != "[]":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite source execution only supports concrete sourceKind SQL slices")
    if RustCsgThreadListSqliteOrderSql(plan.sortKey, plan.sortDirection) == "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite sort not ported")
    if !page.ok:
        return RustCsgThreadListSqliteError(page.error)

    var dataJson = "["
    var firstData: bool
    firstData = true
    var appendedRows: int32
    var nextCursor: str
    var backwardsCursor: str
    var firstIncludedSortValue: int64
    var lastIncludedSortValue: int64

    for i in 0..<page.rows.len:
        var row = page.rows[i]
        if !row.ok:
            return RustCsgThreadListSqliteError(row.error)
        if !RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, plan.sourceKindPostFilterJson):
            continue
        if appendedRows >= plan.pageSize:
            nextCursor = RustCsgThreadListSqliteCursor(lastIncludedSortValue)
            break
        let sortValue = RustCsgThreadListSqliteSortValueFromStateRow(row, plan.sortKey)
        if appendedRows == 0:
            firstIncludedSortValue = sortValue
        lastIncludedSortValue = sortValue
        dataJson = RustCsgThreadListSqliteAppendRow(dataJson, firstData, row)
        firstData = false
        appendedRows = appendedRows + 1

    dataJson = wire.RustCsgCat(dataJson, "]")

    var response: types.RustCsgThreadListResponse
    response.dataJson = dataJson
    response.nextCursor = nextCursor
    if appendedRows > 0:
        backwardsCursor = RustCsgThreadListSqliteBackwardsCursor(firstIncludedSortValue, plan.sortDirection)
    response.backwardsCursor = backwardsCursor
    var result: RustCsgThreadListSqliteResult
    result.ok = true
    result.response = response
    result.rowCount = appendedRows
    return result

fn RustCsgThreadListScalarPageFromSqlite(dbPath: str,
                                         params: var types.RustCsgThreadListParams,
                                         plan: var RustCsgThreadListSqlitePlan,
                                         modelProvider: str,
                                         cwdFilter: str,
                                         cursorMillisText: str): RustCsgThreadListSqliteResult =
    if plan.sourceKindPostFilterJson != "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite scalar page only supports SQL source filters")
    if RustCsgThreadListSqliteOrderSql(plan.sortKey, plan.sortDirection) == "":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite sort not ported")

    var dataJson = "["
    var firstData: bool
    firstData = true
    var appendedRows: int32
    var nextCursor: str
    var backwardsCursor: str
    var firstIncludedSortValue: int64
    var lastIncludedSortValue: int64
    var offset: int32
    let scanLimit = plan.pageSize + 1

    while offset < scanLimit:
        var row = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                                             plan.sortKey,
                                                                             plan.sortDirection,
                                                                             plan.archived,
                                                                             offset,
                                                                             plan.allowedSourcesJson,
                                                                             modelProvider,
                                                                             cwdFilter,
                                                                             plan.searchTerm,
                                                                             cursorMillisText)
        if !row.ok:
            if row.notFound:
                break
            return RustCsgThreadListSqliteError(row.error)
        if RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, plan.sourceKindPostFilterJson):
            if appendedRows >= plan.pageSize:
                nextCursor = RustCsgThreadListSqliteCursor(lastIncludedSortValue)
                break
            let sortValue = RustCsgThreadListSqliteSortValueFromStateRow(row, plan.sortKey)
            if appendedRows == 0:
                firstIncludedSortValue = sortValue
            lastIncludedSortValue = sortValue
            dataJson = RustCsgThreadListSqliteAppendRow(dataJson, firstData, row)
            firstData = false
            appendedRows = appendedRows + 1
        offset = offset + 1

    dataJson = wire.RustCsgCat(dataJson, "]")

    var response: types.RustCsgThreadListResponse
    response.dataJson = dataJson
    response.nextCursor = nextCursor
    if appendedRows > 0:
        backwardsCursor = RustCsgThreadListSqliteBackwardsCursor(firstIncludedSortValue, plan.sortDirection)
    response.backwardsCursor = backwardsCursor
    var result: RustCsgThreadListSqliteResult
    result.ok = true
    result.response = response
    result.rowCount = appendedRows
    return result

fn RustCsgThreadListFromSqlite(dbPath: str,
                               params: var types.RustCsgThreadListParams,
                               fallbackProvider: str): RustCsgThreadListSqliteResult =
    let plan = RustCsgThreadListSqlitePlanFromParams(params, fallbackProvider)
    if plan.parseError != "":
        return RustCsgThreadListSqliteBlocked(plan.parseError)
    var cwdFilterError: str
    let cwdFiltersJson = RustCsgThreadListSqliteCwdFiltersJson(plan.cwdFiltersJson,
                                                               cwdFilterError)
    if cwdFilterError != "":
        return RustCsgThreadListSqliteBlocked(cwdFilterError)
    var modelProviderError: str
    let modelProvidersJson = RustCsgThreadListSqliteValidateModelProvidersJson(plan.modelProviderFilterJson,
                                                                                modelProviderError)
    if modelProviderError != "":
        return RustCsgThreadListSqliteBlocked(modelProviderError)
    if plan.allowedSourcesJson != RustCsgThreadListSqliteAllInteractiveSourcesJson() &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("cli") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("vscode") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("exec") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("mcp") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("unknown") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_review") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_compact") &&
       plan.allowedSourcesJson != RustCsgThreadListSqliteJsonStringArrayOne("subagent_thread_spawn") &&
       plan.allowedSourcesJson != "[]":
        return RustCsgThreadListSqliteBlocked("thread/list sqlite source execution only supports concrete sourceKind SQL slices")

    var scalarModelProvider: str
    let scalarProviderOk = RustCsgThreadListSqliteSingleModelProvider(modelProvidersJson, scalarModelProvider)
    if cwdFiltersJson == "" &&
       plan.sourceKindPostFilterJson == "" &&
       scalarProviderOk:
        var scalarCursorMillisText: str
        if params.cursor != "":
            scalarCursorMillisText = RustCsgRfc3339ToMillisText(params.cursor)
            if scalarCursorMillisText == "":
                return RustCsgThreadListSqliteBlocked("invalid thread/list sqlite cursor")
        return RustCsgThreadListScalarPageFromSqlite(dbPath,
                                                     params,
                                                     plan,
                                                     scalarModelProvider,
                                                     "",
                                                     scalarCursorMillisText)

    if plan.pageSize <= 3 &&
       params.cursor == "" &&
       cwdFiltersJson == "" &&
       plan.searchTerm == "" &&
       modelProvidersJson == RustCsgThreadListSqliteJsonStringArrayOne(fallbackProvider):
        var row0 = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                                              plan.sortKey,
                                                                              plan.sortDirection,
                                                                              plan.archived,
                                                                              0,
                                                                              plan.allowedSourcesJson,
                                                                              fallbackProvider,
                                                                              "",
                                                                              "",
                                                                              "")
        var row1 = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                                              plan.sortKey,
                                                                              plan.sortDirection,
                                                                              plan.archived,
                                                                              1,
                                                                              plan.allowedSourcesJson,
                                                                              fallbackProvider,
                                                                              "",
                                                                              "",
                                                                              "")
        var row2 = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredWithCwd(dbPath,
                                                                              plan.sortKey,
                                                                              plan.sortDirection,
                                                                              plan.archived,
                                                                              2,
                                                                              plan.allowedSourcesJson,
                                                                              fallbackProvider,
                                                                              "",
                                                                              "",
                                                                              "")
        return RustCsgThreadListRowsToResponse(params,
                                               fallbackProvider,
                                               row0,
                                               row1,
                                               row2)

    if params.cursor != "":
        let cursorMillisText = RustCsgRfc3339ToMillisText(params.cursor)
        if cursorMillisText == "":
            return RustCsgThreadListSqliteBlocked("invalid thread/list sqlite cursor")
        var pageRowsAfter = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                                  plan.sortKey,
                                                                                                  plan.sortDirection,
                                                                                                  plan.archived,
                                                                                                  plan.allowedSourcesJson,
                                                                                                  modelProvidersJson,
                                                                                                  cwdFiltersJson,
                                                                                                  plan.searchTerm,
                                                                                                  cursorMillisText,
                                                                                                  plan.pageSize + 1)
        var responseParamsAfter = params
        responseParamsAfter.cursor = ""
        responseParamsAfter.cwdJson = ""
        responseParamsAfter.searchTerm = ""
        return RustCsgThreadListPageToResponse(responseParamsAfter,
                                               fallbackProvider,
                                               pageRowsAfter)

    var pageRows = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                        plan.sortKey,
                                                                                        plan.sortDirection,
                                                                                        plan.archived,
                                                                                        plan.allowedSourcesJson,
                                                                                        modelProvidersJson,
                                                                                        cwdFiltersJson,
                                                                                        plan.searchTerm,
                                                                                        "",
                                                                                        plan.pageSize + 1)
    var responseParams = params
    responseParams.cursor = ""
    responseParams.cwdJson = ""
    responseParams.searchTerm = ""
    return RustCsgThreadListPageToResponse(responseParams,
                                           fallbackProvider,
                                           pageRows)
