fn rustCsgAppServerHandlePluginList(id: int32): str =
    return rustCsgAppServerResponse(id, "{\"plugins\":[]}")

fn rustCsgAppServerHandlePluginInstall(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pluginId = wire.RustCsgJsonFindStr(paramsJson, "pluginId")
    if pluginId == "":
        return rustCsgAppServerError(id, -32602, "pluginId is required")
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32000, pathError)
    let pluginsDir = home.RustCsgPathJoinChild(codexHome, "plugins")
    let parentOk = rustCsgAppServerEnsureDirectory(pluginsDir)
    if !parentOk:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to create plugins directory")
    let pluginDir = home.RustCsgPathJoinChild(pluginsDir, pluginId)
    let mkdirOk = rustCsgAppServerMkdir(pluginDir)
    if mkdirOk == 0:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to create plugin directory")
    let manifestPath = home.RustCsgPathJoinChild(pluginDir, "manifest.json")
    var manifest = "{"
    manifest = wire.RustCsgCat(manifest, wire.RustCsgJsonFieldStr("pluginId", pluginId))
    let url = wire.RustCsgJsonFindOptionalStr(paramsJson, "url")
    if url != "":
        manifest = wire.RustCsgCat(manifest, ",")
        manifest = wire.RustCsgCat(manifest, wire.RustCsgJsonFieldStr("url", url))
    manifest = wire.RustCsgCat(manifest, "}")
    let wrote = rustCsgAppServerWriteFile(manifestPath, manifest)
    if wrote == 0:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to write manifest")
    return rustCsgAppServerResponse(id, "{\"installed\":true}")

# ── environment handlers ──────────────────────────────────────────────────

fn rustCsgAppServerHandleEnvironmentGet(id: int32): str =
    var cwd = RustCsgExecCommand("pwd")
    if cwd != "" && cwd[cwd.len - 1] == '\n':
        cwd = strings.SliceBytes(cwd, 0, cwd.len - 1)
    let home = RustCsgGetEnv("HOME")
    let shell = RustCsgGetEnv("SHELL")
    var tmpDir = RustCsgGetEnv("TMPDIR")
    if tmpDir == "":
        tmpDir = "/tmp"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("os", "darwin"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("arch", "arm64"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("home", home))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("shell", shell))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("tmpDir", tmpDir))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerHandleEnvironmentListVariables(id: int32): str =
    let envOutput = RustCsgExecCommand("env | cut -d= -f1")
    var names: str[]
    if envOutput != "":
        var lineStart: int32
        var i: int32
        while i < envOutput.len:
            if envOutput[i] == '\n':
                let varName = strings.SliceBytes(envOutput, lineStart, i - lineStart)
                lineStart = i + 1
                if varName != "":
                    add(names, varName)
                i = i + 1
                continue
            i = i + 1
        if lineStart < envOutput.len:
            let varName = strings.SliceBytes(envOutput, lineStart, envOutput.len - lineStart)
            if varName != "":
                add(names, varName)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("variables", wire.RustCsgJsonStringArray(names)))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── feedback handlers ─────────────────────────────────────────────────────

fn rustCsgAppServerHandleFeedbackSend(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let message = wire.RustCsgJsonFindStr(paramsJson, "message")
    if message == "":
        return rustCsgAppServerError(id, -32602, "message must not be empty")
    let category = wire.RustCsgJsonFindStr(paramsJson, "category")
    if category == "":
        return rustCsgAppServerError(id, -32602, "category must not be empty")
    if category != "bug" && category != "feature" && category != "general":
        return rustCsgAppServerError(id, -32602, "category must be one of: bug, feature, general")
    let threadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    var codexHome = RustCsgGetEnv("CODEX_HOME")
    if codexHome == "":
        let homeDir = RustCsgGetEnv("HOME")
        codexHome = wire.RustCsgCat(homeDir, "/.codex")
    let feedbackPath = wire.RustCsgCat3(codexHome, "/", "feedback.jsonl")
    var feedbackEntry = "{"
    feedbackEntry = wire.RustCsgCat(feedbackEntry, wire.RustCsgJsonFieldStr("message", message))
    feedbackEntry = wire.RustCsgCat(feedbackEntry, ",")
    feedbackEntry = wire.RustCsgCat(feedbackEntry, wire.RustCsgJsonFieldStr("category", category))
    if threadId != "":
        feedbackEntry = wire.RustCsgCat(feedbackEntry, ",")
        feedbackEntry = wire.RustCsgCat(feedbackEntry, wire.RustCsgJsonFieldStr("threadId", threadId))
    feedbackEntry = wire.RustCsgCat(feedbackEntry, "}\n")
    let ok = RustCsgFileAppend(feedbackPath, feedbackEntry)
    if ok == 0:
        return rustCsgAppServerError(id, -32603, "failed to write feedback")
    var out = "{"
    out = wire.RustCsgCat(out, "\"received\":true,")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", "Thank you for your feedback"))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

