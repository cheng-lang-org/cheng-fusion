fn rustCsgAppServerStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn rustCsgAppServerInlineFlagValue(arg: str, key: str, outValue: var str): bool =
    outValue = ""
    if arg.len <= key.len:
        return false
    if !rustCsgAppServerStartsWith(arg, key):
        return false
    let sep = arg[key.len]
    if sep != '=' && sep != ':':
        return false
    outValue = strings.SliceBytes(arg, key.len + 1, arg.len - key.len - 1)
    return true

fn rustCsgAppServerUnsupportedListenMessage(value: str): str =
    let head = strings.ConcatStr("unsupported --listen URL `", value)
    return strings.ConcatStr(head, "`; expected `stdio://`, `unix://`, `unix://PATH`, `ws://IP:PORT`, or `off`")

fn rustCsgAppServerInvalidSessionSourceMessage(value: str): str =
    let head = strings.ConcatStr("invalid --session-source value `", value)
    return strings.ConcatStr(head, "`; expected `vscode`, `desktop`, or `cli`")

fn rustCsgAppServerEnsureDirectory(path: str): bool =
    let made = rustCsgAppServerMkdir(path)
    if made != 0:
        return true
    let statJson = rustCsgAppServerPathStat(path)
    if statJson == "":
        return false
    return wire.RustCsgContains(statJson, "\"isDirectory\":true")

fn rustCsgAppServerDeletePluginDirectoryIfPresent(pluginDir: str): bool =
    let statJson = rustCsgAppServerPathStat(pluginDir)
    if statJson == "":
        return true
    if !wire.RustCsgContains(statJson, "\"isDirectory\":true"):
        return false
    let manifestPath = home.RustCsgPathJoinChild(pluginDir, "manifest.json")
    rustCsgAppServerFileDelete(manifestPath)
    let deleted = rustCsgAppServerFileDelete(pluginDir)
    return deleted != 0

fn rustCsgAppServerIsValidSessionSource(value: str): bool =
    if value == "vscode":
        return true
    if value == "desktop":
        return true
    if value == "cli":
        return true
    return false

fn rustCsgAppServerIsKnownListenUrl(value: str): bool =
    if value == "stdio://":
        return true
    if value == "off":
        return true
    if rustCsgAppServerStartsWith(value, "unix://"):
        return true
    if rustCsgAppServerStartsWith(value, "ws://"):
        return true
    return false

fn rustCsgAppServerFindHeaderEnd(text: str): int32 =
    var i: int32
    while i + 4 <= text.len:
        if text[i] == '\r' && text[i + 1] == '\n' && text[i + 2] == '\r' && text[i + 3] == '\n':
            return i
        i = i + 1
    return -1

fn rustCsgAppServerParseContentLength(header: str): int32 =
    let prefix: str = "Content-Length:"
    var i: int32
    while i + prefix.len <= header.len:
        var matched: bool = true
        for j in 0..<prefix.len:
            if header[i + j] != prefix[j]:
                matched = false
                break
        if matched:
            i = i + prefix.len
            while i < header.len && (header[i] == ' ' || header[i] == '\t'):
                i = i + 1
            var value: int32
            var sawDigit: bool
            while i < header.len && header[i] >= '0' && header[i] <= '9':
                value = value * 10 + (int32(header[i]) - int32('0'))
                sawDigit = true
                i = i + 1
            if !sawDigit:
                return -1
            return value
        i = i + 1
    return -1

fn rustCsgAppServerTryReadContentLengthFrame(buffer: str): RustCsgAppServerFrame =
    var out: RustCsgAppServerFrame
    let headerEnd = rustCsgAppServerFindHeaderEnd(buffer)
    if headerEnd < 0:
        out.blocked = true
        return out
    let header = strings.SliceBytes(buffer, 0, headerEnd)
    let contentLength = rustCsgAppServerParseContentLength(header)
    if contentLength < 0:
        return out
    let bodyStart = headerEnd + 4
    if buffer.len < bodyStart + contentLength:
        out.blocked = true
        return out
    out.body = strings.SliceBytes(buffer, bodyStart, contentLength)
    out.rest = strings.SliceBytes(buffer, bodyStart + contentLength, buffer.len - bodyStart - contentLength)
    out.ok = true
    return out

fn rustCsgAppServerTryReadJsonLine(buffer: str): RustCsgAppServerFrame =
    var out: RustCsgAppServerFrame
    var newlineAt: int32 = -1
    for i in 0..<buffer.len:
        if buffer[i] == '\n':
            newlineAt = i
            break
    if newlineAt < 0:
        out.blocked = true
        return out
    var lineLen = newlineAt
    if lineLen > 0:
        if buffer[lineLen - 1] == '\r':
            lineLen = lineLen - 1
    out.body = strings.SliceBytes(buffer, 0, lineLen)
    out.rest = strings.SliceBytes(buffer, newlineAt + 1, buffer.len - newlineAt - 1)
    out.ok = true
    return out

fn rustCsgAppServerTryReadStdioMessage(buffer: str): RustCsgAppServerFrame =
    if rustCsgAppServerStartsWith(buffer, "Content-Length:"):
        return rustCsgAppServerTryReadContentLengthFrame(buffer)
    return rustCsgAppServerTryReadJsonLine(buffer)

fn rustCsgAppServerWriteAll(fd: int32, data: str): bool =
    var offset: int32
    while offset < data.len:
        let chunk = strings.SliceBytes(data, offset, data.len - offset)
        let wrote = process.ProcessWriteFd(fd, chunk)
        if wrote <= 0:
            return false
        offset = offset + wrote
    return true

fn rustCsgAppServerWriteJsonMessage(fd: int32, writerKind: int32, body: str): bool =
    if body.len == 0:
        return true
    if writerKind == 2:
        return rustCsgAppServerWriteAll(fd, wire.RustCsgCat(body, "\n"))
    if writerKind == 3:
        return tcp.RustCsgWebSocketWriteFrame(fd, body) == 0
    return false

fn rustCsgAppServerWriteStderrLine(text: str) =
    if text != "":
        process.ProcessWriteFd(2, wire.RustCsgCat(text, "\n"))

fn rustCsgAppServerRequestId(body: str): int32 =
    if wire.RustCsgContains(body, "\"id\""):
        return wire.RustCsgJsonFindInt32(body, "id")
    return 0

fn rustCsgAppServerResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgAppServerError(id: int32, code: int32, message: str): str =
    let errorHead = wire.RustCsgCat3("{\"error\":{\"code\":", strings.IntToStr(code), ",\"message\":")
    let errorBody = wire.RustCsgCat3(errorHead, wire.RustCsgJsonQuote(message), "}")
    return wire.RustCsgCat3(errorBody, wire.RustCsgCat3(",\"id\":", strings.IntToStr(id), ""), "}")

fn rustCsgAppServerResetFsWatches() =
    RustCsgAppServerWatchIds = []
    RustCsgAppServerWatchPaths = []
    RustCsgAppServerWatchConnectionIds = []

fn rustCsgAppServerResetFsWatchesForConnection(connectionId: int32) =
    var nextIds: str[]
    var nextPaths: str[]
    var nextConnectionIds: int32[]
    var i: int32
    while i < RustCsgAppServerWatchIds.len && i < RustCsgAppServerWatchPaths.len && i < RustCsgAppServerWatchConnectionIds.len:
        if RustCsgAppServerWatchConnectionIds[i] != connectionId:
            add(nextIds, RustCsgAppServerWatchIds[i])
            add(nextPaths, RustCsgAppServerWatchPaths[i])
            add(nextConnectionIds, RustCsgAppServerWatchConnectionIds[i])
        i = i + 1
    RustCsgAppServerWatchIds = nextIds
    RustCsgAppServerWatchPaths = nextPaths
    RustCsgAppServerWatchConnectionIds = nextConnectionIds

fn rustCsgAppServerLoadedThreadIndex(threadId: str): int32 =
    var i: int32
    while i < RustCsgAppServerLoadedThreadIds.len:
        if RustCsgAppServerLoadedThreadIds[i] == threadId:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerMarkThreadLoaded(threadId: str) =
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", "", "", "")

fn rustCsgAppServerMarkThreadLoadedWithDynamicTools(threadId: str, dynamicToolsJson: str) =
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, dynamicToolsJson, "", "", "")

fn rustCsgAppServerMarkThreadLoadedFromResume(threadId: str, baseInstructions: str) =
    if rustCsgAppServerLoadedThreadIndex(threadId) >= 0:
        return
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", baseInstructions, "", "")

fn rustCsgAppServerMarkThreadLoadedWithSession(threadId: str, dynamicToolsJson: str, baseInstructions: str) =
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, dynamicToolsJson, baseInstructions, "", "")

fn rustCsgAppServerMarkThreadLoadedWithFullSession(threadId: str,
                                                   dynamicToolsJson: str,
                                                   baseInstructions: str,
                                                   developerInstructions: str,
                                                   historyJson: str) =
    if threadId == "":
        return
    let existingIndex = rustCsgAppServerLoadedThreadIndex(threadId)
    if existingIndex >= 0:
        if dynamicToolsJson != "" && existingIndex < RustCsgAppServerLoadedThreadDynamicToolsJson.len:
            RustCsgAppServerLoadedThreadDynamicToolsJson[existingIndex] = dynamicToolsJson
        if baseInstructions != "" && existingIndex < RustCsgAppServerLoadedThreadBaseInstructions.len:
            RustCsgAppServerLoadedThreadBaseInstructions[existingIndex] = baseInstructions
        if developerInstructions != "" && existingIndex < RustCsgAppServerLoadedThreadDeveloperInstructions.len:
            RustCsgAppServerLoadedThreadDeveloperInstructions[existingIndex] = developerInstructions
        if historyJson != "" && existingIndex < RustCsgAppServerLoadedThreadHistoryJson.len:
            RustCsgAppServerLoadedThreadHistoryJson[existingIndex] = historyJson
        return
    add(RustCsgAppServerLoadedThreadIds, threadId)
    add(RustCsgAppServerLoadedThreadDynamicToolsJson, dynamicToolsJson)
    add(RustCsgAppServerLoadedThreadBaseInstructions, baseInstructions)
    add(RustCsgAppServerLoadedThreadDeveloperInstructions, developerInstructions)
    add(RustCsgAppServerLoadedThreadHistoryJson, historyJson)
    add(RustCsgAppServerLoadedThreadSources, "")
    add(RustCsgAppServerLoadedThreadSandboxTags, "none")

fn rustCsgAppServerRememberThreadSource(threadId: str, threadSource: str) =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index < 0:
        return
    while RustCsgAppServerLoadedThreadSources.len <= index:
        add(RustCsgAppServerLoadedThreadSources, "")
    RustCsgAppServerLoadedThreadSources[index] = threadSource

fn rustCsgAppServerThreadSourceFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    return wire.RustCsgJsonFindOptionalStr(paramsJson, "threadSource")

fn rustCsgAppServerSandboxTagFromType(sandboxType: str): str =
    if sandboxType == "dangerFullAccess" || sandboxType == "danger-full-access":
        return "none"
    if sandboxType == "readOnly" || sandboxType == "read-only":
        return "seatbelt"
    if sandboxType == "workspaceWrite" || sandboxType == "workspace-write":
        return "seatbelt"
    if sandboxType == "externalSandbox" || sandboxType == "external-sandbox":
        return "external"
    return ""

fn rustCsgAppServerSandboxTagFromSandboxJson(sandboxJson: str): str =
    if sandboxJson == "" || sandboxJson == "null":
        return ""
    if sandboxJson[0] != '{':
        return ""
    let sandboxType = wire.RustCsgJsonFindOptionalStr(sandboxJson, "type")
    return rustCsgAppServerSandboxTagFromType(sandboxType)

fn rustCsgAppServerSandboxTagFromPermissionsJson(permissionsJson: str): str =
    if permissionsJson == "" || permissionsJson == "null":
        return ""
    if permissionsJson[0] != '"':
        return ""
    let permissionName = wire.RustCsgSliceBytes(permissionsJson, 1, permissionsJson.len - 2)
    if permissionName == ":danger-full-access":
        return "none"
    if permissionName == ":read-only" || permissionName == ":workspace":
        return "seatbelt"
    return ""

fn rustCsgAppServerThreadLifecycleSandboxTagFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let sandboxTag = rustCsgAppServerSandboxTagFromSandboxJson(wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "sandbox"))
    if sandboxTag != "":
        return sandboxTag
    let permissionsTag = rustCsgAppServerSandboxTagFromPermissionsJson(wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "permissions"))
    if permissionsTag != "":
        return permissionsTag
    return "none"

fn rustCsgAppServerTurnSandboxTagOverrideFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let sandboxTag = rustCsgAppServerSandboxTagFromSandboxJson(wire.RustCsgJsonFindOptionalObject(paramsJson, "sandboxPolicy"))
    if sandboxTag != "":
        return sandboxTag
    return rustCsgAppServerSandboxTagFromPermissionsJson(wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "permissions"))

fn rustCsgAppServerRememberThreadSandboxTag(threadId: str, sandboxTag: str) =
    if sandboxTag == "":
        return
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index < 0:
        return
    while RustCsgAppServerLoadedThreadSandboxTags.len <= index:
        add(RustCsgAppServerLoadedThreadSandboxTags, "none")
    RustCsgAppServerLoadedThreadSandboxTags[index] = sandboxTag

fn rustCsgAppServerThreadSourceForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadSources.len:
        return RustCsgAppServerLoadedThreadSources[index]
    return ""

fn rustCsgAppServerSandboxTagForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadSandboxTags.len:
        return RustCsgAppServerLoadedThreadSandboxTags[index]
    return "none"

fn rustCsgAppServerDynamicToolsForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadDynamicToolsJson.len:
        return RustCsgAppServerLoadedThreadDynamicToolsJson[index]
    return ""

fn rustCsgAppServerBaseInstructionsForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadBaseInstructions.len:
        return RustCsgAppServerLoadedThreadBaseInstructions[index]
    return ""

fn rustCsgAppServerDeveloperInstructionsForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadDeveloperInstructions.len:
        return RustCsgAppServerLoadedThreadDeveloperInstructions[index]
    return ""

fn rustCsgAppServerHistoryJsonForThread(threadId: str): str =
    let index = rustCsgAppServerLoadedThreadIndex(threadId)
    if index >= 0 && index < RustCsgAppServerLoadedThreadHistoryJson.len:
        return RustCsgAppServerLoadedThreadHistoryJson[index]
    return ""

fn rustCsgAppServerDynamicToolsFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    return wire.RustCsgJsonFindOptionalArray(paramsJson, "dynamicTools")

fn rustCsgAppServerDeveloperInstructionsFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    return wire.RustCsgJsonFindOptionalStr(paramsJson, "developerInstructions")

fn rustCsgAppServerHistoryJsonFromRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    return wire.RustCsgJsonFindOptionalArray(paramsJson, "history")

fn rustCsgAppServerRequestHasBaseInstructions(paramsJson: str): bool =
    let raw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "baseInstructions")
    return raw != "" && raw != "null"

fn rustCsgAppServerModelFromParamsOrDefault(paramsJson: str): str =
    let model = wire.RustCsgJsonFindOptionalStr(paramsJson, "model")
    if model != "":
        return model
    return models_manager.RustCsgModelsManagerDefaultModel()

fn rustCsgAppServerDefaultBaseInstructionsFromParams(paramsJson: str): str =
    let model = rustCsgAppServerModelFromParamsOrDefault(paramsJson)
    let personalityRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "personality")
    return models_manager.RustCsgModelsManagerModelInstructions(model, personalityRaw)

fn rustCsgAppServerEffectiveBaseInstructionsFromStartRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    if rustCsgAppServerRequestHasBaseInstructions(paramsJson):
        return wire.RustCsgJsonFindOptionalStr(paramsJson, "baseInstructions")
    return rustCsgAppServerDefaultBaseInstructionsFromParams(paramsJson)

fn rustCsgAppServerBaseInstructionsFromRolloutPath(path: str, outPresent: var bool): str =
    outPresent = false
    if path == "":
        return ""
    let raw = rollout_reader.RustCsgRolloutLatestSessionMetaBaseInstructionsRaw(path)
    if raw == "":
        return ""
    outPresent = true
    return rollout_reader.RustCsgRolloutSessionMetaBaseInstructionsText(raw)

fn rustCsgAppServerEffectiveBaseInstructionsFromForkRequest(body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    if rustCsgAppServerRequestHasBaseInstructions(paramsJson):
        return wire.RustCsgJsonFindOptionalStr(paramsJson, "baseInstructions")
    var present: bool
    let rolloutBase = rustCsgAppServerBaseInstructionsFromRolloutPath(wire.RustCsgJsonFindOptionalStr(paramsJson, "path"), present)
    if present:
        return rolloutBase
    return rustCsgAppServerDefaultBaseInstructionsFromParams(paramsJson)

fn rustCsgAppServerEffectiveBaseInstructionsFromResumeRequest(body: str, response: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    if rustCsgAppServerRequestHasBaseInstructions(paramsJson):
        return wire.RustCsgJsonFindOptionalStr(paramsJson, "baseInstructions")
    var rolloutPath = wire.RustCsgJsonFindOptionalStr(paramsJson, "path")
    if rolloutPath == "":
        rolloutPath = thread_handler.RustCsgAppServerThreadPathFromLifecycleResponse(response)
    var present: bool
    let rolloutBase = rustCsgAppServerBaseInstructionsFromRolloutPath(rolloutPath, present)
    if present:
        return rolloutBase
    return rustCsgAppServerDefaultBaseInstructionsFromParams(paramsJson)

fn rustCsgAppServerRemoveLoadedThread(threadId: str) =
    var nextIds: str[]
    var nextDynamicTools: str[]
    var nextBaseInstructions: str[]
    var nextDeveloperInstructions: str[]
    var nextHistoryJson: str[]
    var nextSources: str[]
    var nextSandboxTags: str[]
    var i: int32
    while i < RustCsgAppServerLoadedThreadIds.len:
        if RustCsgAppServerLoadedThreadIds[i] != threadId:
            add(nextIds, RustCsgAppServerLoadedThreadIds[i])
            if i < RustCsgAppServerLoadedThreadDynamicToolsJson.len:
                add(nextDynamicTools, RustCsgAppServerLoadedThreadDynamicToolsJson[i])
            else:
                add(nextDynamicTools, "")
            if i < RustCsgAppServerLoadedThreadBaseInstructions.len:
                add(nextBaseInstructions, RustCsgAppServerLoadedThreadBaseInstructions[i])
            else:
                add(nextBaseInstructions, "")
            if i < RustCsgAppServerLoadedThreadDeveloperInstructions.len:
                add(nextDeveloperInstructions, RustCsgAppServerLoadedThreadDeveloperInstructions[i])
            else:
                add(nextDeveloperInstructions, "")
            if i < RustCsgAppServerLoadedThreadHistoryJson.len:
                add(nextHistoryJson, RustCsgAppServerLoadedThreadHistoryJson[i])
            else:
                add(nextHistoryJson, "")
            if i < RustCsgAppServerLoadedThreadSources.len:
                add(nextSources, RustCsgAppServerLoadedThreadSources[i])
            else:
                add(nextSources, "")
            if i < RustCsgAppServerLoadedThreadSandboxTags.len:
                add(nextSandboxTags, RustCsgAppServerLoadedThreadSandboxTags[i])
            else:
                add(nextSandboxTags, "none")
        i = i + 1
    RustCsgAppServerLoadedThreadIds = nextIds
    RustCsgAppServerLoadedThreadDynamicToolsJson = nextDynamicTools
    RustCsgAppServerLoadedThreadBaseInstructions = nextBaseInstructions
    RustCsgAppServerLoadedThreadDeveloperInstructions = nextDeveloperInstructions
    RustCsgAppServerLoadedThreadHistoryJson = nextHistoryJson
    RustCsgAppServerLoadedThreadSources = nextSources
    RustCsgAppServerLoadedThreadSandboxTags = nextSandboxTags
    var nextSubscriptionIds: str[]
    var nextConnectionIds: int32[]
    var subI: int32
    while subI < RustCsgAppServerThreadSubscriptionIds.len && subI < RustCsgAppServerThreadSubscriptionConnectionIds.len:
        if RustCsgAppServerThreadSubscriptionIds[subI] != threadId:
            add(nextSubscriptionIds, RustCsgAppServerThreadSubscriptionIds[subI])
            add(nextConnectionIds, RustCsgAppServerThreadSubscriptionConnectionIds[subI])
        subI = subI + 1
    RustCsgAppServerThreadSubscriptionIds = nextSubscriptionIds
    RustCsgAppServerThreadSubscriptionConnectionIds = nextConnectionIds
    rustCsgAppServerRemoveActiveTurn(threadId)

fn rustCsgAppServerActiveTurnIndex(threadId: str): int32 =
    var i: int32
    while i < RustCsgAppServerActiveTurnThreadIds.len && i < RustCsgAppServerActiveTurnIds.len:
        if RustCsgAppServerActiveTurnThreadIds[i] == threadId:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerActiveTurnId(threadId: str): str =
    let index = rustCsgAppServerActiveTurnIndex(threadId)
    if index < 0:
        return ""
    return RustCsgAppServerActiveTurnIds[index]

fn rustCsgAppServerRemoveActiveTurn(threadId: str) =
    var nextThreadIds: str[]
    var nextTurnIds: str[]
    var i: int32
    while i < RustCsgAppServerActiveTurnThreadIds.len && i < RustCsgAppServerActiveTurnIds.len:
        if RustCsgAppServerActiveTurnThreadIds[i] != threadId:
            add(nextThreadIds, RustCsgAppServerActiveTurnThreadIds[i])
            add(nextTurnIds, RustCsgAppServerActiveTurnIds[i])
        i = i + 1
    RustCsgAppServerActiveTurnThreadIds = nextThreadIds
    RustCsgAppServerActiveTurnIds = nextTurnIds

fn rustCsgAppServerSetActiveTurn(threadId: str, turnId: str) =
    if threadId == "":
        return
    rustCsgAppServerRemoveActiveTurn(threadId)
    if turnId == "":
        return
    add(RustCsgAppServerActiveTurnThreadIds, threadId)
    add(RustCsgAppServerActiveTurnIds, turnId)

fn rustCsgAppServerThreadSubscriptionIndex(threadId: str, connectionId: int32): int32 =
    var i: int32
    while i < RustCsgAppServerThreadSubscriptionIds.len && i < RustCsgAppServerThreadSubscriptionConnectionIds.len:
        if RustCsgAppServerThreadSubscriptionIds[i] == threadId:
            if RustCsgAppServerThreadSubscriptionConnectionIds[i] == connectionId:
                return i
        i = i + 1
    return -1

fn rustCsgAppServerAddThreadSubscription(threadId: str, connectionId: int32) =
    if threadId == "":
        return
    if rustCsgAppServerThreadSubscriptionIndex(threadId, connectionId) >= 0:
        return
    add(RustCsgAppServerThreadSubscriptionIds, threadId)
    add(RustCsgAppServerThreadSubscriptionConnectionIds, connectionId)

fn rustCsgAppServerRemoveThreadSubscriptionAt(removeAt: int32) =
    var nextIds: str[]
    var nextConnectionIds: int32[]
    var i: int32
    while i < RustCsgAppServerThreadSubscriptionIds.len && i < RustCsgAppServerThreadSubscriptionConnectionIds.len:
        if i != removeAt:
            add(nextIds, RustCsgAppServerThreadSubscriptionIds[i])
            add(nextConnectionIds, RustCsgAppServerThreadSubscriptionConnectionIds[i])
        i = i + 1
    RustCsgAppServerThreadSubscriptionIds = nextIds
    RustCsgAppServerThreadSubscriptionConnectionIds = nextConnectionIds

fn rustCsgAppServerResetThreadSubscriptions() =
    RustCsgAppServerLoadedThreadIds = []
    RustCsgAppServerLoadedThreadDynamicToolsJson = []
    RustCsgAppServerLoadedThreadBaseInstructions = []
    RustCsgAppServerLoadedThreadDeveloperInstructions = []
    RustCsgAppServerLoadedThreadHistoryJson = []
    RustCsgAppServerLoadedThreadSources = []
    RustCsgAppServerLoadedThreadSandboxTags = []
    RustCsgAppServerThreadSubscriptionIds = []
    RustCsgAppServerThreadSubscriptionConnectionIds = []
    RustCsgAppServerActiveTurnThreadIds = []
    RustCsgAppServerActiveTurnIds = []

fn rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId: int32) =
    var nextIds: str[]
    var nextConnectionIds: int32[]
    var i: int32
    while i < RustCsgAppServerThreadSubscriptionIds.len && i < RustCsgAppServerThreadSubscriptionConnectionIds.len:
        if RustCsgAppServerThreadSubscriptionConnectionIds[i] != connectionId:
            add(nextIds, RustCsgAppServerThreadSubscriptionIds[i])
            add(nextConnectionIds, RustCsgAppServerThreadSubscriptionConnectionIds[i])
        i = i + 1
    RustCsgAppServerThreadSubscriptionIds = nextIds
    RustCsgAppServerThreadSubscriptionConnectionIds = nextConnectionIds

fn rustCsgAppServerDashboardManualLoginSessionIndex(email: str): int32 =
    var i: int32
    while i < RustCsgAppServerDashboardManualLoginEmails.len:
        if RustCsgAppServerDashboardManualLoginEmails[i] == email:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerRemoveDashboardManualLoginSessionAt(removeAt: int32) =
    var nextEmails: str[]
    var nextDeviceAuthIds: str[]
    var nextUserCodes: str[]
    var nextIssuers: str[]
    var nextIntervalsSeconds: int32[]
    var nextStartedAtMs: int64[]
    var nextPollMs: int64[]
    var i: int32
    while i < RustCsgAppServerDashboardManualLoginEmails.len:
        if i != removeAt:
            add(nextEmails, RustCsgAppServerDashboardManualLoginEmails[i])
            if i < RustCsgAppServerDashboardManualLoginDeviceAuthIds.len:
                add(nextDeviceAuthIds, RustCsgAppServerDashboardManualLoginDeviceAuthIds[i])
            else:
                add(nextDeviceAuthIds, "")
            if i < RustCsgAppServerDashboardManualLoginUserCodes.len:
                add(nextUserCodes, RustCsgAppServerDashboardManualLoginUserCodes[i])
            else:
                add(nextUserCodes, "")
            if i < RustCsgAppServerDashboardManualLoginIssuers.len:
                add(nextIssuers, RustCsgAppServerDashboardManualLoginIssuers[i])
            else:
                add(nextIssuers, "")
            if i < RustCsgAppServerDashboardManualLoginIntervalsSeconds.len:
                add(nextIntervalsSeconds, RustCsgAppServerDashboardManualLoginIntervalsSeconds[i])
            else:
                add(nextIntervalsSeconds, 5)
            if i < RustCsgAppServerDashboardManualLoginStartedAtMs.len:
                add(nextStartedAtMs, RustCsgAppServerDashboardManualLoginStartedAtMs[i])
            else:
                add(nextStartedAtMs, int64(0))
            if i < RustCsgAppServerDashboardManualLoginNextPollMs.len:
                add(nextPollMs, RustCsgAppServerDashboardManualLoginNextPollMs[i])
            else:
                add(nextPollMs, int64(0))
        i = i + 1
    RustCsgAppServerDashboardManualLoginEmails = nextEmails
    RustCsgAppServerDashboardManualLoginDeviceAuthIds = nextDeviceAuthIds
    RustCsgAppServerDashboardManualLoginUserCodes = nextUserCodes
    RustCsgAppServerDashboardManualLoginIssuers = nextIssuers
    RustCsgAppServerDashboardManualLoginIntervalsSeconds = nextIntervalsSeconds
    RustCsgAppServerDashboardManualLoginStartedAtMs = nextStartedAtMs
    RustCsgAppServerDashboardManualLoginNextPollMs = nextPollMs

fn rustCsgAppServerResetDashboardManualLoginSessions() =
    RustCsgAppServerDashboardManualLoginEmails = []
    RustCsgAppServerDashboardManualLoginDeviceAuthIds = []
    RustCsgAppServerDashboardManualLoginUserCodes = []
    RustCsgAppServerDashboardManualLoginIssuers = []
    RustCsgAppServerDashboardManualLoginIntervalsSeconds = []
    RustCsgAppServerDashboardManualLoginStartedAtMs = []
    RustCsgAppServerDashboardManualLoginNextPollMs = []

fn rustCsgAppServerRememberDashboardManualLoginSession(email: str,
                                                       deviceAuthId: str,
                                                       userCode: str,
                                                       issuer: str,
                                                       intervalSeconds: int32,
                                                       nowMs: int64) =
    let existingIndex = rustCsgAppServerDashboardManualLoginSessionIndex(email)
    if existingIndex >= 0:
        rustCsgAppServerRemoveDashboardManualLoginSessionAt(existingIndex)
    add(RustCsgAppServerDashboardManualLoginEmails, email)
    add(RustCsgAppServerDashboardManualLoginDeviceAuthIds, deviceAuthId)
    add(RustCsgAppServerDashboardManualLoginUserCodes, userCode)
    add(RustCsgAppServerDashboardManualLoginIssuers, issuer)
    add(RustCsgAppServerDashboardManualLoginIntervalsSeconds, intervalSeconds)
    add(RustCsgAppServerDashboardManualLoginStartedAtMs, nowMs)
    add(RustCsgAppServerDashboardManualLoginNextPollMs, nowMs)

fn rustCsgAppServerDashboardManualLoginPendingError(error: str): bool =
    return error == "manual device-code login is still pending"

fn rustCsgAppServerDashboardManualLoginIntervalMsAt(index: int32): int64 =
    var seconds: int32 = 5
    if index >= 0 && index < RustCsgAppServerDashboardManualLoginIntervalsSeconds.len:
        seconds = RustCsgAppServerDashboardManualLoginIntervalsSeconds[index]
    if seconds < 0:
        seconds = 0
    return int64(seconds) * int64(1000)

fn rustCsgAppServerScheduleDashboardManualLoginNextPollAt(index: int32, nowMs: int64) =
    var nextPollMs: int64[]
    var i: int32
    while i < RustCsgAppServerDashboardManualLoginEmails.len:
        if i == index:
            add(nextPollMs, nowMs + rustCsgAppServerDashboardManualLoginIntervalMsAt(index))
        elif i < RustCsgAppServerDashboardManualLoginNextPollMs.len:
            add(nextPollMs, RustCsgAppServerDashboardManualLoginNextPollMs[i])
        else:
            add(nextPollMs, nowMs)
        i = i + 1
    RustCsgAppServerDashboardManualLoginNextPollMs = nextPollMs

fn rustCsgAppServerCompleteDashboardManualLoginSessions(codexHome: str,
                                                        targetEmail: str,
                                                        nowSeconds: int64,
                                                        outError: var str): bool =
    outError = ""
    var i: int32
    while i < RustCsgAppServerDashboardManualLoginEmails.len:
        let email = RustCsgAppServerDashboardManualLoginEmails[i]
        if targetEmail == "" || email == targetEmail:
            var deviceAuthId: str
            var userCode: str
            var issuer: str
            if i < RustCsgAppServerDashboardManualLoginDeviceAuthIds.len:
                deviceAuthId = RustCsgAppServerDashboardManualLoginDeviceAuthIds[i]
            if i < RustCsgAppServerDashboardManualLoginUserCodes.len:
                userCode = RustCsgAppServerDashboardManualLoginUserCodes[i]
            if i < RustCsgAppServerDashboardManualLoginIssuers.len:
                issuer = RustCsgAppServerDashboardManualLoginIssuers[i]
            let authHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, email)
            var completeError: str
            if auth_oauth.CompleteDeviceCodeLoginOnceAtIssuer(authHome,
                                                              issuer,
                                                              deviceAuthId,
                                                              userCode,
                                                              email,
                                                              rustCsgAppServerForcedChatGptWorkspaceId(codexHome),
                                                              nowSeconds,
                                                              completeError):
                rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
                continue
            if targetEmail != "":
                if completeError == "":
                    completeError = "manual login completion failed"
                if !rustCsgAppServerDashboardManualLoginPendingError(completeError):
                    rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
                outError = completeError
                return false
            if !rustCsgAppServerDashboardManualLoginPendingError(completeError):
                rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
                continue
        i = i + 1
    return true

fn rustCsgAppServerPollDashboardManualLoginSessions(codexHome: str, nowMs: int64) =
    var i: int32
    while i < RustCsgAppServerDashboardManualLoginEmails.len:
        var startedAtMs: int64
        if i < RustCsgAppServerDashboardManualLoginStartedAtMs.len:
            startedAtMs = RustCsgAppServerDashboardManualLoginStartedAtMs[i]
        if startedAtMs > int64(0) && nowMs - startedAtMs >= int64(900000):
            rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
            continue
        var nextPollMs: int64
        if i < RustCsgAppServerDashboardManualLoginNextPollMs.len:
            nextPollMs = RustCsgAppServerDashboardManualLoginNextPollMs[i]
        if nowMs < nextPollMs:
            i = i + 1
            continue
        let email = RustCsgAppServerDashboardManualLoginEmails[i]
        var deviceAuthId: str
        var userCode: str
        var issuer: str
        if i < RustCsgAppServerDashboardManualLoginDeviceAuthIds.len:
            deviceAuthId = RustCsgAppServerDashboardManualLoginDeviceAuthIds[i]
        if i < RustCsgAppServerDashboardManualLoginUserCodes.len:
            userCode = RustCsgAppServerDashboardManualLoginUserCodes[i]
        if i < RustCsgAppServerDashboardManualLoginIssuers.len:
            issuer = RustCsgAppServerDashboardManualLoginIssuers[i]
        let authHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, email)
        var completeError: str
        if auth_oauth.CompleteDeviceCodeLoginOnceAtIssuer(authHome,
                                                          issuer,
                                                          deviceAuthId,
                                                          userCode,
                                                          email,
                                                          rustCsgAppServerForcedChatGptWorkspaceId(codexHome),
                                                          nowMs / int64(1000),
                                                          completeError):
            rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
            continue
        if rustCsgAppServerDashboardManualLoginPendingError(completeError):
            rustCsgAppServerScheduleDashboardManualLoginNextPollAt(i, nowMs)
            i = i + 1
            continue
        rustCsgAppServerRemoveDashboardManualLoginSessionAt(i)
    return

fn rustCsgAppServerAllocateConnectionId(): int32 =
    RustCsgAppServerNextConnectionId = RustCsgAppServerNextConnectionId + 1
    if RustCsgAppServerNextConnectionId <= 0:
        RustCsgAppServerNextConnectionId = 1
    return RustCsgAppServerNextConnectionId

fn rustCsgAppServerNowSeconds(): int32 =
    return int32(rustCsgGetCurrentTimeMs() / int64(1000))

fn rustCsgAppServerNowMillisPart(): int32 =
    let nowMs = rustCsgGetCurrentTimeMs()
    let seconds = nowMs / int64(1000)
    return int32(nowMs - seconds * int64(1000))

fn rustCsgAppServerExecSessionIndex(processId: str): int32 =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if RustCsgAppServerExecIds[i] == processId:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerExecSessionIndexForConnection(processId: str, connectionId: int32): int32 =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if RustCsgAppServerExecIds[i] == processId:
            if RustCsgAppServerExecConnectionIds[i] == connectionId:
                return i
        i = i + 1
    return -1

fn rustCsgAppServerExecSessionValid(index: int32): bool =
    if index < 0:
        return false
    if index >= RustCsgAppServerExecIds.len:
        return false
    if index >= RustCsgAppServerExecConnectionIds.len:
        return false
    if index >= RustCsgAppServerExecPids.len:
        return false
    if index >= RustCsgAppServerExecStdinFds.len:
        return false
    if index >= RustCsgAppServerExecStdoutFds.len:
        return false
    if index >= RustCsgAppServerExecStderrFds.len:
        return false
    if index >= RustCsgAppServerExecIsPty.len:
        return false
    if index >= RustCsgAppServerExecPtyFds.len:
        return false
    if index >= RustCsgAppServerExecStreamStdin.len:
        return false
    if index >= RustCsgAppServerExecStdinClosed.len:
        return false
    if index >= RustCsgAppServerExecRequestIds.len:
        return false
    if index >= RustCsgAppServerExecWriterFds.len:
        return false
    if index >= RustCsgAppServerExecWriterKinds.len:
        return false
    if index >= RustCsgAppServerExecStreamOutput.len:
        return false
    if index >= RustCsgAppServerExecOutputCaps.len:
        return false
    if index >= RustCsgAppServerExecStdoutSeen.len:
        return false
    if index >= RustCsgAppServerExecStderrSeen.len:
        return false
    if index >= RustCsgAppServerExecStdoutBuffers.len:
        return false
    if index >= RustCsgAppServerExecStderrBuffers.len:
        return false
    if index >= RustCsgAppServerExecStartSeconds.len:
        return false
    if index >= RustCsgAppServerExecStartMillisPart.len:
        return false
    if index >= RustCsgAppServerExecTimeoutMs.len:
        return false
    if index >= RustCsgAppServerExecMutationPaths.len:
        return false
    return true

fn rustCsgAppServerDropExecSession(index: int32) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    var nextConnectionIds: int32[]
    var nextIds: str[]
    var nextPids: int32[]
    var nextStdinFds: int32[]
    var nextStdoutFds: int32[]
    var nextStderrFds: int32[]
    var nextIsPty: int32[]
    var nextPtyFds: int32[]
    var nextStreamStdin: int32[]
    var nextStdinClosed: int32[]
    var nextRequestIds: int32[]
    var nextWriterFds: int32[]
    var nextWriterKinds: int32[]
    var nextStreamOutput: int32[]
    var nextOutputCaps: int32[]
    var nextStdoutSeen: int32[]
    var nextStderrSeen: int32[]
    var nextStdoutBuffers: str[]
    var nextStderrBuffers: str[]
    var nextStartSeconds: int32[]
    var nextStartMillisPart: int32[]
    var nextTimeoutMs: int32[]
    var nextMutationPaths: str[]
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if i != index:
            if rustCsgAppServerExecSessionValid(i):
                add(nextConnectionIds, RustCsgAppServerExecConnectionIds[i])
                add(nextIds, RustCsgAppServerExecIds[i])
                add(nextPids, RustCsgAppServerExecPids[i])
                add(nextStdinFds, RustCsgAppServerExecStdinFds[i])
                add(nextStdoutFds, RustCsgAppServerExecStdoutFds[i])
                add(nextStderrFds, RustCsgAppServerExecStderrFds[i])
                add(nextIsPty, RustCsgAppServerExecIsPty[i])
                add(nextPtyFds, RustCsgAppServerExecPtyFds[i])
                add(nextStreamStdin, RustCsgAppServerExecStreamStdin[i])
                add(nextStdinClosed, RustCsgAppServerExecStdinClosed[i])
                add(nextRequestIds, RustCsgAppServerExecRequestIds[i])
                add(nextWriterFds, RustCsgAppServerExecWriterFds[i])
                add(nextWriterKinds, RustCsgAppServerExecWriterKinds[i])
                add(nextStreamOutput, RustCsgAppServerExecStreamOutput[i])
                add(nextOutputCaps, RustCsgAppServerExecOutputCaps[i])
                add(nextStdoutSeen, RustCsgAppServerExecStdoutSeen[i])
                add(nextStderrSeen, RustCsgAppServerExecStderrSeen[i])
                add(nextStdoutBuffers, RustCsgAppServerExecStdoutBuffers[i])
                add(nextStderrBuffers, RustCsgAppServerExecStderrBuffers[i])
                add(nextStartSeconds, RustCsgAppServerExecStartSeconds[i])
                add(nextStartMillisPart, RustCsgAppServerExecStartMillisPart[i])
                add(nextTimeoutMs, RustCsgAppServerExecTimeoutMs[i])
                add(nextMutationPaths, RustCsgAppServerExecMutationPaths[i])
        i = i + 1
    RustCsgAppServerExecConnectionIds = nextConnectionIds
    RustCsgAppServerExecIds = nextIds
    RustCsgAppServerExecPids = nextPids
    RustCsgAppServerExecStdinFds = nextStdinFds
    RustCsgAppServerExecStdoutFds = nextStdoutFds
    RustCsgAppServerExecStderrFds = nextStderrFds
    RustCsgAppServerExecIsPty = nextIsPty
    RustCsgAppServerExecPtyFds = nextPtyFds
    RustCsgAppServerExecStreamStdin = nextStreamStdin
    RustCsgAppServerExecStdinClosed = nextStdinClosed
    RustCsgAppServerExecRequestIds = nextRequestIds
    RustCsgAppServerExecWriterFds = nextWriterFds
    RustCsgAppServerExecWriterKinds = nextWriterKinds
    RustCsgAppServerExecStreamOutput = nextStreamOutput
    RustCsgAppServerExecOutputCaps = nextOutputCaps
    RustCsgAppServerExecStdoutSeen = nextStdoutSeen
    RustCsgAppServerExecStderrSeen = nextStderrSeen
    RustCsgAppServerExecStdoutBuffers = nextStdoutBuffers
    RustCsgAppServerExecStderrBuffers = nextStderrBuffers
    RustCsgAppServerExecStartSeconds = nextStartSeconds
    RustCsgAppServerExecStartMillisPart = nextStartMillisPart
    RustCsgAppServerExecTimeoutMs = nextTimeoutMs
    RustCsgAppServerExecMutationPaths = nextMutationPaths

fn rustCsgAppServerRemoveExecSession(index: int32) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    rustCsgAppServerCloseExecSessionFds(index)
    rustCsgAppServerDropExecSession(index)

fn rustCsgAppServerCloseExecSessionFds(index: int32) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    let stdinFd = RustCsgAppServerExecStdinFds[index]
    let stdoutFd = RustCsgAppServerExecStdoutFds[index]
    let stderrFd = RustCsgAppServerExecStderrFds[index]
    let ptyFd = RustCsgAppServerExecPtyFds[index]
    if stdinFd >= 0:
        process.ProcessCloseFd(stdinFd)
    if stdoutFd >= 0 && stdoutFd != stdinFd:
        process.ProcessCloseFd(stdoutFd)
    if stderrFd >= 0 && stderrFd != stdinFd && stderrFd != stdoutFd:
        process.ProcessCloseFd(stderrFd)
    if ptyFd >= 0 && ptyFd != stdinFd && ptyFd != stdoutFd && ptyFd != stderrFd:
        process.ProcessCloseFd(ptyFd)

fn rustCsgAppServerKillWaitExecSession(index: int32) =
    if rustCsgAppServerExecSessionValid(index) && RustCsgAppServerExecPids[index] > 0:
        process.ProcessKillGroup(RustCsgAppServerExecPids[index], 15)
        if process.ProcessTryWait(RustCsgAppServerExecPids[index]) == -2:
            process.ProcessKillGroup(RustCsgAppServerExecPids[index], 9)
        process.ProcessWait(RustCsgAppServerExecPids[index])

fn rustCsgAppServerAbortExecSession(index: int32) =
    rustCsgAppServerRecordCommandExecAfter(index, false, "aborted")
    rustCsgAppServerKillWaitExecSession(index)
    rustCsgAppServerRemoveExecSession(index)

fn rustCsgAppServerResetExecSessions() =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if rustCsgAppServerExecSessionValid(i):
            if RustCsgAppServerExecPids[i] > 0:
                process.ProcessKillGroup(RustCsgAppServerExecPids[i], 15)
                if process.ProcessTryWait(RustCsgAppServerExecPids[i]) == -2:
                    process.ProcessKillGroup(RustCsgAppServerExecPids[i], 9)
                process.ProcessWait(RustCsgAppServerExecPids[i])
            else:
                rustCsgAppServerCloseExecSessionFds(i)
        i = i + 1
    RustCsgAppServerExecConnectionIds = []
    RustCsgAppServerExecIds = []
    RustCsgAppServerExecPids = []
    RustCsgAppServerExecStdinFds = []
    RustCsgAppServerExecStdoutFds = []
    RustCsgAppServerExecStderrFds = []
    RustCsgAppServerExecIsPty = []
    RustCsgAppServerExecPtyFds = []
    RustCsgAppServerExecStreamStdin = []
    RustCsgAppServerExecStdinClosed = []
    RustCsgAppServerExecRequestIds = []
    RustCsgAppServerExecWriterFds = []
    RustCsgAppServerExecWriterKinds = []
    RustCsgAppServerExecStreamOutput = []
    RustCsgAppServerExecOutputCaps = []
    RustCsgAppServerExecStdoutSeen = []
    RustCsgAppServerExecStderrSeen = []
    RustCsgAppServerExecStdoutBuffers = []
    RustCsgAppServerExecStderrBuffers = []
    RustCsgAppServerExecStartSeconds = []
    RustCsgAppServerExecStartMillisPart = []
    RustCsgAppServerExecTimeoutMs = []
    RustCsgAppServerExecMutationPaths = []

fn rustCsgAppServerResetExecSessionsForConnection(connectionId: int32) =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if rustCsgAppServerExecSessionValid(i) && RustCsgAppServerExecConnectionIds[i] == connectionId:
            rustCsgAppServerAbortExecSession(i)
        else:
            i = i + 1

fn rustCsgAppServerRegisterExecSession(reg: var RustCsgAppServerExecRegistration) =
    add(RustCsgAppServerExecConnectionIds, reg.connectionId)
    add(RustCsgAppServerExecIds, reg.processId)
    add(RustCsgAppServerExecPids, reg.pid)
    add(RustCsgAppServerExecStdinFds, reg.stdinFd)
    add(RustCsgAppServerExecStdoutFds, reg.stdoutFd)
    add(RustCsgAppServerExecStderrFds, reg.stderrFd)
    if reg.isPty:
        add(RustCsgAppServerExecIsPty, 1)
    else:
        add(RustCsgAppServerExecIsPty, 0)
    add(RustCsgAppServerExecPtyFds, reg.ptyFd)
    if reg.streamStdin:
        add(RustCsgAppServerExecStreamStdin, 1)
    else:
        add(RustCsgAppServerExecStreamStdin, 0)
    if reg.stdinFd < 0:
        add(RustCsgAppServerExecStdinClosed, 1)
    else:
        add(RustCsgAppServerExecStdinClosed, 0)
    add(RustCsgAppServerExecRequestIds, reg.requestId)
    add(RustCsgAppServerExecWriterFds, reg.writerFd)
    add(RustCsgAppServerExecWriterKinds, reg.writerKind)
    if reg.streamOutput:
        add(RustCsgAppServerExecStreamOutput, 1)
    else:
        add(RustCsgAppServerExecStreamOutput, 0)
    add(RustCsgAppServerExecOutputCaps, reg.outputCap)
    add(RustCsgAppServerExecStdoutSeen, 0)
    add(RustCsgAppServerExecStderrSeen, 0)
    add(RustCsgAppServerExecStdoutBuffers, "")
    add(RustCsgAppServerExecStderrBuffers, "")
    add(RustCsgAppServerExecStartSeconds, rustCsgAppServerNowSeconds())
    add(RustCsgAppServerExecStartMillisPart, rustCsgAppServerNowMillisPart())
    add(RustCsgAppServerExecTimeoutMs, reg.timeoutMs)
    add(RustCsgAppServerExecMutationPaths, reg.mutationPath)

fn rustCsgAppServerRecordCommandExecAfter(index: int32, ok: bool, detail: str) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    let mutationPath = RustCsgAppServerExecMutationPaths[index]
    if mutationPath == "":
        return
    cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", mutationPath, ok, detail)

fn rustCsgAppServerHasExecSessions(): bool =
    return RustCsgAppServerExecIds.len > 0

fn rustCsgAppServerHasExecSessionsForConnection(connectionId: int32): bool =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if rustCsgAppServerExecSessionValid(i) && RustCsgAppServerExecConnectionIds[i] == connectionId:
            return true
        i = i + 1
    return false

fn rustCsgAppServerCommandExecProcessRepr(processId: str): str =
    return wire.RustCsgJsonQuote(processId)

fn rustCsgAppServerNoActiveCommandExecMessage(processId: str): str =
    return wire.RustCsgCat("no active command/exec for process id ", rustCsgAppServerCommandExecProcessRepr(processId))

fn rustCsgAppServerNoLongerRunningCommandExecMessage(processId: str): str =
    return wire.RustCsgCat3("command/exec ", rustCsgAppServerCommandExecProcessRepr(processId), " is no longer running")

fn rustCsgAppServerWatchIndex(watchId: str): int32 =
    var i: int32
    while i < RustCsgAppServerWatchIds.len:
        if RustCsgAppServerWatchIds[i] == watchId:
            return i
        i = i + 1
    return -1

fn rustCsgAppServerWatchIndexForConnection(watchId: str, connectionId: int32): int32 =
    var i: int32
    while i < RustCsgAppServerWatchIds.len && i < RustCsgAppServerWatchConnectionIds.len:
        if RustCsgAppServerWatchIds[i] == watchId:
            if RustCsgAppServerWatchConnectionIds[i] == connectionId:
                return i
        i = i + 1
    return -1

fn rustCsgAppServerPathIsDirectory(path: str): bool =
    let statJson = rustCsgAppServerPathStat(path)
    if statJson == "":
        return false
    return wire.RustCsgContains(statJson, "\"isDirectory\":true")

fn rustCsgAppServerPathEqualOrChild(parent: str, changedPath: str): bool =
    if changedPath == parent:
        return true
    if parent == "":
        return false
    if parent == "/":
        return changedPath.len > 1 && changedPath[0] == '/'
    var prefix = parent
    if parent[parent.len - 1] != '/':
        prefix = wire.RustCsgCat(parent, "/")
    if changedPath.len <= prefix.len:
        return false
    return rustCsgAppServerStartsWith(changedPath, prefix)

fn rustCsgAppServerWatchMatchesPath(watchPath: str, changedPath: str): bool =
    if changedPath == watchPath:
        return true
    if rustCsgAppServerPathIsDirectory(watchPath):
        return rustCsgAppServerPathEqualOrChild(watchPath, changedPath)
    return false

fn rustCsgAppServerFsChangedNotification(watchId: str, changedPath: str): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("watchId", watchId))
    params = wire.RustCsgCat(params, ",\"changedPaths\":[")
    params = wire.RustCsgCat(params, wire.RustCsgJsonQuote(changedPath))
    params = wire.RustCsgCat(params, "]}")
    var out = "{\"method\":\"fs/changed\",\"params\":"
    out = wire.RustCsgCat(out, params)
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgAppServerEmitFsChangedForPath(fd: int32, writerKind: int32, connectionId: int32, changedPath: str): bool =
    if changedPath == "":
        return true
    var i: int32
    while i < RustCsgAppServerWatchIds.len && i < RustCsgAppServerWatchPaths.len && i < RustCsgAppServerWatchConnectionIds.len:
        if RustCsgAppServerWatchConnectionIds[i] == connectionId && rustCsgAppServerWatchMatchesPath(RustCsgAppServerWatchPaths[i], changedPath):
            let notification = rustCsgAppServerFsChangedNotification(RustCsgAppServerWatchIds[i], changedPath)
            if !rustCsgAppServerWriteJsonMessage(fd, writerKind, notification):
                return false
        i = i + 1
    return true

fn rustCsgAppServerHandleFsWatchWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pathRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "path")
    if pathRaw == "" || pathRaw == "null":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "path is required"))
    if pathRaw[0] != '"':
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "path must be string"))
    let path = wire.RustCsgJsonFindStr(paramsJson, "path")
    if path == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "path must not be empty"))
    if !home.RustCsgPathIsAbsolute(path):
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "Invalid request: AbsolutePathBuf deserialized without a base path"))
    let watchIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "watchId")
    if watchIdRaw == "" || watchIdRaw == "null":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId is required"))
    if watchIdRaw[0] != '"':
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId must be string"))
    let watchId = wire.RustCsgJsonFindStr(paramsJson, "watchId")
    if watchId == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId must not be empty"))
    if rustCsgAppServerWatchIndexForConnection(watchId, connectionId) >= 0:
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, wire.RustCsgCat("watchId already exists: ", watchId)))
    add(RustCsgAppServerWatchIds, watchId)
    add(RustCsgAppServerWatchPaths, path)
    add(RustCsgAppServerWatchConnectionIds, connectionId)
    let response = rustCsgAppServerResponse(id, wire.RustCsgCat3("{\"path\":", wire.RustCsgJsonQuote(path), "}"))
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, response)

fn rustCsgAppServerHandleFsUnwatchWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let watchIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "watchId")
    if watchIdRaw == "" || watchIdRaw == "null":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId is required"))
    if watchIdRaw[0] != '"':
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId must be string"))
    let watchId = wire.RustCsgJsonFindStr(paramsJson, "watchId")
    if watchId == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "watchId must not be empty"))
    let removeAt = rustCsgAppServerWatchIndexForConnection(watchId, connectionId)
    if removeAt >= 0:
        var nextIds: str[]
        var nextPaths: str[]
        var nextConnectionIds: int32[]
        nextIds = []
        nextPaths = []
        var i: int32
        while i < RustCsgAppServerWatchIds.len && i < RustCsgAppServerWatchPaths.len && i < RustCsgAppServerWatchConnectionIds.len:
            if i != removeAt:
                add(nextIds, RustCsgAppServerWatchIds[i])
                add(nextPaths, RustCsgAppServerWatchPaths[i])
                add(nextConnectionIds, RustCsgAppServerWatchConnectionIds[i])
            i = i + 1
        RustCsgAppServerWatchIds = nextIds
        RustCsgAppServerWatchPaths = nextPaths
        RustCsgAppServerWatchConnectionIds = nextConnectionIds
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerResponse(id, wire.RustCsgCat("{", "}")))

fn rustCsgAppServerHandleThreadNameSetWriter(id: int32, body: str, fd: int32, writerKind: int32): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadNameSet(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    let threadName = thread_handler.RustCsgAppServerNormalizeThreadName(wire.RustCsgJsonFindStr(paramsJson, "name"))
    let notification = thread_handler.RustCsgAppServerThreadNameUpdatedNotification(threadId, threadName)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, notification)

fn rustCsgAppServerHandleThreadArchiveWriter(id: int32, body: str, fd: int32, writerKind: int32): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadArchive(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    rustCsgAppServerRemoveLoadedThread(threadId)
    let notification = thread_handler.RustCsgAppServerThreadArchivedNotification(threadId)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, notification)

fn rustCsgAppServerHandleThreadStartWriter(id: int32,
                                           body: str,
                                           fd: int32,
                                           writerKind: int32,
                                           connectionId: int32): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadStart(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, rustCsgAppServerDynamicToolsFromRequest(body), rustCsgAppServerEffectiveBaseInstructionsFromStartRequest(body), rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
    rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
    rustCsgAppServerAddThreadSubscription(threadId, connectionId)
    let notification = thread_handler.RustCsgAppServerThreadStartedNotificationFromResponse(response)
    if notification == "":
        return true
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, notification)

fn rustCsgAppServerHandleThreadForkWriter(id: int32,
                                          body: str,
                                          fd: int32,
                                          writerKind: int32,
                                          connectionId: int32): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadFork(id, body)
    var tokenUsageError: str
    let tokenUsageNotification = thread_handler.RustCsgAppServerTokenUsageReplayNotificationFromRequestResponse(body, response, tokenUsageError)
    if tokenUsageError != "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, tokenUsageError))
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", rustCsgAppServerEffectiveBaseInstructionsFromForkRequest(body), rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
    rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
    rustCsgAppServerAddThreadSubscription(threadId, connectionId)
    if tokenUsageNotification != "":
        if !rustCsgAppServerWriteJsonMessage(fd, writerKind, tokenUsageNotification):
            return false
    let notification = thread_handler.RustCsgAppServerThreadStartedNotificationFromResponseClearingTurns(response)
    if notification == "":
        return true
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, notification)

fn rustCsgAppServerHandleThreadResumeWriter(id: int32,
                                            body: str,
                                            fd: int32,
                                           writerKind: int32,
                                           connectionId: int32): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadResume(id, body)
    var tokenUsageError: str
    let tokenUsageNotification = thread_handler.RustCsgAppServerTokenUsageReplayNotificationFromRequestResponse(body, response, tokenUsageError)
    if tokenUsageError != "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, tokenUsageError))
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", rustCsgAppServerEffectiveBaseInstructionsFromResumeRequest(body, response), rustCsgAppServerDeveloperInstructionsFromRequest(body), rustCsgAppServerHistoryJsonFromRequest(body))
    rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
    rustCsgAppServerAddThreadSubscription(threadId, connectionId)
    if tokenUsageNotification != "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, tokenUsageNotification)
    return true

fn rustCsgAppServerHandleThreadUnsubscribeWriter(id: int32,
                                                 body: str,
                                                 fd: int32,
                                                 writerKind: int32,
                                                 connectionId: int32): bool =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "threadId")
    if threadIdRaw == "" || threadIdRaw == "null":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "threadId is required"))
    if threadIdRaw[0] != '"':
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "threadId must be string"))
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "threadId must not be empty"))
    var status = "notLoaded"
    if rustCsgAppServerLoadedThreadIndex(threadId) >= 0:
        let subIndex = rustCsgAppServerThreadSubscriptionIndex(threadId, connectionId)
        if subIndex >= 0:
            rustCsgAppServerRemoveThreadSubscriptionAt(subIndex)
            status = "unsubscribed"
        else:
            status = "notSubscribed"
    let result = wire.RustCsgCat3("{\"status\":", wire.RustCsgJsonQuote(status), "}")
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerResponse(id, result))

fn rustCsgAppServerRequiredThreadId(id: int32, body: str, outErrorResponse: var str): str =
    outErrorResponse = ""
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "threadId")
    if threadIdRaw == "" || threadIdRaw == "null":
        outErrorResponse = rustCsgAppServerError(id, -32602, "threadId is required")
        return ""
    if threadIdRaw[0] != '"':
        outErrorResponse = rustCsgAppServerError(id, -32602, "threadId must be string")
        return ""
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    if threadId == "":
        outErrorResponse = rustCsgAppServerError(id, -32602, "threadId must not be empty")
        return ""
    return threadId

fn rustCsgAppServerHandleTurnStartScoped(id: int32, body: str): str =
    var errorResponse: str
    let threadId = rustCsgAppServerRequiredThreadId(id, body, errorResponse)
    if errorResponse != "":
        return errorResponse
    if rustCsgAppServerLoadedThreadIndex(threadId) < 0:
        var pathError: str
        let dbPath = thread_handler.rustCsgAppServerStateDbPath(pathError)
        if pathError != "":
            return rustCsgAppServerError(id, -32603, pathError)
        var readParams: types.RustCsgThreadReadParams
        readParams.threadId = threadId
        readParams.includeTurns = false
        let readResult = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
        if !readResult.ok:
            if readResult.blockedReason != "":
                return rustCsgAppServerError(id, -32602, readResult.blockedReason)
            return rustCsgAppServerError(id, -32603, readResult.error)
        rustCsgAppServerMarkThreadLoaded(threadId)
    let response = thread_handler.RustCsgAppServerHandleTurnStart(id, body)
    if wire.RustCsgContains(response, "\"result\""):
        let turnId = thread_handler.RustCsgAppServerTurnIdFromTurnStartResponse(response)
        rustCsgAppServerSetActiveTurn(threadId, turnId)
    return response

fn rustCsgAppServerHandleTurnSteerScoped(id: int32, body: str): str =
    var errorResponse: str
    let threadId = rustCsgAppServerRequiredThreadId(id, body, errorResponse)
    if errorResponse != "":
        return errorResponse
    if rustCsgAppServerLoadedThreadIndex(threadId) < 0:
        var pathError: str
        let dbPath = thread_handler.rustCsgAppServerStateDbPath(pathError)
        if pathError != "":
            return rustCsgAppServerError(id, -32603, pathError)
        var readParams: types.RustCsgThreadReadParams
        readParams.threadId = threadId
        readParams.includeTurns = false
        let readResult = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
        if !readResult.ok:
            if readResult.blockedReason != "":
                return rustCsgAppServerError(id, -32602, readResult.blockedReason)
            return rustCsgAppServerError(id, -32603, readResult.error)
        rustCsgAppServerMarkThreadLoaded(threadId)
    return thread_handler.RustCsgAppServerHandleTurnSteer(id, body, rustCsgAppServerActiveTurnId(threadId))

fn rustCsgAppServerHandleTurnStartWriter(id: int32,
                                         body: str,
                                         fd: int32,
                                         writerKind: int32,
                                         connectionId: int32): bool =
    let response = rustCsgAppServerHandleTurnStartScoped(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    var errorResponse: str
    let threadId = rustCsgAppServerRequiredThreadId(id, body, errorResponse)
    if errorResponse != "":
        return true
    if rustCsgAppServerThreadSubscriptionIndex(threadId, connectionId) < 0:
        return true
    let notification = thread_handler.RustCsgAppServerTurnStartedNotificationFromResponse(threadId, response)
    if notification == "":
        return true
    let dynamicToolsJson = rustCsgAppServerDynamicToolsForThread(threadId)
    let baseInstructions = rustCsgAppServerBaseInstructionsForThread(threadId)
    let developerInstructions = rustCsgAppServerDeveloperInstructionsForThread(threadId)
    let historyJson = rustCsgAppServerHistoryJsonForThread(threadId)
    let threadSource = rustCsgAppServerThreadSourceForThread(threadId)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, notification):
        return false
    var eventError: str
    if writerKind == 2:
        let liveOk = turn_event_loop.RustCsgAppServerTurnEventWriteLiveFromResponseWithSessionAndThreadSource(body, response, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, threadSource, fd, eventError)
        if eventError != "":
            rustCsgAppServerWriteStderrLine(eventError)
            return false
        return liveOk
    if writerKind == 3:
        var notificationFds: int32[]
        var requestFds: int32[]
        add(notificationFds, fd)
        add(requestFds, fd)
        let liveOk = turn_event_loop.RustCsgAppServerTurnEventWriteLiveWebSocketFromResponseWithSessionAndThreadSource(body, response, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, threadSource, notificationFds, requestFds, eventError)
        if eventError != "":
            rustCsgAppServerWriteStderrLine(eventError)
            return false
        return liveOk
    let events = turn_event_loop.RustCsgAppServerTurnEventNotificationsFromResponseWithSession(body, response, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, eventError)
    if eventError != "":
        rustCsgAppServerWriteStderrLine(eventError)
        return false
    var eventPos: int32
    while eventPos < events.len:
        var eventLineEnd = eventPos
        while eventLineEnd < events.len && events[eventLineEnd] != '\n':
            eventLineEnd = eventLineEnd + 1
        let eventLine = strings.SliceBytes(events, eventPos, eventLineEnd - eventPos)
        if eventLine != "":
            if !rustCsgAppServerWriteJsonMessage(fd, writerKind, eventLine):
                return false
        eventPos = eventLineEnd + 1
    return true

fn rustCsgAppServerHandleTurnStartStdioWriter(id: int32,
                                              body: str,
                                              fd: int32,
                                              connectionId: int32,
                                              stdioBuffer: var str): bool =
    let response = rustCsgAppServerHandleTurnStartScoped(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, 2, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    var errorResponse: str
    let threadId = rustCsgAppServerRequiredThreadId(id, body, errorResponse)
    if errorResponse != "":
        return true
    if rustCsgAppServerThreadSubscriptionIndex(threadId, connectionId) < 0:
        return true
    let notification = thread_handler.RustCsgAppServerTurnStartedNotificationFromResponse(threadId, response)
    if notification == "":
        return true
    let dynamicToolsJson = rustCsgAppServerDynamicToolsForThread(threadId)
    let baseInstructions = rustCsgAppServerBaseInstructionsForThread(threadId)
    let developerInstructions = rustCsgAppServerDeveloperInstructionsForThread(threadId)
    let historyJson = rustCsgAppServerHistoryJsonForThread(threadId)
    let threadSource = rustCsgAppServerThreadSourceForThread(threadId)
    if !rustCsgAppServerWriteJsonMessage(fd, 2, notification):
        return false
    var eventError: str
    let liveOk = turn_event_loop.RustCsgAppServerTurnEventWriteLiveFromResponseWithStdioBufferAndSessionAndThreadSource(body, response, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, threadSource, fd, stdioBuffer, eventError)
    if eventError != "":
        rustCsgAppServerWriteStderrLine(eventError)
        return false
    return liveOk

fn rustCsgAppServerHandleTurnSteerWriter(id: int32,
                                         body: str,
                                         fd: int32,
                                         writerKind: int32): bool =
    let response = rustCsgAppServerHandleTurnSteerScoped(id, body)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, response)

fn rustCsgAppServerBroadcastWebSocketJson(clientFds: int32[], body: str): bool =
    var i: int32
    while i < clientFds.len:
        if !rustCsgAppServerWriteJsonMessage(clientFds[i], 3, body):
            return false
        i = i + 1
    return true

fn rustCsgAppServerBroadcastWebSocketJsonToThreadSubscribers(threadId: str,
                                                             clientFds: int32[],
                                                             connectionIds: int32[],
                                                             body: str): bool =
    var i: int32
    while i < clientFds.len && i < connectionIds.len:
        if rustCsgAppServerThreadSubscriptionIndex(threadId, connectionIds[i]) >= 0:
            if !rustCsgAppServerWriteJsonMessage(clientFds[i], 3, body):
                return false
        i = i + 1
    return true

fn rustCsgAppServerWebSocketThreadSubscriberFds(threadId: str,
                                                clientFds: int32[],
                                                connectionIds: int32[]): int32[] =
    var out: int32[]
    var i: int32
    while i < clientFds.len && i < connectionIds.len:
        if rustCsgAppServerThreadSubscriptionIndex(threadId, connectionIds[i]) >= 0:
            add(out, clientFds[i])
        i = i + 1
    return out

fn rustCsgAppServerHandleThreadNameSetWebSocketBroadcast(id: int32,
                                                         body: str,
                                                         fd: int32,
                                                         clientFds: int32[]): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadNameSet(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, 3, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    let threadName = thread_handler.RustCsgAppServerNormalizeThreadName(wire.RustCsgJsonFindStr(paramsJson, "name"))
    let notification = thread_handler.RustCsgAppServerThreadNameUpdatedNotification(threadId, threadName)
    return rustCsgAppServerBroadcastWebSocketJson(clientFds, notification)

fn rustCsgAppServerHandleThreadArchiveWebSocketBroadcast(id: int32,
                                                         body: str,
                                                         fd: int32,
                                                         clientFds: int32[]): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadArchive(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, 3, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadId = wire.RustCsgJsonFindStr(paramsJson, "threadId")
    rustCsgAppServerRemoveLoadedThread(threadId)
    let notification = thread_handler.RustCsgAppServerThreadArchivedNotification(threadId)
    return rustCsgAppServerBroadcastWebSocketJson(clientFds, notification)

fn rustCsgAppServerHandleThreadStartWebSocketBroadcast(id: int32,
                                                       body: str,
                                                       fd: int32,
                                                       connectionId: int32,
                                                       clientFds: int32[]): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadStart(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, 3, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
    let dynamicToolsJson = rustCsgAppServerDynamicToolsFromRequest(body)
    let baseInstructions = rustCsgAppServerEffectiveBaseInstructionsFromStartRequest(body)
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, dynamicToolsJson, baseInstructions, rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
    rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
    rustCsgAppServerAddThreadSubscription(threadId, connectionId)
    let notification = thread_handler.RustCsgAppServerThreadStartedNotificationFromResponse(response)
    if notification == "":
        return true
    return rustCsgAppServerBroadcastWebSocketJson(clientFds, notification)

fn rustCsgAppServerHandleThreadForkWebSocketBroadcast(id: int32,
                                                      body: str,
                                                      fd: int32,
                                                      connectionId: int32,
                                                      clientFds: int32[]): bool =
    let response = thread_handler.RustCsgAppServerHandleThreadFork(id, body)
    var tokenUsageError: str
    let tokenUsageNotification = thread_handler.RustCsgAppServerTokenUsageReplayNotificationFromRequestResponse(body, response, tokenUsageError)
    if tokenUsageError != "":
        return rustCsgAppServerWriteJsonMessage(fd, 3, rustCsgAppServerError(id, -32600, tokenUsageError))
    if !rustCsgAppServerWriteJsonMessage(fd, 3, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
    rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", rustCsgAppServerEffectiveBaseInstructionsFromForkRequest(body), rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
    rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
    rustCsgAppServerAddThreadSubscription(threadId, connectionId)
    if tokenUsageNotification != "":
        if !rustCsgAppServerWriteJsonMessage(fd, 3, tokenUsageNotification):
            return false
    let notification = thread_handler.RustCsgAppServerThreadStartedNotificationFromResponseClearingTurns(response)
    if notification == "":
        return true
    return rustCsgAppServerBroadcastWebSocketJson(clientFds, notification)

fn rustCsgAppServerHandleTurnStartWebSocketSubscribed(id: int32,
                                                      body: str,
                                                      fd: int32,
                                                      clientFds: int32[],
                                                      connectionIds: int32[]): bool =
    let response = rustCsgAppServerHandleTurnStartScoped(id, body)
    if !rustCsgAppServerWriteJsonMessage(fd, 3, response):
        return false
    if !wire.RustCsgContains(response, "\"result\""):
        return true
    var errorResponse: str
    let threadId = rustCsgAppServerRequiredThreadId(id, body, errorResponse)
    if errorResponse != "":
        return true
    let notification = thread_handler.RustCsgAppServerTurnStartedNotificationFromResponse(threadId, response)
    if notification == "":
        return true
    if !rustCsgAppServerBroadcastWebSocketJsonToThreadSubscribers(threadId, clientFds, connectionIds, notification):
        return false
    let dynamicToolsJson = rustCsgAppServerDynamicToolsForThread(threadId)
    let baseInstructions = rustCsgAppServerBaseInstructionsForThread(threadId)
    let developerInstructions = rustCsgAppServerDeveloperInstructionsForThread(threadId)
    let historyJson = rustCsgAppServerHistoryJsonForThread(threadId)
    let threadSource = rustCsgAppServerThreadSourceForThread(threadId)
    var eventError: str
    let subscriberFds = rustCsgAppServerWebSocketThreadSubscriberFds(threadId, clientFds, connectionIds)
    var requestFds: int32[]
    add(requestFds, fd)
    let liveOk = turn_event_loop.RustCsgAppServerTurnEventWriteLiveWebSocketFromResponseWithSessionAndThreadSource(body, response, dynamicToolsJson, baseInstructions, developerInstructions, historyJson, threadSource, subscriberFds, requestFds, eventError)
    if eventError != "":
        rustCsgAppServerWriteStderrLine(eventError)
        return false
    return liveOk

fn rustCsgAppServerChangedPathForFsMutation(method: str, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    if method == "fs/copy":
        let dstRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "dst")
        if dstRaw != "" && dstRaw != "null" && dstRaw[0] == '"':
            return wire.RustCsgJsonFindStr(paramsJson, "dst")
        let destinationRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "destinationPath")
        if destinationRaw != "" && destinationRaw != "null" && destinationRaw[0] == '"':
            return wire.RustCsgJsonFindStr(paramsJson, "destinationPath")
        return ""
    let pathRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "path")
    if pathRaw != "" && pathRaw != "null" && pathRaw[0] == '"':
        return wire.RustCsgJsonFindStr(paramsJson, "path")
    return ""

fn rustCsgAppServerMethodMutatesFs(method: str): bool =
    return method == "fs/writeFile" || method == "fs/createDirectory" || method == "fs/remove" || method == "fs/copy"

fn rustCsgAppServerJoinCwdPath(cwd: str, path: str): str =
    if path == "":
        return path
    if path[0] == '/':
        return path
    if cwd == "":
        return path
    if cwd[cwd.len - 1] == '/':
        return wire.RustCsgCat(cwd, path)
    return wire.RustCsgCat3(cwd, "/", path)

fn rustCsgAppServerCommandChengMutationPath(commandItems: str[], cwd: str): str =
    for i in 0..<commandItems.len:
        let item = commandItems[i]
        if strings.StrContains(item, ".cheng") ||
           strings.StrContains(item, "/src/core/") ||
           strings.StrContains(item, "/codex/src/"):
            return rustCsgAppServerJoinCwdPath(cwd, item)
    return ""

fn rustCsgAppServerInitializeResult(codexHome: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("userAgent", "codex-app-server/0.1.0"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codexHome", codexHome))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("platformFamily", "unix"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("platformOs", "macos"))
    out = wire.RustCsgCat(out, ",\"capabilities\":{")
    # thread
    var threadCaps: str[]
    add(threadCaps, "read")
    add(threadCaps, "list")
    add(threadCaps, "loaded/list")
    add(threadCaps, "turns/list")
    add(threadCaps, "delete")
    add(threadCaps, "summary")
    add(threadCaps, "status")
    add(threadCaps, "export")
    add(threadCaps, "import")
    add(threadCaps, "rename")
    add(threadCaps, "history")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("thread", threadCaps))
    # config
    out = wire.RustCsgCat(out, ",")
    var configCaps: str[]
    add(configCaps, "read")
    add(configCaps, "write")
    add(configCaps, "requirements")
    add(configCaps, "reset")
    add(configCaps, "reload")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("config", configCaps))
    # account
    out = wire.RustCsgCat(out, ",")
    var accountCaps: str[]
    add(accountCaps, "get")
    add(accountCaps, "rateLimitsRead")
    add(accountCaps, "subscriptionQuotaRead")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("account", accountCaps))
    # fs
    out = wire.RustCsgCat(out, ",")
    var fsCaps: str[]
    add(fsCaps, "readFile")
    add(fsCaps, "writeFile")
    add(fsCaps, "getMetadata")
    add(fsCaps, "readDirectory")
    add(fsCaps, "createDirectory")
    add(fsCaps, "remove")
    add(fsCaps, "copy")
    add(fsCaps, "watch")
    add(fsCaps, "unwatch")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("fs", fsCaps))
    # command
    out = wire.RustCsgCat(out, ",")
    var commandCaps: str[]
    add(commandCaps, "exec")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("command", commandCaps))
    # search
    out = wire.RustCsgCat(out, ",")
    var searchCaps: str[]
    add(searchCaps, "files")
    add(searchCaps, "query")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("search", searchCaps))
    # git
    out = wire.RustCsgCat(out, ",")
    var gitCaps: str[]
    add(gitCaps, "diffToRemote")
    add(gitCaps, "sha")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("git", gitCaps))
    # plugin
    out = wire.RustCsgCat(out, ",")
    var pluginCaps: str[]
    add(pluginCaps, "list")
    add(pluginCaps, "install")
    add(pluginCaps, "uninstall")
    add(pluginCaps, "update")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("plugin", pluginCaps))
    # environment
    out = wire.RustCsgCat(out, ",")
    var envCaps: str[]
    add(envCaps, "get")
    add(envCaps, "listVariables")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("environment", envCaps))
    # feedback
    out = wire.RustCsgCat(out, ",")
    var feedbackCaps: str[]
    add(feedbackCaps, "send")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("feedback", feedbackCaps))
    # models
    out = wire.RustCsgCat(out, ",")
    var modelsCaps: str[]
    add(modelsCaps, "list")
    add(modelsCaps, "providers")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("models", modelsCaps))
    # attestation
    out = wire.RustCsgCat(out, ",")
    var attestationCaps: str[]
    add(attestationCaps, "challenge")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("attestation", attestationCaps))
    # experimental
    out = wire.RustCsgCat(out, ",")
    var experimentalCaps: str[]
    add(experimentalCaps, "features")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("experimental", experimentalCaps))
    # remoteControl
    out = wire.RustCsgCat(out, ",")
    var remoteControlCaps: str[]
    add(remoteControlCaps, "status")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("remoteControl", remoteControlCaps))
    # externalAgent
    out = wire.RustCsgCat(out, ",")
    var externalAgentCaps: str[]
    add(externalAgentCaps, "status")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("externalAgent", externalAgentCaps))
    # hooks
    out = wire.RustCsgCat(out, ",")
    var hooksCaps: str[]
    add(hooksCaps, "list")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("hooks", hooksCaps))
    # codex
    out = wire.RustCsgCat(out, ",")
    var codexCaps: str[]
    add(codexCaps, "version")
    add(codexCaps, "status")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("codex", codexCaps))
    # metrics
    out = wire.RustCsgCat(out, ",")
    var metricsCaps: str[]
    add(metricsCaps, "status")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("metrics", metricsCaps))
    # sandbox
    out = wire.RustCsgCat(out, ",")
    var sandboxCaps: str[]
    add(sandboxCaps, "modes")
    add(sandboxCaps, "status")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("sandbox", sandboxCaps))
    # approval
    out = wire.RustCsgCat(out, ",")
    var approvalCaps: str[]
    add(approvalCaps, "policies")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("approval", approvalCaps))
    # data
    out = wire.RustCsgCat(out, ",")
    var dataCaps: str[]
    add(dataCaps, "export")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("data", dataCaps))
    # update
    out = wire.RustCsgCat(out, ",")
    var updateCaps: str[]
    add(updateCaps, "check")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("update", updateCaps))
    # rateLimit
    out = wire.RustCsgCat(out, ",")
    var rateLimitCaps: str[]
    add(rateLimitCaps, "status")
    add(rateLimitCaps, "dashboard")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("rateLimit", rateLimitCaps))
    # modelProvider
    out = wire.RustCsgCat(out, ",")
    var modelProviderCaps: str[]
    add(modelProviderCaps, "capabilities")
    add(modelProviderCaps, "models")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("modelProvider", modelProviderCaps))
    # completion
    out = wire.RustCsgCat(out, ",")
    var completionCaps: str[]
    add(completionCaps, "stream")
    add(completionCaps, "chat")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("completion", completionCaps))
    # embedding
    out = wire.RustCsgCat(out, ",")
    var embeddingCaps: str[]
    add(embeddingCaps, "create")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("embedding", embeddingCaps))
    # image
    out = wire.RustCsgCat(out, ",")
    var imageCaps: str[]
    add(imageCaps, "generate")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStringArray("image", imageCaps))
    out = wire.RustCsgCat(out, "}}")
    return out

fn rustCsgAppServerHandleExternalAgentStatus(id: int32): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("migrationAvailable", false))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("currentAgent", "native"))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerHandleHooksList(id: int32): str =
    return rustCsgAppServerResponse(id, "{\"hooks\":[]}")

fn rustCsgAppServerHandleAccountGet(id: int32, body: str): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32000, pathError)
    let authPath = home.RustCsgPathJoinChild(codexHome, "auth.json")
    let authContent = home.RustCsgReadFile(authPath)
    if authContent == "":
        return rustCsgAppServerResponse(id, "{\"account\":null,\"authMode\":\"none\"}")
    if wire.RustCsgContains(authContent, "\"auth_mode\""):
        let authMode = wire.RustCsgJsonFindStr(authContent, "auth_mode")
        if authMode == "ApiKey":
            var apiKey = wire.RustCsgJsonFindStr(authContent, "api_key")
            if apiKey == "":
                apiKey = wire.RustCsgJsonFindStr(authContent, "apiKey")
            var maskedKey: str
            if apiKey != "":
                if apiKey.len > 4:
                    maskedKey = wire.RustCsgCat(strings.SliceBytes(apiKey, 0, 4), "...")
                else:
                    maskedKey = apiKey
            var out = "{"
            out = wire.RustCsgCat(out, "\"account\":{\"type\":\"apiKey\",\"apiKeyMask\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(maskedKey))
            out = wire.RustCsgCat(out, "},\"authMode\":\"apiKey\"}")
            return rustCsgAppServerResponse(id, out)
        if authMode == "Chatgpt":
            var email = wire.RustCsgJsonFindOptionalStr(authContent, "email")
            if email == "":
                email = ""
            var planType = wire.RustCsgJsonFindOptionalStr(authContent, "plan_type")
            if planType == "":
                planType = "unknown"
            var out = "{"
            out = wire.RustCsgCat(out, "\"account\":{\"type\":\"chatgpt\",\"email\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(email))
            out = wire.RustCsgCat(out, ",\"planType\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(planType))
            out = wire.RustCsgCat(out, "},\"authMode\":\"chatgpt\"}")
            return rustCsgAppServerResponse(id, out)
        if authMode == "ChatgptAuthTokens":
            var email = wire.RustCsgJsonFindOptionalStr(authContent, "email")
            if email == "":
                email = ""
            var planType = wire.RustCsgJsonFindOptionalStr(authContent, "plan_type")
            if planType == "":
                planType = "unknown"
            var out = "{"
            out = wire.RustCsgCat(out, "\"account\":{\"type\":\"chatgpt\",\"email\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(email))
            out = wire.RustCsgCat(out, ",\"planType\":")
            out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(planType))
            out = wire.RustCsgCat(out, "},\"authMode\":\"chatgptAuthTokens\"}")
            return rustCsgAppServerResponse(id, out)
    return rustCsgAppServerResponse(id, "{\"account\":null,\"authMode\":\"none\"}")

fn rustCsgAppServerStatusEnvPath(): str =
    let overridePath = RustCsgGetEnv("CODEX_STATUS_ENV_PATH")
    if overridePath != "":
        return overridePath
    return rustCsgAppServerNearestDotEnvFromCurrentDir()

fn rustCsgAppServerPathWithoutTrailingSlash(path: str): str =
    var end = path.len
    while end > 1 && path[end - 1] == '/':
        end = end - 1
    if end == path.len:
        return path
    return strings.SliceBytes(path, 0, end)

fn rustCsgAppServerPathParent(path: str): str =
    let clean = rustCsgAppServerPathWithoutTrailingSlash(path)
    if clean == "" || clean == "/":
        return ""
    var i = clean.len
    while i > 0:
        i = i - 1
        if clean[i] == '/':
            if i == 0:
                return "/"
            return strings.SliceBytes(clean, 0, i)
    return ""

fn rustCsgAppServerNearestDotEnvFromCurrentDir(): str =
    let currentDir = rustCsgAppServerNormalizePathRelativeToCurrentDir(".")
    if currentDir == "":
        return ".env"
    var dir = currentDir
    while dir != "":
        let candidate = home.RustCsgPathJoinChild(dir, ".env")
        if home.RustCsgPathMetadataKind(candidate) == 2:
            return candidate
        let parent = rustCsgAppServerPathParent(dir)
        if parent == dir || parent == "":
            break
        dir = parent
    return home.RustCsgPathJoinChild(currentDir, ".env")

fn rustCsgAppServerReadStatusEnv(path: str, outContent: var str, outError: var str): bool =
    outContent = ""
    outError = ""
    if home.RustCsgPathMetadataKind(path) != 2:
        outError = wire.RustCsgCat("failed to read env file ", path)
        return false
    outContent = home.RustCsgReadFile(path)
    return true

fn rustCsgAppServerIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn rustCsgAppServerTrim(text: str): str =
    var start: int32
    var end: int32 = text.len
    while start < end && rustCsgAppServerIsSpace(text[start]):
        start = start + 1
    while end > start && rustCsgAppServerIsSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn rustCsgAppServerStripTomlString(value: str): str =
    if value.len >= 2:
        let first = value[0]
        let last = value[value.len - 1]
        if first == '"' && last == '"':
            return strings.SliceBytes(value, 1, value.len - 2)
        if int32(first) == 39 && int32(last) == 39:
            return strings.SliceBytes(value, 1, value.len - 2)
    return value

fn rustCsgAppServerConfigTomlStringValue(content: str, key: str): str =
    var pos: int32
    while pos <= content.len:
        var lineEnd = pos
        while lineEnd < content.len && content[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        var line = strings.SliceBytes(content, pos, lineEnd - pos)
        pos = lineEnd + 1
        line = rustCsgAppServerTrim(line)
        if line == "":
            continue
        if line[0] == '#':
            continue
        var equalsAt: int32 = -1
        var i: int32
        while i < line.len:
            if line[i] == '=':
                equalsAt = i
                break
            i = i + 1
        if equalsAt <= 0:
            continue
        let lineKey = rustCsgAppServerTrim(strings.SliceBytes(line, 0, equalsAt))
        if lineKey != key:
            continue
        let rawValue = rustCsgAppServerTrim(strings.SliceBytes(line, equalsAt + 1, line.len - equalsAt - 1))
        return rustCsgAppServerStripTomlString(rawValue)
    return ""

fn rustCsgAppServerChatGptBaseUrl(codexHome: str): str =
    let overrideBaseUrl = RustCsgGetEnv("CODEX_RATE_LIMIT_DASHBOARD_CHATGPT_BASE_URL_OVERRIDE")
    if overrideBaseUrl != "":
        return overrideBaseUrl
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let content = home.RustCsgReadFile(configPath)
    if content == "":
        return ""
    return rustCsgAppServerConfigTomlStringValue(content, "chatgpt_base_url")

fn rustCsgAppServerForcedChatGptWorkspaceId(codexHome: str): str =
    let configPath = home.RustCsgPathJoinChild(codexHome, "config.toml")
    let content = home.RustCsgReadFile(configPath)
    if content == "":
        return ""
    return rustCsgAppServerConfigTomlStringValue(content, "forced_chatgpt_workspace_id")

fn rustCsgAppServerHandleStatus(id: int32): str =
    let path = rustCsgAppServerStatusEnvPath()
    var content: str
    var error: str
    if !rustCsgAppServerReadStatusEnv(path, content, error):
        return rustCsgAppServerError(id, -32000, error)
    var statusJson: str
    if !status_env.RustCsgAppServerStatusFromDotEnv(content, path, statusJson, error):
        return rustCsgAppServerError(id, -32000, error)
    return rustCsgAppServerResponse(id, statusJson)

fn rustCsgAppServerHandleAccountRateLimitsRead(id: int32): str =
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if codexHome == "":
        return rustCsgAppServerError(id, -32603, pathError)
    let chatgptBaseUrl = rustCsgAppServerChatGptBaseUrl(codexHome)
    let refreshTokenUrl = RustCsgGetEnv("CODEX_REFRESH_TOKEN_URL_OVERRIDE")
    let nowSeconds = rustCsgGetCurrentTimeMs() / int64(1000)
    var rateLimitsJson: str
    var error: str
    var invalidRequest: bool
    if !rate_limit_dashboard.RustCsgRateLimitDashboardFetchAccountRateLimitsResponseFromCodexHomeWithRefreshEndpoint(codexHome,
                                                                                                                     chatgptBaseUrl,
                                                                                                                     refreshTokenUrl,
                                                                                                                     nowSeconds,
                                                                                                                     rateLimitsJson,
                                                                                                                     error,
                                                                                                                     invalidRequest):
        if invalidRequest:
            return rustCsgAppServerError(id, -32600, error)
        return rustCsgAppServerError(id, -32603, error)
    return rustCsgAppServerResponse(id, rateLimitsJson)

fn rustCsgAppServerHandleAccountSubscriptionQuotaRead(id: int32): str =
    let path = rustCsgAppServerStatusEnvPath()
    var content: str
    var error: str
    if !rustCsgAppServerReadStatusEnv(path, content, error):
        return rustCsgAppServerError(id, -32000, error)
    var statusJson: str
    if !status_env.RustCsgAppServerSubscriptionQuotaFromDotEnv(content, path, statusJson, error):
        return rustCsgAppServerError(id, -32000, error)
    return rustCsgAppServerResponse(id, statusJson)

# ── Parse env JSON object {"K":"V"} → ["K=V"] array ────────────────

fn rustCsgAppServerParseEnvObject(envJson: str): str[] =
    var result: str[]
    if envJson == "":
        return result
    var pos: int32
    pos = 0
    while pos < envJson.len && envJson[pos] != '{':
        pos = pos + 1
    if pos >= envJson.len:
        return result
    pos = pos + 1
    while pos < envJson.len:
        while pos < envJson.len && (envJson[pos] == ' ' || envJson[pos] == '\t' || envJson[pos] == '\n' || envJson[pos] == '\r' || envJson[pos] == ','):
            pos = pos + 1
        if pos >= envJson.len || envJson[pos] == '}':
            break
        if envJson[pos] != '"':
            break
        pos = pos + 1
        var key: str
        while pos < envJson.len && envJson[pos] != '"':
            if envJson[pos] == '\\':
                pos = pos + 1
                if pos >= envJson.len:
                    return result
            key = strings.ConcatStr(key, strings.SliceBytes(envJson, pos, 1))
            pos = pos + 1
        if pos >= envJson.len:
            return result
        pos = pos + 1
        while pos < envJson.len && envJson[pos] != ':':
            pos = pos + 1
        if pos >= envJson.len:
            return result
        pos = pos + 1
        while pos < envJson.len && (envJson[pos] == ' ' || envJson[pos] == '\t'):
            pos = pos + 1
        if pos >= envJson.len:
            return result
        var value: str
        if envJson[pos] == '"':
            pos = pos + 1
            while pos < envJson.len && envJson[pos] != '"':
                if envJson[pos] == '\\':
                    pos = pos + 1
                    if pos >= envJson.len:
                        return result
                    value = strings.ConcatStr(value, strings.SliceBytes(envJson, pos, 1))
                else:
                    value = strings.ConcatStr(value, strings.SliceBytes(envJson, pos, 1))
                pos = pos + 1
            if pos >= envJson.len:
                return result
            pos = pos + 1
        else:
            while pos < envJson.len && envJson[pos] != ',' && envJson[pos] != '}' && envJson[pos] != ' ':
                value = strings.ConcatStr(value, strings.SliceBytes(envJson, pos, 1))
                pos = pos + 1
        let entry = strings.ConcatStr(strings.ConcatStr(key, "="), value)
        add(result, entry)
    return result

# ── command/exec response builders ──────────────────────────────────

fn rustCsgAppServerCommandExecResponse(id: int32, exitCode: int32, stdout: str, stderr: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("exitCode", exitCode))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("stdout", stdout))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("stderr", stderr))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerCommandExecEmptyResponse(id: int32): str =
    return rustCsgAppServerResponse(id, wire.RustCsgCat("{", "}"))

fn rustCsgAppServerCommandExecError(id: int32, error: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, "\"exitCode\":-1,\"error\":")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(error))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerCommandExecOutputDelta(processId: str, stream: str, deltaBase64: str, capReached: bool): str =
    var params = "{"
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("processId", processId))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("stream", stream))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldStr("deltaBase64", deltaBase64))
    params = wire.RustCsgCat(params, ",")
    params = wire.RustCsgCat(params, wire.RustCsgJsonFieldBool("capReached", capReached))
    params = wire.RustCsgCat(params, "}")
    var out = "{\"method\":\"command/exec/outputDelta\",\"params\":"
    out = wire.RustCsgCat(out, params)
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgAppServerWriteCommandExecDelta(fd: int32, writerKind: int32, processId: str, stream: str, chunk: str, capReached: bool): bool =
    if chunk.len == 0:
        return true
    let deltaBase64 = rustCsgAppServerBase64Encode(chunk)
    let notification = rustCsgAppServerCommandExecOutputDelta(processId, stream, deltaBase64, capReached)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, notification)

fn rustCsgAppServerIsBase64Char(ch: char): bool =
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '+' || ch == '/' || ch == '=':
        return true
    if ch == '\n' || ch == '\r' || ch == '\t' || ch == ' ':
        return true
    return false

fn rustCsgAppServerLooksLikeBase64(value: str): bool =
    var count: int32
    var i: int32
    while i < value.len:
        if !rustCsgAppServerIsBase64Char(value[i]):
            return false
        if value[i] != '\n' && value[i] != '\r' && value[i] != '\t' && value[i] != ' ':
            count = count + 1
        i = i + 1
    if count == 0:
        return true
    return (count % 4) == 0

fn rustCsgAppServerCommandExecCapChunk(chunk: str, cap: int32, seen: var int32, capReached: var bool): str =
    capReached = false
    if cap < 0:
        return chunk
    if seen >= cap:
        capReached = true
        return ""
    var keep = chunk.len
    let remaining = cap - seen
    if keep > remaining:
        keep = remaining
    seen = seen + keep
    if seen >= cap:
        capReached = true
    return strings.SliceBytes(chunk, 0, keep)

fn rustCsgAppServerRecordCommandExecChunk(writerFd: int32,
                                          writerKind: int32,
                                          processId: str,
                                          stream: str,
                                          chunk: str,
                                          capReached: bool,
                                          streamOutput: bool,
                                          buffer: var str): bool =
    if chunk.len == 0:
        return true
    if streamOutput:
        return rustCsgAppServerWriteCommandExecDelta(writerFd, writerKind, processId, stream, chunk, capReached)
    buffer = wire.RustCsgCat(buffer, chunk)
    return true

fn rustCsgAppServerDrainCommandExecFd(index: int32, fd: int32, stream: str, seen: var int32, buffer: var str): bool =
    let writerFd = RustCsgAppServerExecWriterFds[index]
    let writerKind = RustCsgAppServerExecWriterKinds[index]
    let processId = RustCsgAppServerExecIds[index]
    let outputCap = RustCsgAppServerExecOutputCaps[index]
    let streamOutput = RustCsgAppServerExecStreamOutput[index] != 0
    while true:
        let chunk = process.ProcessReadFd(fd)
        if chunk.len == 0:
            return true
        var capReached: bool
        let capped = rustCsgAppServerCommandExecCapChunk(chunk, outputCap, seen, capReached)
        if !rustCsgAppServerRecordCommandExecChunk(writerFd, writerKind, processId, stream, capped, capReached, streamOutput, buffer):
            return false

fn rustCsgAppServerReadCommandExecFdBlocking(index: int32, fd: int32, stream: str, timeoutMs: int32, seen: var int32, buffer: var str): bool =
    let chunk = process.ProcessReadFdBlocking(fd, timeoutMs)
    if chunk.len == 0:
        return true
    let writerFd = RustCsgAppServerExecWriterFds[index]
    let writerKind = RustCsgAppServerExecWriterKinds[index]
    let processId = RustCsgAppServerExecIds[index]
    let outputCap = RustCsgAppServerExecOutputCaps[index]
    let streamOutput = RustCsgAppServerExecStreamOutput[index] != 0
    var capReached: bool
    let capped = rustCsgAppServerCommandExecCapChunk(chunk, outputCap, seen, capReached)
    return rustCsgAppServerRecordCommandExecChunk(writerFd, writerKind, processId, stream, capped, capReached, streamOutput, buffer)

fn rustCsgAppServerStoreExecSessionOutput(index: int32, stdoutSeen: int32, stderrSeen: int32, stdoutBuffer: str, stderrBuffer: str) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    var nextStdoutSeen: int32[]
    var nextStderrSeen: int32[]
    var nextStdoutBuffers: str[]
    var nextStderrBuffers: str[]
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if i == index:
            add(nextStdoutSeen, stdoutSeen)
            add(nextStderrSeen, stderrSeen)
            add(nextStdoutBuffers, stdoutBuffer)
            add(nextStderrBuffers, stderrBuffer)
        else:
            add(nextStdoutSeen, RustCsgAppServerExecStdoutSeen[i])
            add(nextStderrSeen, RustCsgAppServerExecStderrSeen[i])
            add(nextStdoutBuffers, RustCsgAppServerExecStdoutBuffers[i])
            add(nextStderrBuffers, RustCsgAppServerExecStderrBuffers[i])
        i = i + 1
    RustCsgAppServerExecStdoutSeen = nextStdoutSeen
    RustCsgAppServerExecStderrSeen = nextStderrSeen
    RustCsgAppServerExecStdoutBuffers = nextStdoutBuffers
    RustCsgAppServerExecStderrBuffers = nextStderrBuffers

fn rustCsgAppServerMarkExecStdinClosed(index: int32) =
    if !rustCsgAppServerExecSessionValid(index):
        return
    var nextStdinFds: int32[]
    var nextStdinClosed: int32[]
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if i == index:
            add(nextStdinFds, -1)
            add(nextStdinClosed, 1)
        else:
            add(nextStdinFds, RustCsgAppServerExecStdinFds[i])
            add(nextStdinClosed, RustCsgAppServerExecStdinClosed[i])
        i = i + 1
    RustCsgAppServerExecStdinFds = nextStdinFds
    RustCsgAppServerExecStdinClosed = nextStdinClosed

fn rustCsgAppServerPumpExecSession(index: int32): bool =
    if !rustCsgAppServerExecSessionValid(index):
        return true
    let processId = RustCsgAppServerExecIds[index]
    let writerFd = RustCsgAppServerExecWriterFds[index]
    let writerKind = RustCsgAppServerExecWriterKinds[index]
    let outputCap = RustCsgAppServerExecOutputCaps[index]
    let streamOutput = RustCsgAppServerExecStreamOutput[index] != 0
    var stdoutSeen = RustCsgAppServerExecStdoutSeen[index]
    var stderrSeen = RustCsgAppServerExecStderrSeen[index]
    var stdoutBuffer = RustCsgAppServerExecStdoutBuffers[index]
    var stderrBuffer = RustCsgAppServerExecStderrBuffers[index]
    let timeoutLimitMs = RustCsgAppServerExecTimeoutMs[index]
    if timeoutLimitMs >= 0:
        let elapsedMs = (rustCsgAppServerNowSeconds() - RustCsgAppServerExecStartSeconds[index]) * 1000 + (rustCsgAppServerNowMillisPart() - RustCsgAppServerExecStartMillisPart[index])
        if elapsedMs >= timeoutLimitMs:
            rustCsgAppServerKillWaitExecSession(index)
            if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStdoutFds[index], "stdout", stdoutSeen, stdoutBuffer):
                rustCsgAppServerDropExecSession(index)
                return false
            if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStderrFds[index], "stderr", stderrSeen, stderrBuffer):
                rustCsgAppServerDropExecSession(index)
                return false
            let timeoutResponse = rustCsgAppServerCommandExecResponse(RustCsgAppServerExecRequestIds[index], 124, stdoutBuffer, stderrBuffer)
            if !rustCsgAppServerWriteJsonMessage(writerFd, writerKind, timeoutResponse):
                rustCsgAppServerRecordCommandExecAfter(index, false, "failed to write timeout response")
                rustCsgAppServerDropExecSession(index)
                return false
            rustCsgAppServerRecordCommandExecAfter(index, false, "exitCode=124")
            rustCsgAppServerDropExecSession(index)
            return true
    if !rustCsgAppServerReadCommandExecFdBlocking(index, RustCsgAppServerExecStdoutFds[index], "stdout", 20, stdoutSeen, stdoutBuffer):
        rustCsgAppServerAbortExecSession(index)
        return false
    if !rustCsgAppServerReadCommandExecFdBlocking(index, RustCsgAppServerExecStderrFds[index], "stderr", 1, stderrSeen, stderrBuffer):
        rustCsgAppServerAbortExecSession(index)
        return false
    if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStdoutFds[index], "stdout", stdoutSeen, stdoutBuffer):
        rustCsgAppServerAbortExecSession(index)
        return false
    if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStderrFds[index], "stderr", stderrSeen, stderrBuffer):
        rustCsgAppServerAbortExecSession(index)
        return false
    rustCsgAppServerStoreExecSessionOutput(index, stdoutSeen, stderrSeen, stdoutBuffer, stderrBuffer)
    var exitCode = process.ProcessTryWait(RustCsgAppServerExecPids[index])
    if exitCode == -2:
        return true
    if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStdoutFds[index], "stdout", stdoutSeen, stdoutBuffer):
        process.ProcessWait(RustCsgAppServerExecPids[index])
        rustCsgAppServerDropExecSession(index)
        return false
    if !rustCsgAppServerDrainCommandExecFd(index, RustCsgAppServerExecStderrFds[index], "stderr", stderrSeen, stderrBuffer):
        process.ProcessWait(RustCsgAppServerExecPids[index])
        rustCsgAppServerDropExecSession(index)
        return false
    let waited = process.ProcessWait(RustCsgAppServerExecPids[index])
    if exitCode == -2:
        exitCode = waited
    let response = rustCsgAppServerCommandExecResponse(RustCsgAppServerExecRequestIds[index], exitCode, stdoutBuffer, stderrBuffer)
    if !rustCsgAppServerWriteJsonMessage(writerFd, writerKind, response):
        rustCsgAppServerRecordCommandExecAfter(index, false, "failed to write command response")
        rustCsgAppServerDropExecSession(index)
        return false
    let ok = exitCode == 0
    let detail = wire.RustCsgCat("exitCode=", strings.IntToStr(exitCode))
    rustCsgAppServerRecordCommandExecAfter(index, ok, detail)
    rustCsgAppServerDropExecSession(index)
    return true

fn rustCsgAppServerPumpExecSessions(): bool =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        let before = RustCsgAppServerExecIds.len
        if !rustCsgAppServerPumpExecSession(i):
            return false
        if RustCsgAppServerExecIds.len == before:
            i = i + 1
    return true

fn rustCsgAppServerPumpExecSessionsForConnection(connectionId: int32): bool =
    var i: int32
    while i < RustCsgAppServerExecIds.len:
        if rustCsgAppServerExecSessionValid(i) && RustCsgAppServerExecConnectionIds[i] == connectionId:
            let before = RustCsgAppServerExecIds.len
            if !rustCsgAppServerPumpExecSession(i):
                return false
            if RustCsgAppServerExecIds.len == before:
                i = i + 1
        else:
            i = i + 1
    return true

fn rustCsgAppServerHandleCommandExecWriteScoped(id: int32, body: str, connectionScoped: bool, connectionId: int32): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let processId = wire.RustCsgJsonFindOptionalStr(paramsJson, "processId")
    let deltaRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "deltaBase64")
    let closeStdin = wire.RustCsgJsonFindOptionalBool(paramsJson, "closeStdin")
    var hasDelta: bool
    if deltaRaw != "":
        if deltaRaw != "null":
            hasDelta = true
    if !hasDelta && !closeStdin:
        return rustCsgAppServerError(id, -32602, "command/exec/write requires deltaBase64 or closeStdin")
    var index = rustCsgAppServerExecSessionIndex(processId)
    if connectionScoped:
        index = rustCsgAppServerExecSessionIndexForConnection(processId, connectionId)
    if index < 0:
        return rustCsgAppServerError(id, -32600, rustCsgAppServerNoActiveCommandExecMessage(processId))
    if RustCsgAppServerExecStreamStdin[index] == 0:
        return rustCsgAppServerError(id, -32600, "stdin streaming is not enabled for this command/exec")
    if RustCsgAppServerExecStdinClosed[index] != 0:
        return rustCsgAppServerError(id, -32600, "stdin is already closed")
    if hasDelta:
        if deltaRaw.len == 0 || deltaRaw[0] != '"':
            return rustCsgAppServerError(id, -32602, "invalid deltaBase64: expected string")
        let deltaBase64 = wire.RustCsgJsonFindStr(paramsJson, "deltaBase64")
        if !rustCsgAppServerLooksLikeBase64(deltaBase64):
            return rustCsgAppServerError(id, -32602, "invalid deltaBase64: invalid byte")
        let delta = rustCsgAppServerBase64Decode(deltaBase64)
        if delta.len > 0:
            if !rustCsgAppServerWriteAll(RustCsgAppServerExecStdinFds[index], delta):
                if process.ProcessTryWait(RustCsgAppServerExecPids[index]) != -2:
                    return rustCsgAppServerError(id, -32600, rustCsgAppServerNoLongerRunningCommandExecMessage(processId))
                return rustCsgAppServerError(id, -32600, "stdin is already closed")
    if closeStdin:
        if RustCsgAppServerExecIsPty[index] == 0:
            process.ProcessCloseFd(RustCsgAppServerExecStdinFds[index])
        rustCsgAppServerMarkExecStdinClosed(index)
    return rustCsgAppServerCommandExecEmptyResponse(id)

fn rustCsgAppServerHandleCommandExecWrite(id: int32, body: str): str =
    return rustCsgAppServerHandleCommandExecWriteScoped(id, body, true, 0)

fn rustCsgAppServerHandleCommandExecTerminateScoped(id: int32, body: str, connectionScoped: bool, connectionId: int32): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let processId = wire.RustCsgJsonFindOptionalStr(paramsJson, "processId")
    var index = rustCsgAppServerExecSessionIndex(processId)
    if connectionScoped:
        index = rustCsgAppServerExecSessionIndexForConnection(processId, connectionId)
    if index < 0:
        return rustCsgAppServerError(id, -32600, rustCsgAppServerNoActiveCommandExecMessage(processId))
    let killRet = process.ProcessKillGroup(RustCsgAppServerExecPids[index], 15)
    if killRet != 0:
        if process.ProcessTryWait(RustCsgAppServerExecPids[index]) != -2:
            return rustCsgAppServerError(id, -32600, rustCsgAppServerNoLongerRunningCommandExecMessage(processId))
    return rustCsgAppServerCommandExecEmptyResponse(id)

fn rustCsgAppServerHandleCommandExecTerminate(id: int32, body: str): str =
    return rustCsgAppServerHandleCommandExecTerminateScoped(id, body, true, 0)

fn rustCsgAppServerHandleCommandExecResizeScoped(id: int32, body: str, connectionScoped: bool, connectionId: int32): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let processId = wire.RustCsgJsonFindOptionalStr(paramsJson, "processId")
    var index = rustCsgAppServerExecSessionIndex(processId)
    if connectionScoped:
        index = rustCsgAppServerExecSessionIndexForConnection(processId, connectionId)
    if index < 0:
        return rustCsgAppServerError(id, -32600, rustCsgAppServerNoActiveCommandExecMessage(processId))
    let sizeJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "size")
    var rows: int32
    var cols: int32
    if sizeJson != "":
        if sizeJson != "null":
            if sizeJson.len > 0 && sizeJson[0] == '{':
                if wire.RustCsgContains(sizeJson, "\"rows\""):
                    rows = wire.RustCsgJsonFindInt32(sizeJson, "rows")
                if wire.RustCsgContains(sizeJson, "\"cols\""):
                    cols = wire.RustCsgJsonFindInt32(sizeJson, "cols")
    if rows <= 0 || cols <= 0:
        return rustCsgAppServerError(id, -32602, "command/exec size rows and cols must be greater than 0")
    if RustCsgAppServerExecIsPty[index] == 0:
        return rustCsgAppServerError(id, -32600, "failed to resize PTY: process is not attached to a PTY")
    if process.ProcessResizePty(RustCsgAppServerExecPtyFds[index], rows, cols) != 0:
        return rustCsgAppServerError(id, -32600, "failed to resize PTY: resize failed")
    return rustCsgAppServerCommandExecEmptyResponse(id)

fn rustCsgAppServerHandleCommandExecResize(id: int32, body: str): str =
    return rustCsgAppServerHandleCommandExecResizeScoped(id, body, true, 0)

fn rustCsgAppServerHandleCommandExecWriteWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let response = rustCsgAppServerHandleCommandExecWriteScoped(id, body, true, connectionId)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    return rustCsgAppServerPumpExecSessionsForConnection(connectionId)

fn rustCsgAppServerHandleCommandExecTerminateWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let response = rustCsgAppServerHandleCommandExecTerminateScoped(id, body, true, connectionId)
    if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
        return false
    return rustCsgAppServerPumpExecSessionsForConnection(connectionId)

fn rustCsgAppServerHandleCommandExecResizeWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let response = rustCsgAppServerHandleCommandExecResizeScoped(id, body, true, connectionId)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, response)

# ── Build Seatbelt sandbox profile string ───────────────────────────────────
# Modes: read-only, workspace-write, danger-full-access

fn rustCsgAppServerSeatbeltAppendWritableRoot(profile: str, root: str): str =
    if root == "":
        return profile
    if root[0] != '/':
        return profile
    var seatbeltRoot = root
    let realRoot = home.RustCsgRealPath(root)
    if realRoot != "":
        seatbeltRoot = realRoot
    var out = profile
    out = wire.RustCsgCat(out, "(allow file-write* (subpath ")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(seatbeltRoot))
    out = wire.RustCsgCat(out, "))\n")
    return out

fn rustCsgAppServerParseSandboxWritableRoots(sandboxPolicyJson: str): str[] =
    var roots: str[]
    if sandboxPolicyJson == "":
        return roots
    if sandboxPolicyJson == "null":
        return roots
    let writableRootsJson = wire.RustCsgJsonFindOptionalValueRaw(sandboxPolicyJson, "writableRoots")
    if writableRootsJson == "":
        return roots
    if writableRootsJson == "null":
        return roots
    if writableRootsJson.len == 0:
        return roots
    if writableRootsJson[0] != '[':
        return roots
    return wire.RustCsgJsonStringArrayFromRaw(writableRootsJson)

fn rustCsgAppServerBuildSeatbeltProfile(mode: str, cwd: str, writableRoots: str[]): str =
    var profile: str = "(version 1)\n"
    profile = wire.RustCsgCat(profile, "(deny default)\n")
    profile = wire.RustCsgCat(profile, "(allow process-exec)\n")
    profile = wire.RustCsgCat(profile, "(allow process-fork)\n")
    profile = wire.RustCsgCat(profile, "(allow signal (target same-sandbox))\n")
    profile = wire.RustCsgCat(profile, "(allow process-info* (target same-sandbox))\n")
    profile = wire.RustCsgCat(profile, "(allow sysctl-read)\n")
    profile = wire.RustCsgCat(profile, "(allow file-read*)\n")
    profile = wire.RustCsgCat(profile, "(allow file-write-data (require-all (path \"/dev/null\") (vnode-type CHARACTER-DEVICE)))\n")
    profile = wire.RustCsgCat(profile, "(allow pseudo-tty)\n")
    profile = wire.RustCsgCat(profile, "(allow file-read* file-write* file-ioctl (literal \"/dev/ptmx\"))\n")
    profile = wire.RustCsgCat(profile, "(allow file-read* file-write* (require-all (regex #\"^/dev/ttys[0-9]+\") (extension \"com.apple.sandbox.pty\")))\n")
    profile = wire.RustCsgCat(profile, "(allow file-ioctl (regex #\"^/dev/ttys[0-9]+\"))\n")
    if mode == "workspace-write":
        profile = rustCsgAppServerSeatbeltAppendWritableRoot(profile, cwd)
        for i in 0..<writableRoots.len:
            profile = rustCsgAppServerSeatbeltAppendWritableRoot(profile, writableRoots[i])
    return profile

# ── command/exec handler with sandbox support ────────────────────────────────

fn rustCsgAppServerHandleCommandExec(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let commandRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "command")
    if commandRaw == "":
        return rustCsgAppServerError(id, -32600, "command must not be empty")
    if commandRaw.len == 0:
        return rustCsgAppServerError(id, -32600, "command must not be empty")
    if commandRaw[0] != '[':
        return rustCsgAppServerError(id, -32600, "command must be a non-empty array")
    let commandItems = wire.RustCsgJsonStringArrayFromRaw(commandRaw)
    if commandItems.len == 0:
        return rustCsgAppServerError(id, -32600, "command must not be empty")
    let command = commandItems[0]
    var args: str[]
    args = []
    for i in 1..<commandItems.len:
        add(args, commandItems[i])
    let cwd = wire.RustCsgJsonFindOptionalStr(paramsJson, "cwd")
    var env: str[]
    if wire.RustCsgContains(paramsJson, "\"env\":{"):
        let envJson = wire.RustCsgJsonFindObject(paramsJson, "env")
        env = rustCsgAppServerParseEnvObject(envJson)
    else:
        env = []
    let stdin = wire.RustCsgJsonFindOptionalStr(paramsJson, "stdin")
    let chengMutationPath = rustCsgAppServerCommandChengMutationPath(commandItems, cwd)
    if chengMutationPath != "":
        var gateReason: str
        if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("commandExec", chengMutationPath, gateReason):
            return rustCsgAppServerError(id, -32603, gateReason)
    let processId = wire.RustCsgJsonFindOptionalStr(paramsJson, "processId")
    let tty = wire.RustCsgJsonFindOptionalBool(paramsJson, "tty")
    let streamStdin = wire.RustCsgJsonFindOptionalBool(paramsJson, "streamStdin")
    let streamStdoutStderr = wire.RustCsgJsonFindOptionalBool(paramsJson, "streamStdoutStderr")
    let outputBytesCapJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "outputBytesCap")
    let disableOutputCap = wire.RustCsgJsonFindOptionalBool(paramsJson, "disableOutputCap")
    if outputBytesCapJson != "":
        if outputBytesCapJson != "null":
            if disableOutputCap:
                return rustCsgAppServerError(id, -32602, "command/exec cannot set both outputBytesCap and disableOutputCap")
    let timeoutMsJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "timeoutMs")
    let disableTimeout = wire.RustCsgJsonFindOptionalBool(paramsJson, "disableTimeout")
    if timeoutMsJson != "":
        if timeoutMsJson != "null":
            if disableTimeout:
                return rustCsgAppServerError(id, -32602, "command/exec cannot set both timeoutMs and disableTimeout")
            if timeoutMsJson.len > 0:
                if timeoutMsJson[0] == '-':
                    return rustCsgAppServerError(id, -32602, wire.RustCsgCat("command/exec timeoutMs must be non-negative, got ", timeoutMsJson))
    let sizeJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "size")
    if sizeJson != "":
        if sizeJson != "null":
            if !tty:
                return rustCsgAppServerError(id, -32602, "command/exec size requires tty: true")
    let sandboxPolicyJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "sandboxPolicy")
    let permissionProfileJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "permissionProfile")
    if permissionProfileJson != "":
        if permissionProfileJson != "null":
            return rustCsgAppServerError(id, -32600, "command/exec.permissionProfile requires experimentalApi capability")
    if tty || streamStdin || streamStdoutStderr:
        if processId == "":
            return rustCsgAppServerError(id, -32600, "command/exec tty or streaming requires a client-supplied processId")
        return rustCsgAppServerError(id, -32601, "command/exec streaming requires writer-based transport")

    var sandboxMode: str = "workspace-write"
    var sandboxWritableRoots: str[]
    if sandboxPolicyJson != "":
        if sandboxPolicyJson != "null":
            if sandboxPolicyJson.len == 0:
                return rustCsgAppServerError(id, -32602, "command/exec sandboxPolicy must be an object")
            if sandboxPolicyJson[0] != '{':
                return rustCsgAppServerError(id, -32602, "command/exec sandboxPolicy must be an object")
            let sandboxType = wire.RustCsgJsonFindStr(sandboxPolicyJson, "type")
            if sandboxType == "dangerFullAccess":
                sandboxMode = "danger-full-access"
            elif sandboxType == "readOnly":
                sandboxMode = "read-only"
            elif sandboxType == "workspaceWrite":
                sandboxMode = "workspace-write"
                sandboxWritableRoots = rustCsgAppServerParseSandboxWritableRoots(sandboxPolicyJson)
            else:
                return rustCsgAppServerError(id, -32602, wire.RustCsgCat("unsupported command/exec sandboxPolicy type: ", sandboxType))

    var result: process.ProcessResult

    if sandboxMode == "danger-full-access":
        # Direct execution, no sandbox
        if stdin != "":
            let tmpFile = rustCsgAppServerCreateTempFile("csg-exec-stdin-")
            if tmpFile == "":
                return rustCsgAppServerError(id, -32603, "failed to create temp file")
            let writeRet = rustCsgAppServerWriteFile(tmpFile, stdin)
            if writeRet <= 0:
                rustCsgAppServerFileDelete(tmpFile)
                return rustCsgAppServerError(id, -32603, "failed to write stdin to temp file")
            var shellArgs: str[]
            add(shellArgs, "-c")
            let redirectCmd = strings.ConcatStr("exec \"$@\" < ", tmpFile)
            add(shellArgs, redirectCmd)
            add(shellArgs, "sh")
            add(shellArgs, command)
            for i in 0..<args.len:
                add(shellArgs, args[i])
            result = process.ProcessSpawn("/bin/sh", shellArgs, cwd, env)
            rustCsgAppServerFileDelete(tmpFile)
        else:
            result = process.ProcessSpawn(command, args, cwd, env)
        if result.ok:
            if chengMutationPath != "":
                cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, result.exitCode == 0, wire.RustCsgCat("exitCode=", strings.IntToStr(result.exitCode)))
            return rustCsgAppServerCommandExecResponse(id, result.exitCode, result.stdout, result.stderr)
        if chengMutationPath != "":
            cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, false, result.error)
        return rustCsgAppServerCommandExecError(id, result.error)

    # Sandboxed execution with Seatbelt profile
    let profile = rustCsgAppServerBuildSeatbeltProfile(sandboxMode, cwd, sandboxWritableRoots)
    if stdin != "":
        let tmpFile = rustCsgAppServerCreateTempFile("csg-exec-stdin-")
        if tmpFile == "":
            return rustCsgAppServerError(id, -32603, "failed to create temp file")
        let writeRet = rustCsgAppServerWriteFile(tmpFile, stdin)
        if writeRet <= 0:
            rustCsgAppServerFileDelete(tmpFile)
            return rustCsgAppServerError(id, -32603, "failed to write stdin to temp file")
        var shellArgs: str[]
        add(shellArgs, "-c")
        let redirectCmd = strings.ConcatStr("exec \"$@\" < ", tmpFile)
        add(shellArgs, redirectCmd)
        add(shellArgs, "sh")
        add(shellArgs, command)
        for i in 0..<args.len:
            add(shellArgs, args[i])
        result = process.ProcessSpawnSeatbelt("/bin/sh", shellArgs, cwd, env, profile)
        rustCsgAppServerFileDelete(tmpFile)
    else:
        result = process.ProcessSpawnSeatbelt(command, args, cwd, env, profile)
    if result.ok:
        if chengMutationPath != "":
            cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, result.exitCode == 0, wire.RustCsgCat("exitCode=", strings.IntToStr(result.exitCode)))
        return rustCsgAppServerCommandExecResponse(id, result.exitCode, result.stdout, result.stderr)
    if chengMutationPath != "":
        cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, false, result.error)
    return rustCsgAppServerCommandExecError(id, result.error)

fn rustCsgAppServerHandleCommandExecWriter(id: int32, body: str, fd: int32, writerKind: int32, connectionId: int32): bool =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let streamStdoutStderr = wire.RustCsgJsonFindOptionalBool(paramsJson, "streamStdoutStderr")
    let tty = wire.RustCsgJsonFindOptionalBool(paramsJson, "tty")
    let streamStdin = wire.RustCsgJsonFindOptionalBool(paramsJson, "streamStdin")
    if !streamStdoutStderr && !tty && !streamStdin:
        let response = rustCsgAppServerHandleCommandExec(id, body)
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, response)

    let commandRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "command")
    if commandRaw == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command must not be empty"))
    if commandRaw.len == 0:
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command must not be empty"))
    if commandRaw[0] != '[':
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command must be a non-empty array"))
    let commandItems = wire.RustCsgJsonStringArrayFromRaw(commandRaw)
    if commandItems.len == 0:
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command must not be empty"))
    let command = commandItems[0]
    var args: str[]
    args = []
    for i in 1..<commandItems.len:
        add(args, commandItems[i])

    let cwd = wire.RustCsgJsonFindOptionalStr(paramsJson, "cwd")
    var env: str[]
    if wire.RustCsgContains(paramsJson, "\"env\":{"):
        let envJson = wire.RustCsgJsonFindObject(paramsJson, "env")
        env = rustCsgAppServerParseEnvObject(envJson)
    else:
        env = []

    let chengMutationPath = rustCsgAppServerCommandChengMutationPath(commandItems, cwd)
    if chengMutationPath != "":
        var gateReason: str
        if !cheng_write_gateway.ChengWriteGatewayCheckAllowed("commandExec", chengMutationPath, gateReason):
            return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32603, gateReason))

    let processId = wire.RustCsgJsonFindOptionalStr(paramsJson, "processId")
    let outputBytesCapJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "outputBytesCap")
    let disableOutputCap = wire.RustCsgJsonFindOptionalBool(paramsJson, "disableOutputCap")
    if outputBytesCapJson != "":
        if outputBytesCapJson != "null":
            if disableOutputCap:
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec cannot set both outputBytesCap and disableOutputCap"))
            if outputBytesCapJson.len > 0:
                if outputBytesCapJson[0] == '-':
                    return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, wire.RustCsgCat("command/exec outputBytesCap must be non-negative, got ", outputBytesCapJson)))
    let timeoutMsJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "timeoutMs")
    let disableTimeout = wire.RustCsgJsonFindOptionalBool(paramsJson, "disableTimeout")
    if timeoutMsJson != "":
        if timeoutMsJson != "null":
            if disableTimeout:
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec cannot set both timeoutMs and disableTimeout"))
            if timeoutMsJson.len > 0:
                if timeoutMsJson[0] == '-':
                    return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, wire.RustCsgCat("command/exec timeoutMs must be non-negative, got ", timeoutMsJson)))
    let sizeJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "size")
    if sizeJson != "":
        if sizeJson != "null":
            if !tty:
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec size requires tty: true"))
    let sandboxPolicyJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "sandboxPolicy")
    let permissionProfileJson = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "permissionProfile")
    if permissionProfileJson != "":
        if permissionProfileJson != "null":
            return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command/exec.permissionProfile requires experimentalApi capability"))
    if processId == "":
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, "command/exec tty or streaming requires a client-supplied processId"))
    var sandboxMode: str = "workspace-write"
    var sandboxWritableRoots: str[]
    if sandboxPolicyJson != "":
        if sandboxPolicyJson != "null":
            if sandboxPolicyJson.len == 0:
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec sandboxPolicy must be an object"))
            if sandboxPolicyJson[0] != '{':
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec sandboxPolicy must be an object"))
            let sandboxType = wire.RustCsgJsonFindStr(sandboxPolicyJson, "type")
            if sandboxType == "dangerFullAccess":
                sandboxMode = "danger-full-access"
            elif sandboxType == "readOnly":
                sandboxMode = "read-only"
            elif sandboxType == "workspaceWrite":
                sandboxMode = "workspace-write"
                sandboxWritableRoots = rustCsgAppServerParseSandboxWritableRoots(sandboxPolicyJson)
            else:
                return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, wire.RustCsgCat("unsupported command/exec sandboxPolicy type: ", sandboxType)))

    var outputCap: int32 = 1048576
    if disableOutputCap:
        outputCap = -1
    elif outputBytesCapJson != "":
        if outputBytesCapJson != "null":
            outputCap = wire.RustCsgParseInt32(outputBytesCapJson)

    if rustCsgAppServerExecSessionIndexForConnection(processId, connectionId) >= 0:
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32600, wire.RustCsgCat("duplicate active command/exec process id: ", rustCsgAppServerCommandExecProcessRepr(processId))))

    var timeoutLimitMs: int32 = -1
    if !disableTimeout:
        if timeoutMsJson != "":
            if timeoutMsJson != "null":
                timeoutLimitMs = wire.RustCsgParseInt32(timeoutMsJson)

    if tty:
        var rows: int32 = 24
        var cols: int32 = 80
        if sizeJson != "":
            if sizeJson != "null":
                if sizeJson.len > 0 && sizeJson[0] == '{':
                    if wire.RustCsgContains(sizeJson, "\"rows\""):
                        rows = wire.RustCsgJsonFindInt32(sizeJson, "rows")
                    if wire.RustCsgContains(sizeJson, "\"cols\""):
                        cols = wire.RustCsgJsonFindInt32(sizeJson, "cols")
        if rows <= 0 || cols <= 0:
            return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32602, "command/exec size rows and cols must be greater than 0"))
        var ptyHandle: process.ProcessPtyHandle
        if sandboxMode == "danger-full-access":
            ptyHandle = process.ProcessSpawnPty(command, args, cwd, env, rows, cols)
        else:
            let profile = rustCsgAppServerBuildSeatbeltProfile(sandboxMode, cwd, sandboxWritableRoots)
            ptyHandle = process.ProcessSpawnSeatbeltPty(command, args, cwd, env, rows, cols, profile)
        if !ptyHandle.ok:
            if chengMutationPath != "":
                cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, false, ptyHandle.error)
            return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32603, wire.RustCsgCat("failed to spawn command: ", ptyHandle.error)))
        var ptySession: RustCsgAppServerExecRegistration
        ptySession.connectionId = connectionId
        ptySession.processId = processId
        ptySession.pid = ptyHandle.pid
        ptySession.stdinFd = ptyHandle.ptyFd
        ptySession.stdoutFd = ptyHandle.ptyFd
        ptySession.stderrFd = -1
        ptySession.isPty = true
        ptySession.ptyFd = ptyHandle.ptyFd
        ptySession.streamStdin = true
        ptySession.requestId = id
        ptySession.writerFd = fd
        ptySession.writerKind = writerKind
        ptySession.streamOutput = true
        ptySession.outputCap = outputCap
        ptySession.timeoutMs = timeoutLimitMs
        ptySession.mutationPath = chengMutationPath
        rustCsgAppServerRegisterExecSession(ptySession)
        return rustCsgAppServerPumpExecSessionsForConnection(connectionId)

    var handle: process.ProcessHandle
    if sandboxMode == "danger-full-access":
        handle = process.ProcessSpawnRaw(command, args, cwd, env)
    else:
        let profile = rustCsgAppServerBuildSeatbeltProfile(sandboxMode, cwd, sandboxWritableRoots)
        handle = process.ProcessSpawnSeatbeltRaw(command, args, cwd, env, profile)
    if !handle.ok:
        if chengMutationPath != "":
            cheng_write_gateway.ChengWriteGatewayRecordAfter("commandExec", chengMutationPath, false, handle.error)
        return rustCsgAppServerWriteJsonMessage(fd, writerKind, rustCsgAppServerError(id, -32603, wire.RustCsgCat("failed to spawn command: ", handle.error)))
    var sessionStdinFd = handle.stdinFd
    if !streamStdin:
        process.ProcessCloseFd(sessionStdinFd)
        sessionStdinFd = -1
    var session: RustCsgAppServerExecRegistration
    session.connectionId = connectionId
    session.processId = processId
    session.pid = handle.pid
    session.stdinFd = sessionStdinFd
    session.stdoutFd = handle.stdoutFd
    session.stderrFd = handle.stderrFd
    session.isPty = false
    session.ptyFd = -1
    session.streamStdin = streamStdin
    session.requestId = id
    session.writerFd = fd
    session.writerKind = writerKind
    session.streamOutput = streamStdoutStderr
    session.outputCap = outputCap
    session.timeoutMs = timeoutLimitMs
    session.mutationPath = chengMutationPath
    rustCsgAppServerRegisterExecSession(session)
    return rustCsgAppServerPumpExecSessionsForConnection(connectionId)

# ── search/files ────────────────────────────────────────────────────────

fn rustCsgAppServerAsciiLowerCode(ch: char): int32 =
    let code = int32(ch)
    if code >= int32('A') && code <= int32('Z'):
        return code + 32
    return code

fn rustCsgAppServerLineFindColumn(lineContent: str, pattern: str, caseSensitive: bool): int32 =
    if pattern.len > lineContent.len:
        return 0
    for i in 0..<(lineContent.len - pattern.len + 1):
        var matched: bool = true
        for j in 0..<pattern.len:
            if caseSensitive:
                if lineContent[i + j] != pattern[j]:
                    matched = false
                    break
            else:
                if rustCsgAppServerAsciiLowerCode(lineContent[i + j]) != rustCsgAppServerAsciiLowerCode(pattern[j]):
                    matched = false
                    break
        if matched:
            return i + 1
    return 0

fn rustCsgAppServerPathHasSuffix(path: str, suffix: str): bool =
    if suffix.len > path.len:
        return false
    let start = path.len - suffix.len
    for i in 0..<suffix.len:
        if path[start + i] != suffix[i]:
            return false
    return true

fn rustCsgAppServerPathAllowedByTypes(path: str, fileTypes: str[]): bool =
    if fileTypes.len == 0:
        return true
    for i in 0..<fileTypes.len:
        if fileTypes[i] != "":
            let suffix = wire.RustCsgCat(".", fileTypes[i])
            if rustCsgAppServerPathHasSuffix(path, suffix):
                return true
    return false

fn rustCsgAppServerSearchLineToJson(filePath: str, lineNumber: int32, lineContent: str, pattern: str, caseSensitive: bool): str =
    let column = rustCsgAppServerLineFindColumn(lineContent, pattern, caseSensitive)
    if column <= 0:
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("file", filePath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("line", lineNumber))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("column", column))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("lineText", lineContent))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgAppServerSearchResponse(id: int32, pattern: str, searchPath: str, fileTypes: str[], maxResults: int32, caseSensitive: bool, includeSearchedPath: bool): str =
    let paths = rustCsgAppServerWalkDirRec(searchPath)
    var matchesJson = "["
    var totalCount: int32
    for pathIndex in 0..<paths.len:
        let filePath = paths[pathIndex]
        if !rustCsgAppServerPathAllowedByTypes(filePath, fileTypes):
            continue
        let content = home.RustCsgReadFile(filePath)
        if content == "":
            continue
        var fileMatchCount: int32
        var lineStart: int32
        var lineNumber: int32 = 1
        var i: int32
        while i < content.len:
            if content[i] == '\n':
                var lineLen = i - lineStart
                if lineLen > 0 && content[i - 1] == '\r':
                    lineLen = lineLen - 1
                let line = strings.SliceBytes(content, lineStart, lineLen)
                let matchJson = rustCsgAppServerSearchLineToJson(filePath, lineNumber, line, pattern, caseSensitive)
                if matchJson != "" && fileMatchCount < maxResults:
                    fileMatchCount = fileMatchCount + 1
                    totalCount = totalCount + 1
                    if totalCount <= maxResults:
                        if totalCount > 1:
                            matchesJson = wire.RustCsgCat(matchesJson, ",")
                        matchesJson = wire.RustCsgCat(matchesJson, matchJson)
                lineStart = i + 1
                lineNumber = lineNumber + 1
            i = i + 1
        if lineStart < content.len:
            let line = strings.SliceBytes(content, lineStart, content.len - lineStart)
            let matchJson = rustCsgAppServerSearchLineToJson(filePath, lineNumber, line, pattern, caseSensitive)
            if matchJson != "" && fileMatchCount < maxResults:
                fileMatchCount = fileMatchCount + 1
                totalCount = totalCount + 1
                if totalCount <= maxResults:
                    if totalCount > 1:
                        matchesJson = wire.RustCsgCat(matchesJson, ",")
                    matchesJson = wire.RustCsgCat(matchesJson, matchJson)
    let truncated = totalCount > maxResults
    matchesJson = wire.RustCsgCat(matchesJson, "]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("matches", matchesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("totalCount", totalCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("truncated", truncated))
    if includeSearchedPath:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("searchedPath", searchPath))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerHandleSearchFiles(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pattern = wire.RustCsgJsonFindStr(paramsJson, "pattern")
    if pattern == "":
        return rustCsgAppServerError(id, -32602, "pattern must not be empty")
    let searchPath = wire.RustCsgJsonFindStr(paramsJson, "path")
    if searchPath == "":
        return rustCsgAppServerError(id, -32602, "path must not be empty")
    let fileTypesJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "fileTypes")
    var fileTypes: str[]
    if fileTypesJson != "":
        fileTypes = wire.RustCsgJsonStringArrayFromRaw(fileTypesJson)
    var maxResults: int32 = 50
    if wire.RustCsgContains(paramsJson, "\"maxResults\""):
        maxResults = wire.RustCsgJsonFindInt32(paramsJson, "maxResults")

    return rustCsgAppServerSearchResponse(id, pattern, searchPath, fileTypes, maxResults, true, false)

fn rustCsgAppServerHandleFileSearchQuery(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pattern = wire.RustCsgJsonFindStr(paramsJson, "pattern")
    if pattern == "":
        return rustCsgAppServerError(id, -32602, "pattern must not be empty")
    let searchPath = wire.RustCsgJsonFindStr(paramsJson, "path")
    if searchPath == "":
        return rustCsgAppServerError(id, -32602, "path must not be empty")
    let fileTypesJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "fileTypes")
    var fileTypes: str[]
    if fileTypesJson != "":
        fileTypes = wire.RustCsgJsonStringArrayFromRaw(fileTypesJson)
    var maxResults: int32 = 50
    if wire.RustCsgContains(paramsJson, "\"maxResults\""):
        maxResults = wire.RustCsgJsonFindInt32(paramsJson, "maxResults")
    var caseSensitive: bool = true
    if wire.RustCsgContains(paramsJson, "\"caseSensitive\":false"):
        caseSensitive = false

    return rustCsgAppServerSearchResponse(id, pattern, searchPath, fileTypes, maxResults, caseSensitive, true)

# ── git handlers ────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleGitDiffToRemote(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let cwd = wire.RustCsgJsonFindStr(paramsJson, "cwd")
    if cwd == "":
        return rustCsgAppServerError(id, -32602, "cwd must not be empty")
    let cmd = wire.RustCsgCat3("cd ", cwd, wire.RustCsgCat4(" && git diff @", "{", "u", "}"))
    let output = RustCsgExecCommand(cmd)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("diff", output))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

fn rustCsgAppServerHandleGitSha(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let cwd = wire.RustCsgJsonFindStr(paramsJson, "cwd")
    if cwd == "":
        return rustCsgAppServerError(id, -32602, "cwd must not be empty")
    let cmd = wire.RustCsgCat3("cd ", cwd, " && git rev-parse HEAD")
    let output = RustCsgExecCommand(cmd)
    if output == "":
        return rustCsgAppServerError(id, -32603, "failed to get git sha")
    var sha = output
    if sha[sha.len - 1] == '\n':
        sha = strings.SliceBytes(sha, 0, sha.len - 1)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("sha", sha))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

