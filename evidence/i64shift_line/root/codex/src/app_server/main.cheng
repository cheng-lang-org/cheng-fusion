# ── data/export helper: extract thread ids from JSON array ─────────────────

fn rustCsgAppServerExtractThreadIdsFromJsonArray(jsonArray: str): str[] =
    var result: str[]
    if jsonArray == "":
        return result
    var i: int32
    while i < jsonArray.len:
        if jsonArray[i] == '"' && i + 4 < jsonArray.len:
            if jsonArray[i + 1] == 'i' && jsonArray[i + 2] == 'd' && jsonArray[i + 3] == '"' && jsonArray[i + 4] == ':':
                i = i + 5
                while i < jsonArray.len && (jsonArray[i] == ' ' || jsonArray[i] == '\t'):
                    i = i + 1
                if i < jsonArray.len && jsonArray[i] == '"':
                    i = i + 1
                    let start = i
                    while i < jsonArray.len && jsonArray[i] != '"':
                        i = i + 1
                    if i > start:
                        add(result, strings.SliceBytes(jsonArray, start, i - start))
            i = i + 1
        else:
            i = i + 1
    return result

# ── data/export ─────────────────────────────────────────────────────────────

fn rustCsgAppServerHandleDataExport(id: int32, body: str): str =
    var pathError: str
    let dbPath = thread_handler.rustCsgAppServerStateDbPath(pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32603, pathError)
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let threadIdsJson = wire.RustCsgJsonFindOptionalArray(paramsJson, "threadIds")
    var threadIds: str[]
    if threadIdsJson != "":
        threadIds = wire.RustCsgJsonStringArrayFromRaw(threadIdsJson)
    else:
        threadIds = []
    if threadIds.len == 0:
        var listParams: types.RustCsgThreadListParams
        listParams.limitJson = "10"
        listParams.sortKey = "updated_at"
        listParams.sortDirection = "desc"
        let listResult = thread_list_sqlite.RustCsgThreadListFromSqlite(dbPath, listParams, "openai")
        if !listResult.ok:
            if listResult.blockedReason != "":
                return rustCsgAppServerError(id, -32602, listResult.blockedReason)
            return rustCsgAppServerError(id, -32603, listResult.error)
        let listResponse = listResult.response
        let dataJson = listResponse.dataJson
        threadIds = rustCsgAppServerExtractThreadIdsFromJsonArray(dataJson)
    var exportsJson = "["
    var exportCount: int32
    for i in 0..<threadIds.len:
        let threadId = threadIds[i]
        var readParams: types.RustCsgThreadReadParams
        readParams.threadId = threadId
        readParams.includeTurns = true
        let result = thread_read_sqlite.RustCsgThreadReadSqliteFromStateDb(dbPath, readParams, "openai")
        if !result.ok:
            continue
        if exportCount > 0:
            exportsJson = wire.RustCsgCat(exportsJson, ",")
        let nowMs = rustCsgGetCurrentTimeMs()
        let exportedAt = thread_list_sqlite.RustCsgMillisToRfc3339(nowMs)
        var exportEntry = "{"
        exportEntry = wire.RustCsgCat(exportEntry, wire.RustCsgJsonFieldStr("threadId", threadId))
        exportEntry = wire.RustCsgCat(exportEntry, ",")
        exportEntry = wire.RustCsgCat(exportEntry, wire.RustCsgJsonFieldStr("exportedAt", exportedAt))
        exportEntry = wire.RustCsgCat(exportEntry, ",\"version\":\"1.0\"")
        exportEntry = wire.RustCsgCat(exportEntry, ",")
        let readResponse = result.response
        exportEntry = wire.RustCsgCat(exportEntry, wire.RustCsgJsonFieldRaw("thread", wire.RustCsgAppThreadToJson(readResponse.thread)))
        exportEntry = wire.RustCsgCat(exportEntry, "}")
        exportsJson = wire.RustCsgCat(exportsJson, exportEntry)
        exportCount = exportCount + 1
    exportsJson = wire.RustCsgCat(exportsJson, "]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("exports", exportsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("totalCount", exportCount))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

