# ── rate_limit/dashboard ────────────────────────────────────────

fn rustCsgAppServerHandleRateLimitDashboard(id: int32): str =
    var dashboardJson: str
    var error: str
    if !rustCsgAppServerRateLimitDashboardSnapshotJson(dashboardJson, error):
        return rustCsgAppServerError(id, -32000, error)
    return rustCsgAppServerResponse(id, dashboardJson)

fn rustCsgAppServerRateLimitDashboardSnapshotJson(outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    let envPath = rustCsgAppServerStatusEnvPath()
    var envContent: str
    if !rustCsgAppServerReadStatusEnv(envPath, envContent, outError):
        return false
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        outError = homeError
        return false
    let cachePath = home.RustCsgPathJoinChild(codexHome, "rate_limit_dashboard_cache.json")
    let cacheContent = home.RustCsgReadFile(cachePath)
    if !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent,
                                                                              envPath,
                                                                              cacheContent,
                                                                              outJson,
                                                                              outError):
        return false
    return true

fn rustCsgAppServerRateLimitDashboardCachePath(outPath: var str, outError: var str): bool =
    outPath = ""
    outError = ""
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        outError = homeError
        return false
    outPath = home.RustCsgPathJoinChild(codexHome, "rate_limit_dashboard_cache.json")
    return true

fn rustCsgAppServerRateLimitDashboardHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    return -1

fn rustCsgAppServerRateLimitDashboardDecodePathSegment(segment: str): str =
    var out: str
    var i: int32
    let printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz"
    while i < segment.len:
        if segment[i] == '%' && i + 2 < segment.len:
            let hi = rustCsgAppServerRateLimitDashboardHexValue(segment[i + 1])
            let lo = rustCsgAppServerRateLimitDashboardHexValue(segment[i + 2])
            if hi >= 0 && lo >= 0:
                let code = (hi << 4) | lo
                if code >= 32 && code <= 122:
                    out = wire.RustCsgCat(out, strings.SliceBytes(printable, code - 32, 1))
                elif code == 123:
                    out = wire.RustCsgCat(out, "{")
                elif code == 124:
                    out = wire.RustCsgCat(out, "|")
                elif code == 125:
                    out = wire.RustCsgCat(out, "}")
                elif code == 126:
                    out = wire.RustCsgCat(out, "~")
                i = i + 3
                continue
        out = wire.RustCsgCat(out, strings.SliceBytes(segment, i, 1))
        i = i + 1
    return out

fn rustCsgAppServerRateLimitDashboardIssuer(): str =
    let overrideIssuer = RustCsgGetEnv("CODEX_RATE_LIMIT_DASHBOARD_ISSUER_OVERRIDE")
    if overrideIssuer != "":
        return overrideIssuer
    return "https://auth.openai.com"

fn rustCsgAppServerRateLimitDashboardAccountCheck(account: str, outError: var str): int32 =
    outError = ""
    let envPath = rustCsgAppServerStatusEnvPath()
    var envContent: str
    if !rustCsgAppServerReadStatusEnv(envPath, envContent, outError):
        return -1
    var found: bool
    if !rate_limit_dashboard.RustCsgRateLimitDashboardConfiguredAccountExists(envContent, envPath, account, found, outError):
        return -1
    if !found:
        return 0
    return 1

fn rustCsgAppServerRateLimitDashboardManualLoginHtml(account: str,
                                                     outHtml: var str,
                                                     outError: var str): bool =
    outHtml = ""
    outError = ""
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        outError = homeError
        return false
    let authRoot = home.RustCsgPathJoinChild(codexHome, "rate_limit_dashboard_auth")
    if !rustCsgAppServerEnsureDirectory(authRoot):
        outError = wire.RustCsgCat("failed to create rate limit dashboard auth root: ", authRoot)
        return false
    let authHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, account)
    if !rustCsgAppServerEnsureDirectory(authHome):
        outError = wire.RustCsgCat("failed to create rate limit dashboard auth home: ", authHome)
        return false
    var deviceAuthId: str
    var userCode: str
    var verificationUrl: str
    var interval: int32
    let existingIndex = rustCsgAppServerDashboardManualLoginSessionIndex(account)
    if existingIndex >= 0:
        rustCsgAppServerRemoveDashboardManualLoginSessionAt(existingIndex)
    if !auth_oauth.RequestDeviceCodeStartAtIssuer(rustCsgAppServerRateLimitDashboardIssuer(),
                                                  deviceAuthId,
                                                  userCode,
                                                  verificationUrl,
                                                  interval,
                                                  outError):
        return false
    if deviceAuthId == "":
        outError = "manual device-code response is missing device_auth_id"
        return false
    let nowMs = rustCsgGetCurrentTimeMs()
    rustCsgAppServerRememberDashboardManualLoginSession(account,
                                                        deviceAuthId,
                                                        userCode,
                                                        rustCsgAppServerRateLimitDashboardIssuer(),
                                                        interval,
                                                        nowMs)
    outHtml = rate_limit_dashboard.RustCsgRateLimitDashboardManualLoginHtml(account, verificationUrl, userCode)
    return true

fn rustCsgAppServerRateLimitDashboardCachedAuthAvailable(codexHome: str, account: str): bool =
    let authHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, account)
    let authDot = auth_login.LoadAuth(authHome)
    return auth_login.AuthAvailable(authDot)

fn rustCsgAppServerTryCompleteDashboardManualLoginSession(codexHome: str,
                                                          email: str,
                                                          nowSeconds: int64) =
    if rustCsgAppServerDashboardManualLoginSessionIndex(email) < 0:
        return
    var completeError: str
    rustCsgAppServerCompleteDashboardManualLoginSessions(codexHome, email, nowSeconds, completeError)

fn rustCsgAppServerRateLimitDashboardCloseOAuthServer(server: var dashboard_oauth_login.RustCsgDashboardOAuthServer) =
    if server.listenFd >= 0:
        tcp.RustCsgSocketClose(server.listenFd)
        server.listenFd = -1

fn rustCsgAppServerRateLimitDashboardFreshLoginConfigured(): bool =
    if RustCsgGetEnv(dashboard_webdriver_launcher.RustCsgWebDriverBrowserEnv) != "":
        return true
    if RustCsgGetEnv(dashboard_webdriver_launcher.RustCsgWebDriverBrowserOverrideEnv) != "":
        return true
    if RustCsgGetEnv(dashboard_webdriver_launcher.RustCsgWebDriverUrlEnv) != "":
        return true
    return false

fn rustCsgAppServerRateLimitDashboardWebDriverFreshLogin(account: str,
                                                         envContent: str,
                                                         codexHome: str,
                                                         nowSeconds: int64,
                                                         outError: var str): bool =
    outError = ""
    if rustCsgAppServerDashboardWebDriverUnavailableError != "":
        outError = rustCsgAppServerDashboardWebDriverUnavailableError
        return false
    var password: str
    if !rate_limit_dashboard.rustCsgRateLimitDashboardFindEnvValue(envContent, "PASSWORD", password):
        outError = "PASSWORD is missing from .env"
        return false
    var mailboxPassword: str
    if !rate_limit_dashboard.rustCsgRateLimitDashboardFindEnvValue(envContent, "MAILBOX_PASSWORD", mailboxPassword):
        mailboxPassword = password
    let authRoot = home.RustCsgPathJoinChild(codexHome, "rate_limit_dashboard_auth")
    if !rustCsgAppServerEnsureDirectory(authRoot):
        outError = wire.RustCsgCat("failed to create rate limit dashboard auth root: ", authRoot)
        return false
    let authHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, account)
    if !rustCsgAppServerEnsureDirectory(authHome):
        outError = wire.RustCsgCat("failed to create rate limit dashboard auth home: ", authHome)
        return false
    var baseUrl: str
    var isSafari: bool
    var chromeBinary: str
    if !dashboard_webdriver_launcher.RustCsgWebDriverLauncherEnsureDriverReady(baseUrl,
                                                                               isSafari,
                                                                               chromeBinary,
                                                                               outError):
        return false
    var attempt: int32 = 1
    while attempt <= 3:
        var oauthServer: dashboard_oauth_login.RustCsgDashboardOAuthServer
        if !dashboard_oauth_login.RustCsgDashboardOAuthStartServerHostPkce(rustCsgAppServerRateLimitDashboardIssuer(),
                                                                           0,
                                                                           "",
                                                                           rustCsgAppServerForcedChatGptWorkspaceId(codexHome),
                                                                           oauthServer,
                                                                           outError):
            return false
        let oauthIssuer = wire.RustCsgCat("", oauthServer.issuer)
        let oauthRedirectUri = wire.RustCsgCat("", oauthServer.redirectUri)
        let oauthAuthUrl = wire.RustCsgCat("", oauthServer.authUrl)
        let oauthState = wire.RustCsgCat("", oauthServer.state)
        let oauthCodeVerifier = wire.RustCsgCat("", oauthServer.codeVerifier)
        var sessionId: str
        var sessionError: str
        if !dashboard_webdriver.RustCsgWebDriverCreateSession(baseUrl,
                                                              chromeBinary,
                                                              isSafari,
                                                              sessionId,
                                                              sessionError):
            rustCsgAppServerRateLimitDashboardCloseOAuthServer(oauthServer)
            if !isSafari:
                if !dashboard_webdriver_launcher.RustCsgWebDriverLauncherUsesExternalWebDriver():
                    dashboard_webdriver_launcher.RustCsgWebDriverLauncherStopOwnedLocalDriver()
                outError = "Chrome WebDriver could not start Chrome. Click Login to complete manual device-code login, then click Refresh. Last ChromeDriver error: "
                outError = wire.RustCsgCat(outError, sessionError)
                rustCsgAppServerDashboardWebDriverUnavailableError = outError
            else:
                outError = sessionError
            return false
        var loginError: str
        if !dashboard_webdriver_mail163.RustCsgWebDriverCompleteOpenaiLoginWithMail163(baseUrl,
                                                                                       sessionId,
                                                                                       oauthAuthUrl,
                                                                                       account,
                                                                                       password,
                                                                                       mailboxPassword,
                                                                                       loginError):
            dashboard_webdriver.RustCsgWebDriverDeleteSession(baseUrl, sessionId)
            rustCsgAppServerRateLimitDashboardCloseOAuthServer(oauthServer)
            if wire.RustCsgContains(loginError, "OpenAI returned an auth error page before the"):
                var retryError = "OpenAI auth error page for "
                retryError = wire.RustCsgCat(retryError, account)
                retryError = wire.RustCsgCat(retryError, " on login attempt ")
                retryError = wire.RustCsgCat(retryError, strings.IntToStr(attempt))
                retryError = wire.RustCsgCat(retryError, "/3: ")
                retryError = wire.RustCsgCat(retryError, loginError)
                if attempt < 3:
                    attempt = attempt + 1
                    continue
                outError = retryError
                return false
            outError = loginError
            return false
        oauthServer.issuer = oauthIssuer
        oauthServer.redirectUri = oauthRedirectUri
        oauthServer.authUrl = oauthAuthUrl
        oauthServer.state = oauthState
        oauthServer.codeVerifier = oauthCodeVerifier
        var callbackError: str
        let callbackOk = dashboard_oauth_login.RustCsgDashboardOAuthRunUntilDone(authHome,
                                                                                 account,
                                                                                 rustCsgAppServerForcedChatGptWorkspaceId(codexHome),
                                                                                 nowSeconds,
                                                                                 oauthServer,
                                                                                 callbackError)
        dashboard_webdriver.RustCsgWebDriverDeleteSession(baseUrl, sessionId)
        if !callbackOk:
            outError = callbackError
            return false
        return true
    outError = wire.RustCsgCat("failed to log in ", wire.RustCsgCat(account, ": OpenAI auth error retries were exhausted"))
    return false

fn rustCsgAppServerRateLimitDashboardLoadingJson(targetEmail: str, outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    let envPath = rustCsgAppServerStatusEnvPath()
    var envContent: str
    if !rustCsgAppServerReadStatusEnv(envPath, envContent, outError):
        return false
    var cachePath: str
    if !rustCsgAppServerRateLimitDashboardCachePath(cachePath, outError):
        return false
    let cacheContent = home.RustCsgReadFile(cachePath)
    return rate_limit_dashboard.RustCsgRateLimitDashboardLoadingSnapshotFromEnvAndCache(envContent,
                                                                                        envPath,
                                                                                        cacheContent,
                                                                                        targetEmail,
                                                                                        outJson,
                                                                                        outError)

fn rustCsgAppServerDashboardProgressAccountsFromRemaining(accountsJson: str,
                                                          remainingPos: int32,
                                                          refreshedPrefix: str,
                                                          targetEmail: str,
                                                          outAccounts: var str,
                                                          outError: var str): bool =
    outAccounts = ""
    outError = ""
    var accounts = refreshedPrefix
    var needsComma = accounts != "["
    var pos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, remainingPos)
    while pos < accountsJson.len && rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "]":
        if rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            outError = "dashboard account entry must be a JSON object"
            return false
        let recordJson = rate_limit_dashboard.rustCsgRateLimitDashboardRawJsonValueAt(accountsJson, pos)
        if recordJson == "":
            outError = "unterminated dashboard account JSON object"
            return false
        let recordEnd = rate_limit_dashboard.rustCsgRateLimitDashboardJsonValueEndAt(accountsJson, pos)
        if recordEnd < 0:
            outError = "unterminated dashboard account JSON object"
            return false
        var nextRecord = recordJson
        if targetEmail == "":
            nextRecord = rate_limit_dashboard.rustCsgRateLimitDashboardRecordWithStatus(recordJson, "loading", "null")
        if needsComma:
            accounts = wire.RustCsgCat(accounts, ",")
        accounts = wire.RustCsgCat(accounts, nextRecord)
        needsComma = true
        pos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, recordEnd)
        if rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) == ",":
            pos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    outAccounts = wire.RustCsgCat(accounts, "]")
    return true

fn rustCsgAppServerBroadcastDashboardProgressSnapshot(accountsJson: str,
                                                       remainingPos: int32,
                                                       refreshedPrefix: str,
                                                       targetEmail: str,
                                                       lastUpdatedAtJson: str,
                                                       source: str,
                                                       clientFds: int32[],
                                                       clientModes: int32[],
                                                       outError: var str): bool =
    if clientFds.len == 0:
        return true
    var progressAccounts: str
    if !rustCsgAppServerDashboardProgressAccountsFromRemaining(accountsJson,
                                                               remainingPos,
                                                               refreshedPrefix,
                                                               targetEmail,
                                                               progressAccounts,
                                                               outError):
        return false
    let progressJson = rate_limit_dashboard.rustCsgRateLimitDashboardBuildResponse(progressAccounts, lastUpdatedAtJson, source)
    let progressMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", progressJson), "}")
    rustCsgAppServerBroadcastDashboardSnapshot(progressMessage, -1, clientFds, clientModes)
    return true

fn rustCsgAppServerRateLimitDashboardRefreshJsonWithFreshLogin(envContent: str,
                                                               envPath: str,
                                                               cacheContent: str,
                                                               codexHome: str,
                                                               chatgptBaseUrl: str,
                                                               refreshTokenUrl: str,
                                                               nowSeconds: int64,
                                                               targetEmail: str,
                                                               clientFds: int32[],
                                                               clientModes: int32[],
                                                               outJson: var str,
                                                               outCacheJson: var str,
                                                               outError: var str): bool =
    outJson = ""
    outCacheJson = ""
    outError = ""
    if targetEmail != "":
        var found: bool
        if !rate_limit_dashboard.RustCsgRateLimitDashboardConfiguredAccountExists(envContent, envPath, targetEmail, found, outError):
            return false
        if !found:
            return false
    var snapshotJson: str
    if !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent, envPath, cacheContent, snapshotJson, outError):
        return false
    let accountsJson = wire.RustCsgJsonFindArray(snapshotJson, "accounts")
    var progressLastUpdatedAtJson = wire.RustCsgJsonFindOptionalValueRaw(snapshotJson, "lastUpdatedAt")
    if progressLastUpdatedAtJson == "":
        progressLastUpdatedAtJson = "null"
    var progressSource = wire.RustCsgJsonFindOptionalStr(snapshotJson, "source")
    if progressSource == "":
        progressSource = "cache"
    var refreshedAccounts = "["
    var count: int32
    var pos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, 0)
    if rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "[":
        outError = "rate limit dashboard accounts must be an array"
        return false
    pos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    while pos < accountsJson.len && rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "]":
        if rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            outError = "dashboard account entry must be a JSON object"
            return false
        let recordJson = rate_limit_dashboard.rustCsgRateLimitDashboardRawJsonValueAt(accountsJson, pos)
        if recordJson == "":
            outError = "unterminated dashboard account JSON object"
            return false
        let recordEnd = rate_limit_dashboard.rustCsgRateLimitDashboardJsonValueEndAt(accountsJson, pos)
        if recordEnd < 0:
            outError = "unterminated dashboard account JSON object"
            return false
        let email = wire.RustCsgJsonFindOptionalStr(recordJson, "email")
        var nextRecord = recordJson
        if targetEmail == "" || email == targetEmail:
            rustCsgAppServerTryCompleteDashboardManualLoginSession(codexHome, email, nowSeconds)
            var rateLimitsJson: str
            var fetchError: str
            let fetchedAtJson = strings.Int64ToStr(nowSeconds)
            if rate_limit_dashboard.rustCsgRateLimitDashboardFetchAccountRateLimits(codexHome,
                                                                                    chatgptBaseUrl,
                                                                                    refreshTokenUrl,
                                                                                    nowSeconds,
                                                                                    email,
                                                                                    rateLimitsJson,
                                                                                    fetchError):
                nextRecord = rate_limit_dashboard.rustCsgRateLimitDashboardRecordWithSuccess(recordJson,
                                                                                             rateLimitsJson,
                                                                                             fetchedAtJson)
            else:
                var shownError = fetchError
                if rate_limit_dashboard.rustCsgRateLimitDashboardStartsWith(fetchError, "BackendGetRateLimits status 401") ||
                   wire.RustCsgContains(fetchError, "cached auth"):
                    shownError = wire.RustCsgCat(fetchError, ". Click Login to complete manual device-code login, then click Refresh.")
                nextRecord = rate_limit_dashboard.rustCsgRateLimitDashboardRecordWithStatus(recordJson,
                                                                                            "failed",
                                                                                            wire.RustCsgJsonQuote(shownError))
        if count > 0:
            refreshedAccounts = wire.RustCsgCat(refreshedAccounts, ",")
        refreshedAccounts = wire.RustCsgCat(refreshedAccounts, nextRecord)
        var nextPos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, recordEnd)
        if rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson, nextPos) == ",":
            nextPos = rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, nextPos + 1)
        let nextToken = rate_limit_dashboard.rustCsgRateLimitDashboardByteAt(accountsJson,
                                                                             rate_limit_dashboard.rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, nextPos))
        if targetEmail == "" && nextToken == "{":
            if !rustCsgAppServerBroadcastDashboardProgressSnapshot(accountsJson,
                                                                   nextPos,
                                                                   refreshedAccounts,
                                                                   targetEmail,
                                                                   progressLastUpdatedAtJson,
                                                                   progressSource,
                                                                   clientFds,
                                                                   clientModes,
                                                                   outError):
                return false
        count = count + 1
        pos = nextPos
    refreshedAccounts = wire.RustCsgCat(refreshedAccounts, "]")
    let nowJson = strings.Int64ToStr(nowSeconds)
    outJson = rate_limit_dashboard.rustCsgRateLimitDashboardBuildResponse(refreshedAccounts, nowJson, "fresh")
    outCacheJson = rate_limit_dashboard.rustCsgRateLimitDashboardBuildCache(refreshedAccounts, nowJson)
    return true

fn rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast(targetEmail: str,
                                                              clientFds: int32[],
                                                              clientModes: int32[],
                                                              outJson: var str,
                                                              outError: var str): bool =
    outJson = ""
    outError = ""
    let envPath = rustCsgAppServerStatusEnvPath()
    var envContent: str
    if !rustCsgAppServerReadStatusEnv(envPath, envContent, outError):
        return false
    var cachePath: str
    if !rustCsgAppServerRateLimitDashboardCachePath(cachePath, outError):
        return false
    let cacheContent = home.RustCsgReadFile(cachePath)
    var cacheJson: str
    let nowSeconds = rustCsgGetCurrentTimeMs() / int64(1000)
    var codexHome: str
    var homeError: str
    home.RustCsgFindCodexHomeInto(codexHome, homeError)
    if homeError != "":
        outError = homeError
        return false
    let chatgptBaseUrl = rustCsgAppServerChatGptBaseUrl(codexHome)
    let refreshTokenUrl = RustCsgGetEnv("CODEX_REFRESH_TOKEN_URL_OVERRIDE")
    if !rustCsgAppServerRateLimitDashboardRefreshJsonWithFreshLogin(envContent,
                                                                    envPath,
                                                                    cacheContent,
                                                                    codexHome,
                                                                    chatgptBaseUrl,
                                                                    refreshTokenUrl,
                                                                    nowSeconds,
                                                                    targetEmail,
                                                                    clientFds,
                                                                    clientModes,
                                                                    outJson,
                                                                    cacheJson,
                                                                    outError):
        var failureJson: str
        var failureCacheJson: str
        var failureError: str
        if !rate_limit_dashboard.RustCsgRateLimitDashboardRefreshFailureFromEnvAndCache(envContent,
                                                                                        envPath,
                                                                                        cacheContent,
                                                                                        nowSeconds,
                                                                                        targetEmail,
                                                                                        outError,
                                                                                        failureJson,
                                                                                        failureCacheJson,
                                                                                        failureError):
            outError = failureError
            return false
        outJson = failureJson
        cacheJson = failureCacheJson
    if rustCsgAppServerWriteFile(cachePath, cacheJson) == 0:
        outError = wire.RustCsgCat("failed to write rate limit dashboard cache: ", cachePath)
        return false
    return true

fn rustCsgAppServerRateLimitDashboardRefreshJson(targetEmail: str,
                                                 outJson: var str,
                                                 outError: var str): bool =
    var emptyFds: int32[]
    var emptyModes: int32[]
    return rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast(targetEmail,
                                                                      emptyFds,
                                                                      emptyModes,
                                                                      outJson,
                                                                      outError)

fn rustCsgAppServerDashboardSnapshotServerMessage(outMessage: var str, outError: var str): bool =
    var dashboardJson: str
    if !rustCsgAppServerRateLimitDashboardSnapshotJson(dashboardJson, outError):
        outMessage = wire.RustCsgCat("{\"type\":\"error\",\"message\":", wire.RustCsgJsonQuote(outError))
        outMessage = wire.RustCsgCat(outMessage, "}")
        return false
    outMessage = wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", dashboardJson)
    outMessage = wire.RustCsgCat(outMessage, "}")
    return true

fn rustCsgAppServerDashboardErrorServerMessage(message: str): str =
    return wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"error\",\"message\":", wire.RustCsgJsonQuote(message)), "}")

fn rustCsgAppServerDashboardFrameLooksLikeJsonObject(data: str): bool =
    var i: int32
    while i < data.len:
        let ch = data[i]
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            i = i + 1
            continue
        return ch == '{'
    return false

fn rustCsgAppServerDashboardFirstObjectKeyMalformed(data: str): bool =
    var i: int32
    while i < data.len:
        let ch = data[i]
        if ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t':
            i = i + 1
            continue
        if ch != '{':
            return false
        i = i + 1
        while i < data.len:
            let next = data[i]
            if next == ' ' || next == '\n' || next == '\r' || next == '\t':
                i = i + 1
                continue
            if next == '}':
                return false
            return next != '"'
        return false
    return false

fn rustCsgAppServerDashboardRawIsJsonString(raw: str): bool =
    return raw.len >= 2 && raw[0] == '"' && raw[raw.len - 1] == '"'

fn rustCsgAppServerDashboardSerdeTypeName(raw: str): str =
    if raw == "null":
        return "null"
    if raw == "true" || raw == "false":
        return wire.RustCsgCat("boolean `", wire.RustCsgCat(raw, "`"))
    if raw.len > 0 && raw[0] == '{':
        return "map"
    if raw.len > 0 && raw[0] == '[':
        return "sequence"
    if raw.len > 0 && (raw[0] == '-' || (raw[0] >= '0' && raw[0] <= '9')):
        return wire.RustCsgCat("integer `", wire.RustCsgCat(raw, "`"))
    return "value"

fn rustCsgAppServerDashboardInvalidClientMessage(data: str): str =
    if !rustCsgAppServerDashboardFrameLooksLikeJsonObject(data):
        return "invalid dashboard websocket message: expected value at line 1 column 1"
    if rustCsgAppServerDashboardFirstObjectKeyMalformed(data):
        return "invalid dashboard websocket message: key must be a string at line 1 column 2"
    if !wire.RustCsgContains(data, "\"type\""):
        return "invalid dashboard websocket message: missing field `type`"
    let typeRaw = wire.RustCsgJsonFindOptionalValueRaw(data, "type")
    if !rustCsgAppServerDashboardRawIsJsonString(typeRaw):
        var typeMessage = "invalid dashboard websocket message: invalid type: "
        typeMessage = wire.RustCsgCat(typeMessage, rustCsgAppServerDashboardSerdeTypeName(typeRaw))
        typeMessage = wire.RustCsgCat(typeMessage, ", expected variant identifier")
        return typeMessage
    let commandType = wire.RustCsgJsonFindOptionalStr(data, "type")
    if commandType == "refreshAccount" && !wire.RustCsgContains(data, "\"email\""):
        return "invalid dashboard websocket message: missing field `email`"
    if commandType == "refreshAccount":
        let emailRaw = wire.RustCsgJsonFindOptionalValueRaw(data, "email")
        if !rustCsgAppServerDashboardRawIsJsonString(emailRaw):
            var emailMessage = "invalid dashboard websocket message: invalid type: "
            emailMessage = wire.RustCsgCat(emailMessage, rustCsgAppServerDashboardSerdeTypeName(emailRaw))
            emailMessage = wire.RustCsgCat(emailMessage, ", expected a string")
            return emailMessage
    if commandType != "":
        var message = "invalid dashboard websocket message: unknown variant `"
        message = wire.RustCsgCat(message, commandType)
        message = wire.RustCsgCat(message, "`, expected one of `snapshot`, `refreshAll`, `refreshAccount`")
        return message
    return "invalid dashboard websocket message"

fn rustCsgAppServerBroadcastDashboardLoadingSnapshot(targetEmail: str,
                                                     clientFds: int32[],
                                                     clientModes: int32[],
                                                     outError: var str): bool =
    var loadingJson: str
    if !rustCsgAppServerRateLimitDashboardLoadingJson(targetEmail, loadingJson, outError):
        return false
    let loadingMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", loadingJson), "}")
    rustCsgAppServerBroadcastDashboardSnapshot(loadingMessage, -1, clientFds, clientModes)
    return true

# ── completion/stream ────────────────────────────────────────────

fn rustCsgAppServerHandle(body: str): str =
    if !wire.RustCsgContains(body, "\"method\""):
        return rustCsgAppServerError(rustCsgAppServerRequestId(body), -32600, "Invalid request: missing method")
    let method = wire.RustCsgJsonFindStr(body, "method")
    if method == "initialized" || method == "notifications/initialized":
        return ""
    let id = rustCsgAppServerRequestId(body)
    if method == "initialize":
        var codexHome: str
        var homeError: str
        home.RustCsgFindCodexHomeInto(codexHome, homeError)
        if homeError != "":
            return rustCsgAppServerError(id, -32000, homeError)
        return rustCsgAppServerResponse(id, rustCsgAppServerInitializeResult(codexHome))
    if method == "thread/read":
        return thread_handler.rustCsgAppServerHandleThreadRead(id, body)
    if method == "thread/list":
        return thread_handler.rustCsgAppServerHandleThreadList(id, body)
    if method == "thread/loaded/list":
        return thread_handler.rustCsgAppServerHandleThreadLoadedList(id)
    if method == "thread/turns/list":
        return thread_handler.rustCsgAppServerHandleThreadTurnsList(id, body)
    if method == "thread/turns/items/list":
        return rustCsgAppServerError(id, -32601, "thread/turns/items/list is not supported yet")
    if method == "thread/delete":
        return thread_handler.rustCsgAppServerHandleThreadDelete(id, body)
    if method == "thread/summary":
        return thread_handler.rustCsgAppServerHandleThreadSummary(id, body)
    if method == "thread/status":
        return thread_handler.rustCsgAppServerHandleThreadStatus(id, body)
    if method == "thread/start":
        let response = thread_handler.RustCsgAppServerHandleThreadStart(id, body)
        if wire.RustCsgContains(response, "\"result\""):
            let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
            rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, rustCsgAppServerDynamicToolsFromRequest(body), rustCsgAppServerEffectiveBaseInstructionsFromStartRequest(body), rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
            rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
        return response
    if method == "thread/fork":
        let response = thread_handler.RustCsgAppServerHandleThreadFork(id, body)
        if wire.RustCsgContains(response, "\"result\""):
            let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
            rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", rustCsgAppServerEffectiveBaseInstructionsFromForkRequest(body), rustCsgAppServerDeveloperInstructionsFromRequest(body), "")
            rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
        return response
    if method == "thread/resume":
        let response = thread_handler.RustCsgAppServerHandleThreadResume(id, body)
        if wire.RustCsgContains(response, "\"result\""):
            let threadId = thread_handler.RustCsgAppServerThreadIdFromLifecycleResponse(response)
            rustCsgAppServerMarkThreadLoadedWithFullSession(threadId, "", rustCsgAppServerEffectiveBaseInstructionsFromResumeRequest(body, response), rustCsgAppServerDeveloperInstructionsFromRequest(body), rustCsgAppServerHistoryJsonFromRequest(body))
            rustCsgAppServerRememberThreadSource(threadId, rustCsgAppServerThreadSourceFromRequest(body))
        return response
    if method == "turn/start":
        return rustCsgAppServerHandleTurnStartScoped(id, body)
    if method == "turn/steer":
        return rustCsgAppServerHandleTurnSteerScoped(id, body)
    if method == "thread/unsubscribe":
        return rustCsgAppServerError(id, -32601, "thread/unsubscribe requires connection-scoped writer transport")
    if method == "thread/export":
        return thread_handler.rustCsgAppServerHandleThreadExport(id, body)
    if method == "thread/name/set":
        return thread_handler.RustCsgAppServerHandleThreadNameSet(id, body)
    if method == "thread/archive":
        let response = thread_handler.RustCsgAppServerHandleThreadArchive(id, body)
        if wire.RustCsgContains(response, "\"result\""):
            let paramsJson = wire.RustCsgJsonFindObject(body, "params")
            rustCsgAppServerRemoveLoadedThread(wire.RustCsgJsonFindStr(paramsJson, "threadId"))
        return response
    if method == "thread/import":
        return thread_handler.rustCsgAppServerHandleThreadImport(id, body)
    if method == "thread/rename":
        return thread_handler.rustCsgAppServerHandleThreadRename(id, body)
    if method == "config/reset":
        return config_handler.rustCsgAppServerHandleConfigReset(id, body)
    if method == "metrics/status":
        return rustCsgAppServerHandleMetricsStatus(id)
    if method == "config/read":
        return config_handler.rustCsgAppServerHandleConfigRead(id, body)
    if method == "config/value/write":
        return config_handler.rustCsgAppServerHandleConfigValueWrite(id, body)
    if method == "config/batchWrite":
        return config_handler.rustCsgAppServerHandleConfigBatchWrite(id, body)
    if method == "config/write":
        return config_handler.rustCsgAppServerHandleConfigWrite(id, body)
    if method == "configRequirements/read":
        return config_handler.rustCsgAppServerHandleConfigRequirements(id)
    if method == "config/requirements":
        return config_handler.rustCsgAppServerHandleConfigRequirements(id)
    if method == "status":
        return rustCsgAppServerHandleStatus(id)
    if method == "codex/status":
        return rustCsgAppServerHandleStatus(id)
    if method == "account/get":
        return rustCsgAppServerHandleAccountGet(id, body)
    if method == "account/rateLimits/read":
        return rustCsgAppServerHandleAccountRateLimitsRead(id)
    if method == "account/subscriptionQuota/read":
        return rustCsgAppServerHandleAccountSubscriptionQuotaRead(id)
    if method == "fs/readFile":
        return fs_handler.rustCsgAppServerHandleFsReadFile(id, body)
    if method == "fs/getMetadata":
        return fs_handler.rustCsgAppServerHandleFsGetMetadata(id, body)
    if method == "fs/readDirectory":
        return fs_handler.rustCsgAppServerHandleFsReadDirectory(id, body)
    if method == "fs/writeFile":
        return fs_handler.rustCsgAppServerHandleFsWriteFile(id, body)
    if method == "fs/createDirectory":
        return fs_handler.rustCsgAppServerHandleFsCreateDirectory(id, body)
    if method == "fs/remove":
        return fs_handler.rustCsgAppServerHandleFsRemove(id, body)
    if method == "fs/copy":
        return fs_handler.rustCsgAppServerHandleFsCopy(id, body)
    if method == "fs/watch":
        return fs_handler.rustCsgAppServerHandleFsWatch(id, body)
    if method == "fs/unwatch":
        return fs_handler.rustCsgAppServerHandleFsUnwatch(id, body)
    if method == "command/exec":
        return rustCsgAppServerHandleCommandExec(id, body)
    if method == "command/exec/write":
        return rustCsgAppServerHandleCommandExecWrite(id, body)
    if method == "command/exec/terminate":
        return rustCsgAppServerHandleCommandExecTerminate(id, body)
    if method == "command/exec/resize":
        return rustCsgAppServerHandleCommandExecResize(id, body)
    if method == "search/files":
        return rustCsgAppServerHandleSearchFiles(id, body)
    if method == "file_search/query":
        return rustCsgAppServerHandleFileSearchQuery(id, body)
    if method == "git/diffToRemote":
        return rustCsgAppServerHandleGitDiffToRemote(id, body)
    if method == "git/sha":
        return rustCsgAppServerHandleGitSha(id, body)
    if method == "plugin/list":
        return rustCsgAppServerHandlePluginList(id)
    if method == "plugin/install":
        return rustCsgAppServerHandlePluginInstall(id, body)
    if method == "environment/get":
        return rustCsgAppServerHandleEnvironmentGet(id)
    if method == "environment/listVariables":
        return rustCsgAppServerHandleEnvironmentListVariables(id)
    if method == "feedback/send":
        return rustCsgAppServerHandleFeedbackSend(id, body)
    if method == "external_agent/status":
        return rustCsgAppServerHandleExternalAgentStatus(id)
    if method == "hooks/list":
        return rustCsgAppServerHandleHooksList(id)
    if method == "models/list":
        return model_handler.rustCsgAppServerHandleModelsList(id)
    if method == "models/providers":
        return model_handler.rustCsgAppServerHandleModelsProviders(id)
    if method == "attestation/challenge":
        return rustCsgAppServerHandleAttestationChallenge(id)
    if method == "remote_control/status":
        return rustCsgAppServerHandleRemoteControlStatus(id)
    if method == "experimental/features":
        return rustCsgAppServerHandleExperimentalFeatures(id)
    if method == "codex/version":
        return rustCsgAppServerHandleCodexVersion(id)
    if method == "sandbox/modes":
        return rustCsgAppServerHandleSandboxModes(id)
    if method == "approval/policies":
        return rustCsgAppServerHandleApprovalPolicies(id)
    if method == "serverRequest/resolve":
        return rustCsgAppServerHandleServerRequestResolve(id, body)
    if method == "data/export":
        return rustCsgAppServerHandleDataExport(id, body)
    if method == "thread/history":
        return thread_handler.rustCsgAppServerHandleThreadHistory(id, body)
    if method == "config/reload":
        return config_handler.rustCsgAppServerHandleConfigReload(id)
    if method == "plugin/uninstall":
        return rustCsgAppServerHandlePluginUninstall(id, body)
    if method == "plugin/update":
        return rustCsgAppServerHandlePluginUpdate(id, body)
    if method == "sandbox/status":
        return rustCsgAppServerHandleSandboxStatus(id)
    if method == "update/check":
        return rustCsgAppServerHandleUpdateCheck(id)
    if method == "rate_limit/status":
        return rustCsgAppServerHandleRateLimitStatus(id)
    if method == "rate_limit/dashboard":
        return rustCsgAppServerHandleRateLimitDashboard(id)
    if method == "model_provider/capabilities":
        return model_handler.rustCsgAppServerHandleModelProviderCapabilities(id, body)
    if method == "model_provider/models":
        return model_handler.rustCsgAppServerHandleModelProviderModels(id, body)
    if method == "completion/stream":
        return model_handler.rustCsgAppServerHandleCompletionStream(id, body)
    if method == "completion/chat":
        return model_handler.rustCsgAppServerHandleCompletionChat(id, body)
    if method == "completion/anthropic_messages":
        return model_handler.rustCsgAppServerHandleCompletionAnthropicMessages(id, body)
    if method == "embedding/create":
        return model_handler.rustCsgAppServerHandleEmbeddingCreate(id, body)
    if method == "image/generate":
        return model_handler.rustCsgAppServerHandleImageGenerate(id, body)
    return rustCsgAppServerError(id, -32601, wire.RustCsgCat("Method not found: ", method))

fn RustCsgAppServerHandleForTuiBootstrap(body: str): str =
    return rustCsgAppServerHandle(body)

fn rustCsgAppServerServeRequestWithWriterKind(fd: int32, writerKind: int32, connectionId: int32, body: str): bool =
    if wire.RustCsgContains(body, "\"method\""):
        let method = wire.RustCsgJsonFindStr(body, "method")
        if method == "command/exec":
            return rustCsgAppServerHandleCommandExecWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "command/exec/write":
            return rustCsgAppServerHandleCommandExecWriteWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "command/exec/terminate":
            return rustCsgAppServerHandleCommandExecTerminateWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "command/exec/resize":
            return rustCsgAppServerHandleCommandExecResizeWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "fs/watch":
            return rustCsgAppServerHandleFsWatchWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "fs/unwatch":
            return rustCsgAppServerHandleFsUnwatchWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "thread/start":
            return rustCsgAppServerHandleThreadStartWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "thread/fork":
            return rustCsgAppServerHandleThreadForkWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "thread/resume":
            return rustCsgAppServerHandleThreadResumeWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "turn/start":
            return rustCsgAppServerHandleTurnStartWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "turn/steer":
            return rustCsgAppServerHandleTurnSteerWriter(rustCsgAppServerRequestId(body), body, fd, writerKind)
        if method == "thread/unsubscribe":
            return rustCsgAppServerHandleThreadUnsubscribeWriter(rustCsgAppServerRequestId(body), body, fd, writerKind, connectionId)
        if method == "thread/name/set":
            return rustCsgAppServerHandleThreadNameSetWriter(rustCsgAppServerRequestId(body), body, fd, writerKind)
        if method == "thread/archive":
            return rustCsgAppServerHandleThreadArchiveWriter(rustCsgAppServerRequestId(body), body, fd, writerKind)
        if rustCsgAppServerMethodMutatesFs(method):
            let changedPath = rustCsgAppServerChangedPathForFsMutation(method, body)
            let response = rustCsgAppServerHandle(body)
            if !rustCsgAppServerWriteJsonMessage(fd, writerKind, response):
                return false
            if wire.RustCsgContains(response, "\"result\""):
                return rustCsgAppServerEmitFsChangedForPath(fd, writerKind, connectionId, changedPath)
            return true
    let response = rustCsgAppServerHandle(body)
    return rustCsgAppServerWriteJsonMessage(fd, writerKind, response)

fn rustCsgAppServerServeJsonLineRequest(fd: int32, connectionId: int32, body: str, stdioBuffer: var str): bool =
    if wire.RustCsgContains(body, "\"method\""):
        let method = wire.RustCsgJsonFindStr(body, "method")
        if method == "turn/start":
            return rustCsgAppServerHandleTurnStartStdioWriter(rustCsgAppServerRequestId(body), body, fd, connectionId, stdioBuffer)
    return rustCsgAppServerServeRequestWithWriterKind(fd, 2, connectionId, body)

fn rustCsgAppServerServeWebSocketJsonRequest(fd: int32, connectionId: int32, body: str): bool =
    return rustCsgAppServerServeRequestWithWriterKind(fd, 3, connectionId, body)

fn rustCsgAppServerHttpRequestMethod(request: str): str =
    var endPos: int32
    while endPos < request.len && request[endPos] != ' ' && request[endPos] != '\r' && request[endPos] != '\n':
        endPos = endPos + 1
    if endPos <= 0:
        return ""
    return strings.SliceBytes(request, 0, endPos)

fn rustCsgAppServerHttpRequestPath(request: str): str =
    var pos: int32
    while pos < request.len && request[pos] != ' ':
        pos = pos + 1
    while pos < request.len && request[pos] == ' ':
        pos = pos + 1
    let start = pos
    while pos < request.len && request[pos] != ' ' && request[pos] != '\r' && request[pos] != '\n':
        pos = pos + 1
    if pos <= start:
        return ""
    return strings.SliceBytes(request, start, pos - start)

fn rustCsgAppServerHttpRequestIsWebSocketUpgrade(request: str): bool =
    return wire.RustCsgContains(request, "Upgrade: websocket") || wire.RustCsgContains(request, "Upgrade: WebSocket") || wire.RustCsgContains(request, "upgrade: websocket")

fn rustCsgAppServerHttpRequestHasOriginHeader(request: str): bool =
    return wire.RustCsgContains(request, "\r\nOrigin:") || wire.RustCsgContains(request, "\r\norigin:")

fn rustCsgAppServerIsBrowserSafeHttpPath(path: str): bool =
    if path == "/readyz" || path == "/healthz":
        return true
    if path == "/rate-limit-dashboard" || path == "/rate-limit-dashboard/ws":
        return true
    return rustCsgAppServerStartsWith(path, "/api/rate-limits")

fn rustCsgAppServerHttpStatusText(status: int32): str =
    if status == 200:
        return "OK"
    if status == 400:
        return "Bad Request"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 500:
        return "Internal Server Error"
    return "Error"

fn rustCsgAppServerSocketWriteAll(fd: int32, data: str): bool =
    var offset: int32
    while offset < data.len:
        let chunk = strings.SliceBytes(data, offset, data.len - offset)
        let wrote = tcp.RustCsgSocketWrite(fd, chunk)
        if wrote <= 0:
            return false
        offset = offset + wrote
    return true

fn rustCsgAppServerWriteHttpResponse(fd: int32, status: int32, contentType: str, body: str): bool =
    var response = "HTTP/1.1 "
    response = wire.RustCsgCat(response, strings.IntToStr(status))
    response = wire.RustCsgCat(response, " ")
    response = wire.RustCsgCat(response, rustCsgAppServerHttpStatusText(status))
    response = wire.RustCsgCat(response, "\r\nContent-Type: ")
    response = wire.RustCsgCat(response, contentType)
    response = wire.RustCsgCat(response, "\r\nContent-Length: ")
    response = wire.RustCsgCat(response, strings.IntToStr(body.len))
    response = wire.RustCsgCat(response, "\r\nConnection: close\r\n\r\n")
    response = wire.RustCsgCat(response, body)
    return rustCsgAppServerSocketWriteAll(fd, response)

fn rustCsgAppServerDashboardHttpErrorBody(message: str): str =
    return wire.RustCsgCat(wire.RustCsgCat("{\"error\":", wire.RustCsgJsonQuote(message)), "}")

fn rustCsgAppServerServeRateLimitDashboardHttp(fd: int32, request: str, clientFds: int32[], clientModes: int32[]): bool =
    let method = rustCsgAppServerHttpRequestMethod(request)
    let path = rustCsgAppServerHttpRequestPath(request)
    if rustCsgAppServerHttpRequestHasOriginHeader(request) && !rustCsgAppServerIsBrowserSafeHttpPath(path):
        return rustCsgAppServerWriteHttpResponse(fd, 403, "text/plain; charset=utf-8", "")
    if method == "GET" && (path == "/readyz" || path == "/healthz"):
        return rustCsgAppServerWriteHttpResponse(fd, 200, "text/plain; charset=utf-8", "")
    if method == "GET" && path == "/rate-limit-dashboard":
        return rustCsgAppServerWriteHttpResponse(fd, 200, "text/html; charset=utf-8", rate_limit_dashboard_page.RustCsgRateLimitDashboardPageHtml())
    if method == "GET" && path == "/api/rate-limits":
        var dashboardJson: str
        var error: str
        if rustCsgAppServerRateLimitDashboardSnapshotJson(dashboardJson, error):
            return rustCsgAppServerWriteHttpResponse(fd, 200, "application/json; charset=utf-8", dashboardJson)
        return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
    if method == "POST" && path == "/api/rate-limits/refresh":
        var refreshJson: str
        var error: str
        if !rustCsgAppServerBroadcastDashboardLoadingSnapshot("", clientFds, clientModes, error):
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        if !rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast("", clientFds, clientModes, refreshJson, error):
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        var wsMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", refreshJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(wsMessage, -1, clientFds, clientModes)
        return rustCsgAppServerWriteHttpResponse(fd, 200, "application/json; charset=utf-8", refreshJson)
    if method == "POST" && rustCsgAppServerStartsWith(path, "/api/rate-limits/refresh/"):
        let rawAccount = strings.SliceBytes(path, 25, path.len - 25)
        let account = rustCsgAppServerRateLimitDashboardDecodePathSegment(rawAccount)
        var error: str
        let check = rustCsgAppServerRateLimitDashboardAccountCheck(account, error)
        if check == 0:
            return rustCsgAppServerWriteHttpResponse(fd, 404, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        if check < 0:
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        var refreshJson: str
        if !rustCsgAppServerBroadcastDashboardLoadingSnapshot(account, clientFds, clientModes, error):
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        if !rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast(account, clientFds, clientModes, refreshJson, error):
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        var wsMessage2 = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", refreshJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(wsMessage2, -1, clientFds, clientModes)
        return rustCsgAppServerWriteHttpResponse(fd, 200, "application/json; charset=utf-8", refreshJson)
    if method == "GET" && rustCsgAppServerStartsWith(path, "/api/rate-limits/login/"):
        let rawAccount = strings.SliceBytes(path, 23, path.len - 23)
        let account = rustCsgAppServerRateLimitDashboardDecodePathSegment(rawAccount)
        var error: str
        let check = rustCsgAppServerRateLimitDashboardAccountCheck(account, error)
        if check == 0:
            return rustCsgAppServerWriteHttpResponse(fd, 404, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        if check < 0:
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        var html: str
        if !rustCsgAppServerRateLimitDashboardManualLoginHtml(account, html, error):
            return rustCsgAppServerWriteHttpResponse(fd, 500, "application/json; charset=utf-8", rustCsgAppServerDashboardHttpErrorBody(error))
        return rustCsgAppServerWriteHttpResponse(fd, 200, "text/html; charset=utf-8", html)
    if method != "GET":
        return rustCsgAppServerWriteHttpResponse(fd, 405, "text/plain; charset=utf-8", "Request method must be `GET`")
    return rustCsgAppServerWriteHttpResponse(fd, 400, "text/plain; charset=utf-8", "Connection header did not include 'upgrade'")

fn rustCsgAppServerBroadcastDashboardSnapshot(message: str, excludeFd: int32, clientFds: int32[], clientModes: int32[]) =
    var i: int32
    while i < clientFds.len:
        if clientModes[i] == 2 && clientFds[i] != excludeFd:
            tcp.RustCsgWebSocketWriteFrame(clientFds[i], message)
        i = i + 1

fn rustCsgAppServerServeDashboardWebSocketInitial(fd: int32, clientFds: int32[], clientModes: int32[]): bool =
    var message: str
    var error: str
    rustCsgAppServerDashboardSnapshotServerMessage(message, error)
    if tcp.RustCsgWebSocketWriteFrame(fd, message) != 0:
        return false
    return true

fn rustCsgAppServerServeDashboardWebSocketFrame(fd: int32, data: str, clientFds: int32[], clientModes: int32[]): bool =
    let invalidMessage = rustCsgAppServerDashboardInvalidClientMessage(data)
    if invalidMessage != "invalid dashboard websocket message" &&
       invalidMessage != "":
        if !wire.RustCsgContains(invalidMessage, "unknown variant"):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(invalidMessage)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
    let commandType = wire.RustCsgJsonFindOptionalStr(data, "type")
    if commandType == "snapshot":
        var message: str
        var error: str
        rustCsgAppServerDashboardSnapshotServerMessage(message, error)
        if tcp.RustCsgWebSocketWriteFrame(fd, message) != 0:
            return false
        rustCsgAppServerBroadcastDashboardSnapshot(message, fd, clientFds, clientModes)
        return true
    if commandType == "refreshAll":
        var loadingJson: str
        var error: str
        if !rustCsgAppServerRateLimitDashboardLoadingJson("", loadingJson, error):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(error)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        let loadingMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", loadingJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(loadingMessage, -1, clientFds, clientModes)
        var refreshJson: str
        if !rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast("", clientFds, clientModes, refreshJson, error):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(error)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        let finalMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", refreshJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(finalMessage, -1, clientFds, clientModes)
        return true
    if commandType == "refreshAccount":
        let commandError = rustCsgAppServerDashboardInvalidClientMessage(data)
        if commandError != "invalid dashboard websocket message" &&
           !wire.RustCsgContains(commandError, "unknown variant"):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(commandError)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        let account = wire.RustCsgJsonFindOptionalStr(data, "email")
        var error: str
        let check = rustCsgAppServerRateLimitDashboardAccountCheck(account, error)
        if check == 0 || check < 0:
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(error)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        var loadingJson: str
        if !rustCsgAppServerRateLimitDashboardLoadingJson(account, loadingJson, error):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(error)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        let loadingMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", loadingJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(loadingMessage, -1, clientFds, clientModes)
        var refreshJson: str
        if !rustCsgAppServerRateLimitDashboardRefreshJsonWithBroadcast(account, clientFds, clientModes, refreshJson, error):
            let errorMessage = rustCsgAppServerDashboardErrorServerMessage(error)
            return tcp.RustCsgWebSocketWriteFrame(fd, errorMessage) == 0
        let finalMessage = wire.RustCsgCat(wire.RustCsgCat("{\"type\":\"snapshot\",\"data\":", refreshJson), "}")
        rustCsgAppServerBroadcastDashboardSnapshot(finalMessage, -1, clientFds, clientModes)
        return true
    let message = rustCsgAppServerDashboardErrorServerMessage(rustCsgAppServerDashboardInvalidClientMessage(data))
    return tcp.RustCsgWebSocketWriteFrame(fd, message) == 0

fn rustCsgAppServerRunStdio(): int32 =
    rustCsgAppServerResetFsWatches()
    rustCsgAppServerResetExecSessions()
    rustCsgAppServerResetDashboardManualLoginSessions()
    rustCsgAppServerResetThreadSubscriptions()
    let connectionId = rustCsgAppServerAllocateConnectionId()
    var buffer: str
    var idle: int32
    var execIdle: int32
    while true:
        if buffer.len > 0:
            let line = rustCsgAppServerTryReadStdioMessage(buffer)
            if line.ok:
                idle = 0
                execIdle = 0
                buffer = line.rest
                if line.body.len == 0:
                    continue
                if !rustCsgAppServerServeJsonLineRequest(1, connectionId, line.body, buffer):
                    return 78
                if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                    return 78
                continue
            if !line.blocked:
                return 78

        let chunk = process.ProcessReadFdBlocking(0, 100)
        if chunk.len == 0:
            if rustCsgAppServerHasExecSessionsForConnection(connectionId):
                if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                    return 78
                if !rustCsgAppServerHasExecSessionsForConnection(connectionId):
                    execIdle = 0
                    continue
                execIdle = execIdle + 1
                if execIdle >= 50:
                    rustCsgAppServerResetExecSessionsForConnection(connectionId)
                    if buffer.len > 0:
                        return 78
                    return 0
                continue
            idle = idle + 1
            if idle >= 2:
                if buffer.len > 0:
                    return 78
                return 0
            if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                return 78
        else:
            idle = 0
            execIdle = 0
            buffer = wire.RustCsgCat(buffer, chunk)

fn RustCsgAppServerRunUnix(listenFd: int32): int32 =
    while true:
        let clientFd = tcp.RustCsgUnixAccept(listenFd)
        if clientFd < 0:
            return 1
        let request = tcp.RustCsgHttpReadRequest(clientFd)
        if request == "":
            tcp.RustCsgSocketClose(clientFd)
            continue
        if rustCsgAppServerHttpRequestIsWebSocketUpgrade(request):
            let path = rustCsgAppServerHttpRequestPath(request)
            if rustCsgAppServerHttpRequestHasOriginHeader(request) && !rustCsgAppServerIsBrowserSafeHttpPath(path):
                rustCsgAppServerWriteHttpResponse(clientFd, 403, "text/plain; charset=utf-8", "")
                tcp.RustCsgSocketClose(clientFd)
                continue
            if tcp.RustCsgWebSocketAcceptRequest(clientFd, request) != 0:
                tcp.RustCsgSocketClose(clientFd)
                continue
            if path == "/rate-limit-dashboard/ws":
                var emptyFds: int32[]
                var emptyModes: int32[]
                rustCsgAppServerServeDashboardWebSocketInitial(clientFd, emptyFds, emptyModes)
                rustCsgAppServerServeDashboardWebSocket(clientFd)
            else:
                rustCsgAppServerServeWebSocket(clientFd)
        else:
            var emptyFds2: int32[]
            var emptyModes2: int32[]
            rustCsgAppServerServeRateLimitDashboardHttp(clientFd, request, emptyFds2, emptyModes2)
        tcp.RustCsgSocketClose(clientFd)

fn rustCsgAppServerServeWebSocket(clientFd: int32): int32 =
    rustCsgAppServerResetFsWatches()
    rustCsgAppServerResetThreadSubscriptions()
    let connectionId = rustCsgAppServerAllocateConnectionId()
    rustCsgAppServerResetExecSessionsForConnection(connectionId)
    while true:
        var data: str
        if rustCsgAppServerHasExecSessionsForConnection(connectionId):
            data = tcp.RustCsgWebSocketTryReadFrame(clientFd, 50)
            if data == "__RUST_CSG_WS_FRAME_BLOCKED__":
                if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                    rustCsgAppServerResetFsWatchesForConnection(connectionId)
                    rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId)
                    rustCsgAppServerResetExecSessionsForConnection(connectionId)
                    return 1
                continue
            if data.len == 0:
                rustCsgAppServerResetFsWatchesForConnection(connectionId)
                rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId)
                rustCsgAppServerResetExecSessionsForConnection(connectionId)
                return 0
        else:
            data = tcp.RustCsgWebSocketReadFrame(clientFd)
            if data.len == 0:
                rustCsgAppServerResetFsWatchesForConnection(connectionId)
                rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId)
                rustCsgAppServerResetExecSessionsForConnection(connectionId)
                return 0
        if !rustCsgAppServerServeWebSocketJsonRequest(clientFd, connectionId, data):
            rustCsgAppServerResetFsWatchesForConnection(connectionId)
            rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId)
            rustCsgAppServerResetExecSessionsForConnection(connectionId)
            return 1
        if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
            rustCsgAppServerResetFsWatchesForConnection(connectionId)
            rustCsgAppServerResetThreadSubscriptionsForConnection(connectionId)
            rustCsgAppServerResetExecSessionsForConnection(connectionId)
            return 1

fn rustCsgAppServerServeDashboardWebSocket(clientFd: int32): int32 =
    while true:
        let data = tcp.RustCsgWebSocketReadFrame(clientFd)
        if data.len == 0:
            return 0
        var emptyClientFds: int32[]
        var emptyClientModes: int32[]
        if !rustCsgAppServerServeDashboardWebSocketFrame(clientFd, data, emptyClientFds, emptyClientModes):
            return 1

fn rustCsgAppServerRemoveWsClient(index: int32, clientFds: var int32[], connectionIds: var int32[], clientModes: var int32[]) =
    rustCsgAppServerResetFsWatchesForConnection(connectionIds[index])
    rustCsgAppServerResetThreadSubscriptionsForConnection(connectionIds[index])
    rustCsgAppServerResetExecSessionsForConnection(connectionIds[index])
    tcp.RustCsgSocketClose(clientFds[index])
    var nextFds: int32[]
    var nextIds: int32[]
    var nextModes: int32[]
    var i: int32
    while i < clientFds.len:
        if i != index:
            add(nextFds, clientFds[i])
            add(nextIds, connectionIds[i])
            add(nextModes, clientModes[i])
        i = i + 1
    clientFds = nextFds
    connectionIds = nextIds
    clientModes = nextModes

fn rustCsgAppServerResetWsClients(clientFds: var int32[], connectionIds: var int32[], clientModes: var int32[]) =
    var i: int32
    while i < clientFds.len:
        tcp.RustCsgSocketClose(clientFds[i])
        i = i + 1
    clientFds = []
    connectionIds = []
    clientModes = []
    rustCsgAppServerResetFsWatches()
    rustCsgAppServerResetThreadSubscriptions()
    rustCsgAppServerResetExecSessions()

fn RustCsgAppServerRunWs(listenFd: int32): int32 =
    rustCsgAppServerCrashMark("ws-run-start")
    rustCsgAppServerResetFsWatches()
    rustCsgAppServerResetThreadSubscriptions()
    rustCsgAppServerResetExecSessions()
    var codexHome = RustCsgGetEnv("CODEX_HOME")
    if codexHome == "":
        var homeDir = RustCsgGetEnv("HOME")
        codexHome = wire.RustCsgCat(homeDir, "/.codex")
    var clientFds: int32[]
    var connectionIds: int32[]
    var clientModes: int32[]
    while true:
        let readable = tcp.RustCsgSocketReadable(listenFd, 10)
        if readable < 0:
            rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
            return 1
        if readable > 0:
            rustCsgAppServerCrashMark("ws-readable")
            let clientFd = tcp.RustCsgTcpAccept(listenFd)
            if clientFd < 0:
                rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                return 1
            rustCsgAppServerCrashMark("ws-accepted")
            let request = tcp.RustCsgHttpReadRequest(clientFd)
            rustCsgAppServerCrashMark("ws-request-read")
            if request == "":
                tcp.RustCsgSocketClose(clientFd)
            elif rustCsgAppServerHttpRequestIsWebSocketUpgrade(request):
                let path = rustCsgAppServerHttpRequestPath(request)
                rustCsgAppServerCrashMark("ws-upgrade")
                if rustCsgAppServerHttpRequestHasOriginHeader(request) && !rustCsgAppServerIsBrowserSafeHttpPath(path):
                    rustCsgAppServerWriteHttpResponse(clientFd, 403, "text/plain; charset=utf-8", "")
                    tcp.RustCsgSocketClose(clientFd)
                elif tcp.RustCsgWebSocketAcceptRequest(clientFd, request) != 0:
                    tcp.RustCsgSocketClose(clientFd)
                elif path == "/rate-limit-dashboard/ws":
                    rustCsgAppServerCrashMark("dashboard-ws-accepted")
                    if !rustCsgAppServerServeDashboardWebSocketInitial(clientFd, clientFds, clientModes):
                        tcp.RustCsgSocketClose(clientFd)
                    else:
                        add(clientFds, clientFd)
                        add(connectionIds, rustCsgAppServerAllocateConnectionId())
                        add(clientModes, 2)
                else:
                    add(clientFds, clientFd)
                    add(connectionIds, rustCsgAppServerAllocateConnectionId())
                    add(clientModes, 1)
            else:
                rustCsgAppServerCrashMark("http-request")
                rustCsgAppServerServeRateLimitDashboardHttp(clientFd, request, clientFds, clientModes)
                tcp.RustCsgSocketClose(clientFd)

        var i: int32
        while i < clientFds.len:
            let clientFd = clientFds[i]
            let connectionId = connectionIds[i]
            let clientMode = clientModes[i]
            let data = tcp.RustCsgWebSocketTryReadFrame(clientFd, 0)
            if data == "__RUST_CSG_WS_FRAME_BLOCKED__":
                if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                    rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                    return 1
                i = i + 1
                continue
            if data.len == 0:
                rustCsgAppServerRemoveWsClient(i, clientFds, connectionIds, clientModes)
                continue
            if clientMode == 2:
                rustCsgAppServerCrashMark("dashboard-ws-frame")
                if !rustCsgAppServerServeDashboardWebSocketFrame(clientFd, data, clientFds, clientModes):
                    rustCsgAppServerRemoveWsClient(i, clientFds, connectionIds, clientModes)
                else:
                    i = i + 1
                continue
            if wire.RustCsgContains(data, "\"method\""):
                let method = wire.RustCsgJsonFindStr(data, "method")
                if method == "thread/start":
                    if !rustCsgAppServerHandleThreadStartWebSocketBroadcast(rustCsgAppServerRequestId(data), data, clientFd, connectionId, clientFds):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    i = i + 1
                    continue
                if method == "thread/fork":
                    if !rustCsgAppServerHandleThreadForkWebSocketBroadcast(rustCsgAppServerRequestId(data), data, clientFd, connectionId, clientFds):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    i = i + 1
                    continue
                if method == "turn/start":
                    if !rustCsgAppServerHandleTurnStartWebSocketSubscribed(rustCsgAppServerRequestId(data), data, clientFd, clientFds, connectionIds):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    i = i + 1
                    continue
                if method == "thread/name/set":
                    if !rustCsgAppServerHandleThreadNameSetWebSocketBroadcast(rustCsgAppServerRequestId(data), data, clientFd, clientFds):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    i = i + 1
                    continue
                if method == "thread/archive":
                    if !rustCsgAppServerHandleThreadArchiveWebSocketBroadcast(rustCsgAppServerRequestId(data), data, clientFd, clientFds):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                        rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                        return 1
                    i = i + 1
                    continue
            if !rustCsgAppServerServeWebSocketJsonRequest(clientFd, connectionId, data):
                rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                return 1
            if !rustCsgAppServerPumpExecSessionsForConnection(connectionId):
                rustCsgAppServerResetWsClients(clientFds, connectionIds, clientModes)
                return 1
            i = i + 1

        var nowMs = rustCsgGetCurrentTimeMs()
        if RustCsgAppServerDashboardManualLoginEmails.len > 0:
            rustCsgAppServerPollDashboardManualLoginSessions(codexHome, nowMs)

fn rustCsgAppServerPrintHelp() =
    echo("Usage: codex-app-server [OPTIONS]")
    echo("")
    echo("Options:")
    echo("      --listen <URL>             Transport endpoint URL. Supported values: `stdio://` (default), `unix://`, `unix://PATH`, `ws://IP:PORT`, `off`")
    echo("      --session-source <SOURCE>  Session source used to derive product restrictions and metadata")
    echo("  -h, --help                     Print help")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var listen: str = "stdio://"
    var sawListen: bool
    var sessionSource: str = "vscode"
    let count = cmdline.paramCount()
    var i: int32 = 1

    while i < count:
        let arg = cmdline.paramStr(i)
        if arg == "--help" || arg == "-h":
            rustCsgAppServerPrintHelp()
            return 0

        var value: str
        if arg == "--listen":
            if i + 1 >= count:
                echo("error: a value is required for '--listen <URL>'")
                return 1
            value = cmdline.paramStr(i + 1)
            if value.len > 0 && value[0] == '-':
                echo("error: a value is required for '--listen <URL>'")
                return 1
            listen = value
            sawListen = true
            i = i + 2
            continue
        if rustCsgAppServerInlineFlagValue(arg, "--listen", value):
            listen = value
            sawListen = true
            i = i + 1
            continue

        if arg == "--session-source":
            if i + 1 >= count:
                echo("error: a value is required for '--session-source <SOURCE>'")
                return 1
            value = cmdline.paramStr(i + 1)
            if value.len > 0 && value[0] == '-':
                echo("error: a value is required for '--session-source <SOURCE>'")
                return 1
            if !rustCsgAppServerIsValidSessionSource(value):
                echo(rustCsgAppServerInvalidSessionSourceMessage(value))
                return 1
            sessionSource = value
            i = i + 2
            continue
        if rustCsgAppServerInlineFlagValue(arg, "--session-source", value):
            if !rustCsgAppServerIsValidSessionSource(value):
                echo(rustCsgAppServerInvalidSessionSourceMessage(value))
                return 1
            sessionSource = value
            i = i + 1
            continue

        echo(strings.ConcatStr("unexpected argument `", strings.ConcatStr(arg, "`")))
        return 1

    sessionSource
    if !rustCsgAppServerIsKnownListenUrl(listen):
        echo(rustCsgAppServerUnsupportedListenMessage(listen))
        return 1

    if sawListen && listen == "off":
        return 0
    if listen == "stdio://":
        return rustCsgAppServerRunStdio()
    if rustCsgAppServerStartsWith(listen, "unix://"):
        var path = strings.SliceBytes(listen, 7, listen.len - 7)
        if path == "":
            path = "/tmp/cheng-app-server.sock"
        let fd = tcp.RustCsgUnixListen(path)
        if fd < 0:
            echo(wire.RustCsgCat("Failed to listen on unix://", path))
            return 1
        echo(wire.RustCsgCat("Listening on unix://", path))
        return RustCsgAppServerRunUnix(fd)

    if rustCsgAppServerStartsWith(listen, "ws://"):
        let url = strings.SliceBytes(listen, 5, listen.len - 5)
        var host: str = "127.0.0.1"
        var port: int32 = 4096
        var colonAt: int32 = -1
        for i in 0..<url.len:
            if url[i] == ':':
                colonAt = i
                break
        if colonAt >= 0:
            host = strings.SliceBytes(url, 0, colonAt)
            let portStr = strings.SliceBytes(url, colonAt + 1, url.len - colonAt - 1)
            if portStr.len > 0:
                port = wire.RustCsgParsePositiveInt32(portStr)
        let fd = tcp.RustCsgTcpListen(host, port)
        let listenUrl = wire.RustCsgCat4("ws://", host, ":", strings.IntToStr(port))
        if fd < 0:
            echo(wire.RustCsgCat("Failed to listen on ", listenUrl))
            return 1
        echo(wire.RustCsgCat("Listening on ", listenUrl))
        rustCsgAppServerCrashMark("ws-listening")
        return RustCsgAppServerRunWs(fd)

    echo("codex app-server internal error: --listen URL `")
    echo(listen)
    echo("` was accepted by IsKnownListenUrl but not dispatched (code bug)")
    return 78
