fn rustCsgAppServerHandleServerRequestResolve(id: int32, body: str): str =
    let params = wire.RustCsgJsonFindOptionalObject(body, "params")
    if params == "":
        return rustCsgAppServerError(id, -32602, "serverRequest/resolve requires params")
    var coreOp: str
    var resolved: bool
    var submitError: str
    if !turn_event_loop.RustCsgAppServerTurnEventSubmitServerRequestApprovalResponse(params, coreOp, resolved, submitError):
        return rustCsgAppServerError(id, -32602, submitError)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("resolved", resolved))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("coreOp", wire.RustCsgJsonQuote(coreOp)))
    out = wire.RustCsgCat(out, "}")
    return rustCsgAppServerResponse(id, out)

# ── plugin/uninstall ────────────────────────────────────────────────────

fn rustCsgAppServerHandlePluginUninstall(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pluginId = wire.RustCsgJsonFindStr(paramsJson, "pluginId")
    if pluginId == "":
        return rustCsgAppServerError(id, -32602, "pluginId is required")
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32000, pathError)
    let pluginsDir = home.RustCsgPathJoinChild(codexHome, "plugins")
    let pluginDir = home.RustCsgPathJoinChild(pluginsDir, pluginId)
    let deleted = rustCsgAppServerDeletePluginDirectoryIfPresent(pluginDir)
    if !deleted:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to remove plugin directory")
    return rustCsgAppServerResponse(id, "{\"uninstalled\":true}")

# ── plugin/update ───────────────────────────────────────────────────────

fn rustCsgAppServerHandlePluginUpdate(id: int32, body: str): str =
    let paramsJson = wire.RustCsgJsonFindObject(body, "params")
    let pluginId = wire.RustCsgJsonFindStr(paramsJson, "pluginId")
    if pluginId == "":
        return rustCsgAppServerError(id, -32602, "pluginId is required")
    var codexHome: str
    var pathError: str
    home.RustCsgFindCodexHomeInto(codexHome, pathError)
    if pathError != "":
        return rustCsgAppServerError(id, -32000, pathError)
    let pluginsDir = home.RustCsgPathJoinChild(codexHome, "plugins")
    let parentOk = rustCsgAppServerEnsureDirectory(pluginsDir)
    if !parentOk:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to create plugins directory")
    let pluginDir = home.RustCsgPathJoinChild(pluginsDir, pluginId)
    let deleted = rustCsgAppServerDeletePluginDirectoryIfPresent(pluginDir)
    if !deleted:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to remove plugin directory")
    let mkdirOk = rustCsgAppServerMkdir(pluginDir)
    if mkdirOk == 0:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to create plugin directory")
    let manifestPath = home.RustCsgPathJoinChild(pluginDir, "manifest.json")
    var manifest = "{"
    manifest = wire.RustCsgCat(manifest, wire.RustCsgJsonFieldStr("pluginId", pluginId))
    let url = wire.RustCsgJsonFindOptionalStr(paramsJson, "url")
    if url != "":
        manifest = wire.RustCsgCat(manifest, ",")
        manifest = wire.RustCsgCat(manifest, wire.RustCsgJsonFieldStr("url", url))
    manifest = wire.RustCsgCat(manifest, "}")
    let wrote = rustCsgAppServerWriteFile(manifestPath, manifest)
    if wrote == 0:
        return rustCsgAppServerError(id, -32603, "file I/O not available: failed to write manifest")
    return rustCsgAppServerResponse(id, "{\"updated\":true}")

