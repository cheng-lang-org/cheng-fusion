import std/strings
import cheng/codex/auth/login as auth_login
import cheng/codex/auth/oauth as auth_oauth
import cheng/codex/backend_client/api as backend_api
import cheng/codex/backend_client/client as backend_client
import cheng/codex/protocol/ratelimit_wire
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

@importc("RustCsgGetEnv")
fn rustCsgRateLimitDashboardGetEnv(name: str): str

@importc("ReadFile")
fn rustCsgRateLimitDashboardReadFile(path: str): str

fn rustCsgRateLimitDashboardIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn rustCsgRateLimitDashboardByteIsJsonSpace(text: str, pos: int32): bool =
    let ch = strings.SliceBytes(text, pos, 1)
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r"

fn rustCsgRateLimitDashboardByteAt(text: str, pos: int32): str =
    if pos < 0 || pos >= text.len:
        return ""
    return strings.SliceBytes(text, pos, 1)

fn rustCsgRateLimitDashboardTrim(text: str): str =
    var start: int32
    var end: int32 = text.len
    while start < end && rustCsgRateLimitDashboardIsSpace(text[start]):
        start = start + 1
    while end > start && rustCsgRateLimitDashboardIsSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn rustCsgRateLimitDashboardStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn rustCsgRateLimitDashboardStripQuotes(value: str): str =
    if value.len >= 2:
        let first = value[0]
        let last = value[value.len - 1]
        if first == '"' && last == '"':
            return strings.SliceBytes(value, 1, value.len - 2)
        if int32(first) == 39 && int32(last) == 39:
            return strings.SliceBytes(value, 1, value.len - 2)
    return value

fn rustCsgRateLimitDashboardLineWithoutTrailingCr(line: str): str =
    if line.len > 0 && line[line.len - 1] == '\r':
        return strings.SliceBytes(line, 0, line.len - 1)
    return line

fn rustCsgRateLimitDashboardFindEnvValue(content: str, key: str, outValue: var str): bool =
    outValue = ""
    var pos: int32
    while pos <= content.len:
        var lineEnd: int32 = pos
        while lineEnd < content.len && content[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        var line = strings.SliceBytes(content, pos, lineEnd - pos)
        line = rustCsgRateLimitDashboardLineWithoutTrailingCr(line)
        pos = lineEnd + 1

        var trimmed = rustCsgRateLimitDashboardTrim(line)
        if trimmed == "":
            continue
        if trimmed[0] == '#':
            continue
        if rustCsgRateLimitDashboardStartsWith(trimmed, "export "):
            trimmed = rustCsgRateLimitDashboardTrim(strings.SliceBytes(trimmed, 7, trimmed.len - 7))

        var equalsAt: int32 = -1
        var i: int32
        while i < trimmed.len:
            if trimmed[i] == '=':
                equalsAt = i
                break
            i = i + 1
        if equalsAt <= 0:
            continue
        let lineKey = rustCsgRateLimitDashboardTrim(strings.SliceBytes(trimmed, 0, equalsAt))
        if lineKey != key:
            continue
        let rawValue = rustCsgRateLimitDashboardTrim(strings.SliceBytes(trimmed, equalsAt + 1, trimmed.len - equalsAt - 1))
        outValue = rustCsgRateLimitDashboardStripQuotes(rawValue)
        return true
    return false

fn rustCsgRateLimitDashboardValidatePassword(content: str, path: str, outError: var str): bool =
    outError = ""
    if content == "":
        outError = wire.RustCsgCat("PASSWORD is missing from ", path)
        return false
    var password: str
    if !rustCsgRateLimitDashboardFindEnvValue(content, "PASSWORD", password):
        outError = wire.RustCsgCat("PASSWORD is missing from ", path)
        return false
    if rustCsgRateLimitDashboardTrim(password) == "":
        outError = wire.RustCsgCat("PASSWORD in ", wire.RustCsgCat(path, " is empty"))
        return false
    var mailboxPassword: str
    if rustCsgRateLimitDashboardFindEnvValue(content, "MAILBOX_PASSWORD", mailboxPassword):
        if rustCsgRateLimitDashboardTrim(mailboxPassword) == "":
            outError = wire.RustCsgCat("MAILBOX_PASSWORD in ", wire.RustCsgCat(path, " is empty"))
            return false
    return true

fn rustCsgRateLimitDashboardConfiguredAccountsFromEnv(content: str,
                                                      path: str,
                                                      outAccounts: var str,
                                                      outError: var str): bool =
    outAccounts = ""
    outError = ""
    var accountsValue: str
    if !rustCsgRateLimitDashboardFindEnvValue(content, "ACCOUNTS", accountsValue):
        outError = wire.RustCsgCat("ACCOUNTS is missing from ", path)
        return false
    var accounts = "["
    var seenAccounts = "|"
    var accountCount: int32
    var pos: int32
    while pos < accountsValue.len:
        while pos < accountsValue.len && rustCsgRateLimitDashboardIsSpace(accountsValue[pos]):
            pos = pos + 1
        if pos >= accountsValue.len:
            break
        var token: str
        while pos < accountsValue.len && !rustCsgRateLimitDashboardIsSpace(accountsValue[pos]):
            token = wire.RustCsgCat(token, strings.SliceBytes(accountsValue, pos, 1))
            pos = pos + 1
        if token == "":
            continue
        let seenMarker = wire.RustCsgCat(wire.RustCsgCat(wire.RustCsgCat("|", strings.IntToStr(strings.Len(token))), ":"), wire.RustCsgCat(token, "|"))
        if wire.RustCsgContains(seenAccounts, seenMarker):
            continue
        seenAccounts = wire.RustCsgCat(seenAccounts, strings.SliceBytes(seenMarker, 1, strings.Len(seenMarker) - 1))
        if accountCount > 0:
            accounts = wire.RustCsgCat(accounts, ",")
        accounts = wire.RustCsgCat(accounts, "{")
        accounts = wire.RustCsgCat(accounts, wire.RustCsgJsonFieldStr("email", token))
        accounts = wire.RustCsgCat(accounts, "}")
        accountCount = accountCount + 1
    if accountCount == 0:
        outError = wire.RustCsgCat("ACCOUNTS in ", wire.RustCsgCat(path, " is empty"))
        return false
    outAccounts = wire.RustCsgCat(accounts, "]")
    return true

fn rustCsgRateLimitDashboardSkipJsonSpace(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len && rustCsgRateLimitDashboardByteIsJsonSpace(text, i):
        i = i + 1
    return i

fn rustCsgRateLimitDashboardRawIsJsonIntOrNull(raw: str): bool =
    if raw == "null":
        return true
    if raw == "":
        return false
    var pos: int32
    if raw[0] == '-':
        pos = 1
    if pos >= raw.len:
        return false
    var sawDigit: bool
    while pos < raw.len:
        let ch = raw[pos]
        if ch < '0' || ch > '9':
            return false
        sawDigit = true
        pos = pos + 1
    return sawDigit

fn rustCsgRateLimitDashboardRawJsonValueAt(text: str, start: int32): str =
    let p = rustCsgRateLimitDashboardSkipJsonSpace(text, start)
    if p >= text.len:
        return ""
    let first = strings.SliceBytes(text, p, 1)
    if first == "{":
        var depth: int32
        var inString: bool
        var escaped: bool
        var out: str
        var i = p
        while i < text.len:
            let ch = strings.SliceBytes(text, i, 1)
            out = wire.RustCsgCat(out, ch)
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    return out
            i = i + 1
        return ""
    if first == "[":
        var depth: int32
        var inString: bool
        var escaped: bool
        var out: str
        var i = p
        while i < text.len:
            let ch = strings.SliceBytes(text, i, 1)
            out = wire.RustCsgCat(out, ch)
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "[":
                depth = depth + 1
            elif ch == "]":
                depth = depth - 1
                if depth == 0:
                    return out
            i = i + 1
        return ""
    if first == "\"":
        var out = "\""
        var escaped: bool
        var i = p + 1
        while i < text.len:
            let ch = strings.SliceBytes(text, i, 1)
            out = wire.RustCsgCat(out, ch)
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                return out
            i = i + 1
        return ""
    var out: str
    var i = p
    while i < text.len:
        let ch = strings.SliceBytes(text, i, 1)
        if ch == "," || ch == "}" || ch == "]" || ch == " " || ch == "\n" || ch == "\r" || ch == "\t":
            break
        out = wire.RustCsgCat(out, ch)
        i = i + 1
    return out

fn rustCsgRateLimitDashboardJsonValueEndAt(text: str, start: int32): int32 =
    let p = rustCsgRateLimitDashboardSkipJsonSpace(text, start)
    if p >= text.len:
        return -1
    let first = rustCsgRateLimitDashboardByteAt(text, p)
    if first == "{" || first == "[":
        var depth: int32
        var inString: bool
        var escaped: bool
        var i = p
        while i < text.len:
            let ch = rustCsgRateLimitDashboardByteAt(text, i)
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == first:
                depth = depth + 1
            elif first == "{" && ch == "}":
                depth = depth - 1
                if depth == 0:
                    return i + 1
            elif first == "[" && ch == "]":
                depth = depth - 1
                if depth == 0:
                    return i + 1
            i = i + 1
        return -1
    if first == "\"":
        var escaped: bool
        var i = p + 1
        while i < text.len:
            let ch = rustCsgRateLimitDashboardByteAt(text, i)
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                return i + 1
            i = i + 1
        return -1
    var i = p
    while i < text.len:
        let ch = rustCsgRateLimitDashboardByteAt(text, i)
        if ch == "," || ch == "}" || ch == "]" || ch == " " || ch == "\n" || ch == "\r" || ch == "\t":
            return i
        i = i + 1
    return i

fn rustCsgRateLimitDashboardTopValueRaw(text: str, key: str): str =
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    while i < text.len:
        let ch = strings.SliceBytes(text, i, 1)
        if inString:
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                inString = false
            i = i + 1
            continue
        if ch == "\"":
            if depth == 1:
                var keyText: str
                var j = i + 1
                var keyEscaped: bool
                while j < text.len:
                    let keyCh = strings.SliceBytes(text, j, 1)
                    if keyEscaped:
                        keyText = wire.RustCsgCat(keyText, keyCh)
                        keyEscaped = false
                    elif keyCh == "\\":
                        keyEscaped = true
                    elif keyCh == "\"":
                        var p = rustCsgRateLimitDashboardSkipJsonSpace(text, j + 1)
                        if keyText == key && p < text.len && strings.SliceBytes(text, p, 1) == ":":
                            return rustCsgRateLimitDashboardRawJsonValueAt(text, p + 1)
                        break
                    else:
                        keyText = wire.RustCsgCat(keyText, keyCh)
                    j = j + 1
            inString = true
        elif ch == "{":
            depth = depth + 1
        elif ch == "}":
            depth = depth - 1
        i = i + 1
    return ""

fn rustCsgRateLimitDashboardTopObject(text: str, key: str): str =
    let raw = rustCsgRateLimitDashboardTopValueRaw(text, key)
    if raw == "" || raw == "null":
        return ""
    if strings.SliceBytes(raw, 0, 1) == "{":
        return raw
    return ""

fn rustCsgRateLimitDashboardTopArray(text: str, key: str): str =
    let raw = rustCsgRateLimitDashboardTopValueRaw(text, key)
    if raw == "" || raw == "null":
        return ""
    if strings.SliceBytes(raw, 0, 1) == "[":
        return raw
    return ""

fn rustCsgRateLimitDashboardTopStr(text: str, key: str): str =
    let raw = rustCsgRateLimitDashboardTopValueRaw(text, key)
    if raw == "" || raw == "null":
        return ""
    if strings.SliceBytes(raw, 0, 1) != "\"":
        return ""
    let wrapper = wire.RustCsgCat(wire.RustCsgCat("{\"", key), "\":")
    return wire.RustCsgJsonFindStr(wire.RustCsgCat(wire.RustCsgCat(wrapper, raw), "}"), key)

fn rustCsgRateLimitDashboardStatusIsValid(status: str): bool =
    return status == "idle" || status == "loading" || status == "success" || status == "failed"

fn rustCsgRateLimitDashboardNormalizeRecord(recordJson: str, outRecord: var str, outError: var str): bool =
    outRecord = ""
    outError = ""
    let email = wire.RustCsgJsonFindOptionalStr(recordJson, "email")
    if email == "":
        outError = wire.RustCsgCat("rate limit dashboard cache account is missing email: ", recordJson)
        return false
    let status = wire.RustCsgJsonFindOptionalStr(recordJson, "status")
    if !rustCsgRateLimitDashboardStatusIsValid(status):
        outError = wire.RustCsgCat("rate limit dashboard cache account has invalid status: ", email)
        return false
    var fetchedAtJson = wire.RustCsgJsonFindOptionalValueRaw(recordJson, "fetchedAt")
    if fetchedAtJson == "":
        fetchedAtJson = "null"
    if !rustCsgRateLimitDashboardRawIsJsonIntOrNull(fetchedAtJson):
        outError = wire.RustCsgCat("rate limit dashboard cache account has invalid fetchedAt: ", email)
        return false
    var rateLimitsJson = wire.RustCsgJsonFindOptionalArray(recordJson, "rateLimits")
    if rateLimitsJson == "":
        rateLimitsJson = "[]"
    var errorJson = wire.RustCsgJsonFindOptionalValueRaw(recordJson, "error")
    if errorJson == "":
        errorJson = "null"
    if errorJson != "null":
        if errorJson.len == 0 || errorJson[0] != '"':
            outError = wire.RustCsgCat("rate limit dashboard cache account has invalid error: ", email)
            return false
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", email))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("fetchedAt", fetchedAtJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", rateLimitsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", errorJson))
    out = wire.RustCsgCat(out, "}")
    outRecord = out
    return true

fn rustCsgRateLimitDashboardNormalizeCacheAccounts(accountsJson: str, outAccounts: var str, outError: var str): bool =
    outAccounts = ""
    outError = ""
    var normalized = "["
    var count: int32
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, 0)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "[":
        outError = "rate limit dashboard cache accounts must be an array"
        return false
    pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == "]":
        outAccounts = "[]"
        return true
    while pos < accountsJson.len:
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            outError = "dashboard account cache entry must be a JSON object"
            return false
        var objectJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < accountsJson.len && !complete:
            let ch = rustCsgRateLimitDashboardByteAt(accountsJson, next)
            objectJson = wire.RustCsgCat(objectJson, strings.SliceBytes(accountsJson, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            outError = "unterminated dashboard account cache JSON object"
            return false
        var recordJson: str
        if !rustCsgRateLimitDashboardNormalizeRecord(objectJson, recordJson, outError):
            return false
        if count > 0:
            normalized = wire.RustCsgCat(normalized, ",")
        normalized = wire.RustCsgCat(normalized, recordJson)
        count = count + 1
        pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, next)
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
            continue
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == "]":
            outAccounts = wire.RustCsgCat(normalized, "]")
            return true
        outError = "rate limit dashboard cache accounts array has invalid separator"
        return false
    outError = "unterminated rate limit dashboard cache accounts array"
    return false

fn rustCsgRateLimitDashboardFindRecordByEmail(accountsJson: str, email: str): str =
    var found: str
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, 0)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "[":
        return ""
    pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    while pos < accountsJson.len && rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            return ""
        var objectJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < accountsJson.len && !complete:
            let ch = rustCsgRateLimitDashboardByteAt(accountsJson, next)
            objectJson = wire.RustCsgCat(objectJson, strings.SliceBytes(accountsJson, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            return ""
        if wire.RustCsgJsonFindOptionalStr(objectJson, "email") == email:
            found = objectJson
        pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, next)
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    return found

fn rustCsgRateLimitDashboardIdleRecord(email: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", email))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "idle"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("fetchedAt", "null"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", "[]"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", "null"))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardRecordWithStatus(recordJson: str, status: str, errorJson: str): str =
    let email = wire.RustCsgJsonFindOptionalStr(recordJson, "email")
    var fetchedAtJson = wire.RustCsgJsonFindOptionalValueRaw(recordJson, "fetchedAt")
    if fetchedAtJson == "":
        fetchedAtJson = "null"
    var rateLimitsJson = wire.RustCsgJsonFindOptionalArray(recordJson, "rateLimits")
    if rateLimitsJson == "":
        rateLimitsJson = "[]"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", email))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("fetchedAt", fetchedAtJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", rateLimitsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", errorJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardRecordWithSuccess(recordJson: str,
                                              rateLimitsJson: str,
                                              fetchedAtJson: str): str =
    let email = wire.RustCsgJsonFindOptionalStr(recordJson, "email")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", email))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "success"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("fetchedAt", fetchedAtJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", rateLimitsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", "null"))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardPathJoinChild(parent: str, child: str): str =
    if parent == "":
        return child
    if strings.SliceBytes(parent, parent.len - 1, 1) == "/":
        return wire.RustCsgCat(parent, child)
    return wire.RustCsgCat(wire.RustCsgCat(parent, "/"), child)

fn rustCsgRateLimitDashboardSlug(email: str): str =
    var out: str
    var i: int32
    while i < email.len:
        let code = int32(email[i])
        if code >= int32('0') && code <= int32('9'):
            out = wire.RustCsgCat(out, strings.SliceBytes(email, i, 1))
        elif code >= int32('a') && code <= int32('z'):
            out = wire.RustCsgCat(out, strings.SliceBytes(email, i, 1))
        elif code >= int32('A') && code <= int32('Z'):
            out = wire.RustCsgCat(out, strings.CharToStr(char(code + 32)))
        else:
            out = wire.RustCsgCat(out, "_")
        i = i + 1
    return out

fn rustCsgRateLimitDashboardAsciiLower(value: str): str =
    var out: str
    var i: int32
    while i < value.len:
        let code = int32(value[i])
        if code >= int32('A') && code <= int32('Z'):
            out = wire.RustCsgCat(out, strings.CharToStr(char(code + 32)))
        else:
            out = wire.RustCsgCat(out, strings.SliceBytes(value, i, 1))
        i = i + 1
    return out

fn rustCsgRateLimitDashboardRehostRoot(): str =
    let overrideRoot = rustCsgRateLimitDashboardGetEnv("CODEX_RATE_LIMIT_DASHBOARD_REHOST_ROOT")
    if overrideRoot != "":
        return overrideRoot
    let homeDir = rustCsgRateLimitDashboardGetEnv("HOME")
    if homeDir == "":
        return ""
    return rustCsgRateLimitDashboardPathJoinChild(homeDir, ".codex-rehost")

fn rustCsgRateLimitDashboardProfileHomeFromRestoredAccounts(manifestJson: str, email: str): str =
    let profilesJson = wire.RustCsgJsonFindOptionalArray(manifestJson, "profiles")
    if profilesJson == "":
        return ""
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(profilesJson, 0)
    if rustCsgRateLimitDashboardByteAt(profilesJson, pos) != "[":
        return ""
    pos = rustCsgRateLimitDashboardSkipJsonSpace(profilesJson, pos + 1)
    while pos < profilesJson.len && rustCsgRateLimitDashboardByteAt(profilesJson, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(profilesJson, pos) != "{":
            return ""
        let profileJson = rustCsgRateLimitDashboardRawJsonValueAt(profilesJson, pos)
        if profileJson == "":
            return ""
        let profileEmail = wire.RustCsgJsonFindOptionalStr(profileJson, "email")
        if profileEmail != "" && rustCsgRateLimitDashboardAsciiLower(profileEmail) == rustCsgRateLimitDashboardAsciiLower(email):
            return wire.RustCsgJsonFindOptionalStr(profileJson, "codexHomePath")
        let profileEnd = rustCsgRateLimitDashboardJsonValueEndAt(profilesJson, pos)
        if profileEnd < 0:
            return ""
        pos = rustCsgRateLimitDashboardSkipJsonSpace(profilesJson, profileEnd)
        if rustCsgRateLimitDashboardByteAt(profilesJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(profilesJson, pos + 1)
    return ""

fn rustCsgRateLimitDashboardRehostProfileAuthHome(email: str): str =
    let rehostRoot = rustCsgRateLimitDashboardRehostRoot()
    if rehostRoot == "":
        return ""
    let manifestPath = rustCsgRateLimitDashboardPathJoinChild(rehostRoot, "restored-accounts.json")
    let manifestJson = rustCsgRateLimitDashboardReadFile(manifestPath)
    if manifestJson == "":
        return ""
    return rustCsgRateLimitDashboardProfileHomeFromRestoredAccounts(manifestJson, email)

fn rustCsgRateLimitDashboardHtmlEscape(value: str): str =
    var out: str
    var i: int32
    while i < value.len:
        let ch = strings.SliceBytes(value, i, 1)
        if ch == "&":
            out = wire.RustCsgCat(out, "&amp;")
        elif ch == "<":
            out = wire.RustCsgCat(out, "&lt;")
        elif ch == ">":
            out = wire.RustCsgCat(out, "&gt;")
        elif ch == "\"":
            out = wire.RustCsgCat(out, "&quot;")
        elif ch == "'":
            out = wire.RustCsgCat(out, "&#39;")
        else:
            out = wire.RustCsgCat(out, ch)
        i = i + 1
    return out

fn rustCsgRateLimitDashboardStringLess(left: str, right: str): bool =
    var i: int32
    while i < left.len && i < right.len:
        if left[i] < right[i]:
            return true
        if left[i] > right[i]:
            return false
        i = i + 1
    return left.len < right.len

fn rustCsgRateLimitDashboardSnapshotLess(left: str, right: str): bool =
    let leftId = wire.RustCsgJsonFindOptionalStr(left, "limitId")
    let rightId = wire.RustCsgJsonFindOptionalStr(right, "limitId")
    if leftId != rightId:
        return rustCsgRateLimitDashboardStringLess(leftId, rightId)
    let leftName = wire.RustCsgJsonFindOptionalStr(left, "limitName")
    let rightName = wire.RustCsgJsonFindOptionalStr(right, "limitName")
    return rustCsgRateLimitDashboardStringLess(leftName, rightName)

fn rustCsgRateLimitDashboardAuthEmail(auth: auth_login.AuthDotJson): str =
    var email = auth_oauth.IdTokenEmail(auth.rawIdToken)
    if email != "":
        return email
    return auth_oauth.IdTokenEmail(auth.accessToken)

fn rustCsgRateLimitDashboardIndexEmitted(emitted: str, index: int32): bool =
    return wire.RustCsgContains(emitted, wire.RustCsgCat(wire.RustCsgCat("|", strings.IntToStr(index)), "|"))

fn rustCsgRateLimitDashboardSortedSnapshots(snapshotsJson: str): str =
    var out = "["
    var emitted = "|"
    var outCount: int32
    while true:
        var selectedSnapshot: str
        var selectedIndex: int32 = -1
        var index: int32
        var pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, 0)
        if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "[":
            return snapshotsJson
        pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
        while pos < snapshotsJson.len && rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "]":
            if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "{":
                return snapshotsJson
            let snapshotJson = rustCsgRateLimitDashboardRawJsonValueAt(snapshotsJson, pos)
            if snapshotJson == "":
                return snapshotsJson
            if !rustCsgRateLimitDashboardIndexEmitted(emitted, index):
                if selectedSnapshot == "" || rustCsgRateLimitDashboardSnapshotLess(snapshotJson, selectedSnapshot):
                    selectedSnapshot = snapshotJson
                    selectedIndex = index
            let snapshotEnd = rustCsgRateLimitDashboardJsonValueEndAt(snapshotsJson, pos)
            if snapshotEnd < 0:
                return snapshotsJson
            index = index + 1
            pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, snapshotEnd)
            if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) == ",":
                pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
        if selectedIndex < 0:
            break
        if outCount > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, selectedSnapshot)
        emitted = wire.RustCsgCat(emitted, wire.RustCsgCat(strings.IntToStr(selectedIndex), "|"))
        outCount = outCount + 1
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgRateLimitDashboardAccountAuthHome(codexHome: str, email: str): str =
    let rehostAuthHome = rustCsgRateLimitDashboardRehostProfileAuthHome(email)
    if rehostAuthHome != "":
        return rehostAuthHome
    let authRoot = rustCsgRateLimitDashboardPathJoinChild(codexHome, "rate_limit_dashboard_auth")
    let digest = strings.Sha256(email)
    let suffix = strings.SliceBytes(digest, 0, 12)
    return rustCsgRateLimitDashboardPathJoinChild(authRoot, wire.RustCsgCat(wire.RustCsgCat(rustCsgRateLimitDashboardSlug(email), "-"), suffix))

fn RustCsgRateLimitDashboardManualLoginHtml(email: str, verificationUrl: str, userCode: str): str =
    let escapedEmail = rustCsgRateLimitDashboardHtmlEscape(email)
    let escapedVerificationUrl = rustCsgRateLimitDashboardHtmlEscape(verificationUrl)
    let escapedUserCode = rustCsgRateLimitDashboardHtmlEscape(userCode)
    var out = """
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Manual Login</title>
  <style>
    :root { --bg: #ffffff; --fg: #111111; --line: #dddddd; --muted: #666666; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    main { max-width: 560px; margin: 0 auto; padding: 32px 20px 40px; }
    h1 { margin: 0 0 8px; font-size: 28px; line-height: 1.2; }
    p { margin: 0 0 16px; }
    .code { margin: 20px 0; padding: 18px 20px; border: 1px solid var(--line); font: 700 32px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.08em; text-align: center; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0; }
    a, button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 14px; border: 1px solid var(--line); background: #fff; color: var(--fg); font: inherit; text-decoration: none; cursor: pointer; }
    ol { padding-left: 22px; margin: 18px 0; }
    .muted { color: var(--muted); }
  </style>
</head>
<body>
  <main>
"""
    out = wire.RustCsgCat(out, "<h1>Manual login for ")
    out = wire.RustCsgCat(out, escapedEmail)
    out = wire.RustCsgCat(out, "</h1><p>OpenAI browser authorize is unstable here, so this page now uses the official device-code flow.</p><div class=\"code\">")
    out = wire.RustCsgCat(out, escapedUserCode)
    out = wire.RustCsgCat(out, "</div><div class=\"actions\"><a href=\"")
    out = wire.RustCsgCat(out, escapedVerificationUrl)
    out = wire.RustCsgCat(out, "\" target=\"_blank\" rel=\"noopener\">Open OpenAI verification page</a><button id=\"copy-code\" type=\"button\" data-code=\"")
    out = wire.RustCsgCat(out, escapedUserCode)
    out = wire.RustCsgCat(out, "\">Copy code</button></div><ol><li>Open the OpenAI verification page.</li><li>Sign in with <strong>")
    out = wire.RustCsgCat(out, escapedEmail)
    out = wire.RustCsgCat(out, "</strong>.</li><li>Enter the one-time code shown above.</li><li>After OpenAI confirms the login, return to the dashboard and click <strong>Refresh</strong>.</li></ol><p class=\"muted\">This code expires in about 15 minutes. If it expires, close this tab and click Login again.</p>")
    out = wire.RustCsgCat(out, """
  </main>
  <script>
    const copyButton = document.getElementById("copy-code");
    if (copyButton) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.code || "");
          copyButton.textContent = "Copied";
        } catch (error) {
          copyButton.textContent = "Copy failed";
        }
      });
    }
  </script>
</body>
</html>
""")
    return out

fn rustCsgRateLimitDashboardDefaultChatGptBaseUrl(): str =
    return "https://chatgpt.com/backend-api"

fn rustCsgRateLimitDashboardRoundJsonNumberToIntRaw(raw: str): str =
    assert(raw != "", "missing json number")
    var pos: int32
    var sign: int32 = 1
    if raw[0] == '-':
        sign = -1
        pos = 1
    var whole: int32
    var sawDigit: bool
    while pos < raw.len:
        let digit = wire.RustCsgDigitValue(strings.SliceBytes(raw, pos, 1))
        if digit < 0:
            break
        sawDigit = true
        whole = whole * 10 + digit
        pos = pos + 1
    assert(sawDigit, "json number missing integer digits")
    var roundUp: bool
    if pos < raw.len && raw[pos] == '.':
        pos = pos + 1
        if pos < raw.len:
            let firstFractionDigit = wire.RustCsgDigitValue(strings.SliceBytes(raw, pos, 1))
            assert(firstFractionDigit >= 0, "json number fraction missing digits")
            if firstFractionDigit >= 5:
                roundUp = true
        while pos < raw.len:
            let fractionDigit = wire.RustCsgDigitValue(strings.SliceBytes(raw, pos, 1))
            if fractionDigit < 0:
                break
            pos = pos + 1
    assert(pos == raw.len, wire.RustCsgCat("unsupported json number: ", raw))
    if roundUp:
        whole = whole + 1
    if sign < 0:
        return strings.IntToStr(0 - whole)
    return strings.IntToStr(whole)

fn rustCsgRateLimitDashboardWindowFromUsage(rateLimitJson: str, key: str): str =
    if rateLimitJson == "":
        return "null"
    let windowJson = wire.RustCsgJsonFindOptionalObject(rateLimitJson, key)
    if windowJson == "":
        return "null"
    let usedPercentRaw = rustCsgRateLimitDashboardRoundJsonNumberToIntRaw(wire.RustCsgJsonFindValueRaw(windowJson, "used_percent"))
    var secondsRaw = wire.RustCsgJsonFindOptionalValueRaw(windowJson, "limit_window_seconds")
    var windowMinutesJson = "null"
    if secondsRaw != "" && secondsRaw != "null":
        let seconds = wire.RustCsgParseInt32(secondsRaw)
        windowMinutesJson = strings.IntToStr((seconds + 59) / 60)
    var resetsAtJson = wire.RustCsgJsonFindOptionalValueRaw(windowJson, "reset_at")
    if resetsAtJson == "":
        resetsAtJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("usedPercent", usedPercentRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("windowDurationMins", windowMinutesJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("resetsAt", resetsAtJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardCreditsFromUsage(creditsJson: str): str =
    if creditsJson == "":
        return "null"
    var balanceJson = wire.RustCsgJsonFindOptionalValueRaw(creditsJson, "balance")
    if balanceJson == "":
        balanceJson = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("hasCredits", wire.RustCsgJsonFindBool(creditsJson, "has_credits")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("unlimited", wire.RustCsgJsonFindBool(creditsJson, "unlimited")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("balance", balanceJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardPlanTypeFromUsage(planType: str): str =
    if planType == "free":
        return "free"
    if planType == "go":
        return "go"
    if planType == "plus":
        return "plus"
    if planType == "pro":
        return "pro"
    if planType == "team":
        return "team"
    if planType == "self_serve_business_usage_based":
        return "self_serve_business_usage_based"
    if planType == "business":
        return "business"
    if planType == "enterprise_cbp_usage_based":
        return "enterprise_cbp_usage_based"
    if planType == "enterprise":
        return "enterprise"
    if planType == "edu" || planType == "education":
        return "edu"
    return "unknown"

fn rustCsgRateLimitDashboardSnapshotFromUsageParts(limitId: str,
                                                   limitName: str,
                                                   rateLimitJson: str,
                                                   creditsJson: str,
                                                   planTypeJson: str): str =
    var limitNameJson = "null"
    if limitName != "":
        limitNameJson = wire.RustCsgJsonQuote(limitName)
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("limitId", limitId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("limitName", limitNameJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("primary", rustCsgRateLimitDashboardWindowFromUsage(rateLimitJson, "primary_window")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("secondary", rustCsgRateLimitDashboardWindowFromUsage(rateLimitJson, "secondary_window")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("credits", rustCsgRateLimitDashboardCreditsFromUsage(creditsJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("planType", planTypeJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardUsagePayloadToSnapshots(payloadJson: str): str =
    let planType = rustCsgRateLimitDashboardPlanTypeFromUsage(wire.RustCsgJsonFindStr(payloadJson, "plan_type"))
    let planTypeJson = wire.RustCsgJsonQuote(planType)
    var out = "["
    out = wire.RustCsgCat(out, rustCsgRateLimitDashboardSnapshotFromUsageParts("codex",
                                                                                "",
                                                                                wire.RustCsgJsonFindOptionalObject(payloadJson, "rate_limit"),
                                                                                wire.RustCsgJsonFindOptionalObject(payloadJson, "credits"),
                                                                                planTypeJson))
    let additionalJson = rustCsgRateLimitDashboardTrim(rustCsgRateLimitDashboardTopValueRaw(payloadJson, "additional_rate_limits"))
    if additionalJson != "":
        var pos = rustCsgRateLimitDashboardSkipJsonSpace(additionalJson, 0)
        if pos < additionalJson.len && strings.SliceBytes(additionalJson, pos, 1) == "[":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(additionalJson, pos + 1)
            while pos < additionalJson.len && strings.SliceBytes(additionalJson, pos, 1) != "]":
                if strings.SliceBytes(additionalJson, pos, 1) != "{":
                    break
                let itemJson = rustCsgRateLimitDashboardRawJsonValueAt(additionalJson, pos)
                if itemJson == "":
                    break
                let itemEnd = rustCsgRateLimitDashboardJsonValueEndAt(additionalJson, pos)
                if itemEnd < 0:
                    break
                let limitId = wire.RustCsgJsonFindOptionalStr(itemJson, "metered_feature")
                let limitName = wire.RustCsgJsonFindOptionalStr(itemJson, "limit_name")
                if limitId != "":
                    out = wire.RustCsgCat(out, ",")
                    out = wire.RustCsgCat(out, rustCsgRateLimitDashboardSnapshotFromUsageParts(limitId,
                                                                                                limitName,
                                                                                                wire.RustCsgJsonFindOptionalObject(itemJson, "rate_limit"),
                                                                                                "",
                                                                                                planTypeJson))
                pos = rustCsgRateLimitDashboardSkipJsonSpace(additionalJson, itemEnd)
                if pos < additionalJson.len && strings.SliceBytes(additionalJson, pos, 1) == ",":
                    pos = rustCsgRateLimitDashboardSkipJsonSpace(additionalJson, pos + 1)
        out = wire.RustCsgCat(out, "]")
        return out
    out = wire.RustCsgCat(out, "]")
    return out

fn RustCsgRateLimitDashboardUsagePayloadToSnapshots(payloadJson: str): str =
    return rustCsgRateLimitDashboardUsagePayloadToSnapshots(payloadJson)

fn rustCsgRateLimitDashboardPrimarySnapshotFromSnapshots(snapshotsJson: str): str =
    var firstSnapshot: str
    var codexSnapshot: str
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, 0)
    if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "[":
        return ""
    pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
    while pos < snapshotsJson.len && rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "{":
            return ""
        let snapshotJson = rustCsgRateLimitDashboardRawJsonValueAt(snapshotsJson, pos)
        if snapshotJson == "":
            return ""
        if firstSnapshot == "":
            firstSnapshot = snapshotJson
        if wire.RustCsgJsonFindOptionalStr(snapshotJson, "limitId") == "codex":
            codexSnapshot = snapshotJson
        let snapshotEnd = rustCsgRateLimitDashboardJsonValueEndAt(snapshotsJson, pos)
        if snapshotEnd < 0:
            return ""
        pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, snapshotEnd)
        if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
    if codexSnapshot != "":
        return codexSnapshot
    return firstSnapshot

fn rustCsgRateLimitDashboardSnapshotsByLimitId(snapshotsJson: str): str =
    var out = "{"
    var count: int32
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, 0)
    if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "[":
        return ""
    pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
    while pos < snapshotsJson.len && rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) != "{":
            return ""
        let snapshotJson = rustCsgRateLimitDashboardRawJsonValueAt(snapshotsJson, pos)
        if snapshotJson == "":
            return ""
        var limitId = wire.RustCsgJsonFindOptionalStr(snapshotJson, "limitId")
        if limitId == "":
            limitId = "codex"
        if count > 0:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw(limitId, snapshotJson))
        count = count + 1
        let snapshotEnd = rustCsgRateLimitDashboardJsonValueEndAt(snapshotsJson, pos)
        if snapshotEnd < 0:
            return ""
        pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, snapshotEnd)
        if rustCsgRateLimitDashboardByteAt(snapshotsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(snapshotsJson, pos + 1)
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRateLimitDashboardAccountRateLimitsResponseFromUsagePayload(payloadJson: str,
                                                                      outJson: var str,
                                                                      outError: var str): bool =
    outJson = ""
    outError = ""
    if payloadJson == "":
        outError = "failed to fetch codex rate limits: empty payload"
        return false
    let snapshotsJson = rustCsgRateLimitDashboardUsagePayloadToSnapshots(payloadJson)
    let primaryJson = rustCsgRateLimitDashboardPrimarySnapshotFromSnapshots(snapshotsJson)
    if primaryJson == "":
        outError = "failed to fetch codex rate limits: no snapshots returned"
        return false
    let byLimitJson = rustCsgRateLimitDashboardSnapshotsByLimitId(snapshotsJson)
    if byLimitJson == "":
        outError = "failed to fetch codex rate limits: could not build limit map"
        return false
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", primaryJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimitsByLimitId", byLimitJson))
    out = wire.RustCsgCat(out, "}")
    outJson = out
    return true

fn RustCsgRateLimitDashboardFetchAccountRateLimitsResponseFromCodexHomeWithRefreshEndpoint(codexHome: str,
                                                                                           chatgptBaseUrl: str,
                                                                                           refreshTokenUrl: str,
                                                                                           nowSeconds: int64,
                                                                                           outJson: var str,
                                                                                           outError: var str,
                                                                                           outInvalidRequest: var bool): bool =
    outJson = ""
    outError = ""
    outInvalidRequest = false
    var authDot = auth_login.LoadAuth(codexHome)
    if !auth_login.AuthAvailable(authDot):
        outInvalidRequest = true
        outError = "codex account authentication required to read rate limits"
        return false
    if authDot.authMode == "ApiKey":
        outInvalidRequest = true
        outError = "chatgpt authentication required to read rate limits"
        return false
    if auth_oauth.ChatGptAuthNeedsProactiveRefresh(authDot, nowSeconds):
        var refreshedAuth: auth_login.AuthDotJson
        var refreshError: str
        if auth_oauth.RefreshChatGptTokenAtEndpointAtUnixSeconds(codexHome, refreshTokenUrl, nowSeconds, refreshedAuth, refreshError):
            authDot = refreshedAuth
    let codexAuth = auth_login.AuthDotJsonToCodexAuth(authDot)
    let token = auth_login.CodexAuthGetToken(codexAuth)
    if token == "":
        outError = "failed to construct backend client: chatgpt access token is empty"
        return false
    var baseUrl = chatgptBaseUrl
    if baseUrl == "":
        baseUrl = rustCsgRateLimitDashboardDefaultChatGptBaseUrl()
    var clientJson = backend_client.BackendClientNewWithAccountId(baseUrl, token, "codex-cli", codexAuth.accountId)
    var payload = backend_api.BackendGetRateLimits(clientJson)
    if rustCsgRateLimitDashboardStartsWith(payload, "BackendGetRateLimits status 401") && authDot.refreshToken != "":
        var retriedAuth: auth_login.AuthDotJson
        var retryError: str
        if auth_oauth.RefreshChatGptTokenAtEndpointAtUnixSeconds(codexHome, refreshTokenUrl, nowSeconds, retriedAuth, retryError):
            let retriedCodexAuth = auth_login.AuthDotJsonToCodexAuth(retriedAuth)
            let retriedToken = auth_login.CodexAuthGetToken(retriedCodexAuth)
            if retriedToken != "":
                clientJson = backend_client.BackendClientNewWithAccountId(baseUrl, retriedToken, "codex-cli", retriedCodexAuth.accountId)
                payload = backend_api.BackendGetRateLimits(clientJson)
    if payload == "":
        outError = "failed to fetch codex rate limits: empty backend response"
        return false
    if rustCsgRateLimitDashboardStartsWith(payload, "BackendGetRateLimits "):
        outError = wire.RustCsgCat("failed to fetch codex rate limits: ", payload)
        return false
    return RustCsgRateLimitDashboardAccountRateLimitsResponseFromUsagePayload(payload, outJson, outError)

fn RustCsgRateLimitDashboardFetchAccountRateLimitsResponseFromCodexHome(codexHome: str,
                                                                        chatgptBaseUrl: str,
                                                                        outJson: var str,
                                                                        outError: var str,
                                                                        outInvalidRequest: var bool): bool =
    return RustCsgRateLimitDashboardFetchAccountRateLimitsResponseFromCodexHomeWithRefreshEndpoint(codexHome,
                                                                                                  chatgptBaseUrl,
                                                                                                  "",
                                                                                                  int64(0),
                                                                                                  outJson,
                                                                                                  outError,
                                                                                                  outInvalidRequest)

fn rustCsgRateLimitDashboardFetchAccountRateLimits(codexHome: str,
                                                   chatgptBaseUrl: str,
                                                   refreshTokenUrl: str,
                                                   nowSeconds: int64,
                                                   email: str,
                                                   outRateLimitsJson: var str,
                                                   outError: var str): bool =
    outRateLimitsJson = ""
    outError = ""
    let authHome = RustCsgRateLimitDashboardAccountAuthHome(codexHome, email)
    var authDot = auth_login.LoadAuth(authHome)
    if !auth_login.AuthAvailable(authDot):
        outError = wire.RustCsgCat("cached auth is missing for ", email)
        return false
    let cachedEmail = rustCsgRateLimitDashboardAuthEmail(authDot)
    if cachedEmail != "" && rustCsgRateLimitDashboardAsciiLower(cachedEmail) != rustCsgRateLimitDashboardAsciiLower(email):
        outError = wire.RustCsgCat(wire.RustCsgCat("cached auth email mismatch for ", email), wire.RustCsgCat(": got ", cachedEmail))
        return false
    if auth_oauth.ChatGptAuthNeedsProactiveRefresh(authDot, nowSeconds):
        var refreshedAuth: auth_login.AuthDotJson
        var refreshError: str
        if auth_oauth.RefreshChatGptTokenAtEndpointAtUnixSeconds(authHome, refreshTokenUrl, nowSeconds, refreshedAuth, refreshError):
            authDot = refreshedAuth
            let refreshedEmail = rustCsgRateLimitDashboardAuthEmail(authDot)
            if refreshedEmail != "" && rustCsgRateLimitDashboardAsciiLower(refreshedEmail) != rustCsgRateLimitDashboardAsciiLower(email):
                outError = wire.RustCsgCat(wire.RustCsgCat("refreshed auth email mismatch for ", email), wire.RustCsgCat(": got ", refreshedEmail))
                return false
    let refreshedCodexAuth = auth_login.AuthDotJsonToCodexAuth(authDot)
    let token = auth_login.CodexAuthGetToken(refreshedCodexAuth)
    if token == "":
        outError = wire.RustCsgCat("cached auth token is empty for ", email)
        return false
    var accountId = refreshedCodexAuth.accountId
    if accountId == "":
        accountId = auth_oauth.IdTokenAccountId(authDot.rawIdToken)
    if accountId == "":
        outError = wire.RustCsgCat("cached auth account id is empty for ", email)
        return false
    var baseUrl = chatgptBaseUrl
    if baseUrl == "":
        baseUrl = rustCsgRateLimitDashboardDefaultChatGptBaseUrl()
    let clientJson = backend_client.BackendClientNewWithAccountId(baseUrl, token, "codex-cli", accountId)
    var payload = backend_api.BackendGetRateLimits(clientJson)
    if rustCsgRateLimitDashboardStartsWith(payload, "BackendGetRateLimits status 401") && authDot.refreshToken != "":
        var retriedAuth: auth_login.AuthDotJson
        var retryError: str
        if auth_oauth.RefreshChatGptTokenAtEndpointAtUnixSeconds(authHome, refreshTokenUrl, nowSeconds, retriedAuth, retryError):
            let retriedEmail = rustCsgRateLimitDashboardAuthEmail(retriedAuth)
            if retriedEmail != "" && rustCsgRateLimitDashboardAsciiLower(retriedEmail) != rustCsgRateLimitDashboardAsciiLower(email):
                outError = wire.RustCsgCat(wire.RustCsgCat("refreshed auth email mismatch for ", email), wire.RustCsgCat(": got ", retriedEmail))
                return false
            let retriedCodexAuth = auth_login.AuthDotJsonToCodexAuth(retriedAuth)
            let retriedToken = auth_login.CodexAuthGetToken(retriedCodexAuth)
            if retriedToken != "":
                var retriedAccountId = retriedCodexAuth.accountId
                if retriedAccountId == "":
                    retriedAccountId = auth_oauth.IdTokenAccountId(retriedAuth.rawIdToken)
                if retriedAccountId == "":
                    outError = wire.RustCsgCat("refreshed auth account id is empty for ", email)
                    return false
                let retriedClientJson = backend_client.BackendClientNewWithAccountId(baseUrl, retriedToken, "codex-cli", retriedAccountId)
                payload = backend_api.BackendGetRateLimits(retriedClientJson)
    if payload == "":
        outError = wire.RustCsgCat("backend returned empty rate limit payload for ", email)
        return false
    if rustCsgRateLimitDashboardStartsWith(payload, "BackendGetRateLimits "):
        outError = payload
        return false
    if !wire.RustCsgContains(payload, "\"plan_type\""):
        outError = wire.RustCsgCat("backend rate limit payload is missing plan_type for ", email)
        return false
    outRateLimitsJson = rustCsgRateLimitDashboardUsagePayloadToSnapshots(payload)
    return true

fn rustCsgRateLimitDashboardAccountsWithStatus(accountsJson: str,
                                               targetEmail: str,
                                               status: str,
                                               errorJson: str,
                                               outAccounts: var str,
                                               outError: var str): bool =
    outAccounts = ""
    outError = ""
    var normalized = "["
    var count: int32
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, 0)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "[":
        outError = "rate limit dashboard accounts must be an array"
        return false
    pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == "]":
        outAccounts = "[]"
        return true
    while pos < accountsJson.len:
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            outError = "dashboard account entry must be a JSON object"
            return false
        var objectJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < accountsJson.len && !complete:
            let ch = rustCsgRateLimitDashboardByteAt(accountsJson, next)
            objectJson = wire.RustCsgCat(objectJson, strings.SliceBytes(accountsJson, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            outError = "unterminated dashboard account JSON object"
            return false
        let email = wire.RustCsgJsonFindOptionalStr(objectJson, "email")
        var nextRecord = objectJson
        if targetEmail == "" || email == targetEmail:
            nextRecord = rustCsgRateLimitDashboardRecordWithStatus(objectJson, status, errorJson)
        if count > 0:
            normalized = wire.RustCsgCat(normalized, ",")
        normalized = wire.RustCsgCat(normalized, nextRecord)
        count = count + 1
        pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, next)
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
            continue
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == "]":
            outAccounts = wire.RustCsgCat(normalized, "]")
            return true
        outError = "rate limit dashboard accounts array has invalid separator"
        return false
    outError = "unterminated rate limit dashboard accounts array"
    return false

fn rustCsgRateLimitDashboardBuildResponse(accountsJson: str,
                                          lastUpdatedAtJson: str,
                                          source: str): str =
    var response: types.RustCsgRateLimitDashboardResponse
    response.accountsJson = accountsJson
    response.lastUpdatedAtJson = lastUpdatedAtJson
    response.source = source
    return ratelimit_wire.RustCsgRateLimitDashboardResponseToJson(response)

fn rustCsgRateLimitDashboardBuildCache(accountsJson: str, lastUpdatedAtJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("accounts", accountsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("lastUpdatedAt", lastUpdatedAtJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgRateLimitDashboardCacheFromJson(cacheJson: str, outAccounts: var str, outLastUpdatedAt: var str, outError: var str): bool =
    outAccounts = ""
    outLastUpdatedAt = ""
    outError = ""
    if cacheJson == "":
        outError = "rate limit dashboard cache is empty"
        return false
    if !wire.RustCsgContains(cacheJson, "\"accounts\""):
        outError = "rate limit dashboard cache must contain accounts"
        return false
    let rawAccounts = wire.RustCsgJsonFindArray(cacheJson, "accounts")
    if !rustCsgRateLimitDashboardNormalizeCacheAccounts(rawAccounts, outAccounts, outError):
        return false
    outLastUpdatedAt = wire.RustCsgJsonFindOptionalValueRaw(cacheJson, "lastUpdatedAt")
    if outLastUpdatedAt == "":
        outLastUpdatedAt = "null"
    if !rustCsgRateLimitDashboardRawIsJsonIntOrNull(outLastUpdatedAt):
        outError = "rate limit dashboard cache has invalid lastUpdatedAt"
        return false
    return true

fn RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent: str,
                                                    envPath: str,
                                                    cacheJson: str,
                                                    outJson: var str,
                                                    outError: var str): bool =
    outJson = ""
    outError = ""
    var configuredAccounts: str
    if !rustCsgRateLimitDashboardConfiguredAccountsFromEnv(envContent, envPath, configuredAccounts, outError):
        return false
    if !rustCsgRateLimitDashboardValidatePassword(envContent, envPath, outError):
        return false
    var cachedAccounts: str
    var lastUpdatedAtJson: str
    var source = "cache"
    if cacheJson == "":
        cachedAccounts = "[]"
        lastUpdatedAtJson = "null"
        source = "fresh"
    elif !rustCsgRateLimitDashboardCacheFromJson(cacheJson, cachedAccounts, lastUpdatedAtJson, outError):
        cachedAccounts = "[]"
        lastUpdatedAtJson = "null"
        source = "fresh"
        outError = ""
    var accountsOut = "["
    var seenAccounts = "|"
    var accountCount: int32
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, 0)
    if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "[":
        outError = "dashboard status accounts must be an array"
        return false
    pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, pos + 1)
    while pos < configuredAccounts.len && rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "{":
            outError = "dashboard status account entry must be a JSON object"
            return false
        var accountJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < configuredAccounts.len && !complete:
            let ch = rustCsgRateLimitDashboardByteAt(configuredAccounts, next)
            accountJson = wire.RustCsgCat(accountJson, strings.SliceBytes(configuredAccounts, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            outError = "unterminated dashboard status account JSON object"
            return false
        let email = wire.RustCsgJsonFindOptionalStr(accountJson, "email")
        if email == "":
            pos = next
            continue
        let seenMarker = wire.RustCsgCat(wire.RustCsgCat(wire.RustCsgCat("|", strings.IntToStr(strings.Len(email))), ":"), wire.RustCsgCat(email, "|"))
        if wire.RustCsgContains(seenAccounts, seenMarker):
            pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, next)
            if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) == ",":
                pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, pos + 1)
            continue
        seenAccounts = wire.RustCsgCat(seenAccounts, strings.SliceBytes(seenMarker, 1, strings.Len(seenMarker) - 1))
        if accountCount > 0:
            accountsOut = wire.RustCsgCat(accountsOut, ",")
        let cachedRecord = rustCsgRateLimitDashboardFindRecordByEmail(cachedAccounts, email)
        if cachedRecord == "":
            accountsOut = wire.RustCsgCat(accountsOut, rustCsgRateLimitDashboardIdleRecord(email))
        else:
            accountsOut = wire.RustCsgCat(accountsOut, cachedRecord)
        accountCount = accountCount + 1
        pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, next)
        if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, pos + 1)
    if accountCount == 0:
        outError = wire.RustCsgCat("ACCOUNTS in ", wire.RustCsgCat(envPath, " is empty"))
        return false
    accountsOut = wire.RustCsgCat(accountsOut, "]")

    outJson = rustCsgRateLimitDashboardBuildResponse(accountsOut, lastUpdatedAtJson, source)
    return true

fn RustCsgRateLimitDashboardConfiguredAccountExists(envContent: str,
                                                    envPath: str,
                                                    targetEmail: str,
                                                    outFound: var bool,
                                                    outError: var str): bool =
    outFound = false
    outError = ""
    var configuredAccounts: str
    if !rustCsgRateLimitDashboardConfiguredAccountsFromEnv(envContent, envPath, configuredAccounts, outError):
        return false
    if !rustCsgRateLimitDashboardValidatePassword(envContent, envPath, outError):
        return false
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, 0)
    if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "[":
        outError = "dashboard status accounts must be an array"
        return false
    pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, pos + 1)
    while pos < configuredAccounts.len && rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) != "{":
            outError = "dashboard status account entry must be a JSON object"
            return false
        var accountJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < configuredAccounts.len && !complete:
            let ch = rustCsgRateLimitDashboardByteAt(configuredAccounts, next)
            accountJson = wire.RustCsgCat(accountJson, strings.SliceBytes(configuredAccounts, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == "\\":
                    escaped = true
                elif ch == "\"":
                    inString = false
            elif ch == "\"":
                inString = true
            elif ch == "{":
                depth = depth + 1
            elif ch == "}":
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            outError = "unterminated dashboard status account JSON object"
            return false
        if wire.RustCsgJsonFindOptionalStr(accountJson, "email") == targetEmail:
            outFound = true
            return true
        pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, next)
        if rustCsgRateLimitDashboardByteAt(configuredAccounts, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(configuredAccounts, pos + 1)
    outError = wire.RustCsgCat(wire.RustCsgCat("account `", targetEmail), "` is not configured in .env")
    return true

fn RustCsgRateLimitDashboardLoadingSnapshotFromEnvAndCache(envContent: str,
                                                           envPath: str,
                                                           cacheJson: str,
                                                           targetEmail: str,
                                                           outJson: var str,
                                                           outError: var str): bool =
    outJson = ""
    outError = ""
    if targetEmail != "":
        var found: bool
        if !RustCsgRateLimitDashboardConfiguredAccountExists(envContent, envPath, targetEmail, found, outError):
            return false
        if !found:
            return false
    var snapshotJson: str
    if !RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent, envPath, cacheJson, snapshotJson, outError):
        return false
    let accountsJson = wire.RustCsgJsonFindArray(snapshotJson, "accounts")
    let lastUpdatedAtJson = wire.RustCsgJsonFindOptionalValueRaw(snapshotJson, "lastUpdatedAt")
    let source = wire.RustCsgJsonFindOptionalStr(snapshotJson, "source")
    var loadingAccounts: str
    if !rustCsgRateLimitDashboardAccountsWithStatus(accountsJson, targetEmail, "loading", "null", loadingAccounts, outError):
        return false
    outJson = rustCsgRateLimitDashboardBuildResponse(loadingAccounts, lastUpdatedAtJson, source)
    return true

fn RustCsgRateLimitDashboardRefreshFailureFromEnvAndCache(envContent: str,
                                                          envPath: str,
                                                          cacheJson: str,
                                                          nowSeconds: int64,
                                                          targetEmail: str,
                                                          fetchError: str,
                                                          outJson: var str,
                                                          outCacheJson: var str,
                                                          outError: var str): bool =
    outJson = ""
    outCacheJson = ""
    outError = ""
    if targetEmail != "":
        var found: bool
        if !RustCsgRateLimitDashboardConfiguredAccountExists(envContent, envPath, targetEmail, found, outError):
            return false
        if !found:
            return false
    var snapshotJson: str
    if !RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent, envPath, cacheJson, snapshotJson, outError):
        return false
    let accountsJson = wire.RustCsgJsonFindArray(snapshotJson, "accounts")
    var failedAccounts: str
    if !rustCsgRateLimitDashboardAccountsWithStatus(accountsJson, targetEmail, "failed", wire.RustCsgJsonQuote(fetchError), failedAccounts, outError):
        return false
    let nowJson = strings.Int64ToStr(nowSeconds)
    outJson = rustCsgRateLimitDashboardBuildResponse(failedAccounts, nowJson, "fresh")
    outCacheJson = rustCsgRateLimitDashboardBuildCache(failedAccounts, nowJson)
    return true

fn RustCsgRateLimitDashboardRefreshWithCachedAuthAndRefreshEndpointFromEnvAndCache(envContent: str,
                                                                                   envPath: str,
                                                                                   cacheJson: str,
                                                                                   codexHome: str,
                                                                                   chatgptBaseUrl: str,
                                                                                   refreshTokenUrl: str,
                                                                                   nowSeconds: int64,
                                                                                   targetEmail: str,
                                                                                   outJson: var str,
                                                                                   outCacheJson: var str,
                                                                                   outError: var str): bool =
    outJson = ""
    outCacheJson = ""
    outError = ""
    if targetEmail != "":
        var found: bool
        if !RustCsgRateLimitDashboardConfiguredAccountExists(envContent, envPath, targetEmail, found, outError):
            return false
        if !found:
            return false
    var snapshotJson: str
    if !RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent, envPath, cacheJson, snapshotJson, outError):
        return false
    let accountsJson = wire.RustCsgJsonFindArray(snapshotJson, "accounts")
    var refreshedAccounts = "["
    var count: int32
    var pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, 0)
    if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "[":
        outError = "rate limit dashboard accounts must be an array"
        return false
    pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    while pos < accountsJson.len && rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "]":
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) != "{":
            outError = "dashboard account entry must be a JSON object"
            return false
        let recordJson = rustCsgRateLimitDashboardRawJsonValueAt(accountsJson, pos)
        if recordJson == "":
            outError = "unterminated dashboard account JSON object"
            return false
        let recordEnd = rustCsgRateLimitDashboardJsonValueEndAt(accountsJson, pos)
        if recordEnd < 0:
            outError = "unterminated dashboard account JSON object"
            return false
        let email = wire.RustCsgJsonFindOptionalStr(recordJson, "email")
        var nextRecord = recordJson
        if targetEmail == "" || email == targetEmail:
            var rateLimitsJson: str
            var fetchError: str
            let fetchedAtJson = strings.Int64ToStr(nowSeconds)
            if rustCsgRateLimitDashboardFetchAccountRateLimits(codexHome,
                                                               chatgptBaseUrl,
                                                               refreshTokenUrl,
                                                               nowSeconds,
                                                               email,
                                                               rateLimitsJson,
                                                               fetchError):
                nextRecord = rustCsgRateLimitDashboardRecordWithSuccess(recordJson, rateLimitsJson, fetchedAtJson)
            else:
                nextRecord = rustCsgRateLimitDashboardRecordWithStatus(recordJson, "failed", wire.RustCsgJsonQuote(fetchError))
        if count > 0:
            refreshedAccounts = wire.RustCsgCat(refreshedAccounts, ",")
        refreshedAccounts = wire.RustCsgCat(refreshedAccounts, nextRecord)
        count = count + 1
        pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, recordEnd)
        if rustCsgRateLimitDashboardByteAt(accountsJson, pos) == ",":
            pos = rustCsgRateLimitDashboardSkipJsonSpace(accountsJson, pos + 1)
    refreshedAccounts = wire.RustCsgCat(refreshedAccounts, "]")
    let nowJson = strings.Int64ToStr(nowSeconds)
    outJson = rustCsgRateLimitDashboardBuildResponse(refreshedAccounts, nowJson, "fresh")
    outCacheJson = rustCsgRateLimitDashboardBuildCache(refreshedAccounts, nowJson)
    return true

fn RustCsgRateLimitDashboardRefreshWithCachedAuthFromEnvAndCache(envContent: str,
                                                                 envPath: str,
                                                                 cacheJson: str,
                                                                 codexHome: str,
                                                                 chatgptBaseUrl: str,
                                                                 nowSeconds: int64,
                                                                 targetEmail: str,
                                                                 outJson: var str,
                                                                 outCacheJson: var str,
                                                                 outError: var str): bool =
    return RustCsgRateLimitDashboardRefreshWithCachedAuthAndRefreshEndpointFromEnvAndCache(envContent,
                                                                                          envPath,
                                                                                          cacheJson,
                                                                                          codexHome,
                                                                                          chatgptBaseUrl,
                                                                                          "",
                                                                                          nowSeconds,
                                                                                          targetEmail,
                                                                                          outJson,
                                                                                          outCacheJson,
                                                                                          outError)
