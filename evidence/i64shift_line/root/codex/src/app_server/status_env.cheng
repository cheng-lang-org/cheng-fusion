import std/strings
import cheng/codex/protocol/wire

const RustCsgAppServerStatusEnvRequiredJsonVar: str = "ACCOUNT_STATUS_JSON"
const RustCsgAppServerStatusEnvRateLimitsJsonVar: str = "ACCOUNT_RATE_LIMITS_JSON"

fn rustCsgStatusEnvIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn rustCsgStatusEnvIsTokenDelimiter(ch: char): bool =
    return rustCsgStatusEnvIsSpace(ch) || ch == ',' || ch == ';'

fn rustCsgStatusEnvTrim(text: str): str =
    var start: int32
    var end: int32 = text.len
    while start < end && rustCsgStatusEnvIsSpace(text[start]):
        start = start + 1
    while end > start && rustCsgStatusEnvIsSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn rustCsgStatusEnvStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

fn rustCsgStatusEnvStripQuotes(value: str): str =
    if value.len >= 2:
        let first = value[0]
        let last = value[value.len - 1]
        if first == '"' && last == '"':
            return strings.SliceBytes(value, 1, value.len - 2)
        if int32(first) == 39 && int32(last) == 39:
            return strings.SliceBytes(value, 1, value.len - 2)
    return value

fn rustCsgStatusEnvLineWithoutTrailingCr(line: str): str =
    if line.len > 0 && line[line.len - 1] == '\r':
        return strings.SliceBytes(line, 0, line.len - 1)
    return line

fn rustCsgStatusEnvFindValue(content: str, key: str, outValue: var str): bool =
    outValue = ""
    var pos: int32
    while pos <= content.len:
        var lineEnd: int32 = pos
        while lineEnd < content.len && content[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        var line = strings.SliceBytes(content, pos, lineEnd - pos)
        line = rustCsgStatusEnvLineWithoutTrailingCr(line)
        pos = lineEnd + 1

        var trimmed = rustCsgStatusEnvTrim(line)
        if trimmed == "":
            continue
        if trimmed[0] == '#':
            continue
        if rustCsgStatusEnvStartsWith(trimmed, "export "):
            trimmed = rustCsgStatusEnvTrim(strings.SliceBytes(trimmed, 7, trimmed.len - 7))

        var equalsAt: int32 = -1
        var i: int32
        while i < trimmed.len:
            if trimmed[i] == '=':
                equalsAt = i
                break
            i = i + 1
        if equalsAt <= 0:
            continue
        let lineKey = rustCsgStatusEnvTrim(strings.SliceBytes(trimmed, 0, equalsAt))
        if lineKey != key:
            continue
        let rawValue = rustCsgStatusEnvTrim(strings.SliceBytes(trimmed, equalsAt + 1, trimmed.len - equalsAt - 1))
        outValue = rustCsgStatusEnvStripQuotes(rawValue)
        return true
    return false

fn rustCsgStatusEnvNextToken(text: str, start: int32, outToken: var str, outNext: var int32): bool =
    outToken = ""
    outNext = start
    var pos = start
    while pos < text.len && rustCsgStatusEnvIsTokenDelimiter(text[pos]):
        pos = pos + 1
    if pos >= text.len:
        outNext = pos
        return false
    var end = pos
    while end < text.len && !rustCsgStatusEnvIsTokenDelimiter(text[end]):
        end = end + 1
    outToken = strings.SliceBytes(text, pos, end - pos)
    outNext = end
    return true

fn rustCsgStatusEnvObjectRawAt(text: str, start: int32, outObject: var str, outNext: var int32, outError: var str): bool =
    outObject = ""
    outNext = start
    outError = ""
    if start >= text.len || text[start] != '{':
        outError = "status account entry must be a JSON object"
        return false
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                outObject = strings.SliceBytes(text, start, i - start + 1)
                outNext = i + 1
                return true
        i = i + 1
    outError = "unterminated status account JSON object"
    return false

fn rustCsgStatusEnvSkipJsonSpace(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len && rustCsgStatusEnvIsSpace(text[i]):
        i = i + 1
    return i

fn rustCsgStatusEnvRawPresent(raw: str): bool =
    return raw != "" && raw != "null"

fn rustCsgStatusEnvAccountQuotaRemainingRaw(accountJson: str): str =
    let topRemaining = wire.RustCsgJsonFindOptionalValueRaw(accountJson, "quotaRemainingPercent")
    if rustCsgStatusEnvRawPresent(topRemaining):
        return topRemaining
    let quotaJson = wire.RustCsgJsonFindOptionalObject(accountJson, "quota")
    if quotaJson == "":
        return ""
    let remaining = wire.RustCsgJsonFindOptionalValueRaw(quotaJson, "remainingPercent")
    if rustCsgStatusEnvRawPresent(remaining):
        return remaining
    return ""

fn rustCsgStatusEnvAccountQuotaResetRaw(accountJson: str): str =
    var reset = wire.RustCsgJsonFindOptionalValueRaw(accountJson, "quotaResetAt")
    if rustCsgStatusEnvRawPresent(reset):
        return reset
    reset = wire.RustCsgJsonFindOptionalValueRaw(accountJson, "resetAt")
    if rustCsgStatusEnvRawPresent(reset):
        return reset
    reset = wire.RustCsgJsonFindOptionalValueRaw(accountJson, "resetsAt")
    if rustCsgStatusEnvRawPresent(reset):
        return reset
    let quotaJson = wire.RustCsgJsonFindOptionalObject(accountJson, "quota")
    if quotaJson == "":
        return ""
    reset = wire.RustCsgJsonFindOptionalValueRaw(quotaJson, "resetAt")
    if rustCsgStatusEnvRawPresent(reset):
        return reset
    reset = wire.RustCsgJsonFindOptionalValueRaw(quotaJson, "resetsAt")
    if rustCsgStatusEnvRawPresent(reset):
        return reset
    return ""

fn rustCsgStatusEnvBuildNormalizedAccountObject(accountJson: str, outAccount: var str, outError: var str): bool =
    outAccount = ""
    outError = ""
    let email = wire.RustCsgJsonFindOptionalStr(accountJson, "email")
    if email == "":
        outError = "ACCOUNT_STATUS_JSON account is missing email"
        return false
    let subscription = wire.RustCsgJsonFindOptionalStr(accountJson, "subscription")
    if subscription == "":
        outError = wire.RustCsgCat("ACCOUNT_STATUS_JSON account is missing subscription: ", email)
        return false
    let remaining = rustCsgStatusEnvAccountQuotaRemainingRaw(accountJson)
    if !rustCsgStatusEnvRawPresent(remaining):
        outError = wire.RustCsgCat("ACCOUNT_STATUS_JSON account is missing quota remaining data: ", email)
        return false
    let reset = rustCsgStatusEnvAccountQuotaResetRaw(accountJson)
    if !rustCsgStatusEnvRawPresent(reset):
        outError = wire.RustCsgCat("ACCOUNT_STATUS_JSON account is missing quota reset data: ", email)
        return false
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("email", email))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("subscription", subscription))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("quotaRemainingPercent", remaining))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("quotaResetAt", reset))
    let quotaJson = wire.RustCsgJsonFindOptionalObject(accountJson, "quota")
    if quotaJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("quota", quotaJson))
    out = wire.RustCsgCat(out, "}")
    outAccount = out
    return true

fn rustCsgStatusEnvNormalizeAccountsArray(accountsJson: str, outAccountsJson: var str, outCount: var int32, outError: var str): bool =
    outAccountsJson = ""
    outCount = 0
    outError = ""
    var normalized = "["
    var pos = rustCsgStatusEnvSkipJsonSpace(accountsJson, 0)
    if pos >= accountsJson.len || accountsJson[pos] != '[':
        outError = "ACCOUNT_STATUS_JSON accounts must be an array"
        return false
    pos = rustCsgStatusEnvSkipJsonSpace(accountsJson, pos + 1)
    if pos < accountsJson.len && accountsJson[pos] == ']':
        outError = "ACCOUNT_STATUS_JSON accounts must not be empty"
        return false
    while pos < accountsJson.len:
        if pos >= accountsJson.len || accountsJson[pos] != '{':
            outError = "status account entry must be a JSON object"
            return false
        var objectJson: str
        var depth: int32
        var inString: bool
        var escaped: bool
        var next = pos
        var complete: bool
        while next < accountsJson.len && !complete:
            let ch = accountsJson[next]
            objectJson = wire.RustCsgCat(objectJson, strings.SliceBytes(accountsJson, next, 1))
            if inString:
                if escaped:
                    escaped = false
                elif ch == '\\':
                    escaped = true
                elif ch == '"':
                    inString = false
            elif ch == '"':
                inString = true
            elif ch == '{':
                depth = depth + 1
            elif ch == '}':
                depth = depth - 1
                if depth == 0:
                    complete = true
            next = next + 1
        if !complete:
            outError = "unterminated status account JSON object"
            return false
        var accountOut: str
        if !rustCsgStatusEnvBuildNormalizedAccountObject(objectJson, accountOut, outError):
            return false
        if outCount > 0:
            normalized = wire.RustCsgCat(normalized, ",")
        normalized = wire.RustCsgCat(normalized, accountOut)
        outCount = outCount + 1
        pos = rustCsgStatusEnvSkipJsonSpace(accountsJson, next)
        if pos < accountsJson.len && accountsJson[pos] == ',':
            pos = rustCsgStatusEnvSkipJsonSpace(accountsJson, pos + 1)
            continue
        if pos < accountsJson.len && accountsJson[pos] == ']':
            outAccountsJson = wire.RustCsgCat(normalized, "]")
            return true
        outError = "ACCOUNT_STATUS_JSON accounts array has invalid separator"
        return false
    outError = "unterminated ACCOUNT_STATUS_JSON accounts array"
    return false

fn rustCsgStatusEnvBuildFromStatusJson(rawStatusJson: str, path: str, passwordConfigured: bool, outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    if rawStatusJson == "":
        outError = "ACCOUNT_STATUS_JSON is empty"
        return false
    if !wire.RustCsgContains(rawStatusJson, "\"accounts\""):
        outError = "ACCOUNT_STATUS_JSON must contain accounts"
        return false
    let accountsRaw = wire.RustCsgJsonFindArray(rawStatusJson, "accounts")
    var accountsJson: str
    var accountCount: int32
    if !rustCsgStatusEnvNormalizeAccountsArray(accountsRaw, accountsJson, accountCount, outError):
        return false
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", "dotenv"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("passwordConfigured", passwordConfigured))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("quotaDataAvailable", true))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("accountCount", accountCount))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("accounts", accountsJson))
    let updatedAt = wire.RustCsgJsonFindOptionalValueRaw(rawStatusJson, "updatedAt")
    if updatedAt != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("updatedAt", updatedAt))
    out = wire.RustCsgCat(out, "}")
    outJson = out
    return true

fn rustCsgStatusEnvBuildAccountInventory(accountsValue: str, path: str, passwordConfigured: bool, outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    var accountsJson = "["
    var count: int32
    var pos: int32
    while pos < accountsValue.len:
        while pos < accountsValue.len && rustCsgStatusEnvIsTokenDelimiter(accountsValue[pos]):
            pos = pos + 1
        if pos >= accountsValue.len:
            break
        var next = pos
        var token: str
        while next < accountsValue.len && !rustCsgStatusEnvIsTokenDelimiter(accountsValue[next]):
            token = wire.RustCsgCat(token, strings.SliceBytes(accountsValue, next, 1))
            next = next + 1
        if count > 0:
            accountsJson = wire.RustCsgCat(accountsJson, ",")
        accountsJson = wire.RustCsgCat(accountsJson, "{")
        accountsJson = wire.RustCsgCat(accountsJson, wire.RustCsgJsonFieldStr("email", token))
        accountsJson = wire.RustCsgCat(accountsJson, "}")
        count = count + 1
        pos = next
    accountsJson = wire.RustCsgCat(accountsJson, "]")
    if count == 0:
        outError = wire.RustCsgCat("ACCOUNTS in ", wire.RustCsgCat(path, " is empty"))
        return false
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", "dotenv"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("passwordConfigured", passwordConfigured))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("quotaDataAvailable", false))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("accountCount", count))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("accounts", accountsJson))
    out = wire.RustCsgCat(out, ",\"missingFields\":[")
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(RustCsgAppServerStatusEnvRequiredJsonVar))
    out = wire.RustCsgCat(out, "]}")
    outJson = out
    return true

fn RustCsgAppServerStatusFromDotEnv(content: str, path: str, outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    if content == "":
        outError = wire.RustCsgCat("ACCOUNTS is missing from ", path)
        return false
    var passwordValue: str
    let passwordConfigured = rustCsgStatusEnvFindValue(content, "PASSWORD", passwordValue) && passwordValue != ""
    var statusJson: str
    if rustCsgStatusEnvFindValue(content, RustCsgAppServerStatusEnvRequiredJsonVar, statusJson):
        return rustCsgStatusEnvBuildFromStatusJson(statusJson, path, passwordConfigured, outJson, outError)
    var accountsValue: str
    if !rustCsgStatusEnvFindValue(content, "ACCOUNTS", accountsValue):
        outError = wire.RustCsgCat("ACCOUNTS is missing from ", path)
        return false
    return rustCsgStatusEnvBuildAccountInventory(accountsValue, path, passwordConfigured, outJson, outError)

fn RustCsgAppServerSubscriptionQuotaFromDotEnv(content: str, path: str, outJson: var str, outError: var str): bool =
    return RustCsgAppServerStatusFromDotEnv(content, path, outJson, outError)

fn RustCsgAppServerRateLimitsFromDotEnv(content: str, outJson: var str, outError: var str): bool =
    outJson = ""
    outError = ""
    if content == "":
        outError = "status env file is empty or unreadable"
        return false
    var rateLimitsJson: str
    if !rustCsgStatusEnvFindValue(content, RustCsgAppServerStatusEnvRateLimitsJsonVar, rateLimitsJson):
        outError = "account/rateLimits/read requires ACCOUNT_RATE_LIMITS_JSON in status env"
        return false
    if rateLimitsJson == "":
        outError = "ACCOUNT_RATE_LIMITS_JSON is empty"
        return false
    if !wire.RustCsgContains(rateLimitsJson, "\"rateLimits\""):
        outError = "ACCOUNT_RATE_LIMITS_JSON must contain rateLimits"
        return false
    let primary = wire.RustCsgJsonFindObject(rateLimitsJson, "rateLimits")
    let byLimit = wire.RustCsgJsonFindOptionalValueRaw(rateLimitsJson, "rateLimitsByLimitId")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimits", primary))
    out = wire.RustCsgCat(out, ",")
    if byLimit == "":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimitsByLimitId", "null"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("rateLimitsByLimitId", byLimit))
    out = wire.RustCsgCat(out, "}")
    outJson = out
    return true
