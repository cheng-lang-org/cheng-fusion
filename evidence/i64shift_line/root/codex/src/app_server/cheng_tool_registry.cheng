import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire

type ChengToolCapability =
    name: str
    description: str
    inputSchema: str
    readOnly: bool
    writesArtifacts: bool
    recordsEvidence: bool
    requiresTempOut: bool
    allowedForModelRole: str

fn ChengToolRegistryObjectSchema(requiredRaw: str, propertiesRaw: str): str =
    var out = "{\"type\":\"object\",\"properties\":"
    out = wire.RustCsgCat(out, propertiesRaw)
    out = wire.RustCsgCat(out, ",\"required\":")
    out = wire.RustCsgCat(out, requiredRaw)
    out = wire.RustCsgCat(out, ",\"additionalProperties\":false}")
    return out

fn ChengToolRegistryCapability(name: str,
                               description: str,
                               inputSchema: str,
                               readOnly: bool,
                               writesArtifacts: bool,
                               recordsEvidence: bool,
                               requiresTempOut: bool,
                               allowedForModelRole: str): ChengToolCapability =
    return ChengToolCapability(name: name,
                              description: description,
                              inputSchema: inputSchema,
                              readOnly: readOnly,
                              writesArtifacts: writesArtifacts,
                              recordsEvidence: recordsEvidence,
                              requiresTempOut: requiresTempOut,
                              allowedForModelRole: allowedForModelRole)

fn ChengToolRegistryCapabilityToJson(cap: ChengToolCapability): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("name", cap.name))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("description", cap.description))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("inputSchema", cap.inputSchema))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("readOnly", cap.readOnly))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("writesArtifacts", cap.writesArtifacts))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("recordsEvidence", cap.recordsEvidence))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("requiresTempOut", cap.requiresTempOut))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("allowedForModelRole", cap.allowedForModelRole))
    out = wire.RustCsgCat(out, "}")
    return out

fn ChengToolRegistryAppend(out: var str, first: var bool, cap: ChengToolCapability) =
    if !first:
        out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, ChengToolRegistryCapabilityToJson(cap))
    first = false

fn ChengToolRegistryRoleAllows(role: str, cap: ChengToolCapability): bool =
    if role == "" || role == "control":
        return true
    if role == "readonly":
        return cap.readOnly
    return cap.allowedForModelRole == role

fn ChengToolRegistryToolAllowedForRole(tool: str, role: str): bool =
    if !ChengToolRegistryIsTool(tool):
        return false
    if role == "" || role == "control":
        return true
    if role == "readonly":
        return ChengToolRegistryIsReadOnly(tool)
    return false

fn ChengToolRegistryCoreSpecsJson(role: str): str =
    let pathProp = "\"path\":{\"type\":\"string\"}"
    let rootProp = "\"root\":{\"type\":\"string\"}"
    let inProp = "\"in\":{\"type\":\"string\"}"
    let outProp = "\"out\":{\"type\":\"string\"}"
    let targetProp = "\"target\":{\"type\":\"string\"}"
    let reportProp = "\"reportOut\":{\"type\":\"string\"}"
    let rawTextProp = "\"rawText\":{\"type\":\"string\"}"
    let rawPathProp = "\"rawPath\":{\"type\":\"string\"}"
    let sourcePathProp = "\"sourcePath\":{\"type\":\"string\"}"
    let lineProp = "\"line\":{\"type\":\"integer\"}"
    let symbolProp = "\"symbol\":{\"type\":\"string\"}"
    let profileHzProp = "\"profileHz\":{\"type\":\"string\"}"
    let projectProp = "\"project\":{\"type\":\"string\"}"
    let emitProp = "\"emit\":{\"type\":\"string\"}"
    let runtimeProp = "\"runtime\":{\"type\":\"string\"}"
    let entryRootProp = "\"entryRoot\":{\"type\":\"string\"}"
    var out = "["
    var first = true
    let lsp = ChengToolRegistryCapability("cheng_lsp_snapshot",
                                          "Collect diagnostics from the real Cheng LSP command over stdio JSON-RPC.",
                                          ChengToolRegistryObjectSchema("[\"path\"]",
                                                                       wire.RustCsgCat3("{", strutil.Join([pathProp, "\"text\":{\"type\":\"string\"}"], ","), "}")),
                                          true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, lsp): ChengToolRegistryAppend(out, first, lsp)
    let action = ChengToolRegistryCapability("cheng_lsp_code_action_preview",
                                             "Preview real Cheng LSP code actions at a source range.",
                                             ChengToolRegistryObjectSchema("[\"path\"]",
                                                                          "{\"path\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"line\":{\"type\":\"integer\"},\"character\":{\"type\":\"integer\"},\"range\":{\"type\":\"object\"}}"),
                                             true, false, false, false, "readonly")
    if ChengToolRegistryRoleAllows(role, action): ChengToolRegistryAppend(out, first, action)
    let debugReport = ChengToolRegistryCapability("cheng_debug_report",
                                                  "Run the real Cheng builtin debug-report command and record cheng.debugger evidence.",
                                                  ChengToolRegistryObjectSchema("[\"in\"]",
                                                                               wire.RustCsgCat3("{", strutil.Join([rootProp, inProp, targetProp, reportProp, sourcePathProp, lineProp, symbolProp], ","), "}")),
                                                  true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, debugReport): ChengToolRegistryAppend(out, first, debugReport)
    let lineMap = ChengToolRegistryCapability("cheng_print_line_map",
                                              "Run the real Cheng builtin print-line-map command for source/runtime address mapping.",
                                              ChengToolRegistryObjectSchema("[\"in\"]",
                                                                           wire.RustCsgCat3("{", strutil.Join([rootProp, inProp, targetProp, reportProp, sourcePathProp, lineProp, symbolProp], ","), "}")),
                                              true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, lineMap): ChengToolRegistryAppend(out, first, lineMap)
    let symbols = ChengToolRegistryCapability("cheng_print_symbols",
                                              "Run the real Cheng builtin print-symbols command for source/runtime symbol mapping.",
                                              ChengToolRegistryObjectSchema("[\"in\"]",
                                                                           wire.RustCsgCat3("{", strutil.Join([rootProp, inProp, targetProp, reportProp, sourcePathProp, lineProp, symbolProp], ","), "}")),
                                              true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, symbols): ChengToolRegistryAppend(out, first, symbols)
    let crash = ChengToolRegistryCapability("cheng_crash_report",
                                            "Convert cheng_crash_raw_v1 input with the real Cheng debug report parser.",
                                            ChengToolRegistryObjectSchema("[]",
                                                                         wire.RustCsgCat3("{", strutil.Join([rootProp, rawTextProp, rawPathProp, reportProp, sourcePathProp, lineProp, symbolProp], ","), "}")),
                                            true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, crash): ChengToolRegistryAppend(out, first, crash)
    let profile = ChengToolRegistryCapability("cheng_profile_report",
                                              "Convert cheng_profile_raw input with the real Cheng profile report parser.",
                                              ChengToolRegistryObjectSchema("[]",
                                                                           wire.RustCsgCat3("{", strutil.Join([rootProp, rawTextProp, rawPathProp, reportProp, sourcePathProp, lineProp, symbolProp], ","), "}")),
                                              true, true, true, true, "readonly")
    if ChengToolRegistryRoleAllows(role, profile): ChengToolRegistryAppend(out, first, profile)
    let profileRun = ChengToolRegistryCapability("cheng_profile_run",
                                                 "Run the real Cheng builtin profile-run command and record raw/final profile report artifacts.",
                                                 ChengToolRegistryObjectSchema("[\"in\"]",
                                                                              wire.RustCsgCat3("{", strutil.Join([rootProp, inProp, outProp, targetProp, reportProp, profileHzProp, sourcePathProp, symbolProp], ","), "}")),
                                                 false, true, true, true, "control")
    if ChengToolRegistryRoleAllows(role, profileRun): ChengToolRegistryAppend(out, first, profileRun)
    let tsEmit = ChengToolRegistryCapability("ts_csg_emit",
                                             "Emit real TS-CSG facts/reports for a checked TypeScript project; unsupported semantics remain report evidence.",
                                             ChengToolRegistryObjectSchema("[\"project\"]",
                                                                          wire.RustCsgCat3("{", strutil.Join([rootProp, projectProp, emitProp, outProp, reportProp, runtimeProp, entryRootProp], ","), "}")),
                                             true, true, true, true, "control")
    if ChengToolRegistryRoleAllows(role, tsEmit): ChengToolRegistryAppend(out, first, tsEmit)
    let tsClosure = ChengToolRegistryCapability("ts_csg_runtime_closure",
                                                "Emit the real TS-CSG runtime closure provider queue for a checked TypeScript project.",
                                                ChengToolRegistryObjectSchema("[\"project\"]",
                                                                             wire.RustCsgCat3("{", strutil.Join([rootProp, projectProp, outProp, runtimeProp, entryRootProp], ","), "}")),
                                                true, true, true, true, "control")
    if ChengToolRegistryRoleAllows(role, tsClosure): ChengToolRegistryAppend(out, first, tsClosure)
    let compileRun = ChengToolRegistryCapability("cheng_native_compile_run",
                                                 "Compile and run generated Cheng source with backend_driver/cheng system-link-exec.",
                                                 ChengToolRegistryObjectSchema("[\"in\"]",
                                                                              wire.RustCsgCat3("{", strutil.Join([rootProp, inProp, outProp, targetProp, reportProp], ","), "}")),
                                                 false, true, true, true, "control")
    if ChengToolRegistryRoleAllows(role, compileRun): ChengToolRegistryAppend(out, first, compileRun)
    out = wire.RustCsgCat(out, "]")
    return out

fn ChengToolRegistryDataLoopSpecsJson(role: str): str =
    var out = "["
    var first = true
    let traceRecord = ChengToolRegistryCapability("cheng_training_trace_record",
                                                  "Persist a production Cheng agent training trace as content-addressed CHENG_AGENT_TRACE shard plus manifest; JSONL is optional debug export only.",
                                                  ChengToolRegistryObjectSchema("[\"outDir\",\"traceId\",\"instruction\",\"outcome\",\"validationStatus\"]",
                                                                               "{\"outDir\":{\"type\":\"string\"},\"traceId\":{\"type\":\"string\"},\"instruction\":{\"type\":\"string\"},\"outcome\":{\"type\":\"string\"},\"validationStatus\":{\"type\":\"string\"},\"compression\":{\"type\":\"string\"},\"debugJsonl\":{\"type\":\"boolean\"}}"),
                                                  false, true, false, false, "control")
    if ChengToolRegistryRoleAllows(role, traceRecord): ChengToolRegistryAppend(out, first, traceRecord)
    let evalRecord = ChengToolRegistryCapability("cheng_eval_case_record",
                                                 "Persist a production Cheng eval case as content-addressed CHENG_AGENT_TRACE shard plus manifest.",
                                                 ChengToolRegistryObjectSchema("[\"outDir\",\"evalId\",\"traceId\",\"instruction\",\"expectedOutcome\"]",
                                                                              "{\"outDir\":{\"type\":\"string\"},\"evalId\":{\"type\":\"string\"},\"traceId\":{\"type\":\"string\"},\"instruction\":{\"type\":\"string\"},\"evidence\":{\"type\":\"string\"},\"replayCommand\":{\"type\":\"string\"},\"expectedOutcome\":{\"type\":\"string\"},\"validationCommand\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"toolchainSnapshot\":{\"type\":\"string\"},\"sourceRevision\":{\"type\":\"string\"},\"manifestRefs\":{\"type\":\"string\"},\"validationStatus\":{\"type\":\"string\"},\"validationResult\":{\"type\":\"string\"},\"replayFixtureRefs\":{\"type\":\"string\"},\"compression\":{\"type\":\"string\"},\"debugJsonl\":{\"type\":\"boolean\"}}"),
                                                 false, true, false, false, "control")
    if ChengToolRegistryRoleAllows(role, evalRecord): ChengToolRegistryAppend(out, first, evalRecord)
    let verify = ChengToolRegistryCapability("cheng_agent_trace_verify",
                                             "Verify a CHENG_AGENT_TRACE manifest and raw shard integrity.",
                                             ChengToolRegistryObjectSchema("[\"manifest\"]",
                                                                          "{\"manifest\":{\"type\":\"string\"}}"),
                                             true, false, false, false, "readonly")
    if ChengToolRegistryRoleAllows(role, verify): ChengToolRegistryAppend(out, first, verify)
    let exportJsonl = ChengToolRegistryCapability("cheng_agent_trace_export_jsonl",
                                                  "Export debug JSONL from a verified CHENG_AGENT_TRACE manifest/shard.",
                                                  ChengToolRegistryObjectSchema("[\"manifest\",\"out\"]",
                                                                               "{\"manifest\":{\"type\":\"string\"},\"out\":{\"type\":\"string\"}}"),
                                                  false, true, false, false, "control")
    if ChengToolRegistryRoleAllows(role, exportJsonl): ChengToolRegistryAppend(out, first, exportJsonl)
    out = wire.RustCsgCat(out, "]")
    return out

fn ChengToolRegistryIsTool(tool: str): bool =
    return tool == "cheng_lsp_snapshot" ||
           tool == "cheng_lsp_code_action_preview" ||
           tool == "cheng_debug_report" ||
           tool == "cheng_print_line_map" ||
           tool == "cheng_print_symbols" ||
           tool == "cheng_crash_report" ||
           tool == "cheng_profile_report" ||
           tool == "cheng_profile_run" ||
           tool == "ts_csg_emit" ||
           tool == "ts_csg_runtime_closure" ||
           tool == "cheng_native_compile_run" ||
           tool == "cheng_training_trace_record" ||
           tool == "cheng_eval_case_record" ||
           tool == "cheng_agent_trace_verify" ||
           tool == "cheng_agent_trace_export_jsonl"

fn ChengToolRegistryHandlerKind(tool: str): int32 =
    if tool == "cheng_lsp_snapshot":
        return 4
    if tool == "cheng_lsp_code_action_preview":
        return 5
    if tool == "cheng_debug_report":
        return 6
    if tool == "cheng_print_line_map":
        return 7
    if tool == "cheng_print_symbols":
        return 8
    if tool == "cheng_crash_report":
        return 9
    if tool == "cheng_profile_report":
        return 10
    if tool == "cheng_profile_run":
        return 11
    if tool == "ts_csg_emit":
        return 13
    if tool == "ts_csg_runtime_closure":
        return 14
    if tool == "cheng_native_compile_run":
        return 15
    if tool == "cheng_training_trace_record":
        return 16
    if tool == "cheng_eval_case_record":
        return 17
    if tool == "cheng_agent_trace_verify":
        return 18
    if tool == "cheng_agent_trace_export_jsonl":
        return 19
    return 0

fn ChengToolRegistryIsReadOnly(tool: str): bool =
    return tool == "cheng_lsp_snapshot" ||
           tool == "cheng_lsp_code_action_preview" ||
           tool == "cheng_debug_report" ||
           tool == "cheng_print_line_map" ||
           tool == "cheng_print_symbols" ||
           tool == "cheng_crash_report" ||
           tool == "cheng_profile_report" ||
           tool == "cheng_agent_trace_verify"

fn ChengToolRegistryWritesArtifacts(tool: str): bool =
    return tool == "cheng_lsp_snapshot" ||
           tool == "cheng_debug_report" ||
           tool == "cheng_print_line_map" ||
           tool == "cheng_print_symbols" ||
           tool == "cheng_crash_report" ||
           tool == "cheng_profile_report" ||
           tool == "cheng_profile_run" ||
           tool == "ts_csg_emit" ||
           tool == "ts_csg_runtime_closure" ||
           tool == "cheng_native_compile_run" ||
           tool == "cheng_training_trace_record" ||
           tool == "cheng_eval_case_record" ||
           tool == "cheng_agent_trace_export_jsonl"

fn ChengToolRegistryRecordsEvidence(tool: str): bool =
    return tool == "cheng_lsp_snapshot" ||
           tool == "cheng_debug_report" ||
           tool == "cheng_print_line_map" ||
           tool == "cheng_print_symbols" ||
           tool == "cheng_crash_report" ||
           tool == "cheng_profile_report" ||
           tool == "cheng_profile_run" ||
           tool == "ts_csg_emit" ||
           tool == "ts_csg_runtime_closure" ||
           tool == "cheng_native_compile_run"
