import cheng/codex/crates/cli/cli as cli

fn main(): int32 =
    var pass: int32

    # RustCsgCliFormatHelp: deterministic output
    var help = cli.RustCsgCliFormatHelp("")
    if help.len > 0: pass = pass + 1

    var helpCmd = cli.RustCsgCliFormatHelp("build")
    if helpCmd.len > 0: pass = pass + 1

    # cliColorizeOutput
    var colored = cli.cliColorizeOutput("hello", "red")
    if colored.len > 6: pass = pass + 1

    # RustCsgCliValidateArgs: missing program name
    var emptyArgs: str[]
    var validateErr = cli.RustCsgCliValidateArgs(emptyArgs, "")
    if validateErr == "missing program name": pass = pass + 1

    # RustCsgCliConfigToJson: default config
    var config = cli.RustCsgCliConfigDefault()
    var configJson = cli.RustCsgCliConfigToJson(config)
    if configJson.len > 0: pass = pass + 1

    var noAltArgs: str[]
    add(noAltArgs, "tool")
    add(noAltArgs, "--no-alt-screen")
    add(noAltArgs, "inline")
    var noAltConfig = cli.RustCsgParseCliArgs(noAltArgs)
    if noAltConfig.noAltScreen: pass = pass + 1
    var noAltJson = cli.RustCsgCliConfigToJson(noAltConfig)
    if noAltJson == "{\"resumeSessionId\":\"inline\",\"noAltScreen\":true}": pass = pass + 1

    if pass == 7:
        echo("rust_csg_oracle_cli ok")
        return 0
    echo("oracle FAIL")
    return 1

main()
