import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/approval_overlay_oracle as oracle

fn RustCsgTuiApprovalExprRender80(): str =
    return "\"render_overlay_lines(&view, 80)\""

fn RustCsgTuiApprovalExprNormalize120(): str =
    return "\"normalize_snapshot_paths(render_overlay_lines(&view, 120))\""

fn RustCsgTuiApprovalExprBufferDebug(): str =
    return "\"format!(\\\"{buf:?}\\\")\""

fn RustCsgTuiApprovalOracleCheck(path: str, fixture: str, name: str, expression: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/approval_overlay.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expression:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_approval_overlay_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiApprovalOracleCheck(
        cmdline.argStr(argIdx),
        oracle.RustCsgTuiApprovalAdditionalPermissionsPromptSnapshot(),
        "approval_overlay_additional_permissions_prompt",
        RustCsgTuiApprovalExprNormalize120(),
    )
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiApprovalOracleCheck(
        cmdline.argStr(argIdx),
        oracle.RustCsgTuiApprovalCrossThreadPromptSnapshot(),
        "approval_overlay_cross_thread_prompt",
        RustCsgTuiApprovalExprRender80(),
    )
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiApprovalOracleCheck(
        cmdline.argStr(argIdx),
        oracle.RustCsgTuiApprovalPermissionsPromptSnapshot(),
        "approval_overlay_permissions_prompt",
        RustCsgTuiApprovalExprNormalize120(),
    )
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiApprovalOracleCheck(
        cmdline.argStr(argIdx),
        oracle.RustCsgTuiApprovalNetworkExecPromptSnapshot(),
        "network_exec_prompt",
        RustCsgTuiApprovalExprBufferDebug(),
    )

    if exitCode == 0:
        echo("rust_csg_tui_approval_overlay_oracle_smoke ok")
    else:
        echo("rust_csg_tui_approval_overlay_oracle_smoke FAILED")
    return exitCode
