import cheng/codex/crates/tui_terminal/tui_terminal as tt

fn main(): int32 =
    var pass: int32

    if tt.RustCsgTuiTerminalWidth() == 80: pass = pass + 1
    if tt.RustCsgTuiTerminalHeight() == 24: pass = pass + 1

    if pass == 2:
        echo("rust_csg_oracle_tui_terminal ok")
        return 0
    echo("oracle FAIL")
    return 1

main()