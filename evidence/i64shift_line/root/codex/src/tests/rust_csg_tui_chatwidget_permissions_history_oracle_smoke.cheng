import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_permissions_history_oracle as oracle

fn RustCsgTuiChatwidgetPermissionsHistoryCheck(path: str,
                                                expectedSource: str,
                                                expectedExpression: str,
                                                expectedBody: str,
                                                name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 4:
        echo("FAIL usage: rust_csg_tui_chatwidget_permissions_history_oracle_smoke <3 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetPermissionsHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "\"lines_to_single_string(&cells[0])\"", oracle.RustCsgTuiChatwidgetPermissionsHistoryAfterModeSwitch(), "permissions_selection_history_after_mode_switch")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPermissionsHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "\"lines_to_single_string(&cells[0])\"", oracle.RustCsgTuiChatwidgetPermissionsHistoryFullAccessToDefault(), "permissions_selection_history_full_access_to_default")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPermissionsHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "\"lines_to_single_string(&cells[0])\"", oracle.RustCsgTuiChatwidgetPermissionsHistoryFullAccessToDefaultWindows(), "permissions_selection_history_full_access_to_default_windows")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_permissions_history_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_permissions_history_oracle_smoke FAILED")
    return exitCode
