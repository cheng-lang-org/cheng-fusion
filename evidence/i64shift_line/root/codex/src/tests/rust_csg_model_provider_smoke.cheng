fn testBuildTextMessage(): bool =
    var msg: str = chat.BuildUserMessage("Hello!")
    var hasRole: bool = strutil.Contains(msg, "\"role\":\"user\"")
    var hasContent: bool = strutil.Contains(msg, "\"content\":\"Hello!\"")
    if !hasRole:
        echo("testBuildTextMessage: missing role"); return false
    if !hasContent:
        echo("testBuildTextMessage: missing content"); return false
    echo("testBuildTextMessage ok")
    return true

fn testBuildToolMessage(): bool =
    var msg: str = chat.BuildToolMessage("Result", "call_123")
    if !strutil.Contains(msg, "\"tool_call_id\":\"call_123\""):
        echo("testBuildToolMessage: missing tool_call_id"); return false
    echo("testBuildToolMessage ok")
    return true

fn testBuildTool(): bool =
    let params: str = "{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"string\"}}}"
    var tool: str = chat.BuildTool("search", "Search", params)
    var hasFuncType: bool = strutil.Contains(tool, "\"type\":\"function\"")
    var hasName: bool = strutil.Contains(tool, "\"name\":\"search\"")
    if !hasFuncType:
        echo("testBuildTool: missing function type"); return false
    if !hasName:
        echo("testBuildTool: missing name"); return false
    echo("testBuildTool ok")
    return true

# ═════════════════════════════════════════════════════════════════════════
# Main
# ═════════════════════════════════════════════════════════════════════════

# ── Relfacts counting helpers ──────────────────────────────────────────────

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq: bool
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon: bool
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq: bool
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon: bool
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 11 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    echo("model_provider smoke start")
    var allOk: bool = true

    # Relfacts verification
    let source = "type\n    ModelProvider =\n        name: str\n        capabilities: int32\n        modelPattern: str\n\ntype\n    ModelProviderList =\n        provider0: ModelProvider\n        provider1: ModelProvider\n        provider2: ModelProvider\n        provider3: ModelProvider\n        provider4: ModelProvider\n        provider5: ModelProvider\n        provider6: ModelProvider\n        provider7: ModelProvider\n        provider8: ModelProvider\n        provider9: ModelProvider\n        provider10: ModelProvider\n        provider11: ModelProvider\n        provider12: ModelProvider\n        provider13: ModelProvider\n        provider14: ModelProvider\n        provider15: ModelProvider\n        count: int32\n\nfn modelProviderListInit(): ModelProviderList\nfn modelProviderListAdd(l: var ModelProviderList, p: ModelProvider)\nfn modelProviderGlobMatch(pattern: str, model: str): bool\nfn modelProviderPrefixMatch(prefix: str, model: str): bool\nfn modelProviderExtractFamily(model: str): str\nfn modelProviderScoreMatch(provider: var ModelProvider, model: str): int32\nfn modelProviderListSelect(l: var ModelProviderList, model: str): str\n"
    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tmodel_provider\nLocalType\tmodel_provider\tModelProvider\nHasField\tmodel_provider\tModelProvider\tname\tstr\nHasField\tmodel_provider\tModelProvider\tcapabilities\tint32\nHasField\tmodel_provider\tModelProvider\tmodelPattern\tstr\nLocalType\tmodel_provider\tModelProviderList\nHasField\tmodel_provider\tModelProviderList\tprovider0\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider1\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider2\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider3\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider4\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider5\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider6\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider7\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider8\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider9\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider10\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider11\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider12\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider13\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider14\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tprovider15\tModelProvider\nHasField\tmodel_provider\tModelProviderList\tcount\tint32\nDefFunction\tmodel_provider\tmodelProviderListInit\t\t->\tModelProviderList\nDefFunction\tmodel_provider\tmodelProviderListAdd\tl: var ModelProviderList, p: ModelProvider\t->\t\nDefFunction\tmodel_provider\tmodelProviderGlobMatch\tpattern: str, model: str\t->\tbool\nDefFunction\tmodel_provider\tmodelProviderPrefixMatch\tprefix: str, model: str\t->\tbool\nDefFunction\tmodel_provider\tmodelProviderExtractFamily\tmodel: str\t->\tstr\nDefFunction\tmodel_provider\tmodelProviderScoreMatch\tprovider: var ModelProvider, model: str\t->\tint32\nDefFunction\tmodel_provider\tmodelProviderListSelect\tl: var ModelProviderList, model: str\t->\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)
    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    if !checkEqI32(esf, 7, "source function count"): allOk = false
    if !checkEqI32(est, 2, "source type count"): allOk = false
    if !checkEqI32(esfd, 20, "source field count"): allOk = false
    if !checkEqI32(osf, 7, "oracle function count"): allOk = false
    if !checkEqI32(ost, 2, "oracle type count"): allOk = false
    if !checkEqI32(osfd, 20, "oracle field count"): allOk = false
    if !checkEqI32(esf, osf, "functions oracle vs source"): allOk = false
    if !checkEqI32(est, ost, "types oracle vs source"): allOk = false
    if !checkEqI32(esfd, osfd, "fields oracle vs source"): allOk = false
    if allOk:
        echo("testRelfacts ok")

    # Existing: pattern matching
    if !testGlobMatchExact(): allOk = false
    if !testGlobMatchWildcard(): allOk = false
    if !testGlobMatchEmpty(): allOk = false
    if !testExtractFamily(): allOk = false
    if !testSelectEmptyProviderList(): allOk = false
    if !testSelectExactMatch(): allOk = false
    if !testSelectBestScoreWins(): allOk = false
    if !testSelectSimple(): allOk = false
    if !testHasCapability(): allOk = false
    if !testScoreExactMatch(): allOk = false
    if !testScoreFallback(): allOk = false
    if !testScoreNoMatch(): allOk = false

    # New: chat request building
    if !testBuildChatRequestBody(): allOk = false
    if !testBuildChatRequestBodyWithOptions(): allOk = false
    if !testBuildChatRequestBodyWithTools(): allOk = false

    # New: chat response parsing
    if !testNewChatResponse(): allOk = false
    if !testParseChatResponseEmpty(): allOk = false

    # New: SSE streaming
    if !testParseSseDone(): allOk = false
    if !testParseSseNonDataLine(): allOk = false
    if !testParseSseEmptyLine(): allOk = false
    if !testParseSseStreamEmpty(): allOk = false

    # New: provider dispatch
    if !testCreateModelProvider(): allOk = false
    if !testCreateLocalProvider(): allOk = false
    if !testCreateGlmProvider(): allOk = false
    if !testDefaultBaseUrl(): allOk = false

    # New: message builders
    if !testBuildTextMessage(): allOk = false
    if !testBuildToolMessage(): allOk = false
    if !testBuildTool(): allOk = false

    if allOk:
        echo("rust_csg_model_provider_smoke ok")
        return 0
