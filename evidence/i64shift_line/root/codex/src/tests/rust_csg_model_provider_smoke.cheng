# ═══════════════════════════════════════════════════════════════════════════════
# model-provider — relfacts equivalence + functional smoke test
#
# Verifies that the model-provider module's defined functions, types, and fields
# match the oracle, then runs functional assertions.
# ═══════════════════════════════════════════════════════════════════════════════

import std/strutils as strutil
import cheng/codex/crates/model_provider/model_provider
import cheng/codex/model_provider/chat as chat
import cheng/codex/model_provider/streaming as stream
import cheng/codex/model_provider/provider as mp

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: model-provider — provider selection, capability matching,
# chat completion, SSE streaming, and provider dispatch
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    let _label0: str = label
    if got != expected:
        echo("checkEqStr FAIL")
        return false
    echo("checkEqStr ok")
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    let _label0: str = label
    if got != expected:
        echo("checkEqBool FAIL")
        return false
    echo("checkEqBool ok")
    return true

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    let _label0: str = label
    if got != expected:
        echo("checkEqI32 FAIL")
        return false
    echo("checkEqI32 ok")
    return true

# ═════════════════════════════════════════════════════════════════════════
# Pattern matching tests (existing)
# ═════════════════════════════════════════════════════════════════════════

fn testGlobMatchExact(): bool =
    var ok: bool = true
    if !checkEqBool(model_provider.modelProviderGlobMatch("gpt-4", "gpt-4"), true, "glob exact match"): ok = false
    if !checkEqBool(model_provider.modelProviderGlobMatch("gpt-4", "gpt-3.5"), false, "glob no match"): ok = false
    if ok:
        echo("testGlobMatchExact ok")
    return ok

fn testGlobMatchWildcard(): bool =
    var ok: bool = true
    if !checkEqBool(model_provider.modelProviderGlobMatch("gpt-*", "gpt-4"), true, "glob prefix match"): ok = false
    if !checkEqBool(model_provider.modelProviderGlobMatch("gpt-*", "gpt-3.5-turbo"), true, "glob prefix match 2"): ok = false
    if !checkEqBool(model_provider.modelProviderGlobMatch("gpt-*", "claude-3"), false, "glob prefix no match"): ok = false
    if ok:
        echo("testGlobMatchWildcard ok")
    return ok

fn testGlobMatchEmpty(): bool =
    var ok: bool = true
    if !checkEqBool(model_provider.modelProviderGlobMatch("", "anything"), true, "glob empty pattern"): ok = false
    if !checkEqBool(model_provider.modelProviderGlobMatch("*", "anything"), true, "glob star pattern"): ok = false
    if ok:
        echo("testGlobMatchEmpty ok")
    return ok

fn testExtractFamily(): bool =
    var ok: bool = true
    if !checkEqStr(model_provider.modelProviderExtractFamily("gpt-4"), "gpt", "family gpt-4"): ok = false
    if !checkEqStr(model_provider.modelProviderExtractFamily("claude-3-opus"), "claude", "family claude-3"): ok = false
    if !checkEqStr(model_provider.modelProviderExtractFamily("llama3"), "llama3", "family no separator"): ok = false
    if !checkEqStr(model_provider.modelProviderExtractFamily(""), "", "family empty"): ok = false
    if ok:
        echo("testExtractFamily ok")
    return ok

fn testSelectEmptyProviderList(): bool =
    var ok: bool = true
    var list = model_provider.modelProviderListInit()
    let selected = model_provider.modelProviderListSelect(list, "gpt-4")
    if !checkEqStr(selected, "", "select empty list returns empty"):
        ok = false
    if ok:
        echo("testSelectEmptyProviderList ok")
    return ok

fn testSelectExactMatch(): bool =
    var ok: bool = true
    var list = model_provider.modelProviderListInit()
    var p1 = model_provider.modelProviderNew("openai", 5, "gpt-*")
    var p2 = model_provider.modelProviderNew("anthropic", 1, "claude-*")
    model_provider.modelProviderListAdd(list, p1)
    model_provider.modelProviderListAdd(list, p2)

    let selected = model_provider.modelProviderListSelect(list, "claude-3-opus")
    if !checkEqStr(selected, "anthropic", "select exact match anthropic"):
        ok = false
    if ok:
        echo("testSelectExactMatch ok")
    return ok

fn testSelectBestScoreWins(): bool =
    var ok: bool = true
    var list = model_provider.modelProviderListInit()
    var p1 = model_provider.modelProviderNew("generic", 1, "*")
    var p2 = model_provider.modelProviderNew("openai", 1, "gpt-4")
    model_provider.modelProviderListAdd(list, p1)
    model_provider.modelProviderListAdd(list, p2)

    let selected = model_provider.modelProviderListSelect(list, "gpt-4")
    if !checkEqStr(selected, "openai", "select best score wins"):
        ok = false
    if ok:
        echo("testSelectBestScoreWins ok")
    return ok

fn testSelectSimple(): bool =
    var ok: bool = true
    let selected = model_provider.modelProviderSelectSimple(
        "openai", "anthropic", "ollama", "", 3, "claude-3-opus")
    if !checkEqStr(selected, "openai", "selectSimple fallback to first"):
        ok = false
    if ok:
        echo("testSelectSimple ok")
    return ok

fn testHasCapability(): bool =
    var ok: bool = true
    var p = model_provider.modelProviderNew("test", 1 + 16, "*")
    if !checkEqBool(model_provider.modelProviderSupportsVision(p), false, "no vision"): ok = false
    if !checkEqBool(model_provider.modelProviderSupportsStreaming(p), true, "has streaming"): ok = false
    if ok:
        echo("testHasCapability ok")
    return ok

fn testScoreExactMatch(): bool =
    var ok: bool = true
    var p = model_provider.modelProviderNew("test", 0, "gpt-4")
    let score = model_provider.modelProviderScoreMatch(p, "gpt-4")
    if !checkEqI32(score, 100, "score exact match"): ok = false
    if ok:
        echo("testScoreExactMatch ok")
    return ok

fn testScoreFallback(): bool =
    var ok: bool = true
    var p = model_provider.modelProviderNew("test", 0, "")
    let score = model_provider.modelProviderScoreMatch(p, "anything")
    if !checkEqI32(score, 10, "score fallback"): ok = false
    if ok:
        echo("testScoreFallback ok")
    return ok

fn testScoreNoMatch(): bool =
    var ok: bool = true
    var p = model_provider.modelProviderNew("test", 0, "claude-*")
    let score = model_provider.modelProviderScoreMatch(p, "gpt-4")
    if !checkEqI32(score, 0, "score no match"): ok = false
    if ok:
        echo("testScoreNoMatch ok")
    return ok

# ═════════════════════════════════════════════════════════════════════════
# Chat request body building (new)
# ═════════════════════════════════════════════════════════════════════════

fn testBuildChatRequestBody(): bool =
    let msg1: str = chat.BuildUserMessage("Hello!")
    let messages: str = chat.BuildMessagesArray(1, msg1, "", "", "", "", "", "", "")
    let body: str = chat.BuildChatRequestBody("gpt-4", messages, "", false, 0, "")

    # Check that common JSON field names exist in the body string
    if !strutil.Contains(body, "model"):
        echo("testBuildChatRequestBody: missing model"); return false
    if !strutil.Contains(body, "messages"):
        echo("testBuildChatRequestBody: missing messages"); return false
    if !strutil.Contains(body, "stream"):
        echo("testBuildChatRequestBody: missing stream"); return false
    echo("testBuildChatRequestBody ok")
    return true

fn testBuildChatRequestBodyWithOptions(): bool =
    let msg1: str = chat.BuildSystemMessage("Be helpful")
    let msg2: str = chat.BuildUserMessage("Hi")
    let messages: str = chat.BuildMessagesArray(2, msg1, msg2, "", "", "", "", "", "")
    let body: str = chat.BuildChatRequestBody("gpt-4", messages, "", true, 4096, "0.7")

    if !strutil.Contains(body, "\"max_tokens\":4096"):
        echo("testBuildChatRequestBodyWithOptions: missing max_tokens"); return false
    if !strutil.Contains(body, "\"stream\":true"):
        echo("testBuildChatRequestBodyWithOptions: missing stream:true"); return false
    if !strutil.Contains(body, "\"temperature\":0.7"):
        echo("testBuildChatRequestBodyWithOptions: missing temperature"); return false
    echo("testBuildChatRequestBodyWithOptions ok")
    return true

fn testBuildChatRequestBodyWithTools(): bool =
    let msg1: str = chat.BuildUserMessage("What's the weather?")
    let messages: str = chat.BuildMessagesArray(1, msg1, "", "", "", "", "", "", "")
    let params: str = "{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\"}}}"
    let tool: str = chat.BuildTool("get_weather", "Get weather", params)
    let tools: str = chat.BuildToolsArray(1, tool, "", "", "")
    let body: str = chat.BuildChatRequestBody("gpt-4", messages, tools, false, 0, "")

    if !strutil.Contains(body, "\"tools\":"):
        echo("testBuildChatRequestBodyWithTools: missing tools"); return false
    if !strutil.Contains(body, "get_weather"):
        echo("testBuildChatRequestBodyWithTools: missing tool name"); return false
    echo("testBuildChatRequestBodyWithTools ok")
    return true

# ═════════════════════════════════════════════════════════════════════════
# Chat response parsing (new)
# ═════════════════════════════════════════════════════════════════════════

fn testNewChatResponse(): bool =
    let resp: chat.ChatResponse = chat.NewChatResponse()
    if resp.ok:
        echo("testNewChatResponse: ok should default to false"); return false
    echo("testNewChatResponse ok")
    return true

fn testParseChatResponseEmpty(): bool =
    let resp: chat.ChatResponse = chat.ParseChatResponse("")
    if resp.ok:
        echo("testParseChatResponseEmpty: should not be ok"); return false
    echo("testParseChatResponseEmpty ok")
    return true

# ═════════════════════════════════════════════════════════════════════════
# SSE streaming parsing (new) — simple test with [DONE] only
# ═════════════════════════════════════════════════════════════════════════

fn testParseSseDone(): bool =
    let doneLine: str = "data: [DONE]"
    var event: stream.SseEvent = stream.ParseSseDataLine(doneLine)
    if !event.ok:
        echo("testParseSseDone: event not ok"); return false
    if event.kind != "done":
        echo("testParseSseDone: wrong kind"); return false
    echo("testParseSseDone ok")
    return true

fn testParseSseNonDataLine(): bool =
    var event: stream.SseEvent = stream.ParseSseDataLine("event: test")
    if event.ok:
        echo("testParseSseNonDataLine: should not be ok"); return false
    echo("testParseSseNonDataLine ok")
    return true

fn testParseSseEmptyLine(): bool =
    var event: stream.SseEvent = stream.ParseSseDataLine("")
    if event.ok:
        echo("testParseSseEmptyLine: should not be ok"); return false
    echo("testParseSseEmptyLine ok")
    return true

fn testParseSseStreamEmpty(): bool =
    var events: str[]
    var contents: str[]
    var finishReasons: str[]
    let count: int32 = stream.ParseSseStream("", events, contents, finishReasons)
    if count != 0:
        echo("testParseSseStreamEmpty: should be 0"); return false
    echo("testParseSseStreamEmpty ok")
    return true

