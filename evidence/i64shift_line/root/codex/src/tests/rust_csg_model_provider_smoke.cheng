fn testCreateModelProvider(): bool =
    var p: mp.ModelProviderRuntime = mp.CreateModelProviderWithKey("OpenAI", "", "sk-test-key")
    if p.name != "OpenAI":
        echo("provider name FAIL")
        return false
    if p.baseUrl != "https://api.openai.com/v1":
        echo("provider baseUrl FAIL")
        return false
    if p.apiKey != "sk-test-key":
        echo("provider apiKey FAIL")
        return false
    if p.requiresOpenaiAuth != true:
        echo("provider requiresOpenaiAuth FAIL")
        return false
    echo("testCreateModelProvider ok")
    return true

fn testCreateLocalProvider(): bool =
    var p: mp.ModelProviderRuntime = mp.CreateModelProviderWithKey("gpt-oss", "", "")
    if p.name != "gpt-oss":
        echo("local name FAIL")
        return false
    if p.baseUrl != "http://localhost:1234/v1":
        echo("local baseUrl FAIL")
        return false
    if p.requiresOpenaiAuth != false:
        echo("local requiresOpenaiAuth FAIL")
        return false
    echo("testCreateLocalProvider ok")
    return true

fn testCreateGlmProvider(): bool =
    var p: mp.ModelProviderRuntime = mp.CreateModelProviderWithKey("GLM", "", "sk-glm-test")
    if p.name != "GLM":
        echo("glm provider name FAIL")
        return false
    if p.baseUrl != "https://api.z.ai/api/coding/paas/v4":
        echo("glm provider baseUrl FAIL")
        return false
    if p.apiKey != "sk-glm-test":
        echo("glm provider apiKey FAIL")
        return false
    if p.requiresOpenaiAuth != true:
        echo("glm provider requires auth FAIL")
        return false
    echo("testCreateGlmProvider ok")
    return true

fn testDefaultBaseUrl(): bool =
    if mp.DefaultBaseUrlForProvider("OpenAI") != "https://api.openai.com/v1":
        echo("default OpenAI FAIL")
        return false
    if mp.DefaultBaseUrlForProvider("Anthropic") != "https://api.anthropic.com":
        echo("default Anthropic FAIL")
        return false
    if mp.DefaultBaseUrlForProvider("GLM") != "https://api.z.ai/api/coding/paas/v4":
        echo("default GLM FAIL")
        return false
    if mp.DefaultBaseUrlForProvider("gpt-oss") != "http://localhost:1234/v1":
        echo("default LM Studio FAIL")
        return false
    if mp.DefaultBaseUrlForProvider("ollama") != "http://localhost:11434/v1":
        echo("default Ollama FAIL")
        return false
    if mp.DefaultBaseUrlForProvider("Unknown") != "":
        echo("default Unknown FAIL")
        return false
    echo("testDefaultBaseUrl ok")
    return true

