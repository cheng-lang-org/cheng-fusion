import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/chat_replay as replay

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckEqInt(actual: int32, expected: int32, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", strings.IntToStr(expected), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn UserMessageItem(id: str, text: str): str =
    var content = "[{"
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldStr("type", "text"))
    content = wire.RustCsgCat(content, ",")
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldStr("text", text))
    content = wire.RustCsgCat(content, ",")
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldRaw("textElements", "[]"))
    content = wire.RustCsgCat(content, "}]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "userMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", content))
    out = wire.RustCsgCat(out, "}")
    return out

fn AgentMessageItem(id: str, text: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "agentMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", text))
    out = wire.RustCsgCat(out, "}")
    return out

fn ReasoningItem(id: str, summary: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "reasoning"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("summary", wire.RustCsgCat3("[", wire.RustCsgJsonQuote(summary), "]")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", "[]"))
    out = wire.RustCsgCat(out, "}")
    return out

fn CommandExecutionItem(id: str, command: str, source: str, status: str, outputJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "commandExecution"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", command))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", "/repo/current"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", source))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("commandActions", "[]"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("aggregatedOutput", outputJson))
    out = wire.RustCsgCat(out, "}")
    return out

fn Turn(id: str, itemsJson: str, status: str, errorJson: str): str =
    var error = errorJson
    if error == "":
        error = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("items", itemsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("itemsView", "full"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", error))
    out = wire.RustCsgCat(out, ",\"startedAt\":null,\"completedAt\":null,\"durationMs\":null}")
    return out

fn main(): int32 =
    var failures: int32
    let turn1Items = strutil.Join([UserMessageItem("u1", "fix bug"),
                                   ReasoningItem("r1", "checking"),
                                   AgentMessageItem("a1", "done")], ",")
    let turn2Items = CommandExecutionItem("c1", "sleep 1", "agent", "failed", "null")
    let turn3Items = AgentMessageItem("a2", "failed visible")
    let turnsJson = strutil.Join(["[",
                                  Turn("turn-1", wire.RustCsgCat3("[", turn1Items, "]"), "completed", ""),
                                  ",",
                                  Turn("turn-2", wire.RustCsgCat3("[", turn2Items, "]"), "interrupted", ""),
                                  ",",
                                  Turn("turn-3", wire.RustCsgCat3("[", turn3Items, "]"), "failed", "{\"message\":\"boom\"}"),
                                  "]"], "")

    var plan = replay.RustCsgTuiChatReplayFromTurns(turnsJson)
    failures = failures + CheckEqBool(plan.ok, true, "plan ok")
    failures = failures + CheckEqInt(plan.turnCount, 3, "turn count")
    failures = failures + CheckEqInt(plan.eventCount, 5, "event count")
    failures = failures + CheckEqInt(plan.userMessageCount, 1, "user count")
    failures = failures + CheckEqInt(plan.agentMessageCount, 2, "agent count")
    failures = failures + CheckEqInt(plan.reasoningCount, 1, "reasoning count")
    failures = failures + CheckEqInt(plan.commandExecutionCount, 1, "command count")
    failures = failures + CheckEqBool(plan.hasInterruptedTurn, true, "interrupted flag")
    failures = failures + CheckEqBool(plan.hasFailedTurn, true, "failed flag")
    failures = failures + CheckContains(plan.displayTranscriptText, "› fix bug", "user transcript")
    failures = failures + CheckContains(plan.displayTranscriptText, "• done", "agent transcript")
    failures = failures + CheckContains(plan.displayTranscriptText, "• Ran sleep 1\n  └ (no output)", "command transcript")
    let planJson = replay.RustCsgTuiChatReplayPlanToJson(plan)
    failures = failures + CheckContains(planJson, "\"itemType\":\"reasoning\"", "reasoning event json")
    failures = failures + CheckContains(planJson, "\"turnError\":{\"message\":\"boom\"}", "turn error json")

    let badItem = "{\"type\":\"webSearch\",\"id\":\"w1\",\"query\":\"x\"}"
    let badTurns = wire.RustCsgCat3("[", Turn("turn-bad", wire.RustCsgCat3("[", badItem, "]"), "completed", ""), "]")
    let badPlan = replay.RustCsgTuiChatReplayFromTurns(badTurns)
    failures = failures + CheckEqBool(badPlan.ok, false, "unsupported item fails")
    failures = failures + CheckContains(badPlan.error, "unsupported history item type: webSearch", "unsupported item error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_chat_replay_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_chat_replay_smoke ok")
    return 0
