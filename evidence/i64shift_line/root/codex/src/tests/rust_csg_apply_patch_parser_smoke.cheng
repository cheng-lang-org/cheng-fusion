import std/strings
import std/strutils as strutil

fn startsWith(s: str, prefix: str): bool =
    let n = s.len
    let m = prefix.len
    if m > n:
        return false
    var i: int32
    for i in 0..<m:
        if s[i] != prefix[i]:
            return false
    return true

fn parseIntFrom(s: str, start: int32, outValue: var int32, outEnd: var int32): bool =
    outValue = 0
    outEnd = start
    var i: int32 = start
    let n = s.len
    if i >= n:
        return false
    if s[i] < '0' || s[i] > '9':
        return false
    while i < n:
        if s[i] >= '0' && s[i] <= '9':
            outValue = outValue * 10 + (Int32(s[i]) - 48)
            i = i + 1
        else:
            break
    outEnd = i
    return true

fn parsePatch(input: str,
    outHunkTags: var int32[], outHunkPaths: var str[], outHunkContents: var str[],
    outOldStarts: var int32[], outOldCounts: var int32[],
    outNewStarts: var int32[], outNewCounts: var int32[],
    outLineCounts: var int32[], outHunkLines: var str[],
    outOk: var bool, outError: var str
) =
    outOk = false
    outError = ""
    let lines = strutil.Split(input, '\n')
    let n = lines.len
    if n == 0:
        outError = "empty input"
        return
    if n == 1:
        if lines[0] == "":
            outError = "empty input"
            return
    var i: int32
    var currentFile: str
    var allAdds: bool
    var allDels: bool
    var hasContent: bool
    var inFile: bool
    var contentLines: str[]
    for i in 0..<n:
        let line = lines[i]
        if startsWith(line, "--- "):
            if inFile && hasContent:
                if allAdds:
                    add(outHunkTags, 0)
                    add(outHunkPaths, currentFile)
                    add(outHunkContents, strutil.Join(contentLines, "\n"))
                else:
                    if allDels:
                        add(outHunkTags, 1)
                        add(outHunkPaths, currentFile)
                        add(outHunkContents, "")
                add(outOldStarts, 0)
                add(outOldCounts, 0)
                add(outNewStarts, 0)
                add(outNewCounts, 0)
                add(outLineCounts, 0)
                add(outHunkLines, "")
            currentFile = strings.SliceBytes(line, 4, line.len - 4)
            inFile = true
            allAdds = true
            allDels = true
            hasContent = false
            contentLines = []
        else:
            if startsWith(line, "+++ "):
                if !inFile:
                    currentFile = strings.SliceBytes(line, 4, line.len - 4)
                    inFile = true
                    allAdds = true
                    allDels = true
                    hasContent = false
                    contentLines = []
            else:
                if startsWith(line, "@@"):
                    if !inFile:
                        outError = "hunk without file header"
                        return
                    var oldStart: int32
                    var oldCount: int32
                    var newStart: int32
                    var newCount: int32
                    var pos: int32
                    var okP: bool
                    var endP: int32
                    pos = 3
                    if pos < line.len:
                        if line[pos] == '-':
                            pos = pos + 1
                    okP = parseIntFrom(line, pos, oldStart, endP)
                    if !okP:
                        outError = "bad hunk oldStart"
                        return
                    pos = endP
                    if pos < line.len:
                        if line[pos] == ',':
                            pos = pos + 1
                            okP = parseIntFrom(line, pos, oldCount, endP)
                            if !okP:
                                outError = "bad hunk oldCount"
                                return
                            pos = endP
                        else:
                            oldCount = 1
                    else:
                        oldCount = 1
                    while pos < line.len:
                        if line[pos] == ' ':
                            pos = pos + 1
                        else:
                            break
                    if pos < line.len:
                        if line[pos] == '+':
                            pos = pos + 1
                    okP = parseIntFrom(line, pos, newStart, endP)
                    if !okP:
                        outError = "bad hunk newStart"
                        return
                    pos = endP
                    if pos < line.len:
                        if line[pos] == ',':
                            pos = pos + 1
                            okP = parseIntFrom(line, pos, newCount, endP)
                            if !okP:
                                outError = "bad hunk newCount"
                                return
                        else:
                            newCount = 1
                    else:
                        newCount = 1
                    add(outHunkTags, 2)
                    add(outHunkPaths, currentFile)
                    add(outHunkContents, "")
                    add(outOldStarts, oldStart)
                    add(outOldCounts, oldCount)
                    add(outNewStarts, newStart)
                    add(outNewCounts, newCount)
                    add(outLineCounts, 0)
                    add(outHunkLines, "")
                    allAdds = false
                    allDels = false
                else:
                    if startsWith(line, "+"):
                        add(contentLines, strings.SliceBytes(line, 1, line.len - 1))
                        hasContent = true
                        allDels = false
                    else:
                        if startsWith(line, "-"):
                            add(contentLines, strings.SliceBytes(line, 1, line.len - 1))
                            hasContent = true
                            allAdds = false
                        else:
                            if startsWith(line, " "):
                                add(contentLines, strings.SliceBytes(line, 1, line.len - 1))
                                hasContent = true
                                allAdds = false
                                allDels = false
    if inFile && hasContent:
        if allAdds:
            add(outHunkTags, 0)
            add(outHunkPaths, currentFile)
            add(outHunkContents, strutil.Join(contentLines, "\n"))
        else:
            if allDels:
                add(outHunkTags, 1)
                add(outHunkPaths, currentFile)
                add(outHunkContents, "")
        add(outOldStarts, 0)
        add(outOldCounts, 0)
        add(outNewStarts, 0)
        add(outNewCounts, 0)
        add(outLineCounts, 0)
        add(outHunkLines, "")
    outOk = true

# ── generateUnifiedDiff: LCS-based unified diff generator ──

fn generateUnifiedDiff(oldFile: str, newFile: str, oldContent: str, newContent: str): str =
    var result: str = strutil.Join(["--- ", oldFile, "\n+++ ", newFile, "\n"], "")
    if oldContent == "" && newContent == "":
        return result
    var oldLines: str[]
    var newLines: str[]
    var oldN: int32 = 0
    var newN: int32 = 0
    if oldContent != "":
        oldLines = strutil.Split(oldContent, '\n')
        oldN = oldLines.len
    if newContent != "":
        newLines = strutil.Split(newContent, '\n')
        newN = newLines.len
    let stride = newN + 1
    var tableSize = (oldN + 1) * stride
    var dp: int32[]
    var dpIdx: int32 = 0
    while dpIdx < tableSize:
        add(dp, 0)
        dpIdx = dpIdx + 1
    var i: int32 = 0
    while i < oldN:
        var j: int32 = 0
        while j < newN:
            let cell = (i + 1) * stride + (j + 1)
            if oldLines[i] == newLines[j]:
                dp[cell] = dp[i * stride + j] + 1
            else:
                let up = dp[i * stride + (j + 1)]
                let left = dp[(i + 1) * stride + j]
                if up >= left:
                    dp[cell] = up
                else:
                    dp[cell] = left
            j = j + 1
        i = i + 1
    var rOps: int32[]
    var rOldTxt: str[]
    var rNewTxt: str[]
    i = oldN
    var j: int32 = newN
    while i > 0 || j > 0:
        if i > 0 && j > 0 && oldLines[i - 1] == newLines[j - 1]:
            add(rOps, 0)
            add(rOldTxt, oldLines[i - 1])
            add(rNewTxt, oldLines[i - 1])
            i = i - 1
            j = j - 1
        else:
            if i > 0 && (j == 0 || dp[(i - 1) * stride + j] >= dp[i * stride + (j - 1)]):
                add(rOps, 1)
                add(rOldTxt, oldLines[i - 1])
                add(rNewTxt, "")
                i = i - 1
            else:
                add(rOps, 2)
                add(rOldTxt, "")
                add(rNewTxt, newLines[j - 1])
                j = j - 1
    let totalOps = rOps.len
    var firstChange: int32 = totalOps
    var idx: int32 = totalOps - 1
    while idx >= 0:
        if rOps[idx] != 0:
            firstChange = totalOps - 1 - idx
            break
        idx = idx - 1
    if firstChange >= totalOps:
        return result
    var oldTrack: int32 = 1
    var newTrack: int32 = 1
    idx = totalOps - 1
    while idx >= 0:
        let fwdIdx = totalOps - 1 - idx
        if fwdIdx >= firstChange:
            break
        if rOps[idx] == 0 || rOps[idx] == 1:
            oldTrack = oldTrack + 1
        if rOps[idx] == 0 || rOps[idx] == 2:
            newTrack = newTrack + 1
        idx = idx - 1
    let hunkOldStart: int32 = oldTrack
    let hunkNewStart: int32 = newTrack
    var hunkLines: str[]
    while idx >= 0:
        if rOps[idx] == 0:
            add(hunkLines, strutil.Join([" ", rOldTxt[idx], "\n"], ""))
            oldTrack = oldTrack + 1
            newTrack = newTrack + 1
        else:
            if rOps[idx] == 1:
                add(hunkLines, strutil.Join(["-", rOldTxt[idx], "\n"], ""))
                oldTrack = oldTrack + 1
            else:
                add(hunkLines, strutil.Join(["+", rNewTxt[idx], "\n"], ""))
                newTrack = newTrack + 1
        idx = idx - 1
    let oldCnt = oldTrack - hunkOldStart
    let newCnt = newTrack - hunkNewStart
    let hdr = strutil.Join(["@@ -", strings.IntToStr(hunkOldStart), ",", strings.IntToStr(oldCnt),
                            " +", strings.IntToStr(hunkNewStart), ",", strings.IntToStr(newCnt), " @@\n"], "")
    result = strutil.Join([result, hdr], "")
    idx = 0
    while idx < hunkLines.len:
        result = strutil.Join([result, hunkLines[idx]], "")
        idx = idx + 1
    return result

# ── applyHunkToContent: apply a single parsed hunk to content ──

fn applyHunkToContent(content: str, oldStart: int32, oldCount: int32, newStart: int32, newCount: int32, hunkOps: str[], outResult: var str): bool =
    outResult = ""
    if content == "":
        return false
    let lines = strutil.Split(content, '\n')
    let n = lines.len
    let pos = oldStart - 1
    if pos < 0 || pos + oldCount > n:
        return false
    var opIdx: int32 = 0
    var lineIdx: int32 = pos
    var allMatch: bool = true
    while opIdx < hunkOps.len && allMatch:
        let op = hunkOps[opIdx]
        if op.len > 0:
            let prefix = op[0]
            if prefix == ' ' || prefix == '-':
                if lineIdx >= n || lines[lineIdx] != strings.SliceBytes(op, 1, op.len - 1):
                    allMatch = false
                else:
                    lineIdx = lineIdx + 1
        opIdx = opIdx + 1
    if !allMatch:
        return false
    var newLines: str[]
    var i: int32 = 0
    while i < pos:
        add(newLines, lines[i])
        i = i + 1
    opIdx = 0
    while opIdx < hunkOps.len:
        let op = hunkOps[opIdx]
        if op.len > 0:
            let prefix = op[0]
            if prefix == ' ' || prefix == '+':
                add(newLines, strings.SliceBytes(op, 1, op.len - 1))
        opIdx = opIdx + 1
    i = pos + oldCount
    while i < n:
        add(newLines, lines[i])
        i = i + 1
    var res: str = ""
    i = 0
    while i < newLines.len:
        if i > 0:
            res = strutil.Join([res, "\n"], "")
        res = strutil.Join([res, newLines[i]], "")
        i = i + 1
    outResult = res
    return true

# Tests
fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEq(name: str, expected: int32, actual: int32): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn testAddFile(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- new.txt\n+++ new.txt\n+hello\n+world\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if !checkTrue("add_ok", ok):
        return false
    if !checkEq("add_count", 1, tags.len):
        return false
    if !checkEq("add_tag", 0, tags[0]):
        return false
    echo("testAddFile ok")
    return true

fn testDeleteFile(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- old.txt\n+++ old.txt\n-old\n-gone\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if !checkTrue("del_ok", ok):
        return false
    if !checkEq("del_count", 1, tags.len):
        return false
    if !checkEq("del_tag", 1, tags[0]):
        return false
    echo("testDeleteFile ok")
    return true

fn testUpdateFile(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- file.txt\n+++ file.txt\n@@ -1,3 +1,3 @@\n context\n-old\n+new\n more\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if !checkTrue("upd_ok", ok):
        return false
    if !checkEq("upd_count", 1, tags.len):
        return false
    if !checkEq("upd_tag", 2, tags[0]):
        return false
    echo("testUpdateFile ok")
    return true

fn testEmptyInput(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    parsePatch("", tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if checkTrue("empty_not_ok", !ok):
        echo("testEmptyInput ok")
        return true
    return false

fn testMultipleHunks(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- file.txt\n+++ file.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n@@ -4,2 +4,2 @@\n d\n-e\n+f\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if !checkTrue("mh_ok", ok):
        return false
    if !checkEq("mh_count", 2, tags.len):
        return false
    if !checkEq("mh_tag0", 2, tags[0]):
        return false
    if !checkEq("mh_tag1", 2, tags[1]):
        return false
    echo("testMultipleHunks ok")
    return true

fn testMultipleFiles(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- a.txt\n+++ a.txt\n+a\n--- b.txt\n+++ b.txt\n+b\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if !checkTrue("mf_ok", ok):
        return false
    if !checkEq("mf_count", 2, tags.len):
        return false
    if !checkEq("mf_tag0", 0, tags[0]):
        return false
    if !checkEq("mf_tag1", 0, tags[1]):
        return false
    echo("testMultipleFiles ok")
    return true

fn testMalformedHunk(): bool =
    var tags: int32[]
    var paths: str[]
    var contents: str[]
    var os: int32[]
    var oc: int32[]
    var ns: int32[]
    var nc: int32[]
    var lc: int32[]
    var hl: str[]
    var ok: bool
    var err: str
    let patch = "--- file.txt\n+++ file.txt\n@@ -abc +def @@\n context\n"
    parsePatch(patch, tags, paths, contents, os, oc, ns, nc, lc, hl, ok, err)
    if checkTrue("mh_not_ok", !ok):
        echo("testMalformedHunk ok")
