# ── generateUnifiedDiff tests ──

fn testDiffNoChange(): bool =
    let diff = generateUnifiedDiff("f.txt", "f.txt", "a\nb", "a\nb")
    let expected = "--- f.txt\n+++ f.txt\n"
    if !checkStr("diff_nochange", expected, diff):
        return false
    echo("testDiffNoChange ok")
    return true

fn testDiffSimpleModify(): bool =
    let diff = generateUnifiedDiff("f.txt", "f.txt", "a\nb", "a\nx")
    let expected = "--- f.txt\n+++ f.txt\n@@ -2,1 +2,1 @@\n+x\n-b\n"
    if !checkStr("diff_modify", expected, diff):
        return false
    echo("testDiffSimpleModify ok")
    return true

fn testDiffAddFile(): bool =
    let diff = generateUnifiedDiff("new.txt", "new.txt", "", "hello")
    let expected = "--- new.txt\n+++ new.txt\n@@ -1,0 +1,1 @@\n+hello\n"
    if !checkStr("diff_addfile", expected, diff):
        return false
    echo("testDiffAddFile ok")
    return true

# ── applyHunkToContent tests ──

fn testApplyHunkRemove(): bool =
    var ops: str[]
    add(ops, "-b")
    var result: str
    let ok = applyHunkToContent("a\nb\nc", 2, 1, 2, 0, ops, result)
    if !ok:
        echo("FAIL applyRemove_ok")
        return false
    if !checkStr("applyRemove_result", "a\nc", result):
        return false
    echo("testApplyHunkRemove ok")
    return true

fn testApplyHunkReplace(): bool =
    var ops: str[]
    add(ops, "-b")
    add(ops, "+x")
    var result: str
    let ok = applyHunkToContent("a\nb\nc", 2, 1, 2, 1, ops, result)
    if !ok:
        echo("FAIL applyReplace_ok")
        return false
    if !checkStr("applyReplace_result", "a\nx\nc", result):
        return false
    echo("testApplyHunkReplace ok")
    return true

fn testApplyHunkMismatch(): bool =
    var ops: str[]
    add(ops, "-z")
    var result: str
    let ok = applyHunkToContent("a\nb\nc", 2, 1, 2, 0, ops, result)
    if ok:
        echo("FAIL applyMismatch_should_fail")
        return false
    echo("testApplyHunkMismatch ok")
    return true

# ── patchValidateSyntax ──

fn patchValidateSyntax(patch: str, outError: var str): bool =
    outError = ""
    if patch == "":
        outError = "empty patch"
        return false
    let lines = strutil.Split(patch, '\n')
    let n = lines.len
    if n == 0:
        outError = "empty patch"
        return false
    var i: int32 = 0
    var hadHeader: bool = false
    while i < n:
        let line = lines[i]
        if line == "":
            i = i + 1
            continue
        if startsWith(line, "--- "):
            hadHeader = true
            if line.len <= 4:
                outError = "--- header missing filename"
                return false
        elif startsWith(line, "+++ "):
            if !hadHeader:
                outError = "+++ without preceding ---"
                return false
            if line.len <= 4:
                outError = "+++ header missing filename"
                return false
        elif startsWith(line, "@@"):
            if !hadHeader:
                outError = "hunk without file header"
                return false
            var pos: int32 = 2
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '-':
                outError = "hunk header missing '-'"
                return false
            pos = pos + 1
            var foundDigit: bool = false
            while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                foundDigit = true
                pos = pos + 1
            if !foundDigit:
                outError = "hunk header missing old-start"
                return false
            if pos < line.len && line[pos] == ',':
                pos = pos + 1
                foundDigit = false
                while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                    foundDigit = true
                    pos = pos + 1
                if !foundDigit:
                    outError = "hunk header missing old-count"
                    return false
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '+':
                outError = "hunk header missing '+'"
                return false
            pos = pos + 1
            foundDigit = false
            while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                foundDigit = true
                pos = pos + 1
            if !foundDigit:
                outError = "hunk header missing new-start"
                return false
            if pos < line.len && line[pos] == ',':
                pos = pos + 1
                foundDigit = false
                while pos < line.len && line[pos] >= '0' && line[pos] <= '9':
                    foundDigit = true
                    pos = pos + 1
                if !foundDigit:
                    outError = "hunk header missing new-count"
                    return false
            while pos < line.len && line[pos] == ' ':
                pos = pos + 1
            if pos >= line.len || line[pos] != '@' || pos + 1 >= line.len || line[pos+1] != '@':
                outError = "hunk header missing trailing @@"
                return false
        elif startsWith(line, "---") || startsWith(line, "+++") || startsWith(line, "@"):
            outError = "malformed marker"
            return false
        else:
            let c0 = line[0]
            if c0 != ' ' && c0 != '+' && c0 != '-':
                outError = "line does not start with ' ', '+', or '-'"
                return false
            if !hadHeader:
                outError = "content line without file header"
                return false
        i = i + 1
    return true

# ── patchComputeStats ──

fn patchComputeStats(patch: str, outAdditions: var int32, outDeletions: var int32, outFilesChanged: var int32, outError: var str) =
    outAdditions = 0
    outDeletions = 0
    outFilesChanged = 0
    outError = ""
    if patch == "":
        return
    let lines = strutil.Split(patch, '\n')
    let n = lines.len
    var i: int32 = 0
    var fileCounted: bool = false
    while i < n:
        let line = lines[i]
        if line == "":
            i = i + 1
            continue
        if startsWith(line, "--- "):
            fileCounted = false
        elif startsWith(line, "+++ "):
            if !fileCounted:
                outFilesChanged = outFilesChanged + 1
                fileCounted = true
        else:
            if line.len > 0:
                let c0 = line[0]
                if c0 == '+':
                    outAdditions = outAdditions + 1
                elif c0 == '-':
                    outDeletions = outDeletions + 1
        i = i + 1

# ── patchValidateSyntax tests ──

fn testPatchValidateValidHunk(): bool =
    var err: str
    let ok = patchValidateSyntax("--- a.txt\n+++ b.txt\n@@ -1,3 +1,4 @@\n a\n-b\n+c\n d\n", err)
    if !ok:
        echo(strutil.Join(["FAIL [pV_validHunk]: expected ok, got err=", err], ""))
        return false
    echo("testPatchValidateValidHunk ok")
    return true

fn testPatchValidateEmpty(): bool =
    var err: str
    let ok = patchValidateSyntax("", err)
    if ok:
        echo("FAIL [pV_empty]: should be invalid")
        return false
    echo("testPatchValidateEmpty ok")
    return true

fn testPatchValidateNoHeader(): bool =
    var err: str
    let ok = patchValidateSyntax("@@ -1,1 +1,1 @@\n a\n", err)
    if ok:
        echo("FAIL [pV_noHeader]: should be invalid")
        return false
    echo("testPatchValidateNoHeader ok")
    return true

fn testPatchValidateNoMarkerContent(): bool =
    var err: str
    let ok = patchValidateSyntax("--- a.txt\n+++ b.txt\nbad line\n", err)
    if ok:
        echo("FAIL [pV_badContent]: should be invalid")
        return false
    echo("testPatchValidateNoMarkerContent ok")
    return true

fn testPatchValidateHunkMissingMinus(): bool =
    var err: str
    let ok = patchValidateSyntax("--- a.txt\n+++ b.txt\n@@ 1,3 +1,4 @@\n a\n", err)
    if ok:
        echo("FAIL [pV_noMinus]: should be invalid")
        return false
    echo("testPatchValidateHunkMissingMinus ok")
    return true

fn testPatchValidateHunkMissingTrailingAt(): bool =
    var err: str
    let ok = patchValidateSyntax("--- a.txt\n+++ b.txt\n@@ -1,3 +1,4 @\n a\n", err)
    if ok:
        echo("FAIL [pV_noTrailing]: should be invalid")
        return false
    echo("testPatchValidateHunkMissingTrailingAt ok")
    return true

# ── patchComputeStats tests ──

fn testPatchComputeStatsAdd(): bool =
    var adds: int32
    var dels: int32
    var files: int32
    var err: str
    patchComputeStats("--- a.txt\n+++ a.txt\n@@ -0,0 +1,3 @@\n+a\n+b\n+c\n", adds, dels, files, err)
    var ok: bool = true
    if adds != 3:
        echo("FAIL [pCS_adds]: expected 3")
        ok = false
    if dels != 0:
        echo("FAIL [pCS_dels]: expected 0")
        ok = false
    if files != 1:
        echo("FAIL [pCS_files]: expected 1")
        ok = false
    if ok:
        echo("testPatchComputeStatsAdd ok")
    return ok

fn testPatchComputeStatsMixed(): bool =
    var adds: int32
    var dels: int32
    var files: int32
    var err: str
    patchComputeStats("--- a.txt\n+++ a.txt\n@@ -1,3 +1,4 @@\n a\n-b\n+c\n d\n-e\n+f\n", adds, dels, files, err)
    var ok: bool = true
    if adds != 2:
        echo("FAIL [pCS_mixed_adds]: expected 2")
        ok = false
    if dels != 2:
        echo("FAIL [pCS_mixed_dels]: expected 2")
        ok = false
    if files != 1:
        echo("FAIL [pCS_mixed_files]: expected 1")
        ok = false
    if ok:
        echo("testPatchComputeStatsMixed ok")
    return ok

fn testPatchComputeStatsMultipleFiles(): bool =
    var adds: int32
    var dels: int32
    var files: int32
    var err: str
    patchComputeStats("--- a.txt\n+++ a.txt\n@@ -1,1 +1,1 @@\n a\n+b\n--- c.txt\n+++ c.txt\n@@ -1,1 +1,1 @@\n c\n+d\n", adds, dels, files, err)
    var ok: bool = true
    if adds != 2:
        echo("FAIL [pCS_mf_adds]: expected 2")
        ok = false
    if files != 2:
        echo("FAIL [pCS_mf_files]: expected 2")
        ok = false
    if ok:
        echo("testPatchComputeStatsMultipleFiles ok")
    return ok

fn testPatchComputeStatsEmpty(): bool =
    var adds: int32
    var dels: int32
    var files: int32
    var err: str
    patchComputeStats("", adds, dels, files, err)
    var ok: bool = true
    if adds != 0 || dels != 0 || files != 0:
        echo("FAIL [pCS_empty]: expected all zero")
        ok = false
    if ok:
        echo("testPatchComputeStatsEmpty ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool
    allOk = true
    if !testAddFile():
        allOk = false
    if !testDeleteFile():
        allOk = false
    if !testUpdateFile():
        allOk = false
    if !testEmptyInput():
        allOk = false
    if !testMultipleHunks():
        allOk = false
    if !testMultipleFiles():
        allOk = false
    if !testMalformedHunk():
        allOk = false
    if !testHunkWithoutFileHeader():
        allOk = false
    if !testDiffNoChange():
        allOk = false
    if !testDiffSimpleModify():
        allOk = false
    if !testDiffAddFile():
        allOk = false
    if !testApplyHunkRemove():
        allOk = false
    if !testApplyHunkReplace():
        allOk = false
    if !testApplyHunkMismatch():
        allOk = false
    if !testPatchValidateValidHunk():
        allOk = false
    if !testPatchValidateEmpty():
        allOk = false
    if !testPatchValidateNoHeader():
        allOk = false
    if !testPatchValidateNoMarkerContent():
        allOk = false
    if !testPatchValidateHunkMissingMinus():
        allOk = false
    if !testPatchValidateHunkMissingTrailingAt():
        allOk = false
    if !testPatchComputeStatsAdd():
        allOk = false
    if !testPatchComputeStatsMixed():
        allOk = false
    if !testPatchComputeStatsMultipleFiles():
        allOk = false
    if !testPatchComputeStatsEmpty():
        allOk = false
    if allOk:
        echo("rust_csg_apply_patch_parser_smoke ok")
        return 0
    echo("rust_csg_apply_patch_parser_smoke FAILED")
    return 1
