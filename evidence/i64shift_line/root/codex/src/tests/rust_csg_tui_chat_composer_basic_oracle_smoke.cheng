import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chat_composer_basic_oracle as oracle

fn RustCsgTuiChatComposerBasicExpr(): str =
    return "terminal.backend()"

fn RustCsgTuiChatComposerBasicOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/chat_composer.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != RustCsgTuiChatComposerBasicExpr():
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 12:
        echo("FAIL usage: rust_csg_tui_chat_composer_basic_oracle_smoke <11 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicBackspaceAfterPastesSnapshot(), "backspace_after_pastes")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicEmptySnapshot(), "empty")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicImagePlaceholderMultipleSnapshot(), "image_placeholder_multiple")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicImagePlaceholderSingleSnapshot(), "image_placeholder_single")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicLargeSnapshot(), "large")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicMultiplePastesSnapshot(), "multiple_pastes")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicRemoteImageRowsSnapshot(), "remote_image_rows")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicRemoteImageRowsAfterDeleteFirstSnapshot(), "remote_image_rows_after_delete_first")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicRemoteImageRowsSelectedSnapshot(), "remote_image_rows_selected")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicSmallSnapshot(), "small")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerBasicOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerBasicZellijEmptySnapshot(), "zellij_empty_composer")

    if exitCode == 0:
        echo("rust_csg_tui_chat_composer_basic_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chat_composer_basic_oracle_smoke FAILED")
    return exitCode
