# Feedback smoke test — verifies type constants and classification helpers.
# Ported from codex-rs/feedback/src/lib.rs

import cheng/codex/crates/feedback
import std/strings
import std/strutils as strutil

fn fbStrEq(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testConstants(): bool =
    var ok: bool = true
    if !fbStrEq(feedback.RustCsgFeedbackDoctorReportAttachmentFilename, "codex-doctor-report.json", "DoctorReportFilename"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackDiagnosticsAttachmentFilename, "codex-connectivity-diagnostics.txt", "DiagnosticsFilename"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackClassificationBug, "bug", "ClassificationBug"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackClassificationBadResult, "bad_result", "ClassificationBadResult"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackClassificationGoodResult, "good_result", "ClassificationGoodResult"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackClassificationSafetyCheck, "safety_check", "ClassificationSafetyCheck"):
        ok = false
    if ok:
        echo("testConstants ok")
    return ok

fn testDisplayClassification(): bool =
    var ok: bool = true
    if !fbStrEq(feedback.RustCsgFeedbackDisplayClassification("bug"), "Bug", "DisplayBug"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackDisplayClassification("bad_result"), "Bad result", "DisplayBadResult"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackDisplayClassification("good_result"), "Good result", "DisplayGoodResult"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackDisplayClassification("unknown"), "Other", "DisplayUnknown"):
        ok = false
    if !fbStrEq(feedback.RustCsgFeedbackDisplayClassification(""), "Other", "DisplayEmpty"):
        ok = false
    if ok:
        echo("testDisplayClassification ok")
    return ok

fn fbCheckCount(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testCounts(): bool =
    var ok: bool = true
    if !fbCheckCount(feedback.RustCsgCodexFeedbackMethodCount, 5, "CodexFeedbackMethodCount"):
        ok = false
    if !fbCheckCount(feedback.RustCsgFeedbackSnapshotFieldCount, 4, "SnapshotFieldCount"):
        ok = false
    if !fbCheckCount(feedback.RustCsgFeedbackFunctionCount, 2, "FeedbackFunctionCount"):
        ok = false
    if ok:
        echo("testCounts ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testConstants():
        allOk = false
    if !testDisplayClassification():
        allOk = false
    if !testCounts():
        allOk = false
    if allOk:
        echo("rust_csg_feedback_smoke ok")
        return 0
    else:
        echo("rust_csg_feedback_smoke FAILED")
        return 1
