import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# LRU Cache — production implementation backed by C parallel arrays
#
# Uses a monotonic clock (global counter incremented on each access) to track
# recency. The cache with the smallest accessTime is the LRU victim.
# ═══════════════════════════════════════════════════════════════════════════════

@importc("RustCsgLruNew")
fn RustCsgLruNew(capacity: int32): int32

@abi_internal
@importc("RustCsgLruPut")
fn RustCsgLruPut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool)

@abi_internal
@importc("RustCsgLruGet")
fn RustCsgLruGet(handle: int32, key: str, outValue: var str, outOk: var bool)

@abi_internal
@importc("RustCsgLruRemove")
fn RustCsgLruRemove(handle: int32, key: str, outOk: var bool)

@importc("RustCsgLruClear")
fn RustCsgLruClear(handle: int32)

@importc("RustCsgLruStats")
fn RustCsgLruStats(handle: int32, outHits: var int32, outMisses: var int32, outEvictions: var int32)

@abi_internal
@importc("RustCsgLruPeek")
fn RustCsgLruPeek(handle: int32, key: str, outValue: var str, outOk: var bool)

@importc("RustCsgLruResize")
fn RustCsgLruResize(handle: int32, newCapacity: int32, outEvictedCount: var int32)

@abi_internal
@importc("RustCsgLruContains")
fn RustCsgLruContains(handle: int32, key: str): bool

@importc("RustCsgLruCapacity")
fn RustCsgLruCapacity(handle: int32): int32

@abi_internal
@importc("RustCsgLruKeys")
fn RustCsgLruKeys(handle: int32): str

@abi_internal
@importc("RustCsgLruValues")
fn RustCsgLruValues(handle: int32): str

# ── Public API wrappers ─────────────────────────────────────────────────

fn lruCacheNew(capacity: int32): int32 =
    return RustCsgLruNew(capacity)

fn lruCachePut(handle: int32, key: str, value: str, outEvictedKey: var str, outOk: var bool) =
    RustCsgLruPut(handle, key, value, outEvictedKey, outOk)

fn lruCacheGet(handle: int32, key: str, outValue: var str, outOk: var bool) =
    RustCsgLruGet(handle, key, outValue, outOk)

fn lruCacheRemove(handle: int32, key: str, outOk: var bool) =
    RustCsgLruRemove(handle, key, outOk)

fn lruCacheClear(handle: int32) =
    RustCsgLruClear(handle)

fn lruCacheStats(handle: int32, outHits: var int32, outMisses: var int32, outEvictions: var int32) =
    RustCsgLruStats(handle, outHits, outMisses, outEvictions)

fn lruCachePeek(handle: int32, key: str, outValue: var str, outOk: var bool) =
    RustCsgLruPeek(handle, key, outValue, outOk)

fn lruCacheResize(handle: int32, newCapacity: int32, outEvictedCount: var int32) =
    RustCsgLruResize(handle, newCapacity, outEvictedCount)

fn lruCacheContains(handle: int32, key: str): bool =
    return RustCsgLruContains(handle, key)

fn lruCacheCapacity(handle: int32): int32 =
    return RustCsgLruCapacity(handle)

fn lruCacheKeys(handle: int32): str =
    return RustCsgLruKeys(handle)

fn lruCacheValues(handle: int32): str =
    return RustCsgLruValues(handle)

# ── Get-or-Insert (atomic) ──────────────────────────────────────────────

fn lruCacheGetOrInsert(handle: int32, key: str, fallback: str,
                       outValue: var str, outInserted: var bool) =
    var got: str
    var getOk: bool
    lruCacheGet(handle, key, got, getOk)
    if getOk:
        outValue = got
        outInserted = false
    else:
        var evicted: str
        var putOk: bool
        lruCachePut(handle, key, fallback, evicted, putOk)
        outValue = fallback
        outInserted = true

# ── Export All Entries as Delimited String ──────────────────────────────

fn lruCacheToArray(handle: int32): str =
    let keys = lruCacheKeys(handle)
    let values = lruCacheValues(handle)
    return strutil.Join(["k:", keys, " v:", values], "")

# ── Test Helpers ────────────────────────────────────────────────────────

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected bool=", es, " got=", gs], ""))
        return false
    return true

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected i32=", strings.Int64ToStr(int64(expected)),
                          " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    return true

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected str=\"", expected, "\" got=\"", got, "\""], ""))
        return false
    return true

# ── Tests ───────────────────────────────────────────────────────────────

fn testNewCache(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    if !checkEqI32(h != 0, true):
        ok = false
    if ok:
        let h2 = lruCacheNew(16)
        if !checkEqI32(h2 != 0, true):
            ok = false
        if !checkEqI32(h != h2, true):
            ok = false
    if ok:
        echo("testNewCache ok")
    return ok

fn testPutGet(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    if !checkEqI32(h != 0, true):
        ok = false
    var evicted: str
    var putOk: bool
    lruCachePut(h, "key1", "value1", evicted, putOk)
    if !checkEqBool(putOk, true):
        ok = false
    if !checkEqStr(evicted, ""):
        ok = false
    var got: str
    var getOk: bool
    lruCacheGet(h, "key1", got, getOk)
    if !checkEqBool(getOk, true):
        ok = false
    if !checkEqStr(got, "value1"):
        ok = false
    if ok:
        echo("testPutGet ok")
    return ok

fn testUpdateExisting(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k", "v1", evicted, putOk)
    lruCachePut(h, "k", "v2", evicted, putOk)
    if !checkEqBool(putOk, true):
        ok = false
    var got: str
    var getOk: bool
    lruCacheGet(h, "k", got, getOk)
    if !checkEqBool(getOk, true):
        ok = false
    if !checkEqStr(got, "v2"):
        ok = false
    if ok:
        echo("testUpdateExisting ok")
    return ok

fn testGetNonExistent(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var got: str
    var getOk: bool
    lruCacheGet(h, "nonexistent", got, getOk)
    if !checkEqBool(getOk, false):
        ok = false
    if ok:
        echo("testGetNonExistent ok")
    return ok

fn testRemove(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "key1", "val1", evicted, putOk)
    var rmOk: bool
    lruCacheRemove(h, "key1", rmOk)
    if !checkEqBool(rmOk, true):
        ok = false
    var got: str
    var getOk: bool
    lruCacheGet(h, "key1", got, getOk)
    if !checkEqBool(getOk, false):
        ok = false
    if ok:
        echo("testRemove ok")
    return ok

fn testRemoveNonExistent(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var rmOk: bool
    lruCacheRemove(h, "no_such_key", rmOk)
    if !checkEqBool(rmOk, false):
        ok = false
    if ok:
        echo("testRemoveNonExistent ok")
    return ok

fn testCapacityEviction(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    # Fill with 3 entries
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    if !checkEqStr(evicted, ""):
        ok = false
    # 4th entry should evict "a" (LRU)
    lruCachePut(h, "d", "4", evicted, putOk)
    if !checkEqBool(putOk, true):
        ok = false
    if !checkEqStr(evicted, "a"):
        ok = false
    # "a" should be gone
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, false):
        ok = false
    # "d" should be present
    lruCacheGet(h, "d", got, getOk)
    if !checkEqBool(getOk, true):
        ok = false
    if ok:
        echo("testCapacityEviction ok")
    return ok

fn testLruOrdering(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    # Insert a, b, c
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Access "a", making "b" the LRU
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    # Insert "d" — should evict "b"
    lruCachePut(h, "d", "4", evicted, putOk)
    if !checkEqStr(evicted, "b"):
        ok = false
    if ok:
        echo("testLruOrdering ok")
    return ok

fn testClear(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k1", "v1", evicted, putOk)
    lruCachePut(h, "k2", "v2", evicted, putOk)
    lruCacheClear(h)
    var got: str
    var getOk: bool
    lruCacheGet(h, "k1", got, getOk)
    if !checkEqBool(getOk, false):
        ok = false
    lruCacheGet(h, "k2", got, getOk)
    if !checkEqBool(getOk, false):
        ok = false
    # Cache should still accept new entries after clear
    lruCachePut(h, "k3", "v3", evicted, putOk)
    if !checkEqBool(putOk, true):
        ok = false
    lruCacheGet(h, "k3", got, getOk)
    if !checkEqStr(got, "v3"):
        ok = false
    if ok:
        echo("testClear ok")
    return ok

fn testMultipleCaches(): bool =
    var ok: bool = true
    let h1 = lruCacheNew(4)
    let h2 = lruCacheNew(4)
    var evicted: str
    var putOk: bool
    lruCachePut(h1, "shared", "from1", evicted, putOk)
    lruCachePut(h2, "shared", "from2", evicted, putOk)
    var got: str
    var getOk: bool
    lruCacheGet(h1, "shared", got, getOk)
    if !checkEqStr(got, "from1"):
        ok = false
    lruCacheGet(h2, "shared", got, getOk)
    if !checkEqStr(got, "from2"):
        ok = false
    if ok:
        echo("testMultipleCaches ok")
    return ok

# ── Edge case eviction ordering tests ────────────────────────────────

fn testCapacityOne(): bool =
    var ok: bool = true
    let h = lruCacheNew(1)
    var evicted: str
    var putOk: bool
    # Insert one entry
    lruCachePut(h, "a", "1", evicted, putOk)
    if !checkEqBool(putOk, true): ok = false
    if !checkEqStr(evicted, ""): ok = false
    # Second entry should evict "a"
    lruCachePut(h, "b", "2", evicted, putOk)
    if !checkEqBool(putOk, true): ok = false
    if !checkEqStr(evicted, "a"): ok = false
    # "a" is gone
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    # "b" is present
    lruCacheGet(h, "b", got, getOk)
    if !checkEqStr(got, "2"): ok = false
    if ok:
        echo("testCapacityOne ok")
    return ok

fn testEvictionOrderAccessAll(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Access all in reverse order: c, b, a
    var got: str
    var getOk: bool
    lruCacheGet(h, "c", got, getOk)
    lruCacheGet(h, "b", got, getOk)
    lruCacheGet(h, "a", got, getOk)
    # Now "c" is LRU, insert "d" should evict "c"
    lruCachePut(h, "d", "4", evicted, putOk)
    if !checkEqStr(evicted, "c"): ok = false
    # "d" present
    lruCacheGet(h, "d", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    # "c" evicted
    lruCacheGet(h, "c", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    if ok:
        echo("testEvictionOrderAccessAll ok")
    return ok

fn testRemoveLruThenFill(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Remove LRU ("a")
    var rmOk: bool
    lruCacheRemove(h, "a", rmOk)
    if !checkEqBool(rmOk, true): ok = false
    # Fill with "d" — no eviction since capacity=3, only 2 entries (b,c)
    lruCachePut(h, "d", "4", evicted, putOk)
    if !checkEqStr(evicted, ""): ok = false
    # Now full (b,c,d). Put "e" should evict LRU "b"
    lruCachePut(h, "e", "5", evicted, putOk)
    if !checkEqStr(evicted, "b"): ok = false
    var got: str
    var getOk: bool
    lruCacheGet(h, "b", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    lruCacheGet(h, "e", got, getOk)
    if !checkEqStr(got, "5"): ok = false
    if ok:
        echo("testRemoveLruThenFill ok")
    return ok

fn testEvictionInterleavedAccess(): bool =
    var ok: bool = true
    let h = lruCacheNew(4)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    lruCachePut(h, "d", "4", evicted, putOk)
    # Access "a" (making "b" LRU), then access "b" (making "c" LRU)
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    lruCacheGet(h, "b", got, getOk)
    # Insert "e" — should evict "c" (LRU after a,b were accessed)
    lruCachePut(h, "e", "5", evicted, putOk)
    if !checkEqStr(evicted, "c"): ok = false
    # "c" should be gone
    lruCacheGet(h, "c", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    if ok:
        echo("testEvictionInterleavedAccess ok")
    return ok

# ── Cache statistics tests ────────────────────────────────────────────

fn testStatsInitial(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var hits: int32
    var misses: int32
    var evictions: int32
    lruCacheStats(h, hits, misses, evictions)
    if !checkEqI32(hits, 0): ok = false
    if !checkEqI32(misses, 0): ok = false
    if !checkEqI32(evictions, 0): ok = false
    if ok:
        echo("testStatsInitial ok")
    return ok

fn testStatsHitIncrement(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k", "v", evicted, putOk)
    var got: str
    var getOk: bool
    lruCacheGet(h, "k", got, getOk)
    var hits: int32
    var misses: int32
    var evictions: int32
    lruCacheStats(h, hits, misses, evictions)
    if !checkEqI32(hits, 1): ok = false
    if !checkEqI32(misses, 0): ok = false
    if ok:
        echo("testStatsHitIncrement ok")
    return ok

fn testStatsMissIncrement(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var got: str
    var getOk: bool
    lruCacheGet(h, "nonexistent", got, getOk)
    var hits: int32
    var misses: int32
    var evictions: int32
    lruCacheStats(h, hits, misses, evictions)
    if !checkEqI32(hits, 0): ok = false
    if !checkEqI32(misses, 1): ok = false
    if ok:
        echo("testStatsMissIncrement ok")
    return ok

fn testStatsEvictionIncrement(): bool =
    var ok: bool = true
    let h = lruCacheNew(2)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    # Third entry should evict "a"
    lruCachePut(h, "c", "3", evicted, putOk)
    var hits: int32
    var misses: int32
    var evictions: int32
    lruCacheStats(h, hits, misses, evictions)
    if !checkEqI32(evictions, 1): ok = false
    if ok:
        echo("testStatsEvictionIncrement ok")
    return ok

fn testStatsMultipleCaches(): bool =
    var ok: bool = true
    let h1 = lruCacheNew(4)
    let h2 = lruCacheNew(4)
    # h1: miss, miss (2)
    var got: str
    var getOk: bool
    lruCacheGet(h1, "x", got, getOk)
    lruCacheGet(h1, "y", got, getOk)
    # h2: no ops
    var h1hits: int32
    var h1misses: int32
    var h1evictions: int32
    var h2hits: int32
    var h2misses: int32
    var h2evictions: int32
    lruCacheStats(h1, h1hits, h1misses, h1evictions)
    lruCacheStats(h2, h2hits, h2misses, h2evictions)
    if !checkEqI32(h1misses, 2): ok = false
    if !checkEqI32(h2misses, 0): ok = false
    if ok:
        echo("testStatsMultipleCaches ok")
    return ok

# ── Cache peek tests ─────────────────────────────────────────────────

fn testPeekReturnsValue(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k", "v", evicted, putOk)
    var got: str
    var getOk: bool
    lruCachePeek(h, "k", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    if !checkEqStr(got, "v"): ok = false
    if ok:
        echo("testPeekReturnsValue ok")
    return ok

fn testPeekNonExistent(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var got: str
    var getOk: bool
    lruCachePeek(h, "nosuch", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    if ok:
        echo("testPeekNonExistent ok")
    return ok

fn testPeekDoesNotUpdateLruOrder(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Peek "a" — should NOT update LRU order, so "a" remains LRU
    var got: str
    var getOk: bool
    lruCachePeek(h, "a", got, getOk)
    # Insert "d" — should evict "a" (still LRU since peek didn't update time)
    lruCachePut(h, "d", "4", evicted, putOk)
    if !checkEqStr(evicted, "a"): ok = false
    # Verify "a" is gone
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    if ok:
        echo("testPeekDoesNotUpdateLruOrder ok")
    return ok

# ── Cache resize tests ───────────────────────────────────────────────

fn testResizeIncreaseCapacity(): bool =
    var ok: bool = true
    let h = lruCacheNew(2)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    # Resize to 4, then add 2 more without eviction
    var evictedCount: int32
    lruCacheResize(h, 4, evictedCount)
    if !checkEqI32(evictedCount, 0): ok = false
    lruCachePut(h, "c", "3", evicted, putOk)
    lruCachePut(h, "d", "4", evicted, putOk)
    # All 4 should be present
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    lruCacheGet(h, "d", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    if ok:
        echo("testResizeIncreaseCapacity ok")
    return ok

fn testResizeDecreaseCapacityEvictsLru(): bool =
    var ok: bool = true
    let h = lruCacheNew(5)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Resize to 2 — should evict "a" (LRU)
    var evictedCount: int32
    lruCacheResize(h, 2, evictedCount)
    if !checkEqI32(evictedCount, 1): ok = false
    # "a" should be gone, "b" and "c" remain
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, false): ok = false
    lruCacheGet(h, "b", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    lruCacheGet(h, "c", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    if ok:
        echo("testResizeDecreaseCapacityEvictsLru ok")
    return ok

fn testResizeToZeroIsNoop(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    var evictedCount: int32
    lruCacheResize(h, 0, evictedCount)
    if !checkEqI32(evictedCount, 0): ok = false
    # Cache should still work with original capacity
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    if !checkEqBool(getOk, true): ok = false
    if ok:
        echo("testResizeToZeroIsNoop ok")
    return ok

fn testStatsAfterResize(): bool =
    var ok: bool = true
    let h = lruCacheNew(3)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    lruCachePut(h, "c", "3", evicted, putOk)
    # Get "a" — 1 hit
    var got: str
    var getOk: bool
    lruCacheGet(h, "a", got, getOk)
    # Get "x" — 1 miss
    lruCacheGet(h, "x", got, getOk)
    # Resize to 2 — evicts 1 (b is LRU)
    var evictedCount: int32
    lruCacheResize(h, 2, evictedCount)
    # Stats should reflect hits=1, misses=1, evictions=1
    var hits: int32
    var misses: int32
    var evictions: int32
    lruCacheStats(h, hits, misses, evictions)
    if !checkEqI32(hits, 1): ok = false
    if !checkEqI32(misses, 1): ok = false
    if !checkEqI32(evictions, 1): ok = false
    if !checkEqI32(evictedCount, 1): ok = false
    if ok:
        echo("testStatsAfterResize ok")
    return ok

# ── GetOrInsert tests ──────────────────────────────────────────────────────

fn testGetOrInsertExisting(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k", "existing", evicted, putOk)
    var value: str
    var inserted: bool
    lruCacheGetOrInsert(h, "k", "fallback", value, inserted)
    if !checkEqStr(value, "existing"): ok = false
    if inserted:
        echo("FAIL: should not have inserted for existing key")
        ok = false
    if ok:
        echo("testGetOrInsertExisting ok")
    return ok

fn testGetOrInsertMissing(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var value: str
    var inserted: bool
    lruCacheGetOrInsert(h, "k", "fallback", value, inserted)
    if !checkEqStr(value, "fallback"): ok = false
    if !inserted:
        echo("FAIL: should have inserted for missing key")
        ok = false
    # Verify it's actually in cache now
    var got: str
    var getOk: bool
    lruCacheGet(h, "k", got, getOk)
    if !checkEqStr(got, "fallback"): ok = false
    if ok:
        echo("testGetOrInsertMissing ok")
    return ok

fn testGetOrInsertOverwriteExisting(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "k", "original", evicted, putOk)
    var value: str
    var inserted: bool
    # Should return original, not fallback, and not insert
    lruCacheGetOrInsert(h, "k", "fallback", value, inserted)
    if !checkEqStr(value, "original"): ok = false
    if inserted:
        echo("FAIL: should not have inserted for existing key")
        ok = false
    # Value should still be original
    var got: str
    var getOk: bool
    lruCacheGet(h, "k", got, getOk)
    if !checkEqStr(got, "original"): ok = false
    if ok:
        echo("testGetOrInsertOverwriteExisting ok")
    return ok

fn testLruCacheToArray(): bool =
    var ok: bool = true
    let h = lruCacheNew(8)
    var evicted: str
    var putOk: bool
    lruCachePut(h, "a", "1", evicted, putOk)
    lruCachePut(h, "b", "2", evicted, putOk)
    let result = lruCacheToArray(h)
    # Should contain keys "a" and "b", and values "1" and "2"
    if result == "":
        echo("FAIL: lruCacheToArray should not be empty")
        ok = false
    if ok:
        echo("testLruCacheToArray ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testNewCache():
        allOk = false
    if !testPutGet():
        allOk = false
    if !testUpdateExisting():
        allOk = false
    if !testGetNonExistent():
        allOk = false
    if !testRemove():
        allOk = false
    if !testRemoveNonExistent():
        allOk = false
    if !testCapacityEviction():
        allOk = false
    if !testLruOrdering():
        allOk = false
    if !testClear():
        allOk = false
    if !testMultipleCaches():
        allOk = false
    if !testCapacityOne():
        allOk = false
    if !testEvictionOrderAccessAll():
        allOk = false
    if !testRemoveLruThenFill():
        allOk = false
    if !testEvictionInterleavedAccess():
        allOk = false
    if !testStatsInitial():
        allOk = false
    if !testStatsHitIncrement():
        allOk = false
    if !testStatsMissIncrement():
        allOk = false
    if !testStatsEvictionIncrement():
        allOk = false
    if !testStatsMultipleCaches():
        allOk = false
    if !testPeekReturnsValue():
        allOk = false
    if !testPeekNonExistent():
        allOk = false
    if !testPeekDoesNotUpdateLruOrder():
        allOk = false
    if !testResizeIncreaseCapacity():
        allOk = false
    if !testResizeDecreaseCapacityEvictsLru():
        allOk = false
    if !testResizeToZeroIsNoop():
        allOk = false
    if !testStatsAfterResize():
        allOk = false
    if !testGetOrInsertExisting():
        allOk = false
    if !testGetOrInsertMissing():
        allOk = false
    if !testGetOrInsertOverwriteExisting():
        allOk = false
    if !testLruCacheToArray():
        allOk = false
    if allOk:
        echo("rust_csg_lru_cache_smoke ok")
        return 0
    else:
        echo("rust_csg_lru_cache_smoke FAILED")
        return 1
