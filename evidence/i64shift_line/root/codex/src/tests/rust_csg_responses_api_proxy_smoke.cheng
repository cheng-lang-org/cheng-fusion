import cheng/codex/crates/responses_api_proxy/responses_api_proxy as rap
import std/strings

# ═══════════════════════════════════════════════════════════════════════════════
# Responses API Proxy — type definition constants smoke test
#
# Ported from codex-rs/responses-api-proxy
# ═══════════════════════════════════════════════════════════════════════════════

fn testArgsFieldCount(): bool =
    if rap.RustCsgArgsFieldCount != 5: return false
    if rap.RustCsgArgsField1 != "port": return false
    if rap.RustCsgArgsField2 != "server_info": return false
    if rap.RustCsgArgsField5 != "dump_dir": return false
    echo("testArgsFieldCount ok")
    return true

fn testExchangeDumperFieldCount(): bool =
    if rap.RustCsgExchangeDumperFieldCount != 2: return false
    if rap.RustCsgExchangeDumperField1 != "dump_dir": return false
    if rap.RustCsgExchangeDumperField2 != "next_sequence": return false
    echo("testExchangeDumperFieldCount ok")
    return true

fn testExchangeDumperMethodCount(): bool =
    if rap.RustCsgExchangeDumperMethodCount != 2: return false
    if rap.RustCsgExchangeDumperMethod1 != "new": return false
    if rap.RustCsgExchangeDumperMethod2 != "dump_request": return false
    echo("testExchangeDumperMethodCount ok")
    return true

fn testRequestDumpFieldCount(): bool =
    if rap.RustCsgRequestDumpFieldCount != 4: return false
    if rap.RustCsgRequestDumpField1 != "method": return false
    if rap.RustCsgRequestDumpField4 != "body": return false
    echo("testRequestDumpFieldCount ok")
    return true

fn testResponseDumpFieldCount(): bool =
    if rap.RustCsgResponseDumpFieldCount != 3: return false
    if rap.RustCsgResponseDumpField1 != "status": return false
    if rap.RustCsgResponseDumpField3 != "body": return false
    echo("testResponseDumpFieldCount ok")
    return true

fn testHeaderDumpFieldCount(): bool =
    if rap.RustCsgHeaderDumpFieldCount != 2: return false
    if rap.RustCsgHeaderDumpField1 != "name": return false
    if rap.RustCsgHeaderDumpField2 != "value": return false
    echo("testHeaderDumpFieldCount ok")
    return true

fn testFunctionCount(): bool =
    if rap.RustCsgResponsesApiProxyFunctionCount != 4: return false
    if rap.RustCsgResponsesApiProxyFunction1 != "run_main": return false
    if rap.RustCsgResponsesApiProxyFunction4 != "forward_request": return false
    echo("testFunctionCount ok")
    return true

fn testFieldsFns(): bool =
    if rap.ArgsFields() != "port|opt_u16,server_info|opt_path_buf,http_shutdown|bool,upstream_url|str,dump_dir|opt_path_buf": return false
    if rap.ExchangeDumperFields() != "dump_dir|path_buf,next_sequence|atomic_u64": return false
    if rap.RequestDumpFields() != "method|str,url|str,headers|vec_header_dump,body|json_value": return false
    echo("testFieldsFns ok")
    return true

fn testFormatProxyResponse(): bool =
    var resp: str = rap.formatProxyResponse(200, "{\"ok\":true}")
    if resp.len == 0: return false
    if !strings.StrContains(resp, "200"): return false
    if !strings.StrContains(resp, "{\"ok\":true}"): return false
    if !strings.StrContains(resp, "HTTP/1.1"): return false
    echo("testFormatProxyResponse ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testArgsFieldCount(): allOk = false
    if !testExchangeDumperFieldCount(): allOk = false
    if !testExchangeDumperMethodCount(): allOk = false
    if !testRequestDumpFieldCount(): allOk = false
    if !testResponseDumpFieldCount(): allOk = false
    if !testHeaderDumpFieldCount(): allOk = false
    if !testFunctionCount(): allOk = false
    if !testFieldsFns(): allOk = false
    if !testFormatProxyResponse(): allOk = false
    if allOk:
        echo("rust_csg_responses_api_proxy_smoke ok")
        return 0
    echo("rust_csg_responses_api_proxy_smoke FAILED")
    return 1
