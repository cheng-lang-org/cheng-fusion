import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_minimal_oracle as oracle

fn RustCsgTuiChatwidgetMinimalOracleCheck(path: str,
                                           expectedSource: str,
                                           expectedExpression: str,
                                           fixture: str,
                                           name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(strings.Len(fixture)), " got=", strings.IntToStr(s.bodyByteLen)], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 16:
        echo("FAIL usage: rust_csg_tui_chatwidget_minimal_oracle_smoke <15 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallIdleH1Snapshot(), "chat_small_idle_h1")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallIdleH2Snapshot(), "chat_small_idle_h2")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallIdleH3Snapshot(), "chat_small_idle_h3")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallRunningH1Snapshot(), "chat_small_running_h1")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallRunningH2Snapshot(), "chat_small_running_h2")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetMinimalChatSmallRunningH3Snapshot(), "chat_small_running_h3")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "header", oracle.RustCsgTuiChatwidgetMinimalReconnectFooterRowSnapshot(), "replayed_interrupted_reconnect_footer_row")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "blob", oracle.RustCsgTuiChatwidgetMinimalUserShellLsOutputSnapshot(), "user_shell_ls_output")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "blob", oracle.RustCsgTuiChatwidgetMinimalDisabledSlashCommandSnapshot(), "disabled_slash_command_while_task_running")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep1StartLsSnapshot(), "exploring_step1_start_ls")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep2FinishLsSnapshot(), "exploring_step2_finish_ls")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep3StartCatFooSnapshot(), "exploring_step3_start_cat_foo")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep4FinishCatFooSnapshot(), "exploring_step4_finish_cat_foo")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep5FinishSedRangeSnapshot(), "exploring_step5_finish_sed_range")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatwidgetMinimalOracleCheck(cmdline.argStr(argIdx), "tui/src/chatwidget/tests.rs", "active_blob(&chat)", oracle.RustCsgTuiChatwidgetMinimalExploringStep6FinishCatBarSnapshot(), "exploring_step6_finish_cat_bar")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_minimal_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_minimal_oracle_smoke FAILED")
    return exitCode
