import std/cmdline
import std/strings as strutil
import cheng/codex/tui/markdown_oracle as markdown
import cheng/codex/src/tui/oracle_snapshot as snap
import cheng/codex/tui/status_indicator as status
import cheng/codex/tui/startup_hooks_review as hooks

# ── Inlined fixture helpers ──────────────────────────────────────────────────
# (Cold provider can't resolve separate oracle module objects, so we inline.)

fn RustCsgTuiWidgetOracleCheck(path: str, expectedSource: str, expectedExpr: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpr:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture.len == 0:
        echo(strutil.Join(["FAIL: ", name, " empty fixture"], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch (expected ", strings.IntToStr(s.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(fixture)), ")"], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

# ── startup_hooks_review ──
# source: tui/src/startup_hooks_review.rs
# expression: "render_lines(&view, 80)"

fn main(): int32 =
    if cmdline.argCount() != 7:
        echo("FAIL usage: rust_csg_tui_widget_oracle_smoke <6 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    # ── status_indicator_widget ────────────────────────────────────────────
    # 1. renders_truncated
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/status_indicator_widget.rs",
        "terminal.backend()",
        status.RustCsgTuiStatusIndicatorRenderTruncatedSnapshot(),
        "status_indicator_renders_truncated")
    argIdx = argIdx + 1

    # 2. renders_with_queued_messages
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/status_indicator_widget.rs",
        "terminal.backend()",
        status.RustCsgTuiStatusIndicatorRenderQueuedMessagesSnapshot(),
        "status_indicator_renders_with_queued_messages")
    argIdx = argIdx + 1

    # 3. renders_with_queued_messages@macos
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/status_indicator_widget.rs",
        "terminal.backend()",
        status.RustCsgTuiStatusIndicatorRenderQueuedMessagesMacOsSnapshot(),
        "status_indicator_renders_with_queued_messages_macos")
    argIdx = argIdx + 1
    # 4. renders_with_working_header
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/status_indicator_widget.rs",
        "terminal.backend()",
        status.RustCsgTuiStatusIndicatorRenderWorkingHeaderSnapshot(),
        "status_indicator_renders_with_working_header")
    argIdx = argIdx + 1

    # 5. renders_wrapped_details_panama_two_lines
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/status_indicator_widget.rs",
        "terminal.backend()",
        status.RustCsgTuiStatusIndicatorRenderWrappedDetailsSnapshot(),
        "status_indicator_renders_wrapped_details")
    argIdx = argIdx + 1

    # ── markdown_render_complex ────────────────────────────────────────────
    # 8. markdown_render_complex
    exitCode = exitCode + RustCsgTuiWidgetOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/markdown_render_tests.rs",
        "rendered",
        markdown.RustCsgTuiMarkdownRenderComplexSnapshot(),
        "markdown_render_complex")
    argIdx = argIdx + 1

    if exitCode == 0:
        echo("rust_csg_tui_widget_oracle_smoke ok")
    else:
        echo("rust_csg_tui_widget_oracle_smoke FAILED")
    return exitCode
