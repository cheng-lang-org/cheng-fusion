import cheng/codex/crates/shell_command/shell_command as m

fn main(): int32 =
    var pass: int32

    # ShellTypeToString
    if m.RustCsgShellTypeToString(0) == "zsh": pass = pass + 1
    if m.RustCsgShellTypeToString(1) == "bash": pass = pass + 1
    if m.RustCsgShellTypeToString(2) == "sh": pass = pass + 1
    if m.RustCsgShellTypeToString(3) == "powershell": pass = pass + 1
    if m.RustCsgShellTypeToString(4) == "cmd": pass = pass + 1
    if m.RustCsgShellTypeToString(5) == "unknown": pass = pass + 1
    if m.RustCsgShellTypeToString(99) == "unknown": pass = pass + 1

    # DetectShellType
    if m.RustCsgDetectShellType("bash") == 1: pass = pass + 1
    if m.RustCsgDetectShellType("zsh") == 0: pass = pass + 1
    if m.RustCsgDetectShellType("pwsh") == 3: pass = pass + 1
    if m.RustCsgDetectShellType("") == 5: pass = pass + 1

    if pass == 11:
        echo("rust_csg_oracle_shell_command ok")
        return 0
    echo("oracle FAIL")
    return 1

main()