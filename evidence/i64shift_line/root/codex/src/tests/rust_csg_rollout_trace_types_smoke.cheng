    var ok: bool = true
    if !checkEqI32(RustCsgRolloutStatusRunning, 0): ok = false
    if !checkEqI32(RustCsgRolloutStatusCompleted, 1): ok = false
    if !checkEqI32(RustCsgRolloutStatusFailed, 2): ok = false
    if !checkEqI32(RustCsgRolloutStatusAborted, 3): ok = false
    if ok:
        echo("testRolloutStatusConstants ok")
    return ok

