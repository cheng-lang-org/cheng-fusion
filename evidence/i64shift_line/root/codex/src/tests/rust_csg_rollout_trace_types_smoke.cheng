# ── Wire string constants (function-based for cold compiler compat) ──────
fn RustCsgWireRolloutStarted(): str = "rollout_started"
fn RustCsgWireRolloutEnded(): str = "rollout_ended"
fn RustCsgWireThreadStarted(): str = "thread_started"
fn RustCsgWireThreadEnded(): str = "thread_ended"
fn RustCsgWireCodexTurnStarted(): str = "codex_turn_started"
fn RustCsgWireCodexTurnEnded(): str = "codex_turn_ended"
fn RustCsgWireInferenceStarted(): str = "inference_started"
fn RustCsgWireInferenceCompleted(): str = "inference_completed"
fn RustCsgWireInferenceFailed(): str = "inference_failed"
fn RustCsgWireToolCallStarted(): str = "tool_call_started"
fn RustCsgWireToolCallEnded(): str = "tool_call_ended"
fn RustCsgWireCodeCellStarted(): str = "code_cell_started"
fn RustCsgWireCodeCellEnded(): str = "code_cell_ended"

fn RustCsgRolloutTraceFormatSpan(traceId: str, spanId: str, duration: int32): str =
    var out = strings.ConcatStr("trace_id=", traceId)
    out = strings.ConcatStr(out, " span_id=")
    out = strings.ConcatStr(out, spanId)
    out = strings.ConcatStr(out, " duration=")
    out = strings.ConcatStr(out, strings.IntToStr(duration))
    out = strings.ConcatStr(out, "ms")
    return out

