fn testWireStringConstants(): bool =
    var ok: bool = true
    if RustCsgWireRolloutStarted() != "rollout_started":
        echo("FAIL: RustCsgWireRolloutStarted expected=rollout_started"); ok = false
    if RustCsgWireRolloutEnded() != "rollout_ended":
        echo("FAIL: RustCsgWireRolloutEnded expected=rollout_ended"); ok = false
    if RustCsgWireThreadStarted() != "thread_started":
        echo("FAIL: RustCsgWireThreadStarted expected=thread_started"); ok = false
    if RustCsgWireThreadEnded() != "thread_ended":
        echo("FAIL: RustCsgWireThreadEnded expected=thread_ended"); ok = false
    if RustCsgWireCodexTurnStarted() != "codex_turn_started":
        echo("FAIL: RustCsgWireCodexTurnStarted expected=codex_turn_started"); ok = false
    if RustCsgWireCodexTurnEnded() != "codex_turn_ended":
        echo("FAIL: RustCsgWireCodexTurnEnded expected=codex_turn_ended"); ok = false
    if RustCsgWireInferenceStarted() != "inference_started":
        echo("FAIL: RustCsgWireInferenceStarted expected=inference_started"); ok = false
    if RustCsgWireInferenceCompleted() != "inference_completed":
        echo("FAIL: RustCsgWireInferenceCompleted expected=inference_completed"); ok = false
    if RustCsgWireInferenceFailed() != "inference_failed":
        echo("FAIL: RustCsgWireInferenceFailed expected=inference_failed"); ok = false
    if RustCsgWireToolCallStarted() != "tool_call_started":
        echo("FAIL: RustCsgWireToolCallStarted expected=tool_call_started"); ok = false
    if RustCsgWireToolCallEnded() != "tool_call_ended":
        echo("FAIL: RustCsgWireToolCallEnded expected=tool_call_ended"); ok = false
    if RustCsgWireCodeCellStarted() != "code_cell_started":
        echo("FAIL: RustCsgWireCodeCellStarted expected=code_cell_started"); ok = false
    if RustCsgWireCodeCellEnded() != "code_cell_ended":
        echo("FAIL: RustCsgWireCodeCellEnded expected=code_cell_ended"); ok = false
    if ok:
        echo("testWireStringConstants ok")
    return ok

# ── Rollout reader function tests ────────────────────────────────────────

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testBuildRolloutPath(): bool =
    var ok: bool = true
    let path = reader.RustCsgRolloutBuildRolloutPath("/home/user/.codex", "abc123")
    if !checkEqStr(path, "/home/user/.codex/rollout/abc123.jsonl", "buildRolloutPath basic"):
        ok = false
    # Edge: empty codexHome
    let path2 = reader.RustCsgRolloutBuildRolloutPath("", "abc")
    if !checkEqStr(path2, "", "buildRolloutPath empty home"):
        ok = false
    # Edge: empty sessionId
    let path3 = reader.RustCsgRolloutBuildRolloutPath("/home", "")
    if !checkEqStr(path3, "", "buildRolloutPath empty session"):
        ok = false
    # Edge: both empty
    let path4 = reader.RustCsgRolloutBuildRolloutPath("", "")
    if !checkEqStr(path4, "", "buildRolloutPath both empty"):
        ok = false
    if ok:
        echo("testBuildRolloutPath ok")
    return ok

fn testParseRolloutLine(): bool =
    var ok: bool = true
    # Session meta line
    let sm = "{\"timestamp\":\"2024-01-01T00:00:00Z\",\"type\":\"session_meta\",\"payload\":{\"id\":\"s1\"}}"
    let result = reader.RustCsgRolloutParseRolloutLine(sm)
    if !checkEqStr(result, "session_meta", "parseRolloutLine session_meta"):
        ok = false
    # Turn context line
    let tc = "{\"timestamp\":\"2024-01-01T00:00:01Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"/home\"}}"
    let result2 = reader.RustCsgRolloutParseRolloutLine(tc)
    if !checkEqStr(result2, "turn_context", "parseRolloutLine turn_context"):
        ok = false
    # Event line
    let ev = "{\"timestamp\":\"2024-01-01T00:00:02Z\",\"type\":\"event_msg\",\"payload\":{\"message\":\"hello\"}}"
    let result3 = reader.RustCsgRolloutParseRolloutLine(ev)
    if !checkEqStr(result3, "event_msg", "parseRolloutLine event_msg"):
        ok = false
    # Edge: empty line
    let result4 = reader.RustCsgRolloutParseRolloutLine("")
    if !checkEqStr(result4, "", "parseRolloutLine empty"):
        ok = false
    # Edge: unknown type
    let uk = "{\"timestamp\":\"x\",\"type\":\"unknown_type\",\"payload\":{}}"
    let result5 = reader.RustCsgRolloutParseRolloutLine(uk)
    if !checkEqStr(result5, "unknown", "parseRolloutLine unknown"):
        ok = false
    # Edge: malformed JSON
    let result6 = reader.RustCsgRolloutParseRolloutLine("not json")
    if !checkEqStr(result6, "unknown", "parseRolloutLine malformed"):
        ok = false
    if ok:
        echo("testParseRolloutLine ok")
    return ok

fn testClassifyRawEvent(): bool =
    var ok: bool = true
    # Inference events
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("inference_started"), "Inference", "classify inference_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("inference_completed"), "Inference", "classify inference_completed"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("inference_failed"), "Inference", "classify inference_failed"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("inference_cancelled"), "Inference", "classify inference_cancelled"): ok = false
    # Compaction events
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("compaction_request_started"), "Compaction", "classify compaction_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("compaction_request_completed"), "Compaction", "classify compaction_completed"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("compaction_request_failed"), "Compaction", "classify compaction_failed"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("compaction_installed"), "Compaction", "classify compaction_installed"): ok = false
    # ToolDispatch events
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("tool_call_started"), "ToolDispatch", "classify tool_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("tool_call_runtime_started"), "ToolDispatch", "classify tool_runtime_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("tool_call_runtime_ended"), "ToolDispatch", "classify tool_runtime_ended"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("tool_call_ended"), "ToolDispatch", "classify tool_ended"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("code_cell_started"), "ToolDispatch", "classify code_cell_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("code_cell_initial_response"), "ToolDispatch", "classify code_cell_response"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("code_cell_ended"), "ToolDispatch", "classify code_cell_ended"): ok = false
    # McpCall events
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("mcp_tool_call_correlation_assigned"), "McpCall", "classify mcp_assigned"): ok = false
    # Unknown events
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("rollout_started"), "Unknown", "classify rollout_started"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("thread_ended"), "Unknown", "classify thread_ended"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent(""), "Unknown", "classify empty"): ok = false
    if !checkEqStr(reader.RustCsgRolloutClassifyRawEvent("unknown_type"), "Unknown", "classify unknown"): ok = false
    if ok:
        echo("testClassifyRawEvent ok")
    return ok

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testRolloutStatusConstants(): allOk = false
    if !testExecutionStatusConstants(): allOk = false
    if !testToolCallKindConstants(): allOk = false
    if !testRawTraceEventPayloadConstants(): allOk = false
    if !testRawPayloadKindConstants(): allOk = false
    if !testCodeCellRuntimeStatusConstants(): allOk = false
    if !testConversationRoleConstants(): allOk = false
    if !testConversationChannelConstants(): allOk = false
    if !testConversationItemKindConstants(): allOk = false
    if !testSchemaVersionConstants(): allOk = false
    if !testToolCallRequesterConstants(): allOk = false
    if !testRawToolCallRequesterConstants(): allOk = false
    if !testTerminalOperationKindConstants(): allOk = false
    if !testAgentOriginConstants(): allOk = false
    if !testInteractionEdgeKindConstants(): allOk = false
    if !testTerminalObservationSourceConstants(): allOk = false
    if !testToolCallSummaryConstants(): allOk = false
    if !testProducerRefConstants(): allOk = false
    if !testTraceAnchorConstants(): allOk = false
    if !testConversationPartConstants(): allOk = false
    if !testWireStringConstants(): allOk = false
    if !testBuildRolloutPath(): allOk = false
    if !testParseRolloutLine(): allOk = false
    if !testClassifyRawEvent(): allOk = false

    # Production function: formatSpan
    let span1 = RustCsgRolloutTraceFormatSpan("abc123", "span456", 1500)
    if !strutil.Contains(span1, "trace_id=abc123"):
        echo("FAIL: formatSpan should contain trace_id=abc123")
        allOk = false
    if !strutil.Contains(span1, "span_id=span456"):
        echo("FAIL: formatSpan should contain span_id=span456")
        allOk = false
    if !strutil.Contains(span1, "duration=1500ms"):
        echo("FAIL: formatSpan should contain duration=1500ms")
        allOk = false
    let span2 = RustCsgRolloutTraceFormatSpan("", "", 0)
    if !strutil.Contains(span2, "duration=0ms"):
        echo("FAIL: formatSpan zero duration")
        allOk = false
    if !strutil.Contains(span2, "trace_id="):
        echo("FAIL: formatSpan empty trace_id")
        allOk = false

    if allOk:
        echo("rust_csg_rollout_trace_types_smoke ok")
        return 0
    else:
        echo("rust_csg_rollout_trace_types_smoke FAILED")
        return 1
