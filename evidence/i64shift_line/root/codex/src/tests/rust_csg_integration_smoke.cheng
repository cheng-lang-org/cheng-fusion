# codex end-to-end integration smoke test
#
# Exercises the full chain in a single binary:
#   CLI arguments -> parse -> build request plan -> output JSON
#
# Tests the complete pipeline from arg parsing through session plan construction
# to final JSON output, validating every intermediate data structure.
#
# Note: All assertions are inlined (no helper functions) to avoid a Cheng cold
# backend limitation where top-level helper functions are not emitted to
# primary.o during --emit:exe with provider system link scope.

import cheng/codex/exec/plan
import cheng/codex/exec/session
import cheng/codex/exec/config
import cheng/codex/exec/operation
import cheng/codex/exec/prompt
import cheng/codex/exec/schema
import cheng/codex/exec/resume_lookup
import cheng/codex/config/home
import cheng/codex/config/user_config
import cheng/codex/protocol/wire
import cheng/codex/state/state_db
import cheng/codex/app_server/thread_list

# ── Step 1: Probe all module imports are alive ────────────────────────────

fn testModuleProbes(): bool =
    # wire
    if "" != wire.RustCsgCat("", ""):
        echo("wire_probe")
        return false

    # config
    var configErr: str
    if "true" != config.RustCsgExecConfigValueJsonFromRaw("true", configErr):
        echo("config_probe")
        return false
    if "" != configErr:
        echo("config_probe_err")
        return false

    # schema
    var schemaErr: str
    if !schema.RustCsgExecSchemaValidateJson("{}", schemaErr):
        echo("schema_probe")
        return false

    # prompt
    var promptErr: str
    if "hello" != prompt.RustCsgPromptResolve("hello", promptErr):
        echo("prompt_probe")
        return false

    # home
    if "/codex/test.toml" != home.RustCsgPathJoinChild("/codex", "test.toml"):
        echo("home_probe")
        return false

    # user_config
    if "" != wire.RustCsgJsonFindStr(user_config.RustCsgEmptyUserConfigJson(), "model"):
        echo("user_config_probe")
        return false

    # thread_list
    if "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]" != thread_list.RustCsgThreadListAllSourceKindsJson():
        echo("thread_list_probe")
        return false

    # resume_lookup
    if !resume_lookup.RustCsgExecResumeLookupIsUuid("123e4567-e89b-12d3-a456-426614174000"):
        echo("resume_lookup_probe")
        return false

    # state_db
    let stateDbProbe = state_db.RustCsgStateDbThreadListQueryPlanFromValues("/codex/sqlite",
                                                                           1,
                                                                           "created_at",
                                                                           "desc",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           false,
                                                                           "",
                                                                           "/repo")
    if stateDbProbe.blockedReason != state_db.RustCsgStateDbQueryBlockedReason():
        echo("state_db_probe")
        return false

    return true

# ── Step 2: Full chain: parse args -> build plan -> JSON ──────────────────

fn testRunChain(): bool =
    # ── 2a: Parse "codex exec --model gpt-5 --cd /workspace 'Fix the bug'" ──
    let runArgs: str[] = ["codex-exec", "--model", "gpt-5", "--cd", "/workspace",
                          "Fix the bug"]
    var p = plan.RustCsgExecParseArgs(runArgs)
    if p.parseError != "": echo("2a_parse_error"); return false
    if p.command != "run": echo("2a_command"); return false
    if p.prompt != "Fix the bug": echo("2a_prompt"); return false
    if p.model != "gpt-5": echo("2a_model"); return false
    if p.cwd != "/workspace": echo("2a_cwd"); return false
    if p.json: echo("2a_no_json"); return false

    # Build request plan from parsed plan (full chain: plan -> session)
    let requestPlan = session.RustCsgExecRequestPlanFromPlan(p, "thread-run-test")
    if requestPlan.kind != "startUserTurn": echo("2a_kind"); return false
    if requestPlan.parseError != "": echo("2a_parse_error2"); return false

    # Convert to JSON
    let json = session.RustCsgExecRequestPlanToJson(requestPlan)
    if wire.RustCsgJsonFindStr(json, "kind") != "startUserTurn":
        echo("2a_json_kind"); return false
    if wire.RustCsgJsonFindStr(json, "method") != "thread/start":
        echo("2a_json_method"); return false
    if !wire.RustCsgContains(json, "requestSequence"):
        echo("2a_json_seq"); return false

    # ── 2b: Resume with explicit thread UUID ──
    let resumeArgs: str[] = ["codex-exec", "resume",
                             "00000000-0000-0000-0000-000000000001",
                             "continue work"]
    var p2 = plan.RustCsgExecParseArgs(resumeArgs)
    if p2.parseError != "": echo("2b_parse_error"); return false
    if p2.command != "resume": echo("2b_command"); return false
    if p2.prompt != "continue work": echo("2b_prompt"); return false
    if p2.resumeSessionId != "00000000-0000-0000-0000-000000000001":
        echo("2b_session_id"); return false

    let requestPlan2 = session.RustCsgExecRequestPlanFromPlan(p2, "")
    if requestPlan2.kind != "resumeUserTurn": echo("2b_kind"); return false
    if requestPlan2.parseError != "": echo("2b_parse_error2"); return false

    let json2 = session.RustCsgExecRequestPlanToJson(requestPlan2)
    if wire.RustCsgJsonFindStr(json2, "kind") != "resumeUserTurn":
        echo("2b_json_kind"); return false
    if wire.RustCsgJsonFindStr(json2, "method") != "thread/resume":
        echo("2b_json_method"); return false

    # ── 2c: Review with --uncommitted ──
    let reviewArgs: str[] = ["codex-exec", "review", "--uncommitted",
                             "review my changes"]
    var p3 = plan.RustCsgExecParseArgs(reviewArgs)
    if p3.parseError != "": echo("2c_parse_error"); return false
    if p3.command != "review": echo("2c_command"); return false
    if p3.prompt != "review my changes": echo("2c_prompt"); return false
    if !p3.reviewUncommitted: echo("2c_uncommitted"); return false

    let requestPlan3 = session.RustCsgExecRequestPlanFromPlan(p3, "")
    if requestPlan3.kind != "review": echo("2c_kind"); return false
    if requestPlan3.parseError != "": echo("2c_parse_error2"); return false

    let json3 = session.RustCsgExecRequestPlanToJson(requestPlan3)
    if wire.RustCsgJsonFindStr(json3, "kind") != "review":
        echo("2c_json_kind"); return false

    return true

# ── Step 3: Config override parsing and validation ────────────────────────

fn testConfigOverrides(): bool =
    # ── 3a: Config overrides from -c flags ──
    let args: str[] = ["codex-exec",
                       "-c", "model=gpt-5.4",
                       "-c", "approval_policy=on-request",
                       "-c", "approvals_reviewer=auto_review",
                       "-c", "ephemeral=true",
                       "-c", "profile=local",
                       "Fix it"]
    var p = plan.RustCsgExecParseArgs(args)
    if p.parseError != "": echo("3a_parse_error"); return false
    if config.RustCsgExecConfigOverridesBlockedReason(p) != "":
        echo("3a_blocked"); return false

    var configErr: str
    if config.RustCsgExecConfigOverrideStringForKey(p, "model", configErr) != "gpt-5.4":
        echo("3a_model_override"); return false
    if configErr != "": echo("3a_model_err"); return false

    if config.RustCsgExecConfigOverrideStringForKey(p, "approvals_reviewer", configErr) != "auto_review":
        echo("3a_reviewer_override"); return false
    if configErr != "": echo("3a_reviewer_err"); return false

    if config.RustCsgExecConfigOverrideBoolJsonForKey(p, "ephemeral", configErr) != "true":
        echo("3a_ephemeral_json"); return false
    if configErr != "": echo("3a_ephemeral_err"); return false

    if config.RustCsgExecConfigProfileJsonFromPlan(p, configErr) != "{\"profile\":\"local\"}":
        echo("3a_profile_json"); return false
    if configErr != "": echo("3a_profile_err"); return false

    # ── 3b: Unknown config override ──
    let unknownArgs: str[] = ["codex-exec", "-c", "foo=bar", "Fix it"]
    var p2 = plan.RustCsgExecParseArgs(unknownArgs)
    let blockedReason2 = config.RustCsgExecConfigOverridesBlockedReason(p2)
    if wire.RustCsgSliceBytes(blockedReason2, 0, 32) != "config override key not ported: ":
        echo("3b_blocked_prefix"); return false

    # ── 3c: Malformed config override ──
    let malformedArgs: str[] = ["codex-exec", "-c", "model", "Fix it"]
    var p3 = plan.RustCsgExecParseArgs(malformedArgs)
    if config.RustCsgExecConfigOverridesParseError(p3) != "invalid config override: model":
        echo("3c_malformed_error"); return false

    return true

# ── Step 4: Operation classification ──────────────────────────────────────

fn testOperationClassification(): bool =
    # ── 4a: Run operation ──
    let runPlan = plan.RustCsgExecParseArgs([
        "codex-exec", "--model", "gpt-5", "Fix it"])
    let runOp = operation.RustCsgExecInitialOperationFromPlan(runPlan)
    if runOp.kind != "userTurn": echo("4a_operation_kind"); return false

    # ── 4b: Resume operation ──
    let resumePlan = plan.RustCsgExecParseArgs([
        "codex-exec", "resume", "--last", "continue"])
    let resumeOp = operation.RustCsgExecInitialOperationFromPlan(resumePlan)
    if resumeOp.kind != "resumeUserTurn": echo("4b_operation_kind"); return false

    # ── 4c: Review operation ──
    let reviewPlan = plan.RustCsgExecParseArgs([
        "codex-exec", "review", "--uncommitted", "review code"])
    let reviewOp = operation.RustCsgExecInitialOperationFromPlan(reviewPlan)
    if reviewOp.kind != "review": echo("4c_operation_kind"); return false

    return true

# ── Step 5: Thread start and turn start parameter construction ────────────

fn testThreadAndTurnParams(): bool =
    let plan = plan.RustCsgExecParseArgs([
        "codex-exec", "--model", "gpt-5.4", "--cd", "/repo",
        "--sandbox", "workspace-write", "--ephemeral", "Fix it"])

    # ── 5a: Thread start params ──
    let threadStart = session.RustCsgExecThreadStartParamsJsonFromPlan(plan)
    if threadStart != "{\"model\":\"gpt-5.4\",\"cwd\":\"/repo\",\"approvalPolicy\":\"never\",\"approvalsReviewer\":\"user\",\"sandbox\":\"workspace-write\",\"ephemeral\":true,\"sessionStartSource\":\"cli\"}":
        echo("5a_thread_start"); return false

    # ── 5b: Turn start params ──
    let requestPlan = session.RustCsgExecRequestPlanFromPlan(plan, "thread-1")
    if requestPlan.turnStartJson != "{\"threadId\":\"thread-1\",\"input\":[{\"type\":\"text\",\"text\":\"Fix it\",\"textElements\":[]}],\"cwd\":\"/repo\",\"approvalPolicy\":\"never\"}":
        echo("5b_turn_start"); return false

    return true

# ── Step 6: Error handling ────────────────────────────────────────────────

fn testErrorHandling(): bool =
    # ── 6a: Unknown flag ──
    let unknownArgs: str[] = ["codex-exec", "--bogus-flag"]
    var p = plan.RustCsgExecParseArgs(unknownArgs)
    if wire.RustCsgSliceBytes(p.parseError, 0, 19) != "unknown exec flag: ":
        echo("6a_parse_error_prefix"); return false

    # ── 6b: Missing value for --model ──
    let missingArgs: str[] = ["codex-exec", "--model", "--json"]
    var p2 = plan.RustCsgExecParseArgs(missingArgs)
    if !wire.RustCsgContains(p2.parseError, "requires a value"):
        echo("6b_parse_error_content"); return false

    # ── 6c: Empty args (default command) ──
    var emptyArgs: str[]
    var p3 = plan.RustCsgExecParseArgs(emptyArgs)
    if p3.parseError != "": echo("6c_parse_error"); return false
    if p3.command != "run": echo("6c_command"); return false
    if p3.prompt != "": echo("6c_prompt"); return false

    return true

# ── Step 7: JSON roundtrip ────────────────────────────────────────────────

fn assertRoundtrip(name: str, value: plan.RustCsgExecPlan): bool =
    let encoded = plan.RustCsgExecPlanToJson(value)
    let decoded = plan.RustCsgExecPlanFromJson(encoded)
    if encoded != plan.RustCsgExecPlanToJson(decoded):
        echo(name)
        return false
    return true

fn testJsonRoundtrip(): bool =
    # ── 7a: Full run plan roundtrip ──
    let args: str[] = ["codex-exec",
                       "--model", "gpt-5.4",
                       "--cd", "/repo",
                       "--json",
                       "--output-last-message", "/repo/last.txt",
                       "--color", "always",
                       "--ephemeral",
                       "Fix the bug"]
    var p = plan.RustCsgExecParseArgs(args)
    if p.parseError != "": echo("7a_parse_error"); return false
    if !assertRoundtrip("7a_roundtrip", p): return false

    # ── 7b: Resume plan roundtrip ──
    let resumeArgs: str[] = ["codex-exec", "resume", "--last",
                             "--json", "--ephemeral", "continue work"]
    var p2 = plan.RustCsgExecParseArgs(resumeArgs)
    if p2.parseError != "": echo("7b_parse_error"); return false
    if !assertRoundtrip("7b_roundtrip", p2): return false

    return true

# ── Step 8: Full integration chain: session plan to final JSON structure ──

fn testFinalJsonStructure(): bool =
    # Build a complete run plan with all options
    let args: str[] = ["codex-exec",
                       "--model", "claude-opus-5",
                       "--cd", "/home/user/project",
                       "--sandbox", "read-only",
                       "--ephemeral",
                       "--json",
                       "Implement the feature"]
    var p = plan.RustCsgExecParseArgs(args)
    if p.parseError != "": echo("8a_parse_error"); return false

    # Build request plan (the full chain)
    let requestPlan = session.RustCsgExecRequestPlanFromPlan(p, "integration-thread-id")
    if requestPlan.kind != "startUserTurn": echo("8a_kind"); return false
    if requestPlan.threadId != "integration-thread-id": echo("8a_thread_id"); return false

    # Convert to final JSON
    let json = session.RustCsgExecRequestPlanToJson(requestPlan)
    if wire.RustCsgJsonFindStr(json, "kind") != "startUserTurn":
        echo("8a_json_kind"); return false
    if wire.RustCsgJsonFindStr(json, "method") != "thread/start":
        echo("8a_json_method"); return false

    # Verify requestSequence is present
    if !wire.RustCsgContains(json, "requestSequence"):
        echo("8a_seq_present"); return false

    return true

# ── Main: execute all test steps ──────────────────────────────────────────

fn main(): int32 =
    echo("codex integration smoke: begin")
    var allOk: bool = true

    echo("  Step 1: Module probes")
    if !testModuleProbes():
        echo("  FAIL: Step 1")
        allOk = false

    echo("  Step 2: Full chain (run/resume/review)")
    if !testRunChain():
        echo("  FAIL: Step 2")
        allOk = false

    echo("  Step 3: Config overrides")
    if !testConfigOverrides():
        echo("  FAIL: Step 3")
        allOk = false

    echo("  Step 4: Operation classification")
    if !testOperationClassification():
        echo("  FAIL: Step 4")
        allOk = false

    echo("  Step 5: Thread/turn params")
    if !testThreadAndTurnParams():
        echo("  FAIL: Step 5")
        allOk = false

    echo("  Step 6: Error handling")
    if !testErrorHandling():
        echo("  FAIL: Step 6")
        allOk = false

    echo("  Step 7: JSON roundtrip")
    if !testJsonRoundtrip():
        echo("  FAIL: Step 7")
        allOk = false

    echo("  Step 8: Final JSON structure")
    if !testFinalJsonStructure():
        echo("  FAIL: Step 8")
        allOk = false

    if allOk:
        echo("")
        echo("rust_csg_integration_smoke ok")
        return 0

    echo("")
    echo("rust_csg_integration_smoke FAILED")
    return 1
