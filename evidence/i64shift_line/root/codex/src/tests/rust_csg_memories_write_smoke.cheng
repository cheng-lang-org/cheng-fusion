import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: memories/write — extract memory items from conversation text
# ═══════════════════════════════════════════════════════════════════════════════

# Check if the text at position lineStart starts with "Memory:" prefix.
# Using inline char check to avoid const str bugs (finding #23).
fn RustCsgMemoriesWriteLineHasPrefix(text: str, lineStart: int32): bool =
    if lineStart + 7 > text.len:
        return false
    if text[lineStart] != 'M': return false
    if text[lineStart + 1] != 'e': return false
    if text[lineStart + 2] != 'm': return false
    if text[lineStart + 3] != 'o': return false
    if text[lineStart + 4] != 'r': return false
    if text[lineStart + 5] != 'y': return false
    if text[lineStart + 6] != ':': return false
    return true

fn RustCsgMemoriesWriteExtractMemoryItems(conversationText: str): str[] =
    var result: str[]
    if conversationText.len == 0:
        return result
    var lineStart: int32 = 0
    var i: int32 = 0
    while i <= conversationText.len:
        var isEnd: bool = false
        if i == conversationText.len || conversationText[i] == '\n':
            isEnd = true
        if isEnd:
            let lineLen = i - lineStart
            if lineLen >= 7 && RustCsgMemoriesWriteLineHasPrefix(conversationText, lineStart):
                # Extract content after "Memory:"
                let contentStart: int32 = lineStart + 7
                var contentLen: int32 = lineLen - 7
                # Skip leading space
                var skip: int32 = 0
                while skip < contentLen && conversationText[contentStart + skip] == ' ':
                    skip = skip + 1
                contentLen = contentLen - skip
                if contentLen > 0:
                    add(result, strings.SliceBytes(conversationText, contentStart + skip, contentLen))
                else:
                    add(result, "")
            lineStart = i + 1
        i = i + 1
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn checkEqI64(got: int64, expected: int64): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.Int64ToStr(expected), " got=", strings.Int64ToStr(got)], ""))
        return false
    return true

fn checkEqArr(got: str[], expected: str[]): bool =
    if got.len != expected.len:
        echo(strutil.Join(["FAIL: length mismatch: expected=", strings.Int64ToStr(int64(expected.len)), " got=", strings.Int64ToStr(int64(got.len))], ""))
        return false
    var i: int32 = 0
    while i < got.len:
        if got[i] != expected[i]:
            echo(strutil.Join(["FAIL at index ", strings.IntToStr(i), ": expected=", expected[i], " got=", got[i]], ""))
            return false
        i = i + 1
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testExtractMemoryItemsSimple(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "User asked about Go",
        "Memory: User prefers Go over Python",
        "Assistant provided code",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 1):
        ok = false
    elif !checkEq(items[0], "User prefers Go over Python"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsSimple ok")
    return ok

fn testExtractMemoryItemsMultiple(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "Memory: First memory item",
        "some text",
        "Memory: Second memory item",
        "more text",
        "Memory: Third memory item",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 3):
        ok = false
    elif !checkEq(items[0], "First memory item"):
        ok = false
    elif !checkEq(items[1], "Second memory item"):
        ok = false
    elif !checkEq(items[2], "Third memory item"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsMultiple ok")
    return ok

fn testExtractMemoryItemsEmptyConversation(): bool =
    var ok: bool = true
    let items = RustCsgMemoriesWriteExtractMemoryItems("")
    if !checkEqI64(int64(items.len), 0):
        ok = false
    if ok:
        echo("testExtractMemoryItemsEmptyConversation ok")
    return ok

fn testExtractMemoryItemsNoMemoryLines(): bool =
    var ok: bool = true
    let text = "just a regular conversation\nwith no memory items\nat all"
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 0):
        ok = false
    if ok:
        echo("testExtractMemoryItemsNoMemoryLines ok")
    return ok

fn testExtractMemoryItemsLeadingSpace(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "Memory:  indented content",
        "Memory:no space after colon",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 2):
        ok = false
    elif !checkEq(items[0], "indented content"):
        ok = false
    elif !checkEq(items[1], "no space after colon"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsLeadingSpace ok")
    return ok

fn testExtractMemoryItemsOnlyMemoryPrefix(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "Memory:",
        "Memory: ",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 2):
        ok = false
    elif !checkEq(items[0], ""):
        ok = false
    elif !checkEq(items[1], ""):
        ok = false
    if ok:
        echo("testExtractMemoryItemsOnlyMemoryPrefix ok")
    return ok

fn testExtractMemoryItemsCaseSensitive(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "memory: lowercase prefix not matched",
        "MEMORY: uppercase prefix not matched",
        "Memory: proper prefix matched",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 1):
        ok = false
    elif !checkEq(items[0], "proper prefix matched"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsCaseSensitive ok")
    return ok

fn testExtractMemoryItemsSubstringPrefix(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "MemoryRelated: not a memory item",
        "Memory: actual memory item",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 1):
        ok = false
    elif !checkEq(items[0], "actual memory item"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsSubstringPrefix ok")
    return ok

fn testExtractMemoryItemsWithSpecialChars(): bool =
    var ok: bool = true
    let text = strutil.Join([
        "Memory: API key = sk-abc123!@#",
        "Memory: user's note: \"important\"",
        "Memory: path/to/file.go:42",
    ], "\n")
    let items = RustCsgMemoriesWriteExtractMemoryItems(text)
    if !checkEqI64(int64(items.len), 3):
        ok = false
    elif !checkEq(items[0], "API key = sk-abc123!@#"):
        ok = false
    elif !checkEq(items[1], "user's note: \"important\""):
        ok = false
    elif !checkEq(items[2], "path/to/file.go:42"):
        ok = false
    if ok:
        echo("testExtractMemoryItemsWithSpecialChars ok")
    return ok

# ── memoriesWriteValidateEntry: validates a memory entry format ──────────────
# Validates a memory entry string. An entry is valid if:
# - It is not empty
# - It does not contain newlines (single-line entries only)
# - Its length does not exceed 10000 characters
# Returns an empty string on success, or an error message on failure.

fn memoriesWriteValidateEntry(entry: str): str =
    if entry.len == 0:
        return "empty entry"
    if entry.len > 10000:
        return "entry too long"
    var i: int32 = 0
    while i < entry.len:
        if entry[i] == '\n' || entry[i] == '\r':
            return "entry contains newline"
        i = i + 1
    return ""

# ── Test: memoriesWriteValidateEntry ─────────────────────────────────────────

fn testValidateEntryValid(): bool =
    var ok: bool = true
    let err = memoriesWriteValidateEntry("User likes Go")
    if err != "":
        echo(strutil.Join(["FAIL: valid entry got error: ", err], ""))
        ok = false
    if ok:
        echo("testValidateEntryValid ok")
    return ok

fn testValidateEntryEmpty(): bool =
    var ok: bool = true
    let err = memoriesWriteValidateEntry("")
    if err == "":
        echo("FAIL: empty entry should return error")
        ok = false
    if ok:
        echo("testValidateEntryEmpty ok")
    return ok

fn testValidateEntryNewline(): bool =
    var ok: bool = true
    let err = memoriesWriteValidateEntry("line1\nline2")
    if err == "":
        echo("FAIL: entry with newline should return error")
        ok = false
    if ok:
        echo("testValidateEntryNewline ok")
    return ok

fn testValidateEntryTooLong(): bool =
    var ok: bool = true
    var longEntry: str
    var i: int32 = 0
    while i < 10001:
        longEntry = strings.ConcatStr(longEntry, "x")
        i = i + 1
    let err = memoriesWriteValidateEntry(longEntry)
    if err == "":
        echo("FAIL: too long entry should return error")
        ok = false
    if ok:
        echo("testValidateEntryTooLong ok")
    return ok

fn testValidateEntrySpecialChars(): bool =
    var ok: bool = true
    let err = memoriesWriteValidateEntry("API key = sk-abc123!@#$%^&*()")
    if err != "":
        echo(strutil.Join(["FAIL: valid entry with special chars got error: ", err], ""))
        ok = false
    if ok:
        echo("testValidateEntrySpecialChars ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testExtractMemoryItemsSimple(): allOk = false
    if !testExtractMemoryItemsMultiple(): allOk = false
    if !testExtractMemoryItemsEmptyConversation(): allOk = false
    if !testExtractMemoryItemsNoMemoryLines(): allOk = false
    if !testExtractMemoryItemsLeadingSpace(): allOk = false
    if !testExtractMemoryItemsOnlyMemoryPrefix(): allOk = false
    if !testExtractMemoryItemsCaseSensitive(): allOk = false
    if !testExtractMemoryItemsSubstringPrefix(): allOk = false
    if !testExtractMemoryItemsWithSpecialChars(): allOk = false
    if !testValidateEntryValid(): allOk = false
    if !testValidateEntryEmpty(): allOk = false
    if !testValidateEntryNewline(): allOk = false
    if !testValidateEntryTooLong(): allOk = false
    if !testValidateEntrySpecialChars(): allOk = false
    if allOk:
        echo("rust_csg_memories_write_smoke ok")
        return 0
    else:
        echo("rust_csg_memories_write_smoke FAILED")
        return 1
