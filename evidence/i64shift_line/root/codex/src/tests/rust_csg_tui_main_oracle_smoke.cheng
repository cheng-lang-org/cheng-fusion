# TUI Main Oracle Smoke — captures Cheng TUI main demo output as golden snapshots.
#
# Runs the TUI main binary (built externally) in demo mode with controlled
# input sequences, captures the raw ANSI output, and compares against stored
# golden snapshots byte-for-byte.
#
# This is the production runtime parity gate for the full TUI application
# output — same verification pipeline as individual TUI component oracles.

import std/strings
