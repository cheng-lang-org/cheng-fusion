import cheng/codex/src/tui/main as tui_main
import cheng/codex/protocol/wire

const
    RustCsgTuiMainOracleVersion: str = "v1"

fn main(): int32 =
    echo("rust_csg_tui_main_oracle_smoke ok")
    return 0

main()