import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_interrupt_history_oracle as oracle

fn RustCsgTuiChatwidgetInterruptHistoryFirstDiff(expected: str, got: str): int32 =
    let expectedLen: int32 = strings.Len(expected)
    let gotLen: int32 = strings.Len(got)
    var limit: int32 = expectedLen
    if gotLen < limit:
        limit = gotLen

    var i: int32 = 0
    while i < limit:
        if expected[i] != got[i]:
            return i
        i = i + 1

    if expectedLen != gotLen:
        return limit
    return -1

fn RustCsgTuiChatwidgetInterruptHistoryCheck(path: str,
                                              expectedSource: str,
                                              expectedExpression: str,
                                              expectedBody: str,
                                              name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
            " first_diff=", strings.IntToStr(RustCsgTuiChatwidgetInterruptHistoryFirstDiff(expectedBody, s.body)),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 2:
        echo("FAIL usage: rust_csg_tui_chatwidget_interrupt_history_oracle_smoke <1 snapshot path>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetInterruptHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "last", oracle.RustCsgTuiChatwidgetInterruptedTurnErrorMessage(), "interrupted_turn_error_message")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_interrupt_history_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_interrupt_history_oracle_smoke FAILED")
    return exitCode
