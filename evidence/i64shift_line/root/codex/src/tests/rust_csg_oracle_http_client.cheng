import cheng/codex/crates/http_client/http_client as m
fn main(): int32 =
    var pass: int32
    if m.HttpMethodVariantNames().len > 0: pass = pass + 1
    if m.HttpRequestFields().len > 0: pass = pass + 1
    if m.HttpResponseFields().len > 0: pass = pass + 1
    if pass == 3: echo("rust_csg_oracle_http_client ok"); return 0
    echo("oracle FAIL"); return 1
main()
