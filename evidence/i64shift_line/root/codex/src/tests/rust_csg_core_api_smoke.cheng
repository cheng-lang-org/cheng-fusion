# ═══════════════════════════════════════════════════════════════════════════════
# core-api — relfacts equivalence + functional smoke test
#
# Verifies that the core-api module's defined functions, types, and fields
# match the oracle, then runs functional assertions.
# ═══════════════════════════════════════════════════════════════════════════════
import cheng/codex/crates/core_api/core_api
import std/strutils as strutil

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkNonEmpty(value: str, label: str): bool =
    if value == "":
        echo(strutil.Join([label, " FAIL: empty"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testTypeConstants(): bool =
    var ok: bool = true
    if !checkNonEmpty(core_api.CoreApiCodexThread, "CodexThread"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiMcpManager, "McpManager"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiThreadManager, "ThreadManager"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiUserInput, "UserInput"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiAbsolutePathBuf, "AbsolutePathBuf"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiAuthManager, "AuthManager"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiFeature, "Feature"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiRefreshStrategy, "RefreshStrategy"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiThreadId, "ThreadId"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiConfigLayerStack, "ConfigLayerStack"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiServerNotification, "ServerNotification"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiEmptyExtensionRegistry, "EmptyExtensionRegistry"):
        ok = false
    if !checkNonEmpty(core_api.CoreApiEnvironmentManager, "EnvironmentManager"):
        ok = false
    if ok:
        echo("testTypeConstants ok")
    return ok

fn testProviderId(): bool =
    var ok: bool = true
    if !checkEqStr(core_api.CoreApiOpenaiProviderId, "OPENAI_PROVIDER_ID", "openai_provider_id"):
        ok = false
    if !checkEqStr(core_api.RustCsgCoreApiProviderId(), "OPENAI_PROVIDER_ID", "provider_id_fn"):
        ok = false
    if ok:
        echo("testProviderId ok")
    return ok

fn testGetVersion(): bool =
    var ok: bool = true
    if !checkNonEmpty(core_api.RustCsgCoreApiGetVersion(), "api_version"):
        ok = false
    if ok:
        echo("testGetVersion ok")
    return ok

# ── Relfacts counting helpers ──────────────────────────────────────────────

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 11 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn testRelfacts(): bool =
    # core_api.cheng defines 2 functions (RustCsgCoreApiProviderId, RustCsgCoreApiGetVersion) and 0 types
    let source = "fn RustCsgCoreApiProviderId(): str\nfn RustCsgCoreApiGetVersion(): str\n"
    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tcore_api\nDefFunction\tcore_api\tRustCsgCoreApiProviderId\t\t->\tstr\nDefFunction\tcore_api\tRustCsgCoreApiGetVersion\t\t->\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)
    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(esf == 2, "source function count")
    assert(est == 0, "source type count")
    assert(esfd == 0, "source field count")
    assert(osf == 2, "oracle function count")
    assert(ost == 0, "oracle type count")
    assert(osfd == 0, "oracle field count")
    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")
    echo("testRelfacts ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testRelfacts():
        allOk = false
    if !testTypeConstants():
        allOk = false
    if !testProviderId():
        allOk = false
    if !testGetVersion():
        allOk = false
    if allOk:
        echo("rust_csg_core_api_smoke ok")
        return 0
    else:
        echo("rust_csg_core_api_smoke FAILED")
        return 1