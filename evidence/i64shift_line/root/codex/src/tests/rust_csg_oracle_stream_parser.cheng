import cheng/codex/crates/stream_parser/stream_parser as sp

fn main(): int32 =
    var pass: int32

    # strFindAt with fresh pos each call
    var pos: int32
    var found: bool
    sp.strFindAt("hello world", 0, "world", pos, found)
    if pos == 6: pass = pass + 1

    pos = -1
    sp.strFindAt("abca", 0, "a", pos, found)
    if pos == 0: pass = pass + 1

    pos = -1
    sp.strFindAt("hello", 3, "lo", pos, found)
    if pos == 3: pass = pass + 1

    # longestSuffixPrefixLen
    if sp.longestSuffixPrefixLen("", "abc") == 0: pass = pass + 1

    # stripProposedPlan
    var r1 = sp.stripProposedPlan("<proposed_plan>do this</proposed_plan>")
    if r1.len == 0: pass = pass + 1
    var r3 = sp.stripProposedPlan("no plan here")
    if r3.len == 12: pass = pass + 1

    if pass == 6:
        echo("rust_csg_oracle_stream_parser ok")
        return 0
    echo("oracle FAIL")
    return 1

main()