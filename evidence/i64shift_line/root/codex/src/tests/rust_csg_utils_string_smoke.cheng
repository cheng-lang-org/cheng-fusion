# ═══════════════════════════════════════════════════════════════════════════════
# utils/string — relfacts equivalence smoke test
#
# Verifies that the utils_string crate's defined functions, types, and fields
# match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "fn RustCsgUtilsStringTakeBytesAtCharBoundary(s: str, maxb: int64): str\nfn RustCsgUtilsStringSanitizeMetricTagValue(value: str): str\nfn RustCsgUtilsStringFindUuids(s: str): str[]\nfn RustCsgUtilsStringNormalizeMarkdownHashLocationSuffix(suffix: str, out: var str, outOk: var bool)\nfn RustCsgUtilsStringTruncateMiddleChars(s: str, maxBytes: int64): str\nfn RustCsgUtilsStringTruncateMiddleWithTokenBudget(s: str, maxTokens: int64, outOriginalTokens: var int64, outHadTruncation: var bool): str\nfn RustCsgUtilsStringApproxTokenCount(text: str): int64\nfn RustCsgUtilsStringApproxBytesForTokens(tokens: int64): int64\nfn RustCsgUtilsStringApproxTokensFromByteCount(bytes: int64): int64\nfn RustCsgUtilsStringSplitWords(text: str): str[]\nfn RustCsgUtilsStringCommonPrefix(a: str, b: str): str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tutils_string\nDefFunction\tutils_string\tRustCsgUtilsStringTakeBytesAtCharBoundary\ts: str, maxb: int64\t->\tstr\nDefFunction\tutils_string\tRustCsgUtilsStringSanitizeMetricTagValue\tvalue: str\t->\tstr\nDefFunction\tutils_string\tRustCsgUtilsStringFindUuids\ts: str\t->\tstr[]\nDefFunction\tutils_string\tRustCsgUtilsStringNormalizeMarkdownHashLocationSuffix\tsuffix: str, out: var str, outOk: var bool\t->\t\nDefFunction\tutils_string\tRustCsgUtilsStringTruncateMiddleChars\ts: str, maxBytes: int64\t->\tstr\nDefFunction\tutils_string\tRustCsgUtilsStringTruncateMiddleWithTokenBudget\ts: str, maxTokens: int64, outOriginalTokens: var int64, outHadTruncation: var bool\t->\tstr\nDefFunction\tutils_string\tRustCsgUtilsStringApproxTokenCount\ttext: str\t->\tint64\nDefFunction\tutils_string\tRustCsgUtilsStringApproxBytesForTokens\ttokens: int64\t->\tint64\nDefFunction\tutils_string\tRustCsgUtilsStringApproxTokensFromByteCount\tbytes: int64\t->\tint64\nDefFunction\tutils_string\tRustCsgUtilsStringSplitWords\ttext: str\t->\tstr[]\nDefFunction\tutils_string\tRustCsgUtilsStringCommonPrefix\ta: str, b: str\t->\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 11, "source function count")
    assert(est == 0, "source type count")
    assert(esfd == 0, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 11, "oracle function count")
    assert(ost == 0, "oracle type count")
    assert(osfd == 0, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_utils_string_smoke ok")
    return 0
