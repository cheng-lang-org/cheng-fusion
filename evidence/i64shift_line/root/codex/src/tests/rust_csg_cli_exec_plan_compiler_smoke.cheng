import std/cmdline as cmdline
import cheng/codex/exec/plan
import cheng/codex/exec/session

fn RustCsgCliExecPlanCompilerRunExec(args: str[]): int32 =
    var p = plan.RustCsgExecParseArgs(args)
    if p.parseError != "":
        echo(p.parseError)
        return 1
    if p.configOverrides.len != 0:
        return 10
    var err: str
    let profile = session.RustCsgExecSelectedProfileOverrideFromPlan(p, err)
    if err != "":
        echo(err)
        return 2
    if profile != "":
        return 3
    echo("rust_csg_cli_exec_plan_compiler_smoke ok")
    return 0

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var args: str[]
    let count = cmdline.paramCount()
    for i in 0..<count:
        add(args, cmdline.paramStr(i))
    return RustCsgCliExecPlanCompilerRunExec(args)
