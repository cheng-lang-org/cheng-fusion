import std/cmdline
import std/strings as strutil
import cheng/codex/tui/app_oracle as app
import cheng/codex/tui/oracle_snapshot as snap

# ── Smoke test entry ─────────────────────────────────────────────────────────

fn main(): int32 =
    if cmdline.argCount() < 4:
        echo("FAIL usage: rust_csg_tui_app_oracle_smoke <agent_picker> <clear_fresh_header> <clear_fast_header>")
        return 1

    var exitCode: int32 = 0

    # ── 1. agent_picker_item_name ────────────────────────────────────────────
    let p1: str = cmdline.argStr(1)
    let s1 = snap.RustCsgTuiOracleSnapshotParseFile(p1)
    if !s1.ok:
        echo(strutil.Join(["FAIL: agent_picker_item_name parse: ", p1, ": ", s1.error], ""))
        return 1
    if s1.source != "tui/src/app.rs":
        echo(strutil.Join(["FAIL: agent_picker_item_name source: ", s1.source], ""))
        return 1
    if s1.expression != "snapshot":
        echo(strutil.Join(["FAIL: agent_picker_item_name expr: ", s1.expression], ""))
        return 1
    let r1: str = app.RustCsgTuiAppAgentPickerItemNameFixture()
    if r1.len == 0:
        echo("FAIL: agent_picker_item_name empty render"); return 1
    if r1 != s1.body:
        echo(strutil.Join(["FAIL: agent_picker_item_name (expected ", strings.IntToStr(s1.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r1)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: agent_picker_item_name")

    # ── 2. clear_ui_after_long_transcript_fresh_header_only ──────────────────
    let p2: str = cmdline.argStr(2)
    let s2 = snap.RustCsgTuiOracleSnapshotParseFile(p2)
    if !s2.ok:
        echo(strutil.Join(["FAIL: clear_ui_fresh_header parse: ", p2, ": ", s2.error], "")); return 1
    if s2.source != "tui/src/app.rs":
        echo(strutil.Join(["FAIL: clear_ui_fresh_header source: ", s2.source], "")); return 1
    if s2.expression != "rendered":
        echo(strutil.Join(["FAIL: clear_ui_fresh_header expr: ", s2.expression], "")); return 1
    let r2: str = app.RustCsgTuiAppClearUIFreshHeaderOnlyFixture()
    if r2.len == 0:
        echo("FAIL: clear_ui_fresh_header empty render"); return 1
    if r2 != s2.body:
        echo(strutil.Join(["FAIL: clear_ui_fresh_header (expected ", strings.IntToStr(s2.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r2)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: clear_ui_after_long_transcript_fresh_header_only")

    # ── 3. clear_ui_header_fast_status_gpt54_only ────────────────────────────
    let p3: str = cmdline.argStr(3)
    let s3 = snap.RustCsgTuiOracleSnapshotParseFile(p3)
    if !s3.ok:
        echo(strutil.Join(["FAIL: clear_ui_header_fast parse: ", p3, ": ", s3.error], "")); return 1
    if s3.source != "tui/src/app.rs":
        echo(strutil.Join(["FAIL: clear_ui_header_fast source: ", s3.source], "")); return 1
    if s3.expression != "rendered":
        echo(strutil.Join(["FAIL: clear_ui_header_fast expr: ", s3.expression], "")); return 1
    let r3: str = app.RustCsgTuiAppClearUIHeaderFastFixture()
    if r3.len == 0:
        echo("FAIL: clear_ui_header_fast empty render"); return 1
    if r3 != s3.body:
        echo(strutil.Join(["FAIL: clear_ui_header_fast (expected ", strings.IntToStr(s3.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r3)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: clear_ui_header_fast_status_gpt54_only")

    if exitCode == 0:
        echo("rust_csg_tui_app_oracle_smoke ok")
    else:
        echo("rust_csg_tui_app_oracle_smoke FAILED")
    return exitCode
