import std/cmdline
import std/strings
import cheng/codex/tui/oracle_text_full as full

fn parsePositiveI32(text: str): int32 =
    let n: int32 = strings.Len(text)
    if n <= 0:
        return -1
    var i: int32 = 0
    var value: int32 = 0
    while i < n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            return -1
        value = value * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return value

fn checkI32(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strings.ConcatStr(strings.ConcatStr("FAIL ", label),
                               strings.ConcatStr(" expected=", strings.ConcatStr(strings.IntToStr(expected),
                                                                                  strings.ConcatStr(" got=", strings.IntToStr(got))))))
        return false
    echo(strings.ConcatStr(strings.ConcatStr(label, "="), strings.IntToStr(got)))
    return true

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_oracle_text_full_smoke <source_root> <expected_snapshots> <expected_frames> <expected_self_compare>")
        return 1
    let expectedSnapshots: int32 = parsePositiveI32(cmdline.argStr(2))
    let expectedFrames: int32 = parsePositiveI32(cmdline.argStr(3))
    let expectedSelfCompare: int32 = parsePositiveI32(cmdline.argStr(4))
    if expectedSnapshots < 0 || expectedFrames < 0 || expectedSelfCompare < 0:
        echo("FAIL expected counts must be decimal int32")
        return 1

    let report = full.RustCsgTuiOracleTextFullValidateSourceRoot(cmdline.argStr(1))
    if !report.ok:
        echo(strings.ConcatStr("FAIL ", report.error))
        return 1
    echo(strings.ConcatStr("source_root=", report.sourceRoot))
    if !checkI32("snapshot_count", report.snapshotCount, expectedSnapshots):
        return 1
    if !checkI32("frame_count", report.frameCount, expectedFrames):
        return 1
    if report.quotedSnapshotCount <= 0:
        echo("FAIL quoted_snapshot_count expected positive")
        return 1
    echo(strings.ConcatStr("quoted_snapshot_count=", strings.IntToStr(report.quotedSnapshotCount)))
    if report.rawSnapshotCount <= 0:
        echo("FAIL raw_snapshot_count expected positive")
        return 1
    echo(strings.ConcatStr("raw_snapshot_count=", strings.IntToStr(report.rawSnapshotCount)))
    if !checkI32("self_compare_count", report.selfCompareCount, expectedSelfCompare):
        return 1
    if !checkI32("frame_lines_per_file", report.frameLinesPerFile, 17):
        return 1
    if strings.Len(report.firstSnapshotPath) == 0:
        echo("FAIL first_snapshot is empty")
        return 1
    echo(strings.ConcatStr("first_snapshot=", report.firstSnapshotPath))
    if strings.Len(report.firstFramePath) == 0:
        echo("FAIL first_frame is empty")
        return 1
    echo(strings.ConcatStr("first_frame=", report.firstFramePath))
    echo("rust_csg_tui_oracle_text_full_smoke ok")
    return 0
