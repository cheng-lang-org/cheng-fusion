import std/strings
import std/strutils as strutil
import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/tui/app as tui_app
import cheng/codex/tui/app_session_install as install
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_state as state

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckEqInt(actual: int32, expected: int32, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", strings.IntToStr(expected), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn FillThread(thread: var types.RustCsgAppThread,
              threadId: str,
              forkedFromId: str,
              path: str,
              name: str,
              turnsJson: str) =
    thread.id = threadId
    thread.sessionId = threadId
    thread.forkedFromId = forkedFromId
    thread.preview = "preview"
    thread.ephemeral = false
    thread.modelProvider = "openai"
    thread.createdAt = int64(1770000000)
    thread.updatedAt = int64(1770000100)
    thread.statusJson = "{\"type\":\"idle\"}"
    thread.path = path
    thread.cwd = "/repo/current"
    thread.cliVersion = "1.0.0"
    thread.source = "cli"
    thread.threadSource = "user"
    thread.name = name
    thread.turnsJson = turnsJson

fn LifecycleResponseJson(threadJson: str,
                         cwd: str,
                         runtimeWorkspaceRootsJson: str,
                         instructionSourcesJson: str,
                         activePermissionProfileJson: str): str =
    var active = activePermissionProfileJson
    if active == "":
        active = "null"
    var out = "{\"thread\":"
    out = wire.RustCsgCat(out, threadJson)
    out = wire.RustCsgCat(out, ",\"model\":\"gpt-5\",\"modelProvider\":\"openai\",\"serviceTier\":\"flex\",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("runtimeWorkspaceRoots", runtimeWorkspaceRootsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("instructionSources", instructionSourcesJson))
    out = wire.RustCsgCat(out, ",\"approvalPolicy\":\"on-request\",\"approvalsReviewer\":\"user\",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("sandbox", "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("activePermissionProfile", active))
    out = wire.RustCsgCat(out, ",\"reasoningEffort\":\"high\"}")
    return out

fn UserMessageItem(id: str, text: str): str =
    var content = "[{"
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldStr("type", "text"))
    content = wire.RustCsgCat(content, ",")
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldStr("text", text))
    content = wire.RustCsgCat(content, ",")
    content = wire.RustCsgCat(content, wire.RustCsgJsonFieldRaw("textElements", "[]"))
    content = wire.RustCsgCat(content, "}]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "userMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", content))
    out = wire.RustCsgCat(out, "}")
    return out

fn AgentMessageItem(id: str, text: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "agentMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", text))
    out = wire.RustCsgCat(out, "}")
    return out

fn Turn(id: str, itemsJson: str, status: str, errorJson: str): str =
    var error = errorJson
    if error == "":
        error = "null"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("items", itemsJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("itemsView", "full"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", error))
    out = wire.RustCsgCat(out, ",\"startedAt\":null,\"completedAt\":null,\"durationMs\":null}")
    return out

fn PendingEvent(kind: str, payload: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("payload", payload))
    out = wire.RustCsgCat(out, "}")
    return out

fn PendingEventsJson(threadId: str): str =
    let notificationPayload = wire.RustCsgCat3("{\"method\":\"thread/tokenUsage/updated\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), "}}")
    let requestPayload = wire.RustCsgCat3("{\"id\":7,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), ",\"turnId\":\"turn-1\",\"itemId\":\"exec-1\"}}")
    let historyPayload = "{\"entryId\":\"history-1\",\"status\":\"ready\"}"
    let feedbackPayload = "{\"category\":\"bug\",\"includeLogs\":true,\"result\":{\"ok\":\"submitted\"}}"
    return strutil.Join(["[",
                         PendingEvent("notification", notificationPayload),
                         ",",
                         PendingEvent("request", requestPayload),
                         ",",
                         PendingEvent("historyEntryResponse", historyPayload),
                         ",",
                         PendingEvent("feedbackSubmission", feedbackPayload),
                         "]"], "")

fn main(): int32 =
    var failures: int32
    let threadId = "11111111-1111-4111-8111-111111111111"
    let forkedFromId = "22222222-2222-4222-8222-222222222222"
    let turnsJson = strutil.Join(["[",
                                  Turn("turn-1", wire.RustCsgCat3("[", UserMessageItem("u1", "earlier prompt"), "]"), "completed", ""),
                                  ",",
                                  Turn("turn-2", wire.RustCsgCat3("[", AgentMessageItem("a1", "earlier answer"), "]"), "completed", ""),
                                  "]"], "")

    var config: state.RustCsgTuiSessionStateConfig
    config.permissionProfileJson = "{\"id\":\":workspace\"}"
    config.personalityJson = "\"precise\""
    config.messageHistoryLogId = int64(42)
    config.messageHistoryEntryCount = 7

    var thread: types.RustCsgAppThread
    FillThread(thread, threadId, "", "/repo/current/rollout.jsonl", "Active thread", turnsJson)
    let responseJson = LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                             "/repo/current",
                                             "[\"/repo/current\",\"/repo/cache\"]",
                                             "[\"/repo/current/AGENTS.md\"]",
                                             "{\"id\":\":workspace\"}")
    var started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(responseJson,
                                                                        state.RustCsgTuiSessionLifecycleStart,
                                                                        lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                        config)
    failures = failures + CheckEqBool(started.ok, true, "start state ok")
    failures = failures + CheckEqStr(started.session.threadId, threadId, "start thread id")
    failures = failures + CheckEqStr(started.session.threadName, "Active thread", "start thread name")
    failures = failures + CheckEqStr(started.session.permissionProfileSource, "config", "start permission source")
    failures = failures + CheckEqStr(started.session.permissionProfileJson, "{\"id\":\":workspace\"}", "start permission profile")
    failures = failures + CheckEqStr(started.session.activePermissionProfileJson, "{\"id\":\":workspace\"}", "start active profile")
    failures = failures + CheckEqStr(started.session.runtimeWorkspaceRootsJson, "[\"/repo/current\",\"/repo/cache\"]", "start roots")
    failures = failures + CheckEqStr(started.session.instructionSourcePathsJson, "[\"/repo/current/AGENTS.md\"]", "start instructions")
    failures = failures + CheckEqStr(started.session.reasoningEffort, "high", "start reasoning")
    failures = failures + CheckEqInt(started.turnCount, 2, "start turn count")

    let installResult = install.RustCsgTuiAppSessionInstallPrimaryWithPendingEvents(started, true, PendingEventsJson(threadId), true)
    failures = failures + CheckEqBool(installResult.ok, true, "install ok")
    failures = failures + CheckEqStr(installResult.primaryThreadId, threadId, "install primary")
    failures = failures + CheckEqStr(installResult.activeThreadId, threadId, "install active")
    failures = failures + CheckEqStr(installResult.threadStoreThreadId, threadId, "install store")
    failures = failures + CheckEqStr(installResult.chatWidgetThreadId, threadId, "install chat widget")
    failures = failures + CheckEqStr(installResult.replayKind, "ResumeInitialMessages", "install replay kind")
    failures = failures + CheckEqInt(installResult.replayedTurnCount, 2, "install replay count")
    failures = failures + CheckEqInt(installResult.chatReplayEventCount, 2, "install replay events")
    failures = failures + CheckEqInt(installResult.chatReplayUserMessageCount, 1, "install replay user count")
    failures = failures + CheckEqInt(installResult.chatReplayAgentMessageCount, 1, "install replay agent count")
    failures = failures + CheckContains(installResult.chatReplayTranscriptText, "› earlier prompt", "install replay user transcript")
    failures = failures + CheckContains(installResult.chatReplayTranscriptText, "• earlier answer", "install replay agent transcript")
    failures = failures + CheckEqBool(installResult.beginInitialHistoryReplayBuffer, true, "install begin buffer")
    failures = failures + CheckEqBool(installResult.endInitialHistoryReplayBuffer, true, "install end buffer")
    failures = failures + CheckEqBool(installResult.initialUserMessageSubmitSuppressedDuringReplay, true, "install suppressed during")
    failures = failures + CheckEqBool(installResult.initialUserMessageSubmitSuppressedAfterReplay, false, "install suppressed after")
    failures = failures + CheckEqInt(installResult.pendingPrimaryEventReplayCount, 4, "install pending count")
    failures = failures + CheckEqInt(installResult.pendingPrimaryNotificationReplayCount, 1, "install pending notification count")
    failures = failures + CheckEqInt(installResult.pendingPrimaryRequestReplayCount, 1, "install pending request count")
    failures = failures + CheckEqInt(installResult.pendingPrimaryHistoryEntryResponseReplayCount, 1, "install pending history count")
    failures = failures + CheckEqInt(installResult.pendingPrimaryFeedbackSubmissionReplayCount, 1, "install pending feedback count")
    failures = failures + CheckEqBool(installResult.pendingPrimaryEventsClearedAfterReplay, true, "install pending cleared")
    failures = failures + CheckEqBool(installResult.initialUserMessageSubmittedAfterPendingReplay, true, "install initial after pending")
    failures = failures + CheckContains(installResult.pendingPrimaryEventReplayJson, "\"index\":0,\"threadId\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"notification\"", "install pending notification fifo")
    failures = failures + CheckContains(installResult.pendingPrimaryEventReplayJson, "\"index\":1,\"threadId\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"request\",\"method\":\"item/commandExecution/requestApproval\"", "install pending request fifo")
    failures = failures + CheckContains(installResult.pendingPrimaryEventReplayJson, "\"index\":2,\"threadId\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"historyEntryResponse\"", "install pending history fifo")
    failures = failures + CheckContains(installResult.pendingPrimaryEventReplayJson, "\"index\":3,\"threadId\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"feedbackSubmission\"", "install pending feedback fifo")
    failures = failures + CheckEqBool(installResult.submittedInitialUserMessage, true, "install initial submit")
    let installJson = install.RustCsgTuiAppSessionInstallResultToJson(installResult)
    failures = failures + CheckContains(installJson, "\"primarySessionConfigured\":{\"threadId\":\"11111111-1111-4111-8111-111111111111\"", "install session json")
    failures = failures + CheckContains(installJson, "\"threadStoreTurns\":[{\"id\":\"turn-1\"", "install turns json")
    failures = failures + CheckContains(installJson, "\"chatReplayEventCount\":2", "install replay event json")
    failures = failures + CheckContains(installJson, "\"displayTranscriptText\":\"› earlier prompt\\n• earlier answer\"", "install replay transcript json")
    failures = failures + CheckContains(installJson, "\"pendingPrimaryEventReplayCount\":4", "install pending count json")
    failures = failures + CheckContains(installJson, "\"pendingPrimaryEventReplay\":[{\"index\":0", "install pending fifo json")

    var app = tui_app.RustCsgTuiAppInit(96, 20)
    let runtimeInstall = tui_app.RustCsgTuiAppInstallPrimarySession(app, installResult)
    failures = failures + CheckEqBool(runtimeInstall.ok, true, "app runtime install ok")
    failures = failures + CheckEqBool(runtimeInstall.runLoopReady, true, "app runtime ready")
    failures = failures + CheckEqStr(runtimeInstall.activeThreadId, threadId, "app runtime active")
    failures = failures + CheckEqStr(runtimeInstall.chatWidgetThreadId, threadId, "app runtime chat widget")
    failures = failures + CheckEqStr(runtimeInstall.threadStoreThreadId, threadId, "app runtime store")
    failures = failures + CheckEqInt(runtimeInstall.messageCount, 1, "app runtime history message")
    failures = failures + CheckEqInt(runtimeInstall.effectCount, 8, "app runtime effect count")
    failures = failures + CheckEqInt(runtimeInstall.pendingPrimaryEventReplayCount, 4, "app runtime pending count")
    failures = failures + CheckEqInt(runtimeInstall.pendingPrimaryRequestReplayCount, 1, "app runtime request count")
    failures = failures + CheckEqInt(runtimeInstall.pendingPrimaryNotificationReplayCount, 1, "app runtime notification count")
    failures = failures + CheckEqBool(runtimeInstall.initialUserMessageSubmitQueued, true, "app runtime initial submit queued")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"thread_store/install_primary\"", "app runtime store effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"chat_widget/handle_thread_session\"", "app runtime session effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"chat_widget/replay_thread_turns\"", "app runtime replay effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"app/list_skills\",\"targetThreadId\":\"11111111-1111-4111-8111-111111111111\",\"payload\":{\"forceReload\":true}", "app runtime skills effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"app_server/replay_pending_primary_events\"", "app runtime pending effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"chat_widget/submit_initial_user_message\"", "app runtime initial effect")
    failures = failures + CheckContains(runtimeInstall.effectsJson, "\"kind\":\"app/request_redraw\"", "app runtime redraw effect")
    failures = failures + CheckContains(runtimeInstall.firstFrameText, "session 11111111-1111-4111-8111-111111111111", "app runtime first frame status")
    failures = failures + CheckContains(runtimeInstall.firstFrameText, "earlier prompt", "app runtime first frame prompt")
    let runtimeJson = tui_app.RustCsgTuiAppRuntimeInstallResultToJson(runtimeInstall)
    failures = failures + CheckContains(runtimeJson, "\"runLoopReady\":true", "app runtime json ready")
    failures = failures + CheckContains(runtimeJson, "\"effects\":[{\"kind\":\"thread_store/install_primary\"", "app runtime json effects")

    var mismatchInstall: install.RustCsgTuiAppSessionInstallResult
    mismatchInstall.ok = true
    mismatchInstall.primaryThreadId = threadId
    mismatchInstall.activeThreadId = threadId
    mismatchInstall.threadStoreThreadId = threadId
    mismatchInstall.chatWidgetThreadId = "33333333-3333-4333-8333-333333333333"
    let mismatchRuntime = tui_app.RustCsgTuiAppInstallPrimarySession(app, mismatchInstall)
    failures = failures + CheckEqBool(mismatchRuntime.ok, false, "app runtime mismatch fails")
    failures = failures + CheckEqStr(mismatchRuntime.error, "chat widget thread mismatch", "app runtime mismatch error")

    FillThread(thread, threadId, "", "/repo/current/rollout.jsonl", "Unsupported replay", wire.RustCsgCat3("[", Turn("turn-bad", "[{\"type\":\"webSearch\",\"id\":\"w1\",\"query\":\"x\"}]", "completed", ""), "]"))
    let unsupportedStarted = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                                         "/repo/current",
                                                                                                         "[\"/repo/current\",\"/repo/cache\"]",
                                                                                                         "[\"/repo/current/AGENTS.md\"]",
                                                                                                         "{\"id\":\":workspace\"}"),
                                                                                   state.RustCsgTuiSessionLifecycleResume,
                                                                                   lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                                   config)
    failures = failures + CheckEqBool(unsupportedStarted.ok, true, "unsupported state ok")
    let unsupportedInstall = install.RustCsgTuiAppSessionInstallPrimary(unsupportedStarted, true, 0, false)
    failures = failures + CheckEqBool(unsupportedInstall.ok, false, "unsupported replay fails")
    failures = failures + CheckContains(unsupportedInstall.error, "unsupported history item type: webSearch", "unsupported replay error")

    FillThread(thread, threadId, "", "/repo/current/rollout.jsonl", "Resume thread", turnsJson)
    started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                          "/repo/current",
                                                                                          "[\"/repo/current\",\"/repo/cache\"]",
                                                                                          "[\"/repo/current/AGENTS.md\"]",
                                                                                          ""),
                                                                    state.RustCsgTuiSessionLifecycleResume,
                                                                    lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                    config)
    failures = failures + CheckEqBool(started.ok, true, "resume legacy ok")
    failures = failures + CheckEqStr(started.session.permissionProfileSource, "legacy_sandbox", "resume legacy source")
    failures = failures + CheckContains(started.session.permissionProfileJson, "\"type\":\"workspaceWrite\"", "resume legacy profile")

    FillThread(thread, threadId, forkedFromId, "/repo/current/fork.jsonl", "", turnsJson)
    started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                          "/repo/current",
                                                                                          "[\"/repo/current\",\"/repo/cache\"]",
                                                                                          "[\"/repo/current/AGENTS.md\"]",
                                                                                          "{\"id\":\":workspace\"}"),
                                                                    state.RustCsgTuiSessionLifecycleFork,
                                                                    lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                    config)
    started = state.RustCsgTuiStartedThreadSetForkParentTitle(started, "Parent thread")
    failures = failures + CheckEqBool(started.ok, true, "fork state ok")
    failures = failures + CheckEqStr(started.session.forkedFromId, forkedFromId, "fork parent id")
    failures = failures + CheckEqStr(started.session.forkParentTitle, "Parent thread", "fork parent title")

    FillThread(thread, threadId, "", "/repo/current/rollout.jsonl", "Remote thread", "[]")
    thread.cwd = "/remote/workspace"
    started = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                          "/remote/workspace",
                                                                                          "[\"/remote/workspace\"]",
                                                                                          "[]",
                                                                                          ""),
                                                                    state.RustCsgTuiSessionLifecycleResume,
                                                                    lifecycle.RustCsgTuiThreadParamsModeRemote,
                                                                    config)
    failures = failures + CheckEqBool(started.ok, true, "remote state ok")
    failures = failures + CheckEqStr(started.session.permissionProfileSource, "sandbox", "remote permission source")
    failures = failures + CheckEqStr(started.session.cwd, "/remote/workspace", "remote cwd")
    failures = failures + CheckEqInt(started.turnCount, 0, "remote turn count")

    FillThread(thread, "not-a-uuid", "", "/repo/current/rollout.jsonl", "Bad thread", "[]")
    let invalidThread = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                                    "/repo/current",
                                                                                                    "[\"/repo/current\"]",
                                                                                                    "[]",
                                                                                                    ""),
                                                                              state.RustCsgTuiSessionLifecycleResume,
                                                                              lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                              config)
    failures = failures + CheckEqBool(invalidThread.ok, false, "invalid thread fails")
    failures = failures + CheckContains(invalidThread.error, "thread id is invalid", "invalid thread error")

    FillThread(thread, threadId, "", "/repo/current/rollout.jsonl", "Relative cwd", "[]")
    thread.cwd = "relative/path"
    let relativeCwd = state.RustCsgTuiSessionStateFromLifecycleResponseJson(LifecycleResponseJson(wire.RustCsgAppThreadToJson(thread),
                                                                                                  "relative/path",
                                                                                                  "[\"/repo/current\"]",
                                                                                                  "[]",
                                                                                                  ""),
                                                                            state.RustCsgTuiSessionLifecycleResume,
                                                                            lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                            config)
    failures = failures + CheckEqBool(relativeCwd.ok, false, "relative cwd fails")
    failures = failures + CheckEqStr(relativeCwd.error, "cwd must be absolute", "relative cwd error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_state_install_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_state_install_smoke ok")
    return 0
