import std/strings
import std/strutils as strutil
import cheng/codex/crates/login/login

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: login — OAuth authorization URL construction
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=|", expected, "| got=|", got, "|"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join([label, " FAIL: expected=", es, " got=", gs], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── URL encoding tests ────────────────────────────────────────────────────

fn testUrlEncodeSimple(): bool =
    var ok: bool = true
    if !checkEqStr(login.loginUrlEncode("hello"), "hello", "encode plain"): ok = false
    if !checkEqStr(login.loginUrlEncode("a b"), "a+b", "encode space"): ok = false
    if !checkEqStr(login.loginUrlEncode("a&b"), "a%26b", "encode ampersand"): ok = false
    if !checkEqStr(login.loginUrlEncode("a=b"), "a%3Db", "encode equals"): ok = false
    if !checkEqStr(login.loginUrlEncode(""), "", "encode empty"): ok = false
    if ok:
        echo("testUrlEncodeSimple ok")
    return ok

fn testUrlEncodeReserved(): bool =
    var ok: bool = true
    if !checkEqStr(login.loginUrlEncode("a?b"), "a%3Fb", "encode question mark"): ok = false
    if !checkEqStr(login.loginUrlEncode("a#b"), "a%23b", "encode hash"): ok = false
    if !checkEqStr(login.loginUrlEncode("a%b"), "a%25b", "encode percent"): ok = false
    if ok:
        echo("testUrlEncodeReserved ok")
    return ok

# ── OAuth URL construction tests ─────────────────────────────────────────

fn testStartLoginFlowBasic(): bool =
    var ok: bool = true
    let url = login.loginStartFlow(
        "https://github.com/login/oauth/authorize",
        "my_client_id",
        "myapp://callback",
        "repo user",
        "abc123"
    )
    if !checkEqStr(url, "https://github.com/login/oauth/authorize?response_type=code&client_id=my_client_id&redirect_uri=myapp%3A%2F%2Fcallback&scope=repo+user&state=abc123",
        "startLoginFlow basic"):
        ok = false
    if ok:
        echo("testStartLoginFlowBasic ok")
    return ok

fn testStartLoginFlowNoScope(): bool =
    var ok: bool = true
    let url = login.loginStartFlow(
        "https://example.com/auth",
        "client123",
        "https://example.com/cb",
        "",
        ""
    )
    if !checkEqStr(url, "https://example.com/auth?response_type=code&client_id=client123&redirect_uri=https%3A%2F%2Fexample.com%2Fcb",
        "startLoginFlow no scope"):
        ok = false
    if ok:
        echo("testStartLoginFlowNoScope ok")
    return ok

fn testStartLoginFlowWithPkce(): bool =
    var ok: bool = true
    let url = login.loginStartFlowWithPkce(
        "https://example.com/auth",
        "client123",
        "https://example.com/cb",
        "openid",
        "state_val",
        "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
    )
    if !checkEqStr(url, "https://example.com/auth?response_type=code&client_id=client123&redirect_uri=https%3A%2F%2Fexample.com%2Fcb&scope=openid&state=state_val&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256",
        "startLoginFlowWithPkce"):
        ok = false
    if ok:
        echo("testStartLoginFlowWithPkce ok")
    return ok

# ── GitHub specific tests ────────────────────────────────────────────────

fn testGithubDeviceFlow(): bool =
    var ok: bool = true
    let url = login.loginGithubDeviceFlow("my_client")
    if !checkEqStr(url, "https://github.com/login/device/code?client_id=my_client&scope=read%3Auser+repo",
        "githubDeviceFlow"):
        ok = false
    if ok:
        echo("testGithubDeviceFlow ok")
    return ok

# ── Validation tests ─────────────────────────────────────────────────────

fn testValidateAuthUrl(): bool =
    var ok: bool = true
    if !checkEqBool(login.loginValidateAuthUrl("https://example.com/auth"), true, "valid https"): ok = false
    if !checkEqBool(login.loginValidateAuthUrl("http://localhost:8080/auth"), true, "valid localhost"): ok = false
    if !checkEqBool(login.loginValidateAuthUrl("http://127.0.0.1/auth"), true, "valid 127.0.0.1"): ok = false
    if !checkEqBool(login.loginValidateAuthUrl("http://evil.com"), false, "invalid http non-localhost"): ok = false
    if !checkEqBool(login.loginValidateAuthUrl(""), false, "empty url"): ok = false
    if !checkEqBool(login.loginValidateAuthUrl("ftp://example.com"), false, "ftp scheme"): ok = false
    if ok:
        echo("testValidateAuthUrl ok")
    return ok

fn testValidateParams(): bool =
    var ok: bool = true
    if !checkEqBool(login.loginValidateParams("client_id", "https://example.com/cb"), true, "valid params"): ok = false
    if !checkEqBool(login.loginValidateParams("", "https://example.com/cb"), false, "empty clientId"): ok = false
    if !checkEqBool(login.loginValidateParams("client_id", ""), false, "empty redirectUri"): ok = false
    if ok:
        echo("testValidateParams ok")
    return ok

# ── Main ──────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testUrlEncodeSimple(): allOk = false
    if !testUrlEncodeReserved(): allOk = false
    if !testStartLoginFlowBasic(): allOk = false
    if !testStartLoginFlowNoScope(): allOk = false
    if !testStartLoginFlowWithPkce(): allOk = false
    if !testGithubDeviceFlow(): allOk = false
    if !testValidateAuthUrl(): allOk = false
    if !testValidateParams(): allOk = false

    if allOk:
        echo("rust_csg_login_smoke ok")
        return 0
    else:
        echo("rust_csg_login_smoke FAILED")
        return 1
