# ═══════════════════════════════════════════════════════════════════════════════
# app-server — relfacts equivalence smoke test
#
# Verifies that the app_server crate's defined functions, types, and fields
# match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgAppServerRequest =\n        method: str\n        id: int32\n        params: str\n\n    RustCsgAppServerResponse =\n        id: int32\n        result: str\n        error: str\n\nfn RustCsgBuildThreadStartRequest(sessionId: str, modelName: str, cwd: str): str\nfn RustCsgJsonEscape(value: str): str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tapp_server\nDefFunction\tapp_server\tRustCsgBuildThreadStartRequest\tsessionId: str, modelName: str, cwd: str\t->\tstr\nDefFunction\tapp_server\tRustCsgJsonEscape\tvalue: str\t->\tstr\nLocalType\tapp_server\tRustCsgAppServerRequest\nHasField\tapp_server\tRustCsgAppServerRequest\tmethod\tstr\nHasField\tapp_server\tRustCsgAppServerRequest\tid\tint32\nHasField\tapp_server\tRustCsgAppServerRequest\tparams\tstr\nLocalType\tapp_server\tRustCsgAppServerResponse\nHasField\tapp_server\tRustCsgAppServerResponse\tid\tint32\nHasField\tapp_server\tRustCsgAppServerResponse\tresult\tstr\nHasField\tapp_server\tRustCsgAppServerResponse\terror\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 2, "source function count")
    assert(est == 2, "source type count")
    assert(esfd == 6, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 2, "oracle function count")
    assert(ost == 2, "oracle type count")
    assert(osfd == 6, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_app_server_smoke ok")
    return 0
