# Secrets provider mode test: file-backed pure Cheng secret store.
# Tests production roundtrip: set, get, delete, rotate, list.

@abi_internal
@importc("RustCsgSecretSet")
fn RustCsgSecretSet(name: str, value: str): int32

@abi_internal
@importc("RustCsgSecretGet")
fn RustCsgSecretGet(name: str, outValue: var str, outOk: var int32)

@abi_internal
@importc("RustCsgSecretDelete")
fn RustCsgSecretDelete(name: str): int32

@abi_internal
@importc("RustCsgSecretRotate")
fn RustCsgSecretRotate(name: str, newValue: str): int32

@abi_internal
@importc("RustCsgSecretList")
fn RustCsgSecretList(): str

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEq(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn testSetGetRoundtrip(): bool =
    let ok = RustCsgSecretSet("test_key_1", "my_secret_value_42")
    if !checkTrue("set_ok", ok != 0):
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("test_key_1", outValue, outOk)
    if !checkTrue("get_ok", outOk != 0):
        return false
    if !checkEq("get_value", "my_secret_value_42", outValue):
        return false
    echo("testSetGetRoundtrip ok")
    return true

fn testDelete(): bool =
    let saved = RustCsgSecretSet("test_del_key", "temp_value_to_delete")
    if !checkTrue("del_save_ok", saved != 0):
        return false
    let deleted = RustCsgSecretDelete("test_del_key")
    if !checkTrue("delete_ok", deleted != 0):
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("test_del_key", outValue, outOk)
    if !checkTrue("deleted_not_found", outOk == 0):
        return false
    echo("testDelete ok")
    return true

fn testOverwrite(): bool =
    RustCsgSecretSet("test_over_key", "first_value")
    RustCsgSecretSet("test_over_key", "second_value")
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("test_over_key", outValue, outOk)
    if !checkTrue("over_ok", outOk != 0):
        return false
    if !checkEq("over_value", "second_value", outValue):
        return false
    RustCsgSecretDelete("test_over_key")
    echo("testOverwrite ok")
    return true

fn testMultipleEntries(): bool =
    RustCsgSecretSet("multi_a", "value_a")
    RustCsgSecretSet("multi_b", "value_b")
    RustCsgSecretSet("multi_c", "value_c")
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("multi_a", outValue, outOk)
    if !checkTrue("multi_a_ok", outOk != 0):
        return false
    if !checkEq("multi_a_val", "value_a", outValue):
        return false
    RustCsgSecretGet("multi_b", outValue, outOk)
    if !checkTrue("multi_b_ok", outOk != 0):
        return false
    if !checkEq("multi_b_val", "value_b", outValue):
        return false
    RustCsgSecretGet("multi_c", outValue, outOk)
    if !checkTrue("multi_c_ok", outOk != 0):
        return false
    if !checkEq("multi_c_val", "value_c", outValue):
        return false
    # Delete one and verify others remain
    RustCsgSecretDelete("multi_b")
    RustCsgSecretGet("multi_a", outValue, outOk)
    if !checkTrue("after_del_a_ok", outOk != 0):
        return false
    if !checkEq("after_del_a_val", "value_a", outValue):
        return false
    RustCsgSecretGet("multi_b", outValue, outOk)
    if !checkTrue("after_del_b_gone", outOk == 0):
        return false
    RustCsgSecretGet("multi_c", outValue, outOk)
    if !checkTrue("after_del_c_ok", outOk != 0):
        return false
    if !checkEq("after_del_c_val", "value_c", outValue):
        return false
    # Cleanup
    RustCsgSecretDelete("multi_a")
    RustCsgSecretDelete("multi_c")
    echo("testMultipleEntries ok")
    return true

fn testMinimalValue(): bool =
    # Minimal non-empty value to stress XOR + base64 boundary (1 byte)
    if 0 == RustCsgSecretSet("min_val_key", "."):
        echo("FAIL min_val_set")
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("min_val_key", outValue, outOk)
    if !checkTrue("min_val_get_ok", outOk != 0):
        return false
    if !checkEq("min_val", ".", outValue):
        return false
    RustCsgSecretDelete("min_val_key")
    echo("testMinimalValue ok")
    return true

fn testSingleCharValue(): bool =
    # Single character XOR roundtrip
    if 0 == RustCsgSecretSet("single_val_key", "X"):
        echo("FAIL single_val_set")
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("single_val_key", outValue, outOk)
    if !checkTrue("single_val_get_ok", outOk != 0):
        return false
    if !checkEq("single_val", "X", outValue):
        return false
    RustCsgSecretDelete("single_val_key")
    echo("testSingleCharValue ok")
    return true

fn testSpecialCharsValue(): bool =
    # Value with special characters that stress XOR + base64 roundtrip
    let specialVal = "hello\n\t\rworld!@#$%^&*()_+-=end"
    if 0 == RustCsgSecretSet("special_val_key", specialVal):
        echo("FAIL special_val_set")
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("special_val_key", outValue, outOk)
    if !checkTrue("special_val_get_ok", outOk != 0):
        return false
    if !checkEq("special_val", specialVal, outValue):
        return false
    RustCsgSecretDelete("special_val_key")
    echo("testSpecialCharsValue ok")
    return true

fn testDeleteNonExistent(): bool =
    # Delete a key that doesn't exist
    let deleted = RustCsgSecretDelete("nonexistent_key_98765")
    if !checkTrue("del_nonexistent", deleted != 0):
        return false
    echo("testDeleteNonExistent ok")
    return true

fn testLongValue(): bool =
    # Long value to stress XOR + base64
    let longVal = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    if 0 == RustCsgSecretSet("long_val_key", longVal):
        echo("FAIL long_val_set")
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("long_val_key", outValue, outOk)
    if !checkTrue("long_val_get_ok", outOk != 0):
        return false
    if !checkEq("long_val", longVal, outValue):
        return false
    RustCsgSecretDelete("long_val_key")
    echo("testLongValue ok")
    return true

fn testRotate(): bool =
    # Set a secret, rotate it, verify new value and previous preserved
    if 0 == RustCsgSecretSet("rotate_key", "original_value"):
        echo("FAIL rotate_set")
        return false
    var outValue: str
    var outOk: int32
    RustCsgSecretGet("rotate_key", outValue, outOk)
    if !checkTrue("rotate_get_orig", outOk != 0):
        return false
    if !checkEq("rotate_orig_val", "original_value", outValue):
        return false

    # Rotate to new value
    if 0 == RustCsgSecretRotate("rotate_key", "new_value_42"):
        echo("FAIL rotate_call")
        return false

    # New value should be readable
    RustCsgSecretGet("rotate_key", outValue, outOk)
    if !checkTrue("rotate_get_new", outOk != 0):
        return false
    if !checkEq("rotate_new_val", "new_value_42", outValue):
        return false

    # Previous value should be stored under rotate_key.previous
    RustCsgSecretGet("rotate_key.previous", outValue, outOk)
    if !checkTrue("rotate_get_prev", outOk != 0):
        return false
    if !checkEq("rotate_prev_val", "original_value", outValue):
        return false

    # Cleanup
    RustCsgSecretDelete("rotate_key")
    RustCsgSecretDelete("rotate_key.previous")
    echo("testRotate ok")
    return true

fn testList(): bool =
    # Set multiple secrets, list them, verify names
    RustCsgSecretSet("list_key_a", "val_a")
    RustCsgSecretSet("list_key_b", "val_b")
    RustCsgSecretSet("list_key_c", "val_c")

    var list: str = RustCsgSecretList()
    if list.len == 0:
        echo("FAIL list_empty")
        return false
    # Must start with '[' and end with ']'
    if list[0] != '[':
        echo("FAIL list_no_bracket")
        return false
    if list[list.len - 1] != ']':
        echo("FAIL list_no_end_bracket")
        return false

    # All three keys should appear
    var foundA: bool = false
    var foundB: bool = false
    var foundC: bool = false
    var li: int32 = 0
    while li < list.len:
        if list[li] == 'l':
            if li + 9 <= list.len:
                if list[li] == 'l' && list[li+1] == 'i' &&
                   list[li+2] == 's' && list[li+3] == 't' &&
                   list[li+4] == '_' && list[li+5] == 'k' &&
                   list[li+6] == 'e' && list[li+7] == 'y' &&
                   list[li+8] == '_' && list[li+9] == 'a':
                    foundA = true
            if li + 9 <= list.len:
                if list[li] == 'l' && list[li+1] == 'i' &&
                   list[li+2] == 's' && list[li+3] == 't' &&
                   list[li+4] == '_' && list[li+5] == 'k' &&
                   list[li+6] == 'e' && list[li+7] == 'y' &&
                   list[li+8] == '_' && list[li+9] == 'b':
                    foundB = true
            if li + 9 <= list.len:
                if list[li] == 'l' && list[li+1] == 'i' &&
                   list[li+2] == 's' && list[li+3] == 't' &&
                   list[li+4] == '_' && list[li+5] == 'k' &&
                   list[li+6] == 'e' && list[li+7] == 'y' &&
                   list[li+8] == '_' && list[li+9] == 'c':
                    foundC = true
        li = li + 1

    if !checkTrue("list_found_a", foundA):
        return false
    if !checkTrue("list_found_b", foundB):
        return false
    if !checkTrue("list_found_c", foundC):
        return false

    # Cleanup
    RustCsgSecretDelete("list_key_a")
    RustCsgSecretDelete("list_key_b")
    RustCsgSecretDelete("list_key_c")
    echo("testList ok")
    return true

fn main(): int32 =
    echo("secrets start")
    var allOk: bool = true
    if !testSetGetRoundtrip():
        allOk = false
    if !testDelete():
        allOk = false
    if !testOverwrite():
        allOk = false
    if !testMultipleEntries():
        allOk = false
    if !testMinimalValue():
        allOk = false
    if !testSingleCharValue():
        allOk = false
    if !testSpecialCharsValue():
        allOk = false
    if !testDeleteNonExistent():
        allOk = false
    if !testLongValue():
        allOk = false
    if !testRotate():
        allOk = false
    if !testList():
        allOk = false
    if allOk:
        echo("rust_csg_secrets_smoke ok")
        return 0
    echo("rust_csg_secrets_smoke FAILED")
    return 1
