import cheng/codex/crates/utils_home_dir/utils_home_dir as m
import cheng/codex/protocol/wire

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn quotePath(path: str): str =
    return wire.RustCsgCat(wire.RustCsgCat("\"", path), "\"")

fn main(): int32 =
    var p: str
    var e: str

    let fixtureHome = RustCsgGetEnv("RUST_CSG_CODEX_HOME_FIXTURE")
    let fixtureCanonical = RustCsgGetEnv("RUST_CSG_CODEX_HOME_CANONICAL")
    let fixtureFile = RustCsgGetEnv("RUST_CSG_CODEX_FILE_FIXTURE")
    let fixtureMissing = RustCsgGetEnv("RUST_CSG_CODEX_MISSING_FIXTURE")
    let fallbackHome = RustCsgGetEnv("RUST_CSG_HOME_FIXTURE")
    assert(fixtureHome != "", "fixture_home")
    assert(fixtureCanonical != "", "fixture_canonical")
    assert(fixtureFile != "", "fixture_file")
    assert(fixtureMissing != "", "fixture_missing")
    assert(fallbackHome != "", "fallback_home")

    m.RustCsgUtilsHomeDirFindCodexHomeFromEnv(fixtureHome, p, e)
    checkEq("valid_path", p, fixtureCanonical)
    checkEq("valid_error", e, "")

    m.RustCsgUtilsHomeDirFindCodexHomeFromEnv(fixtureFile, p, e)
    checkEq("file_path", p, "")
    checkEq("file_error", e, wire.RustCsgCat(
        wire.RustCsgCat("CODEX_HOME points to ", quotePath(fixtureFile)),
        ", but that path is not a directory"))

    m.RustCsgUtilsHomeDirFindCodexHomeFromEnv(fixtureMissing, p, e)
    checkEq("missing_path", p, "")
    checkEq("missing_error", e, wire.RustCsgCat(
        wire.RustCsgCat("CODEX_HOME points to ", quotePath(fixtureMissing)),
        ", but that path does not exist"))

    m.RustCsgUtilsHomeDirFindCodexHomeFromEnv("", p, e)
    checkEq("default_path", p, wire.RustCsgCat(fallbackHome, "/.codex"))
    checkEq("default_error", e, "")

    echo("rust_csg_oracle_utils_home_dir ok")
    return 0

main()
