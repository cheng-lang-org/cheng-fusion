import std/strings
import std/strutils as strutil
import cheng/codex/crates/features/features

fn main(): int32 =
    let list = features.RustCsgFeaturesListText()
    let rows = strutil.Split(list, '\n')
    assert(rows.len == 55, "features list row count")
    assert(strings.StrContains(list, "apply_patch_freeform"), "features list apply_patch_freeform")
    assert(strings.StrContains(list, "guardian_approval"), "features list guardian_approval")
    assert(strings.StrContains(list, "prevent_idle_sleep"), "features list prevent_idle_sleep")
    assert(strings.StrContains(list, "unified_exec"), "features list unified_exec")
    assert(strings.StrContains(list, "web_search_request"), "features list web_search_request")
    assert(strings.StrContains(list, "stable"), "features list stable")
    assert(strings.StrContains(list, "experimental"), "features list experimental")
    assert(strings.StrContains(list, "under development"), "features list under development")
    assert(features.RustCsgFeatureKnown("unified_exec"), "known canonical feature")
    assert(features.RustCsgFeatureKnown("web_search"), "known legacy feature")
    assert(!features.RustCsgFeatureKnown("does_not_exist"), "unknown feature rejected")
    assert(features.RustCsgFeatureCanonicalDefaultFalse("runtime_metrics"), "default false canonical")
    assert(!features.RustCsgFeatureCanonicalDefaultFalse("shell_tool"), "default true canonical")
    assert(!features.RustCsgFeatureCanonicalDefaultFalse("web_search"), "legacy disable persists")
    assert(features.RustCsgFeatureUnderDevelopment("runtime_metrics"), "under development feature")
    assert(!features.RustCsgFeatureUnderDevelopment("unified_exec"), "stable feature no warning")
    let configured = features.RustCsgFeaturesListTextWithConfig("[features]\nshell_tool = false\nruntime_metrics = true\ncode_mode_only = true\n")
    assert(strings.StrContains(configured, "shell_tool"), "configured list shell_tool")
    assert(strings.StrContains(configured, "runtime_metrics"), "configured list runtime_metrics")
    assert(strings.StrContains(configured, "code_mode"), "configured list code_mode")
    echo("rust_csg_features_smoke ok")
    return 0
