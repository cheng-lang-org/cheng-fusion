# Tools smoke test — verifies JsonSchema, ToolCall, ToolDefinition type constants.
# Ported from codex-rs/tools/src/{lib,json_schema,tool_call,tool_definition}.rs

import cheng/codex/crates/tools
import std/strings
import std/strutils as strutil

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testJsonSchemaPrimitiveType(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveTypeCount, 7, "PrimitiveTypeCount"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveString, 0, "PrimitiveString"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveNumber, 1, "PrimitiveNumber"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveBoolean, 2, "PrimitiveBoolean"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveInteger, 3, "PrimitiveInteger"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveObject, 4, "PrimitiveObject"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveArray, 5, "PrimitiveArray"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaPrimitiveNull, 6, "PrimitiveNull"):
        ok = false
    if ok:
        echo("testJsonSchemaPrimitiveType ok")
    return ok

fn testJsonSchemaPrimitiveTypeNames(): bool =
    var ok: bool = true
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(0), "string", "TypeNameString"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(1), "number", "TypeNameNumber"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(2), "boolean", "TypeNameBoolean"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(4), "object", "TypeNameObject"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(5), "array", "TypeNameArray"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaPrimitiveTypeName(99), "", "TypeNameInvalid"):
        ok = false
    if ok:
        echo("testJsonSchemaPrimitiveTypeNames ok")
    return ok

fn testJsonSchemaTypeEnum(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgJsonSchemaTypeVariantCount, 2, "JsonSchemaTypeVariantCount"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaTypeSingle, "Single", "JsonSchemaTypeSingle"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaTypeMultiple, "Multiple", "JsonSchemaTypeMultiple"):
        ok = false
    if ok:
        echo("testJsonSchemaTypeEnum ok")
    return ok

fn testJsonSchemaFields(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgJsonSchemaFieldCount, 8, "JsonSchemaFieldCount"):
        ok = false
    if !checkEqI32(tools.RustCsgJsonSchemaMethodCount, 10, "JsonSchemaMethodCount"):
        ok = false
    if ok:
        echo("testJsonSchemaFields ok")
    return ok

fn testAdditionalProperties(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgJsonSchemaAdditionalPropertiesVariantCount, 2, "AdditionalPropertiesVariantCount"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaAdditionalPropertiesBool, "Boolean", "AdditionalPropertiesBool"):
        ok = false
    if !checkEqStr(tools.RustCsgJsonSchemaAdditionalPropertiesSchema, "Schema", "AdditionalPropertiesSchema"):
        ok = false
    if ok:
        echo("testAdditionalProperties ok")
    return ok

fn testToolCall(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgToolCallFieldCount, 3, "ToolCallFieldCount"):
        ok = false
    if !checkEqI32(tools.RustCsgToolCallMethodCount, 1, "ToolCallMethodCount"):
        ok = false
    if ok:
        echo("testToolCall ok")
    return ok

fn testToolDefinition(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgToolDefinitionFieldCount, 5, "ToolDefinitionFieldCount"):
        ok = false
    if !checkEqI32(tools.RustCsgToolDefinitionMethodCount, 2, "ToolDefinitionMethodCount"):
        ok = false
    if ok:
        echo("testToolDefinition ok")
    return ok

fn testToolPayloadVariantCount(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgToolPayloadVariantCount, 2, "ToolPayloadVariantCount"):
        ok = false
    if !checkEqStr(tools.RustCsgToolPayloadFunction, "Function", "ToolPayloadFunction"):
        ok = false
    if !checkEqStr(tools.RustCsgToolPayloadMcp, "Mcp", "ToolPayloadMcp"):
        ok = false
    if ok:
        echo("testToolPayloadVariantCount ok")
    return ok

fn testFunctionCallErrorVariantCount(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgFunctionCallErrorVariantCount, 2, "FunctionCallErrorVariantCount"):
        ok = false
    if ok:
        echo("testFunctionCallErrorVariantCount ok")
    return ok

fn testToolsFunctionCount(): bool =
    var ok: bool = true
    if !checkEqI32(tools.RustCsgToolsFunctionCount, 6, "ToolsFunctionCount"):
        ok = false
    if ok:
        echo("testToolsFunctionCount ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testJsonSchemaPrimitiveType():
        allOk = false
    if !testJsonSchemaPrimitiveTypeNames():
        allOk = false
    if !testJsonSchemaTypeEnum():
        allOk = false
    if !testJsonSchemaFields():
        allOk = false
    if !testAdditionalProperties():
        allOk = false
    if !testToolCall():
        allOk = false
    if !testToolDefinition():
        allOk = false
    if !testToolPayloadVariantCount():
        allOk = false
    if !testFunctionCallErrorVariantCount():
        allOk = false
    if !testToolsFunctionCount():
        allOk = false
    if allOk:
        echo("rust_csg_tools_smoke ok")
        return 0
    else:
        echo("rust_csg_tools_smoke FAILED")
        return 1
