import cheng/codex/crates/guardian/guardian as guard

# ═══════════════════════════════════════════════════════════════════════════════
# Guardian Extension — type definition constants smoke test
#
# Ported from codex-rs/ext/guardian
# ═══════════════════════════════════════════════════════════════════════════════

fn testGuardianExtensionFields(): bool =
    if guard.RustCsgGuardianExtensionFieldCount != 1: return false
    if guard.RustCsgGuardianExtensionField1 != "agent_spawner": return false
    echo("testGuardianExtensionFields ok")
    return true

fn testGuardianThreadContextFields(): bool =
    if guard.RustCsgGuardianThreadContextFieldCount != 1: return false
    if guard.RustCsgGuardianThreadContextField1 != "forked_from_thread_id": return false
    echo("testGuardianThreadContextFields ok")
    return true

fn testInstallFnName(): bool =
    if guard.RustCsgGuardianInstallFnName != "install": return false
    echo("testInstallFnName ok")
    return true

fn testEvaluateGuardianPolicy(): bool =
    if guard.evaluateGuardianPolicy("allow", "allow_all") != 0: return false
    if guard.evaluateGuardianPolicy("deny", "allow_all") != 0: return false
    if guard.evaluateGuardianPolicy("allow", "deny_all") != 1: return false
    if guard.evaluateGuardianPolicy("deny", "deny_all") != 1: return false
    if guard.evaluateGuardianPolicy("allow", "review_all") != 2: return false
    if guard.evaluateGuardianPolicy("deny", "review_all") != 2: return false
    if guard.evaluateGuardianPolicy("allow", "") != 0: return false
    if guard.evaluateGuardianPolicy("deny", "") != 1: return false
    if guard.evaluateGuardianPolicy("review", "") != 2: return false
    if guard.evaluateGuardianPolicy("unknown", "") != -1: return false
    echo("testEvaluateGuardianPolicy ok")
    return true

fn testClassifyGuardianAction(): bool =
    if guard.classifyGuardianAction("allow") != 0: return false
    if guard.classifyGuardianAction("deny") != 1: return false
    if guard.classifyGuardianAction("review") != 2: return false
    if guard.classifyGuardianAction("unknown") != -1: return false
    if guard.classifyGuardianAction("") != -1: return false
    echo("testClassifyGuardianAction ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testGuardianExtensionFields(): allOk = false
    if !testGuardianThreadContextFields(): allOk = false
    if !testInstallFnName(): allOk = false
    if !testEvaluateGuardianPolicy(): allOk = false
    if !testClassifyGuardianAction(): allOk = false

    if allOk:
        echo("rust_csg_guardian_smoke ok")
        return 0
    else:
        echo("rust_csg_guardian_smoke FAILED")
        return 1