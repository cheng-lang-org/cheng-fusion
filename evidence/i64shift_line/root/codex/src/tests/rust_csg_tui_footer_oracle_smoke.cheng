import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/footer_oracle as oracle

fn RustCsgTuiFooterOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/footer.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn RustCsgTuiFooterOracleNameFromPath(path: str): str =
    let prefix: str = "codex_tui__bottom_pane__footer__tests__"
    let suffix: str = ".snap"
    let n: int32 = strings.Len(path)
    var slash: int32 = -1
    var i: int32 = 0
    while i < n:
        if path[i] == '/':
            slash = i
        i = i + 1
    let baseStart: int32 = slash + 1
    let baseLen: int32 = n - baseStart
    if baseLen <= strings.Len(prefix) + strings.Len(suffix):
        return ""
    let base: str = strings.SliceBytes(path, baseStart, baseLen)
    if strings.SliceBytes(base, 0, strings.Len(prefix)) != prefix:
        return ""
    if strings.SliceBytes(base, strings.Len(base) - strings.Len(suffix), strings.Len(suffix)) != suffix:
        return ""
    return strings.SliceBytes(base, strings.Len(prefix), strings.Len(base) - strings.Len(prefix) - strings.Len(suffix))

fn RustCsgTuiFooterOracleFixtureByName(name: str): str =
    if name == "footer_active_agent_label":
        return oracle.RustCsgTuiFooterActiveAgentLabelSnapshot()
    if name == "footer_composer_has_draft_queue_hint_enabled":
        return oracle.RustCsgTuiFooterComposerDraftQueueHintSnapshot()
    if name == "footer_context_tokens_used":
        return oracle.RustCsgTuiFooterContextTokensUsedSnapshot()
    if name == "footer_ctrl_c_quit_idle":
        return oracle.RustCsgTuiFooterCtrlCQuitIdleSnapshot()
    if name == "footer_ctrl_c_quit_running":
        return oracle.RustCsgTuiFooterCtrlCQuitRunningSnapshot()
    if name == "footer_esc_hint_idle":
        return oracle.RustCsgTuiFooterEscHintIdleSnapshot()
    if name == "footer_esc_hint_primed":
        return oracle.RustCsgTuiFooterEscHintPrimedSnapshot()
    if name == "footer_mode_indicator_narrow_overlap_hides":
        return oracle.RustCsgTuiFooterModeIndicatorNarrowOverlapHidesSnapshot()
    if name == "footer_mode_indicator_running_hides_hint":
        return oracle.RustCsgTuiFooterModeIndicatorRunningHidesHintSnapshot()
    if name == "footer_mode_indicator_wide":
        return oracle.RustCsgTuiFooterModeIndicatorWideSnapshot()
    if name == "footer_shortcuts_collaboration_modes_enabled":
        return oracle.RustCsgTuiFooterShortcutsCollaborationModesEnabledSnapshot()
    if name == "footer_shortcuts_context_running":
        return oracle.RustCsgTuiFooterShortcutsContextRunningSnapshot()
    if name == "footer_shortcuts_default":
        return oracle.RustCsgTuiFooterShortcutsDefaultSnapshot()
    if name == "footer_shortcuts_shift_and_esc":
        return oracle.RustCsgTuiFooterShortcutsShiftAndEscSnapshot()
    if name == "footer_status_line_disabled_context_right":
        return oracle.RustCsgTuiFooterStatusLineDisabledContextRightSnapshot()
    if name == "footer_status_line_enabled_mode_right":
        return oracle.RustCsgTuiFooterStatusLineEnabledModeRightSnapshot()
    if name == "footer_status_line_enabled_no_mode_right":
        return oracle.RustCsgTuiFooterStatusLineEnabledNoModeRightSnapshot()
    if name == "footer_status_line_overrides_context":
        return oracle.RustCsgTuiFooterStatusLineOverridesContextSnapshot()
    if name == "footer_status_line_overrides_draft_idle":
        return oracle.RustCsgTuiFooterStatusLineOverridesDraftIdleSnapshot()
    if name == "footer_status_line_overrides_shortcuts":
        return oracle.RustCsgTuiFooterStatusLineOverridesShortcutsSnapshot()
    if name == "footer_status_line_truncated_with_gap":
        return oracle.RustCsgTuiFooterStatusLineTruncatedWithGapSnapshot()
    if name == "footer_status_line_with_active_agent_label":
        return oracle.RustCsgTuiFooterStatusLineWithActiveAgentLabelSnapshot()
    if name == "footer_status_line_yields_to_queue_hint":
        return oracle.RustCsgTuiFooterStatusLineYieldsToQueueHintSnapshot()
    return ""

fn RustCsgTuiFooterOracleCheckPath(path: str): int32 =
    let name: str = RustCsgTuiFooterOracleNameFromPath(path)
    if strings.Len(name) == 0:
        echo(strutil.Join(["FAIL: invalid footer snapshot path: ", path], ""))
        return 1
    let fixture: str = RustCsgTuiFooterOracleFixtureByName(name)
    if strings.Len(fixture) == 0:
        echo(strutil.Join(["FAIL: missing footer oracle case: ", name], ""))
        return 1
    return RustCsgTuiFooterOracleCheck(path, fixture, name)

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_footer_oracle_smoke <footer snapshot paths...>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    while argIdx < cmdline.argCount():
        exitCode = exitCode + RustCsgTuiFooterOracleCheckPath(cmdline.argStr(argIdx))
        argIdx = argIdx + 1

    if exitCode == 0:
        echo("rust_csg_tui_footer_oracle_smoke ok")
    else:
        echo("rust_csg_tui_footer_oracle_smoke FAILED")
    return exitCode
