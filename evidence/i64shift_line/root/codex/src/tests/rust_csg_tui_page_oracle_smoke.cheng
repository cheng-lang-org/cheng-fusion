import std/cmdline
import std/strings as strutil
import cheng/codex/tui/page_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

# ── Inlined smoke ──────────────────────────────────────────────────────────

fn RustCsgTuiPageOracleCheck(path: str, expectedSource: str, expectedExpr: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpr:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture.len == 0:
        echo(strutil.Join(["FAIL: ", name, " empty fixture"], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch (expected ", strings.IntToStr(s.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(fixture)), ")"], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 10:
        echo("FAIL usage: rust_csg_tui_page_oracle_smoke <9 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/markdown_render_tests.rs",
        "rendered",
        oracle.RustCsgTuiPageFileLinkFixture(),
        "file_link")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/markdown_render_tests.rs",
        "rendered",
        oracle.RustCsgTuiPageMarkdownRenderComplexFixture(),
        "markdown_render_complex")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/multi_agents.rs",
        "snapshot",
        oracle.RustCsgTuiPageCollabAgentTranscriptFixture(),
        "collab_agent_transcript")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/multi_agents.rs",
        "cell_to_text(&cell)",
        oracle.RustCsgTuiPageCollabResumeInterruptedFixture(),
        "collab_resume_interrupted")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/pager_overlay.rs",
        "term.backend()",
        oracle.RustCsgTuiPageStaticOverlayBasicFixture(),
        "static_overlay_basic")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/pager_overlay.rs",
        "term.backend()",
        oracle.RustCsgTuiPageStaticOverlayWrapsFixture(),
        "static_overlay_wraps")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/pager_overlay.rs",
        "snapshot",
        oracle.RustCsgTuiPageTranscriptOverlayApplyPatchFixture(),
        "transcript_overlay_apply_patch")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/pager_overlay.rs",
        "term.backend()",
        oracle.RustCsgTuiPageTranscriptOverlayLiveTailFixture(),
        "transcript_overlay_live_tail")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiPageOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/pager_overlay.rs",
        "term.backend()",
        oracle.RustCsgTuiPageTranscriptOverlayBasicFixture(),
        "transcript_overlay_basic")
    argIdx = argIdx + 1

    if exitCode == 0:
        echo("rust_csg_tui_page_oracle_smoke ok")
    else:
        echo("rust_csg_tui_page_oracle_smoke FAILED")
    return exitCode
