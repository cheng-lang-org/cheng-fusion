import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/diff_render_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

fn firstDiff(expected: str, actual: str): str =
    var i: int32 = 0
    var line: int32 = 1
    var col: int32 = 1
    let expectedLen: int32 = strings.Len(expected)
    let actualLen: int32 = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen
    while i < limit:
        if expected[i] != actual[i]:
            return strutil.Join(["line ", strings.IntToStr(line), " col ", strings.IntToStr(col)], "")
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1
    return strutil.Join(["len expected ", strings.IntToStr(expectedLen), " actual ", strings.IntToStr(actualLen)], "")

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_diff_wrap_oracle_smoke <apply_update_block_wraps_long_lines.snap>")
        return 1
    let parsed = snap.RustCsgTuiOracleSnapshotParseFile(cmdline.argStr(1))
    if !parsed.ok:
        echo(strutil.Join(["FAIL parse: ", parsed.error], ""))
        return 1
    if parsed.source != "tui/src/diff_render.rs":
        echo(strutil.Join(["FAIL source: ", parsed.source], ""))
        return 1
    if parsed.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL expression: ", parsed.expression], ""))
        return 1
    let rendered: str = oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesFixture()
    if strings.Len(rendered) == 0:
        echo("FAIL empty wrap fixture")
        return 1
    if parsed.body != rendered:
        echo(strutil.Join(["FAIL byte mismatch ", firstDiff(parsed.body, rendered)], ""))
        return 1
    echo("rust_csg_tui_diff_wrap_oracle_smoke ok")
    return 0
