import std/strings
import std/strutils as strutil
import cheng/codex/crates/shell_escalation/shell_escalation as se

# ═══════════════════════════════════════════════════════════════════════════════
# shell-escalation: REAL production-level smoke tests
# Tests escalation policy determination based on command analysis.
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── Policy constant tests ─────────────────────────────────────────────────

fn testPolicyConstants(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyNone, 0, "PolicyNone"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyConfirm, 1, "PolicyConfirm"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyAutoEscalate, 2, "PolicyAutoEscalate"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyBlock, 3, "PolicyBlock"): ok = false
    return ok

# ── Escalation policy evaluation tests ────────────────────────────────────

fn testEmptyCommand(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("", "/home/user"), se.RustCsgShellEscalationPolicyBlock, "EmptyCommand"): ok = false
    return ok

fn testSudoCommand(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("sudo apt update", "/home/user"), se.RustCsgShellEscalationPolicyConfirm, "SudoCommand"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("doas pkg update", "/home/user"), se.RustCsgShellEscalationPolicyConfirm, "DoasCommand"): ok = false
    return ok

fn testPackageManager(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("apt install foo", "/"), se.RustCsgShellEscalationPolicyConfirm, "AptInstall"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("brew update", "/opt/homebrew"), se.RustCsgShellEscalationPolicyConfirm, "BrewUpdate"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("dnf install bar", "/usr"), se.RustCsgShellEscalationPolicyConfirm, "DnfInstall"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("pacman -Syu", "/"), se.RustCsgShellEscalationPolicyConfirm, "PacmanSync"): ok = false
    return ok

fn testSystemAdminCommand(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("systemctl restart nginx", "/"), se.RustCsgShellEscalationPolicyConfirm, "Systemctl"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("mount /dev/sda1 /mnt", "/"), se.RustCsgShellEscalationPolicyConfirm, "Mount"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("passwd", "/home/user"), se.RustCsgShellEscalationPolicyConfirm, "Passwd"): ok = false
    return ok

fn testFileOpInSystemDir(): bool =
    var ok: bool = true
    # rm in system path should confirm
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("rm -rf /etc/passwd", "/etc"), se.RustCsgShellEscalationPolicyConfirm, "RmInSystemDir"): ok = false
    # rm in user directory should not escalate
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("rm -rf temp", "/home/user"), se.RustCsgShellEscalationPolicyNone, "RmInUserDir"): ok = false
    # chmod in system path
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("chmod 755 /usr/bin/foo", "/usr/bin"), se.RustCsgShellEscalationPolicyConfirm, "ChmodSystem"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("chmod 755 myfile", "/home/user"), se.RustCsgShellEscalationPolicyNone, "ChmodUser"): ok = false
    return ok

fn testSafeCommand(): bool =
    var ok: bool = true
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("ls -la", "/home/user"), se.RustCsgShellEscalationPolicyNone, "Ls"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("cat /etc/passwd", "/home/user"), se.RustCsgShellEscalationPolicyNone, "Cat"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("echo hello", "/home/user"), se.RustCsgShellEscalationPolicyNone, "Echo"): ok = false
    if !checkEqI32(se.RustCsgShellEscalationPolicyForCommand("grep pattern file.txt", "/home/user"), se.RustCsgShellEscalationPolicyNone, "Grep"): ok = false
    return ok

# ── Audit log tests ─────────────────────────────────────────────────────

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=|", expected, "| got=|", got, "|"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testAuditLog(): bool =
    var ok: bool = true
    var emptyHistory: se.RustCsgShellEscalationEvent[]
    let emptyLog = se.RustCsgShellEscalationAuditLog(emptyHistory)
    if !checkEqStr(emptyLog, "No escalation events logged.", "auditLogEmpty"):
        ok = false
    var history: se.RustCsgShellEscalationEvent[]
    var ev1: se.RustCsgShellEscalationEvent
    ev1.timestamp = "2026-05-21T10:00:00Z"
    ev1.command = "sudo apt update"
    ev1.policy = se.RustCsgShellEscalationPolicyConfirm
    ev1.outcome = "approved"
    add(history, ev1)
    let log = se.RustCsgShellEscalationAuditLog(history)
    if !strutil.Contains(log, "sudo apt update"):
        echo("FAIL auditLogSingle: missing command")
        ok = false
    else:
        echo("auditLogSingle ok")
    if !strutil.Contains(log, "approved"):
        echo("FAIL auditLogSingle: missing outcome")
        ok = false
    else:
        echo("auditLogSingle outcome ok")
    if ok:
        echo("testAuditLog ok")
    return ok

fn testPolicyToJson(): bool =
    var ok: bool = true
    if !checkEqStr(se.RustCsgShellEscalationPolicyToJson(se.RustCsgShellEscalationPolicyNone), "\"none\"", "policyJsonNone"):
        ok = false
    if !checkEqStr(se.RustCsgShellEscalationPolicyToJson(se.RustCsgShellEscalationPolicyConfirm), "\"confirm\"", "policyJsonConfirm"):
        ok = false
    if !checkEqStr(se.RustCsgShellEscalationPolicyToJson(se.RustCsgShellEscalationPolicyAutoEscalate), "\"auto_escalate\"", "policyJsonAuto"):
        ok = false
    if !checkEqStr(se.RustCsgShellEscalationPolicyToJson(se.RustCsgShellEscalationPolicyBlock), "\"block\"", "policyJsonBlock"):
        ok = false
    if !checkEqStr(se.RustCsgShellEscalationPolicyToJson(99), "\"unknown\"", "policyJsonUnknown"):
        ok = false
    if ok:
        echo("testPolicyToJson ok")
    return ok

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testPolicyConstants(): allOk = false
    if !testEmptyCommand(): allOk = false
    if !testSudoCommand(): allOk = false
    if !testPackageManager(): allOk = false
    if !testSystemAdminCommand(): allOk = false
    if !testFileOpInSystemDir(): allOk = false
    if !testSafeCommand(): allOk = false
    if !testAuditLog(): allOk = false
    if !testPolicyToJson(): allOk = false
    if allOk:
        echo("rust_csg_shell_escalation_smoke ok")
        return 0
    else:
        echo("rust_csg_shell_escalation_smoke FAILED")
        return 1
