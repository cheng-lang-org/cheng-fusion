import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chat_composer_footer_collapse_oracle as oracle

fn RustCsgTuiChatComposerFooterCollapseExpr(): str =
    return "terminal.backend()"

fn RustCsgTuiChatComposerFooterCollapseOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/chat_composer.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != RustCsgTuiChatComposerFooterCollapseExpr():
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 19:
        echo("FAIL usage: rust_csg_tui_chat_composer_footer_collapse_oracle_smoke <18 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseEmptyFullSnapshot(), "footer_collapse_empty_full")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseEmptyModeOnlySnapshot(), "footer_collapse_empty_mode_only")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseEmptyModeCycleWithContextSnapshot(), "footer_collapse_empty_mode_cycle_with_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseEmptyModeCycleWithoutContextSnapshot(), "footer_collapse_empty_mode_cycle_without_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseQueueModeOnlySnapshot(), "footer_collapse_queue_mode_only")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseQueueShortWithoutContextSnapshot(), "footer_collapse_queue_short_without_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseQueueShortWithContextSnapshot(), "footer_collapse_queue_short_with_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseQueueFullSnapshot(), "footer_collapse_queue_full")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapseQueueMessageWithoutContextSnapshot(), "footer_collapse_queue_message_without_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanEmptyFullSnapshot(), "footer_collapse_plan_empty_full")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanEmptyModeOnlySnapshot(), "footer_collapse_plan_empty_mode_only")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanEmptyModeCycleWithContextSnapshot(), "footer_collapse_plan_empty_mode_cycle_with_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanEmptyModeCycleWithoutContextSnapshot(), "footer_collapse_plan_empty_mode_cycle_without_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanQueueFullSnapshot(), "footer_collapse_plan_queue_full")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanQueueMessageWithoutContextSnapshot(), "footer_collapse_plan_queue_message_without_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanQueueModeOnlySnapshot(), "footer_collapse_plan_queue_mode_only")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanQueueShortWithContextSnapshot(), "footer_collapse_plan_queue_short_with_context")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterCollapseOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterCollapsePlanQueueShortWithoutContextSnapshot(), "footer_collapse_plan_queue_short_without_context")

    if exitCode == 0:
        echo("rust_csg_tui_chat_composer_footer_collapse_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chat_composer_footer_collapse_oracle_smoke FAILED")
    return exitCode
