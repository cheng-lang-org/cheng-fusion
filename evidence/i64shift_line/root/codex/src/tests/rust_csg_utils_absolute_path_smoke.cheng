import cheng/codex/crates/utils_absolute_path/utils_absolute_path as path

fn check(name: str, actual: str, expected: str, failures: var int32) =
    if actual != expected:
        echo(name)
        echo(actual)
        echo(expected)
        failures = failures + 1

fn main(): int32 =
    var failures: int32
    check("normalize_dots", path.RustCsgUtilsAbsolutePathNormalize("/path/to/./123/../456"), "/path/to/456", failures)
    check("normalize_above_root", path.RustCsgUtilsAbsolutePathNormalize("/../../foo"), "/foo", failures)
    check("normalize_relative_parent", path.RustCsgUtilsAbsolutePathNormalize("a/b/../../foo"), "foo", failures)
    check("normalize_many_parents", path.RustCsgUtilsAbsolutePathNormalize("../../../.."), ".", failures)
    check("path_with_base_absolute", path.RustCsgUtilsAbsolutePathPathWithBase("/path/to/123", "/base"), "/path/to/123", failures)
    check("path_with_base_relative", path.RustCsgUtilsAbsolutePathPathWithBase("path/to/123", "/base"), "/base/path/to/123", failures)
    check("absolutize_base", path.RustCsgUtilsAbsolutePathAbsolutizeFrom("path/to/123/456", "/base"), "/base/path/to/123/456", failures)
    check("absolutize_parent", path.RustCsgUtilsAbsolutePathAbsolutizeFrom("../dest", "/src/sub"), "/src/dest", failures)
    check("absolutize_above_root", path.RustCsgUtilsAbsolutePathAbsolutizeFrom("../../../dest", "/src"), "/dest", failures)
    check("absolutize_double_slash", path.RustCsgUtilsAbsolutePathAbsolutizeFrom("//path//to//file", "/base"), "/path/to/file", failures)
    if failures != 0:
        echo("rust_csg_utils_absolute_path_smoke FAILED")
        return 1
    echo("rust_csg_utils_absolute_path_smoke ok")
    return 0
