import cheng/codex/crates/codex_api as m
fn main(): int32 =
    let names = m.RustCsgCodexApiFunctionNames()
    let parsed = m.RustCsgParseRateLimitHeaders("{\"x-codex-primary-used-percent\":\"12.5\"}")
    if names == "parseRateLimitHeaders" && parsed.len > 0:
        echo("rust_csg_oracle_codex_api ok")
        return 0
    echo("oracle FAIL"); return 1
main()
