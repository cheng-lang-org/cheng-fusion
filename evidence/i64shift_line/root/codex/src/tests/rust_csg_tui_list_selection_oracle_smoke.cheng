import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/list_selection_oracle as oracle

fn RustCsgTuiListSelectionOracleCheck(path: str, expectedExpr: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/list_selection_view.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpr:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 9:
        echo("FAIL usage: rust_csg_tui_list_selection_oracle_smoke <8 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_before_after_scroll_snapshot(ColumnWidthMode::AutoAllRows, 96)\"", oracle.RustCsgTuiListSelectionAutoAllRowsScrollSnapshot(), "list_selection_col_width_mode_auto_all_rows_scroll")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_before_after_scroll_snapshot(ColumnWidthMode::AutoVisible, 96)\"", oracle.RustCsgTuiListSelectionAutoVisibleScrollSnapshot(), "list_selection_col_width_mode_auto_visible_scroll")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_before_after_scroll_snapshot(ColumnWidthMode::Fixed, 96)\"", oracle.RustCsgTuiListSelectionFixedScrollSnapshot(), "list_selection_col_width_mode_fixed_scroll")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_lines_with_width(&view, 40)\"", oracle.RustCsgTuiListSelectionFooterNoteWrapsSnapshot(), "list_selection_footer_note_wraps")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_lines_with_width(&view, 80)\"", oracle.RustCsgTuiListSelectionModelPickerWidth80Snapshot(), "list_selection_model_picker_width_80")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "\"render_lines_with_width(&view, 24)\"", oracle.RustCsgTuiListSelectionNarrowWidthPreservesRowsSnapshot(), "list_selection_narrow_width_preserves_rows")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "render_lines(&view)", oracle.RustCsgTuiListSelectionSpacingWithSubtitleSnapshot(), "list_selection_spacing_with_subtitle")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiListSelectionOracleCheck(cmdline.argStr(argIdx), "render_lines(&view)", oracle.RustCsgTuiListSelectionSpacingWithoutSubtitleSnapshot(), "list_selection_spacing_without_subtitle")

    if exitCode == 0:
        echo("rust_csg_tui_list_selection_oracle_smoke ok")
    else:
        echo("rust_csg_tui_list_selection_oracle_smoke FAILED")
    return exitCode
