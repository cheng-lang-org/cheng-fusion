# FS Provider Gate — uses darwin_inventory_provider for real filesystem operations

import std/strings

@abi_internal
@importc("RustCsgPathMetadataKind")
fn RustCsgPathMetadataKind(path: str): int32

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

@abi_internal
@importc("RustCsgFileSize")
fn RustCsgFileSize(path: str): int64

@abi_internal
@importc("RustCsgMkdir")
fn RustCsgMkdir(path: str): int32

@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgWriteFile(path: str, content: str): int32

@abi_internal
@importc("ReadFile")
fn ReadFile(path: str): str

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEq(name: str, expected: int32, actual: int32): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEqStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        echo("expected_len")
        echo(strings.IntToStr(expected.len))
        echo("actual_len")
        echo(strings.IntToStr(actual.len))
        echo("expected")
        echo(expected)
        echo("actual")
        echo(actual)
        return false
    return true

fn checkEq64(name: str, expected: int64, actual: int64): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn testFileExists(): bool =
    # /etc/passwd exists as a regular file -> metadataKind != 0
    let etcPasswd = RustCsgPathMetadataKind("/etc/passwd")
    if !checkTrue("etc_passwd_exists", etcPasswd != 0):
        return false
    # Check it's NOT a directory (metadataKind=1 means dir)
    if !checkTrue("etc_passwd_not_dir", etcPasswd != 1):
        return false
    echo("testFileExists ok")
    return true

fn testDirExists(): bool =
    let tmp = RustCsgPathMetadataKind("/tmp")
    if !checkEq("tmp_is_dir", 1, tmp):
        return false
    let nonexist = RustCsgPathMetadataKind("/nonexistent_xyz_test_12345")
    if !checkEq("nonexist_missing", 0, nonexist):
        return false
    echo("testDirExists ok")
    return true

fn testGetEnv(): bool =
    let home = RustCsgGetEnv("HOME")
    if !checkTrue("getenv_home", home != ""):
        return false
    echo("testGetEnv ok")
    return true

fn testFileSize(): bool =
    let size = RustCsgFileSize("/etc/passwd")
    if !checkTrue("etc_passwd_size_gt_0", size > int64(0)):
        return false
    let noneSize = RustCsgFileSize("/nonexistent_file_xyz_42")
    if !checkEq64("nonexist_size_minus1", int64(-1), noneSize):
        return false
    echo("testFileSize ok")
    return true

fn testMkdirWriteRead(): bool =
    let testDir: str = "/tmp/_rust_csg_fs_provider_test_dir"
    let mkdirOk: int32 = RustCsgMkdir(testDir)
    let testFile: str = "/tmp/_rust_csg_fs_provider_test_dir/roundtrip.txt"
    let testContent: str = "Hello from FS Provider Gate!"
    let writeOk: int32 = RustCsgWriteFile(testFile, testContent)
    if !checkTrue("write_ok", writeOk != 0):
        echo("writeFile failed")
        return false
    let content: str = ReadFile(testFile)
    if !checkTrue("read_not_empty", content != ""):
        return false
    if !checkEqStr("read_content", testContent, content):
        return false
    let fs: int64 = RustCsgFileSize(testFile)
    let expected: int64 = int64(28)
    if !checkEq64("file_size_match", expected, fs):
        return false
    echo("testMkdirWriteRead ok")
    return true

fn main(): int32 =
    echo("fs_provider_gate start")
    var allOk: bool = true
    if !testFileExists(): allOk = false
    if !testDirExists(): allOk = false
    if !testGetEnv(): allOk = false
    if !testFileSize(): allOk = false
    if !testMkdirWriteRead(): allOk = false
    if allOk:
        echo("rust_csg_fs_provider_gate_smoke ok")
        return 0
    else:
        echo("rust_csg_fs_provider_gate_smoke FAILED")
        return 1
