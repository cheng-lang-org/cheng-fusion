import cheng/codex/core/thread_runtime as core_runtime
import cheng/codex/mcp_server/main as mcp
import cheng/codex/protocol/wire

fn assertEq(name: str, got: str, expected: str) =
    if got != expected:
        echo(name)
        echo(got)
        echo(expected)
    assert(got == expected, name)

fn assertContains(name: str, text: str, needle: str) =
    if !wire.RustCsgContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(wire.RustCsgContains(text, needle), name)

fn assertNotContains(name: str, text: str, needle: str) =
    if wire.RustCsgContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(!wire.RustCsgContains(text, needle), name)

fn main(): int32 =
    var err: str

    mcp.RustCsgMcpRuntimeResetForTest()
    let execParams = "{\"call_id\":\"exec-call-1\",\"approval_id\":\"approval-1\",\"turn_id\":\"turn-from-event-payload\",\"started_at_ms\":123,\"command\":[\"echo\",\"approval\"],\"cwd\":\"/tmp/codex-mcp\",\"available_decisions\":[\"approved\",\"denied\",\"abort\"],\"parsed_cmd\":[]}"
    assert(mcp.RustCsgMcpRegisterPendingApprovalFromEventForTest(0,
                                                                 "mcp-thread-approval",
                                                                 34,
                                                                 "approval-event-1",
                                                                 "exec_approval_request",
                                                                 execParams,
                                                                 err),
           "mcp_exec_pending_register")
    assertEq("mcp_exec_pending_register_err", err, "")
    assertEq("mcp_exec_response_frames",
             mcp.RustCsgMcpHandleFramesForTest("{\"jsonrpc\":\"2.0\",\"id\":0,\"result\":{\"decision\":\"approved\"}}"),
             "")
    assert(core_runtime.RustCsgCoreThreadSubmittedApprovalCount() == 1, "mcp_exec_submitted_once")
    assert(core_runtime.RustCsgCoreThreadDispatchedSubmissionCount() == 1, "mcp_exec_dispatched_once")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "mcp_exec_waiter_consumed")
    let expectedExecOp = "{\"type\":\"exec_approval\",\"id\":\"approval-1\",\"turn_id\":\"approval-event-1\",\"decision\":\"approved\"}"
    assertEq("mcp_exec_resolved_op",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("mcp-thread-approval", "exec_approval", "approval-1", "approval-event-1"),
             expectedExecOp)
    let execSubmission = core_runtime.RustCsgCoreThreadLastSubmissionJson()
    assertContains("mcp_exec_submission_has_op", execSubmission, expectedExecOp)
    assertNotContains("mcp_exec_submission_wire_has_no_thread_id", execSubmission, "thread_id")
    assert(mcp.RustCsgMcpPendingElicitationCountForTest() == 0, "mcp_exec_pending_removed")

    mcp.RustCsgMcpRuntimeResetForTest()
    let patchParams = "{\"call_id\":\"patch-call-1\",\"turn_id\":\"patch-turn-payload\",\"reason\":\"Need to update fixture\",\"grant_root\":\"/tmp/codex-mcp\",\"changes\":{\"/tmp/codex-mcp/file.txt\":{\"type\":\"update\"}}}"
    assert(mcp.RustCsgMcpRegisterPendingApprovalFromEventForTest(1,
                                                                 "mcp-thread-patch",
                                                                 36,
                                                                 "patch-event-1",
                                                                 "apply_patch_approval_request",
                                                                 patchParams,
                                                                 err),
           "mcp_patch_pending_register")
    assertEq("mcp_patch_pending_register_err", err, "")
    assertEq("mcp_patch_response_frames",
             mcp.RustCsgMcpHandleFramesForTest("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"decision\":\"approved\"}}"),
             "")
    let expectedPatchOp = "{\"type\":\"patch_approval\",\"id\":\"patch-call-1\",\"decision\":\"approved\"}"
    assertEq("mcp_patch_resolved_op",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("mcp-thread-patch", "patch_approval", "patch-call-1", ""),
             expectedPatchOp)
    assert(core_runtime.RustCsgCoreThreadSubmittedApprovalCount() == 1, "mcp_patch_submitted_once")
    assert(core_runtime.RustCsgCoreThreadDispatchedSubmissionCount() == 1, "mcp_patch_dispatched_once")
    assert(mcp.RustCsgMcpPendingElicitationCountForTest() == 0, "mcp_patch_pending_removed")

    mcp.RustCsgMcpRuntimeResetForTest()
    assert(mcp.RustCsgMcpRegisterPendingApprovalFromEventForTest(2,
                                                                 "mcp-thread-denied",
                                                                 40,
                                                                 "approval-event-denied",
                                                                 "exec_approval_request",
                                                                 execParams,
                                                                 err),
           "mcp_denied_pending_register")
    assertEq("mcp_denied_response_frames",
             mcp.RustCsgMcpHandleFramesForTest("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{}}"),
             "")
    assertEq("mcp_missing_decision_denied_op",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("mcp-thread-denied", "exec_approval", "approval-1", "approval-event-denied"),
             "{\"type\":\"exec_approval\",\"id\":\"approval-1\",\"turn_id\":\"approval-event-denied\",\"decision\":\"denied\"}")

    mcp.RustCsgMcpRuntimeResetForTest()
    assert(mcp.RustCsgMcpRegisterPendingApprovalFromEventForTest(3,
                                                                 "mcp-thread-error",
                                                                 41,
                                                                 "approval-event-error",
                                                                 "exec_approval_request",
                                                                 execParams,
                                                                 err),
           "mcp_error_pending_register")
    assertEq("mcp_error_response_frames",
             mcp.RustCsgMcpHandleFramesForTest("{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32000,\"message\":\"client failed\"}}"),
             "")
    assert(core_runtime.RustCsgCoreThreadSubmittedApprovalCount() == 0, "mcp_jsonrpc_error_does_not_submit")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 1, "mcp_jsonrpc_error_keeps_core_waiter")
    assert(mcp.RustCsgMcpPendingElicitationCountForTest() == 1, "mcp_jsonrpc_error_keeps_pending_callback")

    echo("rust_csg_mcp_elicitation_core_submit_smoke ok")
    return 0
