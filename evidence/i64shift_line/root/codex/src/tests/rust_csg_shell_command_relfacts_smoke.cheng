fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgShellCommand =\n        tokens: str[]\n        raw: str\n        shellType: int32\n        executable: str\n        cwd: str\n        envCount: int32\n\ntype\n    RustCsgExitStatus =\n        code: int32\n        signal: int32\n        signaled: bool\n        success: bool\n\ntype\n    RustCsgCommandResult =\n        exitStatus: RustCsgExitStatus\n        stdout: str\n        stderr: str\n        command: str\n        durationMs: int32\n\ntype\n    RustCsgApprovalRequest =\n        command: RustCsgShellCommand\n        reason: str\n        decision: int32\n        requestId: str\n\ntype\n    RustCsgApprovalResponse =\n        approved: bool\n        requestId: str\n        reason: str\n        sandboxOverride: int32\n\nfn RustCsgShellTypeToString(t: int32): str =\nfn RustCsgDetectShellType(shellPath: str): int32 =\nfn RustCsgShellCommandNew(tokens: str[]): RustCsgShellCommand =\nfn RustCsgShellCommandDetectShell(cmd: var RustCsgShellCommand): =\nfn RustCsgShellCommandIsDangerous(cmd: RustCsgShellCommand): bool =\nfn RustCsgShellCommandIsSafe(cmd: RustCsgShellCommand): bool =\nfn RustCsgExitStatusNew(): RustCsgExitStatus =\nfn RustCsgExitStatusFromCode(code: int32): RustCsgExitStatus =\nfn RustCsgExitStatusFromSignal(signal: int32): RustCsgExitStatus =\nfn RustCsgExitStatusIsOk(es: RustCsgExitStatus): bool =\nfn RustCsgCommandResultNew(): RustCsgCommandResult =\nfn RustCsgCommandResultSucceeded(r: RustCsgCommandResult): bool =\nfn RustCsgExtractBashCommand(tokens: str[]): (str, str) =\nfn RustCsgExtractPowershellCommand(tokens: str[]): (str, str) =\nfn RustCsgExtractShellCommand(tokens: str[]): (str, str) =\nfn RustCsgShlexJoin(tokens: str[]): str =\nfn RustCsgShlexJoinTwo(a: str, b: str): str =\nfn RustCsgShellIsDangerousCommand(cmd: str): bool =\nfn RustCsgShellIsSafeCommand(cmd: str): bool =\nfn RustCsgApprovalRequestNew(cmd: RustCsgShellCommand, reason: str): RustCsgApprovalRequest =\nfn RustCsgApprovalRequestIsApproved(req: RustCsgApprovalRequest): bool =\nfn RustCsgApprovalRequestIsDenied(req: RustCsgApprovalRequest): bool =\nfn RustCsgApprovalRequestIsPending(req: RustCsgApprovalRequest): bool =\nfn RustCsgApprovalResponseNew(approved: bool, requestId: str, reason: str): RustCsgApprovalResponse =\nfn RustCsgSandboxPermissionsRequiresEscalated(v: int32): bool =\nfn RustCsgSandboxPermissionsRequestsOverride(v: int32): bool =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tshell_command\nLocalType\tshell_command\tRustCsgShellCommand\nHasField\tshell_command\tRustCsgShellCommand\ttokens\tstr[]\nHasField\tshell_command\tRustCsgShellCommand\traw\tstr\nHasField\tshell_command\tRustCsgShellCommand\tshellType\tint32\nHasField\tshell_command\tRustCsgShellCommand\texecutable\tstr\nHasField\tshell_command\tRustCsgShellCommand\tcwd\tstr\nHasField\tshell_command\tRustCsgShellCommand\tenvCount\tint32\nLocalType\tshell_command\tRustCsgExitStatus\nHasField\tshell_command\tRustCsgExitStatus\tcode\tint32\nHasField\tshell_command\tRustCsgExitStatus\tsignal\tint32\nHasField\tshell_command\tRustCsgExitStatus\tsignaled\tbool\nHasField\tshell_command\tRustCsgExitStatus\tsuccess\tbool\nLocalType\tshell_command\tRustCsgCommandResult\nHasField\tshell_command\tRustCsgCommandResult\texitStatus\tRustCsgExitStatus\nHasField\tshell_command\tRustCsgCommandResult\tstdout\tstr\nHasField\tshell_command\tRustCsgCommandResult\tstderr\tstr\nHasField\tshell_command\tRustCsgCommandResult\tcommand\tstr\nHasField\tshell_command\tRustCsgCommandResult\tdurationMs\tint32\nLocalType\tshell_command\tRustCsgApprovalRequest\nHasField\tshell_command\tRustCsgApprovalRequest\tcommand\tRustCsgShellCommand\nHasField\tshell_command\tRustCsgApprovalRequest\treason\tstr\nHasField\tshell_command\tRustCsgApprovalRequest\tdecision\tint32\nHasField\tshell_command\tRustCsgApprovalRequest\trequestId\tstr\nLocalType\tshell_command\tRustCsgApprovalResponse\nHasField\tshell_command\tRustCsgApprovalResponse\tapproved\tbool\nHasField\tshell_command\tRustCsgApprovalResponse\trequestId\tstr\nHasField\tshell_command\tRustCsgApprovalResponse\treason\tstr\nHasField\tshell_command\tRustCsgApprovalResponse\tsandboxOverride\tint32\nFunction\tshell_command\tRustCsgShellTypeToString\tstr\nFunction\tshell_command\tRustCsgDetectShellType\tint32\nFunction\tshell_command\tRustCsgShellCommandNew\tRustCsgShellCommand\nFunction\tshell_command\tRustCsgShellCommandDetectShell\t\nFunction\tshell_command\tRustCsgShellCommandIsDangerous\tbool\nFunction\tshell_command\tRustCsgShellCommandIsSafe\tbool\nFunction\tshell_command\tRustCsgExitStatusNew\tRustCsgExitStatus\nFunction\tshell_command\tRustCsgExitStatusFromCode\tRustCsgExitStatus\nFunction\tshell_command\tRustCsgExitStatusFromSignal\tRustCsgExitStatus\nFunction\tshell_command\tRustCsgExitStatusIsOk\tbool\nFunction\tshell_command\tRustCsgCommandResultNew\tRustCsgCommandResult\nFunction\tshell_command\tRustCsgCommandResultSucceeded\tbool\nFunction\tshell_command\tRustCsgExtractBashCommand\t(str, str)\nFunction\tshell_command\tRustCsgExtractPowershellCommand\t(str, str)\nFunction\tshell_command\tRustCsgExtractShellCommand\t(str, str)\nFunction\tshell_command\tRustCsgShlexJoin\tstr\nFunction\tshell_command\tRustCsgShlexJoinTwo\tstr\nFunction\tshell_command\tRustCsgShellIsDangerousCommand\tbool\nFunction\tshell_command\tRustCsgShellIsSafeCommand\tbool\nFunction\tshell_command\tRustCsgApprovalRequestNew\tRustCsgApprovalRequest\nFunction\tshell_command\tRustCsgApprovalRequestIsApproved\tbool\nFunction\tshell_command\tRustCsgApprovalRequestIsDenied\tbool\nFunction\tshell_command\tRustCsgApprovalRequestIsPending\tbool\nFunction\tshell_command\tRustCsgApprovalResponseNew\tRustCsgApprovalResponse\nFunction\tshell_command\tRustCsgSandboxPermissionsRequiresEscalated\tbool\nFunction\tshell_command\tRustCsgSandboxPermissionsRequestsOverride\tbool\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 5, "source type count")
    assert(ecf == 23, "source field count")
    assert(ecn == 26, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 5, "oracle type count")
    assert(ocf == 23, "oracle field count")
    assert(ocn == 26, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_shell_command_relfacts_smoke ok")
    return 0

main()