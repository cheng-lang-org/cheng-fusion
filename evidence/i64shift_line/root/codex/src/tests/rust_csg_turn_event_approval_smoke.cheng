    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "app_server_registered_file_dispatch")
    assertEq("app_server_registered_file_dispatch_err", err, "")
    assertEq("app_server_registered_file_resolved",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "patch_approval", "patch-call-core", ""),
             pendingFileAcceptOp)
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "app_server_registered_file_waiter_consumed")

    core_runtime.RustCsgCoreThreadRuntimeReset()
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "patch_approval", "patch-call-core", "", err), "server_request_resolve_file_waiter")
    let resolveFileParams = "{\"threadId\":\"thread-core\",\"requestId\":23,\"kind\":\"fileChange\",\"itemId\":\"patch-call-core\",\"result\":{\"decision\":\"acceptForSession\"}}"
    assert(loop.RustCsgAppServerTurnEventSubmitServerRequestApprovalResponse(resolveFileParams, resolveCoreOp, resolveResolved, err), "server_request_resolve_file_ok")
    assertEq("server_request_resolve_file_err", err, "")
    assert(resolveResolved, "server_request_resolve_file_resolved")
    assertEq("server_request_resolve_file_core_op", resolveCoreOp, "{\"type\":\"patch_approval\",\"id\":\"patch-call-core\",\"decision\":\"approved_for_session\"}")
    assertEq("server_request_resolve_file_core_resolved",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "patch_approval", "patch-call-core", ""),
             resolveCoreOp)
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "server_request_resolve_file_waiter_consumed")

    let resolveMissingTurnParams = "{\"threadId\":\"thread-core\",\"requestId\":21,\"kind\":\"commandExecution\",\"approvalId\":\"approval-core\",\"itemId\":\"exec-call-core\",\"result\":{\"decision\":\"accept\"}}"
    let missingTurnOk = loop.RustCsgAppServerTurnEventSubmitServerRequestApprovalResponse(resolveMissingTurnParams, resolveCoreOp, resolveResolved, err)
    assert(!missingTurnOk, "server_request_resolve_missing_turn_fails")
    assertNonEmpty("server_request_resolve_missing_turn_err", err)

    let liveFileAcceptNotification = loop.RustCsgAppServerTurnEventApprovalPendingLiveClientFrame("thread-core",
                                                                                                  pendingFile,
                                                                                                  "{\"id\":23,\"result\":{\"decision\":\"accept\"}}",
                                                                                                  int64(1780000505),
                                                                                                  resolved,
                                                                                                  liveCoreOp,
                                                                                                  err)
    assertEq("pending_file_live_accept_err", err, "")
    assert(resolved, "pending_file_live_accept_resolved")
    assertEq("pending_file_live_accept_core_op", liveCoreOp, "{\"type\":\"patch_approval\",\"id\":\"patch-call-core\",\"decision\":\"approved\"}")
    assertEq("pending_file_live_accept_notification", liveFileAcceptNotification, "")

    let liveFileStateNotification = loop.RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrame("thread-core",
                                                                                                   pendingFile,
                                                                                                   "{\"id\":23,\"result\":{\"decision\":\"accept\"}}",
                                                                                                   int64(1780000508),
                                                                                                   nextPending,
                                                                                                   liveCoreOp,
                                                                                                   liveHandled,
                                                                                                   liveResolved,
                                                                                                   err)
    assertEq("pending_file_live_state_err", err, "")
    assert(liveHandled, "pending_file_live_state_handled")
    assert(liveResolved, "pending_file_live_state_resolved")
    assertEq("pending_file_live_state_next", nextPending, "")
    assertEq("pending_file_live_state_core_op", liveCoreOp, "{\"type\":\"patch_approval\",\"id\":\"patch-call-core\",\"decision\":\"approved\"}")
    assertEq("pending_file_live_state_notification", liveFileStateNotification, "")

    let liveFileTransportDropNotification = loop.RustCsgAppServerTurnEventApprovalLiveStateAfterClientFrame("thread-core",
                                                                                                           pendingFile,
                                                                                                           "{\"id\":23}",
                                                                                                           int64(1780000511),
                                                                                                           nextPending,
                                                                                                           liveCoreOp,
                                                                                                           liveHandled,
                                                                                                           liveResolved,
                                                                                                           err)
    assertEq("pending_file_live_transport_drop_err", err, "")
    assert(liveHandled, "pending_file_live_transport_drop_handled")
    assert(liveResolved, "pending_file_live_transport_drop_resolved")
    assertEq("pending_file_live_transport_drop_next", nextPending, "")
    assertEq("pending_file_live_transport_drop_core_op", liveCoreOp, "{\"type\":\"patch_approval\",\"id\":\"patch-call-core\",\"decision\":\"denied\"}")
    assertEq("pending_file_live_transport_drop_notification", liveFileTransportDropNotification, "")

    let pendingFileBadResultOp = loop.RustCsgAppServerTurnEventApprovalPendingCoreOpFromClientFrame(pendingFile,
                                                                                                    "{\"id\":23,\"result\":{\"decision\":{\"cancel\":{}}}}",
                                                                                                    resolved,
                                                                                                    err)
    assertEq("pending_file_bad_result_err", err, "")
    assert(resolved, "pending_file_bad_result_resolved")
    assertEq("pending_file_bad_result_op", pendingFileBadResultOp, "{\"type\":\"patch_approval\",\"id\":\"patch-call-core\",\"decision\":\"denied\"}")

    let fileObjectKind = loop.RustCsgAppServerTurnEventFileChangeApprovalDecisionKindFromResponse("{\"id\":8,\"result\":{\"decision\":{\"cancel\":{}}}}", err)
    assertEq("file_object_kind", fileObjectKind, "")
    assertNonEmpty("file_object_err", err)

    echo("rust_csg_turn_event_approval_smoke ok")
    return 0

main()
