import cheng/codex/app_server/turn_event_loop as loop
import cheng/codex/core/thread_runtime as core_runtime

fn assertEq(name: str, got: str, expected: str) =
    if got != expected:
        echo(name)
        echo(got)
        echo(expected)
    assert(got == expected, name)

fn assertNonEmpty(name: str, got: str) =
    if got == "":
        echo(name)
    assert(got != "", name)

fn main(): int32 =
    core_runtime.RustCsgCoreThreadRuntimeReset()

    let commandRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequest(7,
                                                                                      "thread-1",
                                                                                      "turn-1",
                                                                                      "item-1",
                                                                                      int64(1780000100),
                                                                                      "approval-1",
                                                                                      "needs permission",
                                                                                      "{\"host\":\"example.com\"}",
                                                                                      "bash -lc pwd",
                                                                                      "/work",
                                                                                      "[{\"type\":\"read\"}]",
                                                                                      "{\"mode\":\"workspaceWrite\"}",
                                                                                      "{\"allow\":[\"/work\"]}",
                                                                                      "[{\"host\":\"example.com\"}]",
                                                                                      "[\"accept\",\"decline\"]")
    let expectedCommandRequest = "{\"id\":7,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-1\",\"turnId\":\"turn-1\",\"itemId\":\"item-1\",\"startedAtMs\":1780000100,\"approvalId\":\"approval-1\",\"reason\":\"needs permission\",\"networkApprovalContext\":{\"host\":\"example.com\"},\"command\":\"bash -lc pwd\",\"cwd\":\"/work\",\"commandActions\":[{\"type\":\"read\"}],\"additionalPermissions\":{\"mode\":\"workspaceWrite\"},\"proposedExecpolicyAmendment\":{\"allow\":[\"/work\"]},\"proposedNetworkPolicyAmendments\":[{\"host\":\"example.com\"}],\"availableDecisions\":[\"accept\",\"decline\"]}}"
    assertEq("command_approval_request", commandRequest, expectedCommandRequest)

    let fileRequest = loop.RustCsgAppServerTurnEventFileChangeApprovalRequest(8,
                                                                             "thread-file",
                                                                             "turn-file",
                                                                             "item-file",
                                                                             int64(1780000200),
                                                                             "patch wants write",
                                                                             "/work")
    let expectedFileRequest = "{\"id\":8,\"method\":\"item/fileChange/requestApproval\",\"params\":{\"threadId\":\"thread-file\",\"turnId\":\"turn-file\",\"itemId\":\"item-file\",\"startedAtMs\":1780000200,\"reason\":\"patch wants write\",\"grantRoot\":\"/work\"}}"
    assertEq("file_change_approval_request", fileRequest, expectedFileRequest)

    var coreErr: str
    let coreCommandEvent = "{\"call_id\":\"exec-call-core\",\"approval_id\":\"approval-core\",\"turn_id\":\"turn-core\",\"started_at_ms\":1780000300,\"command\":[\"bash\",\"-lc\",\"pwd\"],\"cwd\":\"/work\",\"reason\":\"needs exec\",\"proposed_execpolicy_amendment\":[\"/work\"],\"available_decisions\":[\"approved\",{\"approved_execpolicy_amendment\":{\"proposed_execpolicy_amendment\":[\"/work\"]}},\"timed_out\",\"abort\"],\"parsed_cmd\":[]}"
    let coreCommandRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(9, "thread-core", coreCommandEvent, coreErr)
    assertEq("core_command_approval_err", coreErr, "")
    let expectedCoreCommandRequest = "{\"id\":9,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-core\",\"itemId\":\"exec-call-core\",\"startedAtMs\":1780000300,\"approvalId\":\"approval-core\",\"reason\":\"needs exec\",\"command\":\"bash -lc pwd\",\"cwd\":\"/work\",\"proposedExecpolicyAmendment\":[\"/work\"],\"availableDecisions\":[\"accept\",{\"acceptWithExecpolicyAmendment\":{\"execpolicy_amendment\":[\"/work\"]}},\"decline\",\"cancel\"]}}"
    assertEq("core_command_approval_request", coreCommandRequest, expectedCoreCommandRequest)

    let coreNetworkEvent = "{\"call_id\":\"exec-call-network\",\"turn_id\":\"turn-network\",\"started_at_ms\":1780000301,\"command\":[\"ignored\"],\"cwd\":\"/work\",\"network_approval_context\":{\"host\":\"example.com\"},\"available_decisions\":[\"approved\",{\"network_policy_amendment\":{\"network_policy_amendment\":{\"host\":\"example.com\",\"action\":\"allow\"}}}],\"parsed_cmd\":[]}"
    let coreNetworkRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(10, "thread-core", coreNetworkEvent, coreErr)
    assertEq("core_network_approval_err", coreErr, "")
    let expectedCoreNetworkRequest = "{\"id\":10,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-network\",\"itemId\":\"exec-call-network\",\"startedAtMs\":1780000301,\"networkApprovalContext\":{\"host\":\"example.com\"},\"availableDecisions\":[\"accept\",{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":{\"host\":\"example.com\",\"action\":\"allow\"}}}]}}"
    assertEq("core_network_approval_request", coreNetworkRequest, expectedCoreNetworkRequest)

    let missingStartedRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(11, "thread-core", "{\"call_id\":\"exec-call-missing\",\"turn_id\":\"turn-core\",\"command\":[\"pwd\"],\"cwd\":\"/work\",\"available_decisions\":[\"approved\"],\"parsed_cmd\":[]}", coreErr)
    assertEq("core_command_missing_started_request", missingStartedRequest, "")
    assertNonEmpty("core_command_missing_started_err", coreErr)

    let parsedCmdRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(12, "thread-core", "{\"call_id\":\"exec-call-parsed\",\"turn_id\":\"turn-core\",\"started_at_ms\":1780000302,\"command\":[\"cat\",\"README.md\"],\"cwd\":\"/work\",\"available_decisions\":[\"approved\"],\"parsed_cmd\":[{\"type\":\"read\",\"cmd\":\"cat README.md\",\"name\":\"README.md\",\"path\":\"README.md\"}]}", coreErr)
    assertEq("core_command_parsed_cmd_err", coreErr, "")
    let expectedParsedCmdRequest = "{\"id\":12,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-core\",\"itemId\":\"exec-call-parsed\",\"startedAtMs\":1780000302,\"command\":\"cat README.md\",\"cwd\":\"/work\",\"commandActions\":[{\"type\":\"read\",\"command\":\"cat README.md\",\"name\":\"README.md\",\"path\":\"/work/README.md\"}],\"availableDecisions\":[\"accept\"]}}"
    assertEq("core_command_parsed_cmd_request", parsedCmdRequest, expectedParsedCmdRequest)

    let defaultDecisionRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(14, "thread-core", "{\"call_id\":\"exec-call-default\",\"turn_id\":\"turn-core\",\"started_at_ms\":1780000303,\"command\":[\"pwd\"],\"cwd\":\"/work\",\"proposed_execpolicy_amendment\":[\"pwd\"],\"parsed_cmd\":[]}", coreErr)
    assertEq("core_command_default_decisions_err", coreErr, "")
    let expectedDefaultDecisionRequest = "{\"id\":14,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-core\",\"itemId\":\"exec-call-default\",\"startedAtMs\":1780000303,\"command\":\"pwd\",\"cwd\":\"/work\",\"proposedExecpolicyAmendment\":[\"pwd\"],\"availableDecisions\":[\"accept\",{\"acceptWithExecpolicyAmendment\":{\"execpolicy_amendment\":[\"pwd\"]}},\"cancel\"]}}"
    assertEq("core_command_default_decisions_request", defaultDecisionRequest, expectedDefaultDecisionRequest)

    let defaultNetworkDecisionRequest = loop.RustCsgAppServerTurnEventCommandExecutionApprovalRequestFromCoreEvent(15, "thread-core", "{\"call_id\":\"exec-call-network-default\",\"turn_id\":\"turn-network\",\"started_at_ms\":1780000304,\"command\":[\"ignored\"],\"cwd\":\"/work\",\"network_approval_context\":{\"host\":\"example.com\"},\"proposed_network_policy_amendments\":[{\"host\":\"example.com\",\"action\":\"deny\"},{\"host\":\"example.com\",\"action\":\"allow\"}],\"parsed_cmd\":[]}", coreErr)
    assertEq("core_network_default_decisions_err", coreErr, "")
    let expectedDefaultNetworkDecisionRequest = "{\"id\":15,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-network\",\"itemId\":\"exec-call-network-default\",\"startedAtMs\":1780000304,\"networkApprovalContext\":{\"host\":\"example.com\"},\"proposedNetworkPolicyAmendments\":[{\"host\":\"example.com\",\"action\":\"deny\"},{\"host\":\"example.com\",\"action\":\"allow\"}],\"availableDecisions\":[\"accept\",\"acceptForSession\",{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":{\"host\":\"example.com\",\"action\":\"allow\"}}},\"cancel\"]}}"
    assertEq("core_network_default_decisions_request", defaultNetworkDecisionRequest, expectedDefaultNetworkDecisionRequest)

    let coreFileEvent = "{\"call_id\":\"patch-call-core\",\"turn_id\":\"turn-file-core\",\"started_at_ms\":1780000400,\"changes\":{\"/work/file.txt\":{\"additions\":1,\"deletions\":0}},\"reason\":\"patch wants write\",\"grant_root\":\"/work\"}"
    let coreFileRequest = loop.RustCsgAppServerTurnEventFileChangeApprovalRequestFromCoreEvent(13, "thread-core", coreFileEvent, coreErr)
    assertEq("core_file_approval_err", coreErr, "")
    let expectedCoreFileRequest = "{\"id\":13,\"method\":\"item/fileChange/requestApproval\",\"params\":{\"threadId\":\"thread-core\",\"turnId\":\"turn-file-core\",\"itemId\":\"patch-call-core\",\"startedAtMs\":1780000400,\"reason\":\"patch wants write\",\"grantRoot\":\"/work\"}}"
    assertEq("core_file_approval_request", coreFileRequest, expectedCoreFileRequest)

    var payload: str
    var err: str
    let acceptKind = loop.RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse("{\"id\":7,\"result\":{\"decision\":\"acceptForSession\"}}", payload, err)
    assertEq("command_accept_err", err, "")
    assertEq("command_accept_payload", payload, "")
    assertEq("command_accept_kind", acceptKind, "approved_for_session")

    let execpolicyKind = loop.RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse("{\"id\":7,\"result\":{\"decision\":{\"acceptWithExecpolicyAmendment\":{\"execpolicy_amendment\":[\"/work\"]}}}}", payload, err)
    assertEq("command_execpolicy_err", err, "")
    assertEq("command_execpolicy_kind", execpolicyKind, "approved_execpolicy_amendment")
    assertEq("command_execpolicy_payload", payload, "{\"execpolicy_amendment\":[\"/work\"]}")

    let networkKind = loop.RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse("{\"id\":7,\"result\":{\"decision\":{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":{\"action\":\"allow\",\"host\":\"example.com\"}}}}}", payload, err)
    assertEq("command_network_err", err, "")
    assertEq("command_network_kind", networkKind, "network_policy_amendment")
    assertEq("command_network_payload", payload, "{\"network_policy_amendment\":{\"action\":\"allow\",\"host\":\"example.com\"}}")

    let invalidNetworkKind = loop.RustCsgAppServerTurnEventCommandExecutionApprovalDecisionKindFromResponse("{\"id\":7,\"result\":{\"decision\":{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":{\"action\":\"block\",\"host\":\"example.com\"}}}}}", payload, err)
    assertEq("command_invalid_network_kind", invalidNetworkKind, "")
    assertNonEmpty("command_invalid_network_err", err)

    let acceptOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"accept\"}}",
                                                                                            "approval-core",
                                                                                            "exec-call-core",
                                                                                            "turn-core",
                                                                                            err)
    assertEq("command_accept_op_err", err, "")
    assertEq("command_accept_op", acceptOp, "{\"type\":\"exec_approval\",\"id\":\"approval-core\",\"turn_id\":\"turn-core\",\"decision\":\"approved\"}")

    let noSubmitGap = loop.RustCsgAppServerTurnEventApprovalCoreSubmitRequiredError(acceptOp, 0)
    assertEq("approval_core_submit_no_gap", noSubmitGap, "")
    let submitGap = loop.RustCsgAppServerTurnEventApprovalCoreSubmitRequiredError(acceptOp, 1)
    assertEq("approval_core_submit_gap",
             submitGap,
             "approval core submit requires same-process CodexThread.submit(Op::ExecApproval/PatchApproval); generated core op count=1; generated core ops={\"type\":\"exec_approval\",\"id\":\"approval-core\",\"turn_id\":\"turn-core\",\"decision\":\"approved\"}")

    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOp("thread-core", acceptOp, err), "core_submit_without_waiter_queued")
    assertEq("core_submit_without_waiter_err", err, "")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_submit_without_waiter_no_active_waiter")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_missing_waiter_dispatch_ok")
    assertEq("core_missing_waiter_dispatch_err", err, "")
    assert(core_runtime.RustCsgCoreThreadMissingNotifyCount() == 1, "core_missing_waiter_notify_recorded")
    core_runtime.RustCsgCoreThreadRuntimeReset()
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-core", "turn-core", err), "core_exec_waiter_registered")
    assertEq("core_exec_waiter_register_err", err, "")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 1, "core_exec_waiter_active")
    let duplicateWaiter = core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-core", "turn-overwrite", err)
    assert(duplicateWaiter, "core_duplicate_waiter_overwrites")
    assertEq("core_duplicate_waiter_err", err, "")
    assert(core_runtime.RustCsgCoreThreadOverwrittenPendingApprovalCount() == 1, "core_duplicate_waiter_overwrite_count")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 1, "core_duplicate_waiter_active_count")
    assertEq("core_duplicate_waiter_old_receiver",
             core_runtime.RustCsgCoreThreadLastClosedPendingJson(),
             "{\"thread_id\":\"thread-core\",\"op_type\":\"exec_approval\",\"approval_id\":\"approval-core\",\"turn_id\":\"turn-core\",\"reason\":\"overwritten\",\"receiver_decision\":\"abort\"}")
    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOp("thread-core", acceptOp, err), "core_exec_submit_ok")
    assertEq("core_exec_submit_err", err, "")
    assert(core_runtime.RustCsgCoreThreadSubmittedApprovalCount() == 1, "core_submit_count_one")
    assert(core_runtime.RustCsgCoreThreadDispatchedSubmissionCount() == 0, "core_submit_not_dispatched_yet")
    assertEq("core_resolved_before_dispatch",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-core", "turn-core"),
             "")
    assertEq("core_last_submit_op", core_runtime.RustCsgCoreThreadLastSubmittedApprovalOp(), acceptOp)
    assertEq("core_last_submission_json",
             core_runtime.RustCsgCoreThreadLastSubmissionJson(),
             "{\"id\":\"submission-0\",\"op\":{\"type\":\"exec_approval\",\"id\":\"approval-core\",\"turn_id\":\"turn-core\",\"decision\":\"approved\"}}")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_dispatch_ok")
    assertEq("core_dispatch_err", err, "")
    assert(core_runtime.RustCsgCoreThreadDispatchedSubmissionCount() == 1, "core_dispatch_count_one")
    assertEq("core_resolved_exec_op",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-core", "turn-core"),
             acceptOp)
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_exec_waiter_consumed")

    let deniedAgainOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"decline\"}}",
                                                                                                  "approval-core",
                                                                                                  "exec-call-core",
                                                                                                  "turn-core",
                                                                                                  err)
    assertEq("command_denied_again_op_err", err, "")
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-core", "turn-core", err), "core_exec_waiter_reregistered")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 1, "core_exec_waiter_reregistered_active")
    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOp("thread-core", deniedAgainOp, err), "core_exec_resubmit_after_resolve_ok")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_exec_redispatch_after_resolve_ok")
    assertEq("core_resolved_exec_op_after_reregister",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-core", "turn-core"),
             deniedAgainOp)
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_exec_waiter_reuse_consumed")

    let traceOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"accept\"}}",
                                                                                            "approval-trace",
                                                                                            "exec-call-trace",
                                                                                            "turn-trace",
                                                                                            err)
    assertEq("command_trace_op_err", err, "")
    core_runtime.RustCsgCoreThreadRuntimeReset()
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-trace", "turn-trace", err), "core_trace_waiter_registered")
    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOpWithTrace("thread-core",
                                                                   "submission-trace-1",
                                                                   "00-0123456789abcdef0123456789abcdef-0123456789abcdef-01",
                                                                   "codex=trace",
                                                                   traceOp,
                                                                   err),
           "core_trace_submit_ok")
    assertEq("core_trace_submit_err", err, "")
    assertEq("core_trace_submission_json",
             core_runtime.RustCsgCoreThreadLastSubmissionJson(),
             "{\"id\":\"submission-trace-1\",\"op\":{\"type\":\"exec_approval\",\"id\":\"approval-trace\",\"turn_id\":\"turn-trace\",\"decision\":\"approved\"},\"trace\":{\"traceparent\":\"00-0123456789abcdef0123456789abcdef-0123456789abcdef-01\",\"tracestate\":\"codex=trace\"}}")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_trace_dispatch_ok")
    assertEq("core_trace_resolved_op",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-trace", "turn-trace"),
             traceOp)
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_trace_waiter_consumed")

    core_runtime.RustCsgCoreThreadRuntimeReset()
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-interrupt-a", "turn-interrupt", err), "core_interrupt_waiter_a_registered")
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "patch_approval", "approval-interrupt-b", "", err), "core_interrupt_waiter_b_registered")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 2, "core_interrupt_waiters_active")
    assert(core_runtime.RustCsgCoreThreadSubmitInterruptOp("thread-core", err), "core_interrupt_submit_ok")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_interrupt_dispatch_ok")
    assert(core_runtime.RustCsgCoreThreadInterruptCount() == 1, "core_interrupt_count")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_interrupt_clears_all_waiters")

    let itemFallbackOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"acceptForSession\"}}",
                                                                                                  "",
                                                                                                  "exec-call-core",
                                                                                                  "turn-core",
                                                                                                  err)
    assertEq("command_item_fallback_op_err", err, "")
    assertEq("command_item_fallback_op", itemFallbackOp, "{\"type\":\"exec_approval\",\"id\":\"exec-call-core\",\"turn_id\":\"turn-core\",\"decision\":\"approved_for_session\"}")

    let execpolicyOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":{\"acceptWithExecpolicyAmendment\":{\"execpolicy_amendment\":[\"/work\"]}}}}",
                                                                                                "approval-core",
                                                                                                "exec-call-core",
                                                                                                "turn-core",
                                                                                                err)
    assertEq("command_execpolicy_op_err", err, "")
    assertEq("command_execpolicy_op", execpolicyOp, "{\"type\":\"exec_approval\",\"id\":\"approval-core\",\"turn_id\":\"turn-core\",\"decision\":{\"approved_execpolicy_amendment\":{\"proposed_execpolicy_amendment\":[\"/work\"]}}}")

    let networkOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":{\"applyNetworkPolicyAmendment\":{\"network_policy_amendment\":{\"action\":\"deny\",\"host\":\"example.com\"}}}}}",
                                                                                             "approval-network",
                                                                                             "exec-call-network",
                                                                                             "turn-network",
                                                                                             err)
    assertEq("command_network_op_err", err, "")
    assertEq("command_network_op", networkOp, "{\"type\":\"exec_approval\",\"id\":\"approval-network\",\"turn_id\":\"turn-network\",\"decision\":{\"network_policy_amendment\":{\"network_policy_amendment\":{\"action\":\"deny\",\"host\":\"example.com\"}}}}")

    let missingOpId = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"accept\"}}", "", "", "turn-core", err)
    assertEq("command_missing_op_id", missingOpId, "")
    assertNonEmpty("command_missing_op_id_err", err)

    let missingTurnId = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"accept\"}}", "approval-core", "exec-call-core", "", err)
    assertEq("command_missing_turn_id_op", missingTurnId, "")
    assertNonEmpty("command_missing_turn_id_err", err)

    let malformedOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"error\":{\"message\":\"client failed\"}}", "approval-core", "exec-call-core", "turn-core", err)
    assertEq("command_malformed_op", malformedOp, "")
    assertNonEmpty("command_malformed_op_err", err)

    let abortOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"cancel\"}}",
                                                                                           "approval-abort",
                                                                                           "exec-call-abort",
                                                                                           "turn-abort",
                                                                                           err)
    assertEq("command_abort_op_err", err, "")
    assertEq("command_abort_op", abortOp, "{\"type\":\"exec_approval\",\"id\":\"approval-abort\",\"turn_id\":\"turn-abort\",\"decision\":\"abort\"}")
    core_runtime.RustCsgCoreThreadRuntimeReset()
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-abort", "turn-abort", err), "core_abort_waiter_registered")
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "patch_approval", "patch-abort-peer", "", err), "core_abort_peer_waiter_registered")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 2, "core_abort_waiters_active")
    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOp("thread-core", abortOp, err), "core_abort_submit_ok")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_abort_dispatch_ok")
    assertEq("core_abort_resolved_empty",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-abort", "turn-abort"),
             "")
    assert(core_runtime.RustCsgCoreThreadActivePendingApprovalCount() == 0, "core_abort_waiter_consumed")
    assertEq("core_abort_peer_waiter_closed",
             core_runtime.RustCsgCoreThreadLastClosedPendingJson(),
             "{\"thread_id\":\"thread-core\",\"op_type\":\"patch_approval\",\"approval_id\":\"patch-abort-peer\",\"turn_id\":\"\",\"reason\":\"interrupt\",\"receiver_decision\":\"abort\"}")
    assert(core_runtime.RustCsgCoreThreadInterruptCount() == 1, "core_abort_interrupt_count")
    assertEq("core_abort_interrupt",
             core_runtime.RustCsgCoreThreadLastInterruptJson(),
             "{\"thread_id\":\"thread-core\",\"op_type\":\"exec_approval\",\"approval_id\":\"approval-abort\",\"turn_id\":\"turn-abort\"}")
    let abortReuseAcceptOp = loop.RustCsgAppServerTurnEventCommandExecutionApprovalCoreOpFromResponse("{\"id\":7,\"result\":{\"decision\":\"accept\"}}",
                                                                                                      "approval-abort",
                                                                                                      "exec-call-abort",
                                                                                                      "turn-abort",
                                                                                                      err)
    assertEq("core_abort_reuse_accept_op_err", err, "")
    assert(core_runtime.RustCsgCoreThreadRegisterPendingApproval("thread-core", "exec_approval", "approval-abort", "turn-abort", err), "core_abort_waiter_reregistered")
    assert(core_runtime.RustCsgCoreThreadSubmitApprovalOp("thread-core", abortReuseAcceptOp, err), "core_abort_reuse_submit_ok")
    assert(core_runtime.RustCsgCoreThreadDispatchAllSubmissions(err), "core_abort_reuse_dispatch_ok")
    assertEq("core_abort_reuse_resolved",
             core_runtime.RustCsgCoreThreadPendingApprovalResolvedOp("thread-core", "exec_approval", "approval-abort", "turn-abort"),
             abortReuseAcceptOp)
