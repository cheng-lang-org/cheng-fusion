import std/strings
import cheng/codex/config/home
import cheng/codex/state/thread_store
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn checkEqI32(name: str, left: int32, right: int32) =
    if left != right:
        echo(name)
        echo(strings.Int64ToStr(int64(left)))
        echo(strings.Int64ToStr(int64(right)))
    assert(left == right, name)

fn assertEmpty(name: str, value: str) =
    checkEq(name, value, "")

fn checkSessionIndex(indexHome: str, missingHome: str) =
    var err: str
    checkEq("index_path",
               thread_store.RustCsgSessionIndexPath(indexHome),
               home.RustCsgPathJoinChild(indexHome, "session_index.jsonl"))

    var latest: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestInto(indexHome, latest, err)
    assertEmpty("latest_error", err)
    checkEq("latest_id", latest.id, "thread-b")
    checkEq("latest_name", latest.threadName, "renamed")
    checkEq("latest_updated", latest.updatedAt, "2026-05-17T00:00:04Z")

    var byIdA: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByIdInto(indexHome, "thread-a", byIdA, err)
    assertEmpty("by_id_a_error", err)
    checkEq("by_id_a_id", byIdA.id, "thread-a")
    checkEq("by_id_a_name", byIdA.threadName, "target")
    checkEq("by_id_a_updated", byIdA.updatedAt, "2026-05-17T00:00:03Z")

    var byIdB: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByIdInto(indexHome, "thread-b", byIdB, err)
    assertEmpty("by_id_b_error", err)
    checkEq("by_id_b_id", byIdB.id, "thread-b")
    checkEq("by_id_b_name", byIdB.threadName, "renamed")
    checkEq("by_id_b_updated", byIdB.updatedAt, "2026-05-17T00:00:04Z")

    var byNameTarget: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByNameInto(indexHome, "target", byNameTarget, err)
    assertEmpty("by_name_target_error", err)
    checkEq("by_name_target_id", byNameTarget.id, "thread-a")
    checkEq("by_name_target_name", byNameTarget.threadName, "target")

    var byNameOld: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByNameInto(indexHome, "old", byNameOld, err)
    assertEmpty("by_name_old_error", err)
    assert(thread_store.RustCsgSessionIndexEntryEmpty(byNameOld), "old name must not match after rename")

    var missing: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByIdInto(missingHome, "thread-a", missing, err)
    assertEmpty("missing_error", err)
    assert(thread_store.RustCsgSessionIndexEntryEmpty(missing), "missing index should return empty")

fn checkMetadataMerge() =
    # ── mergeThreadMetadata tests ──────────────────────────────────────────
    # Initialize each struct independently (Cheng struct assignment is by ref)

    # Update with all fields non-empty
    var existing1: thread_store.RustCsgThreadMetadata
    existing1.title = "original title"
    existing1.cwd = "/home"
    existing1.status = "running"
    var update1: thread_store.RustCsgThreadMetadata
    update1.title = "new title"
    update1.cwd = "/new/home"
    update1.status = "completed"
    let merged1 = thread_store.RustCsgMergeThreadMetadata(existing1, update1)
    checkEq("merge_title_full", merged1.title, "new title")
    checkEq("merge_cwd_full", merged1.cwd, "/new/home")
    checkEq("merge_status_full", merged1.status, "completed")

    # Update with empty fields -> existing values preserved
    var existing2: thread_store.RustCsgThreadMetadata
    existing2.title = "original title"
    existing2.cwd = "/home"
    existing2.status = "running"
    var partialUpdate: thread_store.RustCsgThreadMetadata
    partialUpdate.title = "updated title"   # only title provided
    let merged2 = thread_store.RustCsgMergeThreadMetadata(existing2, partialUpdate)
    checkEq("merge_title_partial", merged2.title, "updated title")
    checkEq("merge_cwd_partial", merged2.cwd, "/home")
    checkEq("merge_status_partial", merged2.status, "running")

    # Update empty existing
    var existing3: thread_store.RustCsgThreadMetadata
    var update3: thread_store.RustCsgThreadMetadata
    update3.title = "new title"
    update3.cwd = "/new/home"
    update3.status = "completed"
    let merged3 = thread_store.RustCsgMergeThreadMetadata(existing3, update3)
    checkEq("merge_from_empty_title", merged3.title, "new title")
    checkEq("merge_from_empty_cwd", merged3.cwd, "/new/home")
    checkEq("merge_from_empty_status", merged3.status, "completed")

    # Both empty
    var existing4: thread_store.RustCsgThreadMetadata
    var update4: thread_store.RustCsgThreadMetadata
    let merged4 = thread_store.RustCsgMergeThreadMetadata(existing4, update4)
    checkEq("merge_both_empty_title", merged4.title, "")
    checkEq("merge_both_empty_cwd", merged4.cwd, "")
    checkEq("merge_both_empty_status", merged4.status, "")

fn checkArrayMergeDiff() =
    # ── Merge tests (parallel arrays) ──────────────────────────────────────
    var srcIds: str[] = ["id-1", "id-2"]
    var srcData: str[] = ["data-1", "data-2"]
    var tgtIds: str[] = ["id-2", "id-3"]
    var tgtData: str[] = ["data-2-updated", "data-3"]
    var outIds: str[]
    var outData: str[]
    thread_store.RustCsgThreadStoreMerge(srcIds, srcData, tgtIds, tgtData, outIds, outData)
    checkEqI32("merge_len", outIds.len, 3)
    let mi0 = outIds[0]
    let md0 = outData[0]
    checkEq("merge_id0", mi0, "id-1")
    checkEq("merge_data0", md0, "data-1")
    let mi1 = outIds[1]
    let md1 = outData[1]
    checkEq("merge_id1_overwrite", mi1, "id-2")
    checkEq("merge_data1_overwrite", md1, "data-2-updated")
    let mi2 = outIds[2]
    let md2 = outData[2]
    checkEq("merge_id2", mi2, "id-3")
    checkEq("merge_data2", md2, "data-3")

    # ── Diff tests ─────────────────────────────────────────────────────────
    var diffOutIds: str[]
    var diffOutData: str[]
    thread_store.RustCsgThreadStoreDiff(srcIds, srcData, tgtIds, diffOutIds, diffOutData)
    checkEqI32("diff_len", diffOutIds.len, 1)
    let did = diffOutIds[0]
    let ddata = diffOutData[0]
    checkEq("diff_id", did, "id-1")
    checkEq("diff_data", ddata, "data-1")

fn main(): int32 =
    checkEq("wire_probe", wire.RustCsgCat("", ""), "")
    let indexHome = home.RustCsgGetEnv("RUST_CSG_SESSION_INDEX_HOME")
    let missingHome = home.RustCsgGetEnv("RUST_CSG_SESSION_INDEX_MISSING_HOME")
    assert(indexHome != "", "index_home_fixture")
    assert(missingHome != "", "missing_home_fixture")
    checkSessionIndex(indexHome, missingHome)
    checkMetadataMerge()
    checkArrayMergeDiff()
    echo("rust_csg_thread_store_smoke ok")
    return 0
