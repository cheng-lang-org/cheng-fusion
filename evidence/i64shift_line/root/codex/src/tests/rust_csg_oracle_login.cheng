import cheng/codex/crates/login/login as m

fn main(): int32 =
    var pass: int32
    if m.loginUrlEncode("a b&c") == "a+b%26c":
        pass = pass + 1
    let url = m.loginStartFlow("https://example.com/auth", "client id", "myapp://cb", "repo user", "state 1")
    if url == "https://example.com/auth?response_type=code&client_id=client+id&redirect_uri=myapp%3A%2F%2Fcb&scope=repo+user&state=state+1":
        pass = pass + 1
    if m.loginValidateAuthUrl("https://example.com/auth"):
        pass = pass + 1
    if !m.loginValidateAuthUrl("http://evil.com"):
        pass = pass + 1
    if pass == 4:
        echo("rust_csg_oracle_login ok")
        return 0
    echo("oracle FAIL")
    return 1

main()
