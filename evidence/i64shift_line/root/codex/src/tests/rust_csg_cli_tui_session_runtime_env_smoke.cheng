import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/cli/tui_session_runtime as runtime
import cheng/codex/protocol/wire

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn CheckPositiveInt64(value: int64, label: str): int32 =
    if value > int64(0):
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected positive int64, got ", strings.Int64ToStr(value)], ""))
    return 1

fn main(): int32 =
    if cmdline.argCount() < 4:
        echo("FAIL usage: rust_csg_cli_tui_session_runtime_env_smoke <codex-home> <expected-db-path> <expected-cwd>")
        return 1
    let expectedCodexHome = cmdline.argStr(1)
    let expectedDbPath = cmdline.argStr(2)
    let expectedCwd = cmdline.argStr(3)
    var failures: int32
    var config: runtime.RustCsgCliTuiSessionRuntimeConfig
    var err: str
    runtime.RustCsgCliTuiSessionRuntimeConfigFromEnvironmentInto(config, err)
    failures = failures + CheckEqStr(err, "", "env config error")
    failures = failures + CheckEqStr(config.codexHomePath, expectedCodexHome, "codex home")
    failures = failures + CheckEqStr(config.dbPath, expectedDbPath, "state db path")
    failures = failures + CheckEqStr(config.currentCwd, expectedCwd, "current cwd")
    failures = failures + CheckEqStr(config.model, "env-profile-model", "model")
    failures = failures + CheckEqStr(config.modelProviderId, "env-profile-provider", "model provider")
    failures = failures + CheckEqStr(config.approvalPolicyJson, "\"never\"", "approval policy json")
    failures = failures + CheckEqStr(config.approvalsReviewer, "auto_review", "approvals reviewer")
    failures = failures + CheckEqStr(config.permissionsJson, "\":workspace\"", "permissions json")
    failures = failures + CheckContains(config.currentConfigJson, "\"profile\":\"env\"", "current config profile")
    failures = failures + CheckContains(config.configJson, "\"model_reasoning_effort\":\"high\"", "config overrides")
    failures = failures + CheckContains(config.runtimeWorkspaceRootsJson,
                                        wire.RustCsgJsonQuote(expectedCwd),
                                        "workspace root")
    failures = failures + CheckPositiveInt64(config.nowMs, "now ms")
    failures = failures + CheckEqStr(config.requestIdJson, strings.Int64ToStr(config.nowMs), "request id")
    if failures != 0:
        echo(strutil.Join(["rust_csg_cli_tui_session_runtime_env_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_cli_tui_session_runtime_env_smoke ok")
    return 0
