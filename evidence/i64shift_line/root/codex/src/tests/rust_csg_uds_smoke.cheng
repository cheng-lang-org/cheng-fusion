import std/strutils as strutil
import cheng/codex/crates/uds/uds

fn main(): int32 =
    if uds.UdsListenerType != "UnixListener":
        return 1
    if uds.UdsStreamType != "UnixStream":
        return 1
    if uds.UdsPrepareDirFn != "prepare_private_socket_directory":
        return 1
    if uds.UdsIsStaleFn != "is_stale_socket_path":
        return 1
    if uds.UdsSocketDirMode() != 448:
        return 1

    # Production function: validateSocketPath
    if !uds.UdsValidateSocketPath("/tmp/cheng.sock"):
        return 1
    if !uds.UdsValidateSocketPath("/"):
        return 1
    if uds.UdsValidateSocketPath(""):
        return 1

    # Production function: udsCheckSocketAlive
    if !uds.UdsCheckSocketAlive("/tmp/cheng.sock"):
        echo("FAIL: expected /tmp/cheng.sock to be alive")
        return 1
    if !uds.UdsCheckSocketAlive("/var/run/cheng.sock"):
        echo("FAIL: expected /var/run/cheng.sock to be alive")
        return 1
    if uds.UdsCheckSocketAlive(""):
        echo("FAIL: expected empty path to be dead")
        return 1
    if uds.UdsCheckSocketAlive("/"):
        echo("FAIL: expected root to be dead")
        return 1
    if uds.UdsCheckSocketAlive("/tmp"):
        echo("FAIL: expected /tmp to be dead")
        return 1
    if uds.UdsCheckSocketAlive("/var"):
        echo("FAIL: expected /var to be dead")
        return 1

    echo("rust_csg_uds_smoke ok")
    return 0
