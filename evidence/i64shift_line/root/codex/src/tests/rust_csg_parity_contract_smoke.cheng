import cheng/codex/core/parity

fn main(): int32 =
    let status = parity.RustCsgBlocked("tui")
    assert(!status.ported, "codex parity: blocked status is not ported")
    assert(status.status == "explicitly_blocked", "codex parity: status")
    assert(status.reason == parity.RustCsgBlockedReason, "codex parity: reason")
    assert(parity.RustCsgBlockedExitCode != 0, "codex parity: blocked exit non-zero")
    echo("rust_csg_parity_contract_smoke ok")
    return 0
