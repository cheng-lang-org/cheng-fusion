fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "fn strFindAt(haystack: str, start: int32, needle: str, outPos: var int32, outFound: var bool):  =\nfn strFind(haystack: str, needle: str, outPos: var int32, outFound: var bool):  =\nfn longestSuffixPrefixLen(s: str, needle: str): int32 =\nfn findNextOpen(pending: str, specOpens: str[], outPos: var int32, outSpecIdx: var int32, outFound: var bool):  =\nfn maxOpenPrefixSuffixLen(pending: str, specOpens: str[]): int32 =\nfn inlinePushStr(pending: var str, activeId: var int32, activeClose: var str, activeContent: var str, chunk: str):  =\nfn inlineFinish(activeId: var int32, activeClose: var str, activeContent: var str, outVisible: var str):  =\nfn collectInline(specOpens: str[], specCloses: str[], chunks: str[], outVisible: var str, outExtracts: var str[]):  =\nfn stripCitations(text: str, outCitations: var str[]): str =\nfn parseInlineTags(text: str, openTag: str, closeTag: str, outVisible: var str, outExtracts: var str[]):  =\nfn extractTagContent(text: str, tagName: str, outContents: var str[]): bool =\nfn planProcessLine(line: str, active: var int32, outVisible: var str, outDelta: var str): int32 =\nfn planPushStr(pending: var str, active: var int32, chunk: str, outVisible: var str, outPlanDeltas: var str[]):  =\nfn planFinish(pending: var str, active: var int32, outVisible: var str, outPlanDeltas: var str[]):  =\nfn stripProposedPlan(text: str): str =\nfn extractProposedPlan(text: str, outPlanText: var str): bool =\nfn assistantPushStr(citPending: var str, citActiveId: var int32, citActiveClose: var str, citActiveContent: var str, chunk: str):  =\nfn assistantFinish(citPending: var str, citActiveId: var int32, citActiveClose: var str, citActiveContent: var str, outVisible: var str, outCitations: var str[]):  =\nfn parseXmlDocument(xml: str, outRoot: var XmlNode, outError: var str):  =\nfn streamParserReset(state: var StreamParserState):  =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tstream_parser\nFunction\tstream_parser\tstrFindAt\t\nFunction\tstream_parser\tstrFind\t\nFunction\tstream_parser\tlongestSuffixPrefixLen\tint32\nFunction\tstream_parser\tfindNextOpen\t\nFunction\tstream_parser\tmaxOpenPrefixSuffixLen\tint32\nFunction\tstream_parser\tinlinePushStr\t\nFunction\tstream_parser\tinlineFinish\t\nFunction\tstream_parser\tcollectInline\t\nFunction\tstream_parser\tstripCitations\tstr\nFunction\tstream_parser\tparseInlineTags\t\nFunction\tstream_parser\textractTagContent\tbool\nFunction\tstream_parser\tplanProcessLine\tint32\nFunction\tstream_parser\tplanPushStr\t\nFunction\tstream_parser\tplanFinish\t\nFunction\tstream_parser\tstripProposedPlan\tstr\nFunction\tstream_parser\textractProposedPlan\tbool\nFunction\tstream_parser\tassistantPushStr\t\nFunction\tstream_parser\tassistantFinish\t\nFunction\tstream_parser\tparseXmlDocument\t\nFunction\tstream_parser\tstreamParserReset\t\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 0, "source type count")
    assert(ecf == 0, "source field count")
    assert(ecn == 20, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 0, "oracle type count")
    assert(ocf == 0, "oracle field count")
    assert(ocn == 20, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_stream_parser_relfacts_smoke ok")
    return 0

main()