    if r8 != s8.body:
        echo(strutil.Join(["FAIL: picker_fast_mode_enabled (expected ", strings.IntToStr(s8.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r8)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: keymap_picker_fast_mode_enabled")

    # ── 9. keymap_picker_first_actions ──────────────────────────────────────
    let p9: str = cmdline.argStr(9)
    let s9 = snap.RustCsgTuiOracleSnapshotParseFile(p9)
    if !s9.ok:
        echo(strutil.Join(["FAIL: picker_first_actions parse: ", p9, ": ", s9.error], "")); return 1
    if s9.source != "tui/src/keymap_setup.rs":
        echo(strutil.Join(["FAIL: picker_first_actions source: ", s9.source], "")); return 1
    if s9.expression != "snapshot":
        echo(strutil.Join(["FAIL: picker_first_actions expr: ", s9.expression], "")); return 1
    let r9: str = oracle.RustCsgTuiKeymapPickerFirstActionsFixture()
    if r9.len == 0:
        echo("FAIL: picker_first_actions empty render"); return 1
    if r9 != s9.body:
        echo(strutil.Join(["FAIL: picker_first_actions (expected ", strings.IntToStr(s9.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r9)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: keymap_picker_first_actions")

    # ── 10. keymap_picker_narrow ────────────────────────────────────────────
    let p10: str = cmdline.argStr(10)
    let s10 = snap.RustCsgTuiOracleSnapshotParseFile(p10)
    if !s10.ok:
        echo(strutil.Join(["FAIL: picker_narrow parse: ", p10, ": ", s10.error], "")); return 1
    if s10.source != "tui/src/keymap_setup.rs":
