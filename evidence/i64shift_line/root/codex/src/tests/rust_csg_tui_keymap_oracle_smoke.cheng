        echo(strutil.Join(["FAIL: debug_view_initial source: ", s3.source], "")); return 1
    if s3.expression != "\"render_debug(&view, 80)\"":
        echo(strutil.Join(["FAIL: debug_view_initial expr: ", s3.expression], "")); return 1
    let r3: str = oracle.RustCsgTuiKeymapDebugViewInitialFixture()
