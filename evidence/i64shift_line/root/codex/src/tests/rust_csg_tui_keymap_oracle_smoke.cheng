        exitCode = 1
    else:
        echo("ok: keymap_picker_all_tab_search")

    # ── 7. keymap_picker_custom ─────────────────────────────────────────────
    let p7: str = cmdline.argStr(7)
    let s7 = snap.RustCsgTuiOracleSnapshotParseFile(p7)
