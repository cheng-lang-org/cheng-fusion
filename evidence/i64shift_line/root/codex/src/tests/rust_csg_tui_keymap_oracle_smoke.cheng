import std/cmdline
import std/strings as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/keymap_oracle as oracle

# ── Smoke test entry ─────────────────────────────────────────────────────────

fn main(): int32 =
    if cmdline.argCount() < 12:
        echo("FAIL usage: rust_csg_tui_keymap_oracle_smoke <snap1> ... <snap11>")
        return 1

    var exitCode: int32 = 0

    # ── 1. keymap_action_menu ───────────────────────────────────────────────
    let p1: str = cmdline.argStr(1)
    let s1 = snap.RustCsgTuiOracleSnapshotParseFile(p1)
    if !s1.ok:
        echo(strutil.Join(["FAIL: action_menu parse: ", p1, ": ", s1.error], ""))
        return 1
    if s1.source != "tui/src/keymap_setup.rs":
        echo(strutil.Join(["FAIL: action_menu source: ", s1.source], ""))
        return 1
    if s1.expression != "snapshot":
        echo(strutil.Join(["FAIL: action_menu expr: ", s1.expression], ""))
        return 1
    let r1: str = oracle.RustCsgTuiKeymapActionMenuFixture()
    if r1.len == 0:
        echo("FAIL: action_menu empty render"); return 1
    if r1 != s1.body:
        echo(strutil.Join(["FAIL: action_menu (expected ", strings.IntToStr(s1.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r1)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: keymap_action_menu")

    # ── 2. keymap_capture_view ──────────────────────────────────────────────
    let p2: str = cmdline.argStr(2)
    let s2 = snap.RustCsgTuiOracleSnapshotParseFile(p2)
    if !s2.ok:
        echo(strutil.Join(["FAIL: capture_view parse: ", p2, ": ", s2.error], ""))
        return 1
    if s2.source != "tui/src/keymap_setup.rs":
        echo(strutil.Join(["FAIL: capture_view source: ", s2.source], "")); return 1
    if s2.expression != "\"format!(\\\"{:?}\\\", render_capture(&view, 80, 8))\"":
        echo(strutil.Join(["FAIL: capture_view expr: ", s2.expression], "")); return 1
    let r2: str = oracle.RustCsgTuiKeymapCaptureViewFixture()
    if r2.len == 0:
        echo("FAIL: capture_view empty render"); return 1
    if r2 != s2.body:
        echo(strutil.Join(["FAIL: capture_view (expected ", strings.IntToStr(s2.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r2)), ")"], ""))
        exitCode = 1
    else:
        echo("ok: keymap_capture_view")

    # ── 3. keymap_debug_view_initial ────────────────────────────────────────
    let p3: str = cmdline.argStr(3)
    let s3 = snap.RustCsgTuiOracleSnapshotParseFile(p3)
    if !s3.ok:
        echo(strutil.Join(["FAIL: debug_view_initial parse: ", p3, ": ", s3.error], "")); return 1
