import cheng/codex/crates/lmstudio/lmstudio

fn main(): int32 =
    if lmstudio.RustCsgBuildLmstudioModelsRequest() != "/v1/models":
        return 1
    if lmstudio.RustCsgLmStudioModelsUrl("http://localhost:1234/") != "http://localhost:1234/models":
        return 1
    if lmstudio.RustCsgLmStudioResponsesUrl("http://localhost:1234") != "http://localhost:1234/responses":
        return 1
    echo("rust_csg_lmstudio_smoke ok")
    return 0
