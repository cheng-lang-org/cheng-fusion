import std/cmdline
import std/strutils
import cheng/codex/plugin/mcp_stdio_client
import cheng/codex/protocol/wire

fn check(label: str, condition: bool): bool =
    if !condition:
        echo(strutils.Join(["FAIL: ", label], ""))
        return false
    return true

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 2:
        echo("FAIL: missing helper path")
        return 1

    let helper = cmdline.ParamStr(1)
    let resourceUri = "cheng://fixtures/readme"
    let result = mcp_stdio_client.RustCsgMcpStdioClientCallToolAndReadResource(helper, [], "", [], "echo", "{\"message\":\"hello\"}", resourceUri)
    var ok: bool = true
    ok = check("handshake ok", result.ok) && ok
    if !result.ok:
        echo(result.error)
        return 1
    ok = check("server name", result.serverName == "codex-mcp-helper") && ok
    ok = check("protocol version", result.protocolVersion == "2024-11-05") && ok
    ok = check("server exit code", result.exitCode == 0) && ok
    ok = check("initialize response frame parsed", wire.RustCsgContains(result.initializeJson, "\"serverInfo\"")) && ok
    ok = check("tools/list response frame parsed", wire.RustCsgContains(result.toolsListJson, "\"tools\"")) && ok
    ok = check("tools array real", wire.RustCsgContains(result.toolsJson, "\"name\":\"echo\"")) && ok
    ok = check("tools schema real", wire.RustCsgContains(result.toolsJson, "\"inputSchema\":{\"type\":\"object\"}")) && ok
    ok = check("tools/call response frame parsed", wire.RustCsgContains(result.toolCallJson, "\"content\"")) && ok
    ok = check("tools/call content real", wire.RustCsgContains(result.toolCallContentJson, "\"text\":\"hello from echo\"")) && ok
    ok = check("tools/call isError false", !result.toolCallIsError) && ok
    ok = check("resources/read response frame parsed", wire.RustCsgContains(result.resourceReadJson, "\"contents\"")) && ok
    ok = check("resources/read uri real", wire.RustCsgContains(result.resourceContentsJson, "\"uri\":\"cheng://fixtures/readme\"")) && ok
    ok = check("resources/read text real", wire.RustCsgContains(result.resourceContentsJson, "\"text\":\"resource body from helper\"")) && ok

    if ok:
        echo("rust_csg_mcp_stdio_client_smoke ok")
        return 0
    echo("rust_csg_mcp_stdio_client_smoke FAILED")
    return 1
