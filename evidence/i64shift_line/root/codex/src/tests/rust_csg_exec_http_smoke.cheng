import std/cmdline as cmdline
import std/strings
import cheng/codex/exec/run as exec_run

fn RustCsgExecHttpSmokePlanJson(): str =
    return "{\"kind\":\"startUserTurn\",\"threadId\":\"\",\"requestSequence\":[{\"method\":\"thread/start\",\"params\":{\"model\":\"gpt-5\",\"cwd\":\"/tmp\",\"approvalPolicy\":\"never\",\"approvalsReviewer\":\"user\",\"ephemeral\":false,\"sessionStartSource\":\"cli\"}},{\"method\":\"turn/start\",\"params\":{\"threadId\":\"\",\"input\":[{\"type\":\"text\",\"text\":\"hello world\",\"textElements\":[]}],\"cwd\":\"/tmp\",\"approvalPolicy\":\"never\"}}],\"parseError\":\"\",\"blockedReason\":\"\"}"

fn main(): int32 =
    assert(cmdline.argCount() >= 2, "exec_http smoke requires mock app-server base URL")
    let baseUrl: str = cmdline.argStr(1)
    assert(baseUrl != "", "exec_http mock app-server URL must not be empty")

    let url: str = strings.ConcatStr(baseUrl, "/exec-http")
    let status: int32 = exec_run.ExecRunStart(url, RustCsgExecHttpSmokePlanJson())
    assert(status == 0, "exec_http path should exit 0")

    echo("rust_csg_exec_http_smoke ok")
    return 0
