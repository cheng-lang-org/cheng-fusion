import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_simple_history_oracle as oracle

fn RustCsgTuiChatwidgetSimpleHistoryCheck(path: str,
                                           expectedSource: str,
                                           expectedExpression: str,
                                           expectedBody: str,
                                           name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 13:
        echo("FAIL usage: rust_csg_tui_chatwidget_simple_history_oracle_smoke <12 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetFinalReasoningThenMessage(), "final_reasoning_then_message_without_deltas_are_rendered")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetDeltasThenSameFinalMessage(), "deltas_then_same_final_message_are_rendered_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "exec_blob", oracle.RustCsgTuiChatwidgetInterruptExecMarksFailed(), "interrupt_exec_marks_failed")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetLocalImageAttachmentHistory(), "local_image_attachment_history_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUnifiedExecWaitingMultipleEmptyAfter(), "unified_exec_waiting_multiple_empty_after")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "info", oracle.RustCsgTuiChatwidgetInterruptedTurnPendingSteersMessage(), "interrupted_turn_pending_steers_message")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "blob", oracle.RustCsgTuiChatwidgetLiveAppServerCommandExecutionStripsShellWrapper(), "live_app_server_command_execution_strips_shell_wrapper")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "rendered", oracle.RustCsgTuiChatwidgetSlashCopyNoOutputInfoMessage(), "slash_copy_no_output_info_message")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "lines_to_single_string(&approved_lines)", oracle.RustCsgTuiChatwidgetApplyPatchManualFlowHistoryApproved(), "apply_patch_manual_flow_history_approved")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetImageGenerationCallHistory(), "image_generation_call_history_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUnifiedExecWaitAfterFinalAgentMessage(), "unified_exec_wait_after_final_agent_message")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetSimpleHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUnifiedExecWaitBeforeStreamedAgentMessage(), "unified_exec_wait_before_streamed_agent_message")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_simple_history_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_simple_history_oracle_smoke FAILED")
    return exitCode
