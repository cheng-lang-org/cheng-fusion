# ── Wire helper functions (self-contained, no wire import) ───────────────

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn Cat3(a: str, b: str, c: str): str =
    return Cat(Cat(a, b), c)

fn Cat4(a: str, b: str, c: str, d: str): str =
    return Cat(Cat3(a, b, c), d)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn JsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = Cat(out, "\\\"")
        elif ch == '\\':
            out = Cat(out, "\\\\")
        elif ch == '\n':
            out = Cat(out, "\\n")
        elif ch == '\r':
            out = Cat(out, "\\r")
        elif ch == '\t':
            out = Cat(out, "\\t")
        else:
            out = Cat(out, SliceBytes(value, i, 1))
    return Cat(out, "\"")

fn MatchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0:
        return false
    if pos + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if text[pos + i] != needle[i]:
            return false
    return true

fn StartsWith(text: str, prefix: str): bool =
    return MatchesAt(text, 0, prefix)

fn Contains(text: str, needle: str): bool =
    var i: int32
    while i < text.len:
        if MatchesAt(text, i, needle):
            return true
        i = i + 1
    return false

fn SkipJsonSpace(text: str, pos: int32): int32 =
    var i: int32
    i = pos
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return i
        i = i + 1
    return i

fn DigitValue(text: str): int32 =
    if text.len == 0:
        return -1
    let ch = text[0]
    if ch >= '0' && ch <= '9':
        return ch - '0'
    return -1

fn ParseInt32(raw: str): int32 =
    var value: int32
    var neg: bool
    var start: int32
    if raw.len > 0 && raw[0] == '-':
        neg = true
        start = 1
    var i: int32
    i = start
    while i < raw.len:
        let digit = DigitValue(SliceBytes(raw, i, 1))
        value = value * 10 + digit
        i = i + 1
    if neg:
        return -value
    return value

fn JsonStringArrayOne(value: str): str =
    return Cat3("[", JsonQuote(value), "]")

fn JsonStringArrayFromRaw(raw: str): str[] =
    var out: str[]
    out = []
    var pos: int32
    pos = SkipJsonSpace(raw, 0)
    if pos < raw.len && raw[pos] == '[':
        pos = SkipJsonSpace(raw, pos + 1)
    else:
        return out
    if pos < raw.len && raw[pos] == ']':
        return out
    while pos < raw.len:
        if raw[pos] != '"':
            return out
        var value: str
        var i: int32
        i = pos + 1
        while i < raw.len:
            let ch = raw[i]
            if ch == '\\':
                if i + 1 >= raw.len:
                    return out
                let escaped = raw[i + 1]
                if escaped == '"' || escaped == '\\' || escaped == '/':
                    value = Cat(value, SliceBytes(raw, i + 1, 1))
                elif escaped == 'n':
                    value = Cat(value, "\n")
                elif escaped == 'r':
                    value = Cat(value, "\r")
                elif escaped == 't':
                    value = Cat(value, "\t")
                else:
                    return out
                i = i + 2
                continue
            if ch == '"':
                add(out, value)
                pos = SkipJsonSpace(raw, i + 1)
                if pos < raw.len && raw[pos] == ',':
                    pos = SkipJsonSpace(raw, pos + 1)
                    break
                elif pos < raw.len && raw[pos] == ']':
                    return out
                else:
                    return out
            elif ch == '\n' || ch == '\r' || ch == '\t':
                return out
            value = Cat(value, SliceBytes(raw, i, 1))
            i = i + 1
        if i >= raw.len:
            return out
    return out

# ── Thread-list-sqlite function inlines ──────────────────────────────────

fn RustCsgThreadListSqliteAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgThreadListSqliteTrimAsciiSpace(text: str): str =
    var start: int32
    while start < text.len && RustCsgThreadListSqliteAsciiSpace(text[start]):
        start = start + 1
    var end: int32
    end = text.len
    while end > start && RustCsgThreadListSqliteAsciiSpace(text[end - 1]):
        end = end - 1
    return SliceBytes(text, start, end - start)

fn RustCsgThreadListSqliteJsonStringArrayOne(value: str): str =
    return Cat3("[", JsonQuote(value), "]")

fn RustCsgThreadListSqliteAllInteractiveSourcesJson(): str =
    return "[\"cli\",\"vscode\",\"{\\\"custom\\\":\\\"atlas\\\"}\",\"{\\\"custom\\\":\\\"chatgpt\\\"}\"]"

fn RustCsgThreadListSqliteAllSourceKindsJson(): str =
    return "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]"

fn RustCsgThreadListSqliteCanonicalAbsolutePath(value: str): bool =
    if value == "/":
        return true
    if value.len < 2:
        return false
    if value[0] != '/':
        return false
    if value[value.len - 1] == '/':
        return false
    if Contains(value, "//"):
        return false
    if Contains(value, "/./"):
        return false
    if Contains(value, "/../"):
        return false
    if value.len >= 2 && value[value.len - 2] == '/' && value[value.len - 1] == '.':
        return false
    if value.len >= 3 && value[value.len - 3] == '/' && value[value.len - 2] == '.' && value[value.len - 1] == '.':
        return false
    return true

fn RustCsgThreadListSqliteJsonLooksInt(value: str): bool =
    if value == "":
        return false
    var i: int32
    if value[0] == '-':
        i = 1
    if i >= value.len:
        return false
    while i < value.len:
        let digit = DigitValue(SliceBytes(value, i, 1))
        if digit < 0:
            return false
        i = i + 1
    return true

fn RustCsgThreadListSqliteLimit(limitJson: str, outError: var str): int32 =
    outError = ""
    if limitJson == "":
        return 25
    if !RustCsgThreadListSqliteJsonLooksInt(limitJson):
        outError = Cat("invalid thread/list limit: ", limitJson)
        return 0
    var value = ParseInt32(limitJson)
    if value < 1:
        value = 1
    if value > 100:
        value = 100
    return value

fn RustCsgThreadListSqliteSortKey(sortKey: str, outError: var str): str =
    outError = ""
    if sortKey == "":
        return "created_at"
    if sortKey == "created_at" || sortKey == "updated_at":
        return sortKey
    outError = Cat("invalid thread/list sortKey: ", sortKey)
    return ""

fn RustCsgThreadListSqliteSortDirection(sortDirection: str, outError: var str): str =
    outError = ""
    if sortDirection == "":
        return "desc"
    if sortDirection == "asc" || sortDirection == "desc":
        return sortDirection
    outError = Cat("invalid thread/list sortDirection: ", sortDirection)
    return ""

fn RustCsgThreadListSqliteSourceKindRequiresPostFilter(sourceKindsJson: str): bool =
    if sourceKindsJson == "[\"exec\"]":
        return false
    if sourceKindsJson == "[\"appServer\"]":
        return false
    if sourceKindsJson == "[\"unknown\"]":
        return false
    if sourceKindsJson == "[\"subAgent\"]":
        return false
    if sourceKindsJson == "[\"subAgentReview\"]":
        return false
    if sourceKindsJson == "[\"subAgentCompact\"]":
        return false
    if sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return false
    if Contains(sourceKindsJson, "\"exec\""):
        return true
    if Contains(sourceKindsJson, "\"appServer\""):
        return true
    if Contains(sourceKindsJson, "\"subAgent\""):
        return true
    if Contains(sourceKindsJson, "\"subAgentReview\""):
        return true
    if Contains(sourceKindsJson, "\"subAgentCompact\""):
        return true
    if Contains(sourceKindsJson, "\"subAgentThreadSpawn\""):
        return true
    if Contains(sourceKindsJson, "\"subAgentOther\""):
        return true
    return Contains(sourceKindsJson, "\"unknown\"")

fn RustCsgThreadListSqliteAllowedSourcesJson(params: var RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return RustCsgThreadListSqliteAllInteractiveSourcesJson()
    if params.sourceKindsJson == "[\"exec\"]":
        return JsonStringArrayOne("exec")
    if params.sourceKindsJson == "[\"appServer\"]":
        return JsonStringArrayOne("mcp")
    if params.sourceKindsJson == "[\"unknown\"]":
        return JsonStringArrayOne("unknown")
    if params.sourceKindsJson == "[\"subAgent\"]":
        return JsonStringArrayOne("subagent")
    if params.sourceKindsJson == "[\"subAgentReview\"]":
        return JsonStringArrayOne("subagent_review")
    if params.sourceKindsJson == "[\"subAgentCompact\"]":
        return JsonStringArrayOne("subagent_compact")
    if params.sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return JsonStringArrayOne("subagent_thread_spawn")
    if params.sourceKindsJson == "[\"subAgentOther\"]":
        return JsonStringArrayOne("subagent")
    if RustCsgThreadListSqliteSourceKindRequiresPostFilter(params.sourceKindsJson):
        return "[]"
    var out = "["
    var first: bool
    first = true
    if Contains(params.sourceKindsJson, "\"cli\""):
        out = Cat(out, "\"cli\"")
        first = false
    if Contains(params.sourceKindsJson, "\"vscode\""):
        if !first:
            out = Cat(out, ",")
        out = Cat(out, "\"vscode\"")
    out = Cat(out, "]")
    return out

fn RustCsgThreadListSqliteSourceKindPostFilterJson(params: var RustCsgThreadListParams): str =
    if params.sourceKindsJson == "" || params.sourceKindsJson == "[]":
        return ""
    if params.sourceKindsJson == "[\"exec\"]":
        return ""
    if params.sourceKindsJson == "[\"appServer\"]":
        return ""
    if params.sourceKindsJson == "[\"unknown\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgent\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentReview\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentCompact\"]":
        return ""
    if params.sourceKindsJson == "[\"subAgentThreadSpawn\"]":
        return ""
    return params.sourceKindsJson

fn RustCsgThreadListSqliteModelProviderFilterJson(params: var RustCsgThreadListParams,
                                                  fallbackProvider: str): str =
    if params.modelProvidersJson == "":
        return JsonStringArrayOne(fallbackProvider)
    if params.modelProvidersJson == "[]":
        return ""
    return params.modelProvidersJson

fn RustCsgThreadListSqlitePlanFromParams(params: var RustCsgThreadListParams,
                                         fallbackProvider: str): RustCsgThreadListSqlitePlan =
    var result: RustCsgThreadListSqlitePlan
    var err: str
    result.pageSize = RustCsgThreadListSqliteLimit(params.limitJson, err)
    if err != "":
        result.parseError = err
        return result
    result.sortKey = RustCsgThreadListSqliteSortKey(params.sortKey, err)
    if err != "":
        result.parseError = err
        return result
    result.sortDirection = RustCsgThreadListSqliteSortDirection(params.sortDirection, err)
    if err != "":
        result.parseError = err
        return result
    result.modelProviderFilterJson = RustCsgThreadListSqliteModelProviderFilterJson(params, fallbackProvider)
    result.allowedSourcesJson = RustCsgThreadListSqliteAllowedSourcesJson(params)
    result.sourceKindPostFilterJson = RustCsgThreadListSqliteSourceKindPostFilterJson(params)
    result.archived = params.archivedJson == "true"
    result.cwdFiltersJson = params.cwdJson
    result.searchTerm = params.searchTerm
    return result

fn RustCsgThreadListSqliteOrderSql(sortKey: str, sortDirection: str): str =
    if sortKey == "created_at" && sortDirection == "asc":
        return " ORDER BY created_at_ms ASC"
    if sortKey == "created_at" && sortDirection == "desc":
        return " ORDER BY created_at_ms DESC"
    if sortKey == "updated_at" && sortDirection == "asc":
        return " ORDER BY updated_at_ms ASC"
    if sortKey == "updated_at" && sortDirection == "desc":
        return " ORDER BY updated_at_ms DESC"
    return ""

fn RustCsgThreadListSqliteCursor(sortValueMs: int64): str =
    return RustCsgMillisToRfc3339(sortValueMs)

fn RustCsgThreadListSqliteBackwardsCursor(firstSortValueMs: int64, sortDirection: str): str =
    if sortDirection == "desc":
        return RustCsgThreadListSqliteCursor(firstSortValueMs - int64(1))
    return RustCsgThreadListSqliteCursor(firstSortValueMs + int64(1))

fn RustCsgThreadListSqliteHexValueAt(text: str, pos: int32): int32 =
    if pos >= text.len:
        return -1
    let value = SliceBytes(text, pos, 1)
    let digit = DigitValue(value)
    if digit >= 0:
        return digit
    if value == "a" || value == "A":
        return 10
    if value == "b" || value == "B":
        return 11
    if value == "c" || value == "C":
        return 12
    if value == "d" || value == "D":
        return 13
    if value == "e" || value == "E":
        return 14
    if value == "f" || value == "F":
        return 15
    return -1

fn RustCsgThreadListSqlitePrintableAsciiFromCode(code: int32): str =
    if code < 32 || code > 126:
        return ""
    let asciiSet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    return SliceBytes(asciiSet, code - 32, 1)

fn RustCsgThreadListSqliteJsonStringAt(text: str,
                                       start: int32,
                                       outOk: var bool,
                                       outEnd: var int32,
                                       outError: var str): str =
    outOk = false
    outEnd = start
    outError = ""
    if start >= text.len || text[start] != '"':
        outError = "thread/list sqlite cwd filter expects JSON string"
        return ""
    var out: str
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                outError = "thread/list sqlite cwd filter has unterminated string escape"
                return ""
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = Cat(out, SliceBytes(text, i + 1, 1))
            elif escaped == 'n':
                out = Cat(out, "\n")
            elif escaped == 'r':
                out = Cat(out, "\r")
            elif escaped == 't':
                out = Cat(out, "\t")
            elif escaped == 'u':
                if i + 5 >= text.len:
                    outError = "thread/list sqlite cwd filter has invalid unicode escape"
                    return ""
                let h1 = RustCsgThreadListSqliteHexValueAt(text, i + 2)
                let h2 = RustCsgThreadListSqliteHexValueAt(text, i + 3)
                let h3 = RustCsgThreadListSqliteHexValueAt(text, i + 4)
                let h4 = RustCsgThreadListSqliteHexValueAt(text, i + 5)
                if h1 < 0 || h2 < 0 || h3 < 0 || h4 < 0:
                    outError = "thread/list sqlite cwd filter has invalid unicode escape"
                    return ""
                let code = h1 * 4096 + h2 * 256 + h3 * 16 + h4
                let decoded = RustCsgThreadListSqlitePrintableAsciiFromCode(code)
                if decoded == "":
                    outError = "thread/list sqlite cwd filter unicode escape outside printable ASCII"
                    return ""
                out = Cat(out, decoded)
                i = i + 6
                continue
            elif escaped == 'b' || escaped == 'f':
                outError = "thread/list sqlite cwd filter control escape not ported"
                return ""
            else:
                outError = "thread/list sqlite cwd filter has invalid string escape"
                return ""
            i = i + 2
            continue
        if ch == '"':
            outOk = true
            outEnd = i
            return out
        if ch == '\n' || ch == '\r' || ch == '\t':
            outError = "thread/list sqlite cwd filter contains raw control character"
            return ""
        out = Cat(out, SliceBytes(text, i, 1))
        i = i + 1
    outError = "thread/list sqlite cwd filter has unterminated string"
    return ""

fn RustCsgThreadListSqliteCwdFilterStringRaw(raw: str, outError: var str): str =
    outError = ""
    var ok: bool
    var endPos: int32
    let start = SkipJsonSpace(raw, 0)
    let value = RustCsgThreadListSqliteJsonStringAt(raw, start, ok, endPos, outError)
    if !ok:
        return ""
    let trailing = SkipJsonSpace(raw, endPos + 1)
    if trailing != raw.len:
        outError = "thread/list sqlite cwd filter has trailing JSON after string"
        return ""
    return value

fn RustCsgThreadListSqliteCwdFilterValue(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "null":
        return ""
    let value = RustCsgThreadListSqliteCwdFilterStringRaw(raw, outError)
    if outError != "":
        return ""
    let normalized = RustCsgNormalizePathRelativeToCurrentDir(value)
    if normalized == "" || !RustCsgThreadListSqliteCanonicalAbsolutePath(normalized):
        outError = "thread/list sqlite cwd filter normalization failed"
        return ""
    return normalized

fn RustCsgThreadListSqliteCwdFilterValuesRaw(raw: str, outError: var str): str[] =
    outError = ""
    var values: str[]
    values = []
    var pos: int32
    pos = SkipJsonSpace(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        outError = "thread/list sqlite cwd filter only supports JSON string or string array"
        return values
    pos = SkipJsonSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        let trailing = SkipJsonSpace(raw, pos + 1)
        if trailing != raw.len:
            outError = "thread/list sqlite cwd filter has trailing JSON after array"
        return values
    while pos < raw.len:
        var ok: bool
        var endPos: int32
        let value = RustCsgThreadListSqliteJsonStringAt(raw, pos, ok, endPos, outError)
        if !ok:
            return values
        add(values, value)
        pos = SkipJsonSpace(raw, endPos + 1)
        if pos < raw.len && raw[pos] == ',':
            pos = SkipJsonSpace(raw, pos + 1)
        elif pos < raw.len && raw[pos] == ']':
            let trailing = SkipJsonSpace(raw, pos + 1)
            if trailing != raw.len:
                outError = "thread/list sqlite cwd filter has trailing JSON after array"
            return values
        else:
            outError = "thread/list sqlite cwd filter malformed string array"
            return values
    outError = "thread/list sqlite cwd filter has unterminated string array"
    return values

fn RustCsgThreadListSqliteCwdFiltersJson(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "null" || raw == "[]":
        return ""
    let start = SkipJsonSpace(raw, 0)
    if start < raw.len && raw[start] == '"':
        let value = RustCsgThreadListSqliteCwdFilterValue(raw, outError)
        if outError != "":
            return ""
        return JsonStringArrayOne(value)
    let values = RustCsgThreadListSqliteCwdFilterValuesRaw(raw, outError)
    if outError != "":
        return ""
    if values.len == 0:
        return ""
    var out = "["
    var first: bool
    first = true
    for i in 0..<values.len:
        let normalized = RustCsgNormalizePathRelativeToCurrentDir(values[i])
        if normalized == "" || !RustCsgThreadListSqliteCanonicalAbsolutePath(normalized):
            outError = "thread/list sqlite cwd filter normalization failed"
            return ""
        if !first:
            out = Cat(out, ",")
        out = Cat(out, JsonQuote(normalized))
        first = false
    out = Cat(out, "]")
    return out

fn RustCsgThreadListSqliteValidateModelProvidersJson(raw: str, outError: var str): str =
    outError = ""
    if raw == "" || raw == "[]":
        return raw
    if raw.len < 2 || raw[0] != '[' || raw[raw.len - 1] != ']':
        outError = "thread/list sqlite model provider filter must be a JSON string array"
        return ""
    let values = JsonStringArrayFromRaw(raw)
    for i in 0..<values.len:
        if values[i] == "":
            outError = "thread/list sqlite model provider filter contains an empty provider"
            return ""
    return raw

fn RustCsgThreadListSqliteRowIsSubAgentOther(row: RustCsgStateDbThreadRowResult): bool =
    if !StartsWith(row.source, "subagent_"):
        return false
    if row.rolloutPath == "":
        return false
    return false

fn RustCsgThreadListSqliteRowMatchesSourcePostFilter(row: RustCsgStateDbThreadRowResult,
                                                       sourceKindPostFilterJson: str): bool =
    if sourceKindPostFilterJson == "":
        return true
    if sourceKindPostFilterJson == "[\"subAgentOther\"]":
        return RustCsgThreadListSqliteRowIsSubAgentOther(row)
    return true

fn RustCsgThreadListSqliteDistinctTitle(row: RustCsgStateDbThreadRowResult): str =
    let title = RustCsgThreadListSqliteTrimAsciiSpace(row.title)
    if title == "":
        return ""
    if RustCsgThreadListSqliteTrimAsciiSpace(row.firstUserMessage) == title:
        return ""
    return title

fn RustCsgThreadListSqliteSortValueFromStateRow(row: RustCsgStateDbThreadRowResult,
                                                sortKey: str): int64 =
    if sortKey == "created_at":
        return row.createdAtMs
    return row.updatedAtMs

fn RustCsgThreadListSqliteThreadFromStateRow(row: RustCsgStateDbThreadRowResult): RustCsgAppThread =
    var thread: RustCsgAppThread
    thread.id = row.id
    thread.sessionId = row.id
    thread.name = RustCsgThreadListSqliteDistinctTitle(row)
    thread.cwd = row.cwd
    thread.modelProvider = row.modelProvider
    thread.source = row.source
    thread.path = row.rolloutPath
    thread.createdAt = row.createdAtMs / int64(1000)
    thread.updatedAt = row.updatedAtMs / int64(1000)
    thread.cliVersion = row.cliVersion
    thread.preview = row.firstUserMessage
    thread.statusJson = "{\"type\":\"notLoaded\"}"
    thread.turnsJson = "[]"
    return thread

# ── Test helpers ─────────────────────────────────────────────────────────

fn checkBool(name: str, got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

fn checkEq(name: str, got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=`", expected, "`"], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=`", got, "`"], ""))
        return false
    return true

fn checkInt32(name: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", strings.IntToStr(expected)], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", strings.IntToStr(got)], ""))
        return false
    return true

fn checkInt64(name: str, got: int64, expected: int64): bool =
    if got != expected:
        echo("FAIL int64 ")
        echo(name)
        return false
    return true

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo(strutil.Join(["FAIL [", name, "]: expected true"], ""))
        return false
    return true

fn checkFalse(name: str, cond: bool): bool =
    if cond:
        echo(strutil.Join(["FAIL [", name, "]: expected false"], ""))
        return false
    return true

