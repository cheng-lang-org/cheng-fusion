# ── Section: testBackwardsCursor ─────────────────────────────────────────

fn testBackwardsCursor(): bool =
    var ok: bool = true
    # desc -> subtract 1
    let b1 = RustCsgThreadListSqliteBackwardsCursor(int64(1000), "desc")
    if !checkTrue("back_desc", b1 != ""):
        ok = false
    # asc -> add 1
    let b2 = RustCsgThreadListSqliteBackwardsCursor(int64(1000), "asc")
    if !checkTrue("back_asc", b2 != ""):
        ok = false
    # desc and asc produce different cursors for same base value
    let b3 = RustCsgThreadListSqliteBackwardsCursor(int64(1000), "desc")
    let b4 = RustCsgThreadListSqliteBackwardsCursor(int64(1000), "asc")
    if !checkFalse("back_diff", b3 == b4):
        ok = false
    if ok:
        echo("testBackwardsCursor ok")
    return ok

