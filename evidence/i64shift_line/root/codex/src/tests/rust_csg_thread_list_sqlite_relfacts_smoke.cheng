    return ok

# ── Section: testJsonStringAt ────────────────────────────────────────────

fn testJsonStringAt(): bool =
    var ok: bool = true
    var okFlag: bool
    var endPos: int32
    var err: str
    # Basic string
    let r1 = RustCsgThreadListSqliteJsonStringAt("\"hello\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_basic_ok", okFlag):
        ok = false
    if !checkEq("jsStr_basic", r1, "hello"):
        ok = false
    if !checkInt32("jsStr_basic_end", endPos, 6):
        ok = false
    # Empty string
    okFlag = false; endPos = 0; err = ""
    let r2 = RustCsgThreadListSqliteJsonStringAt("\"\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_empty_ok", okFlag):
        ok = false
    if !checkEq("jsStr_empty", r2, ""):
        ok = false
    # Escaped quote
    okFlag = false; endPos = 0; err = ""
    let r3 = RustCsgThreadListSqliteJsonStringAt("\"a\\\"b\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_escQuote_ok", okFlag):
        ok = false
    if !checkEq("jsStr_escQuote", r3, "a\"b"):
        ok = false
    # Escaped backslash
    okFlag = false; endPos = 0; err = ""
    let r4 = RustCsgThreadListSqliteJsonStringAt("\"a\\\\b\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_escBackslash_ok", okFlag):
        ok = false
    if !checkEq("jsStr_escBackslash", r4, "a\\b"):
        ok = false
    # Escaped forward slash
    okFlag = false; endPos = 0; err = ""
    let r5 = RustCsgThreadListSqliteJsonStringAt("\"a\\/b\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_escSlash_ok", okFlag):
        ok = false
    if !checkEq("jsStr_escSlash", r5, "a/b"):
        ok = false
    # Escaped unicode (u0020 = space = printable ASCII 32)
    okFlag = false; endPos = 0; err = ""
    let r6 = RustCsgThreadListSqliteJsonStringAt("\"a\\u0020b\"", 0, okFlag, endPos, err)
    if !checkTrue("jsStr_unicode_ok", okFlag):
        ok = false
    if !checkEq("jsStr_unicode", r6, "a b"):
        ok = false
    # Unterminated string
    okFlag = false; endPos = 0; err = ""
    let r7 = RustCsgThreadListSqliteJsonStringAt("\"unterminated", 0, okFlag, endPos, err)
    if !checkFalse("jsStr_unterm_ok", okFlag):
        ok = false
    if !checkTrue("jsStr_unterm_err", err != ""):
        ok = false
    # Not starting with quote
    okFlag = false; endPos = 0; err = ""
    let r8 = RustCsgThreadListSqliteJsonStringAt("hello", 0, okFlag, endPos, err)
    if !checkFalse("jsStr_noquote_ok", okFlag):
        ok = false
    if !checkTrue("jsStr_noquote_err", err != ""):
        ok = false
    # Control character escape b/f -> error
    okFlag = false; endPos = 0; err = ""
    let r9 = RustCsgThreadListSqliteJsonStringAt("\"a\\bb\"", 0, okFlag, endPos, err)
    if !checkFalse("jsStr_escB_ok", okFlag):
        ok = false
    if !checkTrue("jsStr_escB_err", err != ""):
        ok = false
    # Raw control character -> error
    okFlag = false; endPos = 0; err = ""
    let r10 = RustCsgThreadListSqliteJsonStringAt("\"a\nb\"", 0, okFlag, endPos, err)
    if !checkFalse("jsStr_rawNewline_ok", okFlag):
        ok = false
    if !checkTrue("jsStr_rawNewline_err", err != ""):
        ok = false
    # Unterminated escape
    okFlag = false; endPos = 0; err = ""
    let r11 = RustCsgThreadListSqliteJsonStringAt("\"a\\", 0, okFlag, endPos, err)
    if !checkFalse("jsStr_untermEsc_ok", okFlag):
        ok = false
    if !checkTrue("jsStr_untermEsc_err", err != ""):
        ok = false
    if ok:
        echo("testJsonStringAt ok")
    return ok

# ── Section: testCwdFilterStringRaw ─────────────────────────────────────

fn testCwdFilterStringRaw(): bool =
    var ok: bool = true
    var err: str
    # Basic path
    let r1 = RustCsgThreadListSqliteCwdFilterStringRaw("\"/tmp\"", err)
    if !checkEq("cwdStr_tmp", r1, "/tmp"):
        ok = false
    if !checkEq("cwdStr_tmp_err", err, ""):
        ok = false
    # Quoted path
    err = ""
    let r2 = RustCsgThreadListSqliteCwdFilterStringRaw("\"/home/user/project\"", err)
    if !checkEq("cwdStr_home", r2, "/home/user/project"):
        ok = false
    # Empty string
    err = ""
    let r3 = RustCsgThreadListSqliteCwdFilterStringRaw("\"\"", err)
    if !checkEq("cwdStr_empty", r3, ""):
        ok = false
    # Trailing content -> error
    err = ""
    let r4 = RustCsgThreadListSqliteCwdFilterStringRaw("\"/tmp\" extra", err)
    if !checkEq("cwdStr_trailing", r4, ""):
        ok = false
    if !checkTrue("cwdStr_trailing_err", err != ""):
        ok = false
    # Not a JSON string -> error
    err = ""
    let r5 = RustCsgThreadListSqliteCwdFilterStringRaw("not_json", err)
    if !checkEq("cwdStr_notJson", r5, ""):
        ok = false
    if !checkTrue("cwdStr_notJson_err", err != ""):
        ok = false
    if ok:
        echo("testCwdFilterStringRaw ok")
    return ok

# ── Section: testCwdFilterValuesRaw ─────────────────────────────────────

fn testCwdFilterValuesRaw(): bool =
    var ok: bool = true
    var err: str
    # Empty array
    let r1 = RustCsgThreadListSqliteCwdFilterValuesRaw("[]", err)
    if !checkInt32("cwdVals_empty_len", r1.len, 0):
        ok = false
    if !checkEq("cwdVals_empty_err", err, ""):
        ok = false
    # Single item
    err = ""
    let r2 = RustCsgThreadListSqliteCwdFilterValuesRaw("[\"/tmp\"]", err)
    if !checkInt32("cwdVals_single_len", r2.len, 1):
        ok = false
    if r2.len >= 1:
        if !checkEq("cwdVals_single_val", r2[0], "/tmp"):
            ok = false
    # Multiple items
    err = ""
    let r3 = RustCsgThreadListSqliteCwdFilterValuesRaw("[\"/tmp\",\"/home\"]", err)
    if !checkInt32("cwdVals_multi_len", r3.len, 2):
        ok = false
    if r3.len >= 2:
        if !checkEq("cwdVals_multi_0", r3[0], "/tmp"):
            ok = false
        if !checkEq("cwdVals_multi_1", r3[1], "/home"):
            ok = false
    # Not an array -> error
    err = ""
    let r4 = RustCsgThreadListSqliteCwdFilterValuesRaw("\"string\"", err)
    if !checkInt32("cwdVals_notArr_len", r4.len, 0):
        ok = false
    if !checkTrue("cwdVals_notArr_err", err != ""):
        ok = false
    # Trailing content after array
    err = ""
    let r5 = RustCsgThreadListSqliteCwdFilterValuesRaw("[\"/tmp\"] extra", err)
    if !checkTrue("cwdVals_trailing_err", err != ""):
        ok = false
    if ok:
        echo("testCwdFilterValuesRaw ok")
    return ok

# ── Section: testCwdFiltersJson ─────────────────────────────────────────

fn testCwdFiltersJson(): bool =
    var ok: bool = true
    var err: str
    # Empty -> ""
    if !checkEq("cwdFilt_empty", RustCsgThreadListSqliteCwdFiltersJson("", err), ""):
        ok = false
    # null -> ""
    err = ""
    if !checkEq("cwdFilt_null", RustCsgThreadListSqliteCwdFiltersJson("null", err), ""):
        ok = false
    # Empty array -> ""
    err = ""
    if !checkEq("cwdFilt_emptyArr", RustCsgThreadListSqliteCwdFiltersJson("[]", err), ""):
        ok = false
    # Single string path (empty array from CwdFilterValue because NormalizePath may fail)
    # Just test that the function parses a string path without error
    err = ""
    let r1 = RustCsgThreadListSqliteCwdFiltersJson("\"/\"", err)
    if !checkEq("cwdFilt_root", r1, "[\"/\"]"):
        ok = false
    if !checkEq("cwdFilt_root_err", err, ""):
        ok = false
    # Invalid JSON -> error
    err = ""
    let r2 = RustCsgThreadListSqliteCwdFiltersJson("not_json", err)
    if !checkEq("cwdFilt_badJson", r2, ""):
        ok = false
    if !checkTrue("cwdFilt_badJson_err", err != ""):
        ok = false
    # Array with trailing content -> error
    err = ""
    let r3 = RustCsgThreadListSqliteCwdFiltersJson("[\"/tmp\"] extra", err)
    if !checkEq("cwdFilt_trailing", r3, ""):
        ok = false
    if !checkTrue("cwdFilt_trailing_err", err != ""):
        ok = false
    if ok:
        echo("testCwdFiltersJson ok")
    return ok

# ── Section: testPlanFromParams ─────────────────────────────────────────

fn testPlanFromParams(): bool =
    var ok: bool = true
    # Default plan
    var p1: RustCsgThreadListParams
    let plan1 = RustCsgThreadListSqlitePlanFromParams(p1, "openai")
    if !checkEq("plan_parseErr", plan1.parseError, ""):
        ok = false
    if !checkInt32("plan_pageSize", plan1.pageSize, 25):
        ok = false
    if !checkEq("plan_sortKey", plan1.sortKey, "created_at"):
        ok = false
    if !checkEq("plan_sortDir", plan1.sortDirection, "desc"):
        ok = false
    if !checkEq("plan_modelProv", plan1.modelProviderFilterJson, "[\"openai\"]"):
        ok = false
    if !checkEq("plan_allowedSources", plan1.allowedSourcesJson, RustCsgThreadListSqliteAllInteractiveSourcesJson()):
        ok = false
    if !checkEq("plan_postFilter", plan1.sourceKindPostFilterJson, ""):
        ok = false
    if !checkFalse("plan_archived", plan1.archived):
        ok = false
    if !checkEq("plan_searchTerm", plan1.searchTerm, ""):
        ok = false
    # Explicit params
    var p2: RustCsgThreadListParams
    p2.limitJson = "5"
    p2.sortKey = "updated_at"
    p2.sortDirection = "asc"
    p2.modelProvidersJson = "[\"anthropic\"]"
    p2.sourceKindsJson = "[\"exec\"]"
    p2.archivedJson = "true"
    p2.searchTerm = "test"
    let plan2 = RustCsgThreadListSqlitePlanFromParams(p2, "openai")
    if !checkInt32("plan2_pageSize", plan2.pageSize, 5):
        ok = false
    if !checkEq("plan2_sortKey", plan2.sortKey, "updated_at"):
        ok = false
    if !checkEq("plan2_sortDir", plan2.sortDirection, "asc"):
        ok = false
    if !checkEq("plan2_modelProv", plan2.modelProviderFilterJson, "[\"anthropic\"]"):
        ok = false
    if !checkEq("plan2_allowedSources", plan2.allowedSourcesJson, "[\"exec\"]"):
        ok = false
    if !checkEq("plan2_postFilter", plan2.sourceKindPostFilterJson, ""):
        ok = false
    if !checkTrue("plan2_archived", plan2.archived):
        ok = false
    if !checkEq("plan2_searchTerm", plan2.searchTerm, "test"):
        ok = false
    # Parse error: bad limit
    var p3: RustCsgThreadListParams
    p3.limitJson = "abc"
    let plan3 = RustCsgThreadListSqlitePlanFromParams(p3, "openai")
    if !checkTrue("plan3_error", plan3.parseError != ""):
        ok = false
    if ok:
        echo("testPlanFromParams ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testJsonStringArrayOne(): allOk = false
    if !testCanonicalAbsolutePath(): allOk = false
    if !testJsonLooksInt(): allOk = false
    if !testLimit(): allOk = false
    if !testSortKey(): allOk = false
    if !testSortDirection(): allOk = false
    if !testAllInteractiveSourcesJson(): allOk = false
    if !testAllSourceKindsJson(): allOk = false
    if !testSourceKindRequiresPostFilter(): allOk = false
    if !testAllowedSourcesJson(): allOk = false
    if !testSourceKindPostFilterJson(): allOk = false
    if !testModelProviderFilterJson(): allOk = false
    if !testOrderSql(): allOk = false
    if !testCursor(): allOk = false
    if !testBackwardsCursor(): allOk = false
    if !testAsciiSpace(): allOk = false
    if !testTrimAsciiSpace(): allOk = false
    if !testDistinctTitle(): allOk = false
    if !testThreadFromStateRow(): allOk = false
    if !testSortValueFromStateRow(): allOk = false
    if !testRowMatchesSourcePostFilter(): allOk = false
    if !testValidateModelProvidersJson(): allOk = false
    if !testHexValueAt(): allOk = false
    if !testPrintableAsciiFromCode(): allOk = false
    if !testJsonStringAt(): allOk = false
    if !testCwdFilterStringRaw(): allOk = false
    if !testCwdFilterValuesRaw(): allOk = false
    if !testCwdFiltersJson(): allOk = false
    if !testPlanFromParams(): allOk = false
    if allOk:
        echo("rust_csg_thread_list_sqlite_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_thread_list_sqlite_relfacts_smoke FAILED")
        return 1
