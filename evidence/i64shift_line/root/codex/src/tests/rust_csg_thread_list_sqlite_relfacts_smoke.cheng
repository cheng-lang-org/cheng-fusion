# ── Section: testCanonicalAbsolutePath ───────────────────────────────────

fn testCanonicalAbsolutePath(): bool =
    var ok: bool = true
    # valid paths
    if !checkTrue("canon_root", RustCsgThreadListSqliteCanonicalAbsolutePath("/")):
        ok = false
    if !checkTrue("canon_tmp", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp")):
        ok = false
    if !checkTrue("canon_deep", RustCsgThreadListSqliteCanonicalAbsolutePath("/home/user/projects")):
        ok = false
    if !checkTrue("canon_hyphen", RustCsgThreadListSqliteCanonicalAbsolutePath("/home/user/my-project")):
        ok = false
    # invalid - not absolute
    if !checkFalse("canon_relative", RustCsgThreadListSqliteCanonicalAbsolutePath("relative/path")):
        ok = false
    if !checkFalse("canon_empty", RustCsgThreadListSqliteCanonicalAbsolutePath("")):
        ok = false
    if !checkFalse("canon_tilde", RustCsgThreadListSqliteCanonicalAbsolutePath("~/home")):
        ok = false
    # invalid - trailing slash
    if !checkFalse("canon_trail_slash", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp/")):
        ok = false
    # invalid - double slash
    if !checkFalse("canon_double_slash", RustCsgThreadListSqliteCanonicalAbsolutePath("//tmp")):
        ok = false
    # invalid - dot components
    if !checkFalse("canon_dot", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp/./x")):
        ok = false
    if !checkFalse("canon_dotdot", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp/../x")):
        ok = false
    if !checkFalse("canon_trail_dot", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp/.")):
        ok = false
    if !checkFalse("canon_trail_dotdot", RustCsgThreadListSqliteCanonicalAbsolutePath("/tmp/..")):
        ok = false
    # too short (len < 2, not root)
    if !checkFalse("canon_single", RustCsgThreadListSqliteCanonicalAbsolutePath("a")):
        ok = false
    if ok:
        echo("testCanonicalAbsolutePath ok")
    return ok

