    p7.sourceKindsJson = "[\"subAgentReview\"]"
    if !checkEq("postFilt_subReview", RustCsgThreadListSqliteSourceKindPostFilterJson(p7), ""):
        ok = false
    var p8: RustCsgThreadListParams
    p8.sourceKindsJson = "[\"subAgentCompact\"]"
    if !checkEq("postFilt_subCompact", RustCsgThreadListSqliteSourceKindPostFilterJson(p8), ""):
        ok = false
    var p9: RustCsgThreadListParams
