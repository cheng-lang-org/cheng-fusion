# ── Section: testLimit ───────────────────────────────────────────────────

fn testLimit(): bool =
    var ok: bool = true
    var err: str
    # default when empty
    if !checkInt32("limit_default", RustCsgThreadListSqliteLimit("", err), 25):
        ok = false
    if !checkEq("limit_default_err", err, ""):
        ok = false
    # explicit value
    err = ""
    if !checkInt32("limit_10", RustCsgThreadListSqliteLimit("10", err), 10):
        ok = false
    err = ""
    if !checkInt32("limit_1", RustCsgThreadListSqliteLimit("1", err), 1):
        ok = false
    # clamping: min 1
    err = ""
    if !checkInt32("limit_0_clamped", RustCsgThreadListSqliteLimit("0", err), 1):
        ok = false
    err = ""
    if !checkInt32("limit_neg_clamped", RustCsgThreadListSqliteLimit("-5", err), 1):
        ok = false
    # clamping: max 100
    err = ""
    if !checkInt32("limit_200_clamped", RustCsgThreadListSqliteLimit("200", err), 100):
        ok = false
    # error on non-integer
    err = ""
    let r1 = RustCsgThreadListSqliteLimit("abc", err)
    if !checkInt32("limit_abc", r1, 0):
        ok = false
    if !checkTrue("limit_abc_err", err != ""):
        ok = false
    if ok:
        echo("testLimit ok")
    return ok

