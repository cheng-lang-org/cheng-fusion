# ── Section: testSourceKindRequiresPostFilter ───────────────────────────

fn testSourceKindRequiresPostFilter(): bool =
    var ok: bool = true
    # Single exact matches that SQL can handle -> false
    if !checkFalse("req_exact_exec", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"exec\"]")):
        ok = false
    if !checkFalse("req_exact_appServer", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"appServer\"]")):
        ok = false
    if !checkFalse("req_exact_unknown", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"unknown\"]")):
        ok = false
    if !checkFalse("req_exact_subAgent", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgent\"]")):
        ok = false
    if !checkFalse("req_exact_subReview", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgentReview\"]")):
        ok = false
    if !checkFalse("req_exact_subCompact", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgentCompact\"]")):
        ok = false
    if !checkFalse("req_exact_subSpawn", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgentThreadSpawn\"]")):
        ok = false
    # Interactive only -> false (handled by SQL directly)
    if !checkFalse("req_cli_only", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"cli\"]")):
        ok = false
    if !checkFalse("req_vscode_only", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"vscode\"]")):
        ok = false
    # Empty -> false
    if !checkFalse("req_empty", RustCsgThreadListSqliteSourceKindRequiresPostFilter("")):
        ok = false
    # Mixed with SQL-unhandled kinds -> true
    if !checkTrue("req_mixed_exec", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"exec\",\"cli\"]")):
        ok = false
    if !checkTrue("req_mixed_app", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"appServer\",\"vscode\"]")):
        ok = false
    if !checkTrue("req_mixed_subAgent", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgent\",\"cli\"]")):
        ok = false
    if !checkTrue("req_mixed_unknown", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"cli\",\"unknown\"]")):
        ok = false
    if !checkTrue("req_subOther", RustCsgThreadListSqliteSourceKindRequiresPostFilter("[\"subAgentOther\"]")):
        ok = false
    if ok:
        echo("testSourceKindRequiresPostFilter ok")
    return ok

# ── Section: testAllowedSourcesJson ──────────────────────────────────────

fn testAllowedSourcesJson(): bool =
    var ok: bool = true
    # Default (empty sourceKinds) -> all interactive
    var p1: RustCsgThreadListParams
    let r1 = RustCsgThreadListSqliteAllowedSourcesJson(p1)
    if !checkEq("allowed_default", r1, RustCsgThreadListSqliteAllInteractiveSourcesJson()):
        ok = false
    # Empty array -> all interactive
    var p2: RustCsgThreadListParams
    p2.sourceKindsJson = "[]"
    let r2 = RustCsgThreadListSqliteAllowedSourcesJson(p2)
    if !checkEq("allowed_emptyArr", r2, RustCsgThreadListSqliteAllInteractiveSourcesJson()):
        ok = false
    # exec
    var p3: RustCsgThreadListParams
    p3.sourceKindsJson = "[\"exec\"]"
    if !checkEq("allowed_exec", RustCsgThreadListSqliteAllowedSourcesJson(p3), "[\"exec\"]"):
        ok = false
    # appServer -> mcp
    var p4: RustCsgThreadListParams
    p4.sourceKindsJson = "[\"appServer\"]"
    if !checkEq("allowed_appServer", RustCsgThreadListSqliteAllowedSourcesJson(p4), "[\"mcp\"]"):
        ok = false
    # unknown
    var p5: RustCsgThreadListParams
    p5.sourceKindsJson = "[\"unknown\"]"
    if !checkEq("allowed_unknown", RustCsgThreadListSqliteAllowedSourcesJson(p5), "[\"unknown\"]"):
        ok = false
    # subAgent -> subagent
    var p6: RustCsgThreadListParams
    p6.sourceKindsJson = "[\"subAgent\"]"
    if !checkEq("allowed_subAgent", RustCsgThreadListSqliteAllowedSourcesJson(p6), "[\"subagent\"]"):
        ok = false
    # subAgentReview -> subagent_review
    var p7: RustCsgThreadListParams
    p7.sourceKindsJson = "[\"subAgentReview\"]"
    if !checkEq("allowed_subReview", RustCsgThreadListSqliteAllowedSourcesJson(p7), "[\"subagent_review\"]"):
        ok = false
    # subAgentCompact -> subagent_compact
    var p8: RustCsgThreadListParams
    p8.sourceKindsJson = "[\"subAgentCompact\"]"
    if !checkEq("allowed_subCompact", RustCsgThreadListSqliteAllowedSourcesJson(p8), "[\"subagent_compact\"]"):
        ok = false
    # subAgentThreadSpawn -> subagent_thread_spawn
    var p9: RustCsgThreadListParams
    p9.sourceKindsJson = "[\"subAgentThreadSpawn\"]"
    if !checkEq("allowed_subSpawn", RustCsgThreadListSqliteAllowedSourcesJson(p9), "[\"subagent_thread_spawn\"]"):
        ok = false
    # subAgentOther -> subagent (SQL source = subagent, needs post-filter)
    var p10: RustCsgThreadListParams
    p10.sourceKindsJson = "[\"subAgentOther\"]"
    if !checkEq("allowed_subOther", RustCsgThreadListSqliteAllowedSourcesJson(p10), "[\"subagent\"]"):
        ok = false
    # cli
    var p11: RustCsgThreadListParams
    p11.sourceKindsJson = "[\"cli\"]"
    if !checkEq("allowed_cli", RustCsgThreadListSqliteAllowedSourcesJson(p11), "[\"cli\"]"):
        ok = false
    # vscode
    var p12: RustCsgThreadListParams
    p12.sourceKindsJson = "[\"vscode\"]"
    if !checkEq("allowed_vscode", RustCsgThreadListSqliteAllowedSourcesJson(p12), "[\"vscode\"]"):
        ok = false
    # Mixed exec+cli -> needs post-filter, returns []
    var p13: RustCsgThreadListParams
    p13.sourceKindsJson = "[\"exec\",\"cli\"]"
    if !checkEq("allowed_mixed_exec_cli", RustCsgThreadListSqliteAllowedSourcesJson(p13), "[]"):
        ok = false
    # Mixed cli+vscode -> no post-filter needed
    var p14: RustCsgThreadListParams
    p14.sourceKindsJson = "[\"cli\",\"vscode\"]"
    if !checkEq("allowed_cli_vscode", RustCsgThreadListSqliteAllowedSourcesJson(p14), "[\"cli\",\"vscode\"]"):
        ok = false
    if ok:
        echo("testAllowedSourcesJson ok")
    return ok

