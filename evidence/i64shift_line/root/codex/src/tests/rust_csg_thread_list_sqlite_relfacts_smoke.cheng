        ok = false
    var p11: RustCsgThreadListParams
    p11.sourceKindsJson = "[\"vscode\"]"
    if !checkEq("postFilt_vscode", RustCsgThreadListSqliteSourceKindPostFilterJson(p11), "[\"vscode\"]"):
        ok = false
    # Mixed sources -> returns the sourceKindsJson
    var p12: RustCsgThreadListParams
    p12.sourceKindsJson = "[\"exec\",\"cli\"]"
    if !checkEq("postFilt_mixed", RustCsgThreadListSqliteSourceKindPostFilterJson(p12), "[\"exec\",\"cli\"]"):
        ok = false
    if ok:
        echo("testSourceKindPostFilterJson ok")
    return ok

