# ── Simplified importc stubs (self-contained, no Rust backend dependency) ──

# Stub: formats millis as a simple RFC3339-like string for cursor testing
fn RustCsgMillisToRfc3339(millis: int64): str =
    var s = strings.Int64ToStr(millis / int64(1000))
    return Cat(s, "Z")

# Stub: parses RFC3339-like string back to millis text for cursor validation
fn RustCsgRfc3339ToMillisText(text: str): str =
    if text.len >= 13:
        return strings.SliceBytes(text, 0, 13)
    return ""

# Stub: normalizes path relative to current directory.
# Passes through absolute paths, returns empty for relative paths.
fn RustCsgNormalizePathRelativeToCurrentDir(path: str): str =
    if path.len > 0 && path[0] == '/':
        return path
    return ""

