    if !checkInt64("sortVal_default", RustCsgThreadListSqliteSortValueFromStateRow(row, ""), int64(200)):
        ok = false
    if ok:
        echo("testSortValueFromStateRow ok")
    return ok

# ── Section: testRowMatchesSourcePostFilter ──────────────────────────────

fn testRowMatchesSourcePostFilter(): bool =
    var ok: bool = true
    var row: RustCsgStateDbThreadRowResult
    row.source = "cli"
    row.rolloutPath = "/tmp/rollout.json"
    # Empty filter -> always match
    if !checkTrue("postFiltMatch_empty", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, "")):
        ok = false
    # Non-subAgentOther filter -> always match
    if !checkTrue("postFiltMatch_exec", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, "[\"exec\"]")):
        ok = false
    if !checkTrue("postFiltMatch_cli", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, "[\"cli\"]")):
        ok = false
    if !checkTrue("postFiltMatch_mixed", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, "[\"exec\",\"cli\"]")):
        ok = false
    # subAgentOther with row source not starting with "subagent_" -> false
    if !checkFalse("postFiltMatch_subOther_nonSub", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row, "[\"subAgentOther\"]")):
        ok = false
    # subAgentOther with empty rolloutPath -> false
    var row2: RustCsgStateDbThreadRowResult
    row2.source = "subagent_other"
    row2.rolloutPath = ""
    if !checkFalse("postFiltMatch_subOther_noPath", RustCsgThreadListSqliteRowMatchesSourcePostFilter(row2, "[\"subAgentOther\"]")):
        ok = false
    if ok:
        echo("testRowMatchesSourcePostFilter ok")
    return ok

# ── Section: testValidateModelProvidersJson ──────────────────────────────

fn testValidateModelProvidersJson(): bool =
    var ok: bool = true
    var err: str
    # Empty -> passthrough
    if !checkEq("valProv_empty", RustCsgThreadListSqliteValidateModelProvidersJson("", err), ""):
        ok = false
    if !checkEq("valProv_empty_err", err, ""):
        ok = false
    # Empty array -> passthrough
    err = ""
    if !checkEq("valProv_emptyArr", RustCsgThreadListSqliteValidateModelProvidersJson("[]", err), "[]"):
        ok = false
    # Valid single
    err = ""
    if !checkEq("valProv_single", RustCsgThreadListSqliteValidateModelProvidersJson("[\"anthropic\"]", err), "[\"anthropic\"]"):
        ok = false
    # Valid multiple
    err = ""
    if !checkEq("valProv_multi", RustCsgThreadListSqliteValidateModelProvidersJson("[\"anthropic\",\"openai\"]", err), "[\"anthropic\",\"openai\"]"):
        ok = false
    # Not an array
    err = ""
    let r1 = RustCsgThreadListSqliteValidateModelProvidersJson("\"not_array\"", err)
    if !checkEq("valProv_notArray", r1, ""):
        ok = false
    if !checkTrue("valProv_notArray_err", err != ""):
        ok = false
    # Contains empty provider
    err = ""
    let r2 = RustCsgThreadListSqliteValidateModelProvidersJson("[\"anthropic\",\"\"]", err)
    if !checkEq("valProv_emptyProvider", r2, ""):
        ok = false
    if !checkTrue("valProv_emptyProvider_err", err != ""):
        ok = false
    if ok:
        echo("testValidateModelProvidersJson ok")
    return ok

# ── Section: testHexValueAt ─────────────────────────────────────────────

fn testHexValueAt(): bool =
    var ok: bool = true
    if !checkInt32("hex_0", RustCsgThreadListSqliteHexValueAt("0123", 0), 0):
        ok = false
    if !checkInt32("hex_1", RustCsgThreadListSqliteHexValueAt("0123", 1), 1):
        ok = false
    if !checkInt32("hex_2", RustCsgThreadListSqliteHexValueAt("0123", 2), 2):
        ok = false
    if !checkInt32("hex_3", RustCsgThreadListSqliteHexValueAt("0123", 3), 3):
        ok = false
    if !checkInt32("hex_a", RustCsgThreadListSqliteHexValueAt("aBcDeF", 0), 10):
        ok = false
    if !checkInt32("hex_B", RustCsgThreadListSqliteHexValueAt("aBcDeF", 1), 11):
        ok = false
    if !checkInt32("hex_c", RustCsgThreadListSqliteHexValueAt("aBcDeF", 2), 12):
        ok = false
    if !checkInt32("hex_D", RustCsgThreadListSqliteHexValueAt("aBcDeF", 3), 13):
        ok = false
    if !checkInt32("hex_e", RustCsgThreadListSqliteHexValueAt("aBcDeF", 4), 14):
        ok = false
    if !checkInt32("hex_F", RustCsgThreadListSqliteHexValueAt("aBcDeF", 5), 15):
        ok = false
    if !checkInt32("hex_oob", RustCsgThreadListSqliteHexValueAt("ab", 5), -1):
        ok = false
    if !checkInt32("hex_nonhex", RustCsgThreadListSqliteHexValueAt("xyz", 0), -1):
        ok = false
    if ok:
        echo("testHexValueAt ok")
    return ok

