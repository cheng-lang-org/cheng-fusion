    p5.sourceKindsJson = "[\"unknown\"]"
    if !checkEq("postFilt_unknown", RustCsgThreadListSqliteSourceKindPostFilterJson(p5), ""):
        ok = false
    var p6: RustCsgThreadListParams
    p6.sourceKindsJson = "[\"subAgent\"]"
    if !checkEq("postFilt_subAgent", RustCsgThreadListSqliteSourceKindPostFilterJson(p6), ""):
        ok = false
