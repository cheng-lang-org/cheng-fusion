# ── Section: testDistinctTitle ──────────────────────────────────────────

fn testDistinctTitle(): bool =
    var ok: bool = true
    # Empty title -> ""
    var r1: RustCsgStateDbThreadRowResult
    r1.title = ""
    r1.firstUserMessage = "hello"
    if !checkEq("distinct_emptyTitle", RustCsgThreadListSqliteDistinctTitle(r1), ""):
        ok = false
    # Title same as firstUserMessage -> ""
    var r2: RustCsgStateDbThreadRowResult
    r2.title = "hello"
    r2.firstUserMessage = "hello"
    if !checkEq("distinct_same", RustCsgThreadListSqliteDistinctTitle(r2), ""):
        ok = false
    # Title same but with whitespace -> ""
    var r3: RustCsgStateDbThreadRowResult
    r3.title = "  hello  "
    r3.firstUserMessage = "hello"
    if !checkEq("distinct_same_trim", RustCsgThreadListSqliteDistinctTitle(r3), ""):
        ok = false
    # Title different from firstUserMessage -> trimmed title
    var r4: RustCsgStateDbThreadRowResult
    r4.title = "  My Title  "
    r4.firstUserMessage = "different message"
    if !checkEq("distinct_diff", RustCsgThreadListSqliteDistinctTitle(r4), "My Title"):
        ok = false
    # FirstUserMessage empty, title non-empty -> trimmed title
    var r5: RustCsgStateDbThreadRowResult
    r5.title = "Lone Title"
    r5.firstUserMessage = ""
    if !checkEq("distinct_noFirstMsg", RustCsgThreadListSqliteDistinctTitle(r5), "Lone Title"):
        ok = false
    if ok:
        echo("testDistinctTitle ok")
    return ok

# ── Section: testThreadFromStateRow ──────────────────────────────────────

fn testThreadFromStateRow(): bool =
    var ok: bool = true
    var row: RustCsgStateDbThreadRowResult
    row.ok = true
    row.id = "thread-abc-123"
    row.title = "My Thread"
    row.cwd = "/home/user/project"
    row.modelProvider = "anthropic"
    row.source = "cli"
    row.rolloutPath = "/tmp/rollouts/abc"
    row.createdAtMs = int64(1700000000123)
    row.updatedAtMs = int64(1700000050123)
    row.cliVersion = "1.2.3"
    row.firstUserMessage = "Hello, can you help me?"
    let thread = RustCsgThreadListSqliteThreadFromStateRow(row)
    if !checkEq("thread_id", thread.id, "thread-abc-123"):
        ok = false
    if !checkEq("thread_sessionId", thread.sessionId, "thread-abc-123"):
        ok = false
    if !checkEq("thread_name", thread.name, "My Thread"):
        ok = false
    if !checkEq("thread_cwd", thread.cwd, "/home/user/project"):
        ok = false
    if !checkEq("thread_modelProvider", thread.modelProvider, "anthropic"):
        ok = false
    if !checkEq("thread_source", thread.source, "cli"):
        ok = false
    if !checkEq("thread_path", thread.path, "/tmp/rollouts/abc"):
        ok = false
    if !checkEq("thread_cliVersion", thread.cliVersion, "1.2.3"):
        ok = false
    if !checkEq("thread_preview", thread.preview, "Hello, can you help me?"):
        ok = false
    if !checkEq("thread_statusJson", thread.statusJson, "{\"type\":\"notLoaded\"}"):
        ok = false
    if !checkEq("thread_turnsJson", thread.turnsJson, "[]"):
        ok = false
    # timestamps in seconds (divide by 1000)
    if !checkInt64("thread_createdAt", thread.createdAt, int64(1700000000)):
        ok = false
    if !checkInt64("thread_updatedAt", thread.updatedAt, int64(1700000050)):
        ok = false
    # Name empty when title matches firstUserMessage
    var row2: RustCsgStateDbThreadRowResult
    row2.title = "same message"
    row2.firstUserMessage = "same message"
    let thread2 = RustCsgThreadListSqliteThreadFromStateRow(row2)
    if !checkEq("thread_emptyName", thread2.name, ""):
        ok = false
    if ok:
        echo("testThreadFromStateRow ok")
    return ok

# ── Section: testSortValueFromStateRow ──────────────────────────────────

fn testSortValueFromStateRow(): bool =
    var ok: bool = true
