import std/strutils as strutil
import std/strings as strings
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader

fn strContains(haystack: str, needle: str): bool =
    for i in 0..<haystack.len:
        if wire.RustCsgMatchesAt(haystack, i, needle):
            return true
    return false

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strContains(haystack, needle):
        echo(strutil.Join([label, " FAIL: missing [", needle, "] in [", haystack, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn main(): int32 =
    echo("debug start")
    var allOk: bool = true

    // Test 1: copyOptionalJsonField with number value
    let src = "{\"a\":1,\"b\":\"hello\",\"c\":null}"
    var convOk: bool
    let out1 = reader.RustCsgRolloutCopyOptionalJsonField(src, "a", "")
    echo(strutil.Join(["out1=[", out1, "] len=", strings.IntToStr(out1.len)], ""))
    if !checkContains(out1, "\"a\":1", "copyField a"):
        allOk = false

    // Test 2: copyOptionalJsonField with string value
    let out2 = reader.RustCsgRolloutCopyOptionalJsonField(src, "b", "{\"x\":1}")
    echo(strutil.Join(["out2=[", out2, "] len=", strings.IntToStr(out2.len)], ""))
    if !checkContains(out2, "\"x\":1", "copyField append existing"):
        allOk = false
    if !checkContains(out2, "\"b\":\"hello\"", "copyField append b"):
        allOk = false

    // Test 3: copyOptionalJsonField with null value
    let out3 = reader.RustCsgRolloutCopyOptionalJsonField(src, "c", "")
    echo(strutil.Join(["out3=[", out3, "] len=", strings.IntToStr(out3.len)], ""))
    if out3 != "":
        echo(strutil.Join(["FAIL: copyField null should not copy: got=", out3], "")); allOk = false

    // Test 4: duration secs nanos
    var convOk2: bool
    let dur1 = reader.RustCsgRolloutDurationSecsNanosToMsStr("{\"seconds\":1,\"nanos\":500000000}", convOk2)
    if convOk2:
        echo(strutil.Join(["dur1=[", dur1, "] ok"], ""))
    else:
        echo(strutil.Join(["dur1 FAIL convOk2=false"], ""))
    if !convOk2 || dur1 != "1500":
        echo(strutil.Join(["FAIL: duration 1.5s expected=1500 got=", dur1], "")); allOk = false

    echo("ALL TESTS COMPLETE")
    if allOk:
        echo("rust_csg_rollout_reader_debug ok")
        return 0
    else:
        echo("rust_csg_rollout_reader_debug FAILED")
        return 1
