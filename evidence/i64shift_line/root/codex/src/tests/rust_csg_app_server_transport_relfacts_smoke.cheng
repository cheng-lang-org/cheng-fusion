fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "fn RustCsgHasPrefix(s: str, prefix: str): bool =\nfn RustCsgClassifyTransportUrl(url: str): str =\nfn RustCsgIsConnectionOpened(variant: str): bool =\nfn RustCsgIsConnectionClosed(variant: str): bool =\nfn RustCsgIsIncomingMessage(variant: str): bool =\nfn RustCsgIsStdioConnection(origin: str): bool =\nfn RustCsgIsInProcessConnection(origin: str): bool =\nfn RustCsgIsWebSocketConnection(origin: str): bool =\nfn RustCsgIsRemoteControlConnection(origin: str): bool =\nfn RustCsgIsServerRequest(msgVariant: str): bool =\nfn RustCsgIsAppServerNotification(msgVariant: str): bool =\nfn RustCsgIsResponse(msgVariant: str): bool =\nfn RustCsgIsOutgoingError(msgVariant: str): bool =\nfn RustCsgRemoteControlAvailable(stateDbAvailable: bool): bool =\nfn RustCsgRenderConnectionId(id: int64): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tapp_server_transport\nFunction\tapp_server_transport\tRustCsgHasPrefix\tbool\nFunction\tapp_server_transport\tRustCsgClassifyTransportUrl\tstr\nFunction\tapp_server_transport\tRustCsgIsConnectionOpened\tbool\nFunction\tapp_server_transport\tRustCsgIsConnectionClosed\tbool\nFunction\tapp_server_transport\tRustCsgIsIncomingMessage\tbool\nFunction\tapp_server_transport\tRustCsgIsStdioConnection\tbool\nFunction\tapp_server_transport\tRustCsgIsInProcessConnection\tbool\nFunction\tapp_server_transport\tRustCsgIsWebSocketConnection\tbool\nFunction\tapp_server_transport\tRustCsgIsRemoteControlConnection\tbool\nFunction\tapp_server_transport\tRustCsgIsServerRequest\tbool\nFunction\tapp_server_transport\tRustCsgIsAppServerNotification\tbool\nFunction\tapp_server_transport\tRustCsgIsResponse\tbool\nFunction\tapp_server_transport\tRustCsgIsOutgoingError\tbool\nFunction\tapp_server_transport\tRustCsgRemoteControlAvailable\tbool\nFunction\tapp_server_transport\tRustCsgRenderConnectionId\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 0, "source type count")
    assert(ecf == 0, "source field count")
    assert(ecn == 15, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 0, "oracle type count")
    assert(ocf == 0, "oracle field count")
    assert(ocn == 15, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_app_server_transport_relfacts_smoke ok")
    return 0

main()