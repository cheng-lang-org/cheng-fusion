import cheng/codex/crates/cloud_tasks_mock_client/cloud_tasks_mock_client as ctmm
import std/strings

# ═══════════════════════════════════════════════════════════════════════════════
# Cloud Tasks Mock Client — type definition constants smoke test
#
# Ported from codex-rs/codex-cloud-tasks-mock-client
# ═══════════════════════════════════════════════════════════════════════════════

fn testMockClientFieldCount(): bool =
    if ctmm.RustCsgMockClientFieldCount != 0: return false
    echo("testMockClientFieldCount ok")
    return true

fn testMockClientMethodCount(): bool =
    if ctmm.RustCsgMockClientMethodCount != 9: return false
    echo("testMockClientMethodCount ok")
    return true

fn testMockTaskConstants(): bool =
    if ctmm.RustCsgMockGlobalTaskCount != 3: return false
    if ctmm.RustCsgMockEnvATaskCount != 1: return false
    if ctmm.RustCsgMockEnvBTaskCount != 2: return false
    echo("testMockTaskConstants ok")
    return true

fn testMockTaskIds(): bool =
    if ctmm.RustCsgMockTaskIdGlobal1 != "T-1000": return false
    if ctmm.RustCsgMockTaskIdEnvA1 != "T-2000": return false
    if ctmm.RustCsgMockTaskIdEnvB1 != "T-3000": return false
    echo("testMockTaskIds ok")
    return true

fn testMockTaskTitles(): bool =
    if ctmm.RustCsgMockTaskTitleGlobal1 != "Update README formatting": return false
    if ctmm.RustCsgMockTaskTitleEnvA1 != "A: First": return false
    if ctmm.RustCsgMockTaskTitleEnvB1 != "B: One": return false
    echo("testMockTaskTitles ok")
    return true

fn testMockDiffConstants(): bool =
    if ctmm.RustCsgMockDiffLinesAddedT1000 != 2: return false
    if ctmm.RustCsgMockDiffLinesRemovedT1000 != 1: return false
    if ctmm.RustCsgMockDiffLinesAddedDefault != 3: return false
    echo("testMockDiffConstants ok")
    return true

fn testMockAttemptTotals(): bool =
    if ctmm.RustCsgMockAttemptTotalT1000 != 2: return false
    if ctmm.RustCsgMockAttemptTotalDefault != 1: return false
    echo("testMockAttemptTotals ok")
    return true

fn testSimulateTaskLifecycle(): bool =
    var result: str = ctmm.simulateTaskLifecycle("T-1000")
    # Must not be empty
    if result.len == 0: return false
    # Must contain the task ID
    if !strings.StrContains(result, "T-1000"): return false
    # Must contain expected state transition markers
    if !strings.StrContains(result, "pending"): return false
    if !strings.StrContains(result, "ready"): return false
    if !strings.StrContains(result, "applied"): return false
    echo("testSimulateTaskLifecycle ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testMockClientFieldCount(): allOk = false
    if !testMockClientMethodCount(): allOk = false
    if !testMockTaskConstants(): allOk = false
    if !testMockTaskIds(): allOk = false
    if !testMockTaskTitles(): allOk = false
    if !testMockDiffConstants(): allOk = false
    if !testMockAttemptTotals(): allOk = false
    if !testSimulateTaskLifecycle(): allOk = false
    if allOk:
        echo("rust_csg_cloud_tasks_mock_client_types_smoke ok")
        return 0
    echo("rust_csg_cloud_tasks_mock_client_types_smoke FAILED")
    return 1
