import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/app_link_oracle as oracle

fn RustCsgTuiAppLinkExpr(): str =
    return "\"render_snapshot(&view, Rect::new(0, 0, 72, view.desired_height(72)))\""

fn RustCsgTuiAppLinkOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/app_link_view.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != RustCsgTuiAppLinkExpr():
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 3:
        echo("FAIL usage: rust_csg_tui_app_link_oracle_smoke <2 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiAppLinkOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiAppLinkEnableSuggestionSnapshot(), "app_link_view_enable_suggestion_with_reason")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiAppLinkOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiAppLinkInstallSuggestionSnapshot(), "app_link_view_install_suggestion_with_reason")

    if exitCode == 0:
        echo("rust_csg_tui_app_link_oracle_smoke ok")
    else:
        echo("rust_csg_tui_app_link_oracle_smoke FAILED")
    return exitCode
