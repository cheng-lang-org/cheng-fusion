import cheng/codex/crates/utils_elapsed/elapsed as elapsed
import cheng/codex/protocol/wire

fn checkOracle(ms: int64, expected: str): bool =
    let got = elapsed.RustCsgUtilsElapsedFormatDurationMillis(ms)
    return got == expected

fn main(): int32 =
    var fail: int32
    if !checkOracle(0, "0ms"): fail = fail + 1
    if !checkOracle(250, "250ms"): fail = fail + 1
    if !checkOracle(1500, "1.50s"): fail = fail + 1
    if !checkOracle(59999, "60.00s"): fail = fail + 1
    if !checkOracle(60000, "1m 00s"): fail = fail + 1
    if !checkOracle(75000, "1m 15s"): fail = fail + 1
    if !checkOracle(3600000, "60m 00s"): fail = fail + 1
    if !checkOracle(3601000, "60m 01s"): fail = fail + 1

    if fail > 0:
        echo("FAIL")
        return 1
    echo("rust_csg_oracle_utils_elapsed ok")
    return 0

main()