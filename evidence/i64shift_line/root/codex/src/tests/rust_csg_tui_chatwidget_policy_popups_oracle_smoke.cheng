import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_policy_popups_oracle as oracle

fn RustCsgTuiChatwidgetPolicyPopupsCheck(path: str,
                                          expectedSource: str,
                                          expectedExpression: str,
                                          expectedBody: str,
                                          name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 7:
        echo("FAIL usage: rust_csg_tui_chatwidget_policy_popups_oracle_smoke <6 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetMultiAgentEnablePrompt(), "multi_agent_enable_prompt")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetFullAccessConfirmationPopup(), "full_access_confirmation_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetRateLimitSwitchPromptPopup(), "rate_limit_switch_prompt_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetFeedbackGoodResultConsentPopup(), "feedback_good_result_consent_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetUpdatePopup(), "update_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPolicyPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetApprovalsSelectionPopup(), "approvals_selection_popup")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_policy_popups_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_policy_popups_oracle_smoke FAILED")
    return exitCode
