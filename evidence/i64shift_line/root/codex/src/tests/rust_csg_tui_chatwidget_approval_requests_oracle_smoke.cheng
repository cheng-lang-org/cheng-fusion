import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_approval_requests_oracle as oracle

fn RustCsgTuiChatwidgetApprovalRequestsCheck(path: str,
                                              expectedSource: str,
                                              expectedExpression: str,
                                              expectedBody: str,
                                              name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(s.bodyByteLen),
            " got=", strings.IntToStr(strings.Len(expectedBody)),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_chatwidget_approval_requests_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalRequestsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "\"format!(\\\"{buf:?}\\\")\"", oracle.RustCsgTuiChatwidgetApprovalModalExec(), "exec_approval_modal_exec")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalRequestsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "lines_to_single_string(&decision)", oracle.RustCsgTuiChatwidgetApprovalApprovedShort(), "exec_approval_history_decision_approved_short")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalRequestsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "lines_to_single_string(&aborted_long)", oracle.RustCsgTuiChatwidgetApprovalAbortedLong(), "exec_approval_history_decision_aborted_long")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalRequestsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "lines_to_single_string(&aborted_multi)", oracle.RustCsgTuiChatwidgetApprovalAbortedMultiline(), "exec_approval_history_decision_aborted_multiline")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_approval_requests_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_approval_requests_oracle_smoke FAILED")
    return exitCode
