import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# connectors Type Definitions
#
# Module-level constants extracted from:
#   codex-rs/connectors/src/lib.rs
#
# Covers: ConnectorDirectoryCacheKey, ConnectorDirectoryCacheContext,
#   DirectoryListResponse, DirectoryApp, CONNECTORS_CACHE_TTL
# ═══════════════════════════════════════════════════════════════════════════════

# ── CONNECTORS_CACHE_TTL (int32, testable) ───────────────────────────────────
const RustCsgConnectorsCacheTtlSeconds: int32 = 3600

# ── struct field counts (int32, testable) ────────────────────────────────────
const RustCsgConnectorDirectoryCacheKeyFieldCount: int32 = 4
const RustCsgConnectorDirectoryCacheContextFieldCount: int32 = 2
const RustCsgDirectoryListResponseFieldCount: int32 = 2
const RustCsgDirectoryAppFieldCount: int32 = 10

# ── string consts (verified by compilation) ──────────────────────────────────
const RustCsgConnectorDirectoryCacheKeyField1: str = "chatgpt_base_url"
const RustCsgConnectorDirectoryCacheKeyField2: str = "account_id"
const RustCsgConnectorDirectoryCacheKeyField3: str = "chatgpt_user_id"
const RustCsgConnectorDirectoryCacheKeyField4: str = "is_workspace_account"
const RustCsgDirectoryAppVisibilityHidden: str = "HIDDEN"

# Filter a comma-separated list of "name:protocol" connector specs by supported protocol.
# Returns comma-separated connector names that match the given protocol, or "" if none match.
fn connectorsFilterByProtocol(connectors: str, protocol: str): str =
    if connectors.len == 0 || protocol.len == 0:
        return ""
    var result: str = ""
    var first: bool = true
    var start: int32 = 0
    var i: int32 = 0
    while i <= connectors.len:
        if i == connectors.len || connectors[i] == ',':
            if i > start:
                var spec: str = strings.SliceBytes(connectors, start, i - start)
                # Split on ':'
                var colonIdx: int32 = -1
                var j: int32 = 0
                while j < spec.len:
                    if spec[j] == ':':
                        colonIdx = j
                        break
                    j = j + 1
                if colonIdx >= 0:
                    let name: str = strings.SliceBytes(spec, 0, colonIdx)
                    let proto: str = strings.SliceBytes(spec, colonIdx + 1, spec.len - colonIdx - 1)
                    if proto == protocol:
                        if first:
                            result = name
                            first = false
                        else:
                            result = strutil.Join([result, ",", name], "")
            start = i + 1
        i = i + 1
    return result

# ── Tests ──────────────────────────────────────────────────────────────────

fn testConnectorsCacheTtl(): bool =
    if RustCsgConnectorsCacheTtlSeconds == 3600:
        echo("testConnectorsCacheTtl ok")
        return true
    echo("FAIL testConnectorsCacheTtl")
    return false

fn testConnectorDirectoryCacheKeyFieldCount(): bool =
    if RustCsgConnectorDirectoryCacheKeyFieldCount == 4:
        echo("testConnectorDirectoryCacheKeyFieldCount ok")
        return true
    echo("FAIL testConnectorDirectoryCacheKeyFieldCount")
    return false

fn testConnectorDirectoryCacheContextFieldCount(): bool =
    if RustCsgConnectorDirectoryCacheContextFieldCount == 2:
        echo("testConnectorDirectoryCacheContextFieldCount ok")
        return true
    echo("FAIL testConnectorDirectoryCacheContextFieldCount")
    return false

fn testDirectoryListResponseFieldCount(): bool =
    if RustCsgDirectoryListResponseFieldCount == 2:
        echo("testDirectoryListResponseFieldCount ok")
        return true
    echo("FAIL testDirectoryListResponseFieldCount")
    return false

fn testDirectoryAppFieldCount(): bool =
    if RustCsgDirectoryAppFieldCount == 10:
        echo("testDirectoryAppFieldCount ok")
        return true
    echo("FAIL testDirectoryAppFieldCount")
    return false

# ── connectorsFilterByProtocol tests ───────────────────────────────────────

fn testFilterByProtocolBasic(): bool =
    let result = connectorsFilterByProtocol("github:https,slack:https,local:file", "https")
    if result != "github,slack":
        echo("FAIL testFilterByProtocolBasic")
        return false
    echo("testFilterByProtocolBasic ok")
    return true

fn testFilterByProtocolNoMatch(): bool =
    let result = connectorsFilterByProtocol("github:https,slack:https", "ftp")
    if result != "":
        echo("FAIL testFilterByProtocolNoMatch")
        return false
    echo("testFilterByProtocolNoMatch ok")
    return true

fn testFilterByProtocolEmptyConnectors(): bool =
    let result = connectorsFilterByProtocol("", "https")
    if result != "":
        echo("FAIL testFilterByProtocolEmptyConnectors expected empty")
        return false
    echo("testFilterByProtocolEmptyConnectors ok")
    return true

fn testFilterByProtocolEmptyProtocol(): bool =
    let result = connectorsFilterByProtocol("github:https", "")
    if result != "":
        echo("FAIL testFilterByProtocolEmptyProtocol expected empty")
        return false
    echo("testFilterByProtocolEmptyProtocol ok")
    return true

fn testFilterByProtocolSingleMatch(): bool =
    let result = connectorsFilterByProtocol("github:https", "https")
    if result != "github":
        echo("FAIL testFilterByProtocolSingleMatch")
        return false
    echo("testFilterByProtocolSingleMatch ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testConnectorsCacheTtl(): allOk = false
    if !testConnectorDirectoryCacheKeyFieldCount(): allOk = false
    if !testConnectorDirectoryCacheContextFieldCount(): allOk = false
    if !testDirectoryListResponseFieldCount(): allOk = false
    if !testDirectoryAppFieldCount(): allOk = false
    if !testFilterByProtocolBasic(): allOk = false
    if !testFilterByProtocolNoMatch(): allOk = false
    if !testFilterByProtocolEmptyConnectors(): allOk = false
    if !testFilterByProtocolEmptyProtocol(): allOk = false
    if !testFilterByProtocolSingleMatch(): allOk = false
    if allOk:
        echo("rust_csg_connector_types_smoke ok")
        return 0
    echo("rust_csg_connector_types_smoke FAILED")
    return 1
