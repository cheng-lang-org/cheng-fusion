import cheng/codex/crates/goal/goal as goal

# ═══════════════════════════════════════════════════════════════════════════════
# Goal Extension — type definition constants smoke test
#
# Ported from codex-rs/ext/goal
# ═══════════════════════════════════════════════════════════════════════════════

fn testToolNameConstants(): bool =
    if goal.RustCsgGetGoalToolName != "get_goal": return false
    if goal.RustCsgCreateGoalToolName != "create_goal": return false
    if goal.RustCsgUpdateGoalToolName != "update_goal": return false
    echo("testToolNameConstants ok")
    return true

fn testGoalExtensionConfigFields(): bool =
    if goal.RustCsgGoalExtensionConfigFieldCount != 1: return false
    if goal.RustCsgGoalExtensionConfigField1 != "enabled": return false
    echo("testGoalExtensionConfigFields ok")
    return true

fn testGoalToolBackendMethods(): bool =
    if goal.RustCsgGoalToolBackendMethodCount != 3: return false
    if goal.RustCsgGoalToolBackendMethod1 != "get_goal": return false
    if goal.RustCsgGoalToolBackendMethod3 != "complete_goal": return false
    echo("testGoalToolBackendMethods ok")
    return true

fn testCreateGoalRequestFields(): bool =
    if goal.RustCsgCreateGoalRequestFieldCount != 2: return false
    if goal.RustCsgCreateGoalRequestField1 != "objective": return false
    if goal.RustCsgCreateGoalRequestField2 != "token_budget": return false
    echo("testCreateGoalRequestFields ok")
    return true

fn testInstallFnNames(): bool =
    if goal.RustCsgGoalInstallFnName != "install": return false
    if goal.RustCsgGoalInstallWithBackendFnName != "install_with_backend": return false
    echo("testInstallFnNames ok")
    return true

fn testValidateGoalSpec(): bool =
    if !goal.validateGoalSpec("# Implement Feature\n\nbody content"): return false
    if !goal.validateGoalSpec("## Sub Task\n\ndetails"): return false
    if goal.validateGoalSpec(""): return false
    if goal.validateGoalSpec("no heading"): return false
    if goal.validateGoalSpec("#"): return false
    echo("testValidateGoalSpec ok")
    return true

fn testParseGoalSpec(): bool =
    var title: str
    var okFlag: bool
    goal.parseGoalSpec("# Implement Feature", title, okFlag)
    if !okFlag: return false
    if title != "Implement Feature": return false
    goal.parseGoalSpec("## Sub Task", title, okFlag)
    if !okFlag: return false
    if title != "Sub Task": return false
    goal.parseGoalSpec("no heading", title, okFlag)
    if okFlag: return false
    goal.parseGoalSpec("", title, okFlag)
    if okFlag: return false
    echo("testParseGoalSpec ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testToolNameConstants(): allOk = false
    if !testGoalExtensionConfigFields(): allOk = false
    if !testGoalToolBackendMethods(): allOk = false
    if !testCreateGoalRequestFields(): allOk = false
    if !testInstallFnNames(): allOk = false
    if !testValidateGoalSpec(): allOk = false
    if !testParseGoalSpec(): allOk = false

    if allOk:
        echo("rust_csg_goal_smoke ok")
        return 0
    else:
        echo("rust_csg_goal_smoke FAILED")
        return 1