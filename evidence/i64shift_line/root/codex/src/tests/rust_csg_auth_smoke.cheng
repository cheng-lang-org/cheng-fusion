# Auth smoke test: PKCE generation + token storage roundtrip
import std/strings
import std/system
import cheng/codex/auth/pkce
import cheng/codex/auth/login

# ── C provider bindings for test ────────────────────────────────────────

@abi_internal
@importc("cheng_auth_mkdir")
fn authMkdir(path: str): int32

# ── Helpers ─────────────────────────────────────────────────────────────

fn isAlphaNum(c: char): bool =
    let cv: int32 = int32(c)
    if cv >= 65:
        if cv <= 90: return true
    if cv >= 97:
        if cv <= 122: return true
    if cv >= 48:
        if cv <= 57: return true
    return false

fn isBase64url(c: char): bool =
    if isAlphaNum(c): return true
    if c == '-': return true
    if c == '_': return true
    return false

fn assertEqStr(name: str, got: str, expected: str) =
    if got != expected:
        echo(strings.ConcatStr("FAIL: ", name))
        echo(strings.ConcatStr("  got:      ", got))
        echo(strings.ConcatStr("  expected: ", expected))
    assert(got == expected, name)

fn assertEqInt(name: str, got: int32, expected: int32) =
    if got != expected:
        echo(strings.ConcatStr("FAIL: ", name))
        echo(strings.ConcatStr("  got:      ", strings.IntToStr(got)))
        echo(strings.ConcatStr("  expected: ", strings.IntToStr(expected)))
    assert(got == expected, name)

fn assertTrue(name: str, cond: bool) =
    if !cond:
        echo(strings.ConcatStr("FAIL: ", name))
    assert(cond, name)

# ── Test 1: PKCE ────────────────────────────────────────────────────────

fn checkPkce() =
    echo("--- PKCE test ---")

    let codes: pkce.PkceCodes = pkce.GeneratePkce()

    let vlen: int32 = strings.Len(codes.codeVerifier)
    let clen: int32 = strings.Len(codes.codeChallenge)
    echo(strings.ConcatStr("  verifier length:  ", strings.IntToStr(vlen)))
    echo(strings.ConcatStr("  challenge length: ", strings.IntToStr(clen)))

    assertEqInt("codeVerifier length", vlen, 86)
    assertEqInt("codeChallenge length", clen, 43)

    var verifierOk: bool = true
    var i: int32 = 0
    while i < vlen:
        if !isBase64url(codes.codeVerifier[i]):
            verifierOk = false
            break
        i = i + 1
    assertTrue("codeVerifier base64url", verifierOk)

    var challengeOk: bool = true
    i = 0
    while i < clen:
        if !isBase64url(codes.codeChallenge[i]):
            challengeOk = false
            break
        i = i + 1
    assertTrue("codeChallenge base64url", challengeOk)

    echo("  PKCE values look valid")
    echo("")

# ── Test 2: Token storage roundtrip ─────────────────────────────────────

fn checkTokenStorage() =
    echo("--- Token storage test ---")

    let tmpRoot: str = getEnv("RUST_CSG_AUTH_TMPDIR")
    if tmpRoot == "":
        # Fallback — use /tmp (caller should set env var)
        assert(false, "RUST_CSG_AUTH_TMPDIR must be set")
        return

    authMkdir(tmpRoot)

    # Build expected auth.json path
    var authPath: str
    let rootLen: int32 = strings.Len(tmpRoot)
    if rootLen > 0:
        if tmpRoot[rootLen - 1] == '/':
            authPath = strings.ConcatStr(tmpRoot, "auth.json")
        else:
            authPath = strings.ConcatStr(strings.ConcatStr(tmpRoot, "/"), "auth.json")
    else:

    # Create test auth data
    var auth: login.AuthDotJson = login.NewAuthDotJson()
    auth.authMode = "Chatgpt"
    auth.accessToken = "test_access_token_123"
    auth.refreshToken = "test_refresh_token_456"
    auth.accountId = "test_account_789"
    auth.rawIdToken = "test_id_token.eyJzdWIiOiIxMjM0NTY3ODkwIn0.signature"

    # Save
    let saved: bool = login.SaveAuth(tmpRoot, auth)
    assertTrue("SaveAuth", saved)

    # Load back
    let loaded: login.AuthDotJson = login.LoadAuth(tmpRoot)
    assertTrue("AuthAvailable after save", login.AuthAvailable(loaded))
    assertEqStr("authMode", loaded.authMode, "Chatgpt")
    assertEqStr("accessToken", loaded.accessToken, "test_access_token_123")
    assertEqStr("refreshToken", loaded.refreshToken, "test_refresh_token_456")
    assertEqStr("accountId", loaded.accountId, "test_account_789")
    assertEqStr("rawIdToken", loaded.rawIdToken,
                "test_id_token.eyJzdWIiOiIxMjM0NTY3ODkwIn0.signature")

    # Verify file content
    let fileContent: str = login.authReadFile(authPath)
    assertTrue("auth.json should contain access_token",
               strings.StrContains(fileContent, "test_access_token_123"))
    assertTrue("auth.json should contain Chatgpt",
               strings.StrContains(fileContent, "Chatgpt"))

    # Test Logout
    let removed: bool = login.Logout(tmpRoot)
    assertTrue("Logout should return true", removed)

    # Verify file gone
    let afterLogout: login.AuthDotJson = login.LoadAuth(tmpRoot)
    assertTrue("Auth should not be available after logout",
               !login.AuthAvailable(afterLogout))

    echo("  Token storage roundtrip OK")
    echo("")

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    checkPkce()
    checkTokenStorage()
    echo("rust_csg_auth_smoke ok")
    return 0
