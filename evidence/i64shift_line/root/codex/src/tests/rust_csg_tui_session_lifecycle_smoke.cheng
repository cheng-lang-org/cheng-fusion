import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/session_lifecycle as lifecycle

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strings.strContains(text, needle):
        return 0
    echo(strutil.Join(["FAIL missing ", label, ": ", needle], ""))
    echo(text)
    return 1

fn CheckNotContains(text: str, needle: str, label: str): int32 =
    if !strings.strContains(text, needle):
        return 0
    echo(strutil.Join(["FAIL unexpected ", label, ": ", needle], ""))
    echo(text)
    return 1

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn FillBaseConfig(config: var lifecycle.RustCsgTuiThreadHandoffConfig) =
    config.cwd = "/repo/current"
    config.model = "gpt-5.2"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = "[\"/repo/current\",\"/repo/cache\"]"
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.sandboxJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.permissionsJson = "\":workspace\""
    config.configJson = lifecycle.RustCsgTuiThreadHandoffConfigOverridesJson("high",
                                                                             "detailed",
                                                                             "medium",
                                                                             "pragmatic",
                                                                             "enabled",
                                                                             true)
    config.baseInstructions = "base override"
    config.developerInstructions = "developer override"
    config.ephemeral = true

fn main(): int32 =
    var failures: int32
    var config: lifecycle.RustCsgTuiThreadHandoffConfig
    FillBaseConfig(config)

    let embeddedStart = lifecycle.RustCsgTuiThreadHandoffBuildStartParams(
        lifecycle.RustCsgTuiThreadParamsModeEmbedded, "", config)
    failures = failures + CheckBool(embeddedStart.ok, true, "embedded start ok")
    failures = failures + CheckContains(embeddedStart.json, "\"model\":\"gpt-5.2\"", "embedded start model")
    failures = failures + CheckContains(embeddedStart.json, "\"modelProvider\":\"openai\"", "embedded start modelProvider")
    failures = failures + CheckContains(embeddedStart.json, "\"cwd\":\"/repo/current\"", "embedded start cwd")
    failures = failures + CheckContains(embeddedStart.json, "\"runtimeWorkspaceRoots\":[\"/repo/current\",\"/repo/cache\"]", "embedded start roots")
    failures = failures + CheckContains(embeddedStart.json, "\"permissions\":\":workspace\"", "embedded start permissions")
    failures = failures + CheckContains(embeddedStart.json, "\"ephemeral\":true", "embedded start ephemeral")
    failures = failures + CheckContains(embeddedStart.json, "\"persistExtendedHistory\":true", "embedded start full history")
    failures = failures + CheckNotContains(embeddedStart.json, "\"threadId\"", "embedded start no threadId")
    failures = failures + CheckNotContains(embeddedStart.json, "\"sandbox\"", "embedded start omits sandbox")

    let embeddedResume = lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(
        "thread-embedded", lifecycle.RustCsgTuiThreadParamsModeEmbedded, "", config)
    failures = failures + CheckBool(embeddedResume.ok, true, "embedded resume ok")
    failures = failures + CheckContains(embeddedResume.json, "\"threadId\":\"thread-embedded\"", "embedded resume threadId")
    failures = failures + CheckContains(embeddedResume.json, "\"model\":\"gpt-5.2\"", "embedded resume model")
    failures = failures + CheckContains(embeddedResume.json, "\"modelProvider\":\"openai\"", "embedded resume modelProvider")
    failures = failures + CheckContains(embeddedResume.json, "\"serviceTier\":\"flex\"", "embedded resume serviceTier")
    failures = failures + CheckContains(embeddedResume.json, "\"cwd\":\"/repo/current\"", "embedded resume cwd")
    failures = failures + CheckContains(embeddedResume.json, "\"runtimeWorkspaceRoots\":[\"/repo/current\",\"/repo/cache\"]", "embedded resume roots")
    failures = failures + CheckContains(embeddedResume.json, "\"approvalPolicy\":\"on-request\"", "embedded resume approval")
    failures = failures + CheckContains(embeddedResume.json, "\"approvalsReviewer\":\"user\"", "embedded resume reviewer")
    failures = failures + CheckContains(embeddedResume.json, "\"permissions\":\":workspace\"", "embedded resume permissions")
    failures = failures + CheckContains(embeddedResume.json, "\"model_reasoning_effort\":\"high\"", "embedded resume reasoning")
    failures = failures + CheckContains(embeddedResume.json, "\"personality\":\"pragmatic\"", "embedded resume personality")
    failures = failures + CheckContains(embeddedResume.json, "\"web_search\":\"enabled\"", "embedded resume web search")
    failures = failures + CheckContains(embeddedResume.json, "\"bypass_hook_trust\":true", "embedded resume bypass")
    failures = failures + CheckContains(embeddedResume.json, "\"persistExtendedHistory\":true", "embedded resume full history")
    failures = failures + CheckNotContains(embeddedResume.json, "\"sandbox\"", "embedded resume omits sandbox")
    failures = failures + CheckNotContains(embeddedResume.json, "\"threadSource\"", "embedded resume omits threadSource")

    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalArray(embeddedResume.json, "runtimeWorkspaceRoots"),
                                     "[\"/repo/current\",\"/repo/cache\"]",
                                     "resume roots wire")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalValueRaw(embeddedResume.json, "permissions"),
                                     "\":workspace\"",
                                     "resume permissions wire")

    let remoteResume = lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(
        "thread-remote", lifecycle.RustCsgTuiThreadParamsModeRemote, "", config)
    failures = failures + CheckBool(remoteResume.ok, true, "remote resume ok")
    failures = failures + CheckContains(remoteResume.json, "\"threadId\":\"thread-remote\"", "remote resume threadId")
    failures = failures + CheckContains(remoteResume.json, "\"runtimeWorkspaceRoots\":[\"/repo/current\",\"/repo/cache\"]", "remote resume roots")
    failures = failures + CheckContains(remoteResume.json, "\"sandbox\":{\"type\":\"workspaceWrite\"", "remote resume sandbox")
    failures = failures + CheckNotContains(remoteResume.json, "\"cwd\"", "remote resume no cwd without override")
    failures = failures + CheckNotContains(remoteResume.json, "\"modelProvider\"", "remote resume no modelProvider")
    failures = failures + CheckNotContains(remoteResume.json, "\"permissions\"", "remote resume no permissions")

    let remoteResumeWithCwd = lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(
        "thread-remote-cwd", lifecycle.RustCsgTuiThreadParamsModeRemote, "/remote/workspace", config)
    failures = failures + CheckBool(remoteResumeWithCwd.ok, true, "remote resume cwd ok")
    failures = failures + CheckContains(remoteResumeWithCwd.json, "\"cwd\":\"/remote/workspace\"", "remote resume cwd override")

    let remoteStart = lifecycle.RustCsgTuiThreadHandoffBuildStartParams(
        lifecycle.RustCsgTuiThreadParamsModeRemote, "/remote/start", config)
    failures = failures + CheckBool(remoteStart.ok, true, "remote start ok")
    failures = failures + CheckContains(remoteStart.json, "\"cwd\":\"/remote/start\"", "remote start cwd")
    failures = failures + CheckContains(remoteStart.json, "\"sandbox\":{\"type\":\"workspaceWrite\"", "remote start sandbox")
    failures = failures + CheckNotContains(remoteStart.json, "\"modelProvider\"", "remote start no modelProvider")
    failures = failures + CheckNotContains(remoteStart.json, "\"permissions\"", "remote start no permissions")

    let embeddedFork = lifecycle.RustCsgTuiThreadHandoffBuildForkParams(
        "thread-fork", lifecycle.RustCsgTuiThreadParamsModeEmbedded, "", config)
    failures = failures + CheckBool(embeddedFork.ok, true, "embedded fork ok")
    failures = failures + CheckContains(embeddedFork.json, "\"threadId\":\"thread-fork\"", "embedded fork threadId")
    failures = failures + CheckContains(embeddedFork.json, "\"runtimeWorkspaceRoots\":[\"/repo/current\",\"/repo/cache\"]", "embedded fork roots")
    failures = failures + CheckContains(embeddedFork.json, "\"baseInstructions\":\"base override\"", "embedded fork base instructions")
    failures = failures + CheckContains(embeddedFork.json, "\"developerInstructions\":\"developer override\"", "embedded fork developer instructions")
    failures = failures + CheckContains(embeddedFork.json, "\"threadSource\":\"user\"", "embedded fork thread source")
    failures = failures + CheckContains(embeddedFork.json, "\"ephemeral\":true", "embedded fork ephemeral")
    failures = failures + CheckContains(embeddedFork.json, "\"permissions\":\":workspace\"", "embedded fork permissions")
    failures = failures + CheckContains(embeddedFork.json, "\"persistExtendedHistory\":true", "embedded fork full history")
    failures = failures + CheckNotContains(embeddedFork.json, "\"sandbox\"", "embedded fork omits sandbox")

    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalArray(embeddedFork.json, "runtimeWorkspaceRoots"),
                                     "[\"/repo/current\",\"/repo/cache\"]",
                                     "fork roots wire")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(embeddedFork.json, "threadSource"),
                                     "user",
                                     "fork thread source wire")

    let remoteFork = lifecycle.RustCsgTuiThreadHandoffBuildForkParams(
        "thread-remote-fork", lifecycle.RustCsgTuiThreadParamsModeRemote, "/remote/fork", config)
    failures = failures + CheckBool(remoteFork.ok, true, "remote fork ok")
    failures = failures + CheckContains(remoteFork.json, "\"cwd\":\"/remote/fork\"", "remote fork cwd")
    failures = failures + CheckContains(remoteFork.json, "\"sandbox\":{\"type\":\"workspaceWrite\"", "remote fork sandbox")
    failures = failures + CheckNotContains(remoteFork.json, "\"modelProvider\"", "remote fork no modelProvider")
    failures = failures + CheckNotContains(remoteFork.json, "\"permissions\"", "remote fork no permissions")

    let missingThread = lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(
        "", lifecycle.RustCsgTuiThreadParamsModeEmbedded, "", config)
    failures = failures + CheckBool(missingThread.ok, false, "missing thread fails")
    failures = failures + CheckEqStr(missingThread.error, "threadId is required", "missing thread error")

    let invalidMode = lifecycle.RustCsgTuiThreadHandoffBuildForkParams(
        "thread-invalid", "local", "", config)
    failures = failures + CheckBool(invalidMode.ok, false, "invalid mode fails")
    failures = failures + CheckEqStr(invalidMode.error, "unsupported thread params mode: local", "invalid mode error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_lifecycle_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_lifecycle_smoke ok")
    return 0
