# Process execution smoke test — spawn real processes, verify output.
#
# Tests:
#   1. Spawn "echo" with arg "hello"  → stdout should contain "hello"
#   2. Spawn "ls" with no args        → stdout should be non-empty
#   3. Spawn nonexistent command      → spawn should return error

import std/strings
import std/strutils as strutil
import cheng/codex/std/process

# ── Test helpers ────────────────────────────────────────────────────────

fn check(result: process.ProcessResult, label: str): bool =
    if !result.ok:
        echo(strutil.Join([label, " FAIL: ", result.error], ""))
        return false
    echo(strutil.Join([label, " ok (pid=", strings.IntToStr(result.pid),
                       " exit=", strings.IntToStr(result.exitCode),
                       " stdout=", strings.IntToStr(strings.Len(result.stdout)),
                       " stderr=", strings.IntToStr(strings.Len(result.stderr)), ")"], ""))
    return true

fn checkStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=\"", expected, "\" got=\"", got, "\""], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkNonEmpty(got: str, label: str): bool =
    if strings.Len(got) <= 0:
        echo(strutil.Join([label, " FAIL: expected non-empty string, got empty"], ""))
        return false
    echo(strutil.Join([label, " ok (len=", strings.IntToStr(strings.Len(got)), ")"], ""))
    return true

fn checkExitCode(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected exit code ", strings.IntToStr(expected),
                           " got ", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok (exit=", strings.IntToStr(got), ")"], ""))
    return true

fn checkFd(got: int32, label: str): bool =
    if got < 0:
        echo(strutil.Join([label, " FAIL: expected valid fd got ", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok (fd=", strings.IntToStr(got), ")"], ""))
    return true

# ── Test 1: Spawn "echo hello" ─────────────────────────────────────────
# Verify stdout contains "hello" and exit code is 0.

fn testEchoHello(): bool =
    var ok: bool = true

    # NOTE: command="echo" is the program; args are just the extra arguments
    var args: str[]
    add(args, "hello")

    var env: str[]

    var result: process.ProcessResult = process.ProcessSpawn("echo", args, "", env)
    if !check(result, "echo_hello_spawn"):
        return false

    # Verify exit code
    if !checkExitCode(result.exitCode, 0, "echo_hello_exit"):
        ok = false

    # Verify stdout contains "hello" (adds a newline)
    var stdoutTrimmed: str = result.stdout
    # Check prefix "hello"
    if strings.HasPrefix(stdoutTrimmed, "hello"):
        echo("echo_hello_stdout ok")
    else:
        echo(strutil.Join(["echo_hello_stdout FAIL: expected hello, got=\"", stdoutTrimmed, "\""], ""))
        ok = false

    return ok

# ── Test 2: Spawn "ls" ────────────────────────────────────────────────
# Verify non-empty stdout and exit code 0.

fn testLs(): bool =
    var ok: bool = true

    var args: str[]
    # Just "ls" with no extra args — command itself is the program name

    var env: str[]

    var result: process.ProcessResult = process.ProcessSpawn("ls", args, "", env)
    if !check(result, "ls_spawn"):
        return false

    # Verify exit code
    if !checkExitCode(result.exitCode, 0, "ls_exit"):
        ok = false

    # Verify non-empty stdout
    if !checkNonEmpty(result.stdout, "ls_stdout"):
        ok = false

    return ok

# ── Test 3: Spawn nonexistent command ──────────────────────────────────
# Verify error is returned (spawn fails).

fn testNonexistent(): bool =
    var args: str[]
    add(args, "nonexistent_cmd_xyzzy")

    var env: str[]

    var result: process.ProcessResult = process.ProcessSpawn("nonexistent_cmd_xyzzy", args, "", env)

    # The spawn should return ok=true but exit code should be 127 (command not found)
    # or the spawn itself might return error depending on the C provider behavior
    if result.ok:
        # Spawn succeeded but exec failed in child — child exits with 127
        if result.exitCode == 127 || result.exitCode == -1:
            echo(strutil.Join(["nonexistent_spawn ok (exit=", strings.IntToStr(result.exitCode), ")"], ""))
            return true
        else:
            echo(strutil.Join(["nonexistent_spawn FAIL: unexpected exit code ", strings.IntToStr(result.exitCode)], ""))
            return false
    else:
        # Spawn immediately failed (fork/exec failed entirely)
        echo(strutil.Join(["nonexistent_spawn ok (error=\"", result.error, "\")"], ""))
        return true

# ── Test 4: Raw spawn exposes stdout/stderr fds ────────────────────────
# Verify the low-level handle preserves stderr separately. This is the
# transport primitive required by app-server command/exec outputDelta.

fn testRawSpawnStdoutStderrHandles(): bool =
    var ok: bool = true

    var args: str[]
    add(args, "-c")
    add(args, "printf out; printf err >&2")

    var env: str[]
    var handle: process.ProcessHandle = process.ProcessSpawnRaw("/bin/sh", args, "", env)
    if !handle.ok:
        echo(strutil.Join(["raw_spawn_handle FAIL: ", handle.error], ""))
        return false

    if !checkFd(handle.stdinFd, "raw_spawn_stdin_fd"):
        ok = false
    if !checkFd(handle.stdoutFd, "raw_spawn_stdout_fd"):
        ok = false
    if !checkFd(handle.stderrFd, "raw_spawn_stderr_fd"):
        ok = false

    var stdoutText: str = process.ProcessReadFdBlocking(handle.stdoutFd, 500)
    var stderrText: str = process.ProcessReadFdBlocking(handle.stderrFd, 500)
    var exitCode: int32 = process.ProcessWait(handle.pid)

    if !checkStr(stdoutText, "out", "raw_spawn_stdout_text"):
        ok = false
    if !checkStr(stderrText, "err", "raw_spawn_stderr_text"):
        ok = false
    if !checkExitCode(exitCode, 0, "raw_spawn_exit"):
        ok = false

    return ok

fn testRawSpawnTryWaitKeepsFds(): bool =
    var ok: bool = true
    var args: str[]
    add(args, "-c")
    add(args, "sleep 1; printf done")

    var env: str[]
    var handle: process.ProcessHandle = process.ProcessSpawnRaw("/bin/sh", args, "", env)
    if !handle.ok:
        echo(strutil.Join(["raw_spawn_try_wait_handle FAIL: ", handle.error], ""))
        return false

    process.ProcessCloseFd(handle.stdinFd)
    let firstPoll = process.ProcessTryWait(handle.pid)
    if !checkExitCode(firstPoll, -2, "raw_spawn_try_wait_running"):
        ok = false

    let stdoutText = process.ProcessReadFdBlocking(handle.stdoutFd, 1500)
    if !checkStr(stdoutText, "done", "raw_spawn_try_wait_stdout"):
        ok = false

    var exitCode = process.ProcessTryWait(handle.pid)
    if exitCode == -2:
        exitCode = process.ProcessWait(handle.pid)
    else:
        let waited = process.ProcessWait(handle.pid)
        if waited != exitCode:
            echo(strutil.Join(["raw_spawn_try_wait_cached_exit FAIL: expected ",
                               strings.IntToStr(exitCode), " got=", strings.IntToStr(waited)], ""))
            ok = false
    if !checkExitCode(exitCode, 0, "raw_spawn_try_wait_exit"):
        ok = false
    return ok

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testEchoHello():
        allOk = false
    if !testLs():
        allOk = false
    if !testNonexistent():
        allOk = false
    if !testRawSpawnStdoutStderrHandles():
        allOk = false
    if !testRawSpawnTryWaitKeepsFds():
        allOk = false

    if allOk:
        echo("rust_csg_process_smoke ok")
        return 0
    else:
        echo("rust_csg_process_smoke FAILED")
        return 1
