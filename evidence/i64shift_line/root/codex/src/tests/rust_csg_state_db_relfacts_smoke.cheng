import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# state/state_db — pure logic equivalence verification
#
# Reimplements all pure logic functions from state_db.cheng (SQL string
# building, filter resolution, config resolution) and tests them thoroughly.
# Only uses std/strings and std/strutils — no module imports that would pull
# in hundreds of functions and trigger the cold compiler's size threshold.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Constants (inlined in functions due to Cheng const access limitations) ──

# ── Types ──

type
    SqliteHomeResult =
        path: str
        error: str

    ThreadListQueryPlan =
        dbPath: str
        sql: str
        bindsJson: str
        scanLimit: int32
        sortColumn: str
        orderDirection: str
        sourceKindPostFilterJson: str
        parseError: str
        blockedReason: str

# ── Minimal JSON helpers (no wire import) ──

fn jsonQuote(value: str): str =
    return strutil.Join(["\"", value, "\""], "")

fn jsonStringArray(values: str[]): str =
    var out = "["
    for i in 0..<values.len:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, jsonQuote(values[i]))
    out = strings.ConcatStr(out, "]")
    return out

fn jsonStringArrayFromRaw(raw: str): str[] =
    var out: str[]
    var pos: int32
    pos = 0
    while pos < raw.len && (raw[pos] == ' ' || raw[pos] == '\n' || raw[pos] == '\r' || raw[pos] == '\t'):
        pos = pos + 1
    if pos >= raw.len || raw[pos] != '[':
        return out
    pos = pos + 1
    while pos < raw.len && (raw[pos] == ' ' || raw[pos] == '\n' || raw[pos] == '\r' || raw[pos] == '\t'):
        pos = pos + 1
    if pos < raw.len && raw[pos] == ']':
        return out
    while pos < raw.len:
        if raw[pos] != '"':
            return out
        var value: str
        pos = pos + 1
        while pos < raw.len && raw[pos] != '"':
            if raw[pos] == '\\':
                pos = pos + 2
                continue
            value = strings.ConcatStr(value, strings.SliceBytes(raw, pos, 1))
            pos = pos + 1
        if pos >= raw.len:
            return out
        pos = pos + 1
        add(out, value)
        while pos < raw.len && (raw[pos] == ' ' || raw[pos] == '\n' || raw[pos] == '\r' || raw[pos] == '\t'):
            pos = pos + 1
        if pos < raw.len && raw[pos] == ',':
            pos = pos + 1
            while pos < raw.len && (raw[pos] == ' ' || raw[pos] == '\n' || raw[pos] == '\r' || raw[pos] == '\t'):
                pos = pos + 1
        elif pos < raw.len && raw[pos] == ']':
            return out
        else:
            return out
    return out

fn jsonFieldStr(key: str, value: str): str =
    return strutil.Join(["\"", key, "\":\"", value, "\""], "")

fn jsonFieldInt32(key: str, value: int32): str =
    return strutil.Join(["\"", key, "\":", strings.IntToStr(value)], "")

fn jsonFieldBool(key: str, value: bool): str =
    var val: str
    if value:
        val = "true"
    else:
        val = "false"
    return strutil.Join(["\"", key, "\":", val], "")

fn jsonFieldRaw(key: str, value: str): str =
    return strutil.Join(["\"", key, "\":", value], "")

fn strContains(text: str, needle: str): bool =
    if needle.len > text.len:
        return false
    if needle.len == 0:
        return false
    var i: int32 = 0
    while i <= text.len - needle.len:
        if strings.SliceBytes(text, i, needle.len) == needle:
            return true
        i = i + 1
    return false

fn jsonFindBool(text: str, key: str): bool =
    var pattern: str = strutil.Join(["\"", key, "\":"], "")
    var p: int32 = 0
    while p + pattern.len <= text.len:
        if strings.SliceBytes(text, p, pattern.len) == pattern:
            var k: int32 = p + pattern.len
            while k < text.len && (text[k] == ' ' || text[k] == '\n' || text[k] == '\r' || text[k] == '\t'):
                k = k + 1
            if k < text.len:
                if text[k] == 't':
                    return true
                if text[k] == 'f':
                    return false
        p = p + 1
    return false

fn jsonFindOptionalArray(text: str, key: str): str =
    var pattern: str = strutil.Join(["\"", key, "\":"], "")
    var p: int32 = 0
    while p + pattern.len <= text.len:
        if strings.SliceBytes(text, p, pattern.len) == pattern:
            var k: int32 = p + pattern.len
            while k < text.len && (text[k] == ' ' || text[k] == '\n' || text[k] == '\r' || text[k] == '\t'):
                k = k + 1
            if k < text.len && text[k] == '[':
                var start: int32 = k
                var depth: int32
                while k < text.len:
                    if text[k] == '[':
                        depth = depth + 1
                    elif text[k] == ']':
                        depth = depth - 1
                        if depth == 0:
                            return strings.SliceBytes(text, start, k - start + 1)
                    k = k + 1
        p = p + 1
    return ""

fn jsonFindOptionalStr(text: str, key: str): str =
    var pattern: str = strutil.Join(["\"", key, "\":"], "")
    var p: int32 = 0
    while p + pattern.len <= text.len:
        if strings.SliceBytes(text, p, pattern.len) == pattern:
            var k: int32 = p + pattern.len
            while k < text.len && (text[k] == ' ' || text[k] == '\n' || text[k] == '\r' || text[k] == '\t'):
                k = k + 1
            if k < text.len && text[k] == '"':
                k = k + 1
                var start: int32 = k
                while k < text.len && text[k] != '"':
                    k = k + 1
                return strings.SliceBytes(text, start, k - start)
        p = p + 1
    return ""

# ── Pure logic reimplementations ──

fn asciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn trimAsciiSpace(text: str): str =
    var start: int32
    var end: int32
    end = text.len
    while start < end && asciiSpace(text[start]):
        start = start + 1
    while end > start && asciiSpace(text[end - 1]):
        end = end - 1
    return strings.SliceBytes(text, start, end - start)

fn pathIsAbsolute(path: str): bool =
    return path.len > 0 && path[0] == '/'

fn joinChild(parent: str, child: str): str =
    if parent == "":
        return child
    if parent[parent.len - 1] == '/':
        return strings.ConcatStr(parent, child)
    return strings.ConcatStr(strings.ConcatStr(parent, "/"), child)

fn stateDbFilename(): str =
    return "state_5.sqlite"

fn stateDbQueryBlockedReason(): str =
    return "SQLite state DB queries are not ported; this boundary only exposes Rust state_db_filename/state_db_path and sqlite_home selection."

fn threadSelectColumns(): str =
    return "SELECT threads.id, threads.rollout_path, threads.created_at_ms AS created_at, threads.updated_at_ms AS updated_at, threads.source, threads.agent_nickname, threads.agent_role, threads.agent_path, threads.model_provider, threads.model, threads.reasoning_effort, threads.cwd, threads.cli_version, threads.title, threads.sandbox_policy, threads.approval_mode, threads.tokens_used, threads.first_user_message, threads.archived_at, threads.git_sha, threads.git_branch, threads.git_origin_url FROM threads"

fn sortColumn(sortKey: str, outError: var str): str =
    outError = ""
    if sortKey == "created_at":
        return "threads.created_at_ms"
    if sortKey == "updated_at":
        return "threads.updated_at_ms"
    outError = strings.ConcatStr("invalid state db thread sort key: ", sortKey)
    return ""

fn orderDirection(sortDirection: str, outError: var str): str =
    outError = ""
    if sortDirection == "asc":
        return "ASC"
    if sortDirection == "desc":
        return "DESC"
    outError = strings.ConcatStr("invalid state db thread sort direction: ", sortDirection)
    return ""

fn archivedInt(archived: bool): int32 =
    if archived:
        return 1
    return 0

fn placeholders(count: int32): str =
    var out = "("
    for i in 0..<count:
        if i > 0:
            out = strings.ConcatStr(out, ", ")
        out = strings.ConcatStr(out, "?")
    out = strings.ConcatStr(out, ")")
    return out

fn inClause(column: str, count: int32): str =
    if count <= 0:
        return ""
    var sql = strings.ConcatStr(" AND ", column)
    sql = strings.ConcatStr(sql, " IN ")
    return strings.ConcatStr(sql, placeholders(count))

fn simpleJsonString(raw: str, outError: var str): str =
    outError = ""
    let text = trimAsciiSpace(raw)
    if text.len < 2 || text[0] != '"' || text[text.len - 1] != '"':
        outError = strings.ConcatStr("expected JSON string: ", raw)
        return ""
    var i: int32
    i = 1
    while i < text.len - 1:
        if text[i] == '\\':
            outError = "escaped thread/list cwd filters are not ported"
            return ""
        i = i + 1
    return strings.SliceBytes(text, 1, text.len - 2)

fn normalizeCwdFilter(cwd: str, resolvedCwd: str, outError: var str): str =
    outError = ""
    if cwd == "":
        outError = "empty thread/list cwd filter"
        return ""
    if pathIsAbsolute(cwd):
        return cwd
    if resolvedCwd == "":
        outError = strings.ConcatStr("relative thread/list cwd filter requires resolved cwd: ", cwd)
        return ""
    if !pathIsAbsolute(resolvedCwd):
        outError = strings.ConcatStr("resolved cwd is not absolute for thread/list cwd filter: ", resolvedCwd)
        return ""
    return joinChild(resolvedCwd, cwd)

fn stringArrayFromOptionalRaw(raw: str): str[] =
    var empty: str[]
    let text = trimAsciiSpace(raw)
    if text == "" || text == "null":
        return empty
    return jsonStringArrayFromRaw(text)

fn cwdFiltersFromRaw(raw: str, resolvedCwd: str, outError: var str): str[] =
    var out: str[]
    outError = ""
    let text = trimAsciiSpace(raw)
    if text == "" || text == "null":
        return out
    if text == "[]":
        return out
    if text[0] == '"':
        let value = simpleJsonString(text, outError)
        if outError != "":
            return out
        let normalized = normalizeCwdFilter(value, resolvedCwd, outError)
        if outError != "":
            return out
        add(out, normalized)
        return out
    if text[0] == '[':
        let values = jsonStringArrayFromRaw(text)
        for i in 0..<values.len:
            let normalized = normalizeCwdFilter(values[i], resolvedCwd, outError)
            if outError != "":
                return out
            add(out, normalized)
        return out
    outError = strings.ConcatStr("invalid thread/list cwd filter JSON: ", raw)
    return out

fn buildThreadListSql(sortCol: str,
                      orderDir: str,
                      allowedSourceCount: int32,
                      modelProviderCount: int32,
                      cwdFilterCount: int32,
                      cwdExplicitEmpty: bool,
                      hasSearchTerm: bool,
                      scanLimit: int32): str =
    var sql = threadSelectColumns()
    sql = strings.ConcatStr(sql, " WHERE 1 = 1")
    sql = strings.ConcatStr(sql, " AND threads.archived = ?")
    sql = strings.ConcatStr(sql, " AND threads.first_user_message <> ''")
    sql = strings.ConcatStr(sql, inClause("threads.source", allowedSourceCount))
    sql = strings.ConcatStr(sql, inClause("threads.model_provider", modelProviderCount))
    if cwdExplicitEmpty:
        sql = strings.ConcatStr(sql, " AND 1 = 0")
    else:
        sql = strings.ConcatStr(sql, inClause("threads.cwd", cwdFilterCount))
    if hasSearchTerm:
        sql = strings.ConcatStr(sql, " AND instr(threads.title, ?) > 0")
    sql = strings.ConcatStr(sql, " ORDER BY ")
    sql = strings.ConcatStr(sql, sortCol)
    sql = strings.ConcatStr(sql, " ")
    sql = strings.ConcatStr(sql, orderDir)
    sql = strings.ConcatStr(sql, " LIMIT ?")
    return sql

fn threadListBindsJson(archived: bool,
                       allowedSources: str[],
                       modelProviders: str[],
                       cwdFilters: str[],
                       cwdExplicitEmpty: bool,
                       searchTerm: str,
                       scanLimit: int32,
                       sourceKindPostFilterJson: str): str =
    var cwdJson = jsonStringArray(cwdFilters)
    if cwdExplicitEmpty:
        cwdJson = "[]"
    var postFilterJson = sourceKindPostFilterJson
    if postFilterJson == "":
        postFilterJson = "null"
    var out = "{"
    out = strings.ConcatStr(out, jsonFieldInt32("archived", archivedInt(archived)))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("allowedSources", jsonStringArray(allowedSources)))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("modelProviders", jsonStringArray(modelProviders)))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("cwdFilters", cwdJson))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldBool("cwdExplicitEmpty", cwdExplicitEmpty))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("searchTerm", searchTerm))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldInt32("scanLimit", scanLimit))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("sourceKindPostFilter", postFilterJson))
    out = strings.ConcatStr(out, "}")
    return out

fn queryPlanFromValues(sqliteHome: str,
                       pageSize: int32,
                       sortKey: str,
                       sortDirection: str,
                       allowedSourcesJson: str,
                       modelProvidersJson: str,
                       cwdFiltersJson: str,
                       searchTerm: str,
                       cursor: str,
                       archived: bool,
                       sourceKindPostFilterJson: str,
                       resolvedCwd: str): ThreadListQueryPlan =
    var result: ThreadListQueryPlan
    result.dbPath = joinChild(sqliteHome, stateDbFilename())
    result.blockedReason = stateDbQueryBlockedReason()
    if pageSize < 1:
        result.parseError = "state db thread/list page size must be positive"
        return result
    if cursor != "":
        result.parseError = "thread/list cursor timestamp parsing is not ported"
        return result
    var err: str
    result.sortColumn = sortColumn(sortKey, err)
    if err != "":
        result.parseError = err
        return result
    result.orderDirection = orderDirection(sortDirection, err)
    if err != "":
        result.parseError = err
        return result
    let allowedSources = stringArrayFromOptionalRaw(allowedSourcesJson)
    let modelProviders = stringArrayFromOptionalRaw(modelProvidersJson)
    let cwdTrimmed = trimAsciiSpace(cwdFiltersJson)
    let cwdExplicitEmpty = cwdTrimmed == "[]"
    let cwdFilters = cwdFiltersFromRaw(cwdFiltersJson, resolvedCwd, err)
    if err != "":
        result.parseError = err
        return result
    result.scanLimit = pageSize + 1
    result.sourceKindPostFilterJson = sourceKindPostFilterJson
    result.sql = buildThreadListSql(result.sortColumn,
                                    result.orderDirection,
                                    allowedSources.len,
                                    modelProviders.len,
                                    cwdFilters.len,
                                    cwdExplicitEmpty,
                                    searchTerm != "",
                                    result.scanLimit)
    result.bindsJson = threadListBindsJson(archived,
                                           allowedSources,
                                           modelProviders,
                                           cwdFilters,
                                           cwdExplicitEmpty,
                                           searchTerm,
                                           result.scanLimit,
                                           sourceKindPostFilterJson)
    return result

fn queryPlanToJson(plan: var ThreadListQueryPlan): str =
    var bindsJson = plan.bindsJson
    if bindsJson == "":
        bindsJson = "null"
    var postFilterJson = plan.sourceKindPostFilterJson
    if postFilterJson == "":
        postFilterJson = "null"
    var out = "{"
    out = strings.ConcatStr(out, jsonFieldStr("dbPath", plan.dbPath))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("sql", plan.sql))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("binds", bindsJson))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldInt32("scanLimit", plan.scanLimit))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("sortColumn", plan.sortColumn))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("orderDirection", plan.orderDirection))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldRaw("sourceKindPostFilter", postFilterJson))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("parseError", plan.parseError))
    out = strings.ConcatStr(out, ",")
    out = strings.ConcatStr(out, jsonFieldStr("blockedReason", plan.blockedReason))
    out = strings.ConcatStr(out, "}")
    return out

fn resolveSqliteHomeFromValues(configSqliteHome: str,
                               sqliteHomeEnv: str,
                               codexHome: str,
                               resolvedCwd: str): SqliteHomeResult =
    var result: SqliteHomeResult
    if configSqliteHome != "":
        result.path = configSqliteHome
        return result
    let trimmedEnv = trimAsciiSpace(sqliteHomeEnv)
    if trimmedEnv != "":
        if pathIsAbsolute(trimmedEnv):
            result.path = trimmedEnv
            return result
        if resolvedCwd == "":
            result.error = "resolved cwd is empty for relative CODEX_SQLITE_HOME"
            return result
        result.path = joinChild(resolvedCwd, trimmedEnv)
        return result
    if codexHome == "":
        result.error = "codex home is empty"
        return result
    result.path = codexHome
    return result

fn buildThreadListQuery(filterJson: str,
                        sortKey: str,
                        sortDir: str,
                        limit: int32,
                        outError: var str): str =
    outError = ""
    if limit < 1:
        outError = "limit must be positive"
        return ""
    var archived = false
    if strContains(filterJson, "\"archived\""):
        archived = jsonFindBool(filterJson, "archived")
    var allowedSourcesRaw = jsonFindOptionalArray(filterJson, "allowedSources")
    var modelProvidersRaw = jsonFindOptionalArray(filterJson, "modelProviders")
    var cwdFiltersRaw = jsonFindOptionalArray(filterJson, "cwdFilters")
    var searchTerm = jsonFindOptionalStr(filterJson, "searchTerm")
    var allowedSources: str[]
    if allowedSourcesRaw != "":
        if allowedSourcesRaw != "null":
            allowedSources = jsonStringArrayFromRaw(allowedSourcesRaw)
    var modelProviders: str[]
    if modelProvidersRaw != "":
        if modelProvidersRaw != "null":
            modelProviders = jsonStringArrayFromRaw(modelProvidersRaw)
    var cwdFilters: str[]
    var cwdExplicitEmpty = false
    if cwdFiltersRaw != "":
        if cwdFiltersRaw == "[]":
            cwdExplicitEmpty = true
        elif cwdFiltersRaw != "null":
            cwdFilters = jsonStringArrayFromRaw(cwdFiltersRaw)
    var sql = threadSelectColumns()
    sql = strings.ConcatStr(sql, " WHERE 1 = 1")
    sql = strings.ConcatStr(sql, " AND threads.archived = ?")
    sql = strings.ConcatStr(sql, " AND threads.first_user_message <> ''")
    if allowedSources.len > 0:
        sql = strings.ConcatStr(sql, inClause("threads.source", allowedSources.len))
    if modelProviders.len > 0:
        sql = strings.ConcatStr(sql, inClause("threads.model_provider", modelProviders.len))
    if cwdExplicitEmpty:
        sql = strings.ConcatStr(sql, " AND 1 = 0")
    elif cwdFilters.len > 0:
        sql = strings.ConcatStr(sql, inClause("threads.cwd", cwdFilters.len))
    if searchTerm != "":
        sql = strings.ConcatStr(sql, " AND instr(threads.title, ?) > 0")
    var err: str
    let sortCol = sortColumn(sortKey, err)
    if err != "":
        outError = err
        return ""
    let orderDir = orderDirection(sortDir, err)
    if err != "":
        outError = err
        return ""
    sql = strings.ConcatStr(sql, " ORDER BY ")
    sql = strings.ConcatStr(sql, sortCol)
    sql = strings.ConcatStr(sql, " ")
    sql = strings.ConcatStr(sql, orderDir)
    sql = strings.ConcatStr(sql, " LIMIT ?")
    return sql

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(name: str, expected: int32, actual: int32): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Test cases
# ═══════════════════════════════════════════════════════════════════════════════

fn testBasics(): bool =
    if !checkTrue("space", asciiSpace(' ')): return false
    if !checkTrue("newline", asciiSpace('\n')): return false
    if !checkTrue("cr", asciiSpace('\r')): return false
    if !checkTrue("tab", asciiSpace('\t')): return false
    if !checkTrue("nonSpace", !asciiSpace('a')): return false
    if !checkStr("trimNone", "hello", trimAsciiSpace("hello")): return false
    if !checkStr("trimLeft", "hello", trimAsciiSpace("  hello")): return false
    if !checkStr("trimRight", "hello", trimAsciiSpace("hello  ")): return false
    if !checkStr("trimBoth", "hello", trimAsciiSpace("  hello  ")): return false
    if !checkStr("trimAll", "", trimAsciiSpace("   ")): return false
    if !checkStr("trimEmpty", "", trimAsciiSpace("")): return false
    if !checkStr("joinPlain", "/parent/child", joinChild("/parent", "child")): return false
    if !checkStr("joinTrailing", "/parent/child", joinChild("/parent/", "child")): return false
    if !checkStr("joinEmptyParent", "child", joinChild("", "child")): return false
    if !checkStr("joinRoot", "/file", joinChild("/", "file")): return false
    echo("testBasics ok")
    return true

fn testSortAndDir(): bool =
    var err: str
    if !checkStr("sortCreated", "threads.created_at_ms", sortColumn("created_at", err)): return false
    if !checkStr("sortUpdated", "threads.updated_at_ms", sortColumn("updated_at", err)): return false
    let badSort = sortColumn("invalid", err)
    if !checkStr("sortErr", "invalid state db thread sort key: invalid", err): return false
    if !checkStr("sortBad", "", badSort): return false
    if !checkStr("dirAsc", "ASC", orderDirection("asc", err)): return false
    if !checkStr("dirDesc", "DESC", orderDirection("desc", err)): return false
    let badDir = orderDirection("invalid", err)
    if !checkStr("dirErr", "invalid state db thread sort direction: invalid", err): return false
    if !checkStr("dirBad", "", badDir): return false
    if !checkEq("archivedTrue", 1, archivedInt(true)): return false
    if !checkEq("archivedFalse", 0, archivedInt(false)): return false
    echo("testSortAndDir ok")
    return true

fn testSqlHelpers(): bool =
    if !checkStr("phZero", "()", placeholders(0)): return false
    if !checkStr("phOne", "(?)", placeholders(1)): return false
    if !checkStr("phTwo", "(?, ?)", placeholders(2)): return false
    if !checkStr("phThree", "(?, ?, ?)", placeholders(3)): return false
    if !checkStr("icZero", "", inClause("col", 0)): return false
    if !checkStr("icOne", " AND col IN (?)", inClause("col", 1)): return false
    if !checkStr("icTwo", " AND col IN (?, ?)", inClause("col", 2)): return false
    echo("testSqlHelpers ok")
    return true

fn testJsonHelpers(): bool =
    if !checkStr("jqHello", "\"hello\"", jsonQuote("hello")): return false
    var arr: str[]
    add(arr, "a")
    add(arr, "b")
    if !checkStr("jsa", "[\"a\",\"b\"]", jsonStringArray(arr)): return false
    let parsed = jsonStringArrayFromRaw("[\"a\",\"b\"]")
    if !checkEq("jsafLen", 2, parsed.len): return false
    if !checkStr("jsaf0", "a", parsed[0]): return false
    if !checkStr("jsaf1", "b", parsed[1]): return false
    if !checkStr("jfs", "\"k\":\"v\"", jsonFieldStr("k", "v")): return false
    if !checkStr("jfi", "\"k\":42", jsonFieldInt32("k", 42)): return false
    if !checkStr("jfb", "\"k\":true", jsonFieldBool("k", true)): return false
    if !checkStr("jfr", "\"k\":raw", jsonFieldRaw("k", "raw")): return false
    if !checkTrue("scContains", strContains("hello world", "world")): return false
    if !checkTrue("scNot", !strContains("hello", "xyz")): return false
    if !checkTrue("jfbTrue", jsonFindBool("{\"x\":true}", "x")): return false
    if !checkTrue("jfbFalse", !jsonFindBool("{\"x\":false}", "x")): return false
    echo("testJsonHelpers ok")
    return true

fn testSimpleJsonString(): bool =
    var err: str
    if !checkStr("sjsPlain", "hello", simpleJsonString("\"hello\"", err)): return false
    if !checkStr("sjsSpaced", "hello", simpleJsonString("  \"hello\"  ", err)): return false
    let bad1 = simpleJsonString("hello", err)
    if !checkStr("sjsBad", "", bad1): return false
    if !checkStr("sjsBadErr", "expected JSON string: hello", err): return false
    let bad2 = simpleJsonString("\"he\\x\"", err)
    if !checkStr("sjsEsc", "", bad2): return false
    if !checkStr("sjsEscErr", "escaped thread/list cwd filters are not ported", err): return false
    echo("testSimpleJsonString ok")
    return true

fn testCwdFilters(): bool =
    var err: str
    if !checkStr("ncfAbs", "/abs/path", normalizeCwdFilter("/abs/path", "/cwd", err)): return false
    if !checkStr("ncfRel", "/cwd/rel", normalizeCwdFilter("rel", "/cwd", err)): return false
    let bad1 = normalizeCwdFilter("", "/cwd", err)
    if !checkStr("ncfEmpty", "", bad1): return false
    if !checkStr("ncfEmptyErr", "empty thread/list cwd filter", err): return false
    let bad2 = normalizeCwdFilter("rel", "", err)
    if !checkStr("ncfNoCwd", "", bad2): return false
    if !checkStr("ncfNoCwdErr", "relative thread/list cwd filter requires resolved cwd: rel", err): return false
    let e1 = stringArrayFromOptionalRaw("")
    if !checkEq("safoEmpty", 0, e1.len): return false
    let e2 = stringArrayFromOptionalRaw("null")
    if !checkEq("safoNull", 0, e2.len): return false
    let parsed = stringArrayFromOptionalRaw("[\"a\",\"b\"]")
    if !checkEq("safoLen", 2, parsed.len): return false
    if !checkStr("safo0", "a", parsed[0]): return false
    let cfrE = cwdFiltersFromRaw("", "/repo", err)
    if !checkEq("cfrEmpty", 0, cfrE.len): return false
    let cfrA = cwdFiltersFromRaw("[\"/a\",\"/b\"]", "/repo", err)
    if !checkEq("cfrArr", 2, cfrA.len): return false
    if !checkStr("cfr0", "/a", cfrA[0]): return false
    if !checkStr("cfr1", "/b", cfrA[1]): return false
    let cfrS = cwdFiltersFromRaw("\"/abs\"", "/repo", err)
    if !checkEq("cfrSingle", 1, cfrS.len): return false
    if !checkStr("cfrSingleV", "/abs", cfrS[0]): return false
    let cfrRel = cwdFiltersFromRaw("\"rel\"", "/repo", err)
    if !checkEq("cfrRel", 1, cfrRel.len): return false
    if !checkStr("cfrRelV", "/repo/rel", cfrRel[0]): return false
    echo("testCwdFilters ok")
    return true

fn testBuildSql(): bool =
    let sql = buildThreadListSql("threads.created_at_ms", "DESC", 2, 1, 1, false, true, 26)
    if !checkTrue("select", strContains(sql, "SELECT threads.id")): return false
    if !checkTrue("archived", strContains(sql, "threads.archived = ?")): return false
    if !checkTrue("firstMsg", strContains(sql, "threads.first_user_message <> ''")): return false
    if !checkTrue("sourceIn", strContains(sql, "threads.source IN (?, ?)")): return false
    if !checkTrue("provIn", strContains(sql, "threads.model_provider IN (?)")): return false
    if !checkTrue("cwdIn", strContains(sql, "threads.cwd IN (?)")): return false
    if !checkTrue("search", strContains(sql, "instr(threads.title, ?) > 0")): return false
    if !checkTrue("order", strContains(sql, "ORDER BY threads.created_at_ms DESC LIMIT ?")): return false
    let noSearch = buildThreadListSql("threads.u_ms", "ASC", 0, 0, 0, false, false, 11)
    if !checkTrue("noSearch", !strContains(noSearch, "instr(threads.title")): return false
    if !checkTrue("noIn", !strContains(noSearch, "IN (")): return false
    if !checkTrue("orderAsc", strContains(noSearch, "ORDER BY threads.u_ms ASC LIMIT ?")): return false
    let emptyCwd = buildThreadListSql("t.c", "DESC", 0, 0, 0, true, false, 11)
    if !checkTrue("1eq0", strContains(emptyCwd, "AND 1 = 0")): return false
    echo("testBuildSql ok")
    return true

fn testBindsJson(): bool =
    var srcs: str[]
    add(srcs, "cli")
    add(srcs, "vscode")
    var provs: str[]
    add(provs, "openai")
    var cwds: str[]
    add(cwds, "/repo")
    let json = threadListBindsJson(false, srcs, provs, cwds, false, "demo", 26, "")
    if !checkTrue("archived", strContains(json, "\"archived\":0")): return false
    if !checkTrue("sources", strContains(json, "\"allowedSources\":[\"cli\",\"vscode\"]")): return false
    if !checkTrue("providers", strContains(json, "\"modelProviders\":[\"openai\"]")): return false
    if !checkTrue("cwds", strContains(json, "\"cwdFilters\":[\"/repo\"]")): return false
    if !checkTrue("emptyFlag", strContains(json, "\"cwdExplicitEmpty\":false")): return false
    if !checkTrue("search", strContains(json, "\"searchTerm\":\"demo\"")): return false
    if !checkTrue("limit", strContains(json, "\"scanLimit\":26")): return false
    if !checkTrue("nullFilter", strContains(json, "\"sourceKindPostFilter\":null")): return false
    var empty: str[]
    let json2 = threadListBindsJson(true, empty, empty, empty, true, "", 11, "[\"subAgentReview\"]")
    if !checkTrue("archived1", strContains(json2, "\"archived\":1")): return false
    if !checkTrue("cwdEmpty", strContains(json2, "\"cwdExplicitEmpty\":true")): return false
    if !checkTrue("cwdArr", strContains(json2, "\"cwdFilters\":[]")): return false
    if !checkTrue("postFilter", strContains(json2, "\"sourceKindPostFilter\":[\"subAgentReview\"]")): return false
    echo("testBindsJson ok")
    return true

fn testQueryPlan(): bool =
    let plan = queryPlanFromValues("/codex/sqlite", 25, "created_at", "desc",
        "[\"cli\"]", "[\"openai\"]", "", "", "", false, "", "/repo")
    if !checkStr("dbpath", "/codex/sqlite/state_5.sqlite", plan.dbPath): return false
    if !checkStr("sort", "threads.created_at_ms", plan.sortColumn): return false
    if !checkStr("order", "DESC", plan.orderDirection): return false
    if !checkEq("limit", 26, plan.scanLimit): return false
    if !checkTrue("blocked", plan.blockedReason != ""): return false
    if !checkTrue("sqlOrder", strContains(plan.sql, "ORDER BY threads.created_at_ms DESC LIMIT ?")): return false
    if !checkTrue("binds", strContains(plan.bindsJson, "\"scanLimit\":26")): return false
    let bad = queryPlanFromValues("/s", 0, "created_at", "desc",
        "", "", "", "", "", false, "", "/r")
    if !checkStr("badPage", "state db thread/list page size must be positive", bad.parseError): return false
    let cur = queryPlanFromValues("/s", 10, "created_at", "desc",
        "", "", "", "", "cursor", false, "", "/r")
    if !checkStr("cursor", "thread/list cursor timestamp parsing is not ported", cur.parseError): return false
    let json = queryPlanToJson(plan)
    if !checkTrue("jsonDbPath", strContains(json, "\"dbPath\":\"/codex/sqlite/state_5.sqlite\"")): return false
    if !checkTrue("jsonSort", strContains(json, "\"sortColumn\":\"threads.created_at_ms\"")): return false
    echo("testQueryPlan ok")
    return true

fn testResolveHome(): bool =
    let cfg = resolveSqliteHomeFromValues("/cfg", "/env", "/home", "/cwd")
    if !checkStr("config", "/cfg", cfg.path): return false
    if !checkStr("configErr", "", cfg.error): return false
    let envAbs = resolveSqliteHomeFromValues("", " /abs ", "/home", "/cwd")
    if !checkStr("envAbs", "/abs", envAbs.path): return false
    let envRel = resolveSqliteHomeFromValues("", "rel", "/home", "/cwd")
    if !checkStr("envRel", "/cwd/rel", envRel.path): return false
    let codex = resolveSqliteHomeFromValues("", "", "/codex-home", "/cwd")
    if !checkStr("codex", "/codex-home", codex.path): return false
    let noCodex = resolveSqliteHomeFromValues("", "", "", "/cwd")
    if !checkStr("noCodex", "codex home is empty", noCodex.error): return false
    let relNoCwd = resolveSqliteHomeFromValues("", "rel", "/home", "")
    if !checkStr("relNoCwd", "resolved cwd is empty for relative CODEX_SQLITE_HOME", relNoCwd.error): return false
    echo("testResolveHome ok")
    return true

fn testBuildQuery(): bool =
    var err: str
    let full = buildThreadListQuery(
        "{\"archived\":false,\"allowedSources\":[\"cli\",\"vscode\"],\"modelProviders\":[\"openai\"],\"cwdFilters\":[\"/repo/proj\"],\"searchTerm\":\"demo\"}",
        "created_at", "desc", 20, err)
    if !checkStr("fullErr", "", err): return false
    if !checkTrue("fullWhere", strContains(full, "WHERE 1 = 1")): return false
    if !checkTrue("fullArchived", strContains(full, "threads.archived = ?")): return false
    if !checkTrue("fullSource", strContains(full, "threads.source IN (?, ?)")): return false
    if !checkTrue("fullProv", strContains(full, "threads.model_provider IN (?)")): return false
    if !checkTrue("fullCwd", strContains(full, "threads.cwd IN (?)")): return false
    if !checkTrue("fullSearch", strContains(full, "instr(threads.title, ?) > 0")): return false
    if !checkTrue("fullOrder", strContains(full, "ORDER BY threads.created_at_ms DESC LIMIT ?")): return false
    let empty = buildThreadListQuery("{}", "updated_at", "asc", 10, err)
    if !checkStr("emptyErr", "", err): return false
    if !checkTrue("emptyOrder", strContains(empty, "ORDER BY threads.updated_at_ms ASC LIMIT ?")): return false
    if !checkTrue("emptyNoIn", !strContains(empty, "IN (")): return false
    let cwdEmpty = buildThreadListQuery("{\"cwdFilters\":[]}", "created_at", "desc", 5, err)
    if !checkTrue("ecwd10", strContains(cwdEmpty, "1 = 0")): return false
    let badSort = buildThreadListQuery("{}", "bad", "asc", 10, err)
    if !checkStr("badSort", "invalid state db thread sort key: bad", err): return false
    if !checkStr("badSortSql", "", badSort): return false
    let badDir = buildThreadListQuery("{}", "created_at", "bad", 10, err)
    if !checkStr("badDir", "invalid state db thread sort direction: bad", err): return false
    if !checkStr("badDirSql", "", badDir): return false
    let zero = buildThreadListQuery("{}", "created_at", "asc", 0, err)
    if !checkStr("zero", "limit must be positive", err): return false
    if !checkStr("zeroSql", "", zero): return false
    echo("testBuildQuery ok")
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testBasics(): allOk = false
    if !testSortAndDir(): allOk = false
    if !testSqlHelpers(): allOk = false
    if !testJsonHelpers(): allOk = false
    if !testSimpleJsonString(): allOk = false
    if !testCwdFilters(): allOk = false
    if !testBuildSql(): allOk = false
    if !testBindsJson(): allOk = false
    if !testQueryPlan(): allOk = false
    if !testResolveHome(): allOk = false
    if !testBuildQuery(): allOk = false
    if allOk:
        echo("rust_csg_state_db_relfacts_smoke ok")
        return 0
    echo("rust_csg_state_db_relfacts_smoke FAILED")
    return 1
