import std/cmdline
import std/strings
import std/strings as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/request_user_input_oracle as oracle

fn RustCsgTuiRequestInputOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/request_user_input/mod.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "\"render_snapshot(&overlay, area)\"":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 13:
        echo("FAIL usage: rust_csg_tui_request_user_input_oracle_smoke <12 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputFooterWrapSnapshot(), "request_user_input_footer_wrap")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputFreeformSnapshot(), "request_user_input_freeform")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputHiddenOptionsFooterSnapshot(), "request_user_input_hidden_options_footer")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputLongOptionTextSnapshot(), "request_user_input_long_option_text")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputMultiQuestionFirstSnapshot(), "request_user_input_multi_question_first")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputMultiQuestionLastSnapshot(), "request_user_input_multi_question_last")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputOptionsSnapshot(), "request_user_input_options")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputOptionsNotesVisibleSnapshot(), "request_user_input_options_notes_visible")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputScrollingOptionsSnapshot(), "request_user_input_scrolling_options")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputTightHeightSnapshot(), "request_user_input_tight_height")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputUnansweredConfirmationSnapshot(), "request_user_input_unanswered_confirmation")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiRequestInputOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiRequestInputWrappedOptionsSnapshot(), "request_user_input_wrapped_options")

    if exitCode == 0:
        echo("rust_csg_tui_request_user_input_oracle_smoke ok")
    else:
        echo("rust_csg_tui_request_user_input_oracle_smoke FAILED")
    return exitCode
