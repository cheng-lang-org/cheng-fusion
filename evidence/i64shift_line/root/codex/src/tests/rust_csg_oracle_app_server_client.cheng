import cheng/codex/crates/app_server_client/app_server_client as m
fn main(): int32 =
    var pass: int32
    if m.AppServerEventVariantNames() == "ServerNotification,ServerRequest,Disconnected": pass = pass + 1
    if m.AppServerClientVariantNames() == "InProcess,Remote": pass = pass + 1
    if pass == 2: echo("rust_csg_oracle_app_server_client ok"); return 0
    echo("oracle FAIL"); return 1
main()
