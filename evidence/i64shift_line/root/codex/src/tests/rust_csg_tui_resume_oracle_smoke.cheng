import std/cmdline
import std/strings as strutil
import cheng/codex/tui/resume_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

# ── Inlined smoke ──────────────────────────────────────────────────────────

fn RustCsgTuiResumeOracleCheck(path: str, expectedSource: str, expectedExpr: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpr:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture.len == 0:
        echo(strutil.Join(["FAIL: ", name, " empty fixture"], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch (expected ", strings.IntToStr(s.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(fixture)), ")"], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_resume_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    # ── snapshot expression group (5) ──────────────────────────────────────
    # 1. search_error
    exitCode = exitCode + RustCsgTuiResumeOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/resume_picker.rs",
        "snapshot",
        oracle.RustCsgTuiResumeSearchErrorFixture(),
        "search_error")
    argIdx = argIdx + 1

    # 2. thread_names
    exitCode = exitCode + RustCsgTuiResumeOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/resume_picker.rs",
        "snapshot",
        oracle.RustCsgTuiResumeThreadNamesFixture(),
        "thread_names")
    argIdx = argIdx + 1

    # 3. screen
    exitCode = exitCode + RustCsgTuiResumeOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/resume_picker.rs",
        "snapshot",
        oracle.RustCsgTuiResumeScreenFixture(),
        "screen")
    argIdx = argIdx + 1

    # 4. table
    exitCode = exitCode + RustCsgTuiResumeOracleCheck(
        cmdline.argStr(argIdx),
        "tui/src/resume_picker.rs",
        "snapshot",
        oracle.RustCsgTuiResumeTableFixture(),
        "table")
    argIdx = argIdx + 1

    if exitCode != 0:
        echo(strutil.Join(["rust_csg_tui_resume_oracle_smoke FAIL (", strings.IntToStr(exitCode), " failures)"], ""))
        return 1

    echo("rust_csg_tui_resume_oracle_smoke ok")
    return 0
