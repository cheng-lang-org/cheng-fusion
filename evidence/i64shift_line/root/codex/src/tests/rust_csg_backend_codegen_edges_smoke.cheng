fn probeStackVarWriteback(a0: int32,
                          a1: int32,
                          a2: int32,
                          a3: int32,
                          a4: int32,
                          a5: int32,
                          a6: int32,
                          a7: int32,
                          outValue: var int32,
                          tail: int32): int32 =
    outValue = outValue + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + tail
    return outValue

fn main(): int32 =
    echo("echo-newline-before")
    echo("")
    echo("echo-newline-after")

    var stackValue: int32 = 5
    let written: int32 = probeStackVarWriteback(1, 2, 3, 4, 5, 6, 7, 8, stackValue, 9)
    assert(written == 50, "stack var writeback return")
    assert(stackValue == 50, "stack var writeback value")

    var ints: int32[]
    ints = []
    add(ints, 10)
    add(ints, 20)
    add(ints, 30)
    assert(ints.len == 3, "int32[] len")
    assert(ints[0] == 10, "int32[] index 0")
    assert(ints[2] == 30, "int32[] index 2")
    ints[1] = ints[0] + ints[2] + 5
    assert(ints[1] == 45, "int32[] store")

    var words: str[]
    words = []
    add(words, "alpha")
    add(words, "beta")
    assert(words.len == 2, "str[] len")
    assert(words[0] == "alpha", "str[] index 0")
    assert(words[1] == "beta", "str[] index 1")

    echo("rust_csg_backend_codegen_edges_smoke ok")
    return 0
