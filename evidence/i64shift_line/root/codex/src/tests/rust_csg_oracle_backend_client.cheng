import cheng/codex/crates/backend_client/backend_client as m
fn main(): int32 =
    var pass: int32
    if m.buildAuthHeader("test-token").len > 0: pass = pass + 1
    if m.validateEndpoint("https://api.example.com"): pass = pass + 1
    if !m.validateEndpoint("ftp://bad.com"): pass = pass + 1
    if m.backendClientBuildRequest("GET", "/api/test", "").len > 0: pass = pass + 1
    if pass == 4: echo("rust_csg_oracle_backend_client ok"); return 0
    echo("oracle FAIL"); return 1
main()
