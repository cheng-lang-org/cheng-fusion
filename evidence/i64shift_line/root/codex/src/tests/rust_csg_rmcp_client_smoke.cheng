import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: rmcp_client (inlined due to compiler cross-module ABI issue)
# ═══════════════════════════════════════════════════════════════════════════════

fn jsonEscape(s: str): str =
    if s.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < s.len:
        let ch = s[i]
        if ch == '"':
            result = strutil.Join([result, "\\\""], "")
        elif ch == '\\':
            result = strutil.Join([result, "\\\\"], "")
        elif ch == '\n':
            result = strutil.Join([result, "\\n"], "")
        elif ch == '\t':
            result = strutil.Join([result, "\\t"], "")
        elif ch == '\r':
            result = strutil.Join([result, "\\r"], "")
        else:
            let chStr: str = strings.SliceBytes(s, i, 1)
            result = strutil.Join([result, chStr], "")
        i = i + 1
    return result

fn RustCsgRmcpClientBuildInitializeRequest(clientName: str, version: str): str =
    let clientInfo = strutil.Join([
        "{\"name\":\"",
        jsonEscape(clientName),
        "\",\"version\":\"",
        jsonEscape(version),
        "\"}"
    ], "")

    return strutil.Join([
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{",
        "\"protocolVersion\":\"2024-11-05\",",
        "\"capabilities\":{},",
        "\"clientInfo\":",
        clientInfo,
        "}}"
    ], "")

fn RustCsgRmcpClientParseMcpResponse(json: str, outResult: var str, outError: var str): bool =
    outResult = ""
    outError = ""
    if json.len == 0:
        return false

    let n: int32 = json.len

    # Check for "error": key
    var errIdx: int32 = -1
    var i: int32 = 0
    let errEnd: int32 = n - 7
    while i < errEnd:
        if json[i] == '"' && json[i+1] == 'e' && json[i+2] == 'r' &&
           json[i+3] == 'r' && json[i+4] == 'o' && json[i+5] == 'r' &&
           json[i+6] == '"' && json[i+7] == ':':
            errIdx = i
            break
        i = i + 1

    # Check for "result": key
    var resultIdx: int32 = -1
    i = 0
    let resEnd: int32 = n - 8
    while i < resEnd:
        if json[i] == '"' && json[i+1] == 'r' && json[i+2] == 'e' &&
           json[i+3] == 's' && json[i+4] == 'u' && json[i+5] == 'l' &&
           json[i+6] == 't' && json[i+7] == '"' && json[i+8] == ':':
            resultIdx = i
            break
        i = i + 1

    # ── Error path ──────────────────────────────────────────────────────────
    if errIdx >= 0:
        var searchStart: int32 = errIdx + 8
        let msgEnd: int32 = n - 9
        if searchStart < msgEnd:
            i = searchStart
            while i < msgEnd:
                if json[i] == '"' && json[i+1] == 'm' && json[i+2] == 'e' &&
                   json[i+3] == 's' && json[i+4] == 's' && json[i+5] == 'a' &&
                   json[i+6] == 'g' && json[i+7] == 'e' && json[i+8] == '"' &&
                   json[i+9] == ':':
                    let valStart: int32 = i + 10
                    if valStart < n && json[valStart] == '"':
                        var valEnd: int32 = valStart + 1
                        while valEnd < n && json[valEnd] != '"':
                            valEnd = valEnd + 1
                        if valEnd > valStart + 1 && valEnd <= n:
                            outError = strings.SliceBytes(json, valStart + 1, valEnd - valStart - 1)
                    break
                i = i + 1
        if outError.len == 0:
            outError = "unknown error"
        return true

    # ── Result path ─────────────────────────────────────────────────────────
    if resultIdx >= 0:
        let valStart: int32 = resultIdx + 9
        var vPos: int32 = valStart
        while vPos < n && json[vPos] == ' ':
            vPos = vPos + 1
        if vPos < n:
            var vEnd: int32 = vPos
            var depth: int32 = 0
            while vEnd < n:
                let ch: char = json[vEnd]
                if ch == '{' || ch == '[':
                    depth = depth + 1
                    vEnd = vEnd + 1
                elif ch == '}' || ch == ']':
                    depth = depth - 1
                    vEnd = vEnd + 1
                    if depth <= 0:
                        break
                elif ch == ',' && depth == 0:
                    break
                else:
                    vEnd = vEnd + 1
            if vEnd > vPos:
                outResult = strings.SliceBytes(json, vPos, vEnd - vPos)
        if outResult.len == 0:
            outResult = "null"
        return true

    return false

# Build a JSON-RPC 2.0 notification (no "id" field).
# Returns the JSON string, or "" if method is empty.
fn RustCsgRmcpClientBuildNotification(method: str, params: str): str =
    if method.len == 0:
        return ""
    if params.len == 0:
        return strutil.Join([
            "{\"jsonrpc\":\"2.0\",\"method\":\"",
            jsonEscape(method),
            "\"}"
        ], "")
    return strutil.Join([
        "{\"jsonrpc\":\"2.0\",\"method\":\"",
        jsonEscape(method),
        "\",\"params\":",
        params,
        "}"
    ], "")

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    return true

fn checkContains(haystack: str, needle: str): bool =
    if !strutil.Contains(haystack, needle):
        echo(strutil.Join(["FAIL: missing=[", needle, "] in=[", haystack, "]"], ""))
        return false
    return true

fn testBuildRequestStandard(): bool =
    var ok: bool = true
    let req = RustCsgRmcpClientBuildInitializeRequest("test-client", "1.0.0")
    if !checkContains(req, "\"jsonrpc\":\"2.0\""): ok = false
    if !checkContains(req, "\"id\":1"): ok = false
    if !checkContains(req, "\"method\":\"initialize\""): ok = false
    if !checkContains(req, "\"protocolVersion\":\"2024-11-05\""): ok = false
    if !checkContains(req, "\"capabilities\":{}"): ok = false
    if !checkContains(req, "\"clientInfo\""): ok = false
    if !checkContains(req, "\"name\":\"test-client\""): ok = false
    if !checkContains(req, "\"version\":\"1.0.0\""): ok = false
    if ok:
        echo("testBuildRequestStandard ok")
    return ok

fn testBuildRequestSpecialChars(): bool =
    var ok: bool = true
    let req = RustCsgRmcpClientBuildInitializeRequest("my\"client", "1.0")
    if !checkContains(req, "\"name\":\"my\\\"client\""): ok = false
    if ok:
        echo("testBuildRequestSpecialChars ok")
    return ok

fn testBuildRequestNewlines(): bool =
    var ok: bool = true
    let req = RustCsgRmcpClientBuildInitializeRequest("line1\nline2", "2.0")
    if !checkContains(req, "\"name\":\"line1\\nline2\""): ok = false
    if ok:
        echo("testBuildRequestNewlines ok")
    return ok

fn testParseResponseResult(): bool =
    var ok: bool = true
    var res: str
    var err: str
    let found = RustCsgRmcpClientParseMcpResponse(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"serverInfo\":{\"name\":\"test\",\"version\":\"1.0\"}}}",
        res, err)
    if !found:
        echo("FAIL: parse result should succeed")
        ok = false
    if !checkEq(res, "{\"serverInfo\":{\"name\":\"test\",\"version\":\"1.0\"}}"): ok = false
    if !checkEq(err, ""): ok = false
    if ok:
        echo("testParseResponseResult ok")
    return ok

fn testParseResponseError(): bool =
    var ok: bool = true
    var res: str
    var err: str
    let found = RustCsgRmcpClientParseMcpResponse(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32602,\"message\":\"invalid params\"}}",
        res, err)
    if !found:
        echo("FAIL: parse error should succeed")
        ok = false
    if !checkEq(err, "invalid params"): ok = false
    if !checkEq(res, ""): ok = false
    if ok:
        echo("testParseResponseError ok")
    return ok

fn testParseResponseEmptyJson(): bool =
    var ok: bool = true
    var res: str
    var err: str
    let found = RustCsgRmcpClientParseMcpResponse("", res, err)
    if found:
        echo("FAIL: parse empty should fail")
        ok = false
    if ok:
        echo("testParseResponseEmptyJson ok")
    return ok

fn testParseResponseNoResultOrError(): bool =
    var ok: bool = true
    var res: str
    var err: str
    let found = RustCsgRmcpClientParseMcpResponse(
        "{\"jsonrpc\":\"2.0\",\"id\":1}",
        res, err)
    if found:
        echo("FAIL: parse no result/error should fail")
        ok = false
    if ok:
        echo("testParseResponseNoResultOrError ok")
    return ok

fn testBuildNotificationStandard(): bool =
    var ok: bool = true
    let notif = RustCsgRmcpClientBuildNotification("ping", "")
    if !checkContains(notif, "\"jsonrpc\":\"2.0\""): ok = false
    if !checkContains(notif, "\"method\":\"ping\""): ok = false
    # Notification format should be jsonrpc+method without params
    if !checkContains(notif, "}"):
        echo("FAIL: notification should end with }")
        ok = false
    if ok:
        echo("testBuildNotificationStandard ok")
    return ok

fn testBuildNotificationWithParams(): bool =
    var ok: bool = true
    let notif = RustCsgRmcpClientBuildNotification("custom/event", "{\"key\":\"value\"}")
    if !checkContains(notif, "\"method\":\"custom/event\""): ok = false
    if !checkContains(notif, "\"params\":{\"key\":\"value\"}"): ok = false
    if ok:
        echo("testBuildNotificationWithParams ok")
    return ok

fn testBuildNotificationEmptyMethod(): bool =
    var ok: bool = true
    let notif = RustCsgRmcpClientBuildNotification("", "{}")
    if notif != "":
        echo("FAIL: notification with empty method should be empty")
        ok = false
    if ok:
        echo("testBuildNotificationEmptyMethod ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testBuildRequestStandard(): allOk = false
    if !testBuildRequestSpecialChars(): allOk = false
    if !testBuildRequestNewlines(): allOk = false
    if !testParseResponseResult(): allOk = false
    if !testParseResponseError(): allOk = false
    if !testParseResponseEmptyJson(): allOk = false
    if !testParseResponseNoResultOrError(): allOk = false
    if !testBuildNotificationStandard(): allOk = false
    if !testBuildNotificationWithParams(): allOk = false
    if !testBuildNotificationEmptyMethod(): allOk = false
    if allOk:
        echo("rust_csg_rmcp_client_smoke ok")
        return 0
    else:
        echo("rust_csg_rmcp_client_smoke FAILED")
        return 1
