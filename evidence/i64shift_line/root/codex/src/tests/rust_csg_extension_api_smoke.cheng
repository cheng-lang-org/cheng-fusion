import cheng/codex/crates/extension_api/extension_api as ea
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Extension API — type definition constants smoke test
#
# Ported from codex-rs/ext/extension-api
# ═══════════════════════════════════════════════════════════════════════════════

fn testExtensionDataFields(): bool =
    if ea.RustCsgExtensionDataFieldCount != 2: return false
    if ea.RustCsgExtensionDataField1 != "level_id": return false
    if ea.RustCsgExtensionDataField2 != "entries": return false
    echo("testExtensionDataFields ok")
    return true

fn testPromptSlotVariants(): bool =
    if ea.RustCsgPromptSlotVariantCount != 4: return false
    if ea.RustCsgPromptSlotVariant1 != "DeveloperPolicy": return false
    if ea.RustCsgPromptSlotVariant4 != "SeparateDeveloper": return false
    echo("testPromptSlotVariants ok")
    return true

fn testToolCallSourceVariants(): bool =
    if ea.RustCsgToolCallSourceVariantCount != 2: return false
    if ea.RustCsgToolCallSourceVariant1 != "Direct": return false
    if ea.RustCsgToolCallSourceVariant2 != "CodeMode": return false
    echo("testToolCallSourceVariants ok")
    return true

fn testToolCallOutcomeVariants(): bool =
    if ea.RustCsgToolCallOutcomeVariantCount != 4: return false
    if ea.RustCsgToolCallOutcomeVariant1 != "Completed": return false
    if ea.RustCsgToolCallOutcomeVariant2 != "Blocked": return false
    if ea.RustCsgToolCallOutcomeVariant3 != "Failed": return false
    if ea.RustCsgToolCallOutcomeVariant4 != "Aborted": return false
    echo("testToolCallOutcomeVariants ok")
    return true

fn testContributorMethodCounts(): bool =
    if ea.RustCsgThreadLifecycleContributorVariantCount != 3: return false
    if ea.RustCsgTurnLifecycleContributorVariantCount != 3: return false
    if ea.RustCsgConfigContributorMethodCount != 1: return false
    if ea.RustCsgTokenUsageContributorMethodCount != 1: return false
    if ea.RustCsgToolContributorMethodCount != 1: return false
    if ea.RustCsgToolLifecycleContributorMethodCount != 2: return false
    echo("testContributorMethodCounts ok")
    return true

fn testListExtensionEndpoints(): bool =
    let eps = ea.listExtensionEndpoints()
    if eps.len == 0: return false
    if !strutil.Contains(eps, "/extensions/register"): return false
    if !strutil.Contains(eps, "/extensions/list"): return false
    if !strutil.Contains(eps, "/extensions/health"): return false
    echo("testListExtensionEndpoints ok")
    return true

fn testValidateExtensionVersion(): bool =
    if !ea.validateExtensionVersion("1.0.0"): return false
    if !ea.validateExtensionVersion("0.1.0"): return false
    if !ea.validateExtensionVersion("2.0.0-alpha"): return false
    if !ea.validateExtensionVersion("1.2.3+build"): return false
    if ea.validateExtensionVersion(""): return false
    if ea.validateExtensionVersion("abc"): return false
    if ea.validateExtensionVersion("1"): return false
    echo("testValidateExtensionVersion ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testExtensionDataFields(): allOk = false
    if !testPromptSlotVariants(): allOk = false
    if !testToolCallSourceVariants(): allOk = false
    if !testToolCallOutcomeVariants(): allOk = false
    if !testContributorMethodCounts(): allOk = false
    if !testListExtensionEndpoints(): allOk = false
    if !testValidateExtensionVersion(): allOk = false

    if allOk:
        echo("rust_csg_extension_api_smoke ok")
        return 0
    else:
        echo("rust_csg_extension_api_smoke FAILED")
        return 1