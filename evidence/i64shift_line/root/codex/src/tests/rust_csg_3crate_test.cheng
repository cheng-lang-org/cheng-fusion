import cheng/codex/crates/app_server_test_client/app_server_test_client
import cheng/codex/crates/app_server_client/app_server_client
import cheng/codex/crates/app_server_transport/app_server_transport

fn main(): int32 =
    let a = app_server_test_client.RustCsgAppServerTestClientBuildTestClientConfig()
    let b = app_server_client.RustCsgAppServerClientBuildInProcessClientConfig()
    let c = app_server_transport.RustCsgAppServerTransportClassifyTransportError("timeout")
    assert(a != "" && b != "" && c != "", "all ok")
    echo("test_3crate ok")
    return 0
