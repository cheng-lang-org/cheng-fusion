import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/src/sandbox/exec as sandbox_exec
import cheng/codex/crates/sandboxing/sandboxing

@abi_internal
@importc("RustCsgMkdir")
fn mkdirRaw(path: str): int32

@abi_internal
@importc("RustCsgPathMetadataKind")
fn pathKind(path: str): int32

@abi_internal
@importc("ReadFile")
fn readFile(path: str): str

fn fail(message: str): int32 =
    echo(strutil.Join(["FAIL ", message], ""))
    return 1

fn checkTrue(label: str, value: bool): bool =
    if !value:
        echo(strutil.Join(["FAIL ", label], ""))
        return false
    return true

fn checkEqStr(label: str, got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL ", label, " expected=", expected, " got=", got], ""))
        return false
    return true

fn shellWriteScript(path: str, value: str): str =
    return strutil.Join(["printf ", value, " > ", path], "")

fn seatbeltProfile(allowedDir: str): str =
    return strutil.Join([
        "(version 1)\n",
        "(deny default)\n",
        "(allow process*)\n",
        "(allow signal)\n",
        "(allow sysctl-read)\n",
        "(allow mach-lookup)\n",
        "(allow file-read*)\n",
        "(allow file-read-metadata)\n",
        "(allow file-write* (subpath \"", allowedDir, "\"))\n"
    ], "")

fn runWrite(path: str, value: str, profile: str): sandbox_exec.SandboxExecResult =
    var args: str[] = ["-c", shellWriteScript(path, value)]
    var env: str[]
    return sandbox_exec.SandboxedExecWithSeatbeltProfile("/bin/sh", args, "", env,
                                                         sandboxing.RustCsgSandboxTypeSeatbelt,
                                                         profile)

fn main(): int32 =
    if cmdline.argCount() < 2:
        return fail("usage: rust_csg_sandbox_exec_seatbelt_smoke <work_dir>")

    let workDir: str = cmdline.argStr(1)
    let allowedDir: str = strutil.Join([workDir, "/allowed"], "")
    let forbiddenDir: str = strutil.Join([workDir, "/forbidden"], "")
    let allowedFile: str = strutil.Join([allowedDir, "/ok.txt"], "")
    let forbiddenFile: str = strutil.Join([forbiddenDir, "/bad.txt"], "")

    if mkdirRaw(workDir) != 1:
        return fail("mkdir work_dir failed")
    if mkdirRaw(allowedDir) != 1:
        return fail("mkdir allowed failed")
    if mkdirRaw(forbiddenDir) != 1:
        return fail("mkdir forbidden failed")

    let profile: str = seatbeltProfile(allowedDir)
    let allowed = runWrite(allowedFile, "allowed", profile)
    var ok: bool = true
    if !allowed.ok:
        echo(strutil.Join(["allowed_error=", allowed.error], ""))
    if !checkTrue("allowed_exec_ok", allowed.ok):
        ok = false
    if !checkTrue("allowed_exit_zero", allowed.exitCode == 0):
        ok = false
    if !checkTrue("allowed_file_exists", pathKind(allowedFile) == 2):
        ok = false
    if !checkEqStr("allowed_file_content", readFile(allowedFile), "allowed"):
        ok = false

    let forbidden = runWrite(forbiddenFile, "forbidden", profile)
    if !forbidden.ok:
        echo(strutil.Join(["forbidden_error=", forbidden.error], ""))
    if !checkTrue("forbidden_exec_ok", forbidden.ok):
        ok = false
    if !checkTrue("forbidden_exit_nonzero", forbidden.exitCode != 0):
        ok = false
    if !checkTrue("forbidden_file_absent", pathKind(forbiddenFile) == 0):
        ok = false

    let noProfile = sandbox_exec.SandboxedExec("/bin/true", [], "", [],
                                               sandboxing.RustCsgSandboxTypeSeatbelt)
    if !checkTrue("seatbelt_requires_profile", !noProfile.ok && strings.StrContains(noProfile.error, "profile")):
        ok = false

    if ok:
        echo("sandbox_allowed_write_ok")
        echo("sandbox_forbidden_write_blocked")
        echo("rust_csg_sandbox_exec_seatbelt_smoke ok")
        return 0
    return 1
