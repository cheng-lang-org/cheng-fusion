import cheng/codex/exec/plan

fn main(): int32 =
    let runPlan = plan.RustCsgExecParseArgs(["codex-exec", "--app-server-url", "http://127.0.0.1:4123", "hello"])
    assert(runPlan.command == "run", "run command")
    assert(runPlan.prompt == "hello", "run prompt")
    assert(runPlan.appServerUrl == "http://127.0.0.1:4123", "run app server url")
    assert(plan.RustCsgExecPlanRuntimeMissingReason(runPlan) == "", "run runtime missing reason")

    let resumePlan = plan.RustCsgExecParseArgs(["codex-exec", "resume", "thread-1", "continue"])
    assert(resumePlan.command == "resume", "resume command")
    assert(resumePlan.resumeSessionId == "thread-1", "resume session id")
    assert(plan.RustCsgExecPlanRuntimeMissingReason(resumePlan) == "", "resume runtime missing reason")

    let reviewPlan = plan.RustCsgExecParseArgs(["codex-exec", "review", "--uncommitted"])
    assert(reviewPlan.command == "review", "review command")
    assert(reviewPlan.reviewUncommitted, "review uncommitted")
    assert(plan.RustCsgExecPlanRuntimeMissingReason(reviewPlan) == "", "review runtime missing reason")

    let helpPlan = plan.RustCsgExecParseArgs(["codex-exec", "--help"])
    assert(helpPlan.help, "help flag")
    assert(plan.RustCsgExecPlanRuntimeMissingReason(helpPlan) == "", "help runtime missing reason")

    let parseErrorPlan = plan.RustCsgExecParseArgs(["codex-exec", "--definitely-unknown"])
    assert(plan.RustCsgExecPlanRuntimeMissingReason(parseErrorPlan) == "unknown exec flag: --definitely-unknown",
           "parse error runtime missing reason")

    var unsupported = plan.RustCsgExecPlanDefault()
    unsupported.command = "debug"
    assert(plan.RustCsgExecPlanRuntimeMissingReason(unsupported) == "unsupported exec command: debug",
           "unsupported runtime missing reason")

    echo("rust_csg_exec_plan_smoke ok")
    return 0
