import std/strings
import cheng/codex/core/runtime/string_ops_provider as ops

fn i32MinValue(): int32 =
    var out: int32 = int32(-2147483647)
    out = out - int32(1)
    return out

fn checkI32(name: str, got: int32, want: int32): int32 =
    if got != want:
        echo("FAIL")
        echo(name)
        echo("got")
        echo(strings.IntToStr(got))
        echo("want")
        echo(strings.IntToStr(want))
        return 1
    return 0

fn main(): int32 =
    var fail: int32
    let i32Min = i32MinValue()

    fail = fail + checkI32("contains hit", ops.RustCsgContainsExport("codex-rs", "dex"), 1)
    fail = fail + checkI32("contains miss", ops.RustCsgContainsExport("codex-rs", "cheng"), 0)
    fail = fail + checkI32("ends with", ops.RustCsgEndsWithExport("main.cheng", ".cheng"), 1)
    fail = fail + checkI32("starts with", ops.StartsWithExport("codex", "co"), 1)
    fail = fail + checkI32("str starts with", ops.RustCsgStrStartsWithExport("codex", "dex"), 0)
    fail = fail + checkI32("str count non-overlap", ops.RustCsgStrCountExport("aaaa", "aa"), 2)

    fail = fail + checkI32("strlen", ops.RustCsgStrLenExport("abc"), 3)
    fail = fail + checkI32("strlen i64 abi", ops.RustCsgStrLenI64Export("abcd"), 4)
    fail = fail + checkI32("empty", ops.RustCsgStrIsEmptyExport(""), 1)
    fail = fail + checkI32("not empty", ops.RustCsgStrNotEmptyExport("x"), 1)
    fail = fail + checkI32("len gt", ops.RustCsgStrLenGtExport("abc", 2), 1)
    fail = fail + checkI32("len lt", ops.RustCsgStrLenLtExport("abc", 4), 1)
    fail = fail + checkI32("len eq", ops.RustCsgStrLenEqExport("abc", 3), 1)
    fail = fail + checkI32("first byte", ops.RustCsgStrFirstByteExport("abc"), 97)
    fail = fail + checkI32("last byte", ops.RustCsgStrLastByteExport("abc"), 99)
    fail = fail + checkI32("byte at", ops.RustCsgStrByteAtExport("abc", 1), 98)
    fail = fail + checkI32("byte at invalid", ops.RustCsgStrByteAtExport("abc", 3), -1)
    fail = fail + checkI32("ascii", ops.RustCsgStrIsAsciiExport("abc"), 1)
    fail = fail + checkI32("memcmp equal", ops.RustCsgMemCmpExport("abc", "abc"), 1)
    fail = fail + checkI32("memcmp miss", ops.RustCsgMemCmpExport("abc", "abd"), 0)

    fail = fail + checkI32("min", ops.RustCsgMinI32Export(3, -4), -4)
    fail = fail + checkI32("max", ops.RustCsgMaxI32Export(3, -4), 3)
    fail = fail + checkI32("abs", ops.RustCsgAbsI32Export(-7), 7)
    fail = fail + checkI32("abs i32 min", ops.RustCsgAbsI32Export(i32Min), i32Min)
    fail = fail + checkI32("clamp low", ops.RustCsgClampI32Export(-7, -3, 3), -3)
    fail = fail + checkI32("clamp high", ops.RustCsgClampI32Export(7, -3, 3), 3)
    fail = fail + checkI32("popcount positive", ops.RustCsgPopCountExport(7), 3)
    fail = fail + checkI32("popcount minus one", ops.RustCsgPopCountExport(-1), 32)
    fail = fail + checkI32("popcount i32 min", ops.RustCsgPopCountExport(i32Min), 1)
    fail = fail + checkI32("power two", ops.RustCsgIsPowerOfTwoExport(1024), 1)
    fail = fail + checkI32("not power two", ops.RustCsgIsPowerOfTwoExport(1023), 0)
    fail = fail + checkI32("next power zero", ops.RustCsgNextPowerOfTwoExport(0), 1)
    fail = fail + checkI32("next power three", ops.RustCsgNextPowerOfTwoExport(3), 4)
    fail = fail + checkI32("next power max half", ops.RustCsgNextPowerOfTwoExport(1073741823), 1073741824)
    fail = fail + checkI32("next power overflow guard", ops.RustCsgNextPowerOfTwoExport(1073741824), 1073741824)

    fail = fail + checkI32("bit set", ops.RustCsgBitSetExport(4, 1), 6)
    fail = fail + checkI32("bit set invalid low", ops.RustCsgBitSetExport(4, -1), 4)
    fail = fail + checkI32("bit set invalid high", ops.RustCsgBitSetExport(4, 32), 4)
    fail = fail + checkI32("bit set bit31", ops.RustCsgBitSetExport(0, 31), i32Min)
    fail = fail + checkI32("bit clear", ops.RustCsgBitClearExport(7, 1), 5)
    fail = fail + checkI32("bit clear invalid", ops.RustCsgBitClearExport(7, 32), 7)
    fail = fail + checkI32("bit test", ops.RustCsgBitTestExport(4, 2), 1)
    fail = fail + checkI32("bit test miss", ops.RustCsgBitTestExport(4, 1), 0)
    fail = fail + checkI32("bit test invalid", ops.RustCsgBitTestExport(4, 32), 0)
    fail = fail + checkI32("bit toggle", ops.RustCsgBitToggleExport(4, 2), 0)
    fail = fail + checkI32("bit toggle invalid", ops.RustCsgBitToggleExport(4, -1), 4)

    fail = fail + checkI32("hash str simple", ops.RustCsgHashStrSimpleExport("abc"), 193485963)
    fail = fail + checkI32("hash combine", ops.RustCsgHashCombineExport(1026, 4), 31810)
    fail = fail + checkI32("hash combine wrap", ops.RustCsgHashCombineExport(2147483647, 31), i32Min)
    fail = fail + checkI32("hash3", ops.RustCsgHash3I32Export(1, 2, 3), 1026)
    fail = fail + checkI32("hash4", ops.RustCsgHash4I32Export(1, 2, 3, 4), 31810)
    fail = fail + checkI32("hash strlen", ops.RustCsgHashStrLenExport("abcd"), 4)

    if fail != 0:
        return 1
    echo("rust_csg_string_ops_provider_smoke ok")
    return 0
