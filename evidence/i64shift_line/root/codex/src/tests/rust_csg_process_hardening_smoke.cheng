import std/strings
import std/strutils as strutil
import cheng/codex/crates/process_hardening/process_hardening

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: process-hardening — security hardening configuration
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join([label, " FAIL: expected=", es, " got=", gs], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.Int64ToStr(int64(expected)),
                          " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# applyHardening tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testApplyHardeningDisabled(): bool =
    var ok: bool = true
    let cfg = process_hardening.applyHardening(process_hardening.HardeningLevelDisabled)
    if !checkEqI32(cfg.level, 0, "disabled level"): ok = false
    if !checkEqI32(cfg.flags, 0, "disabled flags"): ok = false
    if ok:
        echo("testApplyHardeningDisabled ok")
    return ok

fn testApplyHardeningBasic(): bool =
    var ok: bool = true
    let cfg = process_hardening.applyHardening(process_hardening.HardeningLevelBasic)
    if !checkEqI32(cfg.level, 1, "basic level"): ok = false
    # Basic should have: DisablePtrace | DisableCoreDump | DisableProcessDump
    let expectedFlags = process_hardening.HardeningDisablePtrace +
                        process_hardening.HardeningDisableCoreDump +
                        process_hardening.HardeningDisableProcessDump
    if !checkEqI32(cfg.flags, expectedFlags, "basic flags"): ok = false
    # Query individual flags
    if !checkEqBool(process_hardening.hardeningHasDisablePtrace(cfg), true, "basic has disablePtrace"): ok = false
    if !checkEqBool(process_hardening.hardeningHasDisableCoreDump(cfg), true, "basic has disableCoreDump"): ok = false
    if !checkEqBool(process_hardening.hardeningHasDisableProcessDump(cfg), true, "basic has disableProcessDump"): ok = false
    # Should NOT have stricter features
    if !checkEqBool(process_hardening.hardeningHasSeccomp(cfg), false, "basic no seccomp"): ok = false
    if ok:
        echo("testApplyHardeningBasic ok")
    return ok

fn testApplyHardeningStandard(): bool =
    var ok: bool = true
    let cfg = process_hardening.applyHardening(process_hardening.HardeningLevelStandard)
    if !checkEqI32(cfg.level, 2, "standard level"): ok = false
    # Should have basic + resource limits
    if !checkEqBool(process_hardening.hardeningHasDisablePtrace(cfg), true, "standard has disablePtrace"): ok = false
    if !checkEqI32(cfg.maxFileDescriptors, 1024, "standard maxFds"): ok = false
    if !checkEqI32(cfg.maxProcessCount, 64, "standard maxProcs"): ok = false
    if ok:
        echo("testApplyHardeningStandard ok")
    return ok

fn testApplyHardeningStrict(): bool =
    var ok: bool = true
    let cfg = process_hardening.applyHardening(process_hardening.HardeningLevelStrict)
    if !checkEqI32(cfg.level, 3, "strict level"): ok = false
    # Should have everything
    if !checkEqBool(process_hardening.hardeningHasDisablePtrace(cfg), true, "strict has disablePtrace"): ok = false
    if !checkEqBool(process_hardening.hardeningHasSeccomp(cfg), true, "strict has seccomp"): ok = false
    if !checkEqI32(cfg.maxAddressSpaceBytes, 4294967296, "strict maxAddressSpace"): ok = false
    if ok:
        echo("testApplyHardeningStrict ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Legacy stub tests (backward compat)
# ═══════════════════════════════════════════════════════════════════════════════

fn testPreMainHardeningSetsFlag(): bool =
    var flag: bool = false
    process_hardening.preMainHardening(flag)
    return checkEqBool(flag, true, "testPreMainHardeningSetsFlag")

fn testDisableProcessDumpingSetsFlag(): bool =
    var flag: bool = false
    process_hardening.disableProcessDumping(flag)
    return checkEqBool(flag, true, "testDisableProcessDumpingSetsFlag")

fn testFlagsAreIndependent(): bool =
    var a: bool = false
    var b: bool = false
    process_hardening.preMainHardening(a)
    if !checkEqBool(a, true, "testFlagsAreIndependent-a"):
        return false
    if !checkEqBool(b, false, "testFlagsAreIndependent-b"):
        return false
    process_hardening.disableProcessDumping(b)
    if !checkEqBool(b, true, "testFlagsAreIndependent-b-after"):
        return false
    if !checkEqBool(a, true, "testFlagsAreIndependent-a-after"):
        return false
    echo("testFlagsAreIndependent ok")
    return true

fn testThreeFlagsIndependence(): bool =
    var flagA: bool = false
    var flagB: bool = false
    var flagC: bool = false
    process_hardening.preMainHardening(flagA)
    process_hardening.disableProcessDumping(flagC)
    if !checkEqBool(flagA, true, "flagA-set"):
        return false
    if !checkEqBool(flagB, false, "flagB-unset"):
        return false
    if !checkEqBool(flagC, true, "flagC-set"):
        return false
    process_hardening.preMainHardening(flagB)
    if !checkEqBool(flagA, true, "flagA-after"):
        return false
    if !checkEqBool(flagB, true, "flagB-after"):
        return false
    if !checkEqBool(flagC, true, "flagC-after"):
        return false
    echo("testThreeFlagsIndependence ok")
    return true

fn testFlagDoubleSetStaysTrue(): bool =
    var flag: bool = false
    process_hardening.preMainHardening(flag)
    if !checkEqBool(flag, true, "first-set"):
        return false
    process_hardening.preMainHardening(flag)
    if !checkEqBool(flag, true, "second-set"):
        return false
    echo("testFlagDoubleSetStaysTrue ok")
    return true

fn testIndependentResetAndReSet(): bool =
    var a: bool = false
    var b: bool = false
    process_hardening.disableProcessDumping(a)
    if !checkEqBool(a, true, "a-set"):
        return false
    a = false
    process_hardening.disableProcessDumping(a)
    if !checkEqBool(a, true, "a-re-set"):
        return false
    if !checkEqBool(b, false, "b-untouched"):
        return false
    echo("testIndependentResetAndReSet ok")
    return true

fn testFlagDefaultIsFalse(): bool =
    var flag: bool
    return checkEqBool(flag, false, "testFlagDefaultIsFalse")

fn testBothFunctionsSetSameFlag(): bool =
    var flag: bool = false
    process_hardening.preMainHardening(flag)
    if !checkEqBool(flag, true, "pre-set"):
        return false
    process_hardening.disableProcessDumping(flag)
    if !checkEqBool(flag, true, "both-set-keeptrue"):
        return false
    echo("testBothFunctionsSetSameFlag ok")
    return true

fn testReversedOrderBothFunctions(): bool =
    var flag: bool = false
    process_hardening.disableProcessDumping(flag)
    if !checkEqBool(flag, true, "disable-first"):
        return false
    process_hardening.preMainHardening(flag)
    if !checkEqBool(flag, true, "pre-second"):
        return false
    echo("testReversedOrderBothFunctions ok")
    return true

fn testAuditLog(): bool =
    var ok: bool = true
    let log1 = process_hardening.processHardeningAuditLog("seccomp_installed,landlock_locked")
    if !checkEqBool(strutil.Contains(log1, "[HARDENING] seccomp_installed"), true, "auditLog contains first event"):
        ok = false
    if !checkEqBool(strutil.Contains(log1, "[HARDENING] landlock_locked"), true, "auditLog contains second event"):
        ok = false
    let log2 = process_hardening.processHardeningAuditLog("")
    if !checkEqStr(log2, "", "auditLog empty"):
        ok = false
    let log3 = process_hardening.processHardeningAuditLog("single_event")
    if !checkEqStr(log3, "[HARDENING] single_event", "auditLog single event"):
        ok = false
    let log4 = process_hardening.processHardeningAuditLog("a,b,c")
    let expected: str = "[HARDENING] a\n[HARDENING] b\n[HARDENING] c"
    if !checkEqStr(log4, expected, "auditLog multiple events"):
        ok = false
    if ok:
        echo("testAuditLog ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testApplyHardeningDisabled(): allOk = false
    if !testApplyHardeningBasic(): allOk = false
    if !testApplyHardeningStandard(): allOk = false
    if !testApplyHardeningStrict(): allOk = false
    if !testPreMainHardeningSetsFlag(): allOk = false
    if !testDisableProcessDumpingSetsFlag(): allOk = false
    if !testFlagsAreIndependent(): allOk = false
    if !testThreeFlagsIndependence(): allOk = false
    if !testFlagDoubleSetStaysTrue(): allOk = false
    if !testIndependentResetAndReSet(): allOk = false
    if !testFlagDefaultIsFalse(): allOk = false
    if !testBothFunctionsSetSameFlag(): allOk = false
    if !testReversedOrderBothFunctions(): allOk = false
    if !testAuditLog(): allOk = false

    if allOk:
        echo("rust_csg_process_hardening_smoke ok")
        return 0
    else:
        echo("rust_csg_process_hardening_smoke FAILED")
        return 1
