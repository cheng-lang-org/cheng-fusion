import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/session_handoff as handoff
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_resume as resume

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn CheckNotContains(text: str, needle: str, label: str): int32 =
    if !strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": unexpected ", needle], ""))
    echo(text)
    return 1

fn FillBaseConfig(config: var lifecycle.RustCsgTuiThreadHandoffConfig,
                  currentCwd: str,
                  workspaceRootsJson: str) =
    config.cwd = currentCwd
    config.model = "current-model"
    config.modelProviderId = "current-provider"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = workspaceRootsJson
    config.approvalPolicyJson = "\"never\""
    config.approvalsReviewer = "auto"
    config.sandboxJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.permissionsJson = "\":workspace\""
    config.configJson = lifecycle.RustCsgTuiThreadHandoffConfigOverridesJson("high",
                                                                             "",
                                                                             "",
                                                                             "precise",
                                                                             "enabled",
                                                                             false)
    config.baseInstructions = "base handoff"
    config.developerInstructions = "developer handoff"
    config.ephemeral = true

fn main(): int32 =
    if cmdline.argCount() < 6:
        echo("FAIL usage: rust_csg_tui_session_handoff_smoke <state-db> <current-cwd> <valid-codex-home> <broken-codex-home> <rollout-path>")
        return 1

    let dbPath = cmdline.argStr(1)
    let currentCwd = cmdline.argStr(2)
    let validCodexHome = cmdline.argStr(3)
    let brokenCodexHome = cmdline.argStr(4)
    let rolloutPath = cmdline.argStr(5)
    let changedCwd = strutil.Join([currentCwd, "/dbcwd"], "")
    let workspaceRootsJson = strutil.Join(["[\"", currentCwd, "\",\"", changedCwd, "\"]"], "")
    let currentUserConfig = "{\"model\":\"current-config-model\",\"modelProvider\":\"current-config-provider\",\"approvalPolicy\":\"never\",\"approvalsReviewer\":\"auto\"}"
    let currentConfigJson = resume.RustCsgTuiSessionResumeConfigJson(currentCwd, currentUserConfig)

    var failures: int32
    var config: lifecycle.RustCsgTuiThreadHandoffConfig
    FillBaseConfig(config, currentCwd, workspaceRootsJson)

    var context: handoff.RustCsgTuiSessionHandoffContext
    context.dbPath = dbPath
    context.currentCwd = currentCwd
    context.currentConfigJson = currentConfigJson
    context.allowPrompt = true
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded

    var selection = handoff.RustCsgTuiSessionHandoffMakeSelection("resume",
                                                                  "thread-db",
                                                                  rolloutPath,
                                                                  rolloutPath)
    context.codexHomePath = validCodexHome
    context.promptChoice = "session"
    context.remoteCwdOverride = ""
    context.requestIdJson = "71"
    let resumeRequest = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(resumeRequest.ok, true, "resume request ok")
    failures = failures + CheckEqStr(resumeRequest.outcome, "request", "resume outcome")
    failures = failures + CheckEqStr(resumeRequest.method, "thread/resume", "resume method")
    failures = failures + CheckEqStr(resumeRequest.cwd, changedCwd, "resume cwd")
    failures = failures + CheckEqStr(resumeRequest.historyCwd, changedCwd, "resume history cwd")
    failures = failures + CheckEqStr(resumeRequest.configOutcome, "rebuilt", "resume config outcome")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindValueRaw(resumeRequest.requestJson, "id"), "71", "resume request id")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindStr(resumeRequest.requestJson, "method"), "thread/resume", "resume request method")
    let resumeParams = wire.RustCsgJsonFindObject(resumeRequest.requestJson, "params")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindStr(resumeParams, "threadId"), "thread-db", "resume param thread")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(resumeParams, "model"), "profile-model", "resume reloaded model")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(resumeParams, "modelProvider"), "profile-provider", "resume reloaded provider")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(resumeParams, "cwd"), changedCwd, "resume param cwd")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalArray(resumeParams, "runtimeWorkspaceRoots"), workspaceRootsJson, "resume roots")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalValueRaw(resumeParams, "approvalPolicy"), "\"on-request\"", "resume approval")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(resumeParams, "approvalsReviewer"), "user", "resume reviewer")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalValueRaw(resumeParams, "permissions"), "\":workspace\"", "resume permissions")
    failures = failures + CheckContains(resumeParams, "\"model_reasoning_effort\":\"high\"", "resume config overrides")
    failures = failures + CheckNotContains(resumeParams, "\"sandbox\"", "resume no sandbox with permissions")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("resume",
                                                              "thread-db",
                                                              rolloutPath,
                                                              "display")
    context.codexHomePath = validCodexHome
    context.promptChoice = ""
    context.remoteCwdOverride = ""
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    context.requestIdJson = "72"
    let promptRequired = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(promptRequired.ok, true, "prompt required ok")
    failures = failures + CheckEqStr(promptRequired.outcome, "prompt_required", "prompt required outcome")
    failures = failures + CheckEqStr(promptRequired.requestJson, "", "prompt no request")
    failures = failures + CheckEqStr(promptRequired.historyCwd, changedCwd, "prompt history")

    context.promptChoice = "exit"
    context.requestIdJson = "73"
    let exitChoice = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(exitChoice.ok, true, "exit choice ok")
    failures = failures + CheckEqStr(exitChoice.outcome, "exit", "exit choice outcome")
    failures = failures + CheckEqStr(exitChoice.requestJson, "", "exit no request")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("fork",
                                                              "thread-db",
                                                              rolloutPath,
                                                              "display")
    context.codexHomePath = validCodexHome
    context.promptChoice = "current"
    context.remoteCwdOverride = ""
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    context.requestIdJson = "74"
    let forkRequest = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(forkRequest.ok, true, "fork request ok")
    failures = failures + CheckEqStr(forkRequest.method, "thread/fork", "fork method")
    failures = failures + CheckEqStr(forkRequest.cwd, currentCwd, "fork current cwd")
    let forkParams = wire.RustCsgJsonFindObject(forkRequest.requestJson, "params")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindStr(forkParams, "threadId"), "thread-db", "fork thread")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(forkParams, "cwd"), currentCwd, "fork cwd")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(forkParams, "threadSource"), "user", "fork source")
    failures = failures + CheckContains(forkParams, "\"baseInstructions\":\"base handoff\"", "fork base")
    failures = failures + CheckContains(forkParams, "\"developerInstructions\":\"developer handoff\"", "fork developer")
    failures = failures + CheckContains(forkParams, "\"ephemeral\":true", "fork ephemeral")

    let directBrokenChanged = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(brokenCodexHome,
                                                                                             currentCwd,
                                                                                             currentConfigJson,
                                                                                             changedCwd,
                                                                                             false,
                                                                                             "")
    failures = failures + CheckEqBool(directBrokenChanged.ok, false, "direct broken changed fails")
    failures = failures + CheckContains(directBrokenChanged.error, "unterminated config.toml table", "direct broken error")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("resume",
                                                              "thread-db",
                                                              rolloutPath,
                                                              "display")
    context.codexHomePath = brokenCodexHome
    context.promptChoice = "session"
    context.remoteCwdOverride = ""
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    context.requestIdJson = "75"
    let brokenChanged = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(brokenChanged.ok, false, "broken changed fails")
    failures = failures + CheckEqStr(brokenChanged.outcome, "error", "broken changed outcome")
    failures = failures + CheckContains(brokenChanged.error, "unterminated config.toml table", "broken changed error")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("resume",
                                                              "thread-db",
                                                              rolloutPath,
                                                              "remote display")
    context.codexHomePath = brokenCodexHome
    context.promptChoice = ""
    context.remoteCwdOverride = "/remote/workspace"
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeRemote
    context.requestIdJson = "76"
    let remoteRequest = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(remoteRequest.ok, true, "remote request ok")
    let remoteParams = wire.RustCsgJsonFindObject(remoteRequest.requestJson, "params")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(remoteParams, "cwd"), "/remote/workspace", "remote cwd override")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(remoteParams, "modelProvider"), "", "remote no model provider")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalValueRaw(remoteParams, "permissions"), "", "remote no permissions")
    failures = failures + CheckContains(remoteParams, "\"sandbox\":{\"type\":\"workspaceWrite\"", "remote sandbox")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("start_fresh", "", "", "")
    context.codexHomePath = validCodexHome
    context.promptChoice = ""
    context.remoteCwdOverride = ""
    context.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    context.requestIdJson = "77"
    let startFresh = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(startFresh.ok, true, "start fresh ok")
    failures = failures + CheckEqStr(startFresh.outcome, "start_fresh", "start fresh outcome")

    selection = handoff.RustCsgTuiSessionHandoffMakeSelection("resume", "", "", "")
    context.requestIdJson = "78"
    let missingThread = handoff.RustCsgTuiSessionHandoffFromSelection(context, selection, config)
    failures = failures + CheckEqBool(missingThread.ok, false, "missing thread fails")
    failures = failures + CheckEqStr(missingThread.error, "threadId is required", "missing thread error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_handoff_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_handoff_smoke ok")
    return 0
