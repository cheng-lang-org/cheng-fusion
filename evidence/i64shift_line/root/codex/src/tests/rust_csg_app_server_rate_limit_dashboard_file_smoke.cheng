import cheng/codex/app_server/rate_limit_dashboard
import cheng/codex/protocol/ratelimit_wire
import cheng/codex/protocol/wire
import std/os as os

fn assertTrue(name: str, value: bool) =
    if !value:
        echo(wire.RustCsgCat("FAIL: ", name))
    assert(value, name)

fn assertContains(name: str, haystack: str, needle: str) =
    if !wire.RustCsgContains(haystack, needle):
        echo(wire.RustCsgCat("FAIL: ", name))
        echo(wire.RustCsgCat("missing: ", needle))
        echo(wire.RustCsgCat("in: ", haystack))
    assert(wire.RustCsgContains(haystack, needle), name)

fn main(): int32 =
    let envPath = "/Users/lbcheng/codex-lbcheng/.env"
    let envContent = os.ReadFile(envPath)
    assertTrue("real env present", envContent != "")

    let cachePath = "/Users/lbcheng/.codex/rate_limit_dashboard_cache.json"
    let cacheContent = os.ReadFile(cachePath)
    assertTrue("real dashboard cache present", cacheContent != "")

    var out: str
    var error: str
    let ok = rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(envContent, envPath, cacheContent, out, error)
    if !ok:
        echo(error)
    assertTrue("real dashboard snapshot ok", ok)
    let parsed = ratelimit_wire.RustCsgRateLimitDashboardResponseFromJson(out)
    assertTrue("real dashboard source cache", parsed.source == "cache")
    assertContains("real dashboard has accounts", parsed.accountsJson, "\"email\"")
    assertContains("real dashboard has rate limits", parsed.accountsJson, "\"rateLimits\"")
    echo("rust_csg_app_server_rate_limit_dashboard_file_smoke ok")
    return 0
