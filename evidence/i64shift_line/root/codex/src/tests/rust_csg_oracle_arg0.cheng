import cheng/codex/crates/arg0/arg0 as m

fn main(): int32 =
    var pass: int32

    if m.parseArg0("codex") == "codex": pass = pass + 1
    if m.parseArg0("/usr/bin/codex") == "codex": pass = pass + 1
    if m.parseArg0("apply_patch") == "apply-patch": pass = pass + 1
    if m.parseArg0("codex-linux-sandbox") == "linux-sandbox": pass = pass + 1
    if m.parseArg0("codex-execve-wrapper") == "execve-wrapper": pass = pass + 1
    if m.parseArg0("unknown-binary") == "unknown": pass = pass + 1
    if m.parseArg0("") == "unknown": pass = pass + 1

    if pass == 7:
        echo("rust_csg_oracle_arg0 ok")
        return 0
    echo("oracle FAIL")
    return 1

main()