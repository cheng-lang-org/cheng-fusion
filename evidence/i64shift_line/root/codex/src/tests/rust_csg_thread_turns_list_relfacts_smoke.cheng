import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Module 19: app_server/thread_turns_list — equivalence verification
#
# Inline replica of pure-logic functions — no wire import, no SQLite.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Constants ────────────────────────────────────────────────────────────────

fn TlDefaultLimit(): int32 = return 25
fn TlMaxLimit(): int32 = return 100

# ── Low-level string helpers ─────────────────────────────────────────────────

fn cat(a: str, b: str): str = return strings.ConcatStr(a, b)
fn cat3(a: str, b: str, c: str): str =
    var x = cat(a, b)
    return cat(x, c)

fn cat4(a: str, b: str, c: str, d: str): str =
    var x = cat3(a, b, c)
    return cat(x, d)
fn slice(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn digitVal(text: str): int32 =
    if text == "0": return 0
    if text == "1": return 1
    if text == "2": return 2
    if text == "3": return 3
    if text == "4": return 4
    if text == "5": return 5
    if text == "6": return 6
    if text == "7": return 7
    if text == "8": return 8
    if text == "9": return 9
    return -1

fn int32ToStr(n: int32): str =
    if n == 0: return "0"
    var v = n
    var neg: bool
    if v < 0:
        neg = true
        v = -v
    var digits: str
    while v > 0:
        let d = v % 10
        v = v / 10
        let ch = slice("0123456789", d, 1)
        digits = cat(ch, digits)
    if neg:
        digits = cat("-", digits)
    return digits

fn parseInt32(raw: str): int32 =
    var out: int32 = 0
    var neg: bool
    if raw[0] == '-': neg = true
    var i: int32 = 0
    if neg: i = 1
    while i < raw.len:
        out = out * 10 + digitVal(slice(raw, i, 1))
        i = i + 1
    if neg: return 0 - out
    return out

fn matchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0 || pos + needle.len > text.len: return false
    var i: int32 = 0
    while i < needle.len:
        if text[pos + i] != needle[i]: return false
        i = i + 1
    return true

# ── 1. JsonLooksInt ──────────────────────────────────────────────────────────

fn looksInt(value: str): bool =
    if value == "": return false
    var i: int32
    if value[0] == '-': i = 1
    if i >= value.len: return false
    while i < value.len:
        if digitVal(slice(value, i, 1)) < 0: return false
        i = i + 1
    return true

# ── 2. Limit clamp ───────────────────────────────────────────────────────────

fn parseLimit(limitJson: str, outError: var str): int32 =
    outError = ""
    if limitJson == "": return TlDefaultLimit()
    if !looksInt(limitJson):
        outError = cat("invalid thread/turns/list limit: ", limitJson)
        return 0
    var value = parseInt32(limitJson)
    if value < 1: value = 1
    if value > TlMaxLimit(): value = TlMaxLimit()
    return value

# ── 3. Sort direction ────────────────────────────────────────────────────────

fn validateSortDirection(raw: str, outError: var str): str =
    outError = ""
    if raw == "": return "desc"
    if raw == "asc" || raw == "desc": return raw
    outError = cat("invalid thread/turns/list sortDirection: ", raw)
    return ""

# ── 4. ItemsView mapping ─────────────────────────────────────────────────────

fn validateItemsView(raw: str, outError: var str): str =
    outError = ""
    if raw == "": return "summary"
    if raw == "\"notLoaded\"": return "notLoaded"
    if raw == "\"summary\"": return "summary"
    if raw == "\"full\"": return "full"
    outError = cat("invalid thread/turns/list itemsView: ", raw)
    return ""

# ── 5. JSON object end detection ─────────────────────────────────────────────

fn jsonObjectEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '{': return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped: escaped = false
            elif ch == '\\': escaped = true
            elif ch == '"': inString = false
        elif ch == '"': inString = true
        elif ch == '{': depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0: return i
        i = i + 1
    return -1

fn skipJsonSpace(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t': return i
        i = i + 1
    return i

# ── 6. Array object access ───────────────────────────────────────────────────

fn arrayObjectAt(arrayJson: str, targetIndex: int32): str =
    var pos = skipJsonSpace(arrayJson, 0)
    if pos >= arrayJson.len || arrayJson[pos] != '[': return ""
    pos = skipJsonSpace(arrayJson, pos + 1)
    var index: int32
    while pos < arrayJson.len:
        if arrayJson[pos] == ']': return ""
        if arrayJson[pos] != '{': return ""
        let endPos = jsonObjectEnd(arrayJson, pos)
        if endPos < 0: return ""
        if index == targetIndex: return slice(arrayJson, pos, endPos - pos + 1)
        index = index + 1
        pos = skipJsonSpace(arrayJson, endPos + 1)
        if pos < arrayJson.len && arrayJson[pos] == ',':
            pos = skipJsonSpace(arrayJson, pos + 1)
        elif pos < arrayJson.len && arrayJson[pos] == ']': return ""
        else: return ""
    return ""

# ── 7. Array length ──────────────────────────────────────────────────────────

fn arrayLen(arrayJson: str): int32 =
    var pos = skipJsonSpace(arrayJson, 0)
    if pos >= arrayJson.len || arrayJson[pos] != '[': return -1
    pos = skipJsonSpace(arrayJson, pos + 1)
    var count: int32
    while pos < arrayJson.len:
        if arrayJson[pos] == ']': return count
        if arrayJson[pos] != '{': return -1
        let endPos = jsonObjectEnd(arrayJson, pos)
        if endPos < 0: return -1
        count = count + 1
        pos = skipJsonSpace(arrayJson, endPos + 1)
        if pos < arrayJson.len && arrayJson[pos] == ',':
            pos = skipJsonSpace(arrayJson, pos + 1)
        elif pos < arrayJson.len && arrayJson[pos] == ']': return count
        else: return -1
    return -1

# ── JSON field extraction helpers ────────────────────────────────────────────

fn jsonValueStart(text: str, key: str): int32 =
    let pattern = cat3("\"", key, "\"")
    var i: int32 = 0
    while i < text.len:
        if matchesAt(text, i, pattern):
            var p = i + pattern.len
            p = skipJsonSpace(text, p)
            if p < text.len && text[p] == ':':
                p = skipJsonSpace(text, p + 1)
                return p
        i = i + 1
    return -1

fn jsonFindStr(text: str, key: str): str =
    let p = jsonValueStart(text, key)
    if p < 0 || p >= text.len || text[p] != '"': return ""
    var i = p + 1
    while i < text.len:
        let ch = text[i]
        if ch == '"': return slice(text, p + 1, i - (p + 1))
        i = i + 1
    return ""

fn jsonFindOptionalStr(text: str, key: str): str =
    if strings.StrContains(text, cat3("\"", key, "\"")):
        return jsonFindStr(text, key)
    return ""

fn jsonFindArray(text: str, key: str): str =
    let p = jsonValueStart(text, key)
    if p < 0 || p >= text.len || text[p] != '[': return "[]"
    var depth: int32
    var inString: bool
    var escaped: bool
    var offset: int32 = 0
    while p + offset < text.len:
        let ch = text[p + offset]
        if inString:
            if escaped: escaped = false
            elif ch == '\\': escaped = true
            elif ch == '"': inString = false
        elif ch == '"': inString = true
        elif ch == '[': depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0: return slice(text, p, offset + 1)
        offset = offset + 1
    return "[]"

# ── 8. ItemArraySummary ──────────────────────────────────────────────────────

fn itemArraySummary(itemsJson: str): str =
    let itemCount = arrayLen(itemsJson)
    if itemCount <= 0: return "[]"
    var firstUser: str
    var firstUserId: str
    var finalAgent: str
    var finalAgentId: str
    var i: int32 = 0
    while i < itemCount:
        let item = arrayObjectAt(itemsJson, i)
        let itemType = jsonFindStr(item, "type")
        if itemType == "userMessage" && firstUser == "":
            firstUser = item
            firstUserId = jsonFindStr(item, "id")
        if itemType == "agentMessage":
            finalAgent = item
            finalAgentId = jsonFindStr(item, "id")
        i = i + 1
    if firstUser != "" && finalAgent != "" && firstUserId != finalAgentId:
        return cat3("[", cat3(firstUser, ",", finalAgent), "]")
    if firstUser != "":
        return cat3("[", firstUser, "]")
    if finalAgent != "":
        return cat3("[", finalAgent, "]")
    return "[]"

# ── 9/10. Cursor construction ────────────────────────────────────────────────

fn fieldStr(key: str, value: str): str =
    var out = "\""
    out = cat(out, key)
    out = cat(out, "\":\"")
    out = cat(out, value)
    out = cat(out, "\"")
    return out

fn fieldRaw(key: str, value: str): str =
    var out = "\""
    out = cat(out, key)
    out = cat(out, "\":")
    out = cat(out, value)
    return out

fn cursorWithIncludeAnchor(turnId: str): str =
    var out = "{"
    out = cat(out, fieldStr("turnId", turnId))
    out = cat(out, ",\"includeAnchor\":true")
    out = cat(out, "}")
    return out

fn cursorAfterAnchor(turnId: str): str =
    var out = "{"
    out = cat(out, fieldStr("turnId", turnId))
    out = cat(out, ",\"includeAnchor\":false")
    out = cat(out, "}")
    return out

# ── TurnWithItemsView ────────────────────────────────────────────────────────

type TlAppTurn =
    id: str
    itemsJson: str
    itemsView: str
    status: str

fn tlAppTurnFromJson(text: str): TlAppTurn =
    var result: TlAppTurn
    result.id = jsonFindStr(text, "id")
    result.itemsJson = jsonFindArray(text, "items")
    result.itemsView = jsonFindOptionalStr(text, "itemsView")
    if result.itemsView == "":
        result.itemsView = "full"
    result.status = jsonFindStr(text, "status")
    return result

fn tlAppTurnToJson(turn: TlAppTurn): str =
    var itemsJson = turn.itemsJson
    if itemsJson == "": itemsJson = "[]"
    var itemsView = turn.itemsView
    if itemsView == "": itemsView = "full"
    var out = "{"
    out = cat(out, fieldStr("id", turn.id))
    out = cat(out, ",")
    out = cat(out, fieldRaw("items", itemsJson))
    out = cat(out, ",")
    out = cat(out, fieldStr("itemsView", itemsView))
    out = cat(out, ",")
    out = cat(out, fieldStr("status", turn.status))
    out = cat(out, "}")
    return out

fn turnWithItemsView(turnJson: str, iv: str): str =
    var turn = tlAppTurnFromJson(turnJson)
    if iv == "notLoaded":
        turn.itemsJson = "[]"
        turn.itemsView = "notLoaded"
    elif iv == "summary":
        turn.itemsJson = itemArraySummary(turn.itemsJson)
        turn.itemsView = "summary"
    elif iv == "full":
        turn.itemsView = "full"
    return tlAppTurnToJson(turn)

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, name: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", expected], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", got], ""))
        return false
    return true

fn checkEqInt(got: int32, expected: int32, name: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected int=", int32ToStr(expected)], ""))
        echo(strutil.Join(["FAIL [", name, "]: got int=", int32ToStr(got)], ""))
        return false
    return true

fn checkNeStr(got: str, name: str): bool =
    if got == "":
        echo(strutil.Join(["FAIL [", name, "]: expected non-empty string"], ""))
        return false
    return true

fn checkBool(got: bool, expected: bool, name: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testLooksInt(): bool =
    var ok = true
    if !checkBool(looksInt(""), false, "looksInt_empty"): ok = false
    if !checkBool(looksInt("-"), false, "looksInt_minusOnly"): ok = false
    if !checkBool(looksInt("0"), true, "looksInt_zero"): ok = false
    if !checkBool(looksInt("123"), true, "looksInt_pos"): ok = false
    if !checkBool(looksInt("-5"), true, "looksInt_neg"): ok = false
    if !checkBool(looksInt("abc"), false, "looksInt_alpha"): ok = false
    if !checkBool(looksInt("12a3"), false, "looksInt_mixed"): ok = false
    if !checkBool(looksInt(" 1"), false, "looksInt_leadingSpace"): ok = false
    if ok: echo("testLooksInt ok")
    return ok

fn testLimit(): bool =
    var ok = true
    var err: str
    if !checkEqInt(parseLimit("", err), 25, "limit_default"): ok = false
    if !checkEqStr(err, "", "limit_default_err"): ok = false
    if !checkEqInt(parseLimit("0", err), 1, "limit_zero"): ok = false
    if !checkEqInt(parseLimit("-5", err), 1, "limit_neg"): ok = false
    if !checkEqInt(parseLimit("1", err), 1, "limit_min"): ok = false
    if !checkEqInt(parseLimit("50", err), 50, "limit_mid"): ok = false
    if !checkEqInt(parseLimit("100", err), 100, "limit_max"): ok = false
    if !checkEqInt(parseLimit("150", err), 100, "limit_clamp"): ok = false
    if !checkEqInt(parseLimit("abc", err), 0, "limit_invalid"): ok = false
    if !checkNeStr(err, "limit_invalid_err"): ok = false
    if ok: echo("testLimit ok")
    return ok

fn testSortDirection(): bool =
    var ok = true
    var err: str
    if !checkEqStr(validateSortDirection("", err), "desc", "sort_default"): ok = false
    if !checkEqStr(err, "", "sort_default_err"): ok = false
    if !checkEqStr(validateSortDirection("asc", err), "asc", "sort_asc"): ok = false
    if !checkEqStr(err, "", "sort_asc_err"): ok = false
    if !checkEqStr(validateSortDirection("desc", err), "desc", "sort_desc"): ok = false
    if !checkEqStr(err, "", "sort_desc_err"): ok = false
    if !checkEqStr(validateSortDirection("invalid", err), "", "sort_invalid"): ok = false
    if !checkNeStr(err, "sort_invalid_err"): ok = false
    if ok: echo("testSortDirection ok")
    return ok

fn testItemsView(): bool =
    var ok = true
    var err: str
    if !checkEqStr(validateItemsView("", err), "summary", "iv_default"): ok = false
    if !checkEqStr(err, "", "iv_default_err"): ok = false
    if !checkEqStr(validateItemsView("\"full\"", err), "full", "iv_full"): ok = false
    if !checkEqStr(validateItemsView("\"notLoaded\"", err), "notLoaded", "iv_notLoaded"): ok = false
    if !checkEqStr(validateItemsView("\"summary\"", err), "summary", "iv_summary"): ok = false
    if !checkEqStr(validateItemsView("full", err), "", "iv_bare_full"): ok = false
    if !checkNeStr(err, "iv_bare_full_err"): ok = false
    if !checkEqStr(validateItemsView("bogus", err), "", "iv_bogus"): ok = false
    if !checkNeStr(err, "iv_bogus_err"): ok = false
    if ok: echo("testItemsView ok")
    return ok

fn testJsonObjectEnd(): bool =
    var ok = true
    if !checkEqInt(jsonObjectEnd("{}", 0), 1, "objEnd_empty"): ok = false
    if !checkEqInt(jsonObjectEnd("{\"a\":1}", 0), 6, "objEnd_simple"): ok = false
    if !checkEqInt(jsonObjectEnd("{\"a\":{\"b\":2}}", 0), 12, "objEnd_nested"): ok = false
    if !checkEqInt(jsonObjectEnd("{}{}", 0), 1, "objEnd_firstOfTwo"): ok = false
    if !checkEqInt(jsonObjectEnd("abc", 0), -1, "objEnd_noBrace"): ok = false
    if !checkEqInt(jsonObjectEnd("", 0), -1, "objEnd_emptyStr"): ok = false
    if !checkEqInt(jsonObjectEnd("{\"}\"}", 0), 4, "objEnd_escapedBraceInStr"): ok = false
    if ok: echo("testJsonObjectEnd ok")
    return ok

fn testArrayObjectAt(): bool =
    var ok = true
    if !checkEqStr(arrayObjectAt("[{\"a\":1}]", 0), "{\"a\":1}", "arrAt_first"): ok = false
    if !checkEqStr(arrayObjectAt("[{\"a\":1},{\"b\":2}]", 0), "{\"a\":1}", "arrAt_0"): ok = false
    if !checkEqStr(arrayObjectAt("[{\"a\":1},{\"b\":2}]", 1), "{\"b\":2}", "arrAt_1"): ok = false
    if !checkEqStr(arrayObjectAt("[{\"a\":1},{\"b\":2}]", 2), "", "arrAt_oob"): ok = false
    if !checkEqStr(arrayObjectAt("[]", 0), "", "arrAt_empty"): ok = false
    if !checkEqStr(arrayObjectAt("", 0), "", "arrAt_notArray"): ok = false
    if ok: echo("testArrayObjectAt ok")
    return ok

fn testArrayLen(): bool =
    var ok = true
    if !checkEqInt(arrayLen("[]"), 0, "arrLen_empty"): ok = false
    if !checkEqInt(arrayLen("[{\"a\":1}]"), 1, "arrLen_one"): ok = false
    if !checkEqInt(arrayLen("[{\"a\":1},{\"b\":2}]"), 2, "arrLen_two"): ok = false
    if !checkEqInt(arrayLen(""), -1, "arrLen_bad"): ok = false
    if !checkEqInt(arrayLen("{}"), -1, "arrLen_obj"): ok = false
    if ok: echo("testArrayLen ok")
    return ok

fn testSummaryFilter(): bool =
    var ok = true
    # Empty array
    if !checkEqStr(itemArraySummary("[]"), "[]", "summary_empty"): ok = false
    # Single userMessage
    let u1 = "{\"id\":\"u1\",\"type\":\"userMessage\",\"content\":\"hi\"}"
    let summary1 = itemArraySummary(cat3("[", u1, "]"))
    if !checkEqStr(summary1, cat3("[", u1, "]"), "summary_singleUser"): ok = false
    # Single agentMessage
    let a1 = "{\"id\":\"a1\",\"type\":\"agentMessage\",\"content\":\"result\"}"
    let summary2 = itemArraySummary(cat3("[", a1, "]"))
    if !checkEqStr(summary2, cat3("[", a1, "]"), "summary_singleAgent"): ok = false
    # userMessage + agentMessage (different ids)
    let input3 = cat3("[", cat3(u1, ",", a1), "]")
    let expected3 = cat3("[", cat3(u1, ",", a1), "]")
    if !checkEqStr(itemArraySummary(input3), expected3, "summary_userAgent"): ok = false
    # userMessage + agentMessage (same id -> dedup)
    let both = "{\"id\":\"same\",\"type\":\"userMessage\",\"content\":\"both\"}"
    let input4 = cat3("[", both, "]")
    let expected4 = cat3("[", both, "]")
    if !checkEqStr(itemArraySummary(input4), expected4, "summary_dedup"): ok = false
    # Multiple items: first user + last agent
    let m1 = "{\"id\":\"m1\",\"type\":\"assistantMessage\"}"
    let m2 = "{\"id\":\"m2\",\"type\":\"userMessage\",\"content\":\"firstUser\"}"
    let m3 = "{\"id\":\"m3\",\"type\":\"agentMessage\",\"content\":\"midAgent\"}"
    let m4 = "{\"id\":\"m4\",\"type\":\"userMessage\",\"content\":\"secondUser\"}"
    let m5 = "{\"id\":\"m5\",\"type\":\"agentMessage\",\"content\":\"lastAgent\"}"
    let input5 = cat3("[", cat3(m1, ",", cat3(m2, ",", cat3(m3, ",", cat3(m4, ",", m5)))), "]")
    let expected5 = cat3("[", cat3(m2, ",", m5), "]")
    if !checkEqStr(itemArraySummary(input5), expected5, "summary_multi"): ok = false
    # No matching types
    let input6 = cat3("[", m1, "]")
    if !checkEqStr(itemArraySummary(input6), "[]", "summary_noMatch"): ok = false
    if ok: echo("testSummaryFilter ok")
    return ok

fn testCursorConstruct(): bool =
    var ok = true
    let cursor1 = cursorWithIncludeAnchor("turn_abc")
    let expected1 = "{\"turnId\":\"turn_abc\",\"includeAnchor\":true}"
    if !checkEqStr(cursor1, expected1, "cursor_includeAnchor"): ok = false
    let cursor2 = cursorAfterAnchor("turn_xyz")
    let expected2 = "{\"turnId\":\"turn_xyz\",\"includeAnchor\":false}"
    if !checkEqStr(cursor2, expected2, "cursor_afterAnchor"): ok = false
    if ok: echo("testCursorConstruct ok")
    return ok

fn testTurnWithItemsView(): bool =
    var ok = true
    let item1 = "{\"id\":\"i1\",\"type\":\"userMessage\",\"content\":\"hello\"}"
    let item2 = "{\"id\":\"i2\",\"type\":\"agentMessage\",\"content\":\"world\"}"
    let items = cat3("[", cat3(item1, ",", item2), "]")
    let turnIn = cat3("{\"id\":\"t1\",\"items\":", items, ",\"status\":\"completed\"}")
    # Full view
    let fullOut = turnWithItemsView(turnIn, "full")
    let expectedFull = cat3("{\"id\":\"t1\",\"items\":", items, ",\"itemsView\":\"full\",\"status\":\"completed\"}")
    if !checkEqStr(fullOut, expectedFull, "turn_full"): ok = false
    # Not loaded
    let notLoadedOut = turnWithItemsView(turnIn, "notLoaded")
    let expectedNotLoaded = "{\"id\":\"t1\",\"items\":[],\"itemsView\":\"notLoaded\",\"status\":\"completed\"}"
    if !checkEqStr(notLoadedOut, expectedNotLoaded, "turn_notLoaded"): ok = false
    # Summary
    let summaryOut = turnWithItemsView(turnIn, "summary")
    let expectedSummaryItems = cat3("[", cat3(item1, ",", item2), "]")
    let expectedSummary = cat3("{\"id\":\"t1\",\"items\":", expectedSummaryItems, ",\"itemsView\":\"summary\",\"status\":\"completed\"}")
    if !checkEqStr(summaryOut, expectedSummary, "turn_summary"): ok = false
    if ok: echo("testTurnWithItemsView ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testLooksInt(): allOk = false
    if !testLimit(): allOk = false
    if !testSortDirection(): allOk = false
    if !testItemsView(): allOk = false
    if !testJsonObjectEnd(): allOk = false
    if !testArrayObjectAt(): allOk = false
    if !testArrayLen(): allOk = false
    if !testSummaryFilter(): allOk = false
    if !testCursorConstruct(): allOk = false
    if !testTurnWithItemsView(): allOk = false
    if allOk:
        echo("rust_csg_thread_turns_list_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_thread_turns_list_relfacts_smoke FAILED")
        return 1
