import std/strutils as strutil
import cheng/codex/model_provider/chat as chat

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strutil.Contains(haystack, needle):
        echo(strutil.Join(["FAIL: ", label, " missing ", needle], ""))
        return false
    echo(strutil.Join(["  ok: ", label], ""))
    return true

fn main(): int32 =
    var failed: bool

    let userMessage = chat.BuildUserMessage("Hi")
    let messages = chat.BuildMessagesArray(1, userMessage, "", "", "", "", "", "", "")
    let tool = chat.BuildTool("search_docs", "Search docs", "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}}}")
    let tools = chat.BuildToolsArray(1, tool, "", "", "")

    let glmBody = chat.BuildGlmChatRequestBody("glm-5.2", messages, tools, true, true, 131072, "1.0", true, "max", true)
    if !checkContains(glmBody, "\"model\":\"glm-5.2\"", "glm model"): failed = true
    if !checkContains(glmBody, "\"stream\":true", "glm stream"): failed = true
    if !checkContains(glmBody, "\"tool_stream\":true", "glm tool_stream"): failed = true
    if !checkContains(glmBody, "\"max_tokens\":131072", "glm max_tokens"): failed = true
    if !checkContains(glmBody, "\"temperature\":1.0", "glm temperature"): failed = true
    if !checkContains(glmBody, "\"thinking\":{\"type\":\"enabled\"}", "glm thinking"): failed = true
    if !checkContains(glmBody, "\"reasoning_effort\":\"max\"", "glm reasoning_effort"): failed = true
    if !checkContains(glmBody, "\"response_format\":{\"type\":\"json_object\"}", "glm json mode"): failed = true
    if !checkContains(glmBody, "\"tools\":[", "glm tools"): failed = true

    let anthropicMessages = "[{\"role\":\"user\",\"content\":\"Hi\"}]"
    let anthropicBody = chat.BuildAnthropicMessagesRequestBody("glm-5.2[1m]", "Be concise", anthropicMessages, "", true, 0, true, "max")
    if !checkContains(anthropicBody, "\"model\":\"glm-5.2[1m]\"", "anthropic model"): failed = true
    if !checkContains(anthropicBody, "\"max_tokens\":131072", "anthropic default max_tokens"): failed = true
    if !checkContains(anthropicBody, "\"system\":\"Be concise\"", "anthropic system"): failed = true
    if !checkContains(anthropicBody, "\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}]", "anthropic messages"): failed = true
    if !checkContains(anthropicBody, "\"stream\":true", "anthropic stream"): failed = true
    if !checkContains(anthropicBody, "\"thinking\":{\"type\":\"enabled\"}", "anthropic thinking"): failed = true
    if !checkContains(anthropicBody, "\"reasoning_effort\":\"max\"", "anthropic reasoning_effort"): failed = true

    if failed:
        echo("rust_csg_glm_native_endpoint_builder_smoke FAILED")
        return 1
    else:
        echo("rust_csg_glm_native_endpoint_builder_smoke ok")
        return 0
