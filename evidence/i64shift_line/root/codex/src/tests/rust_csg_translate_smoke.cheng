import cheng/codex/translate/main as translate

fn main(): int32 =
    let portedResult = translate.RustCsgTranslateOneCrate("utils/elapsed")
    echo(portedResult)
    echo("")

    let nonRuntimeResult = translate.RustCsgTranslateOneCrate("aws-auth")
    echo(nonRuntimeResult)
    echo("")

    let coreMarkerResult = translate.RustCsgTranslateOneCrate("cli")
    echo(coreMarkerResult)
    echo("")

    let status = translate.RustCsgTranslateStatusSummary()
    echo(status)
    echo("")

    let oneClick = translate.RustCsgTranslateOneClickReady()
    echo(oneClick)
    echo("")

    let coreReady = translate.RustCsgTranslateCoreReady()
    echo(coreReady)
    echo("")

    # 分批 all-facts（修复 SIGTRAP 后可安全调用）
    let allFacts = translate.RustCsgTranslateAllCrates()
    echo(allFacts)
    echo("")

    echo("rust_csg_translate_smoke ok")
    return 0

main()