import cheng/codex/crates/rollout_trace_types/rollout_trace_types as rtt

fn main(): int32 =
    var pass: int32

    if rtt.RustCsgRolloutStatusRunning == 0: pass = pass + 1
    if rtt.RustCsgRolloutStatusCompleted == 1: pass = pass + 1
    if rtt.RustCsgRolloutStatusFailed == 2: pass = pass + 1
    if rtt.RustCsgRolloutStatusAborted == 3: pass = pass + 1

    if pass == 4:
        echo("rust_csg_oracle_rollout_trace ok")
        return 0
    echo("oracle FAIL")
    return 1

main()