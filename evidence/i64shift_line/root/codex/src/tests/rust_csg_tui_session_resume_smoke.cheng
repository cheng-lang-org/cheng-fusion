import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/session_resume as resume

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckOk(ok: bool, label: str): int32 =
    if ok:
        return 0
    echo(strutil.Join(["FAIL ", label], ""))
    return 1

fn CheckContains(haystack: str, needle: str, label: str): int32 =
    if strutil.Contains(haystack, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle, " in ", haystack], ""))
    return 1

fn main(): int32 =
    if cmdline.argCount() < 10:
        echo("FAIL usage: rust_csg_tui_session_resume_smoke <state-db> <latest-rollout> <meta-rollout> <malformed-rollout> <empty-rollout> <current-cwd> <current-cwd-dot> <valid-codex-home> <broken-codex-home>")
        return 1

    let dbPath = cmdline.argStr(1)
    let latestRollout = cmdline.argStr(2)
    let metaRollout = cmdline.argStr(3)
    let malformedRollout = cmdline.argStr(4)
    let emptyRollout = cmdline.argStr(5)
    let currentCwd = cmdline.argStr(6)
    let currentCwdDot = cmdline.argStr(7)
    let validCodexHome = cmdline.argStr(8)
    let brokenCodexHome = cmdline.argStr(9)
    let rolloutThreadId = "11111111-1111-4111-8111-111111111111"
    let explicitThreadId = "22222222-2222-4222-8222-222222222222"

    var failures: int32

    let latest = resume.RustCsgTuiSessionResumeReadRolloutState(latestRollout)
    failures = failures + CheckOk(latest.ok, "latest rollout ok")
    failures = failures + CheckEqBool(latest.sawRecord, true, "latest saw record")
    failures = failures + CheckEqStr(latest.threadId, rolloutThreadId, "latest thread id")
    failures = failures + CheckEqStr(latest.cwd, strutil.Join([currentCwd, "/latest"], ""), "latest cwd")
    failures = failures + CheckEqStr(latest.cwdSource, "turn_context", "latest cwd source")
    failures = failures + CheckEqStr(latest.model, "latest-model", "latest model")
    failures = failures + CheckEqStr(latest.modelSource, "turn_context", "latest model source")

    let meta = resume.RustCsgTuiSessionResumeReadRolloutState(metaRollout)
    failures = failures + CheckOk(meta.ok, "meta rollout ok")
    failures = failures + CheckEqStr(meta.threadId, rolloutThreadId, "meta thread id")
    failures = failures + CheckEqStr(meta.cwd, strutil.Join([currentCwd, "/session"], ""), "meta cwd")
    failures = failures + CheckEqStr(meta.cwdSource, "session_meta", "meta cwd source")
    failures = failures + CheckEqStr(meta.model, "", "meta model empty")

    let malformed = resume.RustCsgTuiSessionResumeReadRolloutState(malformedRollout)
    failures = failures + CheckOk(malformed.ok, "malformed rollout keeps valid record")
    failures = failures + CheckEqStr(malformed.threadId, rolloutThreadId, "malformed thread id")
    failures = failures + CheckEqStr(malformed.cwd, strutil.Join([currentCwd, "/session"], ""), "malformed cwd")

    let empty = resume.RustCsgTuiSessionResumeReadRolloutState(emptyRollout)
    failures = failures + CheckEqBool(empty.ok, false, "empty rollout not ok")
    failures = failures + CheckEqBool(empty.sawRecord, false, "empty rollout saw no record")

    let explicit = resume.RustCsgTuiSessionResumeResolveSessionThreadId(latestRollout, explicitThreadId)
    failures = failures + CheckEqBool(explicit.found, true, "explicit thread found")
    failures = failures + CheckEqStr(explicit.value, explicitThreadId, "explicit thread value")
    failures = failures + CheckEqStr(explicit.source, "explicit", "explicit source")

    let invalidExplicit = resume.RustCsgTuiSessionResumeResolveSessionThreadId(latestRollout, "not-a-uuid")
    failures = failures + CheckEqBool(invalidExplicit.found, false, "invalid explicit missing")

    let rolloutResolved = resume.RustCsgTuiSessionResumeResolveSessionThreadId(latestRollout, "")
    failures = failures + CheckEqBool(rolloutResolved.found, true, "rollout thread found")
    failures = failures + CheckEqStr(rolloutResolved.value, rolloutThreadId, "rollout thread value")

    let dbCwd = resume.RustCsgTuiSessionResumeReadSessionCwd(dbPath, "thread-db", latestRollout)
    failures = failures + CheckEqBool(dbCwd.found, true, "db cwd found")
    failures = failures + CheckEqStr(dbCwd.value, strutil.Join([currentCwd, "/dbcwd"], ""), "db cwd value")
    failures = failures + CheckEqStr(dbCwd.source, "state_db", "db cwd source")

    let dbModel = resume.RustCsgTuiSessionResumeReadSessionModel(dbPath, "thread-db", latestRollout)
    failures = failures + CheckEqBool(dbModel.found, true, "db model found")
    failures = failures + CheckEqStr(dbModel.value, "db-model", "db model value")
    failures = failures + CheckEqStr(dbModel.source, "state_db", "db model source")

    let missingModel = resume.RustCsgTuiSessionResumeReadSessionModel(dbPath, "missing-thread", latestRollout)
    failures = failures + CheckEqBool(missingModel.found, true, "missing model falls back")
    failures = failures + CheckEqStr(missingModel.value, "latest-model", "missing model fallback")
    failures = failures + CheckEqStr(missingModel.source, "turn_context", "missing model source")

    let emptyDbModel = resume.RustCsgTuiSessionResumeReadSessionModel(dbPath, "thread-empty-model", latestRollout)
    failures = failures + CheckEqBool(emptyDbModel.found, true, "empty db model falls back")
    failures = failures + CheckEqStr(emptyDbModel.value, "latest-model", "empty db model fallback")
    failures = failures + CheckEqStr(emptyDbModel.source, "turn_context", "empty db model source")

    let emptyStringDbModel = resume.RustCsgTuiSessionResumeReadSessionModel(dbPath, "thread-empty-string-model", latestRollout)
    failures = failures + CheckEqBool(emptyStringDbModel.found, true, "empty string db model found")
    failures = failures + CheckEqStr(emptyStringDbModel.value, "", "empty string db model value")
    failures = failures + CheckEqStr(emptyStringDbModel.source, "state_db", "empty string db model source")

    failures = failures + CheckEqBool(resume.RustCsgTuiSessionResumeCwdsDiffer(currentCwd, currentCwdDot), false, "realpath cwd equal")
    failures = failures + CheckEqBool(resume.RustCsgTuiSessionResumeCwdsDiffer(currentCwd, strutil.Join([currentCwd, "/dbcwd"], "")), true, "cwd differs")

    let prompt = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrFork(dbPath, currentCwd, "thread-db", latestRollout, true)
    failures = failures + CheckOk(prompt.ok, "prompt outcome ok")
    failures = failures + CheckEqStr(prompt.outcome, "prompt_required", "prompt outcome")
    failures = failures + CheckEqStr(prompt.historyCwd, strutil.Join([currentCwd, "/dbcwd"], ""), "prompt history cwd")
    failures = failures + CheckEqStr(prompt.source, "state_db", "prompt source")
    failures = failures + CheckEqBool(prompt.differs, true, "prompt differs")

    let noPrompt = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrFork(dbPath, currentCwd, "thread-db", latestRollout, false)
    failures = failures + CheckEqStr(noPrompt.outcome, "continue", "no prompt continue")
    failures = failures + CheckEqStr(noPrompt.cwd, strutil.Join([currentCwd, "/dbcwd"], ""), "no prompt cwd")
    failures = failures + CheckEqBool(noPrompt.differs, true, "no prompt differs")

    let chooseCurrent = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrForkWithPromptChoice(dbPath, currentCwd, "thread-db", latestRollout, true, "current")
    failures = failures + CheckEqStr(chooseCurrent.outcome, "continue", "choose current continue")
    failures = failures + CheckEqStr(chooseCurrent.cwd, currentCwd, "choose current cwd")
    failures = failures + CheckEqStr(chooseCurrent.historyCwd, strutil.Join([currentCwd, "/dbcwd"], ""), "choose current history")

    let chooseSession = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrForkWithPromptChoice(dbPath, currentCwd, "thread-db", latestRollout, true, "session")
    failures = failures + CheckEqStr(chooseSession.outcome, "continue", "choose session continue")
    failures = failures + CheckEqStr(chooseSession.cwd, strutil.Join([currentCwd, "/dbcwd"], ""), "choose session cwd")

    let chooseExit = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrForkWithPromptChoice(dbPath, currentCwd, "thread-db", latestRollout, true, "exit")
    failures = failures + CheckEqStr(chooseExit.outcome, "exit", "choose exit outcome")
    failures = failures + CheckEqStr(chooseExit.cwd, "", "choose exit cwd")
    failures = failures + CheckEqStr(chooseExit.historyCwd, strutil.Join([currentCwd, "/dbcwd"], ""), "choose exit history")

    let noHistory = resume.RustCsgTuiSessionResumeResolveCwdForResumeOrFork("", currentCwd, "missing-thread", emptyRollout, true)
    failures = failures + CheckEqStr(noHistory.outcome, "continue", "no history continue")
    failures = failures + CheckEqStr(noHistory.cwd, "", "no history cwd")
    failures = failures + CheckEqBool(noHistory.differs, false, "no history differs")

    let currentConfigJson = resume.RustCsgTuiSessionResumeConfigJson(currentCwd, "{\"model\":\"current-model\",\"modelProvider\":\"current-provider\",\"approvalPolicy\":\"never\"}")
    let changedCwd = strutil.Join([currentCwd, "/dbcwd"], "")
    let rebuiltConfig = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(validCodexHome,
                                                                                       currentCwd,
                                                                                       currentConfigJson,
                                                                                       changedCwd,
                                                                                       false,
                                                                                       "")
    failures = failures + CheckOk(rebuiltConfig.ok, "rebuilt config ok")
    failures = failures + CheckEqStr(rebuiltConfig.outcome, "rebuilt", "rebuilt config outcome")
    failures = failures + CheckEqStr(rebuiltConfig.cwd, changedCwd, "rebuilt config cwd")
    failures = failures + CheckEqBool(rebuiltConfig.differs, true, "rebuilt config differs")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(rebuiltConfig.configJson, "cwd"), changedCwd, "rebuilt config json cwd")
    let rebuiltUserConfig = wire.RustCsgJsonFindObject(rebuiltConfig.configJson, "userConfig")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(rebuiltUserConfig, "model"), "profile-model", "rebuilt config profile model")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(rebuiltUserConfig, "modelProvider"), "profile-provider", "rebuilt config profile provider")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(rebuiltUserConfig, "profile"), "work", "rebuilt config profile")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(rebuiltUserConfig, "defaultPermissions"), "trusted", "rebuilt config default permissions")

    let sameCwdBroken = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(brokenCodexHome,
                                                                                       currentCwd,
                                                                                       currentConfigJson,
                                                                                       currentCwd,
                                                                                       false,
                                                                                       "")
    failures = failures + CheckOk(sameCwdBroken.ok, "same cwd broken config falls back")
    failures = failures + CheckEqStr(sameCwdBroken.outcome, "current_config", "same cwd broken outcome")
    failures = failures + CheckEqStr(sameCwdBroken.cwd, currentCwd, "same cwd broken cwd")
    failures = failures + CheckEqStr(sameCwdBroken.configJson, currentConfigJson, "same cwd current config exact")

    let sameRealpathBroken = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(brokenCodexHome,
                                                                                            currentCwd,
                                                                                            currentConfigJson,
                                                                                            currentCwdDot,
                                                                                            false,
                                                                                            "")
    failures = failures + CheckOk(sameRealpathBroken.ok, "same realpath broken config falls back")
    failures = failures + CheckEqStr(sameRealpathBroken.outcome, "current_config", "same realpath broken outcome")
    failures = failures + CheckEqStr(sameRealpathBroken.configJson, currentConfigJson, "same realpath current config exact")

    let changedBroken = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(brokenCodexHome,
                                                                                       currentCwd,
                                                                                       currentConfigJson,
                                                                                       changedCwd,
                                                                                       false,
                                                                                       "")
    failures = failures + CheckEqBool(changedBroken.ok, false, "changed cwd broken config errors")
    failures = failures + CheckEqStr(changedBroken.outcome, "error", "changed cwd broken outcome")
    failures = failures + CheckEqBool(changedBroken.differs, true, "changed cwd broken differs")
    failures = failures + CheckContains(changedBroken.error, "unterminated config.toml table", "changed cwd broken error")

    let ignoreBroken = resume.RustCsgTuiSessionResumeRebuildConfigForResumeOrFallback(brokenCodexHome,
                                                                                      currentCwd,
                                                                                      currentConfigJson,
                                                                                      changedCwd,
                                                                                      true,
                                                                                      "")
    failures = failures + CheckOk(ignoreBroken.ok, "ignore user config rebuilds")
    failures = failures + CheckEqStr(ignoreBroken.outcome, "rebuilt", "ignore user config outcome")
    let ignoredUserConfig = wire.RustCsgJsonFindObject(ignoreBroken.configJson, "userConfig")
    failures = failures + CheckEqStr(wire.RustCsgJsonFindOptionalStr(ignoredUserConfig, "model"), "", "ignore user config model")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_resume_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_resume_smoke ok")
    return 0
