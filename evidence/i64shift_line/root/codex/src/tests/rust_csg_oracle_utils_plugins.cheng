import cheng/codex/crates/utils_plugins/mention_syntax as plugins

fn main(): int32 =
    var pass: int32

    if plugins.parsePluginManifest("{\"name\":\"myplugin\",\"version\":\"1.0\"}") == "myplugin@1.0": pass = pass + 1
    if plugins.parsePluginManifest("{\"name\":\"simple\"}") == "simple": pass = pass + 1
    if plugins.parsePluginManifest("") == "": pass = pass + 1
    if plugins.parsePluginManifest("{\"name\":\"foo\",\"version\":\"2.0\",\"extra\":\"ignored\"}") == "foo@2.0": pass = pass + 1

    if pass == 4:
        echo("rust_csg_oracle_utils_plugins ok")
        return 0
    echo("oracle FAIL")
    return 1

main()