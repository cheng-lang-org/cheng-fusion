import cheng/codex/crates/core/core

fn main(): int32 =
    var pass: int32

    # RustCsgBuildTurnContext: field assignment
    var ctx = core.RustCsgBuildTurnContext("s1", "t1", "gpt-5")
    if ctx.turnId == "t1": pass = pass + 1
    if ctx.traceId == "s1": pass = pass + 1
    if ctx.model == "gpt-5": pass = pass + 1
    if ctx.sandboxNetworkAccess == false: pass = pass + 1

    # Function count/names
    if core.RustCsgCoreFunctionCount == 1: pass = pass + 1

    if pass == 5:
        echo("rust_csg_oracle_core ok")
        return 0
    echo("oracle FAIL")
    return 1

main()