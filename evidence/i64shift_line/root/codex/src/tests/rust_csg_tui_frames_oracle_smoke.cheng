import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/frames as frames
import cheng/codex/tui/oracle_text as text

fn firstDiff(expected: str, actual: str): str =
    let expectedLen: int32 = strings.Len(expected)
    let actualLen: int32 = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen
    var i: int32 = 0
    var line: int32 = 1
    var col: int32 = 1
    while i < limit:
        if expected[i] != actual[i]:
            return strutil.Join(["line=", strings.IntToStr(line), " col=", strings.IntToStr(col)], "")
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1
    return strutil.Join(["len expected=", strings.IntToStr(expectedLen), " actual=", strings.IntToStr(actualLen)], "")

fn framePath(sourceRoot: str, group: str, frameNo: int32): str =
    return strutil.Join([sourceRoot, "/codex-rs/tui/frames/", group, "/frame_", strings.IntToStr(frameNo), ".txt"], "")

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_frames_oracle_smoke <source_root>")
        return 1
    let sourceRoot: str = cmdline.argStr(1)
    var groupIndex: int32 = 0
    var checked: int32 = 0
    var totalBytes: int32 = 0
    while groupIndex < frames.RustCsgTuiFramesGroupCount():
        let group: str = frames.RustCsgTuiFramesGroupAt(groupIndex)
        var frameNo: int32 = 1
        while frameNo <= frames.RustCsgTuiFramesPerGroup():
            let actual = frames.RustCsgTuiFrameLoad(sourceRoot, group, frameNo)
            if !actual.ok:
                echo(strutil.Join(["FAIL actual ", group, " frame ", strings.IntToStr(frameNo), ": ", actual.error], ""))
                return 1
            let expected = text.RustCsgTuiOracleTextParseFrameFile(framePath(sourceRoot, group, frameNo))
            if !expected.ok:
                echo(strutil.Join(["FAIL expected ", group, " frame ", strings.IntToStr(frameNo), ": ", expected.error], ""))
                return 1
            if expected.bodyLineCount != 17:
                echo(strutil.Join(["FAIL frame line count ", group, " frame ", strings.IntToStr(frameNo)], ""))
                return 1
            if actual.body != expected.body:
                echo(strutil.Join(["FAIL frame mismatch ", group, " frame ", strings.IntToStr(frameNo),
                                   " ", firstDiff(expected.body, actual.body)], ""))
                return 1
            checked = checked + 1
            totalBytes = totalBytes + strings.Len(actual.body)
            frameNo = frameNo + 1
        groupIndex = groupIndex + 1
    if checked != 360:
        echo(strutil.Join(["FAIL checked frame count expected=360 got=", strings.IntToStr(checked)], ""))
        return 1
    if totalBytes <= 0:
        echo("FAIL frame bytes must be positive")
        return 1
    echo(strutil.Join(["frame_count=", strings.IntToStr(checked)], ""))
    echo(strutil.Join(["frame_bytes=", strings.IntToStr(totalBytes)], ""))
    echo("rust_csg_tui_frames_oracle_smoke ok")
    return 0
