import std/strings as strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: utils/sandbox-summary (inlined due to compiler cross-module ABI issue)
# ═══════════════════════════════════════════════════════════════════════════════

# Inline helpers to build sandbox summary lines.
# Each returns a line formatted as "  - <key>: <value>".

fn polLine(key: str, value: str): str =
    var r: str = "  - "
    r = strutil.Join([r, key, ": ", value], "")
    return r

fn netLine(allowed: bool, desc: str): str =
    if allowed:
        var r: str = "  - network: "
        r = strutil.Join([r, desc], "")
        return r
    return "  - network: blocked"

fn fsLine(readOk: bool, writeOk: bool, dirs: str): str =
    var p: str = ""
    if readOk:
        p = "read"
    else:
        p = "no_read"
    if writeOk:
        p = strutil.Join([p, ",write"], "")
    else:
        p = strutil.Join([p, ",no_write"], "")
    if dirs.len > 0:
        p = strutil.Join([p, ",dirs=", dirs], "")
    var r: str = "  - filesystem: "
    r = strutil.Join([r, p], "")
    return r

fn sandSummary(policy: str): str =
    var lines: str[]
    add(lines, "sandbox policy:")
    if strutil.Contains(policy, "\"network_enabled\":true") || strutil.Contains(policy, "\"networkEnabled\":true"):
        add(lines, netLine(true, "enabled"))
    elif strutil.Contains(policy, "\"network_enabled\":false") || strutil.Contains(policy, "\"networkEnabled\":false"):
        add(lines, netLine(false, ""))
    if strutil.Contains(policy, "\"filesystem_read\":true") || strutil.Contains(policy, "\"filesystemRead\":true"):
        add(lines, fsLine(true, false, ""))
    elif strutil.Contains(policy, "\"filesystem_read\":false") || strutil.Contains(policy, "\"filesystemRead\":false"):
        var d: str
        if strutil.Contains(policy, "\"allowed_directories\""):
            d = "(restricted)"
        add(lines, fsLine(false, false, d))
    add(lines, "")
    return strutil.Join(lines, "\n")

fn chkCont(text: str, needle: str): bool =
    if !strutil.Contains(text, needle):
        var m: str = "FAIL: expected '"
        m = strutil.Join([m, needle, "' in '", text, "'"], "")
        echo(m)
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Production function: generateSandboxReport
# ═══════════════════════════════════════════════════════════════════════════════

fn generateSandboxReport(policy: str): str =
    var lines: str[]
    add(lines, "=== Sandbox Report ===")
    add(lines, sandSummary(policy))
    var networkOk: bool = false
    if strutil.Contains(policy, "\"network_enabled\":true") || strutil.Contains(policy, "\"networkEnabled\":true"):
        networkOk = true
    var fsOk: bool = false
    if strutil.Contains(policy, "\"filesystem_read\":true") || strutil.Contains(policy, "\"filesystemRead\":true"):
        fsOk = true
    if networkOk && fsOk:
        add(lines, "risk: low")
    elif !networkOk && !fsOk:
        add(lines, "risk: high")
    else:
        add(lines, "risk: medium")
    add(lines, "=== End Report ===")
    return strutil.Join(lines, "\n")

fn chkEq(got: str, expected: str): bool =
    if got != expected:
        var m: str = "FAIL: expected='"
        m = strutil.Join([m, expected, "' got='", got, "'"], "")
        echo(m)
        return false
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    # testNetworkEnabledPolicy
    let r1 = sandSummary("{\"network_enabled\":true}")
    if !chkCont(r1, "network: enabled"): allOk = false
    if !chkCont(r1, "sandbox policy:"): allOk = false
    if allOk: echo("testNetworkEnabledPolicy ok")
    # testNetworkDisabledPolicy
    let r2 = sandSummary("{\"network_enabled\":false}")
    if !chkCont(r2, "network: blocked"): allOk = false
    if allOk: echo("testNetworkDisabledPolicy ok")
    # testFilesystemPolicy
    let r3 = sandSummary("{\"filesystem_read\":true}")
    if !chkCont(r3, "filesystem:"): allOk = false
    if !chkCont(r3, "read"): allOk = false
    if allOk: echo("testFilesystemPolicy ok")
    # testEmptyPolicy
    let r4 = sandSummary("{}")
    if !chkCont(r4, "sandbox policy:"): allOk = false
    if allOk: echo("testEmptyPolicy ok")
    # testPolicyLineFormat
    let l1 = polLine("mode", "strict")
    if !chkEq(l1, "  - mode: strict"): allOk = false
    if allOk: echo("testPolicyLineFormat ok")
    # testNetworkPolicyFormat
    let l2 = netLine(true, "all")
    if !chkEq(l2, "  - network: all"): allOk = false
    let l3 = netLine(false, "")
    if !chkEq(l3, "  - network: blocked"): allOk = false
    if allOk: echo("testNetworkPolicyFormat ok")
    # testGenerateSandboxReport
    let report1 = generateSandboxReport("{\"network_enabled\":true,\"filesystem_read\":true}")
    if !chkCont(report1, "=== Sandbox Report ==="): allOk = false
    if !chkCont(report1, "network: enabled"): allOk = false
    if !chkCont(report1, "risk: low"): allOk = false
    if !chkCont(report1, "=== End Report ==="): allOk = false
    let report2 = generateSandboxReport("{}")
    if !chkCont(report2, "risk: high"): allOk = false
    let report3 = generateSandboxReport("{\"network_enabled\":true,\"filesystem_read\":false}")
    if !chkCont(report3, "risk: medium"): allOk = false
    if allOk: echo("testGenerateSandboxReport ok")
    if allOk:
        echo("rust_csg_sandbox_summary_smoke ok")
        return 0
    else:
        echo("rust_csg_sandbox_summary_smoke FAILED")
        return 1
