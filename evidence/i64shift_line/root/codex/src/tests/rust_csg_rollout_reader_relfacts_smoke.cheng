import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Self-contained behavioral smoke: rollout/reader equivalence verification
# Reimplements pure JSON parsing logic inline. No imports from rollout/reader
# or protocol/wire (cold-path compatible).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Inline string utilities (replaces protocol/wire) ─────────────

fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn cat3(a: str, b: str, c: str): str =
    return cat(cat(a, b), c)

fn slice(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn strContains(text: str, needle: str): bool =
    if needle == "":
        return true
    if needle.len > text.len:
        return false
    for i in 0..<(text.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return true
    return false

fn skipJsonSpace(text: str, pos: int32): int32 =
    var i: int32
    i = pos
    while i < text.len:
        let ch = text[i]
        if ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t':
            return i
        i = i + 1
    return i

fn matchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0:
        return false
    if pos + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if text[pos + i] != needle[i]:
            return false
    return true

fn digitValue(ch: char): int32 =
    if ch == '0': return 0
    if ch == '1': return 1
    if ch == '2': return 2
    if ch == '3': return 3
    if ch == '4': return 4
    if ch == '5': return 5
    if ch == '6': return 6
    if ch == '7': return 7
    if ch == '8': return 8
    if ch == '9': return 9
    return -1

fn jsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = cat(out, "\\\"")
        elif ch == '\\':
            out = cat(out, "\\\\")
        elif ch == '\n':
            out = cat(out, "\\n")
        elif ch == '\r':
            out = cat(out, "\\r")
        elif ch == '\t':
            out = cat(out, "\\t")
        else:
            out = cat(out, slice(value, i, 1))
    return cat(out, "\"")

fn jsonFieldStr(key: str, value: str): str =
    return cat3("\"", key, cat3("\":", jsonQuote(value), ""))

fn jsonFieldRaw(key: str, value: str): str =
    return cat3("\"", key, cat("\":", value))

# ── Assertion helpers ────────────────────────────────────────────

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strContains(haystack, needle):
        echo(strutil.Join([label, " FAIL: missing [", needle, "] in [", haystack, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkTrue(value: bool, label: str): bool =
    if !value:
        echo(strutil.Join([label, " FAIL: expected true"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkFalse(value: bool, label: str): bool =
    if value:
        echo(strutil.Join([label, " FAIL: expected false"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkOk(ok: bool, label: str): bool =
    if !ok:
        echo(strutil.Join([label, " FAIL: outOk was false"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkNotOk(ok: bool, label: str): bool =
    if ok:
        echo(strutil.Join([label, " FAIL: outOk should have been false"], ""))
        return false
    echo(strutil.Join([label, " ok (expected false)"], ""))
    return true

# ── Reimplemented JSON parsing primitives ────────────────────────
# These are inline reimplementations of the reader.cheng JSON functions
# to verify equivalence without importing the reader module.

fn reJsonStringEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var escaped: bool
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if escaped:
            escaped = false
        elif ch == '\\':
            escaped = true
        elif ch == '"':
            return i
        i = i + 1
    return -1

fn reJsonStringAt(text: str, start: int32, outOk: var bool): str =
    outOk = false
    if start < 0 || start >= text.len || text[start] != '"':
        return ""
    var out: str
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                return ""
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = cat(out, slice(text, i + 1, 1))
            elif escaped == 'n':
                out = cat(out, "\n")
            elif escaped == 'r':
                out = cat(out, "\r")
            elif escaped == 't':
                out = cat(out, "\t")
            else:
                return ""
            i = i + 2
            continue
        if ch == '"':
            outOk = true
            return out
        out = cat(out, slice(text, i, 1))
        i = i + 1
    return ""

fn reJsonObjectAt(text: str, start: int32): str =
    if start < 0 || start >= text.len || text[start] != '{':
        return ""
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return slice(text, start, i - start + 1)
        i = i + 1
    return ""

fn reJsonArrayAt(text: str, start: int32): str =
    if start < 0 || start >= text.len || text[start] != '[':
        return ""
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                return slice(text, start, i - start + 1)
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth < 0:
                return ""
        i = i + 1
    return ""

fn reJsonTopFieldValueStart(text: str, key: str): int32 =
    var p: int32
    p = skipJsonSpace(text, 0)
    if p >= text.len || text[p] != '{':
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = p
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            if depth == 1:
                var ok: bool
                let field = reJsonStringAt(text, i, ok)
                if !ok:
                    return -1
                let keyEnd = reJsonStringEnd(text, i)
                if keyEnd < 0:
                    return -1
                let colon = skipJsonSpace(text, keyEnd + 1)
                if colon < text.len && text[colon] == ':' && field == key:
                    return skipJsonSpace(text, colon + 1)
                i = keyEnd
            else:
                inString = true
        elif ch == '{' || ch == '[':
            depth = depth + 1
        elif ch == '}' || ch == ']':
            depth = depth - 1
            if depth < 0:
                return -1
        i = i + 1
    return -1

fn reJsonRequiredString(text: str, key: str, outOk: var bool): str =
    outOk = false
    let start = reJsonTopFieldValueStart(text, key)
    return reJsonStringAt(text, start, outOk)

fn reJsonRequiredIntRaw(text: str, key: str, outOk: var bool): str =
    outOk = false
    let start = reJsonTopFieldValueStart(text, key)
    if start < 0:
        return ""
    var pos: int32
    pos = start
    if pos < text.len && text[pos] == '-':
        pos = pos + 1
    let digitStart = pos
    while pos < text.len:
        let d = digitValue(text[pos])
        if d < 0:
            break
        pos = pos + 1
    if pos == digitStart:
        return ""
    let end = skipJsonSpace(text, pos)
    if end < text.len && text[end] != ',' && text[end] != '}':
        return ""
    outOk = true
    return slice(text, start, pos - start)

fn reJsonRequiredBool(text: str, key: str, outOk: var bool): bool =
    outOk = false
    let start = reJsonTopFieldValueStart(text, key)
    if start < 0:
        return false
    if matchesAt(text, start, "true"):
        outOk = true
        return true
    if matchesAt(text, start, "false"):
        outOk = true
        return false
    return false

# ── test 1: JSONL line parsing (event type classification) ───────

fn testLineParsing(): bool =
    var ok: bool = true
    var outOk: bool

    let sessionMetaLine = "{\"type\":\"session_meta\",\"payload\":{\"model\":\"c1\",\"cwd\":\"/x\"}}"
    let t = reJsonRequiredString(sessionMetaLine, "type", outOk)
    if !checkOk(outOk, "lineParse sessionMeta type ok"): ok = false
    if !checkEqStr(t, "session_meta", "lineParse sessionMeta type"): ok = false

    let turnCtxLine = "{\"type\":\"turn_context\",\"payload\":{\"model\":\"c1\",\"cwd\":\"/x\",\"approval_policy\":\"untrusted\",\"sandbox_policy\":{\"type\":\"danger-full-access\"},\"summary\":\"auto\"}}"
    let t2 = reJsonRequiredString(turnCtxLine, "type", outOk)
    if !checkOk(outOk, "lineParse turnCtx type ok"): ok = false
    if !checkEqStr(t2, "turn_context", "lineParse turnCtx type"): ok = false

    let eventLine = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"hello\"}}"
    let t3 = reJsonRequiredString(eventLine, "type", outOk)
    if !checkOk(outOk, "lineParse eventMsg type ok"): ok = false
    if !checkEqStr(t3, "event_msg", "lineParse eventMsg type"): ok = false

    # Empty line -> no type
    reJsonRequiredString("", "type", outOk)
    if !checkNotOk(outOk, "lineParse empty line no type"): ok = false

    if ok:
        echo("testLineParsing ok")
    return ok

# ── test 2: SessionMeta JSON parsing (required fields) ──────────

fn testSessionMetaParsing(): bool =
    var ok: bool = true
    var outOk: bool

    let meta = "{\"model\":\"claude-opus-4-5\",\"cwd\":\"/home/user\",\"session_id\":\"abc123\",\"approval_policy\":\"untrusted\",\"sandbox_policy\":{\"type\":\"danger-full-access\"},\"summary\":\"auto\"}"

    let model = reJsonRequiredString(meta, "model", outOk)
    if !checkOk(outOk, "sessionMeta model ok"): ok = false
    if !checkEqStr(model, "claude-opus-4-5", "sessionMeta model"): ok = false

    let cwd = reJsonRequiredString(meta, "cwd", outOk)
    if !checkOk(outOk, "sessionMeta cwd ok"): ok = false
    if !checkEqStr(cwd, "/home/user", "sessionMeta cwd"): ok = false

    let sessionId = reJsonRequiredString(meta, "session_id", outOk)
    if !checkOk(outOk, "sessionMeta session_id ok"): ok = false
    if !checkEqStr(sessionId, "abc123", "sessionMeta session_id"): ok = false

    let summary = reJsonRequiredString(meta, "summary", outOk)
    if !checkOk(outOk, "sessionMeta summary ok"): ok = false
    if !checkEqStr(summary, "auto", "sessionMeta summary"): ok = false

    if ok:
        echo("testSessionMetaParsing ok")
    return ok

# ── test 3: Approval policy parsing ─────────────────────────────

fn testApprovalPolicyParsing(): bool =
    var ok: bool = true
    var outOk: bool

    # String-based approval policy
    let stringPolicy = "{\"approval_policy\":\"untrusted\"}"
    let start1 = reJsonTopFieldValueStart(stringPolicy, "approval_policy")
    let val1 = reJsonStringAt(stringPolicy, start1, outOk)
    if !checkOk(outOk, "approvalPolicy string untrusted"): ok = false
    if !checkEqStr(val1, "untrusted", "approvalPolicy val"): ok = false

    # on-failure, on-request, never
    let ops: str[] = ["on-failure", "on-request", "never"]
    for i in 0..<ops.len:
        let p = cat3("{\"approval_policy\":\"", ops[i], "\"}")
        let s = reJsonTopFieldValueStart(p, "approval_policy")
        let v = reJsonStringAt(p, s, outOk)
        if !checkOk(outOk, cat("approvalPolicy ", ops[i])): ok = false
        if !checkEqStr(v, ops[i], cat("approvalPolicy val ", ops[i])): ok = false

    # Granular approval policy object
    let granularPolicy = "{\"approval_policy\":{\"granular\":{\"sandbox_approval\":true,\"rules\":false,\"mcp_elicitations\":true}}}"
    let granularStart = reJsonTopFieldValueStart(granularPolicy, "approval_policy")
    let granularObj = reJsonObjectAt(granularPolicy, granularStart)
    if !checkTrue(granularObj != "", "approvalPolicy granular obj exists"): ok = false
    if granularObj != "":
        let innerStart = reJsonTopFieldValueStart(granularObj, "granular")
        let innerObj = reJsonObjectAt(granularObj, innerStart)
        if !checkTrue(innerObj != "", "approvalPolicy granular inner exists"): ok = false
        if innerObj != "":
            if !checkTrue(reJsonRequiredBool(innerObj, "sandbox_approval", outOk), "approvalPolicy sandbox_approval"): ok = false
            if !checkFalse(reJsonRequiredBool(innerObj, "rules", outOk), "approvalPolicy rules false"): ok = false
            if !checkTrue(reJsonRequiredBool(innerObj, "mcp_elicitations", outOk), "approvalPolicy mcp_elicitations"): ok = false

    if ok:
        echo("testApprovalPolicyParsing ok")
    return ok

# ── test 4: Sandbox policy parsing ──────────────────────────────

fn testSandboxPolicyParsing(): bool =
    var ok: bool = true
    var outOk: bool

    let types: str[] = ["danger-full-access", "read-only", "external-sandbox", "workspace-write"]
    for i in 0..<types.len:
        let json = cat3("{\"sandbox_policy\":{\"type\":\"", types[i], "\"}}")
        let spStart = reJsonTopFieldValueStart(json, "sandbox_policy")
        let spObj = reJsonObjectAt(json, spStart)
        if spObj == "":
            echo(strutil.Join(["sandboxPolicy obj missing for ", types[i]], "")); ok = false
        else:
            let st = reJsonRequiredString(spObj, "type", outOk)
            if !checkEqStr(st, types[i], cat("sandboxPolicy type ", types[i])): ok = false

    if ok:
        echo("testSandboxPolicyParsing ok")
    return ok

# ── test 5: User message text elements parsing (byteRange/placeholder) ──

fn testTextElementParsing(): bool =
    var ok: bool = true
    var outOk: bool

    # Single text element with byte_range and placeholder
    let element = "{\"byte_range\":{\"start\":0,\"end\":5},\"placeholder\":\"...\"}"
    let brStart = reJsonTopFieldValueStart(element, "byte_range")
    let brObj = reJsonObjectAt(element, brStart)
    if !checkTrue(brObj != "", "textElem byte_range obj"): ok = false
    if brObj != "":
        let startRaw = reJsonRequiredIntRaw(brObj, "start", outOk)
        if !checkOk(outOk, "textElem byte_range start ok"): ok = false
        if !checkEqStr(startRaw, "0", "textElem byte_range start"): ok = false
        let endRaw = reJsonRequiredIntRaw(brObj, "end", outOk)
        if !checkOk(outOk, "textElem byte_range end ok"): ok = false
        if !checkEqStr(endRaw, "5", "textElem byte_range end"): ok = false

    let placeholder = reJsonRequiredString(element, "placeholder", outOk)
    if !checkOk(outOk, "textElem placeholder ok"): ok = false
    if !checkEqStr(placeholder, "...", "textElem placeholder"): ok = false

    # Text element without placeholder
    let elementNoPlaceholder = "{\"byte_range\":{\"start\":10,\"end\":20}}"
    let phStart = reJsonTopFieldValueStart(elementNoPlaceholder, "placeholder")
    if !checkTrue(phStart < 0, "textElem no placeholder"): ok = false

    # Text elements array — parse first element's byte_range.start
    let elementsArr = "[{\"byte_range\":{\"start\":0,\"end\":3},\"placeholder\":\"abc\"},{\"byte_range\":{\"start\":5,\"end\":8}}]"
    let firstObj = reJsonObjectAt(elementsArr, 1)
    if firstObj == "":
        echo("textElemArr first obj missing"); ok = false
    else:
        let brStart2 = reJsonTopFieldValueStart(firstObj, "byte_range")
        let brObj2 = reJsonObjectAt(firstObj, brStart2)
        if brObj2 == "":
            echo("textElemArr first byte_range missing"); ok = false
        else:
            let br = reJsonRequiredIntRaw(brObj2, "start", outOk)
            if !checkEqStr(br, "0", "textElemArr first start"): ok = false

    if ok:
        echo("testTextElementParsing ok")
    return ok

# ── test 6: Agent message phase parsing (commentary/final_answer) ──

fn testAgentMessagePhase(): bool =
    var ok: bool = true
    var outOk: bool

    # Phase: commentary
    let commentaryMsg = "{\"message\":\"thinking\",\"phase\":\"commentary\"}"
    let phase1 = reJsonRequiredString(commentaryMsg, "phase", outOk)
    if !checkOk(outOk, "agentPhase commentary ok"): ok = false
    if !checkEqStr(phase1, "commentary", "agentPhase commentary val"): ok = false

    # Phase: final_answer
    let finalMsg = "{\"message\":\"answer\",\"phase\":\"final_answer\"}"
    let phase2 = reJsonRequiredString(finalMsg, "phase", outOk)
    if !checkOk(outOk, "agentPhase final_answer ok"): ok = false
    if !checkEqStr(phase2, "final_answer", "agentPhase final_answer val"): ok = false

    # Phase: null (absent) — field should not be found
    let nullMsg = "{\"message\":\"no phase\"}"
    let phase3Start = reJsonTopFieldValueStart(nullMsg, "phase")
    if !checkTrue(phase3Start < 0, "agentPhase null absent"): ok = false

    if ok:
        echo("testAgentMessagePhase ok")
    return ok

# ── test 7: Memory citation parsing (rollout_ids → threadIds) ──

fn testMemoryCitation(): bool =
    var ok: bool = true
    var outOk: bool

    let citation = "{\"entries\":[{\"path\":\"f.txt\",\"line_start\":\"1\",\"line_end\":\"10\",\"note\":\"test note\"}],\"rollout_ids\":[\"r1\",\"r2\"]}"

    # Validate entries array exists
    let entriesStart = reJsonTopFieldValueStart(citation, "entries")
    let entriesArr = reJsonArrayAt(citation, entriesStart)
    if !checkTrue(entriesArr != "", "memCitation entries array"): ok = false

    # Validate first entry fields
    if entriesArr != "":
        let entryObj = reJsonObjectAt(entriesArr, 1)
        if entryObj == "":
            echo("memCitation entry obj missing"); ok = false
        else:
            let path = reJsonRequiredString(entryObj, "path", outOk)
            if !checkEqStr(path, "f.txt", "memCitation entry path"): ok = false
            let note = reJsonRequiredString(entryObj, "note", outOk)
            if !checkEqStr(note, "test note", "memCitation entry note"): ok = false

    # Validate rollout_ids array
    let ridsStart = reJsonTopFieldValueStart(citation, "rollout_ids")
    let ridsArr = reJsonArrayAt(citation, ridsStart)
    if !checkTrue(ridsArr != "", "memCitation rollout_ids array"): ok = false

    # Extract first rollout_id (equivalent to rollout_ids→threadIds conversion)
    if ridsArr != "":
        let firstRid = reJsonStringAt(ridsArr, 1, outOk)
        if !checkOk(outOk, "memCitation first rollout_id ok"): ok = false
        if !checkEqStr(firstRid, "r1", "memCitation first rollout_id val"): ok = false

    if ok:
        echo("testMemoryCitation ok")
    return ok

# ── test 8: Context compaction detection ────────────────────────

fn testContextCompaction(): bool =
    var ok: bool = true
    var outOk: bool

    # context_compacted event within an event_msg payload
    let json = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"context_compacted\",\"message\":\"compacted\",\"replacement_history\":[]}}"
    let payloadStart = reJsonTopFieldValueStart(json, "payload")
    let payloadObj = reJsonObjectAt(json, payloadStart)
    if !checkTrue(payloadObj != "", "compactEvent payload obj"): ok = false
    if payloadObj != "":
        let eventType = reJsonRequiredString(payloadObj, "type", outOk)
        if !checkOk(outOk, "compactEvent type ok"): ok = false
        if !checkEqStr(eventType, "context_compacted", "compactEvent type"): ok = false

    # compacted top-level type
    let compactedLine = "{\"type\":\"compacted\",\"payload\":{\"message\":\"ctx\",\"replacement_history\":[]}}"
    let cType = reJsonRequiredString(compactedLine, "type", outOk)
    if !checkOk(outOk, "compactedLine type ok"): ok = false
    if !checkEqStr(cType, "compacted", "compactedLine type"): ok = false

    if ok:
        echo("testContextCompaction ok")
    return ok

# ── test 9: Review mode enter/exit parsing ──────────────────────

fn testReviewMode(): bool =
    var ok: bool = true
    var outOk: bool

    # entered_review_mode with target and hint
    let enteredReview = "{\"target\":{\"type\":\"uncommittedChanges\"},\"user_facing_hint\":\"Please review the changes\"}"
    let targetStart = reJsonTopFieldValueStart(enteredReview, "target")
    let targetObj = reJsonObjectAt(enteredReview, targetStart)
    if !checkTrue(targetObj != "", "reviewEnter target obj"): ok = false
    if targetObj != "":
        let targetType = reJsonRequiredString(targetObj, "type", outOk)
        if !checkOk(outOk, "reviewEnter target type ok"): ok = false
        if !checkEqStr(targetType, "uncommittedChanges", "reviewEnter target type"): ok = false

    let hint = reJsonRequiredString(enteredReview, "user_facing_hint", outOk)
    if !checkOk(outOk, "reviewEnter hint ok"): ok = false
    if !checkEqStr(hint, "Please review the changes", "reviewEnter hint"): ok = false

    # exited_review_mode with review_output
    let exitedReview = "{\"review_output\":{\"findings\":[{\"severity\":\"high\",\"description\":\"bug\"}],\"overall_correctness\":\"correct\",\"overall_explanation\":\"LGTM\",\"overall_confidence_score\":0.95}}"
    let outputStart = reJsonTopFieldValueStart(exitedReview, "review_output")
    let outputObj = reJsonObjectAt(exitedReview, outputStart)
    if !checkTrue(outputObj != "", "reviewExit output obj"): ok = false
    if outputObj != "":
        let findingsStart = reJsonTopFieldValueStart(outputObj, "findings")
        let findingsArr = reJsonArrayAt(outputObj, findingsStart)
        if !checkTrue(findingsArr != "", "reviewExit findings arr"): ok = false

        let explanation = reJsonRequiredString(outputObj, "overall_explanation", outOk)
        if !checkOk(outOk, "reviewExit explanation ok"): ok = false
        if !checkEqStr(explanation, "LGTM", "reviewExit explanation"): ok = false

        let correctness = reJsonRequiredString(outputObj, "overall_correctness", outOk)
        if !checkOk(outOk, "reviewExit correctness ok"): ok = false
        if !checkEqStr(correctness, "correct", "reviewExit correctness"): ok = false

    if ok:
        echo("testReviewMode ok")
    return ok

# ── test 10: Task / turn start and complete parsing ─────────────

fn testTaskStartComplete(): bool =
    var ok: bool = true
    var outOk: bool

    # turn_started
    let turnStarted = "{\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"turn-1\",\"started_at\":\"1715000000\"}}"
    let payloadStart = reJsonTopFieldValueStart(turnStarted, "payload")
    let payloadObj = reJsonObjectAt(turnStarted, payloadStart)
    if payloadObj == "":
        echo("taskStart payload obj missing"); ok = false
    else:
        let turnId = reJsonRequiredString(payloadObj, "turn_id", outOk)
        if !checkOk(outOk, "taskStart turn_id ok"): ok = false
        if !checkEqStr(turnId, "turn-1", "taskStart turn_id"): ok = false

        let startedAt = reJsonRequiredString(payloadObj, "started_at", outOk)
        if !checkOk(outOk, "taskStart started_at ok"): ok = false
        if !checkEqStr(startedAt, "1715000000", "taskStart started_at"): ok = false

    # turn_complete with turn_id, completed_at, duration_ms
    let turnComplete = "{\"payload\":{\"type\":\"turn_complete\",\"turn_id\":\"turn-1\",\"completed_at\":\"1715000100\",\"duration_ms\":\"100000\"}}"
    let pcStart = reJsonTopFieldValueStart(turnComplete, "payload")
    let pcObj = reJsonObjectAt(turnComplete, pcStart)
    if pcObj == "":
        echo("taskComplete payload obj missing"); ok = false
    else:
        let ctId = reJsonRequiredString(pcObj, "turn_id", outOk)
        if !checkOk(outOk, "taskComplete turn_id ok"): ok = false
        if !checkEqStr(ctId, "turn-1", "taskComplete turn_id"): ok = false

        let completedAt = reJsonRequiredString(pcObj, "completed_at", outOk)
        if !checkOk(outOk, "taskComplete completed_at ok"): ok = false
        if !checkEqStr(completedAt, "1715000100", "taskComplete completed_at"): ok = false

        let dur = reJsonRequiredString(pcObj, "duration_ms", outOk)
        if !checkOk(outOk, "taskComplete duration_ms ok"): ok = false
        if !checkEqStr(dur, "100000", "taskComplete duration_ms"): ok = false

    if ok:
        echo("testTaskStartComplete ok")
    return ok

# ── test 11: Error / abort parsing ──────────────────────────────

fn testErrorAbortParsing(): bool =
    var ok: bool = true
    var outOk: bool

    # Error event
    let errorJson = "{\"payload\":{\"type\":\"error\",\"message\":\"API rate limit exceeded\",\"codex_error_info\":\"usage_limit_exceeded\"}}"
    let payloadStart = reJsonTopFieldValueStart(errorJson, "payload")
    let payloadObj = reJsonObjectAt(errorJson, payloadStart)
    if payloadObj == "":
        echo("errorEvent payload obj missing"); ok = false
    else:
        let errMsg = reJsonRequiredString(payloadObj, "message", outOk)
        if !checkOk(outOk, "errorEvent message ok"): ok = false
        if !checkEqStr(errMsg, "API rate limit exceeded", "errorEvent message"): ok = false

        let codexInfo = reJsonRequiredString(payloadObj, "codex_error_info", outOk)
        if !checkOk(outOk, "errorEvent codex_error_info ok"): ok = false
        if !checkEqStr(codexInfo, "usage_limit_exceeded", "errorEvent codex_error_info"): ok = false

    # turn_aborted with reason
    let abortJson = "{\"payload\":{\"type\":\"turn_aborted\",\"reason\":\"interrupted\",\"completed_at\":\"1715000200\",\"duration_ms\":\"50000\"}}"
    let paStart = reJsonTopFieldValueStart(abortJson, "payload")
    let paObj = reJsonObjectAt(abortJson, paStart)
    if paObj == "":
        echo("abortEvent payload obj missing"); ok = false
    else:
        let reason = reJsonRequiredString(paObj, "reason", outOk)
        if !checkOk(outOk, "abortEvent reason ok"): ok = false
        if !checkEqStr(reason, "interrupted", "abortEvent reason"): ok = false

    # Valid abort reasons: interrupted, replaced, review_ended, budget_limited
    let validReasons: str[] = ["interrupted", "replaced", "review_ended", "budget_limited"]
    for i in 0..<validReasons.len:
        let r = validReasons[i]
        let testJson = cat3("{\"reason\":\"", r, "\"}")
        let parsed = reJsonRequiredString(testJson, "reason", outOk)
        if !checkOk(outOk, cat("abortReason ", r)): ok = false
        if !checkEqStr(parsed, r, cat("abortReason val ", r)): ok = false

    if ok:
        echo("testErrorAbortParsing ok")
    return ok

# ── test 12: Turn boundary parsing (multi-turn JSONL replay) ────

fn testTurnBoundaryParsing(): bool =
    var ok: bool = true
    var outOk: bool

    # Simulate multi-line JSONL: 2 turns with user+agent items
    let turn1User = "{\"payload\":{\"type\":\"user_message\",\"message\":\"hello\",\"text_elements\":[]}}"
    let turn1Agent = "{\"payload\":{\"type\":\"agent_message\",\"message\":\"hi there\",\"phase\":\"final_answer\"}}"

    let turn2User = "{\"payload\":{\"type\":\"user_message\",\"message\":\"world\",\"text_elements\":[]}}"

    # Parse turn1 user_message
    let u1s = reJsonTopFieldValueStart(turn1User, "payload")
    let u1o = reJsonObjectAt(turn1User, u1s)
    if u1o == "":
        echo("turnBoundary t1 user payload missing"); ok = false
    else:
        let msg1 = reJsonRequiredString(u1o, "message", outOk)
        if !checkOk(outOk, "turnBoundary t1 user msg ok"): ok = false
        if !checkEqStr(msg1, "hello", "turnBoundary t1 user msg"): ok = false

    # Parse turn1 agent_message: phase and message
    let a1s = reJsonTopFieldValueStart(turn1Agent, "payload")
    let a1o = reJsonObjectAt(turn1Agent, a1s)
    if a1o == "":
        echo("turnBoundary t1 agent payload missing"); ok = false
    else:
        let agentMsg = reJsonRequiredString(a1o, "message", outOk)
        if !checkOk(outOk, "turnBoundary t1 agent msg ok"): ok = false
        if !checkEqStr(agentMsg, "hi there", "turnBoundary t1 agent msg"): ok = false

        let phase = reJsonRequiredString(a1o, "phase", outOk)
        if !checkOk(outOk, "turnBoundary t1 agent phase ok"): ok = false
        if !checkEqStr(phase, "final_answer", "turnBoundary t1 agent phase"): ok = false

    # Parse turn2 user_message
    let u2s = reJsonTopFieldValueStart(turn2User, "payload")
    let u2o = reJsonObjectAt(turn2User, u2s)
    if u2o == "":
        echo("turnBoundary t2 user payload missing"); ok = false
    else:
        let msg2 = reJsonRequiredString(u2o, "message", outOk)
        if !checkOk(outOk, "turnBoundary t2 user msg ok"): ok = false
        if !checkEqStr(msg2, "world", "turnBoundary t2 user msg"): ok = false

    if ok:
        echo("testTurnBoundaryParsing ok")
    return ok

# ── Main ─────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testLineParsing(): allOk = false
    if !testSessionMetaParsing(): allOk = false
    if !testApprovalPolicyParsing(): allOk = false
    if !testSandboxPolicyParsing(): allOk = false
    if !testTextElementParsing(): allOk = false
    if !testAgentMessagePhase(): allOk = false
    if !testMemoryCitation(): allOk = false
    if !testContextCompaction(): allOk = false
    if !testReviewMode(): allOk = false
    if !testTaskStartComplete(): allOk = false
    if !testErrorAbortParsing(): allOk = false
    if !testTurnBoundaryParsing(): allOk = false
    echo("ALL TESTS COMPLETE")
    if allOk:
        echo("rust_csg_rollout_reader_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_rollout_reader_relfacts_smoke FAILED")
        return 1
