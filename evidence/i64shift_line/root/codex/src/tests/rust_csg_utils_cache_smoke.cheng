import cheng/codex/crates/utils_cache/utils_cache as cache

fn main(): int32 =
    let handle = cache.RustCsgUtilsCacheNew(2)
    var evicted: str
    var ok: bool
    cache.RustCsgUtilsCachePut(handle, "a", "one", evicted, ok)
    if !ok:
        return 1
    var value: str
    var got: bool
    cache.RustCsgUtilsCacheGet(handle, "a", value, got)
    if !got || value != "one":
        return 1
    cache.RustCsgUtilsCacheRemove(handle, "a", got)
    if !got:
        return 1
    cache.RustCsgUtilsCacheGet(handle, "a", value, got)
    if got:
        return 1
    echo("rust_csg_utils_cache_smoke ok")
    return 0
