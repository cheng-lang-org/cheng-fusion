import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_hooks_history_oracle as oracle

fn RustCsgTuiChatwidgetHooksHistoryCheck(path: str,
                                          expectedSource: str,
                                          expectedExpression: str,
                                          expectedBody: str,
                                          name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 12:
        echo("FAIL usage: rust_csg_tui_chatwidget_hooks_history_oracle_smoke <11 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "active_combined", oracle.RustCsgTuiChatwidgetUnifiedExecNonEmptyThenEmptyActive(), "unified_exec_non_empty_then_empty_active")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "snapshot", oracle.RustCsgTuiChatwidgetUnifiedExecUnknownEndWithActiveExploringCell(), "unified_exec_unknown_end_with_active_exploring_cell")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUnifiedExecEmptyThenNonEmptyAfter(), "unified_exec_empty_then_non_empty_after")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUnifiedExecNonEmptyThenEmptyAfter(), "unified_exec_non_empty_then_empty_after")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetPreToolUseHookEventsRender(), "pre_tool_use_hook_events_render_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetPostToolUseHookEventsRender(), "post_tool_use_hook_events_render_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetSessionStartHookEventsRender(), "session_start_hook_events_render_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetUserPromptSubmitHookNotificationsRender(), "user_prompt_submit_app_server_hook_notifications_render_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "snapshot", oracle.RustCsgTuiChatwidgetInterruptClearsUnifiedExecWaitStreak(), "interrupt_clears_unified_exec_wait_streak")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "snapshot", oracle.RustCsgTuiChatwidgetInterruptPreservesUnifiedExecWaitStreak(), "interrupt_preserves_unified_exec_wait_streak")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetHooksHistoryCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "combined", oracle.RustCsgTuiChatwidgetAppServerCollabWaitItemsRenderHistory(), "app_server_collab_wait_items_render_history")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_hooks_history_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_hooks_history_oracle_smoke FAILED")
    return exitCode
