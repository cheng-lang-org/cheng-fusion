fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgExecResumeLookupPlan =\n        kind: str\n        method: str\n        directThreadId: str\n        threadListParamsJson: str\n        threadListPlanJson: str\n        parseError: str\n        blockedReason: str\n\nfn RustCsgExecResumeLookupJsonStringArrayOne(value: str): str =\nfn RustCsgExecResumeLookupHexValue(ch: char): int32 =\nfn RustCsgExecResumeLookupIsUuid(value: str): bool =\nfn RustCsgExecResumeLookupFillBaseThreadListParams(params: var types.RustCsgThreadListParams) =\nfn RustCsgExecResumeLookupFillLastParams(params: var types.RustCsgThreadListParams, configModelProviderId: str) =\nfn RustCsgExecResumeLookupFillNameParams(params: var types.RustCsgThreadListParams, sessionName: str) =\nfn RustCsgExecResumeLookupPlanFromParamsInto(kind: str, params: var types.RustCsgThreadListParams, fallbackProvider: str, blockedReason: str, result: var RustCsgExecResumeLookupPlan) =\nfn RustCsgExecResumeLookupPlanFromExecPlanInto(execPlan: var plan.RustCsgExecPlan, configModelProviderId: str, result: var RustCsgExecResumeLookupPlan) =\nfn RustCsgExecResumeLookupPlanToJson(lookupPlan: var RustCsgExecResumeLookupPlan): str =\nfn RustCsgExecResumeLookupJson(kind: str, method: str, directThreadId: str, paramsJson: str, listPlanJson: str, parseError: str, blockedReason: str): str =\nfn RustCsgExecResumeLookupJsonFromParams(kind: str, params: var types.RustCsgThreadListParams, fallbackProvider: str, blockedReason: str): str =\nfn RustCsgExecResumeLookupJsonFromExecPlan(execPlan: var plan.RustCsgExecPlan, configModelProviderId: str): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\texec/resume_lookup\nLocalType\texec/resume_lookup\tRustCsgExecResumeLookupPlan\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tkind\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tmethod\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tdirectThreadId\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tthreadListParamsJson\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tthreadListPlanJson\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tparseError\tstr\nHasField\texec/resume_lookup\tRustCsgExecResumeLookupPlan\tblockedReason\tstr\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupJsonStringArrayOne\tstr\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupHexValue\tint32\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupIsUuid\tbool\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupFillBaseThreadListParams\t\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupFillLastParams\t\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupFillNameParams\t\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupPlanFromParamsInto\t\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupPlanFromExecPlanInto\t\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupPlanToJson\tstr\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupJson\tstr\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupJsonFromParams\tstr\nFunction\texec/resume_lookup\tRustCsgExecResumeLookupJsonFromExecPlan\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 7, "source field count")
    assert(ecn == 12, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 7, "oracle field count")
    assert(ocn == 12, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_exec_resume_lookup_relfacts_smoke ok")
    return 0
