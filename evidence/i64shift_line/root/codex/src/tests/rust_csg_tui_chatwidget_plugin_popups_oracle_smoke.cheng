import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_plugin_popups_oracle as oracle

fn RustCsgTuiChatwidgetPluginPopupsCheck(path: str,
                                          expectedSource: str,
                                          expectedExpression: str,
                                          expectedBody: str,
                                          name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 6:
        echo("FAIL usage: rust_csg_tui_chatwidget_plugin_popups_oracle_smoke <5 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetPluginPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPluginDetailPopupInstallable(), "plugin_detail_popup_installable")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPluginPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPluginDetailPopupInstalled(), "plugin_detail_popup_installed")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPluginPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPluginsPopupCuratedMarketplace(), "plugins_popup_curated_marketplace")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPluginPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPluginsPopupLoadingState(), "plugins_popup_loading_state")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPluginPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPluginsPopupSearchFiltered(), "plugins_popup_search_filtered")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_plugin_popups_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_plugin_popups_oracle_smoke FAILED")
    return exitCode
