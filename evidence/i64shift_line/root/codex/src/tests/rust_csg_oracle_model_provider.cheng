import cheng/codex/crates/model_provider/model_provider as m
fn main(): int32 =
    var pass: int32
    if m.modelProviderGlobMatch("gpt-4", "gpt-4"): pass = pass + 1
    if !m.modelProviderGlobMatch("gpt-4", "claude-3"): pass = pass + 1
    if m.modelProviderPrefixMatch("gpt-", "gpt-4"): pass = pass + 1
    if !m.modelProviderPrefixMatch("gpt-", "claude-3"): pass = pass + 1
    if pass == 4: echo("rust_csg_oracle_model_provider ok"); return 0
    echo("oracle FAIL"); return 1
main()
