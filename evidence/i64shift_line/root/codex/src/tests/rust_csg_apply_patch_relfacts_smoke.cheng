fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgParsePatchResult =\n        ok: bool\n        error: str\n        hunkTags: int32[]\n        hunkPaths: str[]\n        hunkContents: str[]\n        oldStarts: int32[]\n        oldCounts: int32[]\n        newStarts: int32[]\n        newCounts: int32[]\n        lineCounts: int32[]\n        hunkLines: str[]\n\nfn generateUnifiedDiff(oldFile: str, newFile: str, oldContent: str, newContent: str): str =\nfn applyHunkToContent(content: str, oldStart: int32, oldCount: int32, newStart: int32, newCount: int32, hunkOps: str[], outResult: var str): bool =\nfn patchValidateSyntax(patch: str, outError: var str): bool =\nfn patchComputeStats(patch: str, outAdditions: var int32, outDeletions: var int32, outFilesChanged: var int32, outError: var str) =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tapply_patch\nLocalType\tapply_patch\tRustCsgParsePatchResult\nHasField\tapply_patch\tRustCsgParsePatchResult\tok\tbool\nHasField\tapply_patch\tRustCsgParsePatchResult\terror\tstr\nHasField\tapply_patch\tRustCsgParsePatchResult\thunkTags\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\thunkPaths\tstr[]\nHasField\tapply_patch\tRustCsgParsePatchResult\thunkContents\tstr[]\nHasField\tapply_patch\tRustCsgParsePatchResult\toldStarts\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\toldCounts\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\tnewStarts\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\tnewCounts\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\tlineCounts\tint32[]\nHasField\tapply_patch\tRustCsgParsePatchResult\thunkLines\tstr[]\nFunction\tapply_patch\tgenerateUnifiedDiff\tstr\nFunction\tapply_patch\tapplyHunkToContent\tbool\nFunction\tapply_patch\tpatchValidateSyntax\tbool\nFunction\tapply_patch\tpatchComputeStats\t\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 11, "source field count")
    assert(ecn == 4, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 11, "oracle field count")
    assert(ocn == 4, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_apply_patch_relfacts_smoke ok")
    return 0
