import std/cmdline
import std/strings as strutil
import cheng/codex/tui/migration_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

fn RustCsgTuiMigrationFirstDiff(expected: str, actual: str): str =
    var limit: int32 = strings.Len(expected)
    if strings.Len(actual) < limit:
        limit = strings.Len(actual)
    var line: int32 = 1
    var col: int32 = 1
    var i: int32 = 0
    while i < limit:
        if expected[i] != actual[i]:
            return strutil.Join(["line ", strings.IntToStr(line), " col ", strings.IntToStr(col), " byte ", strings.IntToStr(i)], "")
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1
    if strings.Len(expected) != strings.Len(actual):
        return strutil.Join(["length diverged at line ", strings.IntToStr(line), " col ", strings.IntToStr(col), " byte ", strings.IntToStr(limit)], "")
    return "no diff"

# ── Smoke test entry ─────────────────────────────────────────────────────────

fn main(): int32 =
    if cmdline.argCount() != 7:
        echo("FAIL usage: rust_csg_tui_migration_oracle_smoke <snap1> ... <snap6>")
        return 1

    var exitCode: int32 = 0

    # ── 1. model_migration_prompt ───────────────────────────────────────────
    let p1: str = cmdline.argStr(1)
    let s1 = snap.RustCsgTuiOracleSnapshotParseFile(p1)
    if !s1.ok:
        echo(strutil.Join(["FAIL: model_migration_prompt parse: ", p1, ": ", s1.error], ""))
        return 1
    if s1.source != "tui/src/model_migration.rs":
        echo(strutil.Join(["FAIL: model_migration_prompt source: ", s1.source], ""))
        return 1
    if s1.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: model_migration_prompt expr: ", s1.expression], ""))
        return 1
    let r1: str = oracle.RustCsgTuiModelMigrationPromptFixture()
    if r1.len == 0:
        echo("FAIL: model_migration_prompt empty render"); return 1
    if r1 != s1.body:
        echo(strutil.Join(["FAIL: model_migration_prompt (expected ", strings.IntToStr(s1.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r1)), "; ", RustCsgTuiMigrationFirstDiff(s1.body, r1), ")"], ""))
        exitCode = 1
    else:
        echo("ok: model_migration_prompt")

    # ── 2. model_migration_prompt_gpt5_codex ────────────────────────────────
    let p2: str = cmdline.argStr(2)
    let s2 = snap.RustCsgTuiOracleSnapshotParseFile(p2)
