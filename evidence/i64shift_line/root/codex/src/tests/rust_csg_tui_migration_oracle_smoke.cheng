        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex source: ", s2.source], "")); return 1
    if s2.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex expr: ", s2.expression], "")); return 1
    let r2: str = oracle.RustCsgTuiModelMigrationPromptGpt5CodexFixture()
    if r2.len == 0:
        echo("FAIL: model_migration_prompt_gpt5_codex empty render"); return 1
    if r2 != s2.body:
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex (expected ", strings.IntToStr(s2.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r2)), "; ", RustCsgTuiMigrationFirstDiff(s2.body, r2), ")"], ""))
        exitCode = 1
    else:
        echo("ok: model_migration_prompt_gpt5_codex")

    # ── 3. model_migration_prompt_gpt5_codex_mini ───────────────────────────
    let p3: str = cmdline.argStr(3)
    let s3 = snap.RustCsgTuiOracleSnapshotParseFile(p3)
    if !s3.ok:
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex_mini parse: ", p3, ": ", s3.error], "")); return 1
    if s3.source != "tui/src/model_migration.rs":
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex_mini source: ", s3.source], "")); return 1
    if s3.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex_mini expr: ", s3.expression], "")); return 1
    let r3: str = oracle.RustCsgTuiModelMigrationPromptGpt5CodexMiniFixture()
    if r3.len == 0:
        echo("FAIL: model_migration_prompt_gpt5_codex_mini empty render"); return 1
    if r3 != s3.body:
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_codex_mini (expected ", strings.IntToStr(s3.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r3)), "; ", RustCsgTuiMigrationFirstDiff(s3.body, r3), ")"], ""))
        exitCode = 1
    else:
        echo("ok: model_migration_prompt_gpt5_codex_mini")

    # ── 4. model_migration_prompt_gpt5_family ───────────────────────────────
    let p4: str = cmdline.argStr(4)
    let s4 = snap.RustCsgTuiOracleSnapshotParseFile(p4)
    if !s4.ok:
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_family parse: ", p4, ": ", s4.error], "")); return 1
    if s4.source != "tui/src/model_migration.rs":
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_family source: ", s4.source], "")); return 1
    if s4.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_family expr: ", s4.expression], "")); return 1
    let r4: str = oracle.RustCsgTuiModelMigrationPromptGpt5FamilyFixture()
    if r4.len == 0:
        echo("FAIL: model_migration_prompt_gpt5_family empty render"); return 1
    if r4 != s4.body:
        echo(strutil.Join(["FAIL: model_migration_prompt_gpt5_family (expected ", strings.IntToStr(s4.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r4)), "; ", RustCsgTuiMigrationFirstDiff(s4.body, r4), ")"], ""))
        exitCode = 1
    else:
        echo("ok: model_migration_prompt_gpt5_family")

    # ── 5. update_prompt_modal ──────────────────────────────────────────────
    let p5: str = cmdline.argStr(5)
    let s5 = snap.RustCsgTuiOracleSnapshotParseFile(p5)
    if !s5.ok:
        echo(strutil.Join(["FAIL: update_prompt_modal parse: ", p5, ": ", s5.error], "")); return 1
    if s5.source != "tui/src/update_prompt.rs":
        echo(strutil.Join(["FAIL: update_prompt_modal source: ", s5.source], "")); return 1
    if s5.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: update_prompt_modal expr: ", s5.expression], "")); return 1
    let r5: str = oracle.RustCsgTuiUpdatePromptModalFixture()
    if r5.len == 0:
        echo("FAIL: update_prompt_modal empty render"); return 1
    if r5 != s5.body:
        echo(strutil.Join(["FAIL: update_prompt_modal (expected ", strings.IntToStr(s5.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r5)), "; ", RustCsgTuiMigrationFirstDiff(s5.body, r5), ")"], ""))
        exitCode = 1
    else:
        echo("ok: update_prompt_modal")

    # ── 6. model_migration_prompt_shows_for_hidden_model ───────────────────
    let p6: str = cmdline.argStr(6)
    let s6 = snap.RustCsgTuiOracleSnapshotParseFile(p6)
    if !s6.ok:
        echo(strutil.Join(["FAIL: model_migration_hidden_model parse: ", p6, ": ", s6.error], "")); return 1
    if s6.source != "tui/src/app.rs":
        echo(strutil.Join(["FAIL: model_migration_hidden_model source: ", s6.source], "")); return 1
    if s6.expression != "model_migration_copy_to_plain_text(&copy)":
        echo(strutil.Join(["FAIL: model_migration_hidden_model expr: ", s6.expression], "")); return 1
    let r6: str = oracle.RustCsgTuiModelMigrationHiddenModelPlainTextFixture()
    if r6.len == 0:
        echo("FAIL: model_migration_hidden_model empty render"); return 1
    if r6 != s6.body:
        echo(strutil.Join(["FAIL: model_migration_hidden_model (expected ", strings.IntToStr(s6.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(r6)), "; ", RustCsgTuiMigrationFirstDiff(s6.body, r6), ")"], ""))
        exitCode = 1
    else:
        echo("ok: model_migration_hidden_model")

    if exitCode == 0:
        echo("rust_csg_tui_migration_oracle_smoke ok")
    else:
        echo("rust_csg_tui_migration_oracle_smoke FAILED")
    return exitCode
