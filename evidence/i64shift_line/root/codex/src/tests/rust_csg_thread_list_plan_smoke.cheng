import std/strings
import std/strutils as strutil
import cheng/codex/app_server/thread_list
import cheng/codex/protocol/types

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqInt32(actual: int32, expected: int32, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", strings.IntToStr(expected), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn main(): int32 =
    var failures: int32
    var params: types.RustCsgThreadListParams
    let plan = thread_list.RustCsgThreadListPlanFromParams(params, "openai")
    failures = failures + CheckEqInt32(plan.pageSize, 25, "default page size")
    failures = failures + CheckEqStr(plan.sortKey, "created_at", "default sort key")
    failures = failures + CheckEqStr(plan.sortDirection, "desc", "default sort direction")
    failures = failures + CheckEqStr(plan.modelProviderFilterJson, "[\"openai\"]", "default provider filter")
    failures = failures + CheckEqStr(plan.allowedSourcesJson,
                                     "[\"cli\",\"vscode\",\"{\\\"custom\\\":\\\"atlas\\\"}\",\"{\\\"custom\\\":\\\"chatgpt\\\"}\"]",
                                     "default allowed sources")
    failures = failures + CheckEqStr(plan.blockedReason, "", "blocked reason")
    failures = failures + CheckEqBool(plan.useStateDbOnly, false, "state db only")
    if failures != 0:
        echo(strutil.Join(["rust_csg_thread_list_plan_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_thread_list_plan_smoke ok")
    return 0
