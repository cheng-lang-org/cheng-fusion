import cheng/codex/crates/app_server/app_server as m
fn main(): int32 =
    var pass: int32
    var r = m.RustCsgBuildThreadStartRequest("sess-1", "gpt-4", "/tmp")
    if r.len > 0: pass = pass + 1
    var e = m.RustCsgJsonEscape("hello")
    if e.len > 0: pass = pass + 1
    if pass == 2: echo("rust_csg_oracle_app_server ok"); return 0
    echo("oracle FAIL"); return 1
main()
