import cheng/codex/crates/model_provider_info/model_provider_info as mpi

fn main(): int32 =
    var pass: int32

    # effective* clamp functions
    if mpi.effectiveRequestMaxRetries(3) == 3: pass = pass + 1
    if mpi.effectiveRequestMaxRetries(-1) == 4: pass = pass + 1
    if mpi.effectiveRequestMaxRetries(200) == 100: pass = pass + 1
    if mpi.effectiveStreamMaxRetries(-1) == 5: pass = pass + 1
    if mpi.effectiveStreamIdleTimeoutMs(-1) == 300000: pass = pass + 1
    if mpi.effectiveWebsocketConnectTimeoutMs(-1) == 15000: pass = pass + 1

    # modelProviderToUrl
    if mpi.modelProviderToUrl("OpenAI") == "https://api.openai.com/v1": pass = pass + 1
    if mpi.modelProviderToUrl("unknown") == "": pass = pass + 1

    # modelProviderToConfigJson (hardcoded cases)
    if mpi.modelProviderToConfigJson("OpenAI") == "{\"name\":\"OpenAI\",\"baseUrl\":\"https://api.openai.com/v1\",\"requiresOpenaiAuth\":true,\"supportsWebsockets\":true,\"hasHttpHeaders\":true,\"hasEnvHttpHeaders\":true}": pass = pass + 1

    # modelProviderCompareConfigs
    var cfgA = "{\"name\":\"OpenAI\",\"baseUrl\":\"https://api.openai.com/v1\",\"requiresOpenaiAuth\":true}"
    var cfgB = "{\"name\":\"OpenAI\",\"baseUrl\":\"https://api.openai.com/v1\",\"requiresOpenaiAuth\":true}"
    if mpi.modelProviderCompareConfigs(cfgA, cfgB): pass = pass + 1

    # modelProviderDiff
    var diffResult = mpi.modelProviderDiff(cfgA, cfgB)
    if diffResult == "{}": pass = pass + 1

    # validateProvider
    var validateErr: str
    if mpi.validateProvider(false, false, false, false, "", false, false, validateErr): pass = pass + 1

    if pass == 12:
        echo("rust_csg_oracle_model_provider_info ok")
        return 0
    echo("oracle FAIL")
    return 1

main()