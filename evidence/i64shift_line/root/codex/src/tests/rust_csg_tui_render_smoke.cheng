# TUI render smoke test: verify oracle rendering functions produce correct output.
import std/strings
import cheng/codex/tui/diff_render_oracle as oracle

fn checkNonEmpty(label: str, rendered: str): bool =
    if rendered.len == 0:
        echo(strings.ConcatStr("FAIL: empty render for ", label))
        return false
    return true

fn main(): int32 =
    if !checkNonEmpty("apply_add_block", oracle.RustCsgTuiDiffRenderOracleApplyAddBlockFixture()):
        return 1
    if !checkNonEmpty("apply_delete_block", oracle.RustCsgTuiDiffRenderOracleApplyDeleteBlockFixture()):
        return 1
    if !checkNonEmpty("apply_update_block", oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockFixture()):
        return 1
    if !checkNonEmpty("diff_gallery_80x24", oracle.RustCsgTuiDiffRenderOracleDiffGallery80x24Fixture()):
        return 1
    if !checkNonEmpty("diff_gallery_94x35", oracle.RustCsgTuiDiffRenderOracleDiffGallery94x35Fixture()):
        return 1
    if !checkNonEmpty("diff_gallery_120x40", oracle.RustCsgTuiDiffRenderOracleDiffGallery120x40Fixture()):
        return 1
    echo("rust_csg_tui_render_smoke ok")
    return 0
