const RustCsgCodexFsRemoveOptions: str = "codex_file_system::RemoveOptions"

# Manual string contains (avoids cold-compiler bug with strutil.Contains + '"').
fn manualContains(haystack: str, needle: str): bool =
    var i: int32 = 0
    while i < haystack.len:
        if haystack[i] == needle[0]:
            var allMatch: bool = true
            var j: int32 = 1
            while j < needle.len:
                if i + j >= haystack.len || haystack[i + j] != needle[j]:
                    allMatch = false
                    break
                j = j + 1
            if allMatch:
                return true
        i = i + 1
    return false

# Classify an exec server request (JSON string) into a request type.
fn execServerClassifyRequest(request: str): str =
    if manualContains(request, "\"type\":\"execute\""):
        return "execute"
    if manualContains(request, "\"type\":\"list_files\""):
        return "list_files"
    if manualContains(request, "\"type\":\"read_file\""):
        return "read_file"
    if manualContains(request, "\"type\":\"write_file\""):
        return "write_file"
    if manualContains(request, "\"type\":\"get_environment\""):
        return "get_environment"
    return "unknown"

# ── Tests ──────────────────────────────────────────────────────────────────

fn testExecServerProcessEventConstants(): bool =
    if RustCsgExecProcessEventOutput == 0 &&
       RustCsgExecProcessEventExited == 1 &&
       RustCsgExecProcessEventClosed == 2 &&
       RustCsgExecProcessEventFailed == 3:
        echo("testExecServerProcessEventConstants ok")
        return true
    echo("FAIL testExecServerProcessEventConstants")
    return false

fn testExecServerOutputStreamConstants(): bool =
    if RustCsgExecOutputStreamStdout == 0 &&
       RustCsgExecOutputStreamStderr == 1 &&
       RustCsgExecOutputStreamPty == 2:
        echo("testExecServerOutputStreamConstants ok")
        return true
    echo("FAIL testExecServerOutputStreamConstants")
    return false

# ── New function tests ──────────────────────────────────────────────────

fn testExecServerClassifyRequestExecute(): bool =
    let result = execServerClassifyRequest("{\"type\":\"execute\",\"command\":\"ls\"}")
    if result != "execute":
        echo(strutil.Join(["FAIL: expected execute, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestExecute ok")
    return true

fn testExecServerClassifyRequestListFiles(): bool =
    let result = execServerClassifyRequest("{\"type\":\"list_files\",\"path\":\"/tmp\"}")
    if result != "list_files":
        echo(strutil.Join(["FAIL: expected list_files, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestListFiles ok")
    return true

fn testExecServerClassifyRequestReadFile(): bool =
    let result = execServerClassifyRequest("{\"type\":\"read_file\",\"path\":\"/tmp/test.txt\"}")
    if result != "read_file":
        echo(strutil.Join(["FAIL: expected read_file, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestReadFile ok")
    return true

fn testExecServerClassifyRequestWriteFile(): bool =
    let result = execServerClassifyRequest("{\"type\":\"write_file\",\"path\":\"/tmp/test.txt\",\"content\":\"hello\"}")
    if result != "write_file":
        echo(strutil.Join(["FAIL: expected write_file, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestWriteFile ok")
    return true

fn testExecServerClassifyRequestGetEnv(): bool =
    let result = execServerClassifyRequest("{\"type\":\"get_environment\"}")
    if result != "get_environment":
        echo(strutil.Join(["FAIL: expected get_environment, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestGetEnv ok")
    return true

fn testExecServerClassifyRequestUnknown(): bool =
    let result = execServerClassifyRequest("{\"type\":\"unknown_op\"}")
    if result != "unknown":
        echo(strutil.Join(["FAIL: expected unknown, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestUnknown ok")
    return true

fn testExecServerClassifyRequestEmpty(): bool =
    let result = execServerClassifyRequest("")
    if result != "unknown":
        echo(strutil.Join(["FAIL: expected unknown for empty, got=", result], ""))
        return false
    echo("testExecServerClassifyRequestEmpty ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testExecServerProcessEventConstants(): allOk = false
    if !testExecServerOutputStreamConstants(): allOk = false
    if !testExecServerClassifyRequestExecute(): allOk = false
    if !testExecServerClassifyRequestListFiles(): allOk = false
    if !testExecServerClassifyRequestReadFile(): allOk = false
    if !testExecServerClassifyRequestWriteFile(): allOk = false
    if !testExecServerClassifyRequestGetEnv(): allOk = false
    if !testExecServerClassifyRequestUnknown(): allOk = false
    if !testExecServerClassifyRequestEmpty(): allOk = false
    if allOk:
        echo("rust_csg_exec_server_types_smoke ok")
        return 0
    echo("rust_csg_exec_server_types_smoke FAILED")
    return 1
