const RustCsgExecProcessEventExited: int32 = 1
const RustCsgExecProcessEventClosed: int32 = 2
const RustCsgExecProcessEventFailed: int32 = 3

# ── ExecOutputStream variant constants (int32, testable) ───────────────────
