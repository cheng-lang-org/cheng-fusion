const RustCsgCodexFsExecutorFileSystem: str = "codex_file_system::ExecutorFileSystem"
const RustCsgCodexFsFileMetadata: str = "codex_file_system::FileMetadata"
const RustCsgCodexFsFileSystemResult: str = "codex_file_system::FileSystemResult"
