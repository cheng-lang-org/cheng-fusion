import cheng/codex/crates/code_mode/code_mode as m

fn main(): int32 =
    var pass: int32

    # normalizeIdentifier: deterministic behavior
    if m.RustCsgCodeModeNormalizeIdentifier("hello-world") == "hello_world": pass = pass + 1
    if m.RustCsgCodeModeNormalizeIdentifier("hello_world") == "hello_world": pass = pass + 1
    if m.RustCsgCodeModeNormalizeIdentifier("") == "_": pass = pass + 1

    # detectLanguage: deterministic behavior
    if m.RustCsgCodeModeDetectLanguage("console") == "javascript": pass = pass + 1
    if m.RustCsgCodeModeDetectLanguage("") == "": pass = pass + 1

    if pass == 5:
        echo("rust_csg_oracle_code_mode ok")
        return 0
    echo("oracle FAIL")
    return 1

main()