fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgExecResumeSqliteResult =\n        ok: bool\n        threadId: str\n        responseJson: str\n        error: str\n        blockedReason: str\n\nfn RustCsgExecResumeSqliteError(message: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteBlocked(message: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteOk(threadId: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteHexValue(ch: char): int32 =\nfn RustCsgExecResumeSqliteIsUuid(value: str): bool =\nfn RustCsgExecResumeSqliteLookupFromParams(dbPath: str, params: var types.RustCsgThreadListParams, configModelProviderId: str, emptyReason: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteLookupMatchingFromParams(dbPath: str, params: var types.RustCsgThreadListParams, configModelProviderId: str, expectedName: str, requireExactName: bool, emptyReason: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteResultFromStateRow(row: state_db_sqlite.RustCsgStateDbThreadRowResult): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqlitePathsMatchAfterNormalization(left: str, right: str): bool =\nfn RustCsgExecResumeSqliteRowCwdMatches(row: state_db_sqlite.RustCsgStateDbThreadRowResult, expectedCwd: str): bool =\nfn RustCsgExecResumeSqliteDbParentDir(dbPath: str): str =\nfn RustCsgExecResumeSqliteSessionMetaCwdMatchResult(row: state_db_sqlite.RustCsgStateDbThreadRowResult, expectedCwd: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteSessionIndexEntryByName(dbPath: str, entry: types.RustCsgSessionIndexEntry, expectedName: str, expectedCwd: str, outMatchedName: var bool): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteSessionIndexByName(dbPath: str, sessionId: str, expectedCwd: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteLookupLastFromParams(dbPath: str, params: var types.RustCsgThreadListParams, configModelProviderId: str, emptyReason: str): RustCsgExecResumeSqliteResult =\nfn RustCsgExecResumeSqliteCwdFilter(execPlan: var plan.RustCsgExecPlan, requireCwd: bool, outBlockedReason: var str): str =\nfn RustCsgExecResumeLastFromSqlite(dbPath: str, execPlan: var plan.RustCsgExecPlan, configModelProviderId: str): RustCsgExecResumeSqliteResult =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\texec/resume_lookup_sqlite\nLocalType\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\nHasField\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\tok\tbool\nHasField\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\tthreadId\tstr\nHasField\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\tresponseJson\tstr\nHasField\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\terror\tstr\nHasField\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResult\tblockedReason\tstr\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteError\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteBlocked\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteOk\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteHexValue\tint32\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteIsUuid\tbool\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteLookupFromParams\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteLookupMatchingFromParams\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteResultFromStateRow\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqlitePathsMatchAfterNormalization\tbool\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteRowCwdMatches\tbool\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteDbParentDir\tstr\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteSessionMetaCwdMatchResult\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteSessionIndexEntryByName\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteSessionIndexByName\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteLookupLastFromParams\t\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeSqliteCwdFilter\tstr\nFunction\texec/resume_lookup_sqlite\tRustCsgExecResumeLastFromSqlite\t\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 5, "source field count")
    assert(ecn == 17, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 5, "oracle field count")
    assert(ocn == 17, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_exec_resume_lookup_sqlite_relfacts_smoke ok")
    return 0
