import std/strings
import codex/app_server/rate_limit_dashboard_webdriver_launcher as wd_launcher
import codex/app_server/rate_limit_dashboard_webdriver as wd
import codex/app_server/rate_limit_dashboard_webdriver_mail163 as wd_mail163
import codex/protocol/wire

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

fn testCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn testContains(text: str, needle: str): bool =
    if needle.len == 0:
        return true
    if needle.len > text.len:
        return false
    var i: int32
    while i <= text.len - needle.len:
        var matched = true
        var j: int32
        while j < needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn main(argc: int32, argv: str*): int32 =
    var baseUrl: str
    var isSafari: bool
    var chromeBinary: str
    var error: str
    let expectInvalid = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_INVALID") == "1"
    let resolved = wd_launcher.RustCsgWebDriverLauncherResolveSpec(baseUrl, isSafari, chromeBinary, error)
    if expectInvalid:
        if resolved:
            echo("resolve spec unexpectedly ok")
            return 1
        if !testContains(error, "must be `chrome` or `safari`"):
            echo(testCat("resolve spec invalid error mismatch: ", error))
            return 1
        echo("resolve spec invalid env ok")
        return 0
    if !resolved:
        echo(testCat("resolve spec FAIL: ", error))
        return 1
    let expectedExternalRaw = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_EXTERNAL")
    if expectedExternalRaw != "":
        let expectedExternal = expectedExternalRaw == "1"
        if wd_launcher.RustCsgWebDriverLauncherUsesExternalWebDriver() != expectedExternal:
            echo("resolve spec external webdriver mismatch")
            return 1
    if RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_BASE_URL_EMPTY") == "1" && baseUrl != "":
        echo(testCat("resolve spec expected empty base url, got: ", baseUrl))
        return 1
    let expectedBaseUrl = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_BASE_URL")
    if expectedBaseUrl != "" && baseUrl != expectedBaseUrl:
        echo(testCat("resolve spec base url mismatch: ", baseUrl))
        return 1
    let expectedBaseUrlPrefix = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_BASE_URL_PREFIX")
    if expectedBaseUrlPrefix != "" && !strings.HasPrefix(baseUrl, expectedBaseUrlPrefix):
        echo(testCat("resolve spec base url prefix mismatch: ", baseUrl))
        return 1
    let expectedSafari = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_SAFARI") == "1"
    if isSafari != expectedSafari:
        echo("resolve spec browser mismatch")
        return 1
    let expectedChromeBinary = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_CHROME_BINARY")
    if expectedChromeBinary != "" && chromeBinary != expectedChromeBinary:
        echo(testCat("resolve spec chrome binary mismatch: ", chromeBinary))
        return 1
    echo(testCat("resolve spec ok baseUrl=", baseUrl))
    let expectEnsureDriverReady = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_ENSURE_DRIVER_READY") == "1"
    let expectEnsureDriverUnreachable = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_ENSURE_DRIVER_UNREACHABLE") == "1"
    if expectEnsureDriverReady || expectEnsureDriverUnreachable:
        var readyBaseUrl: str
        var readyIsSafari: bool
        var readyChromeBinary: str
        var readyError: str
        let ready = wd_launcher.RustCsgWebDriverLauncherEnsureDriverReady(readyBaseUrl,
                                                                          readyIsSafari,
                                                                          readyChromeBinary,
                                                                          readyError)
        if expectEnsureDriverUnreachable:
            if ready:
                echo("webdriver ensure driver unexpectedly ready")
                return 1
            let expectedError = RustCsgGetEnv("RUST_CSG_WEBDRIVER_EXPECT_ERROR")
            if expectedError != "" && readyError != expectedError:
                echo(testCat("webdriver ensure driver unreachable error mismatch: ", readyError))
                return 1
            echo("webdriver ensure driver unreachable ok")
            return 0
        if !ready:
            echo(testCat("webdriver ensure driver ready FAIL: ", readyError))
            return 1
        if readyBaseUrl != baseUrl || readyIsSafari != isSafari || readyChromeBinary != chromeBinary:
            echo("webdriver ensure driver ready spec mismatch")
            return 1
        echo("webdriver ensure driver ready ok")
        return 0
    let capabilities = wd.RustCsgWebDriverChromeCapabilities(chromeBinary)
    if testContains(capabilities, "\"browserName\":\"chrome\"") &&
       testContains(capabilities, "--disable-blink-features=AutomationControlled") &&
       testContains(capabilities, "--remote-debugging-pipe") &&
       testContains(capabilities, "\"excludeSwitches\":[\"enable-automation\"]"):
        echo("chrome capabilities ok")
    else:
        echo("chrome capabilities FAIL")
        return 1
    let safariCaps = wd.RustCsgWebDriverSafariCapabilities()
    if testContains(safariCaps, "\"browserName\":\"Safari\"") &&
       testContains(safariCaps, "\"pageLoadStrategy\":\"eager\""):
        echo("safari capabilities ok")
    else:
        echo("safari capabilities FAIL")
        return 1
    var valueRaw: str
    var decodeError: str
    if !wd.RustCsgWebDriverDecodeResponseValue(200, "{\"value\":{\"sessionId\":\"abc123\",\"capabilities\":{}}}", valueRaw, decodeError):
        echo(testCat("decode session value FAIL: ", decodeError))
        return 1
    if wire.RustCsgJsonFindOptionalStr(valueRaw, "sessionId") != "abc123":
        echo("decode session id FAIL")
        return 1
    if wd.RustCsgWebDriverDecodeResponseValue(500, "{\"value\":null}", valueRaw, decodeError):
        echo("decode status failure unexpectedly ok")
        return 1
    if !testContains(decodeError, "webdriver command failed with status 500"):
        echo(testCat("decode status error mismatch: ", decodeError))
        return 1
    if wd.RustCsgWebDriverDecodeResponseValue(200, "not-json", valueRaw, decodeError):
        echo("decode malformed response unexpectedly ok")
        return 1
    if !testContains(decodeError, "failed to decode webdriver response"):
        echo(testCat("decode malformed response error mismatch: ", decodeError))
        return 1
    if wd.RustCsgWebDriverDecodeResponseValue(200, "{bad", valueRaw, decodeError):
        echo("decode malformed object unexpectedly ok")
        return 1
    if !testContains(decodeError, "failed to decode webdriver response"):
        echo(testCat("decode malformed object error mismatch: ", decodeError))
        return 1
    if wd.RustCsgWebDriverDecodeResponseValue(500, "{\"value\":{\"error\":\"session not created\",\"message\":\"Allow remote automation is disabled\"}}", valueRaw, decodeError):
        echo("decode remote automation unexpectedly ok")
        return 1
    if decodeError != "Safari WebDriver requires Safari Settings > Developer > Allow Remote Automation":
        echo(testCat("decode remote automation error mismatch: ", decodeError))
        return 1
    if !wd.RustCsgWebDriverDecodeResponseValue(200, "{\"value\":true}", valueRaw, decodeError):
        echo(testCat("decode bool value FAIL: ", decodeError))
        return 1
    if valueRaw != "true":
        echo(testCat("decode bool value mismatch: ", valueRaw))
        return 1
    echo("webdriver response decode ok")
    var versionError: str
    let major = wd_launcher.RustCsgWebDriverParseChromeMajorVersion("Noise 1 Google Chrome 146.0.7680.178\n", versionError)
    if major != "146":
        echo(testCat("chrome major parse FAIL: ", versionError))
        return 1
    if wd_launcher.RustCsgWebDriverParseChromeMajorVersion("Google Chrome 146abc", versionError) != "":
        echo("chrome major parse accepted malformed major")
        return 1
    if !testContains(versionError, "failed to parse Chrome major version"):
        echo(testCat("chrome major malformed error mismatch: ", versionError))
        return 1
    let expectFakeServer = RustCsgGetEnv("RUST_CSG_WEBDRIVER_FAKE_SERVER") == "1"
    if expectFakeServer:
        if !wd.RustCsgWebDriverIsReady(baseUrl):
            echo("fake webdriver status FAIL")
            return 1
        var sessionId: str
        var sessionError: str
        if !wd.RustCsgWebDriverCreateSession(baseUrl, chromeBinary, isSafari, sessionId, sessionError):
            echo(testCat("fake webdriver create session FAIL: ", sessionError))
            return 1
        if sessionId != "session-123":
            echo(testCat("fake webdriver session id mismatch: ", sessionId))
            return 1
        var navError: str
        if !wd.RustCsgWebDriverNavigateTo(baseUrl, sessionId, "https://example.test/auth", navError):
            echo(testCat("fake webdriver navigate FAIL: ", navError))
            return 1
        var scriptResult: str
        var scriptError: str
        if !wd.RustCsgWebDriverExecuteScript(baseUrl, sessionId, "return {status:'done'};", "[]", scriptResult, scriptError):
            echo(testCat("fake webdriver execute FAIL: ", scriptError))
            return 1
        if wire.RustCsgJsonFindOptionalStr(scriptResult, "status") != "done":
            echo(testCat("fake webdriver execute result mismatch: ", scriptResult))
            return 1
        var loginError: str
        if !wd_mail163.RustCsgWebDriverCompleteOpenaiLoginWithMail163(
            baseUrl, sessionId, "https://auth.openai.com/start", "alice@163.com", "\"password\"", "\"mail-password\"", loginError):
            echo(testCat("fake webdriver 163 login helper FAIL: ", loginError))
            return 1
        echo("fake webdriver 163 login helper ok")
        if !wd.RustCsgWebDriverDeleteSession(baseUrl, sessionId):
            echo("fake webdriver delete session FAIL")
            return 1
        echo("fake webdriver http ok")
    let mailHash = wd_mail163.RustCsgWebDriverMail163UnreadInboxHash()
    if !testContains(mailHash, "%22read%22%3Afalse"):
        echo("mail163 unread hash FAIL")
        return 1
    let mail163Url = wd_mail163.RustCsgWebDriverMail163Url()
    if mail163Url != "":
        echo("mail163 url ok")
    else:
        echo("mail163 url FAIL")
        return 1
    echo("rust_csg_app_server_rate_limit_dashboard_webdriver_smoke ok")
    return 0
