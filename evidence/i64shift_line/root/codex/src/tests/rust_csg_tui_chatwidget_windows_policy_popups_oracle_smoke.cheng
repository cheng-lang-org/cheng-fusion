import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_windows_policy_popups_oracle as oracle

fn RustCsgTuiChatwidgetWindowsPolicyPopupsCheck(path: str,
                                                 expectedSource: str,
                                                 expectedExpression: str,
                                                 expectedBody: str,
                                                 name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 3:
        echo("FAIL usage: rust_csg_tui_chatwidget_windows_policy_popups_oracle_smoke <2 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    exitCode = exitCode + RustCsgTuiChatwidgetWindowsPolicyPopupsCheck(
        cmdline.argStr(1), "tui/src/chatwidget/tests.rs", "popup",
        oracle.RustCsgTuiChatwidgetWindowsApprovalsSelectionPopup(),
        "approvals_selection_popup_windows"
    )
    exitCode = exitCode + RustCsgTuiChatwidgetWindowsPolicyPopupsCheck(
        cmdline.argStr(2), "tui/src/chatwidget/tests.rs", "popup",
        oracle.RustCsgTuiChatwidgetWindowsApprovalsSelectionPopupDegraded(),
        "approvals_selection_popup_windows_degraded"
    )

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_windows_policy_popups_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_windows_policy_popups_oracle_smoke FAILED")
    return exitCode
