# Sandboxing smoke test — verifies type constants + detectPlatformSandbox
# Production port of codex-rs/sandboxing/src/manager.rs

import cheng/codex/crates/sandboxing/sandboxing
import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════
# Assertion helpers
# ═══════════════════════════════════════════════════════════════════════

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkBool(got: bool, expected: bool, label: str): bool =
    var gotStr: str
    var expStr: str
    if got:
        gotStr = "true"
    else:
        gotStr = "false"
    if expected:
        expStr = "true"
    else:
        expStr = "false"
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expStr, " got=", gotStr], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ═══════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════

fn testSandboxTypeConstants(): bool =
    var ok: bool = true
    if !checkEqI32(sandboxing.RustCsgSandboxTypeNone, 0, "SandboxTypeNone"): ok = false
    if !checkEqI32(sandboxing.RustCsgSandboxTypeBubblewrap, 1, "SandboxTypeBubblewrap"): ok = false
    if !checkEqI32(sandboxing.RustCsgSandboxTypeSeatbelt, 2, "SandboxTypeSeatbelt"): ok = false
    if !checkEqI32(sandboxing.RustCsgSandboxTypeLandlock, 3, "SandboxTypeLandlock"): ok = false
    if !checkEqI32(sandboxing.RustCsgSandboxTypeCustom, 4, "SandboxTypeCustom"): ok = false
    return ok

fn testAllConstantsDistinct(): bool =
    var ok: bool = true
    if sandboxing.RustCsgSandboxTypeNone == sandboxing.RustCsgSandboxTypeBubblewrap:
        echo("testAllConstantsDistinct FAIL: None == Bubblewrap")
        ok = false
    if sandboxing.RustCsgSandboxTypeBubblewrap == sandboxing.RustCsgSandboxTypeSeatbelt:
        echo("testAllConstantsDistinct FAIL: Bubblewrap == Seatbelt")
        ok = false
    if sandboxing.RustCsgSandboxTypeSeatbelt == sandboxing.RustCsgSandboxTypeLandlock:
        echo("testAllConstantsDistinct FAIL: Seatbelt == Landlock")
        ok = false
    if sandboxing.RustCsgSandboxTypeLandlock == sandboxing.RustCsgSandboxTypeCustom:
        echo("testAllConstantsDistinct FAIL: Landlock == Custom")
        ok = false
    if ok:
        echo("testAllConstantsDistinct ok")
    return ok

fn testDetectPlatformSandbox(): bool =
    var ok: bool = true
    let detected = sandboxing.RustCsgSandboxingDetectPlatformSandbox()
    # Must return a valid SandboxType (0..4)
    if detected < 0 || detected > 4:
        echo(strutil.Join(["testDetectPlatformSandbox FAIL: out of range detected=", strings.IntToStr(detected)], ""))
        ok = false
    else:
        if detected == sandboxing.RustCsgSandboxTypeSeatbelt:
            echo("testDetectPlatformSandbox ok (Seatbelt/macOS)")
        elif detected == sandboxing.RustCsgSandboxTypeBubblewrap:
            echo("testDetectPlatformSandbox ok (Bubblewrap/Linux)")
        elif detected == sandboxing.RustCsgSandboxTypeNone:
            echo("testDetectPlatformSandbox ok (None/unknown)")
        else:
            echo(strutil.Join(["testDetectPlatformSandbox ok (type=", strings.IntToStr(detected), ")"], ""))
    return ok

# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testSandboxTypeConstants():
        allOk = false
    if !testAllConstantsDistinct():
        allOk = false
    if !testDetectPlatformSandbox():
        allOk = false
    if allOk:
        echo("rust_csg_sandboxing_smoke ok")
        return 0
    else:
        echo("rust_csg_sandboxing_smoke FAILED")
        return 1
