import cheng/codex/crates/backend_client/backend_client as bc
import cheng/codex/backend_client/client as bclient
import cheng/codex/backend_client/api as bapi
import std/cmdline
import std/strings

# ═══════════════════════════════════════════════════════════════════════════════
# Backend Client — type definition constants + client/api smoke test
#
# Ported from codex-rs/backend-client. Relfacts equivalence verification lives
# in rust_csg_backend_client_relfacts_smoke.cheng.
# ═══════════════════════════════════════════════════════════════════════════════

fn testPathStyleVariants(): bool =
    if bc.RustCsgPathStyleVariantCount != 2: return false
    if bc.RustCsgPathStyleVariant1 != "CodexApi": return false
    if bc.RustCsgPathStyleVariant2 != "ChatGptApi": return false
    echo("testPathStyleVariants ok")
    return true

fn testAddCreditsNudgeCreditTypeVariants(): bool =
    if bc.RustCsgAddCreditsNudgeCreditTypeVariantCount != 2: return false
    if bc.RustCsgAddCreditsNudgeCreditTypeVariant1 != "Credits": return false
    if bc.RustCsgAddCreditsNudgeCreditTypeVariant2 != "UsageLimit": return false
    echo("testAddCreditsNudgeCreditTypeVariants ok")
    return true

fn testCodeTaskDetailsResponseFieldCount(): bool =
    if bc.RustCsgCodeTaskDetailsResponseFieldCount != 3: return false
    if bc.RustCsgCodeTaskDetailsResponseField1 != "current_user_turn": return false
    if bc.RustCsgCodeTaskDetailsResponseField3 != "current_diff_task_turn": return false
    echo("testCodeTaskDetailsResponseFieldCount ok")
    return true

fn testTurnAttemptsSiblingTurnsResponseFieldCount(): bool =
    if bc.RustCsgTurnAttemptsSiblingTurnsResponseFieldCount != 1: return false
    if bc.RustCsgTurnAttemptsSiblingTurnsResponseField1 != "sibling_turns": return false
    echo("testTurnAttemptsSiblingTurnsResponseFieldCount ok")
    return true

fn testCodeTaskDetailsResponseExtMethodCount(): bool =
    if bc.RustCsgCodeTaskDetailsResponseExtMethodCount != 4: return false
    if bc.RustCsgCodeTaskDetailsResponseExtMethod1 != "unified_diff": return false
    if bc.RustCsgCodeTaskDetailsResponseExtMethod4 != "assistant_error_message": return false
    echo("testCodeTaskDetailsResponseExtMethodCount ok")
    return true

fn testVariantNamesFns(): bool =
    if bc.RequestErrorVariantNames() != "UnexpectedStatus,Other": return false
    if bc.PathStyleVariantNames() != "CodexApi,ChatGptApi": return false
    if bc.AddCreditsNudgeCreditTypeVariantNames() != "Credits,UsageLimit": return false
    echo("testVariantNamesFns ok")
    return true

fn testValidateEndpoint(): bool =
    if !bc.validateEndpoint("https://api.example.com"): return false
    if !bc.validateEndpoint("http://localhost:8080"): return false
    if bc.validateEndpoint(""): return false
    if bc.validateEndpoint("ftp://bad.com"): return false
    if bc.validateEndpoint("not-a-url"): return false
    echo("testValidateEndpoint ok")
    return true

fn testBackendClientBuildRequest(): bool =
    # GET without body
    var r1: str = bc.backendClientBuildRequest("GET", "/api/tasks", "")
    if r1.len == 0: return false
    if r1[0] != 123: return false  # '{'
    if r1[r1.len - 1] != 125: return false  # '}'
    # POST with body
    var r2: str = bc.backendClientBuildRequest("POST", "/api/tasks", "{\"title\":\"test\"}")
    if r2.len == 0: return false
    if r2[0] != 123: return false
    if r2[r2.len - 1] != 125: return false
    echo("testBackendClientBuildRequest ok")
    return true

# ── Client tests ────────────────────────────────────────────────────────────

fn testDetectPathStyle(): bool =
    # Default backend URL (contains /backend-api) → ChatGptApi
    let clientJson: str = bclient.BackendClientNew("https://chatgpt.com/backend-api/", "tok_test", "test-agent/1.0")
    if clientJson.len == 0: return false
    if clientJson[0] != 123: return false  # '{'
    if clientJson[clientJson.len - 1] != 125: return false  # '}'
    echo("testDetectPathStyle ok")
    return true

fn testBackendClientNew(): bool =
    let clientJson: str = bclient.BackendClientNew("https://api.codex.com", "tok_abc", "codex-cli/1.0")
    if clientJson.len == 0: return false
    if clientJson == "": return false
    echo("testBackendClientNew ok")
    return true

fn testBackendClientDefaults(): bool =
    let clientJson: str = bclient.BackendClientNew("", "tok_default", "")
    if clientJson.len == 0: return false
    if clientJson[0] != 123: return false
    echo("testBackendClientDefaults ok")
    return true

fn testBackendClientFromAuth(): bool =
    let clientJson: str = bclient.BackendClientFromAuth("https://api.codex.com", "tok_auth")
    if clientJson.len == 0: return false
    echo("testBackendClientFromAuth ok")
    return true

fn testBuildApiUrlCodexApi(): bool =
    let clientJson: str = bclient.BackendClientNew("https://api.codex.com", "tok", "agent")
    if clientJson.len == 0: return false
    echo("testBuildApiUrlCodexApi ok")
    return true

fn testBuildApiUrlChatGptApi(): bool =
    let clientJson: str = bclient.BackendClientNew("https://chatgpt.com/backend-api/", "tok", "agent")
    if clientJson.len == 0: return false
    echo("testBuildApiUrlChatGptApi ok")
    return true

fn testBackendPathHelpers(): bool =
    if bclient.BackendPathTasks() != "/tasks": return false
    if bclient.BackendPathTask("task_123") != "/tasks/task_123": return false
    if bclient.BackendPathTaskList() != "/tasks/list": return false
    if bclient.BackendPathUsage() != "/usage": return false
    if bclient.BackendPathConfigRequirements() != "/config/requirements": return false
    if bclient.BackendPathSiblingTurns("t1", "turn1") != "/tasks/t1/turns/turn1/sibling_turns": return false
    if bclient.BackendPathAddCreditsNudgeEmail() != "/accounts/send_add_credits_nudge_email": return false
    echo("testBackendPathHelpers ok")
    return true

fn testBackendRequestHeaders(): bool =
    let headers: str = bclient.buildRequestHeaders("tok_abc", "agent/1.0")
    if headers != "[\"Authorization: Bearer tok_abc\",\"Content-Type: application/json\",\"User-Agent: agent/1.0\"]": return false
    let accountHeaders: str = bclient.buildRequestHeadersWithAccountId("tok_abc", "agent/1.0", "workspace_123")
    if accountHeaders != "[\"Authorization: Bearer tok_abc\",\"Content-Type: application/json\",\"User-Agent: agent/1.0\",\"ChatGPT-Account-Id: workspace_123\"]": return false
    echo("testBackendRequestHeaders ok")
    return true

fn testBackendJsonExtractStr(): bool =
    let clientJson: str = bclient.BackendClientNew("http://127.0.0.1:12345", "tok_extract", "agent/1.0")
    let baseUrl: str = bclient.jsonExtractStr(clientJson, "baseUrl")
    if baseUrl != "http://127.0.0.1:12345":
        echo("testBackendJsonExtractStr bad baseUrl")
        echo(clientJson)
        echo(baseUrl)
        return false
    echo("testBackendJsonExtractStr ok")
    return true

fn testNormalizeChatGptBaseUrl(): bool =
    let clientJson: str = bclient.BackendClientNew("https://chatgpt.com", "tok_extract", "agent/1.0")
    let baseUrl: str = bclient.jsonExtractStr(clientJson, "baseUrl")
    if baseUrl != "https://chatgpt.com/backend-api": return false
    echo("testNormalizeChatGptBaseUrl ok")
    return true

# ── API tests (no server, just request building) ────────────────────────────

fn testBackendCreateTaskNoServer(): bool =
    let clientJson: str = bclient.BackendClientNew("http://localhost:1", "tok", "test")
    let result: str = bapi.BackendCreateTask(clientJson, "{\"model\":\"test\"}")
    if result == "": return false
    if result.len == 0: return false
    echo("testBackendCreateTaskNoServer ok")
    return true

fn testBackendGetTaskNoServer(): bool =
    let clientJson: str = bclient.BackendClientNew("http://localhost:1", "tok", "test")
    let result: str = bapi.BackendGetTask(clientJson, "task_nonexistent")
    if result == "": return false
    if result.len == 0: return false
    echo("testBackendGetTaskNoServer ok")
    return true

fn testBackendListTasksNoServer(): bool =
    let clientJson: str = bclient.BackendClientNew("http://localhost:1", "tok", "test")
    let result: str = bapi.BackendListTasks(clientJson)
    if result == "": return false
    if result.len == 0: return false
    echo("testBackendListTasksNoServer ok")
    return true

fn testBackendGetRateLimitsNoServer(): bool =
    let clientJson: str = bclient.BackendClientNew("http://localhost:1", "tok", "test")
    let result: str = bapi.BackendGetRateLimits(clientJson)
    if result == "": return false
    if result.len == 0: return false
    echo("testBackendGetRateLimitsNoServer ok")
    return true

fn testBackendGetRateLimitsLocalServer(): bool =
    if cmdline.argCount() < 2:
        echo("testBackendGetRateLimitsLocalServer skipped")
        return true
    let baseUrl: str = cmdline.argStr(1)
    if baseUrl == "":
        echo("testBackendGetRateLimitsLocalServer empty base URL")
        return false
    let clientJson: str = bclient.BackendClientNew(baseUrl, "tok_rate_limit", "backend-client-smoke/1.0")
    let result: str = bapi.BackendGetRateLimits(clientJson)
    if !strings.StrContains(result, "\"plan_type\""):
        echo("testBackendGetRateLimitsLocalServer missing plan_type")
        echo(clientJson)
        echo(result)
        return false
    if !strings.StrContains(result, "\"rate_limit\""):
        echo("testBackendGetRateLimitsLocalServer missing rate_limit")
        echo(result)
        return false
    echo("testBackendGetRateLimitsLocalServer ok")
    return true

fn testBackendSendAddCreditsNudgeEmailNoServer(): bool =
    let clientJson: str = bclient.BackendClientNew("http://localhost:1", "tok", "test")
    let result: str = bapi.BackendSendAddCreditsNudgeEmail(clientJson, "Credits")
    if result == "": return false
    if result.len == 0: return false
    echo("testBackendSendAddCreditsNudgeEmailNoServer ok")
    return true

fn testBackendCreateTaskRequestShape(): bool =
    let url: str = bclient.buildApiUrl("https://api.codex.com", "CodexApi", "/tasks")
    if url != "https://api.codex.com/api/codex/tasks": return false
    echo("testBackendCreateTaskRequestShape ok")
    return true

fn testBackendCreateTaskRequestShapeChatGpt(): bool =
    let url: str = bclient.buildApiUrl("https://chatgpt.com/backend-api", "ChatGptApi", "/tasks")
    if url != "https://chatgpt.com/backend-api/wham/tasks": return false
    echo("testBackendCreateTaskRequestShapeChatGpt ok")
    return true

fn testBackendGetTaskRequestShape(): bool =
    let url: str = bclient.buildApiUrl("https://api.codex.com", "CodexApi", "/tasks/task_abc")
    if url != "https://api.codex.com/api/codex/tasks/task_abc": return false
    echo("testBackendGetTaskRequestShape ok")
    return true

fn testBackendSiblingTurnsRequestShape(): bool =
    let path: str = bclient.BackendPathSiblingTurns("task1", "turn1")
    let url: str = bclient.buildApiUrl("https://api.codex.com", "CodexApi", path)
    if url != "https://api.codex.com/api/codex/tasks/task1/turns/turn1/sibling_turns": return false
    echo("testBackendSiblingTurnsRequestShape ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # Type constants
    if !testPathStyleVariants(): allOk = false
    if !testAddCreditsNudgeCreditTypeVariants(): allOk = false
    if !testCodeTaskDetailsResponseFieldCount(): allOk = false
    if !testTurnAttemptsSiblingTurnsResponseFieldCount(): allOk = false
    if !testCodeTaskDetailsResponseExtMethodCount(): allOk = false
    if !testVariantNamesFns(): allOk = false
    if !testValidateEndpoint(): allOk = false
    if !testBackendClientBuildRequest(): allOk = false

    # Client tests
    if !testDetectPathStyle(): allOk = false
    if !testBackendClientNew(): allOk = false
    if !testBackendClientDefaults(): allOk = false
    if !testBackendClientFromAuth(): allOk = false
    if !testBuildApiUrlCodexApi(): allOk = false
    if !testBuildApiUrlChatGptApi(): allOk = false
    if !testBackendPathHelpers(): allOk = false
    if !testBackendRequestHeaders(): allOk = false
    if !testBackendJsonExtractStr(): allOk = false
    if !testNormalizeChatGptBaseUrl(): allOk = false

    # API tests (request shape verification + connection error handling)
    if !testBackendCreateTaskRequestShape(): allOk = false
    if !testBackendCreateTaskRequestShapeChatGpt(): allOk = false
    if !testBackendGetTaskRequestShape(): allOk = false
    if !testBackendSiblingTurnsRequestShape(): allOk = false
    if !testBackendCreateTaskNoServer(): allOk = false
    if !testBackendGetTaskNoServer(): allOk = false
    if !testBackendListTasksNoServer(): allOk = false
    if !testBackendGetRateLimitsNoServer(): allOk = false
    if !testBackendGetRateLimitsLocalServer(): allOk = false
    if !testBackendSendAddCreditsNudgeEmailNoServer(): allOk = false

    if allOk:
        echo("rust_csg_backend_client_smoke ok")
        return 0
    echo("rust_csg_backend_client_smoke FAILED")
    return 1
