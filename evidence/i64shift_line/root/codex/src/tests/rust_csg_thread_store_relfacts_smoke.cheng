import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Self-contained smoke test for Module 5: state/thread_store
#
# Tests the pure-logic functions from thread_store.cheng without importing
# project modules (types, wire, home). Types are defined locally and wire
# helpers are inlined.
#
# Verified functions:
#   RustCsgSessionIndexEntryEmpty
#   RustCsgSessionIndexSeenId
#   RustCsgSessionIndexLineLooksParseable
#   RustCsgSessionIndexEntryFromJson
#   RustCsgSessionIndexParseLine
#   RustCsgMergeThreadMetadata
#   RustCsgThreadStoreMerge
#   RustCsgThreadStoreDiff
# ═══════════════════════════════════════════════════════════════════════════════

# ── Local type definitions ──────────────────────────────────────────────
# Mirror types in state/thread_store.cheng without importing the project
# types module.

type
    RustCsgSessionIndexEntry =
        id: str
        threadName: str
        updatedAt: str

    RustCsgThreadMetadata =
        title: str
        cwd: str
        status: str

# ── Inlined wire helpers used by thread_store ───────────────────────────

fn rustCsgContains(haystack: str, needle: str): bool =
    if needle == "":
        return true
    if needle.len > haystack.len:
        return false
    for i in 0..<(haystack.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if haystack[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return true
    return false

# ── Inlined core functions from state/thread_store.cheng ────────────────

fn RustCsgSessionIndexEntryEmpty(entry: RustCsgSessionIndexEntry): bool =
    return entry.id == "" && entry.threadName == "" && entry.updatedAt == ""

fn RustCsgSessionIndexSeenId(seenIds: str[], id: str): bool =
    var i: int32 = 0
    while i < seenIds.len:
        if seenIds[i] == id:
            return true
        i = i + 1
    return false

fn RustCsgSessionIndexLineLooksParseable(line: str): bool =
    if line == "":
        return false
    if !rustCsgContains(line, "\"id\""):
        return false
    if !rustCsgContains(line, "\"thread_name\""):
        return false
    return rustCsgContains(line, "\"updated_at\"")

fn RustCsgMergeThreadMetadata(existing: RustCsgThreadMetadata,
                               update: RustCsgThreadMetadata): RustCsgThreadMetadata =
    var result: RustCsgThreadMetadata
    if update.title != "":
        result.title = update.title
    else:
        result.title = existing.title
    if update.cwd != "":
        result.cwd = update.cwd
    else:
        result.cwd = existing.cwd
    if update.status != "":
        result.status = update.status
    else:
        result.status = existing.status
    return result

fn RustCsgThreadStoreMerge(
    sourceIds: str[], sourceData: str[],
    targetIds: str[], targetData: str[],
    outIds: var str[], outData: var str[]
) =
    var i: int32 = 0
    while i < sourceIds.len:
        add(outIds, sourceIds[i])
        var data = sourceData[i]
        var j: int32 = 0
        while j < targetIds.len:
            if sourceIds[i] == targetIds[j]:
                data = targetData[j]
                break
            j = j + 1
        add(outData, data)
        i = i + 1
    var j: int32 = 0
    while j < targetIds.len:
        var found: bool = false
        var k: int32 = 0
        while k < sourceIds.len:
            if sourceIds[k] == targetIds[j]:
                found = true
                break
            k = k + 1
        if !found:
            add(outIds, targetIds[j])
            add(outData, targetData[j])
        j = j + 1

fn RustCsgThreadStoreDiff(
    aIds: str[], aData: str[],
    bIds: str[],
    outIds: var str[], outData: var str[]
) =
    var i: int32 = 0
    while i < aIds.len:
        var found: bool = false
        var j: int32 = 0
        while j < bIds.len:
            if aIds[i] == bIds[j]:
                found = true
                break
            j = j + 1
        if !found:
            add(outIds, aIds[i])
            add(outData, aData[i])
        i = i + 1

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkBool(got: bool, expected: bool, name: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

fn checkEq(got: str, expected: str, name: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", expected], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", got], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testEntryEmpty(): bool =
    var ok: bool = true
    var entry: RustCsgSessionIndexEntry
    if !checkBool(RustCsgSessionIndexEntryEmpty(entry), true, "entryEmpty_allEmpty"):
        ok = false
    var withId: RustCsgSessionIndexEntry
    withId.id = "x"
    if !checkBool(RustCsgSessionIndexEntryEmpty(withId), false, "entryEmpty_hasId"):
        ok = false
    var withName: RustCsgSessionIndexEntry
    withName.threadName = "n"
    if !checkBool(RustCsgSessionIndexEntryEmpty(withName), false, "entryEmpty_hasName"):
        ok = false
    var withDate: RustCsgSessionIndexEntry
    withDate.updatedAt = "d"
    if !checkBool(RustCsgSessionIndexEntryEmpty(withDate), false, "entryEmpty_hasDate"):
        ok = false
    if ok:
        echo("testEntryEmpty ok")
    return ok

fn testSeenId(): bool =
    var ok: bool = true
    var ids: str[]
    if !checkBool(RustCsgSessionIndexSeenId(ids, "a"), false, "seenId_emptyArray"):
        ok = false
    add(ids, "a")
    if !checkBool(RustCsgSessionIndexSeenId(ids, "a"), true, "seenId_found"):
        ok = false
    if !checkBool(RustCsgSessionIndexSeenId(ids, "b"), false, "seenId_notFound"):
        ok = false
    add(ids, "b")
    add(ids, "c")
    if !checkBool(RustCsgSessionIndexSeenId(ids, "a"), true, "seenId_stillFound"):
        ok = false
    if !checkBool(RustCsgSessionIndexSeenId(ids, "c"), true, "seenId_thirdFound"):
        ok = false
    if !checkBool(RustCsgSessionIndexSeenId(ids, "d"), false, "seenId_missing"):
        ok = false
    if ok:
        echo("testSeenId ok")
    return ok

fn testLineLooksParseable(): bool =
    var ok: bool = true
    var validLine = "{\"id\":\"abc\",\"thread_name\":\"test\",\"updated_at\":\"2024-01-01\"}"
    if !checkBool(RustCsgSessionIndexLineLooksParseable(validLine), true, "looks_valid"):
        ok = false
    if !checkBool(RustCsgSessionIndexLineLooksParseable(""), false, "looks_empty"):
        ok = false
    var noId = "{\"thread_name\":\"test\",\"updated_at\":\"2024-01-01\"}"
    if !checkBool(RustCsgSessionIndexLineLooksParseable(noId), false, "looks_noId"):
        ok = false
    var noName = "{\"id\":\"abc\",\"updated_at\":\"2024-01-01\"}"
    if !checkBool(RustCsgSessionIndexLineLooksParseable(noName), false, "looks_noName"):
        ok = false
    var noDate = "{\"id\":\"abc\",\"thread_name\":\"test\"}"
    if !checkBool(RustCsgSessionIndexLineLooksParseable(noDate), false, "looks_noDate"):
        ok = false
    var garbage = "not json at all"
    if !checkBool(RustCsgSessionIndexLineLooksParseable(garbage), false, "looks_garbage"):
        ok = false
    if ok:
        echo("testLineLooksParseable ok")
    return ok

fn testMergeThreadMetadata(): bool =
    var ok: bool = true
    var existing: RustCsgThreadMetadata
    existing.title = "old-title"
    existing.cwd = "/old/path"
    existing.status = "active"
    # Empty update returns existing
    var emptyUpdate: RustCsgThreadMetadata
    var m1 = RustCsgMergeThreadMetadata(existing, emptyUpdate)
    if !checkEq(m1.title, "old-title", "mergeMeta_empty_title"):
        ok = false
    if !checkEq(m1.cwd, "/old/path", "mergeMeta_empty_cwd"):
        ok = false
    if !checkEq(m1.status, "active", "mergeMeta_empty_status"):
        ok = false
    # Full update overrides all
    var fullUpdate: RustCsgThreadMetadata
    fullUpdate.title = "new-title"
    fullUpdate.cwd = "/new/path"
    fullUpdate.status = "archived"
    var m2 = RustCsgMergeThreadMetadata(existing, fullUpdate)
    if !checkEq(m2.title, "new-title", "mergeMeta_full_title"):
        ok = false
    if !checkEq(m2.cwd, "/new/path", "mergeMeta_full_cwd"):
        ok = false
    if !checkEq(m2.status, "archived", "mergeMeta_full_status"):
        ok = false
    # Partial update merges (only title set, cwd and status fall back)
    var partialUpdate: RustCsgThreadMetadata
    partialUpdate.title = "updated-title"
    var m3 = RustCsgMergeThreadMetadata(existing, partialUpdate)
    if !checkEq(m3.title, "updated-title", "mergeMeta_partial_title"):
        ok = false
    if !checkEq(m3.cwd, "/old/path", "mergeMeta_partial_cwd"):
        ok = false
    if !checkEq(m3.status, "active", "mergeMeta_partial_status"):
        ok = false
    if ok:
        echo("testMergeThreadMetadata ok")
    return ok

fn testThreadStoreMerge(): bool =
    var ok: bool = true
    # Case 1: both empty
    var s1: str[]; var d1: str[]
    var t1: str[]; var e1: str[]
    var o1: str[]; var p1: str[]
    RustCsgThreadStoreMerge(s1, d1, t1, e1, o1, p1)
    if o1.len != 0:
        echo("FAIL [merge_empty_len]: expected 0")
        ok = false
    # Case 2: source only
    var s2: str[]; var d2: str[]
    add(s2, "a"); add(d2, "1")
    var t2: str[]; var e2: str[]
    var o2: str[]; var p2: str[]
    RustCsgThreadStoreMerge(s2, d2, t2, e2, o2, p2)
    if o2.len != 1:
        echo("FAIL [merge_sourceOnly_len]: expected 1")
        ok = false
    if o2.len > 0:
        if !checkEq(o2[0], "a", "merge_sourceOnly_id"):
            ok = false
        if !checkEq(p2[0], "1", "merge_sourceOnly_data"):
            ok = false
    # Case 3: target only
    var s3: str[]; var d3: str[]
    var t3: str[]; var e3: str[]
    add(t3, "b"); add(e3, "2")
    var o3: str[]; var p3: str[]
    RustCsgThreadStoreMerge(s3, d3, t3, e3, o3, p3)
    if o3.len != 1:
        echo("FAIL [merge_targetOnly_len]: expected 1")
        ok = false
    if o3.len > 0:
        if !checkEq(o3[0], "b", "merge_targetOnly_id"):
            ok = false
        if !checkEq(p3[0], "2", "merge_targetOnly_data"):
            ok = false
    # Case 4: disjoint ids
    var s4: str[]; var d4: str[]
    add(s4, "a"); add(d4, "1")
    var t4: str[]; var e4: str[]
    add(t4, "b"); add(e4, "2")
    var o4: str[]; var p4: str[]
    RustCsgThreadStoreMerge(s4, d4, t4, e4, o4, p4)
    if o4.len != 2:
        echo("FAIL [merge_disjoint_len]: expected 2")
        ok = false
    if o4.len >= 2:
        if !checkEq(o4[0], "a", "merge_disjoint_first"):
            ok = false
        if !checkEq(o4[1], "b", "merge_disjoint_second"):
            ok = false
    # Case 5: overlapping ids (target data wins)
    var s5: str[]; var d5: str[]
    add(s5, "a"); add(d5, "1")
    add(s5, "b"); add(d5, "2")
    var t5: str[]; var e5: str[]
    add(t5, "a"); add(e5, "10")
    var o5: str[]; var p5: str[]
    RustCsgThreadStoreMerge(s5, d5, t5, e5, o5, p5)
    if o5.len != 2:
        echo("FAIL [merge_overlap_len]: expected 2")
        ok = false
    if o5.len >= 2:
        if !checkEq(o5[0], "a", "merge_overlap_firstId"):
            ok = false
        if !checkEq(p5[0], "10", "merge_overlap_data_wins"):
            ok = false
        if !checkEq(o5[1], "b", "merge_overlap_secondId"):
            ok = false
    if ok:
        echo("testThreadStoreMerge ok")
    return ok

fn testThreadStoreDiff(): bool =
    var ok: bool = true
    # Case 1: identical ids -> empty diff
    var a1: str[]; var d1: str[]
    add(a1, "a"); add(d1, "1")
    var b1: str[]
    add(b1, "a")
    var o1: str[]; var p1: str[]
    RustCsgThreadStoreDiff(a1, d1, b1, o1, p1)
    if o1.len != 0:
        echo("FAIL [diff_identical_len]: expected 0")
        ok = false
    # Case 2: disjoint ids -> all from a
    var a2: str[]; var d2: str[]
    add(a2, "a"); add(d2, "1")
    var b2: str[]
    add(b2, "b")
    var o2: str[]; var p2: str[]
    RustCsgThreadStoreDiff(a2, d2, b2, o2, p2)
    if o2.len != 1:
        echo("FAIL [diff_disjoint_len]: expected 1")
        ok = false
    if o2.len > 0:
        if !checkEq(o2[0], "a", "diff_disjoint_id"):
            ok = false
        if !checkEq(p2[0], "1", "diff_disjoint_data"):
            ok = false
    # Case 3: partial overlap -> only a's entries not in b
    var a3: str[]; var d3: str[]
    add(a3, "a"); add(d3, "1")
    add(a3, "b"); add(d3, "2")
    add(a3, "c"); add(d3, "3")
    var b3: str[]
    add(b3, "a")
    add(b3, "c")
    var o3: str[]; var p3: str[]
    RustCsgThreadStoreDiff(a3, d3, b3, o3, p3)
    if o3.len != 1:
        echo("FAIL [diff_partial_len]: expected 1")
        ok = false
    if o3.len > 0:
        if !checkEq(o3[0], "b", "diff_partial_id"):
            ok = false
        if !checkEq(p3[0], "2", "diff_partial_data"):
            ok = false
    # Case 4: empty b -> all of a in diff
    var a4: str[]; var d4: str[]
    add(a4, "x"); add(d4, "9")
    var b4: str[]
    var o4: str[]; var p4: str[]
    RustCsgThreadStoreDiff(a4, d4, b4, o4, p4)
    if o4.len != 1:
        echo("FAIL [diff_emptyB_len]: expected 1")
        ok = false
    if o4.len > 0:
        if !checkEq(o4[0], "x", "diff_emptyB_id"):
            ok = false
        if !checkEq(p4[0], "9", "diff_emptyB_data"):
            ok = false
    if ok:
        echo("testThreadStoreDiff ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testEntryEmpty(): allOk = false
    if !testSeenId(): allOk = false
    if !testLineLooksParseable(): allOk = false
    if !testMergeThreadMetadata(): allOk = false
    if !testThreadStoreMerge(): allOk = false
    if !testThreadStoreDiff(): allOk = false
    if allOk:
        echo("rust_csg_thread_store_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_thread_store_relfacts_smoke FAILED")
        return 1
