import cheng/codex/crates/app_server_transport/app_server_transport as ast

# ═══════════════════════════════════════════════════════════════════════════════
# App Server Transport — type definition constants smoke test
#
# Ported from codex-rs/app-server-transport
# ═══════════════════════════════════════════════════════════════════════════════

fn testTransportEventVariants(): bool =
    if ast.RustCsgTransportEventVariantCount != 3: return false
    if ast.RustCsgTransportEventVariant1 != "ConnectionOpened": return false
    if ast.RustCsgTransportEventVariant2 != "ConnectionClosed": return false
    if ast.RustCsgTransportEventVariant3 != "IncomingMessage": return false
    echo("testTransportEventVariants ok")
    return true

fn testConnectionOpenedFields(): bool =
    if ast.RustCsgConnectionOpenedFieldCount != 4: return false
    if ast.RustCsgConnectionOpenedField1 != "connection_id": return false
    if ast.RustCsgConnectionOpenedField2 != "origin": return false
    if ast.RustCsgConnectionOpenedField4 != "disconnect_sender": return false
    echo("testConnectionOpenedFields ok")
    return true

fn testConnectionClosedFields(): bool =
    if ast.RustCsgConnectionClosedFieldCount != 1: return false
    if ast.RustCsgConnectionClosedField1 != "connection_id": return false
    echo("testConnectionClosedFields ok")
    return true

fn testIncomingMessageFields(): bool =
    if ast.RustCsgIncomingMessageFieldCount != 2: return false
    if ast.RustCsgIncomingMessageField1 != "connection_id": return false
    if ast.RustCsgIncomingMessageField2 != "message": return false
    echo("testIncomingMessageFields ok")
    return true

fn testAppServerTransportVariants(): bool =
    if ast.RustCsgAppServerTransportVariantCount != 4: return false
    if ast.RustCsgAppServerTransportVariant1 != "Stdio": return false
    if ast.RustCsgAppServerTransportVariant2 != "UnixSocket": return false
    if ast.RustCsgAppServerTransportVariant3 != "WebSocket": return false
    if ast.RustCsgAppServerTransportVariant4 != "Off": return false
    echo("testAppServerTransportVariants ok")
    return true

fn testParseErrorVariants(): bool =
    if ast.RustCsgAppServerTransportParseErrorVariantCount != 3: return false
    if ast.RustCsgAppServerTransportParseErrorVariant1 != "UnsupportedListenUrl": return false
    if ast.RustCsgAppServerTransportParseErrorVariant3 != "InvalidWebSocketListenUrl": return false
    echo("testParseErrorVariants ok")
    return true

fn testConnectionOriginVariants(): bool =
    if ast.RustCsgConnectionOriginVariantCount != 4: return false
    if ast.RustCsgConnectionOriginVariant1 != "Stdio": return false
    if ast.RustCsgConnectionOriginVariant2 != "InProcess": return false
    if ast.RustCsgConnectionOriginVariant3 != "WebSocket": return false
    if ast.RustCsgConnectionOriginVariant4 != "RemoteControl": return false
    echo("testConnectionOriginVariants ok")
    return true

fn testOutgoingMessageVariants(): bool =
    if ast.RustCsgOutgoingMessageVariantCount != 4: return false
    if ast.RustCsgOutgoingMessageVariant1 != "Request": return false
    if ast.RustCsgOutgoingMessageVariant2 != "AppServerNotification": return false
    if ast.RustCsgOutgoingMessageVariant4 != "Error": return false
    echo("testOutgoingMessageVariants ok")
    return true

fn testOutgoingResponseFields(): bool =
    if ast.RustCsgOutgoingResponseFieldCount != 2: return false
    if ast.RustCsgOutgoingResponseField1 != "id": return false
    if ast.RustCsgOutgoingResponseField2 != "result": return false
    echo("testOutgoingResponseFields ok")
    return true

fn testChannelCapacity(): bool =
    if ast.RustCsgChannelCapacity != 128: return false
    echo("testChannelCapacity ok")
    return true

fn testDefaultListenUrl(): bool =
    if ast.RustCsgDefaultListenUrl != "stdio://": return false
    echo("testDefaultListenUrl ok")
    return true

fn testControlConstants(): bool =
    if ast.RustCsgControlSocketDirName != "app-server-control": return false
    if ast.RustCsgControlSocketFileName != "app-server-control.sock": return false
    echo("testControlConstants ok")
    return true

fn testRemoteControlHandleFields(): bool =
    if ast.RustCsgRemoteControlHandleFieldCount != 3: return false
    if ast.RustCsgRemoteControlHandleField1 != "enabled_tx": return false
    if ast.RustCsgRemoteControlHandleField3 != "state_db_available": return false
    echo("testRemoteControlHandleFields ok")
    return true

fn testRemoteControlStartConfigFields(): bool =
    if ast.RustCsgRemoteControlStartConfigFieldCount != 2: return false
    if ast.RustCsgRemoteControlStartConfigField1 != "remote_control_url": return false
    if ast.RustCsgRemoteControlStartConfigField2 != "installation_id": return false
    echo("testRemoteControlStartConfigFields ok")
    return true

fn testRemoteControlUnavailableCount(): bool =
    if ast.RustCsgRemoteControlUnavailableFieldCount != 0: return false
    echo("testRemoteControlUnavailableCount ok")
    return true

fn testClassifyTransportUrl(): bool =
    if ast.RustCsgClassifyTransportUrl("stdio://") != "Stdio": return false
    if ast.RustCsgClassifyTransportUrl("stdio://path") != "Stdio": return false
    if ast.RustCsgClassifyTransportUrl("unix:///tmp/sock") != "UnixSocket": return false
    if ast.RustCsgClassifyTransportUrl("ws://localhost:8080") != "WebSocket": return false
    if ast.RustCsgClassifyTransportUrl("wss://example.com") != "WebSocket": return false
    if ast.RustCsgClassifyTransportUrl("unknown://") != "Off": return false
    echo("testClassifyTransportUrl ok")
    return true

fn testTransportEventClassification(): bool =
    if !ast.RustCsgIsConnectionOpened("ConnectionOpened"): return false
    if ast.RustCsgIsConnectionOpened("ConnectionClosed"): return false
    if !ast.RustCsgIsConnectionClosed("ConnectionClosed"): return false
    if !ast.RustCsgIsIncomingMessage("IncomingMessage"): return false
    echo("testTransportEventClassification ok")
    return true

fn testConnectionOriginClassification(): bool =
    if !ast.RustCsgIsStdioConnection("Stdio"): return false
    if ast.RustCsgIsStdioConnection("InProcess"): return false
    if !ast.RustCsgIsInProcessConnection("InProcess"): return false
    if !ast.RustCsgIsWebSocketConnection("WebSocket"): return false
    if !ast.RustCsgIsRemoteControlConnection("RemoteControl"): return false
    echo("testConnectionOriginClassification ok")
    return true

fn testOutgoingMessageClassification(): bool =
    if !ast.RustCsgIsServerRequest("Request"): return false
    if !ast.RustCsgIsAppServerNotification("AppServerNotification"): return false
    if !ast.RustCsgIsResponse("Response"): return false
    if !ast.RustCsgIsOutgoingError("Error"): return false
    if ast.RustCsgIsServerRequest("Response"): return false
    echo("testOutgoingMessageClassification ok")
    return true

fn testRemoteControlAvailable(): bool =
    if !ast.RustCsgRemoteControlAvailable(true): return false
    if ast.RustCsgRemoteControlAvailable(false): return false
    echo("testRemoteControlAvailable ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testTransportEventVariants(): allOk = false
    if !testConnectionOpenedFields(): allOk = false
    if !testConnectionClosedFields(): allOk = false
    if !testIncomingMessageFields(): allOk = false
    if !testAppServerTransportVariants(): allOk = false
    if !testParseErrorVariants(): allOk = false
    if !testConnectionOriginVariants(): allOk = false
    if !testOutgoingMessageVariants(): allOk = false
    if !testOutgoingResponseFields(): allOk = false
    if !testChannelCapacity(): allOk = false
    if !testDefaultListenUrl(): allOk = false
    if !testControlConstants(): allOk = false
    if !testRemoteControlHandleFields(): allOk = false
    if !testRemoteControlStartConfigFields(): allOk = false
    if !testRemoteControlUnavailableCount(): allOk = false
    if !testClassifyTransportUrl(): allOk = false
    if !testTransportEventClassification(): allOk = false
    if !testConnectionOriginClassification(): allOk = false
    if !testOutgoingMessageClassification(): allOk = false
    if !testRemoteControlAvailable(): allOk = false

    if allOk:
        echo("rust_csg_app_server_transport_smoke ok")
        return 0
    else:
        echo("rust_csg_app_server_transport_smoke FAILED")
        return 1
