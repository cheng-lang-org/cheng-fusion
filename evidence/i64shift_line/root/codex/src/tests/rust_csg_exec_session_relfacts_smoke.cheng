fn testBlockedReason(): bool =
    var ok: bool = true
    var p = planDefault()

    # Non-OSS -> ""
    let b1 = RustCsgExecBlockedReasonFromPlanWithUserConfig(p, "")
    if !checkStr("Block_noOss", "", b1): ok = false

    # OSS without provider -> blocked
    p.oss = true
    let b2 = RustCsgExecBlockedReasonFromPlanWithUserConfig(p, "")
    if !checkBool("Block_oss", true, b2 != ""): ok = false

    if ok:
        echo("testBlockedReason ok")
    return ok

# ── GROUP 17: Config Semantic Error ────────────────────────────────────────

fn testConfigSemanticError(): bool =
    var ok: bool = true
    var p = planDefault()

    # Empty plan + empty user config -> no error
    let e1 = RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(p, "")
    if !checkStr("CfgSem_empty", "", e1): ok = false

    # User config with semantic error
    let badCfg = "{\"sandboxMode\":\"bogus\"}"
    let e2 = RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(p, badCfg)
    if !checkBool("CfgSem_badSandbox", true, e2 != ""): ok = false

    if ok:
        echo("testConfigSemanticError ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    var allOk: bool = true

    if !testJsonAppendComma(): allOk = false
    if !testJsonAppendStr(): allOk = false
    if !testJsonAppendRaw(): allOk = false
    if !testJsonAppendOptional(): allOk = false
    if !testApprovalPolicyValid(): allOk = false
    if !testSandboxValid(): allOk = false
    if !testApprovalsReviewerCanonical(): allOk = false
    if !testDefaultModelForOssProvider(): allOk = false
    if !testEffectiveModelFromPlan(): allOk = false
    if !testEffectiveCwdFromPlan(): allOk = false
    if !testSandboxJsonFromPlan(): allOk = false
    if !testPermissionsJson(): allOk = false
    if !testUserConfigSemanticError(): allOk = false
    if !testConfigProfileJson(): allOk = false
    if !testThreadStartParamsJson(): allOk = false
    if !testThreadResumeParamsJson(): allOk = false
    if !testTurnStartParamsJson(): allOk = false
    if !testReviewStartParamsJson(): allOk = false
    if !testRequestEntryJson(): allOk = false
    if !testSequences(): allOk = false
    if !testRequestPlanToJson(): allOk = false
    if !testEphemeralJson(): allOk = false
    if !testBlockedReason(): allOk = false
    if !testConfigSemanticError(): allOk = false

    if allOk:
        echo("rust_csg_exec_session_relfacts_smoke ok")
        return 0
    echo("rust_csg_exec_session_relfacts_smoke FAILED")
    return 1
