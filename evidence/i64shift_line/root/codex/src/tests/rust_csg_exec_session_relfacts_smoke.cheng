# ── GROUP 13: Sequences ────────────────────────────────────────────────────

fn testSequences(): bool =
    var ok: bool = true
    let tsj = "{\"model\":\"gpt-4\"}"
    let trj = "{\"threadId\":\"t-1\"}"
    let rsj = "{\"target\":{}}"

    let seq1 = RustCsgExecBuildStartUserTurnSequence(tsj, trj)
    let exp1 = "[{\"method\":\"thread/start\",\"params\":{\"model\":\"gpt-4\"}},{\"method\":\"turn/start\",\"params\":{\"threadId\":\"t-1\"}}]"
    if !checkStr("Seq_start", exp1, seq1): ok = false

    let seq2 = RustCsgExecBuildResumeUserTurnSequence(trj, trj)
    let exp2 = "[{\"method\":\"thread/resume\",\"params\":{\"threadId\":\"t-1\"}},{\"method\":\"turn/start\",\"params\":{\"threadId\":\"t-1\"}}]"
    if !checkStr("Seq_resume", exp2, seq2): ok = false

    let seq3 = RustCsgExecBuildReviewSequence(tsj, rsj)
    let exp3 = "[{\"method\":\"thread/start\",\"params\":{\"model\":\"gpt-4\"}},{\"method\":\"review/start\",\"params\":{\"target\":{}}}]"
    if !checkStr("Seq_review", exp3, seq3): ok = false

    if ok:
        echo("testSequences ok")
    return ok

# ── GROUP 14: Request Plan To JSON ─────────────────────────────────────────

fn testRequestPlanToJson(): bool =
    var ok: bool = true
    var rp: RustCsgExecRequestPlan
    rp.kind = "startUserTurn"
    rp.threadId = "thr-42"
    rp.requestSequenceJson = "[{}]"
    rp.parseError = ""
    rp.blockedReason = ""

    let json = RustCsgExecRequestPlanToJson(rp)
    let expected = "{\"kind\":\"startUserTurn\",\"threadId\":\"thr-42\",\"requestSequence\":[{}],\"parseError\":\"\",\"blockedReason\":\"\"}"
    if !checkStr("ReqPlan_toJson", expected, json): ok = false

    # Empty sequence -> defaults to []
    rp.requestSequenceJson = ""
    let json2 = RustCsgExecRequestPlanToJson(rp)
    let expected2 = "{\"kind\":\"startUserTurn\",\"threadId\":\"thr-42\",\"requestSequence\":[],\"parseError\":\"\",\"blockedReason\":\"\"}"
    if !checkStr("ReqPlan_emptySeq", expected2, json2): ok = false

    if ok:
        echo("testRequestPlanToJson ok")
    return ok

