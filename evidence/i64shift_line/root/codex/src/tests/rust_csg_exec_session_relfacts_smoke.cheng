import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Self-contained behavioral smoke test for exec/session pure logic.
# Tests model selection, sandbox mapping, permission profile, config profile
# merging, approval policy, approvals reviewer, thread/turn/review params JSON,
# request sequences, and request plan serialization.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Wire helpers ─────────────────────────────────────────────────────────────

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn JsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = Cat(out, "\\\"")
        elif ch == '\\':
            out = Cat(out, "\\\\")
        elif ch == '\n':
            out = Cat(out, "\\n")
        elif ch == '\r':
            out = Cat(out, "\\r")
        elif ch == '\t':
            out = Cat(out, "\\t")
        else:
            out = Cat(out, SliceBytes(value, i, 1))
    return Cat(out, "\"")

fn JsonFieldStr(key: str, value: str): str =
    var out = JsonQuote(key)
    out = Cat(out, ":")
    out = Cat(out, JsonQuote(value))
    return out

fn JsonFieldRaw(key: str, value: str): str =
    var out = JsonQuote(key)
    out = Cat(out, ":")
    out = Cat(out, value)
    return out

fn JsonFindOptionalStr(json: str, field: str): str =
    # State-machine scanner: never uses inner loops that write to outer vars.
    # State 0 = searching for ", 1 = checking bytes, 2 = key matched, reading value.
    let fieldKey = Cat(JsonQuote(field), ":")
    let keyLen = fieldKey.len
    var i: int32
    var state: int32
    var ki: int32
    var matchStart: int32
    state = 0
    i = 0
    while i < json.len:
        if state == 0:
            if json[i] == fieldKey[0]:
                state = 1
                matchStart = i
                ki = 1
            i = i + 1
        elif state == 1:
            if ki < keyLen:
                if json[i] == fieldKey[ki]:
                    ki = ki + 1
                    i = i + 1
                    if ki == keyLen:
                        state = 2
                else:
                    state = 0
                    i = i + 1
            else:
                state = 2
        elif state == 2:
            i = matchStart + keyLen
            var start: int32
            start = i
            while start < json.len && (json[start] == ' ' || json[start] == '\t'):
                start = start + 1
            if start >= json.len:
                return ""
            if json[start] == '"':
                var vend: int32
                vend = start + 1
                while vend < json.len && json[vend] != '"':
                    vend = vend + 1
                if vend > start + 1 && vend < json.len:
                    return SliceBytes(json, start + 1, vend - start - 1)
            else:
                var epos: int32
                epos = start
                while epos < json.len && json[epos] != ',' && json[epos] != '}' && json[epos] != ' ' && json[epos] != '\n':
                    epos = epos + 1
                if epos > start:
                    return SliceBytes(json, start, epos - start)
            return ""
    return ""

# ── Config helpers (minimal: iterate configOverrides array) ─────────────────

fn ConfigIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn ConfigTrim(raw: str): str =
    if raw.len == 0:
        return ""
    var start: int32
    while start < raw.len && ConfigIsSpace(raw[start]):
        start = start + 1
    if start >= raw.len:
        return ""
    var stop: int32
    stop = raw.len
    while stop > start && ConfigIsSpace(raw[stop - 1]):
        stop = stop - 1
    return SliceBytes(raw, start, stop - start)

fn ConfigFindEquals(raw: str): int32 =
    for i in 0..<raw.len:
        if raw[i] == '=':
            return i
    return -1

fn ConfigOverrideStringForKey(execPlan: var RustCsgExecPlan, key: str, outError: var str): str =
    outError = ""
    for i in 0..<execPlan.configOverrides.len:
        let raw = execPlan.configOverrides[i]
        let eq = ConfigFindEquals(raw)
        if eq <= 0:
            outError = Cat("invalid config override: ", raw)
            return ""
        let foundKey = ConfigTrim(SliceBytes(raw, 0, eq))
        if foundKey != key:
            continue
        let rawVal = ConfigTrim(SliceBytes(raw, eq + 1, raw.len - eq - 1))
        if rawVal == "":
            outError = "empty config override value"
            return ""
        return JsonQuote(rawVal)
    return ""

fn ConfigFirstStringOverride(execPlan: var RustCsgExecPlan, keyA: str, keyB: str, outError: var str): str =
    outError = ""
    let first = ConfigOverrideStringForKey(execPlan, keyA, outError)
    if outError != "" || first != "":
        return first
    if keyB == "":
        return ""
    return ConfigOverrideStringForKey(execPlan, keyB, outError)

fn ConfigOverrideBoolJsonForKey(execPlan: var RustCsgExecPlan, key: str, outError: var str): str =
    let valueJson = ConfigOverrideStringForKey(execPlan, key, outError)
    if outError != "" || valueJson == "":
        return ""
    if valueJson != "\"true\"" && valueJson != "\"false\"":
        outError = Cat("config override value must be bool: ", valueJson)
        return ""
    if valueJson == "\"true\"":
        return "true"
    return "false"

fn ConfigOverridesParseError(execPlan: var RustCsgExecPlan): str =
    for i in 0..<execPlan.configOverrides.len:
        var err: str
        let raw = execPlan.configOverrides[i]
        let eq = ConfigFindEquals(raw)
        if eq <= 0:
            return Cat("invalid config override: ", raw)
        let key = ConfigTrim(SliceBytes(raw, 0, eq))
        if key == "":
            return Cat("empty config override key: ", raw)
        let rawVal = ConfigTrim(SliceBytes(raw, eq + 1, raw.len - eq - 1))
        if rawVal == "":
            err = "empty config override value"
            return err
        if rawVal == "true" || rawVal == "false" || rawVal == "null":
            continue
        if rawVal[0] == '"' || rawVal[0] == '\'':
            if rawVal.len < 2 || rawVal[rawVal.len - 1] != rawVal[0]:
                err = Cat("unterminated config override string: ", raw)
                return err
            continue
    return ""

fn ConfigOverridesBlockedReason(execPlan: var RustCsgExecPlan): str =
    execPlan
    return ""

fn ConfigProfileJsonFromPlan(execPlan: var RustCsgExecPlan, outError: var str): str =
    outError = ""
    var profile = execPlan.configProfile
    if profile == "":
        profile = ConfigOverrideStringForKey(execPlan, "profile", outError)
    if outError != "" || profile == "":
        return ""
    var out = "{"
    out = Cat(out, JsonFieldStr("profile", profile))
    out = Cat(out, "}")
    return out

# ── Plan type ────────────────────────────────────────────────────────────────

type
    RustCsgExecPlan =
        command: str
        prompt: str
        resumeSessionId: str
        resumeLast: bool
        resumeAll: bool
        images: str[]
        model: str
        cwd: str
        sandbox: str
        color: str
        json: bool
        outputLastMessage: str
        outputSchema: str
        skipGitRepoCheck: bool
        ephemeral: bool
        ignoreUserConfig: bool
        ignoreRules: bool
        removedFullAuto: bool
        dangerouslyBypassApprovalsAndSandbox: bool
        oss: bool
        ossProvider: str
        configProfile: str
        configOverrides: str[]
        addDirs: str[]
        reviewUncommitted: bool
        reviewBase: str
        reviewCommit: str
        reviewTitle: str
        parseError: str

    RustCsgExecRequestPlan =
        kind: str
        threadId: str
        threadStartJson: str
        threadResumeJson: str
        turnStartJson: str
        reviewStartJson: str
        requestSequenceJson: str
        parseError: str
        blockedReason: str

# ── Session functions (from exec/session.cheng, pure logic only) ────────────

fn RustCsgExecJsonAppendComma(out: var str, first: var bool) =
    if first:
        first = false
    else:
        out = Cat(out, ",")

fn RustCsgExecJsonAppendStr(out: var str, first: var bool, key: str, value: str) =
    RustCsgExecJsonAppendComma(out, first)
    out = Cat(out, JsonFieldStr(key, value))

fn RustCsgExecJsonAppendRaw(out: var str, first: var bool, key: str, value: str) =
    RustCsgExecJsonAppendComma(out, first)
    out = Cat(out, JsonFieldRaw(key, value))

fn RustCsgExecJsonAppendOptionalStr(out: var str, first: var bool, key: str, value: str) =
    if value != "":
        RustCsgExecJsonAppendStr(out, first, key, value)

fn RustCsgExecJsonAppendOptionalRaw(out: var str, first: var bool, key: str, value: str) =
    if value != "":
        RustCsgExecJsonAppendRaw(out, first, key, value)

fn RustCsgExecEffectiveStringOverride(execPlan: var RustCsgExecPlan,
                                      key: str,
                                      outError: var str): str =
    return ConfigOverrideStringForKey(execPlan, key, outError)

fn RustCsgExecUserConfigString(userConfigJson: str, field: str): str =
    if userConfigJson == "":
        return ""
    return JsonFindOptionalStr(userConfigJson, field)

fn RustCsgExecSelectedProfileOverrideFromPlan(execPlan: var RustCsgExecPlan,
                                             outError: var str): str =
    outError = ""
    if execPlan.configProfile != "":
        return execPlan.configProfile
    return ConfigOverrideStringForKey(execPlan, "profile", outError)

fn RustCsgExecDefaultModelForOssProvider(provider: str): str =
    if provider == "lmstudio":
        return "openai/gpt-oss-20b"
    if provider == "ollama":
        return "gpt-oss:20b"
    return ""

fn RustCsgExecEffectiveModelFromPlan(execPlan: var RustCsgExecPlan,
                                     outError: var str): str =
    return RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                   userConfigJson: str,
                                                   outError: var str): str =
    outError = ""
    if execPlan.model != "":
        return execPlan.model
    let overrideModel = RustCsgExecEffectiveStringOverride(execPlan, "model", outError)
    if outError != "" || overrideModel != "":
        return overrideModel
    if execPlan.oss:
        let provider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan,
                                                                               userConfigJson,
                                                                               outError)
        if outError != "":
            return ""
        let defaultModel = RustCsgExecDefaultModelForOssProvider(provider)
        if defaultModel != "":
            return defaultModel
    return RustCsgExecUserConfigString(userConfigJson, "model")

fn RustCsgExecEffectiveCwdFromPlan(execPlan: var RustCsgExecPlan,
                                   outError: var str): str =
    outError = ""
    if execPlan.cwd != "":
        return execPlan.cwd
    return RustCsgExecEffectiveStringOverride(execPlan, "cwd", outError)

fn RustCsgExecEffectiveModelProviderFromPlan(execPlan: var RustCsgExecPlan,
                                             outError: var str): str =
    return RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                           userConfigJson: str,
                                                           outError: var str): str =
    outError = ""
    if execPlan.ossProvider != "":
        return execPlan.ossProvider
    var provider = ConfigOverrideStringForKey(execPlan, "local_provider", outError)
    if outError != "" || provider != "":
        return provider
    provider = ConfigOverrideStringForKey(execPlan, "oss_provider", outError)
    if outError != "" || provider != "":
        return provider
    if execPlan.oss:
        provider = RustCsgExecUserConfigString(userConfigJson, "ossProvider")
        if provider != "":
            return provider
    provider = ConfigOverrideStringForKey(execPlan, "model_provider", outError)
    if outError != "" || provider != "":
        return provider
    provider = ConfigOverrideStringForKey(execPlan, "model_provider_id", outError)
    if outError != "" || provider != "":
        return provider
    if !execPlan.oss:
        return RustCsgExecUserConfigString(userConfigJson, "modelProvider")
    return ""

fn RustCsgExecApprovalPolicyValueValid(value: str): bool =
    if value == "untrusted" || value == "on-failure" || value == "on-request":
        return true
    return value == "never"

fn RustCsgExecApprovalPolicyJsonFromPlan(execPlan: var RustCsgExecPlan,
                                         outError: var str): str =
    outError = ""
    let value = ConfigOverrideStringForKey(execPlan, "approval_policy", outError)
    if outError != "":
        return ""
    if value == "":
        return "\"never\""
    let unquoted = SliceBytes(value, 1, value.len - 2)
    if !RustCsgExecApprovalPolicyValueValid(unquoted):
        outError = Cat("invalid approval_policy config override: ", unquoted)
        return ""
    return value

fn RustCsgExecApprovalsReviewerCanonical(value: str): str =
    if value == "user":
        return "user"
    if value == "guardian_subagent" || value == "auto_review":
        return "guardian_subagent"
    return ""

fn RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                      userConfigJson: str,
                                                      outError: var str): str =
    outError = ""
    let overrideReviewer = ConfigOverrideStringForKey(execPlan, "approvals_reviewer", outError)
    if outError != "":
        return ""
    if overrideReviewer != "":
        let unquoted = SliceBytes(overrideReviewer, 1, overrideReviewer.len - 2)
        let canonicalOverride = RustCsgExecApprovalsReviewerCanonical(unquoted)
        if canonicalOverride == "":
            outError = Cat("invalid approvals_reviewer config override: ", unquoted)
            return ""
        return canonicalOverride
    let userReviewer = RustCsgExecUserConfigString(userConfigJson, "approvalsReviewer")
    if userReviewer != "":
        let canonicalUser = RustCsgExecApprovalsReviewerCanonical(userReviewer)
        if canonicalUser == "":
            outError = Cat("invalid approvals_reviewer config value: ", userReviewer)
            return ""
        return canonicalUser
    return "user"

fn RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                    userConfigJson: str,
                                                    outError: var str): str =
    outError = ""
    var profileId = ConfigOverrideStringForKey(execPlan, "default_permissions", outError)
    if outError != "":
        return ""
    if profileId == "":
        profileId = RustCsgExecUserConfigString(userConfigJson, "defaultPermissions")
    if profileId == "":
        return ""
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "profile"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("id", profileId))
    if execPlan.addDirs.len > 0:
        out = Cat(out, ",\"modifications\":[")
        for i in 0..<execPlan.addDirs.len:
            if i > 0:
                out = Cat(out, ",")
            out = Cat(out, "{\"type\":\"additionalWritableRoot\",")
            out = Cat(out, JsonFieldStr("path", execPlan.addDirs[i]))
            out = Cat(out, "}")
        out = Cat(out, "]")
    out = Cat(out, "}")
    return out

fn RustCsgExecUserConfigSemanticError(userConfigJson: str): str =
    let approval = RustCsgExecUserConfigString(userConfigJson, "approvalPolicy")
    if approval != "" && !RustCsgExecApprovalPolicyValueValid(approval):
        return Cat("invalid approval_policy config value: ", approval)
    let reviewer = RustCsgExecUserConfigString(userConfigJson, "approvalsReviewer")
    if reviewer != "" && RustCsgExecApprovalsReviewerCanonical(reviewer) == "":
        return Cat("invalid approvals_reviewer config value: ", reviewer)
    let sandbox = RustCsgExecUserConfigString(userConfigJson, "sandboxMode")
    if sandbox != "" && !RustCsgExecSandboxValueValid(sandbox):
        return Cat("invalid sandbox_mode config value: ", sandbox)
    return ""

fn RustCsgExecSandboxValueValid(value: str): bool =
    if value == "read-only" || value == "workspace-write":
        return true
    return value == "danger-full-access"

fn RustCsgExecSandboxJsonFromPlan(execPlan: var RustCsgExecPlan,
                                  outError: var str): str =
    return RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, "", outError)

fn RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                userConfigJson: str,
                                                outError: var str): str =
    outError = ""
    if execPlan.removedFullAuto:
        return "\"workspace-write\""
    if execPlan.dangerouslyBypassApprovalsAndSandbox:
        return "\"danger-full-access\""
    if execPlan.sandbox != "":
        if !RustCsgExecSandboxValueValid(execPlan.sandbox):
            outError = Cat("invalid --sandbox value: ", execPlan.sandbox)
            return ""
        return JsonQuote(execPlan.sandbox)
    var sandbox = ConfigFirstStringOverride(execPlan, "sandbox", "sandbox_mode", outError)
    if outError != "":
        return ""
    if sandbox != "":
        let unquoted = SliceBytes(sandbox, 1, sandbox.len - 2)
        if !RustCsgExecSandboxValueValid(unquoted):
            outError = Cat("invalid sandbox_mode config override: ", unquoted)
            return ""
        return sandbox
    sandbox = RustCsgExecUserConfigString(userConfigJson, "sandboxMode")
    if sandbox == "":
        return ""
    if !RustCsgExecSandboxValueValid(sandbox):
        outError = Cat("invalid sandbox_mode config value: ", sandbox)
        return ""
    return JsonQuote(sandbox)

fn RustCsgExecEphemeralJsonFromPlan(execPlan: var RustCsgExecPlan,
                                    outError: var str): str =
    outError = ""
    if execPlan.ephemeral:
        return "true"
    let valueJson = ConfigOverrideBoolJsonForKey(execPlan, "ephemeral", outError)
    if outError != "":
        return ""
    if valueJson != "":
        return valueJson
    return "false"

fn RustCsgExecConfigSemanticErrorFromPlan(execPlan: var RustCsgExecPlan): str =
    return RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecConfigSemanticErrorFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                        userConfigJson: str): str =
    let userConfigError = RustCsgExecUserConfigSemanticError(userConfigJson)
    if userConfigError != "":
        return userConfigError
    var err: str
    RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    if err != "":
        return err
    RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    if err != "":
        return err
    RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    if err != "":
        return err
    RustCsgExecEphemeralJsonFromPlan(execPlan, err)
    if err != "":
        return err
    ConfigProfileJsonFromPlan(execPlan, err)
    if err != "":
        return err
    return ""

fn RustCsgExecBlockedReasonFromPlan(execPlan: var RustCsgExecPlan): str =
    return RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecBlockedReasonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                  userConfigJson: str): str =
    var err: str
    let provider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    err
    if execPlan.oss && provider == "":
        return "OSS provider resolution from config not ported"
    let configBlocked = ConfigOverridesBlockedReason(execPlan)
    if configBlocked != "":
        return configBlocked
    return ""

fn RustCsgExecThreadStartParamsJsonFromPlan(execPlan: var RustCsgExecPlan): str =
    return RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan, "")

fn RustCsgExecThreadStartParamsJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                          userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let model = RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let modelProvider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    let approvalsReviewer = RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let permissionsJson = RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    var sandboxJson: str
    if permissionsJson == "":
        sandboxJson = RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let configJson = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let ephemeralJson = RustCsgExecEphemeralJsonFromPlan(execPlan, err)
    err
    RustCsgExecJsonAppendOptionalStr(out, first, "model", model)
    RustCsgExecJsonAppendOptionalStr(out, first, "modelProvider", modelProvider)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendStr(out, first, "approvalsReviewer", approvalsReviewer)
    RustCsgExecJsonAppendOptionalRaw(out, first, "sandbox", sandboxJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "permissions", permissionsJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "config", configJson)
    RustCsgExecJsonAppendRaw(out, first, "ephemeral", ephemeralJson)
    RustCsgExecJsonAppendRaw(out, first, "sessionStartSource", "\"cli\"")
    out = Cat(out, "}")
    return out

fn RustCsgExecThreadResumeParamsJsonFromPlan(execPlan: var RustCsgExecPlan, threadId: str): str =
    return RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan, threadId, "")

fn RustCsgExecThreadResumeParamsJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                           threadId: str,
                                                           userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let model = RustCsgExecEffectiveModelFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let modelProvider = RustCsgExecEffectiveModelProviderFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    let approvalsReviewer = RustCsgExecApprovalsReviewerFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let permissionsJson = RustCsgExecPermissionsJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    var sandboxJson: str
    if permissionsJson == "":
        sandboxJson = RustCsgExecSandboxJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    let configJson = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan, userConfigJson, err)
    err
    RustCsgExecJsonAppendStr(out, first, "threadId", threadId)
    RustCsgExecJsonAppendOptionalStr(out, first, "model", model)
    RustCsgExecJsonAppendOptionalStr(out, first, "modelProvider", modelProvider)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendStr(out, first, "approvalsReviewer", approvalsReviewer)
    RustCsgExecJsonAppendOptionalRaw(out, first, "sandbox", sandboxJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "permissions", permissionsJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "config", configJson)
    out = Cat(out, "}")
    return out

fn RustCsgExecTurnStartParamsJsonFromPlan(execPlan: var RustCsgExecPlan,
                                          threadId: str,
                                          inputJson: str,
                                          outputSchemaJson: str): str =
    return RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan, threadId, inputJson, outputSchemaJson, "")

fn RustCsgExecTurnStartParamsJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                        threadId: str,
                                                        inputJson: str,
                                                        outputSchemaJson: str,
                                                        userConfigJson: str): str =
    var out = "{"
    var first: bool
    first = true
    var err: str
    let cwd = RustCsgExecEffectiveCwdFromPlan(execPlan, err)
    let approvalPolicyJson = RustCsgExecApprovalPolicyJsonFromPlan(execPlan, err)
    err
    RustCsgExecJsonAppendStr(out, first, "threadId", threadId)
    RustCsgExecJsonAppendRaw(out, first, "input", inputJson)
    RustCsgExecJsonAppendOptionalStr(out, first, "cwd", cwd)
    RustCsgExecJsonAppendRaw(out, first, "approvalPolicy", approvalPolicyJson)
    RustCsgExecJsonAppendOptionalRaw(out, first, "outputSchema", outputSchemaJson)
    out = Cat(out, "}")
    return out

fn RustCsgExecConfigProfileJsonFromPlanWithUserConfig(execPlan: var RustCsgExecPlan,
                                                      userConfigJson: str,
                                                      outError: var str): str =
    outError = ""
    let configJson = ConfigProfileJsonFromPlan(execPlan, outError)
    if outError != "" || configJson != "":
        return configJson
    let profile = RustCsgExecUserConfigString(userConfigJson, "profile")
    if profile == "":
        return ""
    var out = "{"
    out = Cat(out, JsonFieldStr("profile", profile))
    out = Cat(out, "}")
    return out

fn RustCsgExecReviewStartParamsJson(threadId: str, reviewTargetJson: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("threadId", threadId))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("target", reviewTargetJson))
    out = Cat(out, "}")
    return out

fn RustCsgExecRequestEntryJson(method: str, paramsJson: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("method", method))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("params", paramsJson))
    out = Cat(out, "}")
    return out

fn RustCsgExecBuildStartUserTurnSequence(threadStartJson: str, turnStartJson: str): str =
    var out = "["
    out = Cat(out, RustCsgExecRequestEntryJson("thread/start", threadStartJson))
    out = Cat(out, ",")
    out = Cat(out, RustCsgExecRequestEntryJson("turn/start", turnStartJson))
    out = Cat(out, "]")
    return out

fn RustCsgExecBuildResumeUserTurnSequence(threadResumeJson: str, turnStartJson: str): str =
    var out = "["
    out = Cat(out, RustCsgExecRequestEntryJson("thread/resume", threadResumeJson))
    out = Cat(out, ",")
    out = Cat(out, RustCsgExecRequestEntryJson("turn/start", turnStartJson))
    out = Cat(out, "]")
    return out

fn RustCsgExecBuildReviewSequence(threadStartJson: str, reviewStartJson: str): str =
    var out = "["
    out = Cat(out, RustCsgExecRequestEntryJson("thread/start", threadStartJson))
    out = Cat(out, ",")
    out = Cat(out, RustCsgExecRequestEntryJson("review/start", reviewStartJson))
    out = Cat(out, "]")
    return out

fn RustCsgExecRequestPlanToJson(requestPlan: RustCsgExecRequestPlan): str =
    var sequenceJson = requestPlan.requestSequenceJson
    if sequenceJson == "":
        sequenceJson = "[]"
    var out = "{"
    out = Cat(out, JsonFieldStr("kind", requestPlan.kind))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("threadId", requestPlan.threadId))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("requestSequence", sequenceJson))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("parseError", requestPlan.parseError))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("blockedReason", requestPlan.blockedReason))
    out = Cat(out, "}")
    return out

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn checkStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL str ")
        echo(name)
        echo(": expected=\"")
        echo(expected)
        echo("\" actual=\"")
        echo(actual)
        echo("\"\n")
        return false
    return true

fn checkBool(name: str, expected: bool, actual: bool): bool =
    if expected != actual:
        echo("FAIL bool ")
        echo(name)
        echo(": expected=")
        if expected:
            echo("true")
        else:
            echo("false")
        echo(" actual=")
        if actual:
            echo("true")
        else:
            echo("false")
        echo("\n")
        return false
    return true

fn planDefault(): RustCsgExecPlan =
    var p: RustCsgExecPlan
    p.command = "run"
    p.color = "auto"
    return p

# ── GROUP 1: JSON Append Helpers ────────────────────────────────────────────

fn testJsonAppendComma(): bool =
    var ok: bool = true
    var out: str
    var first: bool
    first = true
    RustCsgExecJsonAppendComma(out, first)
    if !checkStr("AppendComma_first", "", out):
        ok = false
    if !checkBool("AppendComma_first_flag", false, first):
        ok = false
    RustCsgExecJsonAppendComma(out, first)
    if !checkStr("AppendComma_second", ",", out):
        ok = false
    if ok:
        echo("testJsonAppendComma ok")
    return ok

fn testJsonAppendStr(): bool =
    var ok: bool = true
    var out: str
    var first: bool
    first = true
    RustCsgExecJsonAppendStr(out, first, "key", "value")
    if !checkStr("AppendStr_first", "\"key\":\"value\"", out):
        ok = false
    RustCsgExecJsonAppendStr(out, first, "k2", "v2")
    if !checkStr("AppendStr_second", "\"key\":\"value\",\"k2\":\"v2\"", out):
        ok = false
    if ok:
        echo("testJsonAppendStr ok")
    return ok

fn testJsonAppendRaw(): bool =
    var ok: bool = true
    var out: str
    var first: bool
    first = true
    RustCsgExecJsonAppendRaw(out, first, "key", "\"value\"")
    if !checkStr("AppendRaw_first", "\"key\":\"value\"", out):
        ok = false
    RustCsgExecJsonAppendRaw(out, first, "num", "42")
    if !checkStr("AppendRaw_second", "\"key\":\"value\",\"num\":42", out):
        ok = false
    if ok:
        echo("testJsonAppendRaw ok")
    return ok

fn testJsonAppendOptional(): bool =
    var ok: bool = true
    var out: str
    var first: bool
    first = true
    RustCsgExecJsonAppendOptionalStr(out, first, "skip", "")
    if !checkStr("AppendOptStr_skip", "", out):
        ok = false
    if !checkBool("AppendOptStr_skip_flag", true, first):
        ok = false
    RustCsgExecJsonAppendOptionalRaw(out, first, "skip", "")
    if !checkStr("AppendOptRaw_skip", "", out):
        ok = false
    RustCsgExecJsonAppendOptionalStr(out, first, "key", "val")
    if !checkStr("AppendOptStr_present", "\"key\":\"val\"", out):
        ok = false
    RustCsgExecJsonAppendOptionalRaw(out, first, "raw", "42")
    if !checkStr("AppendOptRaw_present", "\"key\":\"val\",\"raw\":42", out):
        ok = false
    if ok:
        echo("testJsonAppendOptional ok")
    return ok

# ── GROUP 2: Validation Functions ──────────────────────────────────────────

fn testApprovalPolicyValid(): bool =
    var ok: bool = true
    if !checkBool("Apv_untrusted", true, RustCsgExecApprovalPolicyValueValid("untrusted")): ok = false
    if !checkBool("Apv_on-failure", true, RustCsgExecApprovalPolicyValueValid("on-failure")): ok = false
    if !checkBool("Apv_on-request", true, RustCsgExecApprovalPolicyValueValid("on-request")): ok = false
    if !checkBool("Apv_never", true, RustCsgExecApprovalPolicyValueValid("never")): ok = false
    if !checkBool("Apv_invalid", false, RustCsgExecApprovalPolicyValueValid("invalid")): ok = false
    if !checkBool("Apv_empty", false, RustCsgExecApprovalPolicyValueValid("")): ok = false
    if ok:
        echo("testApprovalPolicyValid ok")
    return ok

fn testSandboxValid(): bool =
    var ok: bool = true
    if !checkBool("Sbx_read-only", true, RustCsgExecSandboxValueValid("read-only")): ok = false
    if !checkBool("Sbx_workspace-write", true, RustCsgExecSandboxValueValid("workspace-write")): ok = false
    if !checkBool("Sbx_danger-full-access", true, RustCsgExecSandboxValueValid("danger-full-access")): ok = false
    if !checkBool("Sbx_invalid", false, RustCsgExecSandboxValueValid("full-access")): ok = false
    if !checkBool("Sbx_empty", false, RustCsgExecSandboxValueValid("")): ok = false
    if ok:
        echo("testSandboxValid ok")
    return ok

fn testApprovalsReviewerCanonical(): bool =
    var ok: bool = true
    if !checkStr("Arc_user", "user", RustCsgExecApprovalsReviewerCanonical("user")): ok = false
    if !checkStr("Arc_guardian", "guardian_subagent", RustCsgExecApprovalsReviewerCanonical("guardian_subagent")): ok = false
    if !checkStr("Arc_auto_review", "guardian_subagent", RustCsgExecApprovalsReviewerCanonical("auto_review")): ok = false
    if !checkStr("Arc_empty", "", RustCsgExecApprovalsReviewerCanonical("")): ok = false
    if !checkStr("Arc_invalid", "", RustCsgExecApprovalsReviewerCanonical("unknown")): ok = false
    if ok:
        echo("testApprovalsReviewerCanonical ok")
    return ok

# ── GROUP 3: Model Selection ────────────────────────────────────────────────

fn testDefaultModelForOssProvider(): bool =
    var ok: bool = true
    if !checkStr("Oss_lmstudio", "openai/gpt-oss-20b", RustCsgExecDefaultModelForOssProvider("lmstudio")): ok = false
    if !checkStr("Oss_ollama", "gpt-oss:20b", RustCsgExecDefaultModelForOssProvider("ollama")): ok = false
    if !checkStr("Oss_other", "", RustCsgExecDefaultModelForOssProvider("other")): ok = false
    if !checkStr("Oss_empty", "", RustCsgExecDefaultModelForOssProvider("")): ok = false
    if ok:
        echo("testDefaultModelForOssProvider ok")
    return ok

fn testEffectiveModelFromPlan(): bool =
    var ok: bool = true
    var err: str
    var p = planDefault()

    # Plan model set -> returns plan model
    p.model = "gpt-4"
    let result = RustCsgExecEffectiveModelFromPlanWithUserConfig(p, "", err)
    if !checkStr("EffModel_plan", "gpt-4", result): ok = false

    # Plan model empty, user config has model
    p.model = ""
    let userCfg = "{\"model\":\"claude-4\"}"
    let result2 = RustCsgExecEffectiveModelFromPlanWithUserConfig(p, userCfg, err)
    if !checkStr("EffModel_userCfg", "claude-4", result2): ok = false

    # Empty plan + empty user config -> ""
    p.model = ""
    let result3 = RustCsgExecEffectiveModelFromPlanWithUserConfig(p, "", err)
    if !checkStr("EffModel_empty", "", result3): ok = false

    if ok:
        echo("testEffectiveModelFromPlan ok")
    return ok

fn testEffectiveCwdFromPlan(): bool =
    var ok: bool = true
    var err: str
    var p = planDefault()

    p.cwd = "/tmp/project"
    let cwd1 = RustCsgExecEffectiveCwdFromPlan(p, err)
    if !checkStr("EffCwd_plan", "/tmp/project", cwd1): ok = false

    p.cwd = ""
    let cwd2 = RustCsgExecEffectiveCwdFromPlan(p, err)
    if !checkStr("EffCwd_empty", "", cwd2): ok = false

    if ok:
        echo("testEffectiveCwdFromPlan ok")
    return ok

# ── GROUP 4: Sandbox Mode Mapping ──────────────────────────────────────────

fn testSandboxJsonFromPlan(): bool =
    var ok: bool = true
    var err: str
    var p = planDefault()

    # removedFullAuto -> workspace-write
    p.removedFullAuto = true
    let s1 = RustCsgExecSandboxJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("Sbx_removedFullAuto", "\"workspace-write\"", s1): ok = false

    # dangerouslyBypass -> danger-full-access
    p = planDefault()
    p.dangerouslyBypassApprovalsAndSandbox = true
    let s2 = RustCsgExecSandboxJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("Sbx_dangerous", "\"danger-full-access\"", s2): ok = false

    # explicit sandbox -> quoted
    p = planDefault()
    p.sandbox = "read-only"
    let s3 = RustCsgExecSandboxJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("Sbx_explicit", "\"read-only\"", s3): ok = false

    # invalid sandbox -> error
    p = planDefault()
    p.sandbox = "bad-value"
    let s4 = RustCsgExecSandboxJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("Sbx_invalid", "", s4): ok = false
    if !checkBool("Sbx_invalid_err", true, err != ""): ok = false

    # user config sandbox
    p = planDefault()
    let userCfg = "{\"sandboxMode\":\"workspace-write\"}"
    let s5 = RustCsgExecSandboxJsonFromPlanWithUserConfig(p, userCfg, err)
    if !checkStr("Sbx_userCfg", "\"workspace-write\"", s5): ok = false

    if ok:
        echo("testSandboxJsonFromPlan ok")
    return ok

# ── GROUP 5: Permissions JSON ──────────────────────────────────────────────

fn testPermissionsJson(): bool =
    var ok: bool = true
    var err: str
    var p = planDefault()

    # No default_permissions -> empty
    let p1 = RustCsgExecPermissionsJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("Perm_none", "", p1): ok = false

    # From user config, no addDirs
    let userCfg = "{\"defaultPermissions\":\"workspace\"}"
    let p2 = RustCsgExecPermissionsJsonFromPlanWithUserConfig(p, userCfg, err)
    let expected2 = "{\"type\":\"profile\",\"id\":\"workspace\"}"
    if !checkStr("Perm_profile", expected2, p2): ok = false

    # From user config, with addDirs
    add(p.addDirs, "/extra")
    add(p.addDirs, "/more")
    let p3 = RustCsgExecPermissionsJsonFromPlanWithUserConfig(p, userCfg, err)
    let expected3 = "{\"type\":\"profile\",\"id\":\"workspace\",\"modifications\":[{\"type\":\"additionalWritableRoot\",\"path\":\"/extra\"},{\"type\":\"additionalWritableRoot\",\"path\":\"/more\"}]}"
    if !checkStr("Perm_withDirs", expected3, p3): ok = false

    if ok:
        echo("testPermissionsJson ok")
    return ok

# ── GROUP 6: User Config Semantic Error ────────────────────────────────────

fn testUserConfigSemanticError(): bool =
    var ok: bool = true

    # Empty -> no error
    let e1 = RustCsgExecUserConfigSemanticError("")
    if !checkStr("UcErr_empty", "", e1): ok = false

    # Valid -> no error
    let validCfg = "{\"approvalPolicy\":\"never\"}"
    let e2 = RustCsgExecUserConfigSemanticError(validCfg)
    if !checkStr("UcErr_valid", "", e2): ok = false

    # Invalid approvalPolicy -> error
    let badAppr = "{\"approvalPolicy\":\"maybe\"}"
    let e3 = RustCsgExecUserConfigSemanticError(badAppr)
    if !checkBool("UcErr_badAppr", true, e3 != ""): ok = false

    # Invalid approvalsReviewer -> error
    let badRev = "{\"approvalsReviewer\":\"nobody\"}"
    let e4 = RustCsgExecUserConfigSemanticError(badRev)
    if !checkBool("UcErr_badRev", true, e4 != ""): ok = false

    # Invalid sandboxMode -> error
    let badSbx = "{\"sandboxMode\":\"unrestricted\"}"
    let e5 = RustCsgExecUserConfigSemanticError(badSbx)
    if !checkBool("UcErr_badSbx", true, e5 != ""): ok = false

    if ok:
        echo("testUserConfigSemanticError ok")
    return ok

# ── GROUP 7: Config Profile JSON Merge ─────────────────────────────────────

fn testConfigProfileJson(): bool =
    var ok: bool = true
    var err: str

    # Empty plan + empty user config -> empty
    var p = planDefault()
    let c1 = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("CfgProf_empty", "", c1): ok = false

    # Plan configProfile set
    p.configProfile = "my-profile"
    let c2 = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(p, "", err)
    if !checkStr("CfgProf_plan", "{\"profile\":\"my-profile\"}", c2): ok = false

    # From user config
    p = planDefault()
    let userCfg = "{\"profile\":\"user-profile\"}"
    let c3 = RustCsgExecConfigProfileJsonFromPlanWithUserConfig(p, userCfg, err)
    if !checkStr("CfgProf_user", "{\"profile\":\"user-profile\"}", c3): ok = false

    if ok:
        echo("testConfigProfileJson ok")
    return ok

