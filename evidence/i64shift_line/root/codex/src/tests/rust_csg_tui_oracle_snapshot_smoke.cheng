import std/cmdline
import std/strings
import cheng/codex/tui/oracle_snapshot as snapshot

fn checkEqStr(label: str, got: str, expected: str): bool =
    if got != expected:
        echo(strings.ConcatStr(strings.ConcatStr("FAIL ", label),
                               strings.ConcatStr(" expected=", strings.ConcatStr(expected,
                                                                                  strings.ConcatStr(" got=", got)))))
        return false
    return true

fn checkEqI32(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strings.ConcatStr(strings.ConcatStr("FAIL ", label),
                               strings.ConcatStr(" expected=", strings.ConcatStr(strings.IntToStr(expected),
                                                                                  strings.ConcatStr(" got=", strings.IntToStr(got))))))
        return false
    echo(strings.ConcatStr(strings.ConcatStr(label, "="), strings.IntToStr(got)))
    return true

fn main(): int32 =
    if cmdline.argCount() < 3:
        echo("FAIL usage: rust_csg_tui_oracle_snapshot_smoke <diff_snapshot> <macos_snapshot>")
        return 1
    let diff = snapshot.RustCsgTuiOracleSnapshotParseFile(cmdline.argStr(1))
    if !diff.ok:
        echo(strings.ConcatStr("FAIL diff parse: ", diff.error))
        return 1
    if !checkEqStr("diff_source", diff.source, "tui/src/diff_render.rs"):
        return 1
    if !checkEqStr("diff_expression", diff.expression, "terminal.backend()"):
        return 1
    if !checkEqI32("diff_body_lines", diff.bodyLineCount, 10):
        return 1
    if !strings.StrContains(diff.body, "new_file.txt"):
        echo("FAIL diff body missing new_file.txt")
        return 1
    if diff.bodyByteLen <= 0:
        echo("FAIL diff body bytes must be positive")
        return 1
    echo(strings.ConcatStr("diff_body_bytes=", strings.IntToStr(diff.bodyByteLen)))

    let macos = snapshot.RustCsgTuiOracleSnapshotParseFile(cmdline.argStr(2))
    if !macos.ok:
        echo(strings.ConcatStr("FAIL macos parse: ", macos.error))
        return 1
    if !checkEqStr("macos_source", macos.source, "tui/src/status_indicator_widget.rs"):
        return 1
    if !checkEqStr("macos_expression", macos.expression, "terminal.backend()"):
        return 1
    if !checkEqI32("macos_body_lines", macos.bodyLineCount, 8):
        return 1
    if !strings.StrContains(macos.body, "esc to interrupt"):
        echo("FAIL macos body missing esc to interrupt")
        return 1
    if macos.bodyByteLen <= 0:
        echo("FAIL macos body bytes must be positive")
        return 1
    echo(strings.ConcatStr("macos_body_bytes=", strings.IntToStr(macos.bodyByteLen)))
    echo("rust_csg_tui_oracle_snapshot_smoke ok")
    return 0
