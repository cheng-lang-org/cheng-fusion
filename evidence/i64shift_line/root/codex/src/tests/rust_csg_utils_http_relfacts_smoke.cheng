fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgUtilsHttpHeader =\n        name: str\n        value: str\n\nfn RustCsgUtilsHttpLowerAsciiChar(ch: char): str =\nfn RustCsgUtilsHttpLowerAscii(text: str): str =\nfn RustCsgUtilsHttpTrimQuote(text: str): str =\nfn RustCsgUtilsHttpFindChar(text: str, ch: char): int32 =\nfn RustCsgUtilsHttpTrimTrailingCr(text: str): str =\nfn RustCsgUtilsHttpParseContentType(header: str, outMimeType: var str, outCharset: var str, outHasCharset: var bool): =\nfn RustCsgUtilsHttpBuildHttpPostRequest(host: str, path: str, body: str, contentType: str): str =\nfn RustCsgUtilsHttpParseHeaders(rawHeaders: str): RustCsgUtilsHttpHeader[] =\nfn RustCsgUtilsHttpParseHeaderValue(rawHeaders: str, name: str): str =\nfn RustCsgUtilsHttpParseHeaderCount(rawHeaders: str): int32 =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tutils_http\nLocalType\tutils_http\tRustCsgUtilsHttpHeader\nHasField\tutils_http\tRustCsgUtilsHttpHeader\tname\tstr\nHasField\tutils_http\tRustCsgUtilsHttpHeader\tvalue\tstr\nFunction\tutils_http\tRustCsgUtilsHttpLowerAsciiChar\tstr\nFunction\tutils_http\tRustCsgUtilsHttpLowerAscii\tstr\nFunction\tutils_http\tRustCsgUtilsHttpTrimQuote\tstr\nFunction\tutils_http\tRustCsgUtilsHttpFindChar\tint32\nFunction\tutils_http\tRustCsgUtilsHttpTrimTrailingCr\tstr\nFunction\tutils_http\tRustCsgUtilsHttpParseContentType\t\nFunction\tutils_http\tRustCsgUtilsHttpBuildHttpPostRequest\tstr\nFunction\tutils_http\tRustCsgUtilsHttpParseHeaders\tRustCsgUtilsHttpHeader[]\nFunction\tutils_http\tRustCsgUtilsHttpParseHeaderValue\tstr\nFunction\tutils_http\tRustCsgUtilsHttpParseHeaderCount\tint32\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 2, "source field count")
    assert(ecn == 10, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 2, "oracle field count")
    assert(ocn == 10, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_utils_http_relfacts_smoke ok")
    return 0

main()