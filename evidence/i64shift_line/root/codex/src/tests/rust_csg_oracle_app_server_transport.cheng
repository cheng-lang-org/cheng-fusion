import cheng/codex/crates/app_server_transport/app_server_transport as m
fn main(): int32 =
    var pass: int32
    if m.TransportEventVariantNames() == "ConnectionOpened,ConnectionClosed,IncomingMessage": pass = pass + 1
    if m.ConnectionClosedFields() == "connection_id|ConnectionId": pass = pass + 1
    if pass == 2: echo("rust_csg_oracle_app_server_transport ok"); return 0
    echo("oracle FAIL"); return 1
main()
