# ═══════════════════════════════════════════════════════════════════════════════
# CHENG_RELFACTS Roundtrip Smoke Test
#
# Verifies the CHENG_RELFACTS format supports all 5 predicate types:
# LocalType, HasField, Function, Import, ForeignFunc.
# Compatible with CHENG_RELFACTS_ORACLE format.
# Uses the same counting pattern as existing relfacts smoke tests.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn CountOracleImports(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 6 && oracle[lineStart] == 'I' && oracle[lineStart + 1] == 'm':
                c = c + 1
    return c

fn CountOracleForeignFuncs(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 11 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn main(): int32 =
    # CHENG_RELFACTS oracle string covering all 5 predicate types
    # Uses the CHENG_RELFACTS_ORACLE header (compatible with existing format)
    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\ttestmod\nLocalType\ttestmod\tMyType\nLocalType\ttestmod\tOtherType\nHasField\ttestmod\tMyType\tname\tstr\nHasField\ttestmod\tMyType\tcount\tint32\nFunction\ttestmod\tMyFunc\tstr\nFunction\ttestmod\tNoReturn\t\nImport\ttestmod\tstd/strings\nForeignFunc\ttestmod\tmy_native_fn\tMyNativeFn\n"

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    let oci = CountOracleImports(oracle)
    let ocff = CountOracleForeignFuncs(oracle)

    assert(oct == 2, "oracle type count")
    assert(ocf == 2, "oracle field count")
    assert(ocn == 2, "oracle function count")
    assert(oci == 1, "oracle import count")
    assert(ocff == 1, "oracle foreignFunc count")

    echo("rust_csg_relfacts_roundtrip_smoke ok")
    return 0

main()
