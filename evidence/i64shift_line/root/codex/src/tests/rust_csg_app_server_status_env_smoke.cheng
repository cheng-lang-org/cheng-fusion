import cheng/codex/app_server/status_env
import cheng/codex/protocol/wire

fn assertTrue(name: str, value: bool) =
    if !value:
        echo(wire.RustCsgCat("FAIL: ", name))
    assert(value, name)

fn assertContains(name: str, haystack: str, needle: str) =
    if !wire.RustCsgContains(haystack, needle):
        echo(wire.RustCsgCat("FAIL: ", name))
        echo(wire.RustCsgCat("missing: ", needle))
        echo(wire.RustCsgCat("in: ", haystack))
    assert(wire.RustCsgContains(haystack, needle), name)

fn testSimpleAccountsInventory() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=hidden\n"
    var out: str
    var error: str
    assertTrue("simple accounts status ok", status_env.RustCsgAppServerStatusFromDotEnv(env, "/fixture/.env", out, error))
    assertContains("simple account count", out, "\"accountCount\":2")
    assertContains("password configured", out, "\"passwordConfigured\":true")
    assertContains("quota unavailable", out, "\"quotaDataAvailable\":false")
    assertContains("first account", out, "\"email\":\"alpha@example.test\"")
    assertContains("missing status json marker", out, "\"ACCOUNT_STATUS_JSON\"")

    var rateLimitsOut: str
    assertTrue("simple accounts rate limits hard fail", !status_env.RustCsgAppServerRateLimitsFromDotEnv(env, rateLimitsOut, error))
    assertContains("rate limits missing json", error, "ACCOUNT_RATE_LIMITS_JSON")

fn testAccountsConfigErrorTextMatchesRustDashboardService() =
    var out: str
    var error: str
    assertTrue("missing accounts fails", !status_env.RustCsgAppServerStatusFromDotEnv("PASSWORD=hidden\n", "/fixture/.env", out, error))
    assertContains("missing accounts rust text", error, "ACCOUNTS is missing from /fixture/.env")
    assertTrue("empty accounts fails", !status_env.RustCsgAppServerStatusFromDotEnv("ACCOUNTS=\"   \"\nPASSWORD=hidden\n", "/fixture/.env", out, error))
    assertContains("empty accounts rust text", error, "ACCOUNTS in /fixture/.env is empty")

fn testStructuredStatusJson() =
    let env = "ACCOUNT_STATUS_JSON='{\"accounts\":[{\"email\":\"alpha@example.test\",\"subscription\":\"Plus\",\"quota\":{\"remainingPercent\":72,\"resetAt\":\"2026-06-01T00:00:00Z\"}},{\"email\":\"beta@example.test\",\"subscription\":\"Team\",\"quotaRemainingPercent\":41,\"quotaResetAt\":\"2026-06-02T00:00:00Z\"}],\"updatedAt\":\"2026-05-30T00:00:00Z\"}'\nPASSWORD=hidden\n"
    var out: str
    var error: str
    let ok = status_env.RustCsgAppServerStatusFromDotEnv(env, "/fixture/.env", out, error)
    if !ok:
        echo(wire.RustCsgCat("structured error: ", error))
    assertTrue("structured status ok", ok)
    assertContains("structured account count", out, "\"accountCount\":2")
    assertContains("structured quota available", out, "\"quotaDataAvailable\":true")
    assertContains("structured subscription", out, "\"subscription\":\"Plus\"")
    assertContains("structured normalized remaining", out, "\"quotaRemainingPercent\":72")
    assertContains("structured normalized reset", out, "\"quotaResetAt\":\"2026-06-01T00:00:00Z\"")
    assertContains("structured reset", out, "\"resetAt\":\"2026-06-01T00:00:00Z\"")
    assertContains("structured updatedAt", out, "\"updatedAt\":\"2026-05-30T00:00:00Z\"")

    var queryOut: str
    assertTrue("subscription quota alias ok", status_env.RustCsgAppServerSubscriptionQuotaFromDotEnv(env, "/fixture/.env", queryOut, error))
    assertContains("subscription quota alias reset", queryOut, "\"quotaResetAt\":\"2026-06-01T00:00:00Z\"")

fn testMalformedStructuredStatusFails() =
    let env = "ACCOUNT_STATUS_JSON='{\"accounts\":[{\"email\":\"alpha@example.test\",\"quota\":{\"remainingPercent\":72,\"resetAt\":\"2026-06-01T00:00:00Z\"}}]}'\n"
    var out: str
    var error: str
    assertTrue("malformed structured status hard fail", !status_env.RustCsgAppServerStatusFromDotEnv(env, "/fixture/.env", out, error))
    assertContains("missing subscription error", error, "missing subscription")

fn testNullQuotaFails() =
    let env = "ACCOUNT_STATUS_JSON='{\"accounts\":[{\"email\":\"alpha@example.test\",\"subscription\":\"Plus\",\"quota\":{\"remainingPercent\":null,\"resetAt\":\"2026-06-01T00:00:00Z\"}}]}'\n"
    var out: str
    var error: str
    assertTrue("null quota hard fail", !status_env.RustCsgAppServerStatusFromDotEnv(env, "/fixture/.env", out, error))
    assertContains("null quota error", error, "missing quota remaining data")

fn testRateLimitsJson() =
    let env = "ACCOUNT_RATE_LIMITS_JSON='{\"rateLimits\":{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":25,\"windowDurationMins\":300,\"resetsAt\":1780000000}},\"rateLimitsByLimitId\":null}'\n"
    var out: str
    var error: str
    assertTrue("rate limits json ok", status_env.RustCsgAppServerRateLimitsFromDotEnv(env, out, error))
    assertContains("rate limits primary", out, "\"rateLimits\":{\"limitId\":\"codex\"")
    assertContains("rate limits map null", out, "\"rateLimitsByLimitId\":null")

fn main(): int32 =
    testSimpleAccountsInventory()
    testAccountsConfigErrorTextMatchesRustDashboardService()
    testStructuredStatusJson()
    testMalformedStructuredStatusFails()
    testNullQuotaFails()
    testRateLimitsJson()
    echo("rust_csg_app_server_status_env_smoke ok")
    return 0
