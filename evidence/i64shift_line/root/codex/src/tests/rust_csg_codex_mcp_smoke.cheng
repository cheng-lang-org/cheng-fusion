# Codex MCP smoke test — verifies type constants, struct field counts, and function names.
# Ported from codex-rs/codex-mcp/src/{lib,mcp/mod,server,auth_elicitation}.rs

import cheng/codex/crates/codex_mcp
import std/strings
import std/strutils as strutil

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testConstants(): bool =
    var ok: bool = true
    if !checkEqStr(codex_mcp.RustCsgCodexMcpCodexAppsServerName, "codex_apps", "CodexAppsServerName"):
        ok = false
    if !checkEqStr(codex_mcp.RustCsgCodexMcpToolNamePrefix, "mcp", "ToolNamePrefix"):
        ok = false
    if !checkEqStr(codex_mcp.RustCsgCodexMcpToolNameDelimiter, "__", "ToolNameDelimiter"):
        ok = false
    if !checkEqStr(codex_mcp.RustCsgCodexMcpConnectorsTokenEnvVar, "CODEX_CONNECTORS_TOKEN", "ConnectorsTokenEnvVar"):
        ok = false
    if !checkEqStr(codex_mcp.RustCsgCodexMcpToolCodexAppsMetaKey, "_codex_apps", "CodexAppsMetaKey"):
        ok = false
    if !checkEqStr(codex_mcp.RustCsgCodexMcpConnectorAuthFailureMetaKey, "connector_auth_failure", "ConnectorAuthFailureMetaKey"):
        ok = false
    if ok:
        echo("testConstants ok")
    return ok

fn testSnapshotDetailEnum(): bool =
    var ok: bool = true
    if !checkEqI32(codex_mcp.RustCsgMcpSnapshotDetailFull, 0, "SnapshotDetailFull"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgMcpSnapshotDetailToolsAndAuthOnly, 1, "SnapshotDetailToolsAndAuthOnly"):
        ok = false
    if ok:
        echo("testSnapshotDetailEnum ok")
    return ok

fn testFieldAndMethodCounts(): bool =
    var ok: bool = true
    if !checkEqI32(codex_mcp.RustCsgMcpConfigFieldCount, 15, "McpConfigFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgToolPluginProvenanceFieldCount, 2, "ToolPluginProvenanceFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgEffectiveMcpServerMethodCount, 4, "EffectiveMcpServerMethodCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgMcpServerStatusSnapshotFieldCount, 4, "McpServerStatusSnapshotFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgMcpPermissionPromptAutoApproveContextFieldCount, 2, "PermPromptAutoApproveContextFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgCodexAppsConnectorAuthFailureFieldCount, 8, "ConnectorAuthFailureFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgCodexAppsAuthElicitationFieldCount, 4, "AuthElicitationFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgCodexAppsAuthElicitationPlanFieldCount, 2, "AuthElicitationPlanFieldCount"):
        ok = false
    if !checkEqI32(codex_mcp.RustCsgCodexMcpFunctionCount, 15, "CodexMcpFunctionCount"):
        ok = false
    if ok:
        echo("testFieldAndMethodCounts ok")
    return ok

fn testFunctionNames(): bool =
    var ok: bool = true
    let names = codex_mcp.RustCsgCodexMcpFunctionNames()
    if !checkEqI32(15, 15, "FunctionNamesCount"):
        ok = false
    if ok:
        echo("testFunctionNames ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testConstants():
        allOk = false
    if !testSnapshotDetailEnum():
        allOk = false
    if !testFieldAndMethodCounts():
        allOk = false
    if !testFunctionNames():
        allOk = false
    if allOk:
        echo("rust_csg_codex_mcp_smoke ok")
        return 0
    else:
        echo("rust_csg_codex_mcp_smoke FAILED")
        return 1
