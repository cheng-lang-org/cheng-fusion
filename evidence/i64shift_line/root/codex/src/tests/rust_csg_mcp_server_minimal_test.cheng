import std/strings
import std/strutils as strutil

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn main(): int32 =
    let rustInit: str = "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"codex-mcp-server\",\"version\":\"0.1.0\",\"title\":\"Codex\"}}"
    let chengInit: str = "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"codex-mcp-server\",\"version\":\"0.1.0\",\"title\":\"Codex\"}}"
    var allOk: bool = true
    if !checkEqStr(chengInit, rustInit, "initialize"):
        allOk = false
    if allOk:
        echo("rust_csg_mcp_server_compare_smoke ok")
        return 0
    echo("FAILED")
    return 1
