import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/app_server/main as app_server
import cheng/codex/protocol/wire
import cheng/codex/tui/session_bootstrap as bootstrap
import cheng/codex/tui/session_handoff as handoff
import cheng/codex/tui/session_lifecycle as lifecycle

fn SourceThreadId(): str =
    return "11111111-1111-4111-8111-111111111111"

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckMinInt32(actual: int32, minimum: int32, label: str): int32 =
    if actual >= minimum:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected at least ", strings.IntToStr(minimum), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn MakeHandoffConfig(cwd: str): lifecycle.RustCsgTuiThreadHandoffConfig =
    var config: lifecycle.RustCsgTuiThreadHandoffConfig
    config.cwd = cwd
    config.model = "gpt-5"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(cwd), "]")
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.permissionsJson = "\":workspace\""
    config.configJson = "{\"model_reasoning_effort\":\"medium\"}"
    config.baseInstructions = "base"
    config.developerInstructions = "dev"
    return config

fn PendingEvent(kind: str, payload: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("payload", payload))
    out = wire.RustCsgCat(out, "}")
    return out

fn BootstrapPendingEventsJson(): str =
    let threadId = SourceThreadId()
    let notificationPayload = wire.RustCsgCat3("{\"method\":\"thread/tokenUsage/updated\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), "}}")
    let requestPayload = wire.RustCsgCat3("{\"id\":9,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), ",\"turnId\":\"turn-cmd\",\"itemId\":\"exec-cmd\"}}")
    return strutil.Join(["[",
                         PendingEvent("notification", notificationPayload),
                         ",",
                         PendingEvent("request", requestPayload),
                         "]"], "")

fn MakeBootstrapConfig(): bootstrap.RustCsgTuiSessionBootstrapConfig =
    var config: bootstrap.RustCsgTuiSessionBootstrapConfig
    config.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.terminalResizeReflowEnabled = true
    config.pendingPrimaryEventCount = 2
    config.pendingPrimaryEventsJson = BootstrapPendingEventsJson()
    config.initialUserMessagePending = true
    config.stateConfig.permissionProfileJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.stateConfig.personalityJson = "\"test-personality\""
    config.stateConfig.messageHistoryLogId = int64(42)
    config.stateConfig.messageHistoryEntryCount = 3
    return config

fn MakeHandoffResult(method: str, requestJson: str, displayLabel: str): handoff.RustCsgTuiSessionHandoffResult =
    var result: handoff.RustCsgTuiSessionHandoffResult
    result.ok = true
    result.outcome = "request"
    result.method = method
    result.requestJson = requestJson
    result.threadId = SourceThreadId()
    result.path = "source.jsonl"
    result.displayLabel = displayLabel
    result.cwdSource = "state_db"
    result.configOutcome = "rebuilt"
    return result

fn RunBootstrap(method: str,
                paramsJson: str,
                displayLabel: str,
                requestIdJson: str,
                config: var bootstrap.RustCsgTuiSessionBootstrapConfig): bootstrap.RustCsgTuiSessionBootstrapResult =
    let requestJson = handoff.RustCsgTuiSessionHandoffRequestJson(requestIdJson, method, paramsJson)
    let responseJson = app_server.RustCsgAppServerHandleForTuiBootstrap(requestJson)
    var handoffResult = MakeHandoffResult(method, requestJson, displayLabel)
    return bootstrap.RustCsgTuiSessionBootstrapInstallFromJsonRpcResponse(handoffResult, responseJson, config)

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_session_bootstrap_smoke <work-dir>")
        return 1

    let cwd = cmdline.argStr(1)
    var failures: int32
    var lifecycleConfig = MakeHandoffConfig(cwd)
    var bootstrapConfig = MakeBootstrapConfig()

    let sourceThreadId = SourceThreadId()
    let resumeParams = lifecycle.RustCsgTuiThreadHandoffBuildResumeParams(sourceThreadId,
                                                                          lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                          "",
                                                                          lifecycleConfig)
    failures = failures + CheckEqBool(resumeParams.ok, true, "resume params ok")
    failures = failures + CheckContains(resumeParams.json, "\"runtimeWorkspaceRoots\"", "resume params roots")
    let resumeResult = RunBootstrap("thread/resume", resumeParams.json, "Existing thread", "41", bootstrapConfig)
    failures = failures + CheckEqBool(resumeResult.ok, true, "resume bootstrap ok")
    failures = failures + CheckEqStr(resumeResult.outcome, "installed", "resume outcome")
    failures = failures + CheckEqStr(resumeResult.method, "thread/resume", "resume method")
    failures = failures + CheckEqStr(resumeResult.primaryThreadId, sourceThreadId, "resume primary thread")
    failures = failures + CheckMinInt32(resumeResult.turnCount, 1, "resume turn replay count")
    failures = failures + CheckContains(resumeResult.startedJson, "\"permissionProfileSource\":\"config\"", "resume permission source")
    failures = failures + CheckContains(resumeResult.startedJson, "\"reasoningEffort\":\"medium\"", "resume reasoning effort")
    failures = failures + CheckContains(resumeResult.installJson, "\"replayKind\":\"ResumeInitialMessages\"", "resume replay kind")
    failures = failures + CheckContains(resumeResult.installJson, "\"pendingPrimaryEventReplayCount\":2", "resume pending replay")
    failures = failures + CheckContains(resumeResult.installJson, "\"pendingPrimaryNotificationReplayCount\":1", "resume pending notification")
    failures = failures + CheckContains(resumeResult.installJson, "\"pendingPrimaryRequestReplayCount\":1", "resume pending request")
    failures = failures + CheckContains(resumeResult.installJson, "\"pendingPrimaryEventReplay\":[{\"index\":0", "resume pending fifo start")
    failures = failures + CheckContains(resumeResult.installJson, "\"index\":1,\"threadId\":\"11111111-1111-4111-8111-111111111111\",\"kind\":\"request\",\"method\":\"item/commandExecution/requestApproval\"", "resume pending request fifo")
    failures = failures + CheckContains(resumeResult.installJson, "\"initialUserMessageSubmittedAfterPendingReplay\":true", "resume initial after pending")
    failures = failures + CheckContains(resumeResult.installJson, "\"chatReplayPlan\"", "resume replay plan")
    failures = failures + CheckContains(resumeResult.installJson, "› resume hello", "resume replay user text")
    failures = failures + CheckContains(resumeResult.installJson, "\"chatReplayCommandExecutionCount\":1", "resume replay command count")
    failures = failures + CheckContains(resumeResult.installJson, "• Ran echo ok\\n  └ cmd output", "resume replay command text")

    let forkParams = lifecycle.RustCsgTuiThreadHandoffBuildForkParams(sourceThreadId,
                                                                      lifecycle.RustCsgTuiThreadParamsModeEmbedded,
                                                                      "",
                                                                      lifecycleConfig)
    failures = failures + CheckEqBool(forkParams.ok, true, "fork params ok")
    failures = failures + CheckContains(forkParams.json, "\"threadSource\":\"user\"", "fork params source")
    let forkResult = RunBootstrap("thread/fork", forkParams.json, "Existing thread", "42", bootstrapConfig)
    failures = failures + CheckEqBool(forkResult.ok, true, "fork bootstrap ok")
    failures = failures + CheckEqStr(forkResult.outcome, "installed", "fork outcome")
    failures = failures + CheckEqStr(forkResult.method, "thread/fork", "fork method")
    failures = failures + CheckContains(forkResult.startedJson, wire.RustCsgCat3("\"forkedFromId\":\"", sourceThreadId, "\""), "fork parent id")
    failures = failures + CheckContains(forkResult.startedJson, "\"forkParentTitle\":\"Existing thread\"", "fork parent title")
    failures = failures + CheckMinInt32(forkResult.turnCount, 1, "fork turn replay count")
    failures = failures + CheckContains(forkResult.installJson, "\"chatReplayPlan\"", "fork replay plan")
    failures = failures + CheckContains(forkResult.installJson, "• resume reply", "fork replay agent text")
    failures = failures + CheckContains(forkResult.installJson, "\"chatReplayCommandExecutionCount\":1", "fork replay command count")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_bootstrap_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_bootstrap_smoke ok")
    return 0
