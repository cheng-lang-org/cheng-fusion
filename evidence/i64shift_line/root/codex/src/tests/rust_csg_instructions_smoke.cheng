import cheng/codex/crates/instructions/instructions as instr

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(label)
        echo(got)
        return false
    return true

fn checkBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        echo(label)
        return false
    return true

fn testUserInstructions(): bool =
    var ui: instr.RustCsgUserInstructions
    ui.directory = "test_directory"
    ui.text = "test_text"
    return checkEqStr(
        instr.RustCsgUserInstructionsSerializeToText(ui),
        "# AGENTS.md instructions for test_directory\n\n<INSTRUCTIONS>\ntest_text\n</INSTRUCTIONS>",
        "user instructions")

fn testAgentsFragmentMatches(): bool =
    let fragment = instr.RustCsgInstructionsAgentsMdFragment()
    var ok: bool = true
    if !checkBool(instr.RustCsgInstructionsFragmentMatchesText(
        fragment,
        "# AGENTS.md instructions for test_directory\n\n<INSTRUCTIONS>\ntest_text\n</INSTRUCTIONS>"),
        true,
        "agents match"):
        ok = false
    if !checkBool(instr.RustCsgInstructionsFragmentMatchesText(fragment, "test_text"), false, "agents reject"):
        ok = false
    return ok

fn testSkillInstructions(): bool =
    var si: instr.RustCsgSkillInstructions
    si.name = "demo-skill"
    si.path = "skills/demo/SKILL.md"
    si.contents = "body"
    return checkEqStr(
        instr.RustCsgSkillInstructionsSerializeToText(si),
        "<skill>\n<name>demo-skill</name>\n<path>skills/demo/SKILL.md</path>\nbody\n</skill>",
        "skill instructions")

fn testSkillFragmentMatches(): bool =
    let fragment = instr.RustCsgInstructionsSkillFragment()
    var ok: bool = true
    if !checkBool(instr.RustCsgInstructionsFragmentMatchesText(
        fragment,
        "<skill>\n<name>demo-skill</name>\n<path>skills/demo/SKILL.md</path>\nbody\n</skill>"),
        true,
        "skill match"):
        ok = false
    if !checkBool(instr.RustCsgInstructionsFragmentMatchesText(fragment, "regular text"), false, "skill reject"):
        ok = false
    return ok

fn main(): int32 =
    var ok: bool = true
    if !testUserInstructions(): ok = false
    if !testAgentsFragmentMatches(): ok = false
    if !testSkillInstructions(): ok = false
    if !testSkillFragmentMatches(): ok = false
    if ok:
        echo("rust_csg_instructions_smoke ok")
        return 0
    echo("rust_csg_instructions_smoke FAILED")
    return 1

