fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "fn HttpMethodVariantNames(): str =\nfn HttpRequestFields(): str =\nfn HttpResponseFields(): str =\nfn HttpClientFields(): str =\nfn httpClientLowerAsciiChar(ch: char): str =\nfn httpClientLowerAscii(text: str): str =\nfn httpClientTrimQuote(text: str): str =\nfn httpClientFindChar(text: str, ch: char): int32 =\nfn httpClientTrimTrailingCr(text: str): str =\nfn RustCsgHttpClientParseContentType(header: str, outMimeType: var str, outCharset: var str): =\nfn RustCsgHttpClientBuildHttpPostRequest(host: str, path: str, body: str, contentType: str, accept: str): str =\nfn RustCsgHttpClientBuildHttpGetRequest(host: str, path: str): str =\nfn RustCsgHttpClientParseHeaders(rawHeaders: str): RustCsgHttpClientHeader[] =\nfn RustCsgHttpClientMethodToString(methodIdx: int32): str =\nfn RustCsgHttpClientValidateUrl(url: str): bool =\nfn RustCsgHttpClientFindHeaderValue(headers: RustCsgHttpClientHeader[], name: str): str =\nfn RustCsgHttpClientClassifyStatusCode(status: int32): str =\ntype\n    RustCsgHttpClientHeader =\n        name: str\n        value: str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\thttp_client\nLocalType\thttp_client\tRustCsgHttpClientHeader\nHasField\thttp_client\tRustCsgHttpClientHeader\tname\tstr\nHasField\thttp_client\tRustCsgHttpClientHeader\tvalue\tstr\nFunction\thttp_client\tHttpMethodVariantNames\tstr\nFunction\thttp_client\tHttpRequestFields\tstr\nFunction\thttp_client\tHttpResponseFields\tstr\nFunction\thttp_client\tHttpClientFields\tstr\nFunction\thttp_client\thttpClientLowerAsciiChar\tstr\nFunction\thttp_client\thttpClientLowerAscii\tstr\nFunction\thttp_client\thttpClientTrimQuote\tstr\nFunction\thttp_client\thttpClientFindChar\tint32\nFunction\thttp_client\thttpClientTrimTrailingCr\tstr\nFunction\thttp_client\tRustCsgHttpClientParseContentType\t\nFunction\thttp_client\tRustCsgHttpClientBuildHttpPostRequest\tstr\nFunction\thttp_client\tRustCsgHttpClientBuildHttpGetRequest\tstr\nFunction\thttp_client\tRustCsgHttpClientParseHeaders\tRustCsgHttpClientHeader[]\nFunction\thttp_client\tRustCsgHttpClientMethodToString\tstr\nFunction\thttp_client\tRustCsgHttpClientValidateUrl\tbool\nFunction\thttp_client\tRustCsgHttpClientFindHeaderValue\tstr\nFunction\thttp_client\tRustCsgHttpClientClassifyStatusCode\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 2, "source field count")
    assert(ecn == 17, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 2, "oracle field count")
    assert(ocn == 17, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_http_client_relfacts_smoke ok")
    return 0

main()