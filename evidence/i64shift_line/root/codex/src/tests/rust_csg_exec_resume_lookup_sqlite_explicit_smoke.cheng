import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/protocol/wire

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteRelativeCwdRow")
fn RustCsgAddSqliteRelativeCwdRow(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertBool(name: str, value: bool) =
    if !value:
        echo(name)
    assert(value, name)

fn assertOk(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn checkResultThread(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult, expected: str) =
    let actual = result.threadId
    if actual != expected:
        echo(name)
        echo(actual)
        echo(expected)
    assert(actual == expected, name)

fn checkResultBlockedReason(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult, expected: str) =
    let actual = result.blockedReason
    if actual != expected:
        echo(name)
        echo(actual)
        echo(expected)
    assert(actual == expected, name)

fn assertResultResponseContains(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult, needle: str) =
    let response = result.responseJson
    assertBool(name, wire.RustCsgContains(response, needle))

fn checkResultResponse(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult, expected: str) =
    let actual = result.responseJson
    if actual != expected:
        echo(name)
        echo(actual)
        echo(expected)
    assert(actual == expected, name)

fn main(): int32 =
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    let repoCwd = "repo"
    let otherCwd = "other-repo"
    checkEq("relative_cwd_fixture", RustCsgAddSqliteRelativeCwdRow(path), "")

    var explicitNamePlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", "repo", "resume", "relative cwd thread", "continue"])
    var explicitName: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path, explicitNamePlan, "", explicitName)
    assertOk("explicit_name", explicitName)
    checkResultThread("explicit_name_thread", explicitName, "thread-relative-cwd")
    assertResultResponseContains("explicit_name_response_has_relative", explicitName, "\"id\":\"thread-relative-cwd\"")

    var explicitOtherProviderPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--all", "anthropic thread", "continue"])
    var explicitOtherProvider: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path,
                                                             explicitOtherProviderPlan,
                                                             "",
                                                             explicitOtherProvider)
    assertOk("explicit_other_provider", explicitOtherProvider)
    checkResultThread("explicit_other_provider_thread", explicitOtherProvider, "thread-4")

    var explicitAllOtherProviderPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--all", "anthropic thread", "continue"])
    var explicitAllOtherProvider: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path,
                                                             explicitAllOtherProviderPlan,
                                                             "",
                                                             explicitAllOtherProvider)
    assertOk("explicit_all_other_provider", explicitAllOtherProvider)
    checkResultThread("explicit_all_other_provider_thread", explicitAllOtherProvider, "thread-4")

    var explicitWrongCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "anthropic thread", "continue"])
    var explicitWrongCwd: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path, explicitWrongCwdPlan, "", explicitWrongCwd)
    assertBool("explicit_wrong_cwd_blocked", !explicitWrongCwd.ok)
    checkResultBlockedReason("explicit_wrong_cwd_reason", explicitWrongCwd, "explicit resume name found no thread")

    var explicitSubstringPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "thread", "continue"])
    var explicitSubstring: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path, explicitSubstringPlan, "", explicitSubstring)
    assertBool("explicit_substring_blocked", !explicitSubstring.ok)
    checkResultBlockedReason("explicit_substring_reason", explicitSubstring, "explicit resume name found no thread")

    var explicitMissingPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "missing thread", "continue"])
    var explicitMissing: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path,
                                                             explicitMissingPlan,
                                                             "openai",
                                                             explicitMissing)
    assertBool("explicit_missing_blocked", !explicitMissing.ok)
    checkResultBlockedReason("explicit_missing_reason", explicitMissing, "explicit resume name found no thread")

    var explicitIdPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                    "--cd",
                                                    repoCwd,
                                                    "resume",
                                                    "123e4567-e89b-12d3-a456-426614174000",
                                                    "continue"])
    var explicitId: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path, explicitIdPlan, "openai", explicitId)
    assertOk("explicit_id_direct", explicitId)
    checkResultThread("explicit_id_thread", explicitId, "123e4567-e89b-12d3-a456-426614174000")
    checkResultResponse("explicit_id_response", explicitId, "{}")

    echo("rust_csg_exec_resume_lookup_sqlite_explicit_smoke ok")
    return 0
