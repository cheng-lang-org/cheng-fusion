import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_guardian_history_oracle as oracle

fn RustCsgTuiChatwidgetGuardianHistoryCheck(path: str,
                                             expectedSource: str,
                                             expectedExpression: str,
                                             expectedBody: str,
                                             name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_chatwidget_guardian_history_oracle_smoke <4 snapshot paths>")
        return 1

    let source: str = "tui/src/chatwidget/tests.rs"
    let vtExpression: str = "term.backend().vt100().screen().contents()"
    let renderedExpression: str = "rendered"

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetGuardianHistoryCheck(cmdline.argStr(i), source, vtExpression, oracle.RustCsgTuiChatwidgetGuardianApprovedExec(), "guardian_approved_exec_renders_approved_request")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetGuardianHistoryCheck(cmdline.argStr(i), source, vtExpression, oracle.RustCsgTuiChatwidgetGuardianDeniedExec(), "guardian_denied_exec_renders_warning_and_denied_request")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetGuardianHistoryCheck(cmdline.argStr(i), source, renderedExpression, oracle.RustCsgTuiChatwidgetGuardianParallelReviewsAggregateStatus(), "guardian_parallel_reviews_render_aggregate_status")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetGuardianHistoryCheck(cmdline.argStr(i), source, vtExpression, oracle.RustCsgTuiChatwidgetAppServerGuardianDeniedRequest(), "app_server_guardian_review_denied_renders_denied_request")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_guardian_history_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_guardian_history_oracle_smoke FAILED")
    return exitCode
