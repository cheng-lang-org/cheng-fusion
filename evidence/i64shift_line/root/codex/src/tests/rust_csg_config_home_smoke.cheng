import cheng/codex/config/home
import cheng/codex/protocol/wire

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertContains(name: str, text: str, needle: str) =
    if !wire.RustCsgContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(wire.RustCsgContains(text, needle), name)

fn assertEmpty(name: str, value: str) =
    checkEq(name, value, "")

fn main(): int32 =
    checkEq("wire_probe", "", wire.RustCsgCat("", ""))

    let validHome = home.RustCsgGetEnv("RUST_CSG_VALID_CODEX_HOME")
    let validHomeCanonical = home.RustCsgGetEnv("RUST_CSG_VALID_CODEX_HOME_CANONICAL")
    let fileHome = home.RustCsgGetEnv("RUST_CSG_FILE_CODEX_HOME")
    let missingHome = home.RustCsgGetEnv("RUST_CSG_MISSING_CODEX_HOME")
    let fakeHome = home.RustCsgGetEnv("RUST_CSG_FAKE_HOME")
    assert(validHome != "", "valid_home_fixture")
    assert(validHomeCanonical != "", "valid_home_canonical_fixture")
    assert(fileHome != "", "file_home_fixture")
    assert(missingHome != "", "missing_home_fixture")
    assert(fakeHome != "", "fake_home_fixture")

    checkEq("process_env_value", home.RustCsgGetEnv("CODEX_HOME"), validHome)
    checkEq("valid_realpath", home.RustCsgRealPath(validHome), validHomeCanonical)
    assert(home.RustCsgPathMetadataKind(validHome) == 1, "valid_home_directory")
    assert(home.RustCsgPathMetadataKind(fileHome) == 2, "file_home_file")
    assert(home.RustCsgPathMetadataKind(missingHome) == 0, "missing_home_missing")
    assert(home.RustCsgPathIsAbsolute(validHome), "valid_home_absolute")
    assert(!home.RustCsgPathIsAbsolute("relative-home"), "relative_home_not_absolute")
    echo("rust_csg_config_home_smoke ok")
    return 0
