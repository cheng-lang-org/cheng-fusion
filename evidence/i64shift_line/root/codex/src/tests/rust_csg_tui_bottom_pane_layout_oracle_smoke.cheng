import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/bottom_pane_layout_oracle as oracle

fn RustCsgTuiBottomPaneLayoutExprArea(): str =
    return "\"render_snapshot(&pane, area)\""

fn RustCsgTuiBottomPaneLayoutExprAreaOne(): str =
    return "\"render_snapshot(&pane, area1)\""

fn RustCsgTuiBottomPaneLayoutOracleCheck(path: str, fixture: str, name: str, expression: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/mod.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expression:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 7:
        echo("FAIL usage: rust_csg_tui_bottom_pane_layout_oracle_smoke <6 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutQueuedMessagesVisibleWhenStatusHiddenSnapshot(), "queued_messages_visible_when_status_hidden", RustCsgTuiBottomPaneLayoutExprArea())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutStatusAndComposerFillHeightSnapshot(), "status_and_composer_fill_height_without_bottom_padding", RustCsgTuiBottomPaneLayoutExprArea())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutStatusAndQueuedMessagesSnapshot(), "status_and_queued_messages", RustCsgTuiBottomPaneLayoutExprArea())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutStatusHiddenHeightOneSnapshot(), "status_hidden_height_one", RustCsgTuiBottomPaneLayoutExprAreaOne())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutStatusOnlySnapshot(), "status_only", RustCsgTuiBottomPaneLayoutExprArea())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneLayoutOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneLayoutStatusWithDetailsAndQueuedMessagesSnapshot(), "status_with_details_and_queued_messages", RustCsgTuiBottomPaneLayoutExprArea())

    if exitCode == 0:
        echo("rust_csg_tui_bottom_pane_layout_oracle_smoke ok")
    else:
        echo("rust_csg_tui_bottom_pane_layout_oracle_smoke FAILED")
    return exitCode
