import cheng/codex/protocol/wire
import cheng/codex/rollout/reader

fn checkContains(name: str, text: str, needle: str): bool =
    if !wire.RustCsgContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
        return false
    return true

fn checkNotContains(name: str, text: str, needle: str): bool =
    if wire.RustCsgContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
        return false
    return true

fn checkEq(name: str, left: str, right: str): bool =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
        return false
    return true

fn threadHistoryToolUpsertSmoke(): bool =
    var input: str
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"turn-1\",\"started_at\":\"2024-01-01T00:00:00Z\"}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"item_completed\",\"turn_id\":\"turn-1\",\"item\":{\"type\":\"plan\",\"id\":\"plan-1\",\"text\":\"draft plan\"}}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"hello\",\"text_elements\":[]}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_complete\",\"turn_id\":\"turn-1\",\"completed_at\":\"2024-01-01T00:01:00Z\",\"duration_ms\":60000}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"dynamic_tool_call_request\",\"call_id\":\"dyn-1\",\"turn_id\":\"turn-1\",\"namespace\":\"codex_app\",\"tool\":\"lookup_ticket\",\"arguments\":{\"id\":\"ABC-123\"}}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"dynamic_tool_call_response\",\"call_id\":\"dyn-1\",\"turn_id\":\"turn-1\",\"namespace\":\"codex_app\",\"tool\":\"lookup_ticket\",\"arguments\":{\"id\":\"ABC-123\"},\"success\":true,\"content_items\":[{\"type\":\"inputText\",\"text\":\"Ticket is open\"}],\"duration\":{\"seconds\":0,\"nanos\":42000000}}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"patch_apply_end\",\"call_id\":\"patch-1\",\"turn_id\":\"turn-1\",\"status\":\"completed\",\"changes\":[{\"path\":\"src/lib.rs\",\"kind\":{\"type\":\"update\",\"unified_diff\":\"@@ -1 +1 @@\"}}]}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"exec_command_end\",\"call_id\":\"exec-1\",\"turn_id\":\"turn-1\",\"status\":\"completed\",\"command\":[\"echo\",\"ok\"],\"cwd\":\"/repo\",\"duration\":{\"seconds\":0,\"nanos\":5000000},\"exit_code\":0,\"aggregated_output\":\"ok\",\"source\":\"codex\"}}\n")

    var outError: str
    let output = reader.RustCsgRolloutTurnsJsonFromText(input, outError)
    var ok = checkEq("tool_upsert_error", outError, "")
    ok = checkContains("tool_upsert_turn_id", output, "\"id\":\"turn-1\"") && ok
    ok = checkContains("tool_upsert_plan", output, "\"type\":\"plan\"") && ok
    ok = checkContains("tool_upsert_dynamic", output, "\"type\":\"dynamicToolCall\"") && ok
    ok = checkContains("tool_upsert_dynamic_status", output, "\"status\":\"completed\"") && ok
    ok = checkContains("tool_upsert_dynamic_content", output, "\"Ticket is open\"") && ok
    ok = checkContains("tool_upsert_dynamic_duration", output, "\"durationMs\":42") && ok
    ok = checkContains("tool_upsert_file_change", output, "\"type\":\"fileChange\"") && ok
    ok = checkContains("tool_upsert_command", output, "\"type\":\"commandExecution\"") && ok
    ok = checkContains("tool_upsert_exit_code", output, "\"exitCode\":0") && ok
    ok = checkNotContains("tool_upsert_replaced_in_progress", output, "\"status\":\"inProgress\"") && ok
    return ok

fn threadHistoryErrorInfoSmoke(): bool =
    var input: str
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"error-turn\",\"started_at\":\"2024-01-01T00:00:00Z\"}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"context window exceeded\",\"codex_error_info\":\"context_window_exceeded\"}}\n")

    var outError: str
    let output = reader.RustCsgRolloutTurnsJsonFromText(input, outError)
    var ok = checkEq("error_info_parse_error", outError, "")
    ok = checkContains("error_info_status", output, "\"status\":\"failed\"") && ok
    ok = checkContains("error_info_message", output, "\"message\":\"context window exceeded\"") && ok
    ok = checkContains("error_info_variant", output, "\"codexErrorInfo\":\"contextWindowExceeded\"") && ok
    ok = checkContains("error_info_details", output, "\"additionalDetails\":null") && ok
    return ok

fn threadHistoryHttpErrorInfoSmoke(): bool =
    var input: str
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"http-error\",\"started_at\":\"2024-01-01T00:00:00Z\"}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"stream disconnected\",\"codex_error_info\":{\"response_stream_disconnected\":{\"http_status_code\":502}}}}\n")

    var outError: str
    let output = reader.RustCsgRolloutTurnsJsonFromText(input, outError)
    var ok = checkEq("http_error_info_parse_error", outError, "")
    ok = checkContains("http_error_info_status", output, "\"status\":\"failed\"") && ok
    ok = checkContains("http_error_info_variant", output, "\"codexErrorInfo\":{\"responseStreamDisconnected\":{\"httpStatusCode\":502}}") && ok
    ok = checkContains("http_error_info_message", output, "\"message\":\"stream disconnected\"") && ok
    return ok

fn threadHistoryNullHttpErrorInfoSmoke(): bool =
    var input: str
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"null-http-error\",\"started_at\":\"2024-01-01T00:00:00Z\"}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"connection failed\",\"codex_error_info\":{\"http_connection_failed\":{\"http_status_code\":null}}}}\n")

    var outError: str
    let output = reader.RustCsgRolloutTurnsJsonFromText(input, outError)
    var ok = checkEq("null_http_error_info_parse_error", outError, "")
    ok = checkContains("null_http_error_info_status", output, "\"status\":\"failed\"") && ok
    ok = checkContains("null_http_error_info_variant", output, "\"codexErrorInfo\":{\"httpConnectionFailed\":{\"httpStatusCode\":null}}") && ok
    return ok

fn threadHistoryNonAffectingErrorInfoSmoke(): bool =
    var input: str
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"steer-error\",\"started_at\":\"2024-01-01T00:00:00Z\"}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"not steerable\",\"codex_error_info\":{\"active_turn_not_steerable\":{\"turn_kind\":\"review\"}}}}\n")
    input = wire.RustCsgCat(input, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"rollback failed\",\"codex_error_info\":\"thread_rollback_failed\"}}\n")

    var outError: str
    let output = reader.RustCsgRolloutTurnsJsonFromText(input, outError)
    var ok = checkEq("non_affecting_error_info_parse_error", outError, "")
    ok = checkContains("non_affecting_error_info_status", output, "\"status\":\"inProgress\"") && ok
    ok = checkContains("non_affecting_error_null", output, "\"error\":null") && ok
    ok = checkContains("non_affecting_completed_null", output, "\"completedAt\":null") && ok
    ok = checkContains("non_affecting_duration_null", output, "\"durationMs\":null") && ok
    ok = checkNotContains("non_affecting_error_info_not_failed", output, "\"status\":\"failed\"") && ok
    ok = checkNotContains("non_affecting_error_info_no_turn_error", output, "\"codexErrorInfo\"") && ok
    return ok

fn main(): int32 =
    if !threadHistoryToolUpsertSmoke():
        return 1
    if !threadHistoryErrorInfoSmoke():
        return 1
    if !threadHistoryHttpErrorInfoSmoke():
        return 1
    if !threadHistoryNullHttpErrorInfoSmoke():
        return 1
    if !threadHistoryNonAffectingErrorInfoSmoke():
        return 1
    echo("rust_csg_thread_read_sqlite_smoke ok")
    return 0
