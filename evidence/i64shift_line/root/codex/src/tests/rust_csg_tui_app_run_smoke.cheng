import cheng/codex/tui/app as app

fn main(): int32 =
    var tui = app.RustCsgTuiAppInit(80, 12)
    app.RustCsgTuiAppSetStatus(tui, "session app-run-smoke")
    app.RustCsgTuiAppAddMessage(tui, "history", "earlier prompt", false)
    app.RustCsgTuiAppRun(tui)
    echo("rust_csg_tui_app_run_smoke ok")
    return 0
