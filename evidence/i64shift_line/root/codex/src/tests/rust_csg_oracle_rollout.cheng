import cheng/codex/crates/rollout/rollout as r

fn main(): int32 =
    var pass: int32

    # rolloutEscapeJson
    var escaped = r.rolloutEscapeJson("hello")
    if escaped == "hello": pass = pass + 1
    var escaped2 = r.rolloutEscapeJson("a\"b")
    if escaped2.len > 3: pass = pass + 1

    # rolloutBuildJsonlLineKV
    var line = r.rolloutBuildJsonlLineKV("key1", "val1")
    if line.len > 5: pass = pass + 1

    # rolloutRecorder: init + append + flush
    var rec = r.rolloutRecorderInit()
    r.rolloutRecorderAppendKV(rec, "k1", "v1")
    if r.rolloutRecorderLineCount(rec) == 1: pass = pass + 1
    var flushed = r.rolloutRecorderFlush(rec)
    if flushed.len > 0: pass = pass + 1

    # rolloutRecorderInitWithFlushSize
    var rec2 = r.rolloutRecorderInitWithFlushSize(10)
    r.rolloutRecorderAppendKV(rec2, "a", "b")
    var flushed2 = r.rolloutRecorderRecord(rec2, "{\"x\":\"y\"}\n")
    if r.rolloutRecorderFlushedCount(rec2) > 0 || r.rolloutRecorderBufferSize(rec2) > 0: pass = pass + 1

    if pass == 6:
        echo("rust_csg_oracle_rollout ok")
        return 0
    echo("oracle FAIL")
    return 1

main()