# ═══════════════════════════════════════════════════════════════════════════════
# model-provider-info — relfacts equivalence smoke test
#
# Verifies that the model-provider-info module's defined functions, types, and
# fields match the oracle.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 11 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    # model_provider_info.cheng defines 11 functions and 0 types
    let source = "fn createOpenaiProvider(baseUrl: str, outName: var str, outRequiresOpenaiAuth: var bool, outSupportsWebsockets: var bool, outHasHttpHeaders: var bool, outHasEnvHttpHeaders: var bool)\nfn createAmazonBedrockProvider(awsProfile: str, awsRegion: str, outName: var str, outBaseUrl: var str, outRequiresOpenaiAuth: var bool, outSupportsWebsockets: var bool, outHasHttpHeaders: var bool, outHasEnvHttpHeaders: var bool, outAwsProfile: var str, outAwsRegion: var str)\nfn resolveOssBaseUrl(defaultPort: int, codexOssPort: str, codexOssBaseUrl: str): str\nfn createOssProvider(defaultPort: int, wireApi: int, outName: var str, outBaseUrl: var str, outRequiresOpenaiAuth: var bool)\nfn validateProvider(hasAws: bool, hasEnvKey: bool, hasBearer: bool, hasAuth: bool, authCmd: str, requiresOpenaiAuth: bool, supportsWebsockets: bool, outError: var str): bool\nfn mergeBedrockOnlyAwsOverride(builtInProfile: var str, builtInRegion: var str, overrideProfile: str, overrideRegion: str, configuredHasNonAwsFields: bool, outError: var str): bool\nfn effectiveRequestMaxRetries(configValue: int): int\nfn effectiveStreamMaxRetries(configValue: int): int\nfn effectiveStreamIdleTimeoutMs(configValue: int): int\nfn effectiveWebsocketConnectTimeoutMs(configValue: int): int\nfn modelProviderCompareConfigs(a: str, b: str): bool\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tmodel_provider_info\nDefFunction\tmodel_provider_info\tcreateOpenaiProvider\tbaseUrl: str, outName: var str, outRequiresOpenaiAuth: var bool, outSupportsWebsockets: var bool, outHasHttpHeaders: var bool, outHasEnvHttpHeaders: var bool\t->\t\nDefFunction\tmodel_provider_info\tcreateAmazonBedrockProvider\tawsProfile: str, awsRegion: str, outName: var str, outBaseUrl: var str, outRequiresOpenaiAuth: var bool, outSupportsWebsockets: var bool, outHasHttpHeaders: var bool, outHasEnvHttpHeaders: var bool, outAwsProfile: var str, outAwsRegion: var str\t->\t\nDefFunction\tmodel_provider_info\tresolveOssBaseUrl\tdefaultPort: int, codexOssPort: str, codexOssBaseUrl: str\t->\tstr\nDefFunction\tmodel_provider_info\tcreateOssProvider\tdefaultPort: int, wireApi: int, outName: var str, outBaseUrl: var str, outRequiresOpenaiAuth: var bool\t->\t\nDefFunction\tmodel_provider_info\tvalidateProvider\thasAws: bool, hasEnvKey: bool, hasBearer: bool, hasAuth: bool, authCmd: str, requiresOpenaiAuth: bool, supportsWebsockets: bool, outError: var str\t->\tbool\nDefFunction\tmodel_provider_info\tmergeBedrockOnlyAwsOverride\tbuiltInProfile: var str, builtInRegion: var str, overrideProfile: str, overrideRegion: str, configuredHasNonAwsFields: bool, outError: var str\t->\tbool\nDefFunction\tmodel_provider_info\teffectiveRequestMaxRetries\tconfigValue: int\t->\tint\nDefFunction\tmodel_provider_info\teffectiveStreamMaxRetries\tconfigValue: int\t->\tint\nDefFunction\tmodel_provider_info\teffectiveStreamIdleTimeoutMs\tconfigValue: int\t->\tint\nDefFunction\tmodel_provider_info\teffectiveWebsocketConnectTimeoutMs\tconfigValue: int\t->\tint\nDefFunction\tmodel_provider_info\tmodelProviderCompareConfigs\ta: str, b: str\t->\tbool\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(esf == 11, "source function count")
    assert(est == 0, "source type count")
    assert(esfd == 0, "source field count")

    assert(osf == 11, "oracle function count")
    assert(ost == 0, "oracle type count")
    assert(osfd == 0, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_model_provider_info_smoke ok")
    return 0
