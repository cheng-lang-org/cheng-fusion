import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/mcp_elicitation_oracle as oracle

fn RustCsgTuiMcpElicitationOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/mcp_server_elicitation.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "\"render_snapshot(&overlay, Rect::new(0, 0, 120, 16))\"":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_mcp_elicitation_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    exitCode = exitCode + RustCsgTuiMcpElicitationOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiMcpElicitationApprovalWithParamSummarySnapshot(), "mcp_server_elicitation_approval_form_with_param_summary")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMcpElicitationOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiMcpElicitationApprovalWithSessionPersistSnapshot(), "mcp_server_elicitation_approval_form_with_session_persist")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMcpElicitationOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiMcpElicitationApprovalNoSchemaSnapshot(), "mcp_server_elicitation_approval_form_without_schema")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMcpElicitationOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiMcpElicitationBooleanFormSnapshot(), "mcp_server_elicitation_boolean_form")

    if exitCode == 0:
        echo("rust_csg_tui_mcp_elicitation_oracle_smoke ok")
    else:
        echo("rust_csg_tui_mcp_elicitation_oracle_smoke FAILED")
    return exitCode
