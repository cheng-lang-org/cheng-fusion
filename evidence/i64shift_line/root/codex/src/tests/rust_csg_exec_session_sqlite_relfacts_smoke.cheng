import std/sqlite
import cheng/codex/app_server/thread_list
import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/config/home
import cheng/codex/config/user_config
import cheng/codex/exec/config
import cheng/codex/exec/operation
import cheng/codex/exec/plan
import cheng/codex/exec/prompt
import cheng/codex/exec/resume_lookup
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/exec/schema
import cheng/codex/exec/session
import cheng/codex/exec/session_sqlite
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db
import cheng/codex/state/state_db_sqlite
import cheng/codex/state/thread_store

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteRelativeCwdRow")
fn RustCsgAddSqliteRelativeCwdRow(path: str): str

@abi_internal
@importc("RustCsgCreateSessionIndexFixture")
fn RustCsgCreateSessionIndexFixture(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertEmpty(name: str, value: str) =
    checkEq(name, value, "")

fn main(): int32 =
    # ── Probes ──────────────────────────────────────────────────
    assert(sqlite.SqliteOk == 0, "sqlite_probe")
    var configErr: str
    checkEq("config_probe", config.RustCsgExecConfigValueJsonFromRaw("true", configErr), "true")
    var schemaErr: str
    assert(schema.RustCsgExecSchemaValidateJson("{}", schemaErr), schemaErr)
    checkEq("home_probe", home.RustCsgPathJoinChild("/codex", "config.toml"), "/codex/config.toml")
    checkEq("user_config_probe",
               wire.RustCsgJsonFindStr(user_config.RustCsgEmptyUserConfigJson(), "model"),
               "")
    var promptErr: str
    checkEq("prompt_probe", prompt.RustCsgPromptResolve("probe", promptErr), "probe")
    checkEq("thread_list_probe",
               thread_list.RustCsgThreadListAllSourceKindsJson(),
               "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]")
    checkEq("thread_list_sqlite_probe",
               thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson(),
               "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]")
    let stateDbProbe = state_db.RustCsgStateDbThreadListQueryPlanFromValues("/codex/sqlite",
                                                                           1,
                                                                           "created_at",
                                                                           "desc",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           false,
                                                                           "",
                                                                           "/repo")
    checkEq("state_db_probe", stateDbProbe.blockedReason, state_db.RustCsgStateDbQueryBlockedReason())
    assert(resume_lookup.RustCsgExecResumeLookupIsUuid("123e4567-e89b-12d3-a456-426614174000"), "resume_lookup_probe")
    checkEq("rollout_reader_probe", reader.RustCsgRolloutLatestTurnCwd(""), "")
    let sessionIndexProbe = thread_store.RustCsgSessionIndexParseLine("{\"id\":\"thread-probe\",\"thread_name\":\"probe\",\"updated_at\":\"2026-05-17T00:00:00Z\"}")
    checkEq("session_index_probe_id", sessionIndexProbe.id, "thread-probe")

    # ── Fixture ─────────────────────────────────────────────────
    let dbPath = RustCsgCreateSqliteFixture()
    assert(dbPath != "", "fixture_path")
    checkEq("relative_cwd_fixture", RustCsgAddSqliteRelativeCwdRow(dbPath), "")

    let userConfigJson = "{\"model\":\"\",\"modelProvider\":\"openai\",\"approvalPolicy\":\"\",\"approvalsReviewer\":\"\",\"sandboxMode\":\"\",\"ossProvider\":\"\",\"profile\":\"\"}"

    # ============================================================
    # Section 1: Non-SQLite dispatch (userTurn -> session path)
    # ============================================================
    var runPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                             "--model",
                                             "gpt-5.4",
                                             "--cd",
                                             "/repo",
                                             "Fix it"])
    let runRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(runPlan,
                                                                                          "thread-1",
                                                                                          "",
                                                                                          "")
    assertEmpty("run_parse", runRequest.parseError)
    assertEmpty("run_blocked", runRequest.blockedReason)
    checkEq("run_kind", runRequest.kind, "startUserTurn")
    assert(wire.RustCsgContains(runRequest.requestSequenceJson, "thread/start"), "run_seq_start")
    assert(wire.RustCsgContains(runRequest.requestSequenceJson, "turn/start"), "run_seq_turn")

    # ============================================================
    # Section 2: UUID dispatch (resume UUID -> session path)
    # ============================================================
    var uuidPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                               "resume",
                                               "123e4567-e89b-12d3-a456-426614174000",
                                               "--model",
                                               "gpt-5.2-codex",
                                               "continue"])
    let uuidRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(uuidPlan,
                                                                                            "unused",
                                                                                            "",
                                                                                            "")
    assertEmpty("uuid_parse", uuidRequest.parseError)
    assertEmpty("uuid_blocked", uuidRequest.blockedReason)
    checkEq("uuid_kind", uuidRequest.kind, "resumeUserTurn")
    assert(wire.RustCsgContains(uuidRequest.requestSequenceJson, "thread/resume"), "uuid_seq_resume")
    assert(wire.RustCsgContains(uuidRequest.requestSequenceJson, "turn/start"), "uuid_seq_turn")

    # ============================================================
    # Section 3: resume --last with SQLite
    # ============================================================
    var lastPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                               "--cd",
                                               "repo",
                                               "resume",
                                               "--last",
                                               "continue work"])
    let lastRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(lastPlan,
                                                                                            "unused",
                                                                                            userConfigJson,
                                                                                            dbPath)
    assertEmpty("last_parse", lastRequest.parseError)
    assertEmpty("last_blocked", lastRequest.blockedReason)
    checkEq("last_kind", lastRequest.kind, "resumeUserTurn")
    checkEq("last_thread", lastRequest.threadId, "thread-relative-cwd")
    assert(wire.RustCsgContains(lastRequest.requestSequenceJson, "thread/resume"), "last_seq_resume")
    assert(wire.RustCsgContains(lastRequest.requestSequenceJson, "turn/start"), "last_seq_turn")

    # ============================================================
    # Section 4: explicit name resume with SQLite
    # ============================================================
    var explicitPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                    "--cd",
                                                    "repo",
                                                    "resume",
                                                    "relative cwd thread",
                                                    "continue named"])
    let explicitRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(explicitPlan,
                                                                                                "unused",
                                                                                                userConfigJson,
                                                                                                dbPath)
    assertEmpty("explicit_parse", explicitRequest.parseError)
    assertEmpty("explicit_blocked", explicitRequest.blockedReason)
    checkEq("explicit_kind", explicitRequest.kind, "resumeUserTurn")
    checkEq("explicit_thread", explicitRequest.threadId, "thread-relative-cwd")

    # ============================================================
    # Section 5: config override propagation
    # ============================================================
    var overridePlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                    "--cd",
                                                    "repo",
                                                    "--model",
                                                    "gpt-5.5",
                                                    "resume",
                                                    "--last",
                                                    "continue"])
    let overrideRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(overridePlan,
                                                                                                "unused",
                                                                                                userConfigJson,
                                                                                                dbPath)
    assertEmpty("override_parse", overrideRequest.parseError)
    assertEmpty("override_blocked", overrideRequest.blockedReason)
    checkEq("override_model",
               wire.RustCsgJsonFindStr(overrideRequest.threadResumeJson, "model"),
               "gpt-5.5")
    checkEq("override_provider",
               wire.RustCsgJsonFindStr(overrideRequest.threadResumeJson, "modelProvider"),
               "openai")

    # ============================================================
    # Section 6: session index resume
    # ============================================================
    let sessionIndexHome = RustCsgCreateSessionIndexFixture(dbPath)
    assert(sessionIndexHome != "", "si_fixture")
    var siPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                              "--cd",
                                              "repo",
                                              "resume",
                                              "--all",
                                              "session-index-named",
                                              "continue"])
    let siRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(siPlan,
                                                                                          "unused",
                                                                                          userConfigJson,
                                                                                          dbPath)
    assertEmpty("si_parse", siRequest.parseError)
    assertEmpty("si_blocked", siRequest.blockedReason)
    checkEq("si_kind", siRequest.kind, "resumeUserTurn")
    checkEq("si_thread", siRequest.threadId, "thread-si-1")

    # ============================================================
    # Section 7: blocked reason checks
    # ============================================================
    var noDbPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                "--cd",
                                                "repo",
                                                "resume",
                                                "--last",
                                                "continue"])
    let noDbReq = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(noDbPlan,
                                                                                        "unused",
                                                                                        userConfigJson,
                                                                                        "")
    checkEq("no_db_blocked",
               noDbReq.blockedReason,
               "resume --last sqlite lookup requires state db path")

    var noCwdPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                 "resume",
                                                 "--last",
                                                 "continue"])
    let noCwdReq = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(noCwdPlan,
                                                                                         "unused",
                                                                                         userConfigJson,
                                                                                         dbPath)
    checkEq("no_cwd_blocked",
               noCwdReq.blockedReason,
               "resume sqlite lookup requires canonical absolute cwd")

    # ============================================================
    # Section 8: requestSequence JSON structure
    # ============================================================
    let sequenceJson = session.RustCsgExecRequestPlanToJson(lastRequest)
    checkEq("seq_kind", wire.RustCsgJsonFindStr(sequenceJson, "kind"), "resumeUserTurn")
    checkEq("seq_thread", wire.RustCsgJsonFindStr(sequenceJson, "threadId"), "thread-relative-cwd")
    checkEq("seq_parse", wire.RustCsgJsonFindStr(sequenceJson, "parseError"), "")
    checkEq("seq_blocked", wire.RustCsgJsonFindStr(sequenceJson, "blockedReason"), "")
    assert(wire.RustCsgContains(sequenceJson, "thread/resume"), "seq_has_resume")
    assert(wire.RustCsgContains(sequenceJson, "turn/start"), "seq_has_turn")

    echo("rust_csg_exec_session_sqlite_relfacts_smoke ok")
    return 0
