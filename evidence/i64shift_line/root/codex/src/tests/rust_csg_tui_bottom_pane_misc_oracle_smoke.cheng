import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/bottom_pane_misc_oracle as oracle

fn RustCsgTuiBottomPaneMiscExprSkillPopup(): str =
    return "\"render_popup(&popup, /*width*/ 72)\""

fn RustCsgTuiBottomPaneMiscExprRenderLines72(): str =
    return "\"render_lines(&view, 72)\""

fn RustCsgTuiBottomPaneMiscExprRenderLines84(): str =
    return "\"render_lines(&view, 84)\""

fn RustCsgTuiBottomPaneMiscExprBufferDebug(): str =
    return "\"format!(\\\"{buf:?}\\\")\""

fn RustCsgTuiBottomPaneMiscOracleCheck(path: str, fixture: str, name: str, source: str, expression: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != source:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expression:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 7:
        echo("FAIL usage: rust_csg_tui_bottom_pane_misc_oracle_smoke <6 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscSkillPopupScrolledSnapshot(), "skill_popup_scrolled", "tui/src/bottom_pane/skill_popup.rs", RustCsgTuiBottomPaneMiscExprSkillPopup())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscSkillsToggleBasicSnapshot(), "skills_toggle_basic", "tui/src/bottom_pane/skills_toggle_view.rs", RustCsgTuiBottomPaneMiscExprRenderLines72())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscStatusLineSetupRuntimePreviewSnapshot(), "status_line_setup_runtime_preview", "tui/src/bottom_pane/status_line_setup.rs", RustCsgTuiBottomPaneMiscExprRenderLines72())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscTerminalTitleSetupBasicSnapshot(), "terminal_title_setup_basic", "tui/src/bottom_pane/title_setup.rs", RustCsgTuiBottomPaneMiscExprRenderLines84())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscUnifiedExecFooterManySessionsSnapshot(), "unified_exec_footer_many_sessions", "tui/src/bottom_pane/unified_exec_footer.rs", RustCsgTuiBottomPaneMiscExprBufferDebug())
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiBottomPaneMiscOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiBottomPaneMiscUnifiedExecFooterMoreSessionsSnapshot(), "unified_exec_footer_more_sessions", "tui/src/bottom_pane/unified_exec_footer.rs", RustCsgTuiBottomPaneMiscExprBufferDebug())

    if exitCode == 0:
        echo("rust_csg_tui_bottom_pane_misc_oracle_smoke ok")
    else:
        echo("rust_csg_tui_bottom_pane_misc_oracle_smoke FAILED")
    return exitCode
