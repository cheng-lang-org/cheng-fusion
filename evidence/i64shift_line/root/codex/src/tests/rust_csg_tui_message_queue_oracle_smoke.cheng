import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/queue_oracle as queue

fn RustCsgTuiMessageQueueOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/message_queue.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "\"format!(\\\"{buf:?}\\\")\"":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_message_queue_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiMessageQueueOracleCheck(cmdline.argStr(argIdx), queue.RustCsgTuiMessageQueueManyLineSnapshot(), "message_queue_render_many_line_message")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMessageQueueOracleCheck(cmdline.argStr(argIdx), queue.RustCsgTuiMessageQueueOneSnapshot(), "message_queue_render_one_message")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMessageQueueOracleCheck(cmdline.argStr(argIdx), queue.RustCsgTuiMessageQueueTwoSnapshot(), "message_queue_render_two_messages")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiMessageQueueOracleCheck(cmdline.argStr(argIdx), queue.RustCsgTuiMessageQueueWrappedSnapshot(), "message_queue_render_wrapped_message")

    if exitCode == 0:
        echo("rust_csg_tui_message_queue_oracle_smoke ok")
    else:
        echo("rust_csg_tui_message_queue_oracle_smoke FAILED")
    return exitCode
