import cheng/codex/crates/utils_string/string as s

fn main(): int32 =
    var pass: int32

    if s.RustCsgUtilsStringSanitizeMetricTagValue("bad value!") == "bad_value": pass = pass + 1
    if s.RustCsgUtilsStringSanitizeMetricTagValue("///") == "unspecified": pass = pass + 1
    if s.RustCsgUtilsStringSanitizeMetricTagValue("hello.world") == "hello.world": pass = pass + 1
    if s.RustCsgUtilsStringSanitizeMetricTagValue("a-b/c") == "a-b/c": pass = pass + 1
    if s.RustCsgUtilsStringCommonPrefix("hello world", "hello there") == "hello ": pass = pass + 1
    if s.RustCsgUtilsStringCommonPrefix("abc", "xyz") == "": pass = pass + 1
    if s.RustCsgUtilsStringCommonPrefix("same", "same") == "same": pass = pass + 1
    if s.RustCsgUtilsStringCommonPrefix("", "hello") == "": pass = pass + 1

    if pass == 8:
        echo("rust_csg_oracle_utils_string ok")
        return 0
    echo("oracle FAIL")
    return 1

main()