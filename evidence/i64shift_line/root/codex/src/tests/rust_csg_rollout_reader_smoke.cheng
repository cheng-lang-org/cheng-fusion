fn testAgentStatusIsError(): bool =
    var ok: bool = true
    if !reader.RustCsgRolloutAgentStatusIsError("\"NotFound\""):
        echo("FAIL: agentStatus NotFound should be error"); ok = false
    if reader.RustCsgRolloutAgentStatusIsError("\"Completed\""):
        echo("FAIL: agentStatus Completed should not be error"); ok = false
    if !reader.RustCsgRolloutAgentStatusIsError("{\"Errored\":\"msg\"}"):
        echo("FAIL: agentStatus Errored should be error"); ok = false
    if ok:
        echo("testAgentStatusIsError ok")
    return ok

fn testExecStatusToV2(): bool =
    var ok: bool = true
    if reader.RustCsgRolloutExecStatusToV2("completed") != "completed":
        echo("FAIL: execStatus completed"); ok = false
    if reader.RustCsgRolloutExecStatusToV2("failed") != "failed":
        echo("FAIL: execStatus failed"); ok = false
    if reader.RustCsgRolloutExecStatusToV2("declined") != "cancelled":
        echo("FAIL: execStatus declined->cancelled"); ok = false
    if ok:
        echo("testExecStatusToV2 ok")
    return ok

fn testDurationSecsNanosToMsStr(): bool =
    var ok: bool = true
    var convOk: bool
    let dur1 = reader.RustCsgRolloutDurationSecsNanosToMsStr("{\"seconds\":1,\"nanos\":500000000}", convOk)
    if !convOk || dur1 != "1500":
        echo(strutil.Join(["FAIL: duration 1.5s expected=1500 got=", dur1], "")); ok = false
    var convOk2: bool
    let dur2 = reader.RustCsgRolloutDurationSecsNanosToMsStr("{\"seconds\":0,\"nanos\":0}", convOk2)
    if !convOk2 || dur2 != "0":
        echo(strutil.Join(["FAIL: duration 0 expected=0 got=", dur2], "")); ok = false
    if ok:
        echo("testDurationSecsNanosToMsStr ok")
    return ok

fn testCopyOptionalJsonField(): bool =
    var ok: bool = true
    let src = "{\"a\":1,\"b\":\"hello\",\"c\":null}"
    let out1 = reader.RustCsgRolloutCopyOptionalJsonField(src, "a", "")
    if !checkContains(out1, "\"a\":1", "copyField a"):
        ok = false
    let out2 = reader.RustCsgRolloutCopyOptionalJsonField(src, "b", "{\"x\":1}")
    if !checkContains(out2, "\"x\":1", "copyField append existing"):
        ok = false
    if !checkContains(out2, "\"b\":\"hello\"", "copyField append b"):
        ok = false
    let out3 = reader.RustCsgRolloutCopyOptionalJsonField(src, "c", "")
    if out3 != "":
        echo(strutil.Join(["FAIL: copyField null should not copy: got=", out3], "")); ok = false
    if ok:
        echo("testCopyOptionalJsonField ok")
    return ok

fn testCopyOptionalJsonFieldEdgeCases(): bool =
    var ok: bool = true
    let src = "{\"a\":1}"
    let out1 = reader.RustCsgRolloutCopyOptionalJsonField(src, "nonexistent", "")
    if out1 != "":
        echo(strutil.Join(["FAIL: copyField missing should return empty, got=", out1], "")); ok = false
    let out2 = reader.RustCsgRolloutCopyOptionalJsonField("{\"a\":1}", "a", "")
    if out2 == "":
        echo("FAIL: copyField from valid source should return value"); ok = false
    if ok:
        echo("testCopyOptionalJsonFieldEdgeCases ok")
    return ok

fn testEventLineDispatchAllTypes(): bool =
    var ok: bool = true
    var outErr: str
    var lines: str[]
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"t1\",\"started_at\":\"2024-01-01T00:00:00Z\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"hello\",\"text_elements\":[{\"byte_range\":{\"start\":0,\"end\":5},\"placeholder\":\"hello\"}]}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"agent_message\",\"message\":\"hi there\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"web_search_end\",\"call_id\":\"ws1\",\"query\":\"test\",\"action\":{\"type\":\"search\",\"query\":\"test\"}}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"image_generation_end\",\"call_id\":\"ig1\",\"status\":\"completed\",\"result\":\"url\",\"saved_path\":null}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"view_image_tool_call\",\"call_id\":\"vi1\",\"path\":\"/tmp/img.png\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"patch_apply_end\",\"call_id\":\"pa1\",\"status\":\"completed\",\"changes\":[{\"path\":\"f.txt\",\"kind\":{\"type\":\"update\",\"unified_diff\":\"@@ -1 +1 @@\"}}],\"turn_id\":\"t1\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"exec_command_end\",\"call_id\":\"ec1\",\"status\":\"completed\",\"command\":[\"echo\",\"hello\"],\"cwd\":\"/home\",\"duration\":{\"seconds\":0,\"nanos\":0},\"turn_id\":\"t1\",\"source\":\"codex\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"mcp_tool_call_begin\",\"call_id\":\"mcp1\",\"invocation\":{\"server\":\"codex\",\"tool\":\"read\",\"arguments\":{}}}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"mcp_tool_call_end\",\"call_id\":\"mcp1\",\"invocation\":{\"server\":\"codex\",\"tool\":\"read\",\"arguments\":{}},\"result\":{\"Ok\":{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}},\"duration\":{\"secs\":1,\"nanos\":0}}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_complete\",\"turn_id\":\"t1\",\"completed_at\":\"2024-01-01T00:01:00Z\",\"duration_ms\":\"60000\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"error\",\"message\":\"test error\"}}")
    var input: str = strutil.Join(lines, "\n")
    var output: str = reader.RustCsgRolloutTurnsJsonFromText(input, outErr)
    if outErr != "":
        echo(strutil.Join(["FAIL: TurnsJsonFromText should succeed, got error=", outErr], ""))
        ok = false
    elif !strContains(output, "\"id\":\"t1\""):
        echo(strutil.Join(["FAIL: output should contain id t1, output=", output], "")); ok = false
    elif !strContains(output, "\"type\":\"webSearch\""):
        echo("FAIL: output should contain webSearch item"); ok = false
    elif !strContains(output, "\"type\":\"commandExecution\""):
        echo("FAIL: output should contain commandExecution item"); ok = false
    else:
        echo("testEventLineDispatchAllTypes ok")
    outErr = ""
    var badInput: str = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"unknown_event_xyz\",\"data\":1}}"
    var out: str = reader.RustCsgRolloutTurnsJsonFromText(badInput, outErr)
    if outErr == "":
        echo("FAIL: unknown event type should produce error"); ok = false
    else:
        echo("testEventLineDispatchUnknownType ok")
    outErr = ""
    var badTextElementInput: str = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"hello\",\"text_elements\":[{\"type\":\"text\",\"text\":\"hello\"}]}}"
    out = reader.RustCsgRolloutTurnsJsonFromText(badTextElementInput, outErr)
    if outErr == "":
        echo("FAIL: invalid user_message text_elements should produce error"); ok = false
    else:
        echo("testEventLineDispatchInvalidTextElements ok")
    outErr = ""
    var ignoredInput: str = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"tokens\":100}}"
    out = reader.RustCsgRolloutTurnsJsonFromText(ignoredInput, outErr)
    if outErr != "":
        echo(strutil.Join(["FAIL: ignored event should not error, got=", outErr], "")); ok = false
    else:
        echo("testEventLineDispatchIgnoredType ok")
    return ok

fn testTokenUsageNotificationReplay(): bool =
    var ok: bool = true
    var outErr: str
    var lines: str[]
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"turn_started\",\"turn_id\":\"turn-token\",\"started_at\":\"2024-01-01T00:00:00Z\"}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"user_message\",\"message\":\"hello\",\"text_elements\":[],\"local_images\":[]}}")
    add(lines, "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"total_token_usage\":{\"input_tokens\":120,\"cached_input_tokens\":20,\"output_tokens\":30,\"reasoning_output_tokens\":10,\"total_tokens\":150},\"last_token_usage\":{\"input_tokens\":70,\"cached_input_tokens\":10,\"output_tokens\":20,\"reasoning_output_tokens\":5,\"total_tokens\":90},\"model_context_window\":200000},\"rate_limits\":null}}")
    let input = strutil.Join(lines, "\n")
    let notification = reader.RustCsgRolloutTokenUsageUpdatedNotificationFromText("thread-token", input, outErr)
    if outErr != "":
        echo(strutil.Join(["FAIL: token usage notification error=", outErr], "")); ok = false
    elif notification == "":
        echo("FAIL: token usage notification should be present"); ok = false
    elif !checkContains(notification, "\"method\":\"thread/tokenUsage/updated\"", "tu method"):
        ok = false
    elif !checkContains(notification, "\"threadId\":\"thread-token\"", "tu threadId"):
        ok = false
    elif !checkContains(notification, "\"turnId\":\"turn-token\"", "tu turnId"):
        ok = false
    elif !checkContains(notification, "\"totalTokens\":150", "tu total"):
        ok = false
    elif !checkContains(notification, "\"inputTokens\":120", "tu input"):
        ok = false
    elif !checkContains(notification, "\"cachedInputTokens\":20", "tu cached"):
        ok = false
    elif !checkContains(notification, "\"outputTokens\":30", "tu output"):
        ok = false
    elif !checkContains(notification, "\"reasoningOutputTokens\":10", "tu reasoning"):
        ok = false
    elif !checkContains(notification, "\"totalTokens\":90", "tu last"):
        ok = false
    elif !checkContains(notification, "\"modelContextWindow\":200000", "tu context window"):
        ok = false

    outErr = ""
    let nullInfoInput = "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":null,\"rate_limits\":null}}"
    let nullInfoNotification = reader.RustCsgRolloutTokenUsageUpdatedNotificationFromText("thread-token", nullInfoInput, outErr)
    if outErr != "":
        echo(strutil.Join(["FAIL: token_count info null should not error, got=", outErr], "")); ok = false
    elif nullInfoNotification != "":
        echo(strutil.Join(["FAIL: token_count info null should not notify, got=", nullInfoNotification], "")); ok = false
    if ok:
        echo("testTokenUsageNotificationReplay ok")
    return ok

fn testSessionMetaBaseInstructionsText(): bool =
    var ok: bool = true
    let raw = "{\"text\":\"rollout base instructions\"}"
    if !checkEqStr(reader.RustCsgRolloutSessionMetaBaseInstructionsText(raw), "rollout base instructions", "sessionMeta base instructions text"):
        ok = false
    let emptyRaw = "{\"text\":\"\"}"
    if !checkEqStr(reader.RustCsgRolloutSessionMetaBaseInstructionsText(emptyRaw), "", "sessionMeta empty base instructions text"):
        ok = false
    if ok:
        echo("testSessionMetaBaseInstructionsText ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testWebSearchActionToV2(): allOk = false
    if !testWebSearchItemJson(): allOk = false
    if !testImageViewItemJson(): allOk = false
    if !testImageGenerationItemJson(): allOk = false
    if !testPlanItemJson(): allOk = false
    if !testPatchChangeKindToV2(): allOk = false
    if !testCommandExecutionItemJson(): allOk = false
    if !testDynamicToolCallItemJson(): allOk = false
    if !testCollabAgentToolCallItemJson(): allOk = false
    if !testAgentStatusIsError(): allOk = false
    if !testExecStatusToV2(): allOk = false
    if !testDurationSecsNanosToMsStr(): allOk = false
    if !testCopyOptionalJsonField(): allOk = false
    if !testCopyOptionalJsonFieldEdgeCases(): allOk = false
    if !testEventLineDispatchAllTypes(): allOk = false
    if !testTokenUsageNotificationReplay(): allOk = false
    if !testSessionMetaBaseInstructionsText(): allOk = false
    echo("ALL TESTS COMPLETE")
    if allOk:
        echo("rust_csg_rollout_reader_smoke ok")
        return 0
    else:
        echo("rust_csg_rollout_reader_smoke FAILED")
        return 1
