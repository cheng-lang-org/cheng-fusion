import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader

fn strContains(haystack: str, needle: str): bool =
    for i in 0..<haystack.len:
        if wire.RustCsgMatchesAt(haystack, i, needle):
            return true
    return false

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    if label != "":
        echo(strutil.Join([label, " ok"], ""))
    return true

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strContains(haystack, needle):
        echo(strutil.Join([label, " FAIL: missing [", needle, "] in [", haystack, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testWebSearchActionToV2(): bool =
    var ok: bool = true
    var convOk: bool
    let searchRaw = "{\"type\":\"search\",\"query\":\"hello\"}"
    let searchV2 = reader.RustCsgRolloutWebSearchActionToV2(searchRaw, convOk)
    if !convOk:
        echo("FAIL: webSearchAction search should succeed"); ok = false
    elif !checkContains(searchV2, "\"type\":\"search\"", "wsAction search type"):
        ok = false
    elif !checkContains(searchV2, "\"query\":\"hello\"", "wsAction search query"):
        ok = false
    let openRaw = "{\"type\":\"open_page\",\"url\":\"https://example.com\"}"
    var convOk2: bool
    let openV2 = reader.RustCsgRolloutWebSearchActionToV2(openRaw, convOk2)
    if !convOk2:
        echo("FAIL: webSearchAction open_page should succeed"); ok = false
    elif !checkContains(openV2, "\"type\":\"openPage\"", "wsAction openPage type"):
        ok = false
    elif !checkContains(openV2, "\"url\":\"https://example.com\"", "wsAction openPage url"):
        ok = false
    let badRaw = "{\"type\":\"invalid\"}"
    var convOk3: bool
    let badV2 = reader.RustCsgRolloutWebSearchActionToV2(badRaw, convOk3)
    if convOk3:
        echo("FAIL: webSearchAction invalid should fail"); ok = false
    if ok:
        echo("testWebSearchActionToV2 ok")
    return ok

fn testWebSearchItemJson(): bool =
    var ok: bool = true
    let item = reader.RustCsgRolloutWebSearchItemJson("call1", "test query", "{\"type\":\"search\"}")
    if !checkContains(item, "\"type\":\"webSearch\"", "wsItem type"):
        ok = false
    if !checkContains(item, "\"id\":\"call1\"", "wsItem id"):
        ok = false
    if !checkContains(item, "\"query\":\"test query\"", "wsItem query"):
        ok = false
    if !checkContains(item, "\"action\":{\"type\":\"search\"}", "wsItem action"):
        ok = false
    if ok:
        echo("testWebSearchItemJson ok")
    return ok

