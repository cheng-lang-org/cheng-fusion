fn testImageGenerationItemJson(): bool =
    var ok: bool = true
    let item = reader.RustCsgRolloutImageGenerationItemJson("img1", "completed", "\"revised\"", "url://img", "\"/tmp/saved.png\"")
    if !checkContains(item, "\"type\":\"imageGeneration\"", "igItem type"):
        ok = false
    if !checkContains(item, "\"status\":\"completed\"", "igItem status"):
        ok = false
    if !checkContains(item, "\"revisedPrompt\":\"revised\"", "igItem revised"):
        ok = false
    if !checkContains(item, "\"result\":\"url://img\"", "igItem result"):
        ok = false
    if !checkContains(item, "\"savedPath\":\"/tmp/saved.png\"", "igItem savedPath"):
        ok = false
    let item2 = reader.RustCsgRolloutImageGenerationItemJson("img2", "failed", "null", "", "null")
    if !checkContains(item2, "\"status\":\"failed\"", "igItem2 status"):
        ok = false
    if wire.RustCsgContains(item2, "revisedPrompt"):
        echo(strutil.Join(["FAIL: igItem2 should not have revisedPrompt item2=", item2, ""], "")); ok = false
    if ok:
        echo("testImageGenerationItemJson ok")
    return ok

