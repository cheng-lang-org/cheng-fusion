fn testPatchChangeKindToV2(): bool =
    var ok: bool = true
    var convOk: bool
    let addV2 = reader.RustCsgRolloutPatchChangeKindToV2("{\"type\":\"add\"}", convOk)
    if !convOk:
        echo("FAIL: patchChangeKind add should succeed"); ok = false
    elif !checkContains(addV2, "\"type\":\"add\"", "patchKind add"):
        ok = false
    var convOk2: bool
    let delV2 = reader.RustCsgRolloutPatchChangeKindToV2("{\"type\":\"delete\"}", convOk2)
    if !convOk2 || !strContains(delV2, "\"type\":\"delete\""):
        echo("FAIL: patchChangeKind delete"); ok = false
    var convOk3: bool
    let updRaw = "{\"type\":\"update\",\"unified_diff\":\"@@ -1 +1 @@\"}"
    let updV2 = reader.RustCsgRolloutPatchChangeKindToV2(updRaw, convOk3)
    if !convOk3:
        echo("FAIL: patchChangeKind update should succeed"); ok = false
    elif !checkContains(updV2, "\"type\":\"update\"", "patchKind update type"):
        ok = false
    elif !checkContains(updV2, "\"diff\":\"@@ -1 +1 @@\"", "patchKind update diff"):
        ok = false
    if ok:
        echo("testPatchChangeKindToV2 ok")
    return ok

