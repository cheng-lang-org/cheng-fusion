import cheng/codex/crates/utils_absolute_path/utils_absolute_path as m

fn main(): int32 =
    var pass: int32

    if m.RustCsgUtilsAbsolutePathNormalize("") == ".": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize(".") == ".": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize("..") == ".": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize("/") == "/": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize("/foo/..") == "/": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize("a/b/../c") == "a/c": pass = pass + 1
    if m.RustCsgUtilsAbsolutePathNormalize("/a/./b") == "/a/b": pass = pass + 1

    if pass == 7:
        echo("rust_csg_oracle_utils_absolute_path ok")
        return 0
    echo("oracle FAIL")
    return 1

main()
