import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_approval_requests_oracle as oracle

fn RustCsgTuiChatwidgetApprovalModalCheck(path: str,
                                          expectedSource: str,
                                          expectedExpression: str,
                                          expectedBody: str,
                                          name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_chatwidget_approval_modal_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalModalCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetApprovalModalExecVt100(), "approval_modal_exec")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalModalCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetApprovalModalExecNoReason(), "approval_modal_exec_no_reason")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalModalCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "contents", oracle.RustCsgTuiChatwidgetApprovalModalExecMultilineNoExecPolicy(), "approval_modal_exec_multiline_prefix_no_execpolicy")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetApprovalModalCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetApprovalModalPatch(), "approval_modal_patch")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_approval_modal_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_approval_modal_oracle_smoke FAILED")
    return exitCode
