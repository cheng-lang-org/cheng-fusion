import std/strutils as strutil
import cheng/codex/crates/v8_poc/v8_poc

fn main(): int32 =
    assert(v8_poc.V8PocBazelTarget == "//codex-rs/v8-poc:v8-poc", "bazel target")
    assert(v8_poc.V8PocEmbeddedVersionFn == "embedded_v8_version", "version fn")
    assert(v8_poc.V8PocHasSandboxFn == "linked_v8_has_sandbox", "sandbox fn")

    # Production function: parseV8Version
    let v1 = v8_poc.V8PocParseV8Version("12.3.45")
    assert(v1 == "12.3.45", "parseV8Version basic")

    let v2 = v8_poc.V8PocParseV8Version("12.3.45.0")
    assert(v2 == "12.3.45", "parseV8Version extra part")

    let v3 = v8_poc.V8PocParseV8Version("12.3")
    assert(v3 == "12.3", "parseV8Version two parts")

    let v4 = v8_poc.V8PocParseV8Version("")
    assert(v4 == "", "parseV8Version empty")

    let v5 = v8_poc.V8PocParseV8Version("12")
    assert(v5 == "12", "parseV8Version single part")

    # Production function: parseHeapStats
    let h1 = v8_poc.V8PocParseHeapStats("heap_used=2048, heap_total=8192, other=123")
    assert(strutil.Contains(h1, "2048"), "parseHeapStats contains used")
    assert(strutil.Contains(h1, "8192"), "parseHeapStats contains total")

    let h2 = v8_poc.V8PocParseHeapStats("")
    assert(h2 == "", "parseHeapStats empty")

    let h3 = v8_poc.V8PocParseHeapStats("no stats here")
    assert(h3 == "", "parseHeapStats no stats")

    echo("rust_csg_v8_poc_smoke ok")
    return 0
