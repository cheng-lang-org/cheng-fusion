import std/cmdline
import std/strings
import std/system

@importc("cheng_http_sse_post_start")
fn chengHttpSsePostStartAbi(url: cstring, body: cstring, headers: cstring): int32

@ffi_owned_result(free = free)
@importc("cheng_http_sse_poll")
fn chengHttpSsePollAbi(handle: int32, timeoutMs: int32): owned_cstring

@importc("cheng_http_sse_close")
fn chengHttpSseClose(handle: int32): int32

@ffi_owned_result(free = free)
@importc("cheng_http_last_error")
fn chengHttpLastErrorAbi(): owned_cstring

fn chengHttpSsePostStart(url: str, body: str, headers: str): int32 =
    return chengHttpSsePostStartAbi(system.strToCStringTemp(url),
                                    system.strToCStringTemp(body),
                                    system.strToCStringTemp(headers))

fn chengHttpSsePoll(handle: int32, timeoutMs: int32): str =
    let out: str = chengHttpSsePollAbi(handle, timeoutMs)
    return out

fn chengHttpLastError(): str =
    let out: str = chengHttpLastErrorAbi()
    return out

fn fail(message: str): int32 =
    echo(strings.ConcatStr("FAIL ", message))
    return 1

fn main(): int32 =
    if cmdline.argCount() < 2:
        return fail("usage: rust_csg_http_sse_provider_smoke <url>")
    let url = cmdline.argStr(1)
    let handle = chengHttpSsePostStart(url, "{\"smoke\":true}", "[\"Content-Type: application/json\"]")
    if handle <= 0:
        return fail(strings.ConcatStr("sse start: ", chengHttpLastError()))
    var sawCreated: bool
    var sawCompleted: bool
    var sawStatus: bool
    var i: int32
    while i < 20 && !sawStatus:
        let frame = chengHttpSsePoll(handle, 1000)
        if frame == "D{\"type\":\"response.created\"}":
            sawCreated = true
        elif frame == "D{\"type\":\"response.completed\"}":
            sawCompleted = true
        elif frame == "S200":
            sawStatus = true
        elif frame.len > 0 && frame[0] == 'E':
            return fail(frame)
        i = i + 1
    chengHttpSseClose(handle)
    if !sawCreated:
        return fail("missing created frame")
    if !sawCompleted:
        return fail("missing completed frame")
    if !sawStatus:
        return fail("missing status frame")
    echo("rust_csg_http_sse_provider_smoke ok")
    return 0
