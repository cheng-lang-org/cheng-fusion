import cheng/codex/crates/app_server_protocol/app_server_protocol as m
fn main(): int32 =
    var pass: int32
    if m.RequestIdVariantNames() == "String,Integer": pass = pass + 1
    if m.JSONRPCMessageVariantNames() == "Request,Notification,Response,Error": pass = pass + 1
    if m.JSONRPCRequestFields().len > 0: pass = pass + 1
    if pass == 3: echo("rust_csg_oracle_app_server_protocol ok"); return 0
    echo("oracle FAIL"); return 1
main()
