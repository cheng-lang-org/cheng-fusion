@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

@abi_internal
@importc("RustCsgPathMetadataKind")
fn RustCsgPathMetadataKind(path: str): int32

@abi_internal
@importc("RustCsgRealPath")
fn RustCsgRealPath(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn pathIsAbsolute(path: str): bool =
    return path.len > 0 && path[0] == '/'

fn main(): int32 =
    let fixtureHome = RustCsgGetEnv("RUST_CSG_CODEX_HOME_FIXTURE")
    let fixtureCanonical = RustCsgGetEnv("RUST_CSG_CODEX_HOME_CANONICAL")
    let fixtureFile = RustCsgGetEnv("RUST_CSG_CODEX_FILE_FIXTURE")
    let fixtureMissing = RustCsgGetEnv("RUST_CSG_CODEX_MISSING_FIXTURE")
    assert(fixtureHome != "", "fixture_home")
    assert(fixtureCanonical != "", "fixture_canonical")
    assert(fixtureFile != "", "fixture_file")
    assert(fixtureMissing != "", "fixture_missing")
    assert(RustCsgPathMetadataKind(fixtureHome) == 1, "fixture_dir_kind")
    assert(RustCsgPathMetadataKind(fixtureFile) == 2, "fixture_file_kind")
    assert(RustCsgPathMetadataKind(fixtureMissing) == 0, "fixture_missing_kind")
    checkEq("fixture_realpath", RustCsgRealPath(fixtureHome), fixtureCanonical)
    assert(pathIsAbsolute(fixtureHome), "fixture_absolute")
    assert(!pathIsAbsolute("relative/path"), "relative_rejected")
    echo("rust_csg_utils_home_dir_provider_smoke ok")
    return 0
