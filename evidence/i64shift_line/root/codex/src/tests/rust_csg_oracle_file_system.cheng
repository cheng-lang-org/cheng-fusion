import cheng/codex/crates/file_system/file_system as m

fn main(): int32 =
    var pass: int32

    # FileType constants: File=0, Dir=1, Symlink=2
    if m.fileMetadataIsFile(0): pass = pass + 1
    if m.fileMetadataIsDir(1): pass = pass + 1
    if m.fileMetadataIsSymlink(2): pass = pass + 1
    if !m.fileMetadataIsFile(1): pass = pass + 1
    if !m.fileMetadataIsDir(0): pass = pass + 1

    if pass == 5:
        echo("rust_csg_oracle_file_system ok")
        return 0
    echo("oracle FAIL")
    return 1

main()