import cheng/codex/crates/utils_path_utils/utils_path_utils as m

fn main(): int32 =
    var pass: int32

    # commonAncestor
    if m.commonAncestor("/a/b/c", "/a/b/d") == "/a/b": pass = pass + 1
    if m.commonAncestor("/x/y", "/a/b") == "/": pass = pass + 1
    if m.commonAncestor("a/b", "a/c") == "a": pass = pass + 1
    if m.commonAncestor("/a/b", "/a/b") == "/a/b": pass = pass + 1

    # splitPathComponents
    var c1 = m.splitPathComponents("/a/b/c")
    if c1.len == 3: pass = pass + 1
    var c2 = m.splitPathComponents("a/b")
    if c2.len == 2: pass = pass + 1

    if pass == 6:
        echo("rust_csg_oracle_utils_path_utils ok")
        return 0
    echo("oracle FAIL")
    return 1

main()