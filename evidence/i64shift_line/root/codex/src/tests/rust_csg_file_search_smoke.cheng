# FileSearch smoke test — type constants, glob matching, real search/find/watcher
# Ported from codex-rs/file-search/src/lib.rs, file-watcher/src/lib.rs
#
# Tests:
#   1. Type constants (MatchType, Options defaults, Status flags)
#   2. SessionReporter stubs
#   3. Glob pattern matching (*, ?, [abc], [a-z], [!abc], **)
#   4. RankResults
#   5. GlobToRegex conversion
#   6. Real file content search via grep (requires process_provider)
#   7. Real file finding via find
#   8. File watcher: PollDirectory detects file creation

import cheng/codex/crates/file_search/file_search
import cheng/codex/src/file_search/search
import cheng/codex/src/file_search/glob
import cheng/codex/src/file_watcher/watcher
import std/strings
import std/strutils as strutil
import cheng/codex/std/process

# ═══════════════════════════════════════════════════════════════════════
# Assertion helpers
# ═══════════════════════════════════════════════════════════════════════

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected),
                           " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join([label, " FAIL: expected=", es, " got=", gs], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=\"", expected, "\" got=\"", got, "\""], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkNonEmpty(got: str, label: str): bool =
    if got.len == 0:
        echo(strutil.Join([label, " FAIL: expected non-empty"], ""))
        return false
    echo(strutil.Join([label, " ok (len=", strings.IntToStr(got.len), ")"], ""))
    return true

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strutil.Contains(haystack, needle):
        echo(strutil.Join([label, " FAIL: expected [", haystack, "] to contain [", needle, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkNotContains(haystack: str, needle: str, label: str): bool =
    if strutil.Contains(haystack, needle):
        echo(strutil.Join([label, " FAIL: expected [", haystack, "] NOT to contain [", needle, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn hasErrorPrefix(text: str): bool =
    if text.len < 6:
        return false
    return strings.SliceBytes(text, 0, 6) == "ERROR:"

