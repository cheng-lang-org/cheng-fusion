        echo("testStatusValuesMonotonic FAIL: running >= walk_complete")
        return false
    if file_search.RustCsgFileSearchStatusWalkComplete >= file_search.RustCsgFileSearchStatusComplete:
        echo("testStatusValuesMonotonic FAIL: walk_complete >= complete")
        return false
    echo("testStatusValuesMonotonic ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Glob matching tests (crate-level basic matcher)
# ═══════════════════════════════════════════════════════════════════════

fn testGlobExactMatch(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("foo.txt", "foo.txt"):
        echo("testGlobExactMatch FAIL: exact")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("foo.txt", "bar.txt"):
        echo("testGlobExactMatch FAIL: negative")
        return false
    echo("testGlobExactMatch ok")
    return true

fn testGlobStar(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("foo.txt", "*"):
        echo("testGlobStar FAIL: star")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("", "*"):
        echo("testGlobStar FAIL: star empty")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("foo.txt", "*.txt"):
        echo("testGlobStar FAIL: star.txt")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("foo.txt", "*.md"):
        echo("testGlobStar FAIL: star.md negative")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("bar.rs", "bar.*"):
        echo("testGlobStar FAIL: bar.*")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("a.b.c", "a*"):
        echo("testGlobStar FAIL: a*")
        return false
    echo("testGlobStar ok")
    return true

fn testGlobQuestion(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("cat", "c?t"):
        echo("testGlobQuestion FAIL: c?t")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("ct", "c?t"):
        echo("testGlobQuestion FAIL: c?t too short")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("cart", "c?t"):
        echo("testGlobQuestion FAIL: c?t too long")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("a", "?"):
        echo("testGlobQuestion FAIL: single ?")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("ab", "?"):
        echo("testGlobQuestion FAIL: single ? too long")
        return false
    echo("testGlobQuestion ok")
    return true

fn testGlobComposite(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("hello.rs", "h*ll?.rs"):
        echo("testGlobComposite FAIL: h*ll?.rs")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("hl.rs", "h*ll?.rs"):
        echo("testGlobComposite FAIL: h*ll?.rs too short")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("src/main.rs", "src/*.rs"):
        echo("testGlobComposite FAIL: src/*.rs dir")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("src/main.rs", "src/*.go"):
        echo("testGlobComposite FAIL: src/*.go negative")
        return false
    echo("testGlobComposite ok")
    return true

fn testGlobCharClass(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("cat", "[cb]at"):
        echo("testGlobCharClass FAIL: [cb]at")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("rat", "[cb]at"):
        echo("testGlobCharClass FAIL: [cb]at negative")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("bat", "[!c]at"):
        echo("testGlobCharClass FAIL: [!c]at")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("cat", "[!c]at"):
        echo("testGlobCharClass FAIL: [!c]at negative")
        return false
    echo("testGlobCharClass ok")
    return true

fn testGlobCharRange(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("cat", "[a-d]at"):
        echo("testGlobCharRange FAIL: [a-d]at")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("kat", "[a-d]at"):
        echo("testGlobCharRange FAIL: [a-d]at negative")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("3", "[0-9]"):
        echo("testGlobCharRange FAIL: [0-9] digit")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("a", "[0-9]"):
        echo("testGlobCharRange FAIL: [0-9] non-digit negative")
        return false
    echo("testGlobCharRange ok")
    return true

fn testGlobPathSepBlocked(): bool =
    if file_search.RustCsgFileSearchMatchGlobPattern("a/b", "*"):
        echo("testGlobPathSepBlocked FAIL: * crossing /")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("a/b", "?"):
        echo("testGlobPathSepBlocked FAIL: ? crossing /")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("a/b", "a/b"):
        echo("testGlobPathSepBlocked FAIL: a/b explicit")
        return false
    echo("testGlobPathSepBlocked ok")
    return true

fn testGlobEmptyPattern(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("", ""):
        echo("testGlobEmptyPattern FAIL: empty empty")
        return false
    if file_search.RustCsgFileSearchMatchGlobPattern("x", ""):
        echo("testGlobEmptyPattern FAIL: nonempty empty")
        return false
    echo("testGlobEmptyPattern ok")
    return true

fn testGlobStarMultiMatch(): bool =
    if !file_search.RustCsgFileSearchMatchGlobPattern("axbxc", "a*b*c"):
        echo("testGlobStarMultiMatch FAIL: a*b*c")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("abc", "a*b*c"):
        echo("testGlobStarMultiMatch FAIL: a*b*c empty star")
        return false
    if !file_search.RustCsgFileSearchMatchGlobPattern("ac", "a*c"):
        echo("testGlobStarMultiMatch FAIL: a*c empty star")
        return false
    echo("testGlobStarMultiMatch ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# RankResults tests
# ═══════════════════════════════════════════════════════════════════════

fn checkRankOrder(ranked: str, expectedFirst: str, label: str): bool =
    if !strutil.Contains(ranked, expectedFirst):
        echo(strutil.Join([label, " FAIL: expected [", expectedFirst, "] in [", ranked, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testRankResults(): bool =
    var ok: bool = true
    let ranked = file_search.RustCsgFileSearchRankResults("src/main.rs,README.md,src/lib.rs", "main.rs")
    if !checkRankOrder(ranked, "main.rs", "rankResults exact first"):
        ok = false
    if ok:
        echo("testRankResults ok")
    return ok

fn testRankResultsEmpty(): bool =
    var ok: bool = true
    let ranked = file_search.RustCsgFileSearchRankResults("", "query")
    if ranked != "":
        echo("FAIL: empty results should return empty")
        ok = false
    let ranked2 = file_search.RustCsgFileSearchRankResults("a.txt,b.txt", "")
    if ranked2 != "a.txt,b.txt":
        echo("FAIL: empty query should return unchanged")
        ok = false
    if ok:
        echo("testRankResultsEmpty ok")
    return ok

fn testRankResultsPrefix(): bool =
    var ok: bool = true
    let ranked = file_search.RustCsgFileSearchRankResults("other.txt,common.rs,prefix_common.rs", "common")
    if !checkRankOrder(ranked, "common.rs", "rankResults prefix before substring"):
        ok = false
    if ok:
        echo("testRankResultsPrefix ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════
# GlobToRegex tests (from src/file_search/glob.cheng)
# ═══════════════════════════════════════════════════════════════════════

fn testGlobToRegexSimple(): bool =
    var ok: bool = true
    # foo.txt → foo\.txt (dot is a regex special char, gets escaped)
    if !checkEqStr(glob.GlobToRegex("foo.txt"), "foo\\.txt", "globToRegex foo.txt"):
        ok = false
    # *.txt → [^/]*\.txt (star becomes [^/]*, dot escaped)
    if !checkEqStr(glob.GlobToRegex("*.txt"), "[^/]*\\.txt", "globToRegex *.txt"):
        ok = false
    # ? → [^/]
    if !checkEqStr(glob.GlobToRegex("?"), "[^/]", "globToRegex ?"):
        ok = false
    if ok:
        echo("testGlobToRegexSimple ok")
    return ok

fn testGlobToRegexDoubleStar(): bool =
    var ok: bool = true
    # **/*.cheng → .*[^/]*\.cheng (** becomes .* with / consumed, * becomes [^/]*, dot escaped)
    if !checkEqStr(glob.GlobToRegex("**/*.cheng"), ".*[^/]*\\.cheng", "globToRegex **/*.cheng"):
        ok = false
    # ** → .*
    if !checkEqStr(glob.GlobToRegex("**"), ".*", "globToRegex **"):
        ok = false
    if ok:
        echo("testGlobToRegexDoubleStar ok")
    return ok

fn testGlobToRegexSpecialChars(): bool =
    var ok: bool = true
    # file.test → file\.test (dot is regex special char)
    if !checkEqStr(glob.GlobToRegex("file.test"), "file\\.test", "globToRegex dot escape"):
        ok = false
    # file+test → file\+test (plus is regex special char)
    if !checkEqStr(glob.GlobToRegex("file+test"), "file\\+test", "globToRegex plus escape"):
        ok = false
    if ok:
        echo("testGlobToRegexSpecialChars ok")
    return ok

fn testGlobToRegexCharClass(): bool =
    var ok: bool = true
    # [abc] → [abc] (char class passed through)
    if !checkEqStr(glob.GlobToRegex("[abc]"), "[abc]", "globToRegex char class"):
        ok = false
    # [!abc] → [^abc] (! transliterated to ^)
    if !checkEqStr(glob.GlobToRegex("[!abc]"), "[^abc]", "globToRegex negated class"):
        ok = false
    # [0-9] → [0-9] (ranges pass through)
    if !checkEqStr(glob.GlobToRegex("[0-9]"), "[0-9]", "globToRegex range"):
        ok = false
    if ok:
        echo("testGlobToRegexCharClass ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════
# GlobMatch with ** support (from src/file_search/glob.cheng)
# ═══════════════════════════════════════════════════════════════════════

fn testGlobMatchDoubleStar(): bool =
    var ok: bool = true
    # **/ prefix: match at any depth
    if !glob.GlobMatch("a/b/c/file.cheng", "**/*.cheng"):
        echo("testGlobMatchDS FAIL: **/*.cheng with a/b/c/file.cheng")
        ok = false
    if !glob.GlobMatch("file.cheng", "**/*.cheng"):
        echo("testGlobMatchDS FAIL: **/*.cheng with file.cheng at root")
        ok = false
    if glob.GlobMatch("file.rs", "**/*.cheng"):
        echo("testGlobMatchDS FAIL: **/*.cheng negative .rs")
        ok = false
    # ** alone matches everything
    if !glob.GlobMatch("anything/at/all", "**"):
        echo("testGlobMatchDS FAIL: ** anything")
        ok = false
    if !glob.GlobMatch("", "**"):
        echo("testGlobMatchDS FAIL: ** empty path")
        ok = false
    if ok:
        echo("testGlobMatchDoubleStar ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════
# ParseGrepOutputLine tests
# ═══════════════════════════════════════════════════════════════════════

fn testParseGrepOutput(): bool =
    var ok: bool = true
    var outFile: str
    var outLine: int32
    var outContent: str

    if !search.ParseGrepOutputLine("foo.txt:42:hello world", outFile, outLine, outContent):
        echo("FAIL: parse grep output")
        ok = false
    else:
        if !checkEqStr(outFile, "foo.txt", "parse file"): ok = false
        if !checkEqI32(outLine, 42, "parse line"): ok = false
        if !checkEqStr(outContent, "hello world", "parse content"): ok = false

    if ok:
        echo("testParseGrepOutput ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════
# Real file content search via grep
# ═══════════════════════════════════════════════════════════════════════

fn testRealContentSearch(): bool =
    # Create a temp directory with test files using shell commands
    var testDir: str = "/tmp/cheng_test_search_content"
    var ok: bool = true

    # Clean up any previous test dir
    var rmArgs: str[]
    add(rmArgs, "-rf")
    add(rmArgs, testDir)
    var env: str[]
    process.ProcessSpawn("rm", rmArgs, "", env)

    # Create test directory
    var mkdirArgs: str[]
    add(mkdirArgs, "-p")
    add(mkdirArgs, testDir)
    var mkdirResult: process.ProcessResult = process.ProcessSpawn("mkdir", mkdirArgs, "", env)
    if !mkdirResult.ok:
        echo(strutil.Join(["testRealContentSearch FAIL: mkdir failed: ", mkdirResult.error], ""))
        return false

    # Create test files with known content (using sh -c for redirection)
    var shArgs1: str[]
    add(shArgs1, "-c")
    add(shArgs1, strutil.Join(["echo 'hello world this is a test file alpha' > ", testDir, "/alpha.txt"], ""))
    process.ProcessSpawn("sh", shArgs1, "", env)

    var shArgs2: str[]
    add(shArgs2, "-c")
    add(shArgs2, strutil.Join(["echo 'goodbye world beta file here' > ", testDir, "/beta.txt"], ""))
    process.ProcessSpawn("sh", shArgs2, "", env)

    var shArgs3: str[]
    add(shArgs3, "-c")
    add(shArgs3, strutil.Join(["echo 'hello alpha and beta together gamma' > ", testDir, "/gamma.txt"], ""))
    process.ProcessSpawn("sh", shArgs3, "", env)

    # Now search for "hello" in the test directory
    var q: search.SearchQuery = search.makeSearchQuery("hello", testDir, "", "", 100, false)
    var result: str = search.SearchFiles(q)

    # Debug output
    echo(strutil.Join(["  search output (", strings.IntToStr(result.len), " bytes): ", result], ""))

    # Verify matches found
    if result.len == 0:
        echo("testRealContentSearch FAIL: no matches found")
        ok = false
    elif hasErrorPrefix(result):
        echo(strutil.Join(["testRealContentSearch FAIL: error: ", result], ""))
        ok = false
    else:
        # Should find "hello" in alpha.txt and gamma.txt
        if !strutil.Contains(result, "alpha.txt"):
            echo("testRealContentSearch FAIL: expected alpha.txt in results")
            ok = false
        if !strutil.Contains(result, "gamma.txt"):
            echo("testRealContentSearch FAIL: expected gamma.txt in results")
            ok = false

    # Search for non-existent string
    var q2: search.SearchQuery = search.makeSearchQuery("XYZZYNONEXISTENT", testDir, "", "", 100, false)
    var result2: str = search.SearchFiles(q2)
    if result2.len == 0 || hasErrorPrefix(result2):
        # No matches is expected behavior (grep returns exit code 1 = no match)
        if hasErrorPrefix(result2):
            echo(strutil.Join(["testRealContentSearch non-existent returned error: ", result2], ""))
        else:
            echo("testRealContentSearch non-existent returned empty (expected)")
    else:
        echo(strutil.Join(["testRealContentSearch FAIL: non-existent search returned results: ", result2], ""))
        ok = false

    # Cleanup
    process.ProcessSpawn("rm", rmArgs, "", env)

    if ok:
        echo("testRealContentSearch ok")
    return ok


fn testRealFindFile(): bool =
    var testDir: str = "/tmp/cheng_test_search_find"
    var ok: bool = true

    # Clean up
    var rmArgs: str[]
    add(rmArgs, "-rf")
    add(rmArgs, testDir)
    var env: str[]

    # Create test directory
    var mkdirArgs: str[]
    add(mkdirArgs, "-p")
    add(mkdirArgs, strutil.Join([testDir, "/subdir"], ""))
    process.ProcessSpawn("mkdir", mkdirArgs, "", env)

    # Create test files (using sh -c for redirection)
    var shArgs1: str[]
    add(shArgs1, "-c")
    add(shArgs1, strutil.Join(["echo 'target_file' > ", testDir, "/target_file.txt"], ""))
    process.ProcessSpawn("sh", shArgs1, "", env)

    var shArgs2: str[]
    add(shArgs2, "-c")
    add(shArgs2, strutil.Join(["echo 'other content' > ", testDir, "/subdir/other.txt"], ""))
    process.ProcessSpawn("sh", shArgs2, "", env)

    var shArgs3: str[]
    add(shArgs3, "-c")
    add(shArgs3, strutil.Join(["echo 'target file in subdir' > ", testDir, "/subdir/target_file.txt"], ""))
    process.ProcessSpawn("sh", shArgs3, "", env)

    # Find target_file.txt
    var result: str = search.FindFile("target_file.txt", testDir)
    echo(strutil.Join(["  find output: ", result], ""))

    if result.len == 0:
        echo("testRealFindFile FAIL: no results")
        ok = false
    elif hasErrorPrefix(result):
        echo(strutil.Join(["testRealFindFile FAIL: error: ", result], ""))
        ok = false
    else:
        # Should find target_file.txt in root
        if !strutil.Contains(result, "target_file.txt"):
            echo("testRealFindFile FAIL: expected target_file.txt in results")
            ok = false

    # Cleanup
    process.ProcessSpawn("rm", rmArgs, "", env)

    if ok:
        echo("testRealFindFile ok")
    return ok


# ═══════════════════════════════════════════════════════════════════════
# File watcher: PollDirectory test
# ═══════════════════════════════════════════════════════════════════════

fn testPollDirectoryDetectCreate(): bool =
    var testDir: str = "/tmp/cheng_test_watcher_poll"
    var ok: bool = true
    var env: str[]

    # Clean up
    var rmArgs: str[]
    add(rmArgs, "-rf")
    add(rmArgs, testDir)
    process.ProcessSpawn("rm", rmArgs, "", env)

    # Create test directory with one file
    var mkdirArgs: str[]
    add(mkdirArgs, "-p")
    add(mkdirArgs, testDir)
    process.ProcessSpawn("mkdir", mkdirArgs, "", env)

    var shArgsExisting: str[]
    add(shArgsExisting, "-c")
    add(shArgsExisting, strutil.Join(["echo 'first file' > ", testDir, "/existing.txt"], ""))
    process.ProcessSpawn("sh", shArgsExisting, "", env)

    # First poll — establish baseline (empty = capture all current files)
    var firstPoll: str = watcher.PollDirectory(testDir, "")
    echo(strutil.Join(["  first poll output: ", firstPoll], ""))

    # Now create a new file
    var shArgsNew: str[]
    add(shArgsNew, "-c")
    add(shArgsNew, strutil.Join(["echo 'new file content' > ", testDir, "/newly_created.txt"], ""))
    process.ProcessSpawn("sh", shArgsNew, "", env)

    # Sleep briefly to ensure mtime differs
    var sleepArgs: str[]
    add(sleepArgs, "1")
    process.ProcessSpawn("sleep", sleepArgs, "", env)

    # Second poll — should detect the new file
    # Use first poll output as baseline
    var secondBaseline: str = firstPoll
    if secondBaseline.len == 0:
        # If first poll returned empty (no files with proper stat format),
        # do another poll to set baseline
        var setupPoll: str = watcher.BuildPollBaseline("0 /dev/null")
        secondBaseline = setupPoll

    var secondPoll: str = watcher.PollDirectory(testDir, secondBaseline)
    echo(strutil.Join(["  second poll output: ", secondPoll], ""))

    # Check if newly_created.txt was detected
    if !strutil.Contains(secondPoll, "newly_created.txt"):
        echo("testPollDirectoryDetectCreate FAIL: expected newly_created.txt in changes")
        echo(strutil.Join(["  secondPoll=", secondPoll], ""))
        ok = false

    # Also check for create event
    if !strutil.Contains(secondPoll, "create"):
        echo("testPollDirectoryDetectCreate WARN: no 'create' event in poll output")
        echo(strutil.Join(["  (may be 'modify' if file was created before stat)", " secondPoll=", secondPoll], ""))

    # Cleanup
    process.ProcessSpawn("rm", rmArgs, "", env)

    if ok:
        echo("testPollDirectoryDetectCreate ok")
    return ok


# ═══════════════════════════════════════════════════════════════════════
# CountSearchResults and GetNthSearchResult tests
# ═══════════════════════════════════════════════════════════════════════

fn testSearchHelpers(): bool =
    var ok: bool = true

    # CountSearchResults
    if !checkEqI32(search.CountSearchResults(""), 0, "count empty"):
        ok = false
    if !checkEqI32(search.CountSearchResults("a.txt:1:hello"), 1, "count one line"):
        ok = false
    if !checkEqI32(search.CountSearchResults("a.txt:1:hello\nb.txt:2:world"), 2, "count two lines"):
        ok = false

    # GetNthSearchResult
    if !checkEqStr(search.GetNthSearchResult("a.txt:1:hello\nb.txt:2:world", 0),
                   "a.txt:1:hello", "get first"):
        ok = false
    if !checkEqStr(search.GetNthSearchResult("a.txt:1:hello\nb.txt:2:world", 1),
                   "b.txt:2:world", "get second"):
        ok = false
    if !checkEqStr(search.GetNthSearchResult("a.txt:1:hello\nb.txt:2:world", 5),
                   "", "get out of range"):
        ok = false

    if ok:
        echo("testSearchHelpers ok")
    return ok


# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # Existing type constant tests
    if !testMatchTypeConstants(): allOk = false
    if !testDefaultOptionsConstants(): allOk = false
    if !testStatusConstants(): allOk = false
    if !testSessionReporterStubs(): allOk = false
    if !testMatchTypeValuesDistinct(): allOk = false
    if !testStatusValuesMonotonic(): allOk = false

    # Existing glob tests
    if !testGlobExactMatch(): allOk = false
    if !testGlobStar(): allOk = false
    if !testGlobQuestion(): allOk = false
    if !testGlobComposite(): allOk = false
    if !testGlobCharClass(): allOk = false
    if !testGlobCharRange(): allOk = false
    if !testGlobPathSepBlocked(): allOk = false
    if !testGlobEmptyPattern(): allOk = false
    if !testGlobStarMultiMatch(): allOk = false

    # Existing rank tests
    if !testRankResults(): allOk = false
    if !testRankResultsEmpty(): allOk = false
    if !testRankResultsPrefix(): allOk = false

    # New GlobToRegex tests
    if !testGlobToRegexSimple(): allOk = false
    if !testGlobToRegexDoubleStar(): allOk = false
    if !testGlobToRegexSpecialChars(): allOk = false
    if !testGlobToRegexCharClass(): allOk = false

    # New ** glob match tests
    if !testGlobMatchDoubleStar(): allOk = false

    # ParseGrepOutput tests
    if !testParseGrepOutput(): allOk = false

    # Count/GetNth tests
    if !testSearchHelpers(): allOk = false

    # Real process execution tests (require process_provider)
    echo("--- real content search ---")
    if !testRealContentSearch(): allOk = false
    echo("--- real find file ---")
    if !testRealFindFile(): allOk = false
    echo("--- poll directory ---")
    if !testPollDirectoryDetectCreate(): allOk = false

    if allOk:
        echo("rust_csg_file_search_smoke ok")
        return 0
    else:
        echo("rust_csg_file_search_smoke FAILED")
        return 1
