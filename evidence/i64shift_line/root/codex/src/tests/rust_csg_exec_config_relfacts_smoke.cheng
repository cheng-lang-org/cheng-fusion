import std/strings as strings
import std/strutils as strutil

# ── wire helpers (self-contained, no wire module import) ──

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn JsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = Cat(out, "\\\"")
        elif ch == '\\':
            out = Cat(out, "\\\\")
        elif ch == '\n':
            out = Cat(out, "\\n")
        elif ch == '\r':
            out = Cat(out, "\\r")
        elif ch == '\t':
            out = Cat(out, "\\t")
        else:
            out = Cat(out, SliceBytes(value, i, 1))
    return Cat(out, "\"")

# ── config functions (mirroring exec/config.cheng) ──

fn IsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn Trim(raw: str): str =
    if raw.len == 0:
        return ""
    var start: int32
    while start < raw.len && IsSpace(raw[start]):
        start = start + 1
    if start >= raw.len:
        return ""
    var stop: int32
    stop = raw.len
    while stop > start && IsSpace(raw[stop - 1]):
        stop = stop - 1
    return SliceBytes(raw, start, stop - start)

fn FindEquals(raw: str): int32 =
    for i in 0..<raw.len:
        if raw[i] == '=':
            return i
    return -1

fn CanonicalKey(key: str): str =
    if key == "use_legacy_landlock":
        return "features.use_legacy_landlock"
    return key

fn OverrideKey(raw: str, outError: var str): str =
    outError = ""
    let eq = FindEquals(raw)
    if eq <= 0:
        outError = Cat("invalid config override: ", raw)
        return ""
    let key = Trim(SliceBytes(raw, 0, eq))
    if key == "":
        outError = Cat("empty config override key: ", raw)
        return ""
    return CanonicalKey(key)

fn OverrideRawValue(raw: str, outError: var str): str =
    outError = ""
    let eq = FindEquals(raw)
    if eq <= 0:
        outError = Cat("invalid config override: ", raw)
        return ""
    return Trim(SliceBytes(raw, eq + 1, raw.len - eq - 1))

fn IsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn IsNumber(raw: str): bool =
    if raw.len == 0:
        return false
    var start: int32
    if raw[0] == '-':
        if raw.len == 1:
            return false
        start = 1
    var sawDigit: bool
    var sawDot: bool
    for i in start..<raw.len:
        let ch = raw[i]
        if IsDigit(ch):
            sawDigit = true
        elif ch == '.':
            if sawDot:
                return false
            sawDot = true
        else:
            return false
    return sawDigit

fn IsSafeBareChar(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '-' || ch == '_' || ch == '.' || ch == '/' || ch == ':' || ch == '@'

fn IsSafeBareString(raw: str): bool =
    if raw.len == 0:
        return false
    for i in 0..<raw.len:
        if !IsSafeBareChar(raw[i]):
            return false
    return true

fn QuotedValue(raw: str, quote: char, outError: var str): str =
    outError = ""
    if raw.len < 2 || raw[raw.len - 1] != quote:
        outError = Cat("unterminated config override string: ", raw)
        return ""
    let inner = SliceBytes(raw, 1, raw.len - 2)
    for i in 0..<inner.len:
        let ch = inner[i]
        if ch == '\\' || ch == '"' || ch == '\n' || ch == '\r' || ch == '\t':
            outError = "config override string escaping not ported"
            return ""
    return JsonQuote(inner)

fn ValueJsonFromRaw(rawValue: str, outError: var str): str =
    outError = ""
    let value = Trim(rawValue)
    if value == "":
        outError = "empty config override value"
        return ""
    if value == "true" || value == "false" || value == "null":
        return value
    if IsNumber(value):
        return value
    if value[0] == '"':
        return QuotedValue(value, '"', outError)
    if value[0] == '\'':
        return QuotedValue(value, '\'', outError)
    if value[0] == '[' || value[0] == '{':
        outError = "complex TOML config override values not ported"
        return ""
    if IsSafeBareString(value):
        return JsonQuote(value)
    outError = Cat("unsupported config override value: ", value)
    return ""

fn OverrideValueJson(raw: str, outError: var str): str =
    outError = ""
    let value = OverrideRawValue(raw, outError)
    if outError != "":
        return ""
    return ValueJsonFromRaw(value, outError)

# ── test helpers ──

fn checkEq(name: str, expected: int32, actual: int32): bool =
    if expected != actual:
        echo("FAIL int32 ")
        echo(name)
        echo(": expected=")
        echo(strings.IntToStr(expected))
        echo(" actual=")
        echo(strings.IntToStr(actual))
        echo("\n")
        return false
    return true

fn checkStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL str ")
        echo(name)
        echo(": expected=\"")
        echo(expected)
        echo("\" actual=\"")
        echo(actual)
        echo("\"\n")
        return false
    return true

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL bool ")
        echo(name)
        echo("\n")
        return false
    return true

fn checkFalse(name: str, cond: bool): bool =
    if cond:
        echo("FAIL not ")
        echo(name)
        echo("\n")
        return false
    return true

# ── Trim tests ──

fn testTrim(): bool =
    var ok: bool = true
    if !checkStr("Trim_basic", "hello", Trim("  hello  ")):
        ok = false
    if !checkStr("Trim_tab", "hello", Trim("\thello\n")):
        ok = false
    if !checkStr("Trim_empty", "", Trim("")):
        ok = false
    if !checkStr("Trim_ws_only", "", Trim("  \t  ")):
        ok = false
    if !checkStr("Trim_nochange", "hello", Trim("hello")):
        ok = false
    if ok:
        echo("testTrim ok")
    return ok

# ── FindEquals tests ──

fn testFindEquals(): bool =
    var ok: bool = true
    if !checkEq("FindEq_basic", 3, FindEquals("key=value")):
        ok = false
    if !checkEq("FindEq_begin", 0, FindEquals("=value")):
        ok = false
    if !checkEq("FindEq_none", -1, FindEquals("noequals")):
        ok = false
    if !checkEq("FindEq_multi", 1, FindEquals("a=b=c")):
        ok = false
    if !checkEq("FindEq_empty", -1, FindEquals("")):
        ok = false
    if ok:
        echo("testFindEquals ok")
    return ok

# ── CanonicalKey tests ──

fn testCanonicalKey(): bool =
    var ok: bool = true
    if !checkStr("Canon_landlock", "features.use_legacy_landlock", CanonicalKey("use_legacy_landlock")):
        ok = false
    if !checkStr("Canon_passthru", "model", CanonicalKey("model")):
        ok = false
    if !checkStr("Canon_sandbox", "sandbox", CanonicalKey("sandbox")):
        ok = false
    if ok:
        echo("testCanonicalKey ok")
    return ok

# ── OverrideKey tests ──

fn testOverrideKey(): bool =
    var ok: bool = true
    var err: str
    if !checkStr("OvKey_basic", "model", OverrideKey("model=gpt-4", err)):
        ok = false
    if !checkStr("OvKey_passthru", "key", OverrideKey("key=value", err)):
        ok = false
    if !checkStr("OvKey_canon", "features.use_legacy_landlock", OverrideKey("use_legacy_landlock=true", err)):
        ok = false
    err = ""
    let r1 = OverrideKey("=value", err)
    if !checkStr("OvKey_no_key", "", r1):
        ok = false
    if !checkTrue("OvKey_no_key_err", err != ""):
        ok = false
    err = ""
    let r2 = OverrideKey("invalid", err)
    if !checkStr("OvKey_no_eq", "", r2):
        ok = false
    if !checkTrue("OvKey_no_eq_err", err != ""):
        ok = false
    if ok:
        echo("testOverrideKey ok")
    return ok

# ── OverrideRawValue tests ──

fn testOverrideRawValue(): bool =
    var ok: bool = true
    var err: str
    if !checkStr("OvRaw_basic", "value", OverrideRawValue("key=value", err)):
        ok = false
    if !checkStr("OvRaw_trimmed", "value", OverrideRawValue("key= value ", err)):
        ok = false
    if !checkStr("OvRaw_empty_val", "", OverrideRawValue("key=", err)):
        ok = false
    if !checkStr("OvRaw_trim_ws", "hello", OverrideRawValue("key=  hello  ", err)):
        ok = false
    err = ""
    let r1 = OverrideRawValue("invalid", err)
    if !checkStr("OvRaw_no_eq", "", r1):
        ok = false
    if !checkTrue("OvRaw_no_eq_err", err != ""):
        ok = false
    if ok:
        echo("testOverrideRawValue ok")
    return ok

# ── IsNumber tests ──

fn testIsNumber(): bool =
    var ok: bool = true
    if !checkTrue("IsNum_42", IsNumber("42")):
        ok = false
    if !checkTrue("IsNum_3.14", IsNumber("3.14")):
        ok = false
    if !checkTrue("IsNum_neg7", IsNumber("-7")):
        ok = false
    if !checkTrue("IsNum_zero", IsNumber("0")):
        ok = false
    if !checkFalse("IsNum_abc", IsNumber("abc")):
        ok = false
    if !checkFalse("IsNum_empty", IsNumber("")):
        ok = false
    if !checkFalse("IsNum_dash", IsNumber("-")):
        ok = false
    if !checkFalse("IsNum_dotdot", IsNumber("1.2.3")):
        ok = false
    if ok:
        echo("testIsNumber ok")
    return ok

# ── IsSafeBareString tests ──

fn testIsSafeBareString(): bool =
    var ok: bool = true
    if !checkTrue("SafeBare_hello", IsSafeBareString("hello")):
        ok = false
    if !checkTrue("SafeBare_hyphen", IsSafeBareString("hello-world")):
        ok = false
    if !checkTrue("SafeBare_path", IsSafeBareString("hello/world:test@v1")):
        ok = false
    if !checkFalse("SafeBare_space", IsSafeBareString("hello world")):
        ok = false
    if !checkFalse("SafeBare_tab", IsSafeBareString("hello\tworld")):
        ok = false
    if !checkFalse("SafeBare_empty", IsSafeBareString("")):
        ok = false
    if ok:
        echo("testIsSafeBareString ok")
    return ok

# ── ValueJsonFromRaw tests ──

fn testValueJsonFromRaw(): bool =
    var ok: bool = true
    var err: str
    if !checkStr("ValJson_true", "true", ValueJsonFromRaw("true", err)):
        ok = false
    if !checkStr("ValJson_false", "false", ValueJsonFromRaw("false", err)):
        ok = false
    if !checkStr("ValJson_null", "null", ValueJsonFromRaw("null", err)):
        ok = false
    if !checkStr("ValJson_int42", "42", ValueJsonFromRaw("42", err)):
        ok = false
    if !checkStr("ValJson_neg7", "-7", ValueJsonFromRaw("-7", err)):
        ok = false
    if !checkStr("ValJson_float", "3.14", ValueJsonFromRaw("3.14", err)):
        ok = false
    if !checkStr("ValJson_bare", "\"hello\"", ValueJsonFromRaw("hello", err)):
        ok = false
    if !checkStr("ValJson_bare_v1", "\"safe-bare/v1\"", ValueJsonFromRaw("safe-bare/v1", err)):
        ok = false
    if !checkStr("ValJson_dq", "\"double-quoted\"", ValueJsonFromRaw("\"double-quoted\"", err)):
        ok = false
    if !checkStr("ValJson_sq", "\"single-quoted\"", ValueJsonFromRaw("'single-quoted'", err)):
        ok = false
    err = ""
    let r1 = ValueJsonFromRaw("", err)
    if !checkStr("ValJson_empty", "", r1):
        ok = false
    if !checkTrue("ValJson_empty_err", err != ""):
        ok = false
    err = ""
    let r2 = ValueJsonFromRaw("  ", err)
    if !checkStr("ValJson_ws", "", r2):
        ok = false
    if !checkTrue("ValJson_ws_err", err != ""):
        ok = false
    if ok:
        echo("testValueJsonFromRaw ok")
    return ok

# ── OverrideValueJson tests ──

fn testOverrideValueJson(): bool =
    var ok: bool = true
    var err: str
    if !checkStr("OvValJson_model", "\"gpt-4\"", OverrideValueJson("model=gpt-4", err)):
        ok = false
    if !checkStr("OvValJson_spaces", "\"gpt-4\"", OverrideValueJson("model= gpt-4 ", err)):
        ok = false
    if !checkStr("OvValJson_int", "42", OverrideValueJson("key=42", err)):
        ok = false
    if !checkStr("OvValJson_bool", "true", OverrideValueJson("ephemeral=true", err)):
        ok = false
    err = ""
    let r1 = OverrideValueJson("invalid", err)
    if !checkStr("OvValJson_invalid", "", r1):
        ok = false
    if !checkTrue("OvValJson_invalid_err", err != ""):
        ok = false
    if ok:
        echo("testOverrideValueJson ok")
    return ok

# ── main ──

fn main(): int32 =
    var allOk: bool = true
    if !testTrim():
        allOk = false
    if !testFindEquals():
        allOk = false
    if !testCanonicalKey():
        allOk = false
    if !testOverrideKey():
        allOk = false
    if !testOverrideRawValue():
        allOk = false
    if !testIsNumber():
        allOk = false
    if !testIsSafeBareString():
        allOk = false
    if !testValueJsonFromRaw():
        allOk = false
    if !testOverrideValueJson():
        allOk = false
    if allOk:
        echo("rust_csg_exec_config_relfacts_smoke ok")
        return 0
    echo("rust_csg_exec_config_relfacts_smoke FAILED")
    return 1
