import std/cmdline as cmdline
import std/strings
import cheng/codex/exec/run as exec_run

fn RustCsgExecRunSmokePlanJson(): str =
    return "{\"kind\":\"startUserTurn\",\"threadId\":\"\",\"requestSequence\":[{\"method\":\"thread/start\",\"params\":{\"model\":\"gpt-5\",\"cwd\":\"/tmp\",\"approvalPolicy\":\"never\",\"approvalsReviewer\":\"user\",\"ephemeral\":false,\"sessionStartSource\":\"cli\"}},{\"method\":\"turn/start\",\"params\":{\"threadId\":\"\",\"input\":[{\"type\":\"text\",\"text\":\"hello world\",\"textElements\":[]}],\"cwd\":\"/tmp\",\"approvalPolicy\":\"never\"}}],\"parseError\":\"\",\"blockedReason\":\"\"}"

fn main(): int32 =
    assert(cmdline.argCount() >= 2, "exec_run smoke requires mock app-server base URL")
    let baseUrl: str = cmdline.argStr(1)
    assert(baseUrl != "", "exec_run mock app-server URL must not be empty")

    let okUrl: str = strings.ConcatStr(baseUrl, "/turn")
    let okStatus: int32 = exec_run.ExecRunStart(okUrl, RustCsgExecRunSmokePlanJson())
    assert(okStatus == 0, "exec_run happy path should exit 0")
    echo("exec_run_happy_path_ok")

    let errUrl: str = strings.ConcatStr(baseUrl, "/turn-error")
    let errStatus: int32 = exec_run.ExecRunStart(errUrl, RustCsgExecRunSmokePlanJson())
    assert(errStatus == 1, "exec_run error event should exit 1")
    echo("exec_run_error_path_ok")

    echo("rust_csg_exec_run_smoke ok")
    return 0
