import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/feedback_oracle as oracle

fn RustCsgTuiFeedbackOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/feedback_view.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "rendered":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 8:
        echo("FAIL usage: rust_csg_tui_feedback_oracle_smoke <7 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackBadResultSnapshot(), "feedback_view_bad_result")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackBugSnapshot(), "feedback_view_bug")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackGoodResultSnapshot(), "feedback_view_good_result")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackOtherSnapshot(), "feedback_view_other")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackLegacyUploadPromptSnapshot(), "feedback_view_render")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackSafetyCheckSnapshot(), "feedback_view_safety_check")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiFeedbackOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiFeedbackWithConnectivityDiagnosticsSnapshot(), "feedback_view_with_connectivity_diagnostics")

    if exitCode == 0:
        echo("rust_csg_tui_feedback_oracle_smoke ok")
    else:
        echo("rust_csg_tui_feedback_oracle_smoke FAILED")
    return exitCode
