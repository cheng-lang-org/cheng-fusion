import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/hooks_browser_oracle as oracle

fn RustCsgTuiHooksExpr112(): str =
    return "\"render_lines(&view, 112)\""

fn RustCsgTuiHooksExpr44(): str =
    return "\"render_lines(&view, 44)\""

fn RustCsgTuiHooksOracleCheck(path: str, fixture: str, name: str, expression: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/hooks_browser_view.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expression:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 1:
        echo("FAIL usage: rust_csg_tui_hooks_browser_oracle_smoke")
        return 1
    echo("rust_csg_tui_hooks_browser_oracle_smoke ok")
    return 0
