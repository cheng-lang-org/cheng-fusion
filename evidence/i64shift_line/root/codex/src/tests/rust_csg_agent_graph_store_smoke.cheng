# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testValidateValidNodeIdOpen(): allOk = false
    if !testValidateValidNodeIdClosed(): allOk = false
    if !testValidateValidNodeIdRoot(): allOk = false
    if !testValidateValidNodeIdAgent(): allOk = false
    if !testValidateEmptyNodeId(): allOk = false
    if !testValidateInvalidCharInNodeId(): allOk = false
    if !testValidateSpaceInNodeId(): allOk = false
    if !testValidateEmptyNodeType(): allOk = false
    if !testValidateUnknownNodeType(): allOk = false
    if !testValidateNodeIdOnlyDigits(): allOk = false
    if !testValidateNodeIdOnlyUnderscore(): allOk = false
    if !testValidateAllKnownNodeTypes(): allOk = false
    if !testValidateDotInNodeId(): allOk = false
    if !testValidateSlashInNodeId(): allOk = false
    if !testValidateLongNodeId(): allOk = false
    if !testValidateEdgeValid(): allOk = false
    if !testValidateEdgeAllTypes(): allOk = false
    if !testValidateEdgeSelfLoop(): allOk = false
    if !testValidateEdgeInvalidFromNode(): allOk = false
    if !testValidateEdgeInvalidToNode(): allOk = false
    if !testValidateEdgeEmptyType(): allOk = false
    if !testValidateEdgeUnknownType(): allOk = false
    if !testValidateEdgeInvalidChars(): allOk = false
    if allOk:
        echo("rust_csg_agent_graph_store_smoke ok")
        return 0
    else:
        echo("rust_csg_agent_graph_store_smoke FAILED")
        return 1
