import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: agent-graph-store — node ID & type validation
# ═══════════════════════════════════════════════════════════════════════════════

# Known agent-graph node types (const str[] is broken at runtime, use function).
fn RustCsgAgentGraphStoreKnownNodeTypes(): str[] =
    return ["open", "closed", "root", "agent"]

fn RustCsgAgentGraphStoreValidateAgentGraphNode(nodeId: str, nodeType: str, outError: var str): bool =
    outError = ""
    # nodeId must be non-empty and alphanumeric (plus underscore and hyphen)
    if nodeId.len == 0:
        outError = "nodeId must be non-empty"
        return false
    var i: int32 = 0
    while i < nodeId.len:
        let b = Int32(nodeId[i])
        var valid: bool = false
        if b >= 48 && b <= 57: valid = true    # 0-9
        if b >= 65 && b <= 90: valid = true    # A-Z
        if b >= 97 && b <= 122: valid = true   # a-z
        if nodeId[i] == '_' || nodeId[i] == '-': valid = true
        if !valid:
            outError = strutil.Join(["nodeId contains invalid character '", strings.SliceBytes(nodeId, i, 1), "'"], "")
            return false
        i = i + 1
    # nodeType must be one of the known types
    if nodeType.len == 0:
        outError = "nodeType must be non-empty"
        return false
    var found: bool = false
    let knownTypes = RustCsgAgentGraphStoreKnownNodeTypes()
    var j: int32 = 0
    while j < knownTypes.len:
        if knownTypes[j] == nodeType:
            found = true
            break
        j = j + 1
    if !found:
        outError = strutil.Join(["unknown nodeType: ", nodeType, ""], "")
        return false
    return true

fn RustCsgAgentGraphStoreKnownEdgeTypes(): str[] =
    return ["contains", "depends_on", "references", "child_of", "runs_on"]

fn RustCsgAgentGraphStoreValidateEdge(fromNode: str, toNode: str, edgeType: str, outError: var str): bool =
    outError = ""
    var fromErr: str
    if !RustCsgAgentGraphStoreValidateAgentGraphNode(fromNode, "open", fromErr):
        outError = strutil.Join(["invalid fromNode: ", fromErr], "")
        return false
    var toErr: str
    if !RustCsgAgentGraphStoreValidateAgentGraphNode(toNode, "open", toErr):
        outError = strutil.Join(["invalid toNode: ", toErr], "")
        return false
    if fromNode == toNode:
        outError = "self-loop edge is not allowed"
        return false
    if edgeType.len == 0:
        outError = "edgeType must be non-empty"
        return false
    var found: bool = false
    let knownEdges = RustCsgAgentGraphStoreKnownEdgeTypes()
    var k: int32 = 0
    while k < knownEdges.len:
        if knownEdges[k] == edgeType:
            found = true
            break
        k = k + 1
    if !found:
        outError = strutil.Join(["unknown edgeType: ", edgeType], "")
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkBool(got: bool, expected: bool, name: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

fn checkEq(got: str, expected: str, name: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", expected], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", got], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testValidateValidNodeIdOpen(): bool =
    var ok: bool = true
    var err: str
    let valid = RustCsgAgentGraphStoreValidateAgentGraphNode("thread_abc-123", "open", err)
    if !checkBool(valid, true, "valid_open"): ok = false
    if !checkEq(err, "", "valid_open_err"): ok = false
    if ok:
        echo("testValidateValidNodeIdOpen ok")
    return ok

fn testValidateValidNodeIdClosed(): bool =
    var ok: bool = true
