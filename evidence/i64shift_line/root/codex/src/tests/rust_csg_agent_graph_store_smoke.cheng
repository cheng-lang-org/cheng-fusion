fn testValidateAllKnownNodeTypes(): bool =
    var ok: bool = true
    var err: str
    let knownTypes = RustCsgAgentGraphStoreKnownNodeTypes()
    var t: int32 = 0
    while t < knownTypes.len:
        let nt = knownTypes[t]
        let valid = RustCsgAgentGraphStoreValidateAgentGraphNode("test", nt, err)
        if !checkBool(valid, true, strutil.Join(["known_type_", nt, ""], "")):
            ok = false
        t = t + 1
    if ok:
        echo("testValidateAllKnownNodeTypes ok")
    return ok

