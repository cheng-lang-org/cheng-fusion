fn testValidateEdgeAllTypes(): bool =
    var ok: bool = true
    var err: str
    let knownEdges = RustCsgAgentGraphStoreKnownEdgeTypes()
    var t: int32 = 0
    while t < knownEdges.len:
        let et = knownEdges[t]
        let valid = RustCsgAgentGraphStoreValidateEdge("from_node", "to_node", et, err)
        if !checkBool(valid, true, strutil.Join(["edge_type_", et, ""], "")):
            ok = false
        t = t + 1
    if ok:
        echo("testValidateEdgeAllTypes ok")
    return ok

