import cheng/codex/crates/app_server_client/app_server_client as asc

# ═══════════════════════════════════════════════════════════════════════════════
# App Server Client — type definition constants smoke test
#
# Ported from codex-rs/app-server-client
# ═══════════════════════════════════════════════════════════════════════════════

fn testAppServerEventVariants(): bool =
    if asc.RustCsgAppServerEventVariantCount != 3: return false
    if asc.RustCsgAppServerEventVariant1 != "ServerNotification": return false
    if asc.RustCsgAppServerEventVariant2 != "ServerRequest": return false
    if asc.RustCsgAppServerEventVariant3 != "Disconnected": return false
    echo("testAppServerEventVariants ok")
    return true

fn testAppServerClientVariants(): bool =
    if asc.RustCsgAppServerClientVariantCount != 2: return false
    if asc.RustCsgAppServerClientVariant1 != "InProcess": return false
    if asc.RustCsgAppServerClientVariant2 != "Remote": return false
    echo("testAppServerClientVariants ok")
    return true

fn testAppServerRequestHandleVariants(): bool =
    if asc.RustCsgAppServerRequestHandleVariantCount != 2: return false
    if asc.RustCsgAppServerRequestHandleVariant1 != "InProcess": return false
    if asc.RustCsgAppServerRequestHandleVariant2 != "Remote": return false
    echo("testAppServerRequestHandleVariants ok")
    return true

fn testTypedRequestErrorVariants(): bool =
    if asc.RustCsgTypedRequestErrorVariantCount != 3: return false
    if asc.RustCsgTypedRequestErrorVariant1 != "Transport": return false
    if asc.RustCsgTypedRequestErrorVariant2 != "Server": return false
    if asc.RustCsgTypedRequestErrorVariant3 != "Deserialize": return false
    echo("testTypedRequestErrorVariants ok")
    return true

fn testTransportErrorFields(): bool =
    if asc.RustCsgTransportErrorFieldCount != 2: return false
    if asc.RustCsgTransportErrorField1 != "method": return false
    if asc.RustCsgTransportErrorField2 != "source": return false
    echo("testTransportErrorFields ok")
    return true

fn testInProcessClientStartArgsFieldCount(): bool =
    if asc.RustCsgInProcessClientStartArgsFieldCount != 18: return false
    if asc.RustCsgInProcessClientStartArgsField1 != "arg0_paths": return false
    if asc.RustCsgInProcessClientStartArgsField18 != "channel_capacity": return false
    echo("testInProcessClientStartArgsFieldCount ok")
    return true

fn testClientCommandVariants(): bool =
    if asc.RustCsgClientCommandVariantCount != 5: return false
    if asc.RustCsgClientCommandVariant1 != "Request": return false
    if asc.RustCsgClientCommandVariant5 != "Shutdown": return false
    echo("testClientCommandVariants ok")
    return true

fn testForwardEventResultVariants(): bool =
    if asc.RustCsgForwardEventResultVariantCount != 2: return false
    if asc.RustCsgForwardEventResultVariant1 != "Continue": return false
    if asc.RustCsgForwardEventResultVariant2 != "DisableStream": return false
    echo("testForwardEventResultVariants ok")
    return true

fn testShutdownTimeoutConstant(): bool =
    if asc.RustCsgShutdownTimeoutSec != 5: return false
    echo("testShutdownTimeoutConstant ok")
    return true

fn testValidateInProcessStartArgs(): bool =
    if !asc.RustCsgIsInProcessStartArgsValid("client", "1.0", true, true, true): return false
    if asc.RustCsgIsInProcessStartArgsValid("", "1.0", true, true, true): return false
    if asc.RustCsgIsInProcessStartArgsValid("client", "", true, true, true): return false
    if asc.RustCsgIsInProcessStartArgsValid("client", "1.0", false, true, true): return false
    if asc.RustCsgIsInProcessStartArgsValid("client", "1.0", true, false, true): return false
    if asc.RustCsgIsInProcessStartArgsValid("client", "1.0", true, true, false): return false
    echo("testValidateInProcessStartArgs ok")
    return true

fn testRenderTypedRequestErrorVariant(): bool =
    if asc.RustCsgRenderTypedRequestErrorVariant("Transport") != "transport_error": return false
    if asc.RustCsgRenderTypedRequestErrorVariant("Server") != "server_error": return false
    if asc.RustCsgRenderTypedRequestErrorVariant("Deserialize") != "deserialize_error": return false
    if asc.RustCsgRenderTypedRequestErrorVariant("Unknown") != "unknown_error": return false
    echo("testRenderTypedRequestErrorVariant ok")
    return true

fn testClientCommandName(): bool =
    if asc.RustCsgClientCommandName("Request") != "client_request": return false
    if asc.RustCsgClientCommandName("Shutdown") != "shutdown": return false
    if asc.RustCsgClientCommandName("Unknown") != "unknown": return false
    echo("testClientCommandName ok")
    return true

fn testForwardEventClassification(): bool =
    if !asc.RustCsgIsForwardContinue("Continue"): return false
    if asc.RustCsgIsForwardContinue("DisableStream"): return false
    if !asc.RustCsgIsForwardDisableStream("DisableStream"): return false
    echo("testForwardEventClassification ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testAppServerEventVariants(): allOk = false
    if !testAppServerClientVariants(): allOk = false
    if !testAppServerRequestHandleVariants(): allOk = false
    if !testTypedRequestErrorVariants(): allOk = false
    if !testTransportErrorFields(): allOk = false
    if !testInProcessClientStartArgsFieldCount(): allOk = false
    if !testClientCommandVariants(): allOk = false
    if !testForwardEventResultVariants(): allOk = false
    if !testShutdownTimeoutConstant(): allOk = false
    if !testValidateInProcessStartArgs(): allOk = false
    if !testRenderTypedRequestErrorVariant(): allOk = false
    if !testClientCommandName(): allOk = false
    if !testForwardEventClassification(): allOk = false

    if allOk:
        echo("rust_csg_app_server_client_smoke ok")
        return 0
    else:
        echo("rust_csg_app_server_client_smoke FAILED")
        return 1
