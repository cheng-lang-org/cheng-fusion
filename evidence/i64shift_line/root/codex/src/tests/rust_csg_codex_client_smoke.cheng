import cheng/codex/crates/codex_client/codex_client as cc

# ═══════════════════════════════════════════════════════════════════════════════
# Codex Client — type definition constants smoke test
#
# Ported from codex-rs/codex-client
# ═══════════════════════════════════════════════════════════════════════════════

fn testHttpTransportMethodCount(): bool =
    if cc.RustCsgHttpTransportMethodCount != 2: return false
    if cc.RustCsgHttpTransportMethod1 != "execute": return false
    if cc.RustCsgHttpTransportMethod2 != "stream": return false
    echo("testHttpTransportMethodCount ok")
    return true

fn testReqwestTransportFieldCount(): bool =
    if cc.RustCsgReqwestTransportFieldCount != 1: return false
    if cc.RustCsgReqwestTransportField1 != "client": return false
    echo("testReqwestTransportFieldCount ok")
    return true

fn testRetryPolicyFieldCount(): bool =
    if cc.RustCsgRetryPolicyFieldCount != 3: return false
    if cc.RustCsgRetryPolicyField1 != "max_attempts": return false
    if cc.RustCsgRetryPolicyField3 != "retry_on": return false
    echo("testRetryPolicyFieldCount ok")
    return true

fn testTransportErrorVariants(): bool =
    if cc.RustCsgTransportErrorVariantCount != 5: return false
    if cc.RustCsgTransportErrorVariant1 != "Http": return false
    if cc.RustCsgTransportErrorVariant4 != "Network": return false
    if cc.RustCsgTransportErrorVariant5 != "Build": return false
    echo("testTransportErrorVariants ok")
    return true

fn testStreamErrorVariants(): bool =
    if cc.RustCsgStreamErrorVariantCount != 2: return false
    if cc.RustCsgStreamErrorVariant1 != "Stream": return false
    if cc.RustCsgStreamErrorVariant2 != "Timeout": return false
    echo("testStreamErrorVariants ok")
    return true

fn testRequestFieldCount(): bool =
    if cc.RustCsgRequestFieldCount != 6: return false
    if cc.RustCsgRequestField1 != "method": return false
    if cc.RustCsgRequestField6 != "timeout": return false
    echo("testRequestFieldCount ok")
    return true

fn testRequestBodyVariants(): bool =
    if cc.RustCsgRequestBodyVariantCount != 2: return false
    if cc.RustCsgRequestBodyVariant1 != "Json": return false
    if cc.RustCsgRequestBodyVariant2 != "Raw": return false
    echo("testRequestBodyVariants ok")
    return true

fn testRequestCompressionVariants(): bool =
    if cc.RustCsgRequestCompressionVariantCount != 2: return false
    if cc.RustCsgRequestCompressionVariant1 != "None": return false
    if cc.RustCsgRequestCompressionVariant2 != "Zstd": return false
    echo("testRequestCompressionVariants ok")
    return true

fn testCodexHttpClientFieldCount(): bool =
    if cc.RustCsgCodexHttpClientFieldCount != 1: return false
    if cc.RustCsgCodexHttpClientField1 != "inner": return false
    echo("testCodexHttpClientFieldCount ok")
    return true

fn testCodexRequestBuilderMethodCount(): bool =
    if cc.RustCsgCodexRequestBuilderMethodCount != 6: return false
    if cc.RustCsgCodexRequestBuilderMethod1 != "headers": return false
    if cc.RustCsgCodexRequestBuilderMethod6 != "send": return false
    echo("testCodexRequestBuilderMethodCount ok")
    return true

fn testVariantNamesFns(): bool =
    if cc.TransportErrorVariantNames() != "Http,RetryLimit,Timeout,Network,Build": return false
    if cc.RequestBodyVariantNames() != "Json,Raw": return false
    if cc.RequestCompressionVariantNames() != "None,Zstd": return false
    if cc.HttpTransportMethodNames() != "execute,stream": return false
    echo("testVariantNamesFns ok")
    return true

fn testBuildRequestId(): bool =
    var rid: str = cc.buildRequestId()
    if rid.len == 0: return false
    # Must start with "req_"
    if rid[0] != 'r': return false
    if rid[1] != 'e': return false
    if rid[2] != 'q': return false
    if rid[3] != '_': return false
    echo("testBuildRequestId ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testHttpTransportMethodCount(): allOk = false
    if !testReqwestTransportFieldCount(): allOk = false
    if !testRetryPolicyFieldCount(): allOk = false
    if !testTransportErrorVariants(): allOk = false
    if !testStreamErrorVariants(): allOk = false
    if !testRequestFieldCount(): allOk = false
    if !testRequestBodyVariants(): allOk = false
    if !testRequestCompressionVariants(): allOk = false
    if !testCodexHttpClientFieldCount(): allOk = false
    if !testCodexRequestBuilderMethodCount(): allOk = false
    if !testVariantNamesFns(): allOk = false
    if !testBuildRequestId(): allOk = false
    if allOk:
        echo("rust_csg_codex_client_smoke ok")
        return 0
    echo("rust_csg_codex_client_smoke FAILED")
    return 1
