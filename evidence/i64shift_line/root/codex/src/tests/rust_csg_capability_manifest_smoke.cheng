fn testTotalMembers(): bool =
    let count = inventory.RustCsgExpectedCargoMembers
    if count != ExpectedCargoMembers:
        return false
    echo("testTotalMembers ok")
    return true

fn testPortedCount(): bool =
    var p: int32
    var b: int32
    countMembers(p, b)
    if p != ExpectedPortedCount:
        return false
    echo("testPortedCount ok")
    return true

fn testBlockedCount(): bool =
    var p: int32
    var b: int32
    countMembers(p, b)
    if b != ExpectedBlockedCount:
        return false
    echo("testBlockedCount ok")
    return true

fn testKnownPorted(): bool =
    var u = module_map.RustCsgCargoMemberUnit("utils/elapsed")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("utils/string")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("utils/json-to-toml")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("utils/oss")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("utils/plugins")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("collaboration-mode-templates")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("utils/http")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("device-key")
    if u.status != "ported":
        return false
    echo("testKnownPorted ok")
    return true

fn testKnownBlocked(): bool =
    var u = module_map.RustCsgCargoMemberUnit("__missing__")
    if u.status != module_map.RustCsgExplicitlyBlocked:
        return false
    u = module_map.RustCsgCargoMemberUnit("aws-auth")
    if u.status != "ported":
        return false
    u = module_map.RustCsgCargoMemberUnit("app-server")
    if u.status != "ported":
        return false
    echo("testKnownBlocked ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testTotalMembers(): allOk = false
    if !testPortedCount(): allOk = false
    if !testBlockedCount(): allOk = false
    if !testKnownPorted(): allOk = false
    if !testKnownBlocked(): allOk = false
    if allOk:
        echo("rust_csg_capability_manifest_smoke ok")
        return 0
    else:
        echo("rust_csg_capability_manifest_smoke FAILED")
        return 1
