import std/strings

# ═══════════════════════════════════════════════════════════════════════════════
# exec/schema equivalence verification (self-contained)
#
# Mirrors JSON validation logic from exec/schema.cheng.
# Tests: whitespace helpers, char classification, JSON parse primitives
# (string, number, literal, array, object, value), and full ValidateJson.
# All tests use embedded JSON strings (no file IO).
# ═══════════════════════════════════════════════════════════════════════════════

# ── wire helper equivalents ───────────────────────────────────────────────────

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn MatchesAt(raw: str, pos: int32, literal: str): bool =
    if pos + literal.len > raw.len:
        return false
    for i in 0..<literal.len:
        if raw[pos + i] != literal[i]:
            return false
    return true

# ── Whitespace helpers ────────────────────────────────────────────────────────

fn IsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn SkipSpace(raw: str, pos: int32): int32 =
    var i: int32 = pos
    while i < raw.len && IsSpace(raw[i]):
        i = i + 1
    return i

fn Trim(raw: str): str =
    var start: int32 = SkipSpace(raw, 0)
    if start >= raw.len:
        return ""
    var stop: int32 = raw.len
    while stop > start && IsSpace(raw[stop - 1]):
        stop = stop - 1
    return SliceBytes(raw, start, stop - start)

# ── Char classification ───────────────────────────────────────────────────────

fn IsDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn IsNonZeroDigit(ch: char): bool =
    return ch >= '1' && ch <= '9'

fn IsHexDigit(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    return ch >= 'A' && ch <= 'F'

# ── JSON string parser ────────────────────────────────────────────────────────

fn ParseString(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '"':
        outError = "json string expected"
        return false
    pos = pos + 1
    while pos < raw.len:
        let ch = raw[pos]
        if ch == '"':
            pos = pos + 1
            return true
        if ch == '\\':
            pos = pos + 1
            if pos >= raw.len:
                outError = "unterminated json string escape"
                return false
            let esc = raw[pos]
            if esc == '"' || esc == '\\' || esc == '/' || esc == 'b':
                pos = pos + 1
                continue
            if esc == 'f' || esc == 'n' || esc == 'r' || esc == 't':
                pos = pos + 1
                continue
            if esc == 'u':
                pos = pos + 1
                for i in 0..<4:
                    if pos >= raw.len || !IsHexDigit(raw[pos]):
                        outError = "invalid json unicode escape"
                        return false
                    pos = pos + 1
                continue
            outError = "invalid json string escape"
            return false
        if ch == '\n' || ch == '\r' || ch == '\t':
            outError = "control character in json string"
            return false
        pos = pos + 1
    outError = "unterminated json string"
    return false

# ── JSON number parser ────────────────────────────────────────────────────────

fn ParseNumber(raw: str, pos: var int32, outError: var str): bool =
    if pos < raw.len && raw[pos] == '-':
        pos = pos + 1
    if pos >= raw.len:
        outError = "json number missing digits"
        return false
    if raw[pos] == '0':
        pos = pos + 1
    elif IsNonZeroDigit(raw[pos]):
        while pos < raw.len && IsDigit(raw[pos]):
            pos = pos + 1
    else:
        outError = "json number missing digits"
        return false
    if pos < raw.len && raw[pos] == '.':
        pos = pos + 1
        if pos >= raw.len || !IsDigit(raw[pos]):
            outError = "json number missing fractional digits"
            return false
        while pos < raw.len && IsDigit(raw[pos]):
            pos = pos + 1
    if pos < raw.len && (raw[pos] == 'e' || raw[pos] == 'E'):
        pos = pos + 1
        if pos < raw.len && (raw[pos] == '+' || raw[pos] == '-'):
            pos = pos + 1
        if pos >= raw.len || !IsDigit(raw[pos]):
            outError = "json number missing exponent digits"
            return false
        while pos < raw.len && IsDigit(raw[pos]):
            pos = pos + 1
    return true

# ── JSON literal parser ───────────────────────────────────────────────────────

fn ParseLiteral(raw: str, pos: var int32, literal: str, outError: var str): bool =
    if !MatchesAt(raw, pos, literal):
        outError = Cat("json literal expected: ", literal)
        return false
    pos = pos + literal.len
    return true

# ── JSON value parser ─────────────────────────────────────────────────────────

fn ParseValue(raw: str, pos: var int32, outError: var str): bool =
    pos = SkipSpace(raw, pos)
    if pos >= raw.len:
        outError = "json value expected"
        return false
    let ch = raw[pos]
    if ch == '{':
        return ParseObject(raw, pos, outError)
    if ch == '[':
        return ParseArray(raw, pos, outError)
    if ch == '"':
        return ParseString(raw, pos, outError)
    if ch == 't':
        return ParseLiteral(raw, pos, "true", outError)
    if ch == 'f':
        return ParseLiteral(raw, pos, "false", outError)
    if ch == 'n':
        return ParseLiteral(raw, pos, "null", outError)
    if ch == '-' || IsDigit(ch):
        return ParseNumber(raw, pos, outError)
    outError = "unsupported json value"
    return false

# ── JSON array parser ─────────────────────────────────────────────────────────

fn ParseArray(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '[':
        outError = "json array expected"
        return false
    pos = SkipSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
        return true
    while pos < raw.len:
        if !ParseValue(raw, pos, outError):
            return false
        pos = SkipSpace(raw, pos)
        if pos < raw.len && raw[pos] == ',':
            pos = SkipSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == ']':
            pos = pos + 1
            return true
        outError = "malformed json array"
        return false
    outError = "unterminated json array"
    return false

# ── JSON object parser ────────────────────────────────────────────────────────

fn ParseObject(raw: str, pos: var int32, outError: var str): bool =
    if pos >= raw.len || raw[pos] != '{':
        outError = "json object expected"
        return false
    pos = SkipSpace(raw, pos + 1)
    if pos < raw.len && raw[pos] == '}':
        pos = pos + 1
        return true
    while pos < raw.len:
        if !ParseString(raw, pos, outError):
            return false
        pos = SkipSpace(raw, pos)
        if pos >= raw.len || raw[pos] != ':':
            outError = "json object missing colon"
            return false
        pos = SkipSpace(raw, pos + 1)
        if !ParseValue(raw, pos, outError):
            return false
        pos = SkipSpace(raw, pos)
        if pos < raw.len && raw[pos] == ',':
            pos = SkipSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == '}':
            pos = pos + 1
            return true
        outError = "malformed json object"
        return false
    outError = "unterminated json object"
    return false

# ── Full JSON validation ──────────────────────────────────────────────────────

fn ValidateJson(raw: str, outError: var str): bool =
    outError = ""
    var pos: int32
    if !ParseValue(raw, pos, outError):
        return false
    pos = SkipSpace(raw, pos)
    if pos != raw.len:
        outError = "trailing data after json value"
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

# ── Whitespace helpers ────────────────────────────────────────────────────────

fn testIsSpace(): bool =
    if !IsSpace(' '):
        echo("FAIL IsSpace space")
        return false
    if !IsSpace('\t'):
        echo("FAIL IsSpace tab")
        return false
    if !IsSpace('\n'):
        echo("FAIL IsSpace newline")
        return false
    if !IsSpace('\r'):
        echo("FAIL IsSpace cr")
        return false
    if IsSpace('a'):
        echo("FAIL IsSpace letter")
        return false
    if IsSpace('0'):
        echo("FAIL IsSpace digit")
        return false
    echo("testIsSpace ok")
    return true

fn testSkipSpace(): bool =
    # No leading space
    if SkipSpace("abc", 0) != 0:
        echo("FAIL SkipSpace no-space")
        return false
    # Leading spaces
    if SkipSpace("  hello", 0) != 2:
        echo("FAIL SkipSpace leading")
        return false
    # All spaces
    if SkipSpace("   ", 0) != 3:
        echo("FAIL SkipSpace all-space")
        return false
    # Mixed whitespace
    if SkipSpace("\t\n x", 0) != 3:
        echo("FAIL SkipSpace mixed")
        return false
    # Mid-string (skip from non-zero)
    if SkipSpace("a  b", 1) != 3:
        echo("FAIL SkipSpace mid")
        return false
    echo("testSkipSpace ok")
    return true

fn testTrim(): bool =
    # Surrounding spaces
    if Trim("  hello  ") != "hello":
        echo("FAIL Trim surround")
        return false
    # No trim
    if Trim("hello") != "hello":
        echo("FAIL Trim none")
        return false
    # Whitespace only
    if Trim("\t\n") != "":
        echo("FAIL Trim ws-only")
        return false
    # Empty
    if Trim("") != "":
        echo("FAIL Trim empty")
        return false
    echo("testTrim ok")
    return true

# ── Char classification ───────────────────────────────────────────────────────

fn testIsDigit(): bool =
    if !IsDigit('0'):
        echo("FAIL IsDigit 0")
        return false
    if !IsDigit('5'):
        echo("FAIL IsDigit 5")
        return false
    if !IsDigit('9'):
        echo("FAIL IsDigit 9")
        return false
    if IsDigit('a'):
        echo("FAIL IsDigit letter")
        return false
    echo("testIsDigit ok")
    return true

fn testIsNonZeroDigit(): bool =
    if !IsNonZeroDigit('1'):
        echo("FAIL IsNonZeroDigit 1")
        return false
    if !IsNonZeroDigit('9'):
        echo("FAIL IsNonZeroDigit 9")
        return false
    if IsNonZeroDigit('0'):
        echo("FAIL IsNonZeroDigit 0")
        return false
    if IsNonZeroDigit('a'):
        echo("FAIL IsNonZeroDigit letter")
        return false
    echo("testIsNonZeroDigit ok")
    return true

fn testIsHexDigit(): bool =
    if !IsHexDigit('0'):
        echo("FAIL IsHexDigit 0")
        return false
    if !IsHexDigit('9'):
        echo("FAIL IsHexDigit 9")
        return false
    if !IsHexDigit('a'):
        echo("FAIL IsHexDigit a")
        return false
    if !IsHexDigit('f'):
        echo("FAIL IsHexDigit f")
        return false
    if !IsHexDigit('A'):
        echo("FAIL IsHexDigit A")
        return false
    if !IsHexDigit('F'):
        echo("FAIL IsHexDigit F")
        return false
    if IsHexDigit('g'):
        echo("FAIL IsHexDigit g")
        return false
    echo("testIsHexDigit ok")
    return true

# ── JSON string parser ────────────────────────────────────────────────────────

fn testParseString(): bool =
    var pos: int32
    var err: str

    # Simple string
    pos = 0; err = ""
    if !ParseString("\"hello\"", pos, err):
        echo("FAIL ParseString simple")
        return false
    if pos != 7:
        echo("FAIL ParseString simple pos")
        return false

    # String with escape sequence (\n)
    pos = 0; err = ""
    if !ParseString("\"hello\\nworld\"", pos, err):
        echo("FAIL ParseString escape")
        return false

    # String with unicode escape
    pos = 0; err = ""
    if !ParseString("\"\\u0041\"", pos, err):
        echo("FAIL ParseString unicode")
        return false
    if pos != 8:
        echo("FAIL ParseString unicode pos")
        return false

    # String with escaped quote
    pos = 0; err = ""
    if !ParseString("\"hello\\\"there\"", pos, err):
        echo("FAIL ParseString esc-quote")
        return false
    if pos != 14:
        echo("FAIL ParseString esc-quote pos")
        return false

    # Missing opening quote
    pos = 0; err = ""
    if ParseString("hello", pos, err):
        echo("FAIL ParseString no-quote")
        return false

    # Unterminated
    pos = 0; err = ""
    if ParseString("\"hello", pos, err):
        echo("FAIL ParseString unterminated")
        return false

    echo("testParseString ok")
    return true

# ── JSON number parser ────────────────────────────────────────────────────────

fn testParseNumber(): bool =
    var pos: int32
    var err: str

    # Integer
    pos = 0; err = ""
    if !ParseNumber("42", pos, err):
        echo("FAIL ParseNumber int")
        return false
    if pos != 2:
        echo("FAIL ParseNumber int pos")
        return false

    # Negative
    pos = 0; err = ""
    if !ParseNumber("-7", pos, err):
        echo("FAIL ParseNumber neg")
        return false

    # Zero
    pos = 0; err = ""
    if !ParseNumber("0", pos, err):
        echo("FAIL ParseNumber zero")
        return false
    if pos != 1:
        echo("FAIL ParseNumber zero pos")
        return false

    # Float
    pos = 0; err = ""
    if !ParseNumber("3.14", pos, err):
        echo("FAIL ParseNumber float")
        return false
    if pos != 4:
        echo("FAIL ParseNumber float pos")
        return false

    # Scientific notation
    pos = 0; err = ""
    if !ParseNumber("1e10", pos, err):
        echo("FAIL ParseNumber sci")
        return false
    if pos != 4:
        echo("FAIL ParseNumber sci pos")
        return false

    # Negative exponent
    pos = 0; err = ""
    if !ParseNumber("1e-5", pos, err):
        echo("FAIL ParseNumber sci-neg")
        return false
    if pos != 4:
        echo("FAIL ParseNumber sci-neg pos")
        return false

    # Minus only (error)
    pos = 0; err = ""
    if ParseNumber("-", pos, err):
        echo("FAIL ParseNumber minus-only")
        return false

    echo("testParseNumber ok")
    return true

# ── JSON literal parser ───────────────────────────────────────────────────────

fn testParseLiteral(): bool =
    var pos: int32
    var err: str

    # true
    pos = 0; err = ""
    if !ParseLiteral("true", pos, "true", err):
        echo("FAIL ParseLiteral true")
        return false
    if pos != 4:
        echo("FAIL ParseLiteral true pos")
        return false

    # false
    pos = 0; err = ""
    if !ParseLiteral("false", pos, "false", err):
        echo("FAIL ParseLiteral false")
        return false
    if pos != 5:
        echo("FAIL ParseLiteral false pos")
        return false

    # null
    pos = 0; err = ""
    if !ParseLiteral("null", pos, "null", err):
        echo("FAIL ParseLiteral null")
        return false
    if pos != 4:
        echo("FAIL ParseLiteral null pos")
        return false

    # Mismatch
    pos = 0; err = ""
    if ParseLiteral("true", pos, "false", err):
        echo("FAIL ParseLiteral mismatch")
        return false

    echo("testParseLiteral ok")
    return true

# ── JSON array parser ─────────────────────────────────────────────────────────

fn testParseArray(): bool =
    var pos: int32
    var err: str

    # Empty array
    pos = 0; err = ""
    if !ParseArray("[]", pos, err):
        echo("FAIL ParseArray empty")
        return false
    if pos != 2:
        echo("FAIL ParseArray empty pos")
        return false

    # Number array
    pos = 0; err = ""
    if !ParseArray("[1,2,3]", pos, err):
        echo("FAIL ParseArray numbers")
        return false
    if pos != 7:
        echo("FAIL ParseArray numbers pos")
        return false

    # Array with spaces
    pos = 0; err = ""
    if !ParseArray("[ 1 , 2 , 3 ]", pos, err):
        echo("FAIL ParseArray spaced")
        return false
    if pos != 13:
        echo("FAIL ParseArray spaced pos")
        return false

    # Mixed types
    pos = 0; err = ""
    if !ParseArray("[1,\"a\",true]", pos, err):
        echo("FAIL ParseArray mixed")
        return false

    # Unterminated
    pos = 0; err = ""
    if ParseArray("[1,2", pos, err):
        echo("FAIL ParseArray unterminated")
        return false

    echo("testParseArray ok")
    return true

# ── JSON object parser ────────────────────────────────────────────────────────

fn testParseObject(): bool =
    var pos: int32
    var err: str

    # Empty object
    pos = 0; err = ""
    if !ParseObject("{}", pos, err):
        echo("FAIL ParseObject empty")
        return false
    if pos != 2:
        echo("FAIL ParseObject empty pos")
        return false

    # Simple object
    pos = 0; err = ""
    if !ParseObject("{\"a\":1}", pos, err):
        echo("FAIL ParseObject simple")
        return false
    if pos != 7:
        echo("FAIL ParseObject simple pos")
        return false

    # Multi-field object
    pos = 0; err = ""
    if !ParseObject("{\"a\":1,\"b\":2}", pos, err):
        echo("FAIL ParseObject multi")
        return false

    # Nested object
    pos = 0; err = ""
    if !ParseObject("{\"a\":{\"b\":3}}", pos, err):
        echo("FAIL ParseObject nested")
        return false
    if pos != 13:
        echo("FAIL ParseObject nested pos")
        return false

    # Missing colon (space instead of colon)
    pos = 0; err = ""
    if ParseObject("{\"a\" 1}", pos, err):
        echo("FAIL ParseObject no-colon")
        return false

    echo("testParseObject ok")
    return true

# ── JSON value parser ─────────────────────────────────────────────────────────

fn testParseValue(): bool =
    var pos: int32
    var err: str

    # Integer
    pos = 0; err = ""
    if !ParseValue("42", pos, err):
        echo("FAIL ParseValue int")
        return false

    # String
    pos = 0; err = ""
    if !ParseValue("\"hello\"", pos, err):
        echo("FAIL ParseValue string")
        return false

    # true
    pos = 0; err = ""
    if !ParseValue("true", pos, err):
        echo("FAIL ParseValue true")
        return false

    # false
    pos = 0; err = ""
    if !ParseValue("false", pos, err):
        echo("FAIL ParseValue false")
        return false

    # null
    pos = 0; err = ""
    if !ParseValue("null", pos, err):
        echo("FAIL ParseValue null")
        return false

    # Object
    pos = 0; err = ""
    if !ParseValue("{}", pos, err):
        echo("FAIL ParseValue empty-obj")
        return false

    # Array
    pos = 0; err = ""
    if !ParseValue("[]", pos, err):
        echo("FAIL ParseValue empty-arr")
        return false

    # Leading space
    pos = 0; err = ""
    if !ParseValue("  42", pos, err):
        echo("FAIL ParseValue leading-space")
        return false
    if pos != 4:
        echo("FAIL ParseValue leading-space pos")
        return false

    # Empty -> error
    pos = 0; err = ""
    if ParseValue("", pos, err):
        echo("FAIL ParseValue empty")
        return false

    # Unsupported char -> error
    pos = 0; err = ""
    if ParseValue("?", pos, err):
        echo("FAIL ParseValue unsupported")
        return false

    echo("testParseValue ok")
    return true

# ── Full JSON validation ──────────────────────────────────────────────────────

fn testValidateJson(): bool =
    var err: str

    # Valid values
    err = ""
    if !ValidateJson("42", err):
        echo("FAIL ValidateJson int")
        return false
    if err != "":
        echo("FAIL ValidateJson int err")
        return false

    err = ""
    if !ValidateJson("\"hello\"", err):
        echo("FAIL ValidateJson string")
        return false

    err = ""
    if !ValidateJson("true", err):
        echo("FAIL ValidateJson true")
        return false

    err = ""
    if !ValidateJson("false", err):
        echo("FAIL ValidateJson false")
        return false

    err = ""
    if !ValidateJson("null", err):
        echo("FAIL ValidateJson null")
        return false

    err = ""
    if !ValidateJson("{}", err):
        echo("FAIL ValidateJson empty-obj")
        return false

    err = ""
    if !ValidateJson("[]", err):
        echo("FAIL ValidateJson empty-arr")
        return false

    err = ""
    if !ValidateJson("[1,2,3]", err):
        echo("FAIL ValidateJson arr")
        return false

    err = ""
    if !ValidateJson("{\"a\":1}", err):
        echo("FAIL ValidateJson obj")
        return false

    # Nested structure
    err = ""
    if !ValidateJson("{\"a\":{\"b\":[1,2]}}", err):
        echo("FAIL ValidateJson nested")
        return false

    # With surrounding whitespace
    err = ""
    if !ValidateJson("  true  ", err):
        echo("FAIL ValidateJson spaced")
        return false

    # Invalid cases
    err = ""
    if ValidateJson("", err):
        echo("FAIL ValidateJson empty")
        return false

    err = ""
    if ValidateJson("42 abc", err):
        echo("FAIL ValidateJson trailing")
        return false

    err = ""
    if ValidateJson("tralse", err):
        echo("FAIL ValidateJson bad-literal")
        return false

    err = ""
    if ValidateJson("{", err):
        echo("FAIL ValidateJson partial-obj")
        return false

    err = ""
    if ValidateJson("[1,", err):
        echo("FAIL ValidateJson partial-arr")
        return false

    echo("testValidateJson ok")
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    var allOk: bool = true
    if !testIsSpace():
        allOk = false
    if !testSkipSpace():
        allOk = false
    if !testTrim():
        allOk = false
    if !testIsDigit():
        allOk = false
    if !testIsNonZeroDigit():
        allOk = false
    if !testIsHexDigit():
        allOk = false
    if !testParseString():
        allOk = false
    if !testParseNumber():
        allOk = false
    if !testParseLiteral():
        allOk = false
    if !testParseArray():
        allOk = false
    if !testParseObject():
        allOk = false
    if !testParseValue():
        allOk = false
    if !testValidateJson():
        allOk = false
    if allOk:
        echo("rust_csg_exec_schema_relfacts_smoke ok")
        return 0
    echo("rust_csg_exec_schema_relfacts_smoke FAILED")
    return 1
