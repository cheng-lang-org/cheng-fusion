fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgMcpConfig =\n        chatgpt_base_url: str\n        apps_mcp_path_override: opt_str\n        apps_mcp_product_sku: opt_str\n        codex_home: path_buf\n        mcp_oauth_credentials_store_mode: oauth_store_mode\n        mcp_oauth_callback_port: opt_u16\n        mcp_oauth_callback_url: opt_str\n        skill_mcp_dependency_install_enabled: bool\n        approval_policy: constrained_ask_for_approval\n        codex_linux_sandbox_exe: opt_path_buf\n        use_legacy_landlock: bool\n        apps_enabled: bool\n        client_elicitation_capability: elicitation_capability\n        configured_mcp_servers: map_str_mcp_srv_cfg\n        plugin_capability_summaries: vec_plugin_cap_summary\n\n    RustCsgToolPluginProvenance =\n        plugin_display_names_by_connector_id: map_str_vec_str\n        plugin_display_names_by_mcp_server_name: map_str_vec_str\n\n    RustCsgEffectiveMcpServer =\n        configured: method\n        launch: method\n        configured_config: method\n        enabled: method\n\n    RustCsgMcpServerStatusSnapshot =\n        tools_by_server: map_str_map_str_tool\n        resources: map_str_vec_resource\n        resource_templates: map_str_vec_resource_template\n        auth_statuses: map_str_mcp_auth_status\n\n    RustCsgMcpPermissionPromptAutoApproveContext =\n        approvals_reviewer: opt_approvals_reviewer\n        tool_approval_mode: opt_app_tool_approval\n\n    RustCsgCodexAppsConnectorAuthFailure =\n        connector_id: str\n        connector_name: str\n        install_url: str\n        auth_reason: opt_str\n        link_id: opt_str\n        error_code: opt_str\n        error_http_status_code: opt_i64\n        error_action: opt_str\n\n    RustCsgCodexAppsAuthElicitation =\n        meta: json_value\n        message: str\n        url: str\n        elicitation_id: str\n\n    RustCsgCodexAppsAuthElicitationPlan =\n        auth_failure: codex_apps_connector_auth_failure\n        elicitation: codex_apps_auth_elicitation\n\n    RustCsgMcpSnapshotDetail =\n\n    RustCsgMcpAuthStatusEntry =\n        server_name: str\n        auth_status: mcp_auth_status\n        oauth_login: opt_mcp_oauth_login_config\n\n    RustCsgMcpOAuthLoginConfig =\n        auth_url: str\n        token_url: opt_str\n        scopes: opt_vec_str\n\n    RustCsgMcpOAuthLoginSupport =\n        supported: bool\n        sso_available: bool\n        default_scopes: vec_str\n\n    RustCsgMcpOAuthScopesSource =\n        config_scopes: opt_vec_str\n        discovered_scopes: opt_vec_str\n\n    RustCsgResolvedMcpOAuthScopes =\n        effective_scopes: vec_str\n        source: oauth_scopes_source\n\nfn RustCsgCodexMcpFunctionNames(): str =\nfn RustCsgBuildMcpToolCall(toolName: str, args: str): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tcodex_mcp\nLocalType\tcodex_mcp\tRustCsgMcpConfig\nHasField\tcodex_mcp\tRustCsgMcpConfig\tchatgpt_base_url\tstr\nHasField\tcodex_mcp\tRustCsgMcpConfig\tapps_mcp_path_override\topt_str\nHasField\tcodex_mcp\tRustCsgMcpConfig\tapps_mcp_product_sku\topt_str\nHasField\tcodex_mcp\tRustCsgMcpConfig\tcodex_home\tpath_buf\nHasField\tcodex_mcp\tRustCsgMcpConfig\tmcp_oauth_credentials_store_mode\toauth_store_mode\nHasField\tcodex_mcp\tRustCsgMcpConfig\tmcp_oauth_callback_port\topt_u16\nHasField\tcodex_mcp\tRustCsgMcpConfig\tmcp_oauth_callback_url\topt_str\nHasField\tcodex_mcp\tRustCsgMcpConfig\tskill_mcp_dependency_install_enabled\tbool\nHasField\tcodex_mcp\tRustCsgMcpConfig\tapproval_policy\tconstrained_ask_for_approval\nHasField\tcodex_mcp\tRustCsgMcpConfig\tcodex_linux_sandbox_exe\topt_path_buf\nHasField\tcodex_mcp\tRustCsgMcpConfig\tuse_legacy_landlock\tbool\nHasField\tcodex_mcp\tRustCsgMcpConfig\tapps_enabled\tbool\nHasField\tcodex_mcp\tRustCsgMcpConfig\tclient_elicitation_capability\telicitation_capability\nHasField\tcodex_mcp\tRustCsgMcpConfig\tconfigured_mcp_servers\tmap_str_mcp_srv_cfg\nHasField\tcodex_mcp\tRustCsgMcpConfig\tplugin_capability_summaries\tvec_plugin_cap_summary\nLocalType\tcodex_mcp\tRustCsgToolPluginProvenance\nHasField\tcodex_mcp\tRustCsgToolPluginProvenance\tplugin_display_names_by_connector_id\tmap_str_vec_str\nHasField\tcodex_mcp\tRustCsgToolPluginProvenance\tplugin_display_names_by_mcp_server_name\tmap_str_vec_str\nLocalType\tcodex_mcp\tRustCsgEffectiveMcpServer\nHasField\tcodex_mcp\tRustCsgEffectiveMcpServer\tconfigured\tmethod\nHasField\tcodex_mcp\tRustCsgEffectiveMcpServer\tlaunch\tmethod\nHasField\tcodex_mcp\tRustCsgEffectiveMcpServer\tconfigured_config\tmethod\nHasField\tcodex_mcp\tRustCsgEffectiveMcpServer\tenabled\tmethod\nLocalType\tcodex_mcp\tRustCsgMcpServerStatusSnapshot\nHasField\tcodex_mcp\tRustCsgMcpServerStatusSnapshot\ttools_by_server\tmap_str_map_str_tool\nHasField\tcodex_mcp\tRustCsgMcpServerStatusSnapshot\tresources\tmap_str_vec_resource\nHasField\tcodex_mcp\tRustCsgMcpServerStatusSnapshot\tresource_templates\tmap_str_vec_resource_template\nHasField\tcodex_mcp\tRustCsgMcpServerStatusSnapshot\tauth_statuses\tmap_str_mcp_auth_status\nLocalType\tcodex_mcp\tRustCsgMcpPermissionPromptAutoApproveContext\nHasField\tcodex_mcp\tRustCsgMcpPermissionPromptAutoApproveContext\tapprovals_reviewer\topt_approvals_reviewer\nHasField\tcodex_mcp\tRustCsgMcpPermissionPromptAutoApproveContext\ttool_approval_mode\topt_app_tool_approval\nLocalType\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\tconnector_id\tstr\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\tconnector_name\tstr\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\tinstall_url\tstr\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\tauth_reason\topt_str\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\tlink_id\topt_str\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\terror_code\topt_str\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\terror_http_status_code\topt_i64\nHasField\tcodex_mcp\tRustCsgCodexAppsConnectorAuthFailure\terror_action\topt_str\nLocalType\tcodex_mcp\tRustCsgCodexAppsAuthElicitation\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitation\tmeta\tjson_value\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitation\tmessage\tstr\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitation\turl\tstr\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitation\telicitation_id\tstr\nLocalType\tcodex_mcp\tRustCsgCodexAppsAuthElicitationPlan\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitationPlan\tauth_failure\tcodex_apps_connector_auth_failure\nHasField\tcodex_mcp\tRustCsgCodexAppsAuthElicitationPlan\telicitation\tcodex_apps_auth_elicitation\nLocalType\tcodex_mcp\tRustCsgMcpSnapshotDetail\nLocalType\tcodex_mcp\tRustCsgMcpAuthStatusEntry\nHasField\tcodex_mcp\tRustCsgMcpAuthStatusEntry\tserver_name\tstr\nHasField\tcodex_mcp\tRustCsgMcpAuthStatusEntry\tauth_status\tmcp_auth_status\nHasField\tcodex_mcp\tRustCsgMcpAuthStatusEntry\toauth_login\topt_mcp_oauth_login_config\nLocalType\tcodex_mcp\tRustCsgMcpOAuthLoginConfig\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginConfig\tauth_url\tstr\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginConfig\ttoken_url\topt_str\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginConfig\tscopes\topt_vec_str\nLocalType\tcodex_mcp\tRustCsgMcpOAuthLoginSupport\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginSupport\tsupported\tbool\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginSupport\tsso_available\tbool\nHasField\tcodex_mcp\tRustCsgMcpOAuthLoginSupport\tdefault_scopes\tvec_str\nLocalType\tcodex_mcp\tRustCsgMcpOAuthScopesSource\nHasField\tcodex_mcp\tRustCsgMcpOAuthScopesSource\tconfig_scopes\topt_vec_str\nHasField\tcodex_mcp\tRustCsgMcpOAuthScopesSource\tdiscovered_scopes\topt_vec_str\nLocalType\tcodex_mcp\tRustCsgResolvedMcpOAuthScopes\nHasField\tcodex_mcp\tRustCsgResolvedMcpOAuthScopes\teffective_scopes\tvec_str\nHasField\tcodex_mcp\tRustCsgResolvedMcpOAuthScopes\tsource\toauth_scopes_source\nFunction\tcodex_mcp\tRustCsgCodexMcpFunctionNames\tstr\nFunction\tcodex_mcp\tRustCsgBuildMcpToolCall\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 14, "source type count")
    assert(ecf == 54, "source field count")
    assert(ecn == 2, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 14, "oracle type count")
    assert(ocf == 54, "oracle field count")
    assert(ocn == 2, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_codex_mcp_relfacts_smoke ok")
