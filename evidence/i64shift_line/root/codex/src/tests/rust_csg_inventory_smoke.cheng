import std/strings
import cheng/codex/core/inventory

fn main(): int32 =
    var reason: str
    if !inventory.RustCsgCargoMembersOk(reason):
        echo("FAIL cargo members")
        echo(reason)
        return 1

    var stats = inventory.RustCsgCollectSourceStats()
    if !inventory.RustCsgInventoryOk(stats, reason):
        echo("FAIL source inventory")
        echo(reason)
        return 1
    echo(inventory.RustCsgStatsText(stats))

    if !inventory.RustCsgTuiRecursiveSnapshotsOk(reason):
        echo("FAIL tui recursive snapshots")
        echo(reason)
        return 1
    let recursiveSnapshots = inventory.RustCsgCountTuiRecursiveSnapshots(
        inventory.RustCsgInventorySourceRoot(),
        reason)
    if reason != "":
        echo("FAIL tui recursive snapshot recount")
        echo(reason)
        return 1
    echo(strings.ConcatStr("tui_recursive_snapshots=", inventory.RustCsgInt32Text(recursiveSnapshots)))

    echo("rust_csg_inventory_smoke ok")
    return 0
