import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Shell Command Provider — tests for shlex_join, is_dangerous, is_safe
# Ported from codex-rs/shell-command/src/
# ═══════════════════════════════════════════════════════════════════════════════

@abi_internal
@importc("ShlexJoinTwo")
fn ShlexJoinTwo(a: str, b: str): str

@abi_internal
@importc("ShellIsDangerousCommand")
fn ShellIsDangerousCommand(cmd: str): bool

@abi_internal
@importc("ShellIsSafeCommand")
fn ShellIsSafeCommand(cmd: str): bool

# ── Test Helpers ────────────────────────────────────────────────────────

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected str=\"", expected, "\" got=\"", got, "\""], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

# ── Tests ───────────────────────────────────────────────────────────────

fn testShlexJoinSafeTokens(): bool =
    var ok: bool = true
    # Simple tokens — no quoting needed
    let joined = ShlexJoinTwo("ls", "-la")
    if !checkEqStr(joined, "ls -la"):
        ok = false

    if ok:
        echo("testShlexJoinSafeTokens ok")
    return ok

fn testShlexJoinNeedsQuoting(): bool =
    var ok: bool = true
    # Token with space — needs single-quoting
    let joined = ShlexJoinTwo("cat", "my file.txt")
    if !checkEqStr(joined, "cat 'my file.txt'"):
        ok = false

    if ok:
        echo("testShlexJoinNeedsQuoting ok")
    return ok

fn testShlexJoinSpecialChars(): bool =
    var ok: bool = true
    # Token with shell metacharacter
    let withDollar = ShlexJoinTwo("echo", "$PATH")
    if !checkEqStr(withDollar, "echo '$PATH'"):
        ok = false

    # Token with backtick
    let withBacktick = ShlexJoinTwo("echo", "`pwd`")
    if !checkEqStr(withBacktick, "echo '`pwd`'"):
        ok = false

    # Token with semicolon
    let withSemi = ShlexJoinTwo("echo", "hello;world")
    if !checkEqStr(withSemi, "echo 'hello;world'"):
        ok = false

    if ok:
        echo("testShlexJoinSpecialChars ok")
    return ok

fn testShlexJoinSingleQuotes(): bool =
    var ok: bool = true
    # Token with embedded single quote: standard POSIX shell escapes as \'
    let withQuote = ShlexJoinTwo("echo", "it's")
    if !checkEqStr(withQuote, "echo 'it'\\''s'"):
        ok = false

    if ok:
        echo("testShlexJoinSingleQuotes ok")
    return ok

fn testIsDangerousRf(): bool =
    var ok: bool = true
    if !checkEqBool(ShellIsDangerousCommand("rm -rf /"), true):
        ok = false
    if !checkEqBool(ShellIsDangerousCommand("rm -f /etc/passwd"), true):
        ok = false
    if !checkEqBool(ShellIsDangerousCommand("ls -la"), false):
        ok = false
    if !checkEqBool(ShellIsDangerousCommand("echo hello"), false):
        ok = false
    if !checkEqBool(ShellIsDangerousCommand("sudo rm -rf /"), true):
        ok = false

    if ok:
        echo("testIsDangerousRf ok")
    return ok

fn testIsSafeCommand(): bool =
    var ok: bool = true
    if !checkEqBool(ShellIsSafeCommand("ls -la"), true):
        ok = false
    if !checkEqBool(ShellIsSafeCommand("cat file.txt"), true):
        ok = false
    if !checkEqBool(ShellIsSafeCommand("echo hello"), true):
        ok = false
    if !checkEqBool(ShellIsSafeCommand("grep foo bar"), true):
        ok = false
    if !checkEqBool(ShellIsSafeCommand("rm -rf /"), false):
        ok = false
    if !checkEqBool(ShellIsSafeCommand("sudo rm -rf"), false):
        ok = false

    if ok:
        echo("testIsSafeCommand ok")
    return ok

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testShlexJoinSafeTokens():
        allOk = false
    if !testShlexJoinNeedsQuoting():
        allOk = false
    if !testShlexJoinSpecialChars():
        allOk = false
    if !testShlexJoinSingleQuotes():
        allOk = false
    if !testIsDangerousRf():
        allOk = false
    if !testIsSafeCommand():
        allOk = false
    if allOk:
        echo("rust_csg_shell_command_smoke ok")
        return 0
    else:
        echo("rust_csg_shell_command_smoke FAILED")
        return 1
