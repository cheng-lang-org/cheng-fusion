# ═══════════════════════════════════════════════════════════════════════════════
# config/user_config — relfacts equivalence smoke test
#
# Verifies that the config/user_config module's defined functions, types, and
# fields match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgUserConfig =\n        model: str\n        modelProvider: str\n        approvalPolicy: str\n        approvalsReviewer: str\n        sandboxMode: str\n        ossProvider: str\n        defaultPermissions: str\n        profile: str\n\nfn RustCsgPathReadable(path: str): int32\nfn RustCsgReadConfigFile(path: str): str\nfn RustCsgConfigTomlIsSpace(ch: char): bool\nfn RustCsgConfigTomlTrim(raw: str): str\nfn RustCsgConfigTomlFindEquals(line: str): int32\nfn RustCsgConfigTomlStripComment(line: str, outError: var str): str\nfn RustCsgConfigTomlStringValue(valueRaw: str, outError: var str): str\nfn RustCsgUserConfigJson(model: str, modelProvider: str, approvalPolicy: str, approvalsReviewer: str, sandboxMode: str, ossProvider: str, defaultPermissions: str, profile: str): str\nfn RustCsgEmptyUserConfigJson(): str\nfn RustCsgConfigTomlStartsWith(text: str, prefix: str): bool\nfn RustCsgConfigTomlProfileTableName(tableName: str, outError: var str): str\nfn RustCsgConfigTomlRootProfileName(text: str, selectedProfile: str, outError: var str): str\nfn RustCsgParseUserConfigTomlJsonWithProfile(text: str, selectedProfileOverride: str, outError: var str): str\nfn RustCsgParseUserConfigTomlJson(text: str, outError: var str): str\nfn RustCsgLoadUserConfigJsonFromCodexHome(codexHomePath: str, ignoreUserConfig: bool, outError: var str): str\nfn RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(codexHomePath: str, ignoreUserConfig: bool, selectedProfile: str, outError: var str): str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tconfig/user_config\nDefFunction\tconfig/user_config\tRustCsgPathReadable\tpath: str\t->\tint32\nDefFunction\tconfig/user_config\tRustCsgReadConfigFile\tpath: str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgConfigTomlIsSpace\tch: char\t->\tbool\nDefFunction\tconfig/user_config\tRustCsgConfigTomlTrim\traw: str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgConfigTomlFindEquals\tline: str\t->\tint32\nDefFunction\tconfig/user_config\tRustCsgConfigTomlStripComment\tline: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgConfigTomlStringValue\tvalueRaw: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgUserConfigJson\tmodel: str, modelProvider: str, approvalPolicy: str, approvalsReviewer: str, sandboxMode: str, ossProvider: str, defaultPermissions: str, profile: str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgEmptyUserConfigJson\t\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgConfigTomlStartsWith\ttext: str, prefix: str\t->\tbool\nDefFunction\tconfig/user_config\tRustCsgConfigTomlProfileTableName\ttableName: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgConfigTomlRootProfileName\ttext: str, selectedProfile: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgParseUserConfigTomlJsonWithProfile\ttext: str, selectedProfileOverride: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgParseUserConfigTomlJson\ttext: str, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgLoadUserConfigJsonFromCodexHome\tcodexHomePath: str, ignoreUserConfig: bool, outError: var str\t->\tstr\nDefFunction\tconfig/user_config\tRustCsgLoadUserConfigJsonFromCodexHomeWithProfile\tcodexHomePath: str, ignoreUserConfig: bool, selectedProfile: str, outError: var str\t->\tstr\nLocalType\tconfig/user_config\tRustCsgUserConfig\nHasField\tconfig/user_config\tRustCsgUserConfig\tmodel\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tmodelProvider\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tapprovalPolicy\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tapprovalsReviewer\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tsandboxMode\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tossProvider\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tdefaultPermissions\tstr\nHasField\tconfig/user_config\tRustCsgUserConfig\tprofile\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 16, "source function count")
    assert(est == 1, "source type count")
    assert(esfd == 8, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 16, "oracle function count")
    assert(ost == 1, "oracle type count")
    assert(osfd == 8, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_user_config_relfacts_smoke ok")
    return 0
