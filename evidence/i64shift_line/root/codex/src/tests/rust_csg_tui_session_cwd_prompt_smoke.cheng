import std/strings
import std/strutils as strutil
import cheng/codex/tui/session_cwd_prompt as prompt

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn Esc(): str =
    return strings.CharToStr(Char(27))

fn CtrlC(): str =
    return strings.CharToStr(Char(3))

fn CtrlD(): str =
    return strings.CharToStr(Char(4))

fn main(): int32 =
    let currentCwd = "/Users/example/current"
    let sessionCwd = "/Users/example/session"
    var failures: int32

    let empty = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "")
    failures = failures + CheckEqBool(empty.ok, true, "empty ok")
    failures = failures + CheckEqStr(empty.outcome, "selection", "empty outcome")
    failures = failures + CheckEqStr(empty.selection, "session", "empty default session")
    failures = failures + CheckContains(empty.screen, "Choose working directory to resume this session", "resume heading")
    failures = failures + CheckContains(empty.screen, "› 1. Use session directory (/Users/example/session)", "default session highlighted")

    let enter = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "\n")
    failures = failures + CheckEqStr(enter.outcome, "selection", "enter outcome")
    failures = failures + CheckEqStr(enter.selection, "session", "enter default")

    let downEnter = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, strutil.Join([Esc(), "[B|\n"], ""))
    failures = failures + CheckEqStr(downEnter.selection, "current", "down enter current")
    failures = failures + CheckContains(downEnter.screen, "› 2. Use current directory (/Users/example/current)", "current highlighted")

    let jEnter = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "j|\n")
    failures = failures + CheckEqStr(jEnter.selection, "current", "j enter current")

    let kEnter = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "k|\n")
    failures = failures + CheckEqStr(kEnter.selection, "current", "k toggles current")

    let one = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "1")
    failures = failures + CheckEqStr(one.selection, "session", "one selects session")

    let two = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, "2")
    failures = failures + CheckEqStr(two.selection, "current", "two selects current")

    let escape = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, Esc())
    failures = failures + CheckEqStr(escape.selection, "session", "escape selects session")

    let ctrlC = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, CtrlC())
    failures = failures + CheckEqStr(ctrlC.outcome, "exit", "ctrl-c exits")
    failures = failures + CheckEqStr(ctrlC.selection, "", "ctrl-c no selection")

    let ctrlD = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("resume", currentCwd, sessionCwd, 80, CtrlD())
    failures = failures + CheckEqStr(ctrlD.outcome, "exit", "ctrl-d exits")

    let fork = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("fork", currentCwd, sessionCwd, 80, "\n")
    failures = failures + CheckEqStr(fork.selection, "session", "fork enter session")
    failures = failures + CheckContains(fork.screen, "Choose working directory to fork this session", "fork heading")
    failures = failures + CheckContains(fork.screen, "forked session", "fork past participle")

    let badAction = prompt.RustCsgTuiSessionCwdPromptRunTerminalSequences("delete", currentCwd, sessionCwd, 80, "")
    failures = failures + CheckEqBool(badAction.ok, false, "bad action fails")
    failures = failures + CheckEqStr(badAction.error, "unsupported cwd prompt action", "bad action error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_cwd_prompt_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_cwd_prompt_smoke ok")
    return 0
