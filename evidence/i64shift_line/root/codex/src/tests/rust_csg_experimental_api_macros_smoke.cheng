import std/strutils as strutil
import cheng/codex/crates/experimental_api_macros/experimental_api_macros

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: codex-experimental-api-macros isExperimentalApi
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # experimental_ prefix (13 chars) → true
    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("experimental_new_ui"):
        echo("FAIL: experimental_new_ui should be true")
        allOk = false

    # unstable_ prefix (9 chars) → true
    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("unstable_beta_api"):
        echo("FAIL: unstable_beta_api should be true")
        allOk = false

    # No prefix → false
    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("stable_feature"):
        echo("FAIL: stable_feature should be false")
        allOk = false

    # Empty → false
    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi(""):
        echo("FAIL: empty should be false")
        allOk = false

    # Partial match (experimental in the middle) → false
    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("my_experimental_thing"):
        echo("FAIL: my_experimental_thing should be false")
        allOk = false

    # Exact experimental_ → true
    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("experimental_"):
        echo("FAIL: exact experimental_ should be true")
        allOk = false

    # Exact unstable_ → true
    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsExperimentalApi("unstable_"):
        echo("FAIL: exact unstable_ should be true")
        allOk = false

    # Production function: isStableApi
    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsStableApi("stable_feature"):
        echo("FAIL: stable_feature should be true for isStableApi")
        allOk = false

    if !experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsStableApi("my_custom_api"):
        echo("FAIL: my_custom_api should be true for isStableApi")
        allOk = false

    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsStableApi(""):
        echo("FAIL: empty should be false for isStableApi")
        allOk = false

    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsStableApi("experimental_new_ui"):
        echo("FAIL: experimental_ prefix should be false for isStableApi")
        allOk = false

    if experimental_api_macros.RustCsgCodexExperimentalApiMacrosIsStableApi("unstable_beta_api"):
        echo("FAIL: unstable_ prefix should be false for isStableApi")
        allOk = false

    # Production function: generateManifest
    let m1 = experimental_api_macros.RustCsgCodexExperimentalApiMacrosGenerateManifest("experimental_new_ui,stable_feature,unstable_beta")
    if !strutil.Contains(m1, "\"experimental\""):
        echo("FAIL: manifest should contain experimental key")
        allOk = false
    if !strutil.Contains(m1, "\"stable\""):
        echo("FAIL: manifest should contain stable key")
        allOk = false
    if !strutil.Contains(m1, "\"experimental_new_ui\""):
        echo("FAIL: manifest should contain experimental_new_ui")
        allOk = false
    let m3 = experimental_api_macros.RustCsgCodexExperimentalApiMacrosGenerateManifest("")
    if m3 != "{\"experimental\":[],\"stable\":[]}":
        echo("FAIL: empty manifest should be {\"experimental\":[],\"stable\":[]}")
        allOk = false

    if allOk:
        echo("rust_csg_experimental_api_macros_smoke ok")
        return 0
    else:
        echo("rust_csg_experimental_api_macros_smoke FAILED")
        return 1
