@importc("getpid")
fn clib_getpid(): int32
@importc("time")
fn clib_time(out: ptr): int64
@abi_internal
@importc("access")
fn clib_access(path: cstring, mode: int32): int32
@abi_internal
@importc("mkdir")
fn clib_mkdir(path: cstring, mode: int32): int32
@abi_internal
@importc("unlink")
fn clib_unlink(path: cstring): int32
@abi_internal
@importc("rmdir")
fn clib_rmdir(path: cstring): int32
@abi_internal
@importc("fopen")
fn clib_fopen(path: cstring, mode: cstring): ptr
@importc("fclose")
fn clib_fclose(f: ptr): int32
@importc("fseek")
fn clib_fseek(f: ptr, offset: int64, whence: int32): int32
@importc("ftell")
fn clib_ftell(f: ptr): int64
@abi_internal
@importc("opendir")
fn clib_opendir(path: cstring): ptr
@importc("closedir")
fn clib_closedir(dir: ptr): int32
@abi_internal
@importc("open")
fn clib_open(path: cstring, flags: int32, mode: int32): int32
@importc("read")
fn clib_read(fd: int32, buf: ptr, count: int64): int64
@importc("write")
fn clib_write(fd: int32, buf: ptr, count: int64): int64
@importc("close")
fn clib_close(fd: int32): int32

@abi_internal
@exportc("RustCsgGetPid")
fn RustCsgGetPidExport(): int32 = return clib_getpid()
@abi_internal
@exportc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMsExport(): int64 = return clib_time(nil) * int64(1000)
@abi_internal
@exportc("RustCsgFileExists")
fn RustCsgFileExistsExport(path: str): int32 =
    if clib_access(path, 0) == 0: return 1
    return 0
@abi_internal
@exportc("RustCsgMkdir")
fn RustCsgMkdirExport(path: str): int32 =
    if clib_mkdir(path, 493) == 0: return 1
    return 0
@abi_internal
@exportc("RustCsgFileDelete")
fn RustCsgFileDeleteExport(path: str): int32 =
    if clib_unlink(path) == 0: return 1
    if clib_rmdir(path) == 0: return 1
    return 0
@abi_internal
@exportc("RustCsgPathMetadataKind")
fn RustCsgPathMetadataKindExport(path: str): int32 =
    if clib_access(path, 0) != 0: return 0
    var d = clib_opendir(path)
    if d != nil:
        clib_closedir(d)
        return 1
    var f = clib_fopen(path, "rb")
    if f != nil:
        clib_fclose(f)
        return 2
    return -1

@importc("usleep")
fn clib_usleep(usec: uint32): int32

@abi_internal
@exportc("RustCsgSleepMs")
fn RustCsgSleepMsExport(ms: int32): int32 =
    var usec: uint32 = uint32(ms) * uint32(1000)
    clib_usleep(usec)
    return 1

@abi_internal
@exportc("RustCsgFileCopy")
fn RustCsgFileCopyExport(src: str, dst: str): int32 =
    let content = ReadTextFile(src)
    if content == "": return 0
    if WriteTextFile(dst, content) != 1: return 0
    return 1

@abi_internal
@importc("rename")
fn clib_rename(old: cstring, new: cstring): int32
@abi_internal
@importc("rmdir")
fn clib_rmdir2(path: cstring): int32

@abi_internal
@exportc("RustCsgFileRename")
fn RustCsgFileRenameExport(old: str, new: str): int32 =
    if clib_rename(old, new) == 0: return 1
    return 0

@abi_internal
@exportc("RustCsgRemoveDir")
fn RustCsgRemoveDirExport(path: str): int32 =
    if clib_rmdir2(path) == 0: return 1
    return 0

@abi_internal
@exportc("cheng_auth_file_exists")
fn chengAuthFileExistsExport(path: str): int32 =
    var f = clib_fopen(path, "rb")
    if f == nil: return 0
    clib_fclose(f)
    return 1
