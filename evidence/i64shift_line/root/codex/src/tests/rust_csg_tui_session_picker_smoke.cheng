import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/session_picker as picker

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strings.strContains(text, needle):
        return 0
    echo(strutil.Join(["FAIL missing ", label, ": ", needle], ""))
    return 1

fn CheckNotContains(text: str, needle: str, label: str): int32 =
    if !strings.strContains(text, needle):
        return 0
    echo(strutil.Join(["FAIL unexpected ", label, ": ", needle], ""))
    return 1

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqInt(actual: int32, expected: int32, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", strings.IntToStr(expected), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_session_picker_smoke <state-db>")
        return 1

    let dbPath = cmdline.argStr(1)
    let nowMs: int64 = int64(1770007200000)
    var failures: int32

    let comfortable = picker.RustCsgTuiSessionPickerRenderFromStateDb(
        dbPath, "resume", 80, 12, 1, false, true, "", "", "updated_at", nowMs, 25)
    if !comfortable.ok:
        echo(strutil.Join(["FAIL comfortable render: ", comfortable.error], ""))
        return 1
    failures = failures + CheckEqInt(comfortable.rowCount, 3, "comfortable rowCount")
    failures = failures + CheckEqStr(comfortable.selectedThreadId, "thread-b", "selectedThreadId")
    failures = failures + CheckContains(comfortable.screen, "Resume a previous session", "resume title")
    failures = failures + CheckContains(comfortable.screen, "❯ Parser crash investigation", "selected row")
    failures = failures + CheckContains(comfortable.screen, "Code review widget", "first row title")
    failures = failures + CheckContains(comfortable.screen, "15m ago", "relative updated")
    failures = failures + CheckContains(comfortable.screen, "⌁ /repo/a", "cwd")
    failures = failures + CheckContains(comfortable.screen, " no branch", "missing branch label")
    failures = failures + CheckContains(comfortable.screen, " 2 / 3 · 66% ", "footer progress")

    let resumeSelection = picker.RustCsgTuiSessionPickerSelectFromStateDb(
        dbPath, "resume", 1, "", "", "updated_at", 25)
    if !resumeSelection.ok:
        echo(strutil.Join(["FAIL resume selection: ", resumeSelection.error], ""))
        return 1
    failures = failures + CheckEqStr(resumeSelection.kind, "resume", "resume selection kind")
    failures = failures + CheckEqStr(resumeSelection.threadId, "thread-b", "resume selection threadId")
    failures = failures + CheckEqStr(resumeSelection.path, "/tmp/b.jsonl", "resume selection path")
    failures = failures + CheckEqStr(resumeSelection.displayLabel, "/tmp/b.jsonl", "resume selection label")

    let forkSelection = picker.RustCsgTuiSessionPickerSelectFromStateDb(
        dbPath, "fork", 0, "", "/repo/a", "updated_at", 25)
    if !forkSelection.ok:
        echo(strutil.Join(["FAIL fork selection: ", forkSelection.error], ""))
        return 1
    failures = failures + CheckEqStr(forkSelection.kind, "fork", "fork selection kind")
    failures = failures + CheckEqStr(forkSelection.threadId, "thread-a", "fork selection threadId")
    failures = failures + CheckEqStr(forkSelection.path, "/tmp/a.jsonl", "fork selection path")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_picker_smoke FAIL (", strings.IntToStr(failures), " failures)"], ""))
        return 1
    echo(comfortable.screen)
    echo("rust_csg_tui_session_picker_smoke ok")
    return 0
