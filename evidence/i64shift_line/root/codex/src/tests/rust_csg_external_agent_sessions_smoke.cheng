import std/strings as strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: external-agent-sessions — filesystem-safe session name normalization
# ═══════════════════════════════════════════════════════════════════════════════

# NOTE: const str is broken at runtime (finding #23), use functions instead.
fn RustCsgExternalAgentSessionsLowerAlpha(): str =
    return "abcdefghijklmnopqrstuvwxyz"

fn RustCsgExternalAgentSessionsNormalizeSessionName(name: str): str =
    if name.len == 0:
        return "unnamed-session"
    # Phase 1: lowercase, keep alphanumeric/underscore/hyphen, replace rest with hyphen
    var out: str = ""
    var i: int32 = 0
    while i < name.len:
        let ch = name[i]
        let b = Int32(ch)
        if b >= 65 && b <= 90:
            # Uppercase ASCII → lowercase via lookup table
            let idx = b - 65
            out = strutil.Join([out, strings.SliceBytes(RustCsgExternalAgentSessionsLowerAlpha(), idx, 1)], "")
        elif (b >= 97 && b <= 122) || (b >= 48 && b <= 57):
            # Already lowercase letter or digit
            out = strutil.Join([out, strings.SliceBytes(name, i, 1)], "")
        elif ch == '-' || ch == '_':
            out = strutil.Join([out, strings.SliceBytes(name, i, 1)], "")
        else:
            # Space, punctuation, special char → hyphen
            out = strutil.Join([out, "-"], "")
        i = i + 1
    # Phase 2: collapse consecutive hyphens
    var collapsed: str = ""
    var prevHyphen: bool = false
    var ci: int32 = 0
    while ci < out.len:
        let c = out[ci]
        if c == '-':
            if !prevHyphen:
                collapsed = strutil.Join([collapsed, "-"], "")
                prevHyphen = true
        else:
            collapsed = strutil.Join([collapsed, strings.SliceBytes(out, ci, 1)], "")
            prevHyphen = false
        ci = ci + 1
    # Phase 3: trim leading and trailing hyphens
    var startTrim: int32 = 0
    while startTrim < collapsed.len && collapsed[startTrim] == '-':
        startTrim = startTrim + 1
    var endTrim: int32 = collapsed.len
    while endTrim > startTrim && collapsed[endTrim - 1] == '-':
        endTrim = endTrim - 1
    if startTrim >= endTrim:
        return "unnamed-session"
    return strings.SliceBytes(collapsed, startTrim, endTrim - startTrim)

fn RustCsgExternalAgentSessionsBuildContext(sessions: str[]): str =
    if sessions.len == 0:
        return ""
    var result: str = ""
    var i: int32 = 0
    while i < sessions.len:
        let entry: str = sessions[i]
        if entry.len > 5:
            let prefix: str = strings.SliceBytes(entry, 0, 5)
            if prefix == "name:":
                let sessionName: str = strings.SliceBytes(entry, 5, entry.len - 5)
                if sessionName.len > 0:
                    let normalized: str = RustCsgExternalAgentSessionsNormalizeSessionName(sessionName)
                    result = strutil.Join([result, "<session>", normalized, "</session>"], "")
        i = i + 1
    if result.len == 0:
        return ""
    return strutil.Join(["<sessions>", result, "</sessions>"], "")

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testNormalizeSessionNameSimple(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("My Session"), "my-session"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameSimple ok")
    return ok

fn testNormalizeSessionNameAlreadySlug(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("my-session-2024"), "my-session-2024"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameAlreadySlug ok")
    return ok

fn testNormalizeSessionNameEmpty(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName(""), "unnamed-session"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameEmpty ok")
    return ok

fn testNormalizeSessionNameSpecialChars(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("Hello World! @#$%"), "hello-world"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameSpecialChars ok")
    return ok

fn testNormalizeSessionNameMultipleSpaces(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("Session   Name"), "session-name"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameMultipleSpaces ok")
    return ok

fn testNormalizeSessionNameLeadingTrailingHyphens(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("--Hello World--"), "hello-world"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameLeadingTrailingHyphens ok")
    return ok

fn testNormalizeSessionNameUnderscore(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("my_session_name"), "my_session_name"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameUnderscore ok")
    return ok

fn testNormalizeSessionNameNumbersOnly(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("12345"), "12345"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameNumbersOnly ok")
    return ok

fn testNormalizeSessionNameMixedCase(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("My-Cool_Session 2024!"), "my-cool_session-2024"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameMixedCase ok")
    return ok

fn testNormalizeSessionNameLeadingSpecialChars(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("!!!important"), "important"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameLeadingSpecialChars ok")
    return ok

fn testNormalizeSessionNameTrailingSpecialChars(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("hello???"), "hello"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameTrailingSpecialChars ok")
    return ok

fn testNormalizeSessionNameOnlySpecialChars(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("!!!"), "unnamed-session"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameOnlySpecialChars ok")
    return ok

fn testNormalizeSessionNameDotSeparator(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("config.v1.2024"), "config-v1-2024"):
        ok = false
    if ok:
        echo("testNormalizeSessionNameDotSeparator ok")
    return ok

fn testNormalizeSessionNamePathLike(): bool =
    var ok: bool = true
    if !checkEq(RustCsgExternalAgentSessionsNormalizeSessionName("/var/log/session"), "var-log-session"):
        ok = false
    if ok:
        echo("testNormalizeSessionNamePathLike ok")
    return ok

fn testBuildContextEmpty(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, ""): ok = false
    if ok:
        echo("testBuildContextEmpty ok")
    return ok

fn testBuildContextSingle(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    add(sessions, "name:my-session")
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, "<sessions><session>my-session</session></sessions>"): ok = false
    if ok:
        echo("testBuildContextSingle ok")
    return ok

fn testBuildContextMultiple(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    add(sessions, "name:session-one")
    add(sessions, "name:session-two")
    add(sessions, "name:session-three")
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, "<sessions><session>session-one</session><session>session-two</session><session>session-three</session></sessions>"): ok = false
    if ok:
        echo("testBuildContextMultiple ok")
    return ok

fn testBuildContextNormalizesName(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    add(sessions, "name:My Cool Session!")
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, "<sessions><session>my-cool-session</session></sessions>"): ok = false
    if ok:
        echo("testBuildContextNormalizesName ok")
    return ok

fn testBuildContextSkipsMalformed(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    add(sessions, "name:valid")
    add(sessions, "invalid-entry")
    add(sessions, "name:")
    add(sessions, "other=stuff")
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, "<sessions><session>valid</session></sessions>"): ok = false
    if ok:
        echo("testBuildContextSkipsMalformed ok")
    return ok

fn testBuildContextOnlyMalformed(): bool =
    var ok: bool = true
    var sessions: str[]
    sessions = []
    add(sessions, "invalid")
    add(sessions, "")
    let ctx = RustCsgExternalAgentSessionsBuildContext(sessions)
    if !checkEq(ctx, ""): ok = false
    if ok:
        echo("testBuildContextOnlyMalformed ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testNormalizeSessionNameSimple(): allOk = false
    if !testNormalizeSessionNameAlreadySlug(): allOk = false
    if !testNormalizeSessionNameEmpty(): allOk = false
    if !testNormalizeSessionNameSpecialChars(): allOk = false
    if !testNormalizeSessionNameMultipleSpaces(): allOk = false
    if !testNormalizeSessionNameLeadingTrailingHyphens(): allOk = false
    if !testNormalizeSessionNameUnderscore(): allOk = false
    if !testNormalizeSessionNameNumbersOnly(): allOk = false
    if !testNormalizeSessionNameMixedCase(): allOk = false
    if !testNormalizeSessionNameLeadingSpecialChars(): allOk = false
    if !testNormalizeSessionNameTrailingSpecialChars(): allOk = false
    if !testNormalizeSessionNameOnlySpecialChars(): allOk = false
    if !testNormalizeSessionNameDotSeparator(): allOk = false
    if !testNormalizeSessionNamePathLike(): allOk = false
    if !testBuildContextEmpty(): allOk = false
    if !testBuildContextSingle(): allOk = false
    if !testBuildContextMultiple(): allOk = false
    if !testBuildContextNormalizesName(): allOk = false
    if !testBuildContextSkipsMalformed(): allOk = false
    if !testBuildContextOnlyMalformed(): allOk = false
    if allOk:
        echo("rust_csg_external_agent_sessions_smoke ok")
        return 0
    else:
        echo("rust_csg_external_agent_sessions_smoke FAILED")
        return 1
