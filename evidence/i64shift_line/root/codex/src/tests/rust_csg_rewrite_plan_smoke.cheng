import cheng/codex/core/inventory_static as inventory
import cheng/codex/core/module_map
import cheng/codex/core/rewrite_plan
import cheng/codex/protocol/wire

fn CheckCount(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(wire.RustCsgCat4(label, ": expected ", inventory.RustCsgInt32Text(expected), " got "))
        echo(inventory.RustCsgInt32Text(got))
        return false
    return true

fn CheckRewritePlanAggregates(): bool =
    var units = rewrite_plan.RustCsgRewritePlanUnits()
    if !CheckCount("total", int32(units.len), rewrite_plan.RustCsgRewritePlanExpectedTotalMembers()):
        return false
    if !CheckCount("ported",
                   rewrite_plan.RustCsgRewritePlanStatusCount(units, "ported"),
                   rewrite_plan.RustCsgRewritePlanExpectedPortedMembers()):
        return false
    if !CheckCount("blocked",
                   rewrite_plan.RustCsgRewritePlanStatusCount(units, module_map.RustCsgExplicitlyBlocked),
                   rewrite_plan.RustCsgRewritePlanExpectedBlockedMembers()):
        return false
    if !CheckCount("verified_members",
                   rewrite_plan.RustCsgRewritePlanRelfactsVerifiedCount(units),
                   rewrite_plan.RustCsgRewritePlanExpectedRelfactsCoreMembers()):
        return false

    let firstGap = rewrite_plan.RustCsgRewritePlanFirstCoreRelfactsGap(units)
    if firstGap != "":
        echo(wire.RustCsgCat("core relfacts gap: ", firstGap))
        return false

    var reason: str
    if !rewrite_plan.RustCsgRewritePlanOneClickReady(units, reason):
        echo(wire.RustCsgCat("OneClickReady false: ", reason))
        return false
    return true

fn CheckCoreGapHardFails(): bool =
    var units = rewrite_plan.RustCsgRewritePlanUnits()
    var changed: bool
    for i in 0..<units.len:
        if !changed && module_map.RustCsgCargoMemberInTranslationCore(units[i].sourcePath):
            units[i].sourcePath = "__missing_core_relfacts_marker__"
            changed = true

    if !changed:
        echo("no translation core member found")
        return false

    let firstGap = rewrite_plan.RustCsgRewritePlanFirstCoreRelfactsGap(units)
    if firstGap == "":
        echo("core relfacts gap mutation did not register")
        return false

    var reason: str
    if rewrite_plan.RustCsgRewritePlanOneClickReady(units, reason):
        echo("OneClickReady accepted missing core relfacts")
        return false
    if !wire.RustCsgContains(reason, "first_gap="):
        echo(wire.RustCsgCat("OneClickReady missing core gap reason: ", reason))
        return false
    return true

fn main(): int32 =
    if !CheckRewritePlanAggregates():
        return 1
    if !CheckCoreGapHardFails():
        return 1
    echo("rust_csg_rewrite_plan_smoke ok")
    return 0
