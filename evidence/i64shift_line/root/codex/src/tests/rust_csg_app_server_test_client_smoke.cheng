import cheng/codex/crates/app_server_test_client/app_server_test_client as astc

# ═══════════════════════════════════════════════════════════════════════════════
# App Server Test Client — type definition constants smoke test
#
# Ported from codex-rs/app-server-test-client
# ═══════════════════════════════════════════════════════════════════════════════

fn testNotificationsToOptOutCount(): bool =
    if astc.RustCsgNotificationsToOptOutCount != 6: return false
    if astc.RustCsgNotificationsToOptOut1 != "command/exec/outputDelta": return false
    if astc.RustCsgNotificationsToOptOut6 != "item/reasoning/textDelta": return false
    echo("testNotificationsToOptOutCount ok")
    return true

fn testTimeoutConstants(): bool =
    var ok: bool = true
    if astc.RustCsgAppServerGracefulShutdownTimeoutSec != 5:
        echo("FAIL: timeoutSec")
        ok = false
    if astc.RustCsgAppServerGracefulShutdownPollIntervalMs != 100:
        echo("FAIL: pollIntervalMs")
        ok = false
    if astc.RustCsgOtelServiceName != "codex-app-server-test-client":
        echo("FAIL: otelServiceName")
        ok = false
    if astc.RustCsgTraceDisabledMessage != "Not enabled - enable tracing in $CODEX_HOME/config.toml to get a trace URL!":
        echo("FAIL: traceDisabledMessage")
        ok = false
    if ok:
        echo("testTimeoutConstants ok")
    return ok

fn testCliCommandVariantCount(): bool =
    if astc.RustCsgCliCommandVariantCount != 17: return false
    if astc.RustCsgCliCommandVariant1 != "Serve": return false
    if astc.RustCsgCliCommandVariant17 != "ThreadDecrementElicitation": return false
    echo("testCliCommandVariantCount ok")
    return true

fn testEndpointVariants(): bool =
    if astc.RustCsgEndpointVariantCount != 2: return false
    if astc.RustCsgEndpointVariant1 != "SpawnCodex": return false
    if astc.RustCsgEndpointVariant2 != "ConnectWs": return false
    echo("testEndpointVariants ok")
    return true

fn testClientTransportVariants(): bool =
    if astc.RustCsgClientTransportVariantCount != 2: return false
    if astc.RustCsgClientTransportVariant1 != "Stdio": return false
    if astc.RustCsgClientTransportVariant2 != "WebSocket": return false
    echo("testClientTransportVariants ok")
    return true

fn testCommandApprovalBehaviorVariants(): bool =
    if astc.RustCsgCommandApprovalBehaviorVariantCount != 2: return false
    if astc.RustCsgCommandApprovalBehaviorVariant1 != "AlwaysAccept": return false
    if astc.RustCsgCommandApprovalBehaviorVariant2 != "AbortOn": return false
    echo("testCommandApprovalBehaviorVariants ok")
    return true

fn testTraceSummaryVariants(): bool =
    if astc.RustCsgTraceSummaryVariantCount != 2: return false
    if astc.RustCsgTraceSummaryVariant1 != "Enabled": return false
    if astc.RustCsgTraceSummaryVariant2 != "Disabled": return false
    echo("testTraceSummaryVariants ok")
    return true

fn testDefaultWebsocketUrl(): bool =
    if astc.RustCsgDefaultWebsocketUrl != "ws://127.0.0.1:4222": return false
    echo("testDefaultWebsocketUrl ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testNotificationsToOptOutCount(): allOk = false
    if !testTimeoutConstants(): allOk = false
    if !testCliCommandVariantCount(): allOk = false
    if !testEndpointVariants(): allOk = false
    if !testClientTransportVariants(): allOk = false
    if !testCommandApprovalBehaviorVariants(): allOk = false
    if !testTraceSummaryVariants(): allOk = false
    if !testDefaultWebsocketUrl(): allOk = false

    if allOk:
        echo("rust_csg_app_server_test_client_smoke ok")
        return 0
    else:
        echo("rust_csg_app_server_test_client_smoke FAILED")
        return 1
