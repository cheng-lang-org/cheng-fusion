import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: file-system types (inlined due to compiler cross-module ABI issue)
# ═══════════════════════════════════════════════════════════════════════════════

# fileType constants: 0=file, 1=dir, 2=symlink
const FileTypeFile: int32 = 0
const FileTypeDir: int32 = 1
const FileTypeSymlink: int32 = 2

fn fileMetadataNew(fileType: int32, size: int64, modifiedAt: int64,
                   outFileType: var int32, outSize: var int64, outModifiedAt: var int64) =
    outFileType = fileType
    outSize = size
    outModifiedAt = modifiedAt

fn readDirectoryEntryNew(name: str, fileType: int32,
                         outName: var str, outFileType: var int32) =
    outName = name
    outFileType = fileType

fn fileMetadataIsDir(fileType: int32): bool =
    return fileType == FileTypeDir

fn fileMetadataIsFile(fileType: int32): bool =
    return fileType == FileTypeFile

fn fileMetadataIsSymlink(fileType: int32): bool =
    return fileType == FileTypeSymlink

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.Int64ToStr(int64(expected)), " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    return true

fn checkEqI64(got: int64, expected: int64): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.Int64ToStr(expected), " got=", strings.Int64ToStr(got)], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testFileMetadataConstructor(): bool =
    var ok: bool = true
    var ft: int32
    var sz: int64
    var mt: int64

    # File type
    fileMetadataNew(FileTypeFile, 1024, 1700000000000, ft, sz, mt)
    if !checkEqI32(ft, FileTypeFile): ok = false
    if !checkEqI64(sz, 1024): ok = false
    if !checkEqI64(mt, 1700000000000): ok = false

    # Directory type
    fileMetadataNew(FileTypeDir, 0, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeDir): ok = false
    if !checkEqI64(sz, 0): ok = false
    if !checkEqI64(mt, 0): ok = false

    # Symlink type
    fileMetadataNew(FileTypeSymlink, 42, 9988776655, ft, sz, mt)
    if !checkEqI32(ft, FileTypeSymlink): ok = false
    if !checkEqI64(sz, 42): ok = false
    if !checkEqI64(mt, 9988776655): ok = false

    if ok:
        echo("testFileMetadataConstructor ok")
    return ok

fn testReadDirectoryEntryConstructor(): bool =
    var ok: bool = true
    var outName: str
    var outType: int32

    readDirectoryEntryNew("main.rs", FileTypeFile, outName, outType)
    if !checkEq(outName, "main.rs"): ok = false
    if !checkEqI32(outType, FileTypeFile): ok = false

    readDirectoryEntryNew("src", FileTypeDir, outName, outType)
    if !checkEq(outName, "src"): ok = false
    if !checkEqI32(outType, FileTypeDir): ok = false

    readDirectoryEntryNew("link", FileTypeSymlink, outName, outType)
    if !checkEq(outName, "link"): ok = false
    if !checkEqI32(outType, FileTypeSymlink): ok = false

    if ok:
        echo("testReadDirectoryEntryConstructor ok")
    return ok

fn testFileMetadataTypeChecks(): bool =
    var ok: bool = true

    # isDir checks
    if !checkEqBool(fileMetadataIsDir(FileTypeDir), true): ok = false
    if !checkEqBool(fileMetadataIsDir(FileTypeFile), false): ok = false
    if !checkEqBool(fileMetadataIsDir(FileTypeSymlink), false): ok = false

    # isFile checks
    if !checkEqBool(fileMetadataIsFile(FileTypeFile), true): ok = false
    if !checkEqBool(fileMetadataIsFile(FileTypeDir), false): ok = false
    if !checkEqBool(fileMetadataIsFile(FileTypeSymlink), false): ok = false

    # isSymlink checks
    if !checkEqBool(fileMetadataIsSymlink(FileTypeSymlink), true): ok = false
    if !checkEqBool(fileMetadataIsSymlink(FileTypeFile), false): ok = false
    if !checkEqBool(fileMetadataIsSymlink(FileTypeDir), false): ok = false

    if ok:
        echo("testFileMetadataTypeChecks ok")
    return ok

fn testDefaultMetadata(): bool =
    var ok: bool = true
    var ft: int32
    var sz: int64
    var mt: int64

    # Test zero-value metadata (default-like)
    fileMetadataNew(0, 0, 0, ft, sz, mt)
    if !checkEqI32(ft, 0): ok = false
    if !checkEqI64(sz, 0): ok = false
    if !checkEqI64(mt, 0): ok = false

    # Default file type is FileTypeFile (0)
    if !checkEqBool(fileMetadataIsFile(ft), true): ok = false
    if !checkEqBool(fileMetadataIsDir(ft), false): ok = false
    if !checkEqBool(fileMetadataIsSymlink(ft), false): ok = false

    if ok:
        echo("testDefaultMetadata ok")
    return ok

fn testMetadataBoundarySizes(): bool =
    var ok: bool = true
    var ft: int32
    var sz: int64
    var mt: int64

    # int64 max value
    fileMetadataNew(FileTypeFile, 9223372036854775807, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeFile): ok = false
    if !checkEqI64(sz, 9223372036854775807): ok = false

    # int64 min value (negative)
    fileMetadataNew(FileTypeFile, -9223372036854775808, 0, ft, sz, mt)
    if !checkEqI64(sz, -9223372036854775808): ok = false

    # Negative size with dir type
    fileMetadataNew(FileTypeDir, -1, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeDir): ok = false
    if !checkEqI64(sz, -1): ok = false

    if ok:
        echo("testMetadataBoundarySizes ok")
    return ok

fn testMetadataTimestampVariants(): bool =
    var ok: bool = true
    var ft: int32
    var sz: int64
    var mt: int64

    # Unix epoch
    fileMetadataNew(FileTypeSymlink, 0, 0, ft, sz, mt)
    if !checkEqI64(mt, 0): ok = false

    # Far future timestamp
    fileMetadataNew(FileTypeFile, 0, 9999999999999, ft, sz, mt)
    if !checkEqI64(mt, 9999999999999): ok = false

    # Negative timestamp (pre-epoch)
    fileMetadataNew(FileTypeDir, 0, -2208988800, ft, sz, mt)
    if !checkEqI64(mt, -2208988800): ok = false

    if ok:
        echo("testMetadataTimestampVariants ok")
    return ok

fn testMetadataTypeAndSizeCombinations(): bool =
    var ok: bool = true
    var ft: int32
    var sz: int64
    var mt: int64

    # File type = file, size = 1
    fileMetadataNew(FileTypeFile, 1, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeFile): ok = false
    if !checkEqI64(sz, 1): ok = false
    if !checkEqI64(mt, 0): ok = false

    # File type = file, size = 65536
    fileMetadataNew(FileTypeFile, 65536, 0, ft, sz, mt)
    if !checkEqI64(sz, 65536): ok = false

    # File type = dir, size = 65536
    fileMetadataNew(FileTypeDir, 65536, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeDir): ok = false
    if !checkEqI64(sz, 65536): ok = false

    # File type = symlink, size = 1073741824
    fileMetadataNew(FileTypeSymlink, 1073741824, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeSymlink): ok = false
    if !checkEqI64(sz, 1073741824): ok = false

    # File type = symlink, size = 0
    fileMetadataNew(FileTypeSymlink, 0, 0, ft, sz, mt)
    if !checkEqI32(ft, FileTypeSymlink): ok = false
    if !checkEqI64(sz, 0): ok = false

    if ok:
        echo("testMetadataTypeAndSizeCombinations ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testFileMetadataConstructor(): allOk = false
    if !testReadDirectoryEntryConstructor(): allOk = false
    if !testFileMetadataTypeChecks(): allOk = false
    if !testDefaultMetadata(): allOk = false
    if !testMetadataBoundarySizes(): allOk = false
    if !testMetadataTimestampVariants(): allOk = false
    if !testMetadataTypeAndSizeCombinations(): allOk = false
    if allOk:
        echo("rust_csg_file_system_smoke ok")
        return 0
    else:
        echo("rust_csg_file_system_smoke FAILED")
        return 1
