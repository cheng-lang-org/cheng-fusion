@exportc("RustCsgPathJoin")
fn RustCsgPathJoinExport(root: str, raw: str): str =
    return PathJoin(root, raw)

@abi_internal
@exportc("RustCsgPathExists")
fn RustCsgPathExistsExport(path: str): int32 =
    return PathFileExists(path)

@abi_internal
@exportc("RustCsgPathAbsolute")
fn RustCsgPathAbsoluteExport(root: str, raw: str): str =
    return PathAbsolute(root, raw)

@abi_internal
@exportc("RustCsgPathParentDir")
fn RustCsgPathParentDirExport(path: str): str =
    return PathParentDir(path)

@abi_internal
@exportc("RustCsgPathIsAbsolute")
fn RustCsgPathIsAbsoluteExport(path: str): int32 =
    return PathIsAbsolute(path)

@abi_internal
@exportc("RustCsgGetCurrentDir")
fn RustCsgGetCurrentDirExport(): str =
    return PathCurrentDir()

@abi_internal
@exportc("RustCsgPathBasename")
fn RustCsgPathBasenameExport(path: str): str =
    var i: int32
    i = path.len - 1
    while i >= 0:
        if path[i] == '/':
            return sliceBytes(path, i + 1, path.len - i - 1)
        i = i - 1
    return path

@abi_internal
@exportc("RustCsgPathDirname")
fn RustCsgPathDirnameExport(path: str): str =
    var i: int32
    i = path.len - 1
    while i >= 0:
        if path[i] == '/':
            if i == 0: return "/"
            return sliceBytes(path, 0, i)
        i = i - 1
    return "."

@abi_internal
@exportc("RustCsgPathExtension")
fn RustCsgPathExtensionExport(path: str): str =
    var base = RustCsgPathBasenameExport(path)
    var i: int32
    i = base.len - 1
    while i >= 0:
        if base[i] == '.':
            return sliceBytes(base, i, base.len - i)
        i = i - 1
    return ""

@abi_internal
@exportc("RustCsgMimeFromPath")
fn RustCsgMimeFromPathExport(path: str): str =
    var ext = RustCsgPathExtensionExport(path)
    if ext == ".html" || ext == ".htm": return "text/html"
    if ext == ".json": return "application/json"
    if ext == ".js": return "application/javascript"
    if ext == ".css": return "text/css"
    if ext == ".png": return "image/png"
    if ext == ".jpg" || ext == ".jpeg": return "image/jpeg"
    if ext == ".svg": return "image/svg+xml"
    if ext == ".pdf": return "application/pdf"
    return "application/octet-stream"
