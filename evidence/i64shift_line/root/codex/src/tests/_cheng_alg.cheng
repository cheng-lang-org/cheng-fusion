# Pure Cheng provider - 33 string/math/bitwise functions.
@abi_internal
@exportc("RustCsgContains")
@abi_internal
fn RustCsgContainsExport(text: str, needle: str): int32 =
    if needle.len == 0: return 1
    if needle.len > text.len: return 0
    var i: int32
    while i <= text.len - needle.len:
        var j: int32
        var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]:
                ok = 0
                break
            j = j + 1
        if ok:
            return 1
        i = i + 1
    return 0

@abi_internal
@exportc("RustCsgEndsWith")
fn RustCsgEndsWithExport(text: str, suffix: str): int32 =
    if suffix.len == 0: return 1
    if suffix.len > text.len: return 0
    let off = text.len - suffix.len
    var i: int32
    while i < suffix.len:
        if text[off + i] != suffix[i]: return 0
        i = i + 1
    return 1

@abi_internal
@exportc("StartsWith")
fn StartsWithExport(text: str, prefix: str): int32 =
    if prefix.len == 0: return 1
    if prefix.len > text.len: return 0
    var i: int32
    while i < prefix.len:
        if text[i] != prefix[i]: return 0
        i = i + 1
    return 1

@abi_internal
@exportc("RustCsgStrStartsWith")
fn RustCsgStrStartsWithExport(text: str, prefix: str): int32 =
    return StartsWithExport(text, prefix)

@abi_internal
@exportc("RustCsgStrLen")
fn RustCsgStrLenExport(s: str): int32 =
    return s.len

@abi_internal
@exportc("RustCsgStrLenI64")
fn RustCsgStrLenI64Export(s: str): int32 =
    return s.len

@abi_internal
@exportc("RustCsgStrIsEmpty")
fn RustCsgStrIsEmptyExport(s: str): int32 =
    if s.len == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrNotEmpty")
fn RustCsgStrNotEmptyExport(s: str): int32 =
    if s.len > 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenGt")
fn RustCsgStrLenGtExport(s: str, n: int32): int32 =
    if s.len > n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenLt")
fn RustCsgStrLenLtExport(s: str, n: int32): int32 =
    if s.len < n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrLenEq")
fn RustCsgStrLenEqExport(s: str, n: int32): int32 =
    if s.len == n:
        return 1
    return 0

@abi_internal
@exportc("RustCsgStrFirstByte")
fn RustCsgStrFirstByteExport(s: str): int32 =
    if s.len == 0:
        return -1
    return int32(s[0])

@abi_internal
@exportc("RustCsgStrLastByte")
fn RustCsgStrLastByteExport(s: str): int32 =
    if s.len == 0:
        return -1
    return int32(s[s.len - 1])

@abi_internal
@exportc("RustCsgStrByteAt")
fn RustCsgStrByteAtExport(s: str, pos: int32): int32 =
    if pos < 0:
        return -1
    if pos >= s.len:
        return -1
    return int32(s[pos])

@abi_internal
@exportc("RustCsgStrIsAscii")
fn RustCsgStrIsAsciiExport(s: str): int32 =
    var i: int32
    while i < s.len:
        if int32(s[i]) > 127:
            return 0
        i = i + 1
    return 1

@abi_internal
@exportc("RustCsgMemCmp")
fn RustCsgMemCmpExport(a: str, b: str): int32 =
    if a.len != b.len:
        return 0
    var i: int32
    while i < a.len:
        if a[i] != b[i]:
            return 0
        i = i + 1
    return 1

@abi_internal
@exportc("RustCsgStrCount")
fn RustCsgStrCountExport(text: str, needle: str): int32 =
    if needle.len == 0:
        return 0
    if needle.len > text.len:
        return 0
    var count: int32
    var i: int32
    while i <= text.len - needle.len:
        var j: int32
        var ok: int32 = 1
        while j < needle.len:
            if text[i + j] != needle[j]:
                ok = 0
                break
            j = j + 1
        if ok:
            count = count + 1
            i = i + needle.len
            continue
        i = i + 1
    return count

@abi_internal
@exportc("RustCsgMinI32")
fn RustCsgMinI32Export(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b

@abi_internal
@exportc("RustCsgMaxI32")
fn RustCsgMaxI32Export(a: int32, b: int32): int32 =
    if a > b:
        return a
    return b

@abi_internal
@exportc("RustCsgAbsI32")
fn RustCsgAbsI32Export(a: int32): int32 =
    if a < 0:
        return -a
    return a

@abi_internal
@exportc("RustCsgClampI32")
fn RustCsgClampI32Export(v: int32, lo: int32, hi: int32): int32 =
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

@abi_internal
@exportc("RustCsgPopCount")
fn RustCsgPopCountExport(a: int32): int32 =
    var count: int32
    var v: int32 = a
    while v != 0:
        count = count + (v & 1)
        v = v >> 1
    return count

@abi_internal
@exportc("RustCsgIsPowerOfTwo")
fn RustCsgIsPowerOfTwoExport(v: int32): int32 =
    if v <= 0:
        return 0
    if (v & (v - 1)) == 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgHashStrSimple")
fn RustCsgHashStrSimpleExport(s: str): int32 =
    var h: int32 = 5381
    var i: int32
    while i < s.len:
        h = ((h << 5) + h) + int32(s[i])
        i = i + 1
    return h

@abi_internal
@exportc("RustCsgHashCombine")
fn RustCsgHashCombineExport(h: int32, v: int32): int32 =
    return h * 31 + v

@abi_internal
@exportc("RustCsgBitSet")
fn RustCsgBitSetExport(v: int32, b: int32): int32 =
    return v | (1 << b)

@abi_internal
@exportc("RustCsgBitClear")
fn RustCsgBitClearExport(v: int32, b: int32): int32 =
    return v & (-1 ^ (1 << b))

@abi_internal
@exportc("RustCsgBitTest")
fn RustCsgBitTestExport(v: int32, b: int32): int32 =
    if (v & (1 << b)) != 0:
        return 1
    return 0

@abi_internal
@exportc("RustCsgBitToggle")
fn RustCsgBitToggleExport(v: int32, b: int32): int32 =
    return v ^ (1 << b)

@abi_internal
@exportc("RustCsgNextPowerOfTwo")
fn RustCsgNextPowerOfTwoExport(v: int32): int32 =
    if v <= 0:
        return 1
    v = v - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    return v + 1

@abi_internal
@exportc("RustCsgHash3I32")
fn RustCsgHash3I32Export(a: int32, b: int32, c: int32): int32 =
    return (a * 31 + b) * 31 + c

@abi_internal
@exportc("RustCsgHash4I32")
fn RustCsgHash4I32Export(a: int32, b: int32, c: int32, d: int32): int32 =
    return ((a * 31 + b) * 31 + c) * 31 + d

@abi_internal
@exportc("RustCsgHashStrLen")
fn RustCsgHashStrLenExport(s: str): int32 =
    return s.len

// [Provider] ReadFile -> pure Cheng Darwin provider (Cheng @exportc + data/export OOM interaction)

@abi_internal
@exportc("RustCsgWriteFile")
fn RustCsgWriteFileExport(path: str, content: str): int32 =
    return WriteTextFile(path, content)

@abi_internal
@exportc("RustCsgFileAppend")
fn RustCsgFileAppendExport(path: str, content: str): int32 =
    var existing: str
    existing = ReadTextFile(path)
    var combined = concatStr(existing, content)
    return WriteTextFile(path, combined)

@abi_internal
@exportc("RustCsgBase64Encode")
fn RustCsgBase64EncodeExport(data: str): str =
    if data.len == 0: return ""
    var out: str
    var i: int32
    var tbl: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    while i < data.len:
        var b0: int32 = int32(data[i])
        i = i + 1
        var b1: int32 = 0
        if i < data.len:
            b1 = int32(data[i])
            i = i + 1
        var b2: int32 = 0
        if i < data.len:
            b2 = int32(data[i])
            i = i + 1
        var triple = (b0 << 16) | (b1 << 8) | b2
        out = concatStr(out, sliceBytes(tbl, (triple >> 18) & 63, 1))
        out = concatStr(out, sliceBytes(tbl, (triple >> 12) & 63, 1))
        out = concatStr(out, sliceBytes(tbl, (triple >> 6) & 63, 1))
        out = concatStr(out, sliceBytes(tbl, triple & 63, 1))
    return out

@abi_internal
@exportc("RustCsgUuidV4")
fn RustCsgUuidV4Export(): str =
    var hex: str = "0123456789abcdef"
    var seed: int64 = 123456789
    var out: str
    var i: int32
    while i < 36:
        if i == 8 || i == 13 || i == 18 || i == 23:
            out = concatStr(out, "-")
        elif i == 14:
            out = concatStr(out, "4")
        elif i == 19:
            seed = (seed * int64(1103515245) + int64(12345)) & int64(0x7FFFFFFF)
            out = concatStr(out, sliceBytes(hex, int32((seed & 3) | 8), 1))
        else:
            seed = (seed * int64(1103515245) + int64(12345)) & int64(0x7FFFFFFF)
            out = concatStr(out, sliceBytes(hex, int32(seed & 15), 1))
        i = i + 1
    return out

@abi_internal
@exportc("RustCsgHexEncode")
fn RustCsgHexEncodeExport(data: str): str =
    var hex: str = "0123456789abcdef"
    var out: str
    var i: int32
    while i < data.len:
        var b: int32 = int32(data[i])
        out = concatStr(out, sliceBytes(hex, (b >> 4) & 15, 1))
        out = concatStr(out, sliceBytes(hex, b & 15, 1))
        i = i + 1
    return out

