import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: fuzzy-match (inlined due to compiler cross-module ABI issue)
# ═══════════════════════════════════════════════════════════════════════════════

const FzMaxInt32: int32 = 2147483647

fn fuzzyMatch(haystack: str, needle: str, outIndices: var int32[], outScore: var int32, outOk: var bool) =
    outOk = false
    outScore = 0
    if needle.len == 0:
        outOk = true
        outScore = FzMaxInt32
        return
    # Lowercase haystack (byte by byte; ASCII A-Z add 32 to get a-z)
    var loweredChars: int32[]
    var loweredToOrig: int32[]
    var i: int32 = 0
    while i < haystack.len:
        let b = Int32(haystack[i])
        if b >= 65 && b <= 90:
            add(loweredChars, b + 32)
        else:
            add(loweredChars, b)
        add(loweredToOrig, i)
        i = i + 1
    # Lowercase needle
    var loweredNeedle: int32[]
    var j: int32 = 0
    while j < needle.len:
        let b = Int32(needle[j])
        if b >= 65 && b <= 90:
            add(loweredNeedle, b + 32)
        else:
            add(loweredNeedle, b)
        j = j + 1
    # Greedy left-to-right subsequence matching
    var resultOrig: int32[]
    var cur: int32 = 0
    var lastLowerPos: int32 = 0
    var hasLast: bool = false
    var ni: int32 = 0
    while ni < loweredNeedle.len:
        let nc = loweredNeedle[ni]
        var found: bool = false
        while cur < loweredChars.len:
            if loweredChars[cur] == nc:
                found = true
                add(resultOrig, loweredToOrig[cur])
                lastLowerPos = cur
                hasLast = true
                cur = cur + 1
                break
            cur = cur + 1
        if !found:
            return
        ni = ni + 1
    # Score: (lastLowerPos - firstLowerPos + 1) - needleLen, clamped >= 0
    var firstLowerPos: int32 = 0
    if resultOrig.len > 0:
        let targetOrig = resultOrig[0]
        var fi: int32 = 0
        while fi < loweredToOrig.len:
            if loweredToOrig[fi] == targetOrig:
                firstLowerPos = fi
                break
            fi = fi + 1
    if hasLast:
        let window = (lastLowerPos - firstLowerPos + 1) - loweredNeedle.len
        if window > 0:
            outScore = window
        else:
            outScore = 0
    # Sort and dedup resultOrig
    if resultOrig.len > 0:
        var sorted: int32[]
        var si: int32 = 0
        while si < resultOrig.len:
            add(sorted, resultOrig[si])
            si = si + 1
        # Bubble sort (small arrays, no built-in sort in Cheng)
        var n: int32 = sorted.len
        var swapped: bool = true
        while swapped:
            swapped = false
            var i2: int32 = 1
            while i2 < n:
                if sorted[i2 - 1] > sorted[i2]:
                    let tmp = sorted[i2 - 1]
                    sorted[i2 - 1] = sorted[i2]
                    sorted[i2] = tmp
                    swapped = true
                i2 = i2 + 1
            n = n - 1
        # Dedup
        var prev: int32 = -1
        var di: int32 = 0
        while di < sorted.len:
            if di == 0 || sorted[di] != prev:
                add(outIndices, sorted[di])
                prev = sorted[di]
            di = di + 1
    outOk = true

# ── fuzzyMatchMulti ─────────────────────────────────────────────────────────
fn fuzzyMatchMulti(haystack: str, needles: str[], outBestNeedle: var str, outBestScore: var int32, outOk: var bool) =
    outBestNeedle = ""
    outBestScore = 999999
    outOk = false
    var bestScore: int32 = 999999
    var foundAny: bool = false
    var bi: int32 = 0
    while bi < needles.len:
        var indices: int32[]
        var score: int32
        var ok: bool
        fuzzyMatch(haystack, needles[bi], indices, score, ok)
        if ok:
            if !foundAny || score < bestScore:
                bestScore = score
                outBestNeedle = needles[bi]
                outBestScore = score
                foundAny = true
        bi = bi + 1
    outOk = foundAny

# ── fuzzyMatchHighlight ─────────────────────────────────────────────────────
fn fuzzyMatchHighlight(haystack: str, needle: str, outMarked: var str, outOk: var bool) =
    outMarked = ""
    outOk = false
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch(haystack, needle, indices, score, ok)
    if !ok || indices.len == 0:
        outMarked = haystack
        outOk = false
        return
    var result: str = ""
    var mi: int32 = 0
    var hi: int32 = 0
    var inMarker: bool = false
    while hi < haystack.len:
        if mi < indices.len && hi == indices[mi]:
            if !inMarker:
                result = strutil.Join([result, "**"], "")
                inMarker = true
            result = strutil.Join([result, strings.SliceBytes(haystack, hi, 1)], "")
            mi = mi + 1
        else:
            if inMarker:
                result = strutil.Join([result, "**"], "")
                inMarker = false
            result = strutil.Join([result, strings.SliceBytes(haystack, hi, 1)], "")
        hi = hi + 1
    if inMarker:
        result = strutil.Join([result, "**"], "")
    outMarked = result
    outOk = true

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.Int64ToStr(int64(expected)), " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Test cases
# ═══════════════════════════════════════════════════════════════════════════════

fn testEmptyNeedle(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("hello", "", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(score, FzMaxInt32):
        return false
    if indices.len != 0:
        echo(strutil.Join(["FAIL: expected empty indices, got len=", strings.Int64ToStr(int64(indices.len))], ""))
        return false
    echo("testEmptyNeedle ok")
    return true

fn testExactMatch(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("hello", "hello", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 5):
        return false
    if !checkEqI32(indices[0], 0):
        return false
    if !checkEqI32(indices[1], 1):
        return false
    if !checkEqI32(indices[2], 2):
        return false
    if !checkEqI32(indices[3], 3):
        return false
    if !checkEqI32(indices[4], 4):
        return false
    if !checkEqI32(score, 0):
        return false
    echo("testExactMatch ok")
    return true

fn testCaseInsensitive(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("Hello", "hello", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 5):
        return false
    if !checkEqI32(indices[0], 0):
        return false
    if !checkEqI32(indices[1], 1):
        return false
    if !checkEqI32(indices[2], 2):
        return false
    if !checkEqI32(indices[3], 3):
        return false
    if !checkEqI32(indices[4], 4):
        return false
    if !checkEqI32(score, 0):
        return false
    echo("testCaseInsensitive ok")
    return true

fn testSubsequenceMatch(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("hello world", "hlo", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 3):
        return false
    if !checkEqI32(indices[0], 0):
        return false
    if !checkEqI32(indices[1], 2):
        return false
    if !checkEqI32(indices[2], 4):
        return false
    echo("testSubsequenceMatch ok")
    return true

fn testNoMatch(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("abc", "xyz", indices, score, ok)
    if !checkEqBool(ok, false):
        return false
    echo("testNoMatch ok")
    return true

fn testEmptyHaystack(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("", "hello", indices, score, ok)
    if !checkEqBool(ok, false):
        return false
    echo("testEmptyHaystack ok")
    return true

fn testSingleCharNeedle(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("hello world", "e", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 1):
        return false
    if !checkEqI32(indices[0], 1):
        return false
    echo("testSingleCharNeedle ok")
    return true

fn testRepeatedChars(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("aaa", "aa", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 2):
        return false
    if !checkEqI32(indices[0], 0):
        return false
    if !checkEqI32(indices[1], 1):
        return false
    echo("testRepeatedChars ok")
    return true

fn testNeedleLonger(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("abc", "abcd", indices, score, ok)
    if !checkEqBool(ok, false):
        return false
    echo("testNeedleLonger ok")
    return true

fn testCaseMismatchHaystackLower(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("hello", "HELLO", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 5):
        return false
    echo("testCaseMismatchHaystackLower ok")
    return true

fn testPartialEndMatch(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("abcdef", "def", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 3):
        return false
    if !checkEqI32(indices[0], 3):
        return false
    if !checkEqI32(indices[1], 4):
        return false
    if !checkEqI32(indices[2], 5):
        return false
    echo("testPartialEndMatch ok")
    return true

fn testScoreWide(): bool =
    var indices: int32[]
    var score: int32
    var ok: bool
    fuzzyMatch("aXXXc", "ac", indices, score, ok)
    if !checkEqBool(ok, true):
        return false
    if !checkEqI32(indices.len, 2):
        return false
    if !checkEqI32(indices[0], 0):
        return false
    if !checkEqI32(indices[1], 4):
        return false
    if !checkEqI32(score, 3):
        return false
    echo("testScoreWide ok")
    return true

fn testFuzzyMatchMultiFound(): bool =
    var best: str
    var bestScore: int32
    var ok: bool
    var needles: str[]
    add(needles, "abc")
    add(needles, "xyz")
    add(needles, "ace")
    fuzzyMatchMulti("abcdef", needles, best, bestScore, ok)
    if !checkEqBool(ok, true): return false
    if best != "abc" && best != "ace":
        echo("FAIL: expected abc or ace, got=")
        echo(best)
        return false
    echo("testFuzzyMatchMultiFound ok")
    return true

fn testFuzzyMatchMultiNone(): bool =
    var best: str
    var bestScore: int32
    var ok: bool
    var needles: str[]
    add(needles, "xyz")
    add(needles, "123")
    fuzzyMatchMulti("abcdef", needles, best, bestScore, ok)
    if !checkEqBool(ok, false): return false
    echo("testFuzzyMatchMultiNone ok")
    return true

fn testFuzzyMatchHighlightExact(): bool =
    var marked: str
    var ok: bool
    fuzzyMatchHighlight("hello", "hello", marked, ok)
    if !checkEqBool(ok, true): return false
    # Consecutive matched chars are grouped in one ** pair
    if marked != "**hello**":
        echo("FAIL: unexpected highlight, got=")
        echo(marked)
        return false
    echo("testFuzzyMatchHighlightExact ok")
    return true

fn testFuzzyMatchHighlightSubseq(): bool =
    var marked: str
    var ok: bool
    fuzzyMatchHighlight("hello_world", "hwd", marked, ok)
    if !checkEqBool(ok, true): return false
    if !strings.HasPrefix(marked, "**h**"):
        echo("FAIL: expected h highlighted at start, got=")
        echo(marked)
        return false
    echo("testFuzzyMatchHighlightSubseq ok")
    return true

fn testFuzzyMatchHighlightNoMatch(): bool =
    var marked: str
    var ok: bool
    fuzzyMatchHighlight("hello", "xyz", marked, ok)
    if !checkEqBool(ok, false): return false
    if marked != "hello":
        echo("FAIL: expected original string, got=")
        echo(marked)
        return false
    echo("testFuzzyMatchHighlightNoMatch ok")
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testEmptyNeedle(): allOk = false
    if !testExactMatch(): allOk = false
    if !testCaseInsensitive(): allOk = false
    if !testSubsequenceMatch(): allOk = false
    if !testNoMatch(): allOk = false
    if !testEmptyHaystack(): allOk = false
    if !testSingleCharNeedle(): allOk = false
    if !testRepeatedChars(): allOk = false
    if !testNeedleLonger(): allOk = false
    if !testCaseMismatchHaystackLower(): allOk = false
    if !testPartialEndMatch(): allOk = false
    if !testScoreWide(): allOk = false
    if !testFuzzyMatchMultiFound(): allOk = false
    if !testFuzzyMatchMultiNone(): allOk = false
    if !testFuzzyMatchHighlightExact(): allOk = false
    if !testFuzzyMatchHighlightSubseq(): allOk = false
    if !testFuzzyMatchHighlightNoMatch(): allOk = false
    if allOk:
        echo("rust_csg_fuzzy_match_smoke ok")
        return 0
    else:
        echo("rust_csg_fuzzy_match_smoke FAILED")
        return 1
