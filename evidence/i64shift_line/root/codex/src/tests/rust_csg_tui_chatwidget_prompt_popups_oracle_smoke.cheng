import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_prompt_popups_oracle as oracle

fn RustCsgTuiChatwidgetPromptPopupsCheck(path: str,
                                          expectedSource: str,
                                          expectedExpression: str,
                                          expectedBody: str,
                                          name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_chatwidget_prompt_popups_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetPromptPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPlanImplementationPopup(), "plan_implementation_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPromptPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetPlanImplementationPopupNoSelected(), "plan_implementation_popup_no_selected")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPromptPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetFeedbackSelectionPopup(), "feedback_selection_popup")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetPromptPopupsCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "popup", oracle.RustCsgTuiChatwidgetFeedbackUploadConsentPopup(), "feedback_upload_consent_popup")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_prompt_popups_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_prompt_popups_oracle_smoke FAILED")
    return exitCode
