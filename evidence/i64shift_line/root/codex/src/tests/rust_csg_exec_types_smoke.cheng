# ── hooks: Hook event key label constants ───────────────────────────────
# File: hooks/src/lib.rs fn hook_event_key_label()
#   PreToolUse -> "pre_tool_use", etc.
fn RustCsgHooksEventKeyLabel(v: int32): str =
    if v == RustCsgHooksHookEventNamePreToolUse:
        return "pre_tool_use"
    elif v == RustCsgHooksHookEventNamePermissionRequest:
        return "permission_request"
    elif v == RustCsgHooksHookEventNamePostToolUse:
        return "post_tool_use"
    elif v == RustCsgHooksHookEventNamePreCompact:
        return "pre_compact"
    elif v == RustCsgHooksHookEventNamePostCompact:
        return "post_compact"
    elif v == RustCsgHooksHookEventNameSessionStart:
        return "session_start"
    elif v == RustCsgHooksHookEventNameUserPromptSubmit:
        return "user_prompt_submit"
    elif v == RustCsgHooksHookEventNameStop:
        return "stop"
    return ""

