import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Exec (execpolicy / execpolicy-legacy / hooks) Type Definitions
#
# Type constants extracted from codex-rs/execpolicy/src/, execpolicy-legacy/src/,
# codex-rs/hooks/src/ and codex-rs/protocol/src/protocol.rs.
# Enums -> int32 constants. Struct field names documented as comments.
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected i32=", strings.Int64ToStr(int64(expected)),
                          " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    return true

# ── execpolicy: Decision ─────────────────────────────────────────────────
# File: execpolicy/src/decision.rs
# pub enum Decision { Allow, Prompt, Forbidden }
const RustCsgExecpolicyDecisionAllow: int32 = 0
const RustCsgExecpolicyDecisionPrompt: int32 = 1
const RustCsgExecpolicyDecisionForbidden: int32 = 2

fn ExecpolicyDecisionName(v: int32): str =
    if v == RustCsgExecpolicyDecisionAllow:
        return "allow"
    elif v == RustCsgExecpolicyDecisionPrompt:
        return "prompt"
    elif v == RustCsgExecpolicyDecisionForbidden:
        return "forbidden"
    return "unknown"

