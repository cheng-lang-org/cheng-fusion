# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testExecpolicyDecisionConstants(): allOk = false
    if !testExecpolicyNetworkRuleProtocolConstants(): allOk = false
    if !testExecpolicyPatternTokenConstants(): allOk = false
    if !testExecpolicyRuleMatchConstants(): allOk = false
    if !testExecpolicyLegacyArgMatcherConstants(): allOk = false
    if !testExecpolicyLegacyArgMatcherCardinalityConstants(): allOk = false
    if !testExecpolicyLegacyMatchedExecConstants(): allOk = false
    if !testExecpolicyLegacyForbiddenConstants(): allOk = false
    if !testHooksHookEventNameConstants(): allOk = false
    if !testHooksWireStringConstants(): allOk = false
    if !testHooksEventNamesWithMatchersCount(): allOk = false
    if !testHooksEventKeyLabels(): allOk = false
    if !testDecisionWireNames(): allOk = false
    if !testNetworkRuleProtocolWireNames(): allOk = false
    if !testHooksEventNameWireLookup(): allOk = false
    if !testArgMatcherNames(): allOk = false
    if allOk:
        echo("rust_csg_exec_types_smoke ok")
        return 0
    else:
        echo("rust_csg_exec_types_smoke FAILED")
        return 1
