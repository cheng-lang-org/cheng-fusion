fn testExecpolicyDecisionConstants(): bool =
    var ok: bool = true
    if !checkEqI32(RustCsgExecpolicyDecisionAllow, 0): ok = false
    if !checkEqI32(RustCsgExecpolicyDecisionPrompt, 1): ok = false
    if !checkEqI32(RustCsgExecpolicyDecisionForbidden, 2): ok = false
    if ok:
        echo("testExecpolicyDecisionConstants ok")
    return ok

