import cheng/codex/crates/stdio_to_uds/stdio_to_uds as m
fn main(): int32 =
    var pass: int32
    if m.StdioToUdsBuildSocketPath("/home/user/.codex") == "/home/user/.codex/cheng.sock": pass = pass + 1
    if m.StdioToUdsBuildSocketPath("/home/user/.codex/") == "/home/user/.codex/cheng.sock": pass = pass + 1
    if m.StdioToUdsBuildSocketPath("") == "cheng.sock": pass = pass + 1
    if m.StdioToUdsBuildSocketPath("/") == "/cheng.sock": pass = pass + 1
    if pass == 4: echo("rust_csg_oracle_stdio_to_uds ok"); return 0
    echo("oracle FAIL"); return 1
main()
