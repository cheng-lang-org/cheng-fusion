import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Self-contained smoke test for Module 9: exec/prompt
#
# Tests pure-logic functions from exec/prompt.cheng: whitespace detection,
# trimmed-empty check, trailing-newline check, and stdin context wrapping.
# Skips functions that need actual stdin/std::os.
#
# Verified functions:
#   RustCsgPromptIsSpace
#   RustCsgPromptTrimmedEmpty
#   RustCsgPromptEndsWithNewline
#   RustCsgPromptWithStdinContext
#
# Also verifies oracle function count equivalence.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Inlined pure functions from exec/prompt.cheng ────────────────────────

fn RustCsgPromptIsSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn RustCsgPromptTrimmedEmpty(text: str): bool =
    for i in 0..<text.len:
        if !RustCsgPromptIsSpace(text[i]):
            return false
    return true

fn RustCsgPromptEndsWithNewline(text: str): bool =
    if text.len == 0:
        return false
    return text[text.len - 1] == '\n'

fn RustCsgPromptWithStdinContext(prompt: str, stdinText: str): str =
    var out = strutil.Join([prompt, "\n\n<stdin>\n", stdinText], "")
    if !RustCsgPromptEndsWithNewline(stdinText):
        out = strutil.Join([out, "\n"], "")
    return strutil.Join([out, "</stdin>"], "")

# ═══════════════════════════════════════════════════════════════════════════════
# Oracle-count helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkBool(got: bool, expected: bool, name: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

fn checkEq(got: str, expected: str, name: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", expected], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", got], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Behavioral tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testIsSpace(): bool =
    var ok: bool = true
    # Whitespace chars
    if !checkBool(RustCsgPromptIsSpace(' '), true, "isSpace_space"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('\t'), true, "isSpace_tab"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('\n'), true, "isSpace_newline"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('\r'), true, "isSpace_cr"):
        ok = false
    # Non-whitespace chars
    if !checkBool(RustCsgPromptIsSpace('a'), false, "isSpace_letter"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('Z'), false, "isSpace_upper"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('0'), false, "isSpace_digit"):
        ok = false
    if !checkBool(RustCsgPromptIsSpace('.'), false, "isSpace_punct"):
        ok = false
    if ok:
        echo("testIsSpace ok")
    return ok

fn testTrimmedEmpty(): bool =
    var ok: bool = true
    # Empty / whitespace-only
    if !checkBool(RustCsgPromptTrimmedEmpty(""), true, "trimmedEmpty_empty"):
        ok = false
    if !checkBool(RustCsgPromptTrimmedEmpty("   "), true, "trimmedEmpty_spaces"):
        ok = false
    if !checkBool(RustCsgPromptTrimmedEmpty("\t\n\r "), true, "trimmedEmpty_mixed"):
        ok = false
    # Non-empty
    if !checkBool(RustCsgPromptTrimmedEmpty("a"), false, "trimmedEmpty_letter"):
        ok = false
    if !checkBool(RustCsgPromptTrimmedEmpty("  hello  "), false, "trimmedEmpty_surrounded"):
        ok = false
    if !checkBool(RustCsgPromptTrimmedEmpty("x\n"), false, "trimmedEmpty_textWithNewline"):
        ok = false
    if ok:
        echo("testTrimmedEmpty ok")
    return ok

fn testEndsWithNewline(): bool =
    var ok: bool = true
    # No newline
    if !checkBool(RustCsgPromptEndsWithNewline(""), false, "endsNewline_empty"):
        ok = false
    if !checkBool(RustCsgPromptEndsWithNewline("a"), false, "endsNewline_noNewline"):
        ok = false
    if !checkBool(RustCsgPromptEndsWithNewline("hello"), false, "endsNewline_word"):
        ok = false
    # Has trailing newline
    if !checkBool(RustCsgPromptEndsWithNewline("\n"), true, "endsNewline_onlyNewline"):
        ok = false
    if !checkBool(RustCsgPromptEndsWithNewline("a\n"), true, "endsNewline_textWithNewline"):
        ok = false
    if !checkBool(RustCsgPromptEndsWithNewline("hello\n\n"), true, "endsNewline_doubleNewline"):
        ok = false
    if ok:
        echo("testEndsWithNewline ok")
    return ok

fn testWithStdinContext(): bool =
    var ok: bool = true

    # Case 1: stdinText does NOT end with newline — extra \n added before </stdin>
    var r1 = RustCsgPromptWithStdinContext("hello", "world")
    var e1 = "hello\n\n<stdin>\nworld\n</stdin>"
    if !checkEq(r1, e1, "withStdin_basic"):
        ok = false

    # Case 2: stdinText already ends with newline — no extra newline added
    var r2 = RustCsgPromptWithStdinContext("hello", "world\n")
    var e2 = "hello\n\n<stdin>\nworld\n</stdin>"
    if !checkEq(r2, e2, "withStdin_endsWithNewline"):
        ok = false

    # Case 3: empty prompt string
    var r3 = RustCsgPromptWithStdinContext("", "data")
    var e3 = "\n\n<stdin>\ndata\n</stdin>"
    if !checkEq(r3, e3, "withStdin_emptyPrompt"):
        ok = false

    # Case 4: empty stdinText
    var r4 = RustCsgPromptWithStdinContext("test", "")
    var e4 = "test\n\n<stdin>\n\n</stdin>"
    if !checkEq(r4, e4, "withStdin_emptyText"):
        ok = false

    # Case 5: multi-line stdinText without trailing newline
    var r5 = RustCsgPromptWithStdinContext("test", "line1\nline2")
    var e5 = "test\n\n<stdin>\nline1\nline2\n</stdin>"
    if !checkEq(r5, e5, "withStdin_multiline"):
        ok = false

    if ok:
        echo("testWithStdinContext ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")

    # ── Oracle equivalence: count functions ──
    let source = "fn RustCsgPromptIsSpace(ch: char): bool =\nfn RustCsgPromptTrimmedEmpty(text: str): bool =\nfn RustCsgPromptEndsWithNewline(text: str): bool =\nfn RustCsgPromptWithStdinContext(prompt: str, stdinText: str): str =\nfn RustCsgPromptReadFromStdin(behavior: str, outError: var str): str =\nfn RustCsgPromptResolve(promptArg: str, outError: var str): str =\nfn RustCsgPromptResolveRoot(promptArg: str, outError: var str): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\texec/prompt\nFunction\texec/prompt\tRustCsgPromptIsSpace\tbool\nFunction\texec/prompt\tRustCsgPromptTrimmedEmpty\tbool\nFunction\texec/prompt\tRustCsgPromptEndsWithNewline\tbool\nFunction\texec/prompt\tRustCsgPromptWithStdinContext\tstr\nFunction\texec/prompt\tRustCsgPromptReadFromStdin\tstr\nFunction\texec/prompt\tRustCsgPromptResolve\tstr\nFunction\texec/prompt\tRustCsgPromptResolveRoot\tstr\n"

    let esf = CountSourceFunctions(source)
    let osf = CountOracleFunctions(oracle)

    assert(esf == 7, "source function count")
    assert(osf == 7, "oracle function count")
    assert(esf == osf, "functions oracle vs source")

    # ── Constant values (from exec/prompt.cheng) ──
    # (inlined as literals since const blocks are not supported by the cold compiler)

    # ── Behavioral tests ──
    var allOk: bool = true
    if !testIsSpace(): allOk = false
    if !testTrimmedEmpty(): allOk = false
    if !testEndsWithNewline(): allOk = false
    if !testWithStdinContext(): allOk = false

    if allOk:
        echo("rust_csg_exec_prompt_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_exec_prompt_relfacts_smoke FAILED")
        return 1
