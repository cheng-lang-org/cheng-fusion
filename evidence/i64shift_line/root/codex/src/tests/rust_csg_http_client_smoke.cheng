# HTTP client crate + module smoke test
#
# Tests the http_client crate (type constants and utility functions)
# and the net/http_client module (actual HTTP via C provider).

import cheng/codex/crates/http_client/http_client as hc
import cheng/codex/net/http_client
import std/cmdline
import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════
# Crate: type constant tests
# ═══════════════════════════════════════════════════════════════════════

fn testMethodVariantCount(): bool =
    if hc.RustCsgHttpClientMethodVariantCount != 7: return false
    if hc.RustCsgHttpClientMethodVariant1 != "GET": return false
    if hc.RustCsgHttpClientMethodVariant2 != "POST": return false
    if hc.RustCsgHttpClientMethodVariant3 != "PUT": return false
    if hc.RustCsgHttpClientMethodVariant4 != "DELETE": return false
    if hc.RustCsgHttpClientMethodVariant5 != "HEAD": return false
    if hc.RustCsgHttpClientMethodVariant6 != "OPTIONS": return false
    if hc.RustCsgHttpClientMethodVariant7 != "PATCH": return false
    if hc.HttpMethodVariantNames() != "GET,POST,PUT,DELETE,HEAD,OPTIONS,PATCH": return false
    echo("testMethodVariantCount ok")
    return true

fn testRequestFieldCount(): bool =
    if hc.RustCsgHttpClientRequestFieldCount != 4: return false
    if hc.RustCsgHttpClientRequestField1 != "method": return false
    if hc.RustCsgHttpClientRequestField2 != "url": return false
    if hc.RustCsgHttpClientRequestField3 != "headers": return false
    if hc.RustCsgHttpClientRequestField4 != "body": return false
    echo("testRequestFieldCount ok")
    return true

fn testResponseFieldCount(): bool =
    if hc.RustCsgHttpClientResponseFieldCount != 4: return false
    if hc.RustCsgHttpClientResponseField1 != "status_code": return false
    if hc.RustCsgHttpClientResponseField2 != "headers": return false
    if hc.RustCsgHttpClientResponseField3 != "body": return false
    if hc.RustCsgHttpClientResponseField4 != "error": return false
    echo("testResponseFieldCount ok")
    return true

fn testClientFieldCount(): bool =
    if hc.RustCsgHttpClientClientFieldCount != 5: return false
    if hc.RustCsgHttpClientClientField1 != "base_url": return false
    if hc.RustCsgHttpClientClientField2 != "default_headers": return false
    if hc.RustCsgHttpClientClientField3 != "timeout_s": return false
    if hc.RustCsgHttpClientClientField4 != "max_redirects": return false
    if hc.RustCsgHttpClientClientField5 != "follow_redirects": return false
    echo("testClientFieldCount ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: parse_content_type tests
# ═══════════════════════════════════════════════════════════════════════

fn testParseContentTypeSimple(): bool =
    var mime: str; var charset: str; var has: bool
    hc.RustCsgHttpClientParseContentType("text/html", mime, charset, has)
    if mime != "text/html": return false
    if has: return false   # no charset
    echo("testParseContentTypeSimple ok")
    return true

fn testParseContentTypeWithCharset(): bool =
    var mime: str; var charset: str; var has: bool
    hc.RustCsgHttpClientParseContentType("text/html; charset=utf-8", mime, charset, has)
    if mime != "text/html": return false
    if !has: return false
    if charset != "utf-8": return false
    echo("testParseContentTypeWithCharset ok")
    return true

fn testParseContentTypeApplicationJson(): bool =
    var mime: str; var charset: str; var has: bool
    hc.RustCsgHttpClientParseContentType("application/json", mime, charset, has)
    if mime != "application/json": return false
    if has: return false
    echo("testParseContentTypeApplicationJson ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: build request tests
# ═══════════════════════════════════════════════════════════════════════

fn testBuildHttpPostRequest(): bool =
    let req = hc.RustCsgHttpClientBuildHttpPostRequest("example.com", "/api", "hello", "text/plain")
    if !strutil.StartsWith(req, "POST /api HTTP/1.1\r\n"): return false
    if !strutil.Contains(req, "Host: example.com"): return false
    if !strutil.Contains(req, "Content-Type: text/plain"): return false
    if !strutil.Contains(req, "Content-Length: 5"): return false
    echo("testBuildHttpPostRequest ok")
    return true

fn testBuildHttpGetRequest(): bool =
    let req = hc.RustCsgHttpClientBuildHttpGetRequest("example.com", "/")
    if !strutil.StartsWith(req, "GET / HTTP/1.1\r\n"): return false
    if !strutil.Contains(req, "Host: example.com"): return false
    echo("testBuildHttpGetRequest ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: parse headers tests
# ═══════════════════════════════════════════════════════════════════════

fn testParseHeadersSimple(): bool =
    let headers = hc.RustCsgHttpClientParseHeaders("Content-Type: text/html\r\nContent-Length: 42\r\n")
    if headers.len != 2: return false
    if headers[0].name != "content-type": return false
    if headers[0].value != "text/html": return false
    if headers[1].name != "content-length": return false
    if headers[1].value != "42": return false
    echo("testParseHeadersSimple ok")
    return true

fn testParseHeadersEmpty(): bool =
    let headers = hc.RustCsgHttpClientParseHeaders("")
    if headers.len != 0: return false
    echo("testParseHeadersEmpty ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: method_to_string tests
# ═══════════════════════════════════════════════════════════════════════

fn testMethodToString(): bool =
    if hc.RustCsgHttpClientMethodToString(1) != "GET": return false
    if hc.RustCsgHttpClientMethodToString(2) != "POST": return false
    if hc.RustCsgHttpClientMethodToString(3) != "PUT": return false
    if hc.RustCsgHttpClientMethodToString(4) != "DELETE": return false
    if hc.RustCsgHttpClientMethodToString(5) != "HEAD": return false
    if hc.RustCsgHttpClientMethodToString(6) != "OPTIONS": return false
    if hc.RustCsgHttpClientMethodToString(7) != "PATCH": return false
    if hc.RustCsgHttpClientMethodToString(0) != "": return false
    if hc.RustCsgHttpClientMethodToString(8) != "": return false
    echo("testMethodToString ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: validate_url tests
# ═══════════════════════════════════════════════════════════════════════

fn testValidateUrl(): bool =
    if !hc.RustCsgHttpClientValidateUrl("https://example.com"): return false
    if !hc.RustCsgHttpClientValidateUrl("http://localhost:8080"): return false
    if !hc.RustCsgHttpClientValidateUrl("https://a"): return false
    if hc.RustCsgHttpClientValidateUrl(""): return false
    if hc.RustCsgHttpClientValidateUrl("ftp://bad.com"): return false
    if hc.RustCsgHttpClientValidateUrl("not-a-url"): return false
    if hc.RustCsgHttpClientValidateUrl("https://"): return false
    if hc.RustCsgHttpClientValidateUrl("http://"): return false
    echo("testValidateUrl ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: find_header_value tests
# ═══════════════════════════════════════════════════════════════════════

fn testFindHeaderValue(): bool =
    let headers = hc.RustCsgHttpClientParseHeaders(
        "Content-Type: application/json\r\nX-Custom: val\r\n")
    let ct = hc.RustCsgHttpClientFindHeaderValue(headers, "Content-Type")
    if ct != "application/json": return false
    let xc = hc.RustCsgHttpClientFindHeaderValue(headers, "x-custom")
    if xc != "val": return false
    let missing = hc.RustCsgHttpClientFindHeaderValue(headers, "X-Missing")
    if missing != "": return false
    echo("testFindHeaderValue ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Crate: classify_status_code tests
# ═══════════════════════════════════════════════════════════════════════

fn testClassifyStatusCode(): bool =
    if hc.RustCsgHttpClientClassifyStatusCode(100) != "Informational": return false
    if hc.RustCsgHttpClientClassifyStatusCode(200) != "Success": return false
    if hc.RustCsgHttpClientClassifyStatusCode(301) != "Redirection": return false
    if hc.RustCsgHttpClientClassifyStatusCode(404) != "ClientError": return false
    if hc.RustCsgHttpClientClassifyStatusCode(500) != "ServerError": return false
    if hc.RustCsgHttpClientClassifyStatusCode(99) != "Unknown": return false
    if hc.RustCsgHttpClientClassifyStatusCode(600) != "Unknown": return false
    echo("testClassifyStatusCode ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Module: net/http_client tests (requires C provider)
# ═══════════════════════════════════════════════════════════════════════

fn check(name: str, ok: bool) =
    if !ok:
        echo(strings.ConcatStr(name, " FAILED"))
    assert(ok, name)

fn joinUrl(baseUrl: str, path: str): str =
    if strings.HasSuffix(baseUrl, "/"):
        return strings.ConcatStr(strings.SliceBytes(baseUrl, 0, strings.Len(baseUrl) - 1), path)
    return strings.ConcatStr(baseUrl, path)

fn testNetHttpClientGet(baseUrl: str): bool =
    var getResult = http_client.HttpClientGet(joinUrl(baseUrl, "/client-get"), "token-http-smoke")
    if getResult.statusCode != 200: return false
    if !strings.StrContains(getResult.body, "local-http-client-get-ok"): return false
    echo(strings.ConcatStr("  GET status: ", strings.IntToStr(getResult.statusCode)))
    echo(strings.ConcatStr("  GET body length: ", strings.IntToStr(strings.Len(getResult.body))))
    echo("testNetHttpClientGet ok")
    return true

fn testNetHttpClientPost(baseUrl: str): bool =
    var postResult = http_client.HttpClientPost(joinUrl(baseUrl, "/client-post"),
                                                 "{\"test\":true}", "token-http-smoke")
    if postResult.statusCode != 200: return false
    if !strings.StrContains(postResult.body, "local-http-client-post-ok"): return false
    echo(strings.ConcatStr("  POST status: ", strings.IntToStr(postResult.statusCode)))
    echo(strings.ConcatStr("  POST body length: ", strings.IntToStr(strings.Len(postResult.body))))
    echo("testNetHttpClientPost ok")
    return true

# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_http_client_smoke <base_url>")
        return 1
    let baseUrl: str = cmdline.argStr(1)
    echo("smoke start")
    var allOk: bool = true

    # ── Crate type constant tests ──
    if !testMethodVariantCount(): allOk = false
    if !testRequestFieldCount(): allOk = false
    if !testResponseFieldCount(): allOk = false
    if !testClientFieldCount(): allOk = false

    # ── Crate utility function tests ──
    if !testParseContentTypeSimple(): allOk = false
    if !testParseContentTypeWithCharset(): allOk = false
    if !testParseContentTypeApplicationJson(): allOk = false
    if !testBuildHttpPostRequest(): allOk = false
    if !testBuildHttpGetRequest(): allOk = false
    if !testParseHeadersSimple(): allOk = false
    if !testParseHeadersEmpty(): allOk = false
    if !testMethodToString(): allOk = false
    if !testValidateUrl(): allOk = false
    if !testFindHeaderValue(): allOk = false
    if !testClassifyStatusCode(): allOk = false

    # ── Module net/http_client tests (requires C provider) ──
    if !testNetHttpClientGet(baseUrl): allOk = false
    if !testNetHttpClientPost(baseUrl): allOk = false

    echo("")
    if allOk:
        echo("rust_csg_http_client_smoke ok")
        return 0
    else:
        echo("rust_csg_http_client_smoke FAILED")
        return 1
