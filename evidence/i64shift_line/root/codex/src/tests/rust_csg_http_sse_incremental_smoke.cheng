import std/cmdline as cmdline
import std/strings
import std/system

@importc("cheng_http_sse_post_start")
fn chengHttpSsePostStartAbi(url: cstring, body: cstring, headers: cstring): int32

@ffi_owned_result(free = free)
@importc("cheng_http_sse_poll")
fn chengHttpSsePollAbi(handle: int32, timeoutMs: int32): owned_cstring

@importc("cheng_http_sse_close")
fn chengHttpSseClose(handle: int32): int32

@ffi_owned_result(free = free)
@importc("cheng_http_last_error")
fn chengHttpLastErrorAbi(): owned_cstring

fn chengHttpSsePostStart(url: str, body: str, headers: str): int32 =
    return chengHttpSsePostStartAbi(system.strToCStringTemp(url),
                                    system.strToCStringTemp(body),
                                    system.strToCStringTemp(headers))

fn chengHttpSsePoll(handle: int32, timeoutMs: int32): str =
    let out: str = chengHttpSsePollAbi(handle, timeoutMs)
    return out

fn chengHttpLastError(): str =
    let out: str = chengHttpLastErrorAbi()
    return out

fn fail(name: str, detail: str): int32 =
    echo(name)
    echo(detail)
    return 1

fn main(): int32 =
    if cmdline.argCount() < 2:
        return fail("sse_url_arg", "missing url")
    let handle = chengHttpSsePostStart(cmdline.argStr(1), "{\"stream\":true}", "")
    if handle <= 0:
        return fail("sse_start", chengHttpLastError())
    var sawDelta: bool
    var sawCompleted: bool
    var sawStatus: bool
    var polls: int32
    while polls < 80:
        let frame = chengHttpSsePoll(handle, 250)
        if frame == "":
            polls = polls + 1
            continue
        echo(frame)
        if strings.HasPrefix(frame, "E"):
            chengHttpSseClose(handle)
            return fail("sse_error", frame)
        if strings.HasPrefix(frame, "S"):
            sawStatus = true
            if frame != "S200":
                chengHttpSseClose(handle)
                return fail("sse_status", frame)
            break
        if strings.HasPrefix(frame, "D"):
            let data = strings.SliceBytes(frame, 1, strings.Len(frame) - 1)
            if strings.StrContains(data, "\"response.output_text.delta\""):
                sawDelta = true
            if strings.StrContains(data, "\"response.completed\""):
                sawCompleted = true
        polls = polls + 1
    let _closed = chengHttpSseClose(handle)
    if !sawDelta:
        return fail("sse_delta", "missing")
    if !sawCompleted:
        return fail("sse_completed", "missing")
    if !sawStatus:
        return fail("sse_status", "missing")
    echo("rust_csg_http_sse_incremental_smoke ok")
    return 0
