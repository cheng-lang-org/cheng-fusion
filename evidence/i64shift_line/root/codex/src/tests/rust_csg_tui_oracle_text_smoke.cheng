import std/cmdline
import std/strings
import cheng/codex/tui/oracle_text as oracle

fn checkOk(label: str, status: str): bool =
    if status != "ok":
        echo(strings.ConcatStr(strings.ConcatStr("FAIL ", label), strings.ConcatStr(": ", status)))
        return false
    echo(label)
    return true

fn main(): int32 =
    if cmdline.argCount() < 4:
        echo("FAIL usage: rust_csg_tui_oracle_text_smoke <quoted_snapshot> <raw_snapshot> <frame>")
        return 1
    if !checkOk("snapshot_quoted_body_compare_ok",
                oracle.RustCsgTuiOracleTextCheckQuotedDiffAddSnapshot(cmdline.argStr(1))):
        return 1
    if !checkOk("snapshot_raw_body_compare_ok",
                oracle.RustCsgTuiOracleTextCheckRawAppSnapshot(cmdline.argStr(2))):
        return 1
    if !checkOk("frame_body_compare_ok",
                oracle.RustCsgTuiOracleTextFrameContractFile(cmdline.argStr(3), 17)):
        return 1
    if !checkOk("first_diff_contract_ok", oracle.RustCsgTuiOracleTextFirstDiffContract()):
        return 1
    echo("rust_csg_tui_oracle_text_smoke ok")
    return 0
