import std/strings
import std/strutils as strutil
import cheng/codex/crates/realtime_webrtc/realtime_webrtc

fn main(): int32 =
    assert(realtime_webrtc.RealtimeWebrtcSessionType == "RealtimeWebrtcSession", "session type")
    assert(realtime_webrtc.RealtimeWebrtcStartedSessionType == "StartedRealtimeWebrtcSession", "started type")
    assert(realtime_webrtc.RealtimeWebrtcSessionHandleType == "RealtimeWebrtcSessionHandle", "handle type")
    assert(realtime_webrtc.RealtimeWebrtcConnectedEvent == "Connected", "connected")
    assert(realtime_webrtc.RealtimeWebrtcClosedEvent == "Closed", "closed")
    assert(realtime_webrtc.RealtimeWebrtcFailedEvent == "Failed", "failed")
    assert(realtime_webrtc.RealtimeWebrtcUnsupportedPlatform == "UnsupportedPlatform", "unsupported")
    assert(realtime_webrtc.RealtimeWebrtcStartFn == "start", "start fn")
    assert(realtime_webrtc.RealtimeWebrtcCloseFn == "close", "close fn")

    # Production function: buildSdpOffer
    let offer1 = realtime_webrtc.RealtimeWebrtcBuildSdpOffer("session-abc-123")
    if !strutil.Contains(offer1, "o=- session-abc-123 2 IN IP4 127.0.0.1"):
        assert(false, "buildSdpOffer sessionId")
    if !strutil.Contains(offer1, "v=0"):
        assert(false, "buildSdpOffer version line")
    if !strutil.Contains(offer1, "s=-"):
        assert(false, "buildSdpOffer session name")
    if !strutil.Contains(offer1, "t=0 0"):
        assert(false, "buildSdpOffer timing")

    let offer2 = realtime_webrtc.RealtimeWebrtcBuildSdpOffer("")
    if !strutil.Contains(offer2, "o=-  2 IN IP4 127.0.0.1"):
        assert(false, "buildSdpOffer empty sessionId")

    # Production function: webrtcParseSdp
    let sections1 = realtime_webrtc.RealtimeWebrtcParseSdp(offer1)
    if sections1.len != 0:
        assert(false, "parseSdp basic offer should have no media sections")

    let sdpWithMedia = strutil.Join([
        "v=0",
        "o=- 12345 2 IN IP4 127.0.0.1",
        "s=-",
        "t=0 0",
        "m=audio 9 UDP/TLS/RTP/SAVPF 0 1",
        "a=rtpmap:0 PCMU/8000",
        "m=video 9 UDP/TLS/RTP/SAVPF 96 97",
        "a=rtpmap:96 VP8/90000"
    ], "\n")

    let sections2 = realtime_webrtc.RealtimeWebrtcParseSdp(sdpWithMedia)
    if sections2.len != 2:
        assert(false, strutil.Join(["parseSdp expected 2 sections, got ", strings.IntToStr(sections2.len), ""], ""))
    if sections2[0] != "m=audio 9 UDP/TLS/RTP/SAVPF 0 1":
        assert(false, strutil.Join(["parseSdp section 0 mismatch: ", sections2[0], ""], ""))
    if sections2[1] != "m=video 9 UDP/TLS/RTP/SAVPF 96 97":
        assert(false, strutil.Join(["parseSdp section 1 mismatch: ", sections2[1], ""], ""))

    let sections3 = realtime_webrtc.RealtimeWebrtcParseSdp("")
    if sections3.len != 0:
        assert(false, "parseSdp empty sdp should return empty array")

    let sdpSingle = strutil.Join([
        "v=0",
        "m=application 9 UDP/DTLS/SCTP webrtc-datachannel"
    ], "\n")
    let sections4 = realtime_webrtc.RealtimeWebrtcParseSdp(sdpSingle)
    if sections4.len != 1:
        assert(false, "parseSdp single media section count")
    if sections4[0] != "m=application 9 UDP/DTLS/SCTP webrtc-datachannel":
        assert(false, "parseSdp single media section mismatch")

    echo("rust_csg_realtime_webrtc_smoke ok")
    return 0
