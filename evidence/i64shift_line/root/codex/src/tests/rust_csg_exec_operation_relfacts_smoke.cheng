import std/strings as strings

# ═══════════════════════════════════════════════════════════════════════════════
# Self-contained smoke test for Module 11: exec/operation
#
# Tests pure-logic functions from exec/operation.cheng:
#   RustCsgExecTextInputJson
#   RustCsgExecLocalImageInputJson
#   RustCsgExecBuildInputJson
#   RustCsgExecReviewTargetUncommittedJson
#   RustCsgExecReviewTargetBaseJson
#   RustCsgExecReviewTargetCommitJson
#   RustCsgExecReviewTargetCustomJson
#   (kind determination extracted from RustCsgExecInitialOperationFromPlan)
#
# Also verifies type/field/function oracle equivalence.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Wire helpers (self-contained, no wire module import) ────────────────────

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn JsonFieldStr(key: str, value: str): str =
    var out = "\""
    out = Cat(out, key)
    out = Cat(out, "\":\"")
    out = Cat(out, value)
    out = Cat(out, "\"")
    return out

fn JsonFieldRaw(key: str, value: str): str =
    var out = "\""
    out = Cat(out, key)
    out = Cat(out, "\":")
    out = Cat(out, value)
    return out

# ── Test helper ─────────────────────────────────────────────────────────────

fn checkEq(name: str, got: str, expected: str) =
    if got != expected:
        echo(name)
        echo(got)
        echo(expected)
        assert(got == expected, name)

# ═══════════════════════════════════════════════════════════════════════════════
# Oracle-count helpers (copied from exec/plan_relfacts)
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

# ═══════════════════════════════════════════════════════════════════════════════
# Pure-function reimplementations (mirroring exec/operation.cheng)
# ═══════════════════════════════════════════════════════════════════════════════

fn TextInputJson(text: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "text"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("text", text))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("textElements", "[]"))
    out = Cat(out, "}")
    return out

fn LocalImageInputJson(path: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "localImage"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("path", path))
    out = Cat(out, "}")
    return out

fn BuildInputJson(promptText: str, images: str[]): str =
    var out = "["
    for i in 0..<images.len:
        if i > 0:
            out = Cat(out, ",")
        out = Cat(out, LocalImageInputJson(images[i]))
    if images.len > 0:
        out = Cat(out, ",")
    out = Cat(out, TextInputJson(promptText))
    out = Cat(out, "]")
    return out

fn ReviewTargetUncommittedJson(): str =
    return "{\"type\":\"uncommittedChanges\"}"

fn ReviewTargetBaseJson(branch: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "baseBranch"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("branch", branch))
    out = Cat(out, "}")
    return out

fn ReviewTargetCommitJson(sha: str, title: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "commit"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("sha", sha))
    if title != "":
        out = Cat(out, ",")
        out = Cat(out, JsonFieldStr("title", title))
    out = Cat(out, "}")
    return out

fn ReviewTargetCustomJson(instructions: str): str =
    var out = "{"
    out = Cat(out, JsonFieldStr("type", "custom"))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("instructions", instructions))
    out = Cat(out, "}")
    return out

# ── Operation kind determination (extracted from RustCsgExecInitialOperationFromPlan) ──

fn OperationKindFromCommand(command: str): str =
    if command == "review":
        return "review"
    if command == "resume":
        return "resumeUserTurn"
    return "userTurn"

# ═══════════════════════════════════════════════════════════════════════════════
# Behavioral tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testTextInput(): bool =
    checkEq("text_input", TextInputJson("Hello"), "{\"type\":\"text\",\"text\":\"Hello\",\"textElements\":[]}")
    echo("testTextInput ok")
    return true

fn testLocalImageInput(): bool =
    checkEq("local_image", LocalImageInputJson("/repo/img.png"), "{\"type\":\"localImage\",\"path\":\"/repo/img.png\"}")
    echo("testLocalImageInput ok")
    return true

fn testBuildInput(): bool =
    checkEq("build_no_images", BuildInputJson("Fix it", []), "[{\"type\":\"text\",\"text\":\"Fix it\",\"textElements\":[]}]")
    checkEq("build_with_image", BuildInputJson("Fix it", ["/repo/a.png"]), "[{\"type\":\"localImage\",\"path\":\"/repo/a.png\"},{\"type\":\"text\",\"text\":\"Fix it\",\"textElements\":[]}]")
    echo("testBuildInput ok")
    return true

fn testReviewTargets(): bool =
    checkEq("review_uncommitted", ReviewTargetUncommittedJson(), "{\"type\":\"uncommittedChanges\"}")
    checkEq("review_base", ReviewTargetBaseJson("main"), "{\"type\":\"baseBranch\",\"branch\":\"main\"}")
    checkEq("review_commit", ReviewTargetCommitJson("abc123", "Fix bug"), "{\"type\":\"commit\",\"sha\":\"abc123\",\"title\":\"Fix bug\"}")
    checkEq("review_commit_no_title", ReviewTargetCommitJson("abc123", ""), "{\"type\":\"commit\",\"sha\":\"abc123\"}")
    checkEq("review_custom", ReviewTargetCustomJson("review this"), "{\"type\":\"custom\",\"instructions\":\"review this\"}")
    echo("testReviewTargets ok")
    return true

fn testKindDetermination(): bool =
    checkEq("kind_userTurn", OperationKindFromCommand("run"), "userTurn")
    checkEq("kind_resume", OperationKindFromCommand("resume"), "resumeUserTurn")
    checkEq("kind_review", OperationKindFromCommand("review"), "review")
    echo("testKindDetermination ok")
    return true

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    # ── Oracle equivalence ──
    let source = "type\n    RustCsgExecInitialOperation =\n        kind: str\n        promptText: str\n        inputJson: str\n        outputSchemaPath: str\n        reviewTargetJson: str\n        parseError: str\n        blockedReason: str\n\nfn RustCsgExecTextInputJson(text: str): str =\nfn RustCsgExecLocalImageInputJson(path: str): str =\nfn RustCsgExecBuildInputJson(promptText: str, images: str[]): str =\nfn RustCsgExecReviewTargetUncommittedJson(): str =\nfn RustCsgExecReviewTargetBaseJson(branch: str): str =\nfn RustCsgExecReviewTargetCommitJson(sha: str, title: str): str =\nfn RustCsgExecReviewTargetCustomJson(instructions: str): str =\nfn RustCsgExecBuildReviewTargetJson(execPlan: var plan.RustCsgExecPlan, outError: var str): str =\nfn RustCsgExecInitialOperationFromPlanInto(execPlan: var plan.RustCsgExecPlan, result: var RustCsgExecInitialOperation) =\nfn RustCsgExecInitialOperationFromPlan(execPlan: var plan.RustCsgExecPlan): RustCsgExecInitialOperation =\nfn RustCsgExecInitialOperationToJson(operation: RustCsgExecInitialOperation): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\texec/operation\nLocalType\texec/operation\tRustCsgExecInitialOperation\nHasField\texec/operation\tRustCsgExecInitialOperation\tkind\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\tpromptText\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\tinputJson\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\toutputSchemaPath\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\treviewTargetJson\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\tparseError\tstr\nHasField\texec/operation\tRustCsgExecInitialOperation\tblockedReason\tstr\nFunction\texec/operation\tRustCsgExecTextInputJson\tstr\nFunction\texec/operation\tRustCsgExecLocalImageInputJson\tstr\nFunction\texec/operation\tRustCsgExecBuildInputJson\tstr\nFunction\texec/operation\tRustCsgExecReviewTargetUncommittedJson\tstr\nFunction\texec/operation\tRustCsgExecReviewTargetBaseJson\tstr\nFunction\texec/operation\tRustCsgExecReviewTargetCommitJson\tstr\nFunction\texec/operation\tRustCsgExecReviewTargetCustomJson\tstr\nFunction\texec/operation\tRustCsgExecBuildReviewTargetJson\tstr\nFunction\texec/operation\tRustCsgExecInitialOperationFromPlanInto\tvoid\nFunction\texec/operation\tRustCsgExecInitialOperationFromPlan\tRustCsgExecInitialOperation\nFunction\texec/operation\tRustCsgExecInitialOperationToJson\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)

    assert(ect == 1, "source type count")
    assert(ecf == 7, "source field count")
    assert(ecn == 11, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)

    assert(oct == 1, "oracle type count")
    assert(ocf == 7, "oracle field count")
    assert(ocn == 11, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("oracle ok")

    # ── Behavioral tests ──
    if !testTextInput(): return 1
    if !testLocalImageInput(): return 1
    if !testBuildInput(): return 1
    if !testReviewTargets(): return 1
    if !testKindDetermination(): return 1

    echo("rust_csg_exec_operation_relfacts_smoke ok")
    return 0
