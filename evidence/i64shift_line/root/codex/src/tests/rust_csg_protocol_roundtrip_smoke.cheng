import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn assertEq(name: str, got: str, expected: str) =
    if got != expected:
        echo(name)
        echo(got)
        echo(expected)
    assert(got == expected, name)

fn main(): int32 =
    var turn: types.RustCsgAppTurn
    turn.id = "turn-null"
    turn.itemsView = "notLoaded"
    turn.status = "inProgress"
    let turnJson = wire.RustCsgAppTurnToJson(turn)
    let expectedTurn = "{\"id\":\"turn-null\",\"items\":[],\"itemsView\":\"notLoaded\",\"status\":\"inProgress\",\"error\":null,\"startedAt\":null,\"completedAt\":null,\"durationMs\":null}"
    assertEq("app_turn_null_wire", turnJson, expectedTurn)

    let turnBack = wire.RustCsgAppTurnFromJson(turnJson)
    assertEq("app_turn_null_roundtrip", wire.RustCsgAppTurnToJson(turnBack), expectedTurn)

    var total: types.RustCsgTokenUsageBreakdown
    total.totalTokens = int64(150)
    total.inputTokens = int64(120)
    total.cachedInputTokens = int64(20)
    total.outputTokens = int64(30)
    total.reasoningOutputTokens = int64(10)
    var last: types.RustCsgTokenUsageBreakdown
    last.totalTokens = int64(90)
    last.inputTokens = int64(70)
    last.cachedInputTokens = int64(10)
    last.outputTokens = int64(20)
    last.reasoningOutputTokens = int64(5)
    var usage: types.RustCsgThreadTokenUsage
    usage.total = total
    usage.last = last
    usage.modelContextWindowJson = "200000"
    var notification: types.RustCsgThreadTokenUsageUpdatedNotification
    notification.threadId = "thread-token"
    notification.turnId = "turn-token"
    notification.tokenUsage = usage
    let usageJson = wire.RustCsgThreadTokenUsageUpdatedNotificationToJson(notification)
    let expectedUsage = "{\"method\":\"thread/tokenUsage/updated\",\"params\":{\"threadId\":\"thread-token\",\"turnId\":\"turn-token\",\"tokenUsage\":{\"total\":{\"totalTokens\":150,\"inputTokens\":120,\"cachedInputTokens\":20,\"outputTokens\":30,\"reasoningOutputTokens\":10},\"last\":{\"totalTokens\":90,\"inputTokens\":70,\"cachedInputTokens\":10,\"outputTokens\":20,\"reasoningOutputTokens\":5},\"modelContextWindow\":200000}}}"
    assertEq("thread_token_usage_updated_wire", usageJson, expectedUsage)

    usage.modelContextWindowJson = ""
    notification.tokenUsage = usage
    let usageNullJson = wire.RustCsgThreadTokenUsageUpdatedNotificationToJson(notification)
    let expectedUsageNull = "{\"method\":\"thread/tokenUsage/updated\",\"params\":{\"threadId\":\"thread-token\",\"turnId\":\"turn-token\",\"tokenUsage\":{\"total\":{\"totalTokens\":150,\"inputTokens\":120,\"cachedInputTokens\":20,\"outputTokens\":30,\"reasoningOutputTokens\":10},\"last\":{\"totalTokens\":90,\"inputTokens\":70,\"cachedInputTokens\":10,\"outputTokens\":20,\"reasoningOutputTokens\":5},\"modelContextWindow\":null}}}"
    assertEq("thread_token_usage_updated_null_window_wire", usageNullJson, expectedUsageNull)

    var meta: types.RustCsgSessionMeta
    meta.id = "session-base"
    meta.timestamp = "2026-05-28T00:00:00Z"
    meta.cwd = "/tmp/session-base"
    meta.originator = "codex-cli"
    meta.cliVersion = "1.0.0"
    meta.source = "cli"
    meta.modelProvider = "openai"
    meta.baseInstructions = "session base instructions"
    meta.baseInstructionsPresent = true
    let metaJson = wire.RustCsgSessionMetaToJson(meta)
    let expectedMeta = "{\"id\":\"session-base\",\"timestamp\":\"2026-05-28T00:00:00Z\",\"cwd\":\"/tmp/session-base\",\"originator\":\"codex-cli\",\"cli_version\":\"1.0.0\",\"source\":\"cli\",\"model_provider\":\"openai\",\"base_instructions\":{\"text\":\"session base instructions\"}}"
    assertEq("session_meta_base_instructions_wire", metaJson, expectedMeta)

    let metaBack = wire.RustCsgSessionMetaFromJson(metaJson)
    assert(metaBack.baseInstructionsPresent, "session_meta_base_instructions_present")
    assertEq("session_meta_base_instructions_roundtrip", metaBack.baseInstructions, "session base instructions")

    var resumeParams: types.RustCsgThreadResumeParams
    resumeParams.threadId = "thread-resume-roots"
    resumeParams.runtimeWorkspaceRootsJson = "[\"/work\",\"/cache\"]"
    let resumeJson = wire.RustCsgThreadResumeParamsToJson(resumeParams)
    assertEq("thread_resume_runtime_roots_wire",
             resumeJson,
             "{\"threadId\":\"thread-resume-roots\",\"runtimeWorkspaceRoots\":[\"/work\",\"/cache\"]}")
    let resumeBack = wire.RustCsgThreadResumeParamsFromJson(resumeJson)
    assertEq("thread_resume_runtime_roots_roundtrip",
             resumeBack.runtimeWorkspaceRootsJson,
             "[\"/work\",\"/cache\"]")

    echo("rust_csg_protocol_roundtrip_smoke ok")
    return 0
