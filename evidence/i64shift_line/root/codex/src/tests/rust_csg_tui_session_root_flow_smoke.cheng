import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/session_bootstrap as bootstrap
import cheng/codex/tui/session_handoff as handoff
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_resume as resume
import cheng/codex/tui/session_root_flow as root_flow

fn SourceThreadId(): str =
    return "11111111-1111-4111-8111-111111111111"

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckMinInt32(actual: int32, minimum: int32, label: str): int32 =
    if actual >= minimum:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected at least ", strings.IntToStr(minimum), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn FillHandoffConfig(config: var lifecycle.RustCsgTuiThreadHandoffConfig,
                     cwd: str) =
    config.cwd = cwd
    config.model = "gpt-5"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(cwd), "]")
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.permissionsJson = "\":workspace\""
    config.configJson = "{\"model_reasoning_effort\":\"medium\"}"
    config.baseInstructions = "base"
    config.developerInstructions = "dev"

fn PendingEvent(kind: str, payload: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("payload", payload))
    out = wire.RustCsgCat(out, "}")
    return out

fn BootstrapPendingEventsJson(): str =
    let threadId = SourceThreadId()
    let notificationPayload = wire.RustCsgCat3("{\"method\":\"thread/tokenUsage/updated\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), "}}")
    let requestPayload = wire.RustCsgCat3("{\"id\":9,\"method\":\"item/commandExecution/requestApproval\",\"params\":{\"threadId\":", wire.RustCsgJsonQuote(threadId), ",\"turnId\":\"turn-cmd\",\"itemId\":\"exec-cmd\"}}")
    return strutil.Join(["[",
                         PendingEvent("notification", notificationPayload),
                         ",",
                         PendingEvent("request", requestPayload),
                         "]"], "")

fn FillBootstrapConfig(config: var bootstrap.RustCsgTuiSessionBootstrapConfig) =
    config.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.terminalResizeReflowEnabled = true
    config.pendingPrimaryEventCount = 2
    config.pendingPrimaryEventsJson = BootstrapPendingEventsJson()
    config.initialUserMessagePending = true
    config.stateConfig.permissionProfileJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.stateConfig.personalityJson = "\"test-personality\""
    config.stateConfig.messageHistoryLogId = int64(42)
    config.stateConfig.messageHistoryEntryCount = 3

fn FillRootFlowConfig(config: var root_flow.RustCsgTuiSessionRootFlowConfig,
                      dbPath: str,
                      codexHome: str,
                      currentCwd: str,
                      requestIdJson: str) =
    config.handoffContext.dbPath = dbPath
    config.handoffContext.codexHomePath = codexHome
    config.handoffContext.currentCwd = currentCwd
    config.handoffContext.currentConfigJson = resume.RustCsgTuiSessionResumeConfigJson(currentCwd,
                                                                                       "{\"model\":\"current-config-model\",\"modelProvider\":\"current-config-provider\",\"approvalPolicy\":\"on-request\",\"approvalsReviewer\":\"user\"}")
    config.handoffContext.allowPrompt = true
    config.handoffContext.promptChoice = "current"
    config.handoffContext.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.handoffContext.requestIdJson = requestIdJson
    FillHandoffConfig(config.handoffConfig, currentCwd)
    FillBootstrapConfig(config.bootstrapConfig)
    config.appTermWidth = 96
    config.appTermHeight = 20

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_session_root_flow_smoke <state-db> <codex-home> <current-cwd> <rollout-path>")
        return 1

    let dbPath = cmdline.argStr(1)
    let codexHome = cmdline.argStr(2)
    let currentCwd = cmdline.argStr(3)
    let rolloutPath = cmdline.argStr(4)
    let threadId = SourceThreadId()
    var failures: int32

    var resumeConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootFlowConfig(resumeConfig, dbPath, codexHome, currentCwd, "91")
    var resumeSelection = root_flow.RustCsgTuiSessionRootFlowMakeSelection("resume",
                                                                            threadId,
                                                                            rolloutPath,
                                                                            "Existing thread",
                                                                            "Resume a previous session\nExisting thread",
                                                                            1)
    let resumeResult = root_flow.RustCsgTuiSessionRootFlowRunSelected(resumeConfig, resumeSelection)
    failures = failures + CheckEqBool(resumeResult.ok, true, "resume root ok")
    failures = failures + CheckEqStr(resumeResult.outcome, "app_ready", "resume outcome")
    failures = failures + CheckEqStr(resumeResult.selectionKind, "resume", "resume selection")
    failures = failures + CheckEqStr(resumeResult.method, "thread/resume", "resume method")
    failures = failures + CheckEqStr(resumeResult.primaryThreadId, threadId, "resume primary")
    failures = failures + CheckMinInt32(resumeResult.pickerFrameCount, 1, "resume picker frames")
    failures = failures + CheckContains(resumeResult.pickerScreen, "Resume a previous session", "resume picker screen")
    failures = failures + CheckContains(resumeResult.handoffRequestJson, "\"runtimeWorkspaceRoots\"", "resume handoff roots")
    failures = failures + CheckContains(resumeResult.appServerResponseJson, "\"result\":{\"thread\"", "resume app-server response")
    failures = failures + CheckContains(resumeResult.bootstrapJson, "\"outcome\":\"installed\"", "resume bootstrap installed")
    failures = failures + CheckContains(resumeResult.installJson, "\"replayKind\":\"ResumeInitialMessages\"", "resume install replay")
    failures = failures + CheckContains(resumeResult.installJson, "› resume hello", "resume replay user")
    failures = failures + CheckContains(resumeResult.installJson, "• Ran echo ok\\n  └ cmd output", "resume command replay")
    failures = failures + CheckContains(resumeResult.appRuntimeJson, "\"runLoopReady\":true", "resume app runtime ready")
    failures = failures + CheckContains(resumeResult.appEffectsJson, "\"kind\":\"chat_widget/replay_thread_turns\"", "resume replay effect")
    failures = failures + CheckContains(resumeResult.appEffectsJson, "\"kind\":\"app_server/replay_pending_primary_events\"", "resume pending effect")
    failures = failures + CheckContains(resumeResult.appFirstFrameText, "session 11111111-1111-4111-8111-111111111111", "resume first frame status")
    failures = failures + CheckContains(resumeResult.appFirstFrameText, "resume hello", "resume first frame user")

    let resumeJson = root_flow.RustCsgTuiSessionRootFlowResultToJson(resumeResult)
    failures = failures + CheckContains(resumeJson, "\"outcome\":\"app_ready\"", "resume json outcome")
    failures = failures + CheckContains(resumeJson, "\"appRuntime\":{\"ok\":true", "resume json runtime")

    var forkConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootFlowConfig(forkConfig, dbPath, codexHome, currentCwd, "92")
    var forkSelection = root_flow.RustCsgTuiSessionRootFlowMakeSelection("fork",
                                                                          threadId,
                                                                          rolloutPath,
                                                                          "Existing thread",
                                                                          "Fork a session\nExisting thread",
                                                                          1)
    let forkResult = root_flow.RustCsgTuiSessionRootFlowRunSelected(forkConfig, forkSelection)
    failures = failures + CheckEqBool(forkResult.ok, true, "fork root ok")
    failures = failures + CheckEqStr(forkResult.outcome, "app_ready", "fork outcome")
    failures = failures + CheckEqStr(forkResult.selectionKind, "fork", "fork selection")
    failures = failures + CheckEqStr(forkResult.method, "thread/fork", "fork method")
    failures = failures + CheckContains(forkResult.handoffRequestJson, "\"threadSource\":\"user\"", "fork handoff source")
    failures = failures + CheckContains(forkResult.bootstrapJson, wire.RustCsgCat3("\"forkedFromId\":\"", threadId, "\""), "fork parent id")
    failures = failures + CheckContains(forkResult.appRuntimeJson, "\"runLoopReady\":true", "fork app runtime ready")
    failures = failures + CheckContains(forkResult.appEffectsJson, "\"kind\":\"app/request_redraw\"", "fork redraw effect")

    var unsupportedConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootFlowConfig(unsupportedConfig, dbPath, codexHome, currentCwd, "93")
    var unsupportedSelection = root_flow.RustCsgTuiSessionRootFlowMakeSelection("none",
                                                                                 threadId,
                                                                                 rolloutPath,
                                                                                 "Existing thread",
                                                                                 "",
                                                                                 0)
    let unsupported = root_flow.RustCsgTuiSessionRootFlowRunSelected(unsupportedConfig, unsupportedSelection)
    failures = failures + CheckEqBool(unsupported.ok, false, "unsupported selection fails")
    failures = failures + CheckEqStr(unsupported.error, "unsupported session selection: none", "unsupported selection error")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_root_flow_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_root_flow_smoke ok")
    return 0
