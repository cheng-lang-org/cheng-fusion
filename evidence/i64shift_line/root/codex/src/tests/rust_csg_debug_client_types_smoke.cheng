import cheng/codex/crates/debug_client/debug_client as dc

# ═══════════════════════════════════════════════════════════════════════════════
# Debug Client — type definition constants smoke test
#
# Ported from codex-rs/codex-debug-client
# ═══════════════════════════════════════════════════════════════════════════════

fn testAppServerClientFieldCount(): bool =
    if dc.RustCsgAppServerClientFieldCount != 6: return false
    if dc.RustCsgAppServerClientField1 != "child": return false
    if dc.RustCsgAppServerClientField6 != "output": return false
    echo("testAppServerClientFieldCount ok")
    return true

fn testAppServerClientMethodCount(): bool =
    if dc.RustCsgAppServerClientMethodCount != 13: return false
    if dc.RustCsgAppServerClientMethod1 != "spawn": return false
    if dc.RustCsgAppServerClientMethod13 != "shutdown": return false
    echo("testAppServerClientMethodCount ok")
    return true

fn testStateFieldCount(): bool =
    if dc.RustCsgStateFieldCount != 3: return false
    if dc.RustCsgStateField1 != "pending": return false
    if dc.RustCsgStateField3 != "known_threads": return false
    echo("testStateFieldCount ok")
    return true

fn testPendingRequestVariants(): bool =
    if dc.RustCsgPendingRequestVariantCount != 3: return false
    if dc.RustCsgPendingRequestVariant1 != "Start": return false
    if dc.RustCsgPendingRequestVariant3 != "List": return false
    echo("testPendingRequestVariants ok")
    return true

fn testReaderEventVariants(): bool =
    if dc.RustCsgReaderEventVariantCount != 2: return false
    if dc.RustCsgReaderEventVariant1 != "ThreadReady": return false
    if dc.RustCsgReaderEventVariant2 != "ThreadList": return false
    echo("testReaderEventVariants ok")
    return true

fn testInputActionVariants(): bool =
    if dc.RustCsgInputActionVariantCount != 2: return false
    if dc.RustCsgInputActionVariant1 != "Message": return false
    if dc.RustCsgInputActionVariant2 != "Command": return false
    echo("testInputActionVariants ok")
    return true

fn testUserCommandVariants(): bool =
    if dc.RustCsgUserCommandVariantCount != 6: return false
    if dc.RustCsgUserCommandVariant1 != "Help": return false
    if dc.RustCsgUserCommandVariant6 != "RefreshThread": return false
    echo("testUserCommandVariants ok")
    return true

fn testParseErrorVariants(): bool =
    if dc.RustCsgParseErrorVariantCount != 3: return false
    if dc.RustCsgParseErrorVariant1 != "EmptyCommand": return false
    if dc.RustCsgParseErrorVariant3 != "UnknownCommand": return false
    echo("testParseErrorVariants ok")
    return true

fn testLabelColorVariants(): bool =
    if dc.RustCsgLabelColorVariantCount != 4: return false
    if dc.RustCsgLabelColorVariant1 != "Assistant": return false
    if dc.RustCsgLabelColorVariant4 != "Thread": return false
    echo("testLabelColorVariants ok")
    return true

fn testOutputFieldCount(): bool =
    if dc.RustCsgOutputFieldCount != 4: return false
    if dc.RustCsgOutputField1 != "lock": return false
    if dc.RustCsgOutputField4 != "jsonl_file": return false
    echo("testOutputFieldCount ok")
    return true

fn testOutputMethodCount(): bool =
    if dc.RustCsgOutputMethodCount != 8: return false
    if dc.RustCsgOutputMethod1 != "new": return false
    if dc.RustCsgOutputMethod8 != "write_prompt_locked": return false
    echo("testOutputMethodCount ok")
    return true

fn testFormatDebugPrompt(): bool =
    var prompt: str = dc.formatDebugPrompt()
    if prompt.len == 0: return false
    if prompt != "debug> ": return false
    echo("testFormatDebugPrompt ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testAppServerClientFieldCount(): allOk = false
    if !testAppServerClientMethodCount(): allOk = false
    if !testStateFieldCount(): allOk = false
    if !testPendingRequestVariants(): allOk = false
    if !testReaderEventVariants(): allOk = false
    if !testInputActionVariants(): allOk = false
    if !testUserCommandVariants(): allOk = false
    if !testParseErrorVariants(): allOk = false
    if !testLabelColorVariants(): allOk = false
    if !testOutputFieldCount(): allOk = false
    if !testOutputMethodCount(): allOk = false
    if !testFormatDebugPrompt(): allOk = false
    if allOk:
        echo("rust_csg_debug_client_types_smoke ok")
        return 0
    echo("rust_csg_debug_client_types_smoke FAILED")
    return 1
