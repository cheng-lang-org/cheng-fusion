import std/sqlite
import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/protocol/types
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite
import cheng/codex/state/thread_store

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteRelativeCwdRow")
fn RustCsgAddSqliteRelativeCwdRow(path: str): str

@abi_internal
@importc("RustCsgAddSqliteLatestRolloutCwdRow")
fn RustCsgAddSqliteLatestRolloutCwdRow(path: str): str

@abi_internal
@importc("RustCsgAddSqliteSymlinkCwdRow")
fn RustCsgAddSqliteSymlinkCwdRow(path: str): str

@abi_internal
@importc("RustCsgCreateSessionIndexFixture")
fn RustCsgCreateSessionIndexFixture(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertBool(name: str, value: bool) =
    if !value:
        echo(name)
    assert(value, name)

fn assertOk(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn checkInitialResumeLookup(path: str, repoCwd: str, otherCwd: str) =
    var lastPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", "repo/../repo", "resume", "--last", "continue"])
    var lastResult = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, lastPlan, "openai")
    assertOk("last_result", lastResult)
    checkEq("last_thread", lastResult.threadId, "thread-relative-cwd")
    assertBool("last_response_has_thread", wire.RustCsgContains(lastResult.responseJson, "\"id\":\"thread-relative-cwd\""))
    assertBool("last_response_excludes_older", !wire.RustCsgContains(lastResult.responseJson, "\"id\":\"thread-2\""))

    var missingProviderPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--last", "continue"])
    var missingProvider = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, missingProviderPlan, "")
    assertBool("missing_provider_blocked", !missingProvider.ok)
    checkEq("missing_provider_reason",
               missingProvider.blockedReason,
               "resume --last requires config model provider id")

    var missingCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "resume", "--last", "continue"])
    var missingCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, missingCwdPlan, "openai")
    assertBool("missing_cwd_blocked", !missingCwd.ok)
    checkEq("missing_cwd_reason",
               missingCwd.blockedReason,
               "resume sqlite lookup requires canonical absolute cwd")

    var missingExistingCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", wire.RustCsgCat(repoCwd, "/missing"), "resume", "--last", "continue"])
    var missingExistingCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, missingExistingCwdPlan, "openai")
    assertBool("missing_existing_cwd_blocked", !missingExistingCwd.ok)
    checkEq("missing_existing_cwd_reason",
               missingExistingCwd.blockedReason,
               "resume sqlite lookup cwd canonicalize failed: existing path required")

    var allLastNoCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "resume", "--all", "--last", "continue"])
    var allLastNoCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, allLastNoCwdPlan, "openai")
    assertOk("all_last_no_cwd", allLastNoCwd)
    checkEq("all_last_no_cwd_thread", allLastNoCwd.threadId, "thread-relative-cwd")

    var allLastOtherCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--all", "--last", "continue"])
    var allLastOtherCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, allLastOtherCwdPlan, "openai")
    assertOk("all_last_other_cwd", allLastOtherCwd)
    checkEq("all_last_other_cwd_thread", allLastOtherCwd.threadId, "thread-relative-cwd")

    var relativeCwdPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                     "--cd",
                                                     "repo/../repo",
                                                     "resume",
                                                     "relative cwd thread",
                                                     "continue"])
    var relativeCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, relativeCwdPlan, "openai")
    assertOk("relative_cwd", relativeCwd)
    checkEq("relative_cwd_thread", relativeCwd.threadId, "thread-relative-cwd")

fn checkLatestAndSymlinkLookup(path: str, repoCwd: str, otherCwd: str) =
    checkEq("latest_rollout_cwd_fixture", RustCsgAddSqliteLatestRolloutCwdRow(path), "")
    var latestRolloutRow = state_db_sqlite.RustCsgStateDbThreadById(path, "thread-latest-rollout-cwd")
    assertBool("latest_rollout_row_loaded", latestRolloutRow.ok)
    var latestRolloutCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", "repo", "resume", "--last", "continue"])
    var latestRolloutCwdBlockedReason: str
    let latestExpectedCwd = resume_lookup_sqlite.RustCsgExecResumeSqliteCwdFilter(latestRolloutCwdPlan,
                                                                                  true,
                                                                                  latestRolloutCwdBlockedReason)
    checkEq("latest_rollout_cwd_filter_blocked", latestRolloutCwdBlockedReason, "")
    checkEq("latest_rollout_reader_cwd",
               reader.RustCsgRolloutLatestTurnCwd(latestRolloutRow.rolloutPath),
               latestExpectedCwd)
    assertBool("latest_rollout_row_cwd_match",
               resume_lookup_sqlite.RustCsgExecResumeSqliteRowCwdMatches(latestRolloutRow, latestExpectedCwd))
    var latestRolloutCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, latestRolloutCwdPlan, "openai")
    assertOk("latest_rollout_cwd", latestRolloutCwd)
    checkEq("latest_rollout_cwd_thread", latestRolloutCwd.threadId, "thread-latest-rollout-cwd")

    var latestRolloutSkipsDbCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--last", "continue"])
    var latestRolloutSkipsDbCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path,
                                                                                       latestRolloutSkipsDbCwdPlan,
                                                                                       "openai")
    assertBool("latest_rollout_skips_db_cwd_blocked", !latestRolloutSkipsDbCwd.ok)
    checkEq("latest_rollout_skips_db_cwd_reason",
               latestRolloutSkipsDbCwd.blockedReason,
               "resume --last found no thread")

    let symlinkCwd = RustCsgAddSqliteSymlinkCwdRow(path)
    assert(symlinkCwd != "", "symlink cwd fixture")
    var symlinkPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", symlinkCwd, "resume", "--last", "continue"])
    var symlinkCwdBlockedReason: str
    let symlinkExpectedCwd = resume_lookup_sqlite.RustCsgExecResumeSqliteCwdFilter(symlinkPlan,
                                                                                   true,
                                                                                   symlinkCwdBlockedReason)
    checkEq("symlink_cwd_filter_blocked", symlinkCwdBlockedReason, "")
    var symlinkRow = state_db_sqlite.RustCsgStateDbThreadById(path, "thread-symlink-cwd")
    assertBool("symlink_row_loaded", symlinkRow.ok)
    assertBool("symlink_row_cwd_match",
               resume_lookup_sqlite.RustCsgExecResumeSqliteRowCwdMatches(symlinkRow, symlinkExpectedCwd))
    var symlinkResult = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, symlinkPlan, "openai")
    assertOk("symlink_cwd_match", symlinkResult)
    checkEq("symlink_cwd_thread", symlinkResult.threadId, "thread-symlink-cwd")

fn checkExplicitAndSessionIndexLookup(path: str, repoCwd: str, otherCwd: str) =
    var explicitNamePlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", "repo", "resume", "relative cwd thread", "continue"])
    var explicitName = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, explicitNamePlan, "")
    assertOk("explicit_name", explicitName)
    checkEq("explicit_name_thread", explicitName.threadId, "thread-relative-cwd")
    assertBool("explicit_name_response_has_relative", wire.RustCsgContains(explicitName.responseJson, "\"id\":\"thread-relative-cwd\""))

    var explicitOtherProviderPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--all", "anthropic thread", "continue"])
    var explicitOtherProvider = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path,
                                                                                     explicitOtherProviderPlan,
                                                                                     "")
    assertOk("explicit_other_provider", explicitOtherProvider)
    checkEq("explicit_other_provider_thread", explicitOtherProvider.threadId, "thread-4")

    var explicitAllOtherProviderPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--all", "anthropic thread", "continue"])
    var explicitAllOtherProvider = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path,
                                                                                        explicitAllOtherProviderPlan,
                                                                                        "")
    assertOk("explicit_all_other_provider", explicitAllOtherProvider)
    checkEq("explicit_all_other_provider_thread", explicitAllOtherProvider.threadId, "thread-4")

    var explicitWrongCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "anthropic thread", "continue"])
    var explicitWrongCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, explicitWrongCwdPlan, "")
    assertBool("explicit_wrong_cwd_blocked", !explicitWrongCwd.ok)
    checkEq("explicit_wrong_cwd_reason", explicitWrongCwd.blockedReason, "explicit resume name found no thread")

    var explicitSubstringPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "thread", "continue"])
    var explicitSubstring = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, explicitSubstringPlan, "")
    assertBool("explicit_substring_blocked", !explicitSubstring.ok)
    checkEq("explicit_substring_reason",
               explicitSubstring.blockedReason,
               "explicit resume name found no thread")

    let sessionIndexHome = RustCsgCreateSessionIndexFixture(path)
    assert(sessionIndexHome != "", "session_index fixture path")
    var sessionIndexLoadError: str
    var sessionIndexProbeEntry: types.RustCsgSessionIndexEntry
    thread_store.RustCsgSessionIndexFindLatestByNameInto(sessionIndexHome,
                                                         "session-index-named",
                                                         sessionIndexProbeEntry,
                                                         sessionIndexLoadError)
    checkEq("session_index_load_error", sessionIndexLoadError, "")
    checkEq("session_index_probe_named", sessionIndexProbeEntry.threadName, "session-index-named")
    var sessionIndexDirect = resume_lookup_sqlite.RustCsgExecResumeSqliteSessionIndexByName(path,
                                                                                            "session-index-named",
                                                                                            "")
    assertOk("session_index_direct", sessionIndexDirect)
    checkEq("session_index_direct_thread", sessionIndexDirect.threadId, "thread-si-1")

    var siNamePlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--all", "session-index-named", "continue"])
    var siName = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, siNamePlan, "")
    assertOk("session_index_by_name", siName)
    checkEq("session_index_by_name_thread", siName.threadId, "thread-si-1")

    var siNameWrongCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "session-index-named", "continue"])
    var siNameWrongCwd = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, siNameWrongCwdPlan, "")
    assertBool("session_index_wrong_cwd_blocked", !siNameWrongCwd.ok)
    checkEq("session_index_wrong_cwd_reason",
               siNameWrongCwd.blockedReason,
               "explicit resume name found no thread")

    var siNameNotFoundPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "nonexistent-name", "continue"])
    var siNameNotFound = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, siNameNotFoundPlan, "openai")
    assertBool("session_index_not_found_blocked", !siNameNotFound.ok)
    checkEq("session_index_not_found_reason",
               siNameNotFound.blockedReason,
               "explicit resume name found no thread")

    var explicitMissingPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "missing thread", "continue"])
    var explicitMissing = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, explicitMissingPlan, "openai")
    assertBool("explicit_missing_blocked", !explicitMissing.ok)
    checkEq("explicit_missing_reason", explicitMissing.blockedReason, "explicit resume name found no thread")

    var explicitIdPlan = plan.RustCsgExecParseArgs(["codex-exec",
                                                    "--cd",
                                                    repoCwd,
                                                    "resume",
                                                    "123e4567-e89b-12d3-a456-426614174000",
                                                    "continue"])
    var explicitId = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, explicitIdPlan, "openai")
    assertOk("explicit_id_direct", explicitId)
    checkEq("explicit_id_thread", explicitId.threadId, "123e4567-e89b-12d3-a456-426614174000")
    checkEq("explicit_id_response", explicitId.responseJson, "{}")

fn main(): int32 =
    assert(sqlite.SqliteOk == 0, "sqlite_probe")
    checkEq("thread_list_sqlite_probe",
               thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson(),
               "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]")
    checkEq("rollout_reader_probe", reader.RustCsgRolloutLatestTurnCwd(""), "")
    checkEq("rollout_reader_escaped_cwd",
               reader.RustCsgRolloutLineTurnCwd("{\"timestamp\":\"2026-05-17T00:00:00Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"\\/escaped\\/repo\",\"approval_policy\":\"never\",\"sandbox_policy\":{\"type\":\"workspace-write\"},\"model\":\"gpt-5.4\",\"summary\":\"auto\"}}"),
               "/escaped/repo")
    checkEq("rollout_reader_rejects_missing_required",
               reader.RustCsgRolloutLineTurnCwd("{\"timestamp\":\"2026-05-17T00:00:00Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"/bad\"}}"),
               "")
    checkEq("rollout_reader_rejects_bad_approval_string",
               reader.RustCsgRolloutLineTurnCwd("{\"timestamp\":\"2026-05-17T00:00:00Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"/bad\",\"approval_policy\":\"bad\",\"sandbox_policy\":{\"type\":\"workspace-write\"},\"model\":\"gpt-5.4\",\"summary\":\"auto\"}}"),
               "")
    checkEq("rollout_reader_rejects_bad_approval_object",
               reader.RustCsgRolloutLineTurnCwd("{\"timestamp\":\"2026-05-17T00:00:00Z\",\"type\":\"turn_context\",\"payload\":{\"cwd\":\"/bad\",\"approval_policy\":{},\"sandbox_policy\":{\"type\":\"workspace-write\"},\"model\":\"gpt-5.4\",\"summary\":\"auto\"}}"),
               "")
    let sessionIndexProbe = thread_store.RustCsgSessionIndexParseLine("{\"id\":\"thread-probe\",\"thread_name\":\"probe\",\"updated_at\":\"2026-05-17T00:00:00Z\"}")
    checkEq("session_index_probe_id", sessionIndexProbe.id, "thread-probe")
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    let repoCwd = "repo"
    let otherCwd = "other-repo"
    checkEq("relative_cwd_fixture", RustCsgAddSqliteRelativeCwdRow(path), "")
    let stateRowsProbe = state_db_sqlite.RustCsgStateDbVisiblePageRowsFromStart(path,
                                                                                "updated_at",
                                                                                "desc")
    assertBool("state_rows_probe", stateRowsProbe.row0.ok)

    checkInitialResumeLookup(path, repoCwd, otherCwd)
    checkLatestAndSymlinkLookup(path, repoCwd, otherCwd)
    checkExplicitAndSessionIndexLookup(path, repoCwd, otherCwd)

    echo("rust_csg_exec_resume_lookup_sqlite_smoke ok")
    return 0
