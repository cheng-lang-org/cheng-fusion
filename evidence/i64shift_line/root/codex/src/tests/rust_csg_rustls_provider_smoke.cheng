import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# One-shot initialization guard
# Port of utils/rustls-provider (Rust's Once + call_once pattern).
# ═══════════════════════════════════════════════════════════════════════════════

fn ensureRustlsCryptoProvider(initialized: var bool): bool =
    if initialized:
        return false
    initialized = true
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testFirstCallInitializes(): bool =
    var initialized: bool = false
    let result = ensureRustlsCryptoProvider(initialized)
    if !result:
        return false
    if !initialized:
        return false
    return true

fn testSecondCallReturnsFalse(): bool =
    var initialized: bool = false
    let first = ensureRustlsCryptoProvider(initialized)
    if !first:
        return false
    let second = ensureRustlsCryptoProvider(initialized)
    if second:
        return false
    return true

fn testThirdCallStillFalse(): bool =
    var initialized: bool = false
    let first = ensureRustlsCryptoProvider(initialized)
    if !first:
        return false
    let second = ensureRustlsCryptoProvider(initialized)
    if second:
        return false
    let third = ensureRustlsCryptoProvider(initialized)
    if third:
        return false
    return true

fn testMultipleCallsMaintainState(): bool =
    var initialized: bool = false
    let first = ensureRustlsCryptoProvider(initialized)
    if !first:
        return false
    let second = ensureRustlsCryptoProvider(initialized)
    if second:
        return false
    let third = ensureRustlsCryptoProvider(initialized)
    if third:
        return false
    let fourth = ensureRustlsCryptoProvider(initialized)
    if fourth:
        return false
    let fifth = ensureRustlsCryptoProvider(initialized)
    if fifth:
        return false
    return true

fn testMultipleIndependentGuards(): bool =
    var initA: bool = false
    var initB: bool = false
    let r1a = ensureRustlsCryptoProvider(initA)
    let r1b = ensureRustlsCryptoProvider(initB)
    if !r1a:
        return false
    if !r1b:
        return false
    # Second call on each guard should return false
    let r2a = ensureRustlsCryptoProvider(initA)
    let r2b = ensureRustlsCryptoProvider(initB)
    if r2a:
        return false
    if r2b:
        return false
    return true

fn testPreInitializedReturnsFalse(): bool =
    var initialized: bool = true
    let result = ensureRustlsCryptoProvider(initialized)
    if result:
        return false
    if !initialized:
        return false
    return true

fn testDefaultBoolIsFalse(): bool =
    var initialized: bool
    if initialized:
        return false
    return true

fn testReinitializeAfterReset(): bool =
    var initialized: bool = false
    let first = ensureRustlsCryptoProvider(initialized)
    if !first:
        return false
    # Reset the flag externally (simulating a restart)
    initialized = false
    let second = ensureRustlsCryptoProvider(initialized)
    if !second:
        return false
    # Verify the guard still works after re-init
    let third = ensureRustlsCryptoProvider(initialized)
    if third:
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testFirstCallInitializes(): allOk = false
    if !testSecondCallReturnsFalse(): allOk = false
    if !testThirdCallStillFalse(): allOk = false
    if !testMultipleCallsMaintainState(): allOk = false
    if !testMultipleIndependentGuards(): allOk = false
    if !testPreInitializedReturnsFalse(): allOk = false
    if !testDefaultBoolIsFalse(): allOk = false
    if !testReinitializeAfterReset(): allOk = false
    if allOk:
        echo("rust_csg_rustls_provider_smoke ok")
        return 0
    else:
        echo("rust_csg_rustls_provider_smoke FAILED")
        return 1
