fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgSourceStats =\n        cargoMemberCount: int32\n        rustSourceFileCount: int32\n        typeScriptFileCount: int32\n        tuiSnapshotCount: int32\n        tuiFrameCount: int32\n        productPackageJsonCount: int32\n        unknownRuntimeFileCount: int32\n\n    RustCsgMigrationUnit =\n        sourcePath: str\n        chengModule: str\n        status: str\n        reason: str\n\n    RustCsgSubmission =\n        id: str\n        opType: str\n        traceparent: str\n        tracestate: str\n\n    RustCsgEvent =\n        id: str\n        msgType: str\n        message: str\n\n    RustCsgSessionMeta =\n        id: str\n        forkedFromId: str\n        timestamp: str\n        cwd: str\n        originator: str\n        cliVersion: str\n        source: str\n        agentNickname: str\n        agentRole: str\n        agentPath: str\n        modelProvider: str\n        memoryMode: str\n\n    RustCsgTurnContext =\n        turnId: str\n        traceId: str\n        cwd: str\n        currentDate: str\n        timezone: str\n        approvalPolicy: str\n        sandboxType: str\n        sandboxNetworkAccess: bool\n        model: str\n        personality: str\n        collaborationMode: str\n        realtimeActive: bool\n        effort: str\n        summary: str\n        userInstructions: str\n        developerInstructions: str\n\n    RustCsgAppThread =\n        id: str\n        sessionId: str\n        forkedFromId: str\n        preview: str\n        ephemeral: bool\n        modelProvider: str\n        createdAt: int64\n        updatedAt: int64\n        statusJson: str\n        path: str\n        cwd: str\n        cliVersion: str\n        source: str\n        boundAccountEmail: str\n        agentNickname: str\n        agentRole: str\n        gitInfoJson: str\n        name: str\n        turnsJson: str\n\n    RustCsgAppTurn =\n        id: str\n        itemsJson: str\n        itemsView: str\n        status: str\n        errorJson: str\n        startedAtJson: str\n        completedAtJson: str\n        durationMsJson: str\n\n    RustCsgRolloutConfig =\n        codexHome: str\n        sqliteHome: str\n        cwd: str\n        modelProviderId: str\n        generateMemories: bool\n\n    RustCsgParityStatus =\n        surface: str\n        ported: bool\n        status: str\n        reason: str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tprotocol/types\nLocalType\tprotocol/types\tRustCsgSourceStats\nHasField\tprotocol/types\tRustCsgSourceStats\tcargoMemberCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\trustSourceFileCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\ttypeScriptFileCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\ttuiSnapshotCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\ttuiFrameCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\tproductPackageJsonCount\tint32\nHasField\tprotocol/types\tRustCsgSourceStats\tunknownRuntimeFileCount\tint32\nLocalType\tprotocol/types\tRustCsgMigrationUnit\nHasField\tprotocol/types\tRustCsgMigrationUnit\tsourcePath\tstr\nHasField\tprotocol/types\tRustCsgMigrationUnit\tchengModule\tstr\nHasField\tprotocol/types\tRustCsgMigrationUnit\tstatus\tstr\nHasField\tprotocol/types\tRustCsgMigrationUnit\treason\tstr\nLocalType\tprotocol/types\tRustCsgSubmission\nHasField\tprotocol/types\tRustCsgSubmission\tid\tstr\nHasField\tprotocol/types\tRustCsgSubmission\topType\tstr\nHasField\tprotocol/types\tRustCsgSubmission\ttraceparent\tstr\nHasField\tprotocol/types\tRustCsgSubmission\ttracestate\tstr\nLocalType\tprotocol/types\tRustCsgEvent\nHasField\tprotocol/types\tRustCsgEvent\tid\tstr\nHasField\tprotocol/types\tRustCsgEvent\tmsgType\tstr\nHasField\tprotocol/types\tRustCsgEvent\tmessage\tstr\nLocalType\tprotocol/types\tRustCsgSessionMeta\nHasField\tprotocol/types\tRustCsgSessionMeta\tid\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tforkedFromId\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\ttimestamp\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tcwd\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\toriginator\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tcliVersion\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tsource\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tagentNickname\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tagentRole\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tagentPath\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tmodelProvider\tstr\nHasField\tprotocol/types\tRustCsgSessionMeta\tmemoryMode\tstr\nLocalType\tprotocol/types\tRustCsgTurnContext\nHasField\tprotocol/types\tRustCsgTurnContext\tturnId\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\ttraceId\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tcwd\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tcurrentDate\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\ttimezone\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tapprovalPolicy\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tsandboxType\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tsandboxNetworkAccess\tbool\nHasField\tprotocol/types\tRustCsgTurnContext\tmodel\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tpersonality\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tcollaborationMode\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\trealtimeActive\tbool\nHasField\tprotocol/types\tRustCsgTurnContext\teffort\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tsummary\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tuserInstructions\tstr\nHasField\tprotocol/types\tRustCsgTurnContext\tdeveloperInstructions\tstr\nLocalType\tprotocol/types\tRustCsgAppThread\nHasField\tprotocol/types\tRustCsgAppThread\tid\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tsessionId\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tforkedFromId\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tpreview\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tephemeral\tbool\nHasField\tprotocol/types\tRustCsgAppThread\tmodelProvider\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tcreatedAt\tint64\nHasField\tprotocol/types\tRustCsgAppThread\tupdatedAt\tint64\nHasField\tprotocol/types\tRustCsgAppThread\tstatusJson\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tpath\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tcwd\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tcliVersion\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tsource\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tboundAccountEmail\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tagentNickname\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tagentRole\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tgitInfoJson\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tname\tstr\nHasField\tprotocol/types\tRustCsgAppThread\tturnsJson\tstr\nLocalType\tprotocol/types\tRustCsgAppTurn\nHasField\tprotocol/types\tRustCsgAppTurn\tid\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\titemsJson\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\titemsView\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\tstatus\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\terrorJson\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\tstartedAtJson\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\tcompletedAtJson\tstr\nHasField\tprotocol/types\tRustCsgAppTurn\tdurationMsJson\tstr\nLocalType\tprotocol/types\tRustCsgRolloutConfig\nHasField\tprotocol/types\tRustCsgRolloutConfig\tcodexHome\tstr\nHasField\tprotocol/types\tRustCsgRolloutConfig\tsqliteHome\tstr\nHasField\tprotocol/types\tRustCsgRolloutConfig\tcwd\tstr\nHasField\tprotocol/types\tRustCsgRolloutConfig\tmodelProviderId\tstr\nHasField\tprotocol/types\tRustCsgRolloutConfig\tgenerateMemories\tbool\nLocalType\tprotocol/types\tRustCsgParityStatus\nHasField\tprotocol/types\tRustCsgParityStatus\tsurface\tstr\nHasField\tprotocol/types\tRustCsgParityStatus\tported\tbool\nHasField\tprotocol/types\tRustCsgParityStatus\tstatus\tstr\nHasField\tprotocol/types\tRustCsgParityStatus\treason\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    assert(ect == 10, "type count")
    assert(ecf == 82, "field count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    assert(oct == 10, "oracle type count")
    assert(ocf == 82, "oracle field count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")

    echo("rust_csg_protocol_types_relfacts_smoke ok")
    return 0
