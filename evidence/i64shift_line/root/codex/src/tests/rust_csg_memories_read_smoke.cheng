import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: memories/read — memory context + user prompt template composition
# ═══════════════════════════════════════════════════════════════════════════════

# ── memoriesReadBuildContext: builds a full memory context string ────────────
# Takes a comma-separated list of memory items and a user prompt, and builds
# a formatted memory context block. Memory items are formatted as individual
# entries within a <memory_context> block. Returns just the user prompt if
# items list is empty.

fn memoriesReadBuildContext(items: str, userPrompt: str): str =
    if items.len == 0:
        return userPrompt
    var ctx: str
    ctx = strings.ConcatStr(ctx, "<memory_context>\n")
    var i: int32 = 0
    var entryStart: int32 = 0
    while i < items.len:
        if items[i] == ',':
            var entry: str
            var si: int32 = entryStart
            while si < i:
                entry = strings.ConcatStr(entry, strings.SliceBytes(items, si, 1))
                si = si + 1
            if entry.len > 0:
                ctx = strings.ConcatStr(ctx, "  <entry>")
                ctx = strings.ConcatStr(ctx, entry)
                ctx = strings.ConcatStr(ctx, "</entry>\n")
            i = i + 1
            entryStart = i
        else:
            i = i + 1
    # Last entry
    if entryStart < items.len:
        var entry: str
        var si: int32 = entryStart
        while si < items.len:
            entry = strings.ConcatStr(entry, strings.SliceBytes(items, si, 1))
            si = si + 1
        if entry.len > 0:
            ctx = strings.ConcatStr(ctx, "  <entry>")
            ctx = strings.ConcatStr(ctx, entry)
            ctx = strings.ConcatStr(ctx, "</entry>\n")
    ctx = strings.ConcatStr(ctx, "</memory_context>\n")
    ctx = strings.ConcatStr(ctx, userPrompt)
    return ctx

# Template parts for composing the memory prompt.
# Non-variable entries are literal text; "memory_contents" and "user_prompt"
# are variable placeholders substituted at render time.
# NOTE: const str array is broken at runtime (finding #23), so templates are
# inlined in the function body.

fn RustCsgMemoriesReadBuildMemoryPrompt(memoryContents: str, userPrompt: str): str =
    if memoryContents.len == 0:
        return userPrompt
    return strutil.Join([
        "Context from your previous sessions:\n---\n",
        memoryContents,
        "\n---\n\nUser request:\n",
        userPrompt,
    ], "")

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn strFind(text: str, needle: str): int32 =
    if needle.len == 0:
        return 0
    var i: int32 = 0
    while i < text.len:
        var j: int32 = 0
        while j < needle.len && i + j < text.len:
            if text[i + j] != needle[j]:
                break
            j = j + 1
        if j == needle.len:
            return i
        i = i + 1
    return -1

fn checkContains(text: str, needle: str): bool =
    return strFind(text, needle) >= 0

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn testBuildMemoryPromptWithBoth(): bool =
    var ok: bool = true
    let result = RustCsgMemoriesReadBuildMemoryPrompt("User likes Python", "Write a script")
    if !checkContains(result, "User likes Python"):
        echo("FAIL: memory contents missing from prompt")
        ok = false
    if !checkContains(result, "Write a script"):
        echo("FAIL: user prompt missing from prompt")
        ok = false
    if ok:
        echo("testBuildMemoryPromptWithBoth ok")
    return ok

fn testBuildMemoryPromptEmptyMemory(): bool =
    var ok: bool = true
    let result = RustCsgMemoriesReadBuildMemoryPrompt("", "Hello")
    if !checkEq(result, "Hello"):
        ok = false
    if ok:
        echo("testBuildMemoryPromptEmptyMemory ok")
    return ok

fn testBuildMemoryPromptEmptyBoth(): bool =
    var ok: bool = true
    let result = RustCsgMemoriesReadBuildMemoryPrompt("", "")
    if !checkEq(result, ""):
        ok = false
    if ok:
        echo("testBuildMemoryPromptEmptyBoth ok")
    return ok

fn testBuildMemoryPromptMultilineMemory(): bool =
    var ok: bool = true
    let mem = strutil.Join(["User prefers Go", "User works on distributed systems", "User has 10 years experience"], "\n")
    let result = RustCsgMemoriesReadBuildMemoryPrompt(mem, "Review this code")
    if !checkContains(result, "User prefers Go"):
        ok = false
    if !checkContains(result, "Review this code"):
        ok = false
    if !checkContains(result, "10 years"):
        ok = false
    if ok:
        echo("testBuildMemoryPromptMultilineMemory ok")
    return ok

fn testBuildMemoryPromptMemoryWithSpecialChars(): bool =
    var ok: bool = true
    let mem = strutil.Join(["User's project uses C++ and C#", "API key: sk-abc123"], "\n")
    let result = RustCsgMemoriesReadBuildMemoryPrompt(mem, "Check config")
    if !checkContains(result, "C++"):
        ok = false
    if !checkContains(result, "sk-abc123"):
        ok = false
    if !checkContains(result, "Check config"):
        ok = false
    if ok:
        echo("testBuildMemoryPromptMemoryWithSpecialChars ok")
    return ok

fn testBuildMemoryPromptPreservesOrder(): bool =
    var ok: bool = true
    let result = RustCsgMemoriesReadBuildMemoryPrompt("MEMORY_BLOCK", "USER_PROMPT")
    let memIdx = strFind(result, "MEMORY_BLOCK")
    let promptIdx = strFind(result, "USER_PROMPT")
    if memIdx < 0:
        echo("FAIL: memory block not found")
        ok = false
    elif promptIdx < 0:
        echo("FAIL: user prompt not found")
        ok = false
    elif memIdx > promptIdx:
        echo("FAIL: memory block should appear before user prompt")
        ok = false
    if ok:
        echo("testBuildMemoryPromptPreservesOrder ok")
    return ok

# ── Test: memoriesReadBuildContext ───────────────────────────────────────────

fn testMemoriesReadBuildContextWithItems(): bool =
    var ok: bool = true
    let result = memoriesReadBuildContext("User likes Go,User prefers brevity", "Write code")
    if !checkContains(result, "<memory_context>"):
        echo("FAIL: missing memory_context open tag")
        ok = false
    if !checkContains(result, "</memory_context>"):
        echo("FAIL: missing memory_context close tag")
        ok = false
    if !checkContains(result, "User likes Go"):
        echo("FAIL: missing first item")
        ok = false
    if !checkContains(result, "User prefers brevity"):
        echo("FAIL: missing second item")
        ok = false
    if !checkContains(result, "Write code"):
        echo("FAIL: missing user prompt")
        ok = false
    if ok:
        echo("testMemoriesReadBuildContextWithItems ok")
    return ok

fn testMemoriesReadBuildContextEmptyItems(): bool =
    var ok: bool = true
    let result = memoriesReadBuildContext("", "Just a prompt")
    if !checkEq(result, "Just a prompt"):
        ok = false
    if ok:
        echo("testMemoriesReadBuildContextEmptyItems ok")
    return ok

fn testMemoriesReadBuildContextSingleItem(): bool =
    var ok: bool = true
    let result = memoriesReadBuildContext("Only one item", "Do something")
    if !checkContains(result, "Only one item"):
        ok = false
    if !checkContains(result, "Do something"):
        ok = false
    if ok:
        echo("testMemoriesReadBuildContextSingleItem ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testBuildMemoryPromptWithBoth(): allOk = false
    if !testBuildMemoryPromptEmptyMemory(): allOk = false
    if !testBuildMemoryPromptEmptyBoth(): allOk = false
    if !testBuildMemoryPromptMultilineMemory(): allOk = false
    if !testBuildMemoryPromptMemoryWithSpecialChars(): allOk = false
    if !testBuildMemoryPromptPreservesOrder(): allOk = false
    if !testMemoriesReadBuildContextWithItems(): allOk = false
    if !testMemoriesReadBuildContextEmptyItems(): allOk = false
    if !testMemoriesReadBuildContextSingleItem(): allOk = false
    if allOk:
        echo("rust_csg_memories_read_smoke ok")
        return 0
    else:
        echo("rust_csg_memories_read_smoke FAILED")
        return 1
