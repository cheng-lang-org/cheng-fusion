import std/cmdline
import std/strings
import cheng/codex/tui/oracle_inventory as inventory

fn parsePositiveI32(text: str): int32 =
    let n: int32 = strings.Len(text)
    if n <= 0:
        return -1
    var i: int32 = 0
    var value: int32 = 0
    while i < n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            return -1
        value = value * 10 + (int32(ch) - int32('0'))
        i = i + 1
    return value

fn checkI32(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strings.ConcatStr(strings.ConcatStr("FAIL ", label),
                               strings.ConcatStr(" expected=", strings.ConcatStr(strings.IntToStr(expected),
                                                                                  strings.ConcatStr(" got=", strings.IntToStr(got))))))
        return false
    echo(strings.ConcatStr(strings.ConcatStr(label, "="), strings.IntToStr(got)))
    return true

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_tui_oracle_inventory_smoke <source_root> <expected_snapshots> <expected_frames> <expected_frame_groups>")
        return 1
    let expectedSnapshots: int32 = parsePositiveI32(cmdline.argStr(2))
    let expectedFrames: int32 = parsePositiveI32(cmdline.argStr(3))
    let expectedGroups: int32 = parsePositiveI32(cmdline.argStr(4))
    if expectedSnapshots < 0 || expectedFrames < 0 || expectedGroups < 0:
        echo("FAIL expected counts must be decimal int32")
        return 1
    let inv = inventory.RustCsgTuiOracleInventoryFromSourceRoot(cmdline.argStr(1))
    if !inv.ok:
        echo(strings.ConcatStr("FAIL ", inv.error))
        return 1
    echo(strings.ConcatStr("source_root=", inv.sourceRoot))
    if !checkI32("snapshot_count", inv.snapshotCount, expectedSnapshots):
        return 1
    if !checkI32("frame_count", inv.frameCount, expectedFrames):
        return 1
    if !checkI32("frame_group_count", inv.frameGroupCount, expectedGroups):
        return 1
    if !checkI32("frame_files_per_group", inv.frameFilesPerGroup, 36):
        return 1
    if !checkI32("frame_lines_per_file", inv.frameLinesPerFile, 17):
        return 1
    if inv.snapshotBytes <= int64(0) || inv.frameBytes <= int64(0):
        echo("FAIL oracle byte counts must be positive")
        return 1
    if strings.Len(inv.firstSnapshotPath) == 0 || strings.Len(inv.firstFramePath) == 0:
        echo("FAIL first oracle paths must be non-empty")
        return 1
    echo("rust_csg_tui_oracle_inventory_smoke ok")
    return 0
