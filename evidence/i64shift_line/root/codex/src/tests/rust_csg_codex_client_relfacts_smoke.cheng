fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgHttpTransport =\n        execute: fn\n        stream: fn\n\n    RustCsgReqwestTransport =\n        client: codex_http_client\n\n    RustCsgRetryPolicy =\n        max_attempts: u64\n        base_delay: duration\n        retry_on: retry_on\n\n    RustCsgRetryOn =\n        retry_429: bool\n        retry_5xx: bool\n        retry_transport: bool\n\n    RustCsgTransportError =\n        Http\n        RetryLimit\n        Timeout\n        Network\n        Build\n\n    RustCsgStreamError =\n        Stream\n        Timeout\n\n    RustCsgRequest =\n        method: http_method\n        url: str\n        headers: header_map\n        body: opt_request_body\n        compression: request_compression\n        timeout: opt_duration\n\n    RustCsgRequestBody =\n        Json\n        Raw\n\n    RustCsgRequestCompression =\n        None\n        Zstd\n\n    RustCsgResponse =\n        status: http_status_code\n        headers: header_map\n        body: bytes\n\n    RustCsgPreparedRequestBody =\n        headers: header_map\n        body: opt_bytes\n\n    RustCsgStreamResponse =\n        status: http_status_code\n        headers: header_map\n        bytes: byte_stream\n\n    RustCsgCodexHttpClient =\n        inner: reqwest_client\n\n    RustCsgCodexRequestBuilder =\n        builder: reqwest_request_builder\n        method: http_method\n        url: str\n\nfn backoff(attempt: int32): int64 =\nfn runWithRetry(request: str, policy: str): str =\nfn sseStream(url: str): str =\nfn buildRetryPolicy(maxRetries: int32, baseDelayMs: int32): str =\nfn buildRequestId(): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tcodex_client\nLocalType\tcodex_client\tRustCsgHttpTransport\nHasField\tcodex_client\tRustCsgHttpTransport\texecute\tfn\nHasField\tcodex_client\tRustCsgHttpTransport\tstream\tfn\nLocalType\tcodex_client\tRustCsgReqwestTransport\nHasField\tcodex_client\tRustCsgReqwestTransport\tclient\tcodex_http_client\nLocalType\tcodex_client\tRustCsgRetryPolicy\nHasField\tcodex_client\tRustCsgRetryPolicy\tmax_attempts\tu64\nHasField\tcodex_client\tRustCsgRetryPolicy\tbase_delay\tduration\nHasField\tcodex_client\tRustCsgRetryPolicy\tretry_on\tretry_on\nLocalType\tcodex_client\tRustCsgRetryOn\nHasField\tcodex_client\tRustCsgRetryOn\tretry_429\tbool\nHasField\tcodex_client\tRustCsgRetryOn\tretry_5xx\tbool\nHasField\tcodex_client\tRustCsgRetryOn\tretry_transport\tbool\nLocalType\tcodex_client\tRustCsgTransportError\nLocalType\tcodex_client\tRustCsgStreamError\nLocalType\tcodex_client\tRustCsgRequest\nHasField\tcodex_client\tRustCsgRequest\tmethod\thttp_method\nHasField\tcodex_client\tRustCsgRequest\turl\tstr\nHasField\tcodex_client\tRustCsgRequest\theaders\theader_map\nHasField\tcodex_client\tRustCsgRequest\tbody\topt_request_body\nHasField\tcodex_client\tRustCsgRequest\tcompression\trequest_compression\nHasField\tcodex_client\tRustCsgRequest\ttimeout\topt_duration\nLocalType\tcodex_client\tRustCsgRequestBody\nLocalType\tcodex_client\tRustCsgRequestCompression\nLocalType\tcodex_client\tRustCsgResponse\nHasField\tcodex_client\tRustCsgResponse\tstatus\thttp_status_code\nHasField\tcodex_client\tRustCsgResponse\theaders\theader_map\nHasField\tcodex_client\tRustCsgResponse\tbody\tbytes\nLocalType\tcodex_client\tRustCsgPreparedRequestBody\nHasField\tcodex_client\tRustCsgPreparedRequestBody\theaders\theader_map\nHasField\tcodex_client\tRustCsgPreparedRequestBody\tbody\topt_bytes\nLocalType\tcodex_client\tRustCsgStreamResponse\nHasField\tcodex_client\tRustCsgStreamResponse\tstatus\thttp_status_code\nHasField\tcodex_client\tRustCsgStreamResponse\theaders\theader_map\nHasField\tcodex_client\tRustCsgStreamResponse\tbytes\tbyte_stream\nLocalType\tcodex_client\tRustCsgCodexHttpClient\nHasField\tcodex_client\tRustCsgCodexHttpClient\tinner\treqwest_client\nLocalType\tcodex_client\tRustCsgCodexRequestBuilder\nHasField\tcodex_client\tRustCsgCodexRequestBuilder\tbuilder\treqwest_request_builder\nHasField\tcodex_client\tRustCsgCodexRequestBuilder\tmethod\thttp_method\nHasField\tcodex_client\tRustCsgCodexRequestBuilder\turl\tstr\nFunction\tcodex_client\tbackoff\tint64\nFunction\tcodex_client\trunWithRetry\tstr\nFunction\tcodex_client\tsseStream\tstr\nFunction\tcodex_client\tbuildRetryPolicy\tstr\nFunction\tcodex_client\tbuildRequestId\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 14, "source type count")
    assert(ecf == 27, "source field count")
    assert(ecn == 5, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 14, "oracle type count")
    assert(ocf == 27, "oracle field count")
    assert(ocn == 5, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_codex_client_relfacts_smoke ok")
    return 0
