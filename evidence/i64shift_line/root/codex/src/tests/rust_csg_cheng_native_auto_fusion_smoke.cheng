import std/strings
import cheng/codex/app_server/cheng_agent_runtime as agent_runtime
import cheng/codex/app_server/cheng_evidence_ledger as ledger
import cheng/codex/app_server/cheng_native_tools as native
import cheng/codex/app_server/cheng_training_trace as training
import cheng/codex/app_server/cheng_tool_registry as registry
import cheng/codex/app_server/cheng_toolchain_resolver as resolver
import cheng/codex/app_server/cheng_write_gate as gate
import cheng/codex/app_server/cheng_write_gateway as gateway
import cheng/codex/protocol/wire

@abi_internal
@importc("RustCsgWriteFile")
fn smokeWriteFile(path: str, content: str): int32

@importc("RustCsgGetCurrentTimeMs")
fn smokeNowMs(): int64

fn assertContains(name: str, text: str, needle: str) =
    if !strings.StrContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(strings.StrContains(text, needle), name)

fn assertNotContains(name: str, text: str, needle: str) =
    if strings.StrContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(!strings.StrContains(text, needle), name)

fn main(): int32 =
    ledger.ChengEvidenceLedgerReset()
    let root = resolver.ChengToolchainCurrentRoot()

    let missing = resolver.ChengToolchainResolveOne("/definitely/missing/cheng/root",
                                                    "CHENG_NATIVE_AUTO_FUSION_MISSING",
                                                    "missing-tool",
                                                    "missing tool")
    assert(!missing.ok, "resolver hard-fails missing executable")
    assertContains("resolver missing error", missing.error, "not found")

    let sh = resolver.ChengToolchainResolveOne("",
                                               "CHENG_NATIVE_AUTO_FUSION_MISSING",
                                               "/bin/sh",
                                               "shell")
    assert(sh.ok, "resolver accepts real executable fallback")

    let nonChengTools = native.ChengNativeAppendToolsForInput("[]", "hello world")
    assert(nonChengTools == "[]", "non-Cheng prompt does not receive Cheng tools")
    let chengTools = native.ChengNativeAppendToolsForInput("[]", "please inspect src/main.cheng")
    assertNotContains("legacy CSG tool is absent", chengTools, "cheng_csg_emit")
    assertContains("Cheng prompt receives LSP tool", chengTools, "cheng_lsp_snapshot")
    assertContains("Cheng prompt receives debugger tool", chengTools, "cheng_debug_report")
    let tsCsgTools = native.ChengNativeAppendToolsForInput("[]", "inspect TypeScript ts-csg runtime closure")
    assertContains("TS-CSG prompt receives emit tool", tsCsgTools, "ts_csg_emit")
    assertContains("TS-CSG prompt receives runtime closure tool", tsCsgTools, "ts_csg_runtime_closure")
    let dataTools = native.ChengNativeAppendToolsForInput("[]", "verify agent trace and export training trace")
    assertContains("data loop prompt receives verify tool", dataTools, "cheng_agent_trace_verify")
    assertContains("data loop prompt receives export tool", dataTools, "cheng_agent_trace_export_jsonl")
    let readonlyTools = native.ChengNativeAppendToolsForRole("[]", "please inspect src/main.cheng", "readonly")
    assertContains("readonly prompt receives LSP snapshot", readonlyTools, "cheng_lsp_snapshot")
    assertNotContains("readonly prompt excludes native compile/run", readonlyTools, "cheng_native_compile_run")
    let readonlyWriteBlocked = native.ChengNativeHandleToolCallForRole(30,
                                                                       "cheng_training_trace_record",
                                                                       "{\"outDir\":\"/tmp\",\"traceId\":\"blocked\",\"instruction\":\"blocked\",\"outcome\":\"success\",\"validationStatus\":\"passed\"}",
                                                                       "readonly")
    assertContains("readonly role rejects trace writer", readonlyWriteBlocked, "\"success\":false")
    assertContains("readonly role rejection explains role", readonlyWriteBlocked, "not allowed")
    assert(native.ChengNativeIsTool("cheng_profile_report"), "native tool classification")
    assert(native.ChengNativeIsTool("cheng_debug_report"), "debug report native tool classification")
    assert(native.ChengNativeIsTool("cheng_print_line_map"), "line map native tool classification")
    assert(native.ChengNativeIsTool("cheng_print_symbols"), "symbols native tool classification")
    assert(native.ChengNativeIsTool("cheng_profile_run"), "profile-run native tool classification")
    assert(native.ChengNativeIsTool("ts_csg_emit"), "TS-CSG native tool classification")
    assert(native.ChengNativeIsTool("cheng_training_trace_record"), "training trace native tool classification")
    assert(native.ChengNativeIsReadOnlyTool("cheng_lsp_snapshot"), "read-only tool classification")
    assert(!native.ChengNativeIsReadOnlyTool("cheng_training_trace_record"), "data writer is not read-only")
    assert(registry.ChengToolRegistryHandlerKind("cheng_csg_query") == 0, "legacy CSG query is not registered")
    assert(!ledger.ChengEvidenceSourceKnown("cheng.csg"), "legacy CSG evidence is not authoritative")
    assert(registry.ChengToolRegistryToolAllowedForRole("cheng_lsp_snapshot", "readonly"), "registry role allows read-only tool")
    assert(!registry.ChengToolRegistryToolAllowedForRole("cheng_training_trace_record", "readonly"), "registry role blocks writer tool")
    assert(ledger.ChengEvidenceSourceKnown("ts_csg_runtime_closure"), "TS-CSG evidence source classification")
    assert(ledger.ChengEvidenceSourceKnown("cheng.debugger"), "debugger evidence source classification")
    assert(ledger.ChengEvidenceSourceKnown("cheng.profile"), "profile evidence source classification")
    assert(!native.ChengNativeIsTool("read"), "non-Cheng native classification")

    let csgEmitFail = native.ChengNativeHandleToolCall(3, "cheng_csg_emit", "{}")
    assertContains("legacy CSG emit is rejected", csgEmitFail, "unknown Cheng native tool")

    let lspSnapshot = native.ChengNativeHandleToolCall(4, "cheng_lsp_snapshot", "{\"root\":\"/definitely/missing/cheng/root\",\"path\":\"/tmp/missing.cheng\",\"text\":\"fn main(): int32 =\\n    return 0\\n\"}")
    if strings.StrContains(lspSnapshot, "\"success\":true"):
        assertContains("LSP success records evidence", lspSnapshot, "cheng.lsp")
    else:
        assertContains("LSP missing command hard-fails", lspSnapshot, "\"success\":false")
    let lspBadRange = native.ChengNativeHandleToolCall(41, "cheng_lsp_code_action_preview", "{\"path\":\"/tmp/missing.cheng\",\"text\":\"fn main(): int32 =\\n    return 0\\n\",\"range\":{\"start\":{\"line\":1,\"character\":2}}}")
    assertContains("LSP code action invalid range hard-fails", lspBadRange, "\"success\":false")
    assertContains("LSP code action range validation", lspBadRange, "range requires start and end")

    var crashArgs = "{"
    let crashRawPath = "/tmp/cheng_native_auto_fusion_crash_raw.txt"
    assert(smokeWriteFile(crashRawPath, "cheng_crash_raw_v1\nreason=segv\nregs pc=0x1\nm#0 main /tmp/main.cheng:1\n") != 0, "write crash raw fixture")
    crashArgs = wire.RustCsgCat(crashArgs, wire.RustCsgJsonFieldStr("root", "/definitely/missing/cheng/root"))
    crashArgs = wire.RustCsgCat(crashArgs, ",")
    crashArgs = wire.RustCsgCat(crashArgs, wire.RustCsgJsonFieldStr("sourcePath", "/tmp/main.cheng"))
    crashArgs = wire.RustCsgCat(crashArgs, ",")
    crashArgs = wire.RustCsgCat(crashArgs, wire.RustCsgJsonFieldStr("rawPath", crashRawPath))
    crashArgs = wire.RustCsgCat(crashArgs, ",")
    crashArgs = wire.RustCsgCat(crashArgs, wire.RustCsgJsonFieldStr("reportOut", "/tmp/cheng_native_auto_fusion_crash_report.txt"))
    crashArgs = wire.RustCsgCat(crashArgs, "}")
    let crashReport = native.ChengNativeHandleToolCall(5, "cheng_crash_report", crashArgs)
    let crashAvailable = strings.StrContains(crashReport, "\"success\":true")
    if crashAvailable:
        assertContains("crash report records debugger evidence", crashReport, "cheng.debugger")
    else:
        assertContains("crash report hard-fails without real command", crashReport, "\"success\":false")
        assertNotContains("crash report failure has no success evidence", crashReport, "\"source\":\"cheng.debugger\"")

    if crashAvailable:
        var badCrashArgs = "{"
        badCrashArgs = wire.RustCsgCat(badCrashArgs, wire.RustCsgJsonFieldStr("root", root))
        badCrashArgs = wire.RustCsgCat(badCrashArgs, ",")
        badCrashArgs = wire.RustCsgCat(badCrashArgs, wire.RustCsgJsonFieldStr("rawText", "trace trap\n"))
        badCrashArgs = wire.RustCsgCat(badCrashArgs, "}")
        let badCrashReport = native.ChengNativeHandleToolCall(51, "cheng_crash_report", badCrashArgs)
        assertContains("ordinary crash text hard-fails", badCrashReport, "\"success\":false")

    if crashAvailable:
        var profileArgs = "{"
        profileArgs = wire.RustCsgCat(profileArgs, wire.RustCsgJsonFieldStr("root", root))
        profileArgs = wire.RustCsgCat(profileArgs, ",")
        profileArgs = wire.RustCsgCat(profileArgs, wire.RustCsgJsonFieldStr("sourcePath", "/tmp/main.cheng"))
        profileArgs = wire.RustCsgCat(profileArgs, ",")
        profileArgs = wire.RustCsgCat(profileArgs, wire.RustCsgJsonFieldStr("rawText", "cheng_profile_raw\ntotal_samples=1\ndropped_samples=0\nsample\t0x1\tmain\t/tmp/main.cheng:1\n"))
        profileArgs = wire.RustCsgCat(profileArgs, "}")
        let profileReport = native.ChengNativeHandleToolCall(6, "cheng_profile_report", profileArgs)
        assertContains("profile report records profile evidence", profileReport, "cheng.profile")
        var badProfileArgs = "{"
        badProfileArgs = wire.RustCsgCat(badProfileArgs, wire.RustCsgJsonFieldStr("root", root))
        badProfileArgs = wire.RustCsgCat(badProfileArgs, ",")
        badProfileArgs = wire.RustCsgCat(badProfileArgs, wire.RustCsgJsonFieldStr("rawText", "samples: fake\n"))
        badProfileArgs = wire.RustCsgCat(badProfileArgs, "}")
        let badProfileReport = native.ChengNativeHandleToolCall(61, "cheng_profile_report", badProfileArgs)
        assertContains("bad raw profile hard-fails", badProfileReport, "\"success\":false")

    let traceReport = native.ChengNativeHandleToolCall(7, "cheng_trace_map", "{}")
    assertContains("legacy trace map is rejected", traceReport, "unknown Cheng native tool")

    ledger.ChengEvidenceLedgerReset()
    var gateReason: str
    let blocked = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/auto_fusion_gate.cheng", int64(1000), gateReason)
    assert(!blocked, "write gate blocks without evidence")
    assertContains("write gate missing evidence", gateReason, "missing fresh Cheng LSP")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/auto_fusion_gate.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          int64(1000))
    let allowed = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/auto_fusion_gate.cheng", int64(1001), gateReason)
    assert(allowed, "write gate allows fresh same-file LSP evidence")
    let sourceBlocked = gate.ChengWriteGateCheckAllowedAt("remove", "/tmp/project/src/core/demo.cheng", int64(1001), gateReason)
    assert(!sourceBlocked, "source mutation requires CSG")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.csg",
                                          "/tmp/project",
                                          0,
                                          0,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "roundtrip",
                                          "ok",
                                          "roundtrip",
                                          int64(1001))
    assert(!ledger.ChengEvidenceHasFresh("cheng.csg", "/tmp/project/src/core/demo.cheng", int64(1002)),
           "legacy CSG evidence never becomes path-scoped freshness")
    assert(!ledger.ChengEvidenceHasFreshAnyPath("cheng.csg", int64(1002)),
           "legacy CSG evidence never becomes global freshness")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/src/core/demo.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          int64(1001))
    let sourceAllowed = gate.ChengWriteGateCheckAllowedAt("remove", "/tmp/project/src/core/demo.cheng", int64(1002), gateReason)
    assert(!sourceAllowed, "untrusted legacy CSG evidence cannot authorize source mutation")
    assertContains("source mutation requires canonical CSGC authority", gateReason, "CSG")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/src/core/demo.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          smokeNowMs())
    gateway.ChengWriteGatewayReset()
    var legacyGatewayReason: str
    let legacyGatewayBlocked = gateway.ChengWriteGatewayCheckAllowed("remove", "/tmp/project/src/core/demo.cheng", legacyGatewayReason)
    assert(!legacyGatewayBlocked, "write gateway blocks without canonical CSGC authority")
    assertContains("write gateway denial requires canonical CSGC authority", legacyGatewayReason, "canonical CSGC authority")
    let legacyGatewayEvents = gateway.ChengWriteGatewayEventsJson()
    assertContains("blocked gateway event records canonical CSGC authority", legacyGatewayEvents, "cheng.csgc.authority")
    assertContains("blocked gateway event records denial", legacyGatewayEvents, "\"allowed\":false")
    assertContains("blocked gateway event marks authority required", legacyGatewayEvents, "\"required\":true")
    assertContains("blocked gateway exposes canonical authority requirement",
                   gateway.ChengWriteGatewayValidationRequirementsJson(),
                   "cheng.csgc.authority")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/debug_tools.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          int64(1002))
    let debugBlocked = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/debug_tools.cheng", int64(1002), gateReason)
    assert(!debugBlocked, "debug source mutation requires debugger/profile evidence")
    assertContains("debug source missing debugger/profile evidence", gateReason, "debugger/profile")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.debugger",
                                          "/tmp/project/debug_tools.cheng",
                                          1,
                                          1,
                                          "debug_tools",
                                          "",
                                          "",
                                          "/tmp/debug-tools.report.txt",
                                          "debug-report",
                                          "ok",
                                          "/tmp/debug-tools.report.txt",
                                          int64(1002))
    let debugAllowed = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/debug_tools.cheng", int64(1003), gateReason)
    assert(debugAllowed, "debug source mutation allows fresh debugger evidence")
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/src/core/runtime/node_host_runtime.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          int64(1002))
    let providerBlocked = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/src/core/runtime/node_host_runtime.cheng", int64(1002), gateReason)
    assert(!providerBlocked, "runtime provider mutation requires TS-CSG closure")
    assertContains("runtime provider missing canonical CSGC authority", gateReason, "CSG")
    let providerClosureEvidence = ledger.ChengEvidenceLedgerAdd("ts_csg_runtime_closure",
                                                                "/tmp/project/tsconfig.json",
                                                                0,
                                                                0,
                                                                "",
                                                                "",
                                                                "",
                                                                "/tmp/project/runtime-closure.json",
                                                                "ts-csg --emit runtime-closure",
                                                                "ok",
                                                                "/tmp/project/runtime-closure.json",
                                                                int64(1002))
    assertContains("runtime provider closure evidence source", providerClosureEvidence, "ts_csg_runtime_closure")
    assert(ledger.ChengEvidenceHasFreshAnyPath("ts_csg_runtime_closure", int64(1003)), "fresh runtime closure evidence is visible")
    let providerAllowed = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/src/core/runtime/node_host_runtime.cheng", int64(1003), gateReason)
    assert(!providerAllowed, "runtime provider remains blocked without canonical CSGC authority")
    ledger.ChengEvidenceLedgerReset()
    let tsCsgBlocked = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/ts-csg/src/runtime-providers.ts", int64(2000), gateReason)
    assert(!tsCsgBlocked, "TS-CSG source mutation requires TS-CSG emit evidence")
    let _ = ledger.ChengEvidenceLedgerAdd("ts_csg_emit",
                                          "/tmp/project/tsconfig.json",
                                          0,
                                          0,
                                          "",
                                          "",
                                          "",
                                          "/tmp/project/csg-core.report.json",
                                          "ts-csg --emit csg-core",
                                          "ok",
                                          "/tmp/project/csg-core.jsonl",
                                          int64(2000))
    let tsCsgClosureBlocked = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/ts-csg/src/runtime-providers.ts", int64(2001), gateReason)
    assert(!tsCsgClosureBlocked, "runtime provider TS-CSG source requires closure evidence")
    let _ = ledger.ChengEvidenceLedgerAdd("ts_csg_runtime_closure",
                                          "/tmp/project/tsconfig.json",
                                          0,
                                          0,
                                          "",
                                          "",
                                          "",
                                          "/tmp/project/runtime-closure.json",
                                          "ts-csg --emit runtime-closure",
                                          "ok",
                                          "/tmp/project/runtime-closure.json",
                                          int64(2001))
    let tsCsgAllowed = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/ts-csg/src/runtime-providers.ts", int64(2002), gateReason)
    assert(tsCsgAllowed, "TS-CSG source mutation allows fresh emit and closure evidence")
    ledger.ChengEvidenceLedgerReset()
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/src/core/demo.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostics",
                                          int64(1001))
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.csg",
                                          "/tmp/project",
                                          0,
                                          0,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "roundtrip",
                                          "ok",
                                          "roundtrip",
                                          int64(1001))
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/project/src/core/demo.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ownership_violation",
                                          "ownership/no-pointer",
                                          int64(1002))
    let violation = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/src/core/demo.cheng", int64(1003), gateReason)
    assert(!violation, "write gate blocks ownership/no-pointer violation")
    let expiredViolation = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/project/src/core/demo.cheng", int64(601003), gateReason)
    assert(!expiredViolation, "expired violation still lacks fresh LSP evidence")

    ledger.ChengEvidenceLedgerReset()
    let _ = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                          "/tmp/auto_fusion_escape.cheng",
                                          1,
                                          1,
                                          "",
                                          "",
                                          "",
                                          "",
                                          "lsp",
                                          "ok",
                                          "diagnostic says \"hello\"\nnext line with long non-violation detail",
                                          int64(1000))
    let escapedLedgerJson = ledger.ChengEvidenceLedgerJson()
    assertContains("ledger emits evidence id", escapedLedgerJson, "cheng-evidence-1")
    assertContains("ledger escapes quotes", escapedLedgerJson, "\\\"hello\\\"")
    assertContains("ledger escapes newline", escapedLedgerJson, "\\nnext line")
    let longDetailAllowed = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/auto_fusion_escape.cheng", int64(1001), gateReason)
    assert(longDetailAllowed, "long ok detail is not an ownership/no-pointer violation")
    let staleLsp = gate.ChengWriteGateCheckAllowedAt("writeFile", "/tmp/auto_fusion_escape.cheng", int64(601001), gateReason)
    assert(!staleLsp, "write gate rejects expired LSP evidence")
    assert(!ledger.ChengEvidencePathMatches("escape.cheng", "/tmp/auto_fusion_escape.cheng"), "ledger does not suffix-match paths")
    assert(ledger.ChengEvidencePathMatches("/tmp/project", "/tmp/project/src/core/demo.cheng"), "ledger allows directory evidence scope")

    agent_runtime.ChengAgentRuntimeBeginTurn("thread-1", "turn-1", "modify Cheng source")
    var gatewayReason: str
    let gatewayBlocked = gateway.ChengWriteGatewayCheckAllowed("writeFile", "/tmp/agent_runtime_gate.cheng", gatewayReason)
    assert(!gatewayBlocked, "write gateway blocks without evidence")
    assertContains("write gateway records event", gateway.ChengWriteGatewayEventsJson(), "beforeWrite")
    let scopedEvidence = ledger.ChengEvidenceLedgerAdd("cheng.lsp",
                                                       "/tmp/agent_runtime_gate.cheng",
                                                       1,
                                                       1,
                                                       "",
                                                       "",
                                                       "",
                                                       "",
                                                       "lsp",
                                                       "ok",
                                                       "diagnostics",
                                                       smokeNowMs())
    assertContains("scoped evidence created", scopedEvidence, "cheng-evidence")
    let gatewayAllowed = gateway.ChengWriteGatewayCheckAllowed("writeFile", "/tmp/agent_runtime_gate.cheng", gatewayReason)
    assert(gatewayAllowed, "write gateway allows fresh scoped evidence")
    gateway.ChengWriteGatewayRecordAfter("writeFile", "/tmp/agent_runtime_gate.cheng", true, "write ok")
    let gatewayRequirements = gateway.ChengWriteGatewayValidationRequirementsJson()
    assertContains("write gateway records structured validation requirement", gatewayRequirements, "cheng.write_validation_requirement.v1")
    assertContains("write gateway validation requires LSP", gatewayRequirements, "cheng.lsp")
    agent_runtime.ChengAgentRuntimeRecordNativeToolCall("cheng_lsp_snapshot", "{}", "{\"result\":{\"success\":true}}")
    let runtimeSnapshotFailed = agent_runtime.ChengAgentRuntimeSnapshotJson("")
    assertContains("agent runtime snapshot schema", runtimeSnapshotFailed, "cheng.agent_runtime.v1")
    assertContains("agent runtime records write denial", runtimeSnapshotFailed, "\"writeDeniedCount\":1")
    assertContains("agent runtime records validation requirements", runtimeSnapshotFailed, "validationRequirements")
    assertContains("agent runtime includes evidence scope", runtimeSnapshotFailed, "evidenceScope")
    assertContains("agent runtime failed classification", runtimeSnapshotFailed, "\"outcome\":\"failed\"")
    let runtimeFailedFinal = agent_runtime.ChengAgentRuntimeFinalizeTurnIfActive("failed")
    assertContains("agent runtime finalizes failed turn", runtimeFailedFinal, "\"outcome\":\"failed\"")
    let inactiveFinalize = agent_runtime.ChengAgentRuntimeFinalizeTurnIfActive("failed")
    assertContains("inactive finalize returns last snapshot", inactiveFinalize, "cheng.agent_runtime.v1")

    let ledgerJson = ledger.ChengEvidenceLedgerJson()
    assertContains("ledger exports real evidence", ledgerJson, "cheng.lsp")
    assertContains("ledger exports evidence id", ledgerJson, "cheng-evidence-1")
    assertNotContains("ledger has no mock marker", ledgerJson, "mock")

    training.ChengTrainingTraceReset()
    agent_runtime.ChengAgentRuntimeConfigureTraceOutDir("/tmp")
    agent_runtime.ChengAgentRuntimeBeginTurn("thread-trace", "turn-trace", "record trace")
    let autoEvidenceTrace = native.ChengNativeHandleToolCall(80,
                                                             "cheng_training_trace_record",
                                                             "{\"outDir\":\"/tmp\",\"traceId\":\"auto-evidence-trace\",\"instruction\":\"record current runtime\",\"outcome\":\"success\",\"validationStatus\":\"passed\",\"compression\":\"none\"}")
    assertContains("auto evidence trace success", autoEvidenceTrace, "\"success\":true")
    assertContains("auto evidence trace stores runtime snapshot", training.ChengTrainingTraceJson(), "cheng.agent_runtime.v1")
    let autoEvidenceFinal = agent_runtime.ChengAgentRuntimeFinalizeTurnIfActive("passed")
    assertContains("auto evidence finalizes as success", autoEvidenceFinal, "\"outcome\":\"success\"")
    let autoRuntimeManifestPath = agent_runtime.ChengAgentRuntimeLastTraceManifestPath()
    assert(autoRuntimeManifestPath != "", "agent runtime finalize writes trace manifest path")
    var autoRuntimeVerify: training.ChengAgentTraceVerifyResult
    let _ = training.ChengAgentTraceVerifyManifestInto(autoRuntimeManifestPath, autoRuntimeVerify)
    if !autoRuntimeVerify.ok:
        echo(autoRuntimeVerify.error)
    assert(autoRuntimeVerify.ok, "agent runtime finalized trace manifest verifies")
    assert(training.ChengAgentTraceManifestPayloadContains(autoRuntimeManifestPath, "cheng.agent_runtime.v1"), "agent runtime persisted payload includes runtime snapshot")
    agent_runtime.ChengAgentRuntimeConfigureTraceOutDir("")
    let successTrace = training.ChengTrainingTraceRecord("trace-1",
                                                         "fix /root/private/project/src/main.cheng with sk-secret",
                                                         ledgerJson,
                                                         "changed /root/private/project/src/main.cheng",
                                                         "[{\"command\":\"cheng build\",\"status\":\"passed\"}]",
                                                         "success",
                                                         "cheng build /root/private/project",
                                                         "passed",
                                                         int64(2000))
    assertContains("training trace schema", successTrace, "cheng.training_trace.v1")
    assertContains("training trace trainable", successTrace, "\"trainable\":true")
    assertContains("training trace redacts secret/path", successTrace, "[REDACTED_SECRET]")
    assertNotContains("training trace no absolute root path", successTrace, "/root/private")
    let failedTrace = training.ChengTrainingTraceRecord("trace-2",
                                                        "repair local no-pointer failure",
                                                        "[]",
                                                        "no patch",
                                                        "[{\"command\":\"cheng build\",\"status\":\"failed\"}]",
                                                        "failed",
                                                        "cheng build",
                                                        "failed",
                                                        int64(2001))
    assertContains("failed trace not trainable", failedTrace, "\"trainable\":false")
    let evalCase = training.ChengEvalCaseRecord("eval-1",
                                                "trace-2",
                                                "repair /Users/dev/project failure",
                                                "[]",
                                                "cheng replay /Users/dev/project",
                                                "agent_repair_required",
                                                "cheng build /Users/dev/project",
                                                int64(2002))
    assertContains("eval case schema", evalCase, "cheng.eval_case.v1")
    assertContains("eval case redacts path", evalCase, "[REDACTED_PATH]")
    assertContains("eval case carries replay metadata fields", evalCase, "replayFixtureRefs")
    assertContains("training trace list", training.ChengTrainingTraceJson(), "trace-1")
    assertContains("eval case list", training.ChengEvalCaseJson(), "eval-1")

    let prodTrace = native.ChengNativeHandleToolCall(81,
                                                     "cheng_training_trace_record",
                                                     "{\"outDir\":\"/tmp\",\"traceId\":\"prod-trace-1\",\"instruction\":\"fix /root/private/main.cheng with sk-prod\",\"evidence\":\"[]\",\"diffSummary\":\"changed /root/private/main.cheng\",\"checks\":\"[]\",\"outcome\":\"success\",\"validationCommand\":\"cheng build /root/private\",\"validationStatus\":\"passed\",\"compression\":\"none\"}")
    assertContains("production trace success", prodTrace, "\"success\":true")
    assertContains("production trace manifest", prodTrace, "cheng.agent_trace.manifest.v1")
    assertContains("production trace magic", prodTrace, "CHENG_AGENT_TRACE")
    assertContains("production trace raw shard path", prodTrace, ".cagt")
    assertNotContains("production trace redacts path", prodTrace, "/root/private")
    let prodEval = native.ChengNativeHandleToolCall(82,
                                                    "cheng_eval_case_record",
                                                    "{\"outDir\":\"/tmp\",\"evalId\":\"prod-eval-1\",\"traceId\":\"prod-trace-2\",\"instruction\":\"repair /Users/dev/main.cheng\",\"evidence\":\"[]\",\"replayCommand\":\"cheng replay /Users/dev/main.cheng\",\"expectedOutcome\":\"repair_required\",\"validationCommand\":\"cheng build /Users/dev/main.cheng\",\"compression\":\"none\",\"debugJsonl\":true}")
    assertContains("production eval success", prodEval, "\"success\":true")
    assertContains("production eval manifest", prodEval, "cheng.agent_trace.manifest.v1")
    assertContains("production eval raw shard", prodEval, ".eval-case.cagt")
    assertContains("production eval debug jsonl export", prodEval, ".eval-case.jsonl")
    assertNotContains("production eval redacts path", prodEval, "/Users/dev")
    let roundtripPayload = training.ChengTrainingTraceRecord("trace-roundtrip",
                                                            "verify stored agent trace",
                                                            "[]",
                                                            "no diff",
                                                            "[]",
                                                            "success",
                                                            "cheng build",
                                                            "passed",
                                                            int64(2003))
    let roundtripCid = training.ChengTrainingTracePayloadCid(roundtripPayload)
    let roundtripShard = training.ChengTrainingTraceWriteProductionShard("/tmp", "roundtrip-trace", roundtripPayload)
    let _ = training.ChengTrainingTraceWriteProductionManifest("/tmp", "roundtrip-trace", roundtripPayload, "none", "")
    let roundtripManifestPath = training.ChengTrainingTraceManifestPath("/tmp", "roundtrip-trace", roundtripCid)
    var verifyResult: training.ChengAgentTraceVerifyResult
    let _ = training.ChengAgentTraceVerifyManifestInto(roundtripManifestPath, verifyResult)
    assert(verifyResult.ok, "agent trace manifest verifies")
    let verifyJson = training.ChengAgentTraceVerifyResultJson(verifyResult)
    assertContains("agent trace verify root cid", verifyJson, roundtripCid)
    let exportJson = training.ChengAgentTraceExportJsonl(roundtripManifestPath, "/tmp/cheng_agent_trace_roundtrip.jsonl")
    assertContains("agent trace export succeeds", exportJson, "\"ok\":true")
    var nativeVerifyArgs = "{"
    nativeVerifyArgs = wire.RustCsgCat(nativeVerifyArgs, wire.RustCsgJsonFieldStr("manifest", roundtripManifestPath))
    nativeVerifyArgs = wire.RustCsgCat(nativeVerifyArgs, "}")
    let nativeVerify = native.ChengNativeHandleToolCall(85, "cheng_agent_trace_verify", nativeVerifyArgs)
    assertContains("native agent trace verify succeeds", nativeVerify, "\"success\":true")
    var nativeExportArgs = "{"
    nativeExportArgs = wire.RustCsgCat(nativeExportArgs, wire.RustCsgJsonFieldStr("manifest", roundtripManifestPath))
    nativeExportArgs = wire.RustCsgCat(nativeExportArgs, ",")
    nativeExportArgs = wire.RustCsgCat(nativeExportArgs, wire.RustCsgJsonFieldStr("out", "/tmp/cheng_agent_trace_native_export.jsonl"))
    nativeExportArgs = wire.RustCsgCat(nativeExportArgs, "}")
    let nativeExport = native.ChengNativeHandleToolCall(86, "cheng_agent_trace_export_jsonl", nativeExportArgs)
    assertContains("native agent trace export succeeds", nativeExport, "\"success\":true")
    var badManifest = "{"
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("schema", "cheng.agent_trace.manifest.v1"))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("format", "CHENG_AGENT_TRACE"))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldInt32("version", 1))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("rootCid", "sha256:bad"))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("rawShardPath", roundtripShard))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("primaryPath", roundtripShard))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldStr("compression", "none"))
    badManifest = wire.RustCsgCat(badManifest, ",")
    badManifest = wire.RustCsgCat(badManifest, wire.RustCsgJsonFieldInt32("uncompressedBytes", roundtripPayload.len))
    badManifest = wire.RustCsgCat(badManifest, "}")
    assert(smokeWriteFile("/tmp/cheng_agent_trace_bad.manifest.json", badManifest) != 0, "write bad agent trace manifest")
    let badVerify = native.ChengNativeHandleToolCall(87, "cheng_agent_trace_verify", "{\"manifest\":\"/tmp/cheng_agent_trace_bad.manifest.json\"}")
    assertContains("native bad trace verify fails", badVerify, "\"success\":false")
    assertContains("native bad trace verify reports unreadable uncached manifest", badVerify, "manifest not readable")
    let badTracePath = native.ChengNativeHandleToolCall(83,
                                                        "cheng_training_trace_record",
                                                        "{\"outDir\":\"/home/not-allowed\",\"traceId\":\"bad\",\"instruction\":\"bad\",\"outcome\":\"success\",\"validationStatus\":\"passed\"}")
    assertContains("production trace bad output hard-fails", badTracePath, "\"success\":false")
    let badCompression = native.ChengNativeHandleToolCall(84,
                                                          "cheng_training_trace_record",
                                                          "{\"outDir\":\"/tmp\",\"traceId\":\"bad-compression\",\"instruction\":\"bad\",\"outcome\":\"success\",\"validationStatus\":\"passed\",\"compression\":\"zstd\"}")
    assertContains("production trace unsupported compression hard-fails", badCompression, "\"success\":false")

    echo(" rust_csg_cheng_native_auto_fusion_smoke ok")
    return 0
