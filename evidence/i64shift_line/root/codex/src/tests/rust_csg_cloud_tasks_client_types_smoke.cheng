    if ctc.RustCsgAttemptStatusFailed != 3: return false
    if ctc.RustCsgAttemptStatusCancelled != 4: return false
    if ctc.RustCsgAttemptStatusUnknown != 5: return false
    if ctc.RustCsgAttemptStatusCount != 6: return false
