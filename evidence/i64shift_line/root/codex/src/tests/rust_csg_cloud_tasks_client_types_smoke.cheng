import cheng/codex/crates/cloud_tasks_client/cloud_tasks_client as ctc

# ═══════════════════════════════════════════════════════════════════════════════
# Cloud Tasks Client — type definition smoke test
#
# Ported from codex-rs/codex-cloud-tasks-client/src/api.rs
# ═══════════════════════════════════════════════════════════════════════════════

fn testTaskStatusConstants(): bool =
    if ctc.RustCsgTaskStatusPending != 0: return false
    if ctc.RustCsgTaskStatusReady != 1: return false
    if ctc.RustCsgTaskStatusApplied != 2: return false
    if ctc.RustCsgTaskStatusError != 3: return false
    if ctc.RustCsgTaskStatusCount != 4: return false
    echo("testTaskStatusConstants ok")
    return true

fn testTaskStatusName(): bool =
    if ctc.TaskStatusName(ctc.RustCsgTaskStatusPending) != "pending": return false
    if ctc.TaskStatusName(ctc.RustCsgTaskStatusReady) != "ready": return false
    if ctc.TaskStatusName(ctc.RustCsgTaskStatusApplied) != "applied": return false
    if ctc.TaskStatusName(ctc.RustCsgTaskStatusError) != "error": return false
    if ctc.TaskStatusName(99) != "unknown": return false
    echo("testTaskStatusName ok")
    return true

fn testTaskStatusLabel(): bool =
    if ctc.TaskStatusLabel(ctc.RustCsgTaskStatusPending) != "PENDING": return false
    if ctc.TaskStatusLabel(ctc.RustCsgTaskStatusReady) != "READY": return false
    if ctc.TaskStatusLabel(ctc.RustCsgTaskStatusApplied) != "APPLIED": return false
    if ctc.TaskStatusLabel(ctc.RustCsgTaskStatusError) != "ERROR": return false
    if ctc.TaskStatusLabel(99) != "UNKNOWN": return false
    echo("testTaskStatusLabel ok")
    return true

fn testAttemptStatusConstants(): bool =
    if ctc.RustCsgAttemptStatusPending != 0: return false
