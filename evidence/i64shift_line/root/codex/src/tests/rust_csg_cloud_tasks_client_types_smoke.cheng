    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusPending) != "pending": return false
    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusInProgress) != "in_progress": return false
    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusCompleted) != "completed": return false
    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusFailed) != "failed": return false
    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusCancelled) != "cancelled": return false
    if ctc.AttemptStatusName(ctc.RustCsgAttemptStatusUnknown) != "unknown": return false
    echo("testAttemptStatusName ok")
