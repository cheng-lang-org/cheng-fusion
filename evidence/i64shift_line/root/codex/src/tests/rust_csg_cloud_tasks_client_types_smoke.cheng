fn testApplyStatusConstants(): bool =
    if ctc.RustCsgApplyStatusSuccess != 0: return false
    if ctc.RustCsgApplyStatusPartial != 1: return false
    if ctc.RustCsgApplyStatusError != 2: return false
    if ctc.RustCsgApplyStatusCount != 3: return false
    echo("testApplyStatusConstants ok")
    return true

fn testApplyStatusName(): bool =
    if ctc.ApplyStatusName(ctc.RustCsgApplyStatusSuccess) != "success": return false
    if ctc.ApplyStatusName(ctc.RustCsgApplyStatusPartial) != "partial": return false
    if ctc.ApplyStatusName(ctc.RustCsgApplyStatusError) != "error": return false
    if ctc.ApplyStatusName(99) != "unknown": return false
    echo("testApplyStatusName ok")
    return true

fn testStructFieldCounts(): bool =
    if ctc.RustCsgDiffSummaryFieldCount != 3: return false
    if ctc.RustCsgTaskSummaryFieldCount != 9: return false
    if ctc.RustCsgApplyOutcomeFieldCount != 5: return false
    if ctc.RustCsgCreatedTaskFieldCount != 1: return false
    if ctc.RustCsgTaskListPageFieldCount != 2: return false
    if ctc.RustCsgTaskTextFieldCount != 6: return false
    if ctc.RustCsgTurnAttemptFieldCount != 6: return false
    echo("testStructFieldCounts ok")
    return true

fn testStructFieldNames(): bool =
    if ctc.RustCsgDiffSummaryField1 != "files_changed": return false
    if ctc.RustCsgDiffSummaryField2 != "lines_added": return false
    if ctc.RustCsgDiffSummaryField3 != "lines_removed": return false
    if ctc.RustCsgTaskSummaryField1 != "id": return false
    if ctc.RustCsgTaskSummaryField2 != "title": return false
    if ctc.RustCsgCreatedTaskField1 != "id": return false
    if ctc.RustCsgTaskListPageField1 != "tasks": return false
    if ctc.RustCsgTaskListPageField2 != "cursor": return false
    if ctc.RustCsgApplyOutcomeField1 != "applied": return false
    if ctc.RustCsgApplyOutcomeField2 != "status": return false
    if ctc.RustCsgTurnAttemptField1 != "turn_id": return false
    if ctc.RustCsgTurnAttemptField5 != "diff": return false
    echo("testStructFieldNames ok")
    return true

fn testStructFieldsFormat(): bool =
    if ctc.DiffSummaryFields() != "files_changed|int32,lines_added|int32,lines_removed|int32": return false
    if ctc.CreatedTaskFields() != "id|str": return false
    echo("testStructFieldsFormat ok")
    return true

fn testCloudBackendMethodCount(): bool =
    if ctc.RustCsgCloudBackendMethodCount != 9: return false
    if ctc.RustCsgCloudBackendMethod1 != "list_tasks": return false
    if ctc.RustCsgCloudBackendMethod9 != "create_task": return false
    echo("testCloudBackendMethodCount ok")
    return true

fn testErrorVariantCount(): bool =
    if ctc.RustCsgCloudTaskErrorVariantCount != 4: return false
    if ctc.RustCsgCloudTaskErrorVariant1 != "Unimplemented": return false
    if ctc.RustCsgCloudTaskErrorVariant4 != "Msg": return false
    echo("testErrorVariantCount ok")
    return true

fn testBuildTaskFilter(): bool =
    # Both fields
    var f1: str = ctc.buildTaskFilter("pending", "2024-01-15")
    if f1.len == 0: return false
    if f1[0] != 123: return false  # '{'
    if f1[f1.len - 1] != 125: return false  # '}'
    # Status only
    var f2: str = ctc.buildTaskFilter("ready", "")
    if f2.len == 0: return false
    if f2[0] != 123: return false
    if f2[f2.len - 1] != 125: return false
    # Both empty
    var f4: str = ctc.buildTaskFilter("", "")
    if f4 != "{}": return false
    echo("testBuildTaskFilter ok")
    return true

fn testCloudTaskClientBuildPollRequest(): bool =
    var r1: str = ctc.cloudTaskClientBuildPollRequest("task_abc123456789012345678901")
    if r1.len == 0: return false
    if r1[0] != 123: return false  # '{'
    if r1[r1.len - 1] != 125: return false  # '}'
    echo("testCloudTaskClientBuildPollRequest ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testTaskStatusConstants(): allOk = false
    if !testTaskStatusName(): allOk = false
    if !testTaskStatusLabel(): allOk = false
    if !testAttemptStatusConstants(): allOk = false
    if !testAttemptStatusName(): allOk = false
    if !testApplyStatusConstants(): allOk = false
    if !testApplyStatusName(): allOk = false
    if !testStructFieldCounts(): allOk = false
    if !testStructFieldNames(): allOk = false
    if !testStructFieldsFormat(): allOk = false
    if !testCloudBackendMethodCount(): allOk = false
    if !testErrorVariantCount(): allOk = false
    if !testBuildTaskFilter(): allOk = false
    if !testCloudTaskClientBuildPollRequest(): allOk = false
    if allOk:
        echo("rust_csg_cloud_tasks_client_types_smoke ok")
        return 0
    echo("rust_csg_cloud_tasks_client_types_smoke FAILED")
    return 1
