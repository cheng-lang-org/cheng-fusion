import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn assertRoundtripText(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn main(): int32 =
    var mcpTool: types.RustCsgMcpTool
    mcpTool.name = "read_file"
    mcpTool.title = "Read File"
    mcpTool.description = "Read the contents of a file"
    mcpTool.inputSchemaJson = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}"
    mcpTool.outputSchemaJson = "{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"}}}"
    mcpTool.annotationsJson = "{\"readOnlyHint\":true}"
    mcpTool.iconsJson = "[{\"uri\":\"https://example.com/icon.png\"}]"
    mcpTool.metaJson = "{\"deprecated\":false}"
    let toolJson = wire.RustCsgMcpToolToJson(mcpTool)
    let toolBack = wire.RustCsgMcpToolFromJson(toolJson)
    assertRoundtripText("mcp_tool", toolJson, wire.RustCsgMcpToolToJson(toolBack))

    var mcpResource: types.RustCsgMcpResource
    mcpResource.name = "README"
    mcpResource.uri = "file:///work/README.md"
    mcpResource.title = "Project README"
    mcpResource.description = "Main project documentation"
    mcpResource.mimeType = "text/markdown"
    mcpResource.sizeJson = "1024"
    mcpResource.annotationsJson = "{\"audience\":\"developer\"}"
    mcpResource.iconsJson = "[{\"uri\":\"https://example.com/doc.png\"}]"
    mcpResource.metaJson = "{\"version\":1}"
    let resourceJson = wire.RustCsgMcpResourceToJson(mcpResource)
    let resourceBack = wire.RustCsgMcpResourceFromJson(resourceJson)
    assertRoundtripText("mcp_resource", resourceJson, wire.RustCsgMcpResourceToJson(resourceBack))

    var minimalTool: types.RustCsgMcpTool
    minimalTool.name = "minimal_tool"
    minimalTool.inputSchemaJson = "{\"type\":\"object\"}"
    let minimalToolJson = wire.RustCsgMcpToolToJson(minimalTool)
    let minimalToolBack = wire.RustCsgMcpToolFromJson(minimalToolJson)
    assertRoundtripText("mcp_tool_minimal", minimalToolJson, wire.RustCsgMcpToolToJson(minimalToolBack))
    assert(minimalToolBack.title == "", "minimal_tool_title_empty")
    assert(minimalToolBack.description == "", "minimal_tool_description_empty")
    assert(minimalToolBack.outputSchemaJson == "", "minimal_tool_outputSchema_empty")
    assert(minimalToolBack.annotationsJson == "", "minimal_tool_annotations_empty")
    assert(minimalToolBack.iconsJson == "", "minimal_tool_icons_empty")
    assert(minimalToolBack.metaJson == "", "minimal_tool_meta_empty")

    echo("rust_csg_mcp_types_roundtrip_smoke ok")
    return 0
