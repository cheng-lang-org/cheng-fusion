import cheng/codex/crates/utils_fuzzy_match/fuzzy_match as fm

fn main(): int32 =
    // Test exact match
    let ok1 = fm.fuzzyMatchSimple("hello", "hello")
    if !ok1:
        echo("FAIL: exact match")
        return 1
    
    // Test case-insensitive
    let ok2 = fm.fuzzyMatchSimple("Hello", "hello")
    if !ok2:
        echo("FAIL: case insensitive")
        return 1
    
    // Test subsequence
    let ok3 = fm.fuzzyMatchSimple("hello_world", "hwd")
    if !ok3:
        echo("FAIL: subsequence")
        return 1
    
    // Test no match
    let ok4 = fm.fuzzyMatchSimple("abc", "xyz")
    if ok4:
        echo("FAIL: should not match")
        return 1
    
    // Test empty needle
    let ok5 = fm.fuzzyMatchSimple("abc", "")
    if !ok5:
        echo("FAIL: empty needle")
        return 1
    
    echo("rust_csg_utils_fuzzy_match_smoke ok")
    return 0
