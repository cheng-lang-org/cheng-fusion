import std/strings
import std/strutils as strutil
import cheng/codex/login/oauth

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test for login/oauth module
#
# NOTE: Cheng compiler bugs (system-link-exec path) workarounds:
#   - Split `or` conditions into separate `if` statements
#   - Compare int32 character codes instead of chars or strings
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=|", expected, "| got=|", got, "|"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqInt(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── Test OAuth2Config creation ──────────────────────────────────

fn testDefaultConfig(): bool =
    var ok: bool = true
    var config: oauth.OAuth2Config = oauth.OpenAIDefaultConfig()
    if !checkEqStr(config.clientId, "app_EMoamEEZ73f0CkXaXp7hrann", "config.clientId"):
        ok = false
    if !checkEqStr(config.tokenUrl, "https://auth.openai.com/oauth/token", "config.tokenUrl"):
        ok = false
    if !checkEqStr(config.deviceCodeUrl, "https://auth.openai.com/oauth/device/code", "config.deviceCodeUrl"):
        ok = false
    if ok:
        echo("testDefaultConfig ok")
    return ok

# ── Test JSON roundtrip ─────────────────────────────────────────

fn testTokenRoundtrip(): bool =
    var ok: bool = true
    var token: oauth.OAuth2Token
    token.accessToken = "test_access"
    token.refreshToken = "test_refresh"
    token.expiresIn = 3600
    token.tokenType = "Bearer"

    let json: str = oauth.OAuth2TokenToJson(token)
    var parsed: oauth.OAuth2Token = oauth.OAuth2TokenFromJson(json)

    if !checkEqStr(parsed.accessToken, "test_access", "roundtrip.accessToken"):
        ok = false
    if !checkEqStr(parsed.refreshToken, "test_refresh", "roundtrip.refreshToken"):
        ok = false
    if !checkEqInt(parsed.expiresIn, 3600, "roundtrip.expiresIn"):
        ok = false
    if !checkEqStr(parsed.tokenType, "Bearer", "roundtrip.tokenType"):
        ok = false
    if ok:
        echo("testTokenRoundtrip ok")
    return ok

# ── Test JSON from literal ──────────────────────────────────────

fn testJsonFromLiteral(): bool =
    var ok: bool = true
    let json: str = "{\"access_token\":\"abc123\",\"refresh_token\":\"def456\",\"expires_in\":7200,\"token_type\":\"Bearer\"}"
    var parsed: oauth.OAuth2Token = oauth.OAuth2TokenFromJson(json)

    if !checkEqStr(parsed.accessToken, "abc123", "literal.accessToken"):
        ok = false
    if !checkEqStr(parsed.refreshToken, "def456", "literal.refreshToken"):
        ok = false
    if !checkEqInt(parsed.expiresIn, 7200, "literal.expiresIn"):
        ok = false
    if !checkEqStr(parsed.tokenType, "Bearer", "literal.tokenType"):
        ok = false
    if ok:
        echo("testJsonFromLiteral ok")
    return ok

# ── Main ────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testDefaultConfig(): allOk = false
    if !testTokenRoundtrip(): allOk = false
    if !testJsonFromLiteral(): allOk = false

    if allOk:
        echo("rust_csg_login_oauth_smoke ok")
        return 0
    else:
        echo("rust_csg_login_oauth_smoke FAILED")
        return 1
