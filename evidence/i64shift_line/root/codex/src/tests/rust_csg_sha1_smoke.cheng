# SHA-1 smoke test — verify against standard test vectors
import cheng/codex/crates/utils_cache/utils_cache as cache
import std/strings

fn sha1check(name: str, input: str, expected: str, ok: var bool): str =
    let actual = cache.RustCsgSha1DigestString(input)
    if actual == expected:
        ok = true
        return strings.ConcatStr(strings.ConcatStr("PASS ", name), strings.ConcatStr(": ", actual))
    ok = false
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("FAIL ", name), " expected="), expected), strings.ConcatStr(" got=", actual))

fn main(): int32 =
    echo("RUST_CSG_SHA1_SMOKE")

    # RFC 3174 / FIPS 180-4 test vectors
    # "" -> da39a3ee5e6b4b0d3255bfef95601890afd80709
    # "abc" -> a9993e364706816aba3e25717850c26c9cd0d89d
    # "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" -> 84983e441c3bd26ebaae4aa1f95129e5e54670f1
    # "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu" -> a49b2446a02c645bf419f995b67091253a04a259
    # 1,000,000 x 'a' -> 34aa973cd4c4daa4f61eeb2bdbad27316534016f

    var allOk: bool = true
    var ok: bool

    var result: str

    # Test 1: empty string
    result = sha1check("empty", "", "da39a3ee5e6b4b0d3255bfef95601890afd80709", ok)
    echo(result)
    if !ok: allOk = false

    # Test 2: "abc"
    result = sha1check("abc", "abc", "a9993e364706816aba3e25717850c26c9cd0d89d", ok)
    echo(result)
    if !ok: allOk = false

    # Test 3: 56-byte message (exactly block boundary - 8)
    result = sha1check("56bytes", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "84983e441c3bd26ebaae4aa1f95129e5e54670f1", ok)
    echo(result)
    if !ok: allOk = false

    # Test 4: 64-byte message (exactly one block)
    var s64: str = ""
    var i64: int32 = 0
    while i64 < 64:
        s64 = strings.ConcatStr(s64, "a")
        i64 = i64 + 1
    result = sha1check("64bytes", s64, "0098ba824b5c16427bd7a1122a5a442a25ec644d", ok)
    echo(result)
    if !ok: allOk = false

    # Test 5: 55-byte message (fits in one block after padding)
    var s55: str = ""
    var i55: int32 = 0
    while i55 < 55:
        s55 = strings.ConcatStr(s55, "b")
        i55 = i55 + 1
    result = sha1check("55bytes", s55, "4eef4f545f2cbed2f64271250e25fe8e63d8a241", ok)
    echo(result)
    if !ok: allOk = false

    # Test 6: 57-byte message (triggers overflow padding block)
    var s57: str = ""
    var i57: int32 = 0
    while i57 < 57:
        s57 = strings.ConcatStr(s57, "c")
        i57 = i57 + 1
    result = sha1check("57bytes", s57, "ee7e77a61351c000750ed1e1e589e3d6b94cdba0", ok)
    echo(result)
    if !ok: allOk = false

    if allOk:
        echo("rust_csg_sha1_smoke ok")
        return 0
    echo("rust_csg_sha1_smoke FAILED")
    return 1
