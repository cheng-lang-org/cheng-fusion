import cheng/codex/crates/tui/tui

fn main(): int32 =
    var pass: int32

    if tui.RustCsgFormatTuiStatusLine("Plan Mode", "gpt-5", 3) == "Plan Mode | gpt-5 | Turn 3": pass = pass + 1
    if tui.RustCsgFormatTuiStatusLine("Chat Mode", "claude", 1) == "Chat Mode | claude | Turn 1": pass = pass + 1
    if tui.RustCsgFormatTuiStatusLine("", "", 0) == " |  | Turn 0": pass = pass + 1
    if tui.RustCsgFormatTuiStatusLine("Auto", "opus", 42) == "Auto | opus | Turn 42": pass = pass + 1

    if pass == 4:
        echo("rust_csg_oracle_tui ok")
        return 0
    echo("oracle FAIL")
    return 1

main()