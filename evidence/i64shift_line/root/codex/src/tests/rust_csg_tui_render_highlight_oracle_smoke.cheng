import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/render_highlight_oracle as oracle

fn RustCsgTuiRenderHighlightFirstDiff(expected: str, got: str): int32 =
    let expectedLen: int32 = strings.Len(expected)
    let gotLen: int32 = strings.Len(got)
    var limit: int32 = expectedLen
    if gotLen < limit:
        limit = gotLen

    var i: int32 = 0
    while i < limit:
        if expected[i] != got[i]:
            return i
        i = i + 1

    if expectedLen != gotLen:
        return limit
    return -1

fn main(): int32 =
    if cmdline.argCount() != 2:
        echo("FAIL usage: rust_csg_tui_render_highlight_oracle_smoke <snapshot path>")
        return 1

    let path: str = cmdline.argStr(1)
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL parse: ", s.error], ""))
        return 1
    if s.source != "tui/src/render/highlight.rs":
        echo(strutil.Join(["FAIL source got=", s.source], ""))
        return 1
    if s.expression != "out":
        echo(strutil.Join(["FAIL expression got=", s.expression], ""))
        return 1

    let expected: str = oracle.RustCsgTuiRenderHighlightAnsiFamilyForegroundPalette()
    if expected != s.body:
        echo(strutil.Join([
            "FAIL byte mismatch expected=", strings.IntToStr(strings.Len(expected)),
            " got=", strings.IntToStr(s.bodyByteLen),
            " first_diff=", strings.IntToStr(RustCsgTuiRenderHighlightFirstDiff(expected, s.body)),
        ], ""))
        return 1

    echo("rust_csg_tui_render_highlight_oracle_smoke ok")
    return 0
