import cheng/codex/crates/bwrap/bwrap

fn main(): int32 =
    # bwrap is Linux-only via vendored bubblewrap C code
    let supported = bwrap.RustCsgBwrapSupportedOnPlatform()
    if supported:
        echo("FAIL: bwrap should not be supported on Darwin")
        return 1
    let err = bwrap.RustCsgBwrapPlatformError()
    if err == "":
        echo("FAIL: platform error should not be empty")
        return 1

    # validateBwrapPath must return false on Darwin (bwrap is Linux-only)
    let validEmpty = bwrap.RustCsgBwrapValidateBwrapPath("")
    if validEmpty:
        echo("FAIL: empty path should fail validation")
        return 1
    let validNonEmpty = bwrap.RustCsgBwrapValidateBwrapPath("/usr/bin/bwrap")
    if validNonEmpty:
        echo("FAIL: bwrap should not validate on Darwin")
        return 1

    # Test bwrapBuildSeccompProfile
    let profileEmpty = bwrap.bwrapBuildSeccompProfile("")
    if profileEmpty != "{}":
        echo("FAIL: empty syscalls should return {}")
        return 1
    let profileWithSyscalls = bwrap.bwrapBuildSeccompProfile("read,write,open")
    if profileWithSyscalls != "{}":
        echo("FAIL: bwrap profile should be empty on Darwin")
        return 1

    echo("rust_csg_bwrap_smoke ok")
    return 0
