import cheng/codex/app_server/rate_limit_dashboard
import cheng/codex/auth/login as auth_login
import cheng/codex/auth/oauth as auth_oauth
import cheng/codex/protocol/wire
import std/cmdline

fn assertTrue(name: str, value: bool) =
    if !value:
        echo(wire.RustCsgCat("FAIL: ", name))
    assert(value, name)

fn assertContains(name: str, haystack: str, needle: str) =
    if !wire.RustCsgContains(haystack, needle):
        echo(wire.RustCsgCat("FAIL: ", name))
        echo(wire.RustCsgCat("missing: ", needle))
        echo(wire.RustCsgCat("in: ", haystack))
    assert(wire.RustCsgContains(haystack, needle), name)

fn assertNotContains(name: str, haystack: str, needle: str) =
    if wire.RustCsgContains(haystack, needle):
        echo(wire.RustCsgCat("FAIL: ", name))
        echo(wire.RustCsgCat("unexpected: ", needle))
        echo(wire.RustCsgCat("in: ", haystack))
    assert(!wire.RustCsgContains(haystack, needle), name)

fn testMissingAuth(codexHome: str, baseUrl: str) =
    let missingAuthEnv = "ACCOUNTS=\"beta@example.test gamma@example.test\"\nPASSWORD=secret\n"
    var missingOut: str
    var missingCacheOut: str
    var missingError: str
    let missingOk = rate_limit_dashboard.RustCsgRateLimitDashboardRefreshWithCachedAuthFromEnvAndCache(missingAuthEnv,
                                                                                                       "/fixture/.env",
                                                                                                       "",
                                                                                                       codexHome,
                                                                                                       baseUrl,
                                                                                                       int64(320),
                                                                                                       "",
                                                                                                       missingOut,
                                                                                                       missingCacheOut,
                                                                                                       missingError)
    if !missingOk:
        echo(missingError)
    assertTrue("missing auth refresh still returns dashboard", missingOk)
    assertContains("missing auth beta failed", missingOut, "{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":\"cached auth is missing for beta@example.test\"}")
    assertContains("missing auth gamma failed", missingOut, "{\"email\":\"gamma@example.test\",\"status\":\"failed\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":\"cached auth is missing for gamma@example.test\"}")
    assertContains("missing auth cache timestamp", missingCacheOut, "\"lastUpdatedAt\":320")

fn testCachedAuth(codexHome: str, baseUrl: str, refreshUrl: str) =
    let env = "ACCOUNTS=alpha@example.test\nPASSWORD=secret\n"
    var out: str
    var cacheOut: str
    var error: str
    let ok = rate_limit_dashboard.RustCsgRateLimitDashboardRefreshWithCachedAuthAndRefreshEndpointFromEnvAndCache(env,
                                                                                                                   "/fixture/.env",
                                                                                                                   "",
                                                                                                                   codexHome,
                                                                                                                   baseUrl,
                                                                                                                   refreshUrl,
                                                                                                                   int64(321),
                                                                                                                   "",
                                                                                                                   out,
                                                                                                                   cacheOut,
                                                                                                                   error)
    if !ok:
        echo(error)
    assertTrue("cached auth refresh ok", ok)
    assertContains("refresh success status", out, "\"status\":\"success\"")
    assertContains("refresh fetchedAt", out, "\"fetchedAt\":321")
    assertContains("refresh maps primary", out, "\"primary\":{\"usedPercent\":42,\"windowDurationMins\":5,\"resetsAt\":123}")
    assertContains("refresh maps credits", out, "\"credits\":{\"hasCredits\":true,\"unlimited\":false,\"balance\":\"9.99\"}")
    assertContains("refresh maps additional", out, "\"limitId\":\"codex_other\"")
    assertContains("refresh maps additional fields", out, "\"limitId\":\"codex_other\",\"limitName\":\"Codex other\",\"primary\":{\"usedPercent\":70,\"windowDurationMins\":15,\"resetsAt\":789},\"secondary\":null,\"credits\":null,\"planType\":\"pro\"")
    assertNotContains("refresh omits reached type", out, "rateLimitReachedType")
    assertContains("refresh source fresh", out, "\"source\":\"fresh\"")
    assertContains("refresh cache timestamp", cacheOut, "\"lastUpdatedAt\":321")

fn testCachedAuthEmailMismatch(codexHome: str, baseUrl: str, refreshUrl: str) =
    let mismatchEnv = "ACCOUNTS=wrong@example.test\nPASSWORD=secret\n"
    let wrongAuthHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, "wrong@example.test")
    let wrongAuth = auth_login.LoadAuth(wrongAuthHome)
    assertContains("cached auth mismatch access token email parse", auth_oauth.IdTokenEmail(wrongAuth.accessToken), "other")
    var mismatchOut: str
    var mismatchCacheOut: str
    var mismatchError: str
    assertTrue("cached auth email mismatch dashboard ok", rate_limit_dashboard.RustCsgRateLimitDashboardRefreshWithCachedAuthAndRefreshEndpointFromEnvAndCache(mismatchEnv,
                                                                                                                                                             "/fixture/.env",
                                                                                                                                                             "",
                                                                                                                                                             codexHome,
                                                                                                                                                             baseUrl,
                                                                                                                                                             refreshUrl,
                                                                                                                                                             int64(321),
                                                                                                                                                             "wrong@example.test",
                                                                                                                                                             mismatchOut,
                                                                                                                                                             mismatchCacheOut,
                                                                                                                                                             mismatchError))
    assertContains("cached auth email mismatch rejected", mismatchOut, "cached auth email mismatch for wrong@example.test: got other")

fn testRetry401Refresh(codexHome: str, baseUrl: str, refreshUrl: str) =
    let retryEnv = "ACCOUNTS=retry401@example.test\nPASSWORD=secret\n"
    var retryOut: str
    var retryCacheOut: str
    var retryError: str
    assertTrue("401 refresh retry dashboard ok", rate_limit_dashboard.RustCsgRateLimitDashboardRefreshWithCachedAuthAndRefreshEndpointFromEnvAndCache(retryEnv,
                                                                                                                                                      "/fixture/.env",
                                                                                                                                                      "",
                                                                                                                                                      codexHome,
                                                                                                                                                      baseUrl,
                                                                                                                                                      refreshUrl,
                                                                                                                                                      int64(321),
                                                                                                                                                      "retry401@example.test",
                                                                                                                                                      retryOut,
                                                                                                                                                      retryCacheOut,
                                                                                                                                                      retryError))
    assertContains("401 refresh retry succeeds", retryOut, "{\"email\":\"retry401@example.test\",\"status\":\"success\"")

fn testAccountRateLimitsResponse(codexHome: str, baseUrl: str, refreshUrl: str) =
    var accountResponse: str
    var accountError: str
    var invalidRequest: bool
    let accountOk = rate_limit_dashboard.RustCsgRateLimitDashboardFetchAccountRateLimitsResponseFromCodexHomeWithRefreshEndpoint(codexHome,
                                                                                                                                 baseUrl,
                                                                                                                                 refreshUrl,
                                                                                                                                 int64(321),
                                                                                                                                 accountResponse,
                                                                                                                                 accountError,
                                                                                                                                 invalidRequest)
    if !accountOk:
        echo(accountError)
    assertTrue("account rate limits backend fetch ok", accountOk)
    assertTrue("account rate limits not invalid", !invalidRequest)
    assertContains("account response primary", accountResponse, "\"rateLimits\":{\"limitId\":\"codex\"")
    assertContains("account response map additional", accountResponse, "\"codex_other\":{\"limitId\":\"codex_other\"")
    assertNotContains("account response omits reached type", accountResponse, "rateLimitReachedType")

fn testManualDeviceCode(codexHome: str, baseUrl: str) =
    var deviceAuthId: str
    var userCode: str
    var verificationUrl: str
    var interval: int32
    var manualError: str
    assertTrue("manual login device-code start ok", auth_oauth.RequestDeviceCodeStartAtIssuer(baseUrl,
                                                                                              deviceAuthId,
                                                                                              userCode,
                                                                                              verificationUrl,
                                                                                              interval,
                                                                                              manualError))
    assertContains("manual login verification url", verificationUrl, "/codex/device")
    assertContains("manual login user code", userCode, "MANUAL-CODE")
    let manualHtml = rate_limit_dashboard.RustCsgRateLimitDashboardManualLoginHtml("manual@example.test", verificationUrl, userCode)
    assertContains("manual login html title", manualHtml, "<title>Manual Login</title>")
    assertContains("manual login html code", manualHtml, "MANUAL-CODE")
    let manualAuthHome = rate_limit_dashboard.RustCsgRateLimitDashboardAccountAuthHome(codexHome, "manual@example.test")
    assertTrue("manual login device-code complete ok", auth_oauth.CompleteDeviceCodeLoginOnceAtIssuer(manualAuthHome,
                                                                                                       baseUrl,
                                                                                                       deviceAuthId,
                                                                                                       userCode,
                                                                                                       "manual@example.test",
                                                                                                       "workspace_manual",
                                                                                                       int64(400),
                                                                                                       manualError))
    let manualAuth = auth_login.LoadAuth(manualAuthHome)
    assertContains("manual login saved mode", manualAuth.authMode, "Chatgpt")
    assertContains("manual login saved access token", manualAuth.accessToken, "tok_manual")
    assertContains("manual login saved refresh token", manualAuth.refreshToken, "refresh_manual")
    assertContains("manual login saved account id", manualAuth.accountId, "workspace_manual")

fn main(): int32 =
    assertTrue("usage: fetch smoke <codex-home> <base-url> <refresh-url>", cmdline.argCount() >= 4)
    let codexHome = cmdline.argStr(1)
    let baseUrl = cmdline.argStr(2)
    let refreshUrl = cmdline.argStr(3)
    testMissingAuth(codexHome, baseUrl)
    testCachedAuth(codexHome, baseUrl, refreshUrl)
    testCachedAuthEmailMismatch(codexHome, baseUrl, refreshUrl)
    testRetry401Refresh(codexHome, baseUrl, refreshUrl)
    testAccountRateLimitsResponse(codexHome, baseUrl, refreshUrl)
    testManualDeviceCode(codexHome, baseUrl)
    echo("rust_csg_app_server_rate_limit_dashboard_fetch_smoke ok")
    return 0
