import cheng/codex/crates/test_binary_support/test_binary_support as tbs

# ═══════════════════════════════════════════════════════════════════════════════
# Test Binary Support — type definition constants smoke test
#
# Ported from codex-rs/codex-test-binary-support/lib.rs
# ═══════════════════════════════════════════════════════════════════════════════

fn testDispatchGuardFieldCount(): bool =
    if tbs.RustCsgTestBinaryDispatchGuardFieldCount != 3: return false
    if tbs.RustCsgTestBinaryDispatchGuardField1 != "codex_home": return false
    if tbs.RustCsgTestBinaryDispatchGuardField3 != "previous_codex_home": return false
    echo("testDispatchGuardFieldCount ok")
    return true

fn testDispatchGuardMethodCount(): bool =
    if tbs.RustCsgTestBinaryDispatchGuardMethodCount != 1: return false
    if tbs.RustCsgTestBinaryDispatchGuardMethod1 != "paths": return false
    echo("testDispatchGuardMethodCount ok")
    return true

fn testDispatchModeVariants(): bool =
    if tbs.RustCsgTestBinaryDispatchModeVariantCount != 3: return false
    if tbs.RustCsgTestBinaryDispatchModeVariant1 != "DispatchArg0Only": return false
    if tbs.RustCsgTestBinaryDispatchModeVariant2 != "Skip": return false
    if tbs.RustCsgTestBinaryDispatchModeVariant3 != "InstallAliases": return false
    echo("testDispatchModeVariants ok")
    return true

fn testFieldNames(): bool =
    if tbs.TestBinaryDispatchGuardFields() != "codex_home|temp_dir,arg0|arg0_path_entry_guard,previous_codex_home|opt_os_string": return false
    if tbs.TestBinaryDispatchModeVariantNames() != "DispatchArg0Only,Skip,InstallAliases": return false
    echo("testFieldNames ok")
    return true

fn contains(text: str, needle: str): bool =
    if needle == "":
        return true
    if needle.len > text.len:
        return false
    for i in 0..<(text.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return true
    return false

fn testGenerateTestConfig(): bool =
    var cfg: str = tbs.generateTestConfig()
    if cfg.len == 0: return false
    if !contains(cfg, "timeout_secs"): return false
    if !contains(cfg, "60"): return false
    if !contains(cfg, "capture_output"): return false
    if !contains(cfg, "true"): return false
    if !contains(cfg, "log_level"): return false
    if !contains(cfg, "info"): return false
    echo("testGenerateTestConfig ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testDispatchGuardFieldCount(): allOk = false
    if !testDispatchGuardMethodCount(): allOk = false
    if !testDispatchModeVariants(): allOk = false
    if !testFieldNames(): allOk = false
    if !testGenerateTestConfig(): allOk = false
    if allOk:
        echo("rust_csg_test_binary_support_types_smoke ok")
        return 0
    echo("rust_csg_test_binary_support_types_smoke FAILED")
    return 1
