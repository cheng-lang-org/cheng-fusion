import cheng/codex/crates/utils_sleep_inhibitor/sleep_inhibitor as si

fn main(): int32 =
    # Test disabled, not running
    if si.RustCsgSleepInhibitorShouldInhibit(0, 0) != 0:
        echo("FAIL: disabled+notRunning should not inhibit")
        return 1
    if si.RustCsgSleepInhibitorStatus(0, 0) != si.RustCsgSleepInhibitorStatusInactive:
        echo("FAIL: disabled+notRunning status inactive")
        return 1

    # Test disabled, running
    if si.RustCsgSleepInhibitorShouldInhibit(0, 1) != 0:
        echo("FAIL: disabled+running should not inhibit")
        return 1

    # Test enabled, not running
    if si.RustCsgSleepInhibitorShouldInhibit(1, 0) != 0:
        echo("FAIL: enabled+notRunning should not inhibit")
        return 1

    # Test enabled, running
    if si.RustCsgSleepInhibitorShouldInhibit(1, 1) != 1:
        echo("FAIL: enabled+running should inhibit")
        return 1
    if si.RustCsgSleepInhibitorStatus(1, 1) != si.RustCsgSleepInhibitorStatusActive:
        echo("FAIL: enabled+running status active")
        return 1

    # Test toggle
    if si.RustCsgSleepInhibitorShouldInhibit(1, 0) != 0:
        echo("FAIL: toggled off should not inhibit")
        return 1

    echo("rust_csg_sleep_inhibitor_smoke ok")
    return 0
