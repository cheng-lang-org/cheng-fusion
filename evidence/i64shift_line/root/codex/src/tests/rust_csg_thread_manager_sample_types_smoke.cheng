import cheng/codex/crates/thread_manager_sample/thread_manager_sample as tms
import std/strings

# ═══════════════════════════════════════════════════════════════════════════════
# Thread Manager Sample — type definition constants smoke test
#
# Ported from codex-rs/codex-thread-manager-sample/src/main.rs
# ═══════════════════════════════════════════════════════════════════════════════

fn testArgsFieldCount(): bool =
    if tms.RustCsgThreadManagerSampleArgsFieldCount != 2: return false
    if tms.RustCsgThreadManagerSampleArgsField1 != "model": return false
    if tms.RustCsgThreadManagerSampleArgsField2 != "prompt": return false
    echo("testArgsFieldCount ok")
    return true

fn testConfigRelevantFields(): bool =
    if tms.RustCsgThreadManagerSampleConfigRelevantFieldCount != 5: return false
    if tms.RustCsgThreadManagerSampleConfigRelevantField1 != "model": return false
    if tms.RustCsgThreadManagerSampleConfigRelevantField5 != "codex_home": return false
    echo("testConfigRelevantFields ok")
    return true

fn testFunctionNames(): bool =
    if tms.RustCsgThreadManagerSampleFunctionCount != 3: return false
    if tms.RustCsgThreadManagerSampleFunction1 != "main": return false
    if tms.RustCsgThreadManagerSampleFunction3 != "run_turn": return false
    echo("testFunctionNames ok")
    return true

fn testFieldFormats(): bool =
    if tms.ThreadManagerSampleArgsFields() != "model|opt_str,prompt|vec_str": return false
    if tms.ThreadManagerSampleFunctionNames() != "main,run_main,run_turn": return false
    echo("testFieldFormats ok")
    return true

fn testCreateSampleThread(): bool =
    var cfg: str = tms.createSampleThread("test-thread")
    if cfg.len == 0: return false
    if !strings.StrContains(cfg, "thread_name"): return false
    if !strings.StrContains(cfg, "test-thread"): return false
    if !strings.StrContains(cfg, "model"): return false
    if !strings.StrContains(cfg, "claude-sonnet-4"): return false
    if !strings.StrContains(cfg, "ephemeral"): return false
    echo("testCreateSampleThread ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testArgsFieldCount(): allOk = false
    if !testConfigRelevantFields(): allOk = false
    if !testFunctionNames(): allOk = false
    if !testFieldFormats(): allOk = false
    if !testCreateSampleThread(): allOk = false
    if allOk:
        echo("rust_csg_thread_manager_sample_types_smoke ok")
        return 0
    echo("rust_csg_thread_manager_sample_types_smoke FAILED")
    return 1
