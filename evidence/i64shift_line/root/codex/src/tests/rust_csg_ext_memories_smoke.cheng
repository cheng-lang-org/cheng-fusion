import cheng/codex/crates/ext_memories/ext_memories as em
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Ext Memories — type definition constants smoke test
#
# Ported from codex-rs/ext/memories
# ═══════════════════════════════════════════════════════════════════════════════

fn testConstants(): bool =
    if em.RustCsgExtMemoriesDefaultListMaxResults != 2000: return false
    if em.RustCsgExtMemoriesMaxListResults != 2000: return false
    if em.RustCsgExtMemoriesDefaultSearchMaxResults != 200: return false
    if em.RustCsgExtMemoriesMaxSearchResults != 200: return false
    if em.RustCsgExtMemoriesDefaultReadMaxTokens != 20000: return false
    echo("testConstants ok")
    return true

fn testToolNames(): bool =
    if em.RustCsgExtMemoriesToolNamespace != "memories/": return false
    if em.RustCsgExtMemoriesListToolName != "list": return false
    if em.RustCsgExtMemoriesReadToolName != "read": return false
    if em.RustCsgExtMemoriesSearchToolName != "search": return false
    echo("testToolNames ok")
    return true

fn testBackendMethods(): bool =
    if em.RustCsgExtMemoriesBackendMethodCount != 3: return false
    if em.RustCsgExtMemoriesBackendMethod1 != "list": return false
    if em.RustCsgExtMemoriesBackendMethod3 != "search": return false
    echo("testBackendMethods ok")
    return true

fn testMemoryEntryTypeVariants(): bool =
    if em.RustCsgExtMemoriesMemoryEntryTypeVariantCount != 2: return false
    if em.RustCsgExtMemoriesMemoryEntryTypeVariant1 != "File": return false
    if em.RustCsgExtMemoriesMemoryEntryTypeVariant2 != "Directory": return false
    echo("testMemoryEntryTypeVariants ok")
    return true

fn testSearchMatchModeVariants(): bool =
    if em.RustCsgExtMemoriesSearchMatchModeVariantCount != 3: return false
    if em.RustCsgExtMemoriesSearchMatchModeVariant1 != "All": return false
    if em.RustCsgExtMemoriesSearchMatchModeVariant2 != "Any": return false
    if em.RustCsgExtMemoriesSearchMatchModeVariant3 != "Exact": return false
    echo("testSearchMatchModeVariants ok")
    return true

fn testBackendErrorVariants(): bool =
    if em.RustCsgExtMemoriesBackendErrorVariantCount != 5: return false
    if em.RustCsgExtMemoriesBackendErrorVariant1 != "NotFound": return false
    if em.RustCsgExtMemoriesBackendErrorVariant5 != "IoError": return false
    echo("testBackendErrorVariants ok")
    return true

fn testFormatMemoryContext(): bool =
    let r1 = em.formatMemoryContext("")
    if r1 != "": return false
    let r2 = em.formatMemoryContext("hello")
    if !strutil.Contains(r2, "hello"): return false
    if !strutil.Contains(r2, "<memory_context>"): return false
    if !strutil.Contains(r2, "<entry>"): return false
    if !strutil.Contains(r2, "</memory_context>"): return false
    let r3 = em.formatMemoryContext("a,b")
    if !strutil.Contains(r3, "a"): return false
    if !strutil.Contains(r3, "b"): return false
    echo("testFormatMemoryContext ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testConstants(): allOk = false
    if !testToolNames(): allOk = false
    if !testBackendMethods(): allOk = false
    if !testMemoryEntryTypeVariants(): allOk = false
    if !testSearchMatchModeVariants(): allOk = false
    if !testBackendErrorVariants(): allOk = false
    if !testFormatMemoryContext(): allOk = false

    if allOk:
        echo("rust_csg_ext_memories_smoke ok")
        return 0
    else:
        echo("rust_csg_ext_memories_smoke FAILED")
        return 1