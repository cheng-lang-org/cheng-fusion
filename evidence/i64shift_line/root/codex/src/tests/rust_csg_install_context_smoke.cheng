@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

const
    RustCsgInstallContextStandalone: int32 = 1
    RustCsgInstallContextNpm: int32 = 2
    RustCsgInstallContextBun: int32 = 3
    RustCsgInstallContextBrew: int32 = 4
    RustCsgInstallContextOther: int32 = 5

fn startsWith(s: str, prefix: str): bool =
    if s.len < prefix.len:
        return false
    for i in 0..<prefix.len:
        if s[i] != prefix[i]:
            return false
    return true

fn detectInstallContext(currentExe: str, managedByNpm: bool, managedByBun: bool): int32 =
    if managedByNpm:
        return RustCsgInstallContextNpm
    if managedByBun:
        return RustCsgInstallContextBun
    if currentExe != "":
        if startsWith(currentExe, "/opt/homebrew") || startsWith(currentExe, "/usr/local"):
            return RustCsgInstallContextBrew
    return RustCsgInstallContextOther

fn defaultRgCommand(): str =
    return "rg"

fn main(): int32 =
    # Test basic detection (early returns for npm/bun)
    assert(detectInstallContext("", true, false) == RustCsgInstallContextNpm, "npm detection")
    assert(detectInstallContext("", false, true) == RustCsgInstallContextBun, "bun detection")
    assert(detectInstallContext("", false, false) == RustCsgInstallContextOther, "other detection")

    # Test brew detection via executable path prefix
    assert(detectInstallContext("/opt/homebrew/bin/codex", false, false) == RustCsgInstallContextBrew, "brew detection")
    assert(detectInstallContext("/usr/local/bin/codex", false, false) == RustCsgInstallContextBrew, "brew usr local")

    # Test default rg command
    assert(defaultRgCommand() == "rg", "default rg")

    # Test provider function integration: GetEnv returns "" for unset vars
    let envVal = RustCsgGetEnv("RUST_CSG_INSTALL_CONTEXT_PROBE")
    assert(envVal == "", "unset env var returns empty")

    echo("rust_csg_install_context_smoke ok")
    return 0
