import std/strings
import std/strutils as strutil
import cheng/codex/core/models_manager

# ═══════════════════════════════════════════════════════════════════════════════
# Models-Manager: parseModelPreset smoke tests
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testGpt5Variants(): bool =
    var ok: bool = true
    if !checkEqStr(models_manager.RustCsgParseModelPreset("gpt-5"), "gpt-5", "gpt5 direct"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("GPT-5"), "gpt-5", "gpt5 uppercase"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("gpt_5"), "gpt-5", "gpt5 underscore"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("GPT_5"), "gpt-5", "gpt5 underscore upper"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset(" gpt-5 "), "gpt-5", "gpt5 whitespace"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("  GPT_5  "), "gpt-5", "gpt5 whitespace upper"):
        ok = false
    if ok:
        echo("testGpt5Variants ok")
    return ok

fn testClaudeSonnet4Variants(): bool =
    var ok: bool = true
    if !checkEqStr(models_manager.RustCsgParseModelPreset("claude-sonnet-4"), "claude-sonnet-4", "sonnet direct"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("Claude_Sonnet_4"), "claude-sonnet-4", "sonnet underscore upper"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("CLAUDE-SONNET-4"), "claude-sonnet-4", "sonnet all caps"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset(" claude_sonnet_4 "), "claude-sonnet-4", "sonnet whitespace"):
        ok = false
    if ok:
        echo("testClaudeSonnet4Variants ok")
    return ok

fn testEdgeCases(): bool =
    var ok: bool = true
    # Empty string
    if !checkEqStr(models_manager.RustCsgParseModelPreset(""), "", "empty string"):
        ok = false
    # Only whitespace
    if !checkEqStr(models_manager.RustCsgParseModelPreset("   "), "", "only whitespace"):
        ok = false
    # Mixed separators (underscore + space + hyphen)
    if !checkEqStr(models_manager.RustCsgParseModelPreset("gpt_5"), "gpt-5", "mixed underscore"):
        ok = false
    if !checkEqStr(models_manager.RustCsgParseModelPreset("gpt 5"), "gpt-5", "space separator"):
        ok = false
    # Already canonical
    if !checkEqStr(models_manager.RustCsgParseModelPreset("gpt-5"), "gpt-5", "already canonical"):
        ok = false
    # Leading/trailing tabs
    if !checkEqStr(models_manager.RustCsgParseModelPreset("\tgpt-5\n"), "gpt-5", "tab newline trim"):
        ok = false
    if ok:
        echo("testEdgeCases ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testGpt5Variants(): allOk = false
    if !testClaudeSonnet4Variants(): allOk = false
    if !testEdgeCases(): allOk = false
    if allOk:
        echo("rust_csg_models_manager_smoke ok")
        return 0
    else:
        echo("rust_csg_models_manager_smoke FAILED")
        return 1
