import cheng/codex/crates/agent_identity/agent_identity as m

fn main(): int32 =
    var pass: int32

    # JwtAudience
    if m.RustCsgAgentIdentityJwtAudience().len > 0: pass = pass + 1

    # JwtIssuer
    if m.RustCsgAgentIdentityJwtIssuer().len > 0: pass = pass + 1

    # TaskRegistrationTimeoutSec
    if m.RustCsgAgentTaskRegistrationTimeoutSec() > 0: pass = pass + 1

    # JwksTimeoutSec
    if m.RustCsgAgentIdentityJwksTimeoutSec() > 0: pass = pass + 1

    # stripTrailingSlash
    if m.stripTrailingSlash("https://api.example.com/") == "https://api.example.com": pass = pass + 1
    if m.stripTrailingSlash("no-slash") == "no-slash": pass = pass + 1

    # JwksUrl
    if m.RustCsgAgentIdentityJwksUrl("https://chatgpt.com").len > 0: pass = pass + 1

    # AgentRegistrationUrl
    if m.RustCsgAgentRegistrationUrl("https://chatgpt.com").len > 0: pass = pass + 1

    if pass == 8:
        echo("rust_csg_oracle_agent_identity ok")
        return 0
    echo("oracle FAIL")
    return 1

main()