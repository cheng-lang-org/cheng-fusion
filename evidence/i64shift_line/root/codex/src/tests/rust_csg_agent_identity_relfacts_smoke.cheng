# ═══════════════════════════════════════════════════════════════════════════════
# agent-identity — relfacts equivalence smoke test
#
# Verifies that the agent-identity module's defined functions, types, and fields
# match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgAgentIdentityKey =\n        agentRuntimeId: str\n        privateKeyPkcs8Base64: str\n\nfn RustCsgAgentIdentityJwtAudience(): str\nfn RustCsgAgentIdentityJwtIssuer(): str\nfn RustCsgAgentTaskRegistrationTimeoutSec(): int32\nfn RustCsgAgentIdentityJwksTimeoutSec(): int32\nfn RustCsgAgentIdentityJwksUrl(chatgptBaseUrl: str): str\nfn RustCsgAgentRegistrationUrl(chatgptBaseUrl: str): str\nfn RustCsgAgentIdentityEncodeSshPublicKey(keyBytes: str): str\nfn RustCsgAgentIdentityBuildJwtPayload(subject: str, audience: str, expiry: int32): str\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tagent_identity\nFunction\tagent_identity\tRustCsgAgentIdentityJwtAudience\tstr\nFunction\tagent_identity\tRustCsgAgentIdentityJwtIssuer\tstr\nFunction\tagent_identity\tRustCsgAgentTaskRegistrationTimeoutSec\tint32\nFunction\tagent_identity\tRustCsgAgentIdentityJwksTimeoutSec\tint32\nFunction\tagent_identity\tRustCsgAgentIdentityJwksUrl\tstr\nFunction\tagent_identity\tRustCsgAgentRegistrationUrl\tstr\nFunction\tagent_identity\tRustCsgAgentIdentityEncodeSshPublicKey\tstr\nFunction\tagent_identity\tRustCsgAgentIdentityBuildJwtPayload\tstr\nLocalType\tagent_identity\tRustCsgAgentIdentityKey\nHasField\tagent_identity\tRustCsgAgentIdentityKey\tagentRuntimeId\tstr\nHasField\tagent_identity\tRustCsgAgentIdentityKey\tprivateKeyPkcs8Base64\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 8, "source function count")
    assert(est == 1, "source type count")
    assert(esfd == 2, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 8, "oracle function count")
    assert(ost == 1, "oracle type count")
    assert(osfd == 2, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_agent_identity_relfacts_smoke ok")
    return 0
