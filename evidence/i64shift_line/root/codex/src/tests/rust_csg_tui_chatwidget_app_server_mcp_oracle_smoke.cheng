import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_app_server_mcp_oracle as oracle

fn RustCsgTuiChatwidgetAppServerMcpFirstDiff(expected: str, actual: str): str =
    let expectedLen: int32 = strings.Len(expected)
    let actualLen: int32 = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen

    var line: int32 = 1
    var col: int32 = 1
    var i: int32 = 0
    while i < limit:
        if expected[i] != actual[i]:
            return strutil.Join(["line=", strings.IntToStr(line), " byte_col=", strings.IntToStr(col)], "")
        if expected[i] == '\n':
            line = line + 1
            col = 1
        else:
            col = col + 1
        i = i + 1

    return strutil.Join(["line=", strings.IntToStr(line), " byte_col=", strings.IntToStr(col)], "")

fn RustCsgTuiChatwidgetAppServerMcpCheck(path: str,
                                         expectedSource: str,
                                         expectedExpression: str,
                                         expectedBody: str,
                                         name: str): int32 =
    let parsed = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !parsed.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", parsed.error], ""))
        return 1
    if parsed.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source expected=", expectedSource, " got=", parsed.source], ""))
        return 1
    if parsed.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression expected=", expectedExpression, " got=", parsed.expression], ""))
        return 1
    if expectedBody != parsed.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(parsed.bodyByteLen),
            " ",
            RustCsgTuiChatwidgetAppServerMcpFirstDiff(expectedBody, parsed.body),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 4:
        echo("FAIL usage: rust_csg_tui_chatwidget_app_server_mcp_oracle_smoke <3 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetAppServerMcpCheck(cmdline.argStr(i),
                                                                "tui/src/chatwidget/tests.rs",
                                                                "combined",
                                                                oracle.RustCsgTuiChatwidgetAppServerCollabSpawnCompleted(),
                                                                "app_server_collab_spawn_completed")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetAppServerMcpCheck(cmdline.argStr(i),
                                                                "tui/src/chatwidget/tests.rs",
                                                                "terminal.backend()",
                                                                oracle.RustCsgTuiChatwidgetMcpStartupHeaderBooting(),
                                                                "mcp_startup_header_booting")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetAppServerMcpCheck(cmdline.argStr(i),
                                                                "tui/src/chatwidget/tests.rs",
                                                                "term.backend().vt100().screen().contents()",
                                                                oracle.RustCsgTuiChatwidgetAppServerMcpStartupFailureWarningHistory(),
                                                                "app_server_mcp_startup_failure_warning_history")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_app_server_mcp_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_app_server_mcp_oracle_smoke FAILED")
    return exitCode
