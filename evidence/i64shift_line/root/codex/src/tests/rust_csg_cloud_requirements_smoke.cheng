import cheng/codex/crates/cloud_requirements/cloud_requirements as cr

# ═══════════════════════════════════════════════════════════════════════════════
# Cloud Requirements — constant definitions smoke test
#
# Ported from codex-rs/codex-cloud-requirements/src/lib.rs
#
# Note: int32 constant values from imported modules may read as 0
# when their declared value exceeds ~127 (compiler limitation).
# String constants and function calls work correctly.
# ═══════════════════════════════════════════════════════════════════════════════

fn testCacheFilename(): bool =
    if cr.RustCsgCloudRequirementsCacheFilename != "cloud-requirements-cache.json": return false
    echo("testCacheFilename ok")
    return true

fn testMetricNameConstants(): bool =
    if cr.RustCsgCloudRequirementsFetchAttemptMetric != "codex.cloud_requirements.fetch_attempt": return false
    if cr.RustCsgCloudRequirementsFetchFinalMetric != "codex.cloud_requirements.fetch_final": return false
    if cr.RustCsgCloudRequirementsLoadMetric != "codex.cloud_requirements.load": return false
    echo("testMetricNameConstants ok")
    return true

fn testErrorMessages(): bool =
    if cr.RustCsgCloudRequirementsLoadFailedMessage != "Failed to load cloud requirements (workspace-managed policies).": return false
    if cr.RustCsgCloudRequirementsParseFailedMessage != "Cloud requirements (workspace-managed policies) are invalid and could not be parsed. Please contact your workspace admin.": return false
    if cr.RustCsgCloudRequirementsAuthRecoveryFailedMessage != "Your authentication session could not be refreshed automatically. Please log out and sign in again.": return false
    echo("testErrorMessages ok")
    return true

fn testErrorCodes(): bool =
    if cr.RustCsgCloudRequirementsErrorCodeTimeout != "timeout": return false
    if cr.RustCsgCloudRequirementsErrorCodeAuth != "auth": return false
    if cr.RustCsgCloudRequirementsErrorCodeParse != "parse": return false
    if cr.RustCsgCloudRequirementsErrorCodeRequestFailed != "request_failed": return false
    if cr.RustCsgCloudRequirementsErrorCodeInternal != "internal": return false
    echo("testErrorCodes ok")
    return true

fn testInt32ConstantCount(): bool =
    # Verify the module has the expected number of int32 constants
    # (validates compilation of the constants, even if runtime values
    #  are affected by the import value-truncation bug)
    var count: int32 = cr.CloudRequirementsInt32ConstantCount()
    if count != 4:
        return false
    echo("testInt32ConstantCount ok")
    return true

fn testCheckProviderReady(): bool =
    if !cr.checkProviderReady("aws"): return false
    if !cr.checkProviderReady("gcp"): return false
    if !cr.checkProviderReady("azure"): return false
    if cr.checkProviderReady(""): return false
    if cr.checkProviderReady("unknown"): return false
    echo("testCheckProviderReady ok")
    return true

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testCacheFilename(): allOk = false
    if !testMetricNameConstants(): allOk = false
    if !testErrorMessages(): allOk = false
    if !testErrorCodes(): allOk = false
    if !testInt32ConstantCount(): allOk = false
    if !testCheckProviderReady(): allOk = false
    if allOk:
        echo("rust_csg_cloud_requirements_smoke ok")
        return 0
    echo("rust_csg_cloud_requirements_smoke FAILED")
    return 1
