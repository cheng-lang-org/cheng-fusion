import cheng/codex/protocol/exec_server_wire
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn assertRoundtripText(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn main(): int32 =
    assertRoundtripText("wire_probe", "", wire.RustCsgCat("", ""))

    var initParams: types.RustCsgExecServerInitializeParams
    initParams.clientName = "codex-app"
    initParams.resumeSessionIdJson = "\"session-old\""
    let initParamsJson = exec_server_wire.RustCsgExecServerInitializeParamsToJson(initParams)
    let initParamsBack = exec_server_wire.RustCsgExecServerInitializeParamsFromJson(initParamsJson)
    assertRoundtripText("exec_server_initialize_params", initParamsJson, exec_server_wire.RustCsgExecServerInitializeParamsToJson(initParamsBack))

    var initResponse: types.RustCsgExecServerInitializeResponse
    initResponse.sessionId = "session-1"
    let initResponseJson = exec_server_wire.RustCsgExecServerInitializeResponseToJson(initResponse)
    let initResponseBack = exec_server_wire.RustCsgExecServerInitializeResponseFromJson(initResponseJson)
    assertRoundtripText("exec_server_initialize_response", initResponseJson, exec_server_wire.RustCsgExecServerInitializeResponseToJson(initResponseBack))

    var execParams: types.RustCsgExecServerExecParams
    execParams.processId = "proc-1"
    execParams.argv = ["bash", "-lc", "echo ok"]
    execParams.cwd = "/repo"
    execParams.envPolicyJson = "{\"inherit\":\"all\",\"ignoreDefaultExcludes\":false,\"exclude\":[],\"set\":{\"RUST_LOG\":\"debug\"},\"includeOnly\":[]}"
    execParams.envJson = "{\"PATH\":\"/usr/bin\"}"
    execParams.tty = false
    execParams.pipeStdin = true
    execParams.arg0Json = "\"bash\""
    let execParamsJson = exec_server_wire.RustCsgExecServerExecParamsToJson(execParams)
    let execParamsBack = exec_server_wire.RustCsgExecServerExecParamsFromJson(execParamsJson)
    assertRoundtripText("exec_server_exec_params", execParamsJson, exec_server_wire.RustCsgExecServerExecParamsToJson(execParamsBack))

    var execResponse: types.RustCsgExecServerExecResponse
    execResponse.processId = "proc-1"
    let execResponseJson = exec_server_wire.RustCsgExecServerExecResponseToJson(execResponse)
    let execResponseBack = exec_server_wire.RustCsgExecServerExecResponseFromJson(execResponseJson)
    assertRoundtripText("exec_server_exec_response", execResponseJson, exec_server_wire.RustCsgExecServerExecResponseToJson(execResponseBack))

    var readParams: types.RustCsgExecServerReadParams
    readParams.processId = "proc-1"
    readParams.afterSeqJson = "2"
    readParams.maxBytesJson = "4096"
    readParams.waitMsJson = "50"
    let readParamsJson = exec_server_wire.RustCsgExecServerReadParamsToJson(readParams)
    let readParamsBack = exec_server_wire.RustCsgExecServerReadParamsFromJson(readParamsJson)
    assertRoundtripText("exec_server_read_params", readParamsJson, exec_server_wire.RustCsgExecServerReadParamsToJson(readParamsBack))

    var readResponse: types.RustCsgExecServerReadResponse
    readResponse.chunksJson = "[{\"seq\":3,\"stream\":\"stdout\",\"chunk\":\"b2sK\"}]"
    readResponse.nextSeq = int64(4)
    readResponse.exited = true
    readResponse.exitCodeJson = "0"
    readResponse.closed = true
    readResponse.failureJson = "null"
    let readResponseJson = exec_server_wire.RustCsgExecServerReadResponseToJson(readResponse)
    let readResponseBack = exec_server_wire.RustCsgExecServerReadResponseFromJson(readResponseJson)
    assertRoundtripText("exec_server_read_response", readResponseJson, exec_server_wire.RustCsgExecServerReadResponseToJson(readResponseBack))

    var writeParams: types.RustCsgExecServerWriteParams
    writeParams.processId = "proc-1"
    writeParams.chunkBase64 = "aW4K"
    let writeParamsJson = exec_server_wire.RustCsgExecServerWriteParamsToJson(writeParams)
    let writeParamsBack = exec_server_wire.RustCsgExecServerWriteParamsFromJson(writeParamsJson)
    assertRoundtripText("exec_server_write_params", writeParamsJson, exec_server_wire.RustCsgExecServerWriteParamsToJson(writeParamsBack))

    var writeResponse: types.RustCsgExecServerWriteResponse
    writeResponse.status = "accepted"
    let writeResponseJson = exec_server_wire.RustCsgExecServerWriteResponseToJson(writeResponse)
    let writeResponseBack = exec_server_wire.RustCsgExecServerWriteResponseFromJson(writeResponseJson)
    assertRoundtripText("exec_server_write_response", writeResponseJson, exec_server_wire.RustCsgExecServerWriteResponseToJson(writeResponseBack))

    var terminateParams: types.RustCsgExecServerTerminateParams
    terminateParams.processId = "proc-1"
    let terminateParamsJson = exec_server_wire.RustCsgExecServerTerminateParamsToJson(terminateParams)
    let terminateParamsBack = exec_server_wire.RustCsgExecServerTerminateParamsFromJson(terminateParamsJson)
    assertRoundtripText("exec_server_terminate_params", terminateParamsJson, exec_server_wire.RustCsgExecServerTerminateParamsToJson(terminateParamsBack))

    var terminateResponse: types.RustCsgExecServerTerminateResponse
    terminateResponse.running = false
    let terminateResponseJson = exec_server_wire.RustCsgExecServerTerminateResponseToJson(terminateResponse)
    let terminateResponseBack = exec_server_wire.RustCsgExecServerTerminateResponseFromJson(terminateResponseJson)
    assertRoundtripText("exec_server_terminate_response", terminateResponseJson, exec_server_wire.RustCsgExecServerTerminateResponseToJson(terminateResponseBack))

    var outputDelta: types.RustCsgExecServerOutputDeltaNotification
    outputDelta.processId = "proc-1"
    outputDelta.seq = int64(5)
    outputDelta.stream = "pty"
    outputDelta.chunkBase64 = "JCA="
    let outputDeltaJson = exec_server_wire.RustCsgExecServerOutputDeltaNotificationToJson(outputDelta)
    let outputDeltaBack = exec_server_wire.RustCsgExecServerOutputDeltaNotificationFromJson(outputDeltaJson)
    assertRoundtripText("exec_server_output_delta", outputDeltaJson, exec_server_wire.RustCsgExecServerOutputDeltaNotificationToJson(outputDeltaBack))

    var exited: types.RustCsgExecServerExitedNotification
    exited.processId = "proc-1"
    exited.seq = int64(6)
    exited.exitCode = 0
    let exitedJson = exec_server_wire.RustCsgExecServerExitedNotificationToJson(exited)
    let exitedBack = exec_server_wire.RustCsgExecServerExitedNotificationFromJson(exitedJson)
    assertRoundtripText("exec_server_exited", exitedJson, exec_server_wire.RustCsgExecServerExitedNotificationToJson(exitedBack))

    var closed: types.RustCsgExecServerClosedNotification
    closed.processId = "proc-1"
    closed.seq = int64(7)
    let closedJson = exec_server_wire.RustCsgExecServerClosedNotificationToJson(closed)
    let closedBack = exec_server_wire.RustCsgExecServerClosedNotificationFromJson(closedJson)
    assertRoundtripText("exec_server_closed", closedJson, exec_server_wire.RustCsgExecServerClosedNotificationToJson(closedBack))

    var httpParams: types.RustCsgExecServerHttpRequestParams
    httpParams.method = "POST"
    httpParams.url = "https://example.test/rpc"
    httpParams.headersJson = "[{\"name\":\"content-type\",\"value\":\"application/json\"}]"
    httpParams.bodyBase64Json = "\"e30=\""
    httpParams.timeoutMsJson = "1234"
    httpParams.requestId = "http-1"
    httpParams.streamResponse = true
    let httpParamsJson = exec_server_wire.RustCsgExecServerHttpRequestParamsToJson(httpParams)
    let httpParamsBack = exec_server_wire.RustCsgExecServerHttpRequestParamsFromJson(httpParamsJson)
    assertRoundtripText("exec_server_http_request", httpParamsJson, exec_server_wire.RustCsgExecServerHttpRequestParamsToJson(httpParamsBack))

    var httpResponse: types.RustCsgExecServerHttpRequestResponse
    httpResponse.status = 200
    httpResponse.headersJson = "[{\"name\":\"content-type\",\"value\":\"application/json\"}]"
    httpResponse.bodyBase64 = "e30="
    let httpResponseJson = exec_server_wire.RustCsgExecServerHttpRequestResponseToJson(httpResponse)
    let httpResponseBack = exec_server_wire.RustCsgExecServerHttpRequestResponseFromJson(httpResponseJson)
    assertRoundtripText("exec_server_http_response", httpResponseJson, exec_server_wire.RustCsgExecServerHttpRequestResponseToJson(httpResponseBack))

    var httpDelta: types.RustCsgExecServerHttpBodyDeltaNotification
    httpDelta.requestId = "http-1"
    httpDelta.seq = int64(1)
    httpDelta.deltaBase64 = "e30="
    httpDelta.done = true
    httpDelta.errorJson = "null"
    let httpDeltaJson = exec_server_wire.RustCsgExecServerHttpBodyDeltaNotificationToJson(httpDelta)
    let httpDeltaBack = exec_server_wire.RustCsgExecServerHttpBodyDeltaNotificationFromJson(httpDeltaJson)
    assertRoundtripText("exec_server_http_body_delta", httpDeltaJson, exec_server_wire.RustCsgExecServerHttpBodyDeltaNotificationToJson(httpDeltaBack))

    echo("rust_csg_exec_server_roundtrip_smoke ok")
    return 0
