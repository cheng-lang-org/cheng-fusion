import cheng/codex/crates/uds/uds as m

fn main(): int32 =
    var pass: int32

    if m.UdsSocketDirMode() > 0: pass = pass + 1
    if m.UdsValidateSocketPath("/tmp/test.sock"): pass = pass + 1

    if pass == 2:
        echo("rust_csg_oracle_uds ok")
        return 0
    echo("oracle FAIL")
    return 1

main()