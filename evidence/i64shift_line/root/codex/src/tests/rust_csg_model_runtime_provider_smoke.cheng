import std/strings
import std/system

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

@importc("strlen")
fn testCStringLen(raw: ptr): int64

@importc("free")
fn testCStringFree(raw: ptr)

@importc("RustCsgModelEmbedding")
fn RustCsgModelEmbeddingAbi(model: cstring, input: cstring, apiKey: cstring, apiUrl: cstring): cstring

@importc("RustCsgModelImageGenerate")
fn RustCsgModelImageGenerateAbi(model: cstring, prompt: cstring, apiKey: cstring, apiUrl: cstring): cstring

fn testCStringToOwnedStr(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    let count = int32(testCStringLen(ptr(raw)))
    if count <= 0:
        testCStringFree(ptr(raw))
        return ""
    let out = system.StrFromBytesCopy(ptr(raw), count)
    testCStringFree(ptr(raw))
    return out

fn RustCsgModelEmbedding(model: str, input: str, apiKey: str, apiUrl: str): str =
    let raw = RustCsgModelEmbeddingAbi(system.strToCStringTemp(model),
                                       system.strToCStringTemp(input),
                                       system.strToCStringTemp(apiKey),
                                       system.strToCStringTemp(apiUrl))
    return testCStringToOwnedStr(raw)

fn RustCsgModelImageGenerate(model: str, prompt: str, apiKey: str, apiUrl: str): str =
    let raw = RustCsgModelImageGenerateAbi(system.strToCStringTemp(model),
                                           system.strToCStringTemp(prompt),
                                           system.strToCStringTemp(apiKey),
                                           system.strToCStringTemp(apiUrl))
    return testCStringToOwnedStr(raw)

fn expectEq(label: str, got: str, expected: str): bool =
    if got != expected:
        echo(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(label, " FAIL expected="), expected), strings.ConcatStr(" got=", got)))
        return false
    return true

fn main(): int32 =
    let baseUrl = RustCsgGetEnv("MODEL_PROVIDER_TEST_BASE_URL")
    if baseUrl == "":
        echo("MODEL_PROVIDER_TEST_BASE_URL missing")
        return 1
    let embeddingUrl = strings.ConcatStr(baseUrl, "/v1/embeddings")
    let imageUrl = strings.ConcatStr(baseUrl, "/v1/images/generations")
    let embedding = RustCsgModelEmbedding("text-embedding-3-small", "hello", "test-key", embeddingUrl)
    if !expectEq("embedding", embedding, "[0.1,0.2,-3]"):
        return 1
    let image = RustCsgModelImageGenerate("gpt-image-1", "draw", "test-key", imageUrl)
    if !expectEq("image", image, "{\"url\":\"http://image.local/1.png\",\"b64_json\":\"ZmFrZQ==\"}"):
        return 1
    let missing = RustCsgModelEmbedding("", "hello", "test-key", embeddingUrl)
    if !expectEq("missing", missing, "{\"error\":\"missing required arguments\"}"):
        return 1
    echo("rust_csg_model_runtime_provider_smoke ok")
    return 0

main()
