# ═══════════════════════════════════════════════════════════════════════════════
# utils/stream-parser — relfacts equivalence smoke test
#
# Verifies that the stream_parser crate's defined functions, types, and fields
# match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    XmlNodeType = enum\n        xnElement\n        xnText\n\n    XmlAttr =\n        name: str\n        value: str\n\n    XmlNode =\n        nodeType: int32\n        tag: str\n        text: str\n        attrs: XmlAttr[]\n        children: XmlNode[]\n\nfn strFindAt(haystack: str, start: int32, needle: str, outPos: var int32, outFound: var bool)\nfn strFind(haystack: str, needle: str, outPos: var int32, outFound: var bool)\nfn longestSuffixPrefixLen(s: str, needle: str): int32\nfn findNextOpen(pending: str, specOpens: str[], outPos: var int32, outSpecIdx: var int32, outFound: var bool)\nfn maxOpenPrefixSuffixLen(pending: str, specOpens: str[]): int32\nfn inlinePushStr(pending: var str, activeId: var int32, activeClose: var str, activeContent: var str, specOpens: str[], specCloses: str[], chunk: str, outVisible: var str, outExtracts: var str[])\nfn inlineFinish(activeId: var int32, activeClose: var str, activeContent: var str, pending: var str, outVisible: var str, outExtracts: var str[])\nfn collectInline(specOpens: str[], specCloses: str[], chunks: str[], outVisible: var str, outExtracts: var str[])\nfn stripCitations(text: str, outCitations: var str[]): str\nfn parseInlineTags(text: str, openTag: str, closeTag: str, outVisible: var str, outExtracts: var str[])\nfn parseXmlDocument(xml: str, outRoot: var XmlNode, outError: var str)\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tstream_parser\nDefFunction\tstream_parser\tstrFindAt\thaystack: str, start: int32, needle: str, outPos: var int32, outFound: var bool\t->\t\nDefFunction\tstream_parser\tstrFind\thaystack: str, needle: str, outPos: var int32, outFound: var bool\t->\t\nDefFunction\tstream_parser\tlongestSuffixPrefixLen\ts: str, needle: str\t->\tint32\nDefFunction\tstream_parser\tfindNextOpen\tpending: str, specOpens: str[], outPos: var int32, outSpecIdx: var int32, outFound: var bool\t->\t\nDefFunction\tstream_parser\tmaxOpenPrefixSuffixLen\tpending: str, specOpens: str[]\t->\tint32\nDefFunction\tstream_parser\tinlinePushStr\tpending: var str, activeId: var int32, activeClose: var str, activeContent: var str, specOpens: str[], specCloses: str[], chunk: str, outVisible: var str, outExtracts: var str[]\t->\t\nDefFunction\tstream_parser\tinlineFinish\tactiveId: var int32, activeClose: var str, activeContent: var str, pending: var str, outVisible: var str, outExtracts: var str[]\t->\t\nDefFunction\tstream_parser\tcollectInline\tspecOpens: str[], specCloses: str[], chunks: str[], outVisible: var str, outExtracts: var str[]\t->\t\nDefFunction\tstream_parser\tstripCitations\ttext: str, outCitations: var str[]\t->\tstr\nDefFunction\tstream_parser\tparseInlineTags\ttext: str, openTag: str, closeTag: str, outVisible: var str, outExtracts: var str[]\t->\t\nDefFunction\tstream_parser\tparseXmlDocument\txml: str, outRoot: var XmlNode, outError: var str\t->\t\nLocalType\tstream_parser\tXmlNodeType\nLocalType\tstream_parser\tXmlAttr\nHasField\tstream_parser\tXmlAttr\tname\tstr\nHasField\tstream_parser\tXmlAttr\tvalue\tstr\nLocalType\tstream_parser\tXmlNode\nHasField\tstream_parser\tXmlNode\tnodeType\tint32\nHasField\tstream_parser\tXmlNode\ttag\tstr\nHasField\tstream_parser\tXmlNode\ttext\tstr\nHasField\tstream_parser\tXmlNode\tattrs\tXmlAttr[]\nHasField\tstream_parser\tXmlNode\tchildren\tXmlNode[]\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 11, "source function count")
    assert(est == 3, "source type count")
    assert(esfd == 7, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 11, "oracle function count")
    assert(ost == 3, "oracle type count")
    assert(osfd == 7, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_stream_parser_smoke ok")
    return 0
