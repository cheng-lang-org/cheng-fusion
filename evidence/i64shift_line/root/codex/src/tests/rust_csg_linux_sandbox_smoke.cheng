import std/strings
import std/strings
import std/strutils as strutil
import cheng/codex/crates/linux_sandbox/linux_sandbox

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: linux-sandbox detectBwrapAvailable + buildBwrapCommand
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=|", expected, "| got=|", got, "|"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join([label, " FAIL: expected=", es, " got=", gs], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── detectBwrapAvailable tests ───────────────────────────────────────────

fn testDetectBwrapAvailable(): bool =
    var ok: bool = true
    let available = linux_sandbox.RustCsgLinuxSandboxDetectBwrapAvailable()
    if !checkEqBool(available, false, "detectBwrapAvailable returns false on non-Linux"):
        ok = false
    if ok:
        echo("testDetectBwrapAvailable ok")
    return ok

# ── buildBwrapCommand tests ──────────────────────────────────────────────

fn testBuildBwrapCommandBasic(): bool =
    var ok: bool = true
    let cmd = linux_sandbox.buildBwrapCommand("/sandbox/root", "/sandbox/work", "echo hello")
    # Verify the command contains the key parts
    if !checkEqBool(strutil.Contains(cmd, "/usr/bin/bwrap"), true, "bwrap contains binary"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--unshare-all"), true, "bwrap contains unshare"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--share-net"), true, "bwrap contains share-net"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--bind /sandbox/root /"), true, "bwrap contains root bind"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--ro-bind"), true, "bwrap contains ro-bind"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "echo hello"), true, "bwrap contains command"): ok = false
    if ok:
        echo("testBuildBwrapCommandBasic ok")
    return ok

fn testBuildBwrapCommandEmptyParams(): bool =
    var ok: bool = true
    let cmd1 = linux_sandbox.buildBwrapCommand("", "/work", "cmd")
    if !checkEqStr(cmd1, "", "bwrap empty rootPath"): ok = false
    let cmd2 = linux_sandbox.buildBwrapCommand("/root", "/work", "")
    if !checkEqStr(cmd2, "", "bwrap empty command"): ok = false
    if ok:
        echo("testBuildBwrapCommandEmptyParams ok")
    return ok

fn testBuildBwrapCommandReadonlyDirs(): bool =
    var ok: bool = true
    let cmd = linux_sandbox.buildBwrapCommand("/root", "/work", "ls")
    # Verify readonly directories are mounted
    if !checkEqBool(strutil.Contains(cmd, "--ro-bind /root/usr /usr"), true, "bwrap readonly /usr"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--ro-bind /root/lib /lib"), true, "bwrap readonly /lib"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--ro-bind /root/etc /etc"), true, "bwrap readonly /etc"): ok = false
    if ok:
        echo("testBuildBwrapCommandReadonlyDirs ok")
    return ok

fn testBuildBwrapCommandMinimal(): bool =
    var ok: bool = true
    let cmd = linux_sandbox.buildBwrapCommandMinimal("/root", "/work", "whoami")
    if !checkEqBool(strutil.Contains(cmd, "/usr/bin/bwrap"), true, "minimal contains binary"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--unshare-all"), true, "minimal contains unshare"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "--bind /work /work"), true, "minimal contains workdir bind"): ok = false
    if !checkEqBool(strutil.Contains(cmd, "whoami"), true, "minimal contains command"): ok = false
    # Minimal should NOT have --ro-bind (use strings.strContains as fallback)
    if !checkEqBool(strings.strContains(cmd, "--ro-bind"), false, "minimal no ro-bind"): ok = false
    if ok:
        echo("testBuildBwrapCommandMinimal ok")
    return ok

# ── Main ──────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testDetectBwrapAvailable(): allOk = false
    if !testBuildBwrapCommandBasic(): allOk = false
    if !testBuildBwrapCommandEmptyParams(): allOk = false
    if !testBuildBwrapCommandReadonlyDirs(): allOk = false
    if !testBuildBwrapCommandMinimal(): allOk = false

    # Production function: buildSeccomp
    let sp_default = linux_sandbox.RustCsgLinuxSandboxBuildSeccomp("default")
    if !checkEqBool(strutil.Contains(sp_default, "allow"), true, "seccomp default contains allow"):
        allOk = false
    if !checkEqBool(strutil.Contains(sp_default, "kill"), true, "seccomp default contains kill"):
        allOk = false

    let sp_strict = linux_sandbox.RustCsgLinuxSandboxBuildSeccomp("strict")
    if !checkEqBool(strutil.Contains(sp_strict, "allow"), true, "seccomp strict contains allow"):
        allOk = false
    if sp_strict.len == 0:
        echo("FAIL: seccomp strict should not be empty")
        allOk = false

    let sp_unknown = linux_sandbox.RustCsgLinuxSandboxBuildSeccomp("unknown")
    if !checkEqStr(sp_unknown, "", "seccomp unknown profile"):
        allOk = false

    let sp_nowrite = linux_sandbox.RustCsgLinuxSandboxBuildSeccomp("no_write")
    if !checkEqBool(strutil.Contains(sp_nowrite, "kill"), true, "seccomp no_write contains kill"):
        allOk = false

    let sp_net = linux_sandbox.RustCsgLinuxSandboxBuildSeccomp("network_only")
    if !checkEqBool(strutil.Contains(sp_net, "allow"), true, "seccomp network_only contains allow"):
        allOk = false
    if sp_net.len == 0:
        echo("FAIL: seccomp network_only should not be empty")
        allOk = false

    if allOk:
        echo("rust_csg_linux_sandbox_smoke ok")
        return 0
    else:
        echo("rust_csg_linux_sandbox_smoke FAILED")
        return 1
