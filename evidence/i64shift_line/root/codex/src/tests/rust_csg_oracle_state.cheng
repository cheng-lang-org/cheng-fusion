import cheng/codex/crates/state/state as m

fn main(): int32 =
    var pass: int32

    if m.RustCsgStateSqliteHomeEnvName().len > 0: pass = pass + 1
    if m.RustCsgStateStateDbFileName().len > 0: pass = pass + 1
    if m.RustCsgStateLogsDbFileName().len > 0: pass = pass + 1
    var dbPath = m.RustCsgStateDbPath("/home/user/.codex")
    if dbPath.len > 0: pass = pass + 1

    if pass == 4:
        echo("rust_csg_oracle_state ok")
        return 0
    echo("oracle FAIL")
    return 1

main()