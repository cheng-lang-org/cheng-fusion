import cheng/codex/crates/ansi_escape/ansi_escape as m

fn main(): int32 =
    var pass: int32

    # expandTabs
    if m.RustCsgAnsiEscapeExpandTabs("") == "": pass = pass + 1
    if m.RustCsgAnsiEscapeExpandTabs("hello") == "hello": pass = pass + 1
    if m.RustCsgAnsiEscapeExpandTabs("a\tb") == "a    b": pass = pass + 1
    if m.RustCsgAnsiEscapeExpandTabs("\t") == "    ": pass = pass + 1
    if m.RustCsgAnsiEscapeExpandTabs("\t\t") == "        ": pass = pass + 1

    # classifyAnsiCode
    if m.RustCsgAnsiEscapeClassifyAnsiCode(0) == "reset": pass = pass + 1
    if m.RustCsgAnsiEscapeClassifyAnsiCode(1) == "bold": pass = pass + 1
    if m.RustCsgAnsiEscapeClassifyAnsiCode(999) == "unknown": pass = pass + 1

    if pass == 8:
        echo("rust_csg_oracle_ansi_escape ok")
        return 0
    echo("oracle FAIL")
    return 1

main()