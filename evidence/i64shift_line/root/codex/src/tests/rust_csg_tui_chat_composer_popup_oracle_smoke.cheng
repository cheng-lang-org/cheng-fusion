import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chat_composer_popup_oracle as oracle

fn RustCsgTuiChatComposerPopupExpr(): str =
    return "terminal.backend()"

fn RustCsgTuiChatComposerPopupOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/chat_composer.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != RustCsgTuiChatComposerPopupExpr():
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 5:
        echo("FAIL usage: rust_csg_tui_chat_composer_popup_oracle_smoke <4 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiChatComposerPopupOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerPopupMentionPopupTypePrefixesSnapshot(), "mention_popup_type_prefixes")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerPopupOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerPopupPluginMentionPopupSnapshot(), "plugin_mention_popup")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerPopupOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerPopupSlashMoSnapshot(), "slash_popup_mo")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerPopupOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerPopupSlashResSnapshot(), "slash_popup_res")

    if exitCode == 0:
        echo("rust_csg_tui_chat_composer_popup_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chat_composer_popup_oracle_smoke FAILED")
    return exitCode
