import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/state/state_db_sqlite

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteSymlinkCwdRow")
fn RustCsgAddSqliteSymlinkCwdRow(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertBool(name: str, value: bool) =
    if !value:
        echo(name)
    assert(value, name)

fn assertOk(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn main(): int32 =
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")

    let symlinkCwd = RustCsgAddSqliteSymlinkCwdRow(path)
    assert(symlinkCwd != "", "symlink cwd fixture")
    var symlinkPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", symlinkCwd, "resume", "--last", "continue"])
    var symlinkCwdBlockedReason: str
    let symlinkExpectedCwd = resume_lookup_sqlite.RustCsgExecResumeSqliteCwdFilter(symlinkPlan,
                                                                                   true,
                                                                                   symlinkCwdBlockedReason)
    checkEq("symlink_cwd_filter_blocked", symlinkCwdBlockedReason, "")
    var symlinkRow = state_db_sqlite.RustCsgStateDbThreadById(path, "thread-symlink-cwd")
    assertBool("symlink_row_loaded", symlinkRow.ok)
    assertBool("symlink_row_cwd_match",
               resume_lookup_sqlite.RustCsgExecResumeSqliteRowCwdMatches(symlinkRow, symlinkExpectedCwd))
    var symlinkResult: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path, symlinkPlan, "openai", symlinkResult)
    assertOk("symlink_cwd_match", symlinkResult)
    checkEq("symlink_cwd_thread", symlinkResult.threadId, "thread-symlink-cwd")

    echo("rust_csg_exec_resume_lookup_sqlite_symlink_smoke ok")
    return 0
