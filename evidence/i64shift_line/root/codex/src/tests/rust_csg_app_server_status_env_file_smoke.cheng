import cheng/codex/app_server/status_env
import cheng/codex/protocol/wire
import std/os as os

fn assertTrue(name: str, value: bool) =
    if !value:
        echo(wire.RustCsgCat("FAIL: ", name))
    assert(value, name)

fn assertContains(name: str, haystack: str, needle: str) =
    if !wire.RustCsgContains(haystack, needle):
        echo(wire.RustCsgCat("FAIL: ", name))
        echo(wire.RustCsgCat("missing: ", needle))
    assert(wire.RustCsgContains(haystack, needle), name)

fn main(): int32 =
    let path = "/Users/lbcheng/codex-lbcheng/.env"
    let content = os.ReadFile(path)
    assertTrue("real status env readable", content != "")
    var out: str
    var error: str
    let ok = status_env.RustCsgAppServerStatusFromDotEnv(content, path, out, error)
    if !ok:
        echo(wire.RustCsgCat("status env error: ", error))
    assertTrue("real status env parsed", ok)
    let accountCount = wire.RustCsgJsonFindInt32(out, "accountCount")
    assertTrue("real status env has accounts", accountCount > 0)
    assertContains("real env has no quota json", out, "\"quotaDataAvailable\":false")
    assertContains("real env password configured", out, "\"passwordConfigured\":true")
    var queryOut: str
    assertTrue("real subscription quota env parsed", status_env.RustCsgAppServerSubscriptionQuotaFromDotEnv(content, path, queryOut, error))
    assertContains("real subscription quota missing data", queryOut, "\"quotaDataAvailable\":false")
    echo("rust_csg_app_server_status_env_file_smoke ok")
    return 0
