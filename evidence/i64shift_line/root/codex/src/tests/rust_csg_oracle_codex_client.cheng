import cheng/codex/crates/codex_client/codex_client as cc

fn main(): int32 =
    var pass: int32

    if cc.buildRequestId() == "req_1_1": pass = pass + 1

    # RetryPolicy field constants
    if cc.RustCsgRetryPolicyFieldCount == 3: pass = pass + 1
    if cc.RustCsgRetryPolicyField1 == "max_attempts": pass = pass + 1
    if cc.RustCsgRetryPolicyField2 == "base_delay": pass = pass + 1
    if cc.RustCsgRetryPolicyField3 == "retry_on": pass = pass + 1

    # TransportError variant constants
    if cc.RustCsgTransportErrorVariantCount == 5: pass = pass + 1
    if cc.RustCsgTransportErrorVariant1 == "Http": pass = pass + 1
    if cc.TransportErrorVariantNames() == "Http,RetryLimit,Timeout,Network,Build": pass = pass + 1

    # Request field constants
    if cc.RustCsgRequestFieldCount == 6: pass = pass + 1
    if cc.RequestFields() == "method|http_method,url|str,headers|header_map,body|opt_request_body,compression|request_compression,timeout|opt_duration": pass = pass + 1

    # CodexHttpClient constants
    if cc.RustCsgCodexHttpClientFieldCount == 1: pass = pass + 1
    if cc.CodexHttpClientFields() == "inner|reqwest_client": pass = pass + 1

    if pass == 12:
        echo("rust_csg_oracle_codex_client ok")
        return 0
    echo("oracle FAIL")
    return 1

main()