# ═══════════════════════════════════════════════════════════════════════════════
# CHENG_RELFACTS RuntimeRequirement Ranking Smoke Test
#
# Verifies that RuntimeRequirement predicates are emitted and can be counted
# in a CHENG_RELFACTS oracle string. Self-contained pattern matching
# rust_csg_relfacts_roundtrip_smoke.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountRr(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 2 && oracle[lineStart] == 'R' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn CountRrCall(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 24:
                if oracle[lineStart] == 'R' && oracle[lineStart + 1] == 'u':
                    # "RuntimeRequirement"(18) + \t(1) + domain(3) + \t(1) = offset 23 for kind
                    if oracle[lineStart + 23] == 'c' && oracle[lineStart + 24] == 'a':
                        c = c + 1
    return c

fn main(): int32 =
    let oracle = "CHENG_RELFACTS_ORACLE\nRuntimeRequirement\tweb\tset\twindow.location\tclosed\nRuntimeRequirement\tweb\tget\tlocalStorage.getItem\topen\nRuntimeRequirement\tweb\tset\twindow.location\tclosed\nRuntimeRequirement\tweb\tcall\tfetch\tclosed\nRuntimeRequirement\tweb\tget\tlocalStorage.getItem\topen\nRuntimeRequirement\tweb\tcall\tfetch\tclosed\nRuntimeRequirement\tweb\tcall\tfetch\tclosed\n"

    let total = CountRr(oracle)
    assert(total == 7, "expected 7 RuntimeRequirement lines")

    let callCount = CountRrCall(oracle)
    assert(callCount == 3, "expected 3 call requirements")

    echo("rust_csg_relfacts_rr_smoke ok")
    return 0

main()
