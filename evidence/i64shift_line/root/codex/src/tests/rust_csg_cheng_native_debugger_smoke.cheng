import std/strings
import cheng/codex/app_server/cheng_evidence_ledger as ledger
import cheng/codex/app_server/cheng_native_tools as native
import cheng/codex/app_server/cheng_toolchain_resolver as resolver
import cheng/codex/protocol/wire

fn assertContains(name: str, text: str, needle: str) =
    if !strings.StrContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(strings.StrContains(text, needle), name)

fn assertNotContains(name: str, text: str, needle: str) =
    if strings.StrContains(text, needle):
        echo(name)
        echo(text)
        echo(needle)
    assert(!strings.StrContains(text, needle), name)

fn jsonRootInReport(root: str, sourcePath: str, reportPath: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("root", root))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("in", sourcePath))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reportOut", reportPath))
    out = wire.RustCsgCat(out, "}")
    return out

fn jsonRawReport(root: str, rawText: str, reportPath: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("root", root))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("rawText", rawText))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("reportOut", reportPath))
    out = wire.RustCsgCat(out, "}")
    return out

fn main(): int32 =
    ledger.ChengEvidenceLedgerReset()
    let root = resolver.ChengToolchainCurrentRoot()
    let zeroSource = resolver.ChengToolchainPathJoin(root, "src/tests/ordinary_zero_exit_fixture.cheng")
    let profileSource = resolver.ChengToolchainPathJoin(root, "src/tests/ordinary_profile_hotspots_fixture.cheng")

    let debugReportPath = "/tmp/cheng_native_debug_report_smoke.txt"
    let debugReport = native.ChengNativeHandleToolCall(1,
                                                       "cheng_debug_report",
                                                       jsonRootInReport(root, zeroSource, debugReportPath))
    let debugAvailable = strings.StrContains(debugReport, "\"success\":true")
    if debugAvailable:
        assertContains("debug-report records debugger evidence", debugReport, "cheng.debugger")
        assertContains("debug-report returns report path", debugReport, debugReportPath)
    else:
        assertContains("debug-report hard-fails without real command", debugReport, "\"success\":false")
        assertNotContains("debug-report failure has no success evidence", debugReport, "\"source\":\"cheng.debugger\"")
        echo(" rust_csg_cheng_native_debugger_smoke ok")
        return 0

    let lineMapPath = "/tmp/cheng_native_line_map_smoke.txt"
    let lineMap = native.ChengNativeHandleToolCall(2,
                                                   "cheng_print_line_map",
                                                   jsonRootInReport(root, zeroSource, lineMapPath))
    let lineMapAvailable = strings.StrContains(lineMap, "\"success\":true")
    if lineMapAvailable:
        assertContains("line-map records debugger evidence", lineMap, "cheng.debugger")
    else:
        assertContains("print-line-map hard-fails without real command", lineMap, "\"success\":false")

    let symbolsPath = "/tmp/cheng_native_symbols_smoke.txt"
    let symbols = native.ChengNativeHandleToolCall(3,
                                                   "cheng_print_symbols",
                                                   jsonRootInReport(root, zeroSource, symbolsPath))
    let symbolsAvailable = strings.StrContains(symbols, "\"success\":true")
    if symbolsAvailable:
        assertContains("symbols records debugger evidence", symbols, "cheng.debugger")
    else:
        assertContains("print-symbols hard-fails without real command", symbols, "\"success\":false")

    let crashReportPath = "/tmp/cheng_native_crash_report_smoke.txt"
    let crashReport = native.ChengNativeHandleToolCall(4,
                                                       "cheng_crash_report",
                                                       jsonRawReport(root,
                                                                     "cheng_crash_raw_v1\nreason=segv\nregs pc=0x1\nm#0 main /tmp/main.cheng:1\n",
                                                                     crashReportPath))
    let crashAvailable = strings.StrContains(crashReport, "\"success\":true")
    if crashAvailable:
        assertContains("crash-report records debugger evidence", crashReport, "cheng.debugger")
    else:
        assertContains("crash-report hard-fails without real command", crashReport, "\"success\":false")

    let badCrash = native.ChengNativeHandleToolCall(5,
                                                    "cheng_crash_report",
                                                    jsonRawReport(root, "trace trap\n", "/tmp/cheng_native_bad_crash_report_smoke.txt"))
    assertContains("plain trace trap hard-fails", badCrash, "\"success\":false")
    assertNotContains("plain trace trap does not record success evidence", badCrash, "cheng.debugger")

    let profileReportPath = "/tmp/cheng_native_profile_report_smoke.txt"
    let profileReport = native.ChengNativeHandleToolCall(6,
                                                         "cheng_profile_report",
                                                         jsonRawReport(root,
                                                                       "cheng_profile_raw\ntotal_samples=1\ndropped_samples=0\nsample\t0x1\tmain\t/tmp/main.cheng:1\n",
                                                                       profileReportPath))
    let profileAvailable = strings.StrContains(profileReport, "\"success\":true")
    if profileAvailable:
        assertContains("profile-report records profile evidence", profileReport, "cheng.profile")
    else:
        assertContains("profile-report hard-fails without real command", profileReport, "\"success\":false")

    let badProfile = native.ChengNativeHandleToolCall(7,
                                                      "cheng_profile_report",
                                                      jsonRawReport(root, "samples: fake\n", "/tmp/cheng_native_bad_profile_report_smoke.txt"))
    assertContains("bad raw profile hard-fails", badProfile, "\"success\":false")
    assertNotContains("bad raw profile does not record success evidence", badProfile, "cheng.profile")

    var profileRunArgs = "{"
    profileRunArgs = wire.RustCsgCat(profileRunArgs, wire.RustCsgJsonFieldStr("root", root))
    profileRunArgs = wire.RustCsgCat(profileRunArgs, ",")
    profileRunArgs = wire.RustCsgCat(profileRunArgs, wire.RustCsgJsonFieldStr("in", profileSource))
    profileRunArgs = wire.RustCsgCat(profileRunArgs, ",")
    profileRunArgs = wire.RustCsgCat(profileRunArgs, wire.RustCsgJsonFieldStr("out", "/tmp/cheng_native_profile_run_smoke"))
    profileRunArgs = wire.RustCsgCat(profileRunArgs, ",")
    profileRunArgs = wire.RustCsgCat(profileRunArgs, wire.RustCsgJsonFieldStr("reportOut", "/tmp/cheng_native_profile_run_smoke.profile.txt"))
    profileRunArgs = wire.RustCsgCat(profileRunArgs, ",")
    profileRunArgs = wire.RustCsgCat(profileRunArgs, wire.RustCsgJsonFieldStr("profileHz", "200"))
    profileRunArgs = wire.RustCsgCat(profileRunArgs, "}")
    let profileRun = native.ChengNativeHandleToolCall(10, "cheng_profile_run", profileRunArgs)
    if strings.StrContains(profileRun, "\"success\":true"):
        assertContains("profile-run records profile evidence", profileRun, "cheng.profile")
    else:
        assertContains("profile-run hard-fails without real command", profileRun, "\"success\":false")

    echo(" rust_csg_cheng_native_debugger_smoke ok")
    return 0
