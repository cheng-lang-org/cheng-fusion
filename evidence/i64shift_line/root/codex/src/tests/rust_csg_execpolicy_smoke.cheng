import std/strings
import std/strutils as strutil
import cheng/codex/crates/execpolicy/execpolicy as ep

# ═══════════════════════════════════════════════════════════════════════════════
# execpolicy: REAL production-level smoke tests
# Tests constants and prefix rule evaluation.
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkBool(got: bool, expected: bool, label: str): bool =
    var gotStr: str
    var expStr: str
    if got:
        gotStr = "true"
    else:
        gotStr = "false"
    if expected:
        expStr = "true"
    else:
        expStr = "false"
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expStr, " got=", gotStr], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── Decision constant tests ─────────────────────────────────────────────────

fn testDecisionConstants(): bool =
    var ok: bool = true
    if !checkEqI32(ep.RustCsgExecpolicyDecisionAllow, 0, "DecisionAllow"): ok = false
    if !checkEqI32(ep.RustCsgExecpolicyDecisionPrompt, 1, "DecisionPrompt"): ok = false
    if !checkEqI32(ep.RustCsgExecpolicyDecisionForbidden, 2, "DecisionForbidden"): ok = false
    return ok

# ── Decision predicate tests ────────────────────────────────────────────────

fn testDecisionPredicates(): bool =
    var ok: bool = true
    if !checkBool(ep.RustCsgExecpolicyDecisionIsAllowed(ep.RustCsgExecpolicyDecisionAllow), true, "IsAllowed(Allow)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionIsAllowed(ep.RustCsgExecpolicyDecisionPrompt), false, "IsAllowed(Prompt)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionIsAllowed(ep.RustCsgExecpolicyDecisionForbidden), false, "IsAllowed(Forbidden)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionRequiresPrompt(ep.RustCsgExecpolicyDecisionAllow), false, "RequiresPrompt(Allow)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionRequiresPrompt(ep.RustCsgExecpolicyDecisionPrompt), true, "RequiresPrompt(Prompt)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionRequiresPrompt(ep.RustCsgExecpolicyDecisionForbidden), false, "RequiresPrompt(Forbidden)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionIsForbidden(ep.RustCsgExecpolicyDecisionAllow), false, "IsForbidden(Allow)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionIsForbidden(ep.RustCsgExecpolicyDecisionPrompt), false, "IsForbidden(Prompt)"): ok = false
    if !checkBool(ep.RustCsgExecpolicyDecisionIsForbidden(ep.RustCsgExecpolicyDecisionForbidden), true, "IsForbidden(Forbidden)"): ok = false
    return ok

# ── Prefix rule evaluation tests ────────────────────────────────────────────

fn testEvaluatePrefixRuleExactMatch(): bool =
    var ok: bool = true
    # Exact path match
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user", "/home/user", ep.RustCsgExecpolicyDecisionAllow), true, "ExactMatch"): ok = false
    # Non-matching
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/other", "/home/user", ep.RustCsgExecpolicyDecisionAllow), false, "NoMatch"): ok = false
    return ok

fn testEvaluatePrefixRulePathBoundary(): bool =
    var ok: bool = true
    # Prefix at path boundary (ends with /)
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs", "/home/user/", ep.RustCsgExecpolicyDecisionAllow), true, "PrefixBoundarySlash"): ok = false
    # Prefix at path boundary (next char is /)
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs", "/home/user", ep.RustCsgExecpolicyDecisionAllow), true, "PrefixBoundaryNextSlash"): ok = false
    # Prefix should not match across path boundary when it's not a directory prefix
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/userX", "/home/user", ep.RustCsgExecpolicyDecisionAllow), false, "PrefixNoPartialSegment"): ok = false
    return ok

fn testEvaluatePrefixRuleWildcard(): bool =
    var ok: bool = true
    # Wildcard at end
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs/file.txt", "/home/user/*", ep.RustCsgExecpolicyDecisionAllow), true, "WildcardEnd"): ok = false
    # Wildcard at start
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs", "*/user/docs", ep.RustCsgExecpolicyDecisionAllow), true, "WildcardStart"): ok = false
    # Wildcard in middle
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs/readme.md", "/home/*/docs/readme.md", ep.RustCsgExecpolicyDecisionAllow), true, "WildcardMiddle"): ok = false
    # Wildcard matches everything including /
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/a/b/c/d/e", "/a/*/e", ep.RustCsgExecpolicyDecisionAllow), true, "WildcardMultiSegment"): ok = false
    # Wildcard with no match
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user/docs", "/other/*", ep.RustCsgExecpolicyDecisionAllow), false, "WildcardNoMatch"): ok = false
    return ok

fn testEvaluatePrefixRuleEdgeCases(): bool =
    var ok: bool = true
    # Empty prefix (treats as match since everything starts with "")
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/home/user", "", ep.RustCsgExecpolicyDecisionAllow), true, "EmptyPrefix"): ok = false
    # Wildcard only
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("anything", "*", ep.RustCsgExecpolicyDecisionAllow), true, "WildcardOnly"): ok = false
    # Root path
    if !checkBool(ep.RustCsgExecpolicyEvaluatePrefixRule("/", "/", ep.RustCsgExecpolicyDecisionAllow), true, "RootPath"): ok = false
    return ok

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testDecisionConstants(): allOk = false
    if !testDecisionPredicates(): allOk = false
    if !testEvaluatePrefixRuleExactMatch(): allOk = false
    if !testEvaluatePrefixRulePathBoundary(): allOk = false
    if !testEvaluatePrefixRuleWildcard(): allOk = false
    if !testEvaluatePrefixRuleEdgeCases(): allOk = false
    if allOk:
        echo("rust_csg_execpolicy_smoke ok")
        return 0
    echo("rust_csg_execpolicy_smoke FAILED")
    return 1
