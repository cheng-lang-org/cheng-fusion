import cheng/codex/crates/app_server_test_client/app_server_test_client
import cheng/codex/crates/app_server_client/app_server_client
import cheng/codex/crates/app_server_transport/app_server_transport
import cheng/codex/crates/core/core
import cheng/codex/crates/tui/tui

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn main(): int32 =
    let testConfig = app_server_test_client.RustCsgAppServerTestClientBuildTestClientConfig()
    assert(testConfig != "", "test config not empty")
    checkEq("test_config_apikey", app_server_test_client.RustCsgAppServerTestClientBuildTestClientConfig(), "{\"apiKey\":\"test-api-key\",\"baseUrl\":\"http://localhost:8080\",\"timeoutMs\":\"30000\"}")

    let inProcConfig = app_server_client.RustCsgAppServerClientBuildInProcessClientConfig()
    assert(inProcConfig != "", "inproc config not empty")
    checkEq("inproc_mode", app_server_client.RustCsgAppServerClientBuildInProcessClientConfig(), "{\"mode\":\"in-process\",\"maxRetries\":\"3\",\"enableKeepAlive\":true}")

    let timeoutErr = app_server_transport.RustCsgAppServerTransportClassifyTransportError("request timeout after 30s")
    checkEq("timeout_err", timeoutErr, "{\"category\":\"timeout\"}")
    let refusedErr = app_server_transport.RustCsgAppServerTransportClassifyTransportError("connection refused")
    checkEq("refused_err", refusedErr, "{\"category\":\"connection_refused\"}")
    let resetErr = app_server_transport.RustCsgAppServerTransportClassifyTransportError("connection reset by peer")
    checkEq("reset_err", resetErr, "{\"category\":\"connection_reset\"}")
    let unknownErr = app_server_transport.RustCsgAppServerTransportClassifyTransportError("something else")
    checkEq("unknown_err", unknownErr, "{\"category\":\"unknown\"}")

    assert(core.RustCsgCoreValidateThreadId("thread-1"), "thread-1 valid")
    assert(core.RustCsgCoreValidateThreadId("abc_123"), "abc_123 valid")
    assert(core.RustCsgCoreValidateThreadId("123e4567-e89b-12d3-a456-426614174000"), "uuid valid")
    assert(!core.RustCsgCoreValidateThreadId(""), "empty invalid")
    assert(!core.RustCsgCoreValidateThreadId("a\nb"), "newline invalid")
    assert(!core.RustCsgCoreValidateThreadId("a b"), "space invalid")

    let tuiQ = tui.RustCsgTuiParseTuiCommand("q")
    checkEq("tui_quit", tuiQ, "{\"command\":\"quit\",\"valid\":true}")
    let tuiSearch = tui.RustCsgTuiParseTuiCommand("/")
    checkEq("tui_search", tuiSearch, "{\"command\":\"search\",\"valid\":true}")
    let tuiNone = tui.RustCsgTuiParseTuiCommand("")
    checkEq("tui_none", tuiNone, "{\"command\":\"none\",\"valid\":false}")
    let tuiText = tui.RustCsgTuiParseTuiCommand("hello")
    checkEq("tui_text", tuiText, "{\"command\":\"text_input\",\"valid\":true}")

    echo("rust_csg_crate_upgrades_smoke ok")
    return 0
