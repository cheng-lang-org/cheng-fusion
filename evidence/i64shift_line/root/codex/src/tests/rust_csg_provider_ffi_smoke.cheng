# Provider FFI smoke test: process execution, env set, temp file
#
# Tests the FFI functions provided by the pure Cheng Darwin provider:
#   RustCsgExecCommand   — popen-based command capture
#   RustCsgSetEnv        — setenv wrapper
#   RustCsgCreateTempFile — mkstemp wrapper
#
# NOTE: All logic must be in main() — the cold backend does not compile
# user-defined helper functions, and string + concatenation is broken.
# Use RustCsgFileExists (from provider) and RustCsgSliceBytes for checks.

import std/os

@abi_internal
@importc("RustCsgExecCommand")
fn RustCsgExecCommand(cmd: str): str

@abi_internal
@importc("RustCsgSetEnv")
fn RustCsgSetEnv(name: str, value: str): int32

@abi_internal
@importc("RustCsgCreateTempFile")
fn RustCsgCreateTempFile(prefix: str): str

@abi_internal
@importc("RustCsgFileExists")
fn RustCsgFileExists(path: str): int32

# ═══════════════════════════════════════════════════════════════════════════
# Main (all test logic inlined — cold backend limitation)
# ═══════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # ── Test 1: SetEnv ─────────────────────────────────────────────────
    echo("testSetEnv")
    let r1 = RustCsgSetEnv("RUST_CSG_FFI_TEST_VAR", "ffi_test_value_42")
    if r1 != 1:
        echo("FAIL testSetEnv set returned 0")
        allOk = false
    else:
        let v1 = RustCsgExecCommand("echo $RUST_CSG_FFI_TEST_VAR")
        if v1 == "ffi_test_value_42\n" || v1 == "ffi_test_value_42":
            echo("testSetEnv ok")
        else:
            echo("FAIL testSetEnv got different value")
            allOk = false

    # ── Test 2: SetEnv overwrite ───────────────────────────────────────
    echo("testSetEnvOverwrite")
    let r2a = RustCsgSetEnv("RUST_CSG_FFI_TEST_VAR2", "first")
    if r2a != 1:
        echo("FAIL testSetEnvOverwrite first set")
        allOk = false
    else:
        let r2b = RustCsgSetEnv("RUST_CSG_FFI_TEST_VAR2", "second")
        if r2b != 1:
            echo("FAIL testSetEnvOverwrite second set")
            allOk = false
        else:
            let v2 = RustCsgExecCommand("echo $RUST_CSG_FFI_TEST_VAR2")
            if v2 == "second\n" || v2 == "second":
                echo("testSetEnvOverwrite ok")
            else:
                echo("FAIL testSetEnvOverwrite got different value")
                allOk = false

    # ── Test 3: ExecCommand echo ───────────────────────────────────────
    echo("testExecCommandEcho")
    let o3 = RustCsgExecCommand("echo hello_from_ffi")
    if o3 == "hello_from_ffi\n" || o3 == "hello_from_ffi":
        echo("testExecCommandEcho ok")
    else:
        echo("FAIL testExecCommandEcho")
        allOk = false

    # ── Test 4: ExecCommand with args ──────────────────────────────────
    echo("testExecCommandWithArgs")
    let o4 = RustCsgExecCommand("echo arg1 arg2 arg3")
    if o4 != "":
        echo("testExecCommandWithArgs ok")
    else:
        echo("FAIL testExecCommandWithArgs empty")
        allOk = false

    # ── Test 5: ExecCommand no output ──────────────────────────────────
    echo("testExecCommandEmpty")
    let o5 = RustCsgExecCommand("true")
    if o5 == "" || o5 == "\n":
        echo("testExecCommandEmpty ok")
    else:
        echo("FAIL testExecCommandEmpty")
        allOk = false

    # ── Test 6: CreateTempFile ─────────────────────────────────────────
    echo("testCreateTempFile")
    let t6 = RustCsgCreateTempFile("rust_csg_ffi_test_")
    if t6 == "":
        echo("FAIL testCreateTempFile returned empty")
        allOk = false
    else:
        let e6 = RustCsgFileExists(t6)
        if e6 == 1:
            echo("testCreateTempFile ok")
        else:
            echo("FAIL testCreateTempFile not found")
            allOk = false

    # ── Test 7: CreateTempFile long prefix ─────────────────────────────
    echo("testCreateTempFileLongPrefix")
    let t7 = RustCsgCreateTempFile("integration_test_rust_csg_")
    if t7 == "":
        echo("FAIL testCreateTempFileLongPrefix returned empty")
        allOk = false
    else:
        let e7 = RustCsgFileExists(t7)
        if e7 == 1:
            echo("testCreateTempFileLongPrefix ok")
        else:
            echo("FAIL testCreateTempFileLongPrefix not found")
            allOk = false

    # ── Summary ────────────────────────────────────────────────────────
    if allOk:
        echo("rust_csg_provider_ffi_smoke ok")
        return 0
    else:
        echo("rust_csg_provider_ffi_smoke FAILED")
        return 1
