import cheng/codex/crates/utils_http/utils_http as m

fn main(): int32 =
    var pass: int32

    # LowerAscii
    if m.RustCsgUtilsHttpLowerAscii("Hello") == "hello": pass = pass + 1
    if m.RustCsgUtilsHttpLowerAscii("ABC") == "abc": pass = pass + 1
    if m.RustCsgUtilsHttpLowerAscii("") == "": pass = pass + 1
    if m.RustCsgUtilsHttpLowerAscii("a1B2") == "a1b2": pass = pass + 1

    # TrimQuote
    if m.RustCsgUtilsHttpTrimQuote("\"hello\"") == "hello": pass = pass + 1
    if m.RustCsgUtilsHttpTrimQuote("'world'") == "world": pass = pass + 1
    if m.RustCsgUtilsHttpTrimQuote("noquotes") == "noquotes": pass = pass + 1

    # FindChar
    if m.RustCsgUtilsHttpFindChar("hello", 'e') == 1: pass = pass + 1
    if m.RustCsgUtilsHttpFindChar("hello", 'z') == -1: pass = pass + 1

    # TrimTrailingCr
    if m.RustCsgUtilsHttpTrimTrailingCr("hello\r") == "hello": pass = pass + 1
    if m.RustCsgUtilsHttpTrimTrailingCr("hello") == "hello": pass = pass + 1

    # ParseHeaderCount
    if m.RustCsgUtilsHttpParseHeaderCount("Content-Type: text\r\nX-ID: 1\r\n") == 2: pass = pass + 1
    if m.RustCsgUtilsHttpParseHeaderCount("") == 0: pass = pass + 1

    # BuildHttpPostRequest (check contains key parts)
    var req = m.RustCsgUtilsHttpBuildHttpPostRequest("api.example.com", "/v1/chat", "{}", "application/json")
    if req.len > 0: pass = pass + 1
    if m.RustCsgUtilsHttpFindChar(req, 'P') >= 0: pass = pass + 1

    if pass == 15:
        echo("rust_csg_oracle_utils_http ok")
        return 0
    echo("oracle FAIL")
    return 1

main()