import std/strings as strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Library: skills (inlined due to compiler cross-module ABI issue)
# ═══════════════════════════════════════════════════════════════════════════════

# Returns JSON: {"namespace":"...","name":"...","fullName":"...","error":"..."}
fn parseSkillName(fullName: str): str =
    var result: str = "{"
    result = strutil.Join([result, "\"fullName\":\"", fullName, "\""], "")
    if fullName.len == 0:
        result = strutil.Join([result, ",\"namespace\":\"\",\"name\":\"\",\"error\":\"empty skill name\""], "")
        result = strutil.Join([result, "}"], "")
        return result
    var slashIdx: int32 = -1
    for i in 0..<fullName.len:
        if fullName[i] == '/':
            slashIdx = i
            break
    if slashIdx <= 0 || slashIdx >= fullName.len - 1:
        result = strutil.Join([result, ",\"namespace\":\"\""], "")
        result = strutil.Join([result, ",\"name\":\"", fullName, "\""], "")
        result = strutil.Join([result, ",\"error\":\"\""], "")
        result = strutil.Join([result, "}"], "")
        return result
    let namespace = strings.SliceBytes(fullName, 0, slashIdx)
    let name = strings.SliceBytes(fullName, slashIdx + 1, fullName.len - slashIdx - 1)
    result = strutil.Join([result, ",\"namespace\":\"", namespace, "\""], "")
    result = strutil.Join([result, ",\"name\":\"", name, "\""], "")
    result = strutil.Join([result, ",\"error\":\"\""], "")
    result = strutil.Join([result, "}"], "")
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn testSimpleName(): bool =
    var ok: bool = true
    let result = parseSkillName("my-skill")
    if !strutil.Contains(result, "\"name\":\"my-skill\""):
        echo(strutil.Join(["FAIL: expected name in result, got=", result], ""))
        ok = false
    if !strutil.Contains(result, "\"namespace\":\"\""):
        echo(strutil.Join(["FAIL: expected empty namespace, got=", result], ""))
        ok = false
    if ok:
        echo("testSimpleName ok")
    return ok

fn testNamespacedSkill(): bool =
    var ok: bool = true
    let result = parseSkillName("codex/edit-file")
    if !strutil.Contains(result, "\"namespace\":\"codex\""):
        echo(strutil.Join(["FAIL: expected codex namespace, got=", result], ""))
        ok = false
    if !strutil.Contains(result, "\"name\":\"edit-file\""):
        ok = false
    if ok:
        echo("testNamespacedSkill ok")
    return ok

fn testEmptyName(): bool =
    var ok: bool = true
    let result = parseSkillName("")
    if !strutil.Contains(result, "\"error\":\"empty skill name\""):
        ok = false
    if ok:
        echo("testEmptyName ok")
    return ok

fn testMultiLevelName(): bool =
    var ok: bool = true
    let result = parseSkillName("a/b/c")
    if !strutil.Contains(result, "\"namespace\":\"a\""):
        ok = false
    if !strutil.Contains(result, "\"name\":\"b/c\""):
        ok = false
    if ok:
        echo("testMultiLevelName ok")
    return ok

fn testNoSlashName(): bool =
    var ok: bool = true
    let result = parseSkillName("skill_with_underscore")
    if !strutil.Contains(result, "\"name\":\"skill_with_underscore\""):
        ok = false
    if ok:
        echo("testNoSlashName ok")
    return ok

fn testSlashOnly(): bool =
    var ok: bool = true
    let result = parseSkillName("/")
    if !strutil.Contains(result, "\"name\":\"/\""):
        ok = false
    if ok:
        echo("testSlashOnly ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testSimpleName(): allOk = false
    if !testNamespacedSkill(): allOk = false
    if !testEmptyName(): allOk = false
    if !testMultiLevelName(): allOk = false
    if !testNoSlashName(): allOk = false
    if !testSlashOnly(): allOk = false
    if allOk:
        echo("rust_csg_skills_smoke ok")
        return 0
    else:
        echo("rust_csg_skills_smoke FAILED")
        return 1
