import cheng/codex/crates/thread_store/thread_store as ts

fn main(): int32 =
    var pass: int32

    # Constants
    if ts.RustCsgThreadStoreErrorNotFound == "thread not found": pass = pass + 1
    if ts.RustCsgThreadStoreErrorAlreadyExists == "thread already exists": pass = pass + 1
    if ts.RustCsgThreadStoreErrorPersistence == "thread persistence error": pass = pass + 1
    if ts.RustCsgThreadStoreErrorNotFoundMsg() == "thread not found": pass = pass + 1
    if ts.RustCsgThreadStoreErrorAlreadyExistsMsg() == "thread already exists": pass = pass + 1

    # Merge: target overwrites source on conflict
    var srcIds: str[] = ["a", "b"]
    var srcData: str[] = ["data-a", "data-b"]
    var tgtIds: str[] = ["b", "c"]
    var tgtData: str[] = ["data-b-new", "data-c"]
    var outIds: str[]
    var outData: str[]
    ts.RustCsgThreadStoreMerge(srcIds, srcData, tgtIds, tgtData, outIds, outData)
    if outIds.len == 3: pass = pass + 1
    if outIds[0] == "a" && outData[0] == "data-a": pass = pass + 1
    if outIds[1] == "b" && outData[1] == "data-b-new": pass = pass + 1
    if outIds[2] == "c" && outData[2] == "data-c": pass = pass + 1

    # Diff: items in a but not in b
    var diffIds: str[]
    var diffData: str[]
    var bIds: str[] = ["b", "d"]
    ts.RustCsgThreadStoreDiff(srcIds, srcData, bIds, diffIds, diffData)
    if diffIds.len == 1: pass = pass + 1
    if diffIds[0] == "a" && diffData[0] == "data-a": pass = pass + 1

    # Diff: empty a
    var diffIds2: str[]
    var diffData2: str[]
    var emptyIds: str[]
    var emptyData: str[]
    ts.RustCsgThreadStoreDiff(emptyIds, emptyData, bIds, diffIds2, diffData2)
    if diffIds2.len == 0: pass = pass + 1

    if pass == 12:
        echo("rust_csg_oracle_thread_store ok")
        return 0
    echo("oracle FAIL")
    return 1

main()