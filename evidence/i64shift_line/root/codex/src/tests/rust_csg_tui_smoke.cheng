# TUI smoke test — tests TuiBuffer, layout, ANSI escapes, key parsing, and word wrapping.
#
# NOTE: This test does NOT use a real terminal — it tests buffer rendering,
# string output, layout calculations, and ANSI escape generation.
# Raw mode terminal tests require a C provider and are in separate smoke tests.

import std/strings
import std/strutils as strutil
import cheng/codex/tui/render as render
import cheng/codex/tui/layout as layout
import cheng/codex/tui/input as input

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(label: str, got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", label, "]: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    return true

fn checkEqI32(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", label, "]: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    return true

fn checkTrue(label: str, cond: bool): bool =
    if !cond:
        echo(strutil.Join(["FAIL [", label, "]: expected true, got false"], ""))
        return false
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Tests
# ═══════════════════════════════════════════════════════════════════════════════

# ── TuiBuffer tests ──────────────────────────────────────────────────────────

fn testBufferInit(): bool =
    var ok: bool = true
    var buf = render.RustCsgTuiBufferInit(80, 24)
    if !checkEqI32("buf.width", render.RustCsgTuiBufferWidth(buf), 80): ok = false
    if !checkEqI32("buf.height", render.RustCsgTuiBufferHeight(buf), 24): ok = false
    if ok:
        echo("testBufferInit ok")
    return ok

fn testBufferWrite(): bool =
    var ok: bool = true
    var buf = render.RustCsgTuiBufferInit(10, 5)
    render.RustCsgTuiBufferWrite(buf, 2, 1, "hello", 255, 0, 0, -1, -1, -1, render.RustCsgTuiAttrBold)
    # Verify at position (2,1) and (3,1) etc — index = y*width + x = 1*10+2 = 12
    if !checkI32("cell(2,1).fgR", buf.cells[12].fgR, 255): ok = false
    if !checkI32("cell(2,1).fgG", buf.cells[12].fgG, 0): ok = false
    if !checkI32("cell(2,1).attr", buf.cells[12].attr, render.RustCsgTuiAttrBold): ok = false
    if !checkEqStr("cell(3,1).ch", buf.cells[13].ch, "e"): ok = false
    if ok:
        echo("testBufferWrite ok")
    return ok

fn checkI32(label: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", label, "]: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    return true

fn testBufferClear(): bool =
    var ok: bool = true
    var buf = render.RustCsgTuiBufferInit(5, 3)
    render.RustCsgTuiBufferWrite(buf, 0, 0, "X", 255, 0, 0, -1, -1, -1, render.RustCsgTuiAttrBold)
    render.RustCsgTuiBufferClear(buf)
    # After clear, all cells should be space with default attrs
    let total: int32 = 5 * 3
    var i: int32 = 0
    while i < total:
        if buf.cells[i].ch != " ":
            echo(strutil.Join(["FAIL [testBufferClear]: cell ", strings.IntToStr(i), " ch='", buf.cells[i].ch, "'"], ""))
            ok = false
        if buf.cells[i].fgR != -1:
            echo(strutil.Join(["FAIL [testBufferClear]: cell ", strings.IntToStr(i), " fgR not reset"], ""))
            ok = false
        i = i + 1
    if ok:
        echo("testBufferClear ok")
    return ok

# ── ANSI escape generation tests ─────────────────────────────────────────────

fn testAnsiCursorMoveTo(): bool =
    var ok: bool = true
    let result: str = render.RustCsgTuiCursorMoveTo(5, 10)
    if !checkEqStr("CursorMoveTo", result, "[5;10H"): ok = false
    if ok:
        echo("testAnsiCursorMoveTo ok")
    return ok

fn testAnsiClearScreen(): bool =
    var ok: bool = true
    let result: str = render.RustCsgTuiClearScreen()
    if !checkEqStr("ClearScreen", result, "[2J"): ok = false
    if ok:
        echo("testAnsiClearScreen ok")
    return ok

fn testAnsiSetForeground(): bool =
    var ok: bool = true
    let result: str = render.RustCsgTuiSetForegroundColor(255, 128, 0)
    if !checkEqStr("SetForeground", result, "[38;2;255;128;0m"): ok = false
    if ok:
        echo("testAnsiSetForeground ok")
    return ok

fn testAnsiSetBackground(): bool =
    var ok: bool = true
    let result: str = render.RustCsgTuiSetBackgroundColor(10, 20, 30)
    if !checkEqStr("SetBackground", result, "[48;2;10;20;30m"): ok = false
    if ok:
        echo("testAnsiSetBackground ok")
    return ok

fn testAnsiBold(): bool =
    var ok: bool = true
    if !checkEqStr("BoldOn", render.RustCsgTuiSetBold(true), "[1m"): ok = false
    if !checkEqStr("BoldOff", render.RustCsgTuiSetBold(false), "[22m"): ok = false
    if ok:
        echo("testAnsiBold ok")
    return ok

fn testAnsiReverse(): bool =
    var ok: bool = true
    if !checkEqStr("ReverseOn", render.RustCsgTuiSetReverse(true), "[7m"): ok = false
    if !checkEqStr("ReverseOff", render.RustCsgTuiSetReverse(false), "[27m"): ok = false
    if ok:
        echo("testAnsiReverse ok")
    return ok

fn testAnsiReset(): bool =
    var ok: bool = true
    if !checkEqStr("Reset", render.RustCsgTuiResetAttrs(), "[0m"): ok = false
    if ok:
        echo("testAnsiReset ok")
    return ok

# ── Layout tests ──────────────────────────────────────────────────────────────

fn testRectNew(): bool =
    var ok: bool = true
    let r = layout.RustCsgTuiRectNew(1, 2, 80, 24)
    if !checkEqI32("rect.x", r.x, 1): ok = false
    if !checkEqI32("rect.y", r.y, 2): ok = false
    if !checkEqI32("rect.w", r.width, 80): ok = false
    if !checkEqI32("rect.h", r.height, 24): ok = false
    if ok:
        echo("testRectNew ok")
    return ok

fn testSplitLayoutHorizontal(): bool =
    var ok: bool = true
    let rect = layout.RustCsgTuiRectNew(0, 0, 100, 10)
    var constraints: layout.RustCsgTuiConstraint[]
    var ch1: layout.RustCsgTuiConstraint
    ch1 = layout.RustCsgTuiConstraintFixed(30)
    add(constraints, ch1)
    var ch2: layout.RustCsgTuiConstraint
    ch2 = layout.RustCsgTuiConstraintPercent(50)
    add(constraints, ch2)
    var ch3: layout.RustCsgTuiConstraint
    ch3 = layout.RustCsgTuiConstraintPercent(50)
    add(constraints, ch3)
    let lay = layout.RustCsgTuiLayoutNew(0, constraints)   # horizontal
    let results = layout.RustCsgTuiSplitLayout(rect, lay)
    if !checkEqI32("split.count", results.len, 3): ok = false
    if results.len >= 3:
        # First: fixed 30
        if !checkEqI32("split[0].x", results[0].x, 0): ok = false
        if !checkEqI32("split[0].w", results[0].width, 30): ok = false
        # Second: 50% of remaining 70 = 35
        if !checkEqI32("split[1].x", results[1].x, 30): ok = false
        if !checkEqI32("split[2].x", results[2].x, 65): ok = false
        let expectedThirdWidth: int32 = 100 - 30 - 35
        if !checkEqI32("split[2].w", results[2].width, expectedThirdWidth): ok = false
    if ok:
        echo("testSplitLayoutHorizontal ok")
    return ok

fn testSplitLayoutVertical(): bool =
    var ok: bool = true
    let rect = layout.RustCsgTuiRectNew(0, 0, 80, 24)
    var constraints: layout.RustCsgTuiConstraint[]
    var cv1: layout.RustCsgTuiConstraint
    cv1 = layout.RustCsgTuiConstraintFixed(1)
    add(constraints, cv1)
    var cv2: layout.RustCsgTuiConstraint
    cv2 = layout.RustCsgTuiConstraintPercent(80)
    add(constraints, cv2)
    var cv3: layout.RustCsgTuiConstraint
    cv3 = layout.RustCsgTuiConstraintFixed(3)
    add(constraints, cv3)
    let lay = layout.RustCsgTuiLayoutNew(1, constraints)   # vertical
    let results = layout.RustCsgTuiSplitLayout(rect, lay)
    if !checkEqI32("vsplit.count", results.len, 3): ok = false
    if results.len >= 3:
        # First: fixed 1
        if !checkEqI32("vsplit[0].y", results[0].y, 0): ok = false
        if !checkEqI32("vsplit[0].h", results[0].height, 1): ok = false
        # Second: 80% of remaining 23 ~= 18
        if !checkEqI32("vsplit[1].y", results[1].y, 1): ok = false
        # Third: fixed 3
        if !checkEqI32("vsplit[2].y", results[2].y, results[1].y + results[1].height): ok = false
        if !checkEqI32("vsplit[2].h", results[2].height, 3): ok = false
    if ok:
        echo("testSplitLayoutVertical ok")
    return ok

fn testConversationLayout(): bool =
    var ok: bool = true
    let results = layout.RustCsgTuiConversationLayout(80, 24)
    if !checkEqI32("convo.count", results.len, 3): ok = false
    if results.len >= 3:
        # Status bar: top 1 line
        if !checkEqI32("status.y", results[0].y, 0): ok = false
        if !checkEqI32("status.h", results[0].height, 1): ok = false
        if !checkEqI32("status.w", results[0].width, 80): ok = false
        # Input area: bottom 3 lines
        if !checkEqI32("input.y", results[2].y, 21): ok = false
        if !checkEqI32("input.h", results[2].height, 3): ok = false
        # Conversation: middle
        if !checkEqI32("conv.y", results[1].y, 1): ok = false
        if !checkEqI32("conv.h", results[1].height, 20): ok = false
    if ok:
        echo("testConversationLayout ok")
    return ok

# ── Key parsing tests ────────────────────────────────────────────────────────

fn testParsePrintable(): bool =
    var ok: bool = true
    let ev = input.RustCsgTuiParseKeyEvent(65)   # 'A'
    if !checkEqStr("printable.key", ev.key, "A"): ok = false
    if !checkTrue("printable.notCtrl", !ev.ctrl): ok = false
    if !checkTrue("printable.notAlt", !ev.alt): ok = false
    if ok:
        echo("testParsePrintable ok")
    return ok

fn testParseEscape(): bool =
    var ok: bool = true
    let ev = input.RustCsgTuiParseKeyEvent(27)
    if !checkEqStr("escape.key", ev.key, input.RustCsgTuiKeyEscape): ok = false
    if ok:
        echo("testParseEscape ok")
    return ok

fn testParseEnter(): bool =
    var ok: bool = true
    let ev = input.RustCsgTuiParseKeyEvent(10)
    if !checkEqStr("enter.key", ev.key, input.RustCsgTuiKeyEnter): ok = false
    if ok:
        echo("testParseEnter ok")
    return ok

fn testParseCtrlA(): bool =
    var ok: bool = true
    let ev = input.RustCsgTuiParseKeyEvent(1)   # Ctrl+A
    if !checkEqStr("ctrlA.key", ev.key, "A"): ok = false
    if !checkTrue("ctrlA.ctrl", ev.ctrl): ok = false
    if ok:
        echo("testParseCtrlA ok")
    return ok

fn testParseBackspace(): bool =
    var ok: bool = true
    let ev = input.RustCsgTuiParseKeyEvent(127)
    if !checkEqStr("bs.key", ev.key, input.RustCsgTuiKeyBackspace): ok = false
    if ok:
        echo("testParseBackspace ok")
    return ok

# ── Word wrapping tests ──────────────────────────────────────────────────────

fn testWordWrapSimple(): bool =
    var ok: bool = true
    let lines: str[] = render.RustCsgTuiWordWrap("hello world foo", 10)
    if !checkEqI32("wrap.count", lines.len, 2): ok = false
    if lines.len >= 2:
        if !checkEqStr("wrap[0]", lines[0], "hello"): ok = false
        if !checkEqStr("wrap[1]", lines[1], "world foo"): ok = false
    if ok:
        echo("testWordWrapSimple ok")
    return ok

fn testWordWrapLongWord(): bool =
    var ok: bool = true
    let lines: str[] = render.RustCsgTuiWordWrap("superlongword", 5)
    if lines.len >= 3:
        if !checkEqStr("long[0]", lines[0], "super"): ok = false
        if !checkEqStr("long[1]", lines[1], "longw"): ok = false
        if !checkEqStr("long[2]", lines[2], "ord"): ok = false
    if ok:
        echo("testWordWrapLongWord ok")
    return ok

fn testWordWrapExact(): bool =
    var ok: bool = true
    let lines: str[] = render.RustCsgTuiWordWrap("hello", 5)
    if !checkEqI32("exact.count", lines.len, 1): ok = false
    if lines.len >= 1:
        if !checkEqStr("exact[0]", lines[0], "hello"): ok = false
    if ok:
        echo("testWordWrapExact ok")
    return ok

fn testWordWrapEmpty(): bool =
    var ok: bool = true
    let lines: str[] = render.RustCsgTuiWordWrap("", 10)
    if !checkEqI32("empty.count", lines.len, 1): ok = false
    if lines.len >= 1:
        if !checkEqStr("empty[0]", lines[0], ""): ok = false
    if ok:
        echo("testWordWrapEmpty ok")
    return ok

# ── Buffer Render test ───────────────────────────────────────────────────────

fn testBufferRenderOutput(): bool =
    var ok: bool = true
    var buf = render.RustCsgTuiBufferInit(4, 2)
    render.RustCsgTuiBufferWrite(buf, 0, 0, "ab", 255, 0, 0, -1, -1, -1, render.RustCsgTuiAttrNone)
    render.RustCsgTuiBufferWrite(buf, 0, 1, "cd", -1, -1, -1, 0, 0, 255, render.RustCsgTuiAttrNone)
    let out: str = render.RustCsgTuiBufferRender(buf)
    # Output should contain ANSI sequences for color changes and cursor positioning
    if !checkTrue("render.contains_fg", strutil.Contains(out, "[38;2;255;0;0m")): ok = false
    if !checkTrue("render.contains_bg", strutil.Contains(out, "[48;2;0;0;255m")): ok = false
    if !checkTrue("render.contains_CursorHide", strutil.Contains(out, "[?25l")): ok = false
    if !checkTrue("render.contains_CursorShow", strutil.Contains(out, "[?25h")): ok = false
    # Should contain characters
    if !checkTrue("render.contains_ab", strutil.Contains(out, "ab")): ok = false
    if !checkTrue("render.contains_cd", strutil.Contains(out, "cd")): ok = false
    if ok:
        echo("testBufferRenderOutput ok")
    return ok

# ── StrRepeat test ───────────────────────────────────────────────────────────

fn testStrRepeat(): bool =
    var ok: bool = true
    if !checkEqStr("repeat3", render.RustCsgTuiStrRepeat("x", 3), "xxx"): ok = false
    if !checkEqStr("repeat0", render.RustCsgTuiStrRepeat("x", 0), ""): ok = false
    if ok:
        echo("testStrRepeat ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # Buffer tests
    if !testBufferInit(): allOk = false
    if !testBufferWrite(): allOk = false
    if !testBufferClear(): allOk = false
    if !testBufferRenderOutput(): allOk = false

    # ANSI escape tests
    if !testAnsiCursorMoveTo(): allOk = false
    if !testAnsiClearScreen(): allOk = false
    if !testAnsiSetForeground(): allOk = false
    if !testAnsiSetBackground(): allOk = false
    if !testAnsiBold(): allOk = false
    if !testAnsiReverse(): allOk = false
    if !testAnsiReset(): allOk = false

    # Layout tests
    if !testRectNew(): allOk = false
    if !testSplitLayoutHorizontal(): allOk = false
    if !testSplitLayoutVertical(): allOk = false
    if !testConversationLayout(): allOk = false

    # Key parsing tests
    if !testParsePrintable(): allOk = false
    if !testParseEscape(): allOk = false
    if !testParseEnter(): allOk = false
    if !testParseCtrlA(): allOk = false
    if !testParseBackspace(): allOk = false

    # Word wrap tests
    if !testWordWrapSimple(): allOk = false
    if !testWordWrapLongWord(): allOk = false
    if !testWordWrapExact(): allOk = false
    if !testWordWrapEmpty(): allOk = false

    # Utility tests
    if !testStrRepeat(): allOk = false

    if allOk:
        echo("rust_csg_tui_smoke ok")
        return 0
    else:
        echo("rust_csg_tui_smoke FAILED")
        return 1
