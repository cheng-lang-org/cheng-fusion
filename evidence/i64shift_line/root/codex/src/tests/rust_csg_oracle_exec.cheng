import cheng/codex/crates/exec/exec as e

fn main(): int32 =
    var pass: int32

    # execValidatePlan: default plan has command="run", expects prompt
    var plan = e.RustCsgExecCratePlanDefault()
    if e.execValidatePlan(plan) == "prompt is required for run command": pass = pass + 1
    plan.prompt = "fix bug"
    if e.execValidatePlan(plan) == "": pass = pass + 1

    # execEstimateResourceUsage returns non-empty JSON
    if e.execEstimateResourceUsage(plan).len > 0: pass = pass + 1

    if pass == 3:
        echo("rust_csg_oracle_exec ok")
        return 0
    echo("oracle FAIL")
    return 1

main()