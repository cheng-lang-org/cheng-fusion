# Smoke test for Cheng OS provider functions (_cheng_os.cheng).
# Tests all 9 exported functions: GetPid, GetCurrentTimeMs, FileExists,
# Mkdir, FileDelete, SleepMs, FileRename, RemoveDir, cheng_auth_file_exists.
#
# Uses RustCsgWriteFile (from _cheng_alg.cheng via WriteTextFile built-in)
# to create test files, bypassing the cold backend fopen() ABI limitation
# with @abi_internal on multi-cstring @importc functions.
@abi_internal
@importc("RustCsgGetPid")
fn RustCsgGetPid(): int32
@abi_internal
@importc("RustCsgGetCurrentTimeMs")
fn RustCsgGetCurrentTimeMs(): int64
@abi_internal
@importc("RustCsgFileExists")
fn RustCsgFileExists(path: str): int32
@abi_internal
@importc("RustCsgMkdir")
fn RustCsgMkdir(path: str): int32
@abi_internal
@importc("RustCsgFileDelete")
fn RustCsgFileDelete(path: str): int32
@abi_internal
@importc("RustCsgSleepMs")
fn RustCsgSleepMs(ms: int32): int32
@abi_internal
@importc("RustCsgFileRename")
fn RustCsgFileRename(old: str, new: str): int32
@abi_internal
@importc("RustCsgRemoveDir")
fn RustCsgRemoveDir(path: str): int32
@abi_internal
@importc("cheng_auth_file_exists")
fn chengAuthFileExists(path: str): int32
@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgWriteFile(path: str, content: str): int32

fn main(): int32 =
    var ok: bool = true
    echo("--- cheng_os smoke test ---")

    # 1. GetPid — returns > 0
    let pid = RustCsgGetPid()
    if pid > 0:
        echo("PASS: GetPid")
    else:
        echo("FAIL: GetPid")
        ok = false

    # 2. GetCurrentTimeMs — returns > 0
    let now = RustCsgGetCurrentTimeMs()
    if now > int64(0):
        echo("PASS: GetCurrentTimeMs")
    else:
        echo("FAIL: GetCurrentTimeMs")
        ok = false

    # 3. FileExists on /tmp (should exist as a directory)
    let fe1 = RustCsgFileExists("/tmp")
    if fe1 == 1:
        echo("PASS: FileExists /tmp")
    else:
        echo("FAIL: FileExists /tmp")
        ok = false

    # 4. FileExists on nonexistent path
    let fe2 = RustCsgFileExists("/nonexistent_path_cheng_os_smoke_abcdef")
    if fe2 == 0:
        echo("PASS: FileExists nonexistent")
    else:
        echo("FAIL: FileExists nonexistent")
        ok = false

    # 5. Mkdir — create temp directory
    let testDir = "/tmp/_cheng_os_smoke"
    let mk = RustCsgMkdir(testDir)
    if mk == 1:
        echo("PASS: Mkdir")
    else:
        echo("FAIL: Mkdir")
        ok = false

    # 6. Verify dir exists after Mkdir
    let fe3 = RustCsgFileExists(testDir)
    if fe3 == 1:
        echo("PASS: FileExists after Mkdir")
    else:
        echo("FAIL: FileExists after Mkdir")
        ok = false

    # 7. FileDelete — create file with RustCsgWriteFile, delete, verify gone
    let testFile = "/tmp/_cheng_os_smoke/delete_test.txt"
    let wr = RustCsgWriteFile(testFile, "hello")
    if wr == 1:
        # verify file exists
        let fe4 = RustCsgFileExists(testFile)
        if fe4 == 1:
            echo("PASS: FileExists after create")
        else:
            echo("FAIL: FileExists after create")
            ok = false
        # delete the file
        let fd = RustCsgFileDelete(testFile)
        if fd == 1:
            echo("PASS: FileDelete")
        else:
            echo("FAIL: FileDelete")
            ok = false
        # verify deleted
        let fe5 = RustCsgFileExists(testFile)
        if fe5 == 0:
            echo("PASS: FileExists after delete")
        else:
            echo("FAIL: FileExists after delete")
            ok = false
    else:
        echo("FAIL: RustCsgWriteFile for delete test")
        ok = false

    # 8. SleepMs — 1ms sleep
    let sl = RustCsgSleepMs(1)
    if sl == 1:
        echo("PASS: SleepMs")
    else:
        echo("FAIL: SleepMs")
        ok = false

    # 9. FileRename — create file with RustCsgWriteFile, rename, verify
    let oldFile = "/tmp/_cheng_os_smoke/rename_old.txt"
    let newFile = "/tmp/_cheng_os_smoke/rename_new.txt"
    let wr2 = RustCsgWriteFile(oldFile, "rename test")
    if wr2 == 1:
        let fr = RustCsgFileRename(oldFile, newFile)
        if fr == 1:
            echo("PASS: FileRename")
        else:
            echo("FAIL: FileRename")
            ok = false
        # verify new exists, old doesn't
        let fe6 = RustCsgFileExists(newFile)
        if fe6 == 1:
            echo("PASS: FileExists new after rename")
        else:
            echo("FAIL: FileExists new after rename")
            ok = false
        let fe7 = RustCsgFileExists(oldFile)
        if fe7 == 0:
            echo("PASS: FileExists old gone after rename")
        else:
            echo("FAIL: FileExists old gone after rename")
            ok = false
        # clean up files (rename may have failed, leaving oldFile)
        RustCsgFileDelete(oldFile)
        RustCsgFileDelete(newFile)
    else:
        echo("FAIL: RustCsgWriteFile for rename test")
        ok = false

    # Clean up any leftover files so RemoveDir can succeed
    RustCsgFileDelete("/tmp/_cheng_os_smoke/rename_old.txt")
    RustCsgFileDelete("/tmp/_cheng_os_smoke/rename_new.txt")

    # 10. RemoveDir — remove the temp directory
    let rd = RustCsgRemoveDir(testDir)
    if rd == 1:
        echo("PASS: RemoveDir")
    else:
        echo("FAIL: RemoveDir")
        ok = false

    # 11. cheng_auth_file_exists on a known file
    # Uses fopen("rb") internally via chengAuthFileExistsExport in cheng_os.o.
    let af1 = chengAuthFileExists("/etc/hosts")
    if af1 == 1:
        echo("PASS: cheng_auth_file_exists /etc/hosts")
    else:
        echo("FAIL: cheng_auth_file_exists /etc/hosts")
        ok = false

    # 12. cheng_auth_file_exists on nonexistent file
    let af2 = chengAuthFileExists("/nonexistent_path_cheng_os_smoke_abcdef")
    if af2 == 0:
        echo("PASS: cheng_auth_file_exists nonexistent")
    else:
        echo("FAIL: cheng_auth_file_exists nonexistent")
        ok = false

    # Result
    if ok:
        echo("--- ALL PASS ---")
        return 0
    else:
        echo("--- SOME TESTS FAILED ---")
        return 1
