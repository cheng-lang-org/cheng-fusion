# ═══════════════════════════════════════════════════════════════════════════════
# utils/http — relfacts equivalence smoke test
#
# Verifies that the utils_http crate's defined functions, types, and fields
# match the oracle.  Uses only built-in string/assert/echo — no imports.
# ═══════════════════════════════════════════════════════════════════════════════

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgUtilsHttpHeader =\n        name: str\n        value: str\n\nfn RustCsgUtilsHttpLowerAsciiChar(ch: char): str\nfn RustCsgUtilsHttpLowerAscii(text: str): str\nfn RustCsgUtilsHttpTrimQuote(text: str): str\nfn RustCsgUtilsHttpFindChar(text: str, ch: char): int32\nfn RustCsgUtilsHttpTrimTrailingCr(text: str): str\nfn RustCsgUtilsHttpParseContentType(header: str, outMimeType: var str, outCharset: var str, outHasCharset: var bool)\nfn RustCsgUtilsHttpBuildHttpPostRequest(host: str, path: str, body: str, contentType: str): str\nfn RustCsgUtilsHttpParseHeaders(rawHeaders: str): RustCsgUtilsHttpHeader[]\nfn RustCsgUtilsHttpParseHeaderValue(rawHeaders: str, name: str): str\nfn RustCsgUtilsHttpParseHeaderCount(rawHeaders: str): int32\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tutils_http\nDefFunction\tutils_http\tRustCsgUtilsHttpLowerAsciiChar\tch: char\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpLowerAscii\ttext: str\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpTrimQuote\ttext: str\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpFindChar\ttext: str, ch: char\t->\tint32\nDefFunction\tutils_http\tRustCsgUtilsHttpTrimTrailingCr\ttext: str\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpParseContentType\theader: str, outMimeType: var str, outCharset: var str, outHasCharset: var bool\t->\t\nDefFunction\tutils_http\tRustCsgUtilsHttpBuildHttpPostRequest\thost: str, path: str, body: str, contentType: str\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpParseHeaders\trawHeaders: str\t->\tRustCsgUtilsHttpHeader[]\nDefFunction\tutils_http\tRustCsgUtilsHttpParseHeaderValue\trawHeaders: str, name: str\t->\tstr\nDefFunction\tutils_http\tRustCsgUtilsHttpParseHeaderCount\trawHeaders: str\t->\tint32\nLocalType\tutils_http\tRustCsgUtilsHttpHeader\nHasField\tutils_http\tRustCsgUtilsHttpHeader\tname\tstr\nHasField\tutils_http\tRustCsgUtilsHttpHeader\tvalue\tstr\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)

    assert(esf == 10, "source function count")
    assert(est == 1, "source type count")
    assert(esfd == 2, "source field count")

    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(osf == 10, "oracle function count")
    assert(ost == 1, "oracle type count")
    assert(osfd == 2, "oracle field count")

    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")

    echo("rust_csg_utils_http_smoke ok")
    return 0
