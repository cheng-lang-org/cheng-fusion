import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_approval_requests_oracle as approval
import cheng/codex/tui/chatwidget_remaining_small_oracle as oracle

fn RustCsgTuiChatwidgetRemainingSmallFirstDiff(expected: str, got: str): int32 =
    let expectedLen: int32 = strings.Len(expected)
    let gotLen: int32 = strings.Len(got)
    var limit: int32 = expectedLen
    if gotLen < limit:
        limit = gotLen

    var i: int32 = 0
    while i < limit:
        if expected[i] != got[i]:
            return i
        i = i + 1

    if expectedLen != gotLen:
        return limit
    return -1

fn RustCsgTuiChatwidgetRemainingSmallCheck(path: str,
                                            expectedSource: str,
                                            expectedExpression: str,
                                            expectedBody: str,
                                            name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source expected=", expectedSource, " got=", s.source], ""))
        return 1
    if s.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression expected=", expectedExpression, " got=", s.expression], ""))
        return 1
    if expectedBody != s.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(s.bodyByteLen),
            " first_diff=", strings.IntToStr(RustCsgTuiChatwidgetRemainingSmallFirstDiff(expectedBody, s.body)),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 10:
        echo("FAIL usage: rust_csg_tui_chatwidget_remaining_small_oracle_smoke <9 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests/exec_flow.rs", "lines_to_single_string(&decision)", oracle.RustCsgTuiChatwidgetExecApprovalHistoryApprovedShort(), "exec_approval_history_decision_approved_short")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests/exec_flow.rs", "lines_to_single_string(&aborted_long)", oracle.RustCsgTuiChatwidgetExecApprovalHistoryAbortedLong(), "exec_approval_history_decision_aborted_long")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests/exec_flow.rs", "lines_to_single_string(&aborted_multi)", oracle.RustCsgTuiChatwidgetExecApprovalHistoryAbortedMultiline(), "exec_approval_history_decision_aborted_multiline")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetStatusWidgetActive(), "status_widget_active")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "terminal.backend()", oracle.RustCsgTuiChatwidgetStatusWidgetAndApprovalModal(), "status_widget_and_approval_modal")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "term.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetTall(), "chatwidget_tall")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests/exec_flow.rs", "\"format!(\\\"{buf:?}\\\")\"", approval.RustCsgTuiChatwidgetApprovalModalExec(), "exec_approval_modal_exec")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "term.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetExecAndStatusLayoutVt100(), "chatwidget_exec_and_status_layout_vt100_snapshot")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetRemainingSmallCheck(cmdline.argStr(i), "tui/src/chatwidget/tests.rs", "term.backend().vt100().screen().contents()", oracle.RustCsgTuiChatwidgetMarkdownCodeBlocksVt100(), "chatwidget_markdown_code_blocks_vt100_snapshot")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_remaining_small_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_remaining_small_oracle_smoke FAILED")
    return exitCode
