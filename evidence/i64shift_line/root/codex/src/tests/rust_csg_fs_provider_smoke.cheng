import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# Filesystem Provider — tests for FileDelete, FileRename, CreateDir/Mkdir,
# FileCopy, FileAppend, FileTruncate
# ═══════════════════════════════════════════════════════════════════════════════

@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgWriteFile(path: str, content: str): int32

@abi_internal
@importc("RustCsgFileDelete")
fn RustCsgFileDelete(path: str): int32

@abi_internal
@importc("RustCsgFileRename")
fn RustCsgFileRename(oldPath: str, newPath: str): int32

@abi_internal
@importc("RustCsgMkdir")
fn RustCsgCreateDir(path: str): int32

@abi_internal
@importc("RustCsgRemoveDir")
fn RustCsgRemoveDir(path: str): int32

@abi_internal
@importc("RustCsgFileCopy")
fn RustCsgFileCopy(srcPath: str, dstPath: str): int32

@abi_internal
@importc("RustCsgFileAppend")
fn RustCsgFileAppend(path: str, content: str): int32

@abi_internal
@importc("RustCsgFileTruncate")
fn RustCsgFileTruncate(path: str, size: int64): int32

# ── Test Helpers ────────────────────────────────────────────────────────

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected i32=", strings.Int64ToStr(int64(expected)),
                          " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    return true

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected str=\"", expected, "\" got=\"", got, "\""], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected bool=", es, " got=", gs], ""))
        return false
    return true

# ── Tests ───────────────────────────────────────────────────────────────

fn testFileWriteDelete(): bool =
    var ok: bool = true
    let testPath = "/tmp/rust_csg_fs_test_delete.txt"
    # Clean up before test
    RustCsgFileDelete(testPath)
    # Write file
    let wrote = RustCsgWriteFile(testPath, "hello delete")
    if !checkEqI32(wrote, 1):
        ok = false
    # Delete file
    let deleted = RustCsgFileDelete(testPath)
    if !checkEqI32(deleted, 1):
        ok = false
    # Delete again (should fail — file doesn't exist)
    let deleted2 = RustCsgFileDelete(testPath)
    if !checkEqI32(deleted2, 0):
        ok = false
    if ok:
        echo("testFileWriteDelete ok")
    return ok

fn testFileRename(): bool =
    var ok: bool = true
    let oldPath = "/tmp/rust_csg_fs_test_rename_old.txt"
    let newPath = "/tmp/rust_csg_fs_test_rename_new.txt"
    # Clean up
    RustCsgFileDelete(oldPath)
    RustCsgFileDelete(newPath)
    # Write source file
    let wrote = RustCsgWriteFile(oldPath, "rename me")
    if !checkEqI32(wrote, 1):
        ok = false
    # Rename
    let renamed = RustCsgFileRename(oldPath, newPath)
    if !checkEqI32(renamed, 1):
        ok = false
    # Old should be gone
    let oldDeleted = RustCsgFileDelete(oldPath)
    if !checkEqI32(oldDeleted, 0):
        ok = false
    # New should be deletable
    let newDeleted = RustCsgFileDelete(newPath)
    if !checkEqI32(newDeleted, 1):
        ok = false
    if ok:
        echo("testFileRename ok")
    return ok

fn testMkdir(): bool =
    var ok: bool = true
    let testDir = "/tmp/rust_csg_fs_test_mkdir"
    # Clean up
    RustCsgRemoveDir(testDir)
    # Create directory
    let created = RustCsgCreateDir(testDir)
    if !checkEqI32(created, 1):
        ok = false
    # Create again (should fail — already exists)
    let created2 = RustCsgCreateDir(testDir)
    if !checkEqI32(created2, 0):
        ok = false
    # Clean up
    RustCsgRemoveDir(testDir)
    if ok:
        echo("testMkdir ok")
    return ok

fn testFileDeleteNonExistent(): bool =
    var ok: bool = true
    let noFile = "/tmp/rust_csg_fs_test_no_such_file_xyz123"
    let deleted = RustCsgFileDelete(noFile)
    if !checkEqI32(deleted, 0):
        ok = false
    if ok:
        echo("testFileDeleteNonExistent ok")
    return ok

fn testFileRenameNonExistent(): bool =
    var ok: bool = true
    let renamed = RustCsgFileRename("/tmp/rust_csg_fs_test_noexist_old",
                                    "/tmp/rust_csg_fs_test_noexist_new")
    if !checkEqI32(renamed, 0):
        ok = false
    if ok:
        echo("testFileRenameNonExistent ok")
    return ok

fn testFileCopy(): bool =
    var ok: bool = true
    let srcPath = "/tmp/rust_csg_fs_test_copy_src.txt"
    let dstPath = "/tmp/rust_csg_fs_test_copy_dst.txt"
    # Clean up
    RustCsgFileDelete(srcPath)
    RustCsgFileDelete(dstPath)
    # Write source
    let wrote = RustCsgWriteFile(srcPath, "copy me over")
    if !checkEqI32(wrote, 1):
        ok = false
    let copied = RustCsgFileCopy(srcPath, dstPath)
    if !checkEqI32(copied, 1):
        ok = false
    # Copy again (dest exists, should overwrite)
    let copied2 = RustCsgFileCopy(srcPath, dstPath)
    if !checkEqI32(copied2, 1):
        ok = false
    # Copy from nonexistent source
    let copied3 = RustCsgFileCopy("/tmp/rust_csg_fs_test_noexist_src", dstPath)
    if !checkEqI32(copied3, 0):
        ok = false
    # Clean up
    RustCsgFileDelete(srcPath)
    RustCsgFileDelete(dstPath)
    if ok:
        echo("testFileCopy ok")
    return ok

fn testFileAppend(): bool =
    var ok: bool = true
    let testPath = "/tmp/rust_csg_fs_test_append.txt"
    RustCsgFileDelete(testPath)
    # Write initial content
    let wrote = RustCsgWriteFile(testPath, "hello")
    if !checkEqI32(wrote, 1):
        ok = false
    # Append
    let appended = RustCsgFileAppend(testPath, " world")
    if !checkEqI32(appended, 1):
        ok = false
    # Append to nonexistent file (creates file)
    RustCsgFileDelete(testPath)
    let appended2 = RustCsgFileAppend(testPath, "fresh")
    if !checkEqI32(appended2, 1):
        ok = false
    # Clean up
    RustCsgFileDelete(testPath)
    if ok:
        echo("testFileAppend ok")
    return ok

fn testFileTruncate(): bool =
    var ok: bool = true
    let testPath = "/tmp/rust_csg_fs_test_truncate.txt"
    RustCsgFileDelete(testPath)
    # Write content
    let wrote = RustCsgWriteFile(testPath, "hello world truncate test")
    if !checkEqI32(wrote, 1):
        ok = false
    # Truncate to 5 bytes ("hello")
    let truncated = RustCsgFileTruncate(testPath, int64(5))
    if !checkEqI32(truncated, 1):
        ok = false
    # Truncate nonexistent file
    let truncated2 = RustCsgFileTruncate("/tmp/rust_csg_fs_test_noexist_trunc", int64(0))
    if !checkEqI32(truncated2, 0):
        ok = false
    # Truncate to larger size (should extend with zeros)
    let truncated3 = RustCsgFileTruncate(testPath, int64(20))
    if !checkEqI32(truncated3, 1):
        ok = false
    # Clean up
    RustCsgFileDelete(testPath)
    if ok:
        echo("testFileTruncate ok")
    return ok

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testFileWriteDelete(): allOk = false
    if !testFileRename(): allOk = false
    if !testMkdir(): allOk = false
    if !testFileDeleteNonExistent(): allOk = false
    if !testFileRenameNonExistent(): allOk = false
    if !testFileCopy(): allOk = false
    if !testFileAppend(): allOk = false
    if !testFileTruncate(): allOk = false
    if allOk:
        echo("rust_csg_fs_provider_smoke ok")
        return 0
    else:
        echo("rust_csg_fs_provider_smoke FAILED")
        return 1
