# utils_base64 — smoke test for pure Cheng base64 encode / decode

import cheng/codex/crates/utils_base64/utils_base64 as b64

fn main(): int32 =
    # empty string
    let emptyEnc = b64.RustCsgBase64Encode("")
    let emptyDec = b64.RustCsgBase64Decode(emptyEnc)
    assert(emptyEnc == "", "encode empty")
    assert(emptyDec == "", "decode empty")

    # "hello" → "aGVsbG8="
    let helloEnc = b64.RustCsgBase64Encode("hello")
    assert(helloEnc == "aGVsbG8=", "encode hello")

    let helloDec = b64.RustCsgBase64Decode("aGVsbG8=")
    assert(helloDec == "hello", "decode hello")

    # "Codex" → "Q29kZXg="
    let codexEnc = b64.RustCsgBase64Encode("Codex")
    assert(codexEnc == "Q29kZXg=", "encode Codex")

    let codexDec = b64.RustCsgBase64Decode("Q29kZXg=")
    assert(codexDec == "Codex", "decode Codex")

    # roundtrip: encode then decode
    let rt = b64.RustCsgBase64Decode(b64.RustCsgBase64Encode("hello"))
    assert(rt == "hello", "roundtrip hello")

    let rt2 = b64.RustCsgBase64Decode(b64.RustCsgBase64Encode("Codex"))
    assert(rt2 == "Codex", "roundtrip Codex")

    # roundtrip with whitespace in b64 input
    let rt3 = b64.RustCsgBase64Decode("aGVs bG8=")
    assert(rt3 == "hello", "roundtrip with space")

    echo("rust_csg_utils_base64_smoke ok")
    return 0
