import std/cmdline
import std/strutils as strutil
import cheng/codex/config/user_config
import cheng/codex/protocol/wire

fn checkEq(actual: str, expected: str, label: str): bool =
    if actual == expected:
        return true
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return false

fn checkContains(actual: str, needle: str, label: str): bool =
    if strutil.Contains(actual, needle):
        return true
    echo(strutil.Join(["FAIL ", label, ": missing ", needle, " in ", actual], ""))
    return false

fn main(): int32 =
    if cmdline.argCount() < 5:
        echo("FAIL usage: rust_csg_user_config_smoke <config-home> <missing-home> <dir-config-home> <broken-home>")
        return 1

    let configHome = cmdline.argStr(1)
    let missingHome = cmdline.argStr(2)
    let dirConfigHome = cmdline.argStr(3)
    let brokenHome = cmdline.argStr(4)
    var ok = true
    var err: str

    let profileConfig = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(configHome, false, "", err)
    ok = checkEq(err, "", "profile config err") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "model"), "profile-model", "profile model") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "modelProvider"), "profile-provider", "profile provider") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "approvalPolicy"), "never", "profile approval") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "approvalsReviewer"), "auto_review", "profile reviewer") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "sandboxMode"), "read-only", "profile sandbox") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "ossProvider"), "ollama", "profile oss") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "defaultPermissions"), ":workspace", "root default permissions") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(profileConfig, "profile"), "local", "root selected profile") && ok

    let overrideConfig = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(configHome, false, "other", err)
    ok = checkEq(err, "", "override config err") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(overrideConfig, "model"), "other-model", "override model") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(overrideConfig, "approvalsReviewer"), "user", "override reviewer") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(overrideConfig, "profile"), "other", "override profile") && ok

    let missingConfig = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(missingHome, false, "", err)
    ok = checkEq(err, "", "missing config err") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(missingConfig, "model"), "", "missing model") && ok

    let ignoredConfig = user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(brokenHome, true, "", err)
    ok = checkEq(err, "", "ignore config err") && ok
    ok = checkEq(wire.RustCsgJsonFindOptionalStr(ignoredConfig, "model"), "", "ignore model") && ok

    user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(dirConfigHome, false, "", err)
    ok = checkContains(err, "config.toml path is not a file", "directory config error") && ok

    user_config.RustCsgLoadUserConfigJsonFromCodexHomeWithProfile(brokenHome, false, "", err)
    ok = checkContains(err, "unterminated config.toml table", "broken config error") && ok

    if !ok:
        echo("rust_csg_user_config_smoke FAILED")
        return 1
    echo("rust_csg_user_config_smoke ok")
    return 0
