# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testConfigFileResponseFields(): allOk = false
    if !testTaskResponseFields(): allOk = false
    if !testTaskListItemFields(): allOk = false
    if !testGitPullRequestFields(): allOk = false
    if !testPaginatedListFields(): allOk = false
    if !testRateLimitWindowSnapshotFields(): allOk = false
    if !testPlanTypeEnumValues(): allOk = false
    if !testRateLimitReachedKindValues(): allOk = false
    if !testCodeTaskDetailsFields(): allOk = false
    if !testRateLimitStatusPayloadFields(): allOk = false
    if !testExternalPullRequestResponseFields(): allOk = false
    if !testRateLimitStatusDetailsFields(): allOk = false
    if !testAdditionalRateLimitDetailsFields(): allOk = false
    if !testCreditStatusDetailsFields(): allOk = false
    if !testOpenApiValidateModel(): allOk = false

    if allOk:
        echo("rust_csg_openapi_models_smoke ok")
        return 0
    else:
        echo("rust_csg_openapi_models_smoke FAILED")
        return 1
