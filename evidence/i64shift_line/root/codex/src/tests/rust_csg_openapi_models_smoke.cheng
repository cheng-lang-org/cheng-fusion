# Field definition accessors.
# Format: "field_name|json_key|type_tag,..." per struct.
# Type tags: "str", "bool", "int32", "f64", "opt_str", "opt_bool", "opt_f64",
#            "vec", "map", "vec_pr", "opt_vec", "opt_box"
# ═══════════════════════════════════════════════════════════════════════════════

