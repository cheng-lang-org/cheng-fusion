# Validate a model name and version string.
# Model name must be non-empty and start with a letter or digit.
# Version must be non-empty and match "major.minor" or "major.minor.patch" pattern.
# Returns "" on success, or an error message string describing the validation failure.
fn OpenApiValidateModel(name: str, version: str): str =
    if name.len == 0:
        return "model name must not be empty"
    let first = name[0]
    if !(first >= 'a' && first <= 'z') && !(first >= 'A' && first <= 'Z') && !(first >= '0' && first <= '9'):
        return "model name must start with a letter or digit"
    if version.len == 0:
        return "model version must not be empty"
    var dotCount: int32 = 0
    var segStart: int32 = 0
    var i: int32 = 0
    while i <= version.len:
        if i == version.len || version[i] == '.':
            if i == segStart:
                return "model version has empty segment"
            segStart = i + 1
            if i < version.len:
                dotCount = dotCount + 1
        else:
            let ch = version[i]
            if ch < '0' || ch > '9':
                return "model version contains non-digit character"
        i = i + 1
    if dotCount < 1 || dotCount > 2:
        return "model version must have 1 or 2 dots"
    return ""

fn testOpenApiValidateModel(): bool =
    var ok: bool = true
    var v: str
    v = OpenApiValidateModel("claude", "3.5")
    if v != "":
        echo("FAIL: validateModel valid")
        ok = false
    v = OpenApiValidateModel("gpt-4", "1.0.0")
    if v != "":
        echo("FAIL: validateModel valid with patch")
        ok = false
    v = OpenApiValidateModel("", "1.0")
    if v == "":
        echo("FAIL: validateModel empty name")
        ok = false
    v = OpenApiValidateModel("model", "")
    if v == "":
        echo("FAIL: validateModel empty version")
        ok = false
    v = OpenApiValidateModel("model", "abc")
    if v == "":
        echo("FAIL: validateModel non-numeric version")
        ok = false
    v = OpenApiValidateModel("model", "1.2.3.4")
    if v == "":
        echo("FAIL: validateModel too many dots")
        ok = false
    v = OpenApiValidateModel("_model", "1.0")
    if v == "":
        echo("FAIL: validateModel invalid start char")
        ok = false
    if ok:
        echo("testOpenApiValidateModel ok")
    return ok

fn OpenApiRateLimitReachedKindValues(): str =
