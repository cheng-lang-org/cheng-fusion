# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.IntToStr(expected),
                           " got=", strings.IntToStr(got)], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

# Count fields in a pipe+comma delimited definition string
# Used inside test functions on local str vars (works around const bug)
fn countFieldsInline(fields: str, fieldsLen: int32): int32 =
    if fieldsLen == 0:
        return 0
    var count: int32 = 1
    var i: int32 = 0
    var part: int32 = 0
    while i < fieldsLen:
        if fields[i] == ',' && part == 2:
            count = count + 1
            part = 0
        elif fields[i] == '|':
            part = part + 1
        i = i + 1
    return count

