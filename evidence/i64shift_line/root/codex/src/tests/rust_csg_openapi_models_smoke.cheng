fn testConfigFileResponseFields(): bool =
    var ok: bool = true
    var fields: str = OpenApiFieldsConfigFileResponse()
    let count = countFieldsInline(fields, fields.len)
    if !checkEqI32(count, 4): ok = false
    if !strings.StrContains(fields, "contents|contents|opt_str"): ok = false
    if !strings.StrContains(fields, "sha256|sha256|opt_str"): ok = false
    if !strings.StrContains(fields, "updated_by_user_id|updated_by_user_id|opt_str"): ok = false
    if ok:
        echo("testConfigFileResponseFields ok")
    return ok

