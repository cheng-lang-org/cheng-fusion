import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chatwidget_exec_flow_status_oracle as oracle

fn RustCsgTuiChatwidgetExecFlowFirstDiff(a: str, b: str): int32 =
    let alen: int32 = strings.Len(a)
    let blen: int32 = strings.Len(b)
    var limit: int32 = alen
    if blen < limit:
        limit = blen
    var i: int32 = 0
    while i < limit:
        if a[i] != b[i]:
            return i
        i = i + 1
    if alen != blen:
        return limit
    return -1

fn RustCsgTuiChatwidgetExecFlowStatusCheck(path: str,
                                           expectedExpression: str,
                                           expectedBody: str,
                                           name: str): int32 =
    let expectedSource: str = "tui/src/chatwidget/tests.rs"
    let parsed = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !parsed.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", parsed.error], ""))
        return 1
    if parsed.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", parsed.source], ""))
        return 1
    if parsed.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", parsed.expression], ""))
        return 1
    if expectedBody != parsed.body:
        let diff: int32 = RustCsgTuiChatwidgetExecFlowFirstDiff(expectedBody, parsed.body)
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(strings.Len(expectedBody)),
            " got=", strings.IntToStr(parsed.bodyByteLen),
            " first_diff=", strings.IntToStr(diff),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 4:
        echo("FAIL usage: rust_csg_tui_chatwidget_exec_flow_status_oracle_smoke <3 snapshot paths>")
        return 1

    let backendExpression: str = "terminal.backend()"
    let renderedExpression: str = "rendered"

    var exitCode: int32 = 0
    var i: int32 = 1
    exitCode = exitCode + RustCsgTuiChatwidgetExecFlowStatusCheck(
        cmdline.argStr(i),
        backendExpression,
        oracle.RustCsgTuiChatwidgetPreambleKeepsWorkingStatus(),
        "preamble_keeps_working_status")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetExecFlowStatusCheck(
        cmdline.argStr(i),
        backendExpression,
        oracle.RustCsgTuiChatwidgetUnifiedExecBeginRestoresWorkingStatus(),
        "unified_exec_begin_restores_working_status")
    i = i + 1
    exitCode = exitCode + RustCsgTuiChatwidgetExecFlowStatusCheck(
        cmdline.argStr(i),
        renderedExpression,
        oracle.RustCsgTuiChatwidgetUnifiedExecWaitStatusSingleDetailsRow(),
        "unified_exec_wait_status_renders_command_in_single_details_row")

    if exitCode == 0:
        echo("rust_csg_tui_chatwidget_exec_flow_status_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chatwidget_exec_flow_status_oracle_smoke FAILED")
    return exitCode
