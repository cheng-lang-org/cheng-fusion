# Analytics smoke test — verifies event type constants and enum values.
# Ported from codex-rs/analytics/src/{lib,events,facts}.rs

import cheng/codex/crates/analytics
import std/strings
import std/strutils as strutil

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testEventTypeConstants(): bool =
    var ok: bool = true
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeThreadInitialized, "codex_thread_initialized", "EventThreadInitialized"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeSkillInvocation, "codex_skill_invocation", "EventSkillInvocation"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeGuardianReview, "codex_guardian_review", "EventGuardianReview"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeAppMentioned, "codex_app_mentioned", "EventAppMentioned"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeCompaction, "codex_compaction", "EventCompaction"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeTurnEvent, "codex_turn_event", "EventTurnEvent"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsEventTypeTurnSteer, "codex_turn_steer", "EventTurnSteer"):
        ok = false
    if ok:
        echo("testEventTypeConstants ok")
    return ok

fn testGuardianEnums(): bool =
    var ok: bool = true
    if !checkEqStr(analytics.RustCsgGuardianDecisionApproved, "approved", "GuardianDecisionApproved"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianDecisionDenied, "denied", "GuardianDecisionDenied"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianTerminalStatusApproved, "approved", "GuardianTerminalApproved"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianTerminalStatusTimedOut, "timed_out", "GuardianTerminalTimedOut"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianTerminalStatusFailedClosed, "failed_closed", "GuardianTerminalFailedClosed"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianFailureReasonTimeout, "timeout", "GuardianFailureTimeout"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianFailureReasonSessionError, "session_error", "GuardianFailureSessionError"):
        ok = false
    if ok:
        echo("testGuardianEnums ok")
    return ok

fn testGuardianReviewedActionVariants(): bool =
    var ok: bool = true
    if !checkEqI32(analytics.RustCsgGuardianReviewedActionVariantCount, 7, "GuardianActionVariantCount"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianReviewedActionVariantShell, "Shell", "GuardianActionShell"):
        ok = false
    if !checkEqStr(analytics.RustCsgGuardianReviewedActionVariantMcpToolCall, "McpToolCall", "GuardianActionMcpToolCall"):
        ok = false
    if ok:
        echo("testGuardianReviewedActionVariants ok")
    return ok

fn testCompactionEnums(): bool =
    var ok: bool = true
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionTriggerVariantCount, 7, "CompactionTriggerCount"):
        ok = false
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionReasonVariantCount, 6, "CompactionReasonCount"):
        ok = false
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionImplementationVariantCount, 3, "CompactionImplCount"):
        ok = false
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionPhaseVariantCount, 4, "CompactionPhaseCount"):
        ok = false
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionStrategyVariantCount, 6, "CompactionStrategyCount"):
        ok = false
    if !checkEqI32(analytics.RustCsgAnalyticsCompactionStatusVariantCount, 4, "CompactionStatusCount"):
        ok = false
    if ok:
        echo("testCompactionEnums ok")
    return ok

fn testPluginStateConstants(): bool =
    var ok: bool = true
    if !checkEqStr(analytics.RustCsgAnalyticsPluginStateInstalled, "Installed", "PluginInstalled"):
        ok = false
    if !checkEqStr(analytics.RustCsgAnalyticsPluginStateEnabled, "Enabled", "PluginEnabled"):
        ok = false
    if ok:
        echo("testPluginStateConstants ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testEventTypeConstants():
        allOk = false
    if !testGuardianEnums():
        allOk = false
    if !testGuardianReviewedActionVariants():
        allOk = false
    if !testCompactionEnums():
        allOk = false
    if !testPluginStateConstants():
        allOk = false
    if allOk:
        echo("rust_csg_analytics_smoke ok")
        return 0
    else:
        echo("rust_csg_analytics_smoke FAILED")
        return 1
