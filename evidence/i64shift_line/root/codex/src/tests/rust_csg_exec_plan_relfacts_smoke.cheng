fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    if source.len >= 3 && source[0] == 'f' && source[1] == 'n' && source[2] == ' ':
        c = c + 1
    for i in 0..<source.len:
        if source[i] == '\n':
            start = i + 1
            if source.len - start >= 3 && source[start] == 'f' && source[start + 1] == 'n' && source[start + 2] == ' ':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'F' && oracle[lineStart + 1] == 'u':
                c = c + 1
    return c

fn main(): int32 =
    let source = "type\n    RustCsgExecPlan =\n        command: str\n        prompt: str\n        resumeSessionId: str\n        resumeLast: bool\n        resumeAll: bool\n        images: str[]\n        model: str\n        cwd: str\n        sandbox: str\n        color: str\n        json: bool\n        outputLastMessage: str\n        outputSchema: str\n        skipGitRepoCheck: bool\n        ephemeral: bool\n        ignoreUserConfig: bool\n        ignoreRules: bool\n        removedFullAuto: bool\n        dangerouslyBypassApprovalsAndSandbox: bool\n        oss: bool\n        ossProvider: str\n        configProfile: str\n        configOverrides: str[]\n        addDirs: str[]\n        reviewUncommitted: bool\n        reviewBase: str\n        reviewCommit: str\n        reviewTitle: str\n        parseError: str\n\nfn RustCsgExecPlanDefault(): RustCsgExecPlan =\nfn RustCsgExecSetParseError(plan: var RustCsgExecPlan, message: str) =\nfn RustCsgExecSetUnknownFlag(plan: var RustCsgExecPlan, flag: str) =\nfn RustCsgExecMatchesPrefix(text: str, prefix: str): bool =\nfn RustCsgExecInlineValue(arg: str, key: str): str =\nfn RustCsgExecReadValueAt(args: str[], index: int32, keyA: str, keyB: str, outValue: var str, outNextIndex: var int32): bool =\nfn RustCsgExecIsFlag(arg: str): bool =\nfn RustCsgExecConsumeValueFlag(plan: var RustCsgExecPlan, args: str[], index: int32, outNextIndex: var int32): bool =\nfn RustCsgExecConsumeBoolFlag(plan: var RustCsgExecPlan, arg: str): bool =\nfn RustCsgExecConsumePositional(plan: var RustCsgExecPlan, value: str, allowCommand: bool) =\nfn RustCsgExecFinalizePlan(plan: var RustCsgExecPlan) =\nfn RustCsgExecParseArgs(args: str[]): RustCsgExecPlan =\nfn RustCsgExecPlanToJson(plan: RustCsgExecPlan): str =\nfn RustCsgExecPlanFromJson(text: str): RustCsgExecPlan =\nfn RustCsgExecPlanRuntimeMissingReason(plan: RustCsgExecPlan): str =\n"

    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\texec/plan\nLocalType\texec/plan\tRustCsgExecPlan\nHasField\texec/plan\tRustCsgExecPlan\tcommand\tstr\nHasField\texec/plan\tRustCsgExecPlan\tprompt\tstr\nHasField\texec/plan\tRustCsgExecPlan\tresumeSessionId\tstr\nHasField\texec/plan\tRustCsgExecPlan\tresumeLast\tbool\nHasField\texec/plan\tRustCsgExecPlan\tresumeAll\tbool\nHasField\texec/plan\tRustCsgExecPlan\timages\tstr[]\nHasField\texec/plan\tRustCsgExecPlan\tmodel\tstr\nHasField\texec/plan\tRustCsgExecPlan\tcwd\tstr\nHasField\texec/plan\tRustCsgExecPlan\tsandbox\tstr\nHasField\texec/plan\tRustCsgExecPlan\tcolor\tstr\nHasField\texec/plan\tRustCsgExecPlan\tjson\tbool\nHasField\texec/plan\tRustCsgExecPlan\toutputLastMessage\tstr\nHasField\texec/plan\tRustCsgExecPlan\toutputSchema\tstr\nHasField\texec/plan\tRustCsgExecPlan\tskipGitRepoCheck\tbool\nHasField\texec/plan\tRustCsgExecPlan\tephemeral\tbool\nHasField\texec/plan\tRustCsgExecPlan\tignoreUserConfig\tbool\nHasField\texec/plan\tRustCsgExecPlan\tignoreRules\tbool\nHasField\texec/plan\tRustCsgExecPlan\tremovedFullAuto\tbool\nHasField\texec/plan\tRustCsgExecPlan\tdangerouslyBypassApprovalsAndSandbox\tbool\nHasField\texec/plan\tRustCsgExecPlan\toss\tbool\nHasField\texec/plan\tRustCsgExecPlan\tossProvider\tstr\nHasField\texec/plan\tRustCsgExecPlan\tconfigProfile\tstr\nHasField\texec/plan\tRustCsgExecPlan\tconfigOverrides\tstr[]\nHasField\texec/plan\tRustCsgExecPlan\taddDirs\tstr[]\nHasField\texec/plan\tRustCsgExecPlan\treviewUncommitted\tbool\nHasField\texec/plan\tRustCsgExecPlan\treviewBase\tstr\nHasField\texec/plan\tRustCsgExecPlan\treviewCommit\tstr\nHasField\texec/plan\tRustCsgExecPlan\treviewTitle\tstr\nHasField\texec/plan\tRustCsgExecPlan\tparseError\tstr\nFunction\texec/plan\tRustCsgExecPlanDefault\tRustCsgExecPlan\nFunction\texec/plan\tRustCsgExecSetParseError\t\nFunction\texec/plan\tRustCsgExecSetUnknownFlag\t\nFunction\texec/plan\tRustCsgExecMatchesPrefix\tbool\nFunction\texec/plan\tRustCsgExecInlineValue\tstr\nFunction\texec/plan\tRustCsgExecReadValueAt\tbool\nFunction\texec/plan\tRustCsgExecIsFlag\tbool\nFunction\texec/plan\tRustCsgExecConsumeValueFlag\tbool\nFunction\texec/plan\tRustCsgExecConsumeBoolFlag\tbool\nFunction\texec/plan\tRustCsgExecConsumePositional\t\nFunction\texec/plan\tRustCsgExecFinalizePlan\t\nFunction\texec/plan\tRustCsgExecParseArgs\tRustCsgExecPlan\nFunction\texec/plan\tRustCsgExecPlanToJson\tstr\nFunction\texec/plan\tRustCsgExecPlanFromJson\tRustCsgExecPlan\nFunction\texec/plan\tRustCsgExecPlanRuntimeMissingReason\tstr\n"

    let ect = CountSourceTypes(source)
    let ecf = CountSourceFields(source)
    let ecn = CountSourceFunctions(source)
    assert(ect == 1, "source type count")
    assert(ecf == 29, "source field count")
    assert(ecn == 15, "source function count")

    let oct = CountOracleTypes(oracle)
    let ocf = CountOracleFields(oracle)
    let ocn = CountOracleFunctions(oracle)
    assert(oct == 1, "oracle type count")
    assert(ocf == 29, "oracle field count")
    assert(ocn == 15, "oracle function count")
    assert(ect == oct, "types oracle vs extracted")
    assert(ecf == ocf, "fields oracle vs extracted")
    assert(ecn == ocn, "functions oracle vs extracted")

    echo("rust_csg_exec_plan_relfacts_smoke ok")
    return 0
