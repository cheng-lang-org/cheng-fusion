import std/strings
import codex/app_server/rate_limit_dashboard
import codex/protocol/ratelimit_wire
import codex/protocol/wire

fn testCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn testContains(text: str, needle: str): bool =
    return findIndex(text, needle) >= 0

fn assertTrue(name: str, value: bool) =
    if !value:
        echo(testCat("FAIL: ", name))
    assert(value, name)

fn assertText(name: str, left: str, right: str) =
    if left != right:
        echo(testCat("FAIL: ", name))
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertContains(name: str, haystack: str, needle: str) =
    if !testContains(haystack, needle):
        echo(testCat("FAIL: ", name))
        echo(testCat("missing: ", needle))
        echo(testCat("in: ", haystack))
    assert(testContains(haystack, needle), name)

fn assertNotContains(name: str, haystack: str, needle: str) =
    if testContains(haystack, needle):
        echo(testCat("FAIL: ", name))
        echo(testCat("unexpected: ", needle))
        echo(testCat("in: ", haystack))
    assert(!testContains(haystack, needle), name)

fn findIndex(haystack: str, needle: str): int32 =
    if needle == "":
        return 0
    if needle.len > haystack.len:
        return -1
    var i: int32
    while i <= haystack.len - needle.len:
        if haystack[i] == needle[0]:
            var j: int32
            var matched = true
            while j < needle.len:
                if haystack[i + j] != needle[j]:
                    matched = false
                    break
                j = j + 1
            if matched:
                return i
        i = i + 1
    return -1

fn assertBefore(name: str, haystack: str, left: str, right: str) =
    let leftIndex = findIndex(haystack, left)
    let rightIndex = findIndex(haystack, right)
    if leftIndex < 0 || rightIndex < 0 || leftIndex >= rightIndex:
        echo(testCat("FAIL: ", name))
        echo(haystack)
    assert(leftIndex >= 0 && rightIndex >= 0 && leftIndex < rightIndex, name)

fn testSnapshotReconcilesEnvOrder() =
    let env = "ACCOUNTS=\"beta@example.test alpha@example.test alpha@example.test missing@example.test\"\nPASSWORD='secret'\nMAILBOX_PASSWORD=mail-secret\n"
    let cache = "{\"accounts\":[{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\",\"credits\":{\"hasCredits\":false,\"unlimited\":false},\"planType\":\"plus\"}],\"error\":null},{\"email\":\"stale@example.test\",\"status\":\"success\",\"fetchedAt\":176,\"rateLimits\":[],\"error\":null},{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":177,\"rateLimits\":[],\"error\":\"bad token\"}],\"lastUpdatedAt\":179,\"source\":\"fresh\"}"
    var out: str
    var error: str
    let ok = rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(env, "/fixture/.env", cache, out, error)
    if !ok:
        echo(error)
    assertTrue("dashboard snapshot ok", ok)
    let expected = "{\"accounts\":[{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":177,\"rateLimits\":[],\"error\":\"bad token\"},{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\",\"credits\":{\"hasCredits\":false,\"unlimited\":false},\"planType\":\"plus\"}],\"error\":null},{\"email\":\"missing@example.test\",\"status\":\"idle\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":null}],\"lastUpdatedAt\":179,\"source\":\"cache\"}"
    assertText("dashboard snapshot json", expected, out)
    let parsed = ratelimit_wire.RustCsgRateLimitDashboardResponseFromJson(out)
    assertText("dashboard source", "cache", parsed.source)
    assertText("dashboard last updated", "179", parsed.lastUpdatedAtJson)
    assertNotContains("stale account dropped", out, "stale@example.test")

fn testMissingPasswordFails() =
    let env = "ACCOUNTS=alpha@example.test\n"
    let cache = "{\"accounts\":[],\"lastUpdatedAt\":null}"
    var out: str
    var error: str
    assertTrue("missing password hard fail", !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(env, "/fixture/.env", cache, out, error))
    assertContains("missing password error", error, "PASSWORD is missing")

fn testRustAccountsConfigErrors() =
    let cache = "{\"accounts\":[],\"lastUpdatedAt\":null}"
    var out: str
    var error: str
    assertTrue("missing accounts hard fail", !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache("PASSWORD=secret\n", "/fixture/.env", cache, out, error))
    assertText("missing accounts error", "ACCOUNTS is missing from /fixture/.env", error)
    assertTrue("empty accounts hard fail", !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache("ACCOUNTS=\"   \"\nPASSWORD=secret\n", "/fixture/.env", cache, out, error))
    assertText("empty accounts error", "ACCOUNTS in /fixture/.env is empty", error)
    let statusJsonOnly = "ACCOUNT_STATUS_JSON='{\"accounts\":[{\"email\":\"alpha@example.test\",\"subscription\":\"Plus\",\"quotaRemainingPercent\":80,\"quotaResetAt\":\"2026-06-01T00:00:00Z\"}]}'\nPASSWORD=secret\n"
    assertTrue("dashboard ignores status json without accounts", !rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(statusJsonOnly, "/fixture/.env", cache, out, error))
    assertText("status json without accounts error", "ACCOUNTS is missing from /fixture/.env", error)

fn testMissingCacheBuildsIdleSnapshot() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=secret\n"
    var out: str
    var error: str
    assertTrue("missing cache dashboard ok", rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(env, "/fixture/.env", "", out, error))
    assertContains("missing cache fresh source", out, "\"source\":\"fresh\"")
    assertContains("missing cache null timestamp", out, "\"lastUpdatedAt\":null")
    assertContains("missing cache idle account", out, "\"status\":\"idle\"")
    assertContains("missing cache empty limits", out, "\"rateLimits\":[]")

fn testInvalidCacheStatusFallsBackToFresh() =
    let env = "ACCOUNTS=alpha@example.test\nPASSWORD=secret\n"
    let cache = "{\"accounts\":[{\"email\":\"alpha@example.test\",\"status\":\"bogus\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":null}],\"lastUpdatedAt\":179}"
    var out: str
    var error: str
    assertTrue("invalid cache status falls back", rate_limit_dashboard.RustCsgRateLimitDashboardSnapshotFromEnvAndCache(env, "/fixture/.env", cache, out, error))
    assertContains("invalid cache fresh source", out, "\"source\":\"fresh\"")
    assertContains("invalid cache idle account", out, "\"status\":\"idle\"")
    assertText("invalid cache clears error", "", error)

fn testConfiguredAccountCheck() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=secret\n"
    var found: bool
    var error: str
    assertTrue("configured account check ok", rate_limit_dashboard.RustCsgRateLimitDashboardConfiguredAccountExists(env, "/fixture/.env", "beta@example.test", found, error))
    assertTrue("configured account found", found)
    assertText("configured account no error", "", error)
    assertTrue("missing configured account check ok", rate_limit_dashboard.RustCsgRateLimitDashboardConfiguredAccountExists(env, "/fixture/.env", "gamma@example.test", found, error))
    assertTrue("missing configured account false", !found)
    assertContains("missing configured account error", error, "account `gamma@example.test` is not configured in .env")
    assertTrue("configured account missing password fails", !rate_limit_dashboard.RustCsgRateLimitDashboardConfiguredAccountExists("ACCOUNTS=alpha@example.test\n", "/fixture/.env", "alpha@example.test", found, error))
    assertContains("configured account missing password error", error, "PASSWORD is missing")

fn testRefreshFailurePreservesCachedLimitsAndWritesCache() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=secret\n"
    let cache = "{\"accounts\":[{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\",\"limitName\":\"Codex\"}],\"error\":null},{\"email\":\"beta@example.test\",\"status\":\"idle\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":null}],\"lastUpdatedAt\":179}"
    var out: str
    var cacheOut: str
    var error: str
    assertTrue("refresh failure ok", rate_limit_dashboard.RustCsgRateLimitDashboardRefreshFailureFromEnvAndCache(env, "/fixture/.env", cache, int64(200), "", "fetcher unavailable", out, cacheOut, error))
    assertContains("refresh failure fresh source", out, "\"source\":\"fresh\"")
    assertContains("refresh failure last updated", out, "\"lastUpdatedAt\":200")
    assertContains("refresh failure alpha failed", out, "{\"email\":\"alpha@example.test\",\"status\":\"failed\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\",\"limitName\":\"Codex\"}],\"error\":\"fetcher unavailable\"}")
    assertContains("refresh failure beta failed", out, "{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":null,\"rateLimits\":[],\"error\":\"fetcher unavailable\"}")
    assertContains("refresh cache has no source", cacheOut, "\"lastUpdatedAt\":200")
    assertNotContains("refresh cache no source", cacheOut, "\"source\"")

fn testRefreshOneFailureOnlyTouchesTarget() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=secret\n"
    let cache = "{\"accounts\":[{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\"}],\"error\":null},{\"email\":\"beta@example.test\",\"status\":\"success\",\"fetchedAt\":179,\"rateLimits\":[{\"limitId\":\"gpt\"}],\"error\":null}],\"lastUpdatedAt\":180}"
    var out: str
    var cacheOut: str
    var error: str
    assertTrue("refresh one failure ok", rate_limit_dashboard.RustCsgRateLimitDashboardRefreshFailureFromEnvAndCache(env, "/fixture/.env", cache, int64(201), "beta@example.test", "fetcher unavailable", out, cacheOut, error))
    assertContains("refresh one keeps alpha", out, "{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\"}],\"error\":null}")
    assertContains("refresh one fails beta", out, "{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":179,\"rateLimits\":[{\"limitId\":\"gpt\"}],\"error\":\"fetcher unavailable\"}")
    assertTrue("refresh one missing account fails", !rate_limit_dashboard.RustCsgRateLimitDashboardRefreshFailureFromEnvAndCache(env, "/fixture/.env", cache, int64(202), "gamma@example.test", "fetcher unavailable", out, cacheOut, error))
    assertContains("refresh one missing account error", error, "gamma@example.test")

fn testLoadingSnapshot() =
    let env = "ACCOUNTS=\"alpha@example.test beta@example.test\"\nPASSWORD=secret\n"
    let cache = "{\"accounts\":[{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\"}],\"error\":null},{\"email\":\"beta@example.test\",\"status\":\"failed\",\"fetchedAt\":179,\"rateLimits\":[],\"error\":\"old\"}],\"lastUpdatedAt\":180}"
    var out: str
    var error: str
    assertTrue("loading snapshot ok", rate_limit_dashboard.RustCsgRateLimitDashboardLoadingSnapshotFromEnvAndCache(env, "/fixture/.env", cache, "beta@example.test", out, error))
    assertContains("loading keeps alpha", out, "{\"email\":\"alpha@example.test\",\"status\":\"success\",\"fetchedAt\":178,\"rateLimits\":[{\"limitId\":\"codex\"}],\"error\":null}")
    assertContains("loading clears target error", out, "{\"email\":\"beta@example.test\",\"status\":\"loading\",\"fetchedAt\":179,\"rateLimits\":[],\"error\":null}")
    assertContains("loading keeps cache source", out, "\"source\":\"cache\"")

fn testUsagePayloadMapping() =
    let payload = "{\"plan_type\":\"pro\",\"rate_limit\":{\"allowed\":true,\"limit_reached\":false,\"primary_window\":{\"used_percent\":42,\"limit_window_seconds\":300,\"reset_after_seconds\":0,\"reset_at\":123},\"secondary_window\":{\"used_percent\":84,\"limit_window_seconds\":3600,\"reset_after_seconds\":0,\"reset_at\":456}},\"rate_limit_reached_type\":{\"type\":\"workspace_member_credits_depleted\"},\"credits\":{\"has_credits\":true,\"unlimited\":false,\"balance\":\"9.99\"},\"additional_rate_limits\":[{\"limit_name\":\"Codex other\",\"metered_feature\":\"codex_other\",\"rate_limit\":{\"allowed\":true,\"limit_reached\":false,\"primary_window\":{\"used_percent\":70,\"limit_window_seconds\":900,\"reset_after_seconds\":0,\"reset_at\":789}}}]}"
    let additionalRaw = wire.RustCsgJsonFindOptionalArray(payload, "additional_rate_limits")
    assertContains("usage additional raw", additionalRaw, "codex_other")
    let snapshots = rate_limit_dashboard.RustCsgRateLimitDashboardUsagePayloadToSnapshots(payload)
    assertContains("usage maps codex limit", snapshots, "{\"limitId\":\"codex\",\"limitName\":null,\"primary\":{\"usedPercent\":42,\"windowDurationMins\":5,\"resetsAt\":123},\"secondary\":{\"usedPercent\":84,\"windowDurationMins\":60,\"resetsAt\":456},\"credits\":{\"hasCredits\":true,\"unlimited\":false,\"balance\":\"9.99\"},\"planType\":\"pro\"}")
    assertContains("usage maps additional limit", snapshots, "{\"limitId\":\"codex_other\",\"limitName\":\"Codex other\",\"primary\":{\"usedPercent\":70,\"windowDurationMins\":15,\"resetsAt\":789},\"secondary\":null,\"credits\":null,\"planType\":\"pro\"}")
    assertNotContains("usage omits reached type", snapshots, "rateLimitReachedType")
    let prolitePayload = "{\"plan_type\":\"prolite\",\"rate_limit\":{\"primary_window\":{\"used_percent\":1,\"limit_window_seconds\":300,\"reset_at\":10}}}"
    let proliteSnapshots = rate_limit_dashboard.RustCsgRateLimitDashboardUsagePayloadToSnapshots(prolitePayload)
    assertContains("usage maps unsupported prolite to unknown", proliteSnapshots, "\"planType\":\"unknown\"")
    let fractionalPayload = "{\"plan_type\":\"pro\",\"rate_limit\":{\"primary_window\":{\"used_percent\":12.5,\"limit_window_seconds\":60}}}"
    let fractionalSnapshots = rate_limit_dashboard.RustCsgRateLimitDashboardUsagePayloadToSnapshots(fractionalPayload)
    assertContains("usage rounds fractional percent", fractionalSnapshots, "\"primary\":{\"usedPercent\":13,\"windowDurationMins\":1,\"resetsAt\":null}")
    var response: str
    var responseError: str
    assertTrue("usage account response ok", rate_limit_dashboard.RustCsgRateLimitDashboardAccountRateLimitsResponseFromUsagePayload(payload, response, responseError))
    assertContains("usage account response primary", response, "\"rateLimits\":{\"limitId\":\"codex\"")
    assertContains("usage account response map codex", response, "\"rateLimitsByLimitId\":{\"codex\":{\"limitId\":\"codex\"")
    assertContains("usage account response map additional", response, "\"codex_other\":{\"limitId\":\"codex_other\"")
    assertNotContains("usage account response omits reached type", response, "rateLimitReachedType")

fn testUsagePayloadPreservesBackendOrderLikeRust() =
    let payload = "{\"plan_type\":\"plus\",\"rate_limit\":{\"primary_window\":{\"used_percent\":1,\"limit_window_seconds\":300,\"reset_at\":10}},\"additional_rate_limits\":[{\"limit_name\":\"Zed\",\"metered_feature\":\"zed_limit\",\"rate_limit\":{\"primary_window\":{\"used_percent\":2,\"limit_window_seconds\":300,\"reset_at\":20}}},{\"limit_name\":\"Alpha\",\"metered_feature\":\"aaa_limit\",\"rate_limit\":{\"primary_window\":{\"used_percent\":3,\"limit_window_seconds\":300,\"reset_at\":30}}}]}"
    let snapshots = rate_limit_dashboard.RustCsgRateLimitDashboardUsagePayloadToSnapshots(payload)
    assertBefore("codex stays first", snapshots, "\"limitId\":\"codex\"", "\"limitId\":\"zed_limit\"")
    assertBefore("additional order preserved", snapshots, "\"limitId\":\"zed_limit\"", "\"limitId\":\"aaa_limit\"")

fn testUsagePayloadNullAdditionalLimits() =
    let payload = "{\"account_id\":\"redacted\",\"additional_rate_limits\":null,\"code_review_rate_limit\":null,\"credits\":{\"approx_cloud_messages\":null,\"approx_local_messages\":null,\"balance\":null,\"has_credits\":false,\"overage_limit_reached\":false,\"unlimited\":false},\"email\":\"redacted\",\"plan_type\":\"free\",\"promo\":null,\"rate_limit\":{\"allowed\":true,\"limit_reached\":false,\"primary_window\":{\"limit_window_seconds\":2592000,\"reset_after_seconds\":2592000,\"reset_at\":1782911984,\"used_percent\":5},\"secondary_window\":null},\"rate_limit_reached_type\":null,\"rate_limit_reset_credits\":{\"available_count\":0},\"referral_beacon\":null,\"spend_control\":{\"individual_limit\":null,\"reached\":false},\"user_id\":\"redacted\"}"
    let snapshots = rate_limit_dashboard.RustCsgRateLimitDashboardUsagePayloadToSnapshots(payload)
    assertContains("null additional maps free plan", snapshots, "\"planType\":\"free\"")
    assertContains("null additional maps primary monthly window", snapshots, "\"primary\":{\"usedPercent\":5,\"windowDurationMins\":43200,\"resetsAt\":1782911984}")
    assertContains("null additional maps secondary null", snapshots, "\"secondary\":null")
    assertNotContains("null additional emits no extra empty limit", snapshots, "\"limitId\":\"\"")

fn testManualLoginHtmlEscapesAndMatchesDeviceCodePage() =
    let html = rate_limit_dashboard.RustCsgRateLimitDashboardManualLoginHtml("alpha+demo@example.test", "https://auth.example.test/codex/device?x=1&y=2", "ABCD-EFGH")
    assertContains("manual login title", html, "<title>Manual Login</title>")
    assertContains("manual login heading", html, "Manual login for alpha+demo@example.test")
    assertContains("manual login verification link", html, "href=\"https://auth.example.test/codex/device?x=1&amp;y=2\"")
    assertContains("manual login user code", html, "<div class=\"code\">ABCD-EFGH</div>")
    assertContains("manual login copy button", html, "id=\"copy-code\"")

fn main(): int32 =
    testSnapshotReconcilesEnvOrder()
    testMissingPasswordFails()
    testRustAccountsConfigErrors()
    testMissingCacheBuildsIdleSnapshot()
    testInvalidCacheStatusFallsBackToFresh()
    testConfiguredAccountCheck()
    testRefreshFailurePreservesCachedLimitsAndWritesCache()
    testRefreshOneFailureOnlyTouchesTarget()
    testLoadingSnapshot()
    testUsagePayloadMapping()
    testUsagePayloadPreservesBackendOrderLikeRust()
    testUsagePayloadNullAdditionalLimits()
    testManualLoginHtmlEscapesAndMatchesDeviceCodePage()
    echo("rust_csg_app_server_rate_limit_dashboard_smoke ok")
    return 0
