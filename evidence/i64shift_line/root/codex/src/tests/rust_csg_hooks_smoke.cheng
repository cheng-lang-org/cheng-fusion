# Hooks smoke test — verifies type constants, variant names, helpers, glob matching.
# Production port from codex-rs/hooks/src/{lib,types,events/*}.rs

import cheng/codex/crates/hooks
import std/strings
import std/strutils as strutil

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkBool(got: bool, expected: bool, label: str): bool =
    var gotStr: str
    var expStr: str
    if got:
        gotStr = "true"
    else:
        gotStr = "false"
    if expected:
        expStr = "true"
    else:
        expStr = "false"
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expStr, " got=", gotStr], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── Existing constant tests ─────────────────────────────────────────────

fn testHookEventKeyLabel(): bool =
    var ok: bool = true
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("PreToolUse"), "pre_tool_use", "KeyLabelPreToolUse"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("PermissionRequest"), "permission_request", "KeyLabelPermissionRequest"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("PostToolUse"), "post_tool_use", "KeyLabelPostToolUse"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("PreCompact"), "pre_compact", "KeyLabelPreCompact"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("PostCompact"), "post_compact", "KeyLabelPostCompact"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("SessionStart"), "session_start", "KeyLabelSessionStart"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("UserPromptSubmit"), "user_prompt_submit", "KeyLabelUserPromptSubmit"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("Stop"), "stop", "KeyLabelStop"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventKeyLabel("Unknown"), "", "KeyLabelUnknown"): ok = false
    if ok:
        echo("testHookEventKeyLabel ok")
    return ok

fn testHookEventNames(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookEventNamesCount, 8, "HookEventNamesCount"): ok = false
    if !checkEqI32(hooks.RustCsgHookEventNamesWithMatchersCount, 6, "HookEventNamesWithMatchersCount"): ok = false
    if ok:
        echo("testHookEventNames ok")
    return ok

fn testHookResultVariants(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookResultVariantCount, 3, "HookResultVariantCount"): ok = false
    if ok:
        echo("testHookResultVariants ok")
    return ok

fn testHookResponseFields(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookResponseFieldCount, 2, "HookResponseFieldCount"): ok = false
    if ok:
        echo("testHookResponseFields ok")
    return ok

fn testHookFields(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookFieldCount, 2, "HookFieldCount"): ok = false
    if !checkEqI32(hooks.RustCsgHookMethodCount, 1, "HookMethodCount"): ok = false
    if ok:
        echo("testHookFields ok")
    return ok

fn testHookPayloadFields(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookPayloadFieldCount, 5, "HookPayloadFieldCount"): ok = false
    if ok:
        echo("testHookPayloadFields ok")
    return ok

fn testHookEventAfterAgentFields(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookEventAfterAgentFieldCount, 4, "HookEventAfterAgentFieldCount"): ok = false
    if ok:
        echo("testHookEventAfterAgentFields ok")
    return ok

fn testHookEventVariantCount(): bool =
    var ok: bool = true
    if !checkEqI32(hooks.RustCsgHookEventVariantCount(), 1, "HookEventVariantCount"): ok = false
    if !checkEqStr(hooks.RustCsgHookEventVariantAfterAgent, "AfterAgent", "HookEventAfterAgent"): ok = false
    if ok:
        echo("testHookEventVariantCount ok")
    return ok

# ── Glob matching tests ─────────────────────────────────────────────────

fn testGlobMatchExact(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "PreToolUse"), true, "GlobExactMatch"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "PostToolUse"), false, "GlobExactNoMatch"): ok = false
    if ok:
        echo("testGlobMatchExact ok")
    return ok

fn testGlobMatchWildcard(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksGlobMatch("anything", "*"), true, "GlobStarOnly"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "*ToolUse"), true, "GlobLeadingStar"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "Pre*"), true, "GlobTrailingStar"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "*Tool*"), true, "GlobBothStars"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PermissionRequest", "Permission*Request"), true, "GlobMiddleStar"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("PreToolUse", "Post*"), false, "GlobStarNoMatch"): ok = false
    if ok:
        echo("testGlobMatchWildcard ok")
    return ok

fn testGlobMatchQuestionMark(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksGlobMatch("cat", "?at"), true, "GlobQMarkMatch"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("bat", "?at"), true, "GlobQMarkMatch2"): ok = false
    if !checkBool(hooks.RustCsgHooksGlobMatch("at", "?at"), false, "GlobQMarkNoMatch"): ok = false
    if ok:
        echo("testGlobMatchQuestionMark ok")
    return ok

# ── matchHookEvent tests ────────────────────────────────────────────────

fn testMatchHookEventExact(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "PreToolUse"), true, "MatchExact"): ok = false
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "PostToolUse"), false, "MatchExactNo"): ok = false
    if ok:
        echo("testMatchHookEventExact ok")
    return ok

fn testMatchHookEventCsv(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "PostToolUse,PreToolUse"), true, "MatchCsvSecond"): ok = false
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "PostToolUse,PreCompact"), false, "MatchCsvNone"): ok = false
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "PreToolUse,PostToolUse"), true, "MatchCsvFirst"): ok = false
    if ok:
        echo("testMatchHookEventCsv ok")
    return ok

fn testMatchHookEventWildcard(): bool =
    var ok: bool = true
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "*"), true, "MatchWildcardAny"): ok = false
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("PreToolUse", "*Tool*"), true, "MatchWildcardPattern"): ok = false
    if !checkBool(hooks.RustCsgHooksMatchHookEvent("Stop", "*Top"), false, "MatchWildcardNo"): ok = false
    if ok:
        echo("testMatchHookEventWildcard ok")
    return ok

# ── New function tests ────────────────────────────────────────────────

fn testHooksFilterByEventExact(): bool =
    var ok: bool = true
    let result = hooks.hooksFilterByEvent("audit:PreToolUse,logger:PermissionRequest", "PreToolUse")
    if !checkEqStr(result, "audit", "FilterByEventExact"): ok = false
    if ok:
        echo("testHooksFilterByEventExact ok")
    return ok

fn testHooksFilterByEventWildcard(): bool =
    var ok: bool = true
    let result = hooks.hooksFilterByEvent("audit:PreToolUse,logger:*", "PostToolUse")
    if !checkEqStr(result, "logger", "FilterByEventWildcard"): ok = false
    if ok:
        echo("testHooksFilterByEventWildcard ok")
    return ok

fn testHooksFilterByEventNoMatch(): bool =
    var ok: bool = true
    let result = hooks.hooksFilterByEvent("audit:PreToolUse", "Stop")
    if !checkEqStr(result, "", "FilterByEventNoMatch"): ok = false
    if ok:
        echo("testHooksFilterByEventNoMatch ok")
    return ok

fn testHooksExecuteChainEmpty(): bool =
    var ok: bool = true
    let result = hooks.hooksExecuteChain("", "PreToolUse", "{}")
    if !checkEqStr(result, "[]", "ExecuteChainEmpty"): ok = false
    if ok:
        echo("testHooksExecuteChainEmpty ok")
    return ok

fn testHooksExecuteChainOneHook(): bool =
    var ok: bool = true
    let result = hooks.hooksExecuteChain("audit", "PreToolUse", "{}")
    if !checkEqStr(result, "[{\"hook\":\"audit\",\"result\":\"success\"}]", "ExecuteChainOne"): ok = false
    if ok:
        echo("testHooksExecuteChainOneHook ok")
    return ok

fn testHooksExecuteChainMultiple(): bool =
    var ok: bool = true
    let result = hooks.hooksExecuteChain("audit,logger,rate_limit", "PreToolUse", "{}")
    if !checkEqStr(result, "[{\"hook\":\"audit\",\"result\":\"success\"},{\"hook\":\"logger\",\"result\":\"success\"},{\"hook\":\"rate_limit\",\"result\":\"success\"}]", "ExecuteChainMulti"): ok = false
    if ok:
        echo("testHooksExecuteChainMultiple ok")
    return ok

# ── Main ────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testHookEventKeyLabel(): allOk = false
    if !testHookEventNames(): allOk = false
    if !testHookResultVariants(): allOk = false
    if !testHookResponseFields(): allOk = false
    if !testHookFields(): allOk = false
    if !testHookPayloadFields(): allOk = false
    if !testHookEventAfterAgentFields(): allOk = false
    if !testHookEventVariantCount(): allOk = false
    if !testGlobMatchExact(): allOk = false
    if !testGlobMatchWildcard(): allOk = false
    if !testGlobMatchQuestionMark(): allOk = false
    if !testMatchHookEventExact(): allOk = false
    if !testMatchHookEventCsv(): allOk = false
    if !testMatchHookEventWildcard(): allOk = false
    if !testHooksFilterByEventExact(): allOk = false
    if !testHooksFilterByEventWildcard(): allOk = false
    if !testHooksFilterByEventNoMatch(): allOk = false
    if !testHooksExecuteChainEmpty(): allOk = false
    if !testHooksExecuteChainOneHook(): allOk = false
    if !testHooksExecuteChainMultiple(): allOk = false
    if allOk:
        echo("rust_csg_hooks_smoke ok")
        return 0
    else:
        echo("rust_csg_hooks_smoke FAILED")
        return 1
