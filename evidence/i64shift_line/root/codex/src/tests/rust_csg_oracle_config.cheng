import cheng/codex/crates/config/config as cfg

fn main(): int32 =
    var pass: int32

    # parseConfigToml: empty string
    var result = cfg.parseConfigToml("")
    if result.len > 10: pass = pass + 1

    # parseConfigToml: simple key=value
    var toml1 = "[section]\nkey = \"value\"\n"
    var result1 = cfg.parseConfigToml(toml1)
    if result1.len > 10: pass = pass + 1

    # configValidateSchema: empty config with empty schema
    var configJson = "{}"
    var schemaJson = "{\"required\":[],\"optional\":[]}"
    var validateErr = cfg.configValidateSchema(configJson, schemaJson)
    if validateErr == "": pass = pass + 1

    # configValidateSchema: missing required key
    var schemaWithReq = "{\"required\":[\"name\"],\"optional\":[]}"
    var validateErr2 = cfg.configValidateSchema(configJson, schemaWithReq)
    if validateErr2.len > 0: pass = pass + 1

    if pass == 4:
        echo("rust_csg_oracle_config ok")
        return 0
    echo("oracle FAIL")
    return 1

main()