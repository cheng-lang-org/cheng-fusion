# Smoke test for production port logic:
#   - ollama: RustCsgBuildOllamaPullRequest
#   - lmstudio: RustCsgBuildLmstudioModelsRequest
#   - otel: RustCsgFormatOtelSpanContext

import std/strutils as strutil
import cheng/codex/crates/ollama/ollama
import cheng/codex/crates/lmstudio/lmstudio
import cheng/codex/crates/otel/otel

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

# ── ollama tests ───────────────────────────────────────────────────────────

fn testBuildOllamaPullRequest(): bool =
    var ok: bool = true

    # Basic model name
    let req1 = ollama.RustCsgBuildOllamaPullRequest("llama3.2:3b")
    if !checkEqStr(req1, "{\"model\":\"llama3.2:3b\",\"stream\":true}"):
        ok = false

    # Model with special characters (hyphen, dot)
    let req2 = ollama.RustCsgBuildOllamaPullRequest("deepseek-r1:70b")
    if !checkEqStr(req2, "{\"model\":\"deepseek-r1:70b\",\"stream\":true}"):
        ok = false

    # Empty model name
    let req3 = ollama.RustCsgBuildOllamaPullRequest("")
    if !checkEqStr(req3, "{\"model\":\"\",\"stream\":true}"):
        ok = false

    if ok:
        echo("testBuildOllamaPullRequest ok")
    return ok

# ── lmstudio tests ─────────────────────────────────────────────────────────

fn testBuildLmstudioModelsRequest(): bool =
    var ok: bool = true

    let path = lmstudio.RustCsgBuildLmstudioModelsRequest()
    if !checkEqStr(path, "/v1/models"):
        ok = false

    if ok:
        echo("testBuildLmstudioModelsRequest ok")
    return ok

# ── otel tests ─────────────────────────────────────────────────────────────

fn testFormatOtelSpanContext(): bool =
    var ok: bool = true

    # Standard 32-char hex trace ID, 16-char hex span ID
    let ctx1 = otel.RustCsgFormatOtelSpanContext(
        "0af7651916cd43dd8448eb211c80319c",
        "b7ad6b7169203331"
    )
    if !checkEqStr(ctx1, "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01"):
        ok = false

    # All zeros (edge case)
    let ctx2 = otel.RustCsgFormatOtelSpanContext(
        "00000000000000000000000000000000",
        "0000000000000000"
    )
    if !checkEqStr(ctx2, "00-00000000000000000000000000000000-0000000000000000-01"):
        ok = false

    # Short IDs (unusual but should still format correctly)
    let ctx3 = otel.RustCsgFormatOtelSpanContext("abc", "123")
    if !checkEqStr(ctx3, "00-abc-123-01"):
        ok = false

    if ok:
        echo("testFormatOtelSpanContext ok")
    return ok

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testBuildOllamaPullRequest(): allOk = false
    if !testBuildLmstudioModelsRequest(): allOk = false
    if !testFormatOtelSpanContext(): allOk = false

    if allOk:
        echo("rust_csg_production_ports_smoke ok")
        return 0
    else:
        echo("rust_csg_production_ports_smoke FAILED")
        return 1
