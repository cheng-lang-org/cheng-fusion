fn testPatchApprovalTypes(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgPatchApprovalElicitRequestParamsFieldCount, 3, "PatchApprovalElicitRequestParamsFieldCount"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgPatchApprovalResponseFieldCount, 2, "PatchApprovalResponseFieldCount"):
        ok = false
    if ok:
        echo("testPatchApprovalTypes ok")
    return ok

# ── ParseMcpToolName tests ──────────────────────────────────────────────────

fn testParseMcpToolName(): bool =
    var ok: bool = true
    var server: str
    var tool: str

    # Normal case: "server/tool"
    if !checkBool("parse_normal", mcp_server.RustCsgParseMcpToolName("filesystem/read", server, tool), true):
        ok = false
    else:
        if !checkEqStr(server, "filesystem", "parse_normal_server"):
            ok = false
        if !checkEqStr(tool, "read", "parse_normal_tool"):
            ok = false

    # Multiple slashes: splits on first
    if !checkBool("parse_multi_slash", mcp_server.RustCsgParseMcpToolName("a/b/c", server, tool), true):
        ok = false
    else:
        if !checkEqStr(server, "a", "parse_multi_slash_server"):
            ok = false
        if !checkEqStr(tool, "b/c", "parse_multi_slash_tool"):
            ok = false

    # No slash: returns false
    if !checkBool("parse_no_slash", mcp_server.RustCsgParseMcpToolName("no-slash-here", server, tool), false):
        ok = false

    # Empty string: returns false
    if !checkBool("parse_empty", mcp_server.RustCsgParseMcpToolName("", server, tool), false):
        ok = false

    # Leading slash: "/tool" gives server="", tool="tool"
    if !checkBool("parse_leading_slash", mcp_server.RustCsgParseMcpToolName("/tool", server, tool), true):
        ok = false
    else:
        if !checkEqStr(server, "", "parse_leading_slash_server"):
            ok = false
        if !checkEqStr(tool, "tool", "parse_leading_slash_tool"):
            ok = false

    # Trailing slash: "server/" gives server="server", tool=""
    if !checkBool("parse_trailing_slash", mcp_server.RustCsgParseMcpToolName("server/", server, tool), true):
        ok = false
    else:
        if !checkEqStr(server, "server", "parse_trailing_slash_server"):
            ok = false
        if !checkEqStr(tool, "", "parse_trailing_slash_tool"):
            ok = false

    if ok:
        echo("testParseMcpToolName ok")
    return ok

# ── Enum constant tests ─────────────────────────────────────────────────────

fn testEnumConstants(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgApprovalPolicyUntrusted, 0, "ApprovalPolicyUntrusted"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgApprovalPolicyOnFailure, 1, "ApprovalPolicyOnFailure"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgApprovalPolicyOnRequest, 2, "ApprovalPolicyOnRequest"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgApprovalPolicyNever, 3, "ApprovalPolicyNever"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgApprovalPolicyNone, -1, "ApprovalPolicyNone"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgSandboxModeReadOnly, 0, "SandboxModeReadOnly"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgSandboxModeWorkspaceWrite, 1, "SandboxModeWorkspaceWrite"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgSandboxModeDangerFullAccess, 2, "SandboxModeDangerFullAccess"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgSandboxModeNone, -1, "SandboxModeNone"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgReviewDecisionApproved, 0, "ReviewDecisionApproved"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgReviewDecisionDenied, 1, "ReviewDecisionDenied"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgReviewDecisionNone, -1, "ReviewDecisionNone"):
        ok = false
    if ok:
        echo("testEnumConstants ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testConstants():
        allOk = false
    if !testCodexToolCallParam():
        allOk = false
    if !testCodexToolCallApprovalPolicy():
        allOk = false
    if !testCodexToolCallSandboxMode():
        allOk = false
    if !testCodexToolCallReplyParam():
        allOk = false
    if !testExecApprovalTypes():
        allOk = false
    if !testPatchApprovalTypes():
        allOk = false
    if !testParseMcpToolName():
        allOk = false
    if !testEnumConstants():
        allOk = false
    if allOk:
        echo("rust_csg_mcp_server_smoke ok")
        return 0
    else:
        echo("rust_csg_mcp_server_smoke FAILED")
        return 1
