# MCP Server smoke test — verifies type definitions for the codex MCP server.
# Ported from codex-rs/mcp-server/src/{lib,codex_tool_config,exec_approval,patch_approval}.rs

import cheng/codex/crates/mcp_server/mcp_server as mcp_server
import std/strings
import std/strutils as strutil

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkBool(label: str, got: bool, expected: bool): bool =
    if got != expected:
        var gotS: str
        var expS: str
        if got:
            gotS = "true"
        else:
            gotS = "false"
        if expected:
            expS = "true"
        else:
            expS = "false"
        echo(strutil.Join([label, " FAIL: expected=", expS, " got=", gotS], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testConstants(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgMcpServerChannelCapacity, 128, "ChannelCapacity"):
        ok = false
    if !checkEqStr(mcp_server.RustCsgMcpServerOtelServiceName, "codex_mcp_server", "OtelServiceName"):
        ok = false
    if ok:
        echo("testConstants ok")
    return ok

fn testCodexToolCallParam(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgCodexToolCallParamFieldCount, 10, "CodexToolCallParamFieldCount"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgCodexToolCallParamMethodCount, 1, "CodexToolCallParamMethodCount"):
        ok = false
    if ok:
        echo("testCodexToolCallParam ok")
    return ok

fn testCodexToolCallApprovalPolicy(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgCodexToolCallApprovalPolicyVariantCount, 4, "ApprovalPolicyVariantCount"):
        ok = false
    if ok:
        echo("testCodexToolCallApprovalPolicy ok")
    return ok

fn testCodexToolCallSandboxMode(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgCodexToolCallSandboxModeVariantCount, 3, "SandboxModeVariantCount"):
        ok = false
    if ok:
        echo("testCodexToolCallSandboxMode ok")
    return ok

fn testCodexToolCallReplyParam(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgCodexToolCallReplyParamFieldCount, 3, "CodexToolCallReplyParamFieldCount"):
        ok = false
    if ok:
        echo("testCodexToolCallReplyParam ok")
    return ok

fn testExecApprovalTypes(): bool =
    var ok: bool = true
    if !checkEqI32(mcp_server.RustCsgExecApprovalElicitRequestParamsFieldCount, 5, "ExecApprovalElicitRequestParamsFieldCount"):
        ok = false
    if !checkEqI32(mcp_server.RustCsgExecApprovalResponseFieldCount, 2, "ExecApprovalResponseFieldCount"):
        ok = false
    if ok:
        echo("testExecApprovalTypes ok")
