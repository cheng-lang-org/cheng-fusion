import std/strings
import std/strutils as strutil

# Inlined library: approval_presets
# NOTE: struct field access on array elements is broken in direct Mach-O mode.
# Using parallel arrays instead.

fn builtinApprovalPresetIds(): str[] =
    var out: str[]
    add(out, "read-only")
    add(out, "auto")
    add(out, "full-access")
    return out

fn builtinApprovalPresetLabels(): str[] =
    var out: str[]
    add(out, "Read Only")
    add(out, "Default")
    add(out, "Full Access")
    return out

fn builtinApprovalPresetApprovals(): str[] =
    var out: str[]
    add(out, "OnRequest")
    add(out, "OnRequest")
    add(out, "Never")
    return out

fn builtinApprovalPresetProfileIds(): str[] =
    var out: str[]
    add(out, "read-only")
    add(out, "workspace")
    add(out, "danger-full-access")
    return out

fn builtinApprovalPresetPermissionProfiles(): str[] =
    var out: str[]
    add(out, "read_only")
    add(out, "workspace_write")
    add(out, "disabled")
    return out

fn builtinPermissionProfileForActivePermissionProfile(
    id: str,
    hasExtends: bool,
    outProfile: var str,
    outOk: var bool
) =
    outProfile = ""
    outOk = false
    if hasExtends:
        return
    if id == "read-only":
        outProfile = "read_only"
        outOk = true
    else:
        if id == "workspace":
            outProfile = "workspace_write"
            outOk = true
        else:
            if id == "danger-full-access":
                outProfile = "disabled"
                outOk = true

# Tests
fn checkEq(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

fn checkNe(got: str): bool =
    if got == "":
        echo("FAIL: expected non-empty string, got empty")
        return false
    return true

fn testBuiltinPresetsCount(): bool =
    let ids = builtinApprovalPresetIds()
    let labels = builtinApprovalPresetLabels()
    if ids.len != 3:
        return false
    if labels.len != 3:
        return false
    echo("testBuiltinPresetsCount ok")
    return true

fn testBuiltinPresetsNonEmpty(): bool =
    var ok: bool = true
    let ids = builtinApprovalPresetIds()
    let labels = builtinApprovalPresetLabels()
    for i in 0..<ids.len:
        if !checkNe(ids[i]): ok = false
        if !checkNe(labels[i]): ok = false
    if ok:
        echo("testBuiltinPresetsNonEmpty ok")
    return ok

fn testProfileForKnownId(): bool =
    var ok: bool = true
    var profile: str
    var outOk: bool

    builtinPermissionProfileForActivePermissionProfile("read-only", false, profile, outOk)
    if !checkEqBool(outOk, true): ok = false
    if ok:
        if !checkEq(profile, "read_only"): ok = false

    builtinPermissionProfileForActivePermissionProfile("workspace", false, profile, outOk)
    if !checkEqBool(outOk, true): ok = false
    if ok:
        if !checkEq(profile, "workspace_write"): ok = false

    builtinPermissionProfileForActivePermissionProfile("danger-full-access", false, profile, outOk)
    if !checkEqBool(outOk, true): ok = false
    if ok:
        if !checkEq(profile, "disabled"): ok = false

    if ok:
        echo("testProfileForKnownId ok")
    return ok

fn testProfileForUnknownId(): bool =
    var profile: str
    var outOk: bool
    builtinPermissionProfileForActivePermissionProfile("unknown", false, profile, outOk)
    if !checkEqBool(outOk, false):
        return false
    echo("testProfileForUnknownId ok")
    return true

fn testProfileWithExtends(): bool =
    var profile: str
    var outOk: bool
    builtinPermissionProfileForActivePermissionProfile("read-only", true, profile, outOk)
    if !checkEqBool(outOk, false):
        return false
    echo("testProfileWithExtends ok")
    return true

# Test: all parallel arrays have the same length
fn testParallelArraysConsistentLength(): bool =
    var ok: bool = true
    let ids = builtinApprovalPresetIds()
    let labels = builtinApprovalPresetLabels()
    let approvals = builtinApprovalPresetApprovals()
    let profileIds = builtinApprovalPresetProfileIds()
    let profiles = builtinApprovalPresetPermissionProfiles()
    let n = ids.len
    if labels.len != n:
        echo("FAIL: labels len mismatch")
        ok = false
    if approvals.len != n:
        echo("FAIL: approvals len mismatch")
        ok = false
    if profileIds.len != n:
        echo("FAIL: profileIds len mismatch")
        ok = false
    if profiles.len != n:
        echo("FAIL: profiles len mismatch")
        ok = false
    if ok:
        echo("testParallelArraysConsistentLength ok")
    return ok

# Test: all approvals are valid values ("OnRequest" or "Never")
fn testApprovalValuesValid(): bool =
    var ok: bool = true
    let approvals = builtinApprovalPresetApprovals()
    for i in 0..<approvals.len:
        let v = approvals[i]
        if v != "OnRequest" && v != "Never":
            echo(strutil.Join(["FAIL: invalid approval value at ", strings.Int64ToStr(int64(i))], ""))
            ok = false
    if ok:
        echo("testApprovalValuesValid ok")
    return ok

# Test: all preset IDs are non-empty and contain no spaces
fn testPresetIdsWellFormed(): bool =
    var ok: bool = true
    let ids = builtinApprovalPresetIds()
    for i in 0..<ids.len:
        let id = ids[i]
        if id == "":
            echo(strutil.Join(["FAIL: empty id at ", strings.Int64ToStr(int64(i))], ""))
            ok = false
        # Check no spaces in id
        var j: int32 = 0
        while j < id.len:
            if id[j] == ' ':
                echo(strutil.Join(["FAIL: space in id at ", strings.Int64ToStr(int64(i))], ""))
                ok = false
            j = j + 1
    if ok:
        echo("testPresetIdsWellFormed ok")
    return ok

# Test: profileForActivePermissionProfile with empty id returns false
fn testProfileForEmptyId(): bool =
    var profile: str
    var outOk: bool
    builtinPermissionProfileForActivePermissionProfile("", false, profile, outOk)
    if !checkEqBool(outOk, false):
        return false
    echo("testProfileForEmptyId ok")
    return true

# Test: profileIds match expected values
fn testProfileIdsMatch(): bool =
    var ok: bool = true
    let profileIds = builtinApprovalPresetProfileIds()
    if !checkEq(profileIds[0], "read-only"): ok = false
    if !checkEq(profileIds[1], "workspace"): ok = false
    if !checkEq(profileIds[2], "danger-full-access"): ok = false
    if ok:
        echo("testProfileIdsMatch ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testBuiltinPresetsCount(): allOk = false
    if !testBuiltinPresetsNonEmpty(): allOk = false
    if !testProfileForKnownId(): allOk = false
    if !testProfileForUnknownId(): allOk = false
    if !testProfileWithExtends(): allOk = false
    if !testParallelArraysConsistentLength(): allOk = false
    if !testApprovalValuesValid(): allOk = false
    if !testPresetIdsWellFormed(): allOk = false
    if !testProfileForEmptyId(): allOk = false
    if !testProfileIdsMatch(): allOk = false
    if allOk:
        echo("rust_csg_approval_presets_smoke ok")
        return 0
    else:
        echo("rust_csg_approval_presets_smoke FAILED")
        return 1
