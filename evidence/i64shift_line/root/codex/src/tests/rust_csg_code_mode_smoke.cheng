import std/strings
import std/strutils as strutil
import cheng/codex/crates/code_mode/code_mode as cm

# ═══════════════════════════════════════════════════════════════════════════════
# code-mode: REAL production-level smoke tests
# Tests identifier normalization, exec tool description building, and pragma parsing.
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=[", expected, "] got=[", got, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkContains(haystack: str, needle: str, label: str): bool =
    if !strutil.Contains(haystack, needle):
        echo(strutil.Join([label, " FAIL: does not contain [", needle, "]"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── normalizeCodeModeIdentifier tests ────────────────────────────────────

fn testNormalizeSimple(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("foo"), "foo", "NormalizeSimple"): ok = false
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("foo_bar"), "foo_bar", "NormalizeUnderscore"): ok = false
    return ok

fn testNormalizeDashes(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("hidden-dynamic-tool"), "hidden_dynamic_tool", "NormalizeDashes"): ok = false
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("mcp__ologs__get-profile"), "mcp__ologs__get_profile", "NormalizeMixed"): ok = false
    return ok

fn testNormalizeSpecialChars(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("foo.bar.baz"), "foo_bar_baz", "NormalizeDots"): ok = false
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("foo@bar"), "foo_bar", "NormalizeAt"): ok = false
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("foo bar"), "foo_bar", "NormalizeSpace"): ok = false
    return ok

fn testNormalizeLeadingDigit(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("123foo"), "_23foo", "NormalizeLeadingDigit"): ok = false
    return ok

fn testNormalizeDollarUnderscore(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("$foo"), "$foo", "NormalizeDollar"): ok = false
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier("_private"), "_private", "NormalizeUnderscorePrefix"): ok = false
    return ok

fn testNormalizeEmpty(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeNormalizeIdentifier(""), "_", "NormalizeEmpty"): ok = false
    return ok

# ── buildExecToolDescription tests ──────────────────────────────────────

fn testBuildDescNonCodeMode(): bool =
    var ok: bool = true
    let desc = cm.RustCsgCodeModeBuildExecToolDescription("", "", false, false)
    if !checkContains(desc, "Run JavaScript code", "BuildDescNonCodeMode"): ok = false
    if !checkContains(desc, "fresh V8 isolate", "BuildDescNonCodeModeV8"): ok = false
    return ok

fn testBuildDescWithDeferredTools(): bool =
    var ok: bool = true
    let desc = cm.RustCsgCodeModeBuildExecToolDescription("", "", false, true)
    if !checkContains(desc, "Some nested MCP/app tools may be omitted", "BuildDescDeferred"): ok = false
    return ok

fn testBuildDescCodeModeWithTools(): bool =
    var ok: bool = true
    let desc = cm.RustCsgCodeModeBuildExecToolDescription("foo,bar", "", true, false)
    if !checkContains(desc, "### `foo`", "BuildDescToolFoo"): ok = false
    if !checkContains(desc, "### `bar`", "BuildDescToolBar"): ok = false
    return ok

fn testBuildDescCodeModeWithHyphenTools(): bool =
    var ok: bool = true
    let desc = cm.RustCsgCodeModeBuildExecToolDescription("my-tool,another-tool", "", true, false)
    if !checkContains(desc, "### `my_tool` (`my-tool`)", "BuildDescHyphenTool"): ok = false
    if !checkContains(desc, "### `another_tool` (`another-tool`)", "BuildDescHyphenTool2"): ok = false
    return ok

# ── parseCodeBlock tests ─────────────────────────────────────────────────

fn testParseCodeBlockSimple(): bool =
    var ok: bool = true
    let md: str = "text\n```\ncode\n```\nmore"
    let blocks = cm.RustCsgCodeModeParseCodeBlock(md)
    if blocks.len != 1:
        echo(strutil.Join(["FAIL ParseCodeBlockSimple: expected 1 block, got ", strings.IntToStr(blocks.len)], ""))
        ok = false
    else:
        if !checkEqStr(blocks[0].language, "", "ParseCodeBlockSimpleLang"): ok = false
        if !checkEqStr(blocks[0].content, "code", "ParseCodeBlockSimpleContent"): ok = false
    if ok:
        echo("testParseCodeBlockSimple ok")
    return ok

fn testParseCodeBlockWithLang(): bool =
    var ok: bool = true
    let md: str = "```python\nprint(\"hello\")\n```"
    let blocks = cm.RustCsgCodeModeParseCodeBlock(md)
    if blocks.len != 1:
        echo(strutil.Join(["FAIL ParseCodeBlockWithLang: expected 1 block, got ", strings.IntToStr(blocks.len)], ""))
        ok = false
    else:
        if !checkEqStr(blocks[0].language, "python", "ParseCodeBlockWithLangLang"): ok = false
        if !checkEqStr(blocks[0].content, "print(\"hello\")", "ParseCodeBlockWithLangContent"): ok = false
    if ok:
        echo("testParseCodeBlockWithLang ok")
    return ok

fn testParseCodeBlockMultiple(): bool =
    var ok: bool = true
    let md: str = "```rust\nfn main() {}\n```\ntext\n```js\nconsole.log(1)\n```"
    let blocks = cm.RustCsgCodeModeParseCodeBlock(md)
    if blocks.len != 2:
        echo(strutil.Join(["FAIL ParseCodeBlockMultiple: expected 2 blocks, got ", strings.IntToStr(blocks.len)], ""))
        ok = false
    else:
        if !checkEqStr(blocks[0].language, "rust", "ParseCodeBlockMultipleLang0"): ok = false
        if !checkEqStr(blocks[1].language, "js", "ParseCodeBlockMultipleLang1"): ok = false
    if ok:
        echo("testParseCodeBlockMultiple ok")
    return ok

fn testParseCodeBlockEmpty(): bool =
    var ok: bool = true
    let blocks = cm.RustCsgCodeModeParseCodeBlock("")
    if blocks.len != 0:
        echo(strutil.Join(["FAIL ParseCodeBlockEmpty: expected 0 blocks, got ", strings.IntToStr(blocks.len)], ""))
        ok = false
    if ok:
        echo("testParseCodeBlockEmpty ok")
    return ok

fn testParseCodeBlockNoFences(): bool =
    var ok: bool = true
    let blocks = cm.RustCsgCodeModeParseCodeBlock("just plain text\nno fences here")
    if blocks.len != 0:
        echo(strutil.Join(["FAIL ParseCodeBlockNoFences: expected 0 blocks, got ", strings.IntToStr(blocks.len)], ""))
        ok = false
    if ok:
        echo("testParseCodeBlockNoFences ok")
    return ok

# ── detectLanguage tests ───────────────────────────────────────────────────

fn testDetectLanguage(): bool =
    var ok: bool = true
    # Shebang detection
    let langSh = cm.RustCsgCodeModeDetectLanguage("#!/bin/sh\necho hello")
    if !checkEqStr(langSh, "sh", "detectShebangSh"):
        ok = false
    let langNode = cm.RustCsgCodeModeDetectLanguage("#!/usr/bin/env node\nconsole.log(1)")
    if !checkEqStr(langNode, "node", "detectShebangEnvNode"):
        ok = false
    let langPython = cm.RustCsgCodeModeDetectLanguage("#!/usr/bin/python3\nprint(1)")
    if !checkEqStr(langPython, "python3", "detectShebangPython"):
        ok = false
    # No shebang — empty
    let langEmpty = cm.RustCsgCodeModeDetectLanguage("")
    if !checkEqStr(langEmpty, "", "detectEmpty"):
        ok = false
    let langNoMatch = cm.RustCsgCodeModeDetectLanguage("just some text")
    if !checkEqStr(langNoMatch, "", "detectNoMatch"):
        ok = false
    if ok:
        echo("testDetectLanguage ok")
    return ok

# ── formatOutput tests ─────────────────────────────────────────────────────

fn testFormatOutput(): bool =
    var ok: bool = true
    if !checkEqStr(cm.RustCsgCodeModeFormatOutput("hello world"), "```\nhello world\n```\n", "formatOutputBasic"):
        ok = false
    if !checkEqStr(cm.RustCsgCodeModeFormatOutput(""), "No output.", "formatOutputEmpty"):
        ok = false
    if ok:
        echo("testFormatOutput ok")
    return ok

# ── Main ───────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testNormalizeSimple(): allOk = false
    if !testNormalizeDashes(): allOk = false
    if !testNormalizeSpecialChars(): allOk = false
    if !testNormalizeLeadingDigit(): allOk = false
    if !testNormalizeDollarUnderscore(): allOk = false
    if !testNormalizeEmpty(): allOk = false
    if !testBuildDescNonCodeMode(): allOk = false
    if !testBuildDescWithDeferredTools(): allOk = false
    if !testBuildDescCodeModeWithTools(): allOk = false
    if !testBuildDescCodeModeWithHyphenTools(): allOk = false
    if !testParseCodeBlockSimple(): allOk = false
    if !testParseCodeBlockWithLang(): allOk = false
    if !testParseCodeBlockMultiple(): allOk = false
    if !testParseCodeBlockEmpty(): allOk = false
    if !testParseCodeBlockNoFences(): allOk = false
    if !testDetectLanguage(): allOk = false
    if !testFormatOutput(): allOk = false
    if allOk:
        echo("rust_csg_code_mode_smoke ok")
        return 0
    else:
        echo("rust_csg_code_mode_smoke FAILED")
        return 1
