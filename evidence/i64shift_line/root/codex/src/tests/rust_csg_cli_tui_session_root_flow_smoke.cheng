import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/cli/tui_session_command as cli_tui
import cheng/codex/cli/tui_session_runtime as cli_runtime
import cheng/codex/protocol/wire

fn SourceThreadId(): str =
    return "11111111-1111-4111-8111-111111111111"

fn SecondThreadId(): str =
    return "22222222-2222-4222-8222-222222222222"

fn Esc(): str =
    return strings.CharToStr(Char(27))

fn DownEnter(): str =
    return strutil.Join([Esc(), "[B|\n"], "")

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckEqInt32(actual: int32, expected: int32, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", strings.IntToStr(expected), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckMinInt32(actual: int32, minimum: int32, label: str): int32 =
    if actual >= minimum:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected at least ", strings.IntToStr(minimum), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn CheckRuntimeOk(result: var cli_runtime.RustCsgCliTuiSessionRuntimeResult, label: str): int32 =
    if result.ok:
        return 0
    echo(strutil.Join(["FAIL ", label, ": ", result.error], ""))
    return 1

fn Args2(command: str): str[] =
    var args: str[]
    add(args, "codex")
    add(args, command)
    return args

fn Args3(command: str, arg2: str): str[] =
    var args = Args2(command)
    add(args, arg2)
    return args

fn FillRuntimeConfig(config: var cli_runtime.RustCsgCliTuiSessionRuntimeConfig,
                     dbPath: str,
                     codexHome: str,
                     currentCwd: str,
                     requestIdJson: str) =
    config = cli_runtime.RustCsgCliTuiSessionRuntimeDefaultConfig()
    config.dbPath = dbPath
    config.codexHomePath = codexHome
    config.currentCwd = currentCwd
    config.currentConfigJson = "{\"model\":\"current-config-model\",\"modelProvider\":\"current-config-provider\",\"approvalPolicy\":\"on-request\",\"approvalsReviewer\":\"user\"}"
    config.requestIdJson = requestIdJson
    config.model = "gpt-5"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(currentCwd), "]")
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.permissionsJson = "\":workspace\""
    config.configJson = "{\"model_reasoning_effort\":\"medium\"}"
    config.baseInstructions = "base"
    config.developerInstructions = "dev"
    config.permissionProfileJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.personalityJson = "\"test-personality\""
    config.messageHistoryLogId = int64(42)
    config.messageHistoryEntryCount = 3
    config.appTermWidth = 96
    config.appTermHeight = 20
    config.pickerLimit = 10
    config.pickerWidth = 96
    config.pickerListHeight = 12
    config.pickerViewRows = 8
    config.cwdPromptWidth = 192
    config.nowMs = int64(1770007200000)

fn main(): int32 =
    if cmdline.argCount() < 6:
        echo("FAIL usage: rust_csg_cli_tui_session_root_flow_smoke <state-db> <codex-home> <current-cwd> <session-cwd> <rollout-path>")
        return 1

    let dbPath = cmdline.argStr(1)
    let codexHome = cmdline.argStr(2)
    let currentCwd = cmdline.argStr(3)
    let sessionCwd = cmdline.argStr(4)
    let rolloutPath = cmdline.argStr(5)
    let threadId = SourceThreadId()
    let secondThreadId = SecondThreadId()
    var failures: int32

    var resumeArgs = Args2("resume")
    var resumePlan = cli_tui.RustCsgCliTuiSessionCommandParse(resumeArgs, "resume")
    failures = failures + CheckEqBool(resumePlan.ok, true, "resume parse ok")
    failures = failures + CheckEqStr(resumePlan.action, "resume", "resume action")
    failures = failures + CheckEqStr(resumePlan.sessionId, "", "resume no session id")

    var resumeConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(resumeConfig, dbPath, codexHome, currentCwd, "201")
    let resumeResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(resumeArgs,
                                                                       "resume",
                                                                       resumeConfig,
                                                                       "\n",
                                                                       "2")
    failures = failures + CheckRuntimeOk(resumeResult, "resume root ok")
    failures = failures + CheckEqStr(resumeResult.outcome, "app_ready", "resume root outcome")
    failures = failures + CheckContains(resumeResult.flowJson, "\"pickerSelectionKind\":\"resume\"", "resume picker kind")
    failures = failures + CheckContains(resumeResult.flowJson, wire.RustCsgCat3("\"pickerThreadId\":", wire.RustCsgJsonQuote(threadId), ""), "resume picker thread")
    failures = failures + CheckContains(resumeResult.flowJson, "\"cwdPromptSelection\":\"current\"", "resume cwd selection")
    failures = failures + CheckContains(resumeResult.rootJson, "\"method\":\"thread/resume\"", "resume root method")
    failures = failures + CheckContains(resumeResult.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(currentCwd), ""), "resume root cwd")
    failures = failures + CheckContains(resumeResult.rootJson, wire.RustCsgCat3("\"historyCwd\":", wire.RustCsgJsonQuote(sessionCwd), ""), "resume root history cwd")
    failures = failures + CheckContains(resumeResult.appFirstFrameText, "resume hello", "resume app frame")
    failures = failures + CheckContains(resumeResult.flowJson, "\"pickerFrameCount\":1", "resume picker frames")

    var forkArgs = Args2("fork")
    var forkPlan = cli_tui.RustCsgCliTuiSessionCommandParse(forkArgs, "fork")
    failures = failures + CheckEqBool(forkPlan.ok, true, "fork parse ok")
    failures = failures + CheckEqStr(forkPlan.action, "fork", "fork action")

    var forkConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(forkConfig, dbPath, codexHome, currentCwd, "202")
    let forkResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(forkArgs,
                                                                     "fork",
                                                                     forkConfig,
                                                                     DownEnter(),
                                                                     "")
    failures = failures + CheckRuntimeOk(forkResult, "fork root ok")
    failures = failures + CheckEqStr(forkResult.outcome, "app_ready", "fork root outcome")
    failures = failures + CheckContains(forkResult.flowJson, "\"pickerSelectionKind\":\"fork\"", "fork picker kind")
    failures = failures + CheckContains(forkResult.flowJson, wire.RustCsgCat3("\"pickerThreadId\":", wire.RustCsgJsonQuote(secondThreadId), ""), "fork picker thread")
    failures = failures + CheckContains(forkResult.flowJson, "\"cwdPromptOutcome\":null", "fork no cwd prompt")
    failures = failures + CheckContains(forkResult.rootJson, "\"method\":\"thread/fork\"", "fork root method")
    failures = failures + CheckContains(forkResult.appFirstFrameText, "second hello", "fork app frame")
    failures = failures + CheckContains(forkResult.flowJson, "\"pickerFrameCount\":2", "fork picker frames")

    var richArgs = Args2("resume")
    add(richArgs, "--last")
    add(richArgs, "--all")
    add(richArgs, "--include-non-interactive")
    add(richArgs, "--model")
    add(richArgs, "gpt-5.1")
    add(richArgs, "--cwd")
    add(richArgs, currentCwd)
    add(richArgs, "--profile")
    add(richArgs, "work")
    add(richArgs, "--config")
    add(richArgs, "model_reasoning_effort=high")
    add(richArgs, "--color")
    add(richArgs, "always")
    add(richArgs, "--ask-for-approval")
    add(richArgs, "never")
    add(richArgs, "--json")
    add(richArgs, "--experimental-json")
    add(richArgs, "--search")
    add(richArgs, "--no-alt-screen")
    add(richArgs, "--skip-git-repo-check")
    let richPlan = cli_tui.RustCsgCliTuiSessionCommandParse(richArgs, "resume")
    failures = failures + CheckEqBool(richPlan.ok, true, "rich parse ok")
    failures = failures + CheckEqBool(richPlan.last, true, "rich last")
    failures = failures + CheckEqBool(richPlan.all, true, "rich all")
    failures = failures + CheckEqBool(richPlan.includeNonInteractive, true, "rich include")
    failures = failures + CheckEqStr(richPlan.model, "gpt-5.1", "rich model")
    failures = failures + CheckEqStr(richPlan.cwd, currentCwd, "rich cwd")
    failures = failures + CheckEqStr(richPlan.profile, "work", "rich profile")
    failures = failures + CheckEqStr(richPlan.color, "always", "rich color")
    failures = failures + CheckEqStr(richPlan.askForApproval, "never", "rich approval")
    failures = failures + CheckEqBool(richPlan.json, true, "rich json")
    failures = failures + CheckEqBool(richPlan.experimentalJson, true, "rich experimental json")
    failures = failures + CheckEqBool(richPlan.search, true, "rich search")
    failures = failures + CheckEqBool(richPlan.noAltScreen, true, "rich no alt")
    failures = failures + CheckEqBool(richPlan.skipGitRepoCheck, true, "rich skip git")
    failures = failures + CheckEqInt32(richPlan.configOverrides.len, 1, "rich config count")
    if richPlan.configOverrides.len > 0:
        failures = failures + CheckEqStr(richPlan.configOverrides[0], "model_reasoning_effort=high", "rich config value")

    var explicitArgs = Args3("resume", threadId)
    let explicitPlan = cli_tui.RustCsgCliTuiSessionCommandParse(explicitArgs, "resume")
    failures = failures + CheckEqBool(explicitPlan.ok, true, "explicit parse ok")
    failures = failures + CheckEqStr(explicitPlan.sessionId, threadId, "explicit session")

    var explicitConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(explicitConfig, dbPath, codexHome, currentCwd, "203")
    explicitConfig.explicitPromptChoice = "current"
    let explicitResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(explicitArgs,
                                                                         "resume",
                                                                         explicitConfig,
                                                                         "",
                                                                         "")
    failures = failures + CheckRuntimeOk(explicitResult, "explicit root ok")
    failures = failures + CheckEqStr(explicitResult.outcome, "app_ready", "explicit root outcome")
    failures = failures + CheckEqStr(explicitResult.action, "resume", "explicit root kind")
    failures = failures + CheckEqStr(explicitResult.sessionId, threadId, "explicit root thread")
    failures = failures + CheckContains(explicitResult.rootJson, wire.RustCsgCat3("\"threadId\":", wire.RustCsgJsonQuote(threadId), ""), "explicit root thread json")
    failures = failures + CheckContains(explicitResult.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(currentCwd), ""), "explicit root cwd")
    failures = failures + CheckContains(explicitResult.rootJson, wire.RustCsgCat3("\"historyCwd\":", wire.RustCsgJsonQuote(sessionCwd), ""), "explicit root history cwd")
    failures = failures + CheckContains(explicitResult.rootJson, "\"method\":\"thread/resume\"", "explicit handoff method")
    failures = failures + CheckContains(explicitResult.rootJson, "\"runtimeWorkspaceRoots\"", "explicit handoff roots")
    failures = failures + CheckContains(explicitResult.appFirstFrameText, "resume hello", "explicit app frame")

    var overrideArgs = Args3("resume", threadId)
    add(overrideArgs, "--model")
    add(overrideArgs, "gpt-5.1")
    add(overrideArgs, "--cwd")
    add(overrideArgs, currentCwd)
    add(overrideArgs, "--ask-for-approval")
    add(overrideArgs, "never")
    var overrideConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(overrideConfig, dbPath, codexHome, currentCwd, "204")
    overrideConfig.explicitPromptChoice = "current"
    let overrideResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(overrideArgs,
                                                                         "resume",
                                                                         overrideConfig,
                                                                         "",
                                                                         "")
    failures = failures + CheckRuntimeOk(overrideResult, "override root ok")
    failures = failures + CheckContains(overrideResult.rootJson, "\"model\":\"gpt-5.1\"", "override model")
    failures = failures + CheckContains(overrideResult.rootJson, "\"approvalPolicy\":\"never\"", "override approval")

    var yoloArgs = Args3("resume", secondThreadId)
    add(yoloArgs, "--yolo")
    var yoloConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(yoloConfig, dbPath, codexHome, currentCwd, "205")
    let yoloResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(yoloArgs,
                                                                     "resume",
                                                                     yoloConfig,
                                                                     "",
                                                                     "")
    failures = failures + CheckRuntimeOk(yoloResult, "yolo root ok")
    failures = failures + CheckContains(yoloResult.rootJson, "\"permissions\":\":danger-full-access\"", "yolo permissions")
    failures = failures + CheckContains(yoloResult.rootJson, "\"activePermissionProfile\":{\"id\":\":danger-full-access\"}", "yolo active profile")

    var envArgs = Args3("resume", secondThreadId)
    add(envArgs, "--cwd")
    add(envArgs, currentCwd)
    add(envArgs, "--model")
    add(envArgs, "env-run-model")
    let envResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgsFromEnvironment(envArgs,
                                                                                   "resume",
                                                                                   "",
                                                                                   "")
    failures = failures + CheckRuntimeOk(envResult, "env root ok")
    failures = failures + CheckEqStr(envResult.outcome, "app_ready", "env root outcome")
    failures = failures + CheckContains(envResult.rootJson, "\"model\":\"env-run-model\"", "env model")
    failures = failures + CheckContains(envResult.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(currentCwd), ""), "env cwd")

    var configOverrideArgs = Args2("resume")
    add(configOverrideArgs, "--config")
    add(configOverrideArgs, "model_reasoning_effort=high")
    var configOverrideConfig: cli_runtime.RustCsgCliTuiSessionRuntimeConfig
    FillRuntimeConfig(configOverrideConfig, dbPath, codexHome, currentCwd, "206")
    let configOverrideResult = cli_runtime.RustCsgCliTuiSessionRuntimeRunArgs(configOverrideArgs,
                                                                               "resume",
                                                                               configOverrideConfig,
                                                                               "\n",
                                                                               "")
    failures = failures + CheckEqBool(configOverrideResult.ok, false, "config override hard fails")
    failures = failures + CheckEqStr(configOverrideResult.error, "TUI --config runtime overrides not ported", "config override error")

    var conflictArgs = Args2("fork")
    add(conflictArgs, "--last")
    add(conflictArgs, "saved-session-123")
    let conflictPlan = cli_tui.RustCsgCliTuiSessionCommandParse(conflictArgs, "fork")
    failures = failures + CheckEqBool(conflictPlan.ok, false, "conflict parse fails")
    failures = failures + CheckEqStr(conflictPlan.error, "--last conflicts with SESSION_ID", "conflict error")

    var unknownArgs = Args3("resume", "--unknown")
    let unknownPlan = cli_tui.RustCsgCliTuiSessionCommandParse(unknownArgs, "resume")
    failures = failures + CheckEqBool(unknownPlan.ok, false, "unknown parse fails")
    failures = failures + CheckEqStr(unknownPlan.error, "unknown resume flag: --unknown", "unknown error")

    var missingModelArgs = Args3("resume", "--model")
    let missingModel = cli_tui.RustCsgCliTuiSessionCommandParse(missingModelArgs, "resume")
    failures = failures + CheckEqBool(missingModel.ok, false, "missing model fails")
    failures = failures + CheckEqStr(missingModel.error, "--model requires a value", "missing model error")

    var yoloConflictArgs = Args2("resume")
    add(yoloConflictArgs, "--ask-for-approval")
    add(yoloConflictArgs, "never")
    add(yoloConflictArgs, "--yolo")
    let yoloConflict = cli_tui.RustCsgCliTuiSessionCommandParse(yoloConflictArgs, "resume")
    failures = failures + CheckEqBool(yoloConflict.ok, false, "yolo conflict fails")
    failures = failures + CheckEqStr(yoloConflict.error, "--dangerously-bypass-approvals-and-sandbox conflicts with --ask-for-approval", "yolo conflict error")

    if rolloutPath == "":
        failures = failures + 1
        echo("FAIL rollout path required")

    if failures != 0:
        echo(strutil.Join(["rust_csg_cli_tui_session_root_flow_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_cli_tui_session_root_flow_smoke ok")
    return 0
