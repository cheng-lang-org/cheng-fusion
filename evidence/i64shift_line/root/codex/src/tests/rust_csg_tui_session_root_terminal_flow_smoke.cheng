import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire
import cheng/codex/tui/session_bootstrap as bootstrap
import cheng/codex/tui/session_lifecycle as lifecycle
import cheng/codex/tui/session_resume as resume
import cheng/codex/tui/session_root_flow as root_flow
import cheng/codex/tui/session_root_terminal_flow as terminal_flow

fn SourceThreadId(): str =
    return "11111111-1111-4111-8111-111111111111"

fn SecondThreadId(): str =
    return "22222222-2222-4222-8222-222222222222"

fn Esc(): str =
    return strings.CharToStr(Char(27))

fn CtrlC(): str =
    return strings.CharToStr(Char(3))

fn CtrlD(): str =
    return strings.CharToStr(Char(4))

fn DownEnter(): str =
    return strutil.Join([Esc(), "[B|\n"], "")

fn BadCsi(): str =
    return strutil.Join([Esc(), "[?"], "")

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected ", expected, ", got ", actual], ""))
    return 1

fn CheckEqBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn CheckMinInt32(actual: int32, minimum: int32, label: str): int32 =
    if actual >= minimum:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected at least ", strings.IntToStr(minimum), ", got ", strings.IntToStr(actual)], ""))
    return 1

fn CheckContains(text: str, needle: str, label: str): int32 =
    if strutil.Contains(text, needle):
        return 0
    echo(strutil.Join(["FAIL ", label, ": missing ", needle], ""))
    echo(text)
    return 1

fn FillHandoffConfig(config: var lifecycle.RustCsgTuiThreadHandoffConfig,
                     cwd: str) =
    config.cwd = cwd
    config.model = "gpt-5"
    config.modelProviderId = "openai"
    config.serviceTierJson = "\"flex\""
    config.runtimeWorkspaceRootsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(cwd), "]")
    config.approvalPolicyJson = "\"on-request\""
    config.approvalsReviewer = "user"
    config.permissionsJson = "\":workspace\""
    config.configJson = "{\"model_reasoning_effort\":\"medium\"}"
    config.baseInstructions = "base"
    config.developerInstructions = "dev"

fn FillBootstrapConfig(config: var bootstrap.RustCsgTuiSessionBootstrapConfig) =
    config.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.terminalResizeReflowEnabled = true
    config.initialUserMessagePending = true
    config.stateConfig.permissionProfileJson = "{\"type\":\"workspaceWrite\",\"writableRoots\":[],\"networkAccess\":false,\"excludeTmpdirEnvVar\":false,\"excludeSlashTmp\":false}"
    config.stateConfig.personalityJson = "\"test-personality\""
    config.stateConfig.messageHistoryLogId = int64(42)
    config.stateConfig.messageHistoryEntryCount = 3

fn FillRootConfig(config: var root_flow.RustCsgTuiSessionRootFlowConfig,
                  dbPath: str,
                  codexHome: str,
                  currentCwd: str,
                  requestIdJson: str) =
    config.handoffContext.dbPath = dbPath
    config.handoffContext.codexHomePath = codexHome
    config.handoffContext.currentCwd = currentCwd
    config.handoffContext.currentConfigJson = resume.RustCsgTuiSessionResumeConfigJson(currentCwd,
                                                                                       "{\"model\":\"current-config-model\",\"modelProvider\":\"current-config-provider\",\"approvalPolicy\":\"on-request\",\"approvalsReviewer\":\"user\"}")
    config.handoffContext.allowPrompt = true
    config.handoffContext.promptChoice = ""
    config.handoffContext.threadParamsMode = lifecycle.RustCsgTuiThreadParamsModeEmbedded
    config.handoffContext.requestIdJson = requestIdJson
    FillHandoffConfig(config.handoffConfig, currentCwd)
    FillBootstrapConfig(config.bootstrapConfig)
    config.appTermWidth = 96
    config.appTermHeight = 20

fn FillPickerConfig(config: var terminal_flow.RustCsgTuiSessionRootTerminalPickerConfig) =
    config.action = "resume"
    config.selectedIndex = 0
    config.sortKey = "updated_at"
    config.limit = 10
    config.showCwd = true
    config.width = 96
    config.listHeight = 12
    config.viewRows = 8
    config.cwdPromptWidth = 192
    config.nowMs = int64(1770007200000)

fn RunTerminal(rootConfig: var root_flow.RustCsgTuiSessionRootFlowConfig,
               pickerSeq: str,
               cwdSeq: str): terminal_flow.RustCsgTuiSessionRootTerminalFlowResult =
    var pickerConfig: terminal_flow.RustCsgTuiSessionRootTerminalPickerConfig
    FillPickerConfig(pickerConfig)
    return terminal_flow.RustCsgTuiSessionRootTerminalFlowRun(rootConfig,
                                                              pickerConfig,
                                                              pickerSeq,
                                                              cwdSeq)

fn main(): int32 =
    if cmdline.argCount() < 6:
        echo("FAIL usage: rust_csg_tui_session_root_terminal_flow_smoke <state-db> <codex-home> <current-cwd> <session-cwd> <rollout-path>")
        return 1

    let dbPath = cmdline.argStr(1)
    let codexHome = cmdline.argStr(2)
    let currentCwd = cmdline.argStr(3)
    let sessionCwd = cmdline.argStr(4)
    let rolloutPath = cmdline.argStr(5)
    let threadId = SourceThreadId()
    let secondThreadId = SecondThreadId()
    var failures: int32

    var promptConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(promptConfig, dbPath, codexHome, currentCwd, "101")
    let promptResult = RunTerminal(promptConfig, "\n", "2")
    failures = failures + CheckEqBool(promptResult.ok, true, "prompt flow ok")
    failures = failures + CheckEqStr(promptResult.outcome, "app_ready", "prompt flow outcome")
    failures = failures + CheckEqStr(promptResult.pickerSelectionKind, "resume", "prompt picker selection")
    failures = failures + CheckEqStr(promptResult.pickerThreadId, threadId, "prompt picker thread")
    failures = failures + CheckEqStr(promptResult.cwdPromptOutcome, "selection", "prompt cwd outcome")
    failures = failures + CheckEqStr(promptResult.cwdPromptSelection, "current", "prompt cwd selection")
    failures = failures + CheckContains(promptResult.cwdPromptScreen, sessionCwd, "prompt screen session cwd")
    failures = failures + CheckContains(promptResult.rootJson, "\"outcome\":\"app_ready\"", "prompt root ready")
    failures = failures + CheckContains(promptResult.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(currentCwd), ""), "prompt root current cwd")
    failures = failures + CheckContains(promptResult.rootJson, wire.RustCsgCat3("\"historyCwd\":", wire.RustCsgJsonQuote(sessionCwd), ""), "prompt root history cwd")
    failures = failures + CheckContains(promptResult.appFirstFrameText, "resume hello", "prompt app frame user")
    failures = failures + CheckMinInt32(promptResult.pickerFrameCount, 1, "prompt picker frames")
    failures = failures + CheckMinInt32(promptResult.cwdPromptFrameCount, 1, "prompt cwd frames")

    var missingPromptConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(missingPromptConfig, dbPath, codexHome, currentCwd, "102")
    let missingPrompt = RunTerminal(missingPromptConfig, "\n", "")
    failures = failures + CheckEqBool(missingPrompt.ok, false, "missing prompt fails")
    failures = failures + CheckEqStr(missingPrompt.error, "cwd prompt sequence required after prompt_required", "missing prompt error")

    var idleConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(idleConfig, dbPath, codexHome, currentCwd, "103")
    let idle = RunTerminal(idleConfig, "", "")
    failures = failures + CheckEqBool(idle.ok, true, "idle ok")
    failures = failures + CheckEqStr(idle.outcome, "picker_idle", "idle outcome")

    var downConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(downConfig, dbPath, codexHome, currentCwd, "105")
    let down = RunTerminal(downConfig, DownEnter(), "")
    failures = failures + CheckEqBool(down.ok, true, "down enter ok")
    failures = failures + CheckEqStr(down.outcome, "app_ready", "down enter outcome")
    failures = failures + CheckEqStr(down.pickerThreadId, secondThreadId, "down enter thread")
    failures = failures + CheckEqStr(down.cwdPromptOutcome, "", "down enter no cwd prompt")
    failures = failures + CheckContains(down.appFirstFrameText, "second hello", "down enter app frame")
    failures = failures + CheckMinInt32(down.pickerFrameCount, 2, "down enter picker frames")

    var searchConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(searchConfig, dbPath, codexHome, currentCwd, "106")
    let search = RunTerminal(searchConfig, "S|e|c|o|n|d|\n", "")
    failures = failures + CheckEqBool(search.ok, true, "search enter ok")
    failures = failures + CheckEqStr(search.outcome, "app_ready", "search enter outcome")
    failures = failures + CheckEqStr(search.pickerThreadId, secondThreadId, "search enter thread")
    failures = failures + CheckContains(search.appFirstFrameText, "second hello", "search app frame")

    var escConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(escConfig, dbPath, codexHome, currentCwd, "107")
    let esc = RunTerminal(escConfig, Esc(), "")
    failures = failures + CheckEqBool(esc.ok, true, "esc ok")
    failures = failures + CheckEqStr(esc.outcome, "app_ready", "esc starts fresh app")
    failures = failures + CheckEqStr(esc.pickerSelectionKind, "start_fresh", "esc picker selection")
    failures = failures + CheckEqStr(esc.cwdPromptOutcome, "", "esc no cwd prompt")
    failures = failures + CheckContains(esc.rootJson, "\"selectionKind\":\"start_fresh\"", "esc root selection")
    failures = failures + CheckContains(esc.rootJson, "\"method\":\"thread/start\"", "esc root method")
    failures = failures + CheckContains(esc.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(currentCwd), ""), "esc root cwd")
    failures = failures + CheckContains(esc.rootJson, "\"handoffRequest\":{\"id\":107,\"method\":\"thread/start\"", "esc handoff request")
    failures = failures + CheckContains(esc.rootJson, "\"ephemeral\":false", "esc handoff ephemeral")

    var ctrlCConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(ctrlCConfig, dbPath, codexHome, currentCwd, "108")
    let ctrlC = RunTerminal(ctrlCConfig, CtrlC(), "")
    failures = failures + CheckEqBool(ctrlC.ok, true, "ctrl-c ok")
    failures = failures + CheckEqStr(ctrlC.outcome, "exit", "ctrl-c exit")

    var ctrlDConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(ctrlDConfig, dbPath, codexHome, currentCwd, "109")
    let ctrlD = RunTerminal(ctrlDConfig, CtrlD(), "")
    failures = failures + CheckEqBool(ctrlD.ok, true, "ctrl-d ok")
    failures = failures + CheckEqStr(ctrlD.outcome, "picker_idle", "ctrl-d no start fresh")

    var badConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(badConfig, dbPath, codexHome, currentCwd, "110")
    let bad = RunTerminal(badConfig, BadCsi(), "")
    failures = failures + CheckEqBool(bad.ok, false, "bad csi fails")
    failures = failures + CheckEqStr(bad.error, "unsupported root terminal picker sequence", "bad csi error")

    var directConfig: root_flow.RustCsgTuiSessionRootFlowConfig
    FillRootConfig(directConfig, dbPath, codexHome, sessionCwd, "104")
    let direct = RunTerminal(directConfig, "\n", "")
    failures = failures + CheckEqBool(direct.ok, true, "direct ok")
    failures = failures + CheckEqStr(direct.outcome, "app_ready", "direct outcome")
    failures = failures + CheckEqStr(direct.cwdPromptOutcome, "", "direct no cwd prompt")
    failures = failures + CheckContains(direct.rootJson, wire.RustCsgCat3("\"cwd\":", wire.RustCsgJsonQuote(sessionCwd), ""), "direct root session cwd")

    let promptJson = terminal_flow.RustCsgTuiSessionRootTerminalFlowResultToJson(promptResult)
    failures = failures + CheckContains(promptJson, "\"cwdPromptSelection\":\"current\"", "prompt json cwd selection")
    failures = failures + CheckContains(promptJson, "\"root\":{\"ok\":true", "prompt json root")

    if rolloutPath == "":
        failures = failures + 1
        echo("FAIL rollout path required")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_session_root_terminal_flow_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_session_root_terminal_flow_smoke ok")
    return 0
