import cheng/codex/crates/app_server_test_client/app_server_test_client as m

fn main(): int32 =
    var pass: int32

    if m.NotificationsToOptOutList().len > 0: pass = pass + 1
    if m.CliCommandVariantNames().len > 0: pass = pass + 1
    if m.EndpointVariantNames() == "SpawnCodex,ConnectWs": pass = pass + 1
    if m.ClientTransportVariantNames() == "Stdio,WebSocket": pass = pass + 1
    if m.TraceSummaryVariantNames() == "Enabled,Disabled": pass = pass + 1

    if pass == 5:
        echo("rust_csg_oracle_app_server_test_client ok")
        return 0
    echo("oracle FAIL")
    return 1

main()