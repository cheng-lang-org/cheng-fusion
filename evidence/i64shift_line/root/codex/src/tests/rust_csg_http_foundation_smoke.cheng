# HTTP Foundation: URL parser, HTTP/1.1 message builder and response parser
# Production implementations with real HTTP format handling.

import std/strings
import std/strutils as strutil

# ═══════════════════════════════════════════════════════════════════════════════
# URL Parser
# ═══════════════════════════════════════════════════════════════════════════════

# Parse "https://host:port/path" into components.
# On success: outOk=true, outPort=0 means "no port specified" (use default).
# On failure: outOk=false, output fields are undefined.
fn parseUrl(url: str, urlLen: int32, outScheme: var str, outHost: var str,
             outPort: var int32, outPath: var str, outOk: var bool) =
    outOk = false
    outScheme = ""
    outHost = ""
    outPort = 0
    outPath = ""

    if urlLen == 0:
        return

    echo(strutil.Join(["parseUrl: urlLen=", strings.IntToStr(urlLen)], ""))

    # Find ':'
    var i: int32 = 0
    var foundColon: bool = false
    while i < urlLen && !foundColon:
        if url[i] == ':':
            foundColon = true
        else:
            i = i + 1
    if !foundColon:
        return
    outScheme = strings.SliceBytes(url, 0, i)

    # Check "://"
    if i + 3 > urlLen:
        return
    if url[i + 1] != '/' || url[i + 2] != '/':
        return
    i = i + 3

    # Snapshot auth start before continuing scan with i
    let authStart: int32 = i

    # Find '/' after host — reuse i for scanning (no separate authEnd var)
    var foundSlash: bool = false
    while i < urlLen && !foundSlash:
        if url[i] == '/':
            foundSlash = true
        else:
            i = i + 1

    # i now points to '/' or urlLen; auth spans [authStart, i)
    let authLen: int32 = i - authStart
    echo(strutil.Join(["parseUrl: authLen=", strings.IntToStr(authLen)], ""))

    # Extract auth
    var auth: str = ""
    if authLen > 0:
        auth = strings.SliceBytes(url, authStart, authLen)
    echo(strutil.Join(["parseUrl: auth.len=", strings.IntToStr(auth.len)], ""))

    # Find ':' in auth
    var colonPos: int32 = -1
    var ci: int32 = 0
    while ci < auth.len:
        if auth[ci] == ':':
            colonPos = ci
        ci = ci + 1

    if colonPos >= 0:
        outHost = strings.SliceBytes(auth, 0, colonPos)
        var portStr: str = ""
        let portLen: int32 = auth.len - colonPos - 1
        if portLen > 0:
            portStr = strings.SliceBytes(auth, colonPos + 1, portLen)
            var portVal: int32 = 0
            var di: int32 = 0
            while di < portStr.len:
                let d = Int32(portStr[di])
                portVal = portVal * 10 + (d - 48)
                di = di + 1
            outPort = portVal
    else:
        outHost = auth

    # Path: characters from i (points to '/' or urlLen) to urlLen
    if i < urlLen:
        outPath = strings.SliceBytes(url, i, urlLen - i)

    outOk = true

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Message Builder
# ═══════════════════════════════════════════════════════════════════════════════

fn buildHttpGetRequest(host: str, path: str): str =
    var req = "GET "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Response Parser
# ═══════════════════════════════════════════════════════════════════════════════

# Parse "HTTP/1.1 200 OK\r\nHeader: value\r\n\r\nbody"
fn parseHttpResponse(response: str, outStatusCode: var int32,
                     outBody: var str, outOk: var bool) =
    outOk = false
    outStatusCode = 0
    outBody = ""
    let n = response.len

    if !strings.HasPrefix(response, "HTTP/1.1 "):
        return

    var i: int32 = 9

    # Need room for 3-digit status code
    if i + 3 > n:
        return

    # Read 3-digit status code
    var code: int32 = 0
    var di: int32 = 0
    while di < 3:
        let d = Int32(response[i + di])
        if d < 48 || d > 57:
            return
        code = code * 10 + (d - 48)
        di = di + 1
    outStatusCode = code
    i = i + 3

    # Scan for \r\n\r\n which separates headers from body.
    # This naturally consumes status text + header lines in one pass.
    var foundSep: bool = false
    while i + 3 < n && !foundSep:
        if response[i] == '\r' && response[i + 1] == '\n' &&
           response[i + 2] == '\r' && response[i + 3] == '\n':
            i = i + 4
            foundSep = true
        else:
            i = i + 1

    # Edge case: \r\n\r\n at the very end of response (no body)
    if !foundSep && i + 1 < n:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundSep = true

    if !foundSep:
        return

    if i < n:
        outBody = strings.SliceBytes(response, i, n - i)
    outOk = true

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP Header Parsing
# ═══════════════════════════════════════════════════════════════════════════════

# Extract Content-Type value from HTTP response headers section.
fn extractContentType(response: str, outType: var str, outOk: var bool) =
    outType = ""
    outOk = false
    let n = response.len
    var i: int32 = 0

    # Skip past status line
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    # Search for content-type header (case-insensitive)
    let prefix: str = "content-type: "
    var matched: bool = false
    while i < n && !matched:
        var mi: int32 = 0
        var possible: bool = true
        while mi < prefix.len && i + mi < n && possible:
            let ch = response[i + mi]
            let expected = prefix[mi]
            var chNorm: int32
            var expNorm: int32
            if ch >= 65 && ch <= 90:
                chNorm = ch + 32
            else:
                chNorm = ch
            if expected >= 65 && expected <= 90:
                expNorm = expected + 32
            else:
                expNorm = expected
            if chNorm != expNorm:
                possible = false
            mi = mi + 1
        if possible:
            matched = true
            i = i + prefix.len
        else:
            i = i + 1
    if !matched:
        return

    var valStart: int32 = i
    while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
        i = i + 1
    let valLen: int32 = i - valStart
    if valLen > 0:
        outType = strings.SliceBytes(response, valStart, valLen)
    outOk = true

# Extract Content-Length value from HTTP response headers section.
fn extractContentLength(response: str, outLength: var int32, outOk: var bool) =
    outLength = 0
    outOk = false
    let n = response.len
    var i: int32 = 0

    # Skip past status line
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    let prefix: str = "content-length: "
    var matched: bool = false
    while i < n && !matched:
        var mi: int32 = 0
        var possible: bool = true
        while mi < prefix.len && i + mi < n && possible:
            let ch = response[i + mi]
            let expected = prefix[mi]
            var chNorm: int32
            var expNorm: int32
            if ch >= 65 && ch <= 90:
                chNorm = ch + 32
            else:
                chNorm = ch
            if expected >= 65 && expected <= 90:
                expNorm = expected + 32
            else:
                expNorm = expected
            if chNorm != expNorm:
                possible = false
            mi = mi + 1
        if possible:
            matched = true
            i = i + prefix.len
        else:
            i = i + 1
    if !matched:
        return

    var valStart: int32 = i
    while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
        i = i + 1
    let valLen: int32 = i - valStart
    if valLen > 0:
        var val: int32 = 0
        var di: int32 = 0
        while di < valLen:
            let d = Int32(response[valStart + di])
            if d >= 48 && d <= 57:
                val = val * 10 + (d - 48)
            else:
                return
            di = di + 1
        outLength = val
    outOk = true

# ═══════════════════════════════════════════════════════════════════════════════
# Chunked Transfer Encoding (conceptual)
# ═══════════════════════════════════════════════════════════════════════════════

# Check if response uses chunked transfer encoding.
# Scans header section (between status line and \r\n\r\n)
# for "transfer-encoding" header containing "chunked".
fn isChunkedTransferEncoding(response: str): bool =
    let n = response.len

    # Skip past status line to reach headers
    var i: int32 = 0
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return false

    # Scan headers until \r\n\r\n looking for "chunked"
    while i + 3 < n:
        # Check for end of headers
        if response[i] == '\r' && response[i + 1] == '\n' &&
           response[i + 2] == '\r' && response[i + 3] == '\n':
            return false

        # Check for \r\n line boundary
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
        else:
            # Check if current position starts "chunked" (case-insensitive)
            let needle: str = "chunked"
            var ni: int32 = 0
            var found: bool = true
            while ni < needle.len && i + ni < n && found:
                let ch = response[i + ni]
                var chLower: int32
                if ch >= 65 && ch <= 90:
                    chLower = ch + 32
                else:
                    chLower = ch
                if chLower != Int32(needle[ni]):
                    found = false
                ni = ni + 1
            if found:
                return true
            i = i + 1
    return false

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP Status Code Classification
# ═══════════════════════════════════════════════════════════════════════════════

const
    HttpStatusClassInformational: int32 = 1   # 1xx
    HttpStatusClassSuccess: int32 = 2          # 2xx
    HttpStatusClassRedirection: int32 = 3      # 3xx
    HttpStatusClassClientError: int32 = 4      # 4xx
    HttpStatusClassServerError: int32 = 5      # 5xx
    HttpStatusClassUnknown: int32 = 0

fn classifyHttpStatusCode(statusCode: int32): int32 =
    if statusCode >= 100 && statusCode < 200:
        return HttpStatusClassInformational
    if statusCode >= 200 && statusCode < 300:
        return HttpStatusClassSuccess
    if statusCode >= 300 && statusCode < 400:
        return HttpStatusClassRedirection
    if statusCode >= 400 && statusCode < 500:
        return HttpStatusClassClientError
    if statusCode >= 500 && statusCode < 600:
        return HttpStatusClassServerError
    return HttpStatusClassUnknown

fn isHttpSuccess(statusCode: int32): bool =
    return statusCode >= 200 && statusCode < 300

fn isHttpClientError(statusCode: int32): bool =
    return statusCode >= 400 && statusCode < 500

fn isHttpServerError(statusCode: int32): bool =
    return statusCode >= 500 && statusCode < 600

fn isRedirect(statusCode: int32): bool =
    return statusCode == 301 || statusCode == 302 ||
           statusCode == 307 || statusCode == 308

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Request Builder — POST, PUT, DELETE
# ═══════════════════════════════════════════════════════════════════════════════

fn buildHttpPostRequest(host: str, path: str, body: str, contentType: str): str =
    var req = "POST "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    if contentType != "":
        req = strutil.Join([req, "\r\nContent-Type: "], "")
        req = strutil.Join([req, contentType], "")
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

fn buildHttpPutRequest(host: str, path: str, body: str, contentType: str): str =
    var req = "PUT "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    if contentType != "":
        req = strutil.Join([req, "\r\nContent-Type: "], "")
        req = strutil.Join([req, contentType], "")
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

fn buildHttpDeleteRequest(host: str, path: str): str =
    var req = "DELETE "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# Build an arbitrary HTTP/1.1 request with custom headers.
# headers array contains alternating key, value strings.
# Content-Length is auto-computed from body.
fn buildHttpRequest(method: str, host: str, path: str, headers: str[],
                     body: str): str =
    var req = method
    req = strutil.Join([req, " "], "")
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    var hi: int32 = 0
    while hi + 1 < headers.len:
        req = strutil.Join([req, "\r\n"], "")
        req = strutil.Join([req, headers[hi]], "")
        req = strutil.Join([req, ": "], "")
        hi = hi + 1
        req = strutil.Join([req, headers[hi]], "")
        hi = hi + 1
    req = strutil.Join([req, "\r\nContent-Length: "], "")
    req = strutil.Join([req, strings.Int64ToStr(int64(body.len))], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    if body != "":
        req = strutil.Join([req, body], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP Response Header Parser — extract all headers
# ═══════════════════════════════════════════════════════════════════════════════

fn parseHttpResponseHeaders(
    response: str,
    maxHeaders: int32,
    outKeys: var str[],
    outValues: var str[],
    outCount: var int32
) =
    outKeys = []
    outValues = []
    outCount = 0
    let n = response.len

    var i: int32 = 0
    var foundStatusEnd: bool = false
    while i + 1 < n && !foundStatusEnd:
        if response[i] == '\r' && response[i + 1] == '\n':
            i = i + 2
            foundStatusEnd = true
        else:
            i = i + 1
    if !foundStatusEnd:
        return

    while i + 1 < n && outCount < maxHeaders:
        if response[i] == '\r' && response[i + 1] == '\n':
            if i + 3 < n && response[i + 2] == '\r' && response[i + 3] == '\n':
                i = i + 4
            else:
                i = i + 2
            return

        var colonPos: int32 = i
        var foundColon: bool = false
        while colonPos < n && !foundColon:
            if response[colonPos] == ':':
                foundColon = true
            elif response[colonPos] == '\r' || response[colonPos] == '\n':
                var skip: int32 = colonPos
                while skip < n && !(response[skip] == '\r' && skip + 1 < n && response[skip + 1] == '\n'):
                    skip = skip + 1
                i = skip + 2
                colonPos = i
            else:
                colonPos = colonPos + 1

        if !foundColon:
            return

        let keyStart: int32 = i
        let keyEnd: int32 = colonPos
        var ke: int32 = keyEnd
        while ke > keyStart:
            let ch = response[ke - 1]
            if ch == 32 || ch == 9:
                ke = ke - 1
            else:
                break
        let keyLen: int32 = ke - keyStart
        var key: str = ""
        if keyLen > 0:
            key = strings.SliceBytes(response, keyStart, keyLen)

        i = colonPos + 1

        while i < n:
            let ch = response[i]
            if ch == 32 || ch == 9:
                i = i + 1
            else:
                break

        let valStart: int32 = i
        while i < n && !(response[i] == '\r' && i + 1 < n && response[i + 1] == '\n'):
            i = i + 1
        let valLen: int32 = i - valStart
        var value: str = ""
        if valLen > 0:
            value = strings.SliceBytes(response, valStart, valLen)

        if keyLen > 0 && outCount < maxHeaders:
            add(outKeys, key)
            add(outValues, value)
            outCount = outCount + 1

        i = i + 2

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP/1.1 Status Line Parser & Cookie Parser
# ═══════════════════════════════════════════════════════════════════════════════

# Parse "HTTP/1.1 200 OK" into status code and reason phrase.
fn parseHttpStatusLine(line: str, outCode: var int32,
                        outReason: var str, outOk: var bool) =
    outOk = false
    outCode = 0
    outReason = ""
    if !strings.HasPrefix(line, "HTTP/1.1 "):
        return
    var i: int32 = 9
    if i + 3 > line.len:
        return
    var code: int32 = 0
    var di: int32 = 0
    while di < 3:
        let d = Int32(line[i + di])
        if d < 48 || d > 57:
            return
        code = code * 10 + (d - 48)
        di = di + 1
    outCode = code
    i = i + 3
    # Skip space after status code
    if i < line.len && line[i] == 32:
        i = i + 1
    # Rest is reason phrase
    let reasonStart: int32 = i
    while i < line.len && line[i] != '\r' && line[i] != '\n':
        i = i + 1
    let reasonLen: int32 = i - reasonStart
    if reasonLen > 0:
        outReason = strings.SliceBytes(line, reasonStart, reasonLen)
    outOk = true

# Parse "name=value" from a Set-Cookie header value.
# Returns false if no '=' found.
fn parseSetCookie(header: str, outName: var str, outValue: var str): bool =
    outName = ""
    outValue = ""
    var eqPos: int32 = -1
    var i: int32 = 0
    while i < header.len:
        if header[i] == '=':
            eqPos = i
            i = header.len
        else:
            i = i + 1
    if eqPos <= 0:
        return false
    outName = strings.SliceBytes(header, 0, eqPos)
    let valStart: int32 = eqPos + 1
    var valEnd: int32 = valStart
    while valEnd < header.len && header[valEnd] != ';':
        valEnd = valEnd + 1
    let valLen: int32 = valEnd - valStart
    if valLen > 0:
        outValue = strings.SliceBytes(header, valStart, valLen)
    else:
        outValue = ""
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# URL Query String Parser
# ═══════════════════════════════════════════════════════════════════════════════

fn parseUrlQueryString(
    query: str,
    maxPairs: int32,
    outKeys: var str[],
    outValues: var str[],
    outCount: var int32
) =
    outKeys = []
    outValues = []
    outCount = 0
    let n = query.len
    if n == 0:
        return

    var i: int32 = 0
    var currentPair: int32 = 0

    while i < n && currentPair < maxPairs:
        while i < n && query[i] == '&':
            i = i + 1
        if i >= n:
            return

        let keyStart: int32 = i
        var foundEq: bool = false
        while i < n && query[i] != '&':
            if query[i] == '=' && !foundEq:
                foundEq = true
                i = i + 1
            else:
                i = i + 1

        var key: str = ""
        var value: str = ""

        if foundEq:
            var eqPos: int32 = keyStart
            while eqPos < i && query[eqPos] != '=':
                eqPos = eqPos + 1
            let keyLen: int32 = eqPos - keyStart
            if keyLen > 0:
                key = strings.SliceBytes(query, keyStart, keyLen)
            let valStart: int32 = eqPos + 1
            let valLen: int32 = i - valStart
            if valLen > 0 && valStart < n:
                value = strings.SliceBytes(query, valStart, valLen)
        else:
            let keyLen: int32 = i - keyStart
            if keyLen > 0:
                key = strings.SliceBytes(query, keyStart, keyLen)

        if key != "" && currentPair < maxPairs:
            add(outKeys, key)
            add(outValues, value)
            outCount = outCount + 1
            currentPair = currentPair + 1

        if i < n && query[i] == '&':
            i = i + 1

# ═══════════════════════════════════════════════════════════════════════════════
# Content-Type Negotiation
# ═══════════════════════════════════════════════════════════════════════════════

# Select the best matching content type from availableTypes given an Accept header.
# Accept header format: "type/subtype;q=0.9, type/*, */*;q=0.1"
# Returns the best match or empty string if none match.
fn selectContentType(acceptHeader: str, availableTypes: str[]): str =
    var bestType: str = ""
    var bestScore: int32 = 0
    for i in 0..<availableTypes.len:
        let avail = availableTypes[i]
        let score = scoreAgainstAccept(avail, acceptHeader)
        if score > bestScore:
            bestScore = score
            bestType = avail
    return bestType

# Score a single content type against an Accept header.
# Scoring: specificity (3=exact, 2=type/*, 1=*/*) * 1000 + quality (0-100).
fn scoreAgainstAccept(availType: str, acceptHeader: str): int32 =
    var bestScore: int32 = 0

    # Parse available type into main/sub
    var availMain: str = ""
    var availSub: str = ""
    let slashPos = findInStr(availType, '/')
    if slashPos >= 0:
        availMain = strings.SliceBytes(availType, 0, slashPos)
        availSub = strings.SliceBytes(availType, slashPos + 1, availType.len - slashPos - 1)
    else:
        availMain = availType
        availSub = "*"

    var i: int32 = 0
    let n = acceptHeader.len
    while i < n:
        while i < n && acceptHeader[i] == 32:
            i = i + 1
        if i >= n:
            break
        var entryEnd: int32 = i
        while entryEnd < n && acceptHeader[entryEnd] != ',':
            entryEnd = entryEnd + 1
        if entryEnd <= i:
            i = entryEnd
            if i < n && acceptHeader[i] == ',':
                i = i + 1
            continue

        let rawEntry = strings.SliceBytes(acceptHeader, i, entryEnd - i)

        # Split entry into media range and parameters at ';'
        var semiPos: int32 = -1
        var si: int32 = 0
        while si < rawEntry.len:
            if rawEntry[si] == ';':
                semiPos = si
            si = si + 1

        var mediaRange: str = rawEntry
        var qValue: int32 = 100
        if semiPos >= 0:
            mediaRange = strings.SliceBytes(rawEntry, 0, semiPos)
            qValue = parseQualityFromParams(rawEntry, semiPos + 1)

        # Trim media range
        var trimStart: int32 = 0
        while trimStart < mediaRange.len && mediaRange[trimStart] == 32:
            trimStart = trimStart + 1
        var trimEnd: int32 = mediaRange.len
        while trimEnd > trimStart && mediaRange[trimEnd - 1] == 32:
            trimEnd = trimEnd - 1
        if trimEnd <= trimStart:
            i = entryEnd
            if i < n && acceptHeader[i] == ',':
                i = i + 1
            continue
        if trimStart > 0 || trimEnd < mediaRange.len:
            mediaRange = strings.SliceBytes(mediaRange, trimStart, trimEnd - trimStart)

        # Parse entry type/subtype
        var entryMain: str = ""
        var entrySub: str = ""
        let eslash = findInStr(mediaRange, '/')
        if eslash >= 0:
            entryMain = strings.SliceBytes(mediaRange, 0, eslash)
            entrySub = strings.SliceBytes(mediaRange, eslash + 1, mediaRange.len - eslash - 1)
        else:
            entryMain = mediaRange
            entrySub = "*"

        # Compute specificity
        var specificity: int32 = 0
        if entryMain == "*" || entryMain == availMain:
            if entrySub == "*" || entrySub == availSub:
                if entryMain != "*" && entrySub != "*":
                    specificity = 3
                elif entryMain != "*":
                    specificity = 2
                else:
                    specificity = 1

        if specificity > 0:
            let score = specificity * 1000 + qValue
            if score > bestScore:
                bestScore = score

        i = entryEnd
        if i < n && acceptHeader[i] == ',':
            i = i + 1

    return bestScore

# Find first occurrence of character ch in string s, or -1 if not found.
fn findInStr(s: str, ch: int32): int32 =
    var i: int32 = 0
    while i < s.len:
        if Int32(s[i]) == ch:
            return i
        i = i + 1
    return -1

# Parse quality factor from accept header entry parameters starting at paramsStart.
# Quality is returned as integer * 100 (e.g. 0.9 -> 90, 1.0 -> 100).
fn parseQualityFromParams(entry: str, paramsStart: int32): int32 =
    var i: int32 = paramsStart
    while i < entry.len:
        if entry[i] == 'q' && i + 1 < entry.len && entry[i + 1] == '=':
            i = i + 2
            var qValue: int32 = 0
            var divisor: int32 = 1
            var seenDot: bool = false
            while i < entry.len:
                let ch = Int32(entry[i])
                if ch >= 48 && ch <= 57:
                    qValue = qValue * 10 + (ch - 48)
                    if seenDot:
                        divisor = divisor * 10
                    i = i + 1
                elif ch == 46 && !seenDot:
                    seenDot = true
                    i = i + 1
                else:
                    break
            if divisor > 1:
                return (qValue * 100) / divisor
            let result = qValue * 100
            if result > 100:
                return 100
            return result
        else:
            i = i + 1
    return 100

# ═══════════════════════════════════════════════════════════════════════════════
# URL Encode / Decode (percent-encoding)
# ═══════════════════════════════════════════════════════════════════════════════

# Percent-encode a string for use in URLs.
# Safe characters (A-Z, a-z, 0-9, -, _, ., ~) are left as-is.
# Space encodes as %20. All other characters encode as %XX.
fn urlEncode(s: str): str =
    let hexTable: str = "0123456789ABCDEF"
    var out = ""
    var i: int32 = 0
    while i < s.len:
        let ch = Int32(s[i])
        if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) ||
           (ch >= 48 && ch <= 57) || ch == 45 || ch == 46 || ch == 95 || ch == 126:
            out = strutil.Join([out, strings.SliceBytes(s, i, 1)], "")
        elif ch == 32:
            out = strutil.Join([out, "%20"], "")
        else:
            out = strutil.Join([out, "%"], "")
            let high: int32 = (ch >> 4) & 0xF
            let low: int32 = ch & 0xF
            out = strutil.Join([out, strings.SliceBytes(hexTable, high, 1)], "")
            out = strutil.Join([out, strings.SliceBytes(hexTable, low, 1)], "")
        i = i + 1
    return out

# Decode a percent-encoded URL string back to its original form.
# %XX sequences are decoded via sequential scan; all other characters pass through.
fn urlDecode(s: str): str =
    let decodePool: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    var out = ""
    var i: int32 = 0
    while i < s.len:
        let ch = Int32(s[i])
        if ch == 37 && i + 2 < s.len:
            let high = Int32(s[i + 1])
            let low = Int32(s[i + 2])
            var byteVal: int32 = 0
            if high >= 48 && high <= 57:
                byteVal = (high - 48) << 4
            elif high >= 65 && high <= 70:
                byteVal = (high - 65 + 10) << 4
            elif high >= 97 && high <= 102:
                byteVal = (high - 97 + 10) << 4
            if low >= 48 && low <= 57:
                byteVal = byteVal | (low - 48)
            elif low >= 65 && low <= 70:
                byteVal = byteVal | (low - 65 + 10)
            elif low >= 97 && low <= 102:
                byteVal = byteVal | (low - 97 + 10)
            if byteVal >= 32 && byteVal <= 126:
                out = strutil.Join([out, strings.SliceBytes(decodePool, byteVal - 32, 1)], "")
            else:
                out = strutil.Join([out, "?"], "")
            i = i + 3
        else:
            out = strutil.Join([out, strings.SliceBytes(s, i, 1)], "")
            i = i + 1
    return out

# ═══════════════════════════════════════════════════════════════════════════════
# Basic Auth Header (Base64)
# ═══════════════════════════════════════════════════════════════════════════════

# Build a Basic HTTP Authorization header value: "Basic base64(user:pass)".
fn buildBasicAuthHeader(username: str, password: str): str =
    let credentials = strutil.Join([username, ":", password], "")
    let encoded = base64Encode(credentials)
    return strutil.Join(["Basic ", encoded], "")

# Base64 encode a string.
# Uses the standard Base64 alphabet: A-Z, a-z, 0-9, +, /
fn base64Encode(input: str): str =
    let alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var out = ""
    let n = input.len
    var i: int32 = 0
    while i < n:
        let b0 = Int32(input[i])
        var b1: int32 = 0
        var b2: int32 = 0
        if i + 1 < n:
            b1 = Int32(input[i + 1])
        if i + 2 < n:
            b2 = Int32(input[i + 2])
        let idx0 = (b0 >> 2) & 0x3F
        out = strutil.Join([out, strings.SliceBytes(alphabet, idx0, 1)], "")
        let idx1 = ((b0 & 3) << 4) | ((b1 >> 4) & 0xF)
        out = strutil.Join([out, strings.SliceBytes(alphabet, idx1, 1)], "")
        if i + 1 >= n:
            out = strutil.Join([out, "=="], "")
        else:
            let idx2 = ((b1 & 0xF) << 2) | ((b2 >> 6) & 3)
            out = strutil.Join([out, strings.SliceBytes(alphabet, idx2, 1)], "")
            if i + 2 >= n:
                out = strutil.Join([out, "="], "")
            else:
                let idx3 = b2 & 0x3F
                out = strutil.Join([out, strings.SliceBytes(alphabet, idx3, 1)], "")
        i = i + 3
    return out

# ═══════════════════════════════════════════════════════════════════════════════
# HTTPS Request Builder (with SNI host)
# ═══════════════════════════════════════════════════════════════════════════════

fn buildHttpsRequest(host: str, path: str): str =
    var req = "GET "
    req = strutil.Join([req, path], "")
    req = strutil.Join([req, " HTTP/1.1\r\nHost: "], "")
    req = strutil.Join([req, host], "")
    req = strutil.Join([req, "\r\n\r\n"], "")
    return req

# ═══════════════════════════════════════════════════════════════════════════════
# Chunked Transfer Encoding Body Decoder
# ═══════════════════════════════════════════════════════════════════════════════

fn parseChunkedBody(raw: str): str =
    var result = ""
    let n = raw.len
    var i: int32 = 0
    while i < n:
        var size: int32 = 0
        var gotSize: bool = false
        while i < n && raw[i] != '\r':
            let ch = Int32(raw[i])
            var digit: int32 = -1
            if ch >= 48 && ch <= 57:
                digit = ch - 48
            elif ch >= 97 && ch <= 102:
                digit = ch - 97 + 10
            elif ch >= 65 && ch <= 70:
                digit = ch - 65 + 10
            if digit >= 0:
                size = size * 16 + digit
                gotSize = true
            i = i + 1
        if !gotSize:
            return result
        if i + 1 < n && raw[i] == '\r' && raw[i + 1] == '\n':
            i = i + 2
        else:
            return result
        if size == 0:
            break
        if i + size <= n:
            result = strutil.Join([result, strings.SliceBytes(raw, i, size)], "")
            i = i + size
        else:
            return result
        if i + 1 < n && raw[i] == '\r' && raw[i + 1] == '\n':
            i = i + 2
    return result

# ═══════════════════════════════════════════════════════════════════════════════
# HTTP Error Classification
# ═══════════════════════════════════════════════════════════════════════════════

fn classifyHttpError(statusCode: int32): str =
    if statusCode >= 100 && statusCode < 200:
        return "Informational"
    if statusCode >= 200 && statusCode < 300:
        return "Success"
    if statusCode >= 300 && statusCode < 400:
        return "Redirection"
    if statusCode >= 400 && statusCode < 500:
        return "ClientError"
    if statusCode >= 500 && statusCode < 600:
        return "ServerError"
    return "Unknown"

# ═══════════════════════════════════════════════════════════════════════════════
# Test helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", expected, " got=", got], ""))
        return false
    return true

fn checkEqI32(got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL: expected=", strings.IntToStr(expected),
                           " got=", strings.IntToStr(got)], ""))
        return false
    return true

fn checkEqBool(got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL: expected=", es, " got=", gs], ""))
        return false
    return true

