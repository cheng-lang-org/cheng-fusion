    if !checkEqI32(count, 0): ok = false
    if ok:
        echo("testParseNoHeaders ok")
    return ok

# Test 46: Parse headers with multi-digit content-length
fn testParseHeadersWithLargeLength(): bool =
    var ok: bool = true
    var keys: str[]
    var values: str[]
