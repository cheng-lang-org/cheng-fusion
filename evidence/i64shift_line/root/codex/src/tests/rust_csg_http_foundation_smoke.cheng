    if !checkEqBool(isRedirect(302), true): ok = false
    if !checkEqBool(isRedirect(307), true): ok = false
    if !checkEqBool(isRedirect(308), true): ok = false
    if ok:
        echo("testIsRedirectTrue ok")
    return ok

# Test 68: isRedirect false for non-redirect codes
fn testIsRedirectFalse(): bool =
