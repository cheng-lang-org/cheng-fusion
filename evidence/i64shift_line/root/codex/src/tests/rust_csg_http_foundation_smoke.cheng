    if !checkEqBool(isRedirect(404), false): ok = false
    if !checkEqBool(isRedirect(500), false): ok = false
    if !checkEqBool(isRedirect(300), false): ok = false
    if ok:
        echo("testIsRedirectFalse ok")
    return ok

