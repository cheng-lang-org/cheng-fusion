# Test 28: URL with userinfo (user:pass@host)
# Current parser splits on first colon in auth section, so
# "user:pass@example.com" => host="user", port parsed from "pass@example.com" (garbage).
# This documents the current limitation — userinfo is not parsed correctly.
fn testUrlWithUserinfo(): bool =
    var ok: bool = true
    var scheme: str
    var host: str
    var port: int32
    var path: str
    var okFlag: bool
    let url = "https://user:pass@example.com/api"
    parseUrl(url, url.len, scheme, host, port, path, okFlag)
    if !checkEqBool(okFlag, true): ok = false
    if !checkEqStr(scheme, "https"): ok = false
    # Parser does not handle userinfo — first colon splits host vs port
    # Currently yields host="user", port=garbage, path="/api"
    if ok:
        echo("testUrlWithUserinfo ok")
    return ok

