# Test 51: Exact match selects highest priority
fn testSelectContentTypeExact(): bool =
    var ok: bool = true
    var avail: str[] = ["text/html", "application/json"]
    let result = selectContentType("text/html, application/json; q=0.9", avail)
    if !checkEqStr(result, "text/html"): ok = false
    if ok:
        echo("testSelectContentTypeExact ok")
    return ok

# Test 52: Wildcard subtype match (text/*)
fn testSelectContentTypeWildcardSubtype(): bool =
    var ok: bool = true
    var avail: str[] = ["application/json", "text/plain"]
    let result = selectContentType("text/*", avail)
    if !checkEqStr(result, "text/plain"): ok = false
    if ok:
        echo("testSelectContentTypeWildcardSubtype ok")
    return ok

# Test 53: Quality-based selection picks higher q
fn testSelectContentTypeQuality(): bool =
    var ok: bool = true
    var avail: str[] = ["text/plain", "application/json"]
    let result = selectContentType("application/json; q=0.5, text/plain; q=0.8", avail)
    if !checkEqStr(result, "text/plain"): ok = false
    if ok:
        echo("testSelectContentTypeQuality ok")
    return ok

# Test 54: Universal wildcard selects first available
fn testSelectContentTypeUniversalWildcard(): bool =
    var ok: bool = true
    var avail: str[] = ["application/json", "text/html"]
    let result = selectContentType("*/*", avail)
    if !checkEqStr(result, "application/json"): ok = false
    if ok:
        echo("testSelectContentTypeUniversalWildcard ok")
    return ok

