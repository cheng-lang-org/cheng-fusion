fn testParseChunkedBodySingle(): bool =
    var ok: bool = true
    let result = parseChunkedBody("5\r\nHello\r\n0\r\n\r\n")
    if !checkEqStr(result, "Hello"): ok = false
    if ok:
        echo("testParseChunkedBodySingle ok")
    return ok

fn testParseChunkedBodyTwoChunks(): bool =
    var ok: bool = true
    let result = parseChunkedBody("4\r\nWiki\r\n6\r\npedia!\r\n0\r\n\r\n")
    if !checkEqStr(result, "Wikipedia!"): ok = false
    if ok:
        echo("testParseChunkedBodyTwoChunks ok")
    return ok

fn testParseChunkedBodyEmpty(): bool =
    var ok: bool = true
    let result = parseChunkedBody("0\r\n\r\n")
    if !checkEqStr(result, ""): ok = false
    if ok:
        echo("testParseChunkedBodyEmpty ok")
    return ok

fn testClassifyHttpError(): bool =
    var ok: bool = true
    if !checkEqStr(classifyHttpError(200), "Success"): ok = false
    if !checkEqStr(classifyHttpError(404), "ClientError"): ok = false
    if !checkEqStr(classifyHttpError(500), "ServerError"): ok = false
    if !checkEqStr(classifyHttpError(301), "Redirection"): ok = false
    if !checkEqStr(classifyHttpError(100), "Informational"): ok = false
    if !checkEqStr(classifyHttpError(999), "Unknown"): ok = false
    if ok:
        echo("testClassifyHttpError ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # URL parser tests
    if !testUrlStandard(): allOk = false
    if !testUrlHttpLocalhost(): allOk = false
    if !testUrlNoPort(): allOk = false
    if !testUrlHostOnly(): allOk = false
    if !testUrlInvalid(): allOk = false
    # URL edge case tests
    if !testUrlWithUserinfo(): allOk = false
    if !testUrlWithQueryString(): allOk = false
    if !testUrlWithFragment(): allOk = false
    if !testUrlIpv4(): allOk = false
    if !testUrlIpv6(): allOk = false
    if !testUrlEmpty(): allOk = false
    if !testUrlSchemeOnly(): allOk = false
    if !testUrlNoHost(): allOk = false
    if !testUrlPortZero(): allOk = false

    # HTTP/1.1 request builder tests
    if !testBuildGet(): allOk = false
    if !testBuildGetRoot(): allOk = false

    # HTTP/1.1 response parser tests
    if !testParse200(): allOk = false
    if !testParse404(): allOk = false
    if !testParseWithHeaders(): allOk = false
    if !testParse500(): allOk = false
    if !testParseInvalid(): allOk = false
    # Response edge case tests
    if !testParseNoBody(): allOk = false
    if !testParseMinimal(): allOk = false

    # HTTP header parsing tests
    if !testExtractContentType(): allOk = false
    if !testExtractContentTypeWithCharset(): allOk = false
    if !testExtractContentLength(): allOk = false
    if !testExtractContentLengthLarge(): allOk = false
    if !testExtractHeaderNotFound(): allOk = false
    if !testExtractContentLengthNotFound(): allOk = false

    # Chunked transfer encoding tests
    if !testIsChunkedTrue(): allOk = false
    if !testIsChunkedFalse(): allOk = false
    if !testIsChunkedMixedCase(): allOk = false

    # HTTP status code classification tests
    if !testClassify100(): allOk = false
    if !testClassify200(): allOk = false
    if !testClassify300(): allOk = false
    if !testClassify400(): allOk = false
    if !testClassify500(): allOk = false
    if !testClassifyUnknown(): allOk = false

    # HTTP POST/PUT/DELETE request builder tests
    if !testBuildPostJson(): allOk = false
    if !testBuildPostEmptyBody(): allOk = false
    if !testBuildPut(): allOk = false
    if !testBuildDelete(): allOk = false

    # Multi-header parser tests
    if !testParseMultipleHeaders(): allOk = false
    if !testParseSingleHeader(): allOk = false
    if !testParseNoHeaders(): allOk = false
    if !testParseHeadersWithLargeLength(): allOk = false

    # URL query string parser tests
    if !testParseSimpleQuery(): allOk = false
    if !testParseQueryEmptyValue(): allOk = false
    if !testParseQueryEmpty(): allOk = false
    if !testParseQuerySpecialChars(): allOk = false

    # Content-Type negotiation tests
    if !testSelectContentTypeExact(): allOk = false
    if !testSelectContentTypeWildcardSubtype(): allOk = false
    if !testSelectContentTypeQuality(): allOk = false
    if !testSelectContentTypeUniversalWildcard(): allOk = false
    if !testSelectContentTypeNoMatch(): allOk = false

    # URL encode/decode tests
    if !testUrlEncodeBasic(): allOk = false
    if !testUrlEncodeSpecial(): allOk = false
    if !testUrlEncodeSafe(): allOk = false
    if !testUrlEncodeEmpty(): allOk = false
    if !testUrlDecodeBasic(): allOk = false
    if !testUrlDecodeMixed(): allOk = false
    if !testUrlDecodePlain(): allOk = false
    if !testUrlDecodeEmpty(): allOk = false

    # Basic auth header tests
    if !testBuildBasicAuth(): allOk = false
    if !testBuildBasicAuthSpecial(): allOk = false
    if !testBuildBasicAuthEmptyPassword(): allOk = false

    # HTTP client utility tests
    if !testIsRedirectTrue(): allOk = false
    if !testIsRedirectFalse(): allOk = false
    if !testBuildHttpRequestWithHeaders(): allOk = false
    if !testBuildHttpRequestMultiHeaders(): allOk = false
    if !testBuildHttpRequestNoHeaders(): allOk = false
    if !testParseHttpStatusLine200(): allOk = false
    if !testParseHttpStatusLine404(): allOk = false
    if !testParseHttpStatusLineInvalid(): allOk = false
    if !testParseSetCookieBasic(): allOk = false
    if !testParseSetCookieWithAttrs(): allOk = false
    if !testParseSetCookieInvalid(): allOk = false

    # HTTPS / Chunked / Error classification tests
    if !testBuildHttpsRequest(): allOk = false
    if !testParseChunkedBodySingle(): allOk = false
    if !testParseChunkedBodyTwoChunks(): allOk = false
    if !testParseChunkedBodyEmpty(): allOk = false
    if !testClassifyHttpError(): allOk = false

    if allOk:
        echo("rust_csg_http_foundation_smoke ok")
        return 0
    else:
        echo("rust_csg_http_foundation_smoke FAILED")
        return 1
