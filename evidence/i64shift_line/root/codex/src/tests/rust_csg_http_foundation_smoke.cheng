# ═══════════════════════════════════════════════════════════════════════════════
# Test cases — HTTP Response Header Parser (multi-header)
# ═══════════════════════════════════════════════════════════════════════════════

# Test 43: Parse multiple response headers
fn testParseMultipleHeaders(): bool =
    var ok: bool = true
    var keys: str[]
    var values: str[]
    var count: int32 = 0
    let resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nX-Custom: val\r\n\r\nhello world"
    parseHttpResponseHeaders(resp, 8, keys, values, count)
    if !checkEqI32(count, 3): ok = false
    if count >= 1:
        if !checkEqStr(keys[0], "Content-Type"): ok = false
        if !checkEqStr(values[0], "text/plain"): ok = false
    if count >= 2:
        if !checkEqStr(keys[1], "Content-Length"): ok = false
        if !checkEqStr(values[1], "11"): ok = false
    if count >= 3:
        if !checkEqStr(keys[2], "X-Custom"): ok = false
        if !checkEqStr(values[2], "val"): ok = false
    if ok:
        echo("testParseMultipleHeaders ok")
    return ok

# Test 44: Parse response with only one header
fn testParseSingleHeader(): bool =
    var ok: bool = true
    var keys: str[]
    var values: str[]
    var count: int32 = 0
    let resp = "HTTP/1.1 201 Created\r\nLocation: /v1/items/42\r\n\r\n"
    parseHttpResponseHeaders(resp, 4, keys, values, count)
    if !checkEqI32(count, 1): ok = false
    if count >= 1:
        if !checkEqStr(keys[0], "Location"): ok = false
        if !checkEqStr(values[0], "/v1/items/42"): ok = false
    if ok:
        echo("testParseSingleHeader ok")
    return ok

