import std/cmdline
import std/strings as strutil
import cheng/codex/tui/cwd_prompt_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

fn main(): int32 =
    if cmdline.argCount() < 3:
        echo("FAIL usage: rust_csg_tui_cwd_prompt_oracle_smoke <modal.snap> <fork_modal.snap>")
        return 1

    # ── Modal ──────────────────────────────────────────────────────────────
    let modalPath: str = cmdline.argStr(1)
    let modalSnap = snap.RustCsgTuiOracleSnapshotParseFile(modalPath)
    if !modalSnap.ok:
        echo(strutil.Join(["FAIL: modal parse: ", modalPath, ": ", modalSnap.error], ""))
        return 1
    if modalSnap.source != "tui/src/cwd_prompt.rs":
        echo(strutil.Join(["FAIL: modal unexpected source: ", modalSnap.source], ""))
        return 1
    if modalSnap.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: modal unexpected expression: ", modalSnap.expression], ""))
        return 1

    let modalRendered: str = oracle.RustCsgTuiCwdPromptModalFixture()
    if modalRendered.len == 0:
        echo("FAIL: empty render for cwd_prompt_modal")
        return 1
    if modalRendered != modalSnap.body:
        echo(strutil.Join(["FAIL: cwd_prompt_modal byte mismatch (expected ", strings.IntToStr(modalSnap.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(modalRendered)), " bytes)"], ""))
        return 1

    # ── Fork Modal ─────────────────────────────────────────────────────────
    let forkPath: str = cmdline.argStr(2)
    let forkSnap = snap.RustCsgTuiOracleSnapshotParseFile(forkPath)
    if !forkSnap.ok:
        echo(strutil.Join(["FAIL: fork parse: ", forkPath, ": ", forkSnap.error], ""))
        return 1
    if forkSnap.source != "tui/src/cwd_prompt.rs":
        echo(strutil.Join(["FAIL: fork unexpected source: ", forkSnap.source], ""))
        return 1
    if forkSnap.expression != "terminal.backend()":
        echo(strutil.Join(["FAIL: fork unexpected expression: ", forkSnap.expression], ""))
        return 1

    let forkRendered: str = oracle.RustCsgTuiCwdPromptForkModalFixture()
    if forkRendered.len == 0:
        echo("FAIL: empty render for cwd_prompt_fork_modal")
        return 1
    if forkRendered != forkSnap.body:
        echo(strutil.Join(["FAIL: cwd_prompt_fork_modal byte mismatch (expected ", strings.IntToStr(forkSnap.bodyByteLen), " bytes, got ", strings.IntToStr(strings.Len(forkRendered)), " bytes)"], ""))
        return 1

    echo("rust_csg_tui_cwd_prompt_oracle_smoke ok")
    return 0
