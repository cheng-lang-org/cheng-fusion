import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/pending_input_preview_oracle as oracle

fn RustCsgTuiPendingInputPreviewOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/pending_input_preview.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != "\"format!(\\\"{buf:?}\\\")\"":
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 10:
        echo("FAIL usage: rust_csg_tui_pending_input_preview_oracle_smoke <9 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewManyLineSnapshot(), "pending_input_preview_render_many_line_message")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewMoreThanThreeSnapshot(), "pending_input_preview_render_more_than_three_messages")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewMultilineSteerSnapshot(), "pending_input_preview_render_multiline_pending_steer")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewOneMessageSnapshot(), "pending_input_preview_render_one_message")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewOneMessageShiftLeftSnapshot(), "pending_input_preview_render_one_message_shift_left")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewOnePendingSteerSnapshot(), "pending_input_preview_render_one_pending_steer")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewSteersAboveQueuedSnapshot(), "pending_input_preview_render_pending_steers_above_queued")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewTwoMessagesSnapshot(), "pending_input_preview_render_two_messages")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiPendingInputPreviewOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiPendingInputPreviewWrappedSnapshot(), "pending_input_preview_render_wrapped_message")

    if exitCode == 0:
        echo("rust_csg_tui_pending_input_preview_oracle_smoke ok")
    else:
        echo("rust_csg_tui_pending_input_preview_oracle_smoke FAILED")
    return exitCode
