import std/strings
import cheng/codex/state/thread_store

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn checkEqI32(name: str, left: int32, right: int32) =
    if left != right:
        echo(name)
        echo(strings.Int64ToStr(int64(left)))
        echo(strings.Int64ToStr(int64(right)))
    assert(left == right, name)

fn checkMetadataMerge() =
    var existing1: thread_store.RustCsgThreadMetadata
    existing1.title = "original title"
    existing1.cwd = "/home"
    existing1.status = "running"
    var update1: thread_store.RustCsgThreadMetadata
    update1.title = "new title"
    update1.cwd = "/new/home"
    update1.status = "completed"
    let merged1 = thread_store.RustCsgMergeThreadMetadata(existing1, update1)
    checkEq("merge_title_full", merged1.title, "new title")
    checkEq("merge_cwd_full", merged1.cwd, "/new/home")
    checkEq("merge_status_full", merged1.status, "completed")

    var existing2: thread_store.RustCsgThreadMetadata
    existing2.title = "original title"
    existing2.cwd = "/home"
    existing2.status = "running"
    var partialUpdate: thread_store.RustCsgThreadMetadata
    partialUpdate.title = "updated title"
    let merged2 = thread_store.RustCsgMergeThreadMetadata(existing2, partialUpdate)
    checkEq("merge_title_partial", merged2.title, "updated title")
    checkEq("merge_cwd_partial", merged2.cwd, "/home")
    checkEq("merge_status_partial", merged2.status, "running")

fn checkArrayMergeDiff() =
    var srcIds: str[] = ["id-1", "id-2"]
    var srcData: str[] = ["data-1", "data-2"]
    var tgtIds: str[] = ["id-2", "id-3"]
    var tgtData: str[] = ["data-2-updated", "data-3"]
    var outIds: str[]
    var outData: str[]
    thread_store.RustCsgThreadStoreMerge(srcIds, srcData, tgtIds, tgtData, outIds, outData)
    checkEqI32("merge_len", outIds.len, 3)
    checkEq("merge_id0", outIds[0], "id-1")
    checkEq("merge_data0", outData[0], "data-1")
    checkEq("merge_id1_overwrite", outIds[1], "id-2")
    checkEq("merge_data1_overwrite", outData[1], "data-2-updated")
    checkEq("merge_id2", outIds[2], "id-3")
    checkEq("merge_data2", outData[2], "data-3")

    var diffOutIds: str[]
    var diffOutData: str[]
    thread_store.RustCsgThreadStoreDiff(srcIds, srcData, tgtIds, diffOutIds, diffOutData)
    checkEqI32("diff_len", diffOutIds.len, 1)
    checkEq("diff_id", diffOutIds[0], "id-1")
    checkEq("diff_data", diffOutData[0], "data-1")

fn main(): int32 =
    checkMetadataMerge()
    checkArrayMergeDiff()
    echo("rust_csg_thread_store_merge_smoke ok")
    return 0
