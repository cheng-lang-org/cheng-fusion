import std/strings
import std/strutils as strutil
import cheng/codex/tui/key_hint as keyhint

fn CheckEqStr(actual: str, expected: str, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": expected [", expected, "] got [", actual, "]"], ""))
    return 1

fn CheckBool(actual: bool, expected: bool, label: str): int32 =
    if actual == expected:
        return 0
    echo(strutil.Join(["FAIL ", label, ": bool mismatch"], ""))
    return 1

fn main(): int32 =
    var failures: int32

    let ctrlAltV = keyhint.RustCsgTuiKeyBindingChar(118, true, true, false)
    failures = failures + CheckEqStr(keyhint.RustCsgTuiKeyBindingDisplayLabel(ctrlAltV),
                                     "ctrl + ⌥ + v",
                                     "ctrl alt v label")

    let down = keyhint.RustCsgTuiKeyBindingNamed(keyhint.RustCsgTuiKeyDown, false, false, false)
    failures = failures + CheckEqStr(keyhint.RustCsgTuiKeyBindingDisplayLabel(down),
                                     "↓",
                                     "down label")

    let ctrlNBinding = keyhint.RustCsgTuiKeyBindingChar(110, true, false, false)
    let ctrlNEvent = keyhint.RustCsgTuiKeyEventChar(110, true, false, false, keyhint.RustCsgTuiKeyEventKindPress)
    failures = failures + CheckEqStr(keyhint.RustCsgTuiKeyBindingDisplayLabel(keyhint.RustCsgTuiKeyBindingFromEvent(ctrlNEvent)),
                                     "ctrl + n",
                                     "ctrl-n from event label")
    let ctrlNPartsLeft = keyhint.RustCsgTuiKeyPartsChar(110, true, false, false)
    let ctrlNPartsRight = keyhint.RustCsgTuiKeyPartsChar(110, true, false, false)
    failures = failures + CheckEqStr(keyhint.RustCsgTuiKeyPartsDisplayKey(ctrlNPartsLeft),
                                     "n",
                                     "ctrl-n parts display")
    failures = failures + CheckBool(ctrlNPartsLeft.ctrl,
                                    true,
                                    "ctrl-n left ctrl")
    failures = failures + CheckBool(ctrlNPartsRight.ctrl,
                                    true,
                                    "ctrl-n right ctrl")
    failures = failures + CheckBool(keyhint.RustCsgTuiKeyPartsEqual(ctrlNPartsLeft,
                                                                    ctrlNPartsRight),
                                    true,
                                    "ctrl-n parts equal")
    failures = failures + CheckBool(keyhint.RustCsgTuiKeyBindingIsPress(ctrlNBinding, ctrlNEvent),
                                    true,
                                    "ctrl-n press")

    let plainJ = keyhint.RustCsgTuiKeyEventChar(106, false, false, false, keyhint.RustCsgTuiKeyEventKindPress)
    failures = failures + CheckBool(keyhint.RustCsgTuiIsPlainTextKeyEvent(plainJ),
                                    true,
                                    "plain j text")

    if failures != 0:
        echo(strutil.Join(["rust_csg_tui_key_hint_semantic_smoke failures=", strings.IntToStr(failures)], ""))
        return 1
    echo("rust_csg_tui_key_hint_semantic_smoke ok")
    return 0
