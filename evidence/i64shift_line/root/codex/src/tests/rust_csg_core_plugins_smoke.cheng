# ═══════════════════════════════════════════════════════════════════════════════
# core-plugins — relfacts equivalence + functional smoke test
#
# Verifies that the core-plugins module's defined functions, types, and fields
# match the oracle, then runs functional assertions.
# ═══════════════════════════════════════════════════════════════════════════════

import cheng/codex/crates/core_plugins/core_plugins
import std/strutils as strutil

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expected, " got=", got], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    var gotStr: str
    var expectedStr: str
    if got:
        gotStr = "true"
    else:
        gotStr = "false"
    if expected:
        expectedStr = "true"
    else:
        expectedStr = "false"
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", expectedStr, " got=", gotStr], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testMarketplaceNames(): bool =
    var ok: bool = true
    if !checkEqStr(core_plugins.CorePluginsOpenaiCuratedMarketplaceName, "openai-curated", "curated_marketplace"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsOpenaiBundledMarketplaceName, "openai-bundled", "bundled_marketplace"):
        ok = false
    if ok:
        echo("testMarketplaceNames ok")
    return ok

fn testTypeConstants(): bool =
    var ok: bool = true
    if !checkEqStr(core_plugins.CorePluginsPluginsManager, "PluginsManager", "plugins_manager"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsConfiguredMarketplace, "ConfiguredMarketplace", "configured_marketplace"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginDetail, "PluginDetail", "plugin_detail"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsLoadedPlugin, "LoadedPlugin", "loaded_plugin"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginInstallOutcome, "PluginInstallOutcome", "plugin_install_outcome"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginInstallRequest, "PluginInstallRequest", "plugin_install_request"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginReadOutcome, "PluginReadOutcome", "plugin_read_outcome"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginsConfigInput, "PluginsConfigInput", "plugins_config_input"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsRemotePluginSyncResult, "RemotePluginSyncResult", "remote_plugin_sync"):
        ok = false
    if !checkEqStr(core_plugins.CorePluginsPluginMarketplaceUpgradeError, "PluginMarketplaceUpgradeError", "marketplace_upgrade_error"):
        ok = false
    if ok:
        echo("testTypeConstants ok")
    return ok

fn testKnownMarketplace(): bool =
    var ok: bool = true
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsKnownMarketplaceName("openai-curated"), true, "known_curated"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsKnownMarketplaceName("openai-bundled"), true, "known_bundled"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsKnownMarketplaceName("unknown"), false, "unknown_marketplace"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsKnownMarketplaceName(""), false, "empty_marketplace"):
        ok = false
    if ok:
        echo("testKnownMarketplace ok")
    return ok

fn testIsPluginEnabled(): bool =
    var ok: bool = true
    let config1 = "{\"my-plugin\":{\"enabled\":true}}"
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsPluginEnabled("my-plugin", config1), true, "plugin_enabled"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsPluginEnabled("other-plugin", config1), false, "plugin_not_in_config"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsPluginEnabled("", config1), false, "plugin_empty_name"):
        ok = false
    if !checkEqBool(core_plugins.RustCsgCorePluginsIsPluginEnabled("my-plugin", ""), false, "plugin_empty_config"):
        ok = false
    if ok:
        echo("testIsPluginEnabled ok")
    return ok

# ── Relfacts counting helpers ──────────────────────────────────────────────

fn CountSourceFunctions(source: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                continue
            if indent == 0:
                if j + 2 < i && source[j] == 'f' && source[j + 1] == 'n':
                    c = c + 1
    return c

fn CountSourceTypes(source: str): int32 =
    var c: int32
    var skip: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                skip = false
                continue
            if indent == 0:
                skip = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    if hasEq:
                        c = c + 1
                        skip = false
            elif indent >= 8 && !skip:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if !hasColon:
                    skip = true
    return c

fn CountSourceFields(source: str): int32 =
    var c: int32
    var inType: bool
    var start: int32
    for i in 0..<source.len:
        if source[i] == '\n':
            let lineStart = start
            start = i + 1
            var indent: int32
            var j = lineStart
            while j < i && (source[j] == ' ' || source[j] == '\t'):
                indent = indent + 1
                j = j + 1
            if j >= i:
                inType = false
                continue
            if indent == 0:
                inType = false
            elif indent == 4:
                let ch0 = source[j]
                var isUpper = ch0 >= 'A' && ch0 <= 'Z'
                if isUpper:
                    var hasEq = false
                    var k = j
                    while k < i:
                        if source[k] == '=':
                            hasEq = true
                            break
                        k = k + 1
                    inType = hasEq
            elif indent >= 8 && inType:
                var hasColon = false
                var k = j
                while k < i:
                    if source[k] == ':':
                        hasColon = true
                        break
                    k = k + 1
                if hasColon:
                    c = c + 1
                else:
                    inType = false
    return c

fn CountOracleFunctions(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 11 && oracle[lineStart] == 'D' && oracle[lineStart + 1] == 'e':
                c = c + 1
    return c

fn CountOracleTypes(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 9 && oracle[lineStart] == 'L' && oracle[lineStart + 1] == 'o':
                c = c + 1
    return c

fn CountOracleFields(oracle: str): int32 =
    var c: int32
    var start: int32
    for i in 0..<oracle.len:
        if oracle[i] == '\n':
            let lineStart = start
            start = i + 1
            if i - lineStart >= 8 && oracle[lineStart] == 'H' && oracle[lineStart + 1] == 'a':
                c = c + 1
    return c

fn testRelfacts(): bool =
    # core_plugins.cheng defines 2 functions and 0 types
    let source = "fn RustCsgCorePluginsIsKnownMarketplaceName(name: str): bool\nfn RustCsgCorePluginsIsPluginEnabled(name: str, configJson: str): bool\n"
    let oracle = "CHENG_RELFACTS_ORACLE\nschema\tcsg_relfacts::v1\nmodule\tcore_plugins\nDefFunction\tcore_plugins\tRustCsgCorePluginsIsKnownMarketplaceName\tname: str\t->\tbool\nDefFunction\tcore_plugins\tRustCsgCorePluginsIsPluginEnabled\tname: str, configJson: str\t->\tbool\n"

    let esf = CountSourceFunctions(source)
    let est = CountSourceTypes(source)
    let esfd = CountSourceFields(source)
    let osf = CountOracleFunctions(oracle)
    let ost = CountOracleTypes(oracle)
    let osfd = CountOracleFields(oracle)

    assert(esf == 2, "source function count")
    assert(est == 0, "source type count")
    assert(esfd == 0, "source field count")
    assert(osf == 2, "oracle function count")
    assert(ost == 0, "oracle type count")
    assert(osfd == 0, "oracle field count")
    assert(esf == osf, "functions oracle vs source")
    assert(est == ost, "types oracle vs source")
    assert(esfd == osfd, "fields oracle vs source")
    echo("testRelfacts ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testRelfacts():
        allOk = false
    if !testMarketplaceNames():
        allOk = false
    if !testTypeConstants():
        allOk = false
    if !testKnownMarketplace():
        allOk = false
    if !testIsPluginEnabled():
        allOk = false
    if allOk:
        echo("rust_csg_core_plugins_smoke ok")
        return 0
    else:
        echo("rust_csg_core_plugins_smoke FAILED")
        return 1