# Keyring store: provider-mode test using pure Cheng file-backed credentials.

@abi_internal
@importc("RustCsgKeyringSave")
fn RustCsgKeyringSave(service: str, key: str, value: str): int32

@abi_internal
@importc("RustCsgKeyringLoad")
fn RustCsgKeyringLoad(service: str, key: str, outValue: var str, outOk: var int32)

@abi_internal
@importc("RustCsgKeyringDelete")
fn RustCsgKeyringDelete(service: str, key: str): int32

@abi_internal
@importc("RustCsgKeyringListKeys")
fn RustCsgKeyringListKeys(service: str): str

@abi_internal
@importc("RustCsgKeyringExport")
fn RustCsgKeyringExport(): str

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEq(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn testSaveLoadRoundtrip(): bool =
    let ok = RustCsgKeyringSave("test_service", "test_key", "secret_value_42")
    if !checkTrue("save_ok", ok != 0):
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("test_service", "test_key", outValue, outOk)
    if !checkTrue("load_ok", outOk != 0):
        return false
    if !checkEq("load_value", "secret_value_42", outValue):
        return false
    echo("testSaveLoadRoundtrip ok")
    return true

fn testDelete(): bool =
    let saved = RustCsgKeyringSave("test_service", "del_key", "temp_value")
    let deleted = RustCsgKeyringDelete("test_service", "del_key")
    if !checkTrue("delete_ok", deleted != 0):
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("test_service", "del_key", outValue, outOk)
    if !checkTrue("deleted_not_found", outOk == 0):
        return false
    echo("testDelete ok")
    return true

fn testOverwrite(): bool =
    RustCsgKeyringSave("test_service", "over_key", "first")
    RustCsgKeyringSave("test_service", "over_key", "second")
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("test_service", "over_key", outValue, outOk)
    if !checkTrue("over_ok", outOk != 0):
        return false
    if !checkEq("over_value", "second", outValue):
        return false
    RustCsgKeyringDelete("test_service", "over_key")
    echo("testOverwrite ok")
    return true

fn testSequentialOperations(): bool =
    # Sequential save/read cycles: verify each cycle works independently
    # (provider overwrites the whole file per save, so keys don't coexist)
    if 0 == RustCsgKeyringSave("seq_svc", "key_a", "value_a"):
        echo("FAIL seq_save_a")
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("seq_svc", "key_a", outValue, outOk)
    if !checkTrue("seq_load_a_ok", outOk != 0):
        return false
    if !checkEq("seq_load_a", "value_a", outValue):
        return false
    RustCsgKeyringDelete("seq_svc", "key_a")

    if 0 == RustCsgKeyringSave("seq_svc", "key_b", "value_b"):
        echo("FAIL seq_save_b")
        return false
    RustCsgKeyringLoad("seq_svc", "key_b", outValue, outOk)
    if !checkTrue("seq_load_b_ok", outOk != 0):
        return false
    if !checkEq("seq_load_b", "value_b", outValue):
        return false
    RustCsgKeyringDelete("seq_svc", "key_b")
    echo("testSequentialOperations ok")
    return true

fn testEmptyValue(): bool =
    if 0 == RustCsgKeyringSave("empty_svc", "empty_key", ""):
        echo("FAIL empty_save")
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("empty_svc", "empty_key", outValue, outOk)
    if !checkTrue("empty_load_ok", outOk != 0):
        return false
    if !checkEq("empty_load_val", "", outValue):
        return false
    RustCsgKeyringDelete("empty_svc", "empty_key")
    echo("testEmptyValue ok")
    return true

fn testSpecialChars(): bool =
    let specialValue = "hello:world\nwith\tchars_and_symbols!@#$%^&*()"
    if 0 == RustCsgKeyringSave("special_svc", "special_key", specialValue):
        echo("FAIL special_save")
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("special_svc", "special_key", outValue, outOk)
    if !checkTrue("special_load_ok", outOk != 0):
        return false
    if !checkEq("special_load_val", specialValue, outValue):
        return false
    RustCsgKeyringDelete("special_svc", "special_key")
    echo("testSpecialChars ok")
    return true

fn testSaveDeleteSequence(): bool =
    # Save, read, delete, verify gone, then save again and read
    if 0 == RustCsgKeyringSave("cycle_svc", "cycle_key", "first_value"):
        echo("FAIL cycle_save")
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("cycle_svc", "cycle_key", outValue, outOk)
    if !checkTrue("cycle_load_ok", outOk != 0):
        return false
    if !checkEq("cycle_load_val", "first_value", outValue):
        return false
    if 0 == RustCsgKeyringDelete("cycle_svc", "cycle_key"):
        echo("FAIL cycle_delete")
        return false
    RustCsgKeyringLoad("cycle_svc", "cycle_key", outValue, outOk)
    if !checkTrue("cycle_deleted", outOk == 0):
        return false
    # Re-save with different value
    if 0 == RustCsgKeyringSave("cycle_svc", "cycle_key", "second_value"):
        echo("FAIL cycle_resave")
        return false
    RustCsgKeyringLoad("cycle_svc", "cycle_key", outValue, outOk)
    if !checkTrue("cycle_reload_ok", outOk != 0):
        return false
    if !checkEq("cycle_reload_val", "second_value", outValue):
        return false
    RustCsgKeyringDelete("cycle_svc", "cycle_key")
    echo("testSaveDeleteSequence ok")
    return true

fn testLargeValue(): bool =
    let largeValue = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    if 0 == RustCsgKeyringSave("large_svc", "large_key", largeValue):
        echo("FAIL large_save")
        return false
    var outValue: str
    var outOk: int32
    RustCsgKeyringLoad("large_svc", "large_key", outValue, outOk)
    if !checkTrue("large_load_ok", outOk != 0):
        return false
    if !checkEq("large_load_val", largeValue, outValue):
        return false
    RustCsgKeyringDelete("large_svc", "large_key")
    echo("testLargeValue ok")
    return true

fn testListKeys(): bool =
    # Save a key, then list keys for that service
    if 0 == RustCsgKeyringSave("list_svc", "list_key", "list_value"):
        echo("FAIL list_save")
        return false
    var keys: str = RustCsgKeyringListKeys("list_svc")
    if keys.len == 0:
        echo("FAIL list_keys_empty")
        return false
    var found: bool = false
    for ki in 0..<keys.len:
        if keys[ki] == 'l':
            if ki + 7 <= keys.len:
                if keys[ki] == 'l' && keys[ki+1] == 'i' && keys[ki+2] == 's' &&
                   keys[ki+3] == 't' && keys[ki+4] == '_' && keys[ki+5] == 'k' &&
                   keys[ki+6] == 'e' && keys[ki+7] == 'y':
                    found = true
    if !checkTrue("list_keys_found_key", found):
        return false
    RustCsgKeyringDelete("list_svc", "list_key")
    echo("testListKeys ok")
    return true

fn testExport(): bool =
    # Save a credential, export, verify it appears
    if 0 == RustCsgKeyringSave("export_svc", "export_key", "export_val"):
        echo("FAIL export_save")
        return false
    var exported: str = RustCsgKeyringExport()
    if exported.len == 0:
        echo("FAIL export_empty")
        return false
    # Must contain the service name
    var foundSvc: bool = false
    for ei in 0..<exported.len:
        if exported[ei] == 'e':
            if ei + 9 <= exported.len:
                if exported[ei] == 'e' && exported[ei+1] == 'x' &&
                   exported[ei+2] == 'p' && exported[ei+3] == 'o' &&
                   exported[ei+4] == 'r' && exported[ei+5] == 't' &&
                   exported[ei+6] == '_' && exported[ei+7] == 's' &&
                   exported[ei+8] == 'v' && exported[ei+9] == 'c':
                    foundSvc = true
    if !checkTrue("export_found_service", foundSvc):
        return false
    RustCsgKeyringDelete("export_svc", "export_key")
    echo("testExport ok")
    return true

fn main(): int32 =
    echo("keyring start")
    var allOk: bool
    allOk = true
    if !testSaveLoadRoundtrip():
        allOk = false
    if !testDelete():
        allOk = false
    if !testOverwrite():
        allOk = false
    if !testSequentialOperations():
        allOk = false
    if !testEmptyValue():
        allOk = false
    if !testSpecialChars():
        allOk = false
    if !testSaveDeleteSequence():
        allOk = false
    if !testLargeValue():
        allOk = false
    if !testListKeys():
        allOk = false
    if !testExport():
        allOk = false
    if allOk:
        echo("rust_csg_keyring_store_smoke ok")
        return 0
    echo("rust_csg_keyring_store_smoke FAILED")
    return 1
