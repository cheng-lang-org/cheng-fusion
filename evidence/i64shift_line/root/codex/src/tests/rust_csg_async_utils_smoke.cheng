import std/strutils as strutil
import cheng/codex/crates/async_utils/async_utils

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL i32"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqBool(got: bool, expected: bool, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL bool"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn testOrCancelNotCancelled(): bool =
    var ok: bool = true
    var cancelled: bool
    let result = async_utils.asyncUtilsOrCancel(42, false, cancelled)
    if !checkEqI32(result, 42, "orCancel val"): ok = false
    if !checkEqBool(cancelled, false, "orCancel flag"): ok = false
    if ok:
        echo("testOrCancelNotCancelled ok")
    return ok

fn testOrCancelCancelled(): bool =
    var ok: bool = true
    var cancelled: bool
    let result = async_utils.asyncUtilsOrCancel(42, true, cancelled)
    if !checkEqI32(result, 0, "orCancel cancel val"): ok = false
    if !checkEqBool(cancelled, true, "orCancel cancel flag"): ok = false
    if ok:
        echo("testOrCancelCancelled ok")
    return ok

fn testOrCancelStr(): bool =
    var ok: bool = true
    var cancelled: bool
    let r1 = async_utils.asyncUtilsOrCancelStr("hello", true, cancelled)
    if !cancelled: ok = false
    if r1 != "": ok = false
    var cancelled2: bool
    let r2 = async_utils.asyncUtilsOrCancelStr("hello", false, cancelled2)
    if cancelled2: ok = false
    if r2 != "hello": ok = false
    if ok:
        echo("testOrCancelStr ok")
    return ok

fn testIsTimeout(): bool =
    var ok: bool = true
    if !checkEqBool(async_utils.asyncUtilsIsTimeout(100, 50), true, "timeout T"): ok = false
    if !checkEqBool(async_utils.asyncUtilsIsTimeout(50, 100), false, "timeout F"): ok = false
    if !checkEqBool(async_utils.asyncUtilsIsTimeout(100, 100), true, "timeout eq"): ok = false
    if ok:
        echo("testIsTimeout ok")
    return ok

fn testRace(): bool =
    var ok: bool = true
    var ready: bool
    let r1 = async_utils.asyncUtilsRace(100, true, 200, false, ready)
    if !checkEqBool(ready, true, "race1 ready"): ok = false
    if !checkEqI32(r1, 100, "race1 val"): ok = false
    var ready2: bool
    let r2 = async_utils.asyncUtilsRace(100, false, 200, true, ready2)
    if !checkEqBool(ready2, true, "race2 ready"): ok = false
    if !checkEqI32(r2, 200, "race2 val"): ok = false
    var ready3: bool
    let r3 = async_utils.asyncUtilsRace(100, false, 200, false, ready3)
    if !checkEqBool(ready3, false, "race3 ready"): ok = false
    if !checkEqI32(r3, 0, "race3 val"): ok = false
    if ok:
        echo("testRace ok")
    return ok

fn testWithTimeout(): bool =
    var ok: bool = true
    var cancelled: bool
    let r1 = async_utils.asyncUtilsWithTimeout(42, 100, 50, cancelled)
    if !checkEqBool(cancelled, true, "wt cancel"): ok = false
    if !checkEqI32(r1, 0, "wt cancel val"): ok = false
    var cancelled2: bool
    let r2 = async_utils.asyncUtilsWithTimeout(42, 50, 100, cancelled2)
    if !checkEqBool(cancelled2, false, "wt not cancel"): ok = false
    if !checkEqI32(r2, 42, "wt val"): ok = false
    if ok:
        echo("testWithTimeout ok")
    return ok

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testOrCancelNotCancelled(): allOk = false
    if !testOrCancelCancelled(): allOk = false
    if !testOrCancelStr(): allOk = false
    if !testIsTimeout(): allOk = false
    if !testRace(): allOk = false
    if !testWithTimeout(): allOk = false
    if allOk:
        echo("rust_csg_async_utils_smoke ok")
        return 0
    else:
        echo("rust_csg_async_utils_smoke FAILED")
        return 1
