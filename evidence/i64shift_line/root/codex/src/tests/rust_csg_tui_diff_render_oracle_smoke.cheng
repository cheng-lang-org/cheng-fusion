import std/cmdline
import std/strings as strutil
import cheng/codex/tui/diff_render_oracle as oracle
import cheng/codex/tui/oracle_snapshot as snap

fn RustCsgTuiDiffRenderOracleFirstDiff(expected: str, actual: str): str =
    var row: int32 = 1
    var col: int32 = 1
    var i: int32 = 0
    let expectedLen = strings.Len(expected)
    let actualLen = strings.Len(actual)
    var limit: int32 = expectedLen
    if actualLen < limit:
        limit = actualLen
    while i < limit:
        let expectedByte = strings.SliceBytes(expected, i, 1)
        let actualByte = strings.SliceBytes(actual, i, 1)
        if expectedByte != actualByte:
            return strutil.Join(["first diff row=", strings.IntToStr(row),
                                 " col=", strings.IntToStr(col),
                                 " expected=", expectedByte,
                                 " actual=", actualByte], "")
        if expectedByte == "\n":
            row = row + 1
            col = 1
        else:
            col = col + 1
        i = i + 1
    if expectedLen != actualLen:
        return strutil.Join(["first diff row=", strings.IntToStr(row),
                             " col=", strings.IntToStr(col),
                             " expected_len=", strings.IntToStr(expectedLen),
                             " actual_len=", strings.IntToStr(actualLen)], "")
    return "no diff"

fn RustCsgTuiDiffRenderOracleCheck(path: str, expectedSource: str, expectedExpr: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != expectedSource:
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != expectedExpr:
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture.len == 0:
        echo(strutil.Join(["FAIL: ", name, " empty fixture"], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch (expected ", strings.IntToStr(s.bodyByteLen),
                           " bytes, got ", strings.IntToStr(strings.Len(fixture)), "; ",
                           RustCsgTuiDiffRenderOracleFirstDiff(s.body, fixture), ")"], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn RustCsgTuiDiffRenderOracleCheckCase(name: str, path: str): int32 =
    if name == "apply_add_block":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleApplyAddBlockFixture(),
            name)
    if name == "apply_update_block":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockFixture(),
            name)
    if name == "apply_delete_block":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleApplyDeleteBlockFixture(),
            name)
    if name == "apply_update_line_numbers_text":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "text",
