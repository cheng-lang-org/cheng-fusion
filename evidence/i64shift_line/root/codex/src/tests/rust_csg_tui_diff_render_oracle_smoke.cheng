        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleDiffGallery120x40Fixture(),
            name)
    echo(strutil.Join(["FAIL: unknown diff-render case: ", name], ""))
    return 1

fn main(): int32 =
    if cmdline.argCount() == 3:
        let singleExitCode = RustCsgTuiDiffRenderOracleCheckCase(cmdline.argStr(1), cmdline.argStr(2))
        if singleExitCode != 0:
            echo(strutil.Join(["rust_csg_tui_diff_render_oracle_smoke FAIL (", strings.IntToStr(singleExitCode), " failures)"], ""))
            return 1
        echo("rust_csg_tui_diff_render_oracle_smoke ok")
        return 0

    if cmdline.argCount() != 23:
        echo("FAIL usage: rust_csg_tui_diff_render_oracle_smoke <22 diff-render snapshots> OR <case> <snapshot>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyAddBlockFixture(),
        "apply_add_block")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockFixture(),
        "apply_update_block")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyDeleteBlockFixture(),
        "apply_delete_block")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "text",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateLineNumbersTextFixture(),
        "apply_update_line_numbers_text")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyMultipleFilesBlockFixture(),
        "apply_multiple_files_block")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateWithRenameBlockFixture(),
        "apply_update_with_rename_block")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockRelativizesPathFixture(),
        "apply_update_block_relativizes_path")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleBlankContextLineFixture(),
        "blank_context_line")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleSingleLineReplacementCountsFixture(),
        "single_line_replacement_counts")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleAddDetailsFixture(),
        "add_details")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleUpdateDetailsWithRenameFixture(),
        "update_details_with_rename")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleVerticalEllipsisBetweenHunksFixture(),
        "vertical_ellipsis_between_hunks")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleAnsi16InsertDeleteNoBackgroundFixture(),
        "ansi16_insert_delete_no_background")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleWrapBehaviorInsertFixture(),
        "wrap_behavior_insert")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "text",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesTextFixture(),
        "apply_update_block_wraps_long_lines_text")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesFixture(),
        "apply_update_block_wraps_long_lines")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "text",
        oracle.RustCsgTuiDiffRenderOracleSyntaxHighlightedInsertWrapsTextFixture(),
        "syntax_highlighted_insert_wraps_text")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleSyntaxHighlightedInsertWrapsFixture(),
        "syntax_highlighted_insert_wraps")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "snapshot",
        oracle.RustCsgTuiDiffRenderOracleThemeScopeBackgroundResolutionFixture(),
        "theme_scope_background_resolution")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleDiffGallery80x24Fixture(),
        "diff_gallery_80x24")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleDiffGallery94x35Fixture(),
        "diff_gallery_94x35")
    argIdx = argIdx + 1

    exitCode = exitCode + RustCsgTuiDiffRenderOracleCheck(
        cmdline.argStr(argIdx), "tui/src/diff_render.rs", "terminal.backend()",
        oracle.RustCsgTuiDiffRenderOracleDiffGallery120x40Fixture(),
        "diff_gallery_120x40")
    argIdx = argIdx + 1

    if exitCode != 0:
        echo(strutil.Join(["rust_csg_tui_diff_render_oracle_smoke FAIL (", strings.IntToStr(exitCode), " failures)"], ""))
        return 1

    echo("rust_csg_tui_diff_render_oracle_smoke ok")
    return 0
