    if name == "single_line_replacement_counts":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleSingleLineReplacementCountsFixture(),
            name)
    if name == "add_details":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleAddDetailsFixture(),
            name)
    if name == "update_details_with_rename":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleUpdateDetailsWithRenameFixture(),
            name)
    if name == "vertical_ellipsis_between_hunks":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleVerticalEllipsisBetweenHunksFixture(),
            name)
    if name == "ansi16_insert_delete_no_background":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleAnsi16InsertDeleteNoBackgroundFixture(),
            name)
    if name == "wrap_behavior_insert":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleWrapBehaviorInsertFixture(),
            name)
    if name == "apply_update_block_wraps_long_lines_text":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "text",
            oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesTextFixture(),
            name)
    if name == "apply_update_block_wraps_long_lines":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleApplyUpdateBlockWrapsLongLinesFixture(),
            name)
    if name == "syntax_highlighted_insert_wraps_text":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "text",
            oracle.RustCsgTuiDiffRenderOracleSyntaxHighlightedInsertWrapsTextFixture(),
            name)
    if name == "syntax_highlighted_insert_wraps":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleSyntaxHighlightedInsertWrapsFixture(),
            name)
    if name == "theme_scope_background_resolution":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "snapshot",
            oracle.RustCsgTuiDiffRenderOracleThemeScopeBackgroundResolutionFixture(),
            name)
    if name == "diff_gallery_80x24":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleDiffGallery80x24Fixture(),
            name)
    if name == "diff_gallery_94x35":
        return RustCsgTuiDiffRenderOracleCheck(
            path, "tui/src/diff_render.rs", "terminal.backend()",
            oracle.RustCsgTuiDiffRenderOracleDiffGallery94x35Fixture(),
            name)
