import cheng/codex/exec/plan
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/rollout/reader
import cheng/codex/state/state_db_sqlite

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteLatestRolloutCwdRow")
fn RustCsgAddSqliteLatestRolloutCwdRow(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertBool(name: str, value: bool) =
    if !value:
        echo(name)
    assert(value, name)

fn assertOk(name: str, result: var resume_lookup_sqlite.RustCsgExecResumeSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn main(): int32 =
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    let otherCwd = "other-repo"

    checkEq("latest_rollout_cwd_fixture", RustCsgAddSqliteLatestRolloutCwdRow(path), "")
    var latestRolloutRow = state_db_sqlite.RustCsgStateDbThreadById(path, "thread-latest-rollout-cwd")
    assertBool("latest_rollout_row_loaded", latestRolloutRow.ok)
    var latestRolloutCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", "repo", "resume", "--last", "continue"])
    var latestRolloutCwdBlockedReason: str
    let latestExpectedCwd = resume_lookup_sqlite.RustCsgExecResumeSqliteCwdFilter(latestRolloutCwdPlan,
                                                                                  true,
                                                                                  latestRolloutCwdBlockedReason)
    checkEq("latest_rollout_cwd_filter_blocked", latestRolloutCwdBlockedReason, "")
    checkEq("latest_rollout_reader_cwd",
               reader.RustCsgRolloutLatestTurnCwd(latestRolloutRow.rolloutPath),
               latestExpectedCwd)
    assertBool("latest_rollout_row_cwd_match",
               resume_lookup_sqlite.RustCsgExecResumeSqliteRowCwdMatches(latestRolloutRow, latestExpectedCwd))
    var latestRolloutCwd: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path,
                                                             latestRolloutCwdPlan,
                                                             "openai",
                                                             latestRolloutCwd)
    assertOk("latest_rollout_cwd", latestRolloutCwd)
    checkEq("latest_rollout_cwd_thread", latestRolloutCwd.threadId, "thread-latest-rollout-cwd")

    var latestRolloutSkipsDbCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--last", "continue"])
    var latestRolloutSkipsDbCwd: resume_lookup_sqlite.RustCsgExecResumeSqliteResult
    resume_lookup_sqlite.RustCsgExecResumeLastFromSqliteInto(path,
                                                             latestRolloutSkipsDbCwdPlan,
                                                             "openai",
                                                             latestRolloutSkipsDbCwd)
    assertBool("latest_rollout_skips_db_cwd_blocked", !latestRolloutSkipsDbCwd.ok)
    checkEq("latest_rollout_skips_db_cwd_reason",
               latestRolloutSkipsDbCwd.blockedReason,
               "resume --last found no thread")

    echo("rust_csg_exec_resume_lookup_sqlite_latest_smoke ok")
    return 0
