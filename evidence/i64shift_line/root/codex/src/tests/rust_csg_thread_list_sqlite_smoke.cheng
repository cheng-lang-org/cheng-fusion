import std/sqlite
import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/protocol/wire
import cheng/codex/protocol/types
import cheng/codex/state/state_db_sqlite

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteThreadListBulkRows")
fn RustCsgAddSqliteThreadListBulkRows(path: str): str

@abi_internal
@importc("RustCsgRfc3339ToMillisText")
fn RustCsgRfc3339ToMillisText(text: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertInt32(name: str, left: int32, right: int32) =
    if left != right:
        echo(name)
        echo(wire.RustCsgJsonFieldInt32("left", left))
        echo(wire.RustCsgJsonFieldInt32("right", right))
    assert(left == right, name)

fn assertBool(name: str, value: bool) =
    if !value:
        echo(name)
    assert(value, name)

fn assertOk(name: str, result: var thread_list_sqlite.RustCsgThreadListSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn main(): int32 =
    assertInt32("sqlite constant", sqlite.SqliteOk, 0)
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    checkEq("bulk_fixture_rows", RustCsgAddSqliteThreadListBulkRows(path), "")
    let forcedStateRow = state_db_sqlite.RustCsgStateDbVisibleThreadAt(path,
                                                                       "updated_at",
                                                                       "desc",
                                                                       false,
                                                                       0)
    assertBool("forced_state_row", forcedStateRow.ok)
    checkEq("cursor_parse", RustCsgRfc3339ToMillisText("2023-11-14T22:13:20.123Z"), "1700000000123")

    var defaultParams: types.RustCsgThreadListParams
    defaultParams.limitJson = "10"
    defaultParams.archivedJson = "false"
    var allRows = thread_list_sqlite.RustCsgThreadListFromSqlite(path, defaultParams, "openai")
    assertOk("all_rows", allRows)
    assertInt32("all_rows_count", allRows.rowCount, 10)

    var providerParams: types.RustCsgThreadListParams
    providerParams.limitJson = "10"
    providerParams.archivedJson = "false"
    providerParams.modelProvidersJson = thread_list_sqlite.RustCsgThreadListSqliteJsonStringArrayOne("anthropic")
    var providerRows = thread_list_sqlite.RustCsgThreadListFromSqlite(path, providerParams, "openai")
    assertOk("provider_rows", providerRows)
    assertInt32("provider_rows_count", providerRows.rowCount, 1)

    var searchParams: types.RustCsgThreadListParams
    searchParams.limitJson = "10"
    searchParams.archivedJson = "false"
    searchParams.searchTerm = "older"
    var searchRows = thread_list_sqlite.RustCsgThreadListFromSqlite(path, searchParams, "openai")
    assertOk("search_rows", searchRows)
    assertInt32("search_rows_count", searchRows.rowCount, 1)

    var cursorParams: types.RustCsgThreadListParams
    cursorParams.limitJson = "1"
    cursorParams.sortKey = "updated_at"
    cursorParams.sortDirection = "desc"
    cursorParams.archivedJson = "false"
    cursorParams.cursor = "2023-11-14T22:13:20.123Z"
    var cursorResult = thread_list_sqlite.RustCsgThreadListFromSqlite(path, cursorParams, "openai")
    assertOk("cursor_result", cursorResult)
    assertInt32("cursor_row_count", cursorResult.rowCount, 1)

    echo("rust_csg_thread_list_sqlite_smoke ok")
    return 0
