import std/strings
import std/strutils as strutil

# EXACT pattern from inlinePushStr:
# while loop → if/else → declare bool → use via var param → read

fn findIt(haystack: str, needle: str, outFound: var bool) =
    outFound = false
    # Simulate: not found
    let m = needle.len
    let n = haystack.len
    if m > n:
        return
    # Would check here, but skip for test

fn callFindInElse(outResult: var str) =
    var iter: int32 = 0
    while iter < 1:
        if iter < 0:
            outResult = "impossible"
        else:
            var openFound: bool
            findIt("hello", "<oai-mem-citation>", openFound)
            if openFound:
                outResult = "found_true_BUG"
            else:
                outResult = "found_false_OK"
        iter = iter + 1

# What about the "findIt sets outFound to false" pattern?
fn findAndSetFalse(outFound: var bool) =
    outFound = false

fn testFindFalse(outResult: var str) =
    var iter: int32 = 0
    while iter < 1:
        if iter < 0:
            outResult = "impossible"
        else:
            var found: bool
            # call function that sets found = false via var param
            findAndSetFalse(found)
            if found:
                outResult = "still_true_BUG"
            else:
                outResult = "set_false_OK"
        iter = iter + 1

# Does `var found: bool` in else block initialize correctly?
fn testBoolInitInElse(outResult: var str) =
    var iter: int32 = 0
    while iter < 1:
        if iter < 0:
            outResult = "impossible"
        else:
            var found: bool
            # Don't touch found, just read its initial value
            if found:
                outResult = "init_true_BUG"
            else:
                outResult = "init_false_OK"
        iter = iter + 1

fn main(): int32 =
    echo("debug start")
    var r: str
    callFindInElse(r)
    echo(strutil.Join(["find=", r], ""))
    testFindFalse(r)
    echo(strutil.Join(["false=", r], ""))
    testBoolInitInElse(r)
    echo(strutil.Join(["init=", r], ""))
    echo("debug done")
    return 0