import std/strings
import codex/app_server/rate_limit_dashboard_oauth_login as oauth_login
import codex/auth/login

@abi_internal
@importc("RustCsgGetEnv")
fn RustCsgGetEnv(name: str): str

fn testCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn testContains(text: str, needle: str): bool =
    if needle.len == 0:
        return true
    if needle.len > text.len:
        return false
    var i: int32
    while i <= text.len - needle.len:
        var matched = true
        var j: int32
        while j < needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn checkContains(name: str, text: str, needle: str): bool =
    if testContains(text, needle):
        return true
    echo(testCat("FAIL: ", name))
    echo(testCat("  missing: ", needle))
    echo(testCat("  text: ", text))
    return false

fn main(argc: int32, argv: str*): int32 =
    let issuer = RustCsgGetEnv("RUST_CSG_DASHBOARD_OAUTH_ISSUER")
    let codexHome = RustCsgGetEnv("RUST_CSG_DASHBOARD_OAUTH_CODEX_HOME")
    let expectedEmail = RustCsgGetEnv("RUST_CSG_DASHBOARD_OAUTH_EXPECTED_EMAIL")
    let expectedFailure = RustCsgGetEnv("RUST_CSG_DASHBOARD_OAUTH_EXPECT_FAILURE")
    var expectedWorkspace = RustCsgGetEnv("RUST_CSG_DASHBOARD_OAUTH_EXPECTED_WORKSPACE")
    if expectedWorkspace == "":
        expectedWorkspace = "acct-smoke"
    if issuer == "":
        echo("FAIL: missing RUST_CSG_DASHBOARD_OAUTH_ISSUER")
        return 1
    if codexHome == "":
        echo("FAIL: missing RUST_CSG_DASHBOARD_OAUTH_CODEX_HOME")
        return 1
    var server: oauth_login.RustCsgDashboardOAuthServer
    var error: str
    if !oauth_login.RustCsgDashboardOAuthStartServer(issuer, 0, "state-smoke", "workspace-smoke", server, error):
        echo(testCat("FAIL: start OAuth server: ", error))
        return 1
    if !checkContains("auth url authorize", server.authUrl, "/oauth/authorize?"):
        return 1
    if !checkContains("auth url redirect", server.authUrl, "redirect_uri=http%3A%2F%2Flocalhost%3A"):
        return 1
    if !checkContains("auth url callback", server.authUrl, "%2Fauth%2Fcallback"):
        return 1
    if !checkContains("auth url scope", server.authUrl, "scope=openid%20profile%20email%20offline_access%20api.connectors.read%20api.connectors.invoke"):
        return 1
    if !checkContains("auth url challenge method", server.authUrl, "code_challenge_method=S256"):
        return 1
    if !checkContains("auth url simplified flow", server.authUrl, "codex_cli_simplified_flow=true"):
        return 1
    if !checkContains("auth url workspace", server.authUrl, "allowed_workspace_id=workspace-smoke"):
        return 1
    echo(testCat("AUTH_PORT=", strings.IntToStr(server.actualPort)))
    echo(testCat("AUTH_URL=", server.authUrl))
    let ok = oauth_login.RustCsgDashboardOAuthRunUntilDone(codexHome, expectedEmail, expectedWorkspace, int64(1767225600), server, error)
    if expectedFailure != "":
        if ok:
            echo("FAIL: OAuth login unexpectedly succeeded")
            return 1
        if !testContains(error, expectedFailure):
            echo(testCat("FAIL: expected failure mismatch: ", error))
            return 1
        let loadedAfterFailure = login.LoadAuth(codexHome)
        if loadedAfterFailure.authMode != "":
            echo("FAIL: failure path persisted auth.json")
            return 1
        echo("expected OAuth failure ok")
        return 0
    if !ok:
        echo(testCat("FAIL: OAuth login failed: ", error))
        return 1
    let auth = login.LoadAuth(codexHome)
    if auth.authMode != "Chatgpt":
        echo(testCat("FAIL: auth_mode mismatch: ", auth.authMode))
        return 1
    if auth.rawIdToken == "":
        echo("FAIL: missing id_token")
        return 1
    if auth.accessToken == "":
        echo("FAIL: missing access_token")
        return 1
    if auth.refreshToken == "":
        echo("FAIL: missing refresh_token")
        return 1
    if auth.accountId != "acct-smoke":
        echo(testCat("FAIL: account_id mismatch: ", auth.accountId))
        return 1
    if auth.lastRefresh != "2026-01-01T00:00:00Z":
        echo(testCat("FAIL: last_refresh mismatch: ", auth.lastRefresh))
        return 1
    echo("rust_csg_app_server_rate_limit_dashboard_oauth_login_smoke ok")
    return 0
