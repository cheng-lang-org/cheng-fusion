    if threadId == "stub-missing-rollout":
        result.ok = true
        result.id = threadId
        result.title = "Missing Rollout"
        result.cwd = "/tmp"
        result.modelProvider = "anthropic"
        result.source = "vscode"
        result.rolloutPath = "/codex/rollouts/missing_rollout.jsonl"
