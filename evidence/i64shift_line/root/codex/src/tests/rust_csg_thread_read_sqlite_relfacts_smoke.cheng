# ── Local type definitions (mirrors of project types) ────────────────────

type
    RustCsgStateDbThreadRowResult =
        ok: bool
        notFound: bool
        id: str
        title: str
        cwd: str
        modelProvider: str
        source: str
        rolloutPath: str
        createdAtMs: int64
        updatedAtMs: int64
        cliVersion: str
        firstUserMessage: str
        error: str

    RustCsgAppThread =
        id: str
        sessionId: str
        forkedFromId: str
        preview: str
        ephemeral: bool
        modelProvider: str
        createdAt: int64
        updatedAt: int64
        statusJson: str
        path: str
        cwd: str
        cliVersion: str
        source: str
        boundAccountEmail: str
        agentNickname: str
        agentRole: str
        gitInfoJson: str
        name: str
        turnsJson: str

    RustCsgThreadReadParams =
        threadId: str
        includeTurns: bool

    RustCsgThreadReadResponse =
        thread: RustCsgAppThread

    RustCsgThreadReadSqliteResult =
        ok: bool
        response: RustCsgThreadReadResponse
        error: str
        blockedReason: str

# ── Wire helper functions (self-contained, no wire import) ───────────────

fn Cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn Cat3(a: str, b: str, c: str): str =
    return Cat(Cat(a, b), c)

fn Cat4(a: str, b: str, c: str, d: str): str =
    return Cat(Cat3(a, b, c), d)

fn SliceBytes(text: str, start: int32, count: int32): str =
    return strings.SliceBytes(text, start, count)

fn MatchesAt(text: str, pos: int32, needle: str): bool =
    if pos < 0:
        return false
    if pos + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if text[pos + i] != needle[i]:
            return false
    return true

fn Contains(text: str, needle: str): bool =
    var i: int32
    while i < text.len:
        if MatchesAt(text, i, needle):
            return true
        i = i + 1
    return false

fn JsonQuote(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        let ch = value[i]
        if ch == '"':
            out = Cat(out, "\\\"")
        elif ch == '\\':
            out = Cat(out, "\\\\")
        elif ch == '\n':
            out = Cat(out, "\\n")
        elif ch == '\r':
            out = Cat(out, "\\r")
        elif ch == '\t':
            out = Cat(out, "\\t")
        else:
            out = Cat(out, SliceBytes(value, i, 1))
    return Cat(out, "\"")

fn JsonFieldStr(key: str, value: str): str =
    return Cat4("\"", key, "\":", JsonQuote(value))

fn JsonFieldBool(key: str, value: bool): str =
    return Cat4("\"", key, "\":", value ? "true" : "false")

fn JsonFieldInt32(key: str, value: int32): str =
    return Cat4("\"", key, "\":", strings.IntToStr(value))

fn JsonFieldInt64(key: str, value: int64): str =
    return Cat4("\"", key, "\":", strings.Int64ToStr(value))

fn JsonFieldRaw(key: str, value: str): str =
    return Cat4("\"", key, "\":", value)

fn JsonOptionalFieldStr(key: str, value: str): str =
    if value == "":
        return ""
    return Cat(",", JsonFieldStr(key, value))

fn JsonOptionalFieldRaw(key: str, value: str): str =
    if value == "":
        return ""
    return Cat(",", JsonFieldRaw(key, value))

fn AppThreadToJson(thread: RustCsgAppThread): str =
    var turnsJson = thread.turnsJson
    if turnsJson == "":
        turnsJson = "[]"
    var out = "{"
    out = Cat(out, JsonFieldStr("id", thread.id))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("sessionId", thread.sessionId))
    out = Cat(out, JsonOptionalFieldStr("forkedFromId", thread.forkedFromId))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("preview", thread.preview))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldBool("ephemeral", thread.ephemeral))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("modelProvider", thread.modelProvider))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldInt64("createdAt", thread.createdAt))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldInt64("updatedAt", thread.updatedAt))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("status", thread.statusJson))
    out = Cat(out, JsonOptionalFieldStr("path", thread.path))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("cwd", thread.cwd))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("cliVersion", thread.cliVersion))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldStr("source", thread.source))
    out = Cat(out, JsonOptionalFieldStr("boundAccountEmail", thread.boundAccountEmail))
    out = Cat(out, JsonOptionalFieldStr("agentNickname", thread.agentNickname))
    out = Cat(out, JsonOptionalFieldStr("agentRole", thread.agentRole))
    out = Cat(out, JsonOptionalFieldRaw("gitInfo", thread.gitInfoJson))
    out = Cat(out, JsonOptionalFieldStr("name", thread.name))
    out = Cat(out, ",")
    out = Cat(out, JsonFieldRaw("turns", turnsJson))
    out = Cat(out, "}")
    return out

fn ThreadReadResponseToJson(response: RustCsgThreadReadResponse): str =
    var out = "{"
    out = Cat(out, JsonFieldRaw("thread", AppThreadToJson(response.thread)))
    out = Cat(out, "}")
    return out

