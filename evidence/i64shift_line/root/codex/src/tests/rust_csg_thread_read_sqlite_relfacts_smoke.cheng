    return result

# Stub for rollout/reader.RustCsgRolloutTurnsJsonFromFile
fn RustCsgRolloutTurnsJsonFromFileStub(rolloutPath: str, historyError: var str): str =
    historyError = ""
    if Contains(rolloutPath, "missing_rollout"):
        historyError = "rollout history file is missing or empty"
        return ""
    if Contains(rolloutPath, "error_rollout"):
        historyError = "rollout parse error: invalid JSON"
        return ""
    return "[{\"id\":\"turn-1\",\"items\":[{\"type\":\"userMessage\",\"id\":\"item-1\",\"text\":\"hello\"},{\"type\":\"agentMessage\",\"id\":\"item-2\",\"text\":\"reply\"}],\"status\":\"completed\"}]"

# ── thread_row logic implementation ─────────────────────────────────────

fn RustCsgReadSqliteAsciiSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgReadSqliteTrimAsciiSpace(text: str): str =
    var start: int32
    while start < text.len && RustCsgReadSqliteAsciiSpace(text[start]):
        start = start + 1
    var end: int32
    end = text.len
    while end > start && RustCsgReadSqliteAsciiSpace(text[end - 1]):
        end = end - 1
    return SliceBytes(text, start, end - start)

fn RustCsgReadSqliteDistinctTitle(row: RustCsgStateDbThreadRowResult): str =
    let title = RustCsgReadSqliteTrimAsciiSpace(row.title)
    if title == "":
        return ""
    if RustCsgReadSqliteTrimAsciiSpace(row.firstUserMessage) == title:
        return ""
    return title

fn RustCsgReadSqliteThreadRowToAppThread(row: RustCsgStateDbThreadRowResult): RustCsgAppThread =
    var thread: RustCsgAppThread
    thread.id = row.id
    thread.sessionId = row.id
    thread.name = RustCsgReadSqliteDistinctTitle(row)
    thread.cwd = row.cwd
    thread.modelProvider = row.modelProvider
    thread.source = row.source
    thread.path = row.rolloutPath
    thread.createdAt = row.createdAtMs / int64(1000)
    thread.updatedAt = row.updatedAtMs / int64(1000)
    thread.cliVersion = row.cliVersion
    thread.preview = row.firstUserMessage
    thread.statusJson = "{\"type\":\"notLoaded\"}"
    thread.turnsJson = "[]"
    return thread

# ── thread_read_sqlite logic implementation ─────────────────────────────

fn RustCsgReadSqliteError(message: str): RustCsgThreadReadSqliteResult =
    var result: RustCsgThreadReadSqliteResult
    result.error = message
    return result

fn RustCsgReadSqliteBlocked(message: str): RustCsgThreadReadSqliteResult =
    var result: RustCsgThreadReadSqliteResult
    result.blockedReason = message
    return result

fn RustCsgReadSqliteThreadNotLoaded(threadId: str): str =
    return Cat("thread not loaded: ", threadId)

fn RustCsgReadSqliteFromStateDb(dbPath: str,
                                params: var RustCsgThreadReadParams,
                                fallbackProvider: str): RustCsgThreadReadSqliteResult =
    if params.threadId == "":
        return RustCsgReadSqliteBlocked("invalid thread id: empty")

    let row = RustCsgStateDbThreadByIdStub(params.threadId)
    if !row.ok:
        if row.notFound:
            return RustCsgReadSqliteBlocked(RustCsgReadSqliteThreadNotLoaded(params.threadId))
        return RustCsgReadSqliteError(row.error)

    var thread = RustCsgReadSqliteThreadRowToAppThread(row)
    if thread.modelProvider == "":
        thread.modelProvider = fallbackProvider
    if params.includeTurns:
        var historyError: str
        let turnsJson = RustCsgRolloutTurnsJsonFromFileStub(row.rolloutPath, historyError)
        if historyError == "rollout history file is missing or empty":
            return RustCsgReadSqliteBlocked(
                Cat3("thread ", params.threadId, " is not materialized yet; includeTurns is unavailable before first user message"))
        if historyError != "":
            return RustCsgReadSqliteBlocked(historyError)
        thread.turnsJson = turnsJson

    var response: RustCsgThreadReadResponse
    response.thread = thread

    var result: RustCsgThreadReadSqliteResult
    result.ok = true
    result.response = response
    return result

# ── Test helpers ────────────────────────────────────────────────────────

fn checkBool(name: str, got: bool, expected: bool): bool =
    if got != expected:
        var gs: str
        var es: str
        if got:
            gs = "T"
        else:
            gs = "F"
        if expected:
            es = "T"
        else:
            es = "F"
        echo(strutil.Join(["FAIL [", name, "]: expected=", es], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", gs], ""))
        return false
    return true

fn checkEq(name: str, got: str, expected: str): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=`", expected, "`"], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=`", got, "`"], ""))
        return false
    return true

fn checkInt32(name: str, got: int32, expected: int32): bool =
    if got != expected:
        echo(strutil.Join(["FAIL [", name, "]: expected=", strings.IntToStr(expected)], ""))
        echo(strutil.Join(["FAIL [", name, "]: got=", strings.IntToStr(got)], ""))
        return false
    return true

fn checkInt64(name: str, got: int64, expected: int64): bool =
    if got != expected:
        echo("FAIL int64")
        echo(name)
        return false
    return true

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo(strutil.Join(["FAIL [", name, "]: expected true"], ""))
        return false
    return true

fn checkFalse(name: str, cond: bool): bool =
    if cond:
        echo(strutil.Join(["FAIL [", name, "]: expected false"], ""))
        return false
    return true

# ── Section: testFactories ──────────────────────────────────────────────

fn testFactories(): bool =
    var ok: bool = true
    # Error factory
    let e1 = RustCsgReadSqliteError("some error")
    if !checkFalse("err_ok", e1.ok):
        ok = false
    if !checkEq("err_msg", e1.error, "some error"):
        ok = false
    if !checkEq("err_blocked", e1.blockedReason, ""):
        ok = false
    # Blocked factory
    let b1 = RustCsgReadSqliteBlocked("blocked reason")
    if !checkFalse("blocked_ok", b1.ok):
        ok = false
    if !checkEq("blocked_reason", b1.blockedReason, "blocked reason"):
        ok = false
    if !checkEq("blocked_err", b1.error, ""):
        ok = false
    if ok:
        echo("testFactories ok")
    return ok

# ── Section: testThreadNotLoaded ────────────────────────────────────────

fn testThreadNotLoaded(): bool =
    var ok: bool = true
    let msg1 = RustCsgReadSqliteThreadNotLoaded("thread-abc")
    if !checkEq("notLoaded_basic", msg1, "thread not loaded: thread-abc"):
        ok = false
    let msg2 = RustCsgReadSqliteThreadNotLoaded("")
    if !checkEq("notLoaded_empty", msg2, "thread not loaded: "):
        ok = false
    if ok:
        echo("testThreadNotLoaded ok")
    return ok

# ── Section: testAsciiSpace ─────────────────────────────────────────────

fn testAsciiSpace(): bool =
    var ok: bool = true
    if !checkTrue("asciiSpace_space", RustCsgReadSqliteAsciiSpace(' ')):
        ok = false
    if !checkTrue("asciiSpace_newline", RustCsgReadSqliteAsciiSpace('\n')):
        ok = false
    if !checkTrue("asciiSpace_cr", RustCsgReadSqliteAsciiSpace('\r')):
        ok = false
    if !checkTrue("asciiSpace_tab", RustCsgReadSqliteAsciiSpace('\t')):
        ok = false
    if !checkFalse("asciiSpace_a", RustCsgReadSqliteAsciiSpace('a')):
        ok = false
    if !checkFalse("asciiSpace_0", RustCsgReadSqliteAsciiSpace('0')):
        ok = false
    if ok:
        echo("testAsciiSpace ok")
    return ok

# ── Section: testTrimAsciiSpace ─────────────────────────────────────────

fn testTrimAsciiSpace(): bool =
    var ok: bool = true
    if !checkEq("trim_basic", RustCsgReadSqliteTrimAsciiSpace("  hello  "), "hello"):
        ok = false
    if !checkEq("trim_newline", RustCsgReadSqliteTrimAsciiSpace("\thello\n"), "hello"):
        ok = false
    if !checkEq("trim_empty", RustCsgReadSqliteTrimAsciiSpace(""), ""):
        ok = false
    if !checkEq("trim_ws_only", RustCsgReadSqliteTrimAsciiSpace("  \t  "), ""):
        ok = false
    if !checkEq("trim_nochange", RustCsgReadSqliteTrimAsciiSpace("hello"), "hello"):
        ok = false
    if !checkEq("trim_multi", RustCsgReadSqliteTrimAsciiSpace("\r\n  hello world  \n"), "hello world"):
        ok = false
    if ok:
        echo("testTrimAsciiSpace ok")
    return ok

# ── Section: testDistinctTitle ──────────────────────────────────────────

fn testDistinctTitle(): bool =
    var ok: bool = true
    # Empty title -> ""
    var r1: RustCsgStateDbThreadRowResult
    r1.title = ""
    r1.firstUserMessage = "hello"
    if !checkEq("distinct_emptyTitle", RustCsgReadSqliteDistinctTitle(r1), ""):
        ok = false
    # Title same as firstUserMessage -> ""
    var r2: RustCsgStateDbThreadRowResult
    r2.title = "hello"
    r2.firstUserMessage = "hello"
    if !checkEq("distinct_same", RustCsgReadSqliteDistinctTitle(r2), ""):
        ok = false
    # Title same but with whitespace -> ""
    var r3: RustCsgStateDbThreadRowResult
    r3.title = "  hello  "
    r3.firstUserMessage = "hello"
    if !checkEq("distinct_same_trim", RustCsgReadSqliteDistinctTitle(r3), ""):
        ok = false
    # Title different from firstUserMessage -> trimmed title
    var r4: RustCsgStateDbThreadRowResult
    r4.title = "  My Title  "
    r4.firstUserMessage = "different message"
    if !checkEq("distinct_diff", RustCsgReadSqliteDistinctTitle(r4), "My Title"):
        ok = false
    # FirstUserMessage empty, title non-empty -> trimmed title
    var r5: RustCsgStateDbThreadRowResult
    r5.title = "Lone Title"
    r5.firstUserMessage = ""
    if !checkEq("distinct_noFirstMsg", RustCsgReadSqliteDistinctTitle(r5), "Lone Title"):
        ok = false
    if ok:
        echo("testDistinctTitle ok")
    return ok

# ── Section: testThreadRowToAppThread ───────────────────────────────────

fn testThreadRowToAppThread(): bool =
    var ok: bool = true
    var row: RustCsgStateDbThreadRowResult
    row.ok = true
    row.id = "thread-abc-123"
    row.title = "My Thread"
    row.cwd = "/home/user/project"
    row.modelProvider = "anthropic"
    row.source = "cli"
    row.rolloutPath = "/tmp/rollouts/abc"
    row.createdAtMs = int64(1700000000123)
    row.updatedAtMs = int64(1700000050123)
    row.cliVersion = "1.2.3"
    row.firstUserMessage = "Hello, can you help me?"
    let thread = RustCsgReadSqliteThreadRowToAppThread(row)
    if !checkEq("thread_id", thread.id, "thread-abc-123"):
        ok = false
    if !checkEq("thread_sessionId", thread.sessionId, "thread-abc-123"):
        ok = false
    if !checkEq("thread_name", thread.name, "My Thread"):
        ok = false
    if !checkEq("thread_cwd", thread.cwd, "/home/user/project"):
        ok = false
    if !checkEq("thread_modelProvider", thread.modelProvider, "anthropic"):
        ok = false
    if !checkEq("thread_source", thread.source, "cli"):
        ok = false
    if !checkEq("thread_path", thread.path, "/tmp/rollouts/abc"):
        ok = false
    if !checkEq("thread_cliVersion", thread.cliVersion, "1.2.3"):
        ok = false
    if !checkEq("thread_preview", thread.preview, "Hello, can you help me?"):
        ok = false
    if !checkEq("thread_statusJson", thread.statusJson, "{\"type\":\"notLoaded\"}"):
        ok = false
    if !checkEq("thread_turnsJson", thread.turnsJson, "[]"):
        ok = false
    # timestamps in seconds (divide by 1000)
    if !checkInt64("thread_createdAt", thread.createdAt, int64(1700000000)):
        ok = false
    if !checkInt64("thread_updatedAt", thread.updatedAt, int64(1700000050)):
        ok = false
    # Name empty when title matches firstUserMessage
    var row2: RustCsgStateDbThreadRowResult
    row2.title = "same message"
    row2.firstUserMessage = "same message"
    let thread2 = RustCsgReadSqliteThreadRowToAppThread(row2)
    if !checkEq("thread_emptyName", thread2.name, ""):
        ok = false
    if ok:
        echo("testThreadRowToAppThread ok")
    return ok

