# ── Section: testFromStateDbBasic ───────────────────────────────────────

fn testFromStateDbBasic(): bool =
    var ok: bool = true
    var params: RustCsgThreadReadParams
    params.threadId = "my-thread"
    params.includeTurns = false
    let result = RustCsgReadSqliteFromStateDb(":memory:", params, "anthropic")
    if !checkTrue("basic_ok", result.ok):
        ok = false
    let thread = result.response.thread
    if !checkEq("basic_id", thread.id, "my-thread"):
        ok = false
    if !checkEq("basic_sessionId", thread.sessionId, "my-thread"):
        ok = false
    if !checkEq("basic_name", thread.name, "Test Thread"):
        ok = false
    if !checkEq("basic_cwd", thread.cwd, "/home/user/project"):
        ok = false
    if !checkEq("basic_modelProvider", thread.modelProvider, "anthropic"):
        ok = false
    if !checkEq("basic_source", thread.source, "cli"):
        ok = false
    if !checkEq("basic_cliVersion", thread.cliVersion, "1.2.3"):
        ok = false
    if !checkEq("basic_preview", thread.preview, "Hello, can you help me?"):
        ok = false
    if !checkEq("basic_status", thread.statusJson, "{\"type\":\"notLoaded\"}"):
        ok = false
    if !checkEq("basic_turns", thread.turnsJson, "[]"):
        ok = false
    # Verify JSON serialization
    let json = ThreadReadResponseToJson(result.response)
    if !checkTrue("basic_json_has_thread", Contains(json, "\"thread\":{")):
        ok = false
    if !checkTrue("basic_json_has_id", Contains(json, "\"id\":\"my-thread\"")):
        ok = false
    if !checkTrue("basic_json_has_sessionId", Contains(json, "\"sessionId\":\"my-thread\"")):
        ok = false
    if !checkTrue("basic_json_has_notLoaded", Contains(json, "\"status\":{\"type\":\"notLoaded\"}")):
        ok = false
    if !checkTrue("basic_json_has_empty_turns", Contains(json, "\"turns\":[]")):
        ok = false
    # Seconds timestamps (ms / 1000)
    if !checkTrue("basic_json_createdAt", Contains(json, "\"createdAt\":1700000000")):
        ok = false
    if !checkTrue("basic_json_updatedAt", Contains(json, "\"updatedAt\":1700000050")):
        ok = false
    if ok:
        echo("testFromStateDbBasic ok")
    return ok

# ── Section: testFromStateDbFallbackProvider ────────────────────────────

fn testFromStateDbFallbackProvider(): bool =
    var ok: bool = true
    var params: RustCsgThreadReadParams
    params.threadId = "stub-empty-provider"
    let result = RustCsgReadSqliteFromStateDb(":memory:", params, "custom-fallback")
    if !checkTrue("fallback_ok", result.ok):
        ok = false
    if !checkEq("fallback_provider", result.response.thread.modelProvider, "custom-fallback"):
        ok = false
    # Check that non-empty provider is NOT overwritten
    var params2: RustCsgThreadReadParams
    params2.threadId = "my-thread"
    let result2 = RustCsgReadSqliteFromStateDb(":memory:", params2, "override")
    if !checkTrue("fallback_noOverride_ok", result2.ok):
        ok = false
    if !checkEq("fallback_noOverride_provider", result2.response.thread.modelProvider, "anthropic"):
        ok = false
    if ok:
        echo("testFromStateDbFallbackProvider ok")
    return ok

# ── Section: testFromStateDbIncludeTurns ────────────────────────────────

fn testFromStateDbIncludeTurns(): bool =
    var ok: bool = true
    var params: RustCsgThreadReadParams
    params.threadId = "my-thread"
    params.includeTurns = true
    let result = RustCsgReadSqliteFromStateDb(":memory:", params, "anthropic")
    if !checkTrue("turns_ok", result.ok):
        ok = false
    if !checkTrue("turns_has_content", Contains(result.response.thread.turnsJson, "turn-1")):
        ok = false
    if !checkTrue("turns_has_user", Contains(result.response.thread.turnsJson, "userMessage")):
        ok = false
    if !checkTrue("turns_has_agent", Contains(result.response.thread.turnsJson, "agentMessage")):
        ok = false
    # Verify JSON includes turns array
    let json = ThreadReadResponseToJson(result.response)
    if !checkTrue("turns_json_has_turns_arr", Contains(json, "\"turns\":[")):
        ok = false
    if ok:
        echo("testFromStateDbIncludeTurns ok")
    return ok

# ── Section: testFromStateDbIncludeTurnsBlocked ─────────────────────────

fn testFromStateDbIncludeTurnsBlocked(): bool =
    var ok: bool = true
    # Missing rollout file
    var params: RustCsgThreadReadParams
    params.threadId = "stub-missing-rollout"
    params.includeTurns = true
    let result = RustCsgReadSqliteFromStateDb(":memory:", params, "anthropic")
    if !checkFalse("miss_ok", result.ok):
        ok = false
    let expected = "thread stub-missing-rollout is not materialized yet; includeTurns is unavailable before first user message"
    if !checkEq("miss_blocked", result.blockedReason, expected):
        ok = false
    if ok:
        echo("testFromStateDbIncludeTurnsBlocked ok")
    return ok

# ── Section: testFromStateDbIncludeTurnsError ───────────────────────────

fn testFromStateDbIncludeTurnsError(): bool =
    var ok: bool = true
    var params: RustCsgThreadReadParams
    params.threadId = "stub-error-rollout"
    params.includeTurns = true
    let result = RustCsgReadSqliteFromStateDb(":memory:", params, "openai")
    if !checkFalse("err_ok", result.ok):
        ok = false
    if !checkEq("err_blocked", result.blockedReason, "rollout parse error: invalid JSON"):
        ok = false
    if ok:
        echo("testFromStateDbIncludeTurnsError ok")
    return ok

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true
    if !testFactories(): allOk = false
    if !testThreadNotLoaded(): allOk = false
    if !testAsciiSpace(): allOk = false
    if !testTrimAsciiSpace(): allOk = false
    if !testDistinctTitle(): allOk = false
    if !testThreadRowToAppThread(): allOk = false
    if !testFromStateDbEmptyId(): allOk = false
    if !testFromStateDbNotFound(): allOk = false
    if !testFromStateDbError(): allOk = false
    if !testFromStateDbBasic(): allOk = false
    if !testFromStateDbFallbackProvider(): allOk = false
    if !testFromStateDbIncludeTurns(): allOk = false
    if !testFromStateDbIncludeTurnsBlocked(): allOk = false
    if !testFromStateDbIncludeTurnsError(): allOk = false
    if allOk:
        echo("rust_csg_thread_read_sqlite_relfacts_smoke ok")
        return 0
    else:
        echo("rust_csg_thread_read_sqlite_relfacts_smoke FAILED")
        return 1
