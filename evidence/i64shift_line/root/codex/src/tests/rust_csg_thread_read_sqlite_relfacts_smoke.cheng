        result.updatedAtMs = int64(1700000000999)
        result.cliVersion = "1.0.0"
        result.firstUserMessage = "test"
        return result
    if threadId == "stub-error-rollout":
        result.ok = true
        result.id = threadId
        result.title = "Error Rollout"
        result.cwd = "/tmp"
        result.modelProvider = "openai"
        result.source = "exec"
        result.rolloutPath = "/codex/rollouts/error_rollout.jsonl"
        result.createdAtMs = int64(1700000000888)
        result.updatedAtMs = int64(1700000000888)
        result.cliVersion = "1.0.1"
        result.firstUserMessage = "test error"
        return result
    if threadId == "stub-trim-title":
        result.ok = true
        result.id = threadId
        result.title = "  Hello World  "
        result.cwd = "/tmp"
        result.modelProvider = "anthropic"
        result.source = "cli"
        result.rolloutPath = "/codex/rollouts/trim.jsonl"
        result.createdAtMs = int64(1700000000777)
