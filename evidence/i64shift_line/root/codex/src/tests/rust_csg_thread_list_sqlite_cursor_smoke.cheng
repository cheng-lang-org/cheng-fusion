import std/sqlite
import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/protocol/wire
import cheng/codex/protocol/types

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteThreadListBulkRows")
fn RustCsgAddSqliteThreadListBulkRows(path: str): str

@abi_internal
@importc("RustCsgRfc3339ToMillisText")
fn RustCsgRfc3339ToMillisText(text: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertInt32(name: str, left: int32, right: int32) =
    if left != right:
        echo(name)
        echo(wire.RustCsgJsonFieldInt32("left", left))
        echo(wire.RustCsgJsonFieldInt32("right", right))
    assert(left == right, name)

fn assertOk(name: str, result: var thread_list_sqlite.RustCsgThreadListSqliteResult) =
    if !result.ok:
        echo(name)
        echo(result.error)
        echo(result.blockedReason)
    assert(result.ok, name)

fn main(): int32 =
    assertInt32("sqlite constant", sqlite.SqliteOk, 0)
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    checkEq("bulk_fixture_rows", RustCsgAddSqliteThreadListBulkRows(path), "")
    checkEq("cursor_parse", RustCsgRfc3339ToMillisText("2023-11-14T22:13:20.123Z"), "1700000000123")

    var cursorParams: types.RustCsgThreadListParams
    cursorParams.limitJson = "1"
    cursorParams.sortKey = "updated_at"
    cursorParams.sortDirection = "desc"
    cursorParams.archivedJson = "false"
    cursorParams.cursor = "2023-11-14T22:13:20.123Z"
    var cursorResult = thread_list_sqlite.RustCsgThreadListFromSqlite(path, cursorParams, "openai")
    assertOk("cursor_result", cursorResult)
    assertInt32("cursor_row_count", cursorResult.rowCount, 1)

    echo("rust_csg_thread_list_sqlite_cursor_smoke ok")
    return 0
