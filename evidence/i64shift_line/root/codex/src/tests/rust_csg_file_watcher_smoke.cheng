import cheng/codex/crates/file_watcher/file_watcher as fw
import std/strings as strings

# ═══════════════════════════════════════════════════════════════════════════════
# File Watcher — type definition constants smoke test
#
# Ported from codex-rs/file-watcher
# ═══════════════════════════════════════════════════════════════════════════════

fn testFileWatcherEventFields(): bool =
    if fw.RustCsgFileWatcherEventFieldCount != 1: return false
    if fw.RustCsgFileWatcherEventField1 != "paths": return false
    echo("testFileWatcherEventFields ok")
    return true

fn testWatchPathFields(): bool =
    if fw.RustCsgWatchPathFieldCount != 2: return false
    if fw.RustCsgWatchPathField1 != "path": return false
    if fw.RustCsgWatchPathField2 != "recursive": return false
    echo("testWatchPathFields ok")
    return true

fn testFileWatcherMethods(): bool =
    if fw.RustCsgFileWatcherMethodCount != 3: return false
    if fw.RustCsgFileWatcherMethod1 != "new": return false
    if fw.RustCsgFileWatcherMethod2 != "noop": return false
    if fw.RustCsgFileWatcherMethod3 != "add_subscriber": return false
    echo("testFileWatcherMethods ok")
    return true

fn testFileWatcherSubscriberMethods(): bool =
    if fw.RustCsgFileWatcherSubscriberMethodCount != 1: return false
    if fw.RustCsgFileWatcherSubscriberMethod1 != "register_paths": return false
    echo("testFileWatcherSubscriberMethods ok")
    return true

fn testClassifyFileChange(): bool =
    if fw.classifyFileChange("") != "unknown": return false
    if fw.classifyFileChange("CREATE /tmp/foo") != "create": return false
    if fw.classifyFileChange("create /tmp/foo") != "create": return false
    if fw.classifyFileChange("MODIFY /tmp/foo") != "modify": return false
    if fw.classifyFileChange("modify /tmp/foo") != "modify": return false
    if fw.classifyFileChange("DELETE /tmp/foo") != "delete": return false
    if fw.classifyFileChange("delete /tmp/foo") != "delete": return false
    if fw.classifyFileChange("RENAME /tmp/foo") != "rename": return false
    if fw.classifyFileChange("rename /tmp/foo") != "rename": return false
    if fw.classifyFileChange("UNKNOWN event") != "unknown": return false
    echo("testClassifyFileChange ok")
    return true

fn testMatchFilePattern(): bool =
    if !fw.matchFilePattern("foo.txt", "*.txt"): return false
    if !fw.matchFilePattern("bar.txt", "*.txt"): return false
    if fw.matchFilePattern("foo.txt", "*.md"): return false
    if !fw.matchFilePattern("abc", "a?c"): return false
    if fw.matchFilePattern("abcd", "a?c"): return false
    if !fw.matchFilePattern("hello.rs", "hello.*"): return false
    if !fw.matchFilePattern("", ""): return false
    if !fw.matchFilePattern("anything", "*"): return false
    echo("testMatchFilePattern ok")
    return true

fn testFileWatcherDebounce(): bool =
    # Empty input
    if fw.fileWatcherDebounce("", 100) != "": return false
    # WindowMs <= 0 returns input as-is
    if fw.fileWatcherDebounce("a.txt:create", 0) != "a.txt:create": return false
    # Duplicate within window: keep last
    var d1: str = fw.fileWatcherDebounce("a.txt:create,a.txt:modify", 100)
    if d1.len == 0: return false
    echo("testFileWatcherDebounce ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testFileWatcherEventFields(): allOk = false
    if !testWatchPathFields(): allOk = false
    if !testFileWatcherMethods(): allOk = false
    if !testFileWatcherSubscriberMethods(): allOk = false
    if !testClassifyFileChange(): allOk = false
    if !testMatchFilePattern(): allOk = false
    if !testFileWatcherDebounce(): allOk = false

    if allOk:
        echo("rust_csg_file_watcher_smoke ok")
        return 0
    else:
        echo("rust_csg_file_watcher_smoke FAILED")
        return 1