import std/sqlite
import cheng/codex/app_server/thread_list
import cheng/codex/app_server/thread_list_sqlite
import cheng/codex/config/home
import cheng/codex/config/user_config
import cheng/codex/exec/config
import cheng/codex/exec/operation
import cheng/codex/exec/plan
import cheng/codex/exec/prompt
import cheng/codex/exec/resume_lookup
import cheng/codex/exec/resume_lookup_sqlite
import cheng/codex/exec/schema
import cheng/codex/exec/session
import cheng/codex/exec/session_sqlite
import cheng/codex/protocol/wire
import cheng/codex/rollout/reader
import cheng/codex/state/state_db
import cheng/codex/state/state_db_sqlite
import cheng/codex/state/thread_store

@abi_internal
@importc("RustCsgCreateSqliteFixture")
fn RustCsgCreateSqliteFixture(): str

@abi_internal
@importc("RustCsgAddSqliteRelativeCwdRow")
fn RustCsgAddSqliteRelativeCwdRow(path: str): str

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn assertEmpty(name: str, value: str) =
    checkEq(name, value, "")

fn main(): int32 =
    assert(sqlite.SqliteOk == 0, "sqlite_probe")
    var configErr: str
    checkEq("config_probe", config.RustCsgExecConfigValueJsonFromRaw("true", configErr), "true")
    var schemaErr: str
    assert(schema.RustCsgExecSchemaValidateJson("{}", schemaErr), schemaErr)
    checkEq("home_probe", home.RustCsgPathJoinChild("/codex", "config.toml"), "/codex/config.toml")
    checkEq("user_config_probe",
               wire.RustCsgJsonFindStr(user_config.RustCsgEmptyUserConfigJson(), "model"),
               "")
    var promptErr: str
    checkEq("prompt_probe", prompt.RustCsgPromptResolve("probe", promptErr), "probe")
    checkEq("thread_list_probe",
               thread_list.RustCsgThreadListAllSourceKindsJson(),
               "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]")
    let stateDbProbe = state_db.RustCsgStateDbThreadListQueryPlanFromValues("/codex/sqlite",
                                                                           1,
                                                                           "created_at",
                                                                           "desc",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           "",
                                                                           false,
                                                                           "",
                                                                           "/repo")
    checkEq("state_db_probe", stateDbProbe.blockedReason, state_db.RustCsgStateDbQueryBlockedReason())
    assert(resume_lookup.RustCsgExecResumeLookupIsUuid("123e4567-e89b-12d3-a456-426614174000"), "resume_lookup_probe")
    checkEq("thread_list_sqlite_probe",
               thread_list_sqlite.RustCsgThreadListSqliteAllSourceKindsJson(),
               "[\"cli\",\"vscode\",\"exec\",\"appServer\",\"subAgent\",\"subAgentReview\",\"subAgentCompact\",\"subAgentThreadSpawn\",\"subAgentOther\",\"unknown\"]")
    checkEq("rollout_reader_probe", reader.RustCsgRolloutLatestTurnCwd(""), "")
    let sessionIndexProbe = thread_store.RustCsgSessionIndexParseLine("{\"id\":\"thread-probe\",\"thread_name\":\"probe\",\"updated_at\":\"2026-05-17T00:00:00Z\"}")
    checkEq("session_index_probe_id", sessionIndexProbe.id, "thread-probe")
    let path = RustCsgCreateSqliteFixture()
    assert(path != "", "fixture path")
    let repoCwd = "repo"
    let otherCwd = "other-repo"
    checkEq("relative_cwd_fixture", RustCsgAddSqliteRelativeCwdRow(path), "")

    let userConfigJson = "{\"model\":\"\",\"modelProvider\":\"openai\",\"approvalPolicy\":\"\",\"approvalsReviewer\":\"\",\"sandboxMode\":\"\",\"ossProvider\":\"\",\"profile\":\"\"}"
    var resumeLastPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--last", "continue work"])
    let initialProbe = operation.RustCsgExecInitialOperationFromPlan(resumeLastPlan)
    checkEq("operation_probe", initialProbe.kind, "resumeUserTurn")
    let lookupProbe = resume_lookup_sqlite.RustCsgExecResumeLastFromSqlite(path, resumeLastPlan, "openai")
    assert(lookupProbe.ok, "lookup_probe")
    let request = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(resumeLastPlan,
                                                                                       "unused-thread",
                                                                                       userConfigJson,
                                                                                       path)
    assertEmpty("resume_sqlite_parse", request.parseError)
    assertEmpty("resume_sqlite_blocked", request.blockedReason)
    checkEq("resume_sqlite_kind", request.kind, "resumeUserTurn")
    checkEq("resume_sqlite_thread", request.threadId, "thread-relative-cwd")
    checkEq("resume_sqlite_resume",
               request.threadResumeJson,
               wire.RustCsgCat3("{\"threadId\":\"thread-relative-cwd\",\"modelProvider\":\"openai\",\"cwd\":\"",
                                 repoCwd,
                                 "\",\"approvalPolicy\":\"never\",\"approvalsReviewer\":\"user\"}"))
    checkEq("resume_sqlite_turn",
               request.turnStartJson,
               wire.RustCsgCat3("{\"threadId\":\"thread-relative-cwd\",\"input\":[{\"type\":\"text\",\"text\":\"continue work\",\"textElements\":[]}],\"cwd\":\"",
                                 repoCwd,
                                 "\",\"approvalPolicy\":\"never\"}"))
    let sequenceJson = session.RustCsgExecRequestPlanToJson(request)
    checkEq("resume_sqlite_sequence_kind", wire.RustCsgJsonFindStr(sequenceJson, "kind"), "resumeUserTurn")
    assert(wire.RustCsgContains(sequenceJson, "\"method\":\"thread/resume\""), "sequence_has_resume")
    assert(wire.RustCsgContains(sequenceJson, "\"method\":\"turn/start\""), "sequence_has_turn")

    var explicitNamePlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", otherCwd, "resume", "--all", "anthropic thread", "continue named"])
    let explicitNameRequest = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(explicitNamePlan,
                                                                                                   "unused-thread",
                                                                                                   userConfigJson,
                                                                                                   path)
    assertEmpty("explicit_name_parse", explicitNameRequest.parseError)
    assertEmpty("explicit_name_blocked", explicitNameRequest.blockedReason)
    checkEq("explicit_name_thread", explicitNameRequest.threadId, "thread-4")
    checkEq("explicit_name_kind", explicitNameRequest.kind, "resumeUserTurn")
    assert(wire.RustCsgContains(explicitNameRequest.requestSequenceJson, "\"threadId\":\"thread-4\""), "explicit_name_sequence")

    var missingCwdPlan = plan.RustCsgExecParseArgs(["codex-exec", "resume", "--last", "continue work"])
    let missingCwd = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(missingCwdPlan,
                                                                                           "unused-thread",
                                                                                           userConfigJson,
                                                                                           path)
    checkEq("missing_cwd_blocked",
               missingCwd.blockedReason,
               "resume sqlite lookup requires canonical absolute cwd")

    var missingDbPlan = plan.RustCsgExecParseArgs(["codex-exec", "--cd", repoCwd, "resume", "--last", "continue work"])
    let missingDb = session_sqlite.RustCsgExecRequestPlanFromPlanWithUserConfigAndSqlite(missingDbPlan,
                                                                                         "unused-thread",
                                                                                         userConfigJson,
                                                                                         "")
    checkEq("missing_db_blocked", missingDb.blockedReason, "resume --last sqlite lookup requires state db path")

    echo("rust_csg_exec_session_sqlite_smoke ok")
    return 0
