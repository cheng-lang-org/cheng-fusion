import cheng/codex/config/home

fn checkEq(name: str, left: str, right: str) =
    if left != right:
        echo(name)
        echo(left)
        echo(right)
    assert(left == right, name)

fn main(): int32 =
    let codexHome = home.RustCsgGetEnv("RUST_CSG_CODEX_HOME_FIXTURE")
    let canonical = home.RustCsgGetEnv("RUST_CSG_CODEX_HOME_CANONICAL")
    assert(codexHome != "", "codex_home_fixture")
    assert(canonical != "", "codex_home_canonical")
    checkEq("env_fixture", home.RustCsgGetEnv("RUST_CSG_CODEX_HOME_FIXTURE"), codexHome)
    assert(home.RustCsgPathMetadataKind(codexHome) == 1, "codex_home_is_dir")
    checkEq("realpath_fixture", home.RustCsgRealPath(codexHome), canonical)
    assert(home.RustCsgPathIsAbsolute(codexHome), "codex_home_absolute")
    assert(!home.RustCsgPathIsAbsolute("relative/path"), "relative_home_rejected")
    echo("rust_csg_utils_home_dir_smoke ok")
    return 0
