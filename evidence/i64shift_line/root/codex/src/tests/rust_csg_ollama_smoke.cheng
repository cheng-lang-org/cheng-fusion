import cheng/codex/crates/ollama/ollama

fn main(): int32 =
    if ollama.RustCsgBuildOllamaPullRequest("llama3.2:3b") != "{\"model\":\"llama3.2:3b\",\"stream\":true}":
        return 1
    if ollama.RustCsgOllamaTagsUrl("http://localhost:11434/") != "http://localhost:11434/api/tags":
        return 1
    if ollama.RustCsgOllamaPullUrl("http://localhost:11434") != "http://localhost:11434/api/pull":
        return 1
    echo("rust_csg_ollama_smoke ok")
    return 0
