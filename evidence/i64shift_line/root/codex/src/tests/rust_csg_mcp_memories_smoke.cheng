import cheng/codex/crates/mcp_memories/mcp_memories as mm

# ═══════════════════════════════════════════════════════════════════════════════
# MCP Memories — type definition constants smoke test
#
# Ported from codex-rs/memories/mcp
# ═══════════════════════════════════════════════════════════════════════════════

fn testConstants(): bool =
    if mm.RustCsgMcpMemoriesDefaultListMaxResults != 2000: return false
    if mm.RustCsgMcpMemoriesMaxListResults != 2000: return false
    if mm.RustCsgMcpMemoriesDefaultSearchMaxResults != 200: return false
    if mm.RustCsgMcpMemoriesMaxSearchResults != 200: return false
    if mm.RustCsgMcpMemoriesDefaultReadMaxTokens != 20000: return false
    echo("testConstants ok")
    return true

fn testToolNames(): bool =
    if mm.RustCsgMcpMemoriesListToolName != "list": return false
    if mm.RustCsgMcpMemoriesReadToolName != "read": return false
    if mm.RustCsgMcpMemoriesSearchToolName != "search": return false
    echo("testToolNames ok")
    return true

fn testBackendMethods(): bool =
    if mm.RustCsgMcpMemoriesBackendMethodCount != 3: return false
    if mm.RustCsgMcpMemoriesBackendMethod1 != "list": return false
    if mm.RustCsgMcpMemoriesBackendMethod3 != "search": return false
    echo("testBackendMethods ok")
    return true

fn testMemoryEntryTypeVariants(): bool =
    if mm.RustCsgMcpMemoriesMemoryEntryTypeVariantCount != 2: return false
    if mm.RustCsgMcpMemoriesMemoryEntryTypeVariant1 != "File": return false
    if mm.RustCsgMcpMemoriesMemoryEntryTypeVariant2 != "Directory": return false
    echo("testMemoryEntryTypeVariants ok")
    return true

fn testSearchMatchModeVariants(): bool =
    if mm.RustCsgMcpMemoriesSearchMatchModeVariantCount != 3: return false
    if mm.RustCsgMcpMemoriesSearchMatchModeVariant1 != "All": return false
    if mm.RustCsgMcpMemoriesSearchMatchModeVariant3 != "Exact": return false
    echo("testSearchMatchModeVariants ok")
    return true

fn testServerFields(): bool =
    if mm.RustCsgMcpMemoriesServerFieldCount != 2: return false
    if mm.RustCsgMcpMemoriesServerField1 != "backend": return false
    if mm.RustCsgMcpMemoriesServerField2 != "tools": return false
    echo("testServerFields ok")
    return true

fn testBuildMcpMemoryQuery(): bool =
    if mm.buildMcpMemoryQuery("") != "{}": return false
    let q1 = mm.buildMcpMemoryQuery("hello")
    if q1 != "{\"query\":\"hello\"}": return false
    let q2 = mm.buildMcpMemoryQuery("say \"hi\"")
    if q2 != "{\"query\":\"say \\\"hi\\\"\"}": return false
    let q3 = mm.buildMcpMemoryQuery("a\\b")
    if q3 != "{\"query\":\"a\\\\b\"}": return false
    echo("testBuildMcpMemoryQuery ok")
    return true

fn testMcpMemoriesBuildToolResponse(): bool =
    # Empty results returns error response
    var r0: str = mm.mcpMemoriesBuildToolResponse("")
    if r0.len == 0: return false
    # Single result
    var r1: str = mm.mcpMemoriesBuildToolResponse("hello")
    if r1.len == 0: return false
    if r1[0] != 123: return false  # '{'
    if r1[r1.len - 1] != 125: return false  # '}'
    echo("testMcpMemoriesBuildToolResponse ok")
    return true

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testConstants(): allOk = false
    if !testToolNames(): allOk = false
    if !testBackendMethods(): allOk = false
    if !testMemoryEntryTypeVariants(): allOk = false
    if !testSearchMatchModeVariants(): allOk = false
    if !testServerFields(): allOk = false
    if !testBuildMcpMemoryQuery(): allOk = false
    if !testMcpMemoriesBuildToolResponse(): allOk = false

    if allOk:
        echo("rust_csg_mcp_memories_smoke ok")
        return 0
    else:
        echo("rust_csg_mcp_memories_smoke FAILED")
        return 1