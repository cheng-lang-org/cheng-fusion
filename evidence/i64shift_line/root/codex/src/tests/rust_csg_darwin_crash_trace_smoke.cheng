@abi_internal
@importc("RustCsgGetPid")
fn RustCsgGetPid(): int32

@abi_internal
@importc("RustCsgCrashTraceMark")
fn RustCsgCrashTraceMark(tag: str, a: int32, b: int32, c: int32, d: int32): int32

@abi_internal
@importc("raise")
fn raiseSignal(sig: int32): int32

fn main(): int32 =
    let _pid = RustCsgGetPid()
    let _mark = RustCsgCrashTraceMark("darwin-signal-smoke", 0, 0, 0, 0)
    let rc = raiseSignal(5)
    return rc
