import std/strings
import std/strutils as strutil
import cheng/codex/crates/rollout/rollout

# ═══════════════════════════════════════════════════════════════════════════════
# Smoke test: rollout — JSONL recorder with buffering
# ═══════════════════════════════════════════════════════════════════════════════

fn checkEqStr(got: str, expected: str, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=|", expected, "| got=|", got, "|"], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

fn checkEqI32(got: int32, expected: int32, label: str): bool =
    if got != expected:
        echo(strutil.Join([label, " FAIL: expected=", strings.Int64ToStr(int64(expected)),
                          " got=", strings.Int64ToStr(int64(got))], ""))
        return false
    echo(strutil.Join([label, " ok"], ""))
    return true

# ── JSONL line building tests ────────────────────────────────────────────

fn testBuildJsonlLineKV(): bool =
    var ok: bool = true
    let line = rollout.rolloutBuildJsonlLineKV("type", "session_meta")
    if !checkEqStr(line, "{\"type\":\"session_meta\"}\n", "buildJsonlLineKV"):
        ok = false
    if ok:
        echo("testBuildJsonlLineKV ok")
    return ok

# ── Recorder operations tests ────────────────────────────────────────────

fn testRecorderInit(): bool =
    var ok: bool = true
    let r = rollout.rolloutRecorderInit()
    if !checkEqI32(r.buffer.len, 0, "recorder init buffer empty"): ok = false
    if !checkEqI32(r.lineCount, 0, "recorder init lineCount"): ok = false
    if !checkEqI32(r.flushSize, 4096, "recorder init flushSize"): ok = false
    if ok:
        echo("testRecorderInit ok")
    return ok

fn testRecorderAppendAndBufferSize(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInit()
    let sz1 = rollout.rolloutRecorderAppendKV(r, "type", "test")
    if !checkEqI32(sz1, 16, "recorder append size"): ok = false
    if !checkEqI32(r.lineCount, 1, "recorder lineCount after 1"): ok = false
    let sz2 = rollout.rolloutRecorderAppendKV(r, "seq", "2")
    if !checkEqI32(sz2, 28, "recorder append size after 2"): ok = false
    if !checkEqI32(r.lineCount, 2, "recorder lineCount after 2"): ok = false
    if ok:
        echo("testRecorderAppendAndBufferSize ok")
    return ok

fn testRecorderFlush(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInit()
    let _ = rollout.rolloutRecorderAppendKV(r, "key", "val")
    let flushed = rollout.rolloutRecorderFlush(r)
    if !checkEqStr(flushed, "{\"key\":\"val\"}\n", "recorder flush content"): ok = false
    if !checkEqI32(r.buffer.len, 0, "recorder buffer empty after flush"): ok = false
    if !checkEqI32(r.flushedCount, 1, "recorder flushedCount after flush"): ok = false
    if !checkEqI32(r.totalBytesWritten, 14, "recorder totalBytes after flush"): ok = false
    if ok:
        echo("testRecorderFlush ok")
    return ok

fn testRecorderAutoFlush(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInitWithFlushSize(10)
    let flushed1 = rollout.rolloutRecorderRecord(r, "short\n")
    if !checkEqStr(flushed1, "", "recorder autoFlush no flush yet"): ok = false
    let flushed2 = rollout.rolloutRecorderRecord(r, "data\n")
    if !checkEqStr(flushed2, "short\ndata\n", "recorder autoFlush content"): ok = false
    if !checkEqI32(r.buffer.len, 0, "recorder buffer empty after autoFlush"): ok = false
    if ok:
        echo("testRecorderAutoFlush ok")
    return ok

fn testRecorderEmptyFlush(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInit()
    let flushed = rollout.rolloutRecorderFlush(r)
    if !checkEqStr(flushed, "", "recorder empty flush returns empty"): ok = false
    if ok:
        echo("testRecorderEmptyFlush ok")
    return ok

fn testRecorderAppendJson(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInit()
    let _ = rollout.rolloutRecorderAppendJson(r, "{\"a\":1}")
    if !checkEqStr(r.buffer, "{\"a\":1}\n", "recorder appendJson adds newline"): ok = false
    if ok:
        echo("testRecorderAppendJson ok")
    return ok

fn testRecorderAppendJsonWithNewline(): bool =
    var ok: bool = true
    var r = rollout.rolloutRecorderInit()
    let _ = rollout.rolloutRecorderAppendJson(r, "{\"a\":1}\n")
    if !checkEqStr(r.buffer, "{\"a\":1}\n", "recorder appendJson no double newline"): ok = false
    if ok:
        echo("testRecorderAppendJsonWithNewline ok")
    return ok

# ── JSON escaping tests ──────────────────────────────────────────────────

fn testEscapeJson(): bool =
    var ok: bool = true
    if !checkEqStr(rollout.rolloutEscapeJson("hello"), "hello", "escape plain"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a\"b"), "a\\\"b", "escape double quote"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a\\b"), "a\\\\b", "escape backslash"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a\nb"), "a\\nb", "escape newline"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a\rb"), "a\\rb", "escape carriage return"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a\tb"), "a\\tb", "escape tab"): ok = false
    if !checkEqStr(rollout.rolloutEscapeJson("a/b"), "a\\/b", "escape slash"): ok = false
    if ok:
        echo("testEscapeJson ok")
    return ok

# ── Init with flush size tests ───────────────────────────────────────────

fn testRecorderInitWithInvalidFlushSize(): bool =
    var ok: bool = true
    let r = rollout.rolloutRecorderInitWithFlushSize(-1)
    if !checkEqI32(r.flushSize, 4096, "init with negative flushSize uses default"): ok = false
    let r2 = rollout.rolloutRecorderInitWithFlushSize(9999999)
    if !checkEqI32(r2.flushSize, 4096, "init with too large flushSize uses default"): ok = false
    let r3 = rollout.rolloutRecorderInitWithFlushSize(256)
    if !checkEqI32(r3.flushSize, 256, "init with valid flushSize"): ok = false
    if ok:
        echo("testRecorderInitWithInvalidFlushSize ok")
    return ok

# ── Session index parsing tests ──────────────────────────────────────────

fn testParseSessionIndex(): bool =
    var ok: bool = true
    let line = "{\"sessionId\":\"sess-abc\",\"timestamp\":\"2026-05-21T10:00:00Z\",\"model\":\"gpt-5\"}"
    let entry = rollout.rolloutParseSessionIndex(line)
    if !checkEqStr(entry.sessionId, "sess-abc", "parseSessionId"): ok = false
    if !checkEqStr(entry.timestamp, "2026-05-21T10:00:00Z", "parseTimestamp"): ok = false
    if !checkEqStr(entry.model, "gpt-5", "parseModel"): ok = false
    # Empty line
    let entry2 = rollout.rolloutParseSessionIndex("")
    if !checkEqStr(entry2.sessionId, "", "parseEmptySessionId"): ok = false
    if ok:
        echo("testParseSessionIndex ok")
    return ok

fn testFilterByDate(): bool =
    var ok: bool = true
    var entries: rollout.RolloutSessionEntry[]
    var e1: rollout.RolloutSessionEntry
    e1.sessionId = "a"
    e1.timestamp = "2026-05-21"
    add(entries, e1)
    var e2: rollout.RolloutSessionEntry
    e2.sessionId = "b"
    e2.timestamp = "2026-05-22"
    add(entries, e2)
    var e3: rollout.RolloutSessionEntry
    e3.sessionId = "c"
    e3.timestamp = "2026-05-23"
    add(entries, e3)
    let filtered = rollout.rolloutFilterByDate(entries, "2026-05-22", "2026-05-22")
    if !checkEqI32(filtered.len, 1, "filterDateSingle"): ok = false
    if filtered.len >= 1 && !checkEqStr(filtered[0].sessionId, "b", "filterDateSessionId"): ok = false
    let filteredAll = rollout.rolloutFilterByDate(entries, "", "")
    if !checkEqI32(filteredAll.len, 3, "filterDateAll"): ok = false
    let filteredNone = rollout.rolloutFilterByDate(entries, "2026-05-30", "")
    if !checkEqI32(filteredNone.len, 0, "filterDateNone"): ok = false
    if ok:
        echo("testFilterByDate ok")
    return ok

# ── Main ──────────────────────────────────────────────────────────────────

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    if !testBuildJsonlLineKV(): allOk = false
    if !testRecorderInit(): allOk = false
    if !testRecorderAppendAndBufferSize(): allOk = false
    if !testRecorderFlush(): allOk = false
    if !testRecorderAutoFlush(): allOk = false
    if !testRecorderEmptyFlush(): allOk = false
    if !testRecorderAppendJson(): allOk = false
    if !testRecorderAppendJsonWithNewline(): allOk = false
    if !testEscapeJson(): allOk = false
    if !testRecorderInitWithInvalidFlushSize(): allOk = false
    if !testParseSessionIndex(): allOk = false
    if !testFilterByDate(): allOk = false

    if allOk:
        echo("rust_csg_rollout_recorder_smoke ok")
        return 0
    else:
        echo("rust_csg_rollout_recorder_smoke FAILED")
        return 1
