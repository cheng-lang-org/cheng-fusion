import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/chat_composer_footer_mode_oracle as oracle

fn RustCsgTuiChatComposerFooterModeExpr(): str =
    return "terminal.backend()"

fn RustCsgTuiChatComposerFooterModeOracleCheck(path: str, fixture: str, name: str): int32 =
    let s = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !s.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", path, ": ", s.error], ""))
        return 1
    if s.source != "tui/src/bottom_pane/chat_composer.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", s.source], ""))
        return 1
    if s.expression != RustCsgTuiChatComposerFooterModeExpr():
        echo(strutil.Join(["FAIL: ", name, " expr: ", s.expression], ""))
        return 1
    if fixture != s.body:
        echo(strutil.Join(["FAIL: ", name, " byte mismatch expected=", strings.IntToStr(s.bodyByteLen), " got=", strings.IntToStr(strings.Len(fixture))], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() != 9:
        echo("FAIL usage: rust_csg_tui_chat_composer_footer_mode_oracle_smoke <8 snapshot paths>")
        return 1

    var exitCode: int32 = 0
    var argIdx: int32 = 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeCtrlCQuitSnapshot(), "footer_mode_ctrl_c_quit")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeCtrlCInterruptSnapshot(), "footer_mode_ctrl_c_interrupt")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeCtrlCThenEscHintSnapshot(), "footer_mode_ctrl_c_then_esc_hint")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeHiddenWhileTypingSnapshot(), "footer_mode_hidden_while_typing")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeShortcutOverlaySnapshot(), "footer_mode_shortcut_overlay")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeOverlayThenExternalEscHintSnapshot(), "footer_mode_overlay_then_external_esc_hint")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeEscHintBacktrackSnapshot(), "footer_mode_esc_hint_backtrack")
    argIdx = argIdx + 1
    exitCode = exitCode + RustCsgTuiChatComposerFooterModeOracleCheck(cmdline.argStr(argIdx), oracle.RustCsgTuiChatComposerFooterModeEscHintFromOverlaySnapshot(), "footer_mode_esc_hint_from_overlay")

    if exitCode == 0:
        echo("rust_csg_tui_chat_composer_footer_mode_oracle_smoke ok")
    else:
        echo("rust_csg_tui_chat_composer_footer_mode_oracle_smoke FAILED")
    return exitCode
