import cheng/codex/crates/execpolicy_legacy/execpolicy_legacy as el

fn main(): int32 =
    # Test exit code constants
    if el.RustCsgExecpolicyMatchedButWritesFilesExitCode != 12:
        echo("FAIL: matched-but-writes exit code")
        return 1
    if el.RustCsgExecpolicyMightBeSafeExitCode != 13:
        echo("FAIL: might-be-safe exit code")
        return 1
    if el.RustCsgExecpolicyForbiddenExitCode != 14:
        echo("FAIL: forbidden exit code")
        return 1

    # Test result constants
    if el.RustCsgExecpolicyResultSafe != 0:
        echo("FAIL: result safe")
        return 1
    if el.RustCsgExecpolicyResultMatch != 1:
        echo("FAIL: result match")
        return 1
    if el.RustCsgExecpolicyResultForbidden != 2:
        echo("FAIL: result forbidden")
        return 1
    if el.RustCsgExecpolicyResultUnverified != 3:
        echo("FAIL: result unverified")
        return 1

    # Test exit code mapping
    if el.RustCsgExecpolicyExitCodeForResult(el.RustCsgExecpolicyResultSafe, false) != 0:
        echo("FAIL: safe exit code")
        return 1
    if el.RustCsgExecpolicyExitCodeForResult(el.RustCsgExecpolicyResultForbidden, true) != el.RustCsgExecpolicyForbiddenExitCode:
        echo("FAIL: forbidden+requireSafe exit code")
        return 1
    if el.RustCsgExecpolicyExitCodeForResult(el.RustCsgExecpolicyResultUnverified, true) != el.RustCsgExecpolicyMightBeSafeExitCode:
        echo("FAIL: unverified+requireSafe exit code")
        return 1

    echo("rust_csg_execpolicy_legacy_smoke ok")
    return 0
