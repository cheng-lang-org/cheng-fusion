# HTTP client smoke test - imports http module and makes real HTTP requests
import std/cmdline
import std/strings
import cheng/codex/net/http_client
import cheng/codex/std/http

fn checkOk(name: str, result: http.HttpResult) =
    if !result.ok:
        echo(strings.ConcatStr(name, " FAILED"))
        echo(strings.ConcatStr("  error: ", result.error))
        echo(strings.ConcatStr("  status: ", strings.IntToStr(result.statusCode)))
    assert(result.ok, name)

fn main(): int32 =
    assert(cmdline.argCount() >= 2, "mock HTTP base URL argument required")
    let baseUrl: str = cmdline.argStr(1)
    assert(baseUrl != "", "mock HTTP base URL must not be empty")

    echo("--- HTTP GET test ---")
    let getUrl: str = strings.ConcatStr(baseUrl, "/get")
    var getResult: http.HttpResult = http.HttpGet(getUrl, "[\"X-Smoke: codex-http\"]")
    checkOk("http_get", getResult)
    echo(strings.ConcatStr("  status: ", strings.IntToStr(getResult.statusCode)))
    assert(getResult.statusCode == 200, "http_get status should be 200")
    assert(strings.StrContains(getResult.body, "local-http-get-ok"), "http_get body should contain local marker")
    echo(strings.ConcatStr("  body length: ", strings.IntToStr(strings.Len(getResult.body))))

    echo("--- HTTP POST test ---")
    let postUrl: str = strings.ConcatStr(baseUrl, "/post")
    var postResult: http.HttpResult = http.HttpPost(postUrl, "test_body_data", "[\"X-Smoke: codex-http\",\"Content-Type: text/plain\"]")
    checkOk("http_post", postResult)
    echo(strings.ConcatStr("  status: ", strings.IntToStr(postResult.statusCode)))
    assert(postResult.statusCode == 200, "http_post status should be 200")
    assert(strings.StrContains(postResult.body, "test_body_data"), "http_post body should echo test data")
    echo(strings.ConcatStr("  body length: ", strings.IntToStr(strings.Len(postResult.body))))

    echo("--- HttpClient wrapper GET test ---")
    let clientGetUrl: str = strings.ConcatStr(baseUrl, "/client-get")
    var clientGetResult = http_client.HttpClientGet(clientGetUrl, "token-http-smoke")
    assert(clientGetResult.statusCode == 200, "http_client_get status should be 200")
    assert(strings.StrContains(clientGetResult.body, "local-http-client-get-ok"), "http_client_get body should contain local marker")

    echo("--- HttpClient wrapper POST test ---")
    let clientPostUrl: str = strings.ConcatStr(baseUrl, "/client-post")
    var clientPostResult = http_client.HttpClientPost(clientPostUrl, "{\"test\":true}", "token-http-smoke")
    assert(clientPostResult.statusCode == 200, "http_client_post status should be 200")
    assert(strings.StrContains(clientPostResult.body, "local-http-client-post-ok"), "http_client_post body should contain local marker")

    echo("--- Connection refused (error handling) ---")
    var errResult: http.HttpResult = http.HttpGet("http://localhost:1/", "[]")
    assert(!errResult.ok, "connection refused should fail")
    echo(strings.ConcatStr("  error (expected): ", errResult.error))

    echo("")
    echo("rust_csg_http_smoke ok")
    return 0
