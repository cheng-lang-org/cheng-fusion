import std/system
import std/strutils as strutil
import cheng/codex/model_provider/chat as chat
import cheng/codex/protocol/wire as wire

@abi_internal
@importc("RustCsgGetEnvRaw")
fn chatSmokeGetEnvRaw(name: cstring): cstring

fn chatSmokeGetEnv(name: cstring): str =
    let raw: cstring = chatSmokeGetEnvRaw(name)
    if raw == nil:
        return ""
    return system.StrFromCStringBorrow(raw)

fn checkContains(haystack: str, needle: str, label: str): bool =
    if strutil.Contains(haystack, needle):
        echo("  ok")
        return true
    echo("FAIL: missing expected text")
    return false

fn main(): int32 =
    var mockUrl: str
    mockUrl = chatSmokeGetEnv("GLM_CHAT_SMOKE_MOCK_URL")
    if mockUrl == "":
        mockUrl = "http://127.0.0.1:9999"
    echo("Mock URL configured")

    var allOk: bool = true

    # Test 1: BuildUserMessage
    let userMsg = chat.BuildUserMessage("Hello, world!")
    if !checkContains(userMsg, "\"role\":\"user\"", "BuildUserMessage role"): allOk = false
    if !checkContains(userMsg, "Hello, world!", "BuildUserMessage content"): allOk = false

    # Test 2: BuildTool
    let tool = chat.BuildTool("get_weather", "Get weather for a city", "{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}}}")
    if !checkContains(tool, "get_weather", "BuildTool name"): allOk = false
    if !checkContains(tool, "\"type\":\"function\"", "BuildTool type"): allOk = false

    # Test 3: BuildToolMessage
    let toolMsg = chat.BuildToolMessage("The weather is sunny", "call_abc123")
    if !checkContains(toolMsg, "\"role\":\"tool\"", "BuildToolMessage role"): allOk = false
    if !checkContains(toolMsg, "call_abc123", "BuildToolMessage tool_call_id"): allOk = false

    # Test 4: BuildChatRequestBody
    let msg1 = chat.BuildUserMessage("Hi")
    let msgs = chat.BuildMessagesArray(1, msg1, "", "", "", "", "", "", "")
    let body = chat.BuildChatRequestBody("gpt-4", msgs, "", false, 0, "")
    if !checkContains(body, "\"model\":\"gpt-4\"", "BuildChatRequestBody model"): allOk = false
    if !checkContains(body, "\"messages\":", "BuildChatRequestBody messages"): allOk = false

    # Test 5: BuildChatRequestBody with options
    let body2 = chat.BuildChatRequestBody("gpt-4", msgs, "", true, 4096, "0.7")
    if !checkContains(body2, "\"stream\":true", "BuildChatRequestBody stream"): allOk = false
    if !checkContains(body2, "\"max_tokens\":4096", "BuildChatRequestBody max_tokens"): allOk = false
    if !checkContains(body2, "0.7", "BuildChatRequestBody temperature"): allOk = false

    # Test 6: BuildChatRequestBody with tools
    let tools = chat.BuildToolsArray(1, tool, "", "", "")
    let body3 = chat.BuildChatRequestBody("gpt-4", msgs, tools, false, 0, "")
    if !checkContains(body3, "\"tools\":", "BuildChatRequestBody tools"): allOk = false

    # Test 7: GLM-5.2 native OpenAI-compatible body
    let glmBody = chat.BuildGlmChatRequestBody("glm-5.2", msgs, tools, true, true, 65536, "1.0", true, "max", true)
    if !checkContains(glmBody, "\"model\":\"glm-5.2\"", "BuildGlmChatRequestBody model"): allOk = false
    if !checkContains(glmBody, "\"thinking\":{\"type\":\"enabled\"}", "BuildGlmChatRequestBody thinking"): allOk = false
    if !checkContains(glmBody, "\"reasoning_effort\":\"max\"", "BuildGlmChatRequestBody effort"): allOk = false
    if !checkContains(glmBody, "\"tool_stream\":true", "BuildGlmChatRequestBody tool_stream"): allOk = false
    if !checkContains(glmBody, "\"response_format\":{\"type\":\"json_object\"}", "BuildGlmChatRequestBody json mode"): allOk = false

    # Test 8: GLM Anthropic Messages body for Claude Code-compatible endpoint
    let anthropicMsgs = "[{\"role\":\"user\",\"content\":\"Hi\"}]"
    let anthropicBody = chat.BuildAnthropicMessagesRequestBody("glm-5.2[1m]", "Be concise", anthropicMsgs, "", true, 65536, true, "max")
    if !checkContains(anthropicBody, "\"model\":\"glm-5.2[1m]\"", "BuildAnthropicMessagesRequestBody model"): allOk = false
    if !checkContains(anthropicBody, "\"system\":\"Be concise\"", "BuildAnthropicMessagesRequestBody system"): allOk = false
    if !checkContains(anthropicBody, "\"max_tokens\":65536", "BuildAnthropicMessagesRequestBody max_tokens"): allOk = false

    # Test 9: Real chat completion against mock server
    var response: str
    var error: str
    chat.RustCsgModelChatWithUrl("gpt-4", msgs, "", mockUrl, response, error)
    if error != "":
        echo("  ok: chat error expected")
    elif response != "":
        if !checkContains(response, "Hello! How can I help you?", "ChatWithUrl response content"): allOk = false
    else:
        echo("  ok: chat empty response (mock may not be running)")

    # Test 10: GLM native chat completion against mock server
    var glmResponse: str
    var glmError: str
    chat.RustCsgModelGlmChatWithUrl("glm-5.2", msgs, "sk-glm-test", mockUrl, true, "max", 65536, false, glmResponse, glmError)
    if glmError != "":
        echo("  ok: glm chat error expected")
    elif glmResponse != "":
        if !checkContains(glmResponse, "Hello! How can I help you?", "GlmChatWithUrl response content"): allOk = false
    else:
        echo("  ok: glm chat empty response (mock may not be running)")

    # Test 11: Anthropic Messages completion against mock server
    var anthropicResponse: str
    var anthropicError: str
    chat.RustCsgModelAnthropicMessagesWithUrl("glm-5.2[1m]", "Be concise", anthropicMsgs, "sk-glm-test", mockUrl, 65536, true, "max", anthropicResponse, anthropicError)
    if anthropicError != "":
        echo("  ok: anthropic chat error expected")
    elif anthropicResponse != "":
        if !checkContains(anthropicResponse, "Anthropic hello", "AnthropicMessagesWithUrl response text"): allOk = false
    else:
        echo("  ok: anthropic empty response (mock may not be running)")

    # Test 12: Real stream completion
    var streamResponse: str
    var streamError: str
    chat.RustCsgModelChatStream("gpt-4", msgs, "", mockUrl, streamResponse, streamError)
    if streamError != "":
        echo("  ok: stream error expected")
    elif streamResponse != "":
        echo("  ok: stream response")
    else:
        echo("  ok: stream empty (mock may not be running)")

    if allOk:
        echo("rust_csg_model_provider_chat_smoke ok")
        return 0
    echo("rust_csg_model_provider_chat_smoke FAILED")
    return 1
