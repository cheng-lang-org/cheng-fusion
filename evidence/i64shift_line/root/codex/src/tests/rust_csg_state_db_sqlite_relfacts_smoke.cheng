fn testCount(dbPath: str): bool =
    let result = state_db_sqlite.RustCsgStateDbCountVisibleThreads(dbPath)
    if !checkTrue("countOk", result.ok): return false
    if !checkTrue("count10", result.count == 10): return false
    echo("testCount ok")
    return true

fn testFirstVisible(dbPath: str): bool =
    let row = state_db_sqlite.RustCsgStateDbFirstVisibleThread(dbPath)
    if !checkTrue("firstOk", row.ok): return false
    if !checkStr("firstId", "thread-1", row.id): return false
    if !checkStr("firstTitle", "demo thread", row.title): return false
    if !checkStr("firstSource", "cli", row.source): return false
    echo("testFirstVisible ok")
    return true

fn testVisibleThreadAtOffset(dbPath: str): bool =
    # Updated_at DESC: thread-1 (1700000000123), thread-3 (1700000000111), thread-4 (1700000000110)
    let row0 = state_db_sqlite.RustCsgStateDbVisibleThreadAt(dbPath, "updated_at", "desc", false, 0)
    if !checkTrue("vtAt0Ok", row0.ok): return false
    if !checkStr("vtAt0Id", "thread-1", row0.id): return false
    let row1 = state_db_sqlite.RustCsgStateDbVisibleThreadAt(dbPath, "updated_at", "desc", false, 1)
    if !checkTrue("vtAt1Ok", row1.ok): return false
    if !checkStr("vtAt1Id", "thread-3", row1.id): return false
    let row2 = state_db_sqlite.RustCsgStateDbVisibleThreadAt(dbPath, "updated_at", "desc", false, 2)
    if !checkTrue("vtAt2Ok", row2.ok): return false
    if !checkStr("vtAt2Id", "thread-4", row2.id): return false
    # Created_at ASC: earliest first
    let early = state_db_sqlite.RustCsgStateDbVisibleThreadAt(dbPath, "created_at", "asc", false, 0)
    if !checkTrue("vtAtEarlyOk", early.ok): return false
    if !checkStr("vtAtEarlyId", "thread-subagent-other", early.id): return false
    # Error: invalid offset returns error row
    let badOff = state_db_sqlite.RustCsgStateDbVisibleThreadAt(dbPath, "updated_at", "desc", false, 3)
    if !checkTrue("vtAtBadOffNotOk", !badOff.ok): return false
    if !checkStr("vtAtBadOffErr", "unsupported state db visible thread sort or offset", badOff.error): return false
    echo("testVisibleThreadAtOffset ok")
    return true

fn testVisibleThreadAfter(dbPath: str): bool =
    # After thread-1 (updated=1700000000123) in DESC order: next is thread-3 (1700000000111)
    let row = state_db_sqlite.RustCsgStateDbVisibleThreadAfter(dbPath, "updated_at", "desc", "1700000000123", 0)
    if !checkTrue("vtAfterDesc0Ok", row.ok): return false
    if !checkStr("vtAfterDesc0Id", "thread-3", row.id): return false
    # Same cursor, offset 1: thread-4 (1700000000110)
    let row1 = state_db_sqlite.RustCsgStateDbVisibleThreadAfter(dbPath, "updated_at", "desc", "1700000000123", 1)
    if !checkTrue("vtAfterDesc1Ok", row1.ok): return false
    if !checkStr("vtAfterDesc1Id", "thread-4", row1.id): return false
    # After earliest in ASC direction: thread-subagent-spawn
    let rowAsc = state_db_sqlite.RustCsgStateDbVisibleThreadAfter(dbPath, "created_at", "asc", "1699999991000", 0)
    if !checkTrue("vtAfterAsc0Ok", rowAsc.ok): return false
    if !checkStr("vtAfterAsc0Id", "thread-subagent-spawn", rowAsc.id): return false
    # Cursor below all values: not found
    let past = state_db_sqlite.RustCsgStateDbVisibleThreadAfter(dbPath, "updated_at", "desc", "0", 0)
    if !checkTrue("vtAfterPastNotFound", past.notFound): return false
    if !checkTrue("vtAfterPastNotOk", !past.ok): return false
    # Error: invalid sort returns error
    let bad = state_db_sqlite.RustCsgStateDbVisibleThreadAfter(dbPath, "invalid", "desc", "1700000000123", 0)
    if !checkTrue("vtAfterBadNotOk", !bad.ok): return false
    echo("testVisibleThreadAfter ok")
    return true

fn testThreadById(dbPath: str): bool =
    # Visible thread by ID
    let row = state_db_sqlite.RustCsgStateDbThreadById(dbPath, "thread-1")
    if !checkTrue("tbiVisibleOk", row.ok): return false
    if !checkStr("tbiVisibleId", "thread-1", row.id): return false
    if !checkStr("tbiVisibleTitle", "demo thread", row.title): return false
    # Non-existent thread → not found
    let missing = state_db_sqlite.RustCsgStateDbThreadById(dbPath, "nonexistent")
    if !checkTrue("tbiMissingNotFound", missing.notFound): return false
    if !checkTrue("tbiMissingNotOk", !missing.ok): return false
    # IncludingArchived finds archived thread
    let archived = state_db_sqlite.RustCsgStateDbThreadByIdIncludingArchived(dbPath, "thread-5")
    if !checkTrue("tbiArchivedOk", archived.ok): return false
    if !checkStr("tbiArchivedId", "thread-5", archived.id): return false
    if !checkStr("tbiArchivedTitle", "archived thread", archived.title): return false
    # ThreadById (not IncludingArchived) should NOT find archived thread-5
    let archivedHidden = state_db_sqlite.RustCsgStateDbThreadById(dbPath, "thread-5")
    if !checkTrue("tbiHiddenNotFound", archivedHidden.notFound): return false
    if !checkTrue("tbiHiddenNotOk", !archivedHidden.ok): return false
    echo("testThreadById ok")
    return true

fn testExactTitle(dbPath: str): bool =
    # Title + cwd match
    let row = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath, "demo thread", "/repo")
    if !checkTrue("etFoundOk", row.ok): return false
    if !checkStr("etFoundId", "thread-1", row.id): return false
    # Different cwd
    let row4 = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath, "anthropic thread", "/other-repo")
    if !checkTrue("etAnthropicOk", row4.ok): return false
    if !checkStr("etAnthropicId", "thread-4", row4.id): return false
    # With empty cwd (finds without cwd filter)
    let rowNoCwd = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath, "demo thread", "")
    if !checkTrue("etNoCwdOk", rowNoCwd.ok): return false
    if !checkStr("etNoCwdId", "thread-1", rowNoCwd.id): return false
    # Nonexistent title → not found
    let missing = state_db_sqlite.RustCsgStateDbExactTitleThreadMaybeCwd(dbPath, "nonexistent title", "/repo")
    if !checkTrue("etNotFound", missing.notFound): return false
    if !checkTrue("etNotOk", !missing.ok): return false
    echo("testExactTitle ok")
    return true

fn testDynamicPage(dbPath: str): bool =
    # Unfiltered page with scanLimit=3 → 3 rows
    let page = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                   "updated_at",
                                                                                   "desc",
                                                                                   false,
                                                                                   "",
                                                                                   "",
                                                                                   "",
                                                                                   "",
                                                                                   "",
                                                                                   3)
    if !checkTrue("dynPageOk", page.ok): return false
    if !checkEq("dynPageLen", 3, page.rows.len): return false
    if page.rows.len >= 1:
        if !checkStr("dynPage0Id", "thread-1", page.rows[0].id): return false
    if page.rows.len >= 2:
        if !checkStr("dynPage1Id", "thread-3", page.rows[1].id): return false
    if page.rows.len >= 3:
        if !checkStr("dynPage2Id", "thread-4", page.rows[2].id): return false
    # Filtered by source cli, scanLimit=10 → 3 cli threads
    let pageCli = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                      "updated_at",
                                                                                      "desc",
                                                                                      false,
                                                                                      "[\"cli\"]",
                                                                                      "",
                                                                                      "",
                                                                                      "",
                                                                                      "",
                                                                                      10)
    if !checkTrue("dynCliOk", pageCli.ok): return false
    if !checkEq("dynCliLen", 3, pageCli.rows.len): return false
    if pageCli.rows.len >= 1:
        if !checkStr("dynCli0Id", "thread-1", pageCli.rows[0].id): return false
    if pageCli.rows.len >= 2:
        if !checkStr("dynCli1Id", "thread-4", pageCli.rows[1].id): return false
    if pageCli.rows.len >= 3:
        if !checkStr("dynCli2Id", "thread-2", pageCli.rows[2].id): return false
    # Filtered by model provider, scanLimit=10 → 1 anthropic thread (thread-4)
    let pageAnthropic = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                            "updated_at",
                                                                                            "desc",
                                                                                            false,
                                                                                            "",
                                                                                            "[\"anthropic\"]",
                                                                                            "",
                                                                                            "",
                                                                                            "",
                                                                                            10)
    if !checkTrue("dynAnthropicOk", pageAnthropic.ok): return false
    if !checkEq("dynAnthropicLen", 1, pageAnthropic.rows.len): return false
    if pageAnthropic.rows.len >= 1:
        if !checkStr("dynAnthropic0Id", "thread-4", pageAnthropic.rows[0].id): return false
    # No matching model provider → empty result
    let pageNone = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                       "updated_at",
                                                                                       "desc",
                                                                                       false,
                                                                                       "",
                                                                                       "[\"nonexistent_provider\"]",
                                                                                       "",
                                                                                       "",
                                                                                       "",
                                                                                       10)
    if !checkTrue("dynNoneOk", pageNone.ok): return false
    if !checkEq("dynNoneLen", 0, pageNone.rows.len): return false
    # scanLimit < 1 → error
    let pageBad = state_db_sqlite.RustCsgStateDbVisiblePageRowsFilteredDynamicWithCwds(dbPath,
                                                                                      "updated_at",
                                                                                      "desc",
                                                                                      false,
                                                                                      "",
                                                                                      "",
                                                                                      "",
                                                                                      "",
                                                                                      "",
                                                                                      0)
    if !checkTrue("dynBadNotOk", !pageBad.ok): return false
    if !checkStr("dynBadErr", "state db filtered page scan limit must be positive", pageBad.error): return false
    echo("testDynamicPage ok")
    return true

fn testPageRowsFromStart(dbPath: str): bool =
    # 3-row page from start, updated_at DESC
    let page3 = state_db_sqlite.RustCsgStateDbVisiblePageRowsFromStart(dbPath, "updated_at", "desc")
    if !checkTrue("prs0Ok", page3.row0.ok): return false
    if !checkStr("prs0Id", "thread-1", page3.row0.id): return false
    if !checkTrue("prs1Ok", page3.row1.ok): return false
    if !checkStr("prs1Id", "thread-3", page3.row1.id): return false
    if !checkTrue("prs2Ok", page3.row2.ok): return false
    if !checkStr("prs2Id", "thread-4", page3.row2.id): return false
    # Filtered 3-row page, source=cli
    let pageCli = state_db_sqlite.RustCsgStateDbVisiblePageRowsFromStartFiltered(dbPath,
                                                                                 "updated_at",
                                                                                 "desc",
                                                                                 false,
                                                                                 "[\"cli\"]",
                                                                                 "",
                                                                                 "")
    if !checkTrue("prsCli0Ok", pageCli.row0.ok): return false
    if !checkStr("prsCli0Id", "thread-1", pageCli.row0.id): return false
    if !checkTrue("prsCli1Ok", pageCli.row1.ok): return false
    if !checkStr("prsCli1Id", "thread-4", pageCli.row1.id): return false
    if !checkTrue("prsCli2Ok", pageCli.row2.ok): return false
    if !checkStr("prsCli2Id", "thread-2", pageCli.row2.id): return false
    # Filtered with model provider and cwd: cli + anthropic + /other-repo → only thread-4
    let pageFiltered = state_db_sqlite.RustCsgStateDbVisiblePageRowsFromStartFilteredWithCwd(dbPath,
                                                                                             "updated_at",
                                                                                             "desc",
                                                                                             false,
                                                                                             "[\"cli\"]",
                                                                                             "anthropic",
                                                                                             "/other-repo",
                                                                                             "")
    if !checkTrue("prsFilt0Ok", pageFiltered.row0.ok): return false
    if !checkStr("prsFilt0Id", "thread-4", pageFiltered.row0.id): return false
    if !checkTrue("prsFilt1NotFound", pageFiltered.row1.notFound): return false
    if !checkTrue("prsFilt2NotFound", pageFiltered.row2.notFound): return false
    # After cursor filtered page
    let pageAfter = state_db_sqlite.RustCsgStateDbVisiblePageRowsAfterFilteredWithCwd(dbPath,
                                                                                     "updated_at",
                                                                                     "desc",
                                                                                     "1700000000123",
                                                                                     false,
                                                                                     "",
                                                                                     "",
                                                                                     "",
                                                                                     "")
    if !checkTrue("prsAfter0Ok", pageAfter.row0.ok): return false
    if !checkStr("prsAfter0Id", "thread-3", pageAfter.row0.id): return false
    if !checkTrue("prsAfter1Ok", pageAfter.row1.ok): return false
    if !checkStr("prsAfter1Id", "thread-4", pageAfter.row1.id): return false
    echo("testPageRowsFromStart ok")
    return true

# ═══════════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════════

fn main(): int32 =
    echo("smoke start")
    var allOk: bool = true

    # Pure logic tests (no SQLite needed)
    if !testCat(): allOk = false
    if !testSelectColumns(): allOk = false
    if !testOffsetSql(): allOk = false
    if !testOrderColumn(): allOk = false
    if !testOrderDirection(): allOk = false
    if !testSourcePredicate(): allOk = false
    if !testQuestionMarks(): allOk = false
    if !testJsonStringArrayOne(): allOk = false
    if !testStringArrayFromRaw(): allOk = false
    if !testVisibleThreadSql(): allOk = false
    if !testVisibleThreadAfterSql(): allOk = false
    if !testVisibleThreadFilteredSql(): allOk = false
    if !testVisiblePageFilteredSql(): allOk = false
    if !testErrorConstructors(): allOk = false

    # SQLite execution tests (need fixture)
    let path = RustCsgCreateSqliteFixture()
    if !checkTrue("fixtureCreated", path != ""):
        echo("FATAL: could not create sqlite fixture")
        return 1

    if !testCount(path): allOk = false
    if !testFirstVisible(path): allOk = false
    if !testVisibleThreadAtOffset(path): allOk = false
    if !testVisibleThreadAfter(path): allOk = false
    if !testThreadById(path): allOk = false
    if !testExactTitle(path): allOk = false
    if !testDynamicPage(path): allOk = false
    if !testPageRowsFromStart(path): allOk = false

    if allOk:
        echo("rust_csg_state_db_sqlite_relfacts_smoke ok")
        return 0
    echo("rust_csg_state_db_sqlite_relfacts_smoke FAILED")
    return 1
