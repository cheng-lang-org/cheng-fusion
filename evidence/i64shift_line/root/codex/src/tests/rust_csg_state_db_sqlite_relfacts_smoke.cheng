    if !checkStr("srcVscode", " AND threads.source IN ('vscode')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"vscode\"]")): return false
    if !checkStr("srcExec", " AND threads.source IN ('exec')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"exec\"]")): return false
    if !checkStr("srcMcp", " AND threads.source IN ('mcp')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"mcp\"]")): return false
    if !checkStr("srcUnknown", " AND threads.source IN ('unknown')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"unknown\"]")): return false
    if !checkStr("srcSubagent", " AND threads.source LIKE 'subagent_%'", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"subagent\"]")): return false
    if !checkStr("srcSubagentReview", " AND threads.source IN ('subagent_review')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"subagent_review\"]")): return false
    if !checkStr("srcSubagentCompact", " AND threads.source IN ('subagent_compact')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"subagent_compact\"]")): return false
    if !checkStr("srcSubagentSpawn", " AND threads.source LIKE 'subagent_thread_spawn_%'", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"subagent_thread_spawn\"]")): return false
    if !checkStr("srcMulti", " AND threads.source IN ('cli','vscode')", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"cli\",\"vscode\"]")): return false
    if !checkStr("srcUnsupported", "__unsupported_source_filter__", state_db_sqlite.RustCsgStateDbSourcePredicate("[\"unsupported\"]")): return false
