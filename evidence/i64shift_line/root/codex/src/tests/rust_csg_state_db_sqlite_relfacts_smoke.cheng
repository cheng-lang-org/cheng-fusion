# ═══════════════════════════════════════════════════════════════════════════════
# Check helpers
# ═══════════════════════════════════════════════════════════════════════════════

fn checkStr(name: str, expected: str, actual: str): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkTrue(name: str, cond: bool): bool =
    if !cond:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn checkEq(name: str, expected: int32, actual: int32): bool =
    if expected != actual:
        echo("FAIL ")
        echo(name)
        return false
    return true

fn strContains(text: str, needle: str): bool =
    if needle.len > text.len:
        return false
    if needle.len == 0:
        return false
    var i: int32 = 0
    while i <= text.len - needle.len:
        if strings.SliceBytes(text, i, needle.len) == needle:
            return true
        i = i + 1
    return false
