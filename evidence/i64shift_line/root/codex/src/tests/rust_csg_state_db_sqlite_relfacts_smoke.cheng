fn testStringArrayFromRaw(): bool =
    var arr: str[]
    # Empty input
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("")
    if !checkEq("safrEmptyLen", 0, arr.len): return false
    # Empty array JSON
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[]")
    if !checkEq("safrBareArrLen", 0, arr.len): return false
    # Single element
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\"]")
    if !checkEq("safrOneLen", 1, arr.len): return false
    if !checkStr("safrOneVal", "a", arr[0]): return false
    # Two elements
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\",\"b\"]")
    if !checkEq("safrTwoLen", 2, arr.len): return false
    if !checkStr("safrTwo0", "a", arr[0]): return false
    if !checkStr("safrTwo1", "b", arr[1]): return false
    # With whitespace
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("  [  \"a\" , \"b\"  ]  ")
    if !checkEq("safrSpcLen", 2, arr.len): return false
    if !checkStr("safrSpc0", "a", arr[0]): return false
    if !checkStr("safrSpc1", "b", arr[1]): return false
    # Newline escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\nb\"]")
    if !checkEq("safrEscNlLen", 1, arr.len): return false
    if !checkStr("safrEscNlVal", "a\nb", arr[0]): return false
    # Tab escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\tb\"]")
    if !checkEq("safrEscTabLen", 1, arr.len): return false
    if !checkStr("safrEscTabVal", "a\tb", arr[0]): return false
    # CR escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\rb\"]")
    if !checkEq("safrEscCrLen", 1, arr.len): return false
    if !checkStr("safrEscCrVal", "a\rb", arr[0]): return false
    # Quote escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\\"b\"]")
    if !checkEq("safrEscQuoteLen", 1, arr.len): return false
    if !checkStr("safrEscQuoteVal", "a\"b", arr[0]): return false
    # Backslash escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\\\b\"]")
    if !checkEq("safrEscBsLen", 1, arr.len): return false
    if !checkStr("safrEscBsVal", "a\\b", arr[0]): return false
    # Slash escape in JSON string
    arr = state_db_sqlite.RustCsgStateDbStringArrayFromRaw("[\"a\\/b\"]")
    if !checkEq("safrEscSlLen", 1, arr.len): return false
    if !checkStr("safrEscSlVal", "a/b", arr[0]): return false
    echo("testStringArrayFromRaw ok")
    return true

fn testVisibleThreadSql(): bool =
    let selectCols = state_db_sqlite.RustCsgStateDbSelectColumns()
    let baseWhereDesc = "WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms DESC"
    let baseWhereAsc = "WHERE first_user_message <> '' AND archived = 0 ORDER BY updated_at_ms ASC"
    # Updated_at DESC, offset 0
    var sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("updated_at", "desc", false, 0)
    if !checkTrue("vtsDesco0NotEmpty", sql != ""): return false
    if !checkTrue("vtsDesco0Select", strContains(sql, selectCols)): return false
    if !checkTrue("vtsDesco0Order", strContains(sql, baseWhereDesc)): return false
    if !checkTrue("vtsDesco0Limit", strContains(sql, "LIMIT 1 OFFSET 0")): return false
    # Updated_at DESC, offset 1
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("updated_at", "desc", false, 1)
    if !checkTrue("vtsDesco1", strContains(sql, "LIMIT 1 OFFSET 1")): return false
    # Updated_at ASC, offset 0
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("updated_at", "asc", false, 0)
    if !checkTrue("vtsAsco0", strContains(sql, baseWhereAsc)): return false
    # Created_at DESC, offset 0
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("created_at", "desc", false, 0)
    if !checkTrue("vtsCreatedDesc", strContains(sql, "ORDER BY created_at_ms DESC")): return false
    # Created_at ASC, offset 0
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("created_at", "asc", false, 0)
    if !checkTrue("vtsCreatedAsc", strContains(sql, "ORDER BY created_at_ms ASC")): return false
    # Archived returns empty
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("updated_at", "desc", true, 0)
    if !checkTrue("vtsArchivedEmpty", sql == ""): return false
    # Invalid sort returns empty
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("invalid", "desc", false, 0)
    if !checkTrue("vtsBadSortEmpty", sql == ""): return false
    # Invalid direction returns empty
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadSql("updated_at", "invalid", false, 0)
    if !checkTrue("vtsBadDirEmpty", sql == ""): return false
    echo("testVisibleThreadSql ok")
    return true

fn testVisibleThreadAfterSql(): bool =
    let selectCols = state_db_sqlite.RustCsgStateDbSelectColumns()
    # Updated_at DESC, offset 0
    var sql = state_db_sqlite.RustCsgStateDbVisibleThreadAfterSql("updated_at", "desc", 0)
    if !checkTrue("vtasDesc0NotEmpty", sql != ""): return false
    if !checkTrue("vtasDesc0Select", strContains(sql, selectCols)): return false
    if !checkTrue("vtasDesc0Cursor", strContains(sql, "updated_at_ms < CAST(? AS INTEGER)")): return false
    if !checkTrue("vtasDesc0Limit", strContains(sql, "ORDER BY updated_at_ms DESC LIMIT 1 OFFSET 0")): return false
    # Updated_at ASC, offset 0
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadAfterSql("updated_at", "asc", 0)
    if !checkTrue("vtasAsc0", strContains(sql, "updated_at_ms > CAST(? AS INTEGER)")): return false
    if !checkTrue("vtasAsc0Order", strContains(sql, "ORDER BY updated_at_ms ASC LIMIT 1 OFFSET 0")): return false
    # Created_at DESC, offset 2
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadAfterSql("created_at", "desc", 2)
    if !checkTrue("vtasCreatedDesc2", strContains(sql, "created_at_ms < CAST(? AS INTEGER)")): return false
    if !checkTrue("vtasCreatedDesc2Order", strContains(sql, "ORDER BY created_at_ms DESC LIMIT 1 OFFSET 2")): return false
    # Invalid sort returns empty
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadAfterSql("invalid", "desc", 0)
    if !checkTrue("vtasBadSortEmpty", sql == ""): return false
    # Invalid direction returns empty
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadAfterSql("updated_at", "invalid", 0)
    if !checkTrue("vtasBadDirEmpty", sql == ""): return false
    echo("testVisibleThreadAfterSql ok")
    return true

fn testVisibleThreadFilteredSql(): bool =
    # Basic unfiltered
    var sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "", "", "", "", "")
    if !checkTrue("vtfsBasic", sql != ""): return false
    if !checkTrue("vtfsBasicArchived0", strContains(sql, "threads.archived = 0")): return false
    if !checkTrue("vtfsBasicNoSrcIn", !strContains(sql, "source IN")): return false
    # Archived = true
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", true, 0, "", "", "", "", "")
    if !checkTrue("vtfsArchived1", strContains(sql, "threads.archived = 1")): return false
    # Source filter
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "[\"cli\"]", "", "", "", "")
    if !checkTrue("vtfsSourceCli", strContains(sql, "threads.source IN ('cli')")): return false
    # Model provider bind
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "", "openai", "", "", "")
    if !checkTrue("vtfsProvider", strContains(sql, "threads.model_provider = ?")): return false
    # Cwd filter bind
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "", "", "/repo", "", "")
    if !checkTrue("vtfsCwd", strContains(sql, "threads.cwd = ?")): return false
    # Search term
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "", "", "", "demo", "")
    if !checkTrue("vtfsSearch", strContains(sql, "instr(threads.title, ?) > 0")): return false
    # Cursor ASC
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "asc", false, 0, "", "", "", "", "1700000000000")
    if !checkTrue("vtfsCursorAsc", strContains(sql, "updated_at_ms > CAST(? AS INTEGER)")): return false
    # Cursor DESC
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "", "", "", "", "1700000000000")
    if !checkTrue("vtfsCursorDesc", strContains(sql, "updated_at_ms < CAST(? AS INTEGER)")): return false
    # General non-negative offset
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 3, "", "", "", "", "")
    if !checkTrue("vtfsOffset3", strContains(sql, "OFFSET 3")): return false
    # Error: unsupported source
    sql = state_db_sqlite.RustCsgStateDbVisibleThreadFilteredSql("updated_at", "desc", false, 0, "[\"bad\"]", "", "", "", "")
    if !checkTrue("vtfsBadSource", sql == ""): return false
    echo("testVisibleThreadFilteredSql ok")
    return true

fn testVisiblePageFilteredSql(): bool =
    # Basic no filters
    var sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "", 0, 0, "", "")
    if !checkTrue("vpfsBasic", sql != ""): return false
    if !checkTrue("vpfsBasicArchived0", strContains(sql, "threads.archived = 0")): return false
    if !checkTrue("vpfsBasicLimit", strContains(sql, "ORDER BY updated_at_ms DESC LIMIT ?")): return false
    # Archived = true
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", true, "", 0, 0, "", "")
    if !checkTrue("vpfsArchived1", strContains(sql, "threads.archived = 1")): return false
    # Source filter
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "[\"cli\"]", 0, 0, "", "")
    if !checkTrue("vpfsSource", strContains(sql, "threads.source IN ('cli')")): return false
    # Model provider IN clause
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "", 2, 0, "", "")
    if !checkTrue("vpfsProvIn", strContains(sql, "threads.model_provider IN (?,?)")): return false
    # Cwd filter IN clause
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "", 0, 1, "", "")
    if !checkTrue("vpfsCwdIn", strContains(sql, "threads.cwd IN (?)")): return false
    # Search term
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "", 0, 0, "demo", "")
    if !checkTrue("vpfsSearch", strContains(sql, "instr(threads.title, ?) > 0")): return false
    # Cursor ASC
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "asc", false, "", 0, 0, "", "1700000000000")
    if !checkTrue("vpfsCursorAsc", strContains(sql, "updated_at_ms > CAST(? AS INTEGER)")): return false
    # Cursor DESC
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "", 0, 0, "", "1700000000000")
    if !checkTrue("vpfsCursorDesc", strContains(sql, "updated_at_ms < CAST(? AS INTEGER)")): return false
    # Error: invalid sort
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("invalid", "desc", false, "", 0, 0, "", "")
    if !checkTrue("vpfsBadSort", sql == ""): return false
    # Error: unsupported source
    sql = state_db_sqlite.RustCsgStateDbVisiblePageFilteredSql("updated_at", "desc", false, "[\"bad\"]", 0, 0, "", "")
    if !checkTrue("vpfsBadSource", sql == ""): return false
    echo("testVisiblePageFilteredSql ok")
    return true

fn testErrorConstructors(): bool =
    # Count error
    let countErr = state_db_sqlite.RustCsgStateDbCountError("test count error")
    if !checkTrue("countErrNotOk", !countErr.ok): return false
    if !checkStr("countErrMsg", "test count error", countErr.error): return false
    # Row error
    let rowErr = state_db_sqlite.RustCsgStateDbThreadRowError("test row error")
    if !checkTrue("rowErrNotOk", !rowErr.ok): return false
    if !checkStr("rowErrMsg", "test row error", rowErr.error): return false
    # Page error
    let pageErr = state_db_sqlite.RustCsgStateDbThreadPageError("test page error")
    if !checkTrue("pageErrNotOk", !pageErr.ok): return false
    if !checkStr("pageErrMsg", "test page error", pageErr.error): return false
    # Not found
    let notFound = state_db_sqlite.RustCsgStateDbThreadRowNotFound()
    if !checkTrue("nfFlag", notFound.notFound): return false
    if !checkTrue("nfNotOk", !notFound.ok): return false
    echo("testErrorConstructors ok")
    return true

