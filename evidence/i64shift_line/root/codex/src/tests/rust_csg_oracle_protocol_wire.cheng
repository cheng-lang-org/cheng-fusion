import std/strings
import std/strutils as strutil
import cheng/codex/protocol/wire as w

fn RustCsgOracleProtocolWireCheckStr(name: str, got: str, expected: str): int32 =
    if got == expected:
        echo(strutil.Join(["ok: ", name], ""))
        return 1
    echo(strutil.Join(["FAIL: ", name, " expected=", expected, " got=", got], ""))
    return 0

fn RustCsgOracleProtocolWireCheckInt(name: str, got: int32, expected: int32): int32 =
    if got == expected:
        echo(strutil.Join(["ok: ", name], ""))
        return 1
    echo(strutil.Join(["FAIL: ", name, " expected=", strings.IntToStr(expected), " got=", strings.IntToStr(got)], ""))
    return 0

fn RustCsgOracleProtocolWireCheckTrue(name: str, got: bool): int32 =
    if got:
        echo(strutil.Join(["ok: ", name], ""))
        return 1
    echo(strutil.Join(["FAIL: ", name, " expected=true got=false"], ""))
    return 0

fn RustCsgOracleProtocolWireCheckFalse(name: str, got: bool): int32 =
    if !got:
        echo(strutil.Join(["ok: ", name], ""))
        return 1
    echo(strutil.Join(["FAIL: ", name, " expected=false got=true"], ""))
    return 0

fn main(): int32 =
    var pass: int32

    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonQuote hello", w.RustCsgJsonQuote("hello"), "\"hello\"")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonQuote empty", w.RustCsgJsonQuote(""), "\"\"")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldStr name", w.RustCsgJsonFieldStr("name", "codex"), "\"name\":\"codex\"")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldStr empty", w.RustCsgJsonFieldStr("id", ""), "\"id\":\"\"")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldInt32 zero", w.RustCsgJsonFieldInt32("count", 0), "\"count\":0")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldInt32 max", w.RustCsgJsonFieldInt32("max", 100), "\"max\":100")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldInt32 neg", w.RustCsgJsonFieldInt32("neg", -5), "\"neg\":-5")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldBool true", w.RustCsgJsonFieldBool("ok", true), "\"ok\":true")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldBool false", w.RustCsgJsonFieldBool("done", false), "\"done\":false")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFindStr name", w.RustCsgJsonFindStr("{\"name\":\"codex\"}", "name"), "codex")
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFindStr b", w.RustCsgJsonFindStr("{\"a\":\"x\",\"b\":\"y\"}", "b"), "y")
    pass = pass + RustCsgOracleProtocolWireCheckTrue("JsonFindBool true", w.RustCsgJsonFindBool("{\"ok\":true}", "ok"))
    pass = pass + RustCsgOracleProtocolWireCheckFalse("JsonFindBool false", w.RustCsgJsonFindBool("{\"ok\":false}", "ok"))
    pass = pass + RustCsgOracleProtocolWireCheckInt("JsonFindInt32 count", w.RustCsgJsonFindInt32("{\"count\":42}", "count"), 42)
    pass = pass + RustCsgOracleProtocolWireCheckInt("JsonFindInt32 max", w.RustCsgJsonFindInt32("{\"max\":0}", "max"), 0)
    pass = pass + RustCsgOracleProtocolWireCheckStr("Cat", w.RustCsgCat("hello", "world"), "helloworld")
    pass = pass + RustCsgOracleProtocolWireCheckStr("Cat3", w.RustCsgCat3("a", "b", "c"), "abc")
    pass = pass + RustCsgOracleProtocolWireCheckStr("SliceBytes mid", w.RustCsgSliceBytes("hello", 1, 3), "ell")
    pass = pass + RustCsgOracleProtocolWireCheckStr("SliceBytes all", w.RustCsgSliceBytes("hello", 0, 5), "hello")
    pass = pass + RustCsgOracleProtocolWireCheckTrue("Contains yes", w.RustCsgContains("hello world", "lo wo"))
    pass = pass + RustCsgOracleProtocolWireCheckFalse("Contains no", w.RustCsgContains("hello", "xyz"))
    pass = pass + RustCsgOracleProtocolWireCheckTrue("StartsWith yes", w.RustCsgStartsWith("hello world", "hello"))
    pass = pass + RustCsgOracleProtocolWireCheckFalse("StartsWith no", w.RustCsgStartsWith("hello world", "world"))
    pass = pass + RustCsgOracleProtocolWireCheckInt("SkipJsonSpace", w.RustCsgSkipJsonSpace("  {", 0), 2)
    pass = pass + RustCsgOracleProtocolWireCheckInt("SkipJsonSpace none", w.RustCsgSkipJsonSpace("abc", 0), 0)
    pass = pass + RustCsgOracleProtocolWireCheckStr("JsonFieldRaw", w.RustCsgJsonFieldRaw("data", "{\"x\":1}"), "\"data\":{\"x\":1}")

    if pass == 26:
        echo("rust_csg_oracle_protocol_wire ok")
        return 0
    echo(strutil.Join(["oracle FAIL pass=", strings.IntToStr(pass), " expected=26"], ""))
    return 1

main()
