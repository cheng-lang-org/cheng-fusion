import std/cmdline
import std/strings
import std/strutils as strutil
import cheng/codex/tui/oracle_snapshot as snap
import cheng/codex/tui/history_cell_oracle as oracle

fn RustCsgTuiHistoryCellOracleNameFromPath(path: str): str =
    let prefix: str = "codex_tui__history_cell__tests__"
    let suffix: str = ".snap"
    let n: int32 = strings.Len(path)
    var slash: int32 = -1
    var i: int32 = 0
    while i < n:
        if path[i] == '/':
            slash = i
        i = i + 1
    let baseStart: int32 = slash + 1
    let baseLen: int32 = n - baseStart
    if baseLen <= strings.Len(prefix) + strings.Len(suffix):
        return ""
    let base: str = strings.SliceBytes(path, baseStart, baseLen)
    if strings.SliceBytes(base, 0, strings.Len(prefix)) != prefix:
        return ""
    if strings.SliceBytes(base, strings.Len(base) - strings.Len(suffix), strings.Len(suffix)) != suffix:
        return ""
    return strings.SliceBytes(base, strings.Len(prefix), strings.Len(base) - strings.Len(prefix) - strings.Len(suffix))

fn RustCsgTuiHistoryCellOracleCheck(path: str): int32 =
    let name: str = RustCsgTuiHistoryCellOracleNameFromPath(path)
    if strings.Len(name) == 0:
        echo(strutil.Join(["FAIL: invalid history_cell snapshot path: ", path], ""))
        return 1
    let expected: str = oracle.RustCsgTuiHistoryCellByName(name)
    if strings.Len(expected) == 0:
        echo(strutil.Join(["FAIL: missing history_cell oracle case: ", name], ""))
        return 1
    let parsed = snap.RustCsgTuiOracleSnapshotParseFile(path)
    if !parsed.ok:
        echo(strutil.Join(["FAIL: ", name, " parse: ", parsed.error], ""))
        return 1
    if parsed.source != "tui/src/history_cell.rs" && parsed.source != "tui/src/history_cell/tests.rs":
        echo(strutil.Join(["FAIL: ", name, " source: ", parsed.source], ""))
        return 1
    var expectedExpression: str = "rendered"
    if name == "streamed_agent_list_paragraph_preserves_item_indent_when_wrapped":
        expectedExpression = "\"lines.join(\\\"\\\\n\\\")\""
    if parsed.expression != expectedExpression:
        echo(strutil.Join(["FAIL: ", name, " expression: ", parsed.expression], ""))
        return 1
    if expected != parsed.body:
        echo(strutil.Join([
            "FAIL: ", name,
            " byte mismatch expected=", strings.IntToStr(parsed.bodyByteLen),
            " got=", strings.IntToStr(strings.Len(expected)),
        ], ""))
        return 1
    echo(strutil.Join(["ok: ", name], ""))
    return 0

fn main(): int32 =
    if cmdline.argCount() < 2:
        echo("FAIL usage: rust_csg_tui_history_cell_oracle_smoke <history_cell snapshot paths...>")
        return 1
    var exitCode: int32 = 0
    var i: int32 = 1
    while i < cmdline.argCount():
        exitCode = exitCode + RustCsgTuiHistoryCellOracleCheck(cmdline.argStr(i))
        i = i + 1
    if exitCode == 0:
        echo("rust_csg_tui_history_cell_oracle_smoke ok")
    else:
        echo("rust_csg_tui_history_cell_oracle_smoke FAILED")
    return exitCode
