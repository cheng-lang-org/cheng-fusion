    RustCsgRolloutImageDetailCursorValidateRest(detailsRaw, pos, done, outOk)

fn RustCsgRolloutUserInputImageEntry(kind: str,
                                     valueKey: str,
                                     value: str,
                                     detailJson: str): str =
