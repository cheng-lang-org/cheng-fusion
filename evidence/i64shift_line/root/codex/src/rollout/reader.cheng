fn RustCsgRolloutTrimAsciiText(text: str): str =
    var start: int32
    var end = text.len
    while start < end && RustCsgRolloutIsTrimSpace(text[start]):
        start = start + 1
    while end > start && RustCsgRolloutIsTrimSpace(text[end - 1]):
        end = end - 1
    return wire.RustCsgSliceBytes(text, start, end - start)

fn RustCsgRolloutReviewTargetLooksValid(payload: str): bool =
    let targetStart = RustCsgRolloutJsonTopFieldValueStart(payload, "target")
    let targetJson = RustCsgRolloutJsonObjectAt(payload, targetStart)
    if targetJson == "":
        return false
    var ok: bool
    let targetType = RustCsgRolloutJsonRequiredString(targetJson, "type", ok)
    if !ok:
        return false
    if targetType == "uncommittedChanges":
        return true
    if targetType == "baseBranch":
        RustCsgRolloutJsonRequiredString(targetJson, "branch", ok)
        return ok
    if targetType == "commit":
        RustCsgRolloutJsonRequiredString(targetJson, "sha", ok)
        if !ok:
            return false
        RustCsgRolloutJsonOptionalStringJson(targetJson, "title", ok)
        return ok
    if targetType == "custom":
        RustCsgRolloutJsonRequiredString(targetJson, "instructions", ok)
        return ok
    return false

fn RustCsgRolloutEnteredReviewText(payload: str, outOk: var bool): str =
    outOk = false
    if !RustCsgRolloutReviewTargetLooksValid(payload):
        return ""
    var present: bool
    var stringOk: bool
    let hint = RustCsgRolloutJsonOptionalString(payload, "user_facing_hint", present, stringOk)
    if !stringOk:
        return ""
    outOk = true
    if present:
        return hint
    return "Review requested."

fn RustCsgRolloutExitedReviewText(payload: str, outOk: var bool): str =
    outOk = false
    let outputStart = RustCsgRolloutJsonTopFieldValueStart(payload, "review_output")
    if outputStart < 0 || wire.RustCsgMatchesAt(payload, outputStart, "null"):
        outOk = true
        return "Reviewer failed to output a response."
    let outputJson = RustCsgRolloutJsonObjectAt(payload, outputStart)
    if outputJson == "":
        return ""
    var ok: bool
    let findingsRaw = RustCsgRolloutJsonRequiredArrayRaw(outputJson, "findings", ok)
    if !ok || findingsRaw == "":
        return ""
    RustCsgRolloutJsonRequiredString(outputJson, "overall_correctness", ok)
    if !ok:
        return ""
    let explanation = RustCsgRolloutJsonRequiredString(outputJson, "overall_explanation", ok)
    if !ok:
        return ""
    RustCsgRolloutJsonRequiredNumberRaw(outputJson, "overall_confidence_score", ok)
    if !ok:
        return ""
    outOk = true
    let trimmed = RustCsgRolloutTrimAsciiText(explanation)
    if trimmed == "":
        return "Reviewer failed to output a response."
    return trimmed

fn RustCsgRolloutReplayUserMessage(payload: str,
                                   rolloutIndex: int32,
                                   builder: var RustCsgRolloutTurnsBuilder,
                                   outError: var str) =
    var ok: bool
    let message = RustCsgRolloutJsonRequiredString(payload, "message", ok)
    if !ok:
        outError = "rollout replay user_message missing message"
        return
    let textElementsJson = RustCsgRolloutUserMessageTextElementsJson(payload, ok)
    if !ok:
        outError = "rollout replay user_message text_elements invalid"
        return
    let imagesRaw = RustCsgRolloutJsonOptionalArrayRaw(payload, "images", ok)
    if !ok:
        outError = "rollout replay user_message images invalid"
        return
    let imageDetailsRaw = RustCsgRolloutJsonDefaultArrayRaw(payload, "image_details", ok)
    if !ok:
        outError = "rollout replay user_message image_details invalid"
        return
    RustCsgRolloutImageDetailsValidate(imageDetailsRaw, ok)
    if !ok:
        outError = "rollout replay user_message image_details invalid"
        return
    let imageInputsJson = RustCsgRolloutImageInputsToV2(imagesRaw,
                                                        imageDetailsRaw,
                                                        "image",
                                                        "url",
                                                        ok)
    if !ok:
        outError = "rollout replay user_message images invalid"
        return
    let localImagesRaw = RustCsgRolloutJsonDefaultArrayRaw(payload, "local_images", ok)
    if !ok:
        outError = "rollout replay user_message local_images invalid"
        return
    let localImageDetailsRaw = RustCsgRolloutJsonDefaultArrayRaw(payload, "local_image_details", ok)
    if !ok:
        outError = "rollout replay user_message local_image_details invalid"
        return
    RustCsgRolloutImageDetailsValidate(localImageDetailsRaw, ok)
    if !ok:
        outError = "rollout replay user_message local_image_details invalid"
        return
    let localImageInputsJson = RustCsgRolloutImageInputsToV2(localImagesRaw,
                                                             localImageDetailsRaw,
                                                             "localImage",
                                                             "path",
                                                             ok)
    if !ok:
        outError = "rollout replay user_message local_images invalid"
        return
    if builder.currentHasItem && !builder.currentOpenedExplicitly:
        RustCsgRolloutTurnsBuilderFinishCurrent(builder)
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    let itemId = RustCsgRolloutTurnsBuilderNextItemId(builder)
    RustCsgRolloutTurnsBuilderAddItem(builder,
                                      RustCsgRolloutUserMessageItemJson(itemId,
                                                                        message,
                                                                        textElementsJson,
                                                                        imageInputsJson,
                                                                        localImageInputsJson))

fn RustCsgRolloutReplayAgentMessage(payload: str,
                                    rolloutIndex: int32,
                                    builder: var RustCsgRolloutTurnsBuilder,
                                    outError: var str) =
    var ok: bool
    let message = RustCsgRolloutJsonRequiredString(payload, "message", ok)
    if !ok:
        outError = "rollout replay agent_message missing message"
        return
    let phaseJson = RustCsgRolloutAgentMessagePhaseJson(payload, ok)
    if !ok:
        outError = "rollout replay agent_message phase not ported"
        return
    let memoryCitationJson = RustCsgRolloutAgentMessageMemoryCitationJson(payload, ok)
    if !ok:
        outError = "rollout replay agent_message memory_citation not ported"
        return
    if message == "":
        return
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    let itemId = RustCsgRolloutTurnsBuilderNextItemId(builder)
    RustCsgRolloutTurnsBuilderAddItem(builder,
                                      RustCsgRolloutAgentMessageItemJson(itemId,
                                                                        message,
                                                                        phaseJson,
                                                                        memoryCitationJson))

fn RustCsgRolloutReplayContextCompacted(rolloutIndex: int32,
                                        builder: var RustCsgRolloutTurnsBuilder) =
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    let itemId = RustCsgRolloutTurnsBuilderNextItemId(builder)
    RustCsgRolloutTurnsBuilderAddItem(builder, RustCsgRolloutContextCompactionItemJson(itemId))

fn RustCsgRolloutReplayEnteredReviewMode(payload: str,
                                         rolloutIndex: int32,
