        rangeOut = wire.RustCsgCat(rangeOut, ",")
        rangeOut = wire.RustCsgCat(rangeOut, wire.RustCsgJsonFieldRaw("end", endRaw))
        rangeOut = wire.RustCsgCat(rangeOut, "}")
        var out = "{"
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("byteRange", rangeOut))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("placeholder", placeholderJson))
        out = wire.RustCsgCat(out, "}")
