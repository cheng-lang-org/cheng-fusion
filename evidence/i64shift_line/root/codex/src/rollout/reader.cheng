fn RustCsgRolloutImageInputsToV2(raw: str,
                                 detailsRaw: str,
                                 kind: str,
                                 valueKey: str,
                                 outOk: var bool): str =
    outOk = false
    if raw == "":
        outOk = true
        return ""
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start >= raw.len || raw[start] != '[':
        return ""
    var detailPos: int32
    var detailDone: bool
    var detailCursorOk: bool
    RustCsgRolloutImageDetailCursorStart(detailsRaw, detailPos, detailDone, detailCursorOk)
    if !detailCursorOk:
        return ""
    var out: str
    var first = true
    var pos = wire.RustCsgSkipJsonSpace(raw, start + 1)
    if pos < raw.len && raw[pos] == ']':
        outOk = true
        return ""
    while pos < raw.len:
        var stringOk: bool
        let value = RustCsgRolloutJsonStringAt(raw, pos, stringOk)
        if !stringOk:
            return ""
        var detailOk: bool
        let detailJson = RustCsgRolloutImageDetailCursorTake(detailsRaw,
                                                             detailPos,
                                                             detailDone,
                                                             detailOk)
        if !detailOk:
            return ""
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, RustCsgRolloutUserInputImageEntry(kind,
                                                                     valueKey,
                                                                     value,
                                                                     detailJson))
        first = false
        let valueEnd = RustCsgRolloutJsonStringEnd(raw, pos)
        if valueEnd < 0:
            return ""
        pos = wire.RustCsgSkipJsonSpace(raw, valueEnd + 1)
        if pos < raw.len && raw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == ']':
            RustCsgRolloutImageDetailCursorValidateRest(detailsRaw,
                                                        detailPos,
                                                        detailDone,
                                                        detailOk)
            if !detailOk:
                return ""
            outOk = true
            return out
        return ""
