    if !ok || receiverThreadId == "":
        outError = "rollout replay collab_close_end missing receiver_thread_id"
        return
    let receiverThreadIdsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(receiverThreadId), "]")
    let itemJson = RustCsgRolloutCollabAgentToolCallItemJson(callId,
                                                              "closeAgent",
                                                              "completed",
                                                              senderThreadId,
