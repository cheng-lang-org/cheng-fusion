    return RustCsgRolloutAppendUserInput(content, inputsJson, first)

fn RustCsgRolloutUserMessageItemJson(id: str,
                                     message: str,
                                     textElementsJson: str,
                                     imageInputsJson: str,
                                     localImageInputsJson: str): str =
    var content = "["
    var first = true
    if RustCsgRolloutHasTrimmedText(message):
        var input = "{"
        input = wire.RustCsgCat(input, wire.RustCsgJsonFieldStr("type", "text"))
        input = wire.RustCsgCat(input, ",")
        input = wire.RustCsgCat(input, wire.RustCsgJsonFieldStr("text", message))
        input = wire.RustCsgCat(input, ",")
        input = wire.RustCsgCat(input, wire.RustCsgJsonFieldRaw("textElements", textElementsJson))
        input = wire.RustCsgCat(input, "}")
        content = RustCsgRolloutAppendUserInput(content, input, first)
    content = RustCsgRolloutAppendUserInputList(content, imageInputsJson, first)
    content = RustCsgRolloutAppendUserInputList(content, localImageInputsJson, first)
    content = wire.RustCsgCat(content, "]")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "userMessage"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", content))
    out = wire.RustCsgCat(out, "}")
    return out

