fn RustCsgRolloutRawNonNegativeIntLe(raw: str, maxText: str): bool =
    if raw == "" || raw[0] == '-':
        return false
    var first: int32
    while first < raw.len && raw[first] == '0':
        first = first + 1
    if first == raw.len:
        return true
    let significantLen = raw.len - first
    if significantLen > maxText.len:
        return false
    if significantLen < maxText.len:
        return true
    for i in 0..<significantLen:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(raw, first + i, 1))
        let maxDigit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(maxText, i, 1))
        if digit < 0:
            return false
        if digit > maxDigit:
            return false
        if digit < maxDigit:
            return true
    return true

fn RustCsgRolloutMcpOptionalUriJson(payload: str, outOk: var bool): str =
    outOk = true
    var present: bool
    var stringOk: bool
    let uri = RustCsgRolloutJsonOptionalString(payload, "mcp_app_resource_uri", present, stringOk)
    if !stringOk:
        outOk = false
        return ""
    if !present:
        return ""
    return wire.RustCsgJsonQuote(uri)

