# ── item_completed handler (Plan items only) ─────────────────────────────
fn RustCsgRolloutReplayItemCompleted(payload: str,
                                      rolloutIndex: int32,
                                      builder: var RustCsgRolloutTurnsBuilder,
                                      outError: var str) =
    let itemStart = RustCsgRolloutJsonTopFieldValueStart(payload, "item")
    if itemStart < 0:
        return
    let itemJson = RustCsgRolloutJsonObjectAt(payload, itemStart)
    if itemJson == "":
        return
    var ok: bool
    let itemType = RustCsgRolloutJsonRequiredString(itemJson, "type", ok)
    if !ok || itemType != "plan":
        return
    let id = RustCsgRolloutJsonRequiredString(itemJson, "id", ok)
    if !ok || id == "":
        return
    let text = RustCsgRolloutJsonRequiredString(itemJson, "text", ok)
    if !ok:
        return
    let turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
    if !ok || turnId == "":
        return
    let planItemJson = RustCsgRolloutPlanItemJson(id, text)
    RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, planItemJson, ok)
    if !ok:
        outError = "rollout replay item_completed upsert failed"

# ── patch_apply_end handler ──────────────────────────────────────────────
fn RustCsgRolloutReplayPatchApplyEnd(payload: str,
                                      rolloutIndex: int32,
                                      builder: var RustCsgRolloutTurnsBuilder,
                                      outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay patch_apply_end missing call_id"
        return
    var turnPresent: bool
    var turnStringOk: bool
    let turnId = RustCsgRolloutJsonOptionalString(payload, "turn_id", turnPresent, turnStringOk)
    if !turnStringOk:
        outError = "rollout replay patch_apply_end invalid turn_id"
        return
    var changesOk: bool
    let changesRaw = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "changes", changesOk)
    if !changesOk:
        outError = "rollout replay patch_apply_end invalid changes"
        return
    var changesJson: str
    if changesRaw != "null" && changesRaw != "":
        changesJson = RustCsgRolloutPatchChangesToV2(changesRaw, ok)
        if !ok:
            outError = "rollout replay patch_apply_end changes not ported"
            return
    else:
        changesJson = "[]"
    var statusOk: bool
    let status = RustCsgRolloutJsonRequiredString(payload, "status", statusOk)
    if !statusOk:
        outError = "rollout replay patch_apply_end missing status"
        return
    let v2Status = RustCsgRolloutExecStatusToV2(status)
    let itemJson = RustCsgRolloutFileChangeItemJson(callId, changesJson, v2Status)
    if turnId != "":
        RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, itemJson, ok)
    else:
        RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
        RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay patch_apply_end upsert failed"

# ── exec_command_end handler ─────────────────────────────────────────────
fn RustCsgRolloutReplayExecCommandEnd(payload: str,
                                       rolloutIndex: int32,
                                       builder: var RustCsgRolloutTurnsBuilder,
                                       outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay exec_command_end missing call_id"
        return
    let turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
    if !ok || turnId == "":
        outError = "rollout replay exec_command_end missing turn_id"
        return
    var commandOk: bool
    let commandRaw = RustCsgRolloutJsonRequiredArrayRaw(payload, "command", commandOk)
    if !commandOk:
        outError = "rollout replay exec_command_end missing command"
        return
    let command = RustCsgRolloutCommandArrayToShellText(commandRaw, ok)
    if !ok:
        outError = "rollout replay exec_command_end command not ported"
        return
    let cwd = RustCsgRolloutJsonRequiredString(payload, "cwd", ok)
    if !ok:
        outError = "rollout replay exec_command_end missing cwd"
        return
    let processIdJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "process_id", ok)
    if !ok:
        outError = "rollout replay exec_command_end invalid process_id"
        return
    var sourcePresent: bool
    var sourceStringOk: bool
    let sourceRaw = RustCsgRolloutJsonOptionalString(payload, "source", sourcePresent, sourceStringOk)
    if !sourceStringOk:
        outError = "rollout replay exec_command_end invalid source"
        return
    let source = RustCsgRolloutExecSourceToV2(sourceRaw)
    let statusRaw = RustCsgRolloutJsonRequiredString(payload, "status", ok)
    if !ok:
        outError = "rollout replay exec_command_end missing status"
        return
    let status = RustCsgRolloutExecStatusToV2(statusRaw)
    let aggregatedOutputJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "aggregated_output", ok)
    if !ok:
        outError = "rollout replay exec_command_end invalid aggregated_output"
        return
    var exitCodeJson: str
    let exitCodeStart = RustCsgRolloutJsonTopFieldValueStart(payload, "exit_code")
    if exitCodeStart >= 0 && !wire.RustCsgMatchesAt(payload, exitCodeStart, "null"):
        exitCodeJson = RustCsgRolloutJsonOptionalIntRaw(payload, "exit_code", ok)
        if !ok || exitCodeJson == "":
            outError = "rollout replay exec_command_end invalid exit_code"
            return
    var durationMsJson: str
    let durationStart = RustCsgRolloutJsonTopFieldValueStart(payload, "duration")
    if durationStart >= 0:
        let durationRaw = RustCsgRolloutJsonObjectAt(payload, durationStart)
        if durationRaw != "":
            durationMsJson = RustCsgRolloutDurationSecsNanosToMsStr(durationRaw, ok)
            if !ok:
                outError = "rollout replay exec_command_end invalid duration"
                return
    let itemJson = RustCsgRolloutCommandExecutionItemJson(callId,
                                                           command,
                                                           cwd,
                                                           processIdJson,
                                                           source,
                                                           status,
                                                           aggregatedOutputJson,
                                                           exitCodeJson,
                                                           durationMsJson)
    RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, itemJson, ok)
    if !ok:
        outError = "rollout replay exec_command_end upsert failed"

# ── guardian_assessment handler ──────────────────────────────────────────
fn RustCsgRolloutReplayGuardianAssessment(payload: str,
                                           rolloutIndex: int32,
                                           builder: var RustCsgRolloutTurnsBuilder,
                                           outError: var str) =
    var ok: bool
    let status = RustCsgRolloutJsonRequiredString(payload, "status", ok)
    if !ok:
        outError = "rollout replay guardian_assessment missing status"
        return
    if status == "approved":
        return
    let actionStart = RustCsgRolloutJsonTopFieldValueStart(payload, "action")
    let actionObj = RustCsgRolloutJsonObjectAt(payload, actionStart)
    if actionObj == "":
        outError = "rollout replay guardian_assessment missing action"
        return
    let actionType = RustCsgRolloutJsonRequiredString(actionObj, "type", ok)
    if !ok:
        outError = "rollout replay guardian_assessment action missing type"
        return
    if actionType != "command" && actionType != "execve":
        return
    let targetStart = RustCsgRolloutJsonTopFieldValueStart(payload, "target_item_id")
    var targetItemId: str
    if targetStart >= 0:
        targetItemId = RustCsgRolloutJsonStringAt(payload, targetStart, ok)
    if targetItemId == "":
        return
    let command = RustCsgRolloutJsonRequiredString(actionObj, "command", ok)
    if !ok:
        outError = "rollout replay guardian_assessment action missing command"
        return
    let cwd = RustCsgRolloutJsonRequiredString(actionObj, "cwd", ok)
    if !ok:
        outError = "rollout replay guardian_assessment action missing cwd"
        return
    var v2Status: str
    if status == "in_progress":
        v2Status = "inProgress"
    elif status == "denied" || status == "aborted":
        v2Status = "declined"
    elif status == "timed_out":
        v2Status = "failed"
    else:
        outError = "rollout replay guardian_assessment status not ported"
        return
    var turnPresent: bool
    var turnStringOk: bool
    let turnId = RustCsgRolloutJsonOptionalString(payload, "turn_id", turnPresent, turnStringOk)
    if !turnStringOk:
        outError = "rollout replay guardian_assessment invalid turn_id"
        return
    let itemJson = RustCsgRolloutCommandExecutionItemJson(targetItemId,
                                                           command,
                                                           cwd,
                                                           "null",
                                                           "agent",
                                                           v2Status,
                                                           "null",
                                                           "",
                                                           "")
    if turnId != "":
        RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, itemJson, ok)
    else:
        RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
        RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay guardian_assessment upsert failed"

# ── dynamic_tool_call_request handler ────────────────────────────────────
fn RustCsgRolloutReplayDynamicToolCallRequest(payload: str,
                                               rolloutIndex: int32,
                                               builder: var RustCsgRolloutTurnsBuilder,
                                               outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "callId", ok)
    if !ok || callId == "":
        callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
        if !ok || callId == "":
            outError = "rollout replay dynamic_tool_call_request missing call_id"
            return
    var turnId: str
    turnId = RustCsgRolloutJsonRequiredString(payload, "turnId", ok)
    if !ok:
        turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
        if !ok:
            outError = "rollout replay dynamic_tool_call_request missing turn_id"
            return
    let namespaceJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "namespace", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_request invalid namespace"
        return
    let tool = RustCsgRolloutJsonRequiredString(payload, "tool", ok)
    if !ok || tool == "":
        outError = "rollout replay dynamic_tool_call_request missing tool"
        return
    let argumentsJson = RustCsgRolloutJsonValueRawAtField(payload, "arguments", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_request invalid arguments"
        return
    let itemJson = RustCsgRolloutDynamicToolCallItemJson(callId,
                                                          namespaceJson,
                                                          tool,
                                                          argumentsJson,
                                                          "inProgress",
                                                          "null",
                                                          "",
                                                          "")
    RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, itemJson, ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_request upsert failed"

# ── dynamic_tool_call_response handler ───────────────────────────────────
fn RustCsgRolloutReplayDynamicToolCallResponse(payload: str,
                                                rolloutIndex: int32,
                                                builder: var RustCsgRolloutTurnsBuilder,
                                                outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay dynamic_tool_call_response missing call_id"
        return
    let turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_response missing turn_id"
        return
    let namespaceJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "namespace", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_response invalid namespace"
        return
    let tool = RustCsgRolloutJsonRequiredString(payload, "tool", ok)
    if !ok || tool == "":
        outError = "rollout replay dynamic_tool_call_response missing tool"
        return
    let argumentsJson = RustCsgRolloutJsonValueRawAtField(payload, "arguments", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_response invalid arguments"
        return
    var success: bool
    let successStart = RustCsgRolloutJsonTopFieldValueStart(payload, "success")
    if successStart >= 0:
        success = RustCsgRolloutJsonRequiredBool(payload, "success", ok)
        if !ok:
            outError = "rollout replay dynamic_tool_call_response invalid success"
            return
    let status = success ? "completed" : "failed"
    let contentItemsJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "content_items", ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_response invalid content_items"
        return
    let durationStart = RustCsgRolloutJsonTopFieldValueStart(payload, "duration")
    var durationMsJson: str
    if durationStart >= 0:
        let durationRaw = RustCsgRolloutJsonObjectAt(payload, durationStart)
        if durationRaw != "":
            durationMsJson = RustCsgRolloutDurationSecsNanosToMsStr(durationRaw, ok)
            if !ok:
                outError = "rollout replay dynamic_tool_call_response invalid duration"
                return
    let successJson = success ? "true" : "false"
    let itemJson = RustCsgRolloutDynamicToolCallItemJson(callId,
                                                          namespaceJson,
                                                          tool,
                                                          argumentsJson,
                                                          status,
                                                          contentItemsJson,
                                                          successJson,
                                                          durationMsJson)
    RustCsgRolloutTurnsBuilderUpsertInTurnId(builder, turnId, itemJson, ok)
    if !ok:
        outError = "rollout replay dynamic_tool_call_response upsert failed"

# ── Collab end event handlers (spawn/interaction/waiting/close/resume) ───
fn RustCsgRolloutReplayCollabSpawnEnd(payload: str,
                                       rolloutIndex: int32,
                                       builder: var RustCsgRolloutTurnsBuilder,
                                       outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay collab_agent_spawn_end missing call_id"
        return
    let senderThreadId = RustCsgRolloutJsonRequiredString(payload, "sender_thread_id", ok)
    if !ok || senderThreadId == "":
        outError = "rollout replay collab_agent_spawn_end missing sender_thread_id"
        return
    var receiverThreadIdsJson: str = "[]"
    let newThreadIdStart = RustCsgRolloutJsonTopFieldValueStart(payload, "new_thread_id")
    if newThreadIdStart >= 0 && !wire.RustCsgMatchesAt(payload, newThreadIdStart, "null"):
        var stringOk: bool
        let newThreadId = RustCsgRolloutJsonStringAt(payload, newThreadIdStart, stringOk)
        if stringOk && newThreadId != "":
            receiverThreadIdsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(newThreadId), "]")
    let prompt = RustCsgRolloutJsonRequiredString(payload, "prompt", ok)
    if !ok:
        outError = "rollout replay collab_agent_spawn_end missing prompt"
        return
    let model = RustCsgRolloutJsonRequiredString(payload, "model", ok)
    if !ok:
        outError = "rollout replay collab_agent_spawn_end missing model"
        return
    let hasReceiver = newThreadIdStart >= 0 && !wire.RustCsgMatchesAt(payload, newThreadIdStart, "null")
    var collabStatusOk: bool
    let collabStatusRaw = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "status", collabStatusOk)
    var collabStatusIsError: bool
    if collabStatusOk:
        collabStatusIsError = RustCsgRolloutAgentStatusIsError(collabStatusRaw)
    var status: str
    if collabStatusIsError:
        status = "failed"
    elif hasReceiver:
        status = "completed"
    else:
        status = "failed"
    let itemJson = RustCsgRolloutCollabAgentToolCallItemJson(callId,
                                                              "spawnAgent",
                                                              status,
                                                              senderThreadId,
                                                              receiverThreadIdsJson,
                                                              wire.RustCsgJsonQuote(prompt),
                                                              wire.RustCsgJsonQuote(model),
                                                              "null",
                                                              "")
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay collab_agent_spawn_end upsert failed"

fn RustCsgRolloutReplayCollabInteractionEnd(payload: str,
                                             rolloutIndex: int32,
                                             builder: var RustCsgRolloutTurnsBuilder,
                                             outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay collab_agent_interaction_end missing call_id"
        return
    let senderThreadId = RustCsgRolloutJsonRequiredString(payload, "sender_thread_id", ok)
    if !ok || senderThreadId == "":
        outError = "rollout replay collab_agent_interaction_end missing sender_thread_id"
        return
    let receiverThreadId = RustCsgRolloutJsonRequiredString(payload, "receiver_thread_id", ok)
    if !ok || receiverThreadId == "":
        outError = "rollout replay collab_agent_interaction_end missing receiver_thread_id"
        return
    let receiverThreadIdsJson = wire.RustCsgCat3("[", wire.RustCsgJsonQuote(receiverThreadId), "]")
    let prompt = RustCsgRolloutJsonRequiredString(payload, "prompt", ok)
    if !ok:
        outError = "rollout replay collab_agent_interaction_end missing prompt"
        return
    var statusOk: bool
    let statusRaw = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "status", statusOk)
    var interactionStatus: str
    if statusOk && RustCsgRolloutAgentStatusIsError(statusRaw):
        interactionStatus = "failed"
    else:
        interactionStatus = "completed"
    let itemJson = RustCsgRolloutCollabAgentToolCallItemJson(callId,
                                                              "sendInput",
                                                              interactionStatus,
                                                              senderThreadId,
                                                              receiverThreadIdsJson,
                                                              wire.RustCsgJsonQuote(prompt),
                                                              "null",
                                                              "null",
                                                              "")
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay collab_agent_interaction_end upsert failed"

fn RustCsgRolloutReplayCollabWaitingEnd(payload: str,
                                         rolloutIndex: int32,
                                         builder: var RustCsgRolloutTurnsBuilder,
                                         outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay collab_waiting_end missing call_id"
        return
    let senderThreadId = RustCsgRolloutJsonRequiredString(payload, "sender_thread_id", ok)
    if !ok || senderThreadId == "":
        outError = "rollout replay collab_waiting_end missing sender_thread_id"
        return
    let statusesStart = RustCsgRolloutJsonTopFieldValueStart(payload, "statuses")
    if statusesStart < 0:
        outError = "rollout replay collab_waiting_end missing statuses"
        return
    let statusesRaw = RustCsgRolloutJsonObjectAt(payload, statusesStart)
    if statusesRaw == "":
        outError = "rollout replay collab_waiting_end invalid statuses"
        return
    var receiverThreadIdsJson = "[]"
    let ridsStart = RustCsgRolloutJsonTopFieldValueStart(payload, "receiver_thread_ids")
    if ridsStart >= 0:
        let ridsRaw = RustCsgRolloutJsonArrayAt(payload, ridsStart)
        if ridsRaw != "":
            receiverThreadIdsJson = ridsRaw
    var hasError: bool
    var statusKey: str
    var v1: bool
    let statusesObj = statusesRaw
    var statusPos = wire.RustCsgSkipJsonSpace(statusesObj, 1)
    while statusPos < statusesObj.len:
        var stringOk: bool
        let tid = RustCsgRolloutJsonStringAt(statusesObj, statusPos, stringOk)
        if !stringOk:
            break
        let colon = wire.RustCsgSkipJsonSpace(statusesObj, RustCsgRolloutJsonStringEnd(statusesObj, statusPos) + 1)
        if colon >= statusesObj.len || statusesObj[colon] != ':':
            break
        let agentStatus = RustCsgRolloutJsonStringAt(statusesObj, wire.RustCsgSkipJsonSpace(statusesObj, colon + 1), stringOk)
        if stringOk && (agentStatus == "errored" || agentStatus == "not_found"):
            hasError = true
        let comma = wire.RustCsgSkipJsonSpace(statusesObj, colon + 1)
        if comma < statusesObj.len && statusesObj[comma] == ',':
            statusPos = wire.RustCsgSkipJsonSpace(statusesObj, comma + 1)
            continue
        if comma < statusesObj.len && statusesObj[comma] == '}':
            break
        break
    let status = hasError ? "failed" : "completed"
    let itemJson = RustCsgRolloutCollabAgentToolCallItemJson(callId,
                                                              "wait",
                                                              status,
                                                              senderThreadId,
                                                              receiverThreadIdsJson,
                                                              "null",
                                                              "null",
                                                              "null",
                                                              "")
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay collab_waiting_end upsert failed"

fn RustCsgRolloutReplayCollabCloseEnd(payload: str,
                                       rolloutIndex: int32,
                                       builder: var RustCsgRolloutTurnsBuilder,
                                       outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay collab_close_end missing call_id"
        return
    let senderThreadId = RustCsgRolloutJsonRequiredString(payload, "sender_thread_id", ok)
