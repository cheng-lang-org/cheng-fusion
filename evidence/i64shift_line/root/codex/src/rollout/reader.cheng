    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("note", note))
    out = wire.RustCsgCat(out, "}")
    outOk = true
    return out

fn RustCsgRolloutMemoryCitationEntriesToV2(raw: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start >= raw.len || raw[start] != '[':
        return ""
    var out = "["
    var first = true
    var pos = wire.RustCsgSkipJsonSpace(raw, start + 1)
    if pos < raw.len && raw[pos] == ']':
        outOk = true
        return "[]"
    while pos < raw.len:
        let objectJson = RustCsgRolloutJsonObjectAt(raw, pos)
        if objectJson == "":
            return ""
        var entryOk: bool
        let entryJson = RustCsgRolloutMemoryCitationEntryToV2(objectJson, entryOk)
        if !entryOk:
            return ""
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, entryJson)
        first = false
        pos = wire.RustCsgSkipJsonSpace(raw, pos + objectJson.len)
        if pos < raw.len && raw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(raw, pos + 1)
            continue
        if pos < raw.len && raw[pos] == ']':
            outOk = true
            return wire.RustCsgCat(out, "]")
        return ""
    return ""

fn RustCsgRolloutMemoryCitationToV2(raw: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start >= raw.len || raw[start] != '{':
        return ""
    let objectJson = RustCsgRolloutJsonObjectAt(raw, start)
    if objectJson == "":
        return ""
    let entriesStart = RustCsgRolloutJsonTopFieldValueStart(objectJson, "entries")
    let entriesRaw = RustCsgRolloutJsonArrayAt(objectJson, entriesStart)
    if entriesRaw == "":
        return ""
    var ok: bool
    let entriesJson = RustCsgRolloutMemoryCitationEntriesToV2(entriesRaw, ok)
    if !ok:
        return ""
    let rolloutIdsStart = RustCsgRolloutJsonTopFieldValueStart(objectJson, "rollout_ids")
    let rolloutIdsRaw = RustCsgRolloutJsonArrayAt(objectJson, rolloutIdsStart)
    if rolloutIdsRaw == "":
