fn RustCsgRolloutLatestSessionMetaModelProvider(path: str): str =
    let payload = RustCsgRolloutLatestSessionMetaPayloadRaw(path)
    if payload == "":
        return ""
    var present: bool
    var ok: bool
    let modelProvider = RustCsgRolloutJsonOptionalString(payload, "model_provider", present, ok)
    if !present || !ok:
        return ""
    return modelProvider

fn RustCsgRolloutLatestSessionMetaBaseInstructionsRaw(path: str): str =
    let payload = RustCsgRolloutLatestSessionMetaPayloadRaw(path)
    if payload == "":
