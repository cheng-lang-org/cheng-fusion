fn RustCsgRolloutPatchChangeKindToV2(raw: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start >= raw.len || raw[start] != '{':
        return ""
    let obj = RustCsgRolloutJsonObjectAt(raw, start)
    if obj == "":
        return ""
    var ok: bool
    let changeType = RustCsgRolloutJsonRequiredString(obj, "type", ok)
    if !ok:
        return ""
    var v2Type: str
    if changeType == "add":
        v2Type = "add"
    elif changeType == "delete":
        v2Type = "delete"
    elif changeType == "update":
        v2Type = "update"
    else:
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", v2Type))
    if v2Type == "update":
        let diffStart = RustCsgRolloutJsonTopFieldValueStart(obj, "unified_diff")
        if diffStart >= 0:
            var diffEnd: int32
            var diffOk: bool
            let diffVal = RustCsgRolloutJsonRawValueAt(obj, diffStart, diffEnd, diffOk)
            if diffOk:
                out = wire.RustCsgCat(out, ",")
                out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("diff", diffVal))
        let movePathStart = RustCsgRolloutJsonTopFieldValueStart(obj, "move_path")
        if movePathStart >= 0:
            var moveEnd: int32
            var moveOk: bool
            let moveVal = RustCsgRolloutJsonRawValueAt(obj, movePathStart, moveEnd, moveOk)
            if moveOk:
                out = wire.RustCsgCat(out, ",")
                out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("movePath", moveVal))
    out = wire.RustCsgCat(out, "}")
    outOk = true
    return out

fn RustCsgRolloutPatchFileChangeEntryToV2(path: str, changeRaw: str, outOk: var bool): str =
    outOk = false
    var kindOk: bool
    let kindJson = RustCsgRolloutPatchChangeKindToV2(changeRaw, kindOk)
    if !kindOk:
        return ""
    let start = wire.RustCsgSkipJsonSpace(changeRaw, 0)
    if start >= changeRaw.len || changeRaw[start] != '{':
        return ""
    let obj = RustCsgRolloutJsonObjectAt(changeRaw, start)
    if obj == "":
        return ""
    var diff: str
    var ok: bool
    let changeType = RustCsgRolloutJsonRequiredString(obj, "type", ok)
    if !ok:
        return ""
    if changeType == "add":
        diff = RustCsgRolloutJsonRequiredString(obj, "content", ok)
        if !ok:
            return ""
    elif changeType == "delete":
        diff = RustCsgRolloutJsonRequiredString(obj, "content", ok)
        if !ok:
            return ""
    elif changeType == "update":
        diff = RustCsgRolloutJsonRequiredString(obj, "unified_diff", ok)
        if !ok:
            return ""
    else:
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("kind", kindJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("diff", diff))
    out = wire.RustCsgCat(out, "}")
    outOk = true
    return out

fn RustCsgRolloutPatchChangesToV2(changesRaw: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(changesRaw, 0)
    if start >= changesRaw.len:
        return ""
    if changesRaw[start] == '[':
        // Array format: [{"path":"f.txt","kind":{...}}]
        return RustCsgRolloutPatchChangesArrayToV2(changesRaw, start, outOk)
    if changesRaw[start] != '{':
        return ""
    // Object format: {"f.txt":{"type":"update","diff":"..."}}
    var out = "["
    var first = true
    var pos = wire.RustCsgSkipJsonSpace(changesRaw, start + 1)
    if pos < changesRaw.len && changesRaw[pos] == '}':
        outOk = true
        return "[]"
    while pos < changesRaw.len:
        var stringOk: bool
        let key = RustCsgRolloutJsonStringAt(changesRaw, pos, stringOk)
        if !stringOk:
            return ""
        let keyEnd = RustCsgRolloutJsonStringEnd(changesRaw, pos)
        if keyEnd < 0:
            return ""
        let colon = wire.RustCsgSkipJsonSpace(changesRaw, keyEnd + 1)
        if colon >= changesRaw.len || changesRaw[colon] != ':':
            return ""
        let changeObject = RustCsgRolloutJsonObjectAt(changesRaw, colon + 1)
        if changeObject == "":
            return ""
        var entryOk: bool
        let entryJson = RustCsgRolloutPatchFileChangeEntryToV2(key, changeObject, entryOk)
        if !entryOk:
            return ""
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, entryJson)
        first = false
        pos = wire.RustCsgSkipJsonSpace(changesRaw, colon + 1 + changeObject.len)
        if pos < changesRaw.len && changesRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(changesRaw, pos + 1)
            continue
        if pos < changesRaw.len && changesRaw[pos] == '}':
            outOk = true
            return wire.RustCsgCat(out, "]")
        return ""
    return ""

fn RustCsgRolloutPatchChangesArrayToV2(arr: str, start: int32, outOk: var bool): str =
    outOk = false
    var out = "["
    var first = true
    var pos = wire.RustCsgSkipJsonSpace(arr, start + 1)
    if pos < arr.len && arr[pos] == ']':
        outOk = true
        return "[]"
    while pos < arr.len:
        let elem = RustCsgRolloutJsonObjectAt(arr, pos)
        if elem == "":
            return ""
        var pathOk: bool
        let path = RustCsgRolloutJsonRequiredString(elem, "path", pathOk)
        if !pathOk || path == "":
            return ""
        var kindOk: bool
        let kindRaw = RustCsgRolloutJsonOptionalValueOrNullRaw(elem, "kind", kindOk)
        if !kindOk || kindRaw == "":
            return ""
        var entryOk: bool
        let entryJson = RustCsgRolloutPatchFileChangeEntryToV2(path, kindRaw, entryOk)
        if !entryOk:
            return ""
        if !first:
            out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, entryJson)
        first = false
        pos = wire.RustCsgSkipJsonSpace(arr, pos + elem.len)
        if pos < arr.len && arr[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(arr, pos + 1)
            continue
        if pos < arr.len && arr[pos] == ']':
            outOk = true
            return wire.RustCsgCat(out, "]")
        return ""
    return ""

