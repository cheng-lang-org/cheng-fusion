    let start = RustCsgRolloutJsonTopFieldValueStart(invocation, "arguments")
    if start < 0 || wire.RustCsgMatchesAt(invocation, start, "null"):
        outOk = true
        return "null"
    return RustCsgRolloutJsonValueRawAtField(invocation, "arguments", outOk)

fn RustCsgRolloutMcpDurationMillisRaw(payload: str, outOk: var bool): str =
    outOk = false
    let start = RustCsgRolloutJsonTopFieldValueStart(payload, "duration")
    let durationJson = RustCsgRolloutJsonObjectAt(payload, start)
    if durationJson == "":
        return ""
    var ok: bool
    let secsRaw = RustCsgRolloutJsonRequiredNonNegativeIntRaw(durationJson, "secs", ok)
    if !ok || !RustCsgRolloutRawNonNegativeIntLe(secsRaw, "9223372036854775"):
        return ""
    let nanosRaw = RustCsgRolloutJsonRequiredNonNegativeIntRaw(durationJson, "nanos", ok)
    if !ok || !RustCsgRolloutRawNonNegativeIntLe(nanosRaw, "999999999"):
        return ""
    let secs = wire.RustCsgParseInt64(secsRaw)
    let nanos = wire.RustCsgParseInt64(nanosRaw)
    let millis = secs * int64(1000) + nanos / int64(1000000)
    outOk = true
    return strings.Int64ToStr(millis)

fn RustCsgRolloutMcpResultOkJson(coreResult: str,
                                 outStatus: var str,
                                 outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(coreResult, 0)
    let resultObject = RustCsgRolloutJsonObjectAt(coreResult, start)
    if resultObject == "":
        return ""
    var ok: bool
    let content = RustCsgRolloutJsonRequiredArrayRaw(resultObject, "content", ok)
    if !ok:
        return ""
    let structuredContent = RustCsgRolloutJsonOptionalValueOrNullRaw(resultObject, "structuredContent", ok)
    if !ok:
        return ""
    let meta = RustCsgRolloutJsonOptionalValueOrNullRaw(resultObject, "_meta", ok)
    if !ok:
        return ""
    var isError: bool
    let isErrorStart = RustCsgRolloutJsonTopFieldValueStart(resultObject, "isError")
    if isErrorStart >= 0 && !wire.RustCsgMatchesAt(resultObject, isErrorStart, "null"):
        isError = RustCsgRolloutJsonRequiredBool(resultObject, "isError", ok)
        if !ok:
            return ""
    outStatus = isError ? "failed" : "completed"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", content))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("structuredContent", structuredContent))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("_meta", meta))
    out = wire.RustCsgCat(out, "}")
    outOk = true
    return out

fn RustCsgRolloutMcpResultToV2(payload: str,
                               outStatus: var str,
                               outResultJson: var str,
                               outErrorJson: var str,
                               outOk: var bool) =
    outOk = false
    outStatus = ""
    outResultJson = ""
    outErrorJson = ""
    let resultRaw = RustCsgRolloutJsonValueRawAtField(payload, "result", outOk)
    if !outOk:
        return
    let okStart = RustCsgRolloutJsonTopFieldValueStart(resultRaw, "Ok")
    if okStart >= 0:
        let coreResult = RustCsgRolloutJsonValueRawAtField(resultRaw, "Ok", outOk)
        if !outOk:
            return
        outResultJson = RustCsgRolloutMcpResultOkJson(coreResult, outStatus, outOk)
        if !outOk:
            return
        outErrorJson = "null"
        return
    let errStart = RustCsgRolloutJsonTopFieldValueStart(resultRaw, "Err")
    if errStart >= 0:
        var stringOk: bool
        let message = RustCsgRolloutJsonStringAt(resultRaw, errStart, stringOk)
        if !stringOk:
            outOk = false
            return
        outStatus = "failed"
        outResultJson = "null"
        outErrorJson = wire.RustCsgCat3("{", wire.RustCsgJsonFieldStr("message", message), "}")
        outOk = true
        return
    outOk = false

