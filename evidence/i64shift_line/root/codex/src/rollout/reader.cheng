fn RustCsgRolloutFirstUserMessageFromText(text: str): str =
    if text == "":
        return ""
    var lineStart: int32
    var i: int32
    while i <= text.len:
        if i == text.len || text[i] == '\n':
            let lineLen = i - lineStart
            if lineLen > 0:
                let line = wire.RustCsgSliceBytes(text, lineStart, lineLen)
                if wire.RustCsgContains(line, "\"event_msg\"") && wire.RustCsgContains(line, "\"user_message\""):
                    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line, "payload")
                    let payload = RustCsgRolloutJsonObjectAt(line, payloadStart)
                    if payload != "":
                        var ok: bool
                        let eventType = RustCsgRolloutJsonRequiredString(payload, "type", ok)
                        if ok && eventType == "user_message":
                            let message = RustCsgRolloutJsonRequiredString(payload, "message", ok)
                            if ok:
                                return message
            lineStart = i + 1
        i = i + 1
    return ""

fn RustCsgRolloutFirstUserMessageFromFile(path: str): str =
    if path == "":
        return ""
    return RustCsgRolloutFirstUserMessageFromText(home.RustCsgReadFile(path))

fn RustCsgRolloutLatestTurnCwd(path: str): str =
    if path == "":
        return ""
    let text = home.RustCsgReadFile(path)
    if text == "":
        return ""
    var latest: str
    var lineStart: int32
    var pos: int32
    while pos < text.len:
        if text[pos] == '\n':
            if pos > lineStart:
                let cwd = RustCsgRolloutLineTurnCwd(wire.RustCsgSliceBytes(text, lineStart, pos - lineStart))
                if cwd != "":
                    latest = cwd
            lineStart = pos + 1
        pos = pos + 1
    if lineStart < text.len:
        let cwd = RustCsgRolloutLineTurnCwd(wire.RustCsgSliceBytes(text, lineStart, text.len - lineStart))
        if cwd != "":
            latest = cwd
    return latest

type
    RustCsgRolloutTurnsBuilder =
        turnsJson: str
        turnsFirst: bool
        turnJsons: str[]
        turnIds: str[]
        turnItemsJsons: str[]
        turnItemCounts: int32[]
        turnStatuses: str[]
        turnStartedAtJsons: str[]
        turnCompletedAtJsons: str[]
        turnDurationMsJsons: str[]
        turnErrorJsons: str[]
        currentTurnId: str
        currentItemsJson: str
        currentItemsFirst: bool
        currentHasItem: bool
        currentItemCount: int32
        currentStatus: str
        currentStartedAtJson: str
        currentCompletedAtJson: str
        currentDurationMsJson: str
        currentErrorJson: str
        currentOpenedExplicitly: bool
        currentSawCompaction: bool
        currentReasoningId: str
        currentReasoningSummaryJson: str
        currentReasoningContentJson: str
        currentReasoningSummaryFirst: bool
        currentReasoningContentFirst: bool
        currentItemIds: str[]
        currentItemJsons: str[]
        nextItemIndex: int32

fn RustCsgRolloutTurnsBuilderInit(): RustCsgRolloutTurnsBuilder =
    var builder: RustCsgRolloutTurnsBuilder
    builder.turnsJson = "["
    builder.turnsFirst = true
    builder.nextItemIndex = 1
    return builder

fn RustCsgRolloutTurnsBuilderNextItemId(builder: var RustCsgRolloutTurnsBuilder): str =
    let id = wire.RustCsgCat("item-", strings.IntToStr(builder.nextItemIndex))
    builder.nextItemIndex = builder.nextItemIndex + 1
    return id

fn RustCsgRolloutReasoningItemJson(id: str, summaryJson: str, contentJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "reasoning"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("summary", wire.RustCsgCat(summaryJson, "]")))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("content", wire.RustCsgCat(contentJson, "]")))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRolloutTurnJsonFromFields(id: str,
                                    itemsJson: str,
                                    status: str,
                                    startedAtJson: str,
                                    completedAtJson: str,
                                    durationMsJson: str,
                                    errorJson: str): str =
    var turn: types.RustCsgAppTurn
    turn.id = id
    turn.itemsJson = itemsJson
    turn.itemsView = "full"
    turn.status = status
    if turn.status == "":
        turn.status = "completed"
    turn.errorJson = errorJson
    turn.startedAtJson = startedAtJson
    turn.completedAtJson = completedAtJson
    turn.durationMsJson = durationMsJson
    return wire.RustCsgAppTurnToJson(turn)

fn RustCsgRolloutTurnsBuilderResetReasoning(builder: var RustCsgRolloutTurnsBuilder) =
    builder.currentReasoningId = ""
    builder.currentReasoningSummaryJson = ""
    builder.currentReasoningContentJson = ""
    builder.currentReasoningSummaryFirst = true
    builder.currentReasoningContentFirst = true

fn RustCsgRolloutTurnsBuilderResetCurrent(builder: var RustCsgRolloutTurnsBuilder) =
    builder.currentTurnId = ""
    builder.currentItemsJson = ""
    builder.currentItemsFirst = true
    builder.currentItemIds = []
    builder.currentItemJsons = []
    builder.currentHasItem = false
    builder.currentItemCount = 0
    builder.currentStatus = ""
    builder.currentStartedAtJson = ""
    builder.currentCompletedAtJson = ""
    builder.currentDurationMsJson = ""
    builder.currentErrorJson = ""
    builder.currentOpenedExplicitly = false
    builder.currentSawCompaction = false
    RustCsgRolloutTurnsBuilderResetReasoning(builder)

fn RustCsgRolloutTurnsBuilderRebuildCurrentItemsJson(builder: var RustCsgRolloutTurnsBuilder) =
    builder.currentItemsJson = "["
    builder.currentItemsFirst = true
    builder.currentHasItem = false
    builder.currentItemCount = 0
    for i in 0..<builder.currentItemJsons.len:
        if !builder.currentItemsFirst:
            builder.currentItemsJson = wire.RustCsgCat(builder.currentItemsJson, ",")
        builder.currentItemsJson = wire.RustCsgCat(builder.currentItemsJson, builder.currentItemJsons[i])
        builder.currentItemsFirst = false
        builder.currentHasItem = true
        builder.currentItemCount = builder.currentItemCount + 1

fn RustCsgRolloutTurnsBuilderAppendRawItem(builder: var RustCsgRolloutTurnsBuilder,
                                          itemJson: str) =
    var idOk: bool
    let itemId = RustCsgRolloutJsonRequiredString(itemJson, "id", idOk)
    if idOk:
        add(builder.currentItemIds, itemId)
        add(builder.currentItemJsons, itemJson)
    if !builder.currentItemsFirst:
        builder.currentItemsJson = wire.RustCsgCat(builder.currentItemsJson, ",")
    builder.currentItemsJson = wire.RustCsgCat(builder.currentItemsJson, itemJson)
    builder.currentItemsFirst = false
    builder.currentHasItem = true
    builder.currentItemCount = builder.currentItemCount + 1

fn RustCsgRolloutTurnsBuilderUpsertRawItem(builder: var RustCsgRolloutTurnsBuilder,
                                          itemJson: str,
                                          outOk: var bool) =
    outOk = false
    RustCsgRolloutTurnsBuilderFlushReasoning(builder)
    var idOk: bool
    let itemId = RustCsgRolloutJsonRequiredString(itemJson, "id", idOk)
    if !idOk:
        return
    for i in 0..<builder.currentItemIds.len:
        if builder.currentItemIds[i] == itemId:
            builder.currentItemJsons[i] = itemJson
            RustCsgRolloutTurnsBuilderRebuildCurrentItemsJson(builder)
            outOk = true
            return
    RustCsgRolloutTurnsBuilderAppendRawItem(builder, itemJson)
    outOk = true

fn RustCsgRolloutTurnsBuilderUpsertInTurnId(builder: var RustCsgRolloutTurnsBuilder,
                                             turnId: str,
                                             itemJson: str,
                                             outOk: var bool) =
    outOk = false
    if builder.currentTurnId == turnId:
        RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, outOk)
        return
    for i in 0..<builder.turnIds.len:
        if builder.turnIds[i] == turnId:
            var idOk: bool
            let itemId = RustCsgRolloutJsonRequiredString(itemJson, "id", idOk)
            if !idOk:
                outOk = false
                return
            let itemsRaw = builder.turnItemsJsons[i]
            var newItemsJson = "["
            var first = true
            var found = false
            var pos = wire.RustCsgSkipJsonSpace(itemsRaw, 1)
            while pos < itemsRaw.len:
                let objectJson = RustCsgRolloutJsonObjectAt(itemsRaw, pos)
                if objectJson == "":
                    break
                if !first:
                    newItemsJson = wire.RustCsgCat(newItemsJson, ",")
                first = false
                var existingIdOk: bool
                let existingId = RustCsgRolloutJsonRequiredString(objectJson, "id", existingIdOk)
                if existingIdOk && existingId == itemId:
                    newItemsJson = wire.RustCsgCat(newItemsJson, itemJson)
                    found = true
                else:
                    newItemsJson = wire.RustCsgCat(newItemsJson, objectJson)
                pos = wire.RustCsgSkipJsonSpace(itemsRaw, pos + objectJson.len)
                if pos < itemsRaw.len && itemsRaw[pos] == ',':
                    pos = wire.RustCsgSkipJsonSpace(itemsRaw, pos + 1)
                elif pos < itemsRaw.len && itemsRaw[pos] == ']':
                    break
            if !found:
                if !first:
                    newItemsJson = wire.RustCsgCat(newItemsJson, ",")
                newItemsJson = wire.RustCsgCat(newItemsJson, itemJson)
            newItemsJson = wire.RustCsgCat(newItemsJson, "]")
            builder.turnItemsJsons[i] = newItemsJson
            if found:
                builder.turnItemCounts[i] = builder.turnItemCounts[i]
            else:
                builder.turnItemCounts[i] = builder.turnItemCounts[i] + 1
            builder.turnJsons[i] = RustCsgRolloutTurnJsonFromFields(
                builder.turnIds[i],
                newItemsJson,
                builder.turnStatuses[i],
                builder.turnStartedAtJsons[i],
                builder.turnCompletedAtJsons[i],
                builder.turnDurationMsJsons[i],
                builder.turnErrorJsons[i])
            RustCsgRolloutTurnsBuilderRebuildTurnsJson(builder)
            outOk = true
            return
    outOk = true

fn RustCsgRolloutTurnsBuilderFlushReasoning(builder: var RustCsgRolloutTurnsBuilder) =
    if builder.currentReasoningId == "":
        return
    let itemJson = RustCsgRolloutReasoningItemJson(builder.currentReasoningId,
                                                  builder.currentReasoningSummaryJson,
                                                  builder.currentReasoningContentJson)
    RustCsgRolloutTurnsBuilderAppendRawItem(builder, itemJson)
    RustCsgRolloutTurnsBuilderResetReasoning(builder)

fn RustCsgRolloutTurnsBuilderFinishCurrent(builder: var RustCsgRolloutTurnsBuilder) =
    if !builder.currentHasItem && !builder.currentOpenedExplicitly && !builder.currentSawCompaction:
        RustCsgRolloutTurnsBuilderResetCurrent(builder)
        return
    RustCsgRolloutTurnsBuilderFlushReasoning(builder)
    let itemsJson = wire.RustCsgCat(builder.currentItemsJson, "]")
    var status = builder.currentStatus
    if status == "":
        status = "completed"
    let turnJson = RustCsgRolloutTurnJsonFromFields(builder.currentTurnId,
                                                   itemsJson,
                                                   status,
                                                   builder.currentStartedAtJson,
                                                   builder.currentCompletedAtJson,
                                                   builder.currentDurationMsJson,
                                                   builder.currentErrorJson)
    if !builder.turnsFirst:
        builder.turnsJson = wire.RustCsgCat(builder.turnsJson, ",")
    builder.turnsJson = wire.RustCsgCat(builder.turnsJson, turnJson)
    builder.turnsFirst = false
    add(builder.turnJsons, turnJson)
    add(builder.turnIds, builder.currentTurnId)
    add(builder.turnItemsJsons, itemsJson)
    add(builder.turnItemCounts, builder.currentItemCount)
    add(builder.turnStatuses, status)
    add(builder.turnStartedAtJsons, builder.currentStartedAtJson)
    add(builder.turnCompletedAtJsons, builder.currentCompletedAtJson)
    add(builder.turnDurationMsJsons, builder.currentDurationMsJson)
    add(builder.turnErrorJsons, builder.currentErrorJson)
    RustCsgRolloutTurnsBuilderResetCurrent(builder)

fn RustCsgRolloutTurnsBuilderEnsureTurn(builder: var RustCsgRolloutTurnsBuilder,
                                        rolloutIndex: int32) =
    if builder.currentTurnId != "":
        return
    builder.currentTurnId = wire.RustCsgCat("rollout-", strings.IntToStr(rolloutIndex))
    builder.currentItemsJson = "["
    builder.currentItemsFirst = true
    builder.currentItemIds = []
    builder.currentItemJsons = []
    builder.currentHasItem = false
    builder.currentItemCount = 0
    builder.currentStatus = "completed"
    builder.currentStartedAtJson = ""
    builder.currentCompletedAtJson = ""
    builder.currentDurationMsJson = ""
    builder.currentErrorJson = ""
    builder.currentOpenedExplicitly = false
    builder.currentSawCompaction = false

fn RustCsgRolloutTurnsBuilderStartExplicit(builder: var RustCsgRolloutTurnsBuilder,
                                           turnId: str,
                                           startedAtJson: str) =
    RustCsgRolloutTurnsBuilderFinishCurrent(builder)
    builder.currentTurnId = turnId
    builder.currentItemsJson = "["
    builder.currentItemsFirst = true
    builder.currentItemIds = []
    builder.currentItemJsons = []
    builder.currentHasItem = false
    builder.currentItemCount = 0
    builder.currentStatus = "inProgress"
    builder.currentStartedAtJson = startedAtJson
    builder.currentCompletedAtJson = ""
    builder.currentDurationMsJson = ""
    builder.currentErrorJson = ""
    builder.currentOpenedExplicitly = true
    builder.currentSawCompaction = false
    RustCsgRolloutTurnsBuilderResetReasoning(builder)

fn RustCsgRolloutTurnsBuilderCompleteActive(builder: var RustCsgRolloutTurnsBuilder,
                                            completedAtJson: str,
                                            durationMsJson: str) =
    if builder.currentStatus == "completed" || builder.currentStatus == "inProgress":
        builder.currentStatus = "completed"
    builder.currentCompletedAtJson = completedAtJson
    builder.currentDurationMsJson = durationMsJson
    RustCsgRolloutTurnsBuilderFinishCurrent(builder)

fn RustCsgRolloutTurnsBuilderFailActive(builder: var RustCsgRolloutTurnsBuilder,
                                        errorJson: str) =
    if builder.currentTurnId == "":
        return
    builder.currentStatus = "failed"
    builder.currentErrorJson = errorJson

fn RustCsgRolloutTurnsBuilderAbortActive(builder: var RustCsgRolloutTurnsBuilder,
                                         completedAtJson: str,
                                         durationMsJson: str) =
    if builder.currentTurnId == "":
        return
    builder.currentStatus = "interrupted"
    builder.currentCompletedAtJson = completedAtJson
    builder.currentDurationMsJson = durationMsJson

fn RustCsgRolloutTurnsBuilderCompleteStored(builder: var RustCsgRolloutTurnsBuilder,
                                            turnId: str,
                                            completedAtJson: str,
                                            durationMsJson: str): bool =
    var found: bool
    var newJsons: str[]
    var newIds: str[]
    var newItemsJsons: str[]
    var newItemCounts: int32[]
    var newStatuses: str[]
    var newStartedAtJsons: str[]
    var newCompletedAtJsons: str[]
    var newDurationMsJsons: str[]
    var newErrorJsons: str[]
    for i in 0..<builder.turnIds.len:
        let id = builder.turnIds[i]
        let itemsJson = builder.turnItemsJsons[i]
        var status = builder.turnStatuses[i]
        let startedAtJson = builder.turnStartedAtJsons[i]
        var completedJson = builder.turnCompletedAtJsons[i]
        var durationJson = builder.turnDurationMsJsons[i]
        let errorJson = builder.turnErrorJsons[i]
        if id == turnId:
            found = true
            if status == "completed" || status == "inProgress":
                status = "completed"
            completedJson = completedAtJson
            durationJson = durationMsJson
        let turnJson = RustCsgRolloutTurnJsonFromFields(id,
                                                       itemsJson,
                                                       status,
                                                       startedAtJson,
                                                       completedJson,
                                                       durationJson,
                                                       errorJson)
        add(newJsons, turnJson)
        add(newIds, id)
        add(newItemsJsons, itemsJson)
        add(newItemCounts, builder.turnItemCounts[i])
        add(newStatuses, status)
        add(newStartedAtJsons, startedAtJson)
        add(newCompletedAtJsons, completedJson)
        add(newDurationMsJsons, durationJson)
        add(newErrorJsons, errorJson)
    if !found:
        return false
    builder.turnJsons = newJsons
    builder.turnIds = newIds
    builder.turnItemsJsons = newItemsJsons
    builder.turnItemCounts = newItemCounts
    builder.turnStatuses = newStatuses
    builder.turnStartedAtJsons = newStartedAtJsons
    builder.turnCompletedAtJsons = newCompletedAtJsons
    builder.turnDurationMsJsons = newDurationMsJsons
    builder.turnErrorJsons = newErrorJsons
    RustCsgRolloutTurnsBuilderRebuildTurnsJson(builder)
    return true

fn RustCsgRolloutTurnsBuilderAbortStored(builder: var RustCsgRolloutTurnsBuilder,
                                         turnId: str,
                                         completedAtJson: str,
                                         durationMsJson: str): bool =
    var found: bool
    var newJsons: str[]
    var newIds: str[]
    var newItemsJsons: str[]
    var newItemCounts: int32[]
    var newStatuses: str[]
    var newStartedAtJsons: str[]
    var newCompletedAtJsons: str[]
    var newDurationMsJsons: str[]
    var newErrorJsons: str[]
    for i in 0..<builder.turnIds.len:
        let id = builder.turnIds[i]
        let itemsJson = builder.turnItemsJsons[i]
        var status = builder.turnStatuses[i]
        let startedAtJson = builder.turnStartedAtJsons[i]
        var completedJson = builder.turnCompletedAtJsons[i]
        var durationJson = builder.turnDurationMsJsons[i]
        let errorJson = builder.turnErrorJsons[i]
        if id == turnId:
            found = true
            status = "interrupted"
            completedJson = completedAtJson
            durationJson = durationMsJson
        let turnJson = RustCsgRolloutTurnJsonFromFields(id,
                                                       itemsJson,
                                                       status,
                                                       startedAtJson,
                                                       completedJson,
                                                       durationJson,
                                                       errorJson)
        add(newJsons, turnJson)
        add(newIds, id)
        add(newItemsJsons, itemsJson)
        add(newItemCounts, builder.turnItemCounts[i])
        add(newStatuses, status)
        add(newStartedAtJsons, startedAtJson)
        add(newCompletedAtJsons, completedJson)
        add(newDurationMsJsons, durationJson)
        add(newErrorJsons, errorJson)
    if !found:
        return false
    builder.turnJsons = newJsons
    builder.turnIds = newIds
    builder.turnItemsJsons = newItemsJsons
    builder.turnItemCounts = newItemCounts
    builder.turnStatuses = newStatuses
    builder.turnStartedAtJsons = newStartedAtJsons
    builder.turnCompletedAtJsons = newCompletedAtJsons
    builder.turnDurationMsJsons = newDurationMsJsons
    builder.turnErrorJsons = newErrorJsons
    RustCsgRolloutTurnsBuilderRebuildTurnsJson(builder)
    return true

fn RustCsgRolloutTurnsBuilderRebuildTurnsJson(builder: var RustCsgRolloutTurnsBuilder) =
    builder.turnsJson = "["
    builder.turnsFirst = true
    for i in 0..<builder.turnJsons.len:
        if !builder.turnsFirst:
            builder.turnsJson = wire.RustCsgCat(builder.turnsJson, ",")
        builder.turnsJson = wire.RustCsgCat(builder.turnsJson, builder.turnJsons[i])
        builder.turnsFirst = false

fn RustCsgRolloutTurnsBuilderTokenUsageOwnerId(builder: var RustCsgRolloutTurnsBuilder): str =
    if builder.currentTurnId != "":
        return builder.currentTurnId
    var reverseIndex: int32
    reverseIndex = builder.turnIds.len
    while reverseIndex > 0:
        reverseIndex = reverseIndex - 1
        let status = builder.turnStatuses[reverseIndex]
        if status == "completed" || status == "failed" || status == "interrupted":
            return builder.turnIds[reverseIndex]
    if builder.turnIds.len > 0:
        return builder.turnIds[builder.turnIds.len - 1]
    return ""

fn RustCsgRolloutTurnsBuilderCompletedItemCount(builder: var RustCsgRolloutTurnsBuilder): int32 =
    var out: int32
    for i in 0..<builder.turnItemCounts.len:
        out = out + builder.turnItemCounts[i]
    return out

fn RustCsgRolloutTurnsBuilderRollback(builder: var RustCsgRolloutTurnsBuilder,
                                      count: int32) =
    RustCsgRolloutTurnsBuilderFinishCurrent(builder)
    var newLen: int32
    if count >= builder.turnJsons.len:
        newLen = 0
    else:
        newLen = builder.turnJsons.len - count
    var keptJsons: str[]
    var keptIds: str[]
    var keptItemsJsons: str[]
    var keptItemCounts: int32[]
    var keptStatuses: str[]
    var keptStartedAtJsons: str[]
    var keptCompletedAtJsons: str[]
    var keptDurationMsJsons: str[]
    var keptErrorJsons: str[]
    for i in 0..<newLen:
        add(keptJsons, builder.turnJsons[i])
        add(keptIds, builder.turnIds[i])
        add(keptItemsJsons, builder.turnItemsJsons[i])
        add(keptItemCounts, builder.turnItemCounts[i])
        add(keptStatuses, builder.turnStatuses[i])
        add(keptStartedAtJsons, builder.turnStartedAtJsons[i])
        add(keptCompletedAtJsons, builder.turnCompletedAtJsons[i])
        add(keptDurationMsJsons, builder.turnDurationMsJsons[i])
        add(keptErrorJsons, builder.turnErrorJsons[i])
    builder.turnJsons = keptJsons
    builder.turnIds = keptIds
    builder.turnItemsJsons = keptItemsJsons
    builder.turnItemCounts = keptItemCounts
    builder.turnStatuses = keptStatuses
    builder.turnStartedAtJsons = keptStartedAtJsons
    builder.turnCompletedAtJsons = keptCompletedAtJsons
    builder.turnDurationMsJsons = keptDurationMsJsons
    builder.turnErrorJsons = keptErrorJsons
    RustCsgRolloutTurnsBuilderRebuildTurnsJson(builder)
    builder.nextItemIndex = RustCsgRolloutTurnsBuilderCompletedItemCount(builder) + 1

fn RustCsgRolloutTurnsBuilderMarkCompacted(builder: var RustCsgRolloutTurnsBuilder,
                                           rolloutIndex: int32) =
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    builder.currentSawCompaction = true

fn RustCsgRolloutTurnsBuilderAddItem(builder: var RustCsgRolloutTurnsBuilder,
                                     itemJson: str) =
    RustCsgRolloutTurnsBuilderFlushReasoning(builder)
    RustCsgRolloutTurnsBuilderAppendRawItem(builder, itemJson)

fn RustCsgRolloutTurnsBuilderEnsureReasoning(builder: var RustCsgRolloutTurnsBuilder) =
    if builder.currentReasoningId != "":
        return
    builder.currentReasoningId = RustCsgRolloutTurnsBuilderNextItemId(builder)
    builder.currentReasoningSummaryJson = "["
    builder.currentReasoningContentJson = "["
    builder.currentReasoningSummaryFirst = true
    builder.currentReasoningContentFirst = true
    builder.currentHasItem = true

fn RustCsgRolloutTurnsBuilderAppendReasoningSummary(builder: var RustCsgRolloutTurnsBuilder,
                                                    text: str) =
    RustCsgRolloutTurnsBuilderEnsureReasoning(builder)
    if !builder.currentReasoningSummaryFirst:
        builder.currentReasoningSummaryJson = wire.RustCsgCat(builder.currentReasoningSummaryJson, ",")
    builder.currentReasoningSummaryJson = wire.RustCsgCat(builder.currentReasoningSummaryJson,
                                                         wire.RustCsgJsonQuote(text))
    builder.currentReasoningSummaryFirst = false

fn RustCsgRolloutTurnsBuilderAppendReasoningContent(builder: var RustCsgRolloutTurnsBuilder,
                                                    text: str) =
    RustCsgRolloutTurnsBuilderEnsureReasoning(builder)
    if !builder.currentReasoningContentFirst:
        builder.currentReasoningContentJson = wire.RustCsgCat(builder.currentReasoningContentJson, ",")
    builder.currentReasoningContentJson = wire.RustCsgCat(builder.currentReasoningContentJson,
                                                         wire.RustCsgJsonQuote(text))
    builder.currentReasoningContentFirst = false

fn RustCsgRolloutJsonArrayIsEmptyAt(text: str, start: int32): bool =
    if start < 0:
        return true
    var pos = wire.RustCsgSkipJsonSpace(text, start)
    if pos >= text.len || text[pos] != '[':
        return false
    pos = wire.RustCsgSkipJsonSpace(text, pos + 1)
    return pos < text.len && text[pos] == ']'

fn RustCsgRolloutJsonValueIsNullOrAbsent(text: str, key: str): bool =
    let start = RustCsgRolloutJsonTopFieldValueStart(text, key)
    if start < 0:
        return true
    return wire.RustCsgMatchesAt(text, start, "null")

fn RustCsgRolloutJsonOptionalIntRaw(text: str, key: str, outOk: var bool): str =
    outOk = true
    let start = RustCsgRolloutJsonTopFieldValueStart(text, key)
    if start < 0:
        return ""
    if wire.RustCsgMatchesAt(text, start, "null"):
        return ""
    var pos: int32
    pos = start
    if pos < text.len && text[pos] == '-':
        pos = pos + 1
    let digitStart = pos
    while pos < text.len:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(text, pos, 1))
        if digit < 0:
            break
        pos = pos + 1
    if pos == digitStart:
        outOk = false
        return ""
    let end = wire.RustCsgSkipJsonSpace(text, pos)
    if end < text.len && text[end] != ',' && text[end] != '}':
        outOk = false
        return ""
    return RustCsgRolloutBuildSlice(text, start, pos)

fn RustCsgRolloutParseNonNegativeInt32Saturating(raw: str, outOk: var bool): int32 =
    outOk = false
    if raw == "":
        return 0
    if raw[0] == '-':
        return 0
    var first: int32
    while first < raw.len && raw[first] == '0':
        first = first + 1
    if first == raw.len:
        outOk = true
        return 0
    let significantLen = raw.len - first
    if significantLen > 10:
        outOk = true
        return 2147483647
    if significantLen == 10:
        let maxText = "2147483647"
        var j: int32
        while j < 10:
            let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(raw, first + j, 1))
            let maxDigit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(maxText, j, 1))
            if digit < 0:
                return 0
            if digit > maxDigit:
                outOk = true
                return 2147483647
            if digit < maxDigit:
                j = 10
            else:
                j = j + 1
    var out: int32
    for i in first..<raw.len:
        let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(raw, i, 1))
        if digit < 0:
            return 0
        out = out * 10 + digit
    outOk = true
    return out

fn RustCsgRolloutJsonRequiredNonNegativeCount(text: str, key: str, outOk: var bool): int32 =
    var rawOk: bool
    let raw = RustCsgRolloutJsonOptionalIntRaw(text, key, rawOk)
    if !rawOk || raw == "":
        outOk = false
        return 0
    return RustCsgRolloutParseNonNegativeInt32Saturating(raw, outOk)

fn RustCsgRolloutJsonRequiredNonNegativeIntRaw(text: str, key: str, outOk: var bool): str =
    var rawOk: bool
    let raw = RustCsgRolloutJsonOptionalIntRaw(text, key, rawOk)
    if !rawOk || raw == "":
        outOk = false
        return ""
    if raw[0] == '-':
        outOk = false
        return ""
    outOk = true
    return raw

fn RustCsgRolloutJsonRequiredInt64(text: str, key: str, outOk: var bool): int64 =
    var rawOk: bool
    let raw = RustCsgRolloutJsonOptionalIntRaw(text, key, rawOk)
    if !rawOk || raw == "":
        outOk = false
        return int64(0)
    outOk = true
    return wire.RustCsgParseInt64(raw)

fn RustCsgRolloutTokenUsageBreakdownFromJson(text: str, outOk: var bool): types.RustCsgTokenUsageBreakdown =
    outOk = false
    var usage: types.RustCsgTokenUsageBreakdown
    var ok: bool
    usage.totalTokens = RustCsgRolloutJsonRequiredInt64(text, "total_tokens", ok)
    if !ok:
        return usage
    usage.inputTokens = RustCsgRolloutJsonRequiredInt64(text, "input_tokens", ok)
    if !ok:
        return usage
    usage.cachedInputTokens = RustCsgRolloutJsonRequiredInt64(text, "cached_input_tokens", ok)
    if !ok:
        return usage
    usage.outputTokens = RustCsgRolloutJsonRequiredInt64(text, "output_tokens", ok)
    if !ok:
        return usage
    usage.reasoningOutputTokens = RustCsgRolloutJsonRequiredInt64(text, "reasoning_output_tokens", ok)
    if !ok:
        return usage
    outOk = true
    return usage

fn RustCsgRolloutThreadTokenUsageFromTokenCountPayload(payload: str,
                                                       outPresent: var bool,
                                                       outOk: var bool): types.RustCsgThreadTokenUsage =
    outPresent = false
    outOk = true
    var usage: types.RustCsgThreadTokenUsage
    let infoStart = RustCsgRolloutJsonTopFieldValueStart(payload, "info")
    if infoStart < 0 || wire.RustCsgMatchesAt(payload, infoStart, "null"):
        return usage
    let infoJson = RustCsgRolloutJsonObjectAt(payload, infoStart)
    if infoJson == "":
        outOk = false
        return usage
    let totalStart = RustCsgRolloutJsonTopFieldValueStart(infoJson, "total_token_usage")
    let totalJson = RustCsgRolloutJsonObjectAt(infoJson, totalStart)
    if totalJson == "":
        outOk = false
        return usage
    let lastStart = RustCsgRolloutJsonTopFieldValueStart(infoJson, "last_token_usage")
    let lastJson = RustCsgRolloutJsonObjectAt(infoJson, lastStart)
    if lastJson == "":
        outOk = false
        return usage
    var ok: bool
    usage.total = RustCsgRolloutTokenUsageBreakdownFromJson(totalJson, ok)
    if !ok:
        outOk = false
        return usage
    usage.last = RustCsgRolloutTokenUsageBreakdownFromJson(lastJson, ok)
    if !ok:
        outOk = false
        return usage
    let modelContextWindowRaw = RustCsgRolloutJsonOptionalIntRaw(infoJson, "model_context_window", ok)
    if !ok:
        outOk = false
        return usage
    if modelContextWindowRaw == "":
        usage.modelContextWindowJson = "null"
    else:
        usage.modelContextWindowJson = modelContextWindowRaw
    outPresent = true
    outOk = true
    return usage

fn RustCsgRolloutJsonOptionalString(text: str, key: str, outPresent: var bool, outOk: var bool): str =
    outPresent = false
    outOk = true
    let start = RustCsgRolloutJsonTopFieldValueStart(text, key)
    if start < 0:
        return ""
    if wire.RustCsgMatchesAt(text, start, "null"):
        return ""
    outPresent = true
    let value = RustCsgRolloutJsonStringAt(text, start, outOk)
    return value

fn RustCsgRolloutCodexErrorSimpleToV2(value: str, outAffects: var bool, outOk: var bool): str =
    outOk = true
    outAffects = true
    if value == "thread_rollback_failed":
        outAffects = false
        return wire.RustCsgJsonQuote("threadRollbackFailed")
    if value == "context_window_exceeded":
        return wire.RustCsgJsonQuote("contextWindowExceeded")
    if value == "usage_limit_exceeded":
        return wire.RustCsgJsonQuote("usageLimitExceeded")
    if value == "server_overloaded":
        return wire.RustCsgJsonQuote("serverOverloaded")
    if value == "cyber_policy":
        return wire.RustCsgJsonQuote("cyberPolicy")
    if value == "internal_server_error":
        return wire.RustCsgJsonQuote("internalServerError")
    if value == "unauthorized":
        return wire.RustCsgJsonQuote("unauthorized")
    if value == "bad_request":
        return wire.RustCsgJsonQuote("badRequest")
    if value == "sandbox_error":
        return wire.RustCsgJsonQuote("sandboxError")
    if value == "other":
        return wire.RustCsgJsonQuote("other")
    outOk = false
    return ""

fn RustCsgRolloutCodexErrorHttpVariantToV2(key: str, outKey: var str, outAffects: var bool): bool =
    outAffects = true
    if key == "http_connection_failed":
        outKey = "httpConnectionFailed"
        return true
    if key == "response_stream_connection_failed":
        outKey = "responseStreamConnectionFailed"
        return true
    if key == "response_stream_disconnected":
        outKey = "responseStreamDisconnected"
        return true
    if key == "response_too_many_failed_attempts":
        outKey = "responseTooManyFailedAttempts"
        return true
    if key == "active_turn_not_steerable":
        outKey = "activeTurnNotSteerable"
        outAffects = false
        return true
    return false

fn RustCsgRolloutCodexErrorObjectToV2(raw: str, outAffects: var bool, outOk: var bool): str =
    outOk = false
    outAffects = true
    let start = wire.RustCsgSkipJsonSpace(raw, 0)
    if start >= raw.len || raw[start] != '{':
        return ""
    var keyOk: bool
    let key = RustCsgRolloutJsonStringAt(raw, wire.RustCsgSkipJsonSpace(raw, start + 1), keyOk)
    if !keyOk:
        return ""
    var v2Key: str
    if !RustCsgRolloutCodexErrorHttpVariantToV2(key, v2Key, outAffects):
        return ""
    let valueStart = RustCsgRolloutJsonTopFieldValueStart(raw, key)
    let valueObject = RustCsgRolloutJsonObjectAt(raw, valueStart)
    if valueObject == "":
        return ""
    if key == "active_turn_not_steerable":
        outOk = true
        return wire.RustCsgCat3("{", wire.RustCsgJsonFieldRaw(v2Key, valueObject), "}")
    var intOk: bool
    var statusJson = RustCsgRolloutJsonOptionalIntRaw(valueObject, "http_status_code", intOk)
    if !intOk:
        return ""
    if statusJson == "":
        statusJson = "null"
    var inner = "{"
    inner = wire.RustCsgCat(inner, wire.RustCsgJsonFieldRaw("httpStatusCode", statusJson))
    inner = wire.RustCsgCat(inner, "}")
    outOk = true
    return wire.RustCsgCat3("{", wire.RustCsgJsonFieldRaw(v2Key, inner), "}")

fn RustCsgRolloutCodexErrorInfoToV2(payload: str,
                                    outAffects: var bool,
                                    outOk: var bool): str =
    outOk = true
    outAffects = true
    let start = RustCsgRolloutJsonTopFieldValueStart(payload, "codex_error_info")
    if start < 0 || wire.RustCsgMatchesAt(payload, start, "null"):
        return "null"
    if start < payload.len && payload[start] == '"':
        var stringOk: bool
        let value = RustCsgRolloutJsonStringAt(payload, start, stringOk)
        if !stringOk:
            outOk = false
            return ""
        return RustCsgRolloutCodexErrorSimpleToV2(value, outAffects, outOk)
    if start < payload.len && payload[start] == '{':
        return RustCsgRolloutCodexErrorObjectToV2(RustCsgRolloutJsonObjectAt(payload, start),
                                                 outAffects,
                                                 outOk)
    outOk = false
    return ""

fn RustCsgRolloutTurnErrorJson(message: str, codexErrorInfoJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", message))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("codexErrorInfo", codexErrorInfoJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("additionalDetails", "null"))
    out = wire.RustCsgCat(out, "}")
    return out

fn RustCsgRolloutIsTrimSpace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

fn RustCsgRolloutHasTrimmedText(message: str): bool =
    for i in 0..<message.len:
        if !RustCsgRolloutIsTrimSpace(message[i]):
