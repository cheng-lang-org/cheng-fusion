fn RustCsgRolloutReplayWebSearchEnd(payload: str,
                                     rolloutIndex: int32,
                                     builder: var RustCsgRolloutTurnsBuilder,
                                     outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay web_search_end missing call_id"
        return
    let query = RustCsgRolloutJsonRequiredString(payload, "query", ok)
    if !ok:
        outError = "rollout replay web_search_end missing query"
        return
    let actionRaw = RustCsgRolloutJsonValueRawAtField(payload, "action", ok)
    if !ok:
        outError = "rollout replay web_search_end invalid action"
        return
    var actionOk: bool
    let actionJson = RustCsgRolloutWebSearchActionToV2(actionRaw, actionOk)
    if !actionOk:
        outError = "rollout replay web_search_end action not ported"
        return
    let itemJson = RustCsgRolloutWebSearchItemJson(callId, query, actionJson)
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay web_search_end upsert failed"

