# ── CommandExecution item builder ─────────────────────────────────────────
fn RustCsgRolloutExecStatusToV2(status: str): str =
    if status == "completed":
        return "completed"
    if status == "failed":
        return "failed"
    if status == "declined":
        return "cancelled"
    return "inProgress"

fn RustCsgRolloutExecSourceToV2(source: str): str =
    if source == "user_shell":
        return "userShell"
    if source == "unified_exec_startup":
        return "unifiedExecStartup"
    if source == "unified_exec_interaction":
        return "unifiedExecInteraction"
    return "agent"

fn RustCsgRolloutCommandArrayToShellText(commandRaw: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(commandRaw, 0)
    if start >= commandRaw.len || commandRaw[start] != '[':
        return ""
    var out: str
    var first = true
    var pos = wire.RustCsgSkipJsonSpace(commandRaw, start + 1)
    if pos < commandRaw.len && commandRaw[pos] == ']':
        outOk = true
        return ""
    while pos < commandRaw.len:
        var ok: bool
        let arg = RustCsgRolloutJsonStringAt(commandRaw, pos, ok)
        if !ok:
            return ""
        if !first:
            out = wire.RustCsgCat(out, " ")
        out = wire.RustCsgCat(out, arg)
        first = false
        let argEnd = RustCsgRolloutJsonStringEnd(commandRaw, pos)
        if argEnd < 0:
            return ""
        pos = wire.RustCsgSkipJsonSpace(commandRaw, argEnd + 1)
        if pos < commandRaw.len && commandRaw[pos] == ',':
            pos = wire.RustCsgSkipJsonSpace(commandRaw, pos + 1)
            continue
        if pos < commandRaw.len && commandRaw[pos] == ']':
            outOk = true
            return out
        return ""
    return ""

fn RustCsgRolloutDurationSecsNanosToMsStr(payload: str, outOk: var bool): str =
    outOk = false
    let start = wire.RustCsgSkipJsonSpace(payload, 0)
    if start >= payload.len || payload[start] != '{':
        return ""
    let obj = RustCsgRolloutJsonObjectAt(payload, start)
    if obj == "":
        return ""
    var ok: bool
    let secsRaw = RustCsgRolloutJsonRequiredNonNegativeIntRaw(obj, "seconds", ok)
    if !ok:
        return ""
    let nanosRaw = RustCsgRolloutJsonRequiredNonNegativeIntRaw(obj, "nanos", ok)
    if !ok:
        return ""
    let secs = wire.RustCsgParseInt64(secsRaw)
    let nanos = wire.RustCsgParseInt64(nanosRaw)
    let millis = secs * int64(1000) + nanos / int64(1000000)
    outOk = true
    return strings.Int64ToStr(millis)

fn RustCsgRolloutCommandExecutionItemJson(id: str,
                                            command: str,
                                            cwd: str,
                                            processIdJson: str,
                                            source: str,
                                            status: str,
                                            aggregatedOutputJson: str,
                                            exitCodeJson: str,
                                            durationMsJson: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "commandExecution"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", id))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("command", command))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    if processIdJson != "null":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("processId", processIdJson))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("source", source))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", status))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("commandActions", "[]"))
    if aggregatedOutputJson != "null" && aggregatedOutputJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("aggregatedOutput", aggregatedOutputJson))
    if exitCodeJson != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("exitCode", exitCodeJson))
    if durationMsJson != "" && durationMsJson != "null":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("durationMs", durationMsJson))
    out = wire.RustCsgCat(out, "}")
    return out

