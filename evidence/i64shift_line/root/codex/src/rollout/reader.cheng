    if obj == "":
        return ""
    var ok: bool
    let actionType = RustCsgRolloutJsonRequiredString(obj, "type", ok)
    if !ok:
        return ""
    var v2Type: str
    if actionType == "search":
        v2Type = "search"
    elif actionType == "open_page":
        v2Type = "openPage"
    elif actionType == "find_in_page":
        v2Type = "findInPage"
    elif actionType == "other":
        v2Type = "other"
    else:
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", v2Type))
    out = RustCsgRolloutCopyOptionalJsonField(obj, "query", out)
    out = RustCsgRolloutCopyOptionalJsonField(obj, "url", out)
    out = RustCsgRolloutCopyOptionalJsonField(obj, "pattern", out)
    out = RustCsgRolloutCopyOptionalJsonField(obj, "queries", out)
    out = wire.RustCsgCat(out, "}")
    outOk = true
    return out

