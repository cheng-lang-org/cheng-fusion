fn RustCsgRolloutReplayEventLine(line: str,
                                 rolloutIndex: int32,
                                 builder: var RustCsgRolloutTurnsBuilder,
                                 outError: var str) =
    var ok: bool
    let itemType = RustCsgRolloutJsonRequiredString(line, "type", ok)
    if !ok:
        outError = "rollout replay line missing type"
        return
    if itemType == "session_meta" || itemType == "turn_context" || itemType == "response_item":
        return
    if itemType == "compacted":
        RustCsgRolloutReplayCompactedLine(line, rolloutIndex, builder, outError)
        return
    if itemType != "event_msg":
        outError = wire.RustCsgCat("rollout replay item type not ported: ", itemType)
        return
    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line, "payload")
    let payload = RustCsgRolloutJsonObjectAt(line, payloadStart)
    if payload == "":
        outError = "rollout replay event_msg missing payload"
        return
    let eventType = RustCsgRolloutJsonRequiredString(payload, "type", ok)
    if !ok:
        outError = "rollout replay event_msg missing type"
        return
    if eventType == "user_message":
        RustCsgRolloutReplayUserMessage(payload, rolloutIndex, builder, outError)
        return
    if eventType == "agent_message":
        RustCsgRolloutReplayAgentMessage(payload, rolloutIndex, builder, outError)
        return
    if eventType == "agent_reasoning":
        RustCsgRolloutReplayAgentReasoning(payload, rolloutIndex, builder, outError)
        return
    if eventType == "agent_reasoning_raw_content":
        RustCsgRolloutReplayAgentReasoningRawContent(payload, rolloutIndex, builder, outError)
        return
    if eventType == "context_compacted":
        RustCsgRolloutReplayContextCompacted(rolloutIndex, builder)
        return
    if eventType == "entered_review_mode":
        RustCsgRolloutReplayEnteredReviewMode(payload, rolloutIndex, builder, outError)
        return
    if eventType == "exited_review_mode":
        RustCsgRolloutReplayExitedReviewMode(payload, rolloutIndex, builder, outError)
        return
    if eventType == "mcp_tool_call_begin":
        RustCsgRolloutReplayMcpToolCallBegin(payload, rolloutIndex, builder, outError)
        return
    if eventType == "mcp_tool_call_end":
        RustCsgRolloutReplayMcpToolCallEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "task_started" || eventType == "turn_started":
        RustCsgRolloutReplayTurnStarted(payload, builder, outError)
        return
    if eventType == "task_complete" || eventType == "turn_complete":
        RustCsgRolloutReplayTurnComplete(payload, builder, outError)
        return
    if eventType == "error":
        RustCsgRolloutReplayError(payload, builder, outError)
        return
    if eventType == "turn_aborted":
        RustCsgRolloutReplayTurnAborted(payload, builder, outError)
        return
    if eventType == "thread_rolled_back":
        RustCsgRolloutReplayThreadRolledBack(payload, builder, outError)
        return
    RustCsgRolloutReplayEventMsgTail(eventType, payload, rolloutIndex, builder, outError)
    return

fn RustCsgRolloutReplayEventMsgTail(eventType: str,
                                     payload: str,
                                     rolloutIndex: int32,
                                     builder: var RustCsgRolloutTurnsBuilder,
                                     outError: var str) =
    if eventType == "web_search_end":
        RustCsgRolloutReplayWebSearchEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "image_generation_end":
        RustCsgRolloutReplayImageGenerationEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "view_image_tool_call":
        RustCsgRolloutReplayViewImageToolCall(payload, rolloutIndex, builder, outError)
        return
    if eventType == "item_completed":
        RustCsgRolloutReplayItemCompleted(payload, rolloutIndex, builder, outError)
        return
    if eventType == "patch_apply_end":
        RustCsgRolloutReplayPatchApplyEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "exec_command_end":
        RustCsgRolloutReplayExecCommandEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "guardian_assessment":
        RustCsgRolloutReplayGuardianAssessment(payload, rolloutIndex, builder, outError)
        return
    if eventType == "dynamic_tool_call_request":
        RustCsgRolloutReplayDynamicToolCallRequest(payload, rolloutIndex, builder, outError)
        return
    if eventType == "dynamic_tool_call_response":
        RustCsgRolloutReplayDynamicToolCallResponse(payload, rolloutIndex, builder, outError)
        return
    if eventType == "collab_agent_spawn_end":
        RustCsgRolloutReplayCollabSpawnEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "collab_agent_interaction_end":
        RustCsgRolloutReplayCollabInteractionEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "collab_waiting_end":
        RustCsgRolloutReplayCollabWaitingEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "collab_close_end" || eventType == "collab_resume_end":
        if eventType == "collab_close_end":
            RustCsgRolloutReplayCollabCloseEnd(payload, rolloutIndex, builder, outError)
        else:
            RustCsgRolloutReplayCollabResumeEnd(payload, rolloutIndex, builder, outError)
        return
    if eventType == "token_count":
        return
    outError = wire.RustCsgCat("rollout replay event_msg not ported: ", eventType)

fn RustCsgRolloutTurnsJsonFromText(text: str, outError: var str): str =
    outError = ""
    var builder = RustCsgRolloutTurnsBuilderInit()
    var lineStart: int32
    var rolloutIndex: int32
    var i: int32
    while i <= text.len:
        if i == text.len || text[i] == '\n':
            let lineLen = i - lineStart
            if lineLen > 0:
                let line = RustCsgRolloutBuildSlice(text, lineStart, lineStart + lineLen)
                RustCsgRolloutReplayEventLine(line, rolloutIndex, builder, outError)
                if outError != "":
                    return ""
                rolloutIndex = rolloutIndex + 1
            lineStart = i + 1
        i = i + 1
    RustCsgRolloutTurnsBuilderFinishCurrent(builder)
    return wire.RustCsgCat(builder.turnsJson, "]")

fn RustCsgRolloutTokenUsageUpdatedNotificationFromText(threadId: str, text: str, outError: var str): str =
    outError = ""
    var builder = RustCsgRolloutTurnsBuilderInit()
    var latestUsage: types.RustCsgThreadTokenUsage
    var latestUsagePresent: bool
    var latestTurnId: str
    var lineStart: int32
    var rolloutIndex: int32
    var i: int32
    while i <= text.len:
        if i == text.len || text[i] == '\n':
            let lineLen = i - lineStart
            if lineLen > 0:
                let line = RustCsgRolloutBuildSlice(text, lineStart, lineStart + lineLen)
                var consumedTokenCount: bool
                var ok: bool
                let itemType = RustCsgRolloutJsonRequiredString(line, "type", ok)
                if ok && itemType == "event_msg":
                    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line, "payload")
                    let payload = RustCsgRolloutJsonObjectAt(line, payloadStart)
                    if payload != "":
                        let eventType = RustCsgRolloutJsonRequiredString(payload, "type", ok)
                        if ok && eventType == "token_count":
                            var present: bool
                            var usageOk: bool
                            let usage = RustCsgRolloutThreadTokenUsageFromTokenCountPayload(payload, present, usageOk)
                            if !usageOk:
                                outError = "rollout replay token_count invalid"
                                return ""
                            if present:
                                latestUsage = usage
                                latestUsagePresent = true
                                latestTurnId = RustCsgRolloutTurnsBuilderTokenUsageOwnerId(builder)
                            consumedTokenCount = true
                if !consumedTokenCount:
                    RustCsgRolloutReplayEventLine(line, rolloutIndex, builder, outError)
                    if outError != "":
                        return ""
                rolloutIndex = rolloutIndex + 1
            lineStart = i + 1
        i = i + 1
    RustCsgRolloutTurnsBuilderFinishCurrent(builder)
    if !latestUsagePresent:
        return ""
    if latestTurnId == "":
        latestTurnId = RustCsgRolloutTurnsBuilderTokenUsageOwnerId(builder)
    if latestTurnId == "":
        return ""
    var notification: types.RustCsgThreadTokenUsageUpdatedNotification
    notification.threadId = threadId
    notification.turnId = latestTurnId
    notification.tokenUsage = latestUsage
    return wire.RustCsgThreadTokenUsageUpdatedNotificationToJson(notification)

fn RustCsgRolloutTokenUsageUpdatedNotificationFromFile(threadId: str, path: str, outError: var str): str =
    outError = ""
    if path == "":
        outError = "rollout history file is missing or empty"
        return ""
    let text = home.RustCsgReadFile(path)
    if text == "":
        outError = "rollout history file is missing or empty"
        return ""
    return RustCsgRolloutTokenUsageUpdatedNotificationFromText(threadId, text, outError)

fn RustCsgRolloutTurnsJsonFromFile(path: str, outError: var str): str =
    outError = ""
    if path == "":
        outError = "rollout history file is missing or empty"
        return ""
    let text = home.RustCsgReadFile(path)
    if text == "":
        outError = "rollout history file is missing or empty"
        return ""
    return RustCsgRolloutTurnsJsonFromText(text, outError)

# ── Rollout path construction ───────────────────────────────────────────
#
# Constructs the <codexHome>/rollout/<sessionId>.jsonl file path.

fn RustCsgRolloutBuildRolloutPath(codexHome: str, sessionId: str): str =
    if codexHome == "" || sessionId == "":
        return ""
    return os.JoinPath(
        os.JoinPath(codexHome, "rollout"),
        wire.RustCsgCat(sessionId, ".jsonl"))

# ── Rollout line classification ─────────────────────────────────────────
#
# Parses a single JSONL line and returns its event type string:
#   "session_meta" | "turn_context" | "event_msg" | "unknown"
# Returns "" on empty or unparseable input.

fn RustCsgRolloutParseRolloutLine(line: str): str =
    if line == "":
        return ""
    var ok: bool
    let itemType = RustCsgRolloutJsonRequiredString(line, "type", ok)
    if !ok:
        # Attempt to detect by payload content as fallback
        if wire.RustCsgContains(line, "\"session_meta\""):
            return wire.RustCsgWireSessionMeta
        elif wire.RustCsgContains(line, "\"turn_context\""):
            return wire.RustCsgWireTurnContext
        elif wire.RustCsgContains(line, "\"event_msg\""):
            return wire.RustCsgWireEventMsg
        return "unknown"
    if itemType == wire.RustCsgWireSessionMeta:
        return wire.RustCsgWireSessionMeta
    elif itemType == wire.RustCsgWireTurnContext:
        return wire.RustCsgWireTurnContext
    elif itemType == wire.RustCsgWireEventMsg:
        return wire.RustCsgWireEventMsg
    return "unknown"

# ── Raw event classification ──────────────────────────────────────────────
#
# Maps an event-type string (from rollout-trace RawTraceEventPayload) to a
# trace category: "Inference" | "Compaction" | "ToolDispatch" | "McpCall" |
# "Unknown".  Classification is prefix-based so future event variants in
# the same family are correctly categorized without code changes.

fn RustCsgRolloutClassifyRawEvent(eventType: str): str =
    if eventType == "":
        return "Unknown"
    if wire.RustCsgStartsWith(eventType, "inference_"):
        return "Inference"
    if wire.RustCsgStartsWith(eventType, "compaction_"):
        return "Compaction"
    if wire.RustCsgStartsWith(eventType, "tool_call_"):
        return "ToolDispatch"
    if wire.RustCsgStartsWith(eventType, "code_cell_"):
        return "ToolDispatch"
    if wire.RustCsgStartsWith(eventType, "mcp_"):
        return "McpCall"
    return "Unknown"
