import std/os
import std/strings as strings
import cheng/codex/config/home
import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgRolloutJsonStringAt(text: str, start: int32, outOk: var bool): str =
    outOk = false
    if start < 0 || start >= text.len || text[start] != '"':
        return ""
    var out: str
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if ch == '\\':
            if i + 1 >= text.len:
                return ""
            let escaped = text[i + 1]
            if escaped == '"' || escaped == '\\' || escaped == '/':
                out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(text, i + 1, 1))
            elif escaped == 'n':
                out = wire.RustCsgCat(out, "\n")
            elif escaped == 'r':
                out = wire.RustCsgCat(out, "\r")
            elif escaped == 't':
                out = wire.RustCsgCat(out, "\t")
            else:
                return ""
            i = i + 2
            continue
        if ch == '"':
            outOk = true
            return out
        out = wire.RustCsgCat(out, wire.RustCsgSliceBytes(text, i, 1))
        i = i + 1
    return ""

fn RustCsgRolloutJsonStringEnd(text: str, start: int32): int32 =
    if start < 0 || start >= text.len || text[start] != '"':
        return -1
    var escaped: bool
    var i: int32
    i = start + 1
    while i < text.len:
        let ch = text[i]
        if escaped:
            escaped = false
        elif ch == '\\':
            escaped = true
        elif ch == '"':
            return i
        i = i + 1
    return -1

fn RustCsgRolloutJsonTopFieldValueStart(text: str, key: str): int32 =
    var p: int32
    p = wire.RustCsgSkipJsonSpace(text, 0)
    if p >= text.len || text[p] != '{':
        return -1
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = p
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            if depth == 1:
                var ok: bool
                let field = RustCsgRolloutJsonStringAt(text, i, ok)
                if !ok:
                    return -1
                let keyEnd = RustCsgRolloutJsonStringEnd(text, i)
                if keyEnd < 0:
                    return -1
                let colon = wire.RustCsgSkipJsonSpace(text, keyEnd + 1)
                if colon < text.len && text[colon] == ':' && field == key:
                    return wire.RustCsgSkipJsonSpace(text, colon + 1)
                i = keyEnd
            else:
                inString = true
        elif ch == '{' || ch == '[':
            depth = depth + 1
        elif ch == '}' || ch == ']':
            depth = depth - 1
            if depth < 0:
                return -1
        i = i + 1
    return -1

fn RustCsgRolloutJsonObjectAt(text: str, start: int32): str =
    if start < 0 || start >= text.len || text[start] != '{':
        return ""
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth == 0:
                return wire.RustCsgSliceBytes(text, start, i - start + 1)
        i = i + 1
    return ""

fn RustCsgRolloutJsonArrayAt(text: str, start: int32): str =
    if start < 0 || start >= text.len || text[start] != '[':
        return ""
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    i = start
    while i < text.len:
        let ch = text[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                return wire.RustCsgSliceBytes(text, start, i - start + 1)
        elif ch == '{':
            depth = depth + 1
        elif ch == '}':
            depth = depth - 1
            if depth < 0:
                return ""
        i = i + 1
    return ""

fn RustCsgRolloutJsonRequiredString(text: str, key: str, outOk: var bool): str =
    outOk = false
    let start = RustCsgRolloutJsonTopFieldValueStart(text, key)
    let value = RustCsgRolloutJsonStringAt(text, start, outOk)
    return value

fn RustCsgRolloutJsonRequiredStringIsOneOf(text: str,
                                           key: str,
                                           a: str,
                                           b: str,
                                           c: str,
                                           d: str): bool =
    var ok: bool
    let value = RustCsgRolloutJsonRequiredString(text, key, ok)
    if !ok:
        return false
    return value == a || value == b || value == c || value == d

fn RustCsgRolloutJsonRequiredBool(text: str, key: str, outOk: var bool): bool =
    outOk = false
    let start = RustCsgRolloutJsonTopFieldValueStart(text, key)
    if start < 0:
        return false
    if wire.RustCsgMatchesAt(text, start, "true"):
        outOk = true
        return true
    if wire.RustCsgMatchesAt(text, start, "false"):
        outOk = true
        return false
    return false

fn RustCsgRolloutGranularApprovalLooksValid(objectJson: str): bool =
    let start = RustCsgRolloutJsonTopFieldValueStart(objectJson, "granular")
    let granular = RustCsgRolloutJsonObjectAt(objectJson, start)
    if granular == "":
        return false
    var ok: bool
    RustCsgRolloutJsonRequiredBool(granular, "sandbox_approval", ok)
    if !ok:
        return false
    RustCsgRolloutJsonRequiredBool(granular, "rules", ok)
    if !ok:
        return false
    RustCsgRolloutJsonRequiredBool(granular, "mcp_elicitations", ok)
    if !ok:
        return false
    return true

fn RustCsgRolloutApprovalPolicyLooksValid(payload: str): bool =
    let start = RustCsgRolloutJsonTopFieldValueStart(payload, "approval_policy")
    if start < 0 || start >= payload.len:
        return false
    if payload[start] == '"':
        var ok: bool
        let value = RustCsgRolloutJsonStringAt(payload, start, ok)
        return ok && (value == "untrusted" || value == "on-failure" || value == "on-request" || value == "never")
    if payload[start] == '{':
        return RustCsgRolloutGranularApprovalLooksValid(RustCsgRolloutJsonObjectAt(payload, start))
    return false

fn RustCsgRolloutSandboxPolicyLooksValid(payload: str): bool =
    let start = RustCsgRolloutJsonTopFieldValueStart(payload, "sandbox_policy")
    let objectJson = RustCsgRolloutJsonObjectAt(payload, start)
    if objectJson == "":
        return false
    return RustCsgRolloutJsonRequiredStringIsOneOf(objectJson,
                                                   "type",
                                                   "danger-full-access",
                                                   "read-only",
                                                   "external-sandbox",
                                                   "workspace-write")

fn RustCsgRolloutLineLooksLikeSerdeTurnContext(line: str, payload: str): bool =
    var ok: bool
    let timestamp = RustCsgRolloutJsonRequiredString(line, "timestamp", ok)
    if !ok:
        return false
    let model = RustCsgRolloutJsonRequiredString(payload, "model", ok)
    if !ok || model == "":
        return false
    let cwd = RustCsgRolloutJsonRequiredString(payload, "cwd", ok)
    if !ok || cwd == "":
        return false
    if !RustCsgRolloutApprovalPolicyLooksValid(payload):
        return false
    if !RustCsgRolloutSandboxPolicyLooksValid(payload):
        return false
    if !RustCsgRolloutJsonRequiredStringIsOneOf(payload, "summary", "auto", "concise", "detailed", "none"):
        return false
    return timestamp != ""

fn RustCsgRolloutLineTurnCwd(line: str): str =
    if line == "":
        return ""
    var ok: bool
    let itemType = RustCsgRolloutJsonRequiredString(line, "type", ok)
    if !ok || itemType != "turn_context":
        return ""
    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line, "payload")
    let payload = RustCsgRolloutJsonObjectAt(line, payloadStart)
    if payload == "":
        return ""
    if !RustCsgRolloutLineLooksLikeSerdeTurnContext(line, payload):
        return ""
    return RustCsgRolloutJsonRequiredString(payload, "cwd", ok)

fn RustCsgRolloutLatestSessionMetaPayloadRaw(path: str): str =
    if path == "":
        return ""
    let text = home.RustCsgReadFile(path)
    if text == "":
        return ""
    var lineEnd: int32
    lineEnd = text.len
    var i: int32
    i = text.len - 1
    while i >= 0:
        if text[i] == '\n':
            let lineStart = i + 1
            let lineLen = lineEnd - lineStart
            if lineLen > 0:
                if wire.RustCsgContains(wire.RustCsgSliceBytes(text, lineStart, lineLen),
                                       "\"session_meta\""):
                    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(
                        wire.RustCsgSliceBytes(text, lineStart, lineLen), "payload")
                    if payloadStart >= 0:
                        let payload = RustCsgRolloutJsonObjectAt(
                            wire.RustCsgSliceBytes(text, lineStart, lineLen), payloadStart)
                        if payload != "":
                            return payload
            lineEnd = i
        i = i - 1
    if lineEnd > 0:
        let line0 = wire.RustCsgSliceBytes(text, 0, lineEnd)
        if wire.RustCsgContains(line0, "\"session_meta\""):
            let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line0, "payload")
            if payloadStart >= 0:
                let payload = RustCsgRolloutJsonObjectAt(line0, payloadStart)
                if payload != "":
                    return payload
    return ""

fn RustCsgRolloutLatestSessionMetaSourceRaw(path: str): str =
    let payload = RustCsgRolloutLatestSessionMetaPayloadRaw(path)
    if payload == "":
        return ""
    let sourceStart = RustCsgRolloutJsonTopFieldValueStart(payload, "source")
    if sourceStart >= 0:
        if sourceStart < payload.len:
            if payload[sourceStart] == '"':
                var ok: bool
                let sourceStr = RustCsgRolloutJsonStringAt(payload, sourceStart, ok)
                if ok:
                    return sourceStr
                return ""
            if payload[sourceStart] == '{':
                return RustCsgRolloutJsonObjectAt(payload, sourceStart)
    return ""

fn RustCsgRolloutSessionMetaSourceRawIsSubAgentOther(sourceRaw: str): bool =
    if sourceRaw == "":
        return false
    let sourceStart = wire.RustCsgSkipJsonSpace(sourceRaw, 0)
    if sourceStart >= sourceRaw.len || sourceRaw[sourceStart] != '{':
        return false
    let subagentStart = RustCsgRolloutJsonTopFieldValueStart(sourceRaw, "subagent")
    if subagentStart < 0 || subagentStart >= sourceRaw.len:
        return false
    if sourceRaw[subagentStart] != '{':
        return false
    let subagent = RustCsgRolloutJsonObjectAt(sourceRaw, subagentStart)
    if subagent == "":
        return false
    let otherStart = RustCsgRolloutJsonTopFieldValueStart(subagent, "other")
    if otherStart < 0:
        return false
    var ok: bool
    let other = RustCsgRolloutJsonStringAt(subagent, otherStart, ok)
    return ok && other != ""

fn RustCsgRolloutLatestSessionMetaSourceIsSubAgentOther(path: str): bool =
    return RustCsgRolloutSessionMetaSourceRawIsSubAgentOther(RustCsgRolloutLatestSessionMetaSourceRaw(path))

fn RustCsgRolloutLatestSessionMetaCwd(path: str): str =
    let payload = RustCsgRolloutLatestSessionMetaPayloadRaw(path)
    if payload == "":
        return ""
    var ok: bool
    let cwd = RustCsgRolloutJsonRequiredString(payload, "cwd", ok)
    if !ok:
        return ""
    return cwd

