    let start = RustCsgRolloutJsonTopFieldValueStart(payload, "base_instructions")
    if start < 0 || start >= payload.len:
        return ""
    if payload[start] != '{':
        return ""
    return RustCsgRolloutJsonObjectAt(payload, start)

fn RustCsgRolloutSessionMetaBaseInstructionsText(baseInstructionsRaw: str): str =
    if baseInstructionsRaw == "":
        return ""
    var present: bool
    var ok: bool
    let text = RustCsgRolloutJsonOptionalString(baseInstructionsRaw, "text", present, ok)
    if !present || !ok:
        return ""
    return text

fn RustCsgRolloutLatestSessionMetaBaseInstructionsText(path: str): str =
    return RustCsgRolloutSessionMetaBaseInstructionsText(RustCsgRolloutLatestSessionMetaBaseInstructionsRaw(path))

