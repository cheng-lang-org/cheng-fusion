    pos = wire.RustCsgSkipJsonSpace(detailsRaw, valueEnd)
    if pos < detailsRaw.len && detailsRaw[pos] == ',':
        pos = wire.RustCsgSkipJsonSpace(detailsRaw, pos + 1)
        return valueJson
