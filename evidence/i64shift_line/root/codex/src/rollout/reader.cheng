fn RustCsgRolloutReplayMcpToolCallBegin(payload: str,
                                        rolloutIndex: int32,
                                        builder: var RustCsgRolloutTurnsBuilder,
                                        outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let invocationStart = RustCsgRolloutJsonTopFieldValueStart(payload, "invocation")
    let invocation = RustCsgRolloutJsonObjectAt(payload, invocationStart)
    if invocation == "":
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let server = RustCsgRolloutJsonRequiredString(invocation, "server", ok)
    if !ok || server == "":
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let tool = RustCsgRolloutJsonRequiredString(invocation, "tool", ok)
    if !ok || tool == "":
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let argumentsJson = RustCsgRolloutMcpArgumentsJson(invocation, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let uriJson = RustCsgRolloutMcpOptionalUriJson(payload, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_begin invalid"
        return
    let itemJson = RustCsgRolloutMcpToolCallItemJson(callId,
                                                     server,
                                                     tool,
                                                     "inProgress",
                                                     argumentsJson,
                                                     uriJson,
                                                     "null",
                                                     "null",
                                                     "null")
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_begin invalid"

fn RustCsgRolloutReplayMcpToolCallEnd(payload: str,
                                      rolloutIndex: int32,
                                      builder: var RustCsgRolloutTurnsBuilder,
                                      outError: var str) =
    var ok: bool
    let callId = RustCsgRolloutJsonRequiredString(payload, "call_id", ok)
    if !ok || callId == "":
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let invocationStart = RustCsgRolloutJsonTopFieldValueStart(payload, "invocation")
    let invocation = RustCsgRolloutJsonObjectAt(payload, invocationStart)
    if invocation == "":
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let server = RustCsgRolloutJsonRequiredString(invocation, "server", ok)
    if !ok || server == "":
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let tool = RustCsgRolloutJsonRequiredString(invocation, "tool", ok)
    if !ok || tool == "":
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let argumentsJson = RustCsgRolloutMcpArgumentsJson(invocation, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let uriJson = RustCsgRolloutMcpOptionalUriJson(payload, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let durationMsJson = RustCsgRolloutMcpDurationMillisRaw(payload, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    var status: str
    var resultJson: str
    var errorJson: str
    RustCsgRolloutMcpResultToV2(payload, status, resultJson, errorJson, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_end invalid"
        return
    let itemJson = RustCsgRolloutMcpToolCallItemJson(callId,
                                                     server,
                                                     tool,
                                                     status,
                                                     argumentsJson,
                                                     uriJson,
                                                     resultJson,
                                                     errorJson,
                                                     durationMsJson)
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderUpsertRawItem(builder, itemJson, ok)
    if !ok:
        outError = "rollout replay mcp_tool_call_end invalid"

fn RustCsgRolloutReplayTurnStarted(payload: str,
                                   builder: var RustCsgRolloutTurnsBuilder,
                                   outError: var str) =
    var ok: bool
    let turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
    if !ok || turnId == "":
        outError = "rollout replay turn_started missing turn_id"
        return
    let startedAtJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "started_at", ok)
    if !ok:
        outError = "rollout replay turn_started started_at invalid"
        return
    RustCsgRolloutTurnsBuilderStartExplicit(builder, turnId, startedAtJson)

fn RustCsgRolloutReplayTurnComplete(payload: str,
                                    builder: var RustCsgRolloutTurnsBuilder,
                                    outError: var str) =
    var ok: bool
    let turnId = RustCsgRolloutJsonRequiredString(payload, "turn_id", ok)
    if !ok || turnId == "":
        outError = "rollout replay turn_complete missing turn_id"
        return
    let completedAtJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "completed_at", ok)
    if !ok:
        outError = "rollout replay turn_complete completed_at invalid"
        return
    let durationMsJson = RustCsgRolloutJsonOptionalValueOrNullRaw(payload, "duration_ms", ok)
    if !ok:
        outError = "rollout replay turn_complete duration_ms invalid"
        return
    if builder.currentTurnId != "" && builder.currentTurnId == turnId:
        RustCsgRolloutTurnsBuilderCompleteActive(builder, completedAtJson, durationMsJson)
        return
    if RustCsgRolloutTurnsBuilderCompleteStored(builder, turnId, completedAtJson, durationMsJson):
        return
    if builder.currentTurnId == "":
        return
    RustCsgRolloutTurnsBuilderCompleteActive(builder, completedAtJson, durationMsJson)

fn RustCsgRolloutReplayError(payload: str,
                             builder: var RustCsgRolloutTurnsBuilder,
                             outError: var str) =
    var ok: bool
    let message = RustCsgRolloutJsonRequiredString(payload, "message", ok)
    if !ok:
        outError = "rollout replay error missing message"
        return
    var affects: bool
    let codexErrorInfoJson = RustCsgRolloutCodexErrorInfoToV2(payload, affects, ok)
    if !ok:
        outError = "rollout replay error codex_error_info not ported"
        return
    if !affects:
        return
    if builder.currentTurnId == "":
        return
    RustCsgRolloutTurnsBuilderFailActive(builder,
                                         RustCsgRolloutTurnErrorJson(message, codexErrorInfoJson))

fn RustCsgRolloutTurnAbortReasonLooksValid(reason: str): bool =
    return reason == "interrupted" || reason == "replaced" || reason == "review_ended" || reason == "budget_limited"

fn RustCsgRolloutReplayTurnAborted(payload: str,
                                   builder: var RustCsgRolloutTurnsBuilder,
                                   outError: var str) =
    var ok: bool
    let reason = RustCsgRolloutJsonRequiredString(payload, "reason", ok)
    if !ok || !RustCsgRolloutTurnAbortReasonLooksValid(reason):
        outError = "rollout replay turn_aborted reason not ported"
        return
    var turnIdPresent: bool
    let turnId = RustCsgRolloutJsonOptionalString(payload, "turn_id", turnIdPresent, ok)
    if !ok:
        outError = "rollout replay turn_aborted turn_id not a string"
        return
    let completedAtJson = RustCsgRolloutJsonOptionalIntRaw(payload, "completed_at", ok)
    if !ok:
        outError = "rollout replay turn_aborted completed_at not an integer"
        return
    let durationMsJson = RustCsgRolloutJsonOptionalIntRaw(payload, "duration_ms", ok)
    if !ok:
        outError = "rollout replay turn_aborted duration_ms not an integer"
        return
    if turnIdPresent:
        if builder.currentTurnId != "" && turnId == builder.currentTurnId:
            RustCsgRolloutTurnsBuilderAbortActive(builder, completedAtJson, durationMsJson)
            return
        if RustCsgRolloutTurnsBuilderAbortStored(builder, turnId, completedAtJson, durationMsJson):
            return
    if builder.currentTurnId == "":
        return
    RustCsgRolloutTurnsBuilderAbortActive(builder, completedAtJson, durationMsJson)

fn RustCsgRolloutReplayThreadRolledBack(payload: str,
                                        builder: var RustCsgRolloutTurnsBuilder,
                                        outError: var str) =
    var ok: bool
    let count = RustCsgRolloutJsonRequiredNonNegativeCount(payload, "num_turns", ok)
    if !ok:
        outError = "rollout replay thread_rolled_back num_turns not a non-negative integer"
        return
    RustCsgRolloutTurnsBuilderRollback(builder, count)

fn RustCsgRolloutReplayCompactedLine(line: str,
                                     rolloutIndex: int32,
                                     builder: var RustCsgRolloutTurnsBuilder,
                                     outError: var str) =
    let payloadStart = RustCsgRolloutJsonTopFieldValueStart(line, "payload")
    let payload = RustCsgRolloutJsonObjectAt(line, payloadStart)
    if payload == "":
        outError = "rollout replay compacted missing payload"
        return
    var ok: bool
    RustCsgRolloutJsonRequiredString(payload, "message", ok)
    if !ok:
        outError = "rollout replay compacted missing message"
        return
    RustCsgRolloutJsonOptionalArrayRaw(payload, "replacement_history", ok)
    if !ok:
        outError = "rollout replay compacted replacement_history invalid"
        return
    RustCsgRolloutTurnsBuilderMarkCompacted(builder, rolloutIndex)

fn RustCsgRolloutReplayAgentReasoning(payload: str,
                                      rolloutIndex: int32,
                                      builder: var RustCsgRolloutTurnsBuilder,
                                      outError: var str) =
    var ok: bool
    let text = RustCsgRolloutJsonRequiredString(payload, "text", ok)
    if !ok:
        outError = "rollout replay agent_reasoning missing text"
        return
    if text == "":
        return
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderAppendReasoningSummary(builder, text)

fn RustCsgRolloutReplayAgentReasoningRawContent(payload: str,
                                                rolloutIndex: int32,
                                                builder: var RustCsgRolloutTurnsBuilder,
                                                outError: var str) =
    var ok: bool
    let text = RustCsgRolloutJsonRequiredString(payload, "text", ok)
    if !ok:
        outError = "rollout replay agent_reasoning_raw_content missing text"
        return
    if text == "":
        return
    RustCsgRolloutTurnsBuilderEnsureTurn(builder, rolloutIndex)
    RustCsgRolloutTurnsBuilderAppendReasoningContent(builder, text)

