    out = wire.RustCsgCat(out, "}")
    return out

# ── CollabAgentToolCall item builder ──────────────────────────────────────
fn RustCsgRolloutAgentStatusIsError(statusRaw: str): bool =
    if statusRaw == "" || statusRaw == "null":
        return false
    var ok: bool
    let strValue = RustCsgRolloutJsonStringAt(statusRaw, 0, ok)
    if ok:
        return strValue == "NotFound"
    if statusRaw[0] == '{':
        let obj = RustCsgRolloutJsonObjectAt(statusRaw, 0)
        if obj != "":
            let erroredStart = RustCsgRolloutJsonTopFieldValueStart(obj, "Errored")
            if erroredStart >= 0:
                return true
    return false

fn RustCsgRolloutCollabToolToV2(tool: str): str =
    if tool == "spawn_agent":
        return "spawnAgent"
    if tool == "send_input":
        return "sendInput"
    if tool == "resume_agent":
        return "resumeAgent"
    if tool == "close_agent":
        return "closeAgent"
    return "wait"

