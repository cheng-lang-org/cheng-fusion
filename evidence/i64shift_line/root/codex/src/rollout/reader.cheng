fn RustCsgRolloutRawJsonUsizeIsValid(raw: str): bool =
    if raw == "":
        return false
    if raw.len > 1 && raw[0] == '0':
        return false
    let maxText = "18446744073709551615"
    if raw.len > maxText.len:
        return false
    if raw.len == maxText.len:
        for i in 0..<raw.len:
            let digit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(raw, i, 1))
            let maxDigit = wire.RustCsgDigitValue(wire.RustCsgSliceBytes(maxText, i, 1))
            if digit < 0:
                return false
            if digit > maxDigit:
                return false
            if digit < maxDigit:
                return true
    return true

