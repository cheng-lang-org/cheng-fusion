import cheng/codex/protocol/types
import cheng/codex/protocol/wire

fn RustCsgSessionMetaRolloutLine(timestamp: str, meta: types.RustCsgSessionMeta): types.RustCsgRolloutLine =
    var line: types.RustCsgRolloutLine
    line.timestamp = timestamp
    line.itemType = wire.RustCsgWireSessionMeta
    line.sessionMeta = meta
    return line

fn RustCsgTurnContextRolloutLine(timestamp: str, context: types.RustCsgTurnContext): types.RustCsgRolloutLine =
    var line: types.RustCsgRolloutLine
    line.timestamp = timestamp
    line.itemType = wire.RustCsgWireTurnContext
    line.turnContext = context
    return line

fn RustCsgEventRolloutLine(timestamp: str, event: types.RustCsgEvent): types.RustCsgRolloutLine =
    var line: types.RustCsgRolloutLine
    line.timestamp = timestamp
    line.itemType = wire.RustCsgWireEventMsg
    line.event = event
    return line
