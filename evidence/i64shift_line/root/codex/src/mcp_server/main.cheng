fn rustCsgMcpInventoryMemberSample(members: str[]): str =
    var out: str = "["
    if members.len > 0:
        out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(members[0]))
    if members.len > 1:
        out = wire.RustCsgCat3(out, ",", wire.RustCsgJsonQuote(members[1]))
    if members.len > 2:
        out = wire.RustCsgCat3(out, ",", wire.RustCsgJsonQuote(members[2]))
    if members.len > 3:
        out = wire.RustCsgCat3(out, ",", wire.RustCsgJsonQuote(members[members.len - 1]))
    return wire.RustCsgCat(out, "]")

fn rustCsgMcpInventoryText(): str =
    let members = inventory.RustCsgExpectedCargoMembersList()
    var firstMember: str
    var lastMember: str
    if members.len > 0:
        firstMember = members[0]
        lastMember = members[members.len - 1]
    var out: str = "{\"kind\":\"codex-source-inventory\""
    out = wire.RustCsgCat3(out, ",\"package_id\":", wire.RustCsgJsonQuote("pkg://cheng/codex"))
    out = wire.RustCsgCat3(out, ",\"module_prefix\":", wire.RustCsgJsonQuote("rust_csg"))
    out = wire.RustCsgCat3(out, ",\"source_root\":", wire.RustCsgJsonQuote(inventory.RustCsgSourceRoot))
    out = wire.RustCsgCat3(out, ",\"cargo_workspace_member_count\":", inventory.RustCsgInt32Text(inventory.RustCsgExpectedCargoMembers))
    out = wire.RustCsgCat3(out, ",\"cargo_workspace_member_list_count\":", strings.IntToStr(members.len))
    out = wire.RustCsgCat3(out, ",\"cargo_workspace_first_member\":", wire.RustCsgJsonQuote(firstMember))
    out = wire.RustCsgCat3(out, ",\"cargo_workspace_last_member\":", wire.RustCsgJsonQuote(lastMember))
    out = wire.RustCsgCat3(out, ",\"cargo_workspace_member_sample\":", rustCsgMcpInventoryMemberSample(members))
    out = wire.RustCsgCat3(out, ",\"source_inventory_doc\":", wire.RustCsgJsonQuote("codex/docs/source_inventory.md"))
    return wire.RustCsgCat(out, "}")

fn rustCsgMcpInventoryToolResult(): str =
    return wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(rustCsgMcpInventoryText()), "}],\"isError\":false}")

fn rustCsgMcpSafeCommands(): str[] =
    return ["ls", "cat", "head", "tail", "echo", "pwd", "date", "whoami", "uname", "which", "rg", "grep", "find", "git", "npm", "node", "python3", "make", "cargo", "curl", "wget", "mkdir", "cp", "mv", "touch", "chmod", "cd", "source", ".", "npx", "cargo", "rustup", "swift", "xcrun"]

fn rustCsgMcpDangerPrefixes(): str[] =
    return ["rm -rf /", "rm -rf --no-preserve-root", "dd if=", "mkfs.", "chmod -R 777 /", ":(){ :|:& };:", "> /dev/sda", "shutdown", "reboot", "init 0", "poweroff"]

fn rustCsgMcpIsSafeCommand(cmd: str): bool =
    let safe = rustCsgMcpSafeCommands()
    for i in 0..<safe.len:
        if cmd == safe[i] || wire.RustCsgStartsWith(cmd, wire.RustCsgCat(safe[i], " ")) || wire.RustCsgStartsWith(cmd, wire.RustCsgCat(safe[i], "\t")):
            return true
    return false

fn rustCsgMcpIsDangerCommand(cmd: str): bool =
    let danger = rustCsgMcpDangerPrefixes()
    for i in 0..<danger.len:
        if wire.RustCsgStartsWith(cmd, danger[i]):
            return true
    return false

fn rustCsgMcpIsSafeFileType(path: str): bool =
    let exts: str[] = [".cheng", ".rs", ".toml", ".sh", ".json", ".md", ".txt", ".py", ".js", ".ts", ".css", ".html", ".yaml", ".yml", ".swift", ".java", ".kt", ".gradle", ".xml", ".proto", ".c", ".h", ".m", ".mm", ".cpp", ".hpp", ".s", ".zig", ".go", ".mod"]
    for i in 0..<exts.len:
        let e = exts[i]
        if path.len >= e.len && strings.SliceBytes(path, path.len - e.len, e.len) == e:
            return true
    return false

fn rustCsgMcpResolveAppServerUrl(params: str): str =
    let fromArgs = wire.RustCsgJsonFindOptionalStr(params, "app_server_url")
    if fromArgs != "":
        return fromArgs
    let url = home.RustCsgGetEnv("CODEX_APP_SERVER_URL")
    if url != "":
        return url
    let resp96 = rawHttpPost("http://127.0.0.1:4096/health", "", "")
    if resp96 != "":
        let code = parseHttpStatus(resp96)
        if code == 200:
            return "http://127.0.0.1:4096"
    let resp97 = rawHttpPost("http://127.0.0.1:4097/health", "", "")
    if resp97 != "":
        let code = parseHttpStatus(resp97)
        if code == 200:
            return "http://127.0.0.1:4097"
    return ""

fn rustCsgMcpBuildCodexRequestPlanJson(params: str, isReply: bool, outAppServerUrl: var str, outError: var str): str =
    outAppServerUrl = ""
    outError = ""
    if params == "":
        outError = "codex requires params with arguments"
        return ""
    let prompt = wire.RustCsgJsonFindOptionalStr(params, "prompt")
    if prompt == "":
        if isReply:
            outError = "codex-reply requires prompt parameter"
        else:
            outError = "codex: 'prompt' is required and must not be empty"
        return ""
    if !isReply && rustCsgMcpJsonHasTopLevelKey(params, "profile"):
        outError = "Failed to parse configuration for Codex tool: unknown field `profile`"
        return ""
    var threadId: str
    if isReply:
        threadId = wire.RustCsgJsonFindOptionalStr(params, "threadId")
        if threadId == "":
            threadId = wire.RustCsgJsonFindOptionalStr(params, "conversationId")
        if threadId == "":
            outError = "codex-reply requires threadId parameter"
            return ""
    var plan = exec_plan.RustCsgExecPlanDefault()
    plan.prompt = prompt
    plan.disableStdinContext = true
    if isReply:
        plan.command = "resume"
        plan.resumeSessionId = threadId
    plan.model = wire.RustCsgJsonFindOptionalStr(params, "model")
    plan.cwd = wire.RustCsgJsonFindOptionalStr(params, "cwd")
    plan.sandbox = wire.RustCsgJsonFindOptionalStr(params, "sandbox")
    let approvalPolicy = wire.RustCsgJsonFindOptionalStr(params, "approval-policy")
    if approvalPolicy != "":
        add(plan.configOverrides, wire.RustCsgCat("approval-policy=", approvalPolicy))
    if wire.RustCsgContains(params, "\"reasoning-effort\""):
        plan.reasoningEffort = wire.RustCsgJsonFindStr(params, "reasoning-effort")
    if wire.RustCsgContains(params, "\"reasoning-summary\""):
        plan.reasoningSummary = wire.RustCsgJsonFindStr(params, "reasoning-summary")
    if wire.RustCsgContains(params, "\"max-turns\""):
        plan.maxTurns = wire.RustCsgJsonFindInt32(params, "max-turns")
    let tempKey = "\"temperature\":"
    if params.len > tempKey.len:
        for i in 0..<(params.len - tempKey.len):
            if wire.RustCsgMatchesAt(params, i, tempKey):
                var s = i + tempKey.len
                var e = s
                while e < params.len && params[e] != ',' && params[e] != '}' && params[e] != ']':
                    e = e + 1
                if e > s:
                    add(plan.configOverrides, wire.RustCsgCat("temperature=", wire.RustCsgSliceBytes(params, s, e - s)))
                break
    outAppServerUrl = rustCsgMcpResolveAppServerUrl(params)
    if outAppServerUrl == "":
        outError = "codex requires a running app-server. Start with 'codex app-server' or set CODEX_APP_SERVER_URL environment variable."
        return ""
    plan.appServerUrl = outAppServerUrl
    if plan.parseError != "":
        outError = wire.RustCsgCat("codex plan: ", plan.parseError)
        return ""
    var requestPlan = exec_session.RustCsgExecRequestPlanFromPlanWithUserConfig(plan, threadId, "")
    if requestPlan.parseError != "":
        outError = requestPlan.parseError
        return ""
    if requestPlan.blockedReason != "":
        outError = requestPlan.blockedReason
        return ""
    return exec_session.RustCsgExecRequestPlanToJson(requestPlan)

fn rustCsgMcpAgentMessageTextFromItem(itemJson: str): str =
    if itemJson == "" || itemJson == "null":
        return ""
    let itemType = wire.RustCsgJsonFindStr(itemJson, "type")
    if itemType != "agentMessage":
        return ""
    var text = wire.RustCsgJsonFindOptionalStr(itemJson, "text")
    if text != "":
        return text
    let contentRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "content")
    if contentRaw != "":
        return wire.RustCsgJsonFindOptionalStr(contentRaw, "text")
    return ""

fn rustCsgMcpReadNextFrameBodyBlocking(pendingInput: var str, outError: var str): str =
    outError = ""
    var idle: int32
    while idle < 600:
        let frame = rustCsgMcpTryReadFrame(pendingInput)
        if frame.ok:
            pendingInput = frame.rest
            return frame.body
        if !frame.blocked:
            outError = "invalid MCP frame while waiting for elicitation response"
            return ""
        let event = process.ProcessReadFdBlockingEvent(0, 100)
        if event == "T":
            idle = idle + 1
        elif event == "F":
            outError = "stdin closed while waiting for elicitation response"
            return ""
        elif event.len > 0 && event[0] == 'E':
            if event.len > 1:
                outError = wire.RustCsgSliceBytes(event, 1, event.len - 1)
            else:
                outError = "stdin read failed while waiting for elicitation response"
            return ""
        elif event.len > 0 && event[0] == 'D':
            idle = 0
            let chunk = wire.RustCsgSliceBytes(event, 1, event.len - 1)
            pendingInput = wire.RustCsgCat(pendingInput, chunk)
        else:
            outError = "invalid stdin read event while waiting for elicitation response"
            return ""
    outError = "timed out waiting for elicitation response"
    return ""

fn rustCsgMcpApprovalRequestedSchema(paramsJson: str): str =
    var decisionsRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "availableDecisions")
    if decisionsRaw == "":
        decisionsRaw = "[\"accept\",\"decline\",\"cancel\"]"
    var out = "{\"type\":\"object\",\"properties\":{\"decision\":{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("enum", decisionsRaw))
    out = wire.RustCsgCat(out, "}},\"required\":[\"decision\"],\"additionalProperties\":false}")
    return out

fn rustCsgMcpCommandApprovalElicitationParams(paramsJson: str, requestIdRaw: str): str =
    let threadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    let turnId = wire.RustCsgJsonFindOptionalStr(paramsJson, "turnId")
    let itemId = wire.RustCsgJsonFindOptionalStr(paramsJson, "itemId")
    var approvalId = wire.RustCsgJsonFindOptionalStr(paramsJson, "approvalId")
    if approvalId == "":
        approvalId = itemId
    let command = wire.RustCsgJsonFindOptionalStr(paramsJson, "command")
    let cwd = wire.RustCsgJsonFindOptionalStr(paramsJson, "cwd")
    let parsedRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "parsedCmd")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", "Approve command execution"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("requestedSchema", rustCsgMcpApprovalRequestedSchema(paramsJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codex_elicitation", "exec-approval"))
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_mcp_tool_call_id", itemId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_event_id", rustCsgMcpJsonRawToText(requestIdRaw))
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_call_id", approvalId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_turn_id", turnId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_command", command)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_cwd", cwd)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_reason", wire.RustCsgJsonFindOptionalStr(paramsJson, "reason"))
    if parsedRaw != "":
        out = rustCsgMcpJsonAppendOptionalRaw(out, "codex_parsed_cmd", parsedRaw)
    else:
        out = wire.RustCsgCat(out, ",\"codex_parsed_cmd\":[]")
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpFileApprovalElicitationParams(paramsJson: str, requestIdRaw: str): str =
    let threadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    let turnId = wire.RustCsgJsonFindOptionalStr(paramsJson, "turnId")
    let itemId = wire.RustCsgJsonFindOptionalStr(paramsJson, "itemId")
    var changesRaw = wire.RustCsgJsonFindOptionalValueRaw(paramsJson, "changes")
    if changesRaw == "":
        changesRaw = "{}"
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", "Approve file change"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("requestedSchema", rustCsgMcpApprovalRequestedSchema(paramsJson)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("codex_elicitation", "patch-approval"))
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_mcp_tool_call_id", itemId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_event_id", rustCsgMcpJsonRawToText(requestIdRaw))
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_call_id", itemId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_turn_id", turnId)
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_reason", wire.RustCsgJsonFindOptionalStr(paramsJson, "reason"))
    out = rustCsgMcpJsonAppendOptionalStr(out, "codex_grant_root", wire.RustCsgJsonFindOptionalStr(paramsJson, "grantRoot"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("codex_changes", changesRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpApprovalElicitationParams(eventCat: str, paramsJson: str, requestIdRaw: str): str =
    if eventCat == "item/fileChange/requestApproval":
        return rustCsgMcpFileApprovalElicitationParams(paramsJson, requestIdRaw)
    return rustCsgMcpCommandApprovalElicitationParams(paramsJson, requestIdRaw)

fn rustCsgMcpServerRequestResolveParams(eventCat: str,
                                        paramsJson: str,
                                        requestIdRaw: str,
                                        responseBody: str,
                                        outError: var str): str =
    outError = ""
    var rawId = requestIdRaw
    if rawId == "":
        rawId = "0"
    let threadId = wire.RustCsgJsonFindOptionalStr(paramsJson, "threadId")
    if threadId == "":
        outError = "approval request missing threadId"
        return ""
    let itemId = wire.RustCsgJsonFindOptionalStr(paramsJson, "itemId")
    if itemId == "":
        outError = "approval request missing itemId"
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("requestId", rawId))
    out = wire.RustCsgCat(out, ",")
    if eventCat == "item/fileChange/requestApproval":
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", "fileChange"))
    else:
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", "commandExecution"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("itemId", itemId))
    if eventCat != "item/fileChange/requestApproval":
        let turnId = wire.RustCsgJsonFindOptionalStr(paramsJson, "turnId")
        if turnId == "":
            outError = "command approval request missing turnId"
            return ""
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turnId", turnId))
        let approvalId = wire.RustCsgJsonFindOptionalStr(paramsJson, "approvalId")
        if approvalId != "":
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approvalId", approvalId))
    let resultRaw = wire.RustCsgJsonFindOptionalObject(responseBody, "result")
    if resultRaw != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("result", resultRaw))
        out = wire.RustCsgCat(out, "}")
        return out
    let errorRaw = wire.RustCsgJsonFindOptionalObject(responseBody, "error")
    if errorRaw != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("error", errorRaw))
        out = wire.RustCsgCat(out, "}")
        return out
    outError = "elicitation response missing result or error"
    return ""

fn rustCsgMcpPostServerRequestResolve(appServerUrl: str,
                                      eventCat: str,
                                      paramsJson: str,
                                      requestIdRaw: str,
                                      responseBody: str,
                                      outError: var str): bool =
    outError = ""
    var buildError: str
    let resolveParams = rustCsgMcpServerRequestResolveParams(eventCat, paramsJson, requestIdRaw, responseBody, buildError)
    if buildError != "":
        outError = buildError
        return false
    var body = "{\"id\":0,\"method\":\"serverRequest/resolve\",\"params\":"
    body = wire.RustCsgCat(body, resolveParams)
    body = wire.RustCsgCat(body, "}")
    let rawResp = rawHttpPost(appServerUrl, body, "[\"Content-Type: application/json\"]")
    if rawResp == "":
        outError = "serverRequest/resolve returned empty response"
        return false
    if wire.RustCsgJsonFindOptionalValueRaw(rawResp, "status") == "":
        outError = "serverRequest/resolve transport failed"
        return false
    let statusCode = wire.RustCsgJsonFindInt32(rawResp, "status")
    if statusCode != 200:
        outError = wire.RustCsgCat("serverRequest/resolve HTTP status ", strings.IntToStr(statusCode))
        return false
    let responseBodyText = wire.RustCsgJsonFindOptionalStr(rawResp, "body")
    if responseBodyText == "":
        outError = "serverRequest/resolve response missing body"
        return false
    let responseError = wire.RustCsgJsonFindOptionalObject(responseBodyText, "error")
    if responseError != "":
        let message = wire.RustCsgJsonFindOptionalStr(responseError, "message")
        if message != "":
            outError = message
        else:
            outError = "serverRequest/resolve failed"
        return false
    let resultJson = wire.RustCsgJsonFindOptionalObject(responseBodyText, "result")
    if resultJson == "":
        outError = "serverRequest/resolve response missing result"
        return false
    if !wire.RustCsgJsonFindBool(resultJson, "resolved"):
        outError = "serverRequest/resolve did not resolve approval"
        return false
    return true

fn rustCsgMcpWaitForApprovalDecision(requestIdRaw: str, eventCat: str, paramsJson: str,
                                     appServerUrl: str,
                                     pendingInput: var str, outError: var str): str =
    outError = ""
    var rawId = requestIdRaw
    if rawId == "":
        rawId = "0"
    let requestParams = rustCsgMcpApprovalElicitationParams(eventCat, paramsJson, rawId)
    let requestFrame = rustCsgMcpRequestFrameRawId(rawId, "elicitation/create", requestParams)
    if !rustCsgMcpWriteAll(1, requestFrame):
        outError = "failed to write elicitation/create request"
        return ""
    var readError: str
    let responseBody = rustCsgMcpReadNextFrameBodyBlocking(pendingInput, readError)
    if readError != "":
        outError = readError
        return ""
    let responseIdRaw = wire.RustCsgJsonFindOptionalValueRaw(responseBody, "id")
    if responseIdRaw != rawId:
        outError = "elicitation response id mismatch"
        return ""
    let resultJson = wire.RustCsgJsonFindOptionalObject(responseBody, "result")
    if resultJson == "":
        let errorJson = wire.RustCsgJsonFindOptionalObject(responseBody, "error")
        if errorJson == "":
            outError = "elicitation response missing result"
            return ""
        var submitError: str
        if !rustCsgMcpPostServerRequestResolve(appServerUrl, eventCat, paramsJson, rawId, responseBody, submitError):
            outError = submitError
        return ""
    let decisionRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "decision")
    if decisionRaw == "":
        outError = "elicitation response missing decision"
        return ""
    var submitError: str
    if !rustCsgMcpPostServerRequestResolve(appServerUrl, eventCat, paramsJson, rawId, responseBody, submitError):
        outError = submitError
        return ""
    return decisionRaw

fn rustCsgMcpApplyAppServerStreamEvent(requestId: int32, resultJson: str,
                                       isReply: bool,
                                       fallbackThreadId: str,
                                       emitSessionConfigured: bool,
                                       appServerUrl: str,
                                       pendingInput: var str,
                                       state: var RustCsgMcpAppServerStreamState): bool =
    state.eventCount = state.eventCount + 1
    if state.eventCount > 1000:
        state.error = rustCsgMcpRuntimeErrorText("app-server stream exceeded 1000 events")
        return false
    let eventCat = wire.RustCsgJsonFindStr(resultJson, "eventCat")
    if eventCat == "invalid":
        state.error = rustCsgMcpRuntimeErrorText("Invalid app-server stream event")
        return false
    let threadId = wire.RustCsgJsonFindStr(resultJson, "threadId")
    let turnId = wire.RustCsgJsonFindStr(resultJson, "turnId")
    let itemJson = wire.RustCsgJsonFindValueRaw(resultJson, "item")
    let delta = wire.RustCsgJsonFindStr(resultJson, "delta")
    let itemType = wire.RustCsgJsonFindOptionalStr(resultJson, "itemType")
    let errorJson = wire.RustCsgJsonFindValueRaw(resultJson, "error")
    if state.threadId == "" && threadId != "":
        state.threadId = threadId
    if !isReply && eventCat == "response" && threadId != "" && turnId == "":
        state.threadStartSucceeded = true
    if emitSessionConfigured && !state.sessionConfiguredSent && eventCat == "response":
        let msg = rustCsgMcpSessionConfiguredMsg(resultJson)
        if msg != "":
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, "", msg))
            state.sessionConfiguredSent = true
    if eventCat == "turn/started":
        state.turnStarted = true
        state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTaskStartedMsg(turnId)))
    elif eventCat == "item/started":
        let startedAtMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "startedAtMs")
        let msg = rustCsgMcpItemStartedMsg(threadId, turnId, itemJson, startedAtMsRaw)
        if msg != "":
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, msg))
    elif eventCat == "item/delta":
        if itemType == "agentMessage":
            let itemId = wire.RustCsgJsonFindStr(resultJson, "itemId")
            state.agentText = wire.RustCsgCat(state.agentText, delta)
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpAgentMessageDeltaMsg(threadId, turnId, itemId, delta)))
    elif eventCat == "item/completed":
        let completedText = rustCsgMcpAgentMessageTextFromItem(itemJson)
        if completedText != "":
            state.agentText = completedText
        let completedAtMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAtMs")
        let msg = rustCsgMcpItemCompletedMsg(threadId, turnId, itemJson, completedAtMsRaw)
        if msg != "":
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, msg))
    elif eventCat == "item/commandExecution/requestApproval" || eventCat == "item/fileChange/requestApproval":
        if state.frames != "":
            if !rustCsgMcpWriteAll(1, state.frames):
                state.error = rustCsgMcpRuntimeErrorText("failed to write MCP frames before elicitation")
                return false
            state.frames = ""
        let paramsRaw = wire.RustCsgJsonFindOptionalObject(resultJson, "params")
        if paramsRaw == "":
            state.error = rustCsgMcpRuntimeErrorText("approval request missing params")
            return false
        let serverRequestIdRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "serverRequestId")
        var approvalError: str
        rustCsgMcpWaitForApprovalDecision(serverRequestIdRaw, eventCat, paramsRaw, appServerUrl, pendingInput, approvalError)
        if approvalError != "":
            state.error = rustCsgMcpRuntimeErrorText(approvalError)
            return false
    elif eventCat == "turn/completed":
        let statusRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "status")
        if statusRaw == "\"interrupted\"":
            let completedAtRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAt")
            let durationMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "durationMs")
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTurnAbortedMsg(turnId, "", completedAtRaw, durationMsRaw)))
            state.turnAborted = true
        else:
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTaskCompleteMsg(turnId, state.agentText)))
            state.turnCompleted = true
    elif eventCat == "turn/aborted" || eventCat == "turn_aborted":
        let reasonRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "reason")
        let completedAtRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAt")
        let durationMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "durationMs")
        state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTurnAbortedMsg(turnId, reasonRaw, completedAtRaw, durationMsRaw)))
        state.turnAborted = true
    elif eventCat == "error":
        let method = wire.RustCsgJsonFindOptionalStr(resultJson, "method")
        if method == "" && !state.turnStarted:
            var errMsg = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
            if errMsg == "":
                errMsg = "app-server stream error"
            if state.threadId == "" && isReply:
                state.threadId = fallbackThreadId
            if isReply:
                state.error = wire.RustCsgCat("Failed to submit user input: ", errMsg)
            elif state.threadStartSucceeded:
                state.error = wire.RustCsgCat("Failed to submit initial prompt: ", errMsg)
            else:
                state.error = wire.RustCsgCat("Failed to start Codex session: ", errMsg)
            return false
        if method == "":
            state.error = rustCsgMcpRuntimeErrorText(wire.RustCsgJsonFindOptionalStr(errorJson, "message"))
            if state.error == "Codex runtime error: ":
                state.error = rustCsgMcpRuntimeErrorText("app-server stream error")
            return false
        let willRetryRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "willRetry")
        if willRetryRaw == "true":
            state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpStreamErrorMsg(errorJson)))
            return true
        let errMsg = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
        state.frames = wire.RustCsgCat(state.frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpErrorMsg(errorJson)))
        if errMsg != "":
            state.error = errMsg
        else:
            state.error = "app-server stream error"
        return false
    return true

fn rustCsgMcpParseAppServerStreamOutput(requestId: int32, body: str,
                                        isReply: bool,
                                        fallbackThreadId: str,
                                        emitSessionConfigured: bool,
                                        appServerUrl: str,
                                        pendingInput: var str,
                                        outThreadId: var str,
                                        outContent: var str,
                                        outError: var str,
                                        outPending: var bool): str =
    outThreadId = ""
    outContent = ""
    outError = ""
    outPending = false
    var frames: str
    var remaining = body
    var turnCompleted: bool
    var turnAborted: bool
    var turnStarted: bool
    var threadStartSucceeded: bool
    var sessionConfiguredSent: bool
    var agentText: str
    var eventCount: int32
    while !turnCompleted && remaining.len > 0:
        eventCount = eventCount + 1
        if eventCount > 1000:
            outError = rustCsgMcpRuntimeErrorText("app-server stream exceeded 1000 events")
            return frames
        let resultJson = sp.AppServerParseStreamEventJson(remaining)
        let found = wire.RustCsgJsonFindBool(resultJson, "found")
        if !found:
            outError = rustCsgMcpRuntimeErrorText("Invalid app-server stream event")
            return frames
        let eventCat = wire.RustCsgJsonFindStr(resultJson, "eventCat")
        let threadId = wire.RustCsgJsonFindStr(resultJson, "threadId")
        let turnId = wire.RustCsgJsonFindStr(resultJson, "turnId")
        let itemJson = wire.RustCsgJsonFindValueRaw(resultJson, "item")
        let delta = wire.RustCsgJsonFindStr(resultJson, "delta")
        let itemType = wire.RustCsgJsonFindOptionalStr(resultJson, "itemType")
        let errorJson = wire.RustCsgJsonFindValueRaw(resultJson, "error")
        let consumed = wire.RustCsgJsonFindInt32(resultJson, "consumed")
        if consumed <= 0:
            outError = rustCsgMcpRuntimeErrorText("Invalid app-server stream cursor")
            return frames
        if outThreadId == "" && threadId != "":
            outThreadId = threadId
        if !isReply && eventCat == "response" && threadId != "" && turnId == "":
            threadStartSucceeded = true
        if emitSessionConfigured && !sessionConfiguredSent && eventCat == "response":
            let msg = rustCsgMcpSessionConfiguredMsg(resultJson)
            if msg != "":
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, "", msg))
                sessionConfiguredSent = true
        if eventCat == "turn/started":
            turnStarted = true
            frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTaskStartedMsg(turnId)))
        elif eventCat == "item/started":
            let startedAtMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "startedAtMs")
            let msg = rustCsgMcpItemStartedMsg(threadId, turnId, itemJson, startedAtMsRaw)
            if msg != "":
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, msg))
        elif eventCat == "item/delta":
            if itemType == "agentMessage":
                let itemId = wire.RustCsgJsonFindStr(resultJson, "itemId")
                agentText = wire.RustCsgCat(agentText, delta)
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpAgentMessageDeltaMsg(threadId, turnId, itemId, delta)))
        elif eventCat == "item/completed":
            let completedText = rustCsgMcpAgentMessageTextFromItem(itemJson)
            if completedText != "":
                agentText = completedText
            let completedAtMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAtMs")
            let msg = rustCsgMcpItemCompletedMsg(threadId, turnId, itemJson, completedAtMsRaw)
            if msg != "":
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, msg))
        elif eventCat == "item/commandExecution/requestApproval" || eventCat == "item/fileChange/requestApproval":
            if frames != "":
                if !rustCsgMcpWriteAll(1, frames):
                    outError = rustCsgMcpRuntimeErrorText("failed to write MCP frames before elicitation")
                    return ""
                frames = ""
            let paramsRaw = wire.RustCsgJsonFindOptionalObject(resultJson, "params")
            if paramsRaw == "":
                outError = rustCsgMcpRuntimeErrorText("approval request missing params")
                return frames
            let serverRequestIdRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "serverRequestId")
            var approvalError: str
            rustCsgMcpWaitForApprovalDecision(serverRequestIdRaw, eventCat, paramsRaw, appServerUrl, pendingInput, approvalError)
            if approvalError != "":
                outError = rustCsgMcpRuntimeErrorText(approvalError)
                return frames
        elif eventCat == "turn/completed":
            let statusRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "status")
            if statusRaw == "\"interrupted\"":
                let completedAtRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAt")
                let durationMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "durationMs")
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTurnAbortedMsg(turnId, "", completedAtRaw, durationMsRaw)))
                turnAborted = true
            else:
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTaskCompleteMsg(turnId, agentText)))
                turnCompleted = true
        elif eventCat == "turn/aborted" || eventCat == "turn_aborted":
            let reasonRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "reason")
            let completedAtRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "completedAt")
            let durationMsRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "durationMs")
            frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpTurnAbortedMsg(turnId, reasonRaw, completedAtRaw, durationMsRaw)))
            turnAborted = true
        elif eventCat == "error":
            let method = wire.RustCsgJsonFindOptionalStr(resultJson, "method")
            if method == "" && !turnStarted:
                var errMsg = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
                if errMsg == "":
                    errMsg = "app-server stream error"
                if outThreadId == "" && isReply:
                    outThreadId = fallbackThreadId
                if isReply:
                    outError = wire.RustCsgCat("Failed to submit user input: ", errMsg)
                elif threadStartSucceeded:
                    outError = wire.RustCsgCat("Failed to submit initial prompt: ", errMsg)
                else:
                    outError = wire.RustCsgCat("Failed to start Codex session: ", errMsg)
                return frames
            if method == "":
                outError = rustCsgMcpRuntimeErrorText(wire.RustCsgJsonFindOptionalStr(errorJson, "message"))
                if outError == "Codex runtime error: ":
                    outError = rustCsgMcpRuntimeErrorText("app-server stream error")
                return frames
            let willRetryRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "willRetry")
            if willRetryRaw == "true":
                frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpStreamErrorMsg(errorJson)))
                if consumed >= remaining.len:
                    remaining = ""
                else:
                    remaining = wire.RustCsgSliceBytes(remaining, consumed, remaining.len - consumed)
                continue
            let errMsg = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
            frames = wire.RustCsgCat(frames, rustCsgMcpCodexEventFrame(requestId, threadId, turnId, rustCsgMcpErrorMsg(errorJson)))
            if errMsg != "":
                outError = errMsg
            else:
                outError = "app-server stream error"
            return frames
        if consumed >= remaining.len:
            remaining = ""
        else:
            remaining = wire.RustCsgSliceBytes(remaining, consumed, remaining.len - consumed)
    if !turnCompleted:
        if turnAborted:
            outPending = true
            return frames
        outError = rustCsgMcpRuntimeErrorText("App-server stream ended before turn completed")
        return frames
    outContent = agentText
    if outContent == "":
        outContent = "(empty response)"
    return frames

fn rustCsgMcpFinalizeAppServerStreamState(state: var RustCsgMcpAppServerStreamState,
                                          outThreadId: var str,
                                          outContent: var str,
                                          outError: var str,
                                          outPending: var bool): str =
    outThreadId = state.threadId
    outContent = ""
    outError = state.error
    outPending = false
    if state.error != "":
        return state.frames
    if !state.turnCompleted:
        if state.turnAborted:
            outPending = true
            return state.frames
        outError = rustCsgMcpRuntimeErrorText("App-server stream ended before turn completed")
        return state.frames
    outContent = state.agentText
    if outContent == "":
        outContent = "(empty response)"
    return state.frames

fn rustCsgMcpParseAppServerStreamHandle(requestId: int32, handle: int32,
                                        isReply: bool,
                                        fallbackThreadId: str,
                                        emitSessionConfigured: bool,
                                        appServerUrl: str,
                                        pendingInput: var str,
                                        outThreadId: var str,
                                        outContent: var str,
                                        outError: var str,
                                        outPending: var bool): str =
    var state: RustCsgMcpAppServerStreamState
    var idle: int32
    while !state.turnCompleted && !state.turnAborted:
        let event = rustCsgMcpHttpNdjsonPoll(handle, 100)
        if event == "":
            idle = idle + 1
            if idle >= 600:
                state.error = rustCsgMcpRuntimeErrorText("timed out waiting for app-server stream")
                return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
            continue
        idle = 0
        if event.len <= 0:
            continue
        if event[0] == 'D':
            if event.len <= 1:
                continue
            let line = wire.RustCsgSliceBytes(event, 1, event.len - 1)
            let resultJson = sp.AppServerParseStreamEventJson(wire.RustCsgCat(line, "\n"))
            let found = wire.RustCsgJsonFindBool(resultJson, "found")
            if !found:
                state.error = rustCsgMcpRuntimeErrorText("Invalid app-server stream event")
                return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
            let consumed = wire.RustCsgJsonFindInt32(resultJson, "consumed")
            if consumed <= 0:
                state.error = rustCsgMcpRuntimeErrorText("Invalid app-server stream cursor")
                return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
            if !rustCsgMcpApplyAppServerStreamEvent(requestId, resultJson, isReply, fallbackThreadId, emitSessionConfigured, appServerUrl, pendingInput, state):
                return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
        elif event[0] == 'S':
            var statusCode: int32
            if event.len > 1:
                statusCode = wire.RustCsgParseInt32(wire.RustCsgSliceBytes(event, 1, event.len - 1))
            if statusCode != 200:
                state.error = wire.RustCsgCat("HTTP error: status=", strings.IntToStr(statusCode))
            return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
        elif event[0] == 'E':
            if event.len > 1:
                state.error = wire.RustCsgSliceBytes(event, 1, event.len - 1)
            else:
                state.error = "app-server stream read failed"
            return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
        else:
            state.error = rustCsgMcpRuntimeErrorText("invalid app-server stream event")
            return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)
    return rustCsgMcpFinalizeAppServerStreamState(state, outThreadId, outContent, outError, outPending)

fn rustCsgMcpHandleCodexFrames(id: int32, params: str, isReply: bool, pendingInput: var str): str =
    var appServerUrl: str
    var buildError: str
    let requestPlanJson = rustCsgMcpBuildCodexRequestPlanJson(params, isReply, appServerUrl, buildError)
    if buildError != "":
        return rustCsgMcpResponseFrame(id, rustCsgMcpCodexToolResult("", buildError, true))
    let handle = rustCsgMcpHttpNdjsonPostStart(appServerUrl, requestPlanJson, "[\"Content-Type: application/json\"]")
    if handle < 0:
        var message = "failed to start app-server stream"
        let providerError = rustCsgMcpHttpLastError()
        if providerError != "":
            message = wire.RustCsgCat(message, ": ")
            message = wire.RustCsgCat(message, providerError)
        return rustCsgMcpResponseFrame(id, rustCsgMcpCodexToolResult("", message, true))
    var threadId: str
    var content: str
    var parseError: str
    var pending: bool
    let fallbackThreadId = rustCsgMcpThreadIdFromToolParams(params)
    var frames = rustCsgMcpParseAppServerStreamHandle(id, handle, isReply, fallbackThreadId, !isReply, appServerUrl, pendingInput, threadId, content, parseError, pending)
    rustCsgMcpHttpNdjsonClose(handle)
    if pending:
        return frames
    if parseError != "":
        frames = wire.RustCsgCat(frames, rustCsgMcpResponseFrame(id, rustCsgMcpCodexToolResult(threadId, parseError, true)))
        return frames
    frames = wire.RustCsgCat(frames, rustCsgMcpResponseFrame(id, rustCsgMcpCodexToolResult(threadId, content, false)))
    return frames

fn rustCsgMcpHandleCodexToolCallFrames(id: int32, body: str, pendingInput: var str): str =
    let params = wire.RustCsgJsonFindOptionalObject(body, "params")
    if params == "":
        return ""
    let toolName = wire.RustCsgJsonFindOptionalStr(params, "name")
    if toolName != "codex" && toolName != "codex-reply":
        return ""
    let argsObj = wire.RustCsgJsonFindOptionalObject(params, "arguments")
    if toolName == "codex-reply":
        return rustCsgMcpHandleCodexFrames(id, argsObj, true, pendingInput)
    return rustCsgMcpHandleCodexFrames(id, argsObj, false, pendingInput)

fn rustCsgMcpHandleCodex(id: int32, params: str): str =
    if params == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"codex requires params with arguments\"}],\"isError\":true}")
    let prompt = wire.RustCsgJsonFindOptionalStr(params, "prompt")
    if prompt == "":
        let msg = "codex: 'prompt' is required and must not be empty"
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(msg), "}],\"isError\":true}"))
    if rustCsgMcpJsonHasTopLevelKey(params, "profile"):
        let msg = "Failed to parse configuration for Codex tool: unknown field `profile`"
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(msg), "}],\"isError\":true}"))
    var plan = exec_plan.RustCsgExecPlanDefault()
    plan.prompt = prompt
    plan.disableStdinContext = true
    plan.model = wire.RustCsgJsonFindOptionalStr(params, "model")
    plan.cwd = wire.RustCsgJsonFindOptionalStr(params, "cwd")
    plan.sandbox = wire.RustCsgJsonFindOptionalStr(params, "sandbox")
    let approvalPolicy = wire.RustCsgJsonFindOptionalStr(params, "approval-policy")
    if approvalPolicy != "":
        add(plan.configOverrides, wire.RustCsgCat("approval-policy=", approvalPolicy))
    if wire.RustCsgContains(params, "\"reasoning-effort\""):
        plan.reasoningEffort = wire.RustCsgJsonFindStr(params, "reasoning-effort")
    if wire.RustCsgContains(params, "\"reasoning-summary\""):
        plan.reasoningSummary = wire.RustCsgJsonFindStr(params, "reasoning-summary")
    if wire.RustCsgContains(params, "\"max-turns\""):
        plan.maxTurns = wire.RustCsgJsonFindInt32(params, "max-turns")
    let tempKey = "\"temperature\":"
    for i in 0..<(params.len - tempKey.len):
        if wire.RustCsgMatchesAt(params, i, tempKey):
            var s = i + tempKey.len
            var e = s
            while e < params.len && params[e] != ',' && params[e] != '}' && params[e] != ']':
                e = e + 1
            if e > s:
                add(plan.configOverrides, wire.RustCsgCat("temperature=", wire.RustCsgSliceBytes(params, s, e - s)))
            break
    let appServerUrl = rustCsgMcpResolveAppServerUrl(params)
    if appServerUrl == "":
        let err = "codex requires a running app-server. Start with 'codex app-server' or set CODEX_APP_SERVER_URL environment variable."
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(err), "}],\"isError\":true}"))
    plan.appServerUrl = appServerUrl
    if plan.parseError != "":
        let err = wire.RustCsgCat("codex plan: ", plan.parseError)
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(err), "}],\"isError\":true}"))
    let planJson = exec_plan.RustCsgExecPlanToJson(plan)
    return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(planJson), "}],\"isError\":false}"))

fn rustCsgMcpHandleCodexReply(id: int32, params: str): str =
    let prompt = wire.RustCsgJsonFindOptionalStr(params, "prompt")
    if prompt == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"codex-reply requires prompt parameter\"}],\"isError\":true}")
    let threadId = wire.RustCsgJsonFindOptionalStr(params, "threadId")
    if threadId == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"codex-reply requires threadId parameter\"}],\"isError\":true}")
    let model = wire.RustCsgJsonFindOptionalStr(params, "model")
    let approvalPolicy = wire.RustCsgJsonFindOptionalStr(params, "approval-policy")
    let appServerUrl = rustCsgMcpResolveAppServerUrl(params)
    if appServerUrl == "":
        let err = "codex requires a running app-server. Start with 'codex app-server' or set CODEX_APP_SERVER_URL environment variable."
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(err), "}],\"isError\":true}"))
    var info = wire.RustCsgCat4("codex-reply planned: prompt=", wire.RustCsgJsonQuote(prompt), ", threadId=", wire.RustCsgJsonQuote(threadId))
    if model != "":
        info = wire.RustCsgCat3(info, ", model=", wire.RustCsgJsonQuote(model))
    if approvalPolicy != "":
        info = wire.RustCsgCat3(info, ", approval-policy=", wire.RustCsgJsonQuote(approvalPolicy))
    info = wire.RustCsgCat3(info, ", url=", appServerUrl)
    return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(info), "}],\"isError\":false}"))

fn parseHttpStatus(raw: str): int32 =
    if raw == "": return 0
    var i: int32
    while i + 4 <= raw.len:
        if raw[i] == ' ' && raw[i+1] >= '0' && raw[i+1] <= '9':
            return 100 * (int32(raw[i+1]) - 48) + 10 * (int32(raw[i+2]) - 48) + (int32(raw[i+3]) - 48)
        i = i + 1
    return 0

fn rustCsgMcpHandleCodexHealth(id: int32, params: str): str =
    let url = "http://127.0.0.1:4096/health"
    let response = rawHttpPost(url, "", "")
    var reachable: bool = false
    var error: str = ""
    if response != "":
        let statusCode = parseHttpStatus(response)
        if statusCode == 200:
            reachable = true
        else:
            error = wire.RustCsgCat("HTTP ", strings.IntToStr(statusCode))
    else:
        error = "connection refused"
    var out = "{\"appServer\":{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("url", url))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("reachable", reachable))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("error", error))
    out = wire.RustCsgCat(out, "},\"mcpServer\":{\"status\":\"ok\",\"tools\":12,\"resources\":8}}")
    return rustCsgMcpResponse(id, out)

fn rustCsgMcpHandleExecApproval(id: int32, params: str): str =
    let command = wire.RustCsgJsonFindStr(params, "command")
    if command == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"exec_approval requires command\"}],\"isError\":true}")
    if rustCsgMcpIsDangerCommand(command):
        let msg = wire.RustCsgCat("dangerous command rejected: ", command)
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(msg), "}],\"isError\":true}"))
    if !rustCsgMcpIsSafeCommand(command):
        let msg = wire.RustCsgCat("unsafe command blocked: ", command)
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(msg), "}],\"isError\":true}"))
    return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"command approved\"}],\"isError\":false}")

fn rustCsgMcpHandlePatchApproval(id: int32, params: str): str =
    let changes = wire.RustCsgJsonFindOptionalObject(params, "changes")
    if changes == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"patch_approval requires changes\"}],\"isError\":true}")
    if wire.RustCsgContains(changes, "\"file\"") || wire.RustCsgContains(changes, "\"path\""):
        let filePath = wire.RustCsgJsonFindOptionalStr(changes, "file")
        if filePath == "":
            filePath = wire.RustCsgJsonFindOptionalStr(changes, "path")
        if filePath != "" && !rustCsgMcpIsSafeFileType(filePath):
            let msg = wire.RustCsgCat("unsafe file type rejected: ", filePath)
            return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(msg), "}],\"isError\":true}"))
    return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"patch approved\"}],\"isError\":false}")

fn rustCsgMcpHandleElicitationCreate(id: int32, body: str): str =
    let params = wire.RustCsgJsonFindOptionalObject(body, "params")
    if params == "":
        return rustCsgMcpError(id, -32602, "elicitation/create requires params")
    let elicitationType = wire.RustCsgJsonFindOptionalStr(params, "type")
    if elicitationType == "":
        return rustCsgMcpError(id, -32602, "elicitation/create requires type")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("elicitationId", strings.IntToStr(id)))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("status", "pending"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", elicitationType))
    out = wire.RustCsgCat(out, "}")
    return rustCsgMcpResponse(id, out)

