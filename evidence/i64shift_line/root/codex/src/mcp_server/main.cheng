    let t1 = "{\"name\":\"codex-capabilities\",\"uriTemplate\":\"codex://capabilities\",\"title\":\"Rust CSG Capabilities\",\"description\":\"Current codex MCP server implemented method, tool, and resource surface.\",\"mimeType\":\"text/plain\"}"
