@ffi_owned_result(free = free)
@importc("cheng_http_post")
fn rawHttpPostAbi(url: cstring, body: cstring, headers: cstring): owned_cstring

@importc("cheng_http_ndjson_post_start")
fn rustCsgMcpHttpNdjsonPostStartAbi(url: cstring, body: cstring, headers: cstring): int32

@ffi_owned_result(free = free)
@importc("cheng_http_ndjson_poll")
fn rustCsgMcpHttpNdjsonPollAbi(handle: int32, timeoutMs: int32): owned_cstring

@importc("cheng_http_ndjson_close")
fn rustCsgMcpHttpNdjsonClose(handle: int32): int32

@ffi_owned_result(free = free)
@importc("cheng_http_last_error")
fn rustCsgMcpHttpLastErrorAbi(): owned_cstring

@importc("calloc")
fn rustCsgMcpCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn rustCsgMcpMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("strlen")
fn rustCsgMcpCStringLen(raw: ptr): int64

@importc("free")
fn rustCsgMcpCStringFree(raw: ptr)

fn rustCsgMcpCString(text: str): cstring =
    let raw = rustCsgMcpCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        rustCsgMcpMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn rustCsgMcpFreeCString(raw: cstring) =
    if ptr(raw) != nil:
        rustCsgMcpCStringFree(ptr(raw))

fn rawHttpPost(url: str, body: str, headers: str): str =
    let urlRaw = rustCsgMcpCString(url)
    let bodyRaw = rustCsgMcpCString(body)
    let headersRaw = rustCsgMcpCString(headers)
    let out: str = rawHttpPostAbi(urlRaw, bodyRaw, headersRaw)
    rustCsgMcpFreeCString(urlRaw)
    rustCsgMcpFreeCString(bodyRaw)
    rustCsgMcpFreeCString(headersRaw)
    return out

fn rustCsgMcpHttpNdjsonPostStart(url: str, body: str, headers: str): int32 =
    let urlRaw = rustCsgMcpCString(url)
    let bodyRaw = rustCsgMcpCString(body)
    let headersRaw = rustCsgMcpCString(headers)
    let handle = rustCsgMcpHttpNdjsonPostStartAbi(urlRaw, bodyRaw, headersRaw)
    rustCsgMcpFreeCString(urlRaw)
    rustCsgMcpFreeCString(bodyRaw)
    rustCsgMcpFreeCString(headersRaw)
    return handle

fn rustCsgMcpHttpNdjsonPoll(handle: int32, timeoutMs: int32): str =
    let out: str = rustCsgMcpHttpNdjsonPollAbi(handle, timeoutMs)
    return out

fn rustCsgMcpHttpLastError(): str =
    let out: str = rustCsgMcpHttpLastErrorAbi()
    return out

@abi_internal
@importc("ReadFile")
fn RustCsgReadFile(path: str): str

@abi_internal
@importc("RustCsgWriteFile")
fn RustCsgWriteFile(path: str, content: str): int32

@importc("RustCsgModelEmbedding")
fn RustCsgModelEmbeddingAbi(model: cstring, input: cstring, apiKey: cstring, apiUrl: cstring): cstring

@importc("RustCsgModelImageGenerate")
fn RustCsgModelImageGenerateAbi(model: cstring, prompt: cstring, apiKey: cstring, apiUrl: cstring): cstring

fn rustCsgMcpCStringToOwnedStr(raw: cstring): str =
    if ptr(raw) == nil:
        return ""
    let count = int32(rustCsgMcpCStringLen(ptr(raw)))
    if count <= 0:
        rustCsgMcpCStringFree(ptr(raw))
        return ""
    let out = system.StrFromBytesCopy(ptr(raw), count)
    rustCsgMcpCStringFree(ptr(raw))
    return out

fn RustCsgModelEmbedding(model: str, input: str, apiKey: str, apiUrl: str): str =
    let modelRaw = rustCsgMcpCString(model)
    let inputRaw = rustCsgMcpCString(input)
    let apiKeyRaw = rustCsgMcpCString(apiKey)
    let apiUrlRaw = rustCsgMcpCString(apiUrl)
    let raw = RustCsgModelEmbeddingAbi(modelRaw, inputRaw, apiKeyRaw, apiUrlRaw)
    rustCsgMcpFreeCString(modelRaw)
    rustCsgMcpFreeCString(inputRaw)
    rustCsgMcpFreeCString(apiKeyRaw)
    rustCsgMcpFreeCString(apiUrlRaw)
    return rustCsgMcpCStringToOwnedStr(raw)

fn RustCsgModelImageGenerate(model: str, prompt: str, apiKey: str, apiUrl: str): str =
    let modelRaw = rustCsgMcpCString(model)
    let promptRaw = rustCsgMcpCString(prompt)
    let apiKeyRaw = rustCsgMcpCString(apiKey)
    let apiUrlRaw = rustCsgMcpCString(apiUrl)
    let raw = RustCsgModelImageGenerateAbi(modelRaw, promptRaw, apiKeyRaw, apiUrlRaw)
    rustCsgMcpFreeCString(modelRaw)
    rustCsgMcpFreeCString(promptRaw)
    rustCsgMcpFreeCString(apiKeyRaw)
    rustCsgMcpFreeCString(apiUrlRaw)
    return rustCsgMcpCStringToOwnedStr(raw)

type RustCsgMcpFrame =
    ok: bool
    blocked: bool
    body: str
    rest: str

type RustCsgMcpAppServerStreamState =
    frames: str
    threadId: str
    content: str
    error: str
    pending: bool
    turnCompleted: bool
    turnAborted: bool
    turnStarted: bool
    threadStartSucceeded: bool
    sessionConfiguredSent: bool
    agentText: str
    eventCount: int32

fn rustCsgMcpBuildFrame(body: str): str =
    return wire.RustCsgCat4("Content-Length: ", strings.IntToStr(body.len), "\r\n\r\n", body)

fn rustCsgMcpFindHeaderEnd(text: str): int32 =
    var i: int32
    while i + 4 <= text.len:
        if text[i] == '\r' && text[i + 1] == '\n' && text[i + 2] == '\r' && text[i + 3] == '\n':
            return i
        i = i + 1
    return -1

fn rustCsgMcpParseContentLength(header: str): int32 =
    let prefix: str = "Content-Length:"
    var i: int32
    while i + prefix.len <= header.len:
        var matched: bool = true
        for j in 0..<prefix.len:
            if header[i + j] != prefix[j]:
                matched = false
                break
        if matched:
            i = i + prefix.len
            while i < header.len && header[i] == ' ':
                i = i + 1
            var value: int32
            var sawDigit: bool
            while i < header.len && header[i] >= '0' && header[i] <= '9':
                value = value * 10 + (int32(header[i]) - int32('0'))
                sawDigit = true
                i = i + 1
            if !sawDigit:
                return -1
            return value
        i = i + 1
    return -1

fn rustCsgMcpTryReadFrame(buffer: str): RustCsgMcpFrame =
    var out: RustCsgMcpFrame
    let headerEnd = rustCsgMcpFindHeaderEnd(buffer)
    if headerEnd < 0:
        out.blocked = true
        return out
    let header = strings.SliceBytes(buffer, 0, headerEnd)
    let contentLength = rustCsgMcpParseContentLength(header)
    if contentLength < 0:
        return out
    let bodyStart = headerEnd + 4
    if buffer.len < bodyStart + contentLength:
        out.blocked = true
        return out
    out.body = strings.SliceBytes(buffer, bodyStart, contentLength)
    out.rest = strings.SliceBytes(buffer, bodyStart + contentLength, buffer.len - bodyStart - contentLength)
    out.ok = true
    return out

fn rustCsgMcpWriteAll(fd: int32, data: str): bool =
    var offset: int32
    while offset < data.len:
        let chunk = strings.SliceBytes(data, offset, data.len - offset)
        let wrote = process.ProcessWriteFd(fd, chunk)
        if wrote <= 0:
            return false
        offset = offset + wrote
    return true

fn rustCsgMcpResponse(id: int32, resultJson: str): str =
    let head = wire.RustCsgCat3("{\"jsonrpc\":\"2.0\",\"id\":", strings.IntToStr(id), ",\"result\":")
    return wire.RustCsgCat3(head, resultJson, "}")

fn rustCsgMcpResponseFrame(id: int32, resultJson: str): str =
    return rustCsgMcpBuildFrame(rustCsgMcpResponse(id, resultJson))

fn rustCsgMcpRequestFrameRawId(idRaw: str, method: str, paramsJson: str): str =
    var rawId = idRaw
    if rawId == "":
        rawId = "0"
    var body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = wire.RustCsgCat(body, rawId)
    body = wire.RustCsgCat(body, ",")
    body = wire.RustCsgCat(body, wire.RustCsgJsonFieldStr("method", method))
    body = wire.RustCsgCat(body, ",")
    body = wire.RustCsgCat(body, wire.RustCsgJsonFieldRaw("params", paramsJson))
    body = wire.RustCsgCat(body, "}")
    return rustCsgMcpBuildFrame(body)

fn rustCsgMcpError(id: int32, code: int32, message: str): str =
    let head = wire.RustCsgCat3("{\"jsonrpc\":\"2.0\",\"id\":", strings.IntToStr(id), ",\"error\":")
    let errHead = wire.RustCsgCat3("{\"code\":", strings.IntToStr(code), ",\"message\":")
    return wire.RustCsgCat4(head, wire.RustCsgCat3(errHead, wire.RustCsgJsonQuote(message), "}"), "}", "")

fn rustCsgMcpErrorFrame(id: int32, code: int32, message: str): str =
    return rustCsgMcpBuildFrame(rustCsgMcpError(id, code, message))

fn rustCsgMcpToolResultText(text: str): str =
    return wire.RustCsgCat3("{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(text), "}")

fn mcOk(text: str): str =
    return wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(text), "}],\"isError\":false}")

fn mcErr(text: str): str =
    return wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(text), "}],\"isError\":true}")

fn rustCsgMcpCodexEventJson(requestId: int32, threadId: str, turnId: str, msgJson: str): str =
    var out = "{\"jsonrpc\":\"2.0\",\"method\":\"codex/event\",\"params\":{\"_meta\":{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldInt32("requestId", requestId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
    out = wire.RustCsgCat(out, "},")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("msg", msgJson))
    out = wire.RustCsgCat(out, "}}")
    return out

fn rustCsgMcpCodexEventFrame(requestId: int32, threadId: str, turnId: str, msgJson: str): str =
    return rustCsgMcpBuildFrame(rustCsgMcpCodexEventJson(requestId, threadId, turnId, msgJson))

fn rustCsgMcpTaskStartedMsg(turnId: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "task_started"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",\"model_context_window\":null")
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("collaboration_mode_kind", "default"))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpTaskCompleteMsg(turnId: str, lastAgentMessage: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "task_complete"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("last_agent_message", lastAgentMessage))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpTurnAbortedMsg(turnId: str, reasonRaw: str, completedAtRaw: str, durationMsRaw: str): str =
    var reason = reasonRaw
    if reason == "":
        reason = wire.RustCsgJsonQuote("interrupted")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "turn_aborted"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("reason", reason))
    if completedAtRaw != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("completed_at", completedAtRaw))
    if durationMsRaw != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("duration_ms", durationMsRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpJsonRawPresent(raw: str): bool =
    return raw != "" && raw != "null"

fn rustCsgMcpJsonAppendOptionalRaw(out: str, key: str, raw: str): str =
    if !rustCsgMcpJsonRawPresent(raw):
        return out
    return wire.RustCsgCat3(out, ",", wire.RustCsgJsonFieldRaw(key, raw))

fn rustCsgMcpJsonAppendOptionalStr(out: str, key: str, value: str): str =
    if value == "":
        return out
    return wire.RustCsgCat3(out, ",", wire.RustCsgJsonFieldStr(key, value))

fn rustCsgMcpJsonRawToText(raw: str): str =
    if raw == "":
        return ""
    if raw[0] == '"':
        return wire.RustCsgJsonFindStr(wire.RustCsgCat3("{\"v\":", raw, "}"), "v")
    return raw

fn rustCsgMcpNetworkPolicyFromSandbox(sandboxJson: str): str =
    let raw = wire.RustCsgJsonFindOptionalValueRaw(sandboxJson, "networkAccess")
    if raw == "true" || raw == "\"enabled\"":
        return "enabled"
    return "restricted"

fn rustCsgMcpPermissionSpecialEntry(kind: str, access: str): str =
    var out = "{\"path\":{\"type\":\"special\",\"value\":{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("kind", kind))
    out = wire.RustCsgCat(out, "}},")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("access", access))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpPermissionPathEntry(path: str): str =
    var out = "{\"path\":{\"type\":\"path\","
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("path", path))
    out = wire.RustCsgCat(out, "},")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("access", "write"))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpManagedPermissionProfile(entriesJson: str, network: str): str =
    var out = "{\"type\":\"managed\",\"file_system\":{\"type\":\"restricted\",\"entries\":["
    out = wire.RustCsgCat(out, entriesJson)
    out = wire.RustCsgCat(out, "]},")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("network", network))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpWorkspaceWritePermissionProfile(sandboxJson: str): str =
    var entries = rustCsgMcpPermissionSpecialEntry("root", "read")
    entries = wire.RustCsgCat3(entries, ",", rustCsgMcpPermissionSpecialEntry("project_roots", "write"))
    if wire.RustCsgJsonFindOptionalValueRaw(sandboxJson, "excludeSlashTmp") != "true":
        entries = wire.RustCsgCat3(entries, ",", rustCsgMcpPermissionSpecialEntry("slash_tmp", "write"))
    if wire.RustCsgJsonFindOptionalValueRaw(sandboxJson, "excludeTmpdirEnvVar") != "true":
        entries = wire.RustCsgCat3(entries, ",", rustCsgMcpPermissionSpecialEntry("tmpdir", "write"))
    let rootsRaw = wire.RustCsgJsonFindOptionalValueRaw(sandboxJson, "writableRoots")
    if rustCsgMcpJsonRawPresent(rootsRaw):
        if rootsRaw.len == 0 || rootsRaw[0] != '[':
            return ""
        let roots = wire.RustCsgJsonStringArrayFromRaw(rootsRaw)
        for i in 0..<roots.len:
            entries = wire.RustCsgCat3(entries, ",", rustCsgMcpPermissionPathEntry(roots[i]))
    return rustCsgMcpManagedPermissionProfile(entries, rustCsgMcpNetworkPolicyFromSandbox(sandboxJson))

fn rustCsgMcpPermissionProfileFromSandbox(sandboxJson: str): str =
    if sandboxJson == "" || sandboxJson == "null":
        return ""
    if sandboxJson[0] != '{':
        return ""
    let sandboxType = wire.RustCsgJsonFindOptionalStr(sandboxJson, "type")
    if sandboxType == "dangerFullAccess" || sandboxType == "danger-full-access":
        return "{\"type\":\"disabled\"}"
    if sandboxType == "readOnly" || sandboxType == "read-only":
        let entries = rustCsgMcpPermissionSpecialEntry("root", "read")
        return rustCsgMcpManagedPermissionProfile(entries, rustCsgMcpNetworkPolicyFromSandbox(sandboxJson))
    if sandboxType == "workspaceWrite" || sandboxType == "workspace-write":
        return rustCsgMcpWorkspaceWritePermissionProfile(sandboxJson)
    if sandboxType == "externalSandbox" || sandboxType == "external-sandbox":
        var out = "{\"type\":\"external\","
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("network", rustCsgMcpNetworkPolicyFromSandbox(sandboxJson)))
        out = wire.RustCsgCat(out, "}")
        return out
    return ""

fn rustCsgMcpSessionConfiguredMsg(resultJson: str): str =
    let sessionId = wire.RustCsgJsonFindOptionalStr(resultJson, "sessionId")
    let threadId = wire.RustCsgJsonFindOptionalStr(resultJson, "threadId")
    let model = wire.RustCsgJsonFindOptionalStr(resultJson, "model")
    let modelProvider = wire.RustCsgJsonFindOptionalStr(resultJson, "modelProvider")
    let approvalPolicyRaw = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "approvalPolicy")
    let approvalsReviewer = wire.RustCsgJsonFindOptionalStr(resultJson, "approvalsReviewer")
    let sandboxJson = wire.RustCsgJsonFindOptionalValueRaw(resultJson, "sandbox")
    let permissionProfileJson = rustCsgMcpPermissionProfileFromSandbox(sandboxJson)
    let cwd = wire.RustCsgJsonFindOptionalStr(resultJson, "cwd")
    if sessionId == "" || threadId == "" || model == "" || modelProvider == "":
        return ""
    if approvalPolicyRaw == "" || approvalPolicyRaw == "null" || approvalsReviewer == "" || permissionProfileJson == "" || cwd == "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "session_configured"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("session_id", sessionId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", threadId))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "forked_from_id", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "forkedFromId"))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "thread_source", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "threadSource"))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "thread_name", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "threadName"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model", model))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("model_provider_id", modelProvider))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "service_tier", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "serviceTier"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("approval_policy", approvalPolicyRaw))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("approvals_reviewer", approvalsReviewer))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("permission_profile", permissionProfileJson))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "active_permission_profile", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "activePermissionProfile"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("cwd", cwd))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "reasoning_effort", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "reasoningEffort"))
    out = rustCsgMcpJsonAppendOptionalRaw(out, "rollout_path", wire.RustCsgJsonFindOptionalValueRaw(resultJson, "rolloutPath"))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpAgentMessageDeltaMsg(threadId: str, turnId: str, itemId: str, delta: str): str =
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "agent_message_content_delta"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("item_id", itemId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("delta", delta))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpCodexErrorInfoHttpObject(raw: str, camelKey: str, snakeKey: str): str =
    if wire.RustCsgContains(raw, wire.RustCsgCat3("\"", snakeKey, "\"")):
        return raw
    if !wire.RustCsgContains(raw, wire.RustCsgCat3("\"", camelKey, "\"")):
        return ""
    let infoObj = wire.RustCsgJsonFindOptionalObject(raw, camelKey)
    var statusRaw = wire.RustCsgJsonFindOptionalValueRaw(infoObj, "httpStatusCode")
    if statusRaw == "":
        statusRaw = wire.RustCsgJsonFindOptionalValueRaw(infoObj, "http_status_code")
    if statusRaw == "":
        statusRaw = "null"
    var out = "{\""
    out = wire.RustCsgCat(out, snakeKey)
    out = wire.RustCsgCat(out, "\":{")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("http_status_code", statusRaw))
    out = wire.RustCsgCat(out, "}}")
    return out

fn rustCsgMcpCodexErrorInfoJson(raw: str): str =
    if raw == "" || raw == "null":
        return "null"
    if raw == "\"contextWindowExceeded\"":
        return wire.RustCsgJsonQuote("context_window_exceeded")
    if raw == "\"usageLimitExceeded\"":
        return wire.RustCsgJsonQuote("usage_limit_exceeded")
    if raw == "\"serverOverloaded\"":
        return wire.RustCsgJsonQuote("server_overloaded")
    if raw == "\"cyberPolicy\"":
        return wire.RustCsgJsonQuote("cyber_policy")
    if raw == "\"badRequest\"":
        return wire.RustCsgJsonQuote("bad_request")
    if raw == "\"other\"":
        return wire.RustCsgJsonQuote("other")
    let disconnected = rustCsgMcpCodexErrorInfoHttpObject(raw, "responseStreamDisconnected", "response_stream_disconnected")
    if disconnected != "":
        return disconnected
    let connectionFailed = rustCsgMcpCodexErrorInfoHttpObject(raw, "responseStreamConnectionFailed", "response_stream_connection_failed")
    if connectionFailed != "":
        return connectionFailed
    let httpFailed = rustCsgMcpCodexErrorInfoHttpObject(raw, "httpConnectionFailed", "http_connection_failed")
    if httpFailed != "":
        return httpFailed
    let tooMany = rustCsgMcpCodexErrorInfoHttpObject(raw, "responseTooManyFailedAttempts", "response_too_many_failed_attempts")
    if tooMany != "":
        return tooMany
    return raw

fn rustCsgMcpErrorCodexInfoRaw(errorJson: str): str =
    let codexErrorInfo = wire.RustCsgJsonFindOptionalValueRaw(errorJson, "codex_error_info")
    if codexErrorInfo != "":
        return rustCsgMcpCodexErrorInfoJson(codexErrorInfo)
    let camelInfo = wire.RustCsgJsonFindOptionalValueRaw(errorJson, "codexErrorInfo")
    if camelInfo != "":
        return rustCsgMcpCodexErrorInfoJson(camelInfo)
    return "null"

fn rustCsgMcpErrorMsg(errorJson: str): str =
    let message = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "error"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", message))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("codex_error_info", rustCsgMcpErrorCodexInfoRaw(errorJson)))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpStreamErrorMsg(errorJson: str): str =
    let message = wire.RustCsgJsonFindOptionalStr(errorJson, "message")
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "stream_error"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("message", message))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("codex_error_info", rustCsgMcpErrorCodexInfoRaw(errorJson)))
    let details = wire.RustCsgJsonFindOptionalStr(errorJson, "additional_details")
    if details != "":
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("additional_details", details))
    else:
        let camelDetails = wire.RustCsgJsonFindOptionalStr(errorJson, "additionalDetails")
        if camelDetails != "":
            out = wire.RustCsgCat(out, ",")
            out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("additional_details", camelDetails))
        else:
            out = wire.RustCsgCat(out, ",\"additional_details\":null")
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpCoreAgentMessageItemJson(itemJson: str): str =
    if itemJson == "" || itemJson == "null":
        return ""
    let itemType = wire.RustCsgJsonFindStr(itemJson, "type")
    if itemType != "agentMessage":
        return ""
    let itemId = wire.RustCsgJsonFindStr(itemJson, "id")
    var text = wire.RustCsgJsonFindOptionalStr(itemJson, "text")
    if text == "":
        let contentRaw = wire.RustCsgJsonFindOptionalValueRaw(itemJson, "content")
        if contentRaw != "":
            text = wire.RustCsgJsonFindOptionalStr(contentRaw, "text")
    var out = "{\"type\":\"AgentMessage\","
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("id", itemId))
    out = wire.RustCsgCat(out, ",\"content\":[{")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "Text"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("text", text))
    out = wire.RustCsgCat(out, "}]}")
    return out

fn rustCsgMcpItemStartedMsg(threadId: str, turnId: str, itemJson: str, startedAtMsRaw: str): str =
    let coreItem = rustCsgMcpCoreAgentMessageItemJson(itemJson)
    if coreItem == "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "item_started"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("item", coreItem))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("started_at_ms", startedAtMsRaw))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpItemCompletedMsg(threadId: str, turnId: str, itemJson: str, completedAtMsRaw: str): str =
    let coreItem = rustCsgMcpCoreAgentMessageItemJson(itemJson)
    if coreItem == "":
        return ""
    var out = "{"
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("type", "item_completed"))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("thread_id", threadId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("turn_id", turnId))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("item", coreItem))
    out = wire.RustCsgCat(out, ",")
    out = wire.RustCsgCat(out, wire.RustCsgJsonFieldRaw("completed_at_ms", completedAtMsRaw))
    out = wire.RustCsgCat(out, "}")
