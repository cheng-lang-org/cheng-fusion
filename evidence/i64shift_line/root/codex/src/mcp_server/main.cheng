fn rustCsgMcpResourceReadResult(uri: str, mimeType: str, textValue: str): str =
    let head = wire.RustCsgCat3("{\"contents\":[{\"uri\":", wire.RustCsgJsonQuote(uri), ",")
    let mime = wire.RustCsgCat3("\"mimeType\":", wire.RustCsgJsonQuote(mimeType), ",")
    let text = wire.RustCsgCat3("\"text\":", wire.RustCsgJsonQuote(textValue), "}]}")
    return wire.RustCsgCat3(head, mime, text)

fn rustCsgMcpResourcesListResult(): str =
    let r0 = "{\"name\":\"codex-status\",\"uri\":\"codex://status\",\"title\":\"Rust CSG Status\",\"description\":\"Current codex MCP server runtime status.\",\"mimeType\":\"text/plain\"}"
    let r1 = "{\"name\":\"codex-capabilities\",\"uri\":\"codex://capabilities\",\"title\":\"Rust CSG Capabilities\",\"description\":\"Current codex MCP server implemented method, tool, and resource surface.\",\"mimeType\":\"text/plain\"}"
    let r2 = "{\"name\":\"codex-package\",\"uri\":\"codex://package\",\"title\":\"Rust CSG Package\",\"description\":\"Current codex Cheng package identity exposed by this MCP server.\",\"mimeType\":\"application/json\"}"
    let r3 = "{\"name\":\"codex-inventory\",\"uri\":\"codex://inventory\",\"title\":\"Rust CSG Inventory\",\"description\":\"Current codex source inventory facts exposed by this MCP server.\",\"mimeType\":\"application/json\"}"
    let r4 = "{\"name\":\"codex-tools-count\",\"uri\":\"codex://tools/count\",\"title\":\"Codex Tools Count\",\"description\":\"Total number of tools available on this MCP server.\",\"mimeType\":\"application/json\"}"
    let r5 = "{\"name\":\"codex-tools-names\",\"uri\":\"codex://tools/names\",\"title\":\"Codex Tools Names\",\"description\":\"Comma-separated list of all tool names.\",\"mimeType\":\"application/json\"}"
    let r6 = "{\"name\":\"codex-health\",\"uri\":\"codex://health\",\"title\":\"Codex Health\",\"description\":\"MCP server health status.\",\"mimeType\":\"application/json\"}"
    let r7 = "{\"name\":\"codex-server-info\",\"uri\":\"codex://server/info\",\"title\":\"Codex Server Info\",\"description\":\"Codex MCP server identity and version information.\",\"mimeType\":\"application/json\"}"
    let comma = ","
    let all = wire.RustCsgCat4(r0, comma, r1, comma)
    all = wire.RustCsgCat4(all, r2, comma, r3)
    all = wire.RustCsgCat4(all, comma, r4, comma)
    all = wire.RustCsgCat4(all, r5, comma, r6)
    all = wire.RustCsgCat3(all, comma, r7)
    return wire.RustCsgCat4("{\"resources\":[", all, "]}", "")

