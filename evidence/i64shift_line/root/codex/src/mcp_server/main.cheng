fn rustCsgMcpHandleCompletionChat(id: int32, argsObj: str): str =
    if argsObj == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"completion/chat requires messages\"}],\"isError\":true}")
    let messages = wire.RustCsgJsonFindOptionalArray(argsObj, "messages")
    if messages == "" || messages == "[]":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"messages must not be empty\"}],\"isError\":true}")
    var model = wire.RustCsgJsonFindOptionalStr(argsObj, "model")
    if model == "":
        model = "gpt-5"
    var apiKey: str = home.RustCsgGetEnv("DEEPSEEK_API_KEY")
    var apiUrl: str = ""
    if apiKey != "":
        apiUrl = "https://api.deepseek.com/v1/chat/completions"
        if model == "gpt-5":
            model = "deepseek-chat"
    if apiKey == "":
        apiKey = home.RustCsgGetEnv("OPENAI_API_KEY")
    if apiKey == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"completion/chat: no API key configured (set DEEPSEEK_API_KEY or OPENAI_API_KEY)\"}],\"isError\":true}")
    var outResponse: str
    var outError: str
    model_chat.RustCsgModelChatWithUrl(model, messages, apiKey, apiUrl, outResponse, outError)
    if outError == "" && outResponse != "":
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(outResponse), "}],\"isError\":false}"))
    return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(wire.RustCsgCat("API error: ", outError)), "}],\"isError\":true}"))

fn rustCsgMcpHandleEmbeddingCreate(id: int32, argsObj: str): str =
    if argsObj == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"embedding/create requires input\"}],\"isError\":true}")
    let input = wire.RustCsgJsonFindOptionalStr(argsObj, "input")
    if input == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"input must not be empty\"}],\"isError\":true}")
    var model = wire.RustCsgJsonFindOptionalStr(argsObj, "model")
    if model == "":
        model = "text-embedding-3-small"

    var apiKey: str = home.RustCsgGetEnv("DEEPSEEK_API_KEY")
    var apiUrl: str = ""
    if apiKey != "":
        apiUrl = "https://api.deepseek.com/v1/embeddings"
    if apiKey == "":
        apiKey = home.RustCsgGetEnv("OPENAI_API_KEY")
    if apiKey == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"embedding/create: no API key configured (set DEEPSEEK_API_KEY or OPENAI_API_KEY)\"}],\"isError\":true}")

    let result: str = RustCsgModelEmbedding(model, input, apiKey, apiUrl)
    if strings.HasPrefix(result, "{\"error\""):
        let reason = wire.RustCsgJsonFindOptionalStr(result, "error")
        if reason == "":
            reason = "embedding API call failed"
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(reason), "}],\"isError\":true}"))

    return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(result), "}],\"isError\":false}"))

fn rustCsgMcpHandleImageGenerate(id: int32, argsObj: str): str =
    if argsObj == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"image/generate requires prompt\"}],\"isError\":true}")
    let prompt = wire.RustCsgJsonFindOptionalStr(argsObj, "prompt")
    if prompt == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"prompt must not be empty\"}],\"isError\":true}")
    var model = wire.RustCsgJsonFindOptionalStr(argsObj, "model")
    if model == "":
        model = "dall-e-3"

    var apiKey: str = home.RustCsgGetEnv("OPENAI_API_KEY")
    var apiUrl: str = ""
    if apiKey == "":
        return rustCsgMcpResponse(id, "{\"content\":[{\"type\":\"text\",\"text\":\"image/generate: no API key configured (set OPENAI_API_KEY)\"}],\"isError\":true}")

    let result: str = RustCsgModelImageGenerate(model, prompt, apiKey, apiUrl)
    if strings.HasPrefix(result, "{\"error\""):
        let reason = wire.RustCsgJsonFindOptionalStr(result, "error")
        if reason == "":
            reason = "image generation API call failed"
        return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(reason), "}],\"isError\":true}"))

    return rustCsgMcpResponse(id, wire.RustCsgCat3("{\"content\":[{\"type\":\"text\",\"text\":", wire.RustCsgJsonQuote(result), "}],\"isError\":false}"))

fn rustCsgMcpHandleToolCall(id: int32, body: str): str =
    if !wire.RustCsgContains(body, "\"params\""):
        return rustCsgMcpError(id, -32602, "tools/call missing tool name")
    let paramsStart = wire.RustCsgJsonValueStart(body, "params")
    if paramsStart >= body.len || body[paramsStart] != '{':
        return rustCsgMcpError(id, -32602, "tools/call missing tool name")
    let params = wire.RustCsgJsonFindObject(body, "params")
    if !wire.RustCsgContains(params, "\"name\""):
        return rustCsgMcpError(id, -32602, "tools/call missing tool name")
    let nameStart = wire.RustCsgJsonValueStart(params, "name")
    if nameStart >= params.len || params[nameStart] != '"':
        return rustCsgMcpError(id, -32602, "tools/call missing tool name")
    let toolName = wire.RustCsgJsonFindStr(params, "name")
    let argsObj = wire.RustCsgJsonFindOptionalObject(params, "arguments")
    if toolName == "rust_csg_status":
        return rustCsgMcpResponse(id, rustCsgMcpStatusToolResult())
    if toolName == "rust_csg_capabilities":
        return rustCsgMcpResponse(id, rustCsgMcpCapabilitiesToolResult())
    if toolName == "rust_csg_package":
        return rustCsgMcpResponse(id, rustCsgMcpPackageToolResult())
    if toolName == "rust_csg_inventory":
        return rustCsgMcpResponse(id, rustCsgMcpInventoryToolResult())
    if toolName == "codex":
        return rustCsgMcpHandleCodex(id, argsObj)
    if toolName == "codex-reply":
        return rustCsgMcpHandleCodexReply(id, argsObj)
    if toolName == "exec_approval":
        return rustCsgMcpHandleExecApproval(id, argsObj)
    if toolName == "patch_approval":
        return rustCsgMcpHandlePatchApproval(id, argsObj)
    if toolName == "codex/health":
        return rustCsgMcpHandleCodexHealth(id, argsObj)
    if toolName == "completion/chat":
        return rustCsgMcpHandleCompletionChat(id, argsObj)
    if toolName == "embedding/create":
        return rustCsgMcpHandleEmbeddingCreate(id, argsObj)
    if toolName == "image/generate":
        return rustCsgMcpHandleImageGenerate(id, argsObj)
    return rustCsgMcpError(id, -32602, wire.RustCsgCat("unknown MCP tool: ", toolName))

fn rustCsgMcpHandleResourceRead(id: int32, body: str): str =
    if !wire.RustCsgContains(body, "\"params\""):
        return rustCsgMcpError(id, -32602, "resources/read missing resource uri")
    let paramsStart = wire.RustCsgJsonValueStart(body, "params")
    if paramsStart >= body.len || body[paramsStart] != '{':
        return rustCsgMcpError(id, -32602, "resources/read missing resource uri")
    let params = wire.RustCsgJsonFindObject(body, "params")
    if !wire.RustCsgContains(params, "\"uri\""):
        return rustCsgMcpError(id, -32602, "resources/read missing resource uri")
    let uriStart = wire.RustCsgJsonValueStart(params, "uri")
    if uriStart >= params.len || params[uriStart] != '"':
        return rustCsgMcpError(id, -32602, "resources/read missing resource uri")
    let uri = wire.RustCsgJsonFindStr(params, "uri")
    if uri == rustCsgMcpStatusResourceUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "text/plain", rustCsgMcpStatusResourceText()))
    if uri == rustCsgMcpCapabilitiesResourceUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "text/plain", rustCsgMcpCapabilitiesText()))
    if uri == rustCsgMcpPackageResourceUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpPackageText()))
    if uri == rustCsgMcpInventoryResourceUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpInventoryText()))
    if uri == rustCsgMcpCodexToolsCountUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpCodexToolsCountText()))
    if uri == rustCsgMcpCodexToolsNamesUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpCodexToolsNamesText()))
    if uri == rustCsgMcpCodexHealthUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpCodexHealthText()))
    if uri == rustCsgMcpCodexServerInfoUri():
        return rustCsgMcpResponse(id, rustCsgMcpResourceReadResult(uri, "application/json", rustCsgMcpCodexServerInfoText()))
    return rustCsgMcpError(id, -32602, wire.RustCsgCat("unknown MCP resource: ", uri))

fn rustCsgMcpHandle(body: str): str =
    let method = wire.RustCsgJsonFindStr(body, "method")
    if method == "notifications/initialized":
        return ""
    if method == "notifications/cancelled":
        return ""
    if method == "notifications/logging/setLevel":
        return ""
    if method == "initialize":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpResponse(id, rustCsgMcpInitializeResult())
    if method == "ping":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpResponse(id, "{}")
    if method == "tools/list":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpResponse(id, rustCsgMcpToolsListResult())
    if method == "tools/call":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpHandleToolCall(id, body)
    if method == "resources/list":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpResponse(id, rustCsgMcpResourcesListResult())
    if method == "resources/templates/list":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpResponse(id, rustCsgMcpResourceTemplatesListResult())
    if method == "resources/read":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpHandleResourceRead(id, body)
    if method == "elicitation/create":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        return rustCsgMcpHandleElicitationCreate(id, body)
    let id = wire.RustCsgJsonFindInt32(body, "id")
    return rustCsgMcpError(id, -32601, wire.RustCsgCat("Method not found: ", method))

fn rustCsgMcpHandleFrameOutput(body: str, pendingInput: var str): str =
    let method = wire.RustCsgJsonFindStr(body, "method")
    if method == "tools/call":
        let id = wire.RustCsgJsonFindInt32(body, "id")
        let codexFrames = rustCsgMcpHandleCodexToolCallFrames(id, body, pendingInput)
        if codexFrames != "":
            return codexFrames
    let response = rustCsgMcpHandle(body)
    if response.len == 0:
        return ""
    return rustCsgMcpBuildFrame(response)

fn rustCsgMcpRunStdio(): int32 =
    var buffer: str
    var sawFrame: bool
    var idle: int32
    while true:
        let frame = rustCsgMcpTryReadFrame(buffer)
        if frame.ok:
            sawFrame = true
            idle = 0
            buffer = frame.rest
            let responseFrames = rustCsgMcpHandleFrameOutput(frame.body, buffer)
            if responseFrames.len > 0:
                if !rustCsgMcpWriteAll(1, responseFrames):
                    return 78
            continue
        if !frame.blocked:
            return 78
        let event = process.ProcessReadFdBlockingEvent(0, 100)
        if event == "T":
            idle = idle + 1
            if !sawFrame && idle >= 2:
                return 78
        elif event == "F":
            if buffer.len == 0:
                return 0
            return 78
        elif event.len > 0 && event[0] == 'E':
            return 78
        elif event.len > 0 && event[0] == 'D':
            idle = 0
            let chunk = wire.RustCsgSliceBytes(event, 1, event.len - 1)
            buffer = wire.RustCsgCat(buffer, chunk)
        else:
            return 78

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    return rustCsgMcpRunStdio()
