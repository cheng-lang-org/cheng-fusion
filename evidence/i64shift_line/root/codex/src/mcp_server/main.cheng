    let t3 = "{\"name\":\"codex-inventory\",\"uriTemplate\":\"codex://inventory\",\"title\":\"Rust CSG Inventory\",\"description\":\"Current codex source inventory facts exposed by this MCP server.\",\"mimeType\":\"application/json\"}"
    let t4 = "{\"name\":\"codex-tools-count\",\"uriTemplate\":\"codex://tools/count\",\"title\":\"Codex Tools Count\",\"description\":\"Total number of tools available on this MCP server.\",\"mimeType\":\"application/json\"}"
