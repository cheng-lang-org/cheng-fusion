fn rustCsgMcpCodexToolResult(threadId: str, content: str, isError: bool): str =
    var out = "{\"content\":[{\"type\":\"text\",\"text\":"
    out = wire.RustCsgCat(out, wire.RustCsgJsonQuote(content))
    out = wire.RustCsgCat(out, "}]")
    if threadId != "":
        out = wire.RustCsgCat(out, ",\"structuredContent\":{")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("threadId", threadId))
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldStr("content", content))
        out = wire.RustCsgCat(out, "}")
    if isError:
        out = wire.RustCsgCat(out, ",")
        out = wire.RustCsgCat(out, wire.RustCsgJsonFieldBool("isError", true))
    out = wire.RustCsgCat(out, "}")
    return out

fn rustCsgMcpRuntimeErrorText(message: str): str =
    if wire.RustCsgStartsWith(message, "Codex runtime error: "):
        return message
    return wire.RustCsgCat("Codex runtime error: ", message)

fn rustCsgMcpJsonHasTopLevelKey(obj: str, key: str): bool =
    let pattern = wire.RustCsgCat3("\"", key, "\"")
    var depth: int32
    var inString: bool
    var escaped: bool
    var i: int32
    while i < obj.len:
        let ch = obj[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
            i = i + 1
            continue
        if ch == '"':
            if depth == 1 && wire.RustCsgMatchesAt(obj, i, pattern):
                let after = wire.RustCsgSkipJsonSpace(obj, i + pattern.len)
                if after < obj.len && obj[after] == ':':
                    return true
            inString = true
        elif ch == '{' || ch == '[':
            depth = depth + 1
        elif ch == '}' || ch == ']':
            depth = depth - 1
        i = i + 1
    return false

fn rustCsgMcpThreadIdFromToolParams(params: str): str =
    var threadId = wire.RustCsgJsonFindOptionalStr(params, "threadId")
    if threadId == "":
        threadId = wire.RustCsgJsonFindOptionalStr(params, "conversationId")
    return threadId

fn rustCsgMcpInitializeResult(): str =
    return "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{\"listChanged\":true}},\"serverInfo\":{\"name\":\"codex-mcp-server\",\"version\":\"0.1.0\",\"title\":\"Codex\"}}"

fn mkToolSchema(name: str, title: str, desc: str): str =
    var out = wire.RustCsgCat4("{\"name\":", wire.RustCsgJsonQuote(name), ",\"title\":", wire.RustCsgJsonQuote(title))
    out = wire.RustCsgCat3(out, ",\"description\":", wire.RustCsgJsonQuote(desc))
    return wire.RustCsgCat(out, ",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}")

fn rustCsgMcpToolsListResult(): str =
    let t0 = mkToolSchema("rust_csg_status", "Rust CSG Status", "Report the current codex MCP server status.")
    let t1 = mkToolSchema("rust_csg_capabilities", "Rust CSG Capabilities", "Report the MCP methods, tools, and resources currently implemented by codex.")
    let t2 = mkToolSchema("rust_csg_package", "Rust CSG Package", "Report the codex Cheng package identity exposed by this MCP server.")
    let t3 = mkToolSchema("rust_csg_inventory", "Rust CSG Inventory", "Report the current codex source inventory facts exposed by this MCP server.")
    let t4 = "{\"name\":\"codex\",\"title\":\"Codex\",\"description\":\"Run a Codex session. Accepts configuration parameters matching the Codex Config struct.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"approval-policy\":{\"description\":\"Approval policy for shell commands generated by the model: `untrusted`, `on-failure`, `on-request`, `never`.\",\"enum\":[\"untrusted\",\"on-failure\",\"on-request\",\"never\"],\"type\":\"string\"},\"base-instructions\":{\"description\":\"The set of instructions to use instead of the default ones.\",\"type\":\"string\"},\"compact-prompt\":{\"description\":\"Prompt used when compacting the conversation.\",\"type\":\"string\"},\"config\":{\"additionalProperties\":true,\"description\":\"Individual config settings that will override what is in CODEX_HOME/config.toml.\",\"type\":\"object\"},\"cwd\":{\"description\":\"Working directory for the session. If relative, it is resolved against the server process's current working directory.\",\"type\":\"string\"},\"developer-instructions\":{\"description\":\"Developer instructions that should be injected as a developer role message.\",\"type\":\"string\"},\"model\":{\"description\":\"Optional override for the model name (e.g. 'gpt-5.2', 'gpt-5.2-codex').\",\"type\":\"string\"},\"prompt\":{\"description\":\"The *initial user prompt* to start the Codex conversation.\",\"type\":\"string\"},\"sandbox\":{\"description\":\"Sandbox mode: `read-only`, `workspace-write`, or `danger-full-access`.\",\"enum\":[\"read-only\",\"workspace-write\",\"danger-full-access\"],\"type\":\"string\"}},\"required\":[\"prompt\"],\"type\":\"object\"},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"threadId\":{\"type\":\"string\"}},\"required\":[\"threadId\",\"content\"]}}"
    let t5 = "{\"name\":\"codex-reply\",\"title\":\"Codex Reply\",\"description\":\"Continue a Codex conversation by providing the thread id and prompt.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"conversationId\":{\"description\":\"DEPRECATED: use threadId instead.\",\"type\":\"string\"},\"prompt\":{\"description\":\"The *next user prompt* to continue the Codex conversation.\",\"type\":\"string\"},\"threadId\":{\"description\":\"The thread id for this Codex session. This field is required, but we keep it optional here for backward compatibility for clients that still use conversationId.\",\"type\":\"string\"}},\"required\":[\"prompt\"],\"type\":\"object\"},\"outputSchema\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"threadId\":{\"type\":\"string\"}},\"required\":[\"threadId\",\"content\"]}}"
    let t6 = "{\"name\":\"exec_approval\",\"title\":\"Exec Approval\",\"description\":\"Review and approve command execution.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"}},\"required\":[\"command\",\"cwd\"],\"additionalProperties\":false}}"
    let t7 = "{\"name\":\"patch_approval\",\"title\":\"Patch Approval\",\"description\":\"Review and approve file patch application.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"changes\":{\"type\":\"object\"}},\"required\":[\"changes\"],\"additionalProperties\":false}}"
    let t8 = mkToolSchema("codex/health", "Codex Health", "Check app-server health status.")
    let t11 = "{\"name\":\"completion/chat\",\"title\":\"Completion Chat\",\"description\":\"Send a chat completion request to the app-server.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}}}},\"model\":{\"type\":\"string\"}},\"required\":[\"messages\"],\"additionalProperties\":false}}"
    let t12 = "{\"name\":\"embedding/create\",\"title\":\"Embedding Create\",\"description\":\"Create an embedding vector for the given input text.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"input\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}},\"required\":[\"input\"],\"additionalProperties\":false}}"
    let t13 = "{\"name\":\"image/generate\",\"title\":\"Image Generate\",\"description\":\"Generate an image from a text prompt.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"}},\"required\":[\"prompt\"],\"additionalProperties\":false}}"
    let all = wire.RustCsgCat4(t0, ",", t1, ",")
    all = wire.RustCsgCat4(all, t2, ",", t3)
    all = wire.RustCsgCat4(all, ",", t4, ",")
    all = wire.RustCsgCat4(all, t5, ",", t6)
    all = wire.RustCsgCat(all, ",")
    all = wire.RustCsgCat(all, t7)
    all = wire.RustCsgCat(all, ",")
    all = wire.RustCsgCat(all, t8)
    all = wire.RustCsgCat(all, ",")
    all = wire.RustCsgCat(all, t11)
    all = wire.RustCsgCat(all, ",")
    all = wire.RustCsgCat(all, t12)
    all = wire.RustCsgCat(all, ",")
    all = wire.RustCsgCat(all, t13)
    return wire.RustCsgCat4("{\"tools\":[", all, "]}", "")

