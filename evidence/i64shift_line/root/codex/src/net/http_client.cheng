# HTTP client - wraps libcurl provider for exec use
# Provides HttpClientPost/HttpClientGet with API key support
import cheng/codex/std/http
import std/strings

type
    HttpClientResult =
        statusCode: int32
        body: str

fn HttpClientPost(url: str, bodyJson: str, apiKey: str): HttpClientResult =
    var headers: str = "[\"Content-Type: application/json\"]"
    if apiKey.len > 0:
        var auth: str = strings.ConcatStr("[\"Authorization: Bearer ", apiKey)
        headers = strings.ConcatStr(auth, "\",\"Content-Type: application/json\"]")
    var raw: http.HttpResult = http.HttpPost(url, bodyJson, headers)
    var result: HttpClientResult
    result.statusCode = raw.statusCode
    result.body = raw.body
    return result

fn HttpClientGet(url: str, apiKey: str): HttpClientResult =
    var headers: str = "[]"
    if apiKey.len > 0:
        var auth: str = strings.ConcatStr("[\"Authorization: Bearer ", apiKey)
        headers = strings.ConcatStr(auth, "\"]")
    var raw: http.HttpResult = http.HttpGet(url, headers)
    var result: HttpClientResult
    result.statusCode = raw.statusCode
    result.body = raw.body
    return result
