import cheng/core/lang/parser as parser

fn main(): int32 =
    let root = "/Users/lbcheng/cheng-lang"
    var externalRoots: parser.ParserExternalPackageRoot[]
    var suppliedEdges: parser.ImportEdge[]
    var canonicalRoots: parser.ParserExternalPackageRoot[]
    var closurePaths: str[]
    var identityPaths: str[]
    var ownerModulePaths: str[]
    var importEdges: parser.ImportEdge[]
    var entrySourceIndex: int32
    var err: str
    let entry = root + "/src/tests/result_intrinsic_probe.cheng"
    var seen: str[]
    var ordered: str[]
    var cEdges: parser.ImportEdge[]
    var cUnresolved: int32
    if !parser.ParserCollectClosureWithExternalPackageRoots(
            root, root, externalRoots, entry, seen, ordered, cEdges, cUnresolved, err):
        echo(Fmt"closure FAIL {err}")
        return 1
    echo(Fmt"closure_count={ordered.len}")
    return 0
