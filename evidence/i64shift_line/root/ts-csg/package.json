{
  "name": "@cheng-lang/ts-csg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ts-csg": "scripts/csg-generation-cli"
  },
  "scripts": {
    "prepack": "node scripts/reject-quarantined-frozen-dist.mjs",
    "prepublishOnly": "node scripts/reject-quarantined-frozen-dist.mjs",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json && node scripts/freeze-dist.mjs",
    "freeze:dist": "node scripts/freeze-dist.mjs",
    "verify:dist-frozen": "node scripts/freeze-dist.mjs --verify",
    "contract:freeze-dist": "node scripts/freeze-dist-contract.test.mjs",
    "extract": "scripts/csg-generation-cli",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:csg-js": "npm run build && node scripts/csg-js-smoke.mjs",
    "smoke:csg-core-conformance": "npm run build && node scripts/csg-core-conformance-smoke.mjs",
    "smoke:csg-facts-identity": "node scripts/csg-facts-identity-smoke.mjs",
    "gate:csg-relfacts-authority-absence": "../tools/csg_core_ts_relfacts_authority_absence_gate.sh && ../tools/csg_core_ts_relfacts_authority_absence_gate_contract_test",
    "smoke:csg-relfacts-conformance": "npm run build && ../tools/csg_core_ts_relfacts_authority_absence_gate.sh && node scripts/csg-relfacts-conformance-smoke.mjs",
    "smoke:csg-web": "npm run build && node scripts/csg-web-smoke.mjs",
    "smoke:csg-web-materializer": "npm run build && node scripts/csg-web-materializer-smoke.mjs",
    "smoke:cheng-web-run": "npm run build && node scripts/cheng-web-run-smoke.mjs",
    "smoke:cheng-web-oracle": "node ../tools/cheng-web-oracle-smoke.mjs",
    "smoke:cheng-web-oracle-driver": "node --experimental-strip-types ../tools/cheng-web-oracle-driver.ts --self-test",
    "smoke:web-projects": "npm run build && node scripts/csg-web-project-gate.mjs",
    "smoke:web-projects:local-extended": "npm run build && CSG_WEB_PROJECT_GATE_SET=local-extended node scripts/csg-web-project-gate.mjs",
    "smoke:pure-cheng-runtime": "node scripts/pure-cheng-runtime-scope.mjs",
    "smoke:js-runtime": "npm run build && node scripts/js-runtime-smoke.mjs",
    "smoke:js-event-loop": "npm run build && node scripts/js-event-loop-smoke.mjs",
    "smoke:js-promise": "npm run build && node scripts/js-promise-smoke.mjs",
    "smoke:js-runtime-core": "npm run smoke:pure-cheng-runtime && npm run smoke:js-runtime && npm run smoke:js-event-loop && npm run smoke:js-promise",
    "smoke:web-runtime-dom-event": "npm run build && node scripts/web-runtime-dom-event-smoke.mjs",
    "smoke:web-runtime-style": "npm run build && node scripts/web-runtime-style-smoke.mjs",
    "smoke:web-runtime-css-query": "npm run build && node scripts/web-runtime-css-query-smoke.mjs",
    "smoke:web-runtime-layout": "npm run build && node scripts/web-runtime-layout-smoke.mjs",
    "smoke:web-runtime-style-layout": "npm run build && node scripts/web-runtime-style-layout-smoke.mjs",
    "smoke:web-runtime-paint": "npm run build && node scripts/web-runtime-paint-smoke.mjs",
    "smoke:web-runtime-raster": "npm run build && node scripts/web-runtime-raster-smoke.mjs",
    "smoke:web-runtime-text": "npm run build && node scripts/web-runtime-text-smoke.mjs",
    "smoke:web-runtime-font": "npm run build && node scripts/web-runtime-font-smoke.mjs",
    "smoke:web-react-runtime": "npm run build && node scripts/web-react-runtime-smoke.mjs",
    "smoke:web-runtime-core": "npm run smoke:pure-cheng-runtime && npm run smoke:web-runtime-dom-event && npm run smoke:web-runtime-style && npm run smoke:web-runtime-layout && npm run smoke:web-runtime-style-layout && npm run smoke:web-runtime-paint && npm run smoke:web-runtime-raster && npm run smoke:web-runtime-text && npm run smoke:web-runtime-font && npm run smoke:web-react-runtime",
    "smoke:web-runtime": "node scripts/runtime-gate.mjs web",
    "live:observe": "node scripts/html-csg-live-observe.mjs",
    "live:gate": "node scripts/html-csg-live-parity-gate.mjs",
    "live:hotswap-gate": "node scripts/html-csg-live-hotswap-gate.mjs",
    "live:mirror": "node scripts/html-csg-live-hotswap.mjs",
    "live:semantic-hotswap-gate": "node scripts/html-csg-semantic-hotswap-gate.mjs",
    "probe:scene-paint-inline": "node scripts/scene-paint-inline-probe.mjs",
    "live:semantic-watch": "node scripts/csg-watch.mjs",
    "live:semantic-watch-gate": "node scripts/csg-watch-gate.mjs",
    "smoke:cursor": "npm run build && node scripts/project-gate.mjs",
    "smoke:projects": "npm run build && node scripts/project-gate.mjs",
    "deliver:cursor-unimaker": "npm run build && node scripts/cursor-unimaker-production-delivery.mjs",
    "smoke:cursor-unimaker-delivery": "npm run build && node scripts/cursor-unimaker-production-delivery.mjs --mode audit --out-dir tmp/cursor-unimaker-delivery-smoke",
    "unimaker-one-click": "npm run build && node scripts/unimaker-one-click.mjs",
    "unimaker-one-click:compile-only": "npm run build && node scripts/unimaker-one-click.mjs --no-run",
    "unimaker-retained-parity-gate": "npm run build && node scripts/unimaker-retained-parity-gate.mjs",
    "unimaker-functional-coverage-gate": "npm run build && node scripts/unimaker-functional-coverage-gate.mjs",
    "unimaker-apk-build": "npm run build && node scripts/unimaker-apk-build.mjs",
    "unimaker-android-playback-smoke": "node scripts/unimaker-android-playback-smoke.mjs",
    "unimaker-android-video-e2e-smoke": "node scripts/unimaker-android-video-e2e-smoke.mjs",
    "unimaker-android-capture": "npm run build && node scripts/unimaker-android-capture-run.mjs",
    "smoke:unimaker-one-click-output": "npm run build && node scripts/unimaker-one-click-output-smoke.mjs",
    "smoke:m-invoke-gap": "npm run build && node scripts/m-invoke-gap-smoke.mjs",
    "unimaker-gui-matrix": "npm run build && node scripts/unimaker-gui-matrix.mjs",
    "smoke:unimaker-gui-matrix": "npm run build && node scripts/unimaker-gui-matrix.mjs --manifest-only --out-dir tmp/unimaker-gui-matrix-smoke",
    "unimaker-pixel-oracle": "npm run build && node scripts/unimaker-pixel-oracle.mjs",
    "codex-gate": "npm run build && node scripts/codex-gate.mjs",
    "codex-gate:relaxed": "npm run build && node scripts/codex-gate.mjs --relaxed"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "sharp": "^0.34.5",
    "typescript": ">=5.4 <6"
  },
  "devDependencies": {
    "@types/node": ">=20 <25"
  },
  "engines": {
    "node": ">=20"
  }
}
