#!/bin/bash -p
set -euo pipefail

fail() {
  printf 'csg_generation_cli_error=%s\n' "$1" >&2
  exit 1
}

SOURCE_PATH="${BASH_SOURCE[0]}"
case "$SOURCE_PATH" in
  /*) ;;
  *) SOURCE_PATH="$(pwd -P)/$SOURCE_PATH" ;;
esac
SOURCE_PATH="$({ /usr/bin/python3 -I -S -B - "$SOURCE_PATH" <<'PY'
import os
import pathlib
import sys

raw = sys.argv[1]
if not os.path.isabs(raw) or "\n" in raw:
    raise SystemExit("launcher_source_path_invalid")
resolved = pathlib.Path(os.path.realpath(raw))
if not resolved.is_absolute() or pathlib.Path(os.path.abspath(resolved)) != resolved:
    raise SystemExit("launcher_source_path_not_canonical")
print(os.fspath(resolved))
PY
})" || fail "launcher_canonical_path_resolution_failed"
SCRIPT_DIRECTORY="$(cd -P "${SOURCE_PATH%/*}" && pwd -P)"
SELF="$SOURCE_PATH"
PACKAGE_ROOT="$(cd -P "$SCRIPT_DIRECTORY/.." && pwd -P)"
REPO_ROOT="$(cd -P "$PACKAGE_ROOT/.." && pwd -P)"
GATE="$REPO_ROOT/tools/csg_core_ts_source_freeze_provenance_gate.sh"

[ "$SELF" = "$PACKAGE_ROOT/scripts/csg-generation-cli" ] ||
  fail "launcher_path_invalid"
[ -f "$SELF" ] && [ ! -L "$SELF" ] || fail "launcher_identity_invalid"
[ -f "$GATE" ] && [ ! -L "$GATE" ] || fail "provenance_gate_identity_invalid"

exec 8<&0
exec 9<"$GATE" || fail "provenance_gate_open_failed"
exec /usr/bin/python3 -I -S -B - \
  "$SELF" "$PACKAGE_ROOT" "$REPO_ROOT" "$GATE" "$@" <<'PY'
import hashlib
import json
import os
import pathlib
import pwd
import stat
import sys


def fail(reason):
    print("csg_generation_cli_error=" + reason, file=sys.stderr, flush=True)
    raise SystemExit(1)


def identity(info):
    return (
        int(info.st_dev),
        int(info.st_ino),
        int(info.st_mode),
        int(info.st_nlink),
        int(info.st_uid),
        int(info.st_gid),
        int(info.st_size),
        int(info.st_mtime_ns),
        int(info.st_ctime_ns),
    )


def canonical_path(raw, label):
    path = pathlib.Path(raw)
    if not path.is_absolute() or pathlib.Path(os.path.abspath(raw)) != path:
        fail(label + "_not_absolute")
    if pathlib.Path(os.path.realpath(raw)) != path:
        fail(label + "_not_canonical")
    return path


def real_directory(path, label):
    try:
        info = os.stat(path, follow_symlinks=False)
    except OSError as error:
        fail(label + "_missing_or_unreadable:" + str(error.errno))
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(label + "_not_real_directory")
    return info


def stable_file(path, label, maximum):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(label + "_open_failed:" + str(error.errno))
    digest = hashlib.sha256()
    chunks = []
    total = 0
    try:
        before = os.fstat(descriptor)
        named_before = os.stat(path, follow_symlinks=False)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or identity(before) != identity(named_before)
        ):
            fail(label + "_identity_invalid")
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > maximum:
                fail(label + "_too_large")
            digest.update(chunk)
            chunks.append(chunk)
        after = os.fstat(descriptor)
        named_after = os.stat(path, follow_symlinks=False)
        if identity(before) != identity(after) or identity(after) != identity(named_after):
            fail(label + "_changed_during_read")
    finally:
        os.close(descriptor)
    return b"".join(chunks), after, digest.hexdigest()


def held_file(descriptor, path, label):
    before = os.fstat(descriptor)
    named = os.stat(path, follow_symlinks=False)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or identity(before) != identity(named)
    ):
        fail(label + "_identity_invalid")
    digest = hashlib.sha256()
    offset = 0
    while offset < before.st_size:
        chunk = os.pread(descriptor, min(1024 * 1024, before.st_size - offset), offset)
        if not chunk:
            fail(label + "_pread_truncated")
        digest.update(chunk)
        offset += len(chunk)
    after = os.fstat(descriptor)
    named_after = os.stat(path, follow_symlinks=False)
    if identity(before) != identity(after) or identity(after) != identity(named_after):
        fail(label + "_changed_during_read")
    return after, digest.hexdigest()


def canonical_json(raw, label):
    try:
        value = json.loads(raw.decode("utf-8", "strict"))
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(label + "_json_invalid:" + type(error).__name__)
    expected = (
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n"
    ).encode("utf-8")
    if raw != expected or not isinstance(value, dict):
        fail(label + "_not_canonical")
    return value


self_path = canonical_path(sys.argv[1], "launcher")
package_root = canonical_path(sys.argv[2], "package_root")
repo_root = canonical_path(sys.argv[3], "repo_root")
gate_path = canonical_path(sys.argv[4], "gate")
cli_arguments = sys.argv[5:]
if self_path != package_root / "scripts/csg-generation-cli":
    fail("launcher_location_invalid")
if package_root.parent != repo_root or gate_path != repo_root / "tools/csg_core_ts_source_freeze_provenance_gate.sh":
    fail("repository_layout_invalid")

account = pwd.getpwuid(os.geteuid())
home = canonical_path(account.pw_dir, "account_home")
home_info = real_directory(home, "account_home")
if home_info.st_uid != os.geteuid() or home_info.st_mode & 0o022:
    fail("account_home_identity_invalid")

store = canonical_path(package_root / ".csg-ts-source-freeze-generations", "generation_store")
objects = canonical_path(store / "objects", "generation_objects")
object_identities = {}
for path, label in ((store, "generation_store"), (objects, "generation_objects")):
    info = real_directory(path, label)
    if info.st_uid != os.geteuid() or info.st_mode & 0o077:
        fail(label + "_identity_invalid")
    object_identities[label] = identity(info)

pointer_path = store / "current"
pointer_raw, pointer_info, pointer_sha256 = stable_file(pointer_path, "current_pointer", 4096)
if pointer_info.st_uid != os.geteuid() or pointer_info.st_mode & 0o777 != 0o400:
    fail("current_pointer_not_sealed")
pointer = canonical_json(pointer_raw, "current_pointer")
if list(pointer) != ["generation_cid", "schema"] or pointer.get("schema") != "csg_core_ts_source_freeze_provenance.current_pointer":
    fail("current_pointer_fields_invalid")
generation_cid = pointer.get("generation_cid", "")
if not isinstance(generation_cid, str) or len(generation_cid) != 64 or any(character not in "0123456789abcdef" for character in generation_cid):
    fail("current_generation_cid_invalid")

generation_root = canonical_path(objects / generation_cid, "generation_root")
generation_info = real_directory(generation_root, "generation_root")
if (
    generation_info.st_uid != os.geteuid()
    or generation_info.st_mode & 0o777 != 0o500
):
    fail("generation_root_not_sealed")
manifest_path = generation_root / "generation-manifest.json"
manifest_raw, manifest_info, manifest_sha256 = stable_file(
    manifest_path, "generation_manifest", 16 * 1024 * 1024
)
if manifest_sha256 != generation_cid or manifest_info.st_uid != os.geteuid() or manifest_info.st_mode & 0o777 != 0o400:
    fail("generation_manifest_identity_invalid")
manifest = canonical_json(manifest_raw, "generation_manifest")
if manifest.get("schema") != "csg_core_ts_source_freeze_provenance.generation" or manifest.get("legacy_directories_authority") != "none":
    fail("generation_manifest_schema_invalid")
inputs = manifest.get("inputs")
toolchain = inputs.get("toolchain") if isinstance(inputs, dict) else None
if not isinstance(toolchain, dict):
    fail("generation_toolchain_binding_missing")

gate_info, gate_sha256 = held_file(9, gate_path, "held_gate")
launcher_raw, launcher_info, launcher_sha256 = stable_file(
    self_path, "launcher", 1024 * 1024
)
_ = (launcher_raw, launcher_info)
if gate_sha256 != toolchain.get("gate_sha256"):
    fail("held_gate_generation_binding_mismatch")
if launcher_sha256 != toolchain.get("generation_cli_sha256"):
    fail("launcher_generation_binding_mismatch")

pointer_raw_after, pointer_info_after, pointer_sha256_after = stable_file(
    pointer_path, "current_pointer_after", 4096
)
manifest_raw_after, manifest_info_after, manifest_sha256_after = stable_file(
    manifest_path, "generation_manifest_after", 16 * 1024 * 1024
)
if (
    pointer_raw_after != pointer_raw
    or identity(pointer_info_after) != identity(pointer_info)
    or pointer_sha256_after != pointer_sha256
    or manifest_raw_after != manifest_raw
    or identity(manifest_info_after) != identity(manifest_info)
    or manifest_sha256_after != manifest_sha256
    or identity(os.stat(store, follow_symlinks=False)) != object_identities["generation_store"]
    or identity(os.stat(objects, follow_symlinks=False)) != object_identities["generation_objects"]
    or identity(os.stat(generation_root, follow_symlinks=False)) != identity(generation_info)
):
    fail("activation_identity_fence_changed")

os.set_inheritable(9, True)
os.dup2(8, 0)
os.close(8)
environment = {
    "HOME": os.fspath(home),
    "LANG": "C",
    "LC_ALL": "C",
    "PATH": "/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONHASHSEED": "0",
    "TZ": "UTC",
    "CSG_TS_ACTIVATION_GENERATION_CID": generation_cid,
    "CSG_TS_ACTIVATION_GENERATION_ROOT_IDENTITY": ":".join(
        str(value) for value in identity(generation_info)
    ),
    "CSG_TS_ACTIVATION_MANIFEST_IDENTITY": ":".join(
        str(value) for value in identity(manifest_info)
    ),
    "CSG_TS_ACTIVATION_MANIFEST_SHA256": manifest_sha256,
    "CSG_TS_ACTIVATION_OBJECTS_IDENTITY": ":".join(
        str(value) for value in object_identities["generation_objects"]
    ),
    "CSG_TS_ACTIVATION_POINTER_IDENTITY": ":".join(
        str(value) for value in identity(pointer_info)
    ),
    "CSG_TS_ACTIVATION_POINTER_SHA256": pointer_sha256,
    "CSG_TS_ACTIVATION_STORE_IDENTITY": ":".join(
        str(value) for value in object_identities["generation_store"]
    ),
    "CSG_TS_GATE_HELD_FD": "9",
    "CSG_TS_GATE_HELD_IDENTITY": ":".join(str(value) for value in identity(gate_info)),
    "CSG_TS_GATE_HELD_SHA256": gate_sha256,
    "CSG_TS_GATE_NAMED_PATH": os.fspath(gate_path),
    "CSG_TS_LAUNCHER_EXEC_IDENTITY": "HARD_RED:no_external_launcher_anchor",
    "CSG_TS_LAUNCHER_SHA256": launcher_sha256,
}
os.execve(
    "/bin/bash",
    [
        "/bin/bash",
        "-p",
        "/dev/fd/9",
        "--held-generation-gate",
        "--exec-current-cli",
        "--",
        *cli_arguments,
    ],
    environment,
)
PY
