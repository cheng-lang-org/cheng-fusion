fn __csg_rows_digit(ch: char): int32 =
    return Int32(ch) - 48

@borrows
fn __csg_rows_span_int(row: str, pos: int32, stopChar: char): int32 =
    var n: int32
    var i: int32
    i = pos
    while i < row.len && row[i] != stopChar:
        n = n + 1
        i = i + 1
    return n

@borrows
fn __csg_rows_val_int(row: str, pos: int32, countDigits: int32): int32 =
    var value: int32
    var i: int32
    i = pos
    let stop = pos + countDigits
    while i < stop:
        value = value * 10 + __csg_rows_digit(row[i])
        i = i + 1
    return value

@borrows
fn __csg_rows_val_i64(row: str, pos: int32, countDigits: int32): int64 =
    var value: int64
    var i: int32
    i = pos
    let stop = pos + countDigits
    while i < stop:
        value = value * 10 + Int64(__csg_rows_digit(row[i]))
        i = i + 1
    return value

fn __csg_precompute_load_row_tables(graph: var scene.WebSceneGraph, inputsDir: str): int32 =
    var rowsN: str = os.ReadFile(inputsDir + "/rows-nodes.bin")
    var cursor: int32
    while cursor < rowsN.len:
        let rowHead = __csg_rows_span_int(rowsN, cursor, Char(58))
        var p: int32
        p = cursor + rowHead + 1
        let riLen = __csg_rows_span_int(rowsN, p, Char(44))
        let ri = __csg_rows_val_int(rowsN, p, riLen)
        p = p + riLen + 1
        let niLen = __csg_rows_span_int(rowsN, p, Char(44))
        let ni = __csg_rows_val_int(rowsN, p, niLen)
        p = p + niLen + 1
        let piLen = __csg_rows_span_int(rowsN, p, Char(44))
        let pi = __csg_rows_val_int(rowsN, p, piLen)
        p = p + piLen + 1
        let kiLen = __csg_rows_span_int(rowsN, p, Char(44))
        let ki = __csg_rows_val_int(rowsN, p, kiLen)
        p = p + kiLen + 1
        let tagHead = __csg_rows_span_int(rowsN, p, Char(58))
        let tag = strings.SliceBytes(rowsN, p + tagHead + 1, __csg_rows_val_int(rowsN, p, tagHead))
        p = p + tagHead + 1 + __csg_rows_val_int(rowsN, p, tagHead)
        let txHead = __csg_rows_span_int(rowsN, p, Char(58))
        let tx = strings.SliceBytes(rowsN, p + txHead + 1, __csg_rows_val_int(rowsN, p, txHead))
        p = p + txHead + 1 + __csg_rows_val_int(rowsN, p, txHead)
        let lyLen = __csg_rows_span_int(rowsN, p, Char(44))
        let ly = __csg_rows_val_int(rowsN, p, lyLen)
        p = p + lyLen + 1
        let c1Head = __csg_rows_span_int(rowsN, p, Char(58))
        let c1 = strings.SliceBytes(rowsN, p + c1Head + 1, __csg_rows_val_int(rowsN, p, c1Head))
        p = p + c1Head + 1 + __csg_rows_val_int(rowsN, p, c1Head)
        let c2Head = __csg_rows_span_int(rowsN, p, Char(58))
        let c2 = strings.SliceBytes(rowsN, p + c2Head + 1, __csg_rows_val_int(rowsN, p, c2Head))
        p = p + c2Head + 1 + __csg_rows_val_int(rowsN, p, c2Head)
        let c3Head = __csg_rows_span_int(rowsN, p, Char(58))
        let c3 = strings.SliceBytes(rowsN, p + c3Head + 1, __csg_rows_val_int(rowsN, p, c3Head))
        p = p + c3Head + 1 + __csg_rows_val_int(rowsN, p, c3Head)
        let rowEnd = p
        let st = scene.WebSceneAddNodeWithStateBindingsStatus(graph, ri, ni, pi, ki, tag, tx, ly, c1, c2, c3)
        if st != 0:
            return 900000 + st
        cursor = rowEnd
    var rowsL: str = os.ReadFile(inputsDir + "/rows-layouts.bin")
    var cursor: int32
    while cursor < rowsL.len:
        let rowHead = __csg_rows_span_int(rowsL, cursor, Char(58))
        var p: int32
        p = cursor + rowHead + 1
        let laLen = __csg_rows_span_int(rowsL, p, Char(44))
        let la = __csg_rows_val_int(rowsL, p, laLen)
        p = p + laLen + 1
        let lbLen = __csg_rows_span_int(rowsL, p, Char(44))
        let lb = __csg_rows_val_int(rowsL, p, lbLen)
        p = p + lbLen + 1
        let lcLen = __csg_rows_span_int(rowsL, p, Char(44))
        let lc = __csg_rows_val_int(rowsL, p, lcLen)
        p = p + lcLen + 1
        let keyHead = __csg_rows_span_int(rowsL, p, Char(58))
        let key = strings.SliceBytes(rowsL, p + keyHead + 1, __csg_rows_val_int(rowsL, p, keyHead))
        p = p + keyHead + 1 + __csg_rows_val_int(rowsL, p, keyHead)
        let lvalHead = __csg_rows_span_int(rowsL, p, Char(58))
        let lval = strings.SliceBytes(rowsL, p + lvalHead + 1, __csg_rows_val_int(rowsL, p, lvalHead))
        p = p + lvalHead + 1 + __csg_rows_val_int(rowsL, p, lvalHead)
        let rowEnd = p
        if !scene.WebSceneAddLayoutConstraintKnownLoadedNode(graph, la, lb, lc, key, lval):
            return 910000
        cursor = rowEnd
    var rowsP: str = os.ReadFile(inputsDir + "/rows-paints.bin")
    var cursor: int32
    while cursor < rowsP.len:
        let rowHead = __csg_rows_span_int(rowsP, cursor, Char(58))
        var p: int32
        p = cursor + rowHead + 1
        let p1Len = __csg_rows_span_int(rowsP, p, Char(44))
        let p1 = __csg_rows_val_int(rowsP, p, p1Len)
        p = p + p1Len + 1
        let p2Len = __csg_rows_span_int(rowsP, p, Char(44))
        let p2 = __csg_rows_val_int(rowsP, p, p2Len)
        p = p + p2Len + 1
        let p3Len = __csg_rows_span_int(rowsP, p, Char(44))
        let p3 = __csg_rows_val_int(rowsP, p, p3Len)
        p = p + p3Len + 1
        let p4Len = __csg_rows_span_int(rowsP, p, Char(44))
        let p4 = __csg_rows_val_int(rowsP, p, p4Len)
        p = p + p4Len + 1
        let p5Len = __csg_rows_span_int(rowsP, p, Char(44))
        let p5 = __csg_rows_val_int(rowsP, p, p5Len)
        p = p + p5Len + 1
        let kindFlagLen = __csg_rows_span_int(rowsP, p, Char(44))
        let kindFlag = __csg_rows_val_int(rowsP, p, kindFlagLen)
        p = p + kindFlagLen + 1
        let hRawLen = __csg_rows_span_int(rowsP, p, Char(44))
        let hRawVal = __csg_rows_val_i64(rowsP, p, hRawLen)
        p = p + hRawLen + 1
        let q1Len = __csg_rows_span_int(rowsP, p, Char(44))
        let q1 = __csg_rows_val_int(rowsP, p, q1Len)
        p = p + q1Len + 1
        let q2Len = __csg_rows_span_int(rowsP, p, Char(44))
        let q2 = __csg_rows_val_int(rowsP, p, q2Len)
        p = p + q2Len + 1
        let q3Len = __csg_rows_span_int(rowsP, p, Char(44))
        let q3 = __csg_rows_val_int(rowsP, p, q3Len)
        p = p + q3Len + 1
        let ps1Head = __csg_rows_span_int(rowsP, p, Char(58))
        let ps1 = strings.SliceBytes(rowsP, p + ps1Head + 1, __csg_rows_val_int(rowsP, p, ps1Head))
        p = p + ps1Head + 1 + __csg_rows_val_int(rowsP, p, ps1Head)
        let ps2Head = __csg_rows_span_int(rowsP, p, Char(58))
        let ps2 = strings.SliceBytes(rowsP, p + ps2Head + 1, __csg_rows_val_int(rowsP, p, ps2Head))
        p = p + ps2Head + 1 + __csg_rows_val_int(rowsP, p, ps2Head)
        let rowEnd = p
        if kindFlag == 1:
            if !scene.WebSceneAddPaintOpAt(graph, p1, p2, p3, p4, p5, scene.WebScenePaintPlaceholderText,
                    Int64(hRawVal), q1, q2, q3, ps1, ps2):
                return 920001
        if kindFlag != 1:
            if !scene.WebSceneAddPaintOpAt(graph, p1, p2, p3, p4, p5, scene.WebScenePaintText,
                    Int64(hRawVal), q1, q2, q3, ps1, ps2):
                return 920000
        cursor = rowEnd
    return 0
