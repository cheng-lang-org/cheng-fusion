
// ===== Semantic manifest export block (per-node/per-prop/per-edge diff) =====
@exportc("cheng_app_debug_semantic_route_count")
fn chengAppDebugSemanticRouteCount(): int32 =
    return __csgSceneGraph.routes.len

@exportc("cheng_app_debug_semantic_route_id_at")
fn chengAppDebugSemanticRouteIdAt(index: int32): cstring =
    if index < 0 || index >= __csgSceneGraph.routes.len:
        return strToCStringTemp("")
    return strToCStringTemp(__csgSceneGraph.routes[index].routeId)

