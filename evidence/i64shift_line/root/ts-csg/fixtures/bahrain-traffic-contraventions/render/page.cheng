    var parityPass: int32
    var parityFail: int32
    var pfMiss: int32
    var pfX: int32
    var pfW: int32
    var sumDx: int32
    var sumDy: int32
    var sumDw: int32
    var sumDh: int32
    var pi: int32
    while pi < keys.len:
        let pk = keys[pi]
        if pk >= 0 && pk < runtime.elementNodeIds.len:
            let pNode = runtime.elementNodeIds[pk]
            let ex = rects[pi * 4 + 0]
            let ey = rects[pi * 4 + 1]
            let ew = rects[pi * 4 + 2]
            let eh = rects[pi * 4 + 3]
            var found: bool = false
            var badFlagX: bool = false
            var badFlagW: bool = false
            var fdx: int32
            var fdy: int32
            var fdw: int32
            var wLim: int32 = ew / int32(50)
            if wLim < int32(2):
                wLim = int32(2)
            var bi: int32
            while bi < tree.boxes.len:
                let b = tree.boxes[bi]
                if b.nodeId == pNode && b.width > int32(0) && !found:
                    found = true
                    if b.x - ex > wLim:
                        badFlagX = true
                    if ex - b.x > wLim:
                        badFlagX = true
                    if b.width - ew > wLim:
                        badFlagW = true
                    if ew - b.width > wLim:
                        badFlagW = true
                    sumDx = sumDx + (b.x - ex)
                    sumDy = sumDy + (b.y - ey)
                    sumDw = sumDw + (b.width - ew)
                    sumDh = sumDh + (b.height - eh)
                    fdx = b.x - ex
                    fdy = b.y - ey
                    fdw = b.width - ew
                bi = bi + 1
            var countAsPass: bool = found && !badFlagX && !badFlagW
            if !found:
                if ew == 0:
                    countAsPass = true
            if countAsPass:
                parityPass = parityPass + 1
            if !countAsPass:
                var eFlag: int32 = 0
                if !found:
                    pfMiss = pfMiss + 1
                    eFlag = 1
                if badFlagX:
                    pfX = pfX + 1
                    eFlag = eFlag + 2
                if badFlagW:
                    pfW = pfW + 1
                    eFlag = eFlag + 4
                echo(Fmt"PFF k={pk} n={pNode} ew={ew} eh={eh} fx={fdx} fy={fdy} fw={fdw} m={eFlag}")
                parityFail = parityFail + 1
        pi = pi + 1
    echo(Fmt"PARITY total={keys.len} pass={parityPass} fail={parityFail}")
    echo(Fmt"PF miss={pfMiss} x={pfX} w={pfW} dx={sumDx} dy={sumDy} dw={sumDw} dh={sumDh}")
    var twStats: int32 = bridge.WebStyleBridgeDebugTwStats()
    echo(Fmt"TWSTATS stats={twStats}")
fn __csg_hit_test(tree: var layout.WebLayoutTree, px: int32, py: int32): int32 =
    var best: int32 = 0
    var bestZ: int32 = -2147483647
    var bestArea: int32 = 2147483647
    var hi: int32
    while hi < tree.boxes.len:
        let hb = tree.boxes[hi]
        if hb.width > int32(0) && hb.height > int32(0) && hb.visible && hb.opacity > int32(0):
            if px >= hb.x && px < hb.x + hb.width && py >= hb.y && py < hb.y + hb.height:
                let area = hb.width * hb.height
                if best == int32(0) || hb.zIndex > bestZ || (hb.zIndex == bestZ && area <= bestArea):
                    best = hb.nodeId
                    bestZ = hb.zIndex
                    bestArea = area
        hi = hi + 1
    return best
var __csgWindow: web.WebWindow
fn __csg_default_click(document: var web.WebDocument, target: int32): bool =
    var href: str
    if web.WebDocumentGetAttribute(document, target, "href", href):
        return web.WebWindowLocationSetHref(__csgWindow, href)
    var tname: str
    if !web.WebDocumentNodeName(document, target, tname):
        return false
    if tname == "input" || tname == "select" || tname == "textarea" || tname == "button":
        return web.WebDocumentFocus(document, target)
    return false
fn __csg_event_self_check(document: var web.WebDocument, tree: var layout.WebLayoutTree, runtime: var react.ReactRuntime) =
    var twAttrCount: int32 = bridge.WebStyleLayoutBridgeDebugTwAttrCount(document)
    echo(Fmt"TWATTRS count={twAttrCount}")
    var twProbe: int32 = bridge.WebStyleLayoutBridgeDebugTwProbe()
    echo(Fmt"TWPROBE {twProbe}")
    web.WebWindowInit(__csgWindow)
    var total: int32
    var hitOk: int32
    var dispatchedTotal: int32
    var actOk: int32
    var evKeys_change: int32[]
    add(evKeys_change, 245)
    var registered_change: int32
    var boxed_change: int32
    var hitOk_change: int32
    var dispatched_change: int32
    var ei_change: int32
    while ei_change < evKeys_change.len:
        let ek = evKeys_change[ei_change]
        if ek >= 0 && ek < runtime.elementNodeIds.len:
            let eNode = runtime.elementNodeIds[ek]
            web.WebDocumentAddEventListener(document, eNode, "change", 1, false, false)
            registered_change = registered_change + 1
            dispatched_change = dispatched_change + web.WebDocumentDispatchEvent(document, eNode, "change")
            var eFound: bool = false
            var bx: int32 = 0
            var by: int32 = 0
            var bw2: int32 = 0
            var bh2: int32 = 0
            var ej: int32
            while ej < tree.boxes.len:
                let eb = tree.boxes[ej]
                if eb.nodeId == eNode && eb.width > int32(0) && !eFound:
                    eFound = true
                    bx = eb.x
                    by = eb.y
                    bw2 = eb.width
                    bh2 = eb.height
                ej = ej + 1
            if eFound:
                boxed_change = boxed_change + 1
                let cxp = bx + bw2 / int32(2)
                let cyp = by + bh2 / int32(2)
                let hitId = __csg_hit_test(tree, cxp, cyp)
                var ok: bool = hitId == eNode
                var walker: int32 = hitId
                while walker != int32(0):
                    if walker == eNode:
                        ok = true
                    walker = web.WebDocumentParentOf(document, walker)
                if !ok:
                    var up: int32 = eNode
                    while up != int32(0):
                        if up == hitId:
                            ok = true
                        up = web.WebDocumentParentOf(document, up)
                if ok:
                    hitOk_change = hitOk_change + 1
        ei_change = ei_change + 1
    total = total + registered_change
    hitOk = hitOk + hitOk_change
    dispatchedTotal = dispatchedTotal + dispatched_change
    echo(Fmt"EVENTTYPE type=change registered={registered_change} dispatched={dispatched_change} boxed={boxed_change} hitok={hitOk_change}")
    var evKeys_click: int32[]
    add(evKeys_click, 216)
    add(evKeys_click, 258)
    add(evKeys_click, 259)
    add(evKeys_click, 345)
    add(evKeys_click, 356)
    add(evKeys_click, 357)
