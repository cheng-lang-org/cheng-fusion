    while ei_click < evKeys_click.len:
        let ek = evKeys_click[ei_click]
        if ek >= 0 && ek < runtime.elementNodeIds.len:
            let eNode = runtime.elementNodeIds[ek]
            web.WebDocumentAddEventListener(document, eNode, "click", 1, false, false)
            registered_click = registered_click + 1
            dispatched_click = dispatched_click + web.WebDocumentDispatchEvent(document, eNode, "click")
            var eFound: bool = false
            var bx: int32 = 0
            var by: int32 = 0
            var bw2: int32 = 0
            var bh2: int32 = 0
            var ej: int32
            while ej < tree.boxes.len:
                let eb = tree.boxes[ej]
                if eb.nodeId == eNode && eb.width > int32(0) && !eFound:
                    eFound = true
                    bx = eb.x
