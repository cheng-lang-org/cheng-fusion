                    bw2 = eb.width
                    bh2 = eb.height
                ej = ej + 1
            if eFound:
                boxed_click = boxed_click + 1
                let cxp = bx + bw2 / int32(2)
                let cyp = by + bh2 / int32(2)
                let hitId = __csg_hit_test(tree, cxp, cyp)
                var ok: bool = hitId == eNode
                var walker: int32 = hitId
                while walker != int32(0):
                    if walker == eNode:
                        ok = true
                    walker = web.WebDocumentParentOf(document, walker)
                if !ok:
                    var up: int32 = eNode
                    while up != int32(0):
                        if up == hitId:
                            ok = true
                        up = web.WebDocumentParentOf(document, up)
