fn __csg_hit_test(tree: var layout.WebLayoutTree, px: int32, py: int32): int32 =
    var best: int32 = 0
    var bestZ: int32 = -2147483647
    var bestArea: int32 = 2147483647
    var hi: int32
    while hi < tree.boxes.len:
        let hb = tree.boxes[hi]
        if hb.width > int32(0) && hb.height > int32(0) && hb.visible && hb.opacity > int32(0):
            if px >= hb.x && px < hb.x + hb.width && py >= hb.y && py < hb.y + hb.height:
                let area = hb.width * hb.height
                if best == int32(0) || hb.zIndex > bestZ || (hb.zIndex == bestZ && area <= bestArea):
                    best = hb.nodeId
                    bestZ = hb.zIndex
                    bestArea = area
        hi = hi + 1
    return best
