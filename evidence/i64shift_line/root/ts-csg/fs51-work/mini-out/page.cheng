                        badFlagX = true
                    if ex - b.x > wLim:
                        badFlagX = true
                    if b.width - ew > wLim:
                        badFlagW = true
                    if ew - b.width > wLim:
                        badFlagW = true
                    sumDx = sumDx + (b.x - ex)
                    sumDy = sumDy + (b.y - ey)
                    sumDw = sumDw + (b.width - ew)
                    sumDh = sumDh + (b.height - eh)
                    fdx = b.x - ex
                    fdy = b.y - ey
                    fdw = b.width - ew
