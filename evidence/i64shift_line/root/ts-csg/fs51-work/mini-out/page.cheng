        let pk = keys[pi]
        if pk >= 0 && pk < runtime.elementNodeIds.len:
            let pNode = runtime.elementNodeIds[pk]
            let ex = rects[pi * 4 + 0]
            let ey = rects[pi * 4 + 1]
            let ew = rects[pi * 4 + 2]
            let eh = rects[pi * 4 + 3]
            var found: bool = false
            var badFlagX: bool = false
            var badFlagW: bool = false
            var fdx: int32
            var fdy: int32
            var fdw: int32
