fn __csg_dump_layout(document: var web.WebDocument, containerNodeId: int32, outTree: var layout.WebLayoutTree) =
    layout.WebLayoutTreeInit(outTree)
    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    if document.styleSheetCss.len > 0:
        if !style.WebStyleSheetParse(document.styleSheetCss, sheet):
            echo("warning: failed to parse document CSS into stylesheet")
    if containerNodeId != 0:
        if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, containerNodeId, outTree):
            echo(Fmt"layout bridge failed for node {containerNodeId}")
        layout.WebLayoutSetRootViewport(outTree, containerNodeId, 1110, 1209)
        if !layout.WebLayoutCompute(outTree, containerNodeId):
            echo(Fmt"layout compute failed for node {containerNodeId}")
    echo("---CHENG_LAYOUT_DUMP---")
    layout.WebLayoutDumpBoxes(outTree)

fn __csg_parity_self_check(tree: var layout.WebLayoutTree, runtime: var react.ReactRuntime) =
    var keys: int32[]
