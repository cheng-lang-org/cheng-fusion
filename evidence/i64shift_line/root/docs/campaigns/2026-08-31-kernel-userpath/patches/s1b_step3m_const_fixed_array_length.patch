+# The lexer admits `0x`/`0b`/`0o` integer tokens and `_` separators
+# (parser.cheng:14936), which the const grammar's decimal-only literal branch
+# does not read.  A module const's declared value is resolved here, so the table
+# accepts the lexer's own literal set; the bracket-length path itself is
+# unchanged.
+fn parserTypeSyntaxModuleConstRadixValueInto(
+        text: str,
+        valueOut: var int32): bool =
+    valueOut = 0
+    if text.len <= 0:
+        return false
+    var radix: int64 = Int64(10)
+    var cursor = 0
+    if text.len > 2 && text[0] == '0':
+        if text[1] == 'x' || text[1] == 'X':
+            radix = Int64(16)
+            cursor = 2
+        elif text[1] == 'b' || text[1] == 'B':
+            radix = Int64(2)
+            cursor = 2
+        elif text[1] == 'o' || text[1] == 'O':
+            radix = Int64(8)
+            cursor = 2
+    if cursor >= text.len:
+        return false
+    var value: int64
+    while cursor < text.len:
+        let ch = text[cursor]
+        if ch == '_':
+            cursor = cursor + 1
+            continue
+        var digit: int64 = Int64(-1)
+        if ch >= '0' && ch <= '9':
+            digit = Int64(Int32(ch) - Int32('0'))
+        elif ch >= 'a' && ch <= 'f':
+            digit = Int64(Int32(ch) - Int32('a')) + Int64(10)
+        elif ch >= 'A' && ch <= 'F':
+            digit = Int64(Int32(ch) - Int32('A')) + Int64(10)
+        if digit < 0 || digit >= radix:
+            return false
+        value = value * radix + digit
+        if value > Int64(2147483647):
+            return false
+        cursor = cursor + 1
+    valueOut = int32(value)
+    return true
