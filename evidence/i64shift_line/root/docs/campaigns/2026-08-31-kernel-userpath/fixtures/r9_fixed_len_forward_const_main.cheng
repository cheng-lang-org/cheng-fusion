# [S1b step-3 ① acceptance, FORWARD-REFERENCE fixture]
#
# docs/cheng-formal-spec.md:555 requires only that the N in `T[N]` be a
# compile-time constant; it never requires N to be declared first.  Real legal
# uses exist in this repository (src/std/net/stream/connection.cheng:36 and
# src/quic/connection.cheng:52 both write `Connection[connectionQueueCapacity]`
# inside a `type` block that precedes the `const` block declaring the name).
#
# The port therefore builds its module const table from the lexed token stream
# BEFORE any type syntax is produced (the C chain's symbols table is likewise
# complete before it parses a type), so a use above the declaration resolves
# exactly like a use below it.
#
# Expected after the port: compile rc=0 and run rc=0.
type
    Slots =
        used: int32
        values: int32[LateCount]

const
    LateCount: int32 = 5

fn main(): int32 =
    var s: Slots
    s.values[0] = 2
    s.values[LateCount - 1] = 5
    s.used = s.values[0] + s.values[LateCount - 1]
    if s.used != 7:
        return 2
    return 0
