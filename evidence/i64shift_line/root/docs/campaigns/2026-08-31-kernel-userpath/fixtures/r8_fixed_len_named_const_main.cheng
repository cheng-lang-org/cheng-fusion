# [S1b step-3 ① acceptance] `T[NAMED_CONST]` fixed-array length.
#
# Spec basis: docs/cheng-formal-spec.md:555 — `T[N]` 的 N 是编译期常量
# (not "integer literal").  C chain reference: bootstrap/cheng_cold.c:30171-30183
# (`symbols_find_const`).  Cheng chain today only accepts integer literals
# (parser.cheng:17909-17929) => the bracket argument is classified as a type
# argument (parser.cheng:18541-18556) and the compile dies with
# "nominal declaration is not visible provider_source=0 name=<the const>".
#
# Deliberately avoids `.len` on the fixed array so the signal is about the
# LENGTH CLASSIFICATION only: writing index 0 and index SlotCount-1 (3) is legal
# iff the declared length really is the const's value (4).
#
# Expected after the port: compile rc=0 and run rc=0.
const
    SlotCount: int32 = 4

type
    Slots =
        used: int32
        values: int32[SlotCount]

fn main(): int32 =
    var s: Slots
    s.values[0] = 7
    s.values[SlotCount - 1] = 9
    s.used = s.values[0] + s.values[SlotCount - 1]
    if s.used != 16:
        return 2
    return 0
