# [S1b step-3 ① acceptance, UNTYPED-CONST fixture]
#
# Module `const` blocks may omit the type annotation (`maxPipes = 128` in
# src/std/net/stream/connection.cheng:43, `connectionQueueCapacity = 64` on the
# next line).  The const table infers int32 from the initializer in that case
# and records the resolved value, so an untyped const is a legal `T[N]` length
# exactly like a typed one.
#
# Expected after the port: compile rc=0 and run rc=0.
const
    UntypedCount = 6

type
    Slots =
        used: int32
        values: int32[UntypedCount]

fn main(): int32 =
    var s: Slots
    s.values[0] = 1
    s.values[UntypedCount - 1] = 6
    s.used = s.values[0] + s.values[UntypedCount - 1]
    if s.used != 7:
        return 2
    return 0
