# SEQ-FIELDGET collateral probe: builtin .len on str and int32[] standalone
fn main(): int32 =
  let s: str = "abcd"
  var total: int32
  total = s.len
  let xs: int32[] = [1, 2, 3, 4, 5]
  if xs.len == 5:
    if total == 4:
      echo("probe_builtin_len=pass")
      return 0
  echo("probe_builtin_len=fail")
  return 102
