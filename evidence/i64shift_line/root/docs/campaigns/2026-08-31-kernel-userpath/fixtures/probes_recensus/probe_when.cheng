# PHASEB-RECENSUS probe_when: when/elif/else compile-time conditional
fn main(): int32 =
  var picked: int32
  when false:
    picked = 2
  elif true:
    picked = 1
  else:
    picked = 3
  var untouched: int32
  when false:
    untouched = 9
  if picked == 1:
    if untouched == 0:
      echo("probe_when=pass")
      return 0
  echo("probe_when=fail")
  return 101
