# PHASEB-RECENSUS probe_match: case/of/else statement on enum discriminant
type Color = enum
  Red
  Green
  Blue

fn pick(c: Color): int32 =
  case c
  of Red:
    return 1
  of Green:
    return 2
  else:
    return 9

fn main(): int32 =
  let a: int32 = pick(Color.Red)
  let b: int32 = pick(Color.Green)
  let d: int32 = pick(Color.Blue)
  if a == 1:
    if b == 2:
      if d == 9:
        echo("probe_match=pass")
        return 0
  echo("probe_match=fail")
  return 101
