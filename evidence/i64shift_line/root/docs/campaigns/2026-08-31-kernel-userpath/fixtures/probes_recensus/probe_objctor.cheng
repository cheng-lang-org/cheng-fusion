# PHASEB-RECENSUS probe_objctor: object declaration + named construction + field get
type PObj = object
  x: int32
  y: int32

fn main(): int32 =
  let p: PObj = PObj(x: 1, y: 2)
  if p.x == 1:
    if p.y == 2:
      echo("probe_objctor=pass")
      return 0
  echo("probe_objctor=fail")
  return 101
