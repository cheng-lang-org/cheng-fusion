# [S1b step-3 ① acceptance] `T[INLINE_ARITH]` fixed-array length.
#
# C chain reference: bootstrap/cheng_cold.c:30171-30183 — when the bracket
# content is neither an integer literal nor a plain named const it is evaluated
# with `cold_eval_i32_const_expr` (the comment names `Slot[N*16]`).
#
# Why this is a SEPARATE fixture from the named-const one: Cheng's parser
# classifies a bare identifier bracket argument as a TYPE argument
# (`parserTypeSyntaxTryArgumentInto` succeeds for any name token), while an
# arithmetic argument FAILS type parsing and therefore takes the const-root
# path — where the const evaluator (parser.cheng:14335-14396) has no name node
# and the length is left as -1.  The two forms are broken in two different
# ways, so the port must be accepted on both.
#
# Expected after the port: compile rc=0 and run rc=0.
const
    SlotStep: int32 = 8

type
    Slots =
        used: int32
        values: int32[SlotStep * 2]

fn main(): int32 =
    var s: Slots
    s.values[0] = 3
    s.values[SlotStep * 2 - 1] = 4
    s.used = s.values[0] + s.values[SlotStep * 2 - 1]
    if s.used != 7:
        return 2
    return 0
