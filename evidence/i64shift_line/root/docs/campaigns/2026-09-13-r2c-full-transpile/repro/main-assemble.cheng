fn main(): int32 =
    if sanitizeRuntimeStartupError("  boom ") != "boom":
        return 2
    if sanitizeRuntimeStartupError("runtime_not_ready") != "":
        return 3
    if toSourceTag("video") != "":
        return 4
    if toSourceTag(" LAN ") != "LAN":
        return 41
    var prof: NodeSystemProfile
    prof.osName = "iOS"
    prof.osVersion = "17.0"
    prof.cpuModel = "A17"
    prof.cpuCores = 6
    prof.memoryTotalBytes = 8589934592
    prof.gpuModel = "Apple"
    prof.gpuComputeScore = 100
    prof.uplinkBps = 1000000
    prof.diskType = "ssd"
    var lbl = formatNodeOsLabel(prof)
    if lbl != "iOS 17.0":
        return 5
    if !hasSystemProfileSignals(prof):
        return 6
    var cloned = cloneSystemProfile(prof)
    if cloned.osName != "iOS":
        return 7
    if formatNodeTitleWithRemark("peer1", "remark", "fb") != "(remark)peer1":
        return 8
    if formatNodeTitleWithRemark("peer1", "", "fb") != "peer1":
        return 9
    return 0
