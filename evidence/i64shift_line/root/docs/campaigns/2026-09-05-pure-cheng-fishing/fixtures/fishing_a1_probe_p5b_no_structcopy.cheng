# A1 探针 p5b: 去掉结构体拷贝, 只留 CloneStr 入 seq — 定位运行期 registry_miss。
import std/system
import std/strings as strings

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn valid(r: Rec): bool =
    return r.cid.len == 64

fn main(): int32 =
    let r = make(7)
    var cids: str[]
    add(cids, strings.CloneStr(r.cid))
    if cids.len != 1:
        return 2
    if !valid(r):
        return 3
    echo(Fmt"p5b {cids.len} {r.code}")
    return 0
