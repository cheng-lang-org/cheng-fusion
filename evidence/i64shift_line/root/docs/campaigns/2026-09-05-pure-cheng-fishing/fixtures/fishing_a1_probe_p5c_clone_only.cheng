# A1 探针 p5c: CloneStr 结果只绑定 let, 不入 seq — 二分 registry_miss 来源。
import std/system
import std/strings as strings

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

fn main(): int32 =
    let r = make(7)
    let copy = strings.CloneStr(r.cid)
    echo(Fmt"p5c {r.code} {copy.len}")
    return 0
