# A1 探针 p5e: 无 CloneStr — 字面量 cid + 托管结构体赋值拷贝 + 改字段 + 校验。
# 单变量定罪: 托管结构体值拷贝在 C 链的运行期语义。
import std/system
import std/strings as strings

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn valid(r: Rec): bool =
    return r.cid.len == 64

fn main(): int32 =
    let r = make(7)
    var tampered = r
    tampered.code = tampered.code + 1
    if !valid(r):
        return 3
    if valid(tampered):
        return 4
    echo(Fmt"p5e {r.code} {tampered.code}")
    return 0
