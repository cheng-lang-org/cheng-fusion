# A1 探针 p5d: 字面量 str 直接入 seq, 不过 CloneStr — 二分 add(move) 路径。
import std/system

fn main(): int32 =
    var cids: str[]
    add(cids, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    add(cids, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    echo(Fmt"p5d {cids.len} {cids[0].len}")
    return 0
