# A1 探针 p2: 托管返回值绑定 let 后读字段 — physics2d_determinism_smoke 墙形
# (let receipt = Physics2dStep(...) 报 managed bind move lacks exact source value definition)。
import std/system

type
    Receipt =
        code: int32
        tag: str

fn make(code: int32): Receipt =
    var r: Receipt
    r.code = code
    r.tag = "ok"
    return r

fn main(): int32 =
    let r = make(7)
    echo(Fmt"p2 {r.code} {r.tag}")
    return 0
