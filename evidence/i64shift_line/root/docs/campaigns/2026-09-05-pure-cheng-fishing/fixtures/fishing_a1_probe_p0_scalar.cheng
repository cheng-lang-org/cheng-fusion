# A1 探针 p0 对照组: 纯标量字段结构体借用传参两次, 期望编译+运行通过。
import std/system

type
    ScalarPod =
        a: int32
        b: int32

fn fill(p: var ScalarPod) =
    p.a = 11
    p.b = 22

fn total(p: ScalarPod): int32 =
    return p.a + p.b

fn main(): int32 =
    var p: ScalarPod
    fill(p)
    let x = total(p)
    let y = total(p)
    echo(Fmt"p0 {x} {y}")
    return 0
