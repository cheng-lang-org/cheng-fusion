# A1 探针 p1: 含 seq 字段的托管结构体, 借用传参两次 — ecs_capacity_smoke 墙形。
import std/system

type
    Pod =
        count: int32
        xs: int32[]

fn fill(p: var Pod) =
    p.count = 2
    setLen(p.xs, 2)
    p.xs[0] = 11
    p.xs[1] = 22

fn total(p: Pod): int32 =
    var t: int32
    for i in 0..<p.count:
        t = t + p.xs[i]
    return t

fn main(): int32 =
    var p: Pod
    fill(p)
    let x = total(p)
    let y = total(p)
    echo("p1 " & Fmt(x) & " " & Fmt(y))
    return 0
