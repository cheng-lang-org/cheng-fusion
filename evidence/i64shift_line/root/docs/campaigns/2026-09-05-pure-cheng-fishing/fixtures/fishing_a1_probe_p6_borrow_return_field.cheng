# A1 探针 p6: @borrows 函数返回托管字段 — 当前契约是否允许(auto-share)。
import std/system

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn getCid(r: Rec): str =
    return r.cid

fn main(): int32 =
    var r = make(7)
    let a = getCid(r)
    let b = getCid(r)
    echo(Fmt"p6 {r.code} {a.len} {b.len}")
    return 0
