# A1 探针 p5a: p5 去掉自赋值行 — 定位 use of consumed managed value 的消费点。
import std/system
import std/strings as strings

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn valid(r: Rec): bool =
    return r.cid.len == 64

fn main(): int32 =
    let r = make(7)
    var cids: str[]
    add(cids, strings.CloneStr(r.cid))
    if cids.len != 1:
        return 2
    if !valid(r):
        return 3
    var tampered = r
    tampered.code = tampered.code + 1
    if valid(tampered):
        return 4
    echo(Fmt"p5a {cids.len} {tampered.code}")
    return 0
