# A1 负例 neg2: 托管结构体赋值 = move (probe p5e 实证), 源整体再使用必须被拒。
# 采用 p5e 的已证拒绝形态: move 后将源整体传入 @borrows 调用。
# 预期: 编译期硬错误 use of consumed managed value。
import std/system

type
    Pod =
        code: int32
        tag: str

@borrows
fn valid(p: Pod): bool =
    return p.code > 0

fn main(): int32 =
    var a: Pod
    a.code = 1
    a.tag = "x"
    var b: Pod
    b = a
    if !valid(b):
        return 3
    if !valid(a):
        return 4
    return 0
