# A1 探针 p1b: 与 p1 同形, 但只读函数按现行规范标注 @borrows
# (规范 §0.2 逃逸规则: 借用值仅允许传给显式 @borrows 的函数, 非 var 形参默认 move)。
import std/system

type
    Pod =
        count: int32
        xs: int32[]

fn fill(p: var Pod) =
    p.count = 2
    setLen(p.xs, 2)
    p.xs[0] = 11
    p.xs[1] = 22

@borrows
fn total(p: Pod): int32 =
    var t: int32
    for i in 0..<p.count:
        t = t + p.xs[i]
    return t

fn main(): int32 =
    var p: Pod
    fill(p)
    let x = total(p)
    let y = total(p)
    echo(Fmt"p1b {x} {y}")
    return 0
