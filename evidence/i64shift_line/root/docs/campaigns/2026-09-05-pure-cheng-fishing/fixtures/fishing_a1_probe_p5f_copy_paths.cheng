# A1 探针 p5f: 借用 str 的替代拷贝路径 — `&` 串接与 Fmt 插值, 释放是否干净。
import std/system
import std/strutils as strutil

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn preimage(r: Rec): str =
    return "|cid=" & r.cid & "|end"

@borrows
fn fmtCopy(r: Rec): str =
    return Fmt"{r.cid}"

fn main(): int32 =
    let r = make(7)
    let a = preimage(r)
    let b = fmtCopy(r)
    echo(Fmt"p5f alen={a.len} blen={b.len} cidlen={r.cid.len}")
    echo(a)
    return 0
