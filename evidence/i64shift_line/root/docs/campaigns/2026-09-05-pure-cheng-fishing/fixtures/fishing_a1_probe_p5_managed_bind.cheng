# A1 探针 p5: 压满 game_tick_replay_smoke 的剩余形态 —
# 托管返回值 let 绑定、CloneStr 显式共享入 seq、托管结构体赋值拷贝+改字段。
import std/system
import std/strings as strings

type
    Rec =
        code: int32
        cid: str

fn make(code: int32): Rec =
    var r: Rec
    r.code = code
    r.cid = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    return r

@borrows
fn valid(r: Rec): bool =
    return r.cid.len == 64

fn main(): int32 =
    let r = make(7)
    var cids: str[]
    add(cids, strings.CloneStr(r.cid))
    add(cids, strings.CloneStr(r.cid))
    if cids.len != 2:
        return 2
    var tampered = r
    tampered.code = tampered.code + 1
    tampered.cid = tampered.cid
    if !valid(r):
        return 3
    if valid(tampered):
        return 4
    echo(Fmt"p5 {cids.len} {cids[0].len}")
    return 0
