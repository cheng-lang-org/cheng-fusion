# A1 探针 p3: 托管结构体字段(str)读出后 add 进 seq — game_tick_replay_smoke 墙形
# (add(value) borrowed source requires explicit share)。
import std/system

type
    Row =
        name: str

fn main(): int32 =
    var rows: str[]
    var r: Row
    r.name = "fish"
    add(rows, r.name)
    add(rows, r.name)
    echo("p3 " & Fmt(rows.len) & " " & rows[0])
    return 0
