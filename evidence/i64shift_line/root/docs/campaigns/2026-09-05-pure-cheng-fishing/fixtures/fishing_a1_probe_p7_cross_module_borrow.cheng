# A1 探针 p7: 跨模块 @borrows 调用 — var 局部初始化后连续两次借用读。
import cheng/game/ecs

fn main(): int32 =
    var world: ecs.EcsWorld
    ecs.EcsWorldReset(world)
    let _ = ecs.EcsWorldSpawn(world, 1000, 2000, 1, "cid:x")
    let a = ecs.EcsWorldEntityCount(world)
    let b = ecs.EcsWorldEntityCount(world)
    let ok = ecs.EcsWorldColumnsValid(world)
    echo(Fmt"p7 {a} {b} {ok}")
    return 0
