# A1 负例 neg3: 借用源入容器未显式共享 (现行契约, cold_parser add/str[]存储
# 双站点硬拒; probe p3 实证)。显式共享正例走 Fmt 拷贝。
# 预期: 编译期硬错误 add(value) borrowed source requires explicit share。
import std/system

fn main(): int32 =
    var rows: str[]
    var r: Row
    r.name = "fish"
    add(rows, r.name)
    echo(Fmt"{rows.len}")
    return 0

type
    Row =
        name: str
