# A1 最小复现 p1: 托管结构体（含 seq 字段）局部量经 var 参初始化后,
# 以普通值参借用传参两次 — 当前链在第二次调用报
# call argument exact transfer authority is invalid / use of consumed managed value。
# 期望(按规范): 普通值参为共享借用, 两次调用均合法且结果一致。
import std/system

type
    Pod =
        count: int32
        xs: int32[]

fn podFill(p: var Pod) =
    p.count = 2
    setLen(p.xs, 2)
    p.xs[0] = 11
    p.xs[1] = 22

fn podSum(p: Pod): int32 =
    var total: int32
    for i in 0..<p.count:
        total = total + p.xs[i]
    return total

fn main(): int32 =
    var p: Pod
    podFill(p)
    let a = podSum(p)
    let b = podSum(p)
    echo("p1 sum " & Fmt(a) & " " & Fmt(b))
    return 0
