# f64 位型缺陷探针 (任务: f64_bits_abi_fix)。只打印观测值, 不断言。
# 动机: program_support_backend.cheng 的 cheng_bits_to_f64/cheng_f64_to_bits
# 用 `*Int64Ptr(&f64局部)` 做类型化双关, 实测 0.5→错误位型、NaN→0。
# 本探针把两侧 (读侧 f64→bits / 写侧 bits→f64) 分开观测, 定位哪侧被
# 编成数值转换。
# 64 位常量构造纪律: 驱动存在 >32 位整型字面量截断缺陷, 全部用
# int32 分量 + 移位构造, 不写 64 位字面量。
import std/strings
import std/strutils as strutil

fn maskLo32(): int64 =
    return (int64(1) << 32) - int64(1)

fn mkBits(hi: int32, lo: int32): int64 =
    return (int64(hi) << 32) | (int64(lo) & maskLo32())

fn hi32(bits: int64): int32 =
    return int32(bits >> 32)

fn lo32(bits: int64): int32 =
    return int32(bits & maskLo32())

fn makeNaN(): float64 =
    var z: float64 = 0.0
    return z / z

fn makeInf(): float64 =
    var z: float64 = 1.0
    return z / z

fn bstr(label: str, bits: int64): str =
    return strutil.Join([
        strings.CloneStr(label),
        " hi=",
        strings.IntToStr(hi32(bits)),
        " lo=",
        strings.IntToStr(lo32(bits))
    ], "")

fn bflag(label: str, v: bool): str =
    if v:
        return strutil.Join([strings.CloneStr(label), " -> 1"], "")
    return strutil.Join([strings.CloneStr(label), " -> 0"], "")

fn main(): int32 =
    # 读侧观测: f64 → int64 位型。期望值 (十进制 hi/lo):
    #   0.5 -> hi=1071644672(0x3FE00000) lo=0
    #   1.0 -> hi=1072693248(0x3FF00000) lo=0
    #  -2.0 -> hi=-1073741824(0xC0000000) lo=0
    #   nan -> hi=2146959360(0x7FF80000) lo=0
    #   inf -> hi=2146435072(0x7FF00000) lo=0
    #   0.0 -> hi=0 lo=0
    echo(bstr("f64ToBits(0.5)", f64ToBits(0.5)))
    echo(bstr("f64ToBits(1.0)", f64ToBits(1.0)))
    echo(bstr("f64ToBits(-2.0)", f64ToBits(-2.0)))
    echo(bstr("f64ToBits(nan)", f64ToBits(makeNaN())))
    echo(bstr("f64ToBits(inf)", f64ToBits(makeInf())))
    echo(bstr("f64ToBits(0.0)", f64ToBits(0.0)))
    # 写侧观测: int64 位型 → f64。逐个与精确目标值比较。
    echo(bflag("bitsToF64(0x3FE0000000000000)==0.5",
               bitsToF64(mkBits(1071644672, 0)) == 0.5))
    echo(bflag("bitsToF64(0x3FF0000000000000)==1.0",
               bitsToF64(mkBits(1072693248, 0)) == 1.0))
    echo(bflag("bitsToF64(0)==0.0", bitsToF64(0) == 0.0))
    # 双跳观测: bits→f64 再读回来, 看写侧实际落进槽里的字节。
    echo(bstr("f64ToBits(bitsToF64(0x3FE0..))",
              f64ToBits(bitsToF64(mkBits(1071644672, 0)))))
    return 0
