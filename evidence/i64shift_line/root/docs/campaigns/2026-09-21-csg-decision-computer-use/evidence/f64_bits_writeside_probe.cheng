# f64 写侧机制探针: cheng_bits_to_f64 的位型 0x3FE0000000000000 落槽后读回
# 全 0。三组输入分离三种理论: (a) int64 形参在 ABI 边界截成 int32 后数值转
# double; (b) 仅低 32 位字节写入槽低位半; (c) 全 8 字节数值转换写。
#   A = 0x3FF0000000000001 (低32=1)
#   B = 0x7FF8000000000000 (NaN 位型, 低32=0)
#   C = 1
import std/strings
import std/strutils as strutil

fn maskLo32(): int64 =
    return (int64(1) << 32) - int64(1)

fn mkBits(hi: int32, lo: int32): int64 =
    return (int64(hi) << 32) | (int64(lo) & maskLo32())

fn hi32(bits: int64): int32 =
    return int32(bits >> 32)

fn lo32(bits: int64): int32 =
    return int32(bits & maskLo32())

fn bstr(label: str, bits: int64): str =
    return strutil.Join([
        strings.CloneStr(label),
        " hi=",
        strings.IntToStr(hi32(bits)),
        " lo=",
        strings.IntToStr(lo32(bits))
    ], "")

fn doublehop(bits: int64): int64 =
    return f64ToBits(bitsToF64(bits))

fn main(): int32 =
    echo(bstr("A doublehop(0x3FF0000000000001)", doublehop(mkBits(1072693248, 1))))
    echo(bstr("B doublehop(0x7FF8000000000000)", doublehop(mkBits(2146959360, 0))))
    echo(bstr("C doublehop(1)", doublehop(1)))
    return 0
