import std/system as system

# Amplified confirmation run, one compile doing three jobs:
#   1. candidate fix: `setLen(values, count)` + indexed stores instead of
#      growing with `add` inside the loop -- must read 0 over 1000 calls;
#   2. position swap: the leaking shape sits in the SECOND slot, so a "first
#      slot always shows something" artifact cannot explain the reading;
#   3. magnitude: each delta is capped at 15, so 15 means "at least 15 blocks
#      over 1000 calls" (the earlier run only proved >=15 for the add shape).
#
# Exit code = min(presetDelta,15) * 16 + min(addDelta,15):
#     0 = both clean (fix works, leak was noise)
#    15 = preset clean, add leaks   (expected: fix works, leak confirmed in 2nd slot)
#   255 = both leak                 (the preset shape is not a fix)
#    99 = sanity check failed

var probeSink: int32

fn PresetShape(count: int32): int32 =
    var values: int32[]
    setLen(values, count)
    var i: int32
    while i < count:
        values[i] = i
        i = i + 1
    return values.len + values[count - 1]

fn AddShape(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len + values[count - 1]

fn RepeatPreset(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + PresetShape(8)
        r = r + 1
    return acc

fn RepeatAdd(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + AddShape(8)
        r = r + 1
    return acc

fn Cap(delta: int64): int64 =
    if delta <= 0:
        return 0
    if delta > 15:
        return 15
    return delta

fn main(): int32 =
    let rounds: int32 = 1000
    let beforePreset = system.MemLiveAllocations()
    let presetObserved = RepeatPreset(rounds)
    let presetDelta = system.MemLiveAllocations() - beforePreset
    let beforeAdd = system.MemLiveAllocations()
    let addObserved = RepeatAdd(rounds)
    let addDelta = system.MemLiveAllocations() - beforeAdd
    probeSink = presetObserved + addObserved
    if presetObserved <= 0 || addObserved <= 0:
        return 99
    return int32(Cap(presetDelta) * 16 + Cap(addDelta))
