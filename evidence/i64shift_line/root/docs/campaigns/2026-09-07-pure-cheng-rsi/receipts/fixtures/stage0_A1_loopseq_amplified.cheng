import std/system as system

# Amplified repro: lift the seq question above the 1-block noise floor.
#
# Probes 4/5/6 disagreed on which shape leaks, and the leaked amount never
# exceeded 2 blocks -- the instrument's noise floor.  A real per-call leak of
# one buffer must scale with call count, so each shape here runs 1000 times and
# the delta is bucketed (capped at 15) rather than reported raw.
#
# Exit code = bucket(loopShapeDelta) * 16 + bucket(straightShapeDelta):
#   240 = only the loop-grown shape leaks   (probes 4/5 reading)
#    15 = only the straight-line shape leaks
#   255 = both leak                         (i.e. locals leak generally)
#     0 = neither leaks                     (probes 4/5/6 were noise)
#    99 = sanity check failed

var probeSink: int32

fn ShapeLoop(count: int32): int32 =
    var values: int32[]
    var i: int32
    while i < count:
        add(values, i)
        i = i + 1
    return values.len

fn ShapeStraight(seed: int32): int32 =
    var values: int32[]
    add(values, seed)
    add(values, seed + 1)
    add(values, seed + 2)
    return values.len

fn RepeatLoop(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + ShapeLoop(8)
        r = r + 1
    return acc

fn RepeatStraight(rounds: int32): int32 =
    var acc: int32
    var r: int32
    while r < rounds:
        acc = acc + ShapeStraight(r)
        r = r + 1
    return acc

fn Bucket(delta: int64): int64 =
    if delta <= 0:
        return 0
    if delta > 15:
        return 15
    return delta

fn main(): int32 =
    let rounds: int32 = 1000
    let beforeLoop = system.MemLiveAllocations()
    let loopObserved = RepeatLoop(rounds)
    let loopDelta = system.MemLiveAllocations() - beforeLoop
    let beforeStraight = system.MemLiveAllocations()
    let straightObserved = RepeatStraight(rounds)
    let straightDelta = system.MemLiveAllocations() - beforeStraight
    probeSink = loopObserved + straightObserved
    if loopObserved <= 0 || straightObserved <= 0:
        return 99
    return int32(Bucket(loopDelta) * 16 + Bucket(straightDelta))
