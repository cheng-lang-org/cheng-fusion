# B22 collected minimal ORC double-release probe (verbatim copy of
# src/tests/orc_dev_minimal8.cheng; provenance sha of source recorded in the
# stage0 B22 receipt). Shape: @borrows param passthrough. If the compiler
# materializes a @borrows str param as an owned bit-copy and drops it at exit
# while the caller also drops the source, this exits with a double release.
# UNVERIFIED on kd_b2201 (stage 0 does not compile); kept as the smallest
# known in-tree ORC-repro shape.
import std/system
import std/result
import std/strings as strings

@borrows
fn EchoMsg(msg: str): str =
    return msg

fn main(): int32 =
    let owned = strings.CloneStr("passthrough probe message")
    let echoed = EchoMsg(owned)
    echo(echoed)
    echo("done")
    return 0
