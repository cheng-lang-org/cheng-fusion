import std/system as system

# Case probe 4: sequences whose ELEMENTS are themselves managed.
#
# Case probe 2 covered `int32[]` (unmanaged elements) and a bare local `str`.
# It never covered the combination the parser actually builds: a `str[]` whose
# buffer is released but whose element strings would each have to be dropped.
# If only the buffer is freed, every element leaks -- which is linear in names
# and therefore matches the measured "~1.5 blocks/token" shape exactly.  The
# Cheng-side ownership analysis documents the neighbouring gap verbatim
# (ownership_body_ir_production.cheng: "managed sequence cleanup drop-glue
# authority missing").
#
# Every delta is taken ACROSS the worker call in `main`.

var probeSink: int32

fn WorkerStrSeqLiteral(seed: int32): int32 =
    let names: str[] = [Fmt"n{Int32(seed)}a", Fmt"n{Int32(seed)}b"]
    return names.len + names[0].len

fn WorkerStrSeqAdd(seed: int32): int32 =
    var names: str[]
    add(names, Fmt"m{Int32(seed)}a")
    add(names, Fmt"m{Int32(seed)}b")
    add(names, Fmt"m{Int32(seed)}c")
    return names.len + names[0].len + names[2].len

fn WorkerStrSeqLoop(seed: int32): int32 =
    var names: str[]
    var i: int32
    while i < 8:
        add(names, Fmt"l{Int32(seed)}-{Int32(i)}")
        i = i + 1
    return names.len + names[7].len

fn WorkerStrSeqExplicit(seed: int32): int32 =
    var names: str[]
    add(names, Fmt"x{Int32(seed)}a")
    add(names, Fmt"x{Int32(seed)}b")
    let observed = names.len + names[0].len
    names = []
    return observed

fn Digit(value: int64, weight: int64): int64 =
    if value < 0:
        return 7 * weight
    if value > 6:
        return 6 * weight
    return value * weight

fn main(): int32 =
    var acc: int32
    let before0 = system.MemLiveAllocations()
    acc = acc + WorkerStrSeqLiteral(acc + 11)
    let delta0 = system.MemLiveAllocations() - before0
    let before1 = system.MemLiveAllocations()
    acc = acc + WorkerStrSeqAdd(acc + 13)
    let delta1 = system.MemLiveAllocations() - before1
    let before2 = system.MemLiveAllocations()
    acc = acc + WorkerStrSeqLoop(acc + 17)
    let delta2 = system.MemLiveAllocations() - before2
    let before3 = system.MemLiveAllocations()
    acc = acc + WorkerStrSeqExplicit(acc + 19)
    let delta3 = system.MemLiveAllocations() - before3
    probeSink = acc
    if acc <= 0:
        return 99
    let packed = Digit(delta0, 1) +
                 Digit(delta1, 8) +
                 Digit(delta2, 64) +
                 Digit(delta3, 512)
    return int32(packed)
