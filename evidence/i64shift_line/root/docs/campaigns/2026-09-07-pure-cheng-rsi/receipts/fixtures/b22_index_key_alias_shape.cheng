# B22 candidate minimal-shape fixture (NOT yet verified; stage 0 no-compile).
# Shape under test: a module-const registry key declared with a double-line
# initializer (B21 face) is stored into a seq[str] AND into a
# ParserSourcePathIndexLookup bucket key. Candidate patch
# stage0_B22_20260915T101925Z.patch makes ParserSourcePathIndexLookupInsertExact
# self-own its key; if the bucket key aliased the seq element, teardown would
# release the same str payload twice -> cheng_orc_release_failure
# code=registry_miss operation=normal_release detail=wrong_object_or_owner.
# Main-lane run: stage3 kd with the B22 patch, standard 234-closure driver;
# expected after fix: rc=0 and zero ORCM lines.
import std/os

const
    B22DoubleLineTag: str =
        "cheng.core.b22.doubleline"
    B22SingleTag: str = "cheng.core.b22.single"

fn B22TagNames(): str[] =
    var out: str[]
    add(out, B22DoubleLineTag)
    add(out, B22SingleTag)
    return out

fn main(): int32 =
    let names = B22TagNames()
    os.WriteLine(os.Get_stdout(), names[0])
    return 0
