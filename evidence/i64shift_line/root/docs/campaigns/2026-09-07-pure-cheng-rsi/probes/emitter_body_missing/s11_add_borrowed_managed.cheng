# s11: minimal deterministic repro of the "body-missing" family.
# add(seq_of_managed_T, seq_index_read) -> element read is BORROWED ->
# cold_parser.c parse_builtin_add_after_name gate dies ->
# import-body recovery swallows -> "reachable function body missing".
type
    Fact =
        surface: str
        ordinal: int32

    Layer =
        scopes: Fact[]
        n: int32

fn MoveInto(out: var Layer, layer: var Layer) =
    var cloned: Fact[]
    for i in 0..<layer.scopes.len:
        add(cloned, layer.scopes[i])
    out.scopes = cloned
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    var f: Fact
    f.surface = "x"
    f.ordinal = 1
    add(b.scopes, f)
    MoveInto(a, b)
    if a.scopes.len != 1:
        return 1
    return 0
