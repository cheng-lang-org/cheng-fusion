# s09: full MoveInto mirror -- alias probe + double handle guard panic +
# terminal release receipt + all-field move + reset.
import std/system as sys
type
    Tree = ref object
        root: int32

    Receipt =
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    Lookup =
        slots: int32[]
        buckets: int32[]

    Layer =
        sourceCount: int32
        exprs: int32[]
        exprNext: int32[]
        scopes: int32[]
        questionResidualCount: int32
        exprLookup: Lookup
        tree: Tree
        lease: bool

fn DescriptorsAlias(lhs: var Layer, rhs: var Layer): bool =
    let lhsSourceCount = lhs.sourceCount
    let rhsSourceCount = rhs.sourceCount
    var aliasMarker: int32
    if lhsSourceCount == 0:
        aliasMarker = 1
    else:
        aliasMarker = 0
    rhs.sourceCount = aliasMarker
    let aliases = lhs.sourceCount == aliasMarker
    rhs.sourceCount = rhsSourceCount
    return aliases

fn TerminalRelease(layer: var Layer, receipt: var Receipt) =
    setLen(layer.exprs, 0)
    setLen(layer.exprNext, 0)
    setLen(layer.scopes, 0)
    setLen(layer.exprLookup.slots, 0)
    setLen(layer.exprLookup.buckets, 0)
    receipt.releasedBytes = 8
    receipt.storageReleased = true

fn MoveInto(out: var Layer, layer: var Layer) =
    if DescriptorsAlias(out, layer):
        sys.panic("probe: layer move source aliases destination descriptor")
    if out.tree != nil && out.tree == layer.tree && !out.lease && !layer.lease:
        sys.panic("probe: layer move has duplicate owner descriptors")
    var destinationReleaseReceipt: Receipt
    TerminalRelease(out, destinationReleaseReceipt)
    out.sourceCount = layer.sourceCount
    out.exprs = layer.exprs
    out.exprNext = layer.exprNext
    out.scopes = layer.scopes
    out.questionResidualCount = layer.questionResidualCount
    out.exprLookup = layer.exprLookup
    out.tree = layer.tree
    out.lease = layer.lease
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    add(b.exprs, 7)
    add(b.exprLookup.slots, 1)
    b.tree = new(Tree)
    b.tree.root = 11
    MoveInto(a, b)
    if a.exprs.len != 1 || a.tree == nil:
        return 1
    return 0
