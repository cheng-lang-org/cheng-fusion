# s04: two seq fields moved + reset.
type
    Layer =
        exprs: int32[]
        exprNext: int32[]

fn MoveInto(out: var Layer, layer: var Layer) =
    out.exprs = layer.exprs
    out.exprNext = layer.exprNext
    layer = Layer()

fn main(): int32 =
    var x: Layer
    var y: Layer
    add(y.exprs, 1)
    add(y.exprNext, 2)
    MoveInto(x, y)
    if x.exprs.len != 1:
        return 1
    return 0
