# s13: str-seq variant -- add(str_seq, other_str_seq[i]) -- str is managed,
# index read is borrowed. Same gate family as s11 (root findings 10541).
type
    Layer =
        lines: str[]
        n: int32

fn MoveInto(out: var Layer, layer: var Layer) =
    var cloned: str[]
    for i in 0..<layer.lines.len:
        add(cloned, layer.lines[i])
    out.lines = cloned
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    add(b.lines, "hello")
    MoveInto(a, b)
    if a.lines.len != 1:
        return 1
    return 0
