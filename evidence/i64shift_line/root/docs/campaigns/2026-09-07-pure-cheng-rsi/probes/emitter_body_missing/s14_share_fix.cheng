# s14: fix evidence -- the gate's demanded escape: explicit share().
# Same shape as s11 but the borrowed managed element is wrapped in share().
type
    Fact =
        surface: str
        ordinal: int32

    Layer =
        scopes: Fact[]
        n: int32

fn MoveInto(out: var Layer, layer: var Layer) =
    var cloned: Fact[]
    for i in 0..<layer.scopes.len:
        add(cloned, share(layer.scopes[i]))
    out.scopes = cloned
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    var f: Fact
    f.surface = "x"
    f.ordinal = 1
    add(b.scopes, f)
    MoveInto(a, b)
    if a.scopes.len != 1:
        return 1
    if a.scopes[0].surface != "x":
        return 2
    if b.scopes.len != 0:
        return 3
    return 0
