# s10: reset-only -- body does nothing but reset the var param.
type
    Layer =
        exprs: int32[]
        n: int32

fn ResetIt(layer: var Layer) =
    layer = Layer()

fn main(): int32 =
    var y: Layer
    add(y.exprs, 2)
    ResetIt(y)
    if y.exprs.len != 0:
        return 1
    return 0
