# s07: DeepTransfer shape -- clone-into loop + double add + handle move + reset.
type
    Expr =
        kind: int32
        surface: str

    Tree = ref object
        root: int32

    Layer =
        sourceCount: int32
        exprs: Expr[]
        exprNext: int32[]
        scopes: int32[]
        tree: Tree
        lease: bool

fn ExprCloneInto(src: var Expr, dst: var Expr) =
    dst.kind = src.kind
    dst.surface = src.surface

fn Transfer(dst: var Layer, layer: var Layer) =
    var out: Layer
    for i in 0..<layer.exprs.len:
        var clonedExpr: Expr
        ExprCloneInto(layer.exprs[i], clonedExpr)
        add(out.exprs, clonedExpr)
    for i in 0..<layer.exprNext.len:
        add(out.exprNext, layer.exprNext[i])
    for i in 0..<layer.scopes.len:
        add(out.scopes, layer.scopes[i])
    out.tree = layer.tree
    out.lease = layer.lease
    out.sourceCount = layer.sourceCount
    dst = out
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    var e: Expr
    e.kind = 3
    e.surface = "x"
    add(b.exprs, e)
    add(b.exprNext, 1)
    add(b.scopes, 42)
    Transfer(a, b)
    if a.exprs.len != 1:
        return 1
    return 0
