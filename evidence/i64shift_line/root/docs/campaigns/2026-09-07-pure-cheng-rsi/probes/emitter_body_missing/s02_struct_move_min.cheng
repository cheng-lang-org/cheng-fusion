# s02: minimal struct field move via var params. No seq, no handle, no reset.
type
    Pkt =
        a: int32
        b: int32

fn MoveInto(out: var Pkt, src: var Pkt) =
    out.a = src.a
    out.b = src.b

fn main(): int32 =
    var x: Pkt
    var y: Pkt
    y.a = 3
    y.b = 4
    MoveInto(x, y)
    if x.a != 3:
        return 1
    return 0
