# s06: nested managed object field (object containing two seqs) moved whole + reset.
type
    Lookup =
        slots: int32[]
        buckets: int32[]

    Layer =
        lookup: Lookup
        n: int32

fn MoveInto(out: var Layer, layer: var Layer) =
    out.lookup = layer.lookup
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var x: Layer
    var y: Layer
    add(y.lookup.slots, 9)
    MoveInto(x, y)
    if x.lookup.slots.len != 1:
        return 1
    return 0
