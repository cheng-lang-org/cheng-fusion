# s08: var-param call with receipt object argument + seq moves + reset
# (mirrors NormalizedExprLayerTerminalReleaseWithReceipt call shape).
type
    Receipt =
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    Layer =
        exprs: int32[]
        n: int32

fn TerminalRelease(layer: var Layer, receipt: var Receipt) =
    setLen(layer.exprs, 0)
    receipt.releasedBufferCount = 1
    receipt.storageReleased = true

fn MoveInto(out: var Layer, layer: var Layer) =
    var receipt: Receipt
    TerminalRelease(out, receipt)
    out.exprs = layer.exprs
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var x: Layer
    var y: Layer
    add(y.exprs, 4)
    MoveInto(x, y)
    if x.n != 0:
        return 1
    return 0
