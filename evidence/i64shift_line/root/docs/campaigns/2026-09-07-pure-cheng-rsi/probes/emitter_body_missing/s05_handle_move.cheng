# s05: ref-handle field move + lease bool + reset (no seq fields).
type
    Tree = ref object
        root: int32

    Layer =
        tree: Tree
        lease: bool

fn MoveInto(out: var Layer, layer: var Layer) =
    out.tree = layer.tree
    out.lease = layer.lease
    layer = Layer()

fn main(): int32 =
    var x: Layer
    var y: Layer
    y.tree = new(Tree)
    y.tree.root = 5
    MoveInto(x, y)
    if x.tree == nil:
        return 1
    return 0
