# s03: one seq field move + whole reset (layer = T()).
type
    Layer =
        a: int32
        exprs: int32[]

fn MoveInto(out: var Layer, layer: var Layer) =
    out.a = layer.a
    out.exprs = layer.exprs
    layer = Layer()

fn main(): int32 =
    var x: Layer
    var y: Layer
    add(y.exprs, 7)
    MoveInto(x, y)
    if x.exprs.len != 1:
        return 1
    return 0
