# s12: control -- identical shape but the added element is a freshly
# constructed OWNED value instead of a borrowed seq-index read. Expect green.
type
    Fact =
        surface: str
        ordinal: int32

    Layer =
        scopes: Fact[]
        n: int32

fn MoveInto(out: var Layer, layer: var Layer) =
    var cloned: Fact[]
    for i in 0..<layer.scopes.len:
        var copy: Fact
        copy.surface = layer.scopes[i].surface
        copy.ordinal = layer.scopes[i].ordinal
        add(cloned, copy)
    out.scopes = cloned
    out.n = layer.n
    layer = Layer()

fn main(): int32 =
    var a: Layer
    var b: Layer
    var f: Fact
    f.surface = "x"
    f.ordinal = 1
    add(b.scopes, f)
    MoveInto(a, b)
    if a.scopes.len != 1:
        return 1
    return 0
