# m3_issuance_bar_probe.cheng - M3 issuance-bar judge pre-verification probe.
#
# Part of the DarwinAuthority M3 install-surface batch (DESIGN.md M3,
# findings verdict 58). Runs the in-repo held_exec_identity issuance-bar
# judge (heldExecDarwinIssuanceBarError) against an arbitrary absolute
# artifact path so the judge itself can be validated on scratch-signed
# Mach-O controls BEFORE any root install happens:
#   leg A  unsigned          -> held_exec_identity_e_darwin_signature_missing
#   leg B  ad-hoc signed     -> held_exec_identity_e_darwin_adhoc_signature
#   leg C  identity+runtime -> held_exec_identity_e_darwin_hardened_runtime_missing
#                               (library-validation bit absent)
#   leg D  identity+runtime,library
#                            -> held_exec_identity_e_darwin_system_immutable_missing
#                               (bar items 1-3 pass; item 4 is root-only)
# No root, no writes outside the task scratch scope, no fabricated data:
# every reported field comes from the same judge the psb darwin arm will
# consume when M3 is wired.
#
# usage: m3_issuance_bar_probe <absolute-artifact-path>

import std/os as os
import std/strings
import cheng/core/runtime/held_exec_identity as held_identity

fn flagText(value: bool): str =
    if value:
        return "1"
    return "0"

fn reportArtifact(path: str): int32 =
    let platform = held_identity.ChengHeldExecIdentityPlatform()
    var evidence: held_identity.ChengHeldExecFileEvidence
    var collectErr: str
    if !held_identity.ChengHeldExecIdentityCollectFileInto(
           platform, path, evidence, collectErr):
        os.WriteLine(os.Get_stderr(),
            "collect_failed path=" + path + " err=" + collectErr)
        return 1
    os.WriteLine(os.Get_stdout(), "artifact_path=" + path)
    os.WriteLine(os.Get_stdout(),
        "native_image_proven=" + flagText(evidence.nativeImageProven))
    os.WriteLine(os.Get_stdout(),
        "native_image_error=" + evidence.nativeImageError)
    os.WriteLine(os.Get_stdout(),
        "cdhash_cid=" + evidence.darwin.cdhashCid)
    os.WriteLine(os.Get_stdout(),
        "signing_identifier=" + evidence.darwin.signingIdentifier)
    os.WriteLine(os.Get_stdout(),
        "team_identifier=" + evidence.darwin.teamIdentifier)
    os.WriteLine(os.Get_stdout(),
        "ad_hoc_signature=" + flagText(evidence.darwin.adHocSignature))
    os.WriteLine(os.Get_stdout(),
        "hardened_runtime=" + flagText(evidence.darwin.hardenedRuntime))
    os.WriteLine(os.Get_stdout(),
        "library_validation=" + flagText(evidence.darwin.libraryValidation))
    os.WriteLine(os.Get_stdout(),
        "designated_requirement_proven=" +
            flagText(evidence.darwin.designatedRequirementProven))
    os.WriteLine(os.Get_stdout(),
        "designated_requirement_cid=" +
            evidence.darwin.designatedRequirementCid)
    os.WriteLine(os.Get_stdout(),
        "bytes_cid=" + evidence.bytesCid)
    os.WriteLine(os.Get_stdout(),
        "named_held_fence_closed=" +
            flagText(evidence.namedHeldFenceClosed))
    os.WriteLine(os.Get_stdout(),
        "held_descriptor_path_proven=" +
            flagText(evidence.heldDescriptorPathProven))
    os.WriteLine(os.Get_stdout(),
        "inode_flags=" + strings.Uint64ToStr(evidence.held.inodeFlags))
    os.WriteLine(os.Get_stdout(),
        "sf_immutable=" + flagText(
            (evidence.held.inodeFlags & uint64(131072)) != uint64(0)))
    let barError = held_identity.heldExecDarwinIssuanceBarError(evidence)
    if barError.len == 0:
        os.WriteLine(os.Get_stdout(), "issuance_bar=PASS")
    else:
        os.WriteLine(os.Get_stdout(),
            "issuance_bar=FAIL err=" + barError)
    return 0

fn main(): int32 =
    let platform = held_identity.ChengHeldExecIdentityPlatform()
    if platform != held_identity.ChengHeldExecPlatformDarwin:
        os.WriteLine(os.Get_stderr(),
            "m3 probe requires darwin-arm64 host, got: " + platform)
        return 2
    let params = os.commandLineParams()
    if params.len < 1:
        os.WriteLine(os.Get_stderr(),
            "usage: m3_issuance_bar_probe <absolute-artifact-path>")
        return 2
    let artifactPath = strings.CloneStr(params[0])
    return reportArtifact(artifactPath)
