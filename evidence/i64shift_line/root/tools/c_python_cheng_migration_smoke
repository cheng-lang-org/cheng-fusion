def run(cmd: list[str], *, stdout=None) -> None:
    subprocess.run(cmd, cwd=str(ROOT), check=True, stdout=stdout)


def require_contains(path: Path, needle: str) -> None:
    text = path.read_text(encoding="utf-8")
    if needle not in text:
        raise SystemExit(f"missing {needle!r} in {path}")


def require_not_contains(path: Path, needle: str) -> None:
    text = path.read_text(encoding="utf-8")
    if needle in text:
        raise SystemExit(f"unexpected {needle!r} in {path}")


def require_failed(cmd: list[str]) -> None:
    if subprocess.run(cmd, cwd=str(ROOT), text=True, capture_output=True).returncode == 0:
        raise SystemExit(f"command unexpectedly succeeded: {' '.join(cmd)}")


def require_same(left: Path, right: Path) -> None:
    if left.read_bytes() != right.read_bytes():
        raise SystemExit(f"files differ: {left} {right}")


def canonical_identity(path: Path, *, require_complete: bool) -> tuple[tuple[str, ...], str, str]:
    report = json.loads(path.read_text(encoding="utf-8"))
    if report.get("standard") != "csg_core::v1":
        raise SystemExit(f"invalid standard identity in {path}")
    if "factsRoot" in report:
        raise SystemExit(f"legacy factsRoot field in {path}")
    profiles = report.get("profiles")
    profile_set_cid = report.get("profile_set_cid")
    facts_root = report.get("facts_root")
    if not isinstance(profiles, list) or not all(isinstance(value, str) for value in profiles):
        raise SystemExit(f"invalid profiles in {path}")
    if not isinstance(profile_set_cid, str) or not isinstance(facts_root, str):
        raise SystemExit(f"invalid admission identity fields in {path}")
    if require_complete:
        if report.get("complete") is not True:
            raise SystemExit(f"expected complete report in {path}")
        if not profiles or profiles[0] != "csg_core" or profiles != sorted(set(profiles)):
            raise SystemExit(f"non-canonical profiles in {path}")
        if not profile_set_cid.startswith("sha256:") or len(profile_set_cid) != 71:
            raise SystemExit(f"invalid profile_set_cid in {path}")
        if not facts_root.startswith("sha256:") or len(facts_root) != 71:
            raise SystemExit(f"invalid facts_root in {path}")
    elif not facts_root:
        if profiles != [] or profile_set_cid != "":
            raise SystemExit(f"unbound incomplete report carries profile identity in {path}")
    return tuple(profiles), profile_set_cid, facts_root


def require_same_identity(*paths: Path) -> None:
    identities = [canonical_identity(path, require_complete=True) for path in paths]
    if any(identity != identities[0] for identity in identities[1:]):
        raise SystemExit(f"admission identities differ: {' '.join(str(path) for path in paths)}")


def write_json(path: Path, value: object) -> None:
    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")


def write_facts_without_first_param(source: Path, target: Path) -> None:
    lines: list[str] = []
    removed = False
    for line in source.read_text(encoding="utf-8").splitlines():
        fact = json.loads(line)
        if fact.get("kind") == "csg_dialect::native::param_i32" and not removed:
            removed = True
            continue
        lines.append(json.dumps(fact, sort_keys=True, separators=(",", ":")))
    if not removed:
        raise SystemExit(f"missing param_i32 fact in {source}")
    target.write_text("".join(f"{line}\n" for line in lines), encoding="utf-8")


