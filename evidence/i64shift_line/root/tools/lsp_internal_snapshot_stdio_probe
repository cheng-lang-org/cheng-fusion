def canonical_json(value: object) -> str:
    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    )


def unique_json_object(
    pairs: list[tuple[str, object]],
) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise RuntimeError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def stable_file_sha256(
    raw_path: str,
    label: str,
    *,
    executable: bool = False,
    single_link: bool = True,
    max_bytes: int = MAX_PINNED_FILE_BYTES,
) -> tuple[str, int]:
    path = Path(raw_path)
    require(path.is_absolute(), f"{label} path is not absolute")
    canonical = path.resolve(strict=True)
    require(canonical == path, f"{label} path is not canonical")
    before = path.lstat()
    require(
        not path.is_symlink()
        and path.is_file()
        and (before.st_nlink == 1 or not single_link)
        and 0 < before.st_size <= max_bytes,
        f"{label} is not a bounded regular single-link file",
    )
    if executable:
        require(before.st_mode & 0o111 != 0, f"{label} is not executable")
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        identity = (
            opened.st_dev,
            opened.st_ino,
            opened.st_mode,
            opened.st_nlink,
            opened.st_size,
            opened.st_mtime_ns,
            opened.st_ctime_ns,
        )
        require(
            identity
            == (
                before.st_dev,
                before.st_ino,
                before.st_mode,
                before.st_nlink,
                before.st_size,
                before.st_mtime_ns,
                before.st_ctime_ns,
            ),
            f"{label} changed before open",
        )
        digest = hashlib.sha256()
        observed = 0
        while observed < opened.st_size:
            chunk = os.read(descriptor, min(1024 * 1024, opened.st_size - observed))
            require(bool(chunk), f"{label} truncated while hashing")
            digest.update(chunk)
            observed += len(chunk)
        descriptor_after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    require(
        identity
        == (
            descriptor_after.st_dev,
            descriptor_after.st_ino,
            descriptor_after.st_mode,
            descriptor_after.st_nlink,
            descriptor_after.st_size,
            descriptor_after.st_mtime_ns,
            descriptor_after.st_ctime_ns,
        )
        == (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_nlink,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ),
        f"{label} changed while hashing",
    )
    return digest.hexdigest(), observed


def load_binding(
    binding_path_raw: str,
    executable: Path,
) -> tuple[dict[str, object], str]:
    binding_path = Path(binding_path_raw)
    require(binding_path.is_absolute(), "binding path is not absolute")
    binding_sha, binding_size = stable_file_sha256(
        str(binding_path),
        "stdio binding",
        max_bytes=MAX_BINDING_BYTES,
    )
    raw = binding_path.read_bytes()
    require(len(raw) == binding_size, "stdio binding size drift")
    require(
        hashlib.sha256(raw).hexdigest() == binding_sha,
        "stdio binding bytes changed after stable hash",
    )
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError("stdio binding is not UTF-8") from error
    require(
        text.endswith("\n") and "\r" not in text and "\n" not in text[:-1],
        "stdio binding must be one LF-terminated JSON line",
    )
    try:
        binding_document = json.loads(
            text[:-1],
            object_pairs_hook=unique_json_object,
        )
    except (json.JSONDecodeError, RuntimeError) as error:
        raise RuntimeError(f"stdio binding JSON is invalid: {error}") from error
    require(
        isinstance(binding_document, dict),
        "stdio binding is not an object",
    )
    require(
        set(binding_document) == BINDING_KEYS,
        "stdio binding field set drift",
    )
    require(
        binding_document.get("schema") == BINDING_SCHEMA,
        "stdio binding schema drift",
    )
    require(
        is_cid(binding_document.get("entryBuildCommandCid")),
        "stdio binding entry build command CID invalid",
    )
    for field in sorted(BINDING_KEYS - {"schema", "entryBuildCommandCid"}):
        pin = binding_document[field]
        require(
            isinstance(pin, dict) and set(pin) == BINDING_FILE_KEYS,
            f"stdio binding {field} pin shape drift",
        )
        path = pin.get("path")
        expected_sha = pin.get("sha256")
        require(
            isinstance(path, str)
            and isinstance(expected_sha, str)
            and is_cid(expected_sha),
            f"stdio binding {field} pin invalid",
        )
        observed_sha, _ = stable_file_sha256(
            path,
            f"stdio binding {field}",
            executable=field in ("entryExecutable", "officialCompiler", "toolchain"),
            single_link=field != "toolchain",
        )
        require(observed_sha == expected_sha, f"stdio binding {field} hash drift")
    require(
        Path(binding_document["entryExecutable"]["path"]) == executable,
        "stdio binding entry executable path split",
    )
    require(
        f"{canonical_json(binding_document)}\n" == text,
        "stdio binding is not canonical JSON",
    )
    return binding_document, binding_sha


def frame(message: dict[str, object]) -> bytes:
    body = json.dumps(message, separators=(",", ":")).encode("utf-8")
    return f"Content-Length: {len(body)}\r\n\r\n".encode("ascii") + body


def parse_frames(raw: bytes) -> list[dict[str, object]]:
    messages: list[dict[str, object]] = []
    cursor = 0
    while cursor < len(raw):
        header_end = raw.find(b"\r\n\r\n", cursor)
        if header_end < 0:
            raise RuntimeError(f"truncated response header at {cursor}")
        header_fields: dict[bytes, bytes] = {}
        for line in raw[cursor:header_end].split(b"\r\n"):
            key, separator, value = line.partition(b":")
            if not separator:
                raise RuntimeError("response header line has no colon")
            normalized = key.strip().lower()
            if normalized in header_fields:
                raise RuntimeError(
                    "duplicate response header: "
                    + normalized.decode("ascii", errors="replace")
                )
            header_fields[normalized] = value.strip()
        if b"content-length" not in header_fields:
            raise RuntimeError("response has no Content-Length")
        length_raw = header_fields[b"content-length"]
        if (
            not length_raw
            or any(byte not in b"0123456789" for byte in length_raw)
            or (len(length_raw) > 1 and length_raw.startswith(b"0"))
        ):
            raise RuntimeError("response Content-Length is not canonical")
        length = int(length_raw)
        if length <= 0 or length > MAX_RESPONSE_BYTES:
            raise RuntimeError("response Content-Length exceeds its bound")
        body_start = header_end + 4
        body_end = body_start + length
        if body_end > len(raw):
            raise RuntimeError("truncated response body")
        try:
            value = json.loads(
                raw[body_start:body_end],
                object_pairs_hook=unique_json_object,
            )
        except (json.JSONDecodeError, RuntimeError) as error:
            raise RuntimeError(f"response JSON is invalid: {error}") from error
        if not isinstance(value, dict):
            raise RuntimeError("response body is not an object")
        messages.append(value)
        cursor = body_end
    return messages


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def is_cid(value: object) -> bool:
    return (
        isinstance(value, str)
        and len(value) == 64
        and value != "0" * 64
        and all(character in "0123456789abcdef" for character in value)
    )


def is_exact_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def exact_receipt_fingerprint(
    response: dict[str, object], operation: str
) -> tuple[object, ...]:
    require(
        response.get("chengSourceVersion") == 2,
        f"{operation} source version drift",
    )
    for field in RECEIPT_CID_FIELDS:
        require(is_cid(response.get(field)), f"{operation} {field} missing")
    require(
        response.get("chengSnapshotRejected") is False,
        f"{operation} used a rejected snapshot",
    )
    for field in FAILURE_CID_FIELDS:
        require(
            response.get(field) == ZERO_CID,
            f"{operation} success retained nonzero {field}",
        )
    return tuple(response.get(field) for field in RECEIPT_FIELDS)


def result_receipt_rows(value: object) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    if isinstance(value, dict):
        present = [field for field in RECEIPT_FIELDS if field in value]
        if present:
            require(
                len(present) == len(RECEIPT_FIELDS),
                "partial nested semantic receipt: " + ",".join(present),
            )
            rows.append(value)
        for child in value.values():
            rows.extend(result_receipt_rows(child))
    elif isinstance(value, list):
        for child in value:
            rows.extend(result_receipt_rows(child))
    return rows


def exact_response_map(
    responses: list[dict[str, object]],
) -> dict[int, dict[str, object]]:
    require(len(responses) == 9, f"response count drift: {len(responses)}")
    for row in responses:
        require(row.get("jsonrpc") == "2.0", "response jsonrpc drift")
        require("id" in row, "response without id")
        field_set = set(row)
        if "result" in row:
            require(
                field_set == {"jsonrpc", "id", "result"},
                "success response top-level field set drift",
            )
        elif "error" in row:
            require(
                field_set == {"jsonrpc", "id", "error"},
                "error response top-level field set drift",
            )
        else:
            raise RuntimeError("response has neither result nor error")
        validate_known_cheng_fields(row)
    response_id_values = [row["id"] for row in responses]
    require(
        all(is_exact_int(value) for value in response_id_values),
        "response id is not an exact integer",
    )
    require(
        len(response_id_values) == len(set(response_id_values)),
        "duplicate response id",
    )
    require(
        set(response_id_values) == {1, 10, 11, 12, 13, 14, 15, 16, 17},
        f"response id set drift: {response_id_values}",
    )
    return {int(row["id"]): row for row in responses}


def validate_known_cheng_fields(value: object) -> None:
    if isinstance(value, dict):
        for key, child in value.items():
            require(isinstance(key, str), "response object key is not text")
            if key.startswith("cheng"):
                require(key in KNOWN_CHENG_FIELDS, f"unknown Cheng field: {key}")
            validate_known_cheng_fields(child)
    elif isinstance(value, list):
        for child in value:
            validate_known_cheng_fields(child)


def fixture_cid(label: str) -> str:
    return hashlib.sha256(label.encode("utf-8")).hexdigest()


def admission_binding_cid(
    admission_receipt: str,
    probe_fingerprint: str,
    query_fingerprint: str,
) -> str:
    for label, value in (
        ("admission receipt", admission_receipt),
        ("probe fingerprint", probe_fingerprint),
        ("query fingerprint", query_fingerprint),
    ):
        require(is_cid(value), f"{label} is not an exact nonzero CID")
    return hashlib.sha256(
        (
            "cheng.lsp_internal_snapshot_stdio_probe.admission.binding\0"
            + admission_receipt
            + probe_fingerprint
            + query_fingerprint
        ).encode("ascii")
    ).hexdigest()


def self_test() -> int:
    receipt: dict[str, object] = {
        "chengSourceVersion": 2,
        **{
            field: fixture_cid(field)
            for field in RECEIPT_CID_FIELDS
        },
        "chengSnapshotRejected": False,
        **{field: ZERO_CID for field in FAILURE_CID_FIELDS},
    }
    expected = (
        2,
        *(fixture_cid(field) for field in RECEIPT_CID_FIELDS),
        False,
        *(ZERO_CID for _ in FAILURE_CID_FIELDS),
    )
    require(
        exact_receipt_fingerprint(dict(receipt), "self-test-copy") == expected,
        "equal receipt fingerprint drift",
    )
    mutations: list[dict[str, object]] = []
    for field, value in (
        ("chengSourceVersion", 3),
        ("chengSemanticSnapshotCid", ZERO_CID),
        ("chengSnapshotRejected", True),
        ("chengFailureCargoCid", fixture_cid("failure")),
    ):
        candidate = dict(receipt)
        candidate[field] = value
        mutations.append(candidate)
    for index, candidate in enumerate(mutations):
        try:
            exact_receipt_fingerprint(candidate, f"mutation-{index}")
        except RuntimeError:
            continue
        raise RuntimeError(f"receipt mutation accepted: {index}")
    partial = {"chengSourceVersion": 2}
    try:
        result_receipt_rows({"result": partial})
    except RuntimeError:
        pass
    else:
        raise RuntimeError("partial nested receipt accepted")
    response_fixture = [
        {"jsonrpc": "2.0", "id": response_id, "result": None}
        for response_id in (1, 10, 11, 12, 13, 14, 15, 16, 17)
    ]
    exact_response_map(response_fixture)
    error_response_fixture = [
        *response_fixture[:-1],
        {
            "jsonrpc": "2.0",
            "id": 17,
            "error": {"code": -32603, "message": "synthetic"},
        },
    ]
    exact_response_map(error_response_fixture)
    response_mutations = (
        [
            *response_fixture[:-1],
            {"jsonrpc": "2.0", "id": 16, "result": None},
        ],
        [
            *response_fixture[:-1],
            {"jsonrpc": "2.1", "id": 17, "result": None},
        ],
        [
            *response_fixture[:-1],
            {"jsonrpc": "2.0", "result": None},
        ],
        [
            *response_fixture[:-1],
            {
                "jsonrpc": "2.0",
                "id": 17,
                "result": {"chengUnknownCompatibility": fixture_cid("unknown")},
            },
        ],
        [
            *response_fixture[:-1],
            {"jsonrpc": "2.0", "id": "17", "result": None},
        ],
        [
            *response_fixture[:-1],
            {
                "jsonrpc": "2.0",
                "id": 17,
                "result": None,
                "unexpectedTopLevel": True,
            },
        ],
        [
            *response_fixture[:-1],
            {
                "jsonrpc": "2.0",
                "id": 17,
                "result": None,
                "error": {"code": -32603, "message": "ambiguous"},
            },
        ],
    )
    for mutation_index, mutation in enumerate(response_mutations):
        try:
            exact_response_map(mutation)
        except RuntimeError:
            continue
        raise RuntimeError(
            f"response mutation accepted: {mutation_index}"
        )
    duplicate_json = (
        b'{"jsonrpc":"2.0","id":1,"id":2,"result":null}'
    )
    duplicate_frame = (
        f"Content-Length: {len(duplicate_json)}\r\n\r\n".encode("ascii")
        + duplicate_json
    )
    try:
        parse_frames(duplicate_frame)
    except RuntimeError:
        pass
    else:
        raise RuntimeError("duplicate JSON response key accepted")
    main_path_mutations = self_test_main_path()
    print("lsp_internal_snapshot_stdio_probe_self_test_mutations_rejected=13")
    print(
        "lsp_internal_snapshot_stdio_probe_"
        f"main_path_mutations_rejected={main_path_mutations}"
    )
    return 0


