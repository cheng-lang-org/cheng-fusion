                require(
                    isinstance(document_changes, list)
                    and len(document_changes) == 2
                    and all(
                        isinstance(change, dict)
                        and isinstance(change.get("textDocument"), dict)
                        and change["textDocument"].get("uri")
                        in (helper_uri, main_uri)
                        and is_exact_int(
                            change["textDocument"].get("version")
                        )
                        and isinstance(change.get("edits"), list)
                        and change["edits"]
                        and all(
                            isinstance(edit, dict)
                            and edit.get("newText") == "Renamed"
                            and is_exact_int(edit.get("chengSymbolId"))
                            and edit["chengSymbolId"] >= 0
                            and is_cid(edit.get("chengSymbolCid"))
                            for edit in change["edits"]
                        )
                        for change in document_changes
