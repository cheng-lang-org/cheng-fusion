                "compilerSnapshotBuilderAttemptCount": 2,
                "candidateBlockedReason": "",
            }
            results = {
                1: {},
                10: definition,
                11: references,
                12: rename,
                13: hover,
                14: completion,
                15: diagnostics,
                16: metrics,
                17: None,
            }
            responses = [
                {"jsonrpc": "2.0", "id": response_id, "result": result}
                for response_id, result in results.items()
            ]
            if os.getenv("CHENG_LSP_FAKE_UNKNOWN_TOP_LEVEL") == "1":
                responses[1]["unexpectedTopLevel"] = True
            sys.stdout.buffer.write(
                b"".join(frame(response) for response in responses)
            )
            '''
        ).lstrip()
    )

    def file_pin(path: Path) -> dict[str, str]:
        return {
            "path": str(path),
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        }

    def write_binding(path: Path, executable: Path) -> None:
        binding_document = {
            "schema": BINDING_SCHEMA,
            "entryExecutable": file_pin(executable),
            "officialCompiler": file_pin(executable),
            "compilerSource": file_pin(probe_path),
            "entrySource": file_pin(probe_path),
            "parserSource": file_pin(probe_path),
            "lspServerSource": file_pin(probe_path),
            "materializerSource": file_pin(probe_path),
            "grammarSource": file_pin(probe_path),
            "compilerCsgSource": file_pin(probe_path),
            "exportSurfaceSource": file_pin(probe_path),
            "toolchain": file_pin(executable),
            "sourceToolManifest": file_pin(probe_path),
            "entryBuildCommandCid": fixture_cid("self-test-entry-command"),
        }
        path.write_text(
            f"{canonical_json(binding_document)}\n",
            encoding="utf-8",
        )
        path.chmod(0o400)

    summary_re = re.compile(
        r"^lsp_internal_snapshot_stdio_probe: ok "
        r"candidate_attempt=([1-9][0-9]*) parser_observed=1 csg_observed=1 "
        r"builder_attempt=([1-9][0-9]*) published=1 missing_fact_bitmap=0 "
        r"semantic_queries=5 explicit_source_file_reads=2 "
        r"entry_executable=([0-9a-f]{64}) "
        r"probe_fingerprint=([0-9a-f]{64}) "
        r"query_fingerprint=([0-9a-f]{64}) "
        r"admission_receipt=([0-9a-f]{64}) "
        r"admission_binding_receipt=([0-9a-f]{64})$"
    )

    def run_probe(
        script: Path,
        executable: Path,
        binding: Path,
        *,
        unknown_top_level: bool = False,
    ) -> subprocess.CompletedProcess[bytes]:
        environment = os.environ.copy()
        if unknown_top_level:
            environment["CHENG_LSP_FAKE_UNKNOWN_TOP_LEVEL"] = "1"
        else:
            environment.pop("CHENG_LSP_FAKE_UNKNOWN_TOP_LEVEL", None)
        return subprocess.run(
            [
                str(python_executable),
                str(script),
                str(executable),
                str(binding),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            timeout=30,
            check=False,
        )

    def summary_match(completed: subprocess.CompletedProcess[bytes]) -> re.Match[str]:
        require(
            completed.returncode == 0,
            "synthetic main path failed: "
            + completed.stderr.decode(errors="replace"),
        )
        stdout = completed.stdout.decode("ascii")
        require(
            stdout.endswith("\n") and "\n" not in stdout[:-1],
            "synthetic main path output is not one LF-terminated line",
        )
        match = summary_re.fullmatch(stdout[:-1])
        require(match is not None, "synthetic main path summary drift")
        return match

    with tempfile.TemporaryDirectory(
        prefix="cheng-lsp-probe-main-self-test."
    ) as raw_root:
        root = Path(raw_root).resolve(strict=True)
        fake_lsp = root / "fake-lsp"
        fake_lsp.write_text(fake_source, encoding="utf-8")
        fake_lsp.chmod(0o700)
        binding_path = root / "binding.json"
        write_binding(binding_path, fake_lsp)

        positive = run_probe(probe_path, fake_lsp, binding_path)
        positive_match = summary_match(positive)
        expected_positive_binding = hashlib.sha256(
            (
                "cheng.lsp_internal_snapshot_stdio_probe.admission.binding\0"
                + positive_match.group(6)
                + positive_match.group(4)
                + positive_match.group(5)
            ).encode("ascii")
        ).hexdigest()
        require(
            positive_match.group(7) == expected_positive_binding,
            "positive main path admission binding split",
        )

        unknown = run_probe(
            probe_path,
            fake_lsp,
            binding_path,
            unknown_top_level=True,
        )
        require(
            unknown.returncode != 0
            and b"success response top-level field set drift" in unknown.stderr,
            "unknown top-level response field mutant survived main path",
        )

        main_start = probe_source.index("\ndef main() -> int:")
        main_end = probe_source.index("\n\nif __name__ == \"__main__\":", main_start)
        main_source = probe_source[main_start:main_end]
        shadow_token = "\n        workspace_binding = {\n"
        require(
            main_source.count(shadow_token) == 1,
            "workspace binding authority token missing or duplicate",
        )
        shadow_mutant = root / "probe-shadow-mutant.py"
        shadow_main = main_source.replace(
            shadow_token,
            "\n        binding = {\n",
            1,
        )
        workspace_consumer = "\n                    **workspace_binding,\n"
        require(
            shadow_main.count(workspace_consumer) == 2,
            "workspace binding consumer count drift",
        )
        shadow_main = shadow_main.replace(
            workspace_consumer,
            "\n                    **binding,\n",
        )
        require(
            shadow_main.count("exact_binding") >= 2,
            "exact binding authority consumer count drift",
        )
        shadow_main = shadow_main.replace("exact_binding", "binding")
        shadow_mutant.write_text(
            probe_source[:main_start] + shadow_main + probe_source[main_end:],
            encoding="utf-8",
        )
        shadow = run_probe(shadow_mutant, fake_lsp, binding_path)
        require(
            shadow.returncode != 0
            and b"KeyError: 'sourceToolManifest'" in shadow.stderr,
            "binding shadow mutant did not execute its main-path failure: "
            + shadow.stderr.decode(errors="replace"),
        )

        function_start = probe_source.index("def admission_binding_cid(")
        function_end = probe_source.index("\n\ndef self_test()", function_start)
        admission_function = probe_source[function_start:function_end]
        admission_domain = (
            "cheng.lsp_internal_snapshot_stdio_probe.admission.binding\\0"
        )
        require(
            admission_function.count(admission_domain) == 1,
            "admission binding domain missing or duplicate",
        )
        admission_mutant = root / "probe-admission-mutant.py"
        admission_mutant.write_text(
            (
                probe_source[:function_start]
                + admission_function.replace(
                    admission_domain,
                    "cheng.lsp_internal_snapshot_stdio_probe.admission.mutant\\0",
                    1,
                )
                + probe_source[function_end:]
            ),
            encoding="utf-8",
        )
        mutated_admission = run_probe(
            admission_mutant,
            fake_lsp,
            binding_path,
        )
        mutated_match = summary_match(mutated_admission)
        independently_expected = hashlib.sha256(
            (
                "cheng.lsp_internal_snapshot_stdio_probe.admission.binding\0"
                + mutated_match.group(6)
                + mutated_match.group(4)
                + mutated_match.group(5)
            ).encode("ascii")
        ).hexdigest()
        require(
            mutated_match.group(7) != independently_expected,
            "admission binding hash mutant escaped independent oracle",
        )
    return 3


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        return self_test()
    if len(sys.argv) != 3:
        raise RuntimeError(
