            attacked_stderr = attacked.stderr.decode(errors="replace")
            require(
                attacked.returncode != 0 and expected_error in attacked_stderr,
                f"startup attack {attack_name} did not hard-fail "
                f"rc={attacked.returncode} stderr={attacked_stderr}",
