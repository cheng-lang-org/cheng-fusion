                )
                == diagnostics_fingerprint,
                "diagnostics nested receipt fingerprint split",
            )
        diagnostic_items = diagnostics_result.get("items")
        require(
            diagnostics_result.get("kind") == "full"
            and is_cid(diagnostics_result.get("resultId"))
            and diagnostics_result.get("resultId")
            == diagnostics_result.get("chengSemanticSnapshotCid")
            and isinstance(diagnostic_items, list),
            "published diagnostics payload missing",
        )
        require(
            diagnostics_result.get("chengSnapshotRejected") is False,
            "published diagnostics receipt missing",
        )
        require(
            exact_receipt_fingerprint(
                diagnostics_result, "diagnostics.result"
            )
            == diagnostics_fingerprint,
            "diagnostics result receipt split",
        )
        for index, diagnostic_item in enumerate(diagnostic_items):
            require(
                isinstance(diagnostic_item, dict)
                and exact_receipt_fingerprint(
                    diagnostic_item, f"diagnostics.item[{index}]"
                )
                == diagnostics_fingerprint,
                "diagnostics item receipt split",
            )
        metrics_response = by_id.get(16)
        require(isinstance(metrics_response, dict), "metrics response missing")
        require(
            "error" not in metrics_response and "result" in metrics_response,
            "metrics response failed",
        )
        metrics = metrics_response.get("result")
        require(isinstance(metrics, dict), "metrics result missing")
        expected = {
            "candidateAttemptCount": 2,
            "candidateRejectedCount": 1,
            "candidatePublishedCount": 1,
            "candidateAdmissionMissingFactBitmap": 0,
            "currentSourceVersion": 2,
            "publishedSourceVersion": 2,
            "explicitSourceFileReadCount": 2,
            "explicitSourceFileReadBytes": 2
            * len("disk bytes must never feed CompilerCSG\n".encode("utf-8")),
            "queryAttemptCount": 6,
            "definitionQueryCount": 1,
            "referencesQueryCount": 1,
            "renameQueryCount": 1,
            "hoverQueryCount": 1,
            "completionQueryCount": 1,
            "diagnosticsQueryCount": 1,
        }
        for field, value in expected.items():
            require(
                is_exact_int(metrics.get(field)) and metrics.get(field) == value,
                f"metric {field} drift",
            )
        require(
            is_cid(metrics.get("candidateAdmissionReceiptCid")),
            "candidate admission receipt CID missing",
        )
        require(
            metrics.get("candidateAdmissionCompletedStageBitmap") == 28
            and is_exact_int(
                metrics.get("candidateAdmissionCompletedStageBitmap")
            ),
            "candidate admission completed stage bitmap drift",
        )
        diagnostic = json.dumps(metrics, sort_keys=True, separators=(",", ":"))
        stderr = completed.stderr.decode(errors="replace")
        require(
            metrics.get("parserBuildObserved") is True,
            f"parser build not observed metrics={diagnostic} stderr={stderr}",
        )
        require(
            metrics.get("compilerCsgBuildObserved") is True,
            f"CompilerCSG build not observed metrics={diagnostic} stderr={stderr}",
        )
        builder_attempt = metrics.get("compilerSnapshotBuilderAttemptCount")
        require(
            is_exact_int(builder_attempt) and builder_attempt > 0,
            "compiler snapshot builder attempt not observed",
        )
        blocked = metrics.get("candidateBlockedReason")
        require(
            isinstance(blocked, str) and blocked == "",
            "published candidate retained a blocked reason",
        )
        require(
            len(set(canonical_fingerprints)) == 1,
            "semantic query fingerprint split",
        )
        canonical_query_fingerprint = hashlib.sha256(
            canonical_json(
                [list(fingerprint) for fingerprint in canonical_fingerprints]
            ).encode("utf-8")
        ).hexdigest()
        admission_receipt = metrics["candidateAdmissionReceiptCid"]
        admission_binding_receipt = admission_binding_cid(
            admission_receipt,
            probe_fingerprint,
            canonical_query_fingerprint,
        )
        binding_after, binding_sha256_after = load_binding(
            sys.argv[2],
            executable,
        )
        require(
            binding_sha256_after == binding_sha256
            and canonical_json(binding_after) == canonical_json(exact_binding),
            "stdio binding or pinned child closure changed during probe",
        )
        print(
            "lsp_internal_snapshot_stdio_probe: ok "
            f"candidate_attempt={metrics['candidateAttemptCount']} "
            "parser_observed=1 csg_observed=1 "
            f"builder_attempt={builder_attempt} published=1 "
            "missing_fact_bitmap=0 semantic_queries=5 "
            "explicit_source_file_reads=2 "
            f"entry_executable={exact_binding['entryExecutable']['sha256']} "
            f"probe_fingerprint={probe_fingerprint} "
            f"query_fingerprint={canonical_query_fingerprint} "
            f"admission_receipt={admission_receipt} "
            f"admission_binding_receipt={admission_binding_receipt}"
        )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        sys.stderr.write(f"lsp_internal_snapshot_stdio_probe_error={error}\n")
        raise SystemExit(1)
