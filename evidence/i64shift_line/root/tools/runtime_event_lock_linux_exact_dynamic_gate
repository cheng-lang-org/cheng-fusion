def validate_root_identity_receipt(value: Any, label: str) -> dict[str, Any]:
    keys = {"pathFshex", "device", "inode", "mode", "uid", "gid"}
    if not isinstance(value, dict) or set(value) != keys:
        raise GateError(label + "_shape_invalid")
    if (
        not isinstance(value["pathFshex"], str)
        or not value["pathFshex"]
        or any(type(value[key]) is not int or value[key] < 0 for key in keys - {"pathFshex"})
        or value["uid"] != 0
        or stat.S_IMODE(value["mode"]) & 0o022 != 0
    ):
        raise GateError(label + "_value_invalid")
    return value


def validate_exact_authority_receipt(receipt: dict[str, Any]) -> None:
    closure = receipt.get("authorityClosure")
    if not isinstance(closure, dict) or set(closure) != AUTHORITY_CLOSURE_KEYS:
        raise GateError("exact_receipt_authority_closure_missing")
    ancestors = closure["ancestorLimitsEffective"]
    if not isinstance(ancestors, list) or not ancestors:
        raise GateError("exact_receipt_ancestor_limits_missing")
    for ancestor in ancestors:
        if not isinstance(ancestor, dict) or set(ancestor) != {
            "pathFshex",
            "memoryMaxBytes",
        }:
            raise GateError("exact_receipt_ancestor_limit_shape_invalid")
        maximum = ancestor["memoryMaxBytes"]
        if (
            not isinstance(ancestor["pathFshex"], str)
            or not ancestor["pathFshex"]
            or not (maximum == "max" or type(maximum) is int and maximum >= LIMIT_BYTES)
        ):
            raise GateError("exact_receipt_ancestor_limit_invalid")
    local_events = closure["memoryEventsLocal"]
    if not isinstance(local_events, dict) or set(local_events) != {
        "source",
        "beforeSha256",
        "afterSha256",
        "before",
        "after",
    }:
        raise GateError("exact_receipt_memory_events_local_shape_invalid")
    if local_events["source"] != "memory.events.local":
        raise GateError("exact_receipt_memory_events_local_source_invalid")
    require_sha(local_events["beforeSha256"], "memory_events_local_before")
    require_sha(local_events["afterSha256"], "memory_events_local_after")
    before_events = local_events["before"]
    after_events = local_events["after"]
    if (
        not isinstance(before_events, dict)
        or not isinstance(after_events, dict)
        or set(before_events) != set(after_events)
        or not before_events
        or any(
            not isinstance(key, str)
            or not key
            or type(value) is not int
            or value < 0
            for events in (before_events, after_events)
            for key, value in events.items()
        )
    ):
        raise GateError("exact_receipt_memory_events_local_values_invalid")
    if closure["cgroupKillUsed"] != 1 or closure["populatedAfterKill"] != 0:
        raise GateError("exact_receipt_cgroup_cleanup_invalid")
    root_before = validate_root_identity_receipt(
        closure["cgroupRootIdentityBefore"],
        "cgroup_root_before",
    )
    root_after = validate_root_identity_receipt(
        closure["cgroupRootIdentityAfter"],
        "cgroup_root_after",
    )
    if root_before != root_after or closure["cgroupRootOwnershipFrozen"] != 1:
        raise GateError("exact_receipt_cgroup_root_not_frozen")
    if (
        closure["atomicEvidenceCommit"]
        != "same_directory_temp_fsync_atomic_rename_directory_fsync"
    ):
        raise GateError("exact_receipt_atomic_evidence_invalid")


def parse_adapter_provider_audit(
    stdout: bytes,
    expected_artifact_sha256: str,
) -> dict[str, Any]:
    match = PROVIDER_AUDIT_ADAPTER_RE.fullmatch(stdout)
    if match is None:
        raise GateError("provider_audit_adapter_stdout_invalid")
    artifact_sha256 = match.group(1).decode("ascii")
    values = tuple(int(match.group(index)) for index in range(2, 9))
    artifact_stdout_sha256 = match.group(9).decode("ascii")
    if any(value > 2_147_483_647 for value in values):
        raise GateError("provider_audit_int32_overflow")
    (
        magic,
        registered_total,
        current_waiters,
        wake_call_total,
        wake_success_total,
        acquire_total,
        unlock_total,
    ) = values
    if artifact_sha256 != expected_artifact_sha256:
        raise GateError("provider_audit_artifact_sha256_mismatch")
    require_sha(artifact_stdout_sha256, "provider_audit_artifact_stdout")
    artifact_stdout_preimage = (
        "runtime_event_lock_provider_audit "
        + str(magic)
        + " "
        + str(registered_total)
        + " "
        + str(current_waiters)
        + " "
        + str(wake_call_total)
        + " "
        + str(wake_success_total)
        + " "
        + str(acquire_total)
        + " "
        + str(unlock_total)
        + "\n"
    ).encode("ascii")
    if sha256_bytes(artifact_stdout_preimage) != artifact_stdout_sha256:
        raise GateError("provider_audit_artifact_stdout_sha256_mismatch")
    if (
        magic != PROVIDER_AUDIT_MAGIC
        or registered_total < 4
        or current_waiters != 0
        or wake_call_total < 1
        or wake_success_total < 1
        or wake_success_total > wake_call_total
        or acquire_total != PROVIDER_AUDIT_TOTAL
        or unlock_total != PROVIDER_AUDIT_TOTAL
    ):
        raise GateError("provider_audit_invariant_invalid")
    normalized = (
        "runtime_event_lock_expected_exit=passed"
        + " case=contention-positive"
        + " artifact_sha256="
        + artifact_sha256
        + " audit_schema="
        + PROVIDER_AUDIT_SCHEMA
        + " magic="
        + str(magic)
        + " registered_total="
        + str(registered_total)
        + " current_waiters="
        + str(current_waiters)
        + " wake_call_total="
        + str(wake_call_total)
        + " wake_success_total="
        + str(wake_success_total)
        + " acquire_total="
        + str(acquire_total)
        + " unlock_total="
        + str(unlock_total)
        + " artifact_stdout_sha256="
        + artifact_stdout_sha256
        + "\n"
    ).encode("ascii")
    if stdout != normalized:
        raise GateError("provider_audit_adapter_stdout_not_canonical")
    return {
        "magic": magic,
        "registeredTotal": registered_total,
        "currentWaiters": current_waiters,
        "wakeCallTotal": wake_call_total,
        "wakeSuccessTotal": wake_success_total,
        "acquireTotal": acquire_total,
        "unlockTotal": unlock_total,
        "artifactStdoutSha256": artifact_stdout_sha256,
    }


def validate_provider_audit_receipt(
    receipt: dict[str, Any],
    stdout: bytes,
    provider_sha256: str,
    fixture_sha256: str,
    artifact_sha256: str,
) -> dict[str, Any]:
    commands = receipt.get("commands")
    if not isinstance(commands, list):
        raise GateError("provider_audit_commands_invalid")
    candidates = [
        item
        for item in commands
        if isinstance(item, dict) and item.get("id") == "run-contention"
    ]
    if len(candidates) != 1:
        raise GateError("provider_audit_command_missing")
    command = candidates[0]
    command_output_sha256 = require_sha(
        command.get("stdoutSha256"),
        "provider_audit_command_output",
    )
    if sha256_bytes(stdout) != command_output_sha256:
        raise GateError("provider_audit_command_output_sha256_mismatch")
    require_sha(provider_sha256, "provider_audit_provider")
    require_sha(fixture_sha256, "provider_audit_fixture")
    require_sha(artifact_sha256, "provider_audit_artifact")
    audit = parse_adapter_provider_audit(stdout, artifact_sha256)
    value = sealed_value(
        {
            "schema": PROVIDER_AUDIT_SCHEMA,
            "providerSha256": provider_sha256,
            "fixtureSha256": fixture_sha256,
            "artifactSha256": artifact_sha256,
            "artifactStdoutSha256": audit["artifactStdoutSha256"],
            "commandOutputSha256": command_output_sha256,
            "commandOutputBytes": len(stdout),
            "magic": audit["magic"],
            "registeredTotal": audit["registeredTotal"],
            "currentWaiters": audit["currentWaiters"],
            "wakeCallTotal": audit["wakeCallTotal"],
            "wakeSuccessTotal": audit["wakeSuccessTotal"],
            "acquireTotal": audit["acquireTotal"],
            "unlockTotal": audit["unlockTotal"],
        }
    )
    validate_seal(value, "provider_audit_receipt")
    return value


def invoke_exact_gate(
    manifest_path: Path,
    evidence_path: Path,
    timeout_seconds: int,
) -> tuple[dict[str, Any], dict[str, Any]]:
    completed = subprocess.run(
        [
            str(EXACT_GATE),
            "--manifest",
            str(manifest_path),
            "--evidence-dir",
            str(evidence_path),
        ],
        cwd=ROOT,
        env=BASE_ENV,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout_seconds,
        check=False,
    )
    if (
        completed.returncode != 0
        or not completed.stdout.startswith(b"csg_core_exact_1g_gate_status=passed\n")
        or completed.stderr
    ):
        raise GateError("exact_1g_subgate_failed")
    receipt_path = evidence_path / "receipt.json"
    validation = subprocess.run(
        [
            os.path.abspath(sys.executable),
            "-B",
            str(EXACT_VALIDATOR),
            "--evidence-dir",
            str(evidence_path),
            "--manifest",
            str(manifest_path),
            "--receipt",
            str(receipt_path),
        ],
        cwd=ROOT,
        env=BASE_ENV,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout_seconds,
        check=False,
    )
    if (
        validation.returncode != 0
        or validation.stdout != b"csg_core_exact_1g_receipt_validation=passed\n"
        or validation.stderr
    ):
        raise GateError("exact_1g_independent_validation_failed")
    receipt, identity = parse_json_file(receipt_path, "exact_receipt")
    validate_seal(receipt, "exact_receipt")
    expected = {
        "schema": EXACT_RECEIPT_SCHEMA,
        "status": "passed",
        "proofStatus": PROOF_STATUS,
        "hostSystem": "Linux",
        "limitBytes": LIMIT_BYTES,
        "swapBytes": SWAP_BYTES,
        "memoryScope": MEMORY_SCOPE,
        "processTreePlacement": PROCESS_TREE_PLACEMENT,
        "processTreeCompletion": PROCESS_TREE_COMPLETION,
        "userSpacePollingAuthority": 0,
    }
    for key, value in expected.items():
        if receipt.get(key) != value:
            raise GateError("exact_receipt_field_mismatch:" + key)
    validate_exact_authority_receipt(receipt)
    aggregate = receipt.get("aggregateProbe")
    commands = receipt.get("commands")
    if (
        not isinstance(aggregate, dict)
        or type(aggregate.get("oomKill")) is not int
        or aggregate["oomKill"] <= 0
        or aggregate.get("workloadRc") == 0
        or not isinstance(commands, list)
        or not commands
    ):
        raise GateError("exact_receipt_aggregate_or_commands_invalid")
    for command in commands:
        if (
            not isinstance(command, dict)
            or command.get("workloadRc") != 0
            or command.get("oomKill") != 0
            or not command.get("cgroupPathFshex")
        ):
            raise GateError("exact_receipt_command_invalid")
    return receipt, identity


def evidence_output(
    evidence: Path,
    command: dict[str, Any],
    field: str,
    label: str,
) -> bytes:
    relative = command.get(field)
    if not isinstance(relative, str) or not relative:
        raise GateError(label + "_relative_path_invalid")
    relative_path = PurePosixPath(relative)
    if (
        relative_path.is_absolute()
        or relative_path.as_posix() != relative
        or any(part in ("", ".", "..") for part in relative_path.parts)
    ):
        raise GateError(label + "_path_escape")
    candidate = evidence.joinpath(*relative_path.parts)
    return stable_read(candidate, label, MAX_RECEIPT_BYTES, allow_empty=True)


def validate_build_outputs(
    evidence: Path,
    receipt: dict[str, Any],
    expected_ids: set[str],
) -> None:
    commands = receipt["commands"]
    if {command.get("id") for command in commands} != expected_ids:
        raise GateError("build_output_id_set_mismatch")
    for command in commands:
        command_id = command["id"]
        stdout = evidence_output(
            evidence,
            command,
            "stdoutRelativePath",
            command_id + "_stdout",
        )
        stderr = evidence_output(
            evidence,
            command,
            "stderrRelativePath",
            command_id + "_stderr",
        )
        if stderr:
            raise GateError("build_stderr_not_empty:" + command_id)
        if (
            sha256_bytes(stdout) != command.get("stdoutSha256")
            or len(stdout) != command.get("stdoutBytes")
            or sha256_bytes(stderr) != command.get("stderrSha256")
            or len(stderr) != command.get("stderrBytes")
        ):
            raise GateError("build_output_receipt_mismatch:" + command_id)


def validate_command_outputs(
    evidence: Path,
    receipt: dict[str, Any],
    expected: dict[str, tuple[bytes | None, bytes]],
) -> dict[str, tuple[bytes, bytes]]:
    commands = receipt["commands"]
    if {command.get("id") for command in commands} != set(expected):
        raise GateError("command_output_id_set_mismatch")
    outputs: dict[str, tuple[bytes, bytes]] = {}
    for command in commands:
        command_id = command["id"]
        stdout = evidence_output(
            evidence,
            command,
            "stdoutRelativePath",
            command_id + "_stdout",
        )
        stderr = evidence_output(
            evidence,
            command,
            "stderrRelativePath",
            command_id + "_stderr",
        )
        expected_stdout, expected_stderr = expected[command_id]
        if expected_stdout is not None and stdout != expected_stdout:
            raise GateError("command_output_mismatch:" + command_id)
        if stderr != expected_stderr:
            raise GateError("command_stderr_mismatch:" + command_id)
        if (
            sha256_bytes(stdout) != command.get("stdoutSha256")
            or len(stdout) != command.get("stdoutBytes")
            or sha256_bytes(stderr) != command.get("stderrSha256")
            or len(stderr) != command.get("stderrBytes")
        ):
            raise GateError("command_output_receipt_mismatch:" + command_id)
        outputs[command_id] = (stdout, stderr)
    return outputs


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = GateArgumentParser(
        description="Produce exact Linux event-lock dynamic evidence",
    )
    parser.add_argument("--compiler", required=True)
    parser.add_argument("--run-uid", required=True, type=int)
    parser.add_argument("--run-gid", required=True, type=int)
    parser.add_argument("--evidence-dir", required=True)
    return parser.parse_args(argv)


def validate_run_identity(run_uid: int, run_gid: int) -> None:
    if run_uid <= 0 or run_gid <= 0:
        raise GateError("run_identity_must_be_non_root")
    try:
        pwd.getpwuid(run_uid)
        grp.getgrgid(run_gid)
    except KeyError as error:
        raise GateError("run_identity_unknown") from error


def run_gate(args: argparse.Namespace) -> None:
    check_linux_authority()
    validate_run_identity(args.run_uid, args.run_gid)
    evidence, evidence_parent_before = require_absent_evidence(Path(args.evidence_dir))
    target, elf_machine = expected_target()

    compiler = Path(args.compiler)
    compiler_before = require_canonical_file(
        compiler,
        "compiler",
        MAX_ARTIFACT_BYTES,
        executable=True,
    )
    validate_elf(compiler, compiler_before, elf_machine, "compiler")
    python_executable = Path(os.path.abspath(sys.executable))
    python_before = require_canonical_file(
        python_executable,
        "python",
        MAX_ARTIFACT_BYTES,
        executable=True,
    )
    gate_before = require_canonical_file(
        GATE_SOURCE,
        "dynamic_gate",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    static_gate_before = require_canonical_file(
        STATIC_GATE,
        "static_gate",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    exact_gate_before = require_canonical_file(
        EXACT_GATE,
        "exact_gate",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    exact_validator_before = require_canonical_file(
        EXACT_VALIDATOR,
        "exact_validator",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    exact_runner_before = require_canonical_file(
        EXACT_RUNNER,
        "exact_runner",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    adapter_before = require_canonical_file(
        EXIT_ADAPTER,
        "exit_adapter",
        MAX_SOURCE_BYTES,
        executable=True,
    )
    provider_before = require_canonical_file(
        LINUX_PROVIDER_SOURCE,
        "linux_provider",
        MAX_SOURCE_BYTES,
    )
    proof_source_before = require_canonical_file(
        PROOF_SOURCE,
        "proof_source",
        MAX_SOURCE_BYTES,
    )
    fixture_before = {
        fixture["id"]: require_canonical_file(
            fixture["path"],
            "fixture_" + fixture["id"],
            MAX_SOURCE_BYTES,
        )
        for fixture in FIXTURES
    }
    proof_constants_before = read_proof_constants()
    source_before, source_summary = source_manifest()

    os.mkdir(evidence, 0o700)
    os.chown(evidence, 0, 0)
    os.chmod(evidence, 0o700)
    evidence_root_before = require_secure_root_directory(evidence, "evidence_root")
    evidence_parent_frozen = require_secure_root_directory(
        evidence.parent,
        "evidence_parent_frozen",
    )
    write_exclusive(evidence / ".event-lock-evidence-owner", EVIDENCE_OWNER_MARKER, 0o400)
    workspace = evidence / "workspace"
    os.mkdir(workspace, 0o700)
    os.chown(workspace, args.run_uid, args.run_gid)
    source_manifest_path = evidence / "source-manifest.json"
    source_manifest_identity = write_canonical(source_manifest_path, source_before)
    binding_manifest_path = evidence / "binding-manifest.json"
    binding_manifest_identity = write_canonical(
        binding_manifest_path,
        {
            "schema": "cheng.runtime_event_lock_dynamic_bindings",
            "dynamicCompletionCredit": DYNAMIC_COMPLETION_CREDIT,
            "sourceSnapshot": {
                **source_summary,
                "manifestSha256": source_manifest_identity["sha256"],
            },
            "compiler": public_identity(compiler_before),
            "fixtures": [
                {
                    "id": fixture["id"],
                    "case": fixture["case"],
                    **public_identity(fixture_before[fixture["id"]]),
                }
                for fixture in FIXTURES
            ],
            "runtimeSources": {
                "linuxProvider": public_identity(provider_before),
                "proofSource": public_identity(proof_source_before),
            },
            "tools": {
                "dynamicGate": public_identity(gate_before),
                "staticGate": public_identity(static_gate_before),
                "exactGate": public_identity(exact_gate_before),
                "exactValidator": public_identity(exact_validator_before),
                "exactRunner": public_identity(exact_runner_before),
                "exitAdapter": public_identity(adapter_before),
                "python": public_identity(python_before),
            },
            "proofConstants": proof_constants_before,
            "evidenceParent": evidence_parent_frozen,
            "evidenceRoot": evidence_root_before,
        },
    )
    if evidence_parent_before["inode"] != evidence_parent_frozen["inode"]:
        raise GateError("evidence_parent_identity_drift")
    require_exact_runtime_capabilities()

    artifacts: dict[str, Path] = {}
    reports: dict[str, Path] = {}
    build_commands: list[dict[str, Any]] = []
    for fixture in FIXTURES:
        fixture_id = fixture["id"]
        artifact = workspace / (fixture_id + ".elf")
        report = workspace / (fixture_id + ".report")
        artifacts[fixture_id] = artifact
        reports[fixture_id] = report
        build_commands.append(
            make_command(
                "build-" + fixture_id,
                [
                    str(compiler),
                    "system-link-exec",
                    "--root:" + str(ROOT),
                    "--in:" + str(fixture["path"]),
                    "--emit:exe",
                    "--link-providers",
                    "--target:" + target,
                    "--out:" + str(artifact),
                    "--report-out:" + str(report),
                ],
                ROOT,
                1800,
            )
        )
    build_manifest_path = evidence / "build-manifest.json"
    write_canonical(
        build_manifest_path,
        exact_manifest(build_commands, args.run_uid, args.run_gid),
    )
    build_evidence = evidence / "build-exact-1g"
    build_receipt, build_receipt_identity = invoke_exact_gate(
        build_manifest_path,
        build_evidence,
        4 * 1800 + 600,
    )
    validate_build_outputs(
        build_evidence,
        build_receipt,
        {"build-" + fixture["id"] for fixture in FIXTURES},
    )

    artifact_before: dict[str, dict[str, Any]] = {}
    report_before: dict[str, dict[str, Any]] = {}
    for fixture in FIXTURES:
        fixture_id = fixture["id"]
        artifact = artifacts[fixture_id]
        report = reports[fixture_id]
        artifact_identity = require_canonical_file(
            artifact,
            "artifact_" + fixture_id,
            MAX_ARTIFACT_BYTES,
            executable=True,
        )
        validate_elf(artifact, artifact_identity, elf_machine, "artifact_" + fixture_id)
        artifact_before[fixture_id] = artifact_identity
        report_before[fixture_id] = require_canonical_file(
            report,
            "report_" + fixture_id,
            MAX_RECEIPT_BYTES,
        )

    run_commands: list[dict[str, Any]] = []
    expected_outputs: dict[str, tuple[bytes | None, bytes]] = {}
    for fixture in FIXTURES:
        fixture_id = fixture["id"]
        artifact = artifacts[fixture_id]
        command_id = "run-" + fixture_id
        argv = [
            str(python_executable),
            "-B",
            str(EXIT_ADAPTER),
            "--case",
            fixture["case"],
            "--artifact",
            str(artifact),
            "--artifact-sha256",
            artifact_before[fixture_id]["sha256"],
        ]
        expected_stdout: bytes | None = None
        if fixture["case"] != "contention-positive":
            expected_stdout = (
                "runtime_event_lock_expected_exit=passed case="
                + fixture["case"]
                + " artifact_sha256="
                + artifact_before[fixture_id]["sha256"]
                + "\n"
            ).encode("ascii")
        timeout = 120 if fixture["case"] == "contention-positive" else 60
        run_commands.append(make_command(command_id, argv, ROOT, timeout))
        expected_outputs[command_id] = (expected_stdout, b"")
    run_manifest_path = evidence / "run-manifest.json"
    write_canonical(
        run_manifest_path,
        exact_manifest(run_commands, args.run_uid, args.run_gid),
    )
    run_evidence = evidence / "run-exact-1g"
    run_receipt, run_receipt_identity = invoke_exact_gate(
        run_manifest_path,
        run_evidence,
        1200,
    )
    run_outputs = validate_command_outputs(
        run_evidence,
        run_receipt,
        expected_outputs,
    )
    provider_audit_receipt = validate_provider_audit_receipt(
        run_receipt,
        run_outputs["run-contention"][0],
        provider_before["sha256"],
        fixture_before["contention"]["sha256"],
        artifact_before["contention"]["sha256"],
    )
    provider_audit_path = evidence / "provider-audit-receipt.json"
    provider_audit_identity = write_canonical(
        provider_audit_path,
        provider_audit_receipt,
        0o400,
    )

    for fixture in FIXTURES:
        fixture_id = fixture["id"]
        if require_canonical_file(
            artifacts[fixture_id],
            "artifact_after_" + fixture_id,
            MAX_ARTIFACT_BYTES,
            executable=True,
        ) != artifact_before[fixture_id]:
            raise GateError("artifact_identity_drift:" + fixture_id)
        if require_canonical_file(
            reports[fixture_id],
            "report_after_" + fixture_id,
            MAX_RECEIPT_BYTES,
        ) != report_before[fixture_id]:
            raise GateError("report_identity_drift:" + fixture_id)
        if require_canonical_file(
            fixture["path"],
            "fixture_after_" + fixture_id,
            MAX_SOURCE_BYTES,
        ) != fixture_before[fixture_id]:
            raise GateError("fixture_identity_drift:" + fixture_id)
    source_after, source_summary_after = source_manifest()
    if source_after != source_before or source_summary_after != source_summary:
        raise GateError("source_tree_drift")
    if read_proof_constants() != proof_constants_before:
        raise GateError("proof_constants_drift")
    if require_canonical_file(
        compiler,
        "compiler_after",
        MAX_ARTIFACT_BYTES,
        executable=True,
    ) != compiler_before:
        raise GateError("compiler_identity_drift")
    unchanged_tools = (
        (GATE_SOURCE, gate_before, "dynamic_gate", True),
        (STATIC_GATE, static_gate_before, "static_gate", True),
        (EXACT_GATE, exact_gate_before, "exact_gate", True),
        (EXACT_VALIDATOR, exact_validator_before, "exact_validator", True),
        (EXACT_RUNNER, exact_runner_before, "exact_runner", True),
        (EXIT_ADAPTER, adapter_before, "exit_adapter", True),
        (LINUX_PROVIDER_SOURCE, provider_before, "linux_provider", False),
        (PROOF_SOURCE, proof_source_before, "proof_source", False),
        (python_executable, python_before, "python", True),
    )
    for path, before, label, executable in unchanged_tools:
        if require_canonical_file(
            path,
            label + "_after",
            MAX_ARTIFACT_BYTES,
            executable=executable,
        ) != before:
            raise GateError(label + "_identity_drift")
    if require_canonical_file(
        binding_manifest_path,
        "binding_manifest_after",
        MAX_RECEIPT_BYTES,
    ) != binding_manifest_identity:
        raise GateError("binding_manifest_identity_drift")
    if require_canonical_file(
        provider_audit_path,
        "provider_audit_receipt_after",
        MAX_RECEIPT_BYTES,
    ) != provider_audit_identity:
        raise GateError("provider_audit_receipt_identity_drift")
    if require_secure_root_directory(
        evidence,
        "evidence_root_after",
    ) != evidence_root_before:
        raise GateError("evidence_root_identity_drift")
    if require_secure_root_directory(
        evidence.parent,
        "evidence_parent_after",
    ) != evidence_parent_frozen:
        raise GateError("evidence_parent_identity_drift")
    raise GateError(
        "dynamic_credit_locked_zero_after_provider_audit_pending_proof_constants"
    )


def write_failure_receipt(evidence: Path, reason: str) -> str | None:
    if not evidence.is_absolute() or not os.path.lexists(evidence):
        return None
    try:
        evidence_root = require_secure_root_directory(evidence, "failure_evidence_root")
        evidence_parent = require_secure_root_directory(
            evidence.parent,
            "failure_evidence_parent",
        )
        marker = stable_read(
            evidence / ".event-lock-evidence-owner",
            "failure_evidence_owner",
            len(EVIDENCE_OWNER_MARKER),
        )
    except (GateError, OSError) as error:
        return "hard_red_receipt_root_unavailable:" + str(error)
    if marker != EVIDENCE_OWNER_MARKER:
        return "hard_red_receipt_owner_marker_invalid"
    binding_path = evidence / "binding-manifest.json"
    try:
        binding_identity = require_canonical_file(
            binding_path,
            "failure_binding_manifest",
            MAX_RECEIPT_BYTES,
        )
    except (GateError, OSError):
        binding_identity = None
    path = evidence / "receipt.hard-red.json"
    if os.path.lexists(path):
        return "hard_red_receipt_path_already_exists"
    value = sealed_value(
        {
            "schema": SCHEMA,
            "status": "HARD_RED",
            "dynamicCompletionCredit": DYNAMIC_COMPLETION_CREDIT,
            "hostSystem": platform.system(),
            "limitBytes": LIMIT_BYTES,
            "swapBytes": SWAP_BYTES,
            "preLockBarrier": "provider_owned_waiter_barrier",
            "providerAuditEvidence": "required_not_claimed_without_linux_run",
            "lostWakeProof": "not_promoted_without_provider_audit_receipt",
            "authorityClosure": "not_proved_extended_exact_1g_receipt_required",
            "bindingManifest": None
            if binding_identity is None
            else public_identity(binding_identity),
            "evidenceParent": evidence_parent,
            "evidenceRoot": evidence_root,
            "atomicEvidenceCommit": "same_directory_temp_fsync_atomic_rename_directory_fsync",
            "reason": reason.replace("\r", " ").replace("\n", " ")[:4096],
        }
    )
    try:
        os.chmod(evidence, 0o700)
        write_canonical(path, value, 0o400)
        fsync_directory(evidence)
        final_receipt, final_identity = parse_json_file(path, "hard_red_receipt")
        validate_seal(final_receipt, "hard_red_receipt")
        if final_identity["sha256"] != sha256_bytes(canonical_json(value) + b"\n"):
            raise GateError("hard_red_receipt_identity_mismatch")
        if require_secure_root_directory(
            evidence,
            "failure_evidence_root_after",
        ) != evidence_root:
            raise GateError("failure_evidence_root_identity_drift")
        if require_secure_root_directory(
            evidence.parent,
            "failure_evidence_parent_after",
        ) != evidence_parent:
            raise GateError("failure_evidence_parent_identity_drift")
    except (GateError, OSError) as error:
        return "hard_red_receipt_atomic_commit_failed:" + str(error)
    return None


def emit_hard_red(reason: str) -> None:
    print("runtime_event_lock_linux_exact_dynamic_status=HARD_RED", file=sys.stderr)
    print(
        "runtime_event_lock_linux_exact_dynamic_reason="
        + reason.replace("\r", " ").replace("\n", " "),
        file=sys.stderr,
    )
    print("dynamic_completion_credit=0", file=sys.stderr)
    print("proof_constants_promoted=0", file=sys.stderr)


def main(argv: Sequence[str]) -> int:
    if platform.system() != "Linux":
        emit_hard_red("linux_cgroup_v2_required")
        return 1
    evidence: Path | None = None
    try:
        args = parse_args(argv)
        evidence = Path(args.evidence_dir)
        run_gate(args)
        raise GateError("dynamic_gate_must_not_return_success_while_credit_is_zero")
    except (
        GateError,
        OSError,
        ValueError,
        TypeError,
        UnicodeError,
        subprocess.SubprocessError,
    ) as error:
        reason = str(error)
        if evidence is not None:
            receipt_error = write_failure_receipt(evidence, reason)
            if receipt_error is not None:
                reason = reason + ";" + receipt_error
        emit_hard_red(reason)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
