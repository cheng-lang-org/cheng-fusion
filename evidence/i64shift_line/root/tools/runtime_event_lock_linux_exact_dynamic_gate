def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def identity_tuple(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def require_lexical_absolute(path: Path, label: str) -> None:
    raw = os.fspath(path)
    if (
        not path.is_absolute()
        or "\x00" in raw
        or "\n" in raw
        or "\r" in raw
        or os.path.normpath(raw) != raw
    ):
        raise GateError(label + "_path_invalid")


def inspect_file(
    path: Path,
    label: str,
    max_bytes: int,
    *,
    executable: bool = False,
    allow_empty: bool = False,
    collect: bool = False,
) -> tuple[dict[str, Any], bytes | None]:
    require_lexical_absolute(path, label)
    try:
        before = os.lstat(path)
    except OSError as error:
        raise GateError(label + "_path_missing") from error
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or (not allow_empty and before.st_size <= 0)
        or before.st_size > max_bytes
        or (executable and before.st_mode & 0o111 == 0)
    ):
        raise GateError(label + "_identity_invalid")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    digest = hashlib.sha256()
    chunks: list[bytes] | None = [] if collect else None
    try:
        opened = os.fstat(descriptor)
        if identity_tuple(opened) != identity_tuple(before):
            raise GateError(label + "_open_race")
        if Path(os.path.realpath(path)) != path:
            raise GateError(label + "_path_not_canonical")
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise GateError(label + "_short_read")
            digest.update(chunk)
            if chunks is not None:
                chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise GateError(label + "_grew_during_read")
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = os.lstat(path)
    if (
        identity_tuple(before) != identity_tuple(closed)
        or identity_tuple(before) != identity_tuple(after)
    ):
        raise GateError(label + "_read_race")
    identity = {
        "pathFshex": os.fsencode(str(path)).hex(),
        "device": before.st_dev,
        "inode": before.st_ino,
        "mode": before.st_mode,
        "uid": before.st_uid,
        "gid": before.st_gid,
        "size": before.st_size,
        "mtimeNs": before.st_mtime_ns,
        "ctimeNs": before.st_ctime_ns,
        "sha256": digest.hexdigest(),
    }
    return identity, None if chunks is None else b"".join(chunks)


def require_canonical_file(
    path: Path,
    label: str,
    max_bytes: int,
    *,
    executable: bool = False,
    allow_empty: bool = False,
) -> dict[str, Any]:
    identity, _raw = inspect_file(
        path,
        label,
        max_bytes,
        executable=executable,
        allow_empty=allow_empty,
    )
    return identity


def stable_read(
    path: Path,
    label: str,
    max_bytes: int,
    *,
    allow_empty: bool = False,
) -> bytes:
    _identity, raw = inspect_file(
        path,
        label,
        max_bytes,
        allow_empty=allow_empty,
        collect=True,
    )
    if raw is None:
        raise GateError(label + "_read_size_exceeds_collect_limit")
    return raw


def directory_identity_tuple(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
    )


def require_secure_root_directory(path: Path, label: str) -> dict[str, Any]:
    require_lexical_absolute(path, label)
    try:
        before = os.lstat(path)
    except OSError as error:
        raise GateError(label + "_missing") from error
    if (
        not stat.S_ISDIR(before.st_mode)
        or before.st_uid != 0
        or stat.S_IMODE(before.st_mode) & 0o022 != 0
    ):
        raise GateError(label + "_root_owner_mode_required")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if directory_identity_tuple(opened) != directory_identity_tuple(before):
            raise GateError(label + "_open_race")
        if Path(os.path.realpath(path)) != path:
            raise GateError(label + "_not_canonical")
    finally:
        os.close(descriptor)
    after = os.lstat(path)
    if directory_identity_tuple(after) != directory_identity_tuple(before):
        raise GateError(label + "_identity_race")
    return {
        "pathFshex": os.fsencode(str(path)).hex(),
        "device": before.st_dev,
        "inode": before.st_ino,
        "mode": before.st_mode,
        "uid": before.st_uid,
        "gid": before.st_gid,
    }


def atomic_write(path: Path, raw: bytes, mode: int = 0o600) -> dict[str, Any]:
    require_lexical_absolute(path, "evidence_output")
    parent_identity = require_secure_root_directory(
        path.parent,
        "evidence_output_parent",
    )
    parent_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    parent_flags |= getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    parent_descriptor = os.open(path.parent, parent_flags)
    temporary_name = (
        "."
        + path.name
        + ".tmp."
        + str(os.getpid())
        + "."
        + secrets.token_hex(16)
    )
    temporary_descriptor = -1
    renamed = False
    try:
        parent_opened = os.fstat(parent_descriptor)
        if (
            parent_opened.st_dev != parent_identity["device"]
            or parent_opened.st_ino != parent_identity["inode"]
            or parent_opened.st_mode != parent_identity["mode"]
            or parent_opened.st_uid != 0
            or parent_opened.st_gid != parent_identity["gid"]
        ):
            raise GateError("evidence_output_parent_open_race")
        try:
            os.stat(path.name, dir_fd=parent_descriptor, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise GateError("evidence_output_already_exists")
        temporary_descriptor = os.open(
            temporary_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
            mode,
            dir_fd=parent_descriptor,
        )
        os.fchown(temporary_descriptor, 0, 0)
        os.fchmod(temporary_descriptor, mode)
        offset = 0
        while offset < len(raw):
            written = os.write(temporary_descriptor, raw[offset:])
            if written <= 0:
                raise GateError("evidence_write_failed")
            offset += written
        os.fsync(temporary_descriptor)
        written_info = os.fstat(temporary_descriptor)
        if (
            not stat.S_ISREG(written_info.st_mode)
            or written_info.st_nlink != 1
            or written_info.st_uid != 0
            or written_info.st_gid != 0
            or stat.S_IMODE(written_info.st_mode) != mode
            or written_info.st_size != len(raw)
        ):
            raise GateError("evidence_temporary_identity_invalid")
        try:
            os.stat(path.name, dir_fd=parent_descriptor, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise GateError("evidence_output_raced_before_rename")
        os.rename(
            temporary_name,
            path.name,
            src_dir_fd=parent_descriptor,
            dst_dir_fd=parent_descriptor,
        )
        renamed = True
        os.fsync(parent_descriptor)
    finally:
        if temporary_descriptor >= 0:
            os.close(temporary_descriptor)
        if not renamed:
            try:
                os.unlink(temporary_name, dir_fd=parent_descriptor)
            except FileNotFoundError:
                pass
        os.close(parent_descriptor)
    return require_canonical_file(path, "written_evidence", MAX_RECEIPT_BYTES)


def write_exclusive(path: Path, raw: bytes, mode: int = 0o600) -> dict[str, Any]:
    return atomic_write(path, raw, mode)


def write_canonical(path: Path, value: Any, mode: int = 0o600) -> dict[str, Any]:
    raw = canonical_json(value) + b"\n"
    return atomic_write(path, raw, mode)


def fsync_directory(path: Path) -> None:
    require_secure_root_directory(path, "fsync_directory")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


