def parse_json_file(path: Path, label: str) -> tuple[dict[str, Any], dict[str, Any]]:
    raw = stable_read(path, label, MAX_RECEIPT_BYTES)
    try:
        value = json.loads(raw.decode("utf-8", "strict"))
    except (ValueError, UnicodeError) as error:
        raise GateError(label + "_json_invalid") from error
    if not isinstance(value, dict) or raw != canonical_json(value) + b"\n":
        raise GateError(label + "_not_canonical")
    return value, require_canonical_file(path, label + "_identity", MAX_RECEIPT_BYTES)


def validate_seal(receipt: dict[str, Any], label: str) -> None:
    claimed = receipt.get("receiptSha256")
    if not isinstance(claimed, str) or SHA256_RE.fullmatch(claimed) is None:
        raise GateError(label + "_seal_invalid")
    unsigned = dict(receipt)
    del unsigned["receiptSha256"]
    if sha256_bytes(canonical_json(unsigned)) != claimed:
        raise GateError(label + "_seal_mismatch")


def missing_source_markers(
    path: Path,
    label: str,
    markers: Sequence[str],
) -> list[str]:
    raw = stable_read(path, label, MAX_SOURCE_BYTES)
    text = raw.decode("utf-8", "strict")
    return [label + ":" + marker for marker in markers if marker not in text]


