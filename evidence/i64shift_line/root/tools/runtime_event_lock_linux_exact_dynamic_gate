def check_linux_authority() -> None:
    if platform.system() != "Linux":
        raise GateError("linux_cgroup_v2_required")
    if os.geteuid() != 0:
        raise GateError("linux_root_supervisor_required")
    filesystems = Path("/proc/filesystems").read_text(encoding="ascii")
    controllers_path = Path("/sys/fs/cgroup/cgroup.controllers")
    if "cgroup2" not in filesystems or not controllers_path.is_file():
        raise GateError("linux_cgroup_v2_unavailable")
    controllers = controllers_path.read_text(encoding="ascii").split()
    if "memory" not in controllers:
        raise GateError("linux_cgroup_v2_memory_controller_unavailable")
    if not os.access("/sys/fs/cgroup", os.W_OK | os.X_OK):
        raise GateError("linux_cgroup_v2_root_not_writable")


def expected_target() -> tuple[str, int]:
    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "x86_64-unknown-linux-gnu", 62
    if machine in ("aarch64", "arm64"):
        return "aarch64-unknown-linux-gnu", 183
    raise GateError("linux_machine_unsupported")


def validate_elf(path: Path, identity: dict[str, Any], machine: int, label: str) -> None:
    descriptor = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        if (
            os.fstat(descriptor).st_dev != identity["device"]
            or os.fstat(descriptor).st_ino != identity["inode"]
        ):
            raise GateError(label + "_elf_open_race")
        header = os.read(descriptor, 64)
    finally:
        os.close(descriptor)
    if (
        len(header) < 20
        or header[:4] != b"\x7fELF"
        or header[4] != 2
        or header[5] != 1
        or header[6] != 1
        or int.from_bytes(header[16:18], "little") not in (2, 3)
        or int.from_bytes(header[18:20], "little") != machine
    ):
        raise GateError(label + "_elf_identity_invalid")
    if require_canonical_file(path, label + "_elf_after", MAX_ARTIFACT_BYTES, executable=True) != identity:
        raise GateError(label + "_elf_read_race")


def source_paths() -> list[Path]:
    result: list[Path] = []
    for name in ("package_id", "cheng-package.toml", "cheng.lock.toml"):
        metadata = ROOT / name
        if metadata.is_file():
            result.append(metadata)
    source_root = ROOT / "src"
    for directory, directories, files in os.walk(source_root, followlinks=False):
        base = Path(directory)
        for name in tuple(directories):
            candidate = base / name
            if candidate.is_symlink():
                raise GateError("source_tree_symlink_directory")
        for name in files:
            candidate = base / name
            if candidate.is_symlink():
                raise GateError("source_tree_symlink_file")
            if candidate.suffix == ".cheng":
                result.append(candidate)
    result.sort(key=lambda item: os.fsencode(item.relative_to(ROOT).as_posix()))
    if not result:
        raise GateError("source_tree_empty")
    return result


def source_manifest() -> tuple[dict[str, Any], dict[str, Any]]:
    entries: list[dict[str, Any]] = []
    for index, path in enumerate(source_paths()):
        identity = require_canonical_file(path, f"source_{index}", MAX_SOURCE_BYTES)
        entries.append(
            {
                "path": path.relative_to(ROOT).as_posix(),
                "sha256": identity["sha256"],
                "size": identity["size"],
            }
        )
    tree_raw = canonical_json(entries)
    manifest = {
        "schema": SOURCE_MANIFEST_SCHEMA,
        "rootPathFshex": os.fsencode(str(ROOT)).hex(),
        "fileCount": len(entries),
        "sourceTreeSha256": sha256_bytes(tree_raw),
        "entries": entries,
    }
    return manifest, {
        "fileCount": len(entries),
        "sourceTreeSha256": manifest["sourceTreeSha256"],
    }


def read_proof_constants() -> dict[str, int]:
    raw = stable_read(PROOF_SOURCE, "proof_source", MAX_SOURCE_BYTES)
    text = raw.decode("utf-8", "strict")
    result: dict[str, int] = {}
    for name in PROOF_CONSTANTS:
        matches = re.findall(
            r"^[ \t]*" + re.escape(name) + r": int32 = ([0-9]+)[ \t]*$",
            text,
            re.MULTILINE,
        )
        if matches != ["0"]:
            raise GateError("proof_constant_must_remain_zero:" + name)
        result[name] = 0
    return result


