import std/system
import std/strutils as strutil
import std/thread
import std/hashmaps

@importc("cheng_monotime_ns")
fn monotimeNs(): int64

@importc("write")
fn baselineWrite(fd: int32, raw: ptr, count: int32): int32

@importc("cheng_malloc")
fn baselineMalloc(size: int32): ptr

@importc("__cheng_runtime_atomic_add_i32")
fn baselineAtomicAddI32(p: ptr, delta: int32): int32

fn nsPerOp(elapsed: int64, count: int32): int64 =
    if elapsed <= int64(0):
        return int64(1)
    let c = int64(count)
    return (elapsed + c - int64(1)) / c

fn emit(name: str, ns: int64) =
    echo(strutil.Join([name, "_cheng_ns_per_op=", int64ToStr(ns)], ""))

fn emptyThreadMain(raw: ptr) =
    let _ = raw

fn benchOrc(iters: int32): int64 =
    let raw = baselineMalloc(8)
    assert(raw != nil, " runtime baseline cheng: orc malloc")
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        memRetainAtomic(raw)
        memReleaseAtomic(raw)
    let elapsed = monotimeNs() - start
    memReleaseAtomic(raw)
    return nsPerOp(elapsed, iters)

fn benchAtomic(iters: int32): int64 =
    var cell: int32
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        let _ = baselineAtomicAddI32(&cell, 1)
    let elapsed = monotimeNs() - start
    return nsPerOp(elapsed, iters)

fn benchThread(iters: int32): int64 =
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        let t = thread.StartPtr(&emptyThreadMain, nil)
        assert(thread.JoinThread(t), " runtime baseline cheng: thread join")
    let elapsed = monotimeNs() - start
    return nsPerOp(elapsed, iters)

fn benchSliceBounds(iters: int32): int64 =
    var data: int32[128]
    var initIndex: int32
    for initIndex in initIndex..<int32(128):
        data[initIndex] = initIndex
    var sum: int32
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        sum = sum + data[i & 127]
    let elapsed = monotimeNs() - start
    if sum == -1:
        echo("impossible")
    return nsPerOp(elapsed, iters)

fn benchHashLookup(iters: int32): int64 =
    var m = hashmaps.HashMapStrIntInit(128)
    hashmaps.HashMapStrIntPut(m, "alpha", 11)
    hashmaps.HashMapStrIntPut(m, "beta", 22)
    hashmaps.HashMapStrIntPut(m, "gamma", 33)
    var found: bool
    var sum: int32
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        if (i & 1) == 0:
            sum = sum + hashmaps.HashMapStrIntGetMutEx(m, "beta", found)
        else:
            sum = sum + hashmaps.HashMapStrIntGetMutEx(m, "gamma", found)
    let elapsed = monotimeNs() - start
    if sum == -1:
        echo("impossible")
    return nsPerOp(elapsed, iters)

fn benchSyscallWrite(iters: int32): int64 =
    let start = monotimeNs()
    var i: int32
    for i in i..<iters:
        let _ = baselineWrite(1, "", 0)
    let elapsed = monotimeNs() - start
    return nsPerOp(elapsed, iters)

fn main(): int32 =
    emit("orc_retain_release", benchOrc(200000))
    emit("atomic_i32_add", benchAtomic(200000))
    emit("thread_spawn_join", benchThread(200))
    emit("slice_bounds_loop", benchSliceBounds(500000))
    emit("hash_lookup", benchHashLookup(200000))
    emit("syscall_write", benchSyscallWrite(20000))
    return 0
