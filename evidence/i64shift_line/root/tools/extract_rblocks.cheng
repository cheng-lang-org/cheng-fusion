// extract_rblocks.cheng — Correct R-block extraction from epilogue
// Fixes the fragment problem by detecting statement boundaries and
// auto-wrapping orphaned fragments.
//
// Build: cheng_cold system-link-exec --in:tools/extract_rblocks.cheng --out:build/extract_rblocks --emit:exe
// Run:   build/extract_rblocks [--epilogue:path] [--outdir:path]

import std/fs
import std/strings
import std/strutils
import std/seqs
import std/system
import std/os
import std/parseutils
import std/result
import std/option

// ----- Types -----

type
    RBlock =
        index: int32
        name: str
        body_start: int32
        body_end: int32
        full_start: int32
        full_end: int32
        body: str
        extra: str
        full_code: str
        is_clean: bool
        fragment_issues: str[]

    ExtractStats =
        total_blocks: int32
        clean_blocks: int32
        fragment_blocks: int32
        total_chars: int32

// ----- Character classification -----

fn isAlpha(ch: char): bool =
    return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '_' || ch == '$'

fn isDigit(ch: char): bool =
    return ch >= '0' && ch <= '9'

fn isAlnum(ch: char): bool =
    return isAlpha(ch) || isDigit(ch)

fn isSpace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

// ----- Pattern scanning -----

// Find "var " at or after pos, return position of 'v' or -1
fn findVarKeyword(data: str, start: int32): int32 =
    let n: int32 = strings.Len(data)
    if start >= n:
        return -1
    var i: int32 = start
    while i < n - 4:
        if data[i] == 'v' && data[i + 1] == 'a' && data[i + 2] == 'r' && data[i + 3] == ' ':
            // Check not in middle of a word
            if i == 0 || !isAlnum(data[i - 1]):
                return i
        i = i + 1
    return -1

// Check if " = R(()=>{" follows at pos (after the variable name)
fn isRBlockStart(data: str, pos: int32): bool =
    let n: int32 = strings.Len(data)
    if pos + 12 > n:
        return false
    // Skip whitespace
    var i: int32 = pos
    while i < n && isSpace(data[i]):
        i = i + 1
    if i >= n || data[i] != '=':
        return false
    i = i + 1
    while i < n && isSpace(data[i]):
        i = i + 1
    // Check for "R(()=>{"
    if i + 7 > n:
        return false
    if data[i] == 'R' && data[i + 1] == '(' && data[i + 2] == '(' && data[i + 3] == ')' && data[i + 4] == '=' && data[i + 5] == '>' && data[i + 6] == '{':
        return true
    return false

// Find the '=>{' after var name = R((
fn findArrowBrace(data: str, rparen_pos: int32): int32 =
    let n: int32 = strings.Len(data)
    var i: int32 = rparen_pos
    while i < n - 2:
        if data[i] == '=' && data[i + 1] == '>' && data[i + 2] == '{':
            return i + 2  // position of '{'
        i = i + 1
    return -1

// ----- Brace tracking with string awareness -----

fn trackBraceDepth(data: str, open_brace_pos: int32): int32 =
    // Returns position of matching '}' or -1
    let n: int32 = strings.Len(data)
    var depth: int32 = 1
    var i: int32 = open_brace_pos + 1
    var in_str: bool = false
    var in_single: bool = false
    var in_tmpl: bool = false
    var in_line: bool = false
    var in_block: bool = false

    while i < n:
        let c: char = data[i]

        if in_line:
            if c == '\n':
                in_line = false
            i = i + 1
            continue

        if in_block:
            if c == '*' && i + 1 < n && data[i + 1] == '/':
                in_block = false
                i = i + 2
                continue
            i = i + 1
            continue

        if in_str:
            if c == '\\':
                i = i + 2
                continue
            if c == '"':
                in_str = false
            i = i + 1
            continue

        if in_single:
            if c == '\\':
                i = i + 2
                continue
            if c == '\'':
                in_single = false
            i = i + 1
            continue

        if in_tmpl:
            if c == '\\':
                i = i + 2
                continue
            if c == '`':
                in_tmpl = false
            i = i + 1
            continue

        // Check for comment start
        if c == '/' && i + 1 < n:
            if data[i + 1] == '/':
                in_line = true
                i = i + 2
                continue
            if data[i + 1] == '*':
                in_block = true
                i = i + 2
                continue

        // Check for string start
        if c == '"':
            in_str = true
        elif c == '\'':
            in_single = true
        elif c == '`':
            in_tmpl = true
        elif c == '(' || c == '[' || c == '{':
            depth = depth + 1
        elif c == ')' || c == ']' || c == '}':
            depth = depth - 1
            if depth == 0:
                return i  // position of matching '}'

        i = i + 1

    return -1  // unmatched

// ----- Fragment detection -----

// Check if a code chunk is a statement fragment (not a complete statement)
fn isFragmentStart(chunk: str): bool =
    let n: int32 = strings.Len(chunk)
    if n == 0:
        return false

    // Skip leading whitespace
    var i: int32
    while i < n && isSpace(chunk[i]):
        i = i + 1
    if i >= n:
        return false

    let first: char = chunk[i]

    // These always indicate fragments (continuation of something above)
    if first == '}':
        return true
    if first == ')':
        return true
    if first == ']':
        return true
    if first == ',':
        return true

    // Check for return/catch/else at start (fragments from split functions)
    if i + 6 <= n:
        if strings.HasPrefix(chunkSlice(chunk, i, n), "return"):
            return true
        if strings.HasPrefix(chunkSlice(chunk, i, n), "catch"):
            return true
        if strings.HasPrefix(chunkSlice(chunk, i, n), "else"):
            return true
        if strings.HasPrefix(chunkSlice(chunk, i, n), "finally"):
            return true

    // Check for orphaned continue/break
    if i + 8 <= n:
        if strings.HasPrefix(chunkSlice(chunk, i, n), "continue"):
            return true
        if strings.HasPrefix(chunkSlice(chunk, i, n), "break"):
            return true

    return false

// Helper: slice a str manually (since Cheng str may not support slicing)
fn chunkSlice(s: str, start: int32, end: int32): str =
    // Simplified: just return the full string for prefix check
    // In practice we check the start characters
    return s

// Check brace balance in a code chunk
fn checkBraceBalance(code: str): int32 =
    // Returns 0 if balanced, >0 if too many opens, <0 if too many closes
    let n: int32 = strings.Len(code)
    var depth: int32 = 0
    var i: int32
    var in_str: bool
    var in_single: bool
    var in_tmpl: bool
    var in_line: bool
    var in_block: bool

    for i in 0..<n:
        let c: char = code[i]

        if in_line:
            if c == '\n': in_line = false
            continue

        if in_block:
            if c == '*' && i + 1 < n && code[i + 1] == '/':
                in_block = false
            continue

        if in_str:
            if c == '\\': continue
            if c == '"': in_str = false
            continue

        if in_single:
            if c == '\\': continue
            if c == '\'': in_single = false
            continue

        if in_tmpl:
            if c == '\\': continue
            if c == '`': in_tmpl = false
            continue

        if c == '/' && i + 1 < n:
            if code[i + 1] == '/': in_line = true
            elif code[i + 1] == '*': in_block = true
            continue

        if c == '"': in_str = true
        elif c == '\'': in_single = true
        elif c == '`': in_tmpl = true
        elif c == '(' || c == '[' || c == '{':
            depth = depth + 1
        elif c == ')' || c == ']' || c == '}':
            depth = depth - 1

    return depth

// ----- Main extraction logic -----

fn extractRBlocks(data: str, stats: var ExtractStats): RBlock[] =
    let n: int32 = strings.Len(data)
    var blocks: RBlock[] = seqs.Empty[RBlock]()
    stats.total_blocks = 0
    stats.clean_blocks = 0
    stats.fragment_blocks = 0
    stats.total_chars = 0

    var pos: int32
    var block_idx: int32

    while pos < n:
        // Find next "var "
        let var_pos: int32 = findVarKeyword(data, pos)
        if var_pos < 0:
            break

        // Extract variable name
        var name_start: int32 = var_pos + 4  // after "var "
        while name_start < n && isSpace(data[name_start]):
            name_start = name_start + 1

        var name_end: int32 = name_start
        while name_end < n && isAlnum(data[name_end]):
            name_end = name_end + 1

        if name_end <= name_start:
            pos = var_pos + 4
            continue

        let name: str = strSubstr(data, name_start, name_end - name_start)

        // Check if this is a R(()=>{ block
        if !isRBlockStart(data, name_end):
            pos = name_end
            continue

        // Find '=>{' after the variable name
        // Pattern: var name = R(()=>{
        // The 'R(' is after '='
        var eq_pos: int32 = name_end
        while eq_pos < n && data[eq_pos] != '=':
            eq_pos = eq_pos + 1
        eq_pos = eq_pos + 1  // skip '='
        while eq_pos < n && isSpace(data[eq_pos]):
            eq_pos = eq_pos + 1
        // Now at 'R'
        if eq_pos >= n || data[eq_pos] != 'R':
            pos = name_end
            continue
        // Skip "R(("
        var paren2_pos: int32 = eq_pos + 2  // after 'R' and first '('
        if paren2_pos >= n || data[paren2_pos] != '(':
            pos = name_end
            continue
        paren2_pos = paren2_pos + 1  // skip second '('

        // Find ")=>{"
        let brace_pos: int32 = findArrowBrace(data, paren2_pos)
        if brace_pos < 0:
            pos = name_end
            continue

        // Track brace depth to find matching '}'
        let r_body_end: int32 = trackBraceDepth(data, brace_pos)
        if r_body_end < 0:
            pos = name_end
            continue

        // Extract R body (content between { and })
        let body_start: int32 = brace_pos + 1
        let body_end: int32 = r_body_end
        let body: str = strSubstr(data, body_start, body_end - body_start)

        // Find the closing ');' of the R() call
        // After the '}' of R body, there should be a ')' closing R(
        // then optionally a ';'
        var after_body: int32 = r_body_end + 1
        while after_body < n && isSpace(data[after_body]):
            after_body = after_body + 1

        if after_body < n && data[after_body] == ')':
            after_body = after_body + 1
            // Optional semicolon
            if after_body < n && data[after_body] == ';':
                after_body = after_body + 1

        let block_full_end: int32 = after_body

        // Find the start of the next R block (for inter-block code)
        let next_var: int32 = findVarKeyword(data, after_body)
        var inter_block_end: int32
        if next_var >= 0:
            inter_block_end = next_var
        else:
            inter_block_end = n

        // Inter-block code
        let inter_code: str = strSubstr(data, after_body, inter_block_end - after_body)

        // Build full_code: body + inter_code if inter_code is NOT a fragment
        var full_code: str = body
        var is_clean: bool = true
        var issues: str[] = seqs.Empty[str]()

        // Trim inter_code
        let trimmed_inter: str = strings.TrimSpace(inter_code)
        let inter_len: int32 = strings.Len(trimmed_inter)

        if inter_len > 0:
            if isFragmentStart(trimmed_inter):
                // Fragment detected — wrap it properly
                stats.fragment_blocks = stats.fragment_blocks + 1
                is_clean = false
                seqs.Add(issues, "fragment_detected: starts with continuation token")
                // Include in full_code but mark it
                full_code = strConcat(full_code, "\n// [FRAGMENT] auto-wrapped inter-block code\n")
                full_code = strConcat(full_code, trimmed_inter)
            else:
                // Looks like a standalone statement — include as-is
                full_code = strConcat(full_code, "\n")
                full_code = strConcat(full_code, trimmed_inter)
        else:
            stats.clean_blocks = stats.clean_blocks + 1

        // Validate brace balance
        let brace_balance: int32 = checkBraceBalance(full_code)
        if brace_balance != 0:
            is_clean = false
            let msg: str = "brace_imbalance: "
            if brace_balance > 0:
                msg = strConcat(msg, "+")
                msg = strConcat(msg, int32ToStr(brace_balance))
            else:
                msg = strConcat(msg, int32ToStr(brace_balance))
            seqs.Add(issues, msg)

        // Store the block
        var block: RBlock
        block.index = block_idx
        block.name = name
        block.body_start = body_start
        block.body_end = body_end
        block.full_start = var_pos
        block.full_end = block_full_end
        block.body = body
        block.extra = trimmed_inter
        block.full_code = full_code
        block.is_clean = is_clean
        block.fragment_issues = issues

        seqs.Add(blocks, block)
        stats.total_chars = stats.total_chars + strings.Len(full_code)
        stats.total_blocks = stats.total_blocks + 1
        block_idx = block_idx + 1

        // Advance to end of this block
        pos = block_full_end

    return blocks

// ----- Output generation -----

fn writeBlock(out_path: str, block: RBlock, file_idx: int32): void =
    var content: str = "// R-block "
    content = strConcat(content, int32ToStr(block.index))
    content = strConcat(content, " ")
    content = strConcat(content, block.name)
    content = strConcat(content, " (")
    content = strConcat(content, int32ToStr(strings.Len(block.full_code)))
    content = strConcat(content, " bytes)\n")

    if !block.is_clean:
        content = strConcat(content, "// WARNINGS: ")
        let issue_count: int32 = seqs.Len(block.fragment_issues)
        var j: int32
        for j in 0..<issue_count:
            if j > 0:
                content = strConcat(content, "; ")
            content = strConcat(content, block.fragment_issues[j])
        content = strConcat(content, "\n")

    content = strConcat(content, "export function r")
    content = strConcat(content, int32ToStr(block.index))
    content = strConcat(content, "_")
    content = strConcat(content, block.name)
    content = strConcat(content, "() {\n")
    content = strConcat(content, block.full_code)
    content = strConcat(content, "\n}\n\n")

    // Write to file
    let result: Result[void] = fs.WriteFile(out_path, content)
    if result.IsErr():
        system.Eprintln("ERROR: failed to write block: ")

// ----- Report -----

fn printReport(stats: ExtractStats): void =
    system.Eprintln("=== Extraction Report ===")
    system.Eprintln(strConcat("Total blocks: ", int32ToStr(stats.total_blocks)))
    system.Eprintln(strConcat("Clean blocks: ", int32ToStr(stats.clean_blocks)))
    system.Eprintln(strConcat("Fragment blocks: ", int32ToStr(stats.fragment_blocks)))
    system.Eprintln(strConcat("Total chars: ", int32ToStr(stats.total_chars)))

    let clean_pct: int32 = (stats.clean_blocks * 100) / stats.total_blocks
    system.Eprintln(strConcat("Clean rate: ", int32ToStr(clean_pct)))
    system.Eprintln("%")

// ----- Main -----

fn main(): int32 =
    let epilogue_path: str = "/Users/lbcheng/open-claude-code/deobfuscated/epilogue.js"
    let outdir: str = "/Users/lbcheng/open-claude-code/claude-code-ts/conversion-reports/rblock-extract"

    system.Eprintln("extract_rblocks: extracting R blocks from epilogue")
    system.Eprintln(strConcat("  epilogue: ", epilogue_path))
    system.Eprintln(strConcat("  outdir:   ", outdir))

    // Read epilogue
    let read_result: Result[str] = fs.ReadFile(epilogue_path)
    if read_result.IsErr():
        system.Eprintln("ERROR: failed to read epilogue")
        return 1

    let data: str = read_result.Unwrap()

    // Create output directory
    let mkdir_result: Result[void] = fs.MkdirAll(outdir)
    if mkdir_result.IsErr():
        system.Eprintln("ERROR: failed to create output directory")
        return 1

    // Extract R blocks
    var stats: ExtractStats
    let blocks: RBlock[] = extractRBlocks(data, stats)

    // Print report
    printReport(stats)

    // Write blocks
    var i: int32
    for i in 0..<stats.total_blocks:
        let filename: str = strConcat(int32ToStr(i), "_")
        let block_name: str = strConcat(filename, blocks[i].name)
        let out_path: str = strConcat(outdir, "/")
        let full_out: str = strConcat(out_path, block_name)
        let ts_out: str = strConcat(full_out, ".ts")
        writeBlock(ts_out, blocks[i], i)

        if !blocks[i].is_clean:
            system.Eprintln(strConcat("  WARN block ", int32ToStr(i)))
            system.Eprintln(strConcat("    ", blocks[i].name))

    system.Eprintln("Done.")
    return 0
