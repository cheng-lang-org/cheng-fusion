    for key, value in expected_rows.items():
        if rows.get(key) != value:
            fail("scratch_guard_report_binding_invalid:" + key)
    for key, state in (
        ("report", report),
        ("stdout", stdout),
        ("stderr", stderr),
        ("resource_trace", resource_trace),
    ):
        for suffix, value in (
