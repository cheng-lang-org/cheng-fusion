        os.fsdecode(bytes.fromhex(rows.get("install_receipt_path_fshex", "")))
    )
    install_state, install_rows = validate_install_state(install_path)
    compiler_receipt_path = decode_path(
        install_rows,
        "compiler_build_receipt_path_fshex",
        "official_compiler_build_receipt",
    )
    compiler_receipt = stable_read(
        compiler_receipt_path,
        "official_compiler_build_receipt",
    )
    compiler_candidate = stable_read(
        decode_path(
            install_rows,
            "compiler_candidate_path_fshex",
            "official_compiler_candidate",
        ),
        "official_compiler_candidate",
        executable=True,
    )
    if (
        compiler_receipt.sha256
        != install_rows["compiler_build_receipt_sha256"]
        or compiler_candidate.sha256
        != install_rows["compiler_candidate_sha256"]
    ):
        fail("official_compiler_install_binding_drift")
    compiler_evidence = validate_compiler_build_evidence(
        compiler_candidate,
        compiler_receipt,
        before,
        "official_compiler_build",
    )
    compiler_rows = compiler_evidence["rows"]
    compiler_encoder_projection = compiler_evidence["encoder_projection"]
    publisher_path = pathlib.Path(
        os.fsdecode(bytes.fromhex(rows.get("publisher_receipt_path_fshex", "")))
    )
    publisher_state, publisher_rows = validate_official_receipt_state(
        publisher_path,
        before,
    )
    if (
        scratch_state.sha256
        != require_sha(
            rows.get("cold_scratch_execution_receipt_sha256", ""),
            "cold_scratch_execution_receipt",
        )
        or install_state.sha256
        != require_sha(rows.get("install_receipt_sha256", ""), "install_receipt")
        or publisher_state.sha256
        != require_sha(
            rows.get("publisher_receipt_sha256", ""), "publisher_receipt"
        )
        or rows.get("official_sha256") != install_rows["official_sha256"]
        or rows.get("official_sha256")
        != publisher_rows.get("official_driver_sha256")
        or scratch_rows.get("source_manifest_sha256")
        != rows.get("source_manifest_sha256")
        or scratch_rows.get("source_manifest_path_fshex")
        != rows.get("source_manifest_before_path_fshex")
        or compiler_rows.get("output_sha256") != rows.get("official_sha256")
        or encoder_projection != compiler_encoder_projection
    ):
        fail("official_build_receipt_artifact_drift")
    terminal = stable_read(path, "official_build_receipt_terminal")
    if terminal.raw != state.raw or identity(terminal.info) != identity(state.info):
        fail("official_build_receipt_terminal_drift")
    return terminal, rows


def validate_final(path: pathlib.Path) -> dict[str, str]:
    _state, rows = validate_final_state(path)
    return rows


def finish_transaction(transaction_path: pathlib.Path) -> None:
    stabilize_active_transaction_marker()
    stabilize_commit_marker()
    rows, final_receipt = validate_commit_marker()
    candidate = read_existing_official()
    published_receipt = read_existing(
        OFFICIAL_RECEIPT,
        "official_receipt_commit_result",
    )
    candidate_identity = (
        rows["official_staging_device"],
        rows["official_staging_inode"],
        rows["official_staging_mode"],
        "1",
        rows["official_staging_uid"],
        rows["official_staging_gid"],
        rows["official_staging_size"],
    )
    actual_candidate_identity = (
        str(candidate.info.st_dev) if candidate is not None else "",
        str(candidate.info.st_ino) if candidate is not None else "",
        format(candidate.info.st_mode, "o") if candidate is not None else "",
        str(candidate.info.st_nlink) if candidate is not None else "",
        str(candidate.info.st_uid) if candidate is not None else "",
        str(candidate.info.st_gid) if candidate is not None else "",
        str(candidate.info.st_size) if candidate is not None else "",
    )
    if (
        candidate is None
        or candidate.sha256 != rows["candidate_sha256"]
        or actual_candidate_identity != candidate_identity
        or published_receipt is None
        or published_receipt.sha256 != final_receipt.sha256
        or (
            str(published_receipt.info.st_dev),
            str(published_receipt.info.st_ino),
            format(published_receipt.info.st_mode, "o"),
            str(published_receipt.info.st_nlink),
            str(published_receipt.info.st_uid),
            str(published_receipt.info.st_gid),
            str(published_receipt.info.st_size),
        )
        != (
            rows["official_receipt_staging_device"],
            rows["official_receipt_staging_inode"],
            rows["official_receipt_staging_mode"],
            "1",
            rows["official_receipt_staging_uid"],
            rows["official_receipt_staging_gid"],
            rows["official_receipt_staging_size"],
        )
    ):
        fail("official_commit_result_invalid")
    prepared_raw = install_transaction_raw_from_rows(rows)
    try:
        active = stable_published_state(
            OFFICIAL_TRANSACTION,
            "official_active_transaction_commit_cleanup",
        )
    except FileNotFoundError:
        active = None
    if active is not None and active.raw != prepared_raw:
        fail("official_active_transaction_commit_drift")
    staging = decode_path(
        rows,
        "official_staging_path_fshex",
        "official_staging_commit_cleanup",
    )
    canonical_path(
        staging,
        "official_staging_commit_cleanup",
        allow_absent=True,
    )
    for key, label, executable, present_key, digest_key in (
        (
            "rollback_driver_path_fshex",
            "rollback_driver_commit_cleanup",
            True,
            "previous_official_present",
            "rollback_driver_sha256",
        ),
        (
            "rollback_receipt_path_fshex",
            "rollback_receipt_commit_cleanup",
            False,
            "previous_receipt_present",
            "rollback_receipt_sha256",
        ),
    ):
        path = decode_path(rows, key, label)
        if rows[present_key] == "true":
            try:
                state = stable_read(
                    path,
                    label,
                    executable=executable,
                    single_link=False,
                )
            except FileNotFoundError:
                pass
            else:
                if (
                    state.sha256 != rows[digest_key]
                    or state.info.st_nlink != 1
                ):
                    fail(label + "_drift")
                prefix = "rollback_" + (
                    "driver" if executable else "receipt"
                )
                if (
                    str(state.info.st_dev) != rows[prefix + "_device"]
                    or str(state.info.st_ino) != rows[prefix + "_inode"]
                    or format(state.info.st_mode, "o")
                    != rows[prefix + "_mode"]
                    or str(state.info.st_uid) != rows[prefix + "_uid"]
                    or str(state.info.st_gid) != rows[prefix + "_gid"]
                    or str(state.info.st_size) != rows[prefix + "_size"]
                ):
                    fail(label + "_physical_identity_drift")
                unlink_state(state, label)
        else:
            canonical_path(path, label, allow_absent=True)
    canonical_path(
        transaction_path,
        "transaction_commit_cleanup",
        allow_absent=True,
    )
    if active is not None:
        current_active = stable_published_state(
            OFFICIAL_TRANSACTION,
            "official_active_transaction_commit_cleanup",
        )
        if current_active.raw != prepared_raw:
            fail("official_active_transaction_commit_cleanup_drift")
        unlink_state(
            current_active,
            "official_active_transaction_commit_cleanup",
        )
    commit_state = stable_published_state(
        OFFICIAL_COMMIT,
        "official_commit_marker_cleanup",
    )
    unlink_state(commit_state, "official_commit_marker_cleanup")


def validate_current_receipt(path: pathlib.Path) -> tuple[
    FileState,
    dict[str, str],
    FileState,
    dict[str, str],
    FileState,
]:
    if path != OFFICIAL_RECEIPT:
        fail("official_build_receipt_path_not_authoritative")
    receipt_state, final_rows = validate_final_state(path)
    install_path = decode_path(
        final_rows,
        "install_receipt_path_fshex",
        "current_install_receipt",
    )
    install_state, install_rows = validate_install_state(install_path)
    source_manifest_path = decode_path(
        install_rows,
        "source_manifest_path_fshex",
        "current_source_manifest",
    )
    source_manifest = stable_read(
        source_manifest_path,
        "current_source_manifest",
    )
    validate_live_manifest(ROOT, source_manifest)
    compiler_receipt_path = decode_path(
        install_rows,
        "compiler_build_receipt_path_fshex",
        "current_compiler_receipt",
    )
    compiler_receipt = stable_read(
        compiler_receipt_path,
        "current_compiler_receipt",
    )
    compiler_rows = parse_rows(
        compiler_receipt,
        "current_compiler_receipt",
    )
    compiler_candidate_path = decode_path(
        install_rows,
        "compiler_candidate_path_fshex",
        "current_compiler_candidate",
    )
    compiler_root = canonical_path(
        compiler_candidate_path.parent,
        "current_compiler_evidence_root",
        directory=True,
    )
    private_manifest_path = pathlib.Path(
        compiler_rows.get("private_source_snapshot_manifest_path", "")
    )
    if (
        compiler_candidate_path != compiler_root / "cheng.compiler-main"
        or compiler_receipt.path
        != compiler_root / "cheng.compiler-main.build-receipt.txt"
        or private_manifest_path
        != compiler_root / "cheng-source-snapshot.manifest.txt"
        or pathlib.Path(
            compiler_rows.get("private_source_snapshot_root", "")
        )
        != compiler_root / "source-snapshot"
    ):
        fail("current_private_source_manifest_path_invalid")
    private_manifest = stable_read(
        private_manifest_path,
        "current_private_source_manifest",
    )
    if private_manifest.sha256 != require_sha(
        compiler_rows.get("private_source_snapshot_manifest_sha256", ""),
        "current_private_source_manifest",
    ):
        fail("current_private_source_manifest_drift")
    official = stable_read(OFFICIAL, "current_official", executable=True)
    if (
        install_state.sha256
        != require_sha(
            final_rows.get("install_receipt_sha256", ""),
            "current_install_receipt",
        )
        or source_manifest.sha256 != install_rows["source_manifest_sha256"]
        or compiler_receipt.sha256
        != install_rows["compiler_build_receipt_sha256"]
        or official.sha256 != final_rows["official_sha256"]
        or official.sha256 != install_rows["official_sha256"]
    ):
        fail("current_official_binding_drift")
    return (
        receipt_state,
        final_rows,
        source_manifest,
        install_rows,
        private_manifest,
    )


def commit(args: argparse.Namespace) -> None:
    transaction_path = pathlib.Path(args.transaction)
    stabilize_active_transaction_marker()
    transaction_rows = validate_install_transaction(
        OFFICIAL_TRANSACTION,
        published=True,
        allow_missing_staging=True,
    )
    if decode_path(
        transaction_rows,
        "private_transaction_path_fshex",
        "commit_private_transaction",
    ) != transaction_path:
        fail("commit_private_transaction_path_mismatch")
    canonical_path(
        OFFICIAL_COMMIT,
        "official_commit_marker",
        allow_absent=True,
    )
    final_path = pathlib.Path(args.final_receipt)
    final_state, final_rows = validate_final_state(final_path)
    if (
        final_rows["official_sha256"]
        != transaction_rows["candidate_sha256"]
    ):
        fail("commit_final_receipt_binding_drift")
    receipt_staging_path = transaction_path.parent / (
        "official-receipt-staging-" + transaction_rows["transaction_id"]
    )
    receipt_staging = exclusive_write(
        receipt_staging_path,
        final_state.raw,
        0o400,
    )
    if receipt_staging.info.st_dev != OFFICIAL_RECEIPT.parent.lstat().st_dev:
        fail("official_receipt_transaction_cross_device")
    validated_receipt_staging, staged_final_rows = validate_final_state(
        receipt_staging_path
    )
    terminal_receipt_staging = stable_read(
        receipt_staging_path,
        "official_receipt_staging_pre_commit_marker",
    )
    terminal_final_state = stable_read(
        final_path,
        "final_receipt_pre_commit_marker",
    )
    if (
        staged_final_rows != final_rows
        or receipt_staging.raw != final_state.raw
        or validated_receipt_staging.raw != receipt_staging.raw
        or identity(validated_receipt_staging.info)
        != identity(receipt_staging.info)
        or terminal_receipt_staging.raw != receipt_staging.raw
        or identity(terminal_receipt_staging.info)
        != identity(receipt_staging.info)
        or terminal_final_state.raw != final_state.raw
        or identity(terminal_final_state.info) != identity(final_state.info)
    ):
        fail("commit_final_receipt_terminal_drift")
    commit_raw = commit_marker_raw(
        transaction_rows,
        final_state,
        terminal_receipt_staging,
    )
    publish_exclusive_bytes(
        OFFICIAL_COMMIT,
        commit_raw,
        0o400,
        "official_commit_marker",
        pending_parent=final_path.parent,
    )
    committed_rows, committed_final = validate_commit_marker()
    if (
        committed_rows["transaction_id"]
        != transaction_rows["transaction_id"]
        or committed_final.raw != final_state.raw
        or identity(committed_final.info) != identity(final_state.info)
    ):
        fail("commit_marker_terminal_binding_drift")
    replace_durable(receipt_staging_path, OFFICIAL_RECEIPT)
    published = stable_read(
        OFFICIAL_RECEIPT,
        "official_build_receipt_publish",
    )
    if (
        published.raw != final_state.raw
        or (published.info.st_dev, published.info.st_ino)
        != (receipt_staging.info.st_dev, receipt_staging.info.st_ino)
    ):
        fail("official_build_receipt_publish_drift")
    validate_current_receipt(OFFICIAL_RECEIPT)
    finish_transaction(transaction_path)


def stabilize_replaced_artifact(
    source_path: pathlib.Path,
    target_path: pathlib.Path,
    expected_sha256: str,
    expected_identity: tuple[str, str, str, str, str, str],
    previous_present: bool,
    previous_sha256: str,
    previous_identity: tuple[str, str, str, str, str, str],
    label: str,
    *,
    executable: bool,
) -> FileState:
    try:
        source_held = held_read(
            source_path,
            label + "_source",
            executable=executable,
            single_link=False,
        )
    except FileNotFoundError:
        source_held = None
    try:
        target_held = held_read(
            target_path,
            label + "_target",
            executable=executable,
            single_link=False,
        )
    except FileNotFoundError:
        target_held = None
    except Exception:
        if source_held is not None:
            close_held(source_held, label + "_source_open_failure")
        raise
    source = source_held.state if source_held is not None else None
    target = target_held.state if target_held is not None else None

    def matches_expected_identity(state: FileState) -> bool:
        return (
            state.sha256 == expected_sha256
            and (
                str(state.info.st_dev),
                str(state.info.st_ino),
                format(state.info.st_mode, "o"),
                str(state.info.st_uid),
                str(state.info.st_gid),
                str(state.info.st_size),
            )
            == expected_identity
        )

    try:
        target_is_previous = (
            target is not None
            and previous_present
            and target.sha256 == previous_sha256
            and (
                str(target.info.st_dev),
                str(target.info.st_ino),
                format(target.info.st_mode, "o"),
                str(target.info.st_uid),
                str(target.info.st_gid),
                str(target.info.st_size),
            )
            == previous_identity
            and target.info.st_nlink == 2
        )
        if source is None:
            if (
                target is None
                or target_held is None
                or not matches_expected_identity(target)
                or target.info.st_nlink != 1
            ):
                fail(label + "_target_invalid")
            result = held_named_state(
                target_held,
                target_path,
                1,
                label + "_target_terminal",
            )
            return result
        if source_held is None or not matches_expected_identity(source):
            fail(label + "_source_invalid")
        if source.info.st_nlink == 1 and (
            target is None or target_is_previous
        ):
            held_named_state(
                source_held,
                source_path,
                1,
                label + "_source_pre_replace",
            )
            if target_held is not None:
                held_named_state(
                    target_held,
                    target_path,
                    2,
                    label + "_previous_target_pre_replace",
                )
                close_held(
                    target_held,
                    label + "_previous_target",
                )
                target_held = None
            replace_durable(source_path, target_path)
            result = held_named_state(
                source_held,
                target_path,
                1,
                label + "_source_post_replace",
            )
        elif (
            source.info.st_nlink == 2
            and target is not None
            and target_held is not None
            and target.info.st_nlink == 2
            and matches_expected_identity(target)
            and source.raw == target.raw
            and (source.info.st_dev, source.info.st_ino)
            == (target.info.st_dev, target.info.st_ino)
        ):
            held_named_state(
                source_held,
                source_path,
                2,
                label + "_source_link_pre_cleanup",
            )
            held_named_state(
                target_held,
                target_path,
                2,
                label + "_target_link_pre_cleanup",
            )
            source_path.unlink()
            fsync_parent(source_path)
            result = held_named_state(
                target_held,
                target_path,
                1,
                label + "_target_link_post_cleanup",
            )
        else:
            fail(label + "_source_target_conflict")
        if not matches_expected_identity(result):
            fail(label + "_result_invalid")
        return result
    finally:
        if source_held is not None and source_held.descriptor >= 0:
            close_held(source_held, label + "_source")
        if target_held is not None and target_held.descriptor >= 0:
            close_held(target_held, label + "_target")


def recover_active_transaction() -> None:
    stabilize_active_transaction_marker()
    stabilize_commit_marker()
    try:
        OFFICIAL_COMMIT.lstat()
    except FileNotFoundError:
        commit_present = False
    else:
        commit_present = True
    try:
        OFFICIAL_TRANSACTION.lstat()
    except FileNotFoundError:
        transaction_present = False
    else:
        transaction_present = True
    if not commit_present and not transaction_present:
        return
    if commit_present:
        rows, final_receipt = validate_commit_marker()
        prepared_raw = install_transaction_raw_from_rows(rows)
        try:
            active = stable_published_state(
                OFFICIAL_TRANSACTION,
                "official_committed_recovery_active",
            )
        except FileNotFoundError:
            active = None
        if active is not None and active.raw != prepared_raw:
            fail("official_committed_recovery_active_drift")
        stabilize_replaced_artifact(
            decode_path(
                rows,
                "official_staging_path_fshex",
                "official_committed_recovery_driver_staging",
            ),
            OFFICIAL,
            rows["candidate_sha256"],
            (
                rows["official_staging_device"],
                rows["official_staging_inode"],
                rows["official_staging_mode"],
                rows["official_staging_uid"],
                rows["official_staging_gid"],
                rows["official_staging_size"],
            ),
            rows["previous_official_present"] == "true",
            rows["previous_official_sha256"],
            (
                rows["rollback_driver_device"],
                rows["rollback_driver_inode"],
                rows["rollback_driver_mode"],
                rows["rollback_driver_uid"],
                rows["rollback_driver_gid"],
                rows["rollback_driver_size"],
            ),
            "official_committed_recovery_driver",
            executable=True,
        )
        current_receipt = stabilize_replaced_artifact(
            decode_path(
                rows,
                "official_receipt_staging_path_fshex",
                "official_committed_recovery_receipt_staging",
            ),
            OFFICIAL_RECEIPT,
            rows["official_receipt_staging_sha256"],
            (
                rows["official_receipt_staging_device"],
                rows["official_receipt_staging_inode"],
                rows["official_receipt_staging_mode"],
                rows["official_receipt_staging_uid"],
                rows["official_receipt_staging_gid"],
                rows["official_receipt_staging_size"],
            ),
            rows["previous_receipt_present"] == "true",
            rows["previous_receipt_sha256"],
            (
                rows["rollback_receipt_device"],
                rows["rollback_receipt_inode"],
                rows["rollback_receipt_mode"],
                rows["rollback_receipt_uid"],
                rows["rollback_receipt_gid"],
                rows["rollback_receipt_size"],
            ),
            "official_committed_recovery_receipt",
            executable=False,
        )
        current_receipt_identity = (
            current_receipt.sha256 if current_receipt is not None else "",
            str(current_receipt.info.st_dev)
            if current_receipt is not None
            else "",
            str(current_receipt.info.st_ino)
            if current_receipt is not None
            else "",
            format(current_receipt.info.st_mode, "o")
            if current_receipt is not None
            else "",
            str(current_receipt.info.st_nlink)
            if current_receipt is not None
            else "",
            str(current_receipt.info.st_uid)
            if current_receipt is not None
            else "",
            str(current_receipt.info.st_gid)
            if current_receipt is not None
            else "",
            str(current_receipt.info.st_size)
            if current_receipt is not None
            else "",
        )
        committed_receipt_identity = (
            rows["official_receipt_staging_sha256"],
            rows["official_receipt_staging_device"],
            rows["official_receipt_staging_inode"],
            rows["official_receipt_staging_mode"],
            "1",
            rows["official_receipt_staging_uid"],
            rows["official_receipt_staging_gid"],
            rows["official_receipt_staging_size"],
        )
        if active is None and current_receipt_identity != committed_receipt_identity:
            fail("official_committed_recovery_active_missing_before_publish")
        if current_receipt_identity != committed_receipt_identity:
            fail("official_committed_recovery_receipt_invalid")
        # COMMITTED is published only after validate_final has completed
        # against both the source receipt and its independently written
        # staging copy.  Recovery must consume that sealed byte/identity
        # authority; re-reading the mutable source closure here would turn a
        # completed transaction into a non-idempotent post-crash rebuild.
        finish_transaction(
            decode_path(
                rows,
                "private_transaction_path_fshex",
                "committed_private_transaction",
            )
        )
        return
    rows = validate_install_transaction(
        OFFICIAL_TRANSACTION,
        published=True,
        allow_missing_backups=True,
        allow_missing_staging=True,
    )
    rollback_transaction(
        decode_path(
            rows,
            "private_transaction_path_fshex",
            "prepared_private_transaction",
        ),
        None,
    )


def require_transaction_lock() -> None:
    value = os.environ.get("CHENG_CURRENT_BUILD_LOCK_FD", "")
    if not value.isascii() or not value.isdigit():
        fail("official_transaction_lock_missing")
    descriptor = int(value)
    try:
        opened = os.fstat(descriptor)
        parent = OFFICIAL.parent.lstat()
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, ValueError) as error:
        raise BuildEvidenceError(
            "official_transaction_lock_invalid"
        ) from error
    if (
        not stat.S_ISDIR(opened.st_mode)
        or (opened.st_dev, opened.st_ino)
        != (parent.st_dev, parent.st_ino)
    ):
        fail("official_transaction_lock_identity_invalid")


def run_producer(args: argparse.Namespace) -> None:
    producer = canonical_path(
        pathlib.Path(args.producer),
        "official_build_producer",
    )
    if producer != ROOT / "tools/backend2_current_source_official_build_producer.sh":
        fail("official_build_producer_path_invalid")
    output = pathlib.Path(args.out)
    if not output.is_absolute():
        fail("official_build_output_not_absolute")
    OFFICIAL.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(
        OFFICIAL.parent,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise BuildEvidenceError(
                "official_transaction_writer_busy"
            ) from error
        recover_active_transaction()
        os.set_inheritable(descriptor, True)
        environment = dict(os.environ)
        environment["CHENG_CURRENT_BUILD_LOCK_FD"] = str(descriptor)
        completed = subprocess.run(
            [str(producer), "--locked", str(output)],
            env=environment,
            pass_fds=(descriptor,),
            check=False,
        )
        recover_active_transaction()
    finally:
        os.close(descriptor)
    raise SystemExit(completed.returncode)


def acquire_official_read_lock(label: str) -> int:
    descriptor = os.open(
        OFFICIAL.parent,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        fcntl.flock(descriptor, fcntl.LOCK_SH | fcntl.LOCK_NB)
        opened = os.fstat(descriptor)
        named = OFFICIAL.parent.lstat()
        if (
            not stat.S_ISDIR(opened.st_mode)
            or identity(opened) != identity(named)
        ):
            fail(label + "_lock_identity_invalid")
        for marker in (OFFICIAL_TRANSACTION, OFFICIAL_COMMIT):
            try:
                marker.lstat()
            except FileNotFoundError:
                continue
            fail(label + "_transaction_active")
        return descriptor
    except BlockingIOError as error:
        os.close(descriptor)
        raise BuildEvidenceError(label + "_writer_busy") from error
    except Exception:
        os.close(descriptor)
        raise


def require_terminal_state(
