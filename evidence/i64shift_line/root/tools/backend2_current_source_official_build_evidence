    report = stable_read(guard_report_path, "scratch_guard_report")
    stdout = stable_read(stdout_path, "scratch_stdout")
    stderr = stable_read(stderr_path, "scratch_stderr")
    resource_trace = stable_read(
        resource_trace_path,
        "scratch_resource_trace",
    )
