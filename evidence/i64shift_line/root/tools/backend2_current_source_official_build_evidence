        "monitor_python_path": str(monitor_python.path),
        "monitor_python_sha256": monitor_python.sha256,
        "monitor_runtime_script_path": str(monitor_runtime.path),
        "monitor_runtime_script_sha256": monitor_runtime.sha256,
