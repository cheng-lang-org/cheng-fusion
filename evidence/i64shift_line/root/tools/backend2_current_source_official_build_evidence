def finalize(args: argparse.Namespace) -> None:
    install_state, install_rows = validate_install_state(
        pathlib.Path(args.install_receipt)
    )
    scratch_state, scratch_rows = validate_scratch_execution_receipt(
        pathlib.Path(args.scratch_receipt)
    )
    before = stable_read(pathlib.Path(args.manifest_before), "manifest_before")
    after = stable_read(pathlib.Path(args.manifest_after), "manifest_after")
    if before.raw != after.raw or before.sha256 != after.sha256:
        fail("final_source_closure_drift")
    validate_live_manifest(ROOT, before)
    publisher_state, publisher_rows = validate_official_receipt_state(
        pathlib.Path(args.publisher_receipt),
        before,
    )
    if (
        scratch_rows.get("source_manifest_path_fshex")
        != os.fsencode(before.path).hex()
        or scratch_rows.get("source_manifest_sha256") != before.sha256
    ):
        fail("final_scratch_source_manifest_binding_drift")
    if (
        before.sha256 != install_rows["source_manifest_sha256"]
        or publisher_rows.get("official_driver_sha256")
        != install_rows["official_sha256"]
    ):
        fail("final_receipt_binding_drift")
    official = stable_read(OFFICIAL, "final_official", executable=True)
    if official.sha256 != install_rows["official_sha256"]:
        fail("final_official_drift")
    compiler_receipt_path = decode_path(
        install_rows,
        "compiler_build_receipt_path_fshex",
        "final_compiler_build_receipt",
    )
    compiler_receipt = stable_read(
        compiler_receipt_path,
        "final_compiler_build_receipt",
    )
    compiler_candidate = stable_read(
        decode_path(
            install_rows,
            "compiler_candidate_path_fshex",
            "final_compiler_candidate",
        ),
        "final_compiler_candidate",
        executable=True,
    )
    if (
        compiler_receipt.sha256
        != install_rows["compiler_build_receipt_sha256"]
        or compiler_candidate.sha256
        != install_rows["compiler_candidate_sha256"]
    ):
        fail("final_compiler_install_binding_drift")
    compiler_evidence = validate_compiler_build_evidence(
        compiler_candidate,
        compiler_receipt,
        before,
        "final_compiler_build",
    )
    compiler_rows = compiler_evidence["rows"]
    encoder_projection = compiler_evidence["encoder_projection"]
    if compiler_rows.get("output_sha256") != official.sha256:
        fail("final_compiler_output_drift")
    lines = [
        "schema=cheng.backend2.current_source_official_build_receipt.v2",
        "status=PASS",
        "driver_role=production",
        "source_manifest_sha256=" + before.sha256,
        "source_manifest_before_path_fshex=" + os.fsencode(before.path).hex(),
        "source_manifest_after_path_fshex=" + os.fsencode(after.path).hex(),
        "official_sha256=" + official.sha256,
        "cold_scratch_execution_receipt_path_fshex="
        + os.fsencode(scratch_state.path).hex(),
        "cold_scratch_execution_receipt_sha256=" + scratch_state.sha256,
        "install_receipt_path_fshex=" + os.fsencode(install_state.path).hex(),
        "install_receipt_sha256=" + install_state.sha256,
        "publisher_receipt_path_fshex=" + os.fsencode(publisher_state.path).hex(),
        "publisher_receipt_sha256=" + publisher_state.sha256,
        "source_postflight_status=stable",
        "raw_bytes_fixed_point=true",
        "cold_system_link_exec=0",
        "system_link_exec_scope=selfhost_direct",
    ]
    lines.extend(
        key + "=" + encoder_projection[key]
        for key in ENCODER_BUILD_PROJECTION_KEYS
    )
    output = exclusive_write(
        pathlib.Path(args.out),
        rendered(lines, "receipt_payload_sha256"),
    )
    validate_final(output.path)


