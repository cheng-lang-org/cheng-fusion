    return result


def main() -> None:
    args = parser().parse_args()
    if args.command == "run-producer":
        run_producer(args)
    elif args.command == "install":
        require_transaction_lock()
        try:
            install(args)
        except Exception:
            try:
                OFFICIAL_TRANSACTION.lstat()
            except FileNotFoundError:
                pass
            else:
                recover_active_transaction()
            raise
    elif args.command == "validate-install":
        validate_install(pathlib.Path(args.receipt))
    elif args.command == "seal-scratch-execution":
        seal_scratch_execution(args)
    elif args.command == "validate-scratch-execution":
        validate_scratch_execution_receipt(pathlib.Path(args.receipt))
    elif args.command == "validate-publisher-receipt":
        validate_publisher_receipt_cli(args)
    elif args.command == "finalize":
        finalize(args)
    elif args.command == "validate-final":
        validate_final(pathlib.Path(args.receipt))
    elif args.command == "commit":
        require_transaction_lock()
        commit(args)
    elif args.command == "rollback":
        require_transaction_lock()
        rollback_transaction(
            pathlib.Path(args.transaction),
            pathlib.Path(args.final_receipt)
            if args.final_receipt is not None
            else None,
        )
    elif args.command == "recover":
        require_transaction_lock()
        recover_active_transaction()
    elif args.command == "bind-current":
        bind_current(args)
    elif args.command == "validate-binding":
        validate_binding(pathlib.Path(args.binding))
    elif args.command == "safe-remove-tree":
        safe_remove_tree(args)
    elif args.command == "verified-archive-tree":
        verified_archive_tree(args)
    elif args.command == "preflight":
        if not preflight(args):
            raise SystemExit(FAIL_RC)
    else:
        fail("command_invalid")


if __name__ == "__main__":
    try:
        main()
    except (BuildEvidenceError, OSError, ValueError, KeyError) as error:
        print(
            "backend2_current_source_official_build_evidence_error="
            + str(error),
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
