    finalize_cmd.add_argument("--out", required=True)
    validate_final_cmd = commands.add_parser("validate-final")
    validate_final_cmd.add_argument("--receipt", required=True)
    commit_cmd = commands.add_parser("commit")
    commit_cmd.add_argument("--transaction", required=True)
    commit_cmd.add_argument("--final-receipt", required=True)
    rollback_cmd = commands.add_parser("rollback")
    rollback_cmd.add_argument("--transaction", required=True)
    rollback_cmd.add_argument("--final-receipt")
    commands.add_parser("recover")
