def scratch_frame(raw: bytes) -> bytes:
    if len(raw) >= 1 << 32:
        fail("scratch_execution_frame_too_large")
    return len(raw).to_bytes(4, "big") + raw


def scratch_argv_sha256(values: tuple[str, ...]) -> str:
    payload = bytearray(scratch_frame(b"cheng.guard.command_argv"))
    payload.extend(len(values).to_bytes(4, "big"))
    for value in values:
        payload.extend(scratch_frame(os.fsencode(value)))
    return hashlib.sha256(payload).hexdigest()


def scratch_env_sha256(values: dict[str, str]) -> str:
    payload = bytearray(scratch_frame(b"cheng.guard.target_env"))
    keys = sorted(values)
    payload.extend(len(keys).to_bytes(4, "big"))
    for key in keys:
        payload.extend(scratch_frame(os.fsencode(key)))
        payload.extend(scratch_frame(os.fsencode(values[key])))
    return hashlib.sha256(payload).hexdigest()


def require_sealed_scratch_artifact(
    state: FileState,
    label: str,
) -> None:
    if (
        stat.S_IMODE(state.info.st_mode) != 0o400
        or state.info.st_nlink != 1
        or state.info.st_uid != os.geteuid()
        or state.info.st_gid != os.getegid()
    ):
        fail(label + "_seal_invalid")


def scratch_bound_file_rows(role: str, state: FileState) -> dict[str, str]:
    return {
        role + "_path_fshex": os.fsencode(state.path).hex(),
        role + "_sha256": state.sha256,
        role + "_device": str(state.info.st_dev),
        role + "_inode": str(state.info.st_ino),
        role + "_mode": format(state.info.st_mode, "o"),
        role + "_nlink": str(state.info.st_nlink),
        role + "_uid": str(state.info.st_uid),
        role + "_gid": str(state.info.st_gid),
        role + "_size": str(state.info.st_size),
        role + "_mtime_ns": str(state.info.st_mtime_ns),
        role + "_ctime_ns": str(state.info.st_ctime_ns),
    }


