                True,
            ),
            (
                live_root / "tools/current_source_closure_manifest.py",
                False,
            ),
            (live_root / "tools/current_source_snapshot.py", False),
            (live_root / "bootstrap/cheng_cold.c", False),
            (
                live_root
                / "src/core/tooling/backend_driver_dispatch_min.cheng",
                False,
            ),
            (live_root / "cheng-package.toml", False),
            (live_root / "cheng.lock.toml", False),
            (live_root / "docs/cheng-formal-spec.md", False),
        )
        for required_path, executable in required_inputs:
            try:
                required_state = stable_read(
                    required_path,
                    "production_input",
                    executable=executable,
                )
            except (BuildEvidenceError, OSError, ValueError):
                reason = (
                    "production_input_missing_or_invalid:"
                    + str(required_path.relative_to(live_root))
                )
                break
            if required_state.info.st_size <= 0:
                reason = (
                    "production_input_empty:"
                    + str(required_path.relative_to(live_root))
                )
                break

    if scratch_gate_reason:
        reason = scratch_gate_reason

    def present(path: pathlib.Path) -> bool:
        try:
            path.lstat()
        except FileNotFoundError:
            return False
        return True

    official_present = present(OFFICIAL)
    official_receipt_present = present(OFFICIAL_RECEIPT)
    transaction_present = present(OFFICIAL_TRANSACTION)
    commit_present = present(OFFICIAL_COMMIT)
    if not reason and (transaction_present or commit_present):
        reason = "official_transaction_recovery_required"
        actions = [
            "acquire_official_parent_writer_lock",
            "run_exact_prepared_or_committed_recovery",
            "verify_canonical_pair_and_zero_active_markers",
            "rerun_read_only_preflight",
        ]
    elif not reason and official_present != official_receipt_present:
        reason = (
            "official_pair_incomplete_driver_only"
            if official_present
            else "official_pair_incomplete_receipt_only"
        )
        actions = [
            "capture_read_only_unpaired_official_artifact_identity",
            "copy_unpaired_official_artifact_to_operator_archive",
            "verify_archive_hash_and_distinct_inode",
            "move_unpaired_original_out_of_canonical_path_after_operator_confirmation",
            "rerun_read_only_preflight",
        ]
    ready = not reason
    if ready:
        actions = [
            "enter_frozen_no_concurrent_write_window",
            "run_unique_current_official_build_producer_at_absent_candidate_root",
            "validate_canonical_driver_and_current_build_receipt",
        ]
    lines = [
        "schema=cheng.backend2.current_source_official_preflight",
        "status=" + ("READY" if ready else "HARD_RED"),
        "reason=" + reason,
        "candidate_root_mode="
        + (
            "transaction_private_absent"
            if alternate_candidate_root
            else "canonical_observation"
        ),
        "live_root_path_fshex=" + os.fsencode(live_root).hex(),
        "compiler_evidence_root_path_fshex="
        + os.fsencode(compiler_root).hex(),
        "compiler_evidence_entry_count=" + str(entry_count),
        "compiler_evidence_regular_count=" + str(regular_count),
        "compiler_evidence_regular_bytes=" + str(regular_bytes),
        "compiler_evidence_symlink_seen="
        + ("true" if symlink_seen else "false"),
        "failed_seed_attempt_present="
        + ("true" if failed_attempt is not None else "false"),
        "failed_seed_attempt_rc="
        + (failed_attempt["rc"] if failed_attempt is not None else ""),
        "failed_seed_attempt_guard_sha256="
        + (
            failed_attempt["guard_sha256"]
            if failed_attempt is not None
            else ""
        ),
        "failed_seed_attempt_stderr_sha256="
        + (
            failed_attempt["stderr_sha256"]
            if failed_attempt is not None
            else ""
        ),
        "failed_seed_attempt_empty_output_count="
        + (
            failed_attempt["empty_output_count"]
            if failed_attempt is not None
            else "0"
        ),
        "preserved_compiler_evidence_root_path_fshex="
        + os.fsencode(preserved_compiler_root).hex(),
        "preserved_compiler_evidence_reason=" + preserved_reason,
        "preserved_compiler_evidence_entry_count="
        + str(preserved_entry_count),
        "preserved_compiler_evidence_regular_count="
        + str(preserved_regular_count),
        "preserved_compiler_evidence_regular_bytes="
        + str(preserved_regular_bytes),
        "preserved_compiler_evidence_symlink_seen="
        + ("true" if preserved_symlink_seen else "false"),
        "cold_codegen_scratch_gate_input_count="
        + str(len(COLD_CODEGEN_SCRATCH_GATE_INPUTS)),
    ]
    for index, (
        label,
        relative,
        expected_sha256,
        expected_mode,
        _,
    ) in enumerate(COLD_CODEGEN_SCRATCH_GATE_INPUTS):
        state = scratch_gate_states.get(label)
        prefix = "cold_codegen_scratch_gate_input." + str(index)
        lines.extend(
            (
                prefix + ".role=" + label,
                prefix + ".path_fshex="
                + os.fsencode(live_root / relative).hex(),
                prefix + ".sha256="
                + (state.sha256 if state is not None else ""),
                prefix + ".expected_sha256=" + expected_sha256,
                prefix + ".mode="
                + (
                    format(stat.S_IMODE(state.info.st_mode), "o")
                    if state is not None
                    else "0"
                ),
                prefix + ".expected_mode=" + format(expected_mode, "o"),
                prefix + ".nlink="
                + (str(state.info.st_nlink) if state is not None else "0"),
                prefix + ".size="
                + (str(state.info.st_size) if state is not None else "0"),
            )
        )
    for path, prefix, hash_regular in (
        (compiler_root, "compiler_root", False),
        (candidate, "compiler_candidate", True),
        (build_receipt, "compiler_build_receipt", True),
        (private_manifest, "compiler_private_manifest", True),
        (seed, "compiler_bootstrap_seed", True),
        (OFFICIAL, "official_driver", True),
        (OFFICIAL_RECEIPT, "official_build_receipt", True),
    ):
        lines.extend(
            observed_path_rows(
                path,
                prefix,
                hash_regular=hash_regular,
            )
        )
    protected = (
        ROOT / "artifacts/backend_driver/bridge_surface_source",
        ROOT / "artifacts/backend_driver/cheng.report.txt",
        ROOT / "artifacts/backend_driver/profile-current-source",
        ROOT / "artifacts/backend_driver/provider_cache",
    )
    lines.append("protected_material_count=" + str(len(protected)))
    for index, path in enumerate(protected):
        prefix = "protected_material." + str(index)
        lines.append(prefix + ".path_fshex=" + os.fsencode(path).hex())
        lines.extend(
            observed_path_rows(
                path,
                prefix,
                hash_regular=True,
            )
        )
    lines.append("action_count=" + str(len(actions)))
    for index, action in enumerate(actions):
        lines.append("action." + str(index) + "=" + action)
    sys.stdout.buffer.write(rendered(lines, "receipt_payload_sha256"))
    if not ready:
        print(
            "backend2_current_source_official_preflight_error=" + reason,
            file=sys.stderr,
        )
    return ready


