        rows,
        "receipt_payload_sha256",
        "official_commit_marker_stabilize",
    )
    if (
        tuple(rows) != INSTALL_COMMIT_KEYS
        or rows.get("schema")
        != "cheng.backend2.current_source_official_install_commit"
        or rows.get("status") != "COMMITTED"
    ):
        fail("official_commit_marker_stabilize_shape_invalid")
    prepared_rows = {
        "schema":
            "cheng.backend2.current_source_official_install_transaction",
        "status": "PREPARED",
    }
    prepared_rows.update(
        {
            key: rows[key]
            for key in INSTALL_TRANSACTION_KEYS[2:-1]
        }
    )
    prepared_raw = install_transaction_raw_from_rows(prepared_rows)
    prepared_state = FileState(
        OFFICIAL_TRANSACTION,
        prepared_raw,
        hashlib.sha256(prepared_raw).hexdigest(),
        commit.info,
    )
    prepared_rows = parse_rows(
        prepared_state,
        "official_commit_marker_stabilize_prepared",
    )
    if (
        prepared_rows["receipt_payload_sha256"]
        != rows["prepared_payload_sha256"]
    ):
        fail("official_commit_marker_stabilize_prepared_payload_invalid")
    private_path = decode_path(
        rows,
        "private_transaction_path_fshex",
        "official_commit_marker_stabilize_private",
    )
    semantic_rows = validate_install_transaction(
        private_path,
        raw_override=prepared_raw,
        validate_physical=False,
    )
    if semantic_rows != prepared_rows:
        fail("official_commit_marker_stabilize_prepared_semantics_invalid")
    final_path = decode_path(
        rows,
        "final_receipt_path_fshex",
        "official_commit_marker_stabilize_final",
    )
    if (
        final_path.parent != private_path.parent
        or final_path.name != "official-build-receipt.kv"
    ):
        fail("official_commit_marker_stabilize_final_path_invalid")
    pending = pending_publish_path(
        OFFICIAL_COMMIT,
        commit.raw,
        final_path.parent,
    )
    if commit.info.st_nlink == 1:
        canonical_path(
            pending,
            "official_commit_marker_stabilize_pending",
            allow_absent=True,
        )
        return
    if commit.info.st_nlink != 2:
        fail("official_commit_marker_stabilize_nlink_invalid")
    pending_state = stable_read(
        pending,
        "official_commit_marker_stabilize_pending",
        single_link=False,
    )
    if (
        pending_state.raw != commit.raw
        or pending_state.info.st_nlink != 2
        or (pending_state.info.st_dev, pending_state.info.st_ino)
        != (commit.info.st_dev, commit.info.st_ino)
    ):
        fail("official_commit_marker_stabilize_identity_invalid")
    pending_state.path.unlink()
    fsync_parent(pending_state.path)
    stable_published_state(
        OFFICIAL_COMMIT,
        "official_commit_marker_stabilized",
    )


def unlink_state(state: FileState, label: str) -> None:
    current = stable_read(
        state.path,
        label,
        executable=bool(state.info.st_mode & 0o111),
        single_link=state.info.st_nlink == 1,
    )
    if identity(current.info) != identity(state.info) or current.raw != state.raw:
        fail(label + "_identity_drift")
    state.path.unlink()
    directory = os.open(state.path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def restore_or_remove(
    current_path: pathlib.Path,
    installed_sha256: str,
    installed_identity: tuple[str, ...],
    previous_present: bool,
    previous_sha256: str,
    previous_identity: tuple[str, str],
    rollback_path: pathlib.Path,
    label: str,
    *,
    executable: bool,
) -> None:
    current = read_existing(
        current_path,
        label + "_current",
        single_link=False,
    )
    if current is not None and current.sha256 == previous_sha256 and previous_present:
        if (
            str(current.info.st_dev),
            str(current.info.st_ino),
        ) == previous_identity:
            return
    if current is None:
        if previous_present:
            backup = stable_read(
                rollback_path,
                label + "_rollback_backup",
                executable=executable,
                single_link=False,
            )
            if (
                backup.sha256 != previous_sha256
                or (
                    str(backup.info.st_dev),
                    str(backup.info.st_ino),
                )
                != previous_identity
            ):
                fail(label + "_rollback_backup_drift")
            replace_durable(rollback_path, current_path)
        return
    if current.sha256 != installed_sha256:
        fail(label + "_rollback_identity_drift")
    current_identity = (
        str(current.info.st_dev),
        str(current.info.st_ino),
        format(current.info.st_mode, "o"),
        str(current.info.st_nlink),
        str(current.info.st_uid),
        str(current.info.st_gid),
        str(current.info.st_size),
    )
    if current_identity != installed_identity:
        fail(label + "_installed_identity_drift")
    if previous_present:
        backup = stable_read(
            rollback_path,
            label + "_rollback_backup",
            executable=executable,
            single_link=False,
        )
        if (
            backup.sha256 != previous_sha256
            or (
                str(backup.info.st_dev),
                str(backup.info.st_ino),
            )
            != previous_identity
            or backup.info.st_nlink != 1
        ):
            fail(label + "_rollback_backup_drift")
        replace_durable(rollback_path, current_path)
    else:
        unlink_state(current, label + "_remove")


def rollback_transaction(
    transaction_path: pathlib.Path,
    final_receipt_path: pathlib.Path | None,
) -> None:
    del final_receipt_path
    stabilize_active_transaction_marker()
    rows = validate_install_transaction(
        OFFICIAL_TRANSACTION,
        published=True,
        allow_missing_backups=True,
        allow_missing_staging=True,
    )
    private_path = decode_path(
        rows,
        "private_transaction_path_fshex",
        "private_transaction",
    )
    if private_path != transaction_path:
        fail("rollback_private_transaction_path_mismatch")
    staging = decode_path(
        rows,
        "official_staging_path_fshex",
        "official_staging",
    )
    try:
        rollback_staging = stable_read(
            staging,
            "official_staging_rollback_persisted_link",
            executable=True,
            single_link=False,
        )
    except FileNotFoundError:
        rollback_staging = None
    if rollback_staging is not None and rollback_staging.info.st_nlink == 2:
        unlink_state(
            rollback_staging,
            "official_staging_rollback_persisted_link",
        )
    active = stable_published_state(
        OFFICIAL_TRANSACTION,
        "official_active_transaction",
    )
    try:
        private = stable_read(private_path, "private_transaction")
    except FileNotFoundError:
        private = None
    if private is not None and private.raw != active.raw:
        fail("rollback_private_transaction_drift")
    rollback_driver_path = decode_path(
        rows,
        "rollback_driver_path_fshex",
        "rollback_driver",
    )
    rollback_receipt_path = decode_path(
        rows,
        "rollback_receipt_path_fshex",
        "rollback_receipt",
    )
    current_receipt = read_existing(
        OFFICIAL_RECEIPT,
        "official_receipt_current",
        single_link=False,
    )
    previous_receipt_present = rows["previous_receipt_present"] == "true"
    previous_receipt_sha256 = rows["previous_receipt_sha256"]
    if current_receipt is not None:
        if (
            not previous_receipt_present
            or current_receipt.sha256 != previous_receipt_sha256
            or str(current_receipt.info.st_dev)
            != rows["previous_receipt_device"]
            or str(current_receipt.info.st_ino)
            != rows["previous_receipt_inode"]
        ):
            fail("official_receipt_rollback_identity_drift")
    elif previous_receipt_present:
        backup = stable_read(
            rollback_receipt_path,
            "official_receipt_rollback_backup",
            single_link=False,
        )
        if (
            backup.sha256 != previous_receipt_sha256
            or str(backup.info.st_dev)
            != rows["previous_receipt_device"]
            or str(backup.info.st_ino)
            != rows["previous_receipt_inode"]
            or backup.info.st_nlink != 1
        ):
            fail("official_receipt_rollback_backup_drift")
        replace_durable(rollback_receipt_path, OFFICIAL_RECEIPT)
    restore_or_remove(
        OFFICIAL,
        rows["candidate_sha256"],
        (
            rows["official_staging_device"],
            rows["official_staging_inode"],
            rows["official_staging_mode"],
            "1",
            rows["official_staging_uid"],
            rows["official_staging_gid"],
            rows["official_staging_size"],
        ),
        rows["previous_official_present"] == "true",
        rows["previous_official_sha256"],
        (
            rows["previous_official_device"],
            rows["previous_official_inode"],
        ),
        rollback_driver_path,
        "official",
        executable=True,
    )
    try:
        staging_state = stable_read(
            staging,
            "official_staging_rollback",
            executable=True,
            single_link=False,
        )
    except FileNotFoundError:
        pass
    else:
        if (
            staging_state.sha256 != rows["candidate_sha256"]
            or (
                str(staging_state.info.st_dev),
                str(staging_state.info.st_ino),
                format(staging_state.info.st_mode, "o"),
                str(staging_state.info.st_nlink),
                str(staging_state.info.st_uid),
                str(staging_state.info.st_gid),
                str(staging_state.info.st_size),
            )
            != (
                rows["official_staging_device"],
                rows["official_staging_inode"],
                rows["official_staging_mode"],
                rows["official_staging_nlink"],
                rows["official_staging_uid"],
                rows["official_staging_gid"],
                rows["official_staging_size"],
            )
        ):
            fail("official_staging_rollback_identity_drift")
        unlink_state(staging_state, "official_staging_rollback")
    old_driver = read_existing(
        OFFICIAL,
        "official_rollback_result",
        single_link=False,
    )
    old_receipt = read_existing(
        OFFICIAL_RECEIPT,
        "official_receipt_rollback_result",
        single_link=False,
    )
    if (
        (old_driver is not None) != (rows["previous_official_present"] == "true")
        or (old_receipt is not None)
        != (rows["previous_receipt_present"] == "true")
        or (
            old_driver is not None
            and (
                old_driver.sha256 != rows["previous_official_sha256"]
                or str(old_driver.info.st_dev)
                != rows["previous_official_device"]
                or str(old_driver.info.st_ino)
                != rows["previous_official_inode"]
            )
        )
        or (
            old_receipt is not None
            and (
                old_receipt.sha256 != rows["previous_receipt_sha256"]
                or str(old_receipt.info.st_dev)
                != rows["previous_receipt_device"]
                or str(old_receipt.info.st_ino)
                != rows["previous_receipt_inode"]
            )
        )
    ):
        fail("official_rollback_result_invalid")
    for path, label, executable, present_key, digest_key in (
        (
            rollback_driver_path,
            "rollback_driver_cleanup",
            True,
            "previous_official_present",
            "rollback_driver_sha256",
        ),
        (
            rollback_receipt_path,
            "rollback_receipt_cleanup",
            False,
            "previous_receipt_present",
            "rollback_receipt_sha256",
        ),
    ):
        try:
            state = stable_read(
                path,
                label,
                executable=executable,
                single_link=False,
            )
        except FileNotFoundError:
            continue
        if rows[present_key] != "true" or state.sha256 != rows[digest_key]:
            fail(label + "_identity_drift")
        prefix = "rollback_" + (
            "driver" if executable else "receipt"
        )
        if (
            str(state.info.st_dev) != rows[prefix + "_device"]
            or str(state.info.st_ino) != rows[prefix + "_inode"]
            or format(state.info.st_mode, "o") != rows[prefix + "_mode"]
            or str(state.info.st_uid) != rows[prefix + "_uid"]
            or str(state.info.st_gid) != rows[prefix + "_gid"]
            or str(state.info.st_size) != rows[prefix + "_size"]
        ):
            fail(label + "_physical_identity_drift")
        if state.info.st_nlink == 2:
            canonical = (
                OFFICIAL if executable else OFFICIAL_RECEIPT
            )
            current = stable_read(
                canonical,
                label + "_canonical",
                executable=executable,
                single_link=False,
            )
            if (
                current.raw != state.raw
                or (current.info.st_dev, current.info.st_ino)
                != (state.info.st_dev, state.info.st_ino)
            ):
                fail(label + "_canonical_identity_drift")
        elif state.info.st_nlink != 1:
            fail(label + "_nlink_invalid")
        unlink_state(state, label)
    if rows["previous_official_present"] == "true":
        restored_driver = stable_read(
            OFFICIAL,
            "official_rollback_final",
            executable=True,
        )
        restored_receipt = stable_read(
            OFFICIAL_RECEIPT,
            "official_receipt_rollback_final",
        )
        if (
            restored_driver.sha256 != rows["previous_official_sha256"]
            or str(restored_driver.info.st_dev)
            != rows["previous_official_device"]
            or str(restored_driver.info.st_ino)
            != rows["previous_official_inode"]
            or restored_receipt.sha256 != rows["previous_receipt_sha256"]
            or str(restored_receipt.info.st_dev)
            != rows["previous_receipt_device"]
            or str(restored_receipt.info.st_ino)
            != rows["previous_receipt_inode"]
        ):
            fail("official_rollback_final_identity_invalid")
    else:
        canonical_path(
            OFFICIAL,
            "official_rollback_final",
            allow_absent=True,
        )
        canonical_path(
            OFFICIAL_RECEIPT,
            "official_receipt_rollback_final",
            allow_absent=True,
        )
    canonical_path(
        transaction_path,
        "transaction_private_cleanup",
        allow_absent=True,
    )
    unlink_state(active, "official_active_transaction_cleanup")


def install(args: argparse.Namespace) -> None:
    live_root = canonical_path(
        pathlib.Path(args.live_root), "live_root", directory=True
    )
    if live_root != ROOT:
        fail("live_root_not_authoritative")
    official = pathlib.Path(args.official)
    if official != OFFICIAL:
        fail("official_path_not_authoritative")
    manifest = stable_read(pathlib.Path(args.manifest), "source_manifest")
    compiler_candidate = stable_read(
        pathlib.Path(args.compiler_candidate),
        "compiler_candidate",
        executable=True,
    )
    compiler_receipt = stable_read(
        pathlib.Path(args.compiler_receipt), "compiler_build_receipt"
    )
    validate_live_manifest(live_root, manifest)
    artifacts = validate_bootstrap(
        pathlib.Path(args.raw_root),
        manifest,
        compiler_candidate,
        compiler_receipt,
    )
    official.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if pathlib.Path(os.path.realpath(official.parent)) != official.parent:
        fail("official_parent_not_canonical")
    previous = read_existing_official()
    transaction_path = pathlib.Path(args.transaction)
    transaction = prepare_install_transaction(
        transaction_path,
        pathlib.Path(args.rollback_driver),
        pathlib.Path(args.rollback_receipt),
        compiler_candidate,
        manifest,
    )
    transaction_rows = validate_install_transaction(
        transaction.path,
        published=True,
    )
    active_rows = validate_install_transaction(
        OFFICIAL_TRANSACTION,
        published=True,
    )
    if active_rows != transaction_rows:
        fail("official_active_transaction_drift")
    if (
        transaction_rows["previous_official_present"]
        != ("true" if previous is not None else "false")
        or transaction_rows["previous_official_sha256"]
        != (previous.sha256 if previous is not None else "")
        or transaction_rows["previous_official_device"]
        != (str(previous.info.st_dev) if previous is not None else "0")
        or transaction_rows["previous_official_inode"]
        != (str(previous.info.st_ino) if previous is not None else "0")
    ):
        fail("previous_official_changed_before_transaction")
    staged = decode_path(
        transaction_rows,
        "official_staging_path_fshex",
        "official_staging",
    )
    staged_state = stable_read(
        staged,
        "official_staging",
        executable=True,
    )
    if (
        staged_state.raw != artifacts["gen2"].raw
        or staged_state.sha256 != artifacts["gen2"].sha256
        or staged_state.info.st_size
        != require_uint(
            transaction_rows["candidate_size"],
            "transaction_candidate_size",
        )
    ):
        fail("official_staging_bytes_mismatch")
    validate_live_manifest(live_root, manifest)
    replace_durable(staged, official)
    canonical_path(
        staged,
        "official_staging_after_install",
        allow_absent=True,
    )
    current = stable_read(official, "installed_official", executable=True)
    if current.raw != artifacts["gen2"].raw:
        fail("installed_official_bytes_mismatch")
    if (current.info.st_dev, current.info.st_ino) == (
        artifacts["gen2"].info.st_dev,
        artifacts["gen2"].info.st_ino,
    ):
        fail("installed_official_inode_alias")
    validate_live_manifest(live_root, manifest)
    lines = [
        "schema=cheng.backend2.current_source_official_install_receipt",
        "status=PASS",
        "driver_role=production",
        "source_manifest_path_fshex=" + os.fsencode(manifest.path).hex(),
        "source_manifest_sha256=" + manifest.sha256,
        "compiler_candidate_path_fshex="
        + os.fsencode(compiler_candidate.path).hex(),
        "compiler_candidate_sha256=" + compiler_candidate.sha256,
        "compiler_build_receipt_path_fshex="
        + os.fsencode(compiler_receipt.path).hex(),
        "compiler_build_receipt_sha256=" + compiler_receipt.sha256,
        "bootstrap_summary_sha256=" + artifacts["summary"].sha256,
        "bootstrap_fixed_point_sha256=" + artifacts["fixed"].sha256,
        "bootstrap_gen2_sha256=" + artifacts["gen2"].sha256,
        "bootstrap_gen3_sha256=" + artifacts["gen3"].sha256,
        "previous_official_present=" + ("true" if previous else "false"),
        "previous_official_sha256=" + (previous.sha256 if previous else ""),
        "previous_official_device="
        + (str(previous.info.st_dev) if previous else "0"),
        "previous_official_inode="
        + (str(previous.info.st_ino) if previous else "0"),
        "official_path_fshex=" + os.fsencode(current.path).hex(),
        "official_sha256=" + current.sha256,
        "official_device=" + str(current.info.st_dev),
        "official_inode=" + str(current.info.st_ino),
        "official_size=" + str(current.info.st_size),
    ]
    try:
        receipt = exclusive_write(
            pathlib.Path(args.receipt),
            rendered(lines, "receipt_payload_sha256"),
        )
        validate_install(receipt.path)
    except Exception:
        rollback_transaction(transaction_path, None)
        raise


def validate_install_state(
    path: pathlib.Path,
) -> tuple[FileState, dict[str, str]]:
    state = stable_read(path, "install_receipt")
    rows = parse_rows(state, "install_receipt")
    validate_payload_hash(state, rows, "receipt_payload_sha256", "install_receipt")
    expected_keys = {
        "schema",
        "status",
        "driver_role",
        "source_manifest_path_fshex",
        "source_manifest_sha256",
        "compiler_candidate_path_fshex",
        "compiler_candidate_sha256",
        "compiler_build_receipt_path_fshex",
        "compiler_build_receipt_sha256",
        "bootstrap_summary_sha256",
        "bootstrap_fixed_point_sha256",
        "bootstrap_gen2_sha256",
        "bootstrap_gen3_sha256",
        "previous_official_present",
        "previous_official_sha256",
        "previous_official_device",
        "previous_official_inode",
        "official_path_fshex",
        "official_sha256",
        "official_device",
        "official_inode",
        "official_size",
        "receipt_payload_sha256",
    }
    if set(rows) != expected_keys:
        fail("install_receipt_key_set_invalid")
    if (
        rows.get("schema")
        != "cheng.backend2.current_source_official_install_receipt"
        or rows.get("status") != "PASS"
        or rows.get("driver_role") != "production"
        or rows.get("previous_official_present") not in ("true", "false")
    ):
        fail("install_receipt_header_invalid")
    official_path = pathlib.Path(
        os.fsdecode(bytes.fromhex(rows.get("official_path_fshex", "")))
    )
    if official_path != OFFICIAL:
        fail("install_receipt_official_path_invalid")
    official = stable_read(official_path, "installed_official", executable=True)
    if (
        official.sha256 != require_sha(rows.get("official_sha256", ""), "official")
        or rows.get("official_device") != str(official.info.st_dev)
        or rows.get("official_inode") != str(official.info.st_ino)
        or rows.get("official_size") != str(official.info.st_size)
    ):
        fail("install_receipt_official_identity_drift")
    manifest_path = pathlib.Path(
        os.fsdecode(bytes.fromhex(rows.get("source_manifest_path_fshex", "")))
    )
    manifest = stable_read(manifest_path, "source_manifest")
    if manifest.sha256 != require_sha(
        rows.get("source_manifest_sha256", ""), "source_manifest"
    ):
        fail("install_receipt_source_manifest_drift")
    validate_live_manifest(ROOT, manifest)
    compiler_candidate_path = decode_path(
        rows,
        "compiler_candidate_path_fshex",
        "compiler_candidate",
    )
    compiler_candidate = stable_read(
        compiler_candidate_path,
        "compiler_candidate",
        executable=True,
    )
    if compiler_candidate.sha256 != require_sha(
        rows.get("compiler_candidate_sha256", ""),
        "compiler_candidate",
    ):
        fail("install_receipt_compiler_candidate_drift")
    compiler_receipt_path = decode_path(
        rows,
        "compiler_build_receipt_path_fshex",
        "compiler_build_receipt",
    )
    compiler_receipt = stable_read(
        compiler_receipt_path,
        "compiler_build_receipt",
    )
    if compiler_receipt.sha256 != require_sha(
        rows.get("compiler_build_receipt_sha256", ""),
        "compiler_build_receipt",
    ):
        fail("install_receipt_compiler_receipt_drift")
    validate_compiler_build_evidence(
        compiler_candidate,
        compiler_receipt,
        manifest,
        "install_compiler_build",
    )
    terminal = stable_read(path, "install_receipt_terminal")
    if terminal.raw != state.raw or identity(terminal.info) != identity(state.info):
        fail("install_receipt_terminal_drift")
    return terminal, rows


def validate_install(path: pathlib.Path) -> dict[str, str]:
    _state, rows = validate_install_state(path)
    return rows


def validate_official_receipt_state(
    path: pathlib.Path,
    source_manifest: FileState,
) -> tuple[FileState, dict[str, str]]:
    held = held_read(path, "official_publisher_receipt")
    validator: HeldFileState | None = None
    try:
        validator = held_read(
            OFFICIAL_EVIDENCE,
            "official_publisher_validator",
            executable=True,
        )
        parsed_manifest = source_snapshot.parse_manifest(
            str(source_manifest.path)
        )
        if parsed_manifest.raw != source_manifest.raw:
            fail("official_publisher_validator_manifest_parse_drift")
        validator_rows = tuple(
            row
            for row in parsed_manifest.present
            if row.relative
            == b"tools/backend2_current_source_official_evidence"
        )
        if (
            len(validator_rows) != 1
            or validator.state.path
            != ROOT / os.fsdecode(validator_rows[0].relative)
            or validator.state.sha256
            != validator_rows[0].sha256.decode("ascii")
            or validator.state.info.st_size != validator_rows[0].size
            or stat.S_IMODE(validator.state.info.st_mode)
            != stat.S_IMODE(validator_rows[0].mode)
        ):
            fail("official_publisher_validator_manifest_binding_invalid")
        os.set_inheritable(held.descriptor, True)
        os.set_inheritable(validator.descriptor, True)
        completed = subprocess.run(
            [
                sys.executable,
                "-I",
                "-S",
                "-B",
                "/dev/fd/" + str(validator.descriptor),
                "validate-fd",
                str(held.descriptor),
                str(held.state.path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            pass_fds=(held.descriptor, validator.descriptor),
            check=False,
        )
        if completed.returncode != 0:
            fail("official_publisher_receipt_invalid")
        state = held_named_state(
            held,
            held.state.path,
            1,
            "official_publisher_receipt_terminal",
        )
        held_named_state(
            validator,
            validator.state.path,
            1,
            "official_publisher_validator_terminal",
        )
    finally:
        close_held(held, "official_publisher_receipt")
        if validator is not None:
            close_held(validator, "official_publisher_validator")
    rows = parse_rows(state, "official_publisher_receipt")
    return state, rows


