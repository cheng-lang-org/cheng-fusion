def safe_remove_tree(args: argparse.Namespace) -> None:
    path = pathlib.Path(args.path)
    if (
        not path.is_absolute()
        or pathlib.Path(os.path.realpath(path.parent)) != path.parent
    ):
        fail("cleanup_path_not_canonical")
    info = path.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or str(info.st_dev) != args.device
        or str(info.st_ino) != args.inode
    ):
        fail("cleanup_root_identity_drift")
    for directory, names, files in os.walk(
        path,
        topdown=True,
        followlinks=False,
    ):
        directory_path = pathlib.Path(directory)
        directory_info = directory_path.lstat()
        if stat.S_ISLNK(directory_info.st_mode):
            fail("cleanup_directory_symlink")
        os.chmod(directory_path, 0o700)
        for name in names:
            child = directory_path / name
            if stat.S_ISLNK(child.lstat().st_mode):
                fail("cleanup_child_symlink")
        for name in files:
            child = directory_path / name
            if stat.S_ISLNK(child.lstat().st_mode):
                fail("cleanup_file_symlink")
    shutil.rmtree(path)
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def observed_path_rows(
    path: pathlib.Path,
    prefix: str,
    *,
    hash_regular: bool,
) -> list[str]:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return [
            prefix + ".present=false",
            prefix + ".kind=absent",
            prefix + ".device=0",
            prefix + ".inode=0",
            prefix + ".mode=0",
            prefix + ".size=0",
            prefix + ".sha256=",
        ]
    if stat.S_ISREG(info.st_mode):
        kind = "regular"
    elif stat.S_ISDIR(info.st_mode):
        kind = "directory"
    elif stat.S_ISLNK(info.st_mode):
        kind = "symlink"
    else:
        kind = "other"
    digest = ""
    if hash_regular and kind == "regular":
        digest = stable_read(path, "preflight_" + prefix).sha256
    return [
        prefix + ".present=true",
        prefix + ".kind=" + kind,
        prefix + ".device=" + str(info.st_dev),
        prefix + ".inode=" + str(info.st_ino),
        prefix + ".mode=" + format(stat.S_IMODE(info.st_mode), "o"),
        prefix + ".size=" + str(info.st_size),
        prefix + ".sha256=" + digest,
    ]


def tree_observation(path: pathlib.Path) -> tuple[int, int, int, bool]:
    entry_count = 0
    regular_count = 0
    regular_bytes = 0
    symlink_seen = False
    for directory, names, files in os.walk(
        path,
        topdown=True,
        followlinks=False,
    ):
        directory_path = pathlib.Path(directory)
        for name in names:
            entry_count += 1
            child = directory_path / name
            child_info = child.lstat()
            if stat.S_ISLNK(child_info.st_mode):
                symlink_seen = True
        for name in files:
            entry_count += 1
            child = directory_path / name
            child_info = child.lstat()
            if stat.S_ISLNK(child_info.st_mode):
                symlink_seen = True
            elif stat.S_ISREG(child_info.st_mode):
                regular_count += 1
                regular_bytes += child_info.st_size
    return entry_count, regular_count, regular_bytes, symlink_seen


def failed_seed_attempt(
    compiler_root: pathlib.Path,
) -> dict[str, str] | None:
    guard_path = (
        compiler_root
        / "bootstrap-c-seed.build.process-tree-guard.report.txt"
    )
    try:
        guard_state = stable_read(guard_path, "failed_seed_guard")
    except FileNotFoundError:
        return None
    rows = parse_rows(guard_state, "failed_seed_guard")
    rc = require_uint(rows.get("rc", ""), "failed_seed_rc")
    if (
        rows.get("schema") != "beat_c_process_memory_guard"
        or rows.get("status") != "completed"
        or rc <= 0
        or rows.get("formal_command_identity_status")
        != "required_verified"
        or rows.get("output_path_history_status") != "verified_clean"
        or rows.get("process_tree_escape_pid") != "0"
        or rows.get("memory_limit_bytes") != "805306368"
        or require_uint(
            rows.get("process_tree_enforced_peak_bytes", ""),
            "failed_seed_peak",
        )
        > 805_306_368
        or rows.get("command_path") != rows.get("expected_command_path")
        or rows.get("command_sha256")
        != rows.get("expected_command_sha256")
    ):
        fail("failed_seed_guard_contract_invalid")
    if (
        rows.get("report_path") != str(guard_path)
        or rows.get("report_device") != str(guard_state.info.st_dev)
        or rows.get("report_inode") != str(guard_state.info.st_ino)
    ):
        fail("failed_seed_guard_identity_invalid")
    artifact_specs = (
        (
            "stdout",
            compiler_root / "bootstrap-c-seed.build.stdout.txt",
        ),
        (
            "stderr",
            compiler_root / "bootstrap-c-seed.build.stderr.txt",
        ),
        (
            "resource_trace",
            compiler_root / "bootstrap-c-seed.build.resource-trace.tsv",
        ),
    )
    artifact_states: dict[str, FileState] = {}
    for prefix, expected_path in artifact_specs:
        state = stable_read(expected_path, "failed_seed_" + prefix)
        artifact_states[prefix] = state
        if (
            rows.get(prefix + "_status") != "available"
            or rows.get(prefix + "_path") != str(expected_path)
            or rows.get(prefix + "_sha256") != state.sha256
            or rows.get(prefix + "_device") != str(state.info.st_dev)
            or rows.get(prefix + "_inode") != str(state.info.st_ino)
            or rows.get(prefix + "_size") != str(state.info.st_size)
        ):
            fail("failed_seed_artifact_binding_invalid:" + prefix)
    if artifact_states["stderr"].info.st_size <= 0:
        fail("failed_seed_stderr_empty")
    argv_state = stable_read(
        compiler_root / "bootstrap-c-seed.build.argv.manifest.txt",
        "failed_seed_argv_manifest",
    )
    env_state = stable_read(
        compiler_root / "bootstrap-c-seed.build.env.manifest.txt",
        "failed_seed_env_manifest",
    )
    argv_rows = parse_rows(argv_state, "failed_seed_argv_manifest")
    env_rows = parse_rows(env_state, "failed_seed_env_manifest")
    if (
        argv_rows.get("schema") != "cheng.guard.argv_manifest"
        or env_rows.get("schema") != "cheng.guard.env_manifest"
        or require_sha(
            argv_rows.get("sha256", ""), "failed_seed_argv_manifest"
        )
        != require_sha(
            rows.get("command_argv_sha256", ""), "failed_seed_guard_argv"
        )
        or require_sha(
            env_rows.get("sha256", ""), "failed_seed_env_manifest"
        )
        != require_sha(
            rows.get("target_env_requested_sha256", ""),
            "failed_seed_guard_env",
        )
    ):
        fail("failed_seed_command_contract_invalid")
    tracked = (
        (
            "producer_receipt",
            compiler_root
            / "guard-env"
            / "bootstrap-c-seed-system-link"
            / "tmp"
            / "system-link-producer-receipt.kv",
            "regular",
        ),
    )
    if rows.get("tracked_output_count") != str(len(tracked)):
        fail("failed_seed_tracked_output_count_invalid")
    empty_count = 0
    for index, (label, expected_path, expected_mode) in enumerate(tracked):
        prefix = "tracked_output_" + str(index) + "_"
        state = stable_read(expected_path, "failed_seed_" + label)
        if (
            rows.get(prefix + "label") != label
            or rows.get(prefix + "path") != str(expected_path)
            or rows.get(prefix + "status") != "available_unvalidated"
            or rows.get(prefix + "required_mode") != expected_mode
            or rows.get(prefix + "sha256") != state.sha256
            or rows.get(prefix + "device") != str(state.info.st_dev)
            or rows.get(prefix + "inode") != str(state.info.st_ino)
            or rows.get(prefix + "size") != str(state.info.st_size)
            or rows.get(prefix + "identity_stable") != "1"
        ):
            fail("failed_seed_tracked_output_binding_invalid:" + label)
        if state.info.st_size == 0:
            empty_count += 1
    return {
        "rc": str(rc),
        "guard_sha256": guard_state.sha256,
        "stderr_sha256": artifact_states["stderr"].sha256,
        "empty_output_count": str(empty_count),
    }


