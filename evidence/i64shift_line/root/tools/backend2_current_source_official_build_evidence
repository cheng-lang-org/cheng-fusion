    expected_env_sha256 = scratch_env_sha256(expected_env)
    expected_rows = {
        "schema": "beat_c_process_memory_guard",
        "status": "completed",
        "rc": "0",
        "abort_reason": "",
        "expected_exit_code": "0",
        "actual_exit_code": "0",
        "exit_code_contract_status": "verified",
