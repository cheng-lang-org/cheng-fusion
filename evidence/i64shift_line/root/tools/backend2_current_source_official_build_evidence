    expected_inputs = {
        relative: expected_sha256
        for (
            _label,
            relative,
            expected_sha256,
            _expected_mode,
            _executable,
        ) in COLD_CODEGEN_SCRATCH_GATE_INPUTS
    }
    if (
        scratch_gate.sha256
        != expected_inputs["tools/cold_codegen_scratch_lifetime_gate.sh"]
        or scratch_harness.sha256
        != expected_inputs["tools/cold_codegen_scratch_lifetime_gate.c"]
