    )
    if (
        identity(source_manifest.info) != identity(source_manifest_after.info)
        or source_manifest.raw != source_manifest_after.raw
    ):
        fail("scratch_source_manifest_changed_during_validation")
    scratch_gate = stable_read(
        source_root / "tools/cold_codegen_scratch_lifetime_gate.sh",
