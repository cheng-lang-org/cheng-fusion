def fail(reason: str) -> None:
    raise BuildEvidenceError(reason)


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def canonical_path(
    path: pathlib.Path,
    label: str,
    *,
    directory: bool = False,
    allow_absent: bool = False,
) -> pathlib.Path:
    if not path.is_absolute():
        fail(label + "_not_absolute")
    if allow_absent:
        parent = pathlib.Path(os.path.realpath(path.parent))
        if parent != path.parent:
            fail(label + "_parent_not_canonical")
        try:
            path.lstat()
        except FileNotFoundError:
            return path
        fail(label + "_must_be_absent")
    resolved = pathlib.Path(os.path.realpath(path))
    if resolved != path:
        fail(label + "_not_canonical")
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode):
        fail(label + "_symlink")
    if directory and not stat.S_ISDIR(info.st_mode):
        fail(label + "_not_directory")
    if not directory and not stat.S_ISREG(info.st_mode):
        fail(label + "_not_regular")
    return path


def stable_read(
    path: pathlib.Path,
    label: str,
    *,
    executable: bool = False,
    single_link: bool = True,
) -> FileState:
    path = canonical_path(path, label)
    before = path.lstat()
    if (single_link and before.st_nlink != 1) or (
        executable and before.st_mode & 0o111 == 0
    ):
        fail(label + "_identity_invalid")
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            fail(label + "_open_race")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, READ_BYTES)
            if not chunk:
                break
            digest.update(chunk)
            chunks.append(chunk)
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    if identity(before) != identity(closed) or identity(before) != identity(after):
        fail(label + "_read_race")
    raw = b"".join(chunks)
    if len(raw) != before.st_size:
        fail(label + "_short_read")
    return FileState(path, raw, digest.hexdigest(), before)


def held_read(
    path: pathlib.Path,
    label: str,
    *,
    executable: bool = False,
    single_link: bool = True,
) -> HeldFileState:
    path = canonical_path(path, label)
    before = path.lstat()
    if (single_link and before.st_nlink != 1) or (
        executable and before.st_mode & 0o111 == 0
    ):
        fail(label + "_identity_invalid")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            fail(label + "_open_race")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        offset = 0
        while offset < before.st_size:
            chunk = os.pread(
                descriptor,
                min(READ_BYTES, before.st_size - offset),
                offset,
            )
            if not chunk:
                fail(label + "_short_read")
            digest.update(chunk)
            chunks.append(chunk)
            offset += len(chunk)
        terminal = os.fstat(descriptor)
        named = path.lstat()
        if (
            identity(opened) != identity(terminal)
            or identity(opened) != identity(named)
        ):
            fail(label + "_read_race")
        raw = b"".join(chunks)
        if len(raw) != before.st_size:
            fail(label + "_short_read")
        return HeldFileState(
            FileState(path, raw, digest.hexdigest(), before),
            descriptor,
        )
    except Exception:
        os.close(descriptor)
        raise


def held_named_state(
    held: HeldFileState,
    named_path: pathlib.Path,
    expected_nlink: int,
    label: str,
) -> FileState:
    named_path = canonical_path(named_path, label)
    opened = os.fstat(held.descriptor)
    named = named_path.lstat()
    if (
        identity(opened) != identity(named)
        or opened.st_nlink != expected_nlink
        or (
            opened.st_dev,
            opened.st_ino,
            opened.st_mode,
            opened.st_uid,
            opened.st_gid,
            opened.st_size,
        )
        != (
            held.state.info.st_dev,
            held.state.info.st_ino,
            held.state.info.st_mode,
            held.state.info.st_uid,
            held.state.info.st_gid,
            held.state.info.st_size,
        )
    ):
        fail(label + "_identity_drift")
    digest = hashlib.sha256()
    chunks: list[bytes] = []
    offset = 0
    while offset < opened.st_size:
        chunk = os.pread(
            held.descriptor,
            min(READ_BYTES, opened.st_size - offset),
            offset,
        )
        if not chunk:
            fail(label + "_short_read")
        digest.update(chunk)
        chunks.append(chunk)
        offset += len(chunk)
    terminal = os.fstat(held.descriptor)
    terminal_named = named_path.lstat()
    raw = b"".join(chunks)
    if (
        identity(opened) != identity(terminal)
        or identity(opened) != identity(terminal_named)
        or raw != held.state.raw
        or digest.hexdigest() != held.state.sha256
    ):
        fail(label + "_terminal_drift")
    return FileState(
        named_path,
        raw,
        digest.hexdigest(),
        terminal,
    )


def close_held(held: HeldFileState, label: str) -> None:
    try:
        os.close(held.descriptor)
    except OSError as error:
        raise BuildEvidenceError(label + "_close_failed") from error
    held.descriptor = -1


def parse_rows(state: FileState, label: str) -> dict[str, str]:
    try:
        text = state.raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise BuildEvidenceError(label + "_not_utf8") from error
    if not text.endswith("\n") or "\r" in text or "\0" in text:
        fail(label + "_encoding_invalid")
    rows: dict[str, str] = {}
    for line in text.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or key in rows:
            fail(label + "_row_invalid")
        rows[key] = value
    return rows


def parse_report_rows(state: FileState, label: str) -> dict[str, str]:
    try:
        text = state.raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise BuildEvidenceError(label + "_not_utf8") from error
    if not text.endswith("\n") or "\r" in text or "\0" in text:
        fail(label + "_encoding_invalid")
    rows: dict[str, str] = {}
    for line in text.splitlines():
        if line == "":
            continue
        key, separator, value = line.partition("=")
        if not separator or not key or key in rows:
            fail(label + "_row_invalid")
        rows[key] = value
    return rows


def require_sha(value: str, label: str) -> str:
    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
        fail(label + "_sha256_invalid")
    return value


def require_uint(value: str, label: str) -> int:
    if (
        not value
        or not value.isascii()
        or not value.isdigit()
        or len(value) > 1
        and value.startswith("0")
    ):
        fail(label + "_uint_invalid")
    return int(value)


def validate_encoder_build_projection_rows(
    rows: dict[str, str],
    label: str,
) -> dict[str, str]:
    prefix = "encoder_build_projection_"
    schema_key = prefix + "schema"
    if rows.get(schema_key) != ENCODER_BUILD_PROJECTION_SCHEMA:
        fail(label + "_schema_invalid")

    fixed_fields = (
        "build_authority_cid",
        "compiler_csg_artifact_cid",
        "compiler_csg_canonical_graph_cid",
        "compiler_csg_cargo_cid",
        "compiler_csg_cargo_object_receipt_cid",
        "compiler_csg_facts_root_cid",
        "compiler_csg_graph_cid",
        "compiler_csg_source_bundle_cid",
        "content_cid",
        "document_cid",
        "projection_cid",
        "receipt_cid",
    )
    fixed: dict[str, str] = {}
    empty_sha256 = hashlib.sha256(b"").hexdigest()
    zero_sha256 = "0" * 64
    for field in fixed_fields:
        value = require_sha(rows.get(prefix + field, ""), label + "_" + field)
        if value in (empty_sha256, zero_sha256):
            fail(label + "_" + field + "_unobserved")
        fixed[field] = value

    integer_fields = (
        "canonical_row",
        "module_path_text_id",
        "producer_row",
    )
    integers: dict[str, int] = {}
    for field in integer_fields:
        value = require_uint(rows.get(prefix + field, ""), label + "_" + field)
        if value > 2147483647:
            fail(label + "_" + field + "_out_of_range")
        integers[field] = value

    source_bundle = rows.get("source_bundle_cid")
    if source_bundle is not None and (
        require_sha(source_bundle, label + "_source_bundle")
        != fixed["compiler_csg_source_bundle_cid"]
    ):
        fail(label + "_source_bundle_drift")

    def framed_text(value: str) -> bytes:
        raw = value.encode("utf-8")
        return len(raw).to_bytes(4, "big") + raw

    def framed_fixed(field: str) -> bytes:
        return (32).to_bytes(4, "big") + bytes.fromhex(fixed[field])

    def framed_i32(field: str) -> bytes:
        return (4).to_bytes(4, "big") + integers[field].to_bytes(4, "big")

    common = b"".join(
        (
            framed_fixed("build_authority_cid"),
            framed_fixed("compiler_csg_artifact_cid"),
            framed_fixed("compiler_csg_graph_cid"),
            framed_fixed("compiler_csg_canonical_graph_cid"),
            framed_fixed("compiler_csg_source_bundle_cid"),
            framed_fixed("compiler_csg_cargo_cid"),
            framed_fixed("compiler_csg_facts_root_cid"),
            framed_fixed("compiler_csg_cargo_object_receipt_cid"),
            framed_i32("producer_row"),
            framed_i32("canonical_row"),
            framed_i32("module_path_text_id"),
            framed_fixed("document_cid"),
            framed_fixed("content_cid"),
        )
    )
    projection_cid = hashlib.sha256(
        framed_text(ENCODER_BUILD_PROJECTION_DOMAIN) + common
    ).hexdigest()
    if projection_cid != fixed["projection_cid"]:
        fail(label + "_projection_cid_mismatch")
    receipt_cid = hashlib.sha256(
        framed_text(ENCODER_BUILD_PROJECTION_RECEIPT_DOMAIN)
        + common
        + framed_fixed("projection_cid")
    ).hexdigest()
    if receipt_cid != fixed["receipt_cid"]:
        fail(label + "_receipt_cid_mismatch")

    return {key: rows[key] for key in ENCODER_BUILD_PROJECTION_KEYS}


def validate_encoder_cargo_object_rows(
    rows: dict[str, str],
    label: str,
) -> dict[str, object]:
    prefix = "encoder_build_projection_cargo_"
    integer_names = (
        "object_authority_slot",
        "object_authority_generation",
        "object_row",
        "store_generation",
        "byte_count",
    )
    integers = {
        name: require_uint(rows.get(prefix + name, ""), label + "_" + name)
        for name in integer_names
    }
    if (
        integers["object_authority_slot"] > 2147483647
        or integers["object_authority_generation"] == 0
        or integers["object_authority_generation"] > 2147483647
        or integers["object_row"] != integers["object_authority_slot"]
        or integers["store_generation"] == 0
        or integers["store_generation"] > 9223372036854775807
        or integers["byte_count"] == 0
        or integers["byte_count"] > 2147483647
    ):
        fail(label + "_integer_binding_invalid")

    fixed_names = (
        "store_identity_cid",
        "before_store_identity_cid",
        "head_cid",
        "manifest_cid",
        "store_receipt_cid",
        "csgc_object_cid",
        "absolute_path_cid",
        "before_read_observation_cid",
        "after_read_observation_cid",
    )
    fixed = {
        name: require_sha(rows.get(prefix + name, ""), label + "_" + name)
        for name in fixed_names
    }
    empty_sha256 = hashlib.sha256(b"").hexdigest()
    if any(value in ("0" * 64, empty_sha256) for value in fixed.values()):
        fail(label + "_fixed_value_unobserved")

    absolute_path_text = rows.get(prefix + "absolute_path", "")
    if not absolute_path_text:
        fail(label + "_absolute_path_missing")
    absolute_path = canonical_path(
        pathlib.Path(absolute_path_text),
        label + "_absolute_path",
    )
    absolute_path_cid = hashlib.sha256(
        framed_text(
            "cheng.compiler.snapshot_lowering.cargo_object.absolute_path.v1",
            label,
        )
        + framed_text(str(absolute_path), label)
    ).hexdigest()
    if absolute_path_cid != fixed["absolute_path_cid"]:
        fail(label + "_absolute_path_cid_mismatch")
    cargo_state = stable_read(absolute_path, label + "_cargo_object")
    if (
        cargo_state.info.st_size != integers["byte_count"]
        or cargo_state.sha256
        != require_sha(
            rows.get("encoder_build_projection_compiler_csg_cargo_cid", ""),
            label + "_cargo_cid",
        )
    ):
        fail(label + "_cargo_bytes_binding_invalid")

    def raw_i32(name: str) -> bytes:
        return integers[name].to_bytes(4, "big")

    def raw_i64(name: str) -> bytes:
        return integers[name].to_bytes(8, "big")

    def raw_fixed(name: str) -> bytes:
        return bytes.fromhex(fixed[name])

    common = b"".join(
        (
            raw_i32("object_authority_slot"),
            raw_i32("object_authority_generation"),
            raw_i32("object_row"),
            raw_i64("store_generation"),
            raw_fixed("store_identity_cid"),
            raw_fixed("before_store_identity_cid"),
            raw_fixed("head_cid"),
            raw_fixed("manifest_cid"),
            raw_fixed("store_receipt_cid"),
            raw_fixed("csgc_object_cid"),
            raw_fixed("absolute_path_cid"),
            raw_i32("byte_count"),
            bytes.fromhex(rows["encoder_build_projection_compiler_csg_cargo_cid"]),
            bytes.fromhex(rows["encoder_build_projection_compiler_csg_facts_root_cid"]),
            bytes.fromhex(rows["encoder_build_projection_content_cid"]),
        )
    )
    observation_domain = framed_text(
        "cheng.compiler.snapshot_lowering.cargo_object.stable_read.v1",
        label,
    )
    for ordinal, field in (
        (0, "before_read_observation_cid"),
        (1, "after_read_observation_cid"),
    ):
        observed = hashlib.sha256(
            observation_domain + ordinal.to_bytes(4, "big") + common
        ).hexdigest()
        if observed != fixed[field]:
            fail(label + "_" + field + "_mismatch")
    receipt_cid = hashlib.sha256(
        framed_text(
            "cheng.compiler.snapshot_lowering.cargo_object.receipt.v1",
            label,
        )
        + common
        + raw_fixed("before_read_observation_cid")
        + raw_fixed("after_read_observation_cid")
    ).hexdigest()
    if receipt_cid != require_sha(
        rows.get(
            "encoder_build_projection_compiler_csg_cargo_object_receipt_cid",
            "",
        ),
        label + "_receipt_cid",
    ):
        fail(label + "_receipt_cid_mismatch")
    return {
        "absolute_path": absolute_path,
        "cargo_state": cargo_state,
        "receipt_cid": receipt_cid,
    }


def framed_text(value: str, label: str) -> bytes:
    raw = value.encode("utf-8")
    if len(raw) >= 1 << 32:
        fail(label + "_text_too_large")
    return len(raw).to_bytes(4, "big") + raw


def report_required(rows: dict[str, str], key: str, label: str) -> str:
    value = rows.get(key)
    if value is None or value == "":
        fail(label + "_field_missing:" + key)
    return value


def report_fixed(rows: dict[str, str], key: str, label: str) -> bytes:
    value = require_sha(report_required(rows, key, label), label + "_" + key)
    if value in ("0" * 64, hashlib.sha256(b"").hexdigest()):
        fail(label + "_unobserved:" + key)
    return bytes.fromhex(value)


def report_uint(rows: dict[str, str], key: str, label: str) -> int:
    value = require_uint(report_required(rows, key, label), label + "_" + key)
    if value >= 1 << 32:
        fail(label + "_uint32_out_of_range:" + key)
    return value


def validate_private_source_snapshot(
    private_root: pathlib.Path,
    private_manifest: FileState,
    official_snapshot_root: pathlib.Path,
    receipt_rows: dict[str, str],
    label: str,
) -> dict[str, object]:
    manifest_rows = parse_rows(private_manifest, label + "_manifest")
    if (
        manifest_rows.get("schema") != "cheng.private_source_snapshot"
        or manifest_rows.get("status") != "frozen"
        or pathlib.Path(manifest_rows.get("workspace_root", ""))
        != official_snapshot_root
        or pathlib.Path(manifest_rows.get("snapshot_root", "")) != private_root
    ):
        fail(label + "_manifest_header_invalid")
    entry_count = require_uint(
        manifest_rows.get("entry_count", ""),
        label + "_entry_count",
    )
    compiler_source_count = require_uint(
        manifest_rows.get("compiler_source_count", ""),
        label + "_compiler_source_count",
    )
    if (
        entry_count <= 0
        or compiler_source_count <= 0
        or compiler_source_count > entry_count
        or entry_count > 1_000_000
    ):
        fail(label + "_manifest_count_invalid")

    expected_keys = [
        "schema",
        "status",
        "workspace_root",
        "snapshot_root",
        "entry_count",
        "compiler_source_count",
        "closure_sha256",
    ]
    entries: list[tuple[str, str, str, int, FileState]] = []
    official_entries: list[FileState] = []
    compiler_hash_rows: list[str] = []
    auxiliary_roles: dict[str, str] = {}
    previous_relative: bytes | None = None
    for index in range(entry_count):
        prefix = "entry." + str(index) + "."
        fields = (
            "relative",
            "role",
            "sha256",
            "bytes",
            "device",
            "inode",
            "mode",
            "mtime_ns",
            "ctime_ns",
        )
        expected_keys.extend(prefix + field for field in fields)
        relative = manifest_rows.get(prefix + "relative", "")
        relative_path = pathlib.PurePosixPath(relative)
        if (
            not relative
            or relative_path.is_absolute()
            or str(relative_path) != relative
            or any(part in ("", ".", "..") for part in relative_path.parts)
            or "\\" in relative
            or "\n" in relative
            or "\r" in relative
        ):
            fail(label + "_relative_invalid")
        relative_bytes = os.fsencode(relative)
        if previous_relative is not None and previous_relative >= relative_bytes:
            fail(label + "_relative_order_invalid")
        previous_relative = relative_bytes
        role = manifest_rows.get(prefix + "role", "")
        if role not in (
            "compiler_source",
            "backend2_manifest",
            "backend2_sentinel_script",
            "exact_probe_source",
        ):
            fail(label + "_role_invalid")
        digest = require_sha(
            manifest_rows.get(prefix + "sha256", ""),
            label + "_entry_sha",
        )
        size = require_uint(
            manifest_rows.get(prefix + "bytes", ""),
            label + "_entry_bytes",
        )
        device = require_uint(
            manifest_rows.get(prefix + "device", ""),
            label + "_entry_device",
        )
        inode = require_uint(
            manifest_rows.get(prefix + "inode", ""),
            label + "_entry_inode",
        )
        mtime_ns = require_uint(
            manifest_rows.get(prefix + "mtime_ns", ""),
            label + "_entry_mtime",
        )
        ctime_ns = require_uint(
            manifest_rows.get(prefix + "ctime_ns", ""),
            label + "_entry_ctime",
        )
        if manifest_rows.get(prefix + "mode") != "400":
            fail(label + "_entry_mode_invalid")
        private_path = private_root.joinpath(*relative_path.parts)
        private_state = stable_read(private_path, label + "_entry")
        official_state = stable_read(
            official_snapshot_root.joinpath(*relative_path.parts),
            label + "_official_entry",
        )
        if (
            private_state.raw != official_state.raw
            or private_state.sha256 != digest
            or private_state.info.st_size != size
            or private_state.info.st_dev != device
            or private_state.info.st_ino != inode
            or stat.S_IMODE(private_state.info.st_mode) != 0o400
            or private_state.info.st_mtime_ns != mtime_ns
            or private_state.info.st_ctime_ns != ctime_ns
        ):
            fail(label + "_entry_binding_invalid:" + relative)
        if role == "compiler_source":
            if not (
                relative.startswith("src/") and relative.endswith(".cheng")
                or relative
                in (
                    "cheng-package.toml",
                    "cheng.lock.toml",
                    "docs/cheng-formal-spec.md",
                    "bootstrap/cheng_cold.c",
                    "tools/exact_process_tree_guard_report.py.sh",
                )
            ):
                fail(label + "_compiler_source_role_invalid")
            compiler_hash_rows.append(digest + "  " + relative + "\n")
        else:
            if role in auxiliary_roles:
                fail(label + "_auxiliary_role_duplicate")
            auxiliary_roles[role] = relative
        entries.append((relative, role, digest, size, private_state))
        official_entries.append(official_state)
    if tuple(manifest_rows) != tuple(expected_keys):
        fail(label + "_manifest_key_order_invalid")
    if len(compiler_hash_rows) != compiler_source_count:
        fail(label + "_compiler_source_count_mismatch")
    if auxiliary_roles != {
        "backend2_manifest": "tools/backend2_version_manifest.rec",
        "backend2_sentinel_script": "tools/backend2_version_sentinel.sh",
        "exact_probe_source": "tests/cheng/backend/fixtures/scalar_seq_literal_contract.cheng",
    }:
        fail(label + "_auxiliary_roles_invalid")

    actual_files: list[pathlib.Path] = []
    private_directory_identities: dict[pathlib.Path, tuple[int, ...]] = {}
    for directory, names, files in os.walk(private_root, followlinks=False):
        directory_path = pathlib.Path(directory)
        directory_info = directory_path.lstat()
        if (
            not stat.S_ISDIR(directory_info.st_mode)
            or stat.S_ISLNK(directory_info.st_mode)
            or stat.S_IMODE(directory_info.st_mode) != 0o500
        ):
            fail(label + "_directory_invalid")
        private_directory_identities[directory_path] = identity(directory_info)
        for name in names:
            child = directory_path / name
            child_info = child.lstat()
            if not stat.S_ISDIR(child_info.st_mode) or stat.S_ISLNK(
                child_info.st_mode
            ):
                fail(label + "_directory_child_invalid")
        for name in files:
            actual_files.append((directory_path / name).resolve())
    expected_files = [entry[4].path for entry in entries]
    if sorted(actual_files, key=os.fsencode) != sorted(
        expected_files,
        key=os.fsencode,
    ):
        fail(label + "_unmanifested_file")

    closure_payload = bytearray(
        framed_text("cheng.private_source_snapshot", label)
    )
    closure_payload.extend(entry_count.to_bytes(4, "big"))
    for relative, role, digest, size, _state in entries:
        closure_payload.extend(framed_text(relative, label))
        closure_payload.extend(framed_text(role, label))
        closure_payload.extend(bytes.fromhex(digest))
        closure_payload.extend(size.to_bytes(8, "big"))
    closure_sha = hashlib.sha256(closure_payload).hexdigest()
    if closure_sha != require_sha(
        manifest_rows.get("closure_sha256", ""),
        label + "_closure",
    ):
        fail(label + "_closure_mismatch")
    subset_sha = hashlib.sha256("".join(compiler_hash_rows).encode()).hexdigest()
    if subset_sha != receipt_rows.get("workspace_source_manifest_sha256"):
        fail(label + "_compiler_subset_manifest_mismatch")

    validation_reports: list[FileState] = []
    for phase in ("before", "after"):
        path_key = "private_source_snapshot_" + phase + "_validation_path"
        sha_key = "private_source_snapshot_" + phase + "_validation_sha256"
        expected_path = private_root.parent / (
            "cheng-source-snapshot." + phase + ".validation.txt"
        )
        if pathlib.Path(receipt_rows.get(path_key, "")) != expected_path:
            fail(label + "_validation_report_path_invalid:" + phase)
        report = stable_read(expected_path, label + "_validation_" + phase)
        if report.sha256 != require_sha(
            receipt_rows.get(sha_key, ""),
            label + "_validation_" + phase,
        ):
            fail(label + "_validation_report_drift:" + phase)
        report_rows = parse_rows(report, label + "_validation_" + phase)
        if tuple(report_rows) != (
            "schema",
            "status",
            "manifest_path",
            "manifest_sha256",
            "snapshot_root",
            "entry_count",
            "compiler_source_count",
            "closure_sha256",
        ) or report_rows != {
            "schema": "cheng.private_source_snapshot_validation",
            "status": "PASS",
            "manifest_path": str(private_manifest.path),
            "manifest_sha256": private_manifest.sha256,
            "snapshot_root": str(private_root),
            "entry_count": str(entry_count),
            "compiler_source_count": str(compiler_source_count),
            "closure_sha256": closure_sha,
        }:
            fail(label + "_validation_report_invalid:" + phase)
        validation_reports.append(report)
    if (
        receipt_rows.get("private_source_snapshot_schema")
        != "cheng.private_source_snapshot"
        or receipt_rows.get("private_source_snapshot_closure_sha256")
        != closure_sha
        or receipt_rows.get("private_source_snapshot_entry_count")
        != str(entry_count)
        or receipt_rows.get("private_source_snapshot_compiler_source_count")
        != str(compiler_source_count)
    ):
        fail(label + "_receipt_summary_invalid")
    if len(entries) != len(official_entries):
        fail(label + "_entry_state_count_drift")
    for entry, official_state in zip(entries, official_entries):
        private_state = entry[4]
        private_terminal = stable_read(
            private_state.path,
            label + "_entry_terminal",
        )
        official_terminal = stable_read(
            official_state.path,
            label + "_official_entry_terminal",
        )
        if (
            private_terminal.raw != private_state.raw
            or identity(private_terminal.info) != identity(private_state.info)
            or official_terminal.raw != official_state.raw
            or identity(official_terminal.info) != identity(official_state.info)
            or private_terminal.raw != official_terminal.raw
        ):
            fail(label + "_entry_terminal_drift:" + entry[0])
    for directory_path, directory_identity in private_directory_identities.items():
        if identity(directory_path.lstat()) != directory_identity:
            fail(label + "_directory_terminal_drift")
    for report in validation_reports:
        report_terminal = stable_read(
            report.path,
            label + "_validation_report_terminal",
        )
        if (
            report_terminal.raw != report.raw
            or identity(report_terminal.info) != identity(report.info)
        ):
            fail(label + "_validation_report_terminal_drift")
    return {
        "closure_sha256": closure_sha,
        "subset_sha256": subset_sha,
        "validation_reports": tuple(validation_reports),
    }


def validate_exact_materialize_guard(
    compiler_root: pathlib.Path,
    private_root: pathlib.Path,
    compiler_candidate: FileState,
    compiler_report: FileState,
    materialize_guard: FileState,
    receipt_rows: dict[str, str],
    label: str,
) -> tuple[FileState, ...]:
    helper = held_read(
        private_root / EXACT_GUARD_VALIDATOR_RELATIVE,
        label + "_helper",
    )
    materialize_path = compiler_root / "cheng"
    materialize_map_path = compiler_root / "cheng.map"
    candidate_map_path = compiler_root / "cheng.compiler-main.map"
    expected_paths = (
        pathlib.Path(receipt_rows.get("driver_path", "")),
        pathlib.Path(receipt_rows.get("monitor_python_path", "")),
        pathlib.Path(receipt_rows.get("monitor_runtime_script_path", "")),
        compiler_root / "cheng.compiler-main.materialize.argv.manifest.txt",
        compiler_root / "cheng.compiler-main.materialize.env.manifest.txt",
        compiler_root / "cheng.compiler-main.materialize.stdout.txt",
        compiler_root / "cheng.compiler-main.materialize.stderr.txt",
        compiler_root / "cheng.compiler-main.resource-trace.tsv",
        compiler_root / "cheng.compiler-main.phase-trace.tsv",
        candidate_map_path,
    )
    before_states = tuple(
        stable_read(
            path,
            label + "_input_" + str(index),
            executable=index in (0, 1),
        )
        for index, path in enumerate(expected_paths)
    )
    driver, monitor_python, monitor_runtime = before_states[:3]
    if (
        driver.sha256
        != require_sha(receipt_rows.get("driver_sha256", ""), label + "_driver")
        or monitor_python.sha256
        != require_sha(
            receipt_rows.get("monitor_python_sha256", ""),
            label + "_monitor_python",
        )
        or monitor_runtime.sha256
        != require_sha(
            receipt_rows.get("monitor_runtime_script_sha256", ""),
            label + "_monitor_runtime",
        )
    ):
        fail(label + "_tool_binding_invalid")
    os.set_inheritable(helper.descriptor, True)
    try:
        completed = subprocess.run(
            [
                sys.executable,
                "-I",
                "-S",
                "-B",
                "/dev/fd/" + str(helper.descriptor),
                str(materialize_guard.path),
                "0",
                str(driver.path),
                str(before_states[3].path),
                str(before_states[4].path),
                "available",
                str(monitor_python.path),
                "805306368",
                str(before_states[5].path),
                str(before_states[6].path),
                str(before_states[7].path),
                str(before_states[8].path),
                str(monitor_runtime.path),
                monitor_runtime.sha256,
                "candidate=1073741824:executable:" + str(materialize_path),
                "candidate_map=1073741824:regular:" + str(materialize_map_path),
                "compiler_report=1073741824:regular:" + str(compiler_report.path),
                "@moved=candidate:" + str(compiler_candidate.path),
                "@moved=candidate_map:" + str(candidate_map_path),
            ],
            cwd=str(ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            pass_fds=(helper.descriptor,),
            check=False,
        )
        if (
            completed.returncode != 0
            or completed.stdout != b""
            or completed.stderr != b""
        ):
            fail(
                label
                + "_shared_validator_failed:rc="
                + str(completed.returncode)
                + ":stdout_sha256="
                + hashlib.sha256(completed.stdout).hexdigest()
                + ":stderr_sha256="
                + hashlib.sha256(completed.stderr).hexdigest()
            )
        helper_terminal = held_named_state(
            helper,
            helper.state.path,
            1,
            label + "_helper_terminal",
        )
    finally:
        close_held(helper, label + "_helper")
    terminal_states = tuple(
        stable_read(
            state.path,
            label + "_input_terminal_" + str(index),
            executable=index in (0, 1),
        )
        for index, state in enumerate(before_states)
    )
    for index, (before, terminal) in enumerate(
        zip(before_states, terminal_states)
    ):
        if (
            before.raw != terminal.raw
            or identity(before.info) != identity(terminal.info)
        ):
            fail(label + "_input_terminal_drift:" + str(index))
    return (helper_terminal, *terminal_states)


def validate_encoder_projection_validator_evidence(
    compiler_root: pathlib.Path,
    private_root: pathlib.Path,
    compiler_report: FileState,
    receipt_rows: dict[str, str],
    encoder_projection: dict[str, str],
    label: str,
) -> tuple[FileState, ...]:
    expected_validator = compiler_root / "compiler-toolchain-encoder-projection-validator"
    expected_build_guard = compiler_root / (
        "compiler-toolchain-encoder-projection-validator.build."
        "process-tree-guard.report.txt"
    )
    expected_run_guard = compiler_root / (
        "compiler-toolchain-encoder-projection-validator."
        "process-tree-guard.report.txt"
    )
    expected_stdout = compiler_root / (
        "compiler-toolchain-encoder-projection-validator.stdout.txt"
    )
    if (
        receipt_rows.get("encoder_projection_validator_schema")
        != "cheng.compiler.toolchain_encoder_projection_validator.v1"
        or receipt_rows.get("encoder_projection_validator_status") != "pass"
        or pathlib.Path(receipt_rows.get("encoder_projection_validator_path", ""))
        != expected_validator
        or pathlib.Path(
            receipt_rows.get("encoder_projection_validator_build_guard_path", "")
        )
        != expected_build_guard
        or pathlib.Path(
            receipt_rows.get("encoder_projection_validator_guard_path", "")
        )
        != expected_run_guard
        or pathlib.Path(
            receipt_rows.get("encoder_projection_validator_stdout_path", "")
        )
        != expected_stdout
    ):
        fail(label + "_path_or_schema_binding_invalid")

    validator = stable_read(expected_validator, label + "_binary", executable=True)
    build_guard = stable_read(expected_build_guard, label + "_build_guard")
    run_guard = stable_read(expected_run_guard, label + "_run_guard")
    stdout = stable_read(expected_stdout, label + "_stdout")
    if (
        validator.sha256
        != require_sha(
            receipt_rows.get("encoder_projection_validator_sha256", ""),
            label + "_binary",
        )
        or build_guard.sha256
        != require_sha(
            receipt_rows.get("encoder_projection_validator_build_guard_sha256", ""),
            label + "_build_guard",
        )
        or run_guard.sha256
        != require_sha(
            receipt_rows.get("encoder_projection_validator_guard_sha256", ""),
            label + "_run_guard",
        )
        or stdout.sha256
        != require_sha(
            receipt_rows.get("encoder_projection_validator_stdout_sha256", ""),
            label + "_stdout",
        )
    ):
        fail(label + "_digest_binding_invalid")
    stdout_rows = parse_rows(stdout, label + "_stdout")
    if tuple(stdout_rows) != (
        "encoder_projection_validator_schema",
        "encoder_projection_validator_status",
        "encoder_projection_validator_build_projection_receipt_cid",
        "encoder_projection_validator_cargo_object_receipt_cid",
    ) or stdout_rows != {
        "encoder_projection_validator_schema":
            "cheng.compiler.toolchain_encoder_projection_validator.v1",
        "encoder_projection_validator_status": "pass",
        "encoder_projection_validator_build_projection_receipt_cid":
            encoder_projection[
                "encoder_build_projection_receipt_cid"
            ],
        "encoder_projection_validator_cargo_object_receipt_cid":
            encoder_projection[
                "encoder_build_projection_compiler_csg_cargo_object_receipt_cid"
            ],
    }:
        fail(label + "_stdout_binding_invalid")

    stage_manifest_path = compiler_root / "cheng.compiler-main.guarded-stages.txt"
    if (
        receipt_rows.get("guarded_stage_manifest_schema")
        != "current_source_compiler_guarded_stage_set"
        or receipt_rows.get("guarded_stage_count") != "10"
        or pathlib.Path(receipt_rows.get("guarded_stage_manifest_path", ""))
        != stage_manifest_path
    ):
        fail(label + "_stage_manifest_header_invalid")
    stage_manifest = stable_read(
        stage_manifest_path,
        label + "_stage_manifest",
    )
    if (
        stage_manifest.sha256
        != require_sha(
            receipt_rows.get("guarded_stage_manifest_sha256", ""),
            label + "_stage_manifest",
        )
        or stage_manifest.sha256
        != require_sha(
            receipt_rows.get("guarded_stage_set_sha256", ""),
            label + "_stage_set",
        )
    ):
        fail(label + "_stage_manifest_digest_invalid")
    stage_rows = parse_rows(stage_manifest, label + "_stage_manifest")
    stage_expectations = {
        "stage_count": "10",
        "stage.8.name": "encoder_projection_validator_build",
        "stage.8.execution_ordinal": "4",
        "stage.8.expected_rc": "0",
        "stage.8.guard_path": str(build_guard.path),
        "stage.8.guard_sha256": build_guard.sha256,
        "stage.8.output_path": str(validator.path),
        "stage.8.output_sha256": validator.sha256,
        "stage.9.name": "encoder_projection_validator",
        "stage.9.execution_ordinal": "5",
        "stage.9.expected_rc": "0",
        "stage.9.guard_path": str(run_guard.path),
        "stage.9.guard_sha256": run_guard.sha256,
        "stage.9.stdout_path": str(stdout.path),
        "stage.9.stdout_sha256": stdout.sha256,
    }
    for key, expected in stage_expectations.items():
        if stage_rows.get(key) != expected:
            fail(label + "_stage_manifest_binding_invalid:" + key)
    names = tuple(stage_rows.get("stage." + str(index) + ".name", "")
                  for index in range(10))
    ordinals = tuple(
        require_uint(
            stage_rows.get("stage." + str(index) + ".execution_ordinal", ""),
            label + "_stage_ordinal_" + str(index),
        )
        for index in range(10)
    )
    if len(set(names)) != 10 or set(ordinals) != set(range(10)):
        fail(label + "_stage_manifest_identity_invalid")

    stage3 = stable_read(
        pathlib.Path(receipt_rows.get("driver_path", "")),
        label + "_stage3",
        executable=True,
    )
    monitor_python = stable_read(
        pathlib.Path(receipt_rows.get("monitor_python_path", "")),
        label + "_monitor_python",
        executable=True,
        single_link=False,
    )
    monitor_runtime = stable_read(
        pathlib.Path(receipt_rows.get("monitor_runtime_script_path", "")),
        label + "_monitor_runtime",
    )
    if (
        stage3.sha256 != receipt_rows.get("driver_sha256")
        or monitor_python.sha256 != receipt_rows.get("monitor_python_sha256")
        or monitor_runtime.sha256
        != receipt_rows.get("monitor_runtime_script_sha256")
    ):
        fail(label + "_tool_binding_invalid")

    helper = held_read(
        private_root / EXACT_GUARD_VALIDATOR_RELATIVE,
        label + "_guard_validator",
    )
    artifact_specs = (
        (
            build_guard,
            stage3,
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.build.argv.manifest.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.build.env.manifest.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.build.stdout.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.build.stderr.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.build.resource-trace.tsv",
            (
                "encoder_projection_validator=1073741824:executable:"
                + str(validator.path),
                "encoder_projection_validator_map=1073741824:regular:"
                + str(validator.path) + ".map",
                "encoder_projection_validator_report=1073741824:regular:"
                + str(
                    compiler_root
                    / "compiler-toolchain-encoder-projection-validator.compile.report.txt"
                ),
            ),
        ),
        (
            run_guard,
            validator,
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.argv.manifest.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.env.manifest.txt",
            stdout.path,
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.stderr.txt",
            compiler_root
            / "compiler-toolchain-encoder-projection-validator.resource-trace.tsv",
            (),
        ),
    )
    bound_states: list[FileState] = [
        validator,
        build_guard,
        run_guard,
        stdout,
        stage_manifest,
        stage3,
        monitor_python,
        monitor_runtime,
    ]
    os.set_inheritable(helper.descriptor, True)
    try:
        for index, spec in enumerate(artifact_specs):
            (
                guard,
                command,
                argv_manifest_path,
                env_manifest_path,
                stdout_path,
                stderr_path,
                trace_path,
                tracked,
            ) = spec
            argv_manifest = stable_read(
                argv_manifest_path,
                label + "_argv_" + str(index),
            )
            env_manifest = stable_read(
                env_manifest_path,
                label + "_env_" + str(index),
            )
            stage_stdout = stable_read(
                stdout_path,
                label + "_stage_stdout_" + str(index),
            )
            stage_stderr = stable_read(
                stderr_path,
                label + "_stage_stderr_" + str(index),
            )
            trace = stable_read(
                trace_path,
                label + "_trace_" + str(index),
            )
            if stage_stderr.raw != b"":
                fail(label + "_stage_stderr_nonempty:" + str(index))
            completed = subprocess.run(
                [
                    sys.executable,
                    "-I",
                    "-S",
                    "-B",
                    "/dev/fd/" + str(helper.descriptor),
                    str(guard.path),
                    "0",
                    str(command.path),
                    str(argv_manifest.path),
                    str(env_manifest.path),
                    "disabled",
                    str(monitor_python.path),
                    "805306368",
                    str(stage_stdout.path),
                    str(stage_stderr.path),
                    str(trace.path),
                    "",
                    str(monitor_runtime.path),
                    monitor_runtime.sha256,
                    *tracked,
                ],
                cwd=str(ROOT),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                pass_fds=(helper.descriptor,),
                check=False,
            )
            if (
                completed.returncode != 0
                or completed.stdout != b""
                or completed.stderr != b""
            ):
                fail(
                    label
                    + "_guard_validation_failed:"
                    + str(index)
                    + ":rc="
                    + str(completed.returncode)
                    + ":stdout_sha256="
                    + hashlib.sha256(completed.stdout).hexdigest()
                    + ":stderr_sha256="
                    + hashlib.sha256(completed.stderr).hexdigest()
                )
            bound_states.extend(
                (
                    argv_manifest,
                    env_manifest,
                    stage_stdout,
                    stage_stderr,
                    trace,
                )
            )

        fresh_environment = {
            "PATH": "/usr/bin:/bin",
            "HOME": "/var/empty",
            "TMPDIR": "/private/var/tmp",
            "LC_ALL": "C",
            "LANG": "C",
            "CHENG_PROCESS_MAX_RSS_BYTES": "805306368",
            "CHENG_ENCODER_PROJECTION_WORKSPACE_ROOT": str(private_root),
            "CHENG_ENCODER_PROJECTION_REPORT_PATH": str(compiler_report.path),
        }
        fresh = subprocess.run(
            [str(validator.path)],
            cwd=str(private_root),
            env=fresh_environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if (
            fresh.returncode != 0
            or fresh.stdout != stdout.raw
            or fresh.stderr != b""
        ):
            fail(
                label
                + "_fresh_process_failed:rc="
                + str(fresh.returncode)
                + ":stdout_sha256="
                + hashlib.sha256(fresh.stdout).hexdigest()
                + ":stderr_sha256="
                + hashlib.sha256(fresh.stderr).hexdigest()
            )
        helper_terminal = held_named_state(
            helper,
            helper.state.path,
            1,
            label + "_guard_validator_terminal",
        )
    finally:
        close_held(helper, label + "_guard_validator")
    for index, expected in enumerate(bound_states):
        terminal = stable_read(
            expected.path,
            label + "_terminal_" + str(index),
            executable=expected.path in (validator.path, stage3.path, monitor_python.path),
            single_link=expected.path != monitor_python.path,
        )
        if (
            terminal.raw != expected.raw
            or identity(terminal.info) != identity(expected.info)
        ):
            fail(label + "_terminal_drift:" + str(index))
    return (helper_terminal, *bound_states)


def validate_compiler_build_evidence(
    compiler_candidate: FileState,
    compiler_receipt: FileState,
    workspace_manifest: FileState,
    label: str,
) -> dict[str, object]:
    rows = parse_rows(compiler_receipt, label + "_receipt")
    validate_payload_hash(
        compiler_receipt,
        rows,
        "receipt_payload_sha256",
        label + "_receipt",
    )
    if tuple(rows) != COMPILER_BUILD_RECEIPT_KEYS:
        fail(label + "_receipt_key_order_invalid")
    if (
        rows.get("schema") != "current_source_compiler_build_receipt"
        or rows.get("status") != "candidate_complete_release_pending"
        or rows.get("output_sha256") != compiler_candidate.sha256
        or rows.get("full_backend_codegen") != "1"
        or rows.get("cold_system_link_exec") != "0"
        or rows.get("system_link_exec_scope") != "selfhost_direct"
        or require_sha(
            rows.get("official_source_manifest_sha256", ""),
            label + "_official_source_manifest",
        )
        != workspace_manifest.sha256
        or pathlib.Path(rows.get("official_source_manifest_path", ""))
        != workspace_manifest.path
    ):
        fail(label + "_receipt_binding_invalid")
    internal_subset_manifest_sha = require_sha(
        rows.get("workspace_source_manifest_sha256", ""),
        label + "_internal_subset_manifest",
    )
    if internal_subset_manifest_sha in (
        "0" * 64,
        hashlib.sha256(b"").hexdigest(),
    ):
        fail(label + "_internal_subset_manifest_unobserved")

    compiler_root = canonical_path(
        compiler_candidate.path.parent,
        label + "_root",
        directory=True,
    )
    private_root = compiler_root / "source-snapshot"
    private_manifest_path = compiler_root / "cheng-source-snapshot.manifest.txt"
    report_path = compiler_root / "cheng.compiler-main.materialize.report.txt"
    materialize_path = compiler_root / "cheng"
    materialize_guard_path = (
        compiler_root / "cheng.compiler-main.process-tree-guard.report.txt"
    )
    official_snapshot_root = workspace_manifest.path.parent / "source-snapshot"
    if (
        compiler_candidate.path != compiler_root / "cheng.compiler-main"
        or compiler_receipt.path
        != compiler_root / "cheng.compiler-main.build-receipt.txt"
        or pathlib.Path(rows.get("private_source_snapshot_root", ""))
        != private_root
        or pathlib.Path(rows.get("private_source_snapshot_manifest_path", ""))
        != private_manifest_path
        or pathlib.Path(rows.get("compiler_report_path", "")) != report_path
        or pathlib.Path(rows.get("official_source_snapshot_root", ""))
        != official_snapshot_root
        or rows.get("output_path") != str(compiler_candidate.path)
        or rows.get("output_bytes") != str(compiler_candidate.info.st_size)
        or pathlib.Path(rows.get("materialize_output_path", ""))
        != materialize_path
        or pathlib.Path(rows.get("materialize_guard_report_path", ""))
        != materialize_guard_path
        or rows.get("target") != "arm64-apple-darwin"
        or rows.get("entry_mode") != "unelaborated"
        or pathlib.Path(rows.get("workspace_entry_path", ""))
        != official_snapshot_root / COMPILER_ENTRY_RELATIVE
        or pathlib.Path(rows.get("entry_path", ""))
        != private_root / COMPILER_ENTRY_RELATIVE
    ):
        fail(label + "_path_binding_invalid")
    try:
        materialize_path.lstat()
    except FileNotFoundError:
        pass
    else:
        fail(label + "_materialize_path_survived_move")

    materialize_guard = stable_read(
        materialize_guard_path,
        label + "_materialize_guard",
    )
    if materialize_guard.sha256 != require_sha(
        rows.get("materialize_guard_report_sha256", ""),
        label + "_materialize_guard",
    ):
        fail(label + "_materialize_guard_digest_drift")
    materialize_guard_rows = parse_rows(
        materialize_guard,
        label + "_materialize_guard",
    )
    physical_fields = (
        ("device", compiler_candidate.info.st_dev),
        ("inode", compiler_candidate.info.st_ino),
        ("mode", format(compiler_candidate.info.st_mode, "o")),
        ("nlink", compiler_candidate.info.st_nlink),
        ("uid", compiler_candidate.info.st_uid),
        ("gid", compiler_candidate.info.st_gid),
        ("size", compiler_candidate.info.st_size),
        ("mtime_ns", compiler_candidate.info.st_mtime_ns),
        ("ctime_ns", compiler_candidate.info.st_ctime_ns),
    )
    if (
        rows.get("candidate_move_status") != "rename_same_inode"
        or rows.get("materialize_output_sha256") != compiler_candidate.sha256
        or materialize_guard_rows.get("status") != "completed"
        or materialize_guard_rows.get("rc") != "0"
        or materialize_guard_rows.get("tracked_output_0_label") != "candidate"
        or materialize_guard_rows.get("tracked_output_0_path")
        != str(materialize_path)
        or materialize_guard_rows.get("tracked_output_0_status") != "verified"
        or materialize_guard_rows.get("tracked_output_0_sha256")
        != compiler_candidate.sha256
    ):
        fail(label + "_candidate_move_header_invalid")
    for field, actual in physical_fields:
        expected = str(actual)
        if (
            rows.get("materialize_output_" + field) != expected
            or rows.get("candidate_move_" + field) != expected
            or materialize_guard_rows.get("tracked_output_0_" + field)
            != expected
        ):
            fail(label + "_candidate_move_identity_drift:" + field)
    move_values = (
        "cheng.compiler.candidate_move_receipt.v2",
        require_sha(
            rows.get("materialize_guard_report_sha256", ""),
            label + "_candidate_move_guard",
        ),
        str(materialize_path),
        str(compiler_candidate.path),
        compiler_candidate.sha256,
        *(rows["materialize_output_" + field] for field, _ in physical_fields),
        "rename_same_inode",
        *(rows["candidate_move_" + field] for field, _ in physical_fields),
    )
    move_receipt_cid = hashlib.sha256(
        b"".join(framed_text(value, label) for value in move_values)
    ).hexdigest()
    if move_receipt_cid != require_sha(
        rows.get("candidate_move_receipt_cid", ""),
        label + "_candidate_move_receipt",
    ):
        fail(label + "_candidate_move_receipt_cid_mismatch")

    official_snapshot_root = canonical_path(
        official_snapshot_root,
        label + "_official_snapshot_root",
        directory=True,
    )
    try:
        parsed_official_manifest = source_snapshot.parse_manifest(
            str(workspace_manifest.path)
        )
        if parsed_official_manifest.raw != workspace_manifest.raw:
            fail(label + "_official_manifest_parse_drift")
        source_snapshot.validate_snapshot(
            str(official_snapshot_root),
            parsed_official_manifest,
        )
    except (OSError, RuntimeError, ValueError) as error:
        fail(label + "_official_snapshot_validation_failed:" + str(error))
    workspace_manifest_after = stable_read(
        workspace_manifest.path,
        label + "_official_manifest_terminal",
    )
    if (
        workspace_manifest_after.raw != workspace_manifest.raw
        or identity(workspace_manifest_after.info)
        != identity(workspace_manifest.info)
    ):
        fail(label + "_official_manifest_terminal_drift")
    workspace_entry = stable_read(
        official_snapshot_root / COMPILER_ENTRY_RELATIVE,
        label + "_workspace_entry",
    )

    private_root = canonical_path(
        private_root,
        label + "_private_root",
        directory=True,
    )
    private_manifest = stable_read(
        private_manifest_path,
        label + "_private_manifest",
    )
    if private_manifest.sha256 != require_sha(
        rows.get("private_source_snapshot_manifest_sha256", ""),
        label + "_private_manifest",
    ):
        fail(label + "_private_manifest_drift")
    report = stable_read(report_path, label + "_report")
    if report.sha256 != require_sha(
        rows.get("compiler_report_sha256", ""),
        label + "_report",
    ):
        fail(label + "_report_drift")
    report_rows = parse_report_rows(report, label + "_report")

    expected_report_values = {
        "entry_mode": "unelaborated",
        "target": "arm64-apple-darwin",
        "output": str(compiler_root / "cheng"),
        "system_link_exec_runtime_execute": "1",
        "system_link_exec": "1",
        "real_backend_codegen": "1",
        "full_backend_codegen": "1",
        "cold_system_link_exec": "0",
        "system_link_exec_scope": "selfhost_direct",
        "compile_receipt_target": "arm64-apple-darwin",
        "compile_receipt_bootstrap_stage": "stage3_local",
    }
    for key, expected in expected_report_values.items():
        if report_rows.get(key) != expected:
            fail(label + "_report_field_invalid:" + key)

    entry_path = canonical_path(
        pathlib.Path(rows.get("entry_path", "")),
        label + "_entry",
    )
    try:
        entry_path.relative_to(private_root)
    except ValueError:
        fail(label + "_entry_outside_private_root")
    entry_source = stable_read(entry_path, label + "_entry")
    if (
        report_rows.get("entry") != str(entry_path)
        or report_rows.get("entry_source_cid") != entry_source.sha256
        or rows.get("entry_source_sha256") != entry_source.sha256
        or workspace_entry.raw != entry_source.raw
    ):
        fail(label + "_entry_binding_invalid")

    source_bundle = require_sha(
        report_required(report_rows, "source_bundle_cid", label),
        label + "_source_bundle",
    )
    source_count = report_uint(report_rows, "source_snapshot_count", label)
    if (
        source_count == 0
        or report_rows.get("source_manifest_sha256") != source_bundle
        or rows.get("source_bundle_cid") != source_bundle
        or rows.get("compiler_source_manifest_sha256") != source_bundle
        or rows.get("source_snapshot_count")
        != report_rows.get("source_snapshot_count")
    ):
        fail(label + "_source_binding_invalid")

    provider_count = report_uint(
        report_rows,
        "compile_receipt_runtime_provider_count",
        label,
    )
    providers = tuple(
        report_required(
            report_rows,
            "compile_receipt_runtime_provider." + str(index),
            label,
        )
        for index in range(provider_count)
    )
    if any(
        provider.strip() != provider
        or any(ord(character) < 32 or ord(character) == 127 for character in provider)
        for provider in providers
    ) or any(
        providers[index - 1] >= providers[index]
        for index in range(1, len(providers))
    ):
        fail(label + "_provider_set_invalid")

    def compile_framed_fixed(key: str) -> bytes:
        return (32).to_bytes(4, "big") + report_fixed(report_rows, key, label)

    compile_payload = b"".join(
        (
            framed_text("cheng.compiler.compile_receipt", label),
            compile_framed_fixed("compile_receipt_world_head_cid"),
            compile_framed_fixed(
                "compile_receipt_source_identity_receipt_cid"
            ),
            compile_framed_fixed("compile_receipt_semantic_receipt_cid"),
            compile_framed_fixed("compile_receipt_output_digest"),
            compile_framed_fixed("compile_receipt_canonical_output_digest"),
            framed_text(
                report_required(report_rows, "compile_receipt_target", label),
                label,
            ),
            framed_text(
                report_required(
                    report_rows,
                    "compile_receipt_bootstrap_stage",
                    label,
                ),
                label,
            ),
            (4).to_bytes(4, "big") + provider_count.to_bytes(4, "big"),
            *(framed_text(provider, label) for provider in providers),
        )
    )
    compile_receipt_cid = hashlib.sha256(compile_payload).hexdigest()
    if (
        compile_receipt_cid != report_rows.get("compile_receipt_cid")
        or compile_receipt_cid != rows.get("compile_receipt_cid")
        or report_rows.get("compile_receipt_world_head_cid")
        != report_rows.get("world_head_cid")
        or report_rows.get("compile_receipt_source_identity_receipt_cid")
        != report_rows.get("source_identity_receipt_cid")
        or report_rows.get("compile_receipt_semantic_receipt_cid")
        != report_rows.get("semantic_receipt_cid")
        or report_rows.get("compile_receipt_output_digest")
        != compiler_candidate.sha256
        or report_rows.get("output_sha256") != compiler_candidate.sha256
        or report_rows.get("compile_receipt_canonical_output_digest")
        != report_rows.get("semantic_canonical_output_digest")
    ):
        fail(label + "_compile_receipt_binding_invalid")

    backend2_manifest = stable_read(
        private_root / "tools/backend2_version_manifest.rec",
        label + "_backend2_manifest",
    )
    if (
        report_rows.get("backend2_version_manifest_sha256")
        != backend2_manifest.sha256
        or rows.get("backend2_version_manifest_sha256")
        != backend2_manifest.sha256
    ):
        fail(label + "_backend2_manifest_binding_invalid")
    output_receipt_payload = b"".join(
        (
            framed_text("cheng.compiler.output_receipt", label),
            (32).to_bytes(4, "big") + bytes.fromhex(compile_receipt_cid),
            (32).to_bytes(4, "big")
            + bytes.fromhex(compiler_candidate.sha256),
            (32).to_bytes(4, "big") + bytes.fromhex(backend2_manifest.sha256),
            framed_text("arm64-apple-darwin", label),
            framed_text("unelaborated", label),
            framed_text("full_backend_codegen=1", label),
            framed_text("cold_system_link_exec=0", label),
            framed_text("system_link_exec_scope=selfhost_direct", label),
        )
    )
    compiler_output_receipt_cid = hashlib.sha256(
        output_receipt_payload
    ).hexdigest()
    if (
        compiler_output_receipt_cid
        != report_rows.get("compiler_output_receipt_cid")
        or compiler_output_receipt_cid
        != rows.get("compiler_output_receipt_cid")
    ):
        fail(label + "_output_receipt_binding_invalid")

    receipt_projection = validate_encoder_build_projection_rows(
        rows,
        label + "_encoder_projection",
    )
    report_projection = validate_encoder_build_projection_rows(
        report_rows,
        label + "_report_encoder_projection",
    )
    if receipt_projection != report_projection:
        fail(label + "_encoder_projection_drift")
    receipt_cargo_object = validate_encoder_cargo_object_rows(
        rows,
        label + "_encoder_cargo_object",
    )
    report_cargo_object = validate_encoder_cargo_object_rows(
        report_rows,
        label + "_report_encoder_cargo_object",
    )
    if (
        receipt_cargo_object["receipt_cid"]
        != report_cargo_object["receipt_cid"]
        or receipt_cargo_object["absolute_path"]
        != report_cargo_object["absolute_path"]
        or receipt_cargo_object["cargo_state"].raw
        != report_cargo_object["cargo_state"].raw
    ):
        fail(label + "_encoder_cargo_object_drift")
    encoder_validator_states = validate_encoder_projection_validator_evidence(
        compiler_root,
        private_root,
        report,
        rows,
        receipt_projection,
        label + "_encoder_validator",
    )

    exact_guard_states = validate_exact_materialize_guard(
        compiler_root,
        private_root,
        compiler_candidate,
        report,
        materialize_guard,
        rows,
        label + "_materialize_guard_exact",
    )
    private_snapshot_evidence = validate_private_source_snapshot(
        private_root,
        private_manifest,
        official_snapshot_root,
        rows,
        label + "_private_snapshot",
    )
    for terminal_label, expected, executable in (
        ("candidate", compiler_candidate, True),
        ("receipt", compiler_receipt, False),
        ("official_manifest", workspace_manifest, False),
        ("private_manifest", private_manifest, False),
        ("report", report, False),
        ("workspace_entry", workspace_entry, False),
        ("private_entry", entry_source, False),
        ("backend2_manifest", backend2_manifest, False),
        ("materialize_guard", materialize_guard, False),
    ):
        terminal = stable_read(
            expected.path,
            label + "_" + terminal_label + "_terminal",
            executable=executable,
        )
        if (
            terminal.raw != expected.raw
            or identity(terminal.info) != identity(expected.info)
        ):
            fail(label + "_" + terminal_label + "_terminal_drift")
    for exact_index, expected in enumerate(exact_guard_states):
        terminal = stable_read(
            expected.path,
            label + "_exact_guard_terminal_" + str(exact_index),
            executable=expected.path in (
                pathlib.Path(rows.get("driver_path", "")),
                pathlib.Path(rows.get("monitor_python_path", "")),
            ),
        )
        if (
            terminal.raw != expected.raw
            or identity(terminal.info) != identity(expected.info)
        ):
            fail(label + "_exact_guard_terminal_drift:" + str(exact_index))
    for validator_index, expected in enumerate(encoder_validator_states):
        terminal = stable_read(
            expected.path,
            label + "_encoder_validator_terminal_" + str(validator_index),
            executable=bool(expected.info.st_mode & 0o111),
            single_link=expected.info.st_nlink == 1,
        )
        if (
            terminal.raw != expected.raw
            or identity(terminal.info) != identity(expected.info)
        ):
            fail(
                label
                + "_encoder_validator_terminal_drift:"
                + str(validator_index)
            )
    return {
        "rows": rows,
        "report": report,
        "report_rows": report_rows,
        "private_manifest": private_manifest,
        "private_snapshot": private_snapshot_evidence,
        "backend2_manifest": backend2_manifest,
        "encoder_projection": receipt_projection,
        "encoder_cargo_object": receipt_cargo_object,
    }


def exclusive_write(path: pathlib.Path, raw: bytes, mode: int = 0o400) -> FileState:
    canonical_path(path, "exclusive_output", allow_absent=True)
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open(path, flags, mode)
    opened = os.fstat(descriptor)
    complete = False
    cleanup_error = ""
    try:
        os.fchown(descriptor, os.geteuid(), os.getegid())
        os.fchmod(descriptor, mode)
        view = memoryview(raw)
        while view:
            count = os.write(descriptor, view)
            if count <= 0:
                fail("exclusive_output_write_failed")
            view = view[count:]
        os.fsync(descriptor)
        complete = True
    finally:
        if not complete:
            try:
                current = path.lstat()
            except FileNotFoundError:
                pass
            else:
                if (
                    not stat.S_ISREG(current.st_mode)
                    or current.st_nlink != 1
                    or (current.st_dev, current.st_ino)
                    != (opened.st_dev, opened.st_ino)
                ):
                    cleanup_error = "exclusive_output_failure_identity_drift"
                else:
                    path.unlink()
                    fsync_parent(path)
        os.close(descriptor)
    if cleanup_error:
        fail(cleanup_error)
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return stable_read(path, "exclusive_output")


def fsync_parent(path: pathlib.Path) -> None:
    descriptor = os.open(
        path.parent,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def replace_durable(source: pathlib.Path, target: pathlib.Path) -> None:
    source_parent = source.parent
    target_parent = target.parent
    os.replace(source, target)
    fsync_parent(target)
    if source_parent != target_parent:
        fsync_parent(source)


def pending_publish_path(
    path: pathlib.Path,
    raw: bytes,
    parent: pathlib.Path | None = None,
) -> pathlib.Path:
    return (parent if parent is not None else path.parent) / (
        "." + path.name + ".pending-" + hashlib.sha256(raw).hexdigest()
    )


def publish_exclusive_bytes(
    path: pathlib.Path,
    raw: bytes,
    mode: int,
    label: str,
    *,
    pending_parent: pathlib.Path | None = None,
) -> FileState:
    canonical_path(path, label, allow_absent=True)
    pending = pending_publish_path(path, raw, pending_parent)
    pending_state = exclusive_write(pending, raw, mode)
    linked = False
    try:
        os.link(pending, path, follow_symlinks=False)
        linked = True
        fsync_parent(path)
        pending_link = stable_read(
            pending,
            label + "_pending_link",
            executable=bool(mode & 0o111),
            single_link=False,
        )
        current_link = stable_read(
            path,
            label + "_published_link",
            executable=bool(mode & 0o111),
            single_link=False,
        )
        if (
            pending_link.raw != raw
            or current_link.raw != raw
            or pending_link.info.st_nlink != 2
            or current_link.info.st_nlink != 2
            or (pending_link.info.st_dev, pending_link.info.st_ino)
            != (current_link.info.st_dev, current_link.info.st_ino)
        ):
            fail(label + "_linked_publish_identity_invalid")
        pending.unlink()
        fsync_parent(pending)
    except Exception:
        if not linked:
            try:
                current_pending = stable_read(
                    pending,
                    label + "_pending_failure",
                    executable=bool(mode & 0o111),
                )
            except FileNotFoundError:
                pass
            else:
                if (
                    current_pending.raw != pending_state.raw
                    or identity(current_pending.info)
                    != identity(pending_state.info)
                ):
                    fail(label + "_pending_failure_identity_drift")
                current_pending.path.unlink()
                fsync_parent(current_pending.path)
        raise
    current = stable_read(
        path,
        label,
        executable=bool(mode & 0o111),
    )
    if (
        current.raw != raw
        or (current.info.st_dev, current.info.st_ino)
        != (pending_state.info.st_dev, pending_state.info.st_ino)
    ):
        fail(label + "_publish_identity_invalid")
    return current


def stable_published_state(
    path: pathlib.Path,
    label: str,
    *,
    executable: bool = False,
) -> FileState:
    return stable_read(path, label, executable=executable)


def rendered(lines: list[str], hash_key: str) -> bytes:
    payload = ("\n".join(lines) + "\n").encode("utf-8")
    lines.append(hash_key + "=" + hashlib.sha256(payload).hexdigest())
    return ("\n".join(lines) + "\n").encode("utf-8")


def archive_tree_uint(value: int, width: int, label: str) -> bytes:
    if value < 0 or value >= 1 << (width * 8):
        fail(label + "_integer_out_of_range")
    return value.to_bytes(width, "big")


def archive_tree_xattr_call_error(label: str) -> None:
    error_number = ctypes.get_errno()
    fail(label + "_xattr_error:" + str(error_number))


def archive_tree_xattr_names(descriptor: int, label: str) -> tuple[bytes, ...]:
    if hasattr(os, "listxattr"):
        try:
            names = tuple(
                sorted(
                    (os.fsencode(name) for name in os.listxattr(descriptor)),
                )
            )
        except OSError as error:
            raise BuildEvidenceError(label + "_xattr_list_failed") from error
        if len(names) != len(set(names)) or any(b"\0" in name for name in names):
            fail(label + "_xattr_name_invalid")
        return names
    if sys.platform != "darwin":
        fail(label + "_xattr_api_unavailable")
    library = ctypes.CDLL(None, use_errno=True)
    function = library.flistxattr
    function.restype = ctypes.c_ssize_t
    required = function(descriptor, None, 0, 0)
    if required < 0:
        archive_tree_xattr_call_error(label + "_list_size")
    if required == 0:
        return ()
    buffer = ctypes.create_string_buffer(required)
    observed = function(descriptor, buffer, required, 0)
    if observed < 0:
        archive_tree_xattr_call_error(label + "_list")
    if observed != required:
        fail(label + "_xattr_list_race")
    raw_names = bytes(buffer.raw[:observed])
    if not raw_names.endswith(b"\0"):
        fail(label + "_xattr_list_encoding_invalid")
    names = tuple(sorted(raw_names[:-1].split(b"\0")))
    if len(names) != len(set(names)) or any(not name for name in names):
        fail(label + "_xattr_name_invalid")
    return names


def archive_tree_get_xattr(
    descriptor: int,
    name: bytes,
    label: str,
) -> bytes:
    if hasattr(os, "getxattr"):
        try:
            return os.getxattr(descriptor, name)
        except OSError as error:
            raise BuildEvidenceError(label + "_xattr_get_failed") from error
    if sys.platform != "darwin":
        fail(label + "_xattr_api_unavailable")
    library = ctypes.CDLL(None, use_errno=True)
    function = library.fgetxattr
    function.restype = ctypes.c_ssize_t
    required = function(descriptor, name, None, 0, 0, 0)
    if required < 0:
        archive_tree_xattr_call_error(label + "_get_size")
    if required == 0:
        return b""
    buffer = ctypes.create_string_buffer(required)
    observed = function(descriptor, name, buffer, required, 0, 0)
    if observed < 0:
        archive_tree_xattr_call_error(label + "_get")
    if observed != required:
        fail(label + "_xattr_value_race")
    return bytes(buffer.raw[:observed])


def archive_tree_set_xattr(
    descriptor: int,
    name: bytes,
    value: bytes,
    label: str,
) -> None:
    if hasattr(os, "setxattr"):
        try:
            os.setxattr(descriptor, name, value)
        except OSError as error:
            raise BuildEvidenceError(label + "_xattr_set_failed") from error
        return
    if sys.platform != "darwin":
        fail(label + "_xattr_api_unavailable")
    library = ctypes.CDLL(None, use_errno=True)
    function = library.fsetxattr
    function.restype = ctypes.c_int
    value_buffer = ctypes.create_string_buffer(value) if value else None
    result = function(
        descriptor,
        name,
        value_buffer,
        len(value),
        0,
        0,
    )
    if result != 0:
        archive_tree_xattr_call_error(label + "_set")


def archive_tree_remove_xattr(
    descriptor: int,
    name: bytes,
    label: str,
) -> None:
    if hasattr(os, "removexattr"):
        try:
            os.removexattr(descriptor, name)
        except OSError as error:
            raise BuildEvidenceError(label + "_xattr_remove_failed") from error
        return
    if sys.platform != "darwin":
        fail(label + "_xattr_api_unavailable")
    library = ctypes.CDLL(None, use_errno=True)
    function = library.fremovexattr
    function.restype = ctypes.c_int
    if function(descriptor, name, 0) != 0:
        archive_tree_xattr_call_error(label + "_remove")


def archive_tree_read_xattrs(
    descriptor: int,
    label: str,
) -> tuple[tuple[bytes, bytes], ...]:
    def read_once() -> tuple[tuple[bytes, bytes], ...]:
        names = archive_tree_xattr_names(descriptor, label)
        return tuple(
            (
                name,
                archive_tree_get_xattr(descriptor, name, label),
            )
            for name in names
        )

    before = read_once()
    after = read_once()
    if before != after:
        fail(label + "_xattr_read_race")
    return before


def archive_tree_replace_xattrs(
    descriptor: int,
    expected: tuple[tuple[bytes, bytes], ...],
    label: str,
) -> None:
    expected_names = {name for name, _value in expected}
    for name in archive_tree_xattr_names(descriptor, label):
        if name not in expected_names:
            archive_tree_remove_xattr(descriptor, name, label)
    for name, value in expected:
        archive_tree_set_xattr(descriptor, name, value, label)
    if archive_tree_read_xattrs(descriptor, label) != expected:
        fail(label + "_xattr_copy_mismatch")


def archive_tree_open_directory(
    name: str | pathlib.Path,
    *,
    directory_descriptor: int | None = None,
) -> int:
    flags = (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    return os.open(name, flags, dir_fd=directory_descriptor)


def archive_tree_open_regular(
    name: str,
    *,
    directory_descriptor: int,
) -> int:
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    return os.open(name, flags, dir_fd=directory_descriptor)


def archive_tree_directory_names(descriptor: int) -> tuple[str, ...]:
    with os.scandir(descriptor) as entries:
        names = tuple(entry.name for entry in entries)
    if len(names) != len(set(names)):
        fail("archive_tree_duplicate_name")
    return tuple(sorted(names, key=os.fsencode))


def archive_tree_record_bytes(record: ArchiveTreeRecord) -> bytes:
    if record.kind not in (b"D", b"F"):
        fail("archive_tree_record_kind_invalid")
    result = bytearray(record.kind)
    result.extend(archive_tree_uint(len(record.relative), 8, "archive_tree_path"))
    result.extend(record.relative)
    result.extend(archive_tree_uint(record.mode, 4, "archive_tree_mode"))
    result.extend(archive_tree_uint(record.size, 8, "archive_tree_size"))
    if len(record.content_sha256) != 32:
        fail("archive_tree_content_digest_invalid")
    result.extend(record.content_sha256)
    result.extend(
        archive_tree_uint(
            len(record.xattrs),
            8,
            "archive_tree_xattr_count",
        )
    )
    for name, value in record.xattrs:
        result.extend(
            archive_tree_uint(
                len(name),
                8,
                "archive_tree_xattr_name",
            )
        )
        result.extend(name)
        result.extend(
            archive_tree_uint(
                len(value),
                8,
                "archive_tree_xattr_value",
            )
        )
        result.extend(value)
    return bytes(result)


def archive_tree_stability_bytes(record: ArchiveTreeRecord) -> bytes:
    result = bytearray()
    result.extend(
        archive_tree_uint(
            len(record.relative),
            8,
            "archive_tree_stability_path",
        )
    )
    result.extend(record.relative)
    for value in record.identity:
        result.extend(
            int(value).to_bytes(
                16,
                "big",
                signed=True,
            )
        )
    return bytes(result)


def archive_tree_scan(path: pathlib.Path, label: str) -> ArchiveTreeState:
    path = canonical_path(path, label, directory=True)
    root_before = path.lstat()
    root_descriptor = archive_tree_open_directory(path)
    records: list[ArchiveTreeRecord] = []

    def scan_directory(
        descriptor: int,
        relative: bytes,
        expected_info: os.stat_result,
    ) -> None:
        opened_before = os.fstat(descriptor)
        if (
            not stat.S_ISDIR(opened_before.st_mode)
            or identity(opened_before) != identity(expected_info)
        ):
            fail(label + "_directory_open_race")
        xattrs_before = archive_tree_read_xattrs(
            descriptor,
            label + "_directory",
        )
        names_before = archive_tree_directory_names(descriptor)
        for name in names_before:
            name_raw = os.fsencode(name)
            child_relative = (
                name_raw
                if not relative
                else relative + b"/" + name_raw
            )
            child_before = os.stat(
                name,
                dir_fd=descriptor,
                follow_symlinks=False,
            )
            if stat.S_ISLNK(child_before.st_mode):
                fail(label + "_symlink")
            if stat.S_ISDIR(child_before.st_mode):
                child_descriptor = archive_tree_open_directory(
                    name,
                    directory_descriptor=descriptor,
                )
                try:
                    scan_directory(
                        child_descriptor,
                        child_relative,
                        child_before,
                    )
                finally:
                    os.close(child_descriptor)
            elif stat.S_ISREG(child_before.st_mode):
                if child_before.st_nlink != 1:
                    fail(label + "_hardlink")
                child_descriptor = archive_tree_open_regular(
                    name,
                    directory_descriptor=descriptor,
                )
                try:
                    opened = os.fstat(child_descriptor)
                    if identity(opened) != identity(child_before):
                        fail(label + "_regular_open_race")
                    xattrs = archive_tree_read_xattrs(
                        child_descriptor,
                        label + "_regular",
                    )
                    digest = hashlib.sha256()
                    observed_bytes = 0
                    while True:
                        chunk = os.read(child_descriptor, READ_BYTES)
                        if not chunk:
                            break
                        digest.update(chunk)
                        observed_bytes += len(chunk)
                    if observed_bytes != child_before.st_size:
                        fail(label + "_regular_short_read")
                    if (
                        archive_tree_read_xattrs(
                            child_descriptor,
                            label + "_regular",
                        )
                        != xattrs
                    ):
                        fail(label + "_regular_xattr_race")
                    opened_after = os.fstat(child_descriptor)
                finally:
                    os.close(child_descriptor)
                child_after = os.stat(
                    name,
                    dir_fd=descriptor,
                    follow_symlinks=False,
                )
                if (
                    identity(child_before) != identity(opened_after)
                    or identity(child_before) != identity(child_after)
                ):
                    fail(label + "_regular_read_race")
                records.append(
                    ArchiveTreeRecord(
                        child_relative,
                        b"F",
                        stat.S_IMODE(child_before.st_mode),
                        child_before.st_size,
                        digest.digest(),
                        xattrs,
                        identity(child_before),
                    )
                )
            else:
                fail(label + "_nonregular")
        names_after = archive_tree_directory_names(descriptor)
        xattrs_after = archive_tree_read_xattrs(
            descriptor,
            label + "_directory",
        )
        opened_after = os.fstat(descriptor)
        if (
            names_before != names_after
            or xattrs_before != xattrs_after
            or identity(opened_before) != identity(opened_after)
        ):
            fail(label + "_directory_read_race")
        records.append(
            ArchiveTreeRecord(
                relative,
                b"D",
                stat.S_IMODE(opened_before.st_mode),
                0,
                bytes(32),
                xattrs_before,
                identity(opened_before),
            )
        )

    try:
        if identity(os.fstat(root_descriptor)) != identity(root_before):
            fail(label + "_root_open_race")
        scan_directory(root_descriptor, b"", root_before)
    finally:
        os.close(root_descriptor)
    root_after = path.lstat()
    if identity(root_before) != identity(root_after):
        fail(label + "_root_read_race")
    records.sort(key=lambda record: record.relative)
    tree_digest = hashlib.sha256(
        b"cheng.backend2.verified_archive_tree.digest\0"
    )
    stability_digest = hashlib.sha256(
        b"cheng.backend2.verified_archive_tree.stability\0"
    )
    for record in records:
        tree_digest.update(archive_tree_record_bytes(record))
        stability_digest.update(archive_tree_stability_bytes(record))
    directory_count = sum(
        1
        for record in records
        if record.kind == b"D" and record.relative
    )
    regular_records = tuple(
        record for record in records if record.kind == b"F"
    )
    return ArchiveTreeState(
        root_before,
        tree_digest.hexdigest(),
        stability_digest.hexdigest(),
        directory_count + len(regular_records),
        directory_count,
        len(regular_records),
        sum(record.size for record in regular_records),
        sum(record.size == 0 for record in regular_records),
        sum(len(record.xattrs) for record in records),
    )


def archive_tree_copy(
    source: pathlib.Path,
    archive: pathlib.Path,
) -> os.stat_result:
    source_descriptor = archive_tree_open_directory(source)
    archive_descriptor = archive_tree_open_directory(archive)

    def copy_regular(
        source_directory: int,
        archive_directory: int,
        name: str,
        source_before: os.stat_result,
    ) -> None:
        if source_before.st_nlink != 1:
            fail("archive_source_hardlink")
        source_file = archive_tree_open_regular(
            name,
            directory_descriptor=source_directory,
        )
        archive_flags = (
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0)
        )
        archive_file = -1
        try:
            source_opened = os.fstat(source_file)
            if identity(source_opened) != identity(source_before):
                fail("archive_source_regular_open_race")
            source_xattrs = archive_tree_read_xattrs(
                source_file,
                "archive_source_regular",
            )
            archive_file = os.open(
                name,
                archive_flags,
                0o600,
                dir_fd=archive_directory,
            )
            observed_bytes = 0
            while True:
                chunk = os.read(source_file, READ_BYTES)
                if not chunk:
                    break
                observed_bytes += len(chunk)
                view = memoryview(chunk)
                while view:
                    written = os.write(archive_file, view)
                    if written <= 0:
                        fail("archive_target_write_failed")
                    view = view[written:]
            if observed_bytes != source_before.st_size:
                fail("archive_source_regular_short_read")
            os.fsync(archive_file)
            archive_tree_replace_xattrs(
                archive_file,
                source_xattrs,
                "archive_target_regular",
            )
            os.fchmod(
                archive_file,
                stat.S_IMODE(source_before.st_mode),
            )
            os.fsync(archive_file)
            if (
                archive_tree_read_xattrs(
                    source_file,
                    "archive_source_regular",
                )
                != source_xattrs
                or identity(os.fstat(source_file))
                != identity(source_before)
            ):
                fail("archive_source_regular_read_race")
            archive_info = os.fstat(archive_file)
            if (
                not stat.S_ISREG(archive_info.st_mode)
                or archive_info.st_nlink != 1
                or archive_info.st_size != source_before.st_size
                or stat.S_IMODE(archive_info.st_mode)
                != stat.S_IMODE(source_before.st_mode)
            ):
                fail("archive_target_regular_identity_invalid")
        finally:
            if archive_file >= 0:
                os.close(archive_file)
            os.close(source_file)
        source_after = os.stat(
            name,
            dir_fd=source_directory,
            follow_symlinks=False,
        )
        if identity(source_after) != identity(source_before):
            fail("archive_source_regular_path_race")

    def copy_directory(
        source_directory: int,
        archive_directory: int,
        source_before: os.stat_result,
    ) -> None:
        source_opened = os.fstat(source_directory)
        if (
            not stat.S_ISDIR(source_opened.st_mode)
            or identity(source_opened) != identity(source_before)
        ):
            fail("archive_source_directory_open_race")
        source_xattrs = archive_tree_read_xattrs(
            source_directory,
            "archive_source_directory",
        )
        names_before = archive_tree_directory_names(source_directory)
        for name in names_before:
            child_before = os.stat(
                name,
                dir_fd=source_directory,
                follow_symlinks=False,
            )
            if stat.S_ISLNK(child_before.st_mode):
                fail("archive_source_symlink")
            if stat.S_ISDIR(child_before.st_mode):
                os.mkdir(name, 0o700, dir_fd=archive_directory)
                source_child = archive_tree_open_directory(
                    name,
                    directory_descriptor=source_directory,
                )
                archive_child = archive_tree_open_directory(
                    name,
                    directory_descriptor=archive_directory,
                )
                try:
                    copy_directory(
                        source_child,
                        archive_child,
                        child_before,
                    )
                finally:
                    os.close(archive_child)
                    os.close(source_child)
                child_after = os.stat(
                    name,
                    dir_fd=source_directory,
                    follow_symlinks=False,
                )
                if identity(child_before) != identity(child_after):
                    fail("archive_source_directory_path_race")
            elif stat.S_ISREG(child_before.st_mode):
                copy_regular(
                    source_directory,
                    archive_directory,
                    name,
                    child_before,
                )
            else:
                fail("archive_source_nonregular")
        if names_before != archive_tree_directory_names(source_directory):
            fail("archive_source_directory_name_race")
        if (
            archive_tree_read_xattrs(
                source_directory,
                "archive_source_directory",
            )
            != source_xattrs
            or identity(os.fstat(source_directory))
            != identity(source_before)
        ):
            fail("archive_source_directory_read_race")
        archive_tree_replace_xattrs(
            archive_directory,
            source_xattrs,
            "archive_target_directory",
        )
        os.fchmod(
            archive_directory,
            stat.S_IMODE(source_before.st_mode),
        )
        os.fsync(archive_directory)

    try:
        source_root = source.lstat()
        archive_root = archive.lstat()
        if identity(os.fstat(source_descriptor)) != identity(source_root):
            fail("archive_source_root_open_race")
        if identity(os.fstat(archive_descriptor)) != identity(archive_root):
            fail("archive_target_root_open_race")
        copy_directory(
            source_descriptor,
            archive_descriptor,
            source_root,
        )
        archive_after = os.fstat(archive_descriptor)
    finally:
        os.close(archive_descriptor)
        os.close(source_descriptor)
    if identity(source.lstat()) != identity(source_root):
        fail("archive_source_root_path_race")
    if identity(archive.lstat()) != identity(archive_after):
        fail("archive_target_root_path_race")
    return archive_after


def verified_archive_tree(args: argparse.Namespace) -> None:
    source = canonical_path(
        pathlib.Path(args.source),
        "archive_source",
        directory=True,
    )
    source_info = source.lstat()
    if (
        str(source_info.st_dev) != args.device
        or str(source_info.st_ino) != args.inode
    ):
        fail("archive_source_root_identity_drift")
    archive = canonical_path(
        pathlib.Path(args.archive),
        "archive_target",
        allow_absent=True,
    )
    if source in archive.parents:
        fail("archive_target_inside_source")
    source_before = archive_tree_scan(source, "archive_source")
    if (
        source_before.root_info.st_dev != source_info.st_dev
        or source_before.root_info.st_ino != source_info.st_ino
    ):
        fail("archive_source_root_identity_drift")
    os.mkdir(archive, 0o700)
    archive_created = archive.lstat()
    parent_descriptor = archive_tree_open_directory(archive.parent)
    try:
        os.fsync(parent_descriptor)
    finally:
        os.close(parent_descriptor)
    archive_after_copy = archive_tree_copy(source, archive)
    if identity(archive_created)[:2] != identity(archive_after_copy)[:2]:
        fail("archive_target_root_identity_drift")
    source_after = archive_tree_scan(source, "archive_source")
    if (
        source_before.tree_sha256 != source_after.tree_sha256
        or source_before.stability_sha256
        != source_after.stability_sha256
        or identity(source_before.root_info)
        != identity(source_after.root_info)
    ):
        fail("archive_source_tree_changed")
    archive_state = archive_tree_scan(archive, "archive_target")
    if (
        archive_state.root_info.st_dev != archive_created.st_dev
        or archive_state.root_info.st_ino != archive_created.st_ino
    ):
        fail("archive_target_root_identity_drift")
    if (
        source_after.tree_sha256 != archive_state.tree_sha256
        or source_after.entry_count != archive_state.entry_count
        or source_after.directory_count != archive_state.directory_count
        or source_after.regular_count != archive_state.regular_count
        or source_after.regular_bytes != archive_state.regular_bytes
        or source_after.zero_regular_count
        != archive_state.zero_regular_count
        or source_after.xattr_count != archive_state.xattr_count
    ):
        fail("archive_target_tree_mismatch")
    source_final = archive_tree_scan(source, "archive_source")
    if (
        source_before.tree_sha256 != source_final.tree_sha256
        or source_before.stability_sha256
        != source_final.stability_sha256
        or identity(source_before.root_info)
        != identity(source_final.root_info)
    ):
        fail("archive_source_tree_changed")
    source_after = source_final
    if source_after.root_info.st_ino == archive_state.root_info.st_ino:
        fail("archive_target_root_inode_not_distinct")
    lines = [
        "schema=cheng.backend2.verified_archive_tree",
        "status=PASS",
        "tree_digest_schema=cheng.backend2.verified_archive_tree.digest",
        "source_path_fshex=" + os.fsencode(source).hex(),
        "source_device=" + str(source_after.root_info.st_dev),
        "source_inode=" + str(source_after.root_info.st_ino),
        "source_mode="
        + format(stat.S_IMODE(source_after.root_info.st_mode), "o"),
        "source_stability_sha256=" + source_after.stability_sha256,
        "archive_path_fshex=" + os.fsencode(archive).hex(),
        "archive_device=" + str(archive_state.root_info.st_dev),
        "archive_inode=" + str(archive_state.root_info.st_ino),
        "archive_mode="
        + format(stat.S_IMODE(archive_state.root_info.st_mode), "o"),
        "root_inode_distinct=true",
        "entry_count=" + str(source_after.entry_count),
        "directory_count=" + str(source_after.directory_count),
        "regular_count=" + str(source_after.regular_count),
        "regular_bytes=" + str(source_after.regular_bytes),
        "zero_regular_count=" + str(source_after.zero_regular_count),
        "xattr_count=" + str(source_after.xattr_count),
        "source_tree_sha256=" + source_after.tree_sha256,
        "archive_tree_sha256=" + archive_state.tree_sha256,
    ]
    sys.stdout.buffer.write(rendered(lines, "receipt_payload_sha256"))


def validate_payload_hash(
    state: FileState, rows: dict[str, str], key: str, label: str
) -> None:
    lines = state.raw.decode("utf-8").splitlines()
    if not lines or not lines[-1].startswith(key + "="):
        fail(label + "_payload_hash_position_invalid")
    payload = ("\n".join(lines[:-1]) + "\n").encode("utf-8")
    if rows.get(key) != hashlib.sha256(payload).hexdigest():
        fail(label + "_payload_hash_invalid")


def validate_live_manifest(live_root: pathlib.Path, manifest: FileState) -> None:
    parsed = __import__("current_source_snapshot").parse_manifest(str(manifest.path))
    scopes = [os.fsdecode(scope) for scope in parsed.scopes]
    observed = closure.build_manifest(str(live_root), scopes)
    if observed != manifest.raw:
        fail("live_source_closure_drift")


def validate_raw_manifest(path: pathlib.Path, kind: str) -> FileState:
    completed = subprocess.run(
        [str(OFFICIAL_EVIDENCE), "validate-raw-manifest", str(path), kind],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        fail("raw_manifest_invalid:" + kind)
    return stable_read(path, "raw_manifest_" + kind)


def validate_bootstrap(
    raw_root: pathlib.Path,
    manifest: FileState,
    compiler_candidate: FileState,
    compiler_receipt: FileState,
) -> dict[str, FileState]:
    raw_root = canonical_path(raw_root, "raw_root", directory=True)
    summary = stable_read(raw_root / "summary.kv", "bootstrap_summary")
    postflight = stable_read(raw_root / "postflight.kv", "bootstrap_postflight")
    fixed = stable_read(
        raw_root / "backend-driver.gen2-gen3.fixed-point.kv",
        "bootstrap_fixed_point",
    )
    gen2 = stable_read(
        raw_root / "backend-driver.current",
        "bootstrap_gen2",
        executable=True,
    )
    gen3 = stable_read(
        raw_root / "backend-driver.gen3",
        "bootstrap_gen3",
        executable=True,
    )
    epoch = validate_raw_manifest(
        raw_root / "backend2-epoch.raw-manifest.kv", "backend2_epoch"
    )
    jobs = validate_raw_manifest(
        raw_root / "backend2-jobs.raw-manifest.kv", "backend2_jobs"
    )
    source_before = stable_read(
        raw_root / "source-closure.before", "source_closure_before"
    )
    source_after = stable_read(
        raw_root / "source-closure.postflight", "source_closure_postflight"
    )
    if source_before.raw != manifest.raw or source_after.raw != manifest.raw:
        fail("bootstrap_source_manifest_mismatch")
    if gen2.raw != gen3.raw or gen2.raw != compiler_candidate.raw:
        fail("bootstrap_driver_fixed_point_mismatch")
    if len(
        {
            (gen2.info.st_dev, gen2.info.st_ino),
            (gen3.info.st_dev, gen3.info.st_ino),
            (compiler_candidate.info.st_dev, compiler_candidate.info.st_ino),
        }
    ) != 3:
        fail("bootstrap_driver_inode_independence_invalid")
    summary_rows = parse_rows(summary, "bootstrap_summary")
    postflight_rows = parse_rows(postflight, "bootstrap_postflight")
    fixed_rows = parse_rows(fixed, "bootstrap_fixed_point")
    expected_summary = {
        "schema": "cheng.backend2.current_source_gate",
        "status": "pass",
        "source_postflight_status": "stable",
        "gen2_gen3_raw_bytes_equal": "true",
        "gen2_gen3_distinct_artifact_inodes": "true",
        "backend2_epoch_status": "pass",
        "backend2_jobs1_jobs4_raw_bytes_equal": "true",
        "backend2_jobs1_jobs4_distinct_artifact_inodes": "true",
        "official_artifact_unchanged": "true",
    }
    for key, expected in expected_summary.items():
        if summary_rows.get(key) != expected:
            fail("bootstrap_summary_field_invalid:" + key)
    if (
        postflight_rows.get("schema")
        != "cheng.backend2.current_source_postflight"
        or postflight_rows.get("status") != "stable"
        or postflight_rows.get("main_rc") != "0"
    ):
        fail("bootstrap_postflight_invalid")
    if (
        fixed_rows.get("schema")
        != "cheng.backend2.current_source_raw_fixed_point"
        or fixed_rows.get("status") != "pass"
        or fixed_rows.get("raw_bytes_equal") != "true"
        or fixed_rows.get("distinct_artifact_inodes") != "true"
        or require_sha(fixed_rows.get("gen2_sha256", ""), "fixed_gen2")
        != gen2.sha256
        or require_sha(fixed_rows.get("gen3_sha256", ""), "fixed_gen3")
        != gen3.sha256
    ):
        fail("bootstrap_fixed_point_invalid")
    manifest_sha = manifest.sha256
    if (
        require_sha(
            summary_rows.get("snapshot_manifest_sha256", ""),
            "summary_snapshot_manifest",
        )
        != manifest_sha
        or require_sha(summary_rows.get("candidate_sha256", ""), "summary_candidate")
        != gen2.sha256
        or require_sha(summary_rows.get("gen3_sha256", ""), "summary_gen3")
        != gen3.sha256
        or require_sha(
            summary_rows.get("fixed_point_receipt_sha256", ""),
            "summary_fixed_point",
        )
        != fixed.sha256
        or require_sha(
            summary_rows.get("backend2_epoch_raw_manifest_sha256", ""),
            "summary_epoch",
        )
        != epoch.sha256
        or require_sha(
            summary_rows.get("backend2_jobs_raw_manifest_sha256", ""),
            "summary_jobs",
        )
        != jobs.sha256
    ):
        fail("bootstrap_summary_digest_mismatch")
    compiler_evidence = validate_compiler_build_evidence(
        compiler_candidate,
        compiler_receipt,
        manifest,
        "bootstrap_compiler_build",
    )
    return {
        "summary": summary,
        "postflight": postflight,
        "fixed": fixed,
        "gen2": gen2,
        "gen3": gen3,
        "epoch": epoch,
        "jobs": jobs,
        "private_manifest": compiler_evidence["private_manifest"],
    }


def read_existing_official() -> FileState | None:
    try:
        OFFICIAL.lstat()
    except FileNotFoundError:
        return None
    return stable_read(OFFICIAL, "previous_official", executable=True)


def read_existing(
    path: pathlib.Path,
    label: str,
    *,
    single_link: bool = True,
) -> FileState | None:
    try:
        path.lstat()
    except FileNotFoundError:
        return None
    return stable_read(path, label, single_link=single_link)


def decode_path(rows: dict[str, str], key: str, label: str) -> pathlib.Path:
    try:
        raw = bytes.fromhex(rows.get(key, ""))
    except ValueError as error:
        raise BuildEvidenceError(label + "_path_encoding_invalid") from error
    if not raw:
        fail(label + "_path_encoding_invalid")
    return pathlib.Path(os.fsdecode(raw))


def prepare_install_transaction(
    transaction_path: pathlib.Path,
    rollback_driver_path: pathlib.Path,
    rollback_receipt_path: pathlib.Path,
    candidate: FileState,
    manifest: FileState,
) -> FileState:
    canonical_path(transaction_path, "install_transaction", allow_absent=True)
    canonical_path(rollback_driver_path, "rollback_driver", allow_absent=True)
    canonical_path(rollback_receipt_path, "rollback_receipt", allow_absent=True)
    canonical_path(
        OFFICIAL_TRANSACTION,
        "official_active_transaction",
        allow_absent=True,
    )
    canonical_path(
        OFFICIAL_COMMIT,
        "official_commit_marker",
        allow_absent=True,
    )
    previous_driver = read_existing_official()
    previous_receipt = read_existing(
        OFFICIAL_RECEIPT,
        "previous_official_receipt",
    )
    if (previous_driver is None) != (previous_receipt is None):
        fail("previous_official_pair_incomplete")
    if previous_driver is not None and previous_receipt is not None:
        validated_previous_receipt, previous_rows = validate_final_state(
            previous_receipt.path
        )
        if (
            validated_previous_receipt.raw != previous_receipt.raw
            or identity(validated_previous_receipt.info)
            != identity(previous_receipt.info)
            or previous_rows.get("official_sha256") != previous_driver.sha256
        ):
            fail("previous_official_receipt_binding_invalid")
    return _prepare_install_transaction_with_validated_previous(
        transaction_path,
        rollback_driver_path,
        rollback_receipt_path,
        candidate,
        manifest,
        previous_driver,
        previous_receipt,
    )


def _prepare_install_transaction_with_validated_previous(
    transaction_path: pathlib.Path,
    rollback_driver_path: pathlib.Path,
    rollback_receipt_path: pathlib.Path,
    candidate: FileState,
    manifest: FileState,
    previous_driver: FileState | None,
    previous_receipt: FileState | None,
) -> FileState:
    canonical_path(transaction_path, "install_transaction", allow_absent=True)
    canonical_path(rollback_driver_path, "rollback_driver", allow_absent=True)
    canonical_path(rollback_receipt_path, "rollback_receipt", allow_absent=True)
    canonical_path(
        OFFICIAL_TRANSACTION,
        "official_active_transaction",
        allow_absent=True,
    )
    canonical_path(
        OFFICIAL_COMMIT,
        "official_commit_marker",
        allow_absent=True,
    )
    if (previous_driver is None) != (previous_receipt is None):
        fail("validated_previous_official_pair_incomplete")
    transaction_payload = b"\0".join(
        (
            os.fsencode(transaction_path),
            os.fsencode(rollback_driver_path),
            os.fsencode(rollback_receipt_path),
            bytes.fromhex(candidate.sha256),
            bytes.fromhex(manifest.sha256),
        )
    )
    transaction_id = hashlib.sha256(transaction_payload).hexdigest()
    official_staging_path = transaction_path.parent / (
        "official-staging-" + transaction_id
    )
    canonical_path(
        official_staging_path,
        "official_transaction_staging",
        allow_absent=True,
    )
    official_staging = exclusive_write(
        official_staging_path,
        candidate.raw,
        0o500,
    )
    if official_staging.info.st_dev != OFFICIAL.parent.lstat().st_dev:
        fail("official_transaction_cross_device")

    def value(
        state: FileState | None,
        field: str,
        default: str = "0",
    ) -> str:
        if state is None:
            return default
        if field == "sha256":
            return state.sha256
        if field == "mode":
            return format(state.info.st_mode, "o")
        return str(getattr(state.info, "st_" + field))

    lines = [
        "schema=cheng.backend2.current_source_official_install_transaction",
        "status=PREPARED",
        "transaction_id=" + transaction_id,
        "private_transaction_path_fshex="
        + os.fsencode(transaction_path).hex(),
        "official_staging_path_fshex="
        + os.fsencode(official_staging_path).hex(),
        "official_staging_sha256=" + official_staging.sha256,
        "official_staging_device=" + str(official_staging.info.st_dev),
        "official_staging_inode=" + str(official_staging.info.st_ino),
        "official_staging_mode=" + format(official_staging.info.st_mode, "o"),
        "official_staging_nlink=" + str(official_staging.info.st_nlink),
        "official_staging_uid=" + str(official_staging.info.st_uid),
        "official_staging_gid=" + str(official_staging.info.st_gid),
        "official_staging_size=" + str(official_staging.info.st_size),
        "official_path_fshex=" + os.fsencode(OFFICIAL).hex(),
        "candidate_sha256=" + candidate.sha256,
        "candidate_size=" + str(candidate.info.st_size),
        "source_manifest_sha256=" + manifest.sha256,
        "previous_official_present="
        + ("true" if previous_driver is not None else "false"),
        "previous_official_sha256=" + value(previous_driver, "sha256", ""),
        "previous_official_device=" + value(previous_driver, "dev"),
        "previous_official_inode=" + value(previous_driver, "ino"),
        "previous_receipt_present="
        + ("true" if previous_receipt is not None else "false"),
        "previous_receipt_sha256=" + value(previous_receipt, "sha256", ""),
        "previous_receipt_device=" + value(previous_receipt, "dev"),
        "previous_receipt_inode=" + value(previous_receipt, "ino"),
        "rollback_driver_path_fshex="
        + os.fsencode(rollback_driver_path).hex(),
        "rollback_driver_sha256=" + value(previous_driver, "sha256", ""),
        "rollback_driver_device=" + value(previous_driver, "dev"),
        "rollback_driver_inode=" + value(previous_driver, "ino"),
        "rollback_driver_mode=" + value(previous_driver, "mode"),
        "rollback_driver_nlink=" + value(previous_driver, "nlink"),
        "rollback_driver_uid=" + value(previous_driver, "uid"),
        "rollback_driver_gid=" + value(previous_driver, "gid"),
        "rollback_driver_size=" + value(previous_driver, "size"),
        "official_receipt_path_fshex=" + os.fsencode(OFFICIAL_RECEIPT).hex(),
        "rollback_receipt_path_fshex="
        + os.fsencode(rollback_receipt_path).hex(),
        "rollback_receipt_sha256=" + value(previous_receipt, "sha256", ""),
        "rollback_receipt_device=" + value(previous_receipt, "dev"),
        "rollback_receipt_inode=" + value(previous_receipt, "ino"),
        "rollback_receipt_mode=" + value(previous_receipt, "mode"),
        "rollback_receipt_nlink=" + value(previous_receipt, "nlink"),
        "rollback_receipt_uid=" + value(previous_receipt, "uid"),
        "rollback_receipt_gid=" + value(previous_receipt, "gid"),
        "rollback_receipt_size=" + value(previous_receipt, "size"),
    ]
    transaction = exclusive_write(
        transaction_path,
        rendered(lines, "receipt_payload_sha256"),
    )
    rollback_links: list[tuple[pathlib.Path, FileState]] = []

    def cleanup_unpublished_rollback_links() -> None:
        for rollback_path, previous in reversed(rollback_links):
            rollback = stable_read(
                rollback_path,
                "unpublished_rollback_cleanup",
                single_link=False,
            )
            if (
                rollback.raw != previous.raw
                or (rollback.info.st_dev, rollback.info.st_ino)
                != (previous.info.st_dev, previous.info.st_ino)
            ):
                fail("unpublished_rollback_cleanup_identity_invalid")
            rollback_path.unlink()
            fsync_parent(rollback_path)

    try:
        for previous, rollback_path, label, executable in (
            (
                previous_driver,
                rollback_driver_path,
                "rollback_driver",
                True,
            ),
            (
                previous_receipt,
                rollback_receipt_path,
                "rollback_receipt",
                False,
            ),
        ):
            if previous is None:
                continue
            os.link(
                previous.path,
                rollback_path,
                follow_symlinks=False,
            )
            rollback_links.append((rollback_path, previous))
            fsync_parent(rollback_path)
            current_previous = stable_read(
                previous.path,
                label + "_source_pre_publish",
                executable=executable,
                single_link=False,
            )
            rollback = stable_read(
                rollback_path,
                label + "_pre_publish",
                executable=executable,
                single_link=False,
            )
            if (
                current_previous.raw != previous.raw
                or rollback.raw != previous.raw
                or current_previous.info.st_nlink != 2
                or rollback.info.st_nlink != 2
                or (current_previous.info.st_dev, current_previous.info.st_ino)
                != (previous.info.st_dev, previous.info.st_ino)
                or (rollback.info.st_dev, rollback.info.st_ino)
                != (previous.info.st_dev, previous.info.st_ino)
            ):
                fail(label + "_pre_publish_hardlink_identity_invalid")
        os.link(
            transaction_path,
            OFFICIAL_TRANSACTION,
            follow_symlinks=False,
        )
    except Exception:
        try:
            OFFICIAL_TRANSACTION.lstat()
        except FileNotFoundError:
            cleanup_unpublished_rollback_links()
        raise
    fsync_parent(OFFICIAL_TRANSACTION)
    transaction_link = stable_read(
        transaction_path,
        "private_transaction_link",
        single_link=False,
    )
    active_link = stable_read(
        OFFICIAL_TRANSACTION,
        "official_active_transaction_link",
        single_link=False,
    )
    if (
        transaction_link.raw != transaction.raw
        or active_link.raw != transaction.raw
        or transaction_link.info.st_nlink != 2
        or active_link.info.st_nlink != 2
        or (
            transaction_link.info.st_dev,
            transaction_link.info.st_ino,
        )
        != (
            active_link.info.st_dev,
            active_link.info.st_ino,
        )
    ):
        fail("official_active_transaction_link_identity_invalid")
    transaction_path.unlink()
    fsync_parent(transaction_path)
    active = stable_published_state(
        OFFICIAL_TRANSACTION,
        "official_active_transaction",
    )
    if active.raw != transaction.raw:
        fail("official_active_transaction_bytes_mismatch")
    return active


def validate_install_transaction(
    path: pathlib.Path,
    *,
    published: bool = False,
    allow_missing_backups: bool = False,
    allow_missing_staging: bool = False,
    raw_override: bytes | None = None,
    validate_physical: bool = True,
) -> dict[str, str]:
    if raw_override is not None:
        if published or validate_physical:
            fail("install_transaction_override_mode_invalid")
        try:
            override_info = OFFICIAL_TRANSACTION.lstat()
        except FileNotFoundError:
            override_info = OFFICIAL_COMMIT.lstat()
        state = FileState(
            path,
            raw_override,
            hashlib.sha256(raw_override).hexdigest(),
            override_info,
        )
    else:
        state = (
            stable_published_state(path, "install_transaction")
            if published
            else stable_read(path, "install_transaction")
        )
    rows = parse_rows(state, "install_transaction")
    validate_payload_hash(
        state,
        rows,
        "receipt_payload_sha256",
        "install_transaction",
    )
    if tuple(rows) != INSTALL_TRANSACTION_KEYS:
        fail("install_transaction_key_set_invalid")
    if (
        rows.get("schema")
        != "cheng.backend2.current_source_official_install_transaction"
        or rows.get("status") != "PREPARED"
        or rows.get("previous_official_present") not in ("true", "false")
        or rows.get("previous_receipt_present") not in ("true", "false")
        or decode_path(rows, "official_path_fshex", "transaction_official")
        != OFFICIAL
        or decode_path(
            rows,
            "official_receipt_path_fshex",
            "transaction_official_receipt",
        )
        != OFFICIAL_RECEIPT
    ):
        fail("install_transaction_header_invalid")
    transaction_id = require_sha(
        rows.get("transaction_id", ""),
        "transaction_id",
    )
    private_transaction_path = decode_path(
        rows,
        "private_transaction_path_fshex",
        "private_transaction",
    )
    official_staging_path = decode_path(
        rows,
        "official_staging_path_fshex",
        "official_staging",
    )
    if (
        private_transaction_path.parent == OFFICIAL.parent
        or pathlib.Path(os.path.realpath(private_transaction_path.parent))
        != private_transaction_path.parent
        or official_staging_path
        != private_transaction_path.parent
        / ("official-staging-" + transaction_id)
    ):
        fail("install_transaction_path_authority_invalid")
    if validate_physical:
        canonical_path(
            private_transaction_path,
            "install_transaction_private",
            allow_absent=True,
        )
    candidate_sha256 = require_sha(
        rows.get("candidate_sha256", ""),
        "transaction_candidate",
    )
    if (
        require_sha(
            rows.get("official_staging_sha256", ""),
            "transaction_official_staging",
        )
        != candidate_sha256
    ):
        fail("install_transaction_staging_hash_invalid")
    require_uint(rows.get("candidate_size", ""), "transaction_candidate_size")
    staging_fields = tuple(
        rows["official_staging_" + field]
        for field in (
            "device",
            "inode",
            "mode",
            "nlink",
            "uid",
            "gid",
            "size",
        )
    )
    if not all(value.isdigit() for value in staging_fields):
        fail("install_transaction_staging_identity_invalid")
    if validate_physical:
        try:
            staging = stable_read(
                official_staging_path,
                "transaction_official_staging",
                executable=True,
                single_link=False,
            )
        except FileNotFoundError:
            if not allow_missing_staging:
                raise
        else:
            staging_identity = (
                str(staging.info.st_dev),
                str(staging.info.st_ino),
                format(staging.info.st_mode, "o"),
                "1",
                str(staging.info.st_uid),
                str(staging.info.st_gid),
                str(staging.info.st_size),
            )
            if (
                rows["official_staging_sha256"] != candidate_sha256
                or staging.sha256 != candidate_sha256
                or staging_fields != staging_identity
                or staging.info.st_nlink not in (1, 2)
            ):
                fail("install_transaction_staging_identity_drift")
            if staging.info.st_nlink == 2:
                published = stable_read(
                    OFFICIAL,
                    "transaction_official_staging_published_link",
                    executable=True,
                    single_link=False,
                )
                if (
                    published.raw != staging.raw
                    or published.info.st_nlink != 2
                    or (published.info.st_dev, published.info.st_ino)
                    != (staging.info.st_dev, staging.info.st_ino)
                ):
                    fail("install_transaction_staging_link_invalid")
    require_sha(
        rows.get("source_manifest_sha256", ""),
        "transaction_source_manifest",
    )
    if (
        rows["previous_official_present"]
        != rows["previous_receipt_present"]
    ):
        fail("install_transaction_previous_pair_invalid")
    for previous_prefix, rollback_prefix in (
        ("official", "driver"),
        ("receipt", "receipt"),
    ):
        present = rows["previous_" + previous_prefix + "_present"] == "true"
        digest = rows["previous_" + previous_prefix + "_sha256"]
        rollback_digest = rows["rollback_" + rollback_prefix + "_sha256"]
        if present:
            require_sha(digest, "transaction_previous_" + previous_prefix)
            if rollback_digest != digest:
                fail(
                    "install_transaction_rollback_hash_invalid:"
                    + previous_prefix
                )
        elif digest or rollback_digest:
            fail(
                "install_transaction_absent_hash_invalid:"
                + previous_prefix
            )
        previous_fields = (
            rows["previous_" + previous_prefix + "_device"],
            rows["previous_" + previous_prefix + "_inode"],
        )
        rollback_fields = tuple(
            rows["rollback_" + rollback_prefix + "_" + field]
            for field in (
                "device",
                "inode",
                "mode",
                "nlink",
                "uid",
                "gid",
                "size",
            )
        )
        if not all(value.isdigit() for value in previous_fields + rollback_fields):
            fail("install_transaction_identity_invalid:" + previous_prefix)
        if present:
            rollback_path = decode_path(
                rows,
                "rollback_" + rollback_prefix + "_path_fshex",
                "transaction_rollback_" + rollback_prefix,
            )
            expected_name = (
                "previous-official-driver"
                if rollback_prefix == "driver"
                else "previous-official-build-receipt.kv"
            )
            if (
                rollback_path.parent != private_transaction_path.parent
                or rollback_path.name != expected_name
            ):
                fail(
                    "install_transaction_rollback_path_invalid:"
                    + previous_prefix
                )
            if not validate_physical:
                continue
            try:
                rollback = stable_read(
                    rollback_path,
                    "transaction_rollback_" + rollback_prefix,
                    executable=rollback_prefix == "driver",
                    single_link=False,
                )
            except FileNotFoundError:
                if allow_missing_backups:
                    continue
                raise
            expected = (
                str(rollback.info.st_dev),
                str(rollback.info.st_ino),
                format(rollback.info.st_mode, "o"),
                "1",
                str(rollback.info.st_uid),
                str(rollback.info.st_gid),
                str(rollback.info.st_size),
            )
            if (
                rollback.sha256 != rollback_digest
                or rollback_fields != expected
                or rollback.info.st_nlink not in (1, 2)
            ):
                fail(
                    "install_transaction_rollback_identity_invalid:"
                    + previous_prefix
                )
            if rollback.info.st_nlink == 2:
                canonical = (
                    OFFICIAL
                    if rollback_prefix == "driver"
                    else OFFICIAL_RECEIPT
                )
                current = stable_read(
                    canonical,
                    "transaction_rollback_source_" + rollback_prefix,
                    executable=rollback_prefix == "driver",
                    single_link=False,
                )
                if (
                    current.raw != rollback.raw
                    or (current.info.st_dev, current.info.st_ino)
                    != (rollback.info.st_dev, rollback.info.st_ino)
                ):
                    fail(
                        "install_transaction_rollback_source_invalid:"
                        + previous_prefix
                    )
        elif (
            previous_fields != ("0", "0")
            or rollback_fields != ("0",) * len(rollback_fields)
        ):
            fail("install_transaction_absent_identity_invalid:" + previous_prefix)
    rollback_driver_path = decode_path(
        rows,
        "rollback_driver_path_fshex",
        "transaction_id_rollback_driver",
    )
    rollback_receipt_path = decode_path(
        rows,
        "rollback_receipt_path_fshex",
        "transaction_id_rollback_receipt",
    )
    transaction_payload = b"\0".join(
        (
            os.fsencode(private_transaction_path),
            os.fsencode(rollback_driver_path),
            os.fsencode(rollback_receipt_path),
            bytes.fromhex(candidate_sha256),
            bytes.fromhex(rows["source_manifest_sha256"]),
        )
    )
    if hashlib.sha256(transaction_payload).hexdigest() != transaction_id:
        fail("install_transaction_id_invalid")
    return rows


def stabilize_active_transaction_marker() -> None:
    active = read_existing(
        OFFICIAL_TRANSACTION,
        "official_active_transaction_stabilize",
        single_link=False,
    )
    if active is None:
        return
    rows = parse_rows(active, "official_active_transaction_stabilize")
    validate_payload_hash(
        active,
        rows,
        "receipt_payload_sha256",
        "official_active_transaction_stabilize",
    )
    if (
        tuple(rows) != INSTALL_TRANSACTION_KEYS
        or rows.get("schema")
        != "cheng.backend2.current_source_official_install_transaction"
        or rows.get("status") != "PREPARED"
    ):
        fail("official_active_transaction_stabilize_shape_invalid")
    private_path = decode_path(
        rows,
        "private_transaction_path_fshex",
        "official_active_transaction_stabilize_private",
    )
    semantic_rows = validate_install_transaction(
        private_path,
        raw_override=active.raw,
        validate_physical=False,
    )
    if semantic_rows != rows:
        fail("official_active_transaction_stabilize_semantics_invalid")
    if active.info.st_nlink == 1:
        canonical_path(
            private_path,
            "official_active_transaction_stabilize_private",
            allow_absent=True,
        )
        return
    if active.info.st_nlink != 2:
        fail("official_active_transaction_stabilize_nlink_invalid")
    private = stable_read(
        private_path,
        "official_active_transaction_stabilize_private",
        single_link=False,
    )
    if (
        private.raw != active.raw
        or private.info.st_nlink != 2
        or (private.info.st_dev, private.info.st_ino)
        != (active.info.st_dev, active.info.st_ino)
    ):
        fail("official_active_transaction_stabilize_identity_invalid")
    private.path.unlink()
    fsync_parent(private.path)
    stable_published_state(
        OFFICIAL_TRANSACTION,
        "official_active_transaction_stabilized",
    )


def install_transaction_raw_from_rows(rows: dict[str, str]) -> bytes:
    lines = [
        key + "=" + rows[key]
        for key in INSTALL_TRANSACTION_KEYS[:-1]
    ]
    return rendered(lines, "receipt_payload_sha256")


def commit_marker_raw(
    transaction_rows: dict[str, str],
    final_receipt: FileState,
    receipt_staging: FileState,
) -> bytes:
    lines = [
        "schema=cheng.backend2.current_source_official_install_commit",
        "status=COMMITTED",
        "prepared_payload_sha256="
        + transaction_rows["receipt_payload_sha256"],
    ]
    lines.extend(
        key + "=" + transaction_rows[key]
        for key in INSTALL_TRANSACTION_KEYS[2:-1]
    )
    lines.extend(
        (
            "final_receipt_path_fshex="
            + os.fsencode(final_receipt.path).hex(),
            "final_receipt_sha256=" + final_receipt.sha256,
            "final_receipt_device=" + str(final_receipt.info.st_dev),
            "final_receipt_inode=" + str(final_receipt.info.st_ino),
            "final_receipt_mode=" + format(final_receipt.info.st_mode, "o"),
            "final_receipt_nlink=" + str(final_receipt.info.st_nlink),
            "final_receipt_uid=" + str(final_receipt.info.st_uid),
            "final_receipt_gid=" + str(final_receipt.info.st_gid),
            "final_receipt_size=" + str(final_receipt.info.st_size),
            "official_receipt_staging_path_fshex="
            + os.fsencode(receipt_staging.path).hex(),
            "official_receipt_staging_sha256=" + receipt_staging.sha256,
            "official_receipt_staging_device="
            + str(receipt_staging.info.st_dev),
            "official_receipt_staging_inode="
            + str(receipt_staging.info.st_ino),
            "official_receipt_staging_mode="
            + format(receipt_staging.info.st_mode, "o"),
            "official_receipt_staging_nlink="
            + str(receipt_staging.info.st_nlink),
            "official_receipt_staging_uid="
            + str(receipt_staging.info.st_uid),
            "official_receipt_staging_gid="
            + str(receipt_staging.info.st_gid),
            "official_receipt_staging_size="
            + str(receipt_staging.info.st_size),
        )
    )
    return rendered(lines, "receipt_payload_sha256")


def validate_commit_marker(
    path: pathlib.Path = OFFICIAL_COMMIT,
) -> tuple[dict[str, str], FileState]:
    state = stable_published_state(path, "official_commit_marker")
    rows = parse_rows(state, "official_commit_marker")
    validate_payload_hash(
        state,
        rows,
        "receipt_payload_sha256",
        "official_commit_marker",
    )
    if (
        tuple(rows) != INSTALL_COMMIT_KEYS
        or rows.get("schema")
        != "cheng.backend2.current_source_official_install_commit"
        or rows.get("status") != "COMMITTED"
    ):
        fail("official_commit_marker_shape_invalid")
    prepared_rows = {
        "schema":
            "cheng.backend2.current_source_official_install_transaction",
        "status": "PREPARED",
    }
    prepared_rows.update(
        {
            key: rows[key]
            for key in INSTALL_TRANSACTION_KEYS[2:-1]
        }
    )
    prepared_raw = install_transaction_raw_from_rows(prepared_rows)
    prepared_state = FileState(
        pathlib.Path(
            os.fsdecode(
                bytes.fromhex(rows["private_transaction_path_fshex"])
            )
        ),
        prepared_raw,
        hashlib.sha256(prepared_raw).hexdigest(),
        state.info,
    )
    prepared_rows = parse_rows(prepared_state, "commit_prepared_transaction")
    if (
        prepared_rows["receipt_payload_sha256"]
        != rows["prepared_payload_sha256"]
    ):
        fail("official_commit_prepared_payload_invalid")
    private_path = prepared_state.path
    semantic_rows = validate_install_transaction(
        private_path,
        raw_override=prepared_raw,
        validate_physical=False,
    )
    if semantic_rows != prepared_rows:
        fail("official_commit_prepared_semantics_invalid")
    canonical_path(
        private_path,
        "official_commit_private_transaction",
        allow_absent=True,
    )
    semantic_source: pathlib.Path | None = None
    try:
        OFFICIAL_TRANSACTION.lstat()
    except FileNotFoundError:
        pass
    else:
        semantic_source = OFFICIAL_TRANSACTION
    if semantic_source is not None:
        physical_rows = validate_install_transaction(
            semantic_source,
            published=semantic_source == OFFICIAL_TRANSACTION,
            allow_missing_backups=True,
            allow_missing_staging=True,
        )
        if (
            physical_rows != prepared_rows
            or stable_read(
                semantic_source,
                "official_commit_prepared_source",
            ).raw
            != prepared_raw
        ):
            fail("official_commit_prepared_source_drift")
    final_path = decode_path(
        rows,
        "final_receipt_path_fshex",
        "official_commit_final_receipt",
    )
    if (
        final_path.parent != private_path.parent
        or final_path.name != "official-build-receipt.kv"
    ):
        fail("official_commit_final_receipt_path_invalid")
    try:
        final = stable_read(
            final_path,
            "official_commit_final_receipt",
        )
    except FileNotFoundError:
        final = None
    expected = (
        rows["final_receipt_sha256"],
        rows["final_receipt_device"],
        rows["final_receipt_inode"],
        rows["final_receipt_mode"],
        rows["final_receipt_nlink"],
        rows["final_receipt_uid"],
        rows["final_receipt_gid"],
        rows["final_receipt_size"],
    )
    if final is not None:
        actual = (
            final.sha256,
            str(final.info.st_dev),
            str(final.info.st_ino),
            format(final.info.st_mode, "o"),
            str(final.info.st_nlink),
            str(final.info.st_uid),
            str(final.info.st_gid),
            str(final.info.st_size),
        )
        if expected != actual:
            fail("official_commit_final_receipt_identity_drift")
        if (
            final.info.st_mode != stat.S_IFREG | 0o400
            or final.info.st_nlink != 1
            or final.info.st_uid != os.geteuid()
            or final.info.st_gid != os.getegid()
        ):
            fail("official_commit_final_receipt_physical_invalid")
    else:
        canonical_path(
            final_path,
            "official_commit_final_receipt_absent",
            allow_absent=True,
        )
    receipt_staging_path = decode_path(
        rows,
        "official_receipt_staging_path_fshex",
        "official_commit_receipt_staging",
    )
    if (
        receipt_staging_path.parent != private_path.parent
        or receipt_staging_path.name
        != "official-receipt-staging-" + rows["transaction_id"]
    ):
        fail("official_commit_receipt_staging_path_invalid")
    expected_staging = (
        rows["official_receipt_staging_sha256"],
        rows["official_receipt_staging_device"],
        rows["official_receipt_staging_inode"],
        rows["official_receipt_staging_mode"],
        rows["official_receipt_staging_nlink"],
        rows["official_receipt_staging_uid"],
        rows["official_receipt_staging_gid"],
        rows["official_receipt_staging_size"],
    )
    try:
        receipt_staging = stable_read(
            receipt_staging_path,
            "official_commit_receipt_staging",
            single_link=False,
        )
    except FileNotFoundError:
        receipt_staging = stable_read(
            OFFICIAL_RECEIPT,
            "official_commit_published_receipt",
        )
    actual_staging = (
        receipt_staging.sha256,
        str(receipt_staging.info.st_dev),
        str(receipt_staging.info.st_ino),
        format(receipt_staging.info.st_mode, "o"),
        "1",
        str(receipt_staging.info.st_uid),
        str(receipt_staging.info.st_gid),
        str(receipt_staging.info.st_size),
    )
    if (
        expected_staging != actual_staging
        or (
            final is not None
            and receipt_staging.raw != final.raw
        )
        or rows["official_receipt_staging_sha256"]
        != rows["final_receipt_sha256"]
    ):
        fail("official_commit_receipt_staging_identity_drift")
    if receipt_staging.info.st_nlink not in (1, 2):
        fail("official_commit_receipt_staging_nlink_invalid")
    if (
        receipt_staging.path == receipt_staging_path
        and receipt_staging.info.st_nlink == 2
    ):
        published_receipt = stable_read(
            OFFICIAL_RECEIPT,
            "official_commit_receipt_published_link",
            single_link=False,
        )
        if (
            published_receipt.raw != receipt_staging.raw
            or published_receipt.info.st_nlink != 2
            or (
                published_receipt.info.st_dev,
                published_receipt.info.st_ino,
            )
            != (
                receipt_staging.info.st_dev,
                receipt_staging.info.st_ino,
            )
        ):
            fail("official_commit_receipt_staging_link_invalid")
    elif receipt_staging.info.st_nlink != 1:
        fail("official_commit_published_receipt_nlink_invalid")
    prepared_rows.update(
        {
            key: rows[key]
            for key in INSTALL_COMMIT_KEYS
            if key.startswith("final_receipt_")
            or key.startswith("official_receipt_staging_")
        }
    )
    return prepared_rows, (
        final if final is not None else receipt_staging
    )


def stabilize_commit_marker() -> None:
