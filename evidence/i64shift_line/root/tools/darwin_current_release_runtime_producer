def publication_anchor_path(publish_root: pathlib.Path) -> pathlib.Path:
    if not publish_root.is_absolute() or not publish_root.name:
        fail("publication_publish_root_not_absolute")
    raw_name = os.fsencode(publish_root.name)
    try:
        raw_name.decode("utf-8", "strict")
    except UnicodeDecodeError:
        fail("publication_publish_root_name_not_utf8")
    anchor_name = (
        PUBLICATION_ANCHOR_PREFIX
        + raw_name.hex()
        + PUBLICATION_ANCHOR_SUFFIX
    )
    try:
        name_max = os.pathconf(publish_root.parent, "PC_NAME_MAX")
    except (OSError, ValueError) as exc:
        fail("publication_anchor_name_limit_unavailable:" + str(exc))
    if len(os.fsencode(anchor_name)) > name_max:
        fail("publication_anchor_name_too_long")
    return publish_root.parent / anchor_name


