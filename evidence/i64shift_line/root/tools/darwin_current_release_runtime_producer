def validate_leg_lldb_evidence(
    artifacts: dict[str, FileState],
    *,
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> None:
    orc_events = artifacts.get("orc_events")
    if not isinstance(orc_events, FileState):
        fail("formal_orc_events_missing")
    value, state = canonical_json_state(
        orc_events.path, "formal_orc_events"
    )
    if state.sha256 != orc_events.sha256 or not isinstance(value, dict):
        fail("formal_orc_events_identity_invalid")
    events = value.get("events")
    if not isinstance(events, list):
        fail("formal_orc_event_list_invalid")
    publications = [
        event
        for event in events
        if isinstance(event, dict)
        and event.get("kind") == "debug_object_publication"
    ]
    if len(publications) != 1:
        fail("formal_lldb_evidence_event_count_invalid")
    publication = publications[0]
    if (
        publication.get("ordinal") != 1
        or set(publication)
        != {
            "ordinal",
            "kind",
            "publicationRaw32",
            "publicationPathFshex",
        }
    ):
        fail("formal_lldb_evidence_event_shape_invalid")
    evidence = validate_lldb_evidence_receipt(
        path_from_fshex(
            publication["publicationPathFshex"],
            "formal_lldb_evidence",
        ),
        identity=identity,
        tools=tools,
    )
    if evidence.sha256 != require_sha(
        publication["publicationRaw32"], "formal_lldb_evidence"
    ):
        fail("formal_lldb_evidence_event_binding_invalid")


def mach_o_sections(state: FileState, label: str) -> list[dict[str, object]]:
    raw = state.raw
    if len(raw) < 32 or raw[:4] != b"\xcf\xfa\xed\xfe":
        fail(label + "_not_arm64_macho64")
    if int.from_bytes(raw[4:8], "little") != 0x0100000C:
        fail(label + "_not_arm64")
    command_count = int.from_bytes(raw[16:20], "little")
    command_bytes = int.from_bytes(raw[20:24], "little")
    if command_count <= 0 or 32 + command_bytes > len(raw):
        fail(label + "_load_commands_invalid")
    cursor = 32
    sections: list[dict[str, object]] = []
    for _ in range(command_count):
        if cursor + 8 > len(raw):
            fail(label + "_load_command_truncated")
        command = int.from_bytes(raw[cursor : cursor + 4], "little")
        size = int.from_bytes(raw[cursor + 4 : cursor + 8], "little")
        if size < 8 or cursor + size > len(raw):
            fail(label + "_load_command_size_invalid")
        if command == 0x19:
            if size < 72:
                fail(label + "_segment64_truncated")
            count = int.from_bytes(raw[cursor + 64 : cursor + 68], "little")
            if 72 + count * 80 > size:
                fail(label + "_section64_count_invalid")
            for index in range(count):
                start = cursor + 72 + index * 80
                section_name = raw[start : start + 16].split(b"\0", 1)[0]
                segment_name = raw[start + 16 : start + 32].split(b"\0", 1)[0]
                try:
                    section_text = section_name.decode("ascii", "strict")
                    segment_text = segment_name.decode("ascii", "strict")
                except UnicodeError as exc:
                    fail(label + "_section_name_invalid:" + str(exc))
                sections.append(
                    {
                        "ordinal": len(sections),
                        "segment": segment_text,
                        "section": section_text,
                        "address": int.from_bytes(
                            raw[start + 32 : start + 40], "little"
                        ),
                        "size": int.from_bytes(
                            raw[start + 40 : start + 48], "little"
                        ),
                        "offset": int.from_bytes(
                            raw[start + 48 : start + 52], "little"
                        ),
                    }
                )
        cursor += size
    if cursor != 32 + command_bytes or not sections:
        fail(label + "_section_table_invalid")
    return sections


def compile_projection(
    report_path: pathlib.Path,
    object_state: FileState,
    backend: str,
) -> tuple[int, str, list[dict[str, object]], list[dict[str, object]]]:
    rows, report_state = parse_kv(report_path, "compiler_projection_report")
    if rows.get("primary_object_actual_backend_kind") != backend:
        fail("compiler_projection_backend_mismatch")
    body_count = require_uint(
        rows.get("primary_object_body_ir_dod_soa_function_count"),
        "body_ir_function_count",
        positive=True,
    )
    body_rows = [
        key + "=" + rows[key]
        for key in sorted(rows)
        if key.startswith("primary_object_body_ir_")
        or key
        in {
            "primary_object_actual_backend_kind",
            "primary_object_item_count",
        }
    ]
    if not body_rows:
        fail("compiler_projection_body_ir_rows_empty")
    body_raw32 = hashlib.sha256(
        ("\n".join(body_rows) + "\n").encode("utf-8")
    ).hexdigest()
    action_count = require_uint(
        rows.get("regalloc_function_receipt_count"),
        "regalloc_function_receipt_count",
        positive=True,
    )
    actions: list[dict[str, object]] = []
    for index in range(action_count):
        prefix = f"regalloc_function_{index}_"
        fields = {
            "ordinal": index,
            "symbol": rows.get(prefix + "symbol"),
            "functionIrIndex": rows.get(prefix + "function_ir_index"),
            "functionKind": rows.get(prefix + "function_kind"),
            "planRaw32": rows.get(prefix + "plan_sha256"),
            "actionLedgerRootRaw32": rows.get(
                prefix + "action_ledger_root_sha256"
            ),
            "machineFragmentRootRaw32": rows.get(
                prefix + "machine_fragment_root_sha256"
            ),
        }
        if (
            not isinstance(fields["symbol"], str)
            or not fields["symbol"]
            or not str(fields["functionIrIndex"]).isdigit()
            or not isinstance(fields["functionKind"], str)
            or not fields["functionKind"]
        ):
            fail("compiler_projection_action_identity_invalid")
        for key in (
            "planRaw32",
            "actionLedgerRootRaw32",
            "machineFragmentRootRaw32",
        ):
            require_sha(fields[key], "compiler_projection_" + key)
        actions.append(fields)
    if rows.get("regalloc_output_object_sha256") != object_state.sha256:
        fail("compiler_projection_object_digest_mismatch")
    return (
        body_count,
        body_raw32,
        actions,
        mach_o_sections(object_state, "compiler_projection_object"),
    )


def framed_stream(magic: bytes, raw: bytes) -> bytes:
    if len(magic) != 8:
        fail("framed_stream_magic_invalid")
    return magic + len(raw).to_bytes(8, "big") + raw


def resource_samples(process: dict[str, object]) -> list[dict[str, int]]:
