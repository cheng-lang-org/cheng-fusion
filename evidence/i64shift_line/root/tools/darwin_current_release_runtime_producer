    source_relative: str,
    emit: str,
    jobs: int,
    root: pathlib.Path,
    out: pathlib.Path,
    tree: pathlib.Path,
    tree_digest: str,
    commands: dict[str, pathlib.Path],
    tools: dict[str, dict[str, object]],
    link_providers: bool,
    backend: str,
    resource_trace: bool = False,
) -> tuple[dict[str, object], pathlib.Path, pathlib.Path]:
    if backend not in ("primary", "backend2"):
        fail("compile_backend_invalid")
    process_dir = out / "processes" / label
    artifact = process_dir / ("artifact.exe" if emit == "exe" else "artifact.o")
    report = process_dir / "compile-report.kv"
    command = commands[driver_role]
    env = dict(FIXED_ENV_BASE)
    env["BACKEND_JOBS"] = str(jobs)
    env["CHENG_BACKEND2"] = "1" if backend == "backend2" else "0"
    argv = [
        str(command),
        "system-link-exec",
        "--root:" + str(tree / "repo"),
        "--in:" + str(tree / "repo" / source_relative),
        "--emit:" + emit,
        "--target:" + TARGET,
        "--backend:" + backend,
        "--backend-jobs:" + str(jobs),
        "--out:" + str(artifact),
        "--report-out:" + str(report),
    ]
    if link_providers:
        argv.append("--link-providers")
    process = run_guarded(
        label=label,
        root=root,
        out=out,
        tools=tools,
        argv=tuple(argv),
        env=env,
        argv_path_roles=(
            ArgvPathRole(0, "command", "", command),
            ArgvPathRole(2, "workspace_root", "--root:", tree / "repo"),
            ArgvPathRole(
                3,
                "source",
                "--in:",
                tree / "repo" / source_relative,
            ),
            ArgvPathRole(8, "artifact", "--out:", artifact),
            ArgvPathRole(
                9,
                "compile_report",
                "--report-out:",
                report,
            ),
        ),
        command_sha256=str(tools[driver_role]["sha256"]),
        command_mode="private_frozen_tree_direct",
        frozen_tree=tree,
        frozen_tree_sha256=tree_digest,
        tracked=(
            ("artifact", artifact, "executable" if emit == "exe" else "regular"),
            ("compile_report", report, "regular"),
        ),
        timeout_seconds=900,
        resource_trace=resource_trace,
        require_stdout_empty=True,
        require_stderr_empty=True,
    )
    report_rows, _ = parse_kv(report, "compiler_report")
    if report_rows.get("primary_object_actual_backend_kind") != backend:
        fail("compiler_backend_lane_mismatch:" + label)
    return process, artifact, report


