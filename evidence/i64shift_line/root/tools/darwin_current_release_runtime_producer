    out: pathlib.Path,
    binding: dict[str, str],
    primary_receipt: FileState,
    backend2_receipt: FileState,
    primary_artifacts: dict[str, FileState],
    backend2_artifacts: dict[str, FileState],
    case_count: int,
    debug_case_count: int,
    cases_master: FileState,
) -> FileState:
    diff_root = out / "exec-diff"
    report = exclusive_write(
        diff_root / "report.json",
        canonical_json_bytes(
            {
                "schema": "cheng.backend2.current_source_exec_diff_report",
                "status": "COMPLETE",
                "target": TARGET,
                "caseCount": case_count,
                "debugCaseCount": debug_case_count,
                "miscompileCount": 0,
                "primaryLegRaw32": primary_receipt.sha256,
                "backend2LegRaw32": backend2_receipt.sha256,
            }
        ),
        0o400,
    )
    receipt_lines = [
        "schema=cheng.backend2.current_source_exec_diff",
        "status=PASS",
        "driver_role=production",
        "target=" + TARGET,
        "source_closure_cid=" + binding["source_closure_cid"],
        "official_driver_sha256=" + binding["official_driver_sha256"],
        "backend_epoch_sha256=" + binding["backend_epoch_sha256"],
        "jobs_sha256=" + binding["jobs_sha256"],
        "action_ledger_sha256=" + binding["action_ledger_sha256"],
        "fragment_snapshot_sha256=" + binding["fragment_snapshot_sha256"],
        "primary_leg_receipt_sha256=" + primary_receipt.sha256,
        "backend2_leg_receipt_sha256=" + backend2_receipt.sha256,
        "miscompile_count=0",
        "debug_mismatch_count=0",
        "run_equivalent=true",
        "debug_equivalent=true",
        "orc_equivalent=true",
        "primary_run_stdout_sha256="
        + primary_artifacts["run_stdout"].sha256,
        "backend2_run_stdout_sha256="
        + backend2_artifacts["run_stdout"].sha256,
        "primary_run_stderr_sha256="
        + primary_artifacts["run_stderr"].sha256,
        "backend2_run_stderr_sha256="
        + backend2_artifacts["run_stderr"].sha256,
        "primary_orc_stdout_sha256="
        + primary_artifacts["orc_stdout"].sha256,
        "backend2_orc_stdout_sha256="
        + backend2_artifacts["orc_stdout"].sha256,
        "primary_orc_stderr_sha256="
        + primary_artifacts["orc_stderr"].sha256,
        "backend2_orc_stderr_sha256="
        + backend2_artifacts["orc_stderr"].sha256,
        "primary_cases_sha256="
        + primary_artifacts["exec_diff_cases"].sha256,
        "backend2_cases_sha256="
        + backend2_artifacts["exec_diff_cases"].sha256,
        "case_count=" + str(case_count),
        "debug_case_count=" + str(debug_case_count),
        "report_path_fshex="
        + os.fsencode(str(published_path(report.path))).hex(),
        "report_sha256=" + report.sha256,
        "cases_path_fshex="
        + os.fsencode(str(published_path(cases_master.path))).hex(),
        "cases_sha256=" + cases_master.sha256,
    ]
    receipt = exclusive_write(
        diff_root / "receipt.kv",
        release_render(release, receipt_lines, "receipt_payload_sha256"),
        0o400,
    )
    try:
        validated = release["validate_exec_diff_receipt"](
            receipt.path,
            TARGET,
            binding,
            evidence_root,
            primary_receipt.sha256,
            backend2_receipt.sha256,
            primary_artifacts,
            backend2_artifacts,
        )
    except Exception as exc:
        fail("formal_exec_diff_receipt_invalid:" + repr(exc))
    if validated.sha256 != receipt.sha256:
        fail("formal_exec_diff_receipt_identity_mismatch")
    return receipt


def produce_formal(args: argparse.Namespace) -> None:
    if platform.system() != "Darwin" or platform.machine().lower() != "arm64":
        fail("native_darwin_arm64_host_required")
    root = canonical_existing(args.root, "root", directory=True)
    identity_path = canonical_existing(
        args.identity_manifest, "identity_manifest"
    )
    identity, identity_state, tools = validate_identity(
        root, identity_path, revalidate_origins=True
    )
    evidence_root = canonical_existing(
        path_from_fshex(identity["evidenceRootFshex"], "evidence_root"),
        "evidence_root",
        directory=True,
    )
    if logical_path_from_fshex(
        identity["evidenceRootFshex"],
        "produce_logical_evidence_root",
    ) != pathlib.Path(args.publish_root):
        fail("produce_publish_root_binding_invalid")
    if evidence_root != canonical_existing(
        args.evidence_root,
        "produce_evidence_root",
        directory=True,
    ):
        fail("produce_evidence_root_binding_invalid")
    release, _, _ = load_release_contract(root)
    try:
        binding, binding_state = release["binding_rows"](
            evidence_root / "binding.kv"
        )
    except Exception as exc:
        fail("formal_binding_invalid:" + repr(exc))
    if path_pin(binding_state) != identity["formalBinding"]:
        fail("formal_binding_identity_drift")
    out = pathlib.Path(args.out)
    if (
        not out.is_absolute()
        or out.exists()
        or out.is_symlink()
        or pathlib.Path(os.path.realpath(out.parent)) != out.parent
        or not out.is_relative_to(evidence_root)
    ):
        fail("darwin_output_must_be_absent_descendant")
    os.mkdir(out, 0o700)
    tree, commands, snapshot_receipt = materialize_frozen_tree(
        root, out, identity, tools
    )
    tree_digest = private_tree_digest(tree)
    cases_master, diff_stdout, diff_stderr, diff_anchors = (
        produce_exec_diff(
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            identity=identity,
        )
    )
    formal_inputs: dict[str, dict[str, object]] = {}
    stage3_orc: tuple[bytes, bytes] | None = None
    stage3_orc_proof: dict[str, str] | None = None
    for backend in ("primary", "backend2", "stage3"):
        driver_role = "stage3" if backend == "stage3" else "official_driver"
        compile_backend = "backend2" if backend == "stage3" else backend
        object_process, _object_path, object_report = compile_source(
            label="leg_" + backend + "_object",
            driver_role=driver_role,
            source_relative=ORC_SOURCE,
            emit="obj",
            jobs=1,
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            link_providers=False,
            backend=compile_backend,
        )
        debug_compile, debug_path, _debug_report = compile_source(
            label="leg_" + backend + "_debug_compile",
            driver_role=driver_role,
            source_relative=ORC_SOURCE,
            emit="obj",
            jobs=1,
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            link_providers=False,
            backend=compile_backend,
        )
        (
            debug_process,
            debug_object,
            debug_publication,
        ) = lldb_inspect(
            label="leg_" + backend + "_debug_lldb",
            executable=debug_path,
            source_process=debug_compile,
            root=root,
            out=out,
            identity=identity,
            tools=tools,
        )
        executable_compile, executable_path, _ = compile_source(
            label="leg_" + backend + "_executable_compile",
            driver_role=driver_role,
            source_relative=ORC_SOURCE,
            emit="exe",
            jobs=1,
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            link_providers=True,
            backend=compile_backend,
        )
        (
            run_executable_path,
            run_root,
            run_digest,
            run_publication,
        ) = publish_executable(
            label="leg_" + backend + "_run",
            origin=executable_path,
            source_process=executable_compile,
            out=out,
        )
        (
            orc_executable_path,
            orc_root,
            orc_digest,
            orc_publication,
        ) = publish_executable(
            label="leg_" + backend + "_orc",
            origin=executable_path,
            source_process=executable_compile,
            out=out,
        )
        run_process = run_published(
            label="leg_" + backend + "_native_run",
            command=run_executable_path,
            publication_root=run_root,
            publication_digest=run_digest,
            root=root,
            out=out,
            tools=tools,
            expected_stdout=orc_expected_stdout(),
        )
        orc_process = run_published(
            label="leg_" + backend + "_atomic_orc_run",
            command=orc_executable_path,
            publication_root=orc_root,
            publication_digest=orc_digest,
            root=root,
            out=out,
            tools=tools,
            expected_stdout=orc_expected_stdout(),
        )
        runtime_pair = (
            process_state(
                orc_process, "stdout", "atomic_orc_stdout"
            ).raw,
            process_state(
                orc_process, "stderr", "atomic_orc_stderr"
            ).raw,
        )
        if backend == "stage3":
            stage3_orc = runtime_pair
            stage3_orc_proof = {
                "compilerGuardRaw32": executable_compile["guard"]["sha256"],
                "publicationRaw32": orc_publication.sha256,
                "runGuardRaw32": orc_process["guard"]["sha256"],
                "stdoutRaw32": orc_process["stdout"]["sha256"],
                "stderrRaw32": orc_process["stderr"]["sha256"],
            }
            continue
        formal_inputs[backend] = {
            "compile_process": object_process,
            "compile_report_path": object_report,
            "run_process": run_process,
            "executable_compile_process": executable_compile,
            "run_executable": stable_read(
                run_executable_path,
                "run_executable",
                executable=True,
            ),
            "run_publication": run_publication,
            "debug_process": debug_process,
            "debug_object": debug_object,
            "debug_publication": debug_publication,
            "orc_process": orc_process,
            "orc_executable": stable_read(
                orc_executable_path,
                "orc_executable",
                executable=True,
            ),
            "orc_publication": orc_publication,
            "runtime_pair": runtime_pair,
        }
    if stage3_orc is None or stage3_orc_proof is None or any(
        values["runtime_pair"] != stage3_orc
        for values in formal_inputs.values()
    ):
        fail("atomic_orc_current_stage3_mismatch")
    leg_results: dict[
        str, tuple[FileState, dict[str, FileState], dict[str, str]]
    ] = {}
    for backend in ("primary", "backend2"):
        values = formal_inputs[backend]
        leg_results[backend] = make_formal_leg(
            release=release,
            evidence_root=evidence_root,
            output_root=out,
            binding=binding,
            backend=backend,
            compile_process=values["compile_process"],
            compile_report_path=values["compile_report_path"],
            run_process=values["run_process"],
            run_executable=values["run_executable"],
            run_publication=values["run_publication"],
            debug_process=values["debug_process"],
            debug_object=values["debug_object"],
            debug_publication=values["debug_publication"],
            orc_process=values["orc_process"],
            orc_executable=values["orc_executable"],
            orc_publication=values["orc_publication"],
            executable_compile_process=values[
                "executable_compile_process"
            ],
            stage3_orc_proof=stage3_orc_proof,
            exec_cases_master=cases_master,
            exec_stdout_master=diff_stdout,
            exec_stderr_master=diff_stderr,
            exec_anchor_process=diff_anchors[backend],
            tools=tools,
        )
    primary_receipt, primary_artifacts, primary_rows = leg_results["primary"]
    backend2_receipt, backend2_artifacts, backend2_rows = leg_results[
        "backend2"
    ]
    primary_debug = [
        (section["segment"], section["section"])
        for section in mach_o_sections(
            primary_artifacts["debug_object"], "primary_debug"
        )
    ]
    backend2_debug = [
        (section["segment"], section["section"])
        for section in mach_o_sections(
            backend2_artifacts["debug_object"], "backend2_debug"
        )
    ]
    if primary_debug != backend2_debug:
        fail("formal_debug_backend_mismatch")
    case_count = int(primary_rows["exec_diff_case_count"])
    exec_receipt = make_exec_diff_receipt(
        release=release,
        evidence_root=evidence_root,
        out=out,
        binding=binding,
        primary_receipt=primary_receipt,
        backend2_receipt=backend2_receipt,
        primary_artifacts=primary_artifacts,
        backend2_artifacts=backend2_artifacts,
        case_count=case_count,
        debug_case_count=min(
            int(primary_rows["debug_section_count"]),
            int(backend2_rows["debug_section_count"]),
        ),
        cases_master=cases_master,
    )
    raw_samples, verdict, performance_evidence = produce_performance(
        release=release,
        root=root,
        evidence_root=evidence_root,
        out=out,
        tree=tree,
        tree_digest=tree_digest,
        commands=commands,
        tools=tools,
        identity=identity,
        binding=binding,
    )
    if private_tree_digest(tree) != tree_digest:
        fail("frozen_command_tree_drift")
    validate_identity(root, identity_path, revalidate_origins=True)
    summary_lines = [
        "driver_role=production",
        "runtime_validator_path_fshex="
        + os.fsencode(str(root / "tools/darwin_current_release_runtime_producer")).hex(),
        "runtime_validator_sha256="
        + stable_read(
            root / "tools/darwin_current_release_runtime_producer",
            "runtime_validator",
            executable=True,
        ).sha256,
        "identity_manifest_path_fshex="
        + os.fsencode(str(published_path(identity_path))).hex(),
        "darwin_primary_leg=" + str(published_path(primary_receipt.path)),
        "darwin_primary_leg_sha256=" + primary_receipt.sha256,
        "darwin_backend2_leg=" + str(published_path(backend2_receipt.path)),
        "darwin_backend2_leg_sha256=" + backend2_receipt.sha256,
        "darwin_exec_diff=" + str(published_path(exec_receipt.path)),
        "darwin_exec_diff_sha256=" + exec_receipt.sha256,
        "performance_raw=" + str(published_path(raw_samples.path)),
        "performance_raw_sha256=" + raw_samples.sha256,
        "performance_verdict=" + str(published_path(verdict.path)),
        "performance_verdict_sha256=" + verdict.sha256,
        "performance_evidence=" + str(published_path(performance_evidence.path)),
        "performance_evidence_sha256=" + performance_evidence.sha256,
        "identity_manifest_sha256=" + identity_state.sha256,
        "source_snapshot_sha256=" + snapshot_receipt.sha256,
        "hard_memory_limit_proof=not_provable_userspace_poll",
    ]
    exclusive_write(
        out / "formal-inputs.kv",
        ("\n".join(summary_lines) + "\n").encode(),
        0o400,
    )
    print("darwin_current_release_runtime_producer_status=COMPLETE")


def validate_formal(args: argparse.Namespace) -> None:
    root = canonical_existing(args.root, "root", directory=True)
    identity_path = canonical_existing(
        args.identity_manifest, "identity_manifest"
    )
    identity, identity_state, tools = validate_identity(
        root, identity_path, revalidate_origins=True
    )
    evidence_root = canonical_existing(
        path_from_fshex(identity["evidenceRootFshex"], "evidence_root"),
        "evidence_root",
        directory=True,
    )
    if logical_path_from_fshex(
        identity["evidenceRootFshex"],
        "validate_logical_evidence_root",
    ) != pathlib.Path(args.publish_root):
        fail("validate_publish_root_binding_invalid")
    if evidence_root != canonical_existing(
        args.evidence_root,
        "validate_evidence_root",
        directory=True,
    ):
        fail("validate_evidence_root_binding_invalid")
    out = canonical_existing(args.out, "darwin_output", directory=True)
    if not out.is_relative_to(evidence_root):
        fail("darwin_output_not_evidence_descendant")
    process_count, process_authority = (
        validate_published_runtime_process_tree(out, evidence_root)
    )
    release, _, _ = load_release_contract(root)
    binding, _ = release["binding_rows"](evidence_root / "binding.kv")
    primary, primary_artifacts, _ = release["validate_leg"](
        out / "legs/primary/receipt.kv",
        TARGET,
        "primary",
        binding,
        evidence_root,
    )
    backend2, backend2_artifacts, _ = release["validate_leg"](
        out / "legs/backend2/receipt.kv",
        TARGET,
        "backend2",
        binding,
        evidence_root,
    )
    validate_leg_lldb_evidence(
        primary_artifacts,
        identity=identity,
        tools=tools,
    )
    validate_leg_lldb_evidence(
        backend2_artifacts,
        identity=identity,
        tools=tools,
    )
    exec_receipt = release["validate_exec_diff_receipt"](
        out / "exec-diff/receipt.kv",
        TARGET,
        binding,
        evidence_root,
        primary.sha256,
        backend2.sha256,
        primary_artifacts,
        backend2_artifacts,
    )
    release["validate_perf"](
        out / "performance/raw-samples.tsv",
        out / "performance/verdict.kv",
        binding,
        evidence_root,
    )
    performance_evidence = release["validate_performance_evidence"](
        out / "performance/evidence.json",
        evidence_root,
        binding,
        binding["snapshot_manifest_sha256"],
        binding["seven_stage_execution_raw32"],
    )
    formal_inputs = stable_read(
        out / "formal-inputs.kv",
        "runtime_formal_inputs",
    )
    validator = stable_read(
        root / "tools/darwin_current_release_runtime_producer",
        "runtime_validator",
        executable=True,
    )
    receipt_lines = [
        "darwin_current_release_runtime_validation=PASS",
        "driver_role=production",
        "target=" + TARGET,
        "publish_root_fshex=" + os.fsencode(args.publish_root).hex(),
        "runtime_output_root_fshex="
        + os.fsencode(str(published_path(out))).hex(),
        "runtime_validator_sha256=" + validator.sha256,
        "identity_manifest_sha256=" + identity_state.sha256,
        "formal_inputs_sha256=" + formal_inputs.sha256,
        "published_process_count=" + str(process_count),
        "process_argv_raw32=" + process_authority["argvRaw32"],
        "process_env_raw32=" + process_authority["envRaw32"],
        "process_guard_raw32=" + process_authority["guardRaw32"],
        "process_physical_sha256=" + process_authority["physicalDigest"],
        "process_logical_sha256=" + process_authority["logicalDigest"],
        "process_path_role_sha256=" + process_authority["pathRoleDigest"],
        "process_support_path_role_sha256="
        + process_authority["supportPathRoleDigest"],
        "primary_receipt_sha256=" + primary.sha256,
        "backend2_receipt_sha256=" + backend2.sha256,
        "exec_diff_receipt_sha256=" + exec_receipt.sha256,
        "performance_evidence_sha256=" + performance_evidence.sha256,
    ]
    sys.stdout.buffer.write(
        release_render(
            release,
            receipt_lines,
            "receipt_payload_sha256",
        )
    )


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    sub = result.add_subparsers(dest="command", required=True)
    capture = sub.add_parser("capture-identities")
    capture.add_argument("--root", required=True)
    capture.add_argument("--evidence-root", required=True)
    capture.add_argument("--publish-root", required=True)
    capture.add_argument("--official-receipt", required=True)
    capture.add_argument("--monitor-python", required=True)
    capture.add_argument("--clang", required=True)
    capture.add_argument("--llvm-objdump", required=True)
    capture.add_argument("--out", required=True)
    produce_cmd = sub.add_parser("produce")
    produce_cmd.add_argument("--root", required=True)
    produce_cmd.add_argument("--evidence-root", required=True)
    produce_cmd.add_argument("--publish-root", required=True)
    produce_cmd.add_argument("--identity-manifest", required=True)
    produce_cmd.add_argument("--out", required=True)
    validate_cmd = sub.add_parser("validate")
    validate_cmd.add_argument("--root", required=True)
    validate_cmd.add_argument("--evidence-root", required=True)
    validate_cmd.add_argument("--publish-root", required=True)
    validate_cmd.add_argument("--identity-manifest", required=True)
    validate_cmd.add_argument("--out", required=True)
    validate_cmd.add_argument("--staged", action="store_true")
    return result


def main() -> None:
    args = parser().parse_args()
    committed = args.command == "validate" and not args.staged
    work_root, publish_root = runtime_publication_roots(
        args,
        committed=committed,
    )
    if committed:
        args.evidence_root = str(publish_root)
    with publication_path_projection(work_root, publish_root):
        if args.command == "capture-identities":
            capture_identity(args)
        elif args.command == "produce":
            produce_formal(args)
        elif args.command == "validate":
            validate_formal(args)
        else:
            fail("command_invalid")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError) as exc:
        print(
            "darwin_current_release_runtime_producer_status=HARD_RED",
            file=sys.stderr,
        )
        print(
            "darwin_current_release_runtime_producer_reason=" + str(exc),
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
