def darwin_bootstrap_lane_from_binding(
    binding: dict[str, str],
) -> tuple[dict[str, object], FileState]:
    receipt = stable_read(
        path_from_fshex(
            binding.get(
                "darwin_bootstrap_lane_receipt_path_fshex", ""
            ),
            "darwin_bootstrap_lane_receipt",
        ),
        "darwin_bootstrap_lane_receipt",
    )
    physical = {
        "darwin_bootstrap_lane_receipt_sha256": receipt.sha256,
        "darwin_bootstrap_lane_receipt_device": str(receipt.info.st_dev),
        "darwin_bootstrap_lane_receipt_inode": str(receipt.info.st_ino),
        "darwin_bootstrap_lane_receipt_mode":
            format(receipt.info.st_mode, "o"),
        "darwin_bootstrap_lane_receipt_nlink": str(receipt.info.st_nlink),
        "darwin_bootstrap_lane_receipt_size": str(receipt.info.st_size),
        "darwin_bootstrap_lane_receipt_uid": str(receipt.info.st_uid),
        "darwin_bootstrap_lane_receipt_gid": str(receipt.info.st_gid),
        "darwin_bootstrap_lane_receipt_mtime_ns":
            str(receipt.info.st_mtime_ns),
        "darwin_bootstrap_lane_receipt_ctime_ns":
            str(receipt.info.st_ctime_ns),
    }
    if (
        binding.get("darwin_bootstrap_lane") != "darwin"
        or binding.get("darwin_bootstrap_phase_count") != "16"
        or binding.get("darwin_bootstrap_stage3_sha256")
        != binding.get("baseline_driver_sha256")
        or any(binding.get(key) != value for key, value in physical.items())
    ):
        fail("darwin_bootstrap_binding_invalid")
    phase_chain_sha256 = require_sha(
        binding.get("darwin_bootstrap_phase_chain_sha256"),
        "darwin_bootstrap_phase_chain",
    )
    guard_aggregate_sha256 = require_sha(
        binding.get("darwin_bootstrap_guard_aggregate_sha256"),
        "darwin_bootstrap_guard_aggregate",
    )
    if (
        phase_chain_sha256 == ZERO_SHA256
        or guard_aggregate_sha256 == ZERO_SHA256
    ):
        fail("darwin_bootstrap_aggregate_zero")
    value = {
        "lane": "darwin",
        "phaseCount": 16,
        "receipt": path_pin(receipt),
        "validatorSha256": require_sha(
            binding.get("darwin_bootstrap_lane_validator_sha256"),
            "darwin_bootstrap_lane_validator",
        ),
        "phaseChainSha256": phase_chain_sha256,
        "guardAggregateSha256": guard_aggregate_sha256,
        "stage3Sha256": require_sha(
            binding.get("darwin_bootstrap_stage3_sha256"),
            "darwin_bootstrap_stage3",
        ),
    }
    return value, receipt


def runtime_publication_roots(
    args: argparse.Namespace,
    *,
    committed: bool = False,
) -> tuple[pathlib.Path, pathlib.Path]:
    if committed:
        work_root = pathlib.Path(args.evidence_root)
        publish_root = canonical_existing(
            args.publish_root,
            "published_release_root",
            directory=True,
        )
        anchor = publication_anchor_path(publish_root)
        anchor = canonical_existing(
            anchor,
            "published_release_anchor",
            directory=True,
        )
        work_info_missing = not work_root.exists() and not work_root.is_symlink()
        publish_info = publish_root.lstat()
        anchor_info = anchor.lstat()
        if (
            not work_root.is_absolute()
            or work_root != anchor / "work"
            or pathlib.Path(os.path.realpath(work_root)) != work_root
            or not work_info_missing
            or stat.S_IMODE(publish_info.st_mode) != 0o700
            or stat.S_IMODE(anchor_info.st_mode) != 0o700
            or publish_info.st_uid != os.geteuid()
            or publish_info.st_gid != os.getegid()
            or anchor_info.st_uid != publish_info.st_uid
            or anchor_info.st_gid != publish_info.st_gid
            or anchor_info.st_dev != publish_info.st_dev
            or os.listdir(anchor)
        ):
            fail("committed_release_publication_roots_invalid")
        return publish_root, publish_root
    work_root = canonical_existing(
        args.evidence_root,
        "release_evidence_work_root",
        directory=True,
    )
    publish_root = pathlib.Path(args.publish_root)
    anchor = canonical_existing(
        work_root.parent,
        "release_publication_anchor",
        directory=True,
    )
    expected_anchor = publication_anchor_path(publish_root)
    if (
        not publish_root.is_absolute()
        or work_root != anchor / "work"
        or anchor != expected_anchor
        or anchor.parent != publish_root.parent
        or publish_root != publish_root.parent / publish_root.name
        or pathlib.Path(os.path.realpath(publish_root)) != publish_root
    ):
        fail("release_publication_roots_not_distinct_siblings")
    try:
        publish_root.lstat()
    except FileNotFoundError:
        pass
    except OSError as exc:
        fail("release_publish_root_lookup_failed:" + str(exc.errno))
    else:
        fail("release_publish_root_must_be_absent")
    work_info = work_root.lstat()
    anchor_info = anchor.lstat()
    parent_info = anchor.parent.lstat()
    if (
        stat.S_IMODE(work_info.st_mode) != 0o700
        or stat.S_IMODE(anchor_info.st_mode) != 0o700
        or work_info.st_uid != os.geteuid()
        or work_info.st_gid != os.getegid()
        or anchor_info.st_uid != work_info.st_uid
        or anchor_info.st_gid != work_info.st_gid
        or work_info.st_dev != parent_info.st_dev
        or anchor_info.st_dev != parent_info.st_dev
    ):
        fail("release_anchor_work_private_same_device_required")
    return work_root, publish_root


def capture_identity(args: argparse.Namespace) -> None:
    if platform.system() != "Darwin" or platform.machine().lower() != "arm64":
        fail("native_darwin_arm64_host_required")
    root = canonical_existing(args.root, "root", directory=True)
    evidence_root = canonical_existing(
        args.evidence_root, "release_evidence_root", directory=True
    )
    official_receipt = canonical_existing(
        args.official_receipt, "official_receipt"
    )
    monitor_python = canonical_existing(
        args.monitor_python, "monitor_python", executable=True
    )
    clang = canonical_existing(
        args.clang,
        "clang",
        executable=True,
    )
    llvm_objdump = canonical_existing(
        args.llvm_objdump,
        "llvm_objdump",
        executable=True,
    )
    if clang == pathlib.Path("/usr/bin/clang"):
        fail("clang_must_be_real_toolchain_binary_not_ssv_dispatch_shim")
    xcode_lldb = canonical_existing(
        XCODE_LLDB, "xcode_lldb", executable=True
    )
    lldb_closure = capture_lldb_closure(xcode_lldb)
    output = pathlib.Path(args.out)
    if not output.is_absolute() or output.exists() or output.is_symlink():
        fail("identity_output_must_be_absolute_and_absent")
    if pathlib.Path(os.path.realpath(output.parent)) != output.parent:
        fail("identity_output_parent_not_canonical")
    release, contract_raw, schedule = load_release_contract(root)
    try:
        contract_state = release["validate_contract"](evidence_root / "contract.kv")
        binding, binding_state = release["binding_rows"](
            evidence_root / "binding.kv"
        )
    except Exception as exc:
        fail("formal_release_preflight_invalid:" + repr(exc))
    if (
        binding["contract_sha256"] != contract_state.sha256
        or contract_state.raw != contract_raw
        or logical_path_from_fshex(
            binding["publication_root_fshex"],
            "capture_publication_root",
        )
        != pathlib.Path(args.publish_root)
        or release["publication_anchor_path"](
            pathlib.Path(args.publish_root)
        )
        != publication_anchor_path(pathlib.Path(args.publish_root))
    ):
        fail("formal_release_contract_binding_mismatch")
    darwin_bootstrap_lane, _ = darwin_bootstrap_lane_from_binding(
        binding
    )
    source_closure = evidence_root / "source-closure.before"
    source_state, source_cid, members = parse_source_closure(root, source_closure)
    if source_cid != binding["source_closure_cid"]:
        fail("source_closure_cid_binding_mismatch")
    performance_source = stable_read(
        evidence_root / "performance-source.cheng", "performance_source"
    )
    if performance_source.sha256 != binding["performance_source_sha256"]:
        fail("performance_source_binding_mismatch")
    cases = validate_case_authority(members)
    if (
        source_member_map(members)[PERFORMANCE_SOURCE]["sha256"]
        != binding["performance_source_sha256"]
    ):
        fail("performance_source_member_binding_mismatch")
    official_state = stable_read(official_receipt, "official_receipt")
    if official_state.sha256 != binding["official_receipt_sha256"]:
        fail("official_receipt_binding_mismatch")
    official_validator_path = (
        root / "tools/backend2_current_source_official_evidence"
    )
    official_validator = load_python_tool(
        official_validator_path, "official_validator"
    )
    try:
        official_validator["validate"]([str(official_receipt)])
        receipt_rows, _ = release["read_rows"](
            official_receipt,
            "official_publisher_receipt",
            "receipt_payload_sha256",
        )
    except Exception as exc:
        fail("official_receipt_invalid:" + repr(exc))
    official_driver = release["fs_path"](
        receipt_rows["official_driver_path_fshex"], "official_driver"
    )
    if official_driver != root / "artifacts/backend_driver/cheng":
        fail("official_driver_path_not_unique_current")
    producer_root = release["fs_path"](
        receipt_rows["producer_root_fshex"], "official_producer_root"
    )
    candidate_rows, candidate_state = release["read_rows"](
        producer_root / "raw/backend-driver.current.report.kv",
        "official_candidate_report",
    )
    if candidate_state.sha256 != binding["candidate_report_sha256"]:
        fail("official_candidate_report_binding_mismatch")
    action_ledger = pathlib.Path(
        candidate_rows.get("regalloc_action_emission_ledger_path", "")
    )
    fragment_snapshot = pathlib.Path(
        candidate_rows.get("regalloc_frozen_plan_snapshot_path", "")
    )
    action_state = stable_read(action_ledger, "action_ledger_origin")
    fragment_state = stable_read(fragment_snapshot, "fragment_snapshot_origin")
    if (
        action_state.sha256 != binding["action_ledger_sha256"]
        or fragment_state.sha256 != binding["fragment_snapshot_sha256"]
    ):
        fail("official_action_fragment_binding_mismatch")
    tools: list[dict[str, object]] = []
    seen_inodes: set[tuple[int, int]] = set()
    for role, path in tool_paths(
        root,
        monitor_python,
        clang,
        llvm_objdump,
        official_receipt,
        official_driver,
        xcode_lldb,
        candidate_state.path,
        action_ledger,
        fragment_snapshot,
    ).items():
        executable = role in {
            "producer",
            "process_guard",
            "release_evidence",
            "official_validator",
            "official_driver",
            "stage3",
            "monitor_python",
            "xcode_lldb",
            "clang",
            "llvm_objdump",
        }
        state = stable_read(
            path,
            "tool_" + role,
            executable=executable,
        )
        if role == "process_guard" and stat.S_IMODE(state.info.st_mode) != 0o555:
            fail("process_guard_mode_not_frozen_0555")
        if (
            role == "process_guard_runtime"
            and stat.S_IMODE(state.info.st_mode) != 0o444
        ):
            fail("process_guard_runtime_mode_not_frozen_0444")
        inode = (state.info.st_dev, state.info.st_ino)
        if inode in seen_inodes:
            fail("tool_inode_alias:" + role)
        seen_inodes.add(inode)
        tools.append(
            {
                "role": role,
                "pathFshex": os.fsencode(str(path)).hex(),
                "sha256": state.sha256,
                "size": state.info.st_size,
                "identity": file_identity(state.info),
            }
        )
    tools_by_role = {str(item["role"]): item for item in tools}
    current = tools_by_role["official_driver"]
    stage3 = tools_by_role["stage3"]
    if (
        current["sha256"] != binding["official_driver_sha256"]
        or stage3["sha256"] != binding["baseline_driver_sha256"]
    ):
        fail("current_baseline_driver_binding_mismatch")
    if (
        current["identity"]["device"],
        current["identity"]["inode"],
    ) == (
        stage3["identity"]["device"],
        stage3["identity"]["inode"],
    ):
        fail("official_driver_and_stage3_physical_identity_invalid")
    identity = {
        "schema": IDENTITY_SCHEMA,
        "status": "FROZEN",
        "target": TARGET,
        "hardMemoryLimitBytes": LIMIT_BYTES,
        "hardMemoryLimitProof": "not_provable_userspace_poll",
        "rootFshex": os.fsencode(str(root)).hex(),
        "evidenceRootFshex":
            os.fsencode(str(published_path(evidence_root))).hex(),
        "formalContract": path_pin(contract_state),
        "formalBinding": path_pin(binding_state),
        "darwinBootstrapLane": darwin_bootstrap_lane,
        "performanceSource": path_pin(performance_source),
        "sourceClosure": path_pin(source_state),
        "sourceClosureCid": source_cid,
        "sourceMembers": members,
        "sourceMemberCount": len(members),
        "execDiffCases": list(cases),
        "execDiffCaseCount": len(cases),
        "toolMembers": tools,
        "toolMemberCount": len(tools),
        "lldbClosure": lldb_closure,
        "releaseContractSha256": hashlib.sha256(contract_raw).hexdigest(),
        "performanceSchedule": [
            {
                "ordinal": index,
                "block": index // 4,
                "order": order,
                "position": index % 4,
                "jobs": jobs,
                "role": role,
            }
            for index, (order, jobs, role) in enumerate(schedule)
        ],
    }
    exclusive_write(output, canonical_json_bytes(identity), 0o400)
    print("darwin_current_release_runtime_identity=" + str(output))


def validate_identity(
    root: pathlib.Path,
    identity_path: pathlib.Path,
    *,
    revalidate_origins: bool,
) -> tuple[dict[str, object], FileState, dict[str, dict[str, object]]]:
    value, state = canonical_json_state(identity_path, "identity_manifest")
    if not isinstance(value, dict) or set(value) != {
        "schema",
        "status",
        "target",
        "hardMemoryLimitBytes",
        "hardMemoryLimitProof",
        "rootFshex",
        "evidenceRootFshex",
        "formalContract",
        "formalBinding",
        "darwinBootstrapLane",
        "performanceSource",
        "sourceClosure",
        "sourceClosureCid",
        "sourceMembers",
        "sourceMemberCount",
        "execDiffCases",
        "execDiffCaseCount",
        "toolMembers",
        "toolMemberCount",
        "lldbClosure",
        "releaseContractSha256",
        "performanceSchedule",
    }:
        fail("identity_manifest_shape_invalid")
    if (
        value["schema"] != IDENTITY_SCHEMA
        or value["status"] != "FROZEN"
        or value["target"] != TARGET
        or value["hardMemoryLimitBytes"] != LIMIT_BYTES
        or value["hardMemoryLimitProof"] != "not_provable_userspace_poll"
        or path_from_fshex(value["rootFshex"], "identity_root") != root
    ):
        fail("identity_manifest_header_invalid")
    darwin_bootstrap_lane_value = value["darwinBootstrapLane"]
    if (
        not isinstance(darwin_bootstrap_lane_value, dict)
        or set(darwin_bootstrap_lane_value)
        != {
            "lane",
            "phaseCount",
            "receipt",
            "validatorSha256",
            "phaseChainSha256",
            "guardAggregateSha256",
            "stage3Sha256",
        }
        or darwin_bootstrap_lane_value["lane"] != "darwin"
        or darwin_bootstrap_lane_value["phaseCount"] != 16
    ):
        fail("identity_darwin_bootstrap_lane_invalid")
    receipt_pin = darwin_bootstrap_lane_value["receipt"]
    if not isinstance(receipt_pin, dict) or set(receipt_pin) != {
        "pathFshex",
        "sha256",
        "size",
        "identity",
    }:
        fail("identity_darwin_bootstrap_receipt_pin_invalid")
    for key in (
        "validatorSha256",
        "phaseChainSha256",
        "guardAggregateSha256",
        "stage3Sha256",
    ):
        require_sha(
            darwin_bootstrap_lane_value[key],
            "identity_darwin_bootstrap_" + key,
        )
    if (
        darwin_bootstrap_lane_value["phaseChainSha256"] == ZERO_SHA256
        or darwin_bootstrap_lane_value["guardAggregateSha256"]
        == ZERO_SHA256
    ):
        fail("identity_darwin_bootstrap_aggregate_zero")
    evidence_root = path_from_fshex(
        value["evidenceRootFshex"], "identity_evidence_root"
    )
    if not evidence_root.is_absolute():
        fail("identity_evidence_root_not_absolute")
    source_members = value["sourceMembers"]
    tool_members = value["toolMembers"]
    if not isinstance(source_members, list) or not isinstance(tool_members, list):
        fail("identity_member_lists_invalid")
    if (
        value["sourceMemberCount"] != len(source_members)
        or value["toolMemberCount"] != len(tool_members)
        or value["execDiffCaseCount"] != len(value["execDiffCases"])
    ):
        fail("identity_member_count_invalid")
    cases = validate_case_authority(source_members)
    if list(cases) != value["execDiffCases"]:
        fail("identity_exec_diff_case_set_invalid")
    schedule = value["performanceSchedule"]
    if not isinstance(schedule, list) or len(schedule) != 12:
        fail("identity_performance_schedule_invalid")
    release, expected_contract, expected_schedule = load_release_contract(root)
    if hashlib.sha256(expected_contract).hexdigest() != value["releaseContractSha256"]:
        fail("identity_release_contract_drift")
    expected_rows = [
        {
            "ordinal": index,
            "block": index // 4,
            "order": order,
            "position": index % 4,
            "jobs": jobs,
            "role": role,
        }
        for index, (order, jobs, role) in enumerate(expected_schedule)
    ]
    if schedule != expected_rows:
        fail("identity_performance_schedule_drift")
    if revalidate_origins:
        contract_state = validate_pin(value["formalContract"], "formal_contract")
        binding_state = validate_pin(value["formalBinding"], "formal_binding")
        performance_source = validate_pin(
            value["performanceSource"], "performance_source"
        )
        if (
            contract_state.path != evidence_root / "contract.kv"
            or binding_state.path != evidence_root / "binding.kv"
            or performance_source.path
            != evidence_root / "performance-source.cheng"
        ):
            fail("formal_preflight_path_binding_invalid")
        try:
            formal_contract = release["validate_contract"](contract_state.path)
            binding, formal_binding = release["binding_rows"](
                binding_state.path
            )
            darwin_bootstrap_lane, _ = (
                darwin_bootstrap_lane_from_binding(binding)
            )
        except Exception as exc:
            fail("formal_preflight_revalidation_failed:" + repr(exc))
        if (
            formal_contract.sha256 != contract_state.sha256
            or formal_binding.sha256 != binding_state.sha256
            or binding["source_closure_cid"] != value["sourceClosureCid"]
            or binding["performance_source_sha256"] != performance_source.sha256
            or darwin_bootstrap_lane != value["darwinBootstrapLane"]
        ):
            fail("formal_preflight_binding_drift")
    by_role: dict[str, dict[str, object]] = {}
    for item in tool_members:
        if not isinstance(item, dict) or set(item) != {
            "role",
            "pathFshex",
            "sha256",
            "size",
            "identity",
        }:
            fail("tool_member_shape_invalid")
        role = str(item["role"])
        if role in by_role or role not in TOOL_ROLES:
            fail("tool_member_role_invalid")
        by_role[role] = item
        if revalidate_origins:
            verify_bound_file(
                path_from_fshex(item["pathFshex"], "tool_" + role),
                item,
                "tool_" + role,
                executable=role
                in {
                    "producer",
                    "process_guard",
                    "release_evidence",
                    "official_validator",
                    "official_driver",
                    "stage3",
                    "monitor_python",
                    "xcode_lldb",
                    "clang",
                    "llvm_objdump",
                },
            )
    if tuple(by_role) != TOOL_ROLES:
        fail("tool_member_order_invalid")
    if revalidate_origins:
        verify_lldb_origin_closure(value["lldbClosure"])
    source_closure_path = path_from_fshex(
        value["sourceClosure"]["pathFshex"], "source_closure"
    )
    if revalidate_origins:
        validate_pin(value["sourceClosure"], "source_closure")
        source_state, source_cid, fresh_members = parse_source_closure(
            root, source_closure_path
        )
        if (
            path_pin(source_state) != value["sourceClosure"]
            or source_cid != value["sourceClosureCid"]
            or fresh_members != source_members
        ):
            fail("source_closure_origin_drift")
    return value, state, by_role


def frame(raw: bytes) -> bytes:
    return struct.pack(">I", len(raw)) + raw


def command_argv_digest(argv: Iterable[str]) -> str:
    values = tuple(argv)
    payload = bytearray(frame(b"cheng.guard.command_argv"))
    payload.extend(struct.pack(">I", len(values)))
    for value in values:
        payload.extend(frame(os.fsencode(value)))
    return hashlib.sha256(payload).hexdigest()


def env_digest(values: dict[str, str]) -> str:
    payload = bytearray(frame(b"cheng.guard.target_env"))
    keys = sorted(values)
    payload.extend(struct.pack(">I", len(keys)))
    for key in keys:
        payload.extend(frame(os.fsencode(key)))
        payload.extend(frame(os.fsencode(values[key])))
    return hashlib.sha256(payload).hexdigest()


def publication_mapping_roots() -> tuple[pathlib.Path, pathlib.Path]:
    if _PUBLICATION_PATH_PROJECTION is None:
        fail("publication_mapping_projection_required")
    work_root, publish_root = _PUBLICATION_PATH_PROJECTION
    if (
        work_root == publish_root
        or work_root != publication_anchor_path(publish_root) / "work"
    ):
        fail("publication_mapping_roots_invalid")
    return work_root, publish_root


def publication_path_mapping_row(
    *,
    ordinal: int,
    role: str,
    selector: str,
    prefix: str,
    path: pathlib.Path,
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> dict[str, object]:
    if LABEL_RE.fullmatch(role) is None or not path.is_absolute():
        fail("publication_path_role_invalid:" + role)
    try:
        relative = path.relative_to(work_root)
    except ValueError:
        fail("publication_path_role_outside_work_root:" + role)
    logical = publish_root / relative
    if (
        logical == path
        or physical_publication_path(logical) != path
        or published_path(path) != logical
    ):
        fail("publication_path_role_projection_invalid:" + role)
    return {
        "ordinal": ordinal,
        "role": role,
        "selector": selector,
        "prefixUtf8Hex": prefix.encode("utf-8", "strict").hex(),
        "physicalPathFshex": os.fsencode(path).hex(),
        "logicalPathFshex": os.fsencode(logical).hex(),
    }


def argv_publication_manifest(
    argv: tuple[str, ...],
    roles: tuple[ArgvPathRole, ...],
    support_roles: tuple[SupportPathRole, ...] = (),
) -> dict[str, object]:
    work_root, publish_root = publication_mapping_roots()
    physical = list(argv)
    logical = list(argv)
    rows: list[dict[str, object]] = []
    seen_indices: set[int] = set()
    for ordinal, current in enumerate(sorted(roles, key=lambda row: row.index)):
        if (
            current.index < 0
            or current.index >= len(argv)
            or current.index in seen_indices
        ):
            fail("publication_argv_path_role_index_invalid")
        seen_indices.add(current.index)
        physical_value = current.prefix + str(current.path)
        if argv[current.index] != physical_value:
            fail("publication_argv_path_role_value_invalid:" + current.role)
        row = publication_path_mapping_row(
            ordinal=ordinal,
            role=current.role,
            selector=str(current.index),
            prefix=current.prefix,
            path=current.path,
            work_root=work_root,
            publish_root=publish_root,
        )
        logical[current.index] = current.prefix + os.fsdecode(
            bytes.fromhex(str(row["logicalPathFshex"]))
        )
        rows.append(row)
    work_text = str(work_root)
    for index, value in enumerate(physical):
        if work_text in value and index not in seen_indices:
            fail("publication_argv_untyped_work_path:" + str(index))
    if any(work_text in value for value in logical):
        fail("publication_argv_logical_work_path_residual")
    support_rows: list[dict[str, object]] = []
    seen_support_roles: set[str] = set()
    for ordinal, current in enumerate(
        sorted(support_roles, key=lambda row: row.role)
    ):
        if current.role in seen_support_roles:
            fail("publication_support_path_role_duplicate:" + current.role)
        seen_support_roles.add(current.role)
        support_rows.append(
            publication_path_mapping_row(
                ordinal=ordinal,
                role=current.role,
                selector=current.role,
                prefix="",
                path=current.path,
                work_root=work_root,
                publish_root=publish_root,
            )
        )
    return {
        "schema": "cheng.darwin_current_release_runtime_argv",
        "physicalValues": physical,
        "physicalDigest": command_argv_digest(physical),
        "logicalValues": logical,
        "logicalDigest": command_argv_digest(logical),
        "workRootFshex": os.fsencode(work_root).hex(),
        "publishRootFshex": os.fsencode(publish_root).hex(),
        "pathRoles": rows,
        "pathRoleDigest": hashlib.sha256(
            canonical_json_bytes(rows)
        ).hexdigest(),
        "supportPaths": support_rows,
        "supportPathRoleDigest": hashlib.sha256(
            canonical_json_bytes(support_rows)
        ).hexdigest(),
    }


def env_publication_manifest(
    env: dict[str, str],
    roles: tuple[EnvPathRole, ...],
) -> dict[str, object]:
    work_root, publish_root = publication_mapping_roots()
    physical = {key: env[key] for key in sorted(env)}
    logical = dict(physical)
    rows: list[dict[str, object]] = []
    seen_keys: set[str] = set()
    for ordinal, current in enumerate(sorted(roles, key=lambda row: row.key)):
        if (
            current.key not in physical
            or current.key in seen_keys
            or not re.fullmatch(r"[A-Z][A-Z0-9_]*", current.key)
            or physical[current.key] != str(current.path)
        ):
            fail("publication_env_path_role_invalid:" + current.role)
        seen_keys.add(current.key)
        row = publication_path_mapping_row(
            ordinal=ordinal,
            role=current.role,
            selector=current.key,
            prefix="",
            path=current.path,
            work_root=work_root,
            publish_root=publish_root,
        )
        logical[current.key] = os.fsdecode(
            bytes.fromhex(str(row["logicalPathFshex"]))
        )
        rows.append(row)
    work_text = str(work_root)
    for key, value in physical.items():
        if work_text in value and key not in seen_keys:
            fail("publication_env_untyped_work_path:" + key)
    if any(work_text in value for value in logical.values()):
        fail("publication_env_logical_work_path_residual")
    return {
        "schema": "cheng.darwin_current_release_runtime_env",
        "physicalValues": physical,
        "physicalDigest": env_digest(physical),
        "logicalValues": logical,
        "logicalDigest": env_digest(logical),
        "workRootFshex": os.fsencode(work_root).hex(),
        "publishRootFshex": os.fsencode(publish_root).hex(),
        "pathRoles": rows,
        "pathRoleDigest": hashlib.sha256(
            canonical_json_bytes(rows)
        ).hexdigest(),
        "supportPaths": [],
        "supportPathRoleDigest": hashlib.sha256(
            canonical_json_bytes([])
        ).hexdigest(),
    }


def validate_publication_channel_manifest(
    value: object,
    *,
    kind: str,
) -> tuple[object, object, str, str]:
    if not isinstance(value, dict) or set(value) != {
        "schema",
        "physicalValues",
        "physicalDigest",
        "logicalValues",
        "logicalDigest",
        "workRootFshex",
        "publishRootFshex",
        "pathRoles",
        "pathRoleDigest",
        "supportPaths",
        "supportPathRoleDigest",
    }:
        fail("publication_" + kind + "_manifest_shape_invalid")
    expected_schema = "cheng.darwin_current_release_runtime_" + kind
    if value["schema"] != expected_schema:
        fail("publication_" + kind + "_manifest_schema_invalid")
    work_root = logical_path_from_fshex(
        value["workRootFshex"],
        "publication_" + kind + "_work_root",
    )
    publish_root = logical_path_from_fshex(
        value["publishRootFshex"],
        "publication_" + kind + "_publish_root",
    )
    if (
        work_root != publication_anchor_path(publish_root) / "work"
        or not isinstance(value["pathRoles"], list)
        or value["pathRoleDigest"]
        != hashlib.sha256(
            canonical_json_bytes(value["pathRoles"])
        ).hexdigest()
    ):
        fail("publication_" + kind + "_mapping_authority_invalid")
    roles = value["pathRoles"]
    support_paths = value["supportPaths"]
    if (
        not isinstance(support_paths, list)
        or value["supportPathRoleDigest"]
        != hashlib.sha256(
            canonical_json_bytes(support_paths)
        ).hexdigest()
    ):
        fail("publication_" + kind + "_support_authority_invalid")
    previous_support = ""
    seen_support_physical: set[pathlib.Path] = set()
    seen_support_logical: set[pathlib.Path] = set()
    for ordinal, row in enumerate(support_paths):
        if not isinstance(row, dict) or set(row) != {
            "ordinal",
            "role",
            "selector",
            "prefixUtf8Hex",
            "physicalPathFshex",
            "logicalPathFshex",
        }:
            fail("publication_" + kind + "_support_path_shape_invalid")
        role = str(row["role"])
        physical_path = logical_path_from_fshex(
            row["physicalPathFshex"],
            "publication_" + kind + "_support_physical",
        )
        logical_path = logical_path_from_fshex(
            row["logicalPathFshex"],
            "publication_" + kind + "_support_logical",
        )
        try:
            relative = physical_path.relative_to(work_root)
        except ValueError:
            fail("publication_" + kind + "_support_outside_work_root")
        if (
            row["ordinal"] != ordinal
            or LABEL_RE.fullmatch(role) is None
            or role <= previous_support
            or row["selector"] != role
            or row["prefixUtf8Hex"] != ""
            or logical_path != publish_root / relative
            or physical_path in seen_support_physical
            or logical_path in seen_support_logical
        ):
            fail("publication_" + kind + "_support_projection_invalid")
        previous_support = role
        seen_support_physical.add(physical_path)
        seen_support_logical.add(logical_path)
    if kind == "argv":
        physical_values = value["physicalValues"]
        logical_values = value["logicalValues"]
        if (
            not isinstance(physical_values, list)
            or not isinstance(logical_values, list)
            or len(physical_values) != len(logical_values)
            or not all(isinstance(item, str) for item in physical_values)
            or not all(isinstance(item, str) for item in logical_values)
        ):
            fail("publication_argv_values_invalid")
        rebuilt = list(physical_values)
        seen: set[int] = set()
        seen_roles: set[str] = set()
        previous = -1
        for ordinal, row in enumerate(roles):
            if not isinstance(row, dict) or set(row) != {
                "ordinal",
                "role",
                "selector",
                "prefixUtf8Hex",
                "physicalPathFshex",
                "logicalPathFshex",
            }:
                fail("publication_argv_path_role_shape_invalid")
            try:
                index = int(str(row["selector"]))
                prefix = bytes.fromhex(str(row["prefixUtf8Hex"])).decode(
                    "utf-8", "strict"
                )
            except (ValueError, UnicodeError):
                fail("publication_argv_path_role_encoding_invalid")
            role = str(row["role"])
            if (
                row["ordinal"] != ordinal
                or LABEL_RE.fullmatch(role) is None
                or role in seen_roles
                or index <= previous
                or index < 0
                or index >= len(rebuilt)
                or index in seen
            ):
                fail("publication_argv_path_role_order_invalid")
            previous = index
            seen.add(index)
            seen_roles.add(role)
            physical_path = logical_path_from_fshex(
                row["physicalPathFshex"],
                "publication_argv_physical_path",
            )
            logical_path = logical_path_from_fshex(
                row["logicalPathFshex"],
                "publication_argv_logical_path",
            )
            try:
                relative = physical_path.relative_to(work_root)
            except ValueError:
                fail("publication_argv_physical_path_outside_work_root")
            if (
                logical_path != publish_root / relative
                or physical_values[index] != prefix + str(physical_path)
            ):
                fail("publication_argv_path_projection_invalid")
            rebuilt[index] = prefix + str(logical_path)
        work_text = str(work_root)
        if any(
            work_text in value
            for index, value in enumerate(physical_values)
            if index not in seen
        ) or any(work_text in current for current in logical_values):
            fail("publication_argv_untyped_path_residual")
        if rebuilt != logical_values:
            fail("publication_argv_logical_values_invalid")
        if (
            value["physicalDigest"] != command_argv_digest(physical_values)
            or value["logicalDigest"] != command_argv_digest(logical_values)
        ):
            fail("publication_argv_digest_invalid")
    elif kind == "env":
        physical_values = value["physicalValues"]
        logical_values = value["logicalValues"]
        if (
            not isinstance(physical_values, dict)
            or not isinstance(logical_values, dict)
            or set(physical_values) != set(logical_values)
            or not all(
                isinstance(key, str) and isinstance(current, str)
                for key, current in physical_values.items()
            )
            or not all(isinstance(current, str) for current in logical_values.values())
        ):
            fail("publication_env_values_invalid")
        rebuilt = dict(physical_values)
        seen_keys: set[str] = set()
        seen_roles: set[str] = set()
        previous = ""
        for ordinal, row in enumerate(roles):
            if not isinstance(row, dict) or set(row) != {
                "ordinal",
                "role",
                "selector",
                "prefixUtf8Hex",
                "physicalPathFshex",
                "logicalPathFshex",
            }:
                fail("publication_env_path_role_shape_invalid")
            key = str(row["selector"])
            role = str(row["role"])
            if (
                row["ordinal"] != ordinal
                or LABEL_RE.fullmatch(role) is None
                or role in seen_roles
                or key <= previous
                or key not in rebuilt
                or key in seen_keys
                or row["prefixUtf8Hex"] != ""
            ):
                fail("publication_env_path_role_order_invalid")
            previous = key
            seen_keys.add(key)
            seen_roles.add(role)
            physical_path = logical_path_from_fshex(
                row["physicalPathFshex"],
                "publication_env_physical_path",
            )
            logical_path = logical_path_from_fshex(
                row["logicalPathFshex"],
                "publication_env_logical_path",
            )
            try:
                relative = physical_path.relative_to(work_root)
            except ValueError:
                fail("publication_env_physical_path_outside_work_root")
            if (
                logical_path != publish_root / relative
                or physical_values[key] != str(physical_path)
            ):
                fail("publication_env_path_projection_invalid")
            rebuilt[key] = str(logical_path)
        work_text = str(work_root)
        if any(
            work_text in current
            for key, current in physical_values.items()
            if key not in seen_keys
        ) or any(work_text in current for current in logical_values.values()):
            fail("publication_env_untyped_path_residual")
        if rebuilt != logical_values:
            fail("publication_env_logical_values_invalid")
        if (
            value["physicalDigest"] != env_digest(physical_values)
            or value["logicalDigest"] != env_digest(logical_values)
        ):
            fail("publication_env_digest_invalid")
    else:
        fail("publication_channel_kind_invalid")
    return (
        value["physicalValues"],
        value["logicalValues"],
        str(value["physicalDigest"]),
        str(value["logicalDigest"]),
    )


def publication_support_path_map(
    value: object,
    *,
    kind: str,
) -> dict[str, tuple[pathlib.Path, pathlib.Path]]:
    validate_publication_channel_manifest(value, kind=kind)
    if not isinstance(value, dict):
        fail("publication_" + kind + "_manifest_shape_invalid")
    rows = value["supportPaths"]
    if not isinstance(rows, list):
        fail("publication_" + kind + "_support_authority_invalid")
    result: dict[str, tuple[pathlib.Path, pathlib.Path]] = {}
    for row in rows:
        if not isinstance(row, dict):
            fail("publication_" + kind + "_support_path_shape_invalid")
        role = str(row["role"])
        if role in result:
            fail("publication_" + kind + "_support_path_duplicate")
        result[role] = (
            logical_path_from_fshex(
                row["physicalPathFshex"],
                "publication_" + kind + "_support_physical",
            ),
            logical_path_from_fshex(
                row["logicalPathFshex"],
                "publication_" + kind + "_support_logical",
            ),
        )
    return result


def guard_launcher_env() -> dict[str, str]:
    return dict(GUARD_LAUNCHER_ENV)


def private_tree_digest(root: pathlib.Path) -> str:
    if pathlib.Path(os.path.realpath(root)) != root:
        fail("private_tree_root_not_canonical")
    entries: list[tuple[str, str, str, os.stat_result]] = []
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        info = directory_path.lstat()
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            fail("private_tree_directory_invalid")
        for name in directory_names:
            child_info = (directory_path / name).lstat()
            if (
                not stat.S_ISDIR(child_info.st_mode)
                or stat.S_ISLNK(child_info.st_mode)
            ):
                fail("private_tree_child_directory_invalid")
        entries.append(
            (
                os.path.relpath(directory_path, root).replace(os.sep, "/"),
                "directory",
                "",
                info,
            )
        )
        for name in file_names:
            path = directory_path / name
            state = stable_read(path, "private_tree_file", allow_empty=True)
            entries.append(
                (
                    os.path.relpath(path, root).replace(os.sep, "/"),
                    "regular",
                    state.sha256,
                    state.info,
                )
            )
    entries.sort(
        key=lambda item: (
            os.fsencode(item[0]),
            0 if item[1] == "directory" else 1,
        )
    )
    payload = bytearray(frame(b"cheng.guard.private_frozen_tree_closure"))
    payload.extend(struct.pack(">I", len(entries)))
    for relative, kind, digest, info in entries:
        payload.extend(frame(os.fsencode(relative)))
        payload.extend(frame(kind.encode("ascii")))
        payload.extend(
            struct.pack(
                ">QQQQQ",
                info.st_mode,
                info.st_nlink,
                info.st_uid,
                info.st_gid,
                info.st_size,
            )
        )
        payload.extend(bytes.fromhex(digest) if digest else b"\0" * 32)
    return hashlib.sha256(payload).hexdigest()


def tree_destination(
    root: pathlib.Path, logical_path: pathlib.Path
) -> pathlib.Path:
    text = str(logical_path)
    if (
        not logical_path.is_absolute()
        or text == "/"
        or pathlib.PurePosixPath(text).parts[0] != "/"
        or ".." in pathlib.PurePosixPath(text).parts
        or os.path.normpath(text) != text
    ):
        fail("lldb_logical_path_invalid")
    destination = root / text.lstrip("/")
    if not destination.is_relative_to(root):
        fail("lldb_tree_destination_escape")
    return destination


def ensure_private_directory(root: pathlib.Path, path: pathlib.Path) -> None:
    if not path.is_relative_to(root):
        fail("private_directory_escape")
    current = root
    for part in path.relative_to(root).parts:
        current = current / part
        try:
            os.mkdir(current, 0o700)
        except FileExistsError:
            info = current.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail("private_directory_shape_invalid")


def lldb_manifest_relative(value: object, label: str) -> pathlib.PurePosixPath:
    try:
        raw = bytes.fromhex(str(value))
        text = os.fsdecode(raw)
    except (ValueError, UnicodeError) as exc:
        fail(label + "_relative_path_invalid:" + str(exc))
    relative = pathlib.PurePosixPath(text)
    if relative.is_absolute() or ".." in relative.parts or text == "":
        fail(label + "_relative_path_invalid")
    return relative


def lldb_expected_member_specs(
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> dict[str, dict[str, object]]:
    closure = identity.get("lldbClosure")
    if not isinstance(closure, dict):
        fail("lldb_identity_closure_invalid")
    verify_lldb_origin_closure(closure)
    result: dict[str, dict[str, object]] = {}

    def add(
        logical: pathlib.Path,
        sha256: object,
        size: object,
        executable: bool,
    ) -> None:
        relative = str(logical).lstrip("/")
        require_sha(sha256, "lldb_expected_member")
        require_uint(size, "lldb_expected_member_size")
        if relative in result:
            fail("lldb_expected_member_duplicate")
        result[relative] = {
            "sha256": str(sha256),
            "size": int(size),
            "executable": executable,
        }

    lldb_tool = tools.get("xcode_lldb")
    if (
        not isinstance(lldb_tool, dict)
        or path_from_fshex(
            lldb_tool.get("pathFshex"), "xcode_lldb_binding"
        )
        != XCODE_LLDB
    ):
        fail("xcode_lldb_binding_invalid")
    add(
        XCODE_LLDB,
        lldb_tool.get("sha256"),
        lldb_tool.get("size"),
        True,
    )
    main_dylib = closure["mainDylib"]
    if (
        not isinstance(main_dylib, dict)
        or path_from_fshex(
            main_dylib.get("pathFshex"), "xcode_lldb_main_dylib"
        )
        != XCODE_LLDB_MAIN
    ):
        fail("xcode_lldb_main_dylib_binding_invalid")
    add(
        XCODE_LLDB_MAIN,
        main_dylib.get("sha256"),
        main_dylib.get("size"),
        True,
    )
    for key, logical_root in (
        ("swiftCompiler", XCODE_SWIFT_COMPILER),
        ("pythonFramework", XCODE_PYTHON39),
        ("lldbPython", XCODE_LLDB_PYTHON),
    ):
        manifest = closure.get(key)
        if (
            not isinstance(manifest, dict)
            or path_from_fshex(
                manifest.get("rootPathFshex"), "lldb_manifest_root"
            )
            != logical_root
        ):
            fail("lldb_manifest_root_invalid:" + key)
        files = manifest.get("files")
        if not isinstance(files, list):
            fail("lldb_manifest_files_invalid:" + key)
        for item in files:
            if not isinstance(item, dict):
                fail("lldb_manifest_file_invalid:" + key)
            relative = lldb_manifest_relative(
                item.get("relativePathFshex"), key
            )
            if str(relative) == ".":
                fail("lldb_manifest_file_root_invalid:" + key)
            add(
                logical_root / pathlib.Path(str(relative)),
                item.get("sha256"),
                item.get("size"),
                bool(item.get("executable")),
            )
    return result


def materialize_bound_file(
    *,
    root: pathlib.Path,
    logical_path: pathlib.Path,
    source: pathlib.Path,
    expected: dict[str, object],
    executable: bool,
    source_single_link: bool,
) -> FileState:
    source_state = verify_bound_file(
        source,
        expected,
        "lldb_materialization_origin",
        executable=executable,
        single_link=source_single_link,
    )
    destination = tree_destination(root, logical_path)
    ensure_private_directory(root, destination.parent)
    if destination.exists() or destination.is_symlink():
        fail("lldb_materialized_file_duplicate")
    copied = exclusive_write(
        destination,
        source_state.raw,
        0o555 if executable else 0o444,
    )
    if (
        copied.sha256 != source_state.sha256
        or copied.info.st_size != source_state.info.st_size
        or copied.info.st_nlink != 1
    ):
        fail("lldb_materialized_file_mismatch")
    return copied


def materialize_origin_tree(
    *,
    root: pathlib.Path,
    logical_root: pathlib.Path,
    manifest: dict[str, object],
) -> None:
    directories = manifest.get("directories")
    files = manifest.get("files")
    if not isinstance(directories, list) or not isinstance(files, list):
        fail("lldb_origin_tree_manifest_invalid")
    ordered_directories: list[pathlib.PurePosixPath] = []
    for item in directories:
        if not isinstance(item, dict):
            fail("lldb_origin_tree_directory_invalid")
        ordered_directories.append(
            lldb_manifest_relative(
                item.get("relativePathFshex"), "lldb_origin_tree_directory"
            )
        )
    ordered_directories.sort(
        key=lambda value: (len(value.parts), os.fsencode(str(value)))
    )
    for relative in ordered_directories:
        destination = tree_destination(root, logical_root)
        if str(relative) != ".":
            destination = destination / pathlib.Path(str(relative))
        ensure_private_directory(root, destination)
    for item in files:
        if not isinstance(item, dict):
            fail("lldb_origin_tree_file_invalid")
        relative = lldb_manifest_relative(
            item.get("relativePathFshex"), "lldb_origin_tree_file"
        )
        if str(relative) == ".":
            fail("lldb_origin_tree_file_root_invalid")
        materialize_bound_file(
            root=root,
            logical_path=logical_root / pathlib.Path(str(relative)),
            source=path_from_fshex(
                item.get("originPathFshex"), "lldb_origin_tree_file"
            ),
            expected=item,
            executable=bool(item.get("executable")),
            source_single_link=False,
        )


def private_regular_members(root: pathlib.Path) -> list[dict[str, object]]:
    private_tree_digest(root)
    members: list[dict[str, object]] = []
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        for name in file_names:
            state = stable_read(
                directory_path / name,
                "lldb_private_member",
                allow_empty=True,
            )
            if state.info.st_nlink != 1:
                fail("lldb_private_member_not_single_link")
            relative = os.path.relpath(state.path, root).replace(os.sep, "/")
            members.append(
                {
                    "relativePathFshex": os.fsencode(relative).hex(),
                    "sha256": state.sha256,
                    "size": state.info.st_size,
                    "executable": bool(state.info.st_mode & 0o111),
                    "identity": file_identity(state.info),
                }
            )
    members.sort(
        key=lambda item: bytes.fromhex(str(item["relativePathFshex"]))
    )
    return members


def lldb_member_order_digest(members: list[dict[str, object]]) -> str:
    payload = bytearray(frame(b"cheng.lldb.materialized_member_order"))
    payload.extend(struct.pack(">I", len(members)))
    for item in members:
        payload.extend(
            frame(bytes.fromhex(str(item["relativePathFshex"])))
        )
        payload.extend(bytes.fromhex(require_sha(item.get("sha256"), "member")))
        payload.extend(struct.pack(">Q", require_uint(item.get("size"), "member")))
        payload.append(1 if item.get("executable") is True else 0)
    return hashlib.sha256(payload).hexdigest()


def materialize_lldb_command_tree(
    *,
    label: str,
    debug_origin: pathlib.Path,
    source_process: dict[str, object],
    out: pathlib.Path,
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> tuple[pathlib.Path, FileState, pathlib.Path, str, FileState]:
    if LABEL_RE.fullmatch(label) is None:
        fail("lldb_materialization_label_invalid")
    closure = identity["lldbClosure"]
    if not isinstance(closure, dict):
        fail("lldb_materialization_closure_invalid")
    verify_lldb_origin_closure(closure)
    command_root = out / "lldb-commands" / label
    command_root.mkdir(mode=0o700, parents=True)
    tree = command_root / "tree"
    os.mkdir(tree, 0o700)
    command = materialize_bound_file(
        root=tree,
        logical_path=XCODE_LLDB,
        source=XCODE_LLDB,
        expected=tools["xcode_lldb"],
        executable=True,
        source_single_link=True,
    )
    materialize_bound_file(
        root=tree,
        logical_path=XCODE_LLDB_MAIN,
        source=XCODE_LLDB_MAIN,
        expected=closure["mainDylib"],
        executable=True,
        source_single_link=True,
    )
    for key, logical_root in (
        ("swiftCompiler", XCODE_SWIFT_COMPILER),
        ("pythonFramework", XCODE_PYTHON39),
        ("lldbPython", XCODE_LLDB_PYTHON),
    ):
        manifest = closure[key]
        if not isinstance(manifest, dict):
            fail("lldb_materialization_manifest_invalid")
        materialize_origin_tree(
            root=tree,
            logical_root=logical_root,
            manifest=manifest,
        )
    debug_origin_state = stable_read(debug_origin, "lldb_debug_origin")
    debug_destination = tree / "evidence" / "debug-object.o"
    ensure_private_directory(tree, debug_destination.parent)
    debug_object = exclusive_write(
        debug_destination, debug_origin_state.raw, 0o444
    )
    if (
        debug_object.sha256 != debug_origin_state.sha256
        or debug_object.info.st_size != debug_origin_state.info.st_size
        or debug_object.info.st_nlink != 1
    ):
        fail("lldb_debug_materialization_mismatch")
    for directory, _, _ in os.walk(tree, topdown=False):
        os.chmod(directory, 0o555)
    tree_digest = private_tree_digest(tree)
    members = private_regular_members(tree)
    receipt = {
        "schema": LLDB_CLOSURE_SCHEMA,
        "status": "FROZEN",
        "label": label,
        "treeRootFshex": os.fsencode(str(published_path(tree))).hex(),
        "treeSha256": tree_digest,
        "originClosureRaw32": hashlib.sha256(
            canonical_json_bytes(closure)
        ).hexdigest(),
        "sourceProcessGuardRaw32": require_sha(
            source_process["guard"]["sha256"], "lldb_source_guard"
        ),
        "command": path_pin(command),
        "debugObject": path_pin(debug_object),
        "memberCount": len(members),
        "memberOrderSha256": lldb_member_order_digest(members),
        "members": members,
    }
    receipt_state = exclusive_write(
        command_root / "closure.json",
        canonical_json_bytes(receipt),
        0o400,
    )
    validate_lldb_materialized_closure(
        receipt_state.path,
        identity=identity,
        tools=tools,
    )
    return command.path, debug_object, tree, tree_digest, receipt_state


def validate_lldb_materialized_closure(
    receipt_path: pathlib.Path,
    *,
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> tuple[dict[str, object], FileState, set[bytes]]:
    receipt, state = canonical_json_state(
        receipt_path, "lldb_materialized_closure"
    )
    if not isinstance(receipt, dict) or set(receipt) != {
        "schema",
        "status",
        "label",
        "treeRootFshex",
        "treeSha256",
        "originClosureRaw32",
        "sourceProcessGuardRaw32",
        "command",
        "debugObject",
        "memberCount",
        "memberOrderSha256",
        "members",
    }:
        fail("lldb_materialized_closure_shape_invalid")
    closure = identity.get("lldbClosure")
    if (
        receipt["schema"] != LLDB_CLOSURE_SCHEMA
        or receipt["status"] != "FROZEN"
        or LABEL_RE.fullmatch(str(receipt["label"])) is None
        or not isinstance(closure, dict)
        or receipt["originClosureRaw32"]
        != hashlib.sha256(canonical_json_bytes(closure)).hexdigest()
    ):
        fail("lldb_materialized_closure_header_invalid")
    require_sha(receipt["sourceProcessGuardRaw32"], "lldb_source_guard")
    tree = canonical_existing(
        path_from_fshex(receipt["treeRootFshex"], "lldb_private_tree"),
        "lldb_private_tree",
        directory=True,
    )
    tree_digest = private_tree_digest(tree)
    if tree_digest != require_sha(receipt["treeSha256"], "lldb_private_tree"):
        fail("lldb_materialized_tree_digest_mismatch")
    command = validate_pin(
        receipt["command"], "lldb_private_command", executable=True
    )
    debug_object = validate_pin(
        receipt["debugObject"], "lldb_private_debug_object"
    )
    if (
        command.path != tree_destination(tree, XCODE_LLDB)
        or debug_object.path != tree / "evidence" / "debug-object.o"
    ):
        fail("lldb_materialized_primary_paths_invalid")
    members = receipt["members"]
    if (
        not isinstance(members, list)
        or receipt["memberCount"] != len(members)
        or receipt["memberOrderSha256"] != lldb_member_order_digest(members)
    ):
        fail("lldb_materialized_member_header_invalid")
    observed = private_regular_members(tree)
    if members != observed:
        fail("lldb_materialized_members_drift")
    expected = lldb_expected_member_specs(identity, tools)
    expected["evidence/debug-object.o"] = {
        "sha256": debug_object.sha256,
        "size": debug_object.info.st_size,
        "executable": False,
    }
    actual_paths: set[bytes] = set()
    if len(expected) != len(members):
        fail("lldb_materialized_member_count_invalid")
    for item in members:
        relative_raw = bytes.fromhex(str(item["relativePathFshex"]))
        if relative_raw in actual_paths:
            fail("lldb_materialized_member_duplicate")
        actual_paths.add(relative_raw)
        relative = os.fsdecode(relative_raw)
        spec = expected.get(relative)
        if (
            spec is None
            or item["sha256"] != spec["sha256"]
            or item["size"] != spec["size"]
            or item["executable"] is not spec["executable"]
        ):
            fail("lldb_materialized_member_not_exact")
    if set(expected) != {os.fsdecode(value) for value in actual_paths}:
        fail("lldb_materialized_expected_member_missing")
    return receipt, state, {
        os.fsencode(str(tree / os.fsdecode(value))) for value in actual_paths
    }


def materialize_frozen_tree(
    root: pathlib.Path,
    out: pathlib.Path,
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> tuple[pathlib.Path, dict[str, pathlib.Path], FileState]:
    tree = out / "frozen-command-tree"
    os.mkdir(tree, 0o700)
    repo = tree / "repo"
    os.mkdir(repo, 0o700)
    source_receipts: list[dict[str, object]] = []
    for member in identity["sourceMembers"]:
        relative = os.fsdecode(bytes.fromhex(str(member["relativePathFshex"])))
        if member["state"] == "tracked_deleted":
            source_receipts.append(
                {
                    "relativePathFshex": member["relativePathFshex"],
                    "state": "tracked_deleted",
                }
            )
            continue
        source = root / relative
        destination = repo / relative
        copied = exclusive_copy(
            source,
            destination,
            executable=bool(member["executable"]),
            expected_sha256=str(member["sha256"]),
            expected_size=int(member["size"]),
        )
        source_receipts.append(
            {
                "relativePathFshex": member["relativePathFshex"],
                "state": member["state"],
                "originSha256": member["sha256"],
                "originSize": member["size"],
                "snapshotSha256": copied.sha256,
                "snapshotSize": copied.info.st_size,
                "snapshotPathFshex":
                    os.fsencode(str(published_path(copied.path))).hex(),
            }
        )
    oracle_member = source_member_map(identity["sourceMembers"])[
        PERFORMANCE_ORACLE
    ]
    oracle_origin = root / PERFORMANCE_ORACLE
    oracle_state = stable_read(oracle_origin, "performance_oracle")
    if (
        oracle_state.sha256 != oracle_member["sha256"]
        or oracle_state.info.st_size != oracle_member["size"]
    ):
        fail("performance_oracle_origin_drift")
    include = b"#include <stdint.h>"
    if oracle_state.raw.count(include) != 1:
        fail("performance_oracle_include_shape_invalid")
    derived_raw = oracle_state.raw.replace(include, b"typedef int int32_t;")
    derived_dir = tree / "derived"
    os.mkdir(derived_dir, 0o700)
    derived_state = exclusive_write(
        derived_dir / "regalloc_gate_perf_oracle.freestanding.c",
        derived_raw,
        0o444,
    )
    bin_dir = tree / "bin"
    os.mkdir(bin_dir, 0o700)
    commands: dict[str, pathlib.Path] = {}
    command_receipts: list[dict[str, object]] = []
    for role, name in (
        ("official_driver", "current-driver"),
        ("stage3", "stage3"),
        ("clang", "clang"),
        ("llvm_objdump", "llvm-objdump"),
    ):
        binding = tools[role]
        origin = path_from_fshex(binding["pathFshex"], role)
        copied = exclusive_copy(
            origin,
            bin_dir / name,
            executable=True,
            expected_sha256=str(binding["sha256"]),
            expected_size=int(binding["size"]),
        )
        commands[role] = copied.path
        command_receipts.append(
            {
                "role": role,
                "originPathFshex": binding["pathFshex"],
                "originSha256": binding["sha256"],
                "originSize": binding["size"],
                "originIdentity": binding["identity"],
                "snapshotPathFshex":
                    os.fsencode(str(published_path(copied.path))).hex(),
                "snapshotSha256": copied.sha256,
                "snapshotSize": copied.info.st_size,
                "snapshotIdentity": file_identity(copied.info),
            }
        )
    commands["clang_source"] = derived_state.path
    # Freeze bottom-up. Files already have 0444/0555.
    directories = [
        pathlib.Path(directory)
        for directory, _, _ in os.walk(tree, topdown=False)
    ]
    for directory in directories:
        os.chmod(directory, 0o555)
    digest = private_tree_digest(tree)
    receipt = {
        "schema": SNAPSHOT_SCHEMA,
        "status": "FROZEN",
        "rootFshex": os.fsencode(str(published_path(tree))).hex(),
        "treeSha256": digest,
        "sourceClosureSha256": identity["sourceClosure"]["sha256"],
        "sourceClosureCid": identity["sourceClosureCid"],
        "sourceMemberCount": len(source_receipts),
        "sourceMembers": source_receipts,
        "commands": command_receipts,
        "derivedPerformanceOracle": {
            "originPathFshex": os.fsencode(str(oracle_origin)).hex(),
            "originSha256": oracle_state.sha256,
            "originSize": oracle_state.info.st_size,
            "snapshotPathFshex":
                os.fsencode(str(published_path(derived_state.path))).hex(),
            "snapshotSha256": derived_state.sha256,
            "snapshotSize": derived_state.info.st_size,
            "transform": "replace_unique_stdint_include_with_int32_typedef",
        },
    }
    receipt_path = out / "source-snapshot.json"
    receipt_state = exclusive_write(
        receipt_path, canonical_json_bytes(receipt), 0o400
    )
    return tree, commands, receipt_state


def parse_kv(path: pathlib.Path, label: str) -> tuple[dict[str, str], FileState]:
    state = stable_read(path, label, allow_empty=True)
    try:
        lines = state.raw.decode("utf-8", "strict").splitlines()
    except UnicodeError as exc:
        fail(f"{label}_utf8_invalid:{exc}")
    rows: dict[str, str] = {}
    for line in lines:
        if "=" not in line:
            fail(label + "_row_invalid")
        key, value = line.split("=", 1)
        if key in rows:
            fail(label + "_duplicate_key:" + key)
        rows[key] = value
    return rows, state


def tracked_output_rows(
    report: dict[str, str], count: int
) -> list[dict[str, str]]:
    result: list[dict[str, str]] = []
    for index in range(count):
        prefix = f"tracked_output_{index}_"
        result.append(
            {
                key[len(prefix) :]: value
                for key, value in report.items()
                if key.startswith(prefix)
            }
        )
    return result


def validate_guard_completion_rows(rows: dict[str, str]) -> None:
    expected = {
