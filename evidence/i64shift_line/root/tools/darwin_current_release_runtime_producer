    if len(result) < 2:
        fail("resource_trace_sample_count_invalid")
    return result


def object_metrics_from_dumps(
    object_state: FileState,
    disassembly: bytes,
) -> tuple[int, int, int]:
    instruction_re = re.compile(
        r"^\s*([0-9a-f]+):\s+[0-9a-f]{8}\s+([A-Za-z0-9.]+)\s*(.*)$"
    )
    function_re = re.compile(r"^\s*[0-9a-f]+\s+<[^>]+>:\s*$")
    stack_re = re.compile(
        r"\[sp(?:,\s*#(?P<offset>-?(?:0x[0-9a-f]+|[0-9]+)))?\]"
        r"(?P<pre>!)?(?:,\s*#(?P<post>-?(?:0x[0-9a-f]+|[0-9]+)))?"
    )
    any_stack_re = re.compile(
        r"\[sp(?:,\s*[^\]]+)?\](?:!)?"
        r"(?:,\s*#-?(?:0x[0-9a-f]+|[0-9]+))?"
    )
    save_ops = {"str", "stur", "stp", "stnp"}
    restore_ops = {"ldr", "ldur", "ldp", "ldnp"}
    callee_saved = set(range(19, 31))
    instructions: list[dict[str, object]] = []
    function_ordinal = -1
    for raw in disassembly.decode("utf-8", "strict").splitlines():
        if function_re.match(raw):
            function_ordinal += 1
            continue
        match = instruction_re.match(raw)
        if match is None:
            continue
        if function_ordinal < 0:
            function_ordinal = 0
        instructions.append(
            {
                "function": function_ordinal,
                "mnemonic": match.group(2).lower(),
                "operands": match.group(3).strip(),
            }
        )

    def stack_memory(item: dict[str, object]) -> re.Match[str] | None:
        mnemonic = str(item["mnemonic"])
        if re.fullmatch(r"(?:ld|st)[a-z0-9.]*", mnemonic) is None:
            return None
        return any_stack_re.search(str(item["operands"]))

    def frame_stack_memory(item: dict[str, object]) -> re.Match[str] | None:
        if item["mnemonic"] not in save_ops | restore_ops:
            return None
        return stack_re.search(str(item["operands"]))

    def saved_x_registers(
        item: dict[str, object], allowed_ops: set[str]
    ) -> list[int] | None:
        memory = frame_stack_memory(item)
        if item["mnemonic"] not in allowed_ops or memory is None:
            return None
        prefix = str(item["operands"])[: memory.start()]
        tokens = re.findall(r"\b([wx])([0-9]|[12][0-9]|30)\b", prefix)
        if not tokens or any(kind != "x" for kind, _ in tokens):
            return None
        registers = [int(number) for _, number in tokens]
        required = 2 if item["mnemonic"] in {
            "stp",
            "stnp",
            "ldp",
            "ldnp",
        } else 1
        if len(registers) != required or not set(registers) <= callee_saved:
            return None
        return registers

    def memory_slots(
        item: dict[str, object],
        registers: list[int],
        sp_before: int,
        *,
        reverse: bool = False,
    ) -> tuple[int, set[tuple[int, int]]] | None:
        memory = frame_stack_memory(item)
        if memory is None:
            return None
        offset = int(memory.group("offset") or "0", 0)
        pre = memory.group("pre") is not None
        post_text = memory.group("post")
        if pre and post_text is not None:
            return None
        post = int(post_text or "0", 0)
        if reverse:
            after = sp_before
            before = after - (offset if pre else post)
            access = before + offset
            return before, {
                (register, access + ordinal * 8)
                for ordinal, register in enumerate(registers)
            }
        before = sp_before
        access = before + offset
        after = access if pre else before + post
        return after, {
            (register, access + ordinal * 8)
            for ordinal, register in enumerate(registers)
        }

    def prologue_nonmemory(item: dict[str, object]) -> bool:
        mnemonic = str(item["mnemonic"])
        operands = str(item["operands"])
        return (
            mnemonic in {"bti", "paciasp", "pacibsp", "nop"}
            or (
                mnemonic == "sub"
                and re.match(r"^sp,\s*sp,\s*#", operands) is not None
            )
            or (
                mnemonic in {"mov", "add"}
                and re.match(r"^x29,\s*sp(?:,|$)", operands) is not None
            )
        )

    def epilogue_nonmemory(item: dict[str, object]) -> bool:
        mnemonic = str(item["mnemonic"])
        operands = str(item["operands"])
        return (
            mnemonic in {"autiasp", "autibsp", "nop"}
            or (
                mnemonic == "add"
                and re.match(r"^sp,\s*sp,\s*#", operands) is not None
            )
            or (
                mnemonic == "mov"
                and re.match(r"^sp,\s*x29$", operands) is not None
            )
        )

    frame_indices: set[int] = set()
    by_function: dict[int, list[int]] = {}
    for index, item in enumerate(instructions):
        by_function.setdefault(int(item["function"]), []).append(index)
    for indices in by_function.values():
        prologue_saves: list[tuple[int, set[tuple[int, int]]]] = []
        prologue_sp = 0
        for index in indices:
            item = instructions[index]
            registers = saved_x_registers(item, save_ops)
            if registers is not None:
                result = memory_slots(item, registers, prologue_sp)
                if result is None:
                    break
                prologue_sp, bindings = result
                prologue_saves.append((index, bindings))
                continue
            if prologue_nonmemory(item):
                match = re.match(
                    r"^(sub|add)\s+sp,\s*sp,\s*#"
                    r"(-?(?:0x[0-9a-f]+|[0-9]+))$",
                    str(item["mnemonic"]) + " " + str(item["operands"]),
                )
                if match is not None:
                    amount = int(match.group(2), 0)
                    prologue_sp += (
                        -amount if match.group(1) == "sub" else amount
                    )
                continue
            break
        return_indices = [
            index
            for index in indices
            if instructions[index]["mnemonic"] == "ret"
        ]
        restores_by_return: list[set[tuple[int, int]]] = []
        restore_events: list[tuple[int, set[tuple[int, int]]]] = []
        positions = {
            index: position for position, index in enumerate(indices)
        }
        for return_index in return_indices:
            restored: set[tuple[int, int]] = set()
            local: list[tuple[int, set[tuple[int, int]]]] = []
            epilogue_sp = 0
            position = positions[return_index] - 1
            while position >= 0:
                index = indices[position]
                item = instructions[index]
                registers = saved_x_registers(item, restore_ops)
                if registers is not None:
                    result = memory_slots(
                        item, registers, epilogue_sp, reverse=True
                    )
                    if result is None:
                        break
                    epilogue_sp, bindings = result
                    restored.update(bindings)
                    local.append((index, bindings))
                    position -= 1
                    continue
                if epilogue_nonmemory(item):
                    match = re.match(
                        r"^add\s+sp,\s*sp,\s*#"
                        r"(-?(?:0x[0-9a-f]+|[0-9]+))$",
                        str(item["mnemonic"]) + " " + str(item["operands"]),
                    )
                    if match is not None:
                        epilogue_sp -= int(match.group(1), 0)
                    elif item["mnemonic"] == "mov":
                        break
                    position -= 1
                    continue
                break
            restores_by_return.append(restored)
            restore_events.extend(local)
        restored_everywhere = (
            set.intersection(*restores_by_return)
            if restores_by_return
            else set()
        )
        protected = (
            set().union(*(bindings for _, bindings in prologue_saves))
            & restored_everywhere
        )
        frame_indices.update(
            index
            for index, bindings in prologue_saves + restore_events
            if bindings <= protected
        )
    instruction_count = len(instructions)
    if instruction_count <= 0:
        fail("object_instruction_count_zero")
    spill_count = sum(
        1
        for index, item in enumerate(instructions)
        if stack_memory(item) is not None and index not in frame_indices
    )
    text_sections = [
        section
        for section in mach_o_sections(object_state, "object_metrics")
        if section["segment"] == "__TEXT"
        and section["section"] == "__text"
    ]
    if len(text_sections) != 1:
        fail("text_section_count_invalid")
    text_size = int(text_sections[0]["size"])
    if text_size <= 0:
        fail("text_section_size_missing")
    return text_size, instruction_count, spill_count


def produce_object_metrics(
    *,
    label: str,
    object_state: FileState,
    root: pathlib.Path,
    out: pathlib.Path,
    tree: pathlib.Path,
    tree_digest: str,
    commands: dict[str, pathlib.Path],
    tools: dict[str, dict[str, object]],
    output: pathlib.Path,
) -> FileState:
    objdump = run_guarded(
        label=label + "_objdump",
        root=root,
        out=out,
        tools=tools,
        argv=(str(commands["llvm_objdump"]), "-dr", str(object_state.path)),
        env={
            "HOME": "/nonexistent",
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin",
            "TZ": "UTC",
        },
        argv_path_roles=(
            ArgvPathRole(
                0,
                "command",
                "",
                commands["llvm_objdump"],
            ),
            ArgvPathRole(2, "object", "", object_state.path),
        ),
        command_sha256=str(tools["llvm_objdump"]["sha256"]),
        command_mode="private_frozen_tree_direct",
        frozen_tree=tree,
        frozen_tree_sha256=tree_digest,
        require_stdout_empty=False,
        require_stderr_empty=True,
    )
    text_bytes, instruction_count, spill_count = object_metrics_from_dumps(
        object_state,
        process_state(objdump, "stdout", "objdump_stdout").raw,
    )
    lines = [
        "schema=regalloc_object_metrics",
        "object_sha256=" + object_state.sha256,
        "text_bytes=" + str(text_bytes),
        "instruction_count=" + str(instruction_count),
        "spill_reload_instruction_count=" + str(spill_count),
        "spill_density_ppm="
        + str(spill_count * 1_000_000 // instruction_count),
    ]
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    return exclusive_write(output, ("\n".join(lines) + "\n").encode(), 0o400)


def make_raw_manifest(
    release: dict[str, Any],
    path: pathlib.Path,
    target: str,
    backend: str,
    artifacts: dict[str, FileState],
) -> FileState:
    roles = tuple(release["LEG_ROLES"])
    if set(artifacts) != set(roles):
        fail("formal_leg_artifact_role_set_invalid")
    lines = [
        "schema=cheng.backend2.current_source_raw_manifest",
        "status=PASS",
        "lock_kind=release_target_backend",
        "target=" + target,
        "backend=" + backend,
        "artifact_count=" + str(len(roles)),
    ]
    for index, role in enumerate(roles):
        state = artifacts[role]
        prefix = f"artifact.{index}."
        lines.extend(
            (
                prefix + "role=" + role,
                prefix + "path_fshex="
                + os.fsencode(str(published_path(state.path))).hex(),
                prefix + "sha256=" + state.sha256,
                prefix + "device=" + str(state.info.st_dev),
                prefix + "inode=" + str(state.info.st_ino),
                prefix + "size=" + str(state.info.st_size),
                prefix + "mode=" + format(state.info.st_mode, "o"),
                prefix + "mtime_ns=" + str(state.info.st_mtime_ns),
                prefix + "ctime_ns=" + str(state.info.st_ctime_ns),
            )
        )
    return exclusive_write(
        path,
        release_render(release, lines, "manifest_payload_sha256"),
        0o400,
    )


def make_formal_leg(
    *,
    release: dict[str, Any],
    evidence_root: pathlib.Path,
    output_root: pathlib.Path,
    binding: dict[str, str],
    backend: str,
    compile_process: dict[str, object],
    compile_report_path: pathlib.Path,
    run_process: dict[str, object],
    run_executable: FileState,
    run_publication: FileState,
    debug_process: dict[str, object],
    debug_object: FileState,
    debug_publication: FileState,
    orc_process: dict[str, object],
    orc_executable: FileState,
    orc_publication: FileState,
    executable_compile_process: dict[str, object],
    stage3_orc_proof: dict[str, str],
    exec_cases_master: FileState,
    exec_stdout_master: FileState,
    exec_stderr_master: FileState,
    exec_anchor_process: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> tuple[FileState, dict[str, FileState], dict[str, str]]:
    target = TARGET
    leg_root = output_root / "legs" / backend
    leg_root.mkdir(mode=0o700, parents=True)
    object_state = validate_pin(
        compile_process["tracked"][0]["artifact"],
        "formal_object",
    )
    body_count, body_raw32, actions, sections = compile_projection(
        compile_report_path, object_state, backend
    )
    identity = {
        "driverRole": "production",
        "targetTriple": target,
        "architecture": "arm64",
        "backend": backend,
        "sourceBundleRaw32": binding["snapshot_manifest_sha256"],
        "driverRaw32": binding["official_driver_sha256"],
        "executionRaw32": binding["seven_stage_execution_raw32"],
        "bodyIrRaw32": body_raw32,
    }
    target_action = exclusive_write(
        leg_root / "target-action.json",
        canonical_json_bytes(
            {
                "schema": "cheng_current_target_regalloc_action",
                "status": "COMPLETE",
                **identity,
                "actions": actions,
            }
        ),
        0o400,
    )
    target_fragment = exclusive_write(
        leg_root / "target-fragment.json",
        canonical_json_bytes(
            {
                "schema": "cheng_current_target_object_fragment",
                "status": "COMPLETE",
                **identity,
                "actionRaw32": target_action.sha256,
                "objectRaw32": object_state.sha256,
                "sections": sections,
            }
        ),
        0o400,
    )
    action_origin = verify_bound_file(
        path_from_fshex(
            tools["action_ledger_origin"]["pathFshex"], "action_origin"
        ),
        tools["action_ledger_origin"],
        "action_origin",
    )
    fragment_origin = verify_bound_file(
        path_from_fshex(
            tools["fragment_snapshot_origin"]["pathFshex"],
            "fragment_origin",
        ),
        tools["fragment_snapshot_origin"],
        "fragment_origin",
    )
    action_ledger = copy_state(
        action_origin, leg_root / "action-ledger.raw"
    )
    fragment_snapshot = copy_state(
        fragment_origin, leg_root / "fragment-snapshot.raw"
    )
    if (
        action_ledger.sha256 != binding["action_ledger_sha256"]
        or fragment_snapshot.sha256 != binding["fragment_snapshot_sha256"]
    ):
        fail("formal_action_fragment_binding_mismatch")
    run_stdout_raw = process_state(
        run_process, "stdout", "formal_run_stdout_raw"
    ).raw
    run_stderr_raw = process_state(
        run_process, "stderr", "formal_run_stderr_raw"
    ).raw
    run_status = exclusive_write(
        leg_root / "run-status.bin",
        b"CRSTATUS" + (0).to_bytes(4, "big", signed=True) * 2,
        0o400,
    )
    run_stdout = exclusive_write(
        leg_root / "run-stdout.bin",
        framed_stream(b"CROUTPUT", run_stdout_raw),
        0o400,
    )
    run_stderr = exclusive_write(
        leg_root / "run-stderr.bin",
        framed_stream(b"CRERROR!", run_stderr_raw),
        0o400,
    )
    debug_dump = copy_state(
        process_state(debug_process, "stdout", "formal_debug_dump"),
        leg_root / "debug-dump.txt",
    )
    debug_sections = mach_o_sections(debug_object, "formal_debug_object")
    debug_section_count = sum(
        1
        for section in debug_sections
        if str(section["segment"]) == "__DWARF"
        or str(section["section"]).startswith("__debug_")
    )
    if debug_section_count <= 0:
        fail("formal_debug_section_count_zero")
    orc_stdout = copy_state(
        process_state(orc_process, "stdout", "formal_orc_stdout"),
        leg_root / "orc-stdout.bin",
    )
    orc_stderr = copy_state(
        process_state(orc_process, "stderr", "formal_orc_stderr"),
        leg_root / "orc-stderr.bin",
    )
    if orc_stdout.raw != orc_expected_stdout() or orc_stderr.raw:
        fail("formal_orc_output_invalid")
    orc_events = exclusive_write(
        leg_root / "orc-events.json",
        canonical_json_bytes(
            {
                "schema": "cheng_current_orc_event_log",
                "status": "COMPLETE",
                **{
                    key: value
                    for key, value in identity.items()
                    if key != "bodyIrRaw32"
                },
                "actionRaw32": target_action.sha256,
                "fragmentRaw32": target_fragment.sha256,
                "objectRaw32": object_state.sha256,
                "executableRaw32": run_executable.sha256,
                "events": [
                    {
                        "ordinal": 0,
                        "kind": "compile",
                        "guardRaw32": compile_process["guard"]["sha256"],
                    },
                    {
                        "ordinal": 1,
                        "kind": "debug_object_publication",
                        "publicationRaw32": debug_publication.sha256,
                        "publicationPathFshex": os.fsencode(
                            str(published_path(debug_publication.path))
                        ).hex(),
                    },
                    {
                        "ordinal": 2,
                        "kind": "executable_compile",
                        "guardRaw32":
                        executable_compile_process["guard"]["sha256"],
                    },
                    {
                        "ordinal": 3,
                        "kind": "native_run",
                        "guardRaw32": run_process["guard"]["sha256"],
                        "publicationRaw32": run_publication.sha256,
                    },
                    {
                        "ordinal": 4,
                        "kind": "atomic_orc_run",
                        "guardRaw32": orc_process["guard"]["sha256"],
                        "publicationRaw32": orc_publication.sha256,
                        "alloc": 5001,
                        "free": 5001,
                        "live": 0,
                    },
                    {
                        "ordinal": 5,
                        "kind": "stage3_atomic_orc_oracle",
                        **stage3_orc_proof,
                    },
                ],
            }
        ),
        0o400,
    )
    exec_cases = copy_state(
        exec_cases_master, leg_root / "exec-diff-cases.json"
    )
    exec_stdout = copy_state(
        exec_stdout_master, leg_root / "exec-diff-stdout.bin"
    )
    exec_stderr = copy_state(
        exec_stderr_master, leg_root / "exec-diff-stderr.bin"
    )
    exec_case_count = len(
        json.loads(exec_cases.raw.decode("utf-8", "strict"))["cases"]
    )
    compile_report = exclusive_write(
        leg_root / "compile-report.kv",
        release_render(
            release,
            [
                "schema=cheng.backend2.current_source_compile_report",
                "status=PASS",
                "driver_role=production",
                "target=" + target,
                "backend=" + backend,
                "body_ir_entry_count=" + str(body_count),
                "fixed_template_count=0",
                "action_ledger_sha256=" + binding["action_ledger_sha256"],
                "fragment_snapshot_sha256="
                + binding["fragment_snapshot_sha256"],
                "object_sha256=" + object_state.sha256,
                "target_action_sha256=" + target_action.sha256,
                "target_fragment_sha256=" + target_fragment.sha256,
            ],
            "report_payload_sha256",
        ),
        0o400,
    )
    debug_report = exclusive_write(
        leg_root / "debug-report.kv",
        release_render(
            release,
            [
                "schema=cheng.backend2.current_source_debug_report",
                "status=PASS",
                "target=" + target,
                "backend=" + backend,
                "debug_section_count=" + str(debug_section_count),
                "debug_object_sha256=" + debug_object.sha256,
                "debug_dump_sha256=" + debug_dump.sha256,
            ],
            "report_payload_sha256",
        ),
        0o400,
    )
    orc_report = exclusive_write(
        leg_root / "orc-report.kv",
        release_render(
            release,
            [
                "schema=cheng.backend2.current_source_orc_report",
                "status=PASS",
                "target=" + target,
                "backend=" + backend,
                "iterations=5000",
                "alloc=5001",
                "free=5001",
                "live=0",
                "stdout_sha256=" + orc_stdout.sha256,
                "stderr_sha256=" + orc_stderr.sha256,
                "orc_events_sha256=" + orc_events.sha256,
            ],
            "report_payload_sha256",
        ),
        0o400,
    )
    exec_report = exclusive_write(
        leg_root / "exec-diff-report.kv",
        release_render(
            release,
            [
                "schema=cheng.backend2.current_source_exec_diff_leg_report",
                "status=PASS",
                "target=" + target,
                "backend=" + backend,
                "case_count=" + str(exec_case_count),
                "miscompile_count=0",
                "cases_sha256=" + exec_cases.sha256,
                "stdout_sha256=" + exec_stdout.sha256,
                "stderr_sha256=" + exec_stderr.sha256,
            ],
            "report_payload_sha256",
        ),
        0o400,
    )
    artifacts = {
        "object": object_state,
        "compile_report": compile_report,
        "target_action": target_action,
        "target_fragment": target_fragment,
        "action_ledger": action_ledger,
        "fragment_snapshot": fragment_snapshot,
        "compile_guard": process_state(
            compile_process, "guard", "formal_compile_guard"
        ),
        "compile_argv_manifest": process_state(
            compile_process, "argv", "formal_compile_argv"
        ),
        "compile_env_manifest": process_state(
            compile_process, "env", "formal_compile_env"
        ),
        "compile_stdout": process_state(
            compile_process, "stdout", "formal_compile_stdout"
        ),
        "compile_stderr": process_state(
            compile_process, "stderr", "formal_compile_stderr"
        ),
        "run_executable": run_executable,
        "run_status": run_status,
        "run_stdout": run_stdout,
        "run_stderr": run_stderr,
        "run_guard": process_state(run_process, "guard", "formal_run_guard"),
        "run_argv_manifest": process_state(
            run_process, "argv", "formal_run_argv"
        ),
        "run_env_manifest": process_state(
            run_process, "env", "formal_run_env"
        ),
        "debug_object": debug_object,
        "debug_dump": debug_dump,
        "debug_report": debug_report,
        "debug_guard": process_state(
            debug_process, "guard", "formal_debug_guard"
        ),
        "debug_argv_manifest": process_state(
            debug_process, "argv", "formal_debug_argv"
        ),
        "debug_env_manifest": process_state(
            debug_process, "env", "formal_debug_env"
        ),
        "orc_executable": orc_executable,
        "orc_events": orc_events,
        "orc_stdout": orc_stdout,
        "orc_stderr": orc_stderr,
        "orc_report": orc_report,
        "orc_guard": process_state(orc_process, "guard", "formal_orc_guard"),
        "orc_argv_manifest": process_state(
            orc_process, "argv", "formal_orc_argv"
        ),
        "orc_env_manifest": process_state(
            orc_process, "env", "formal_orc_env"
        ),
        "exec_diff_report": exec_report,
        "exec_diff_cases": exec_cases,
        "exec_diff_guard": process_state(
            exec_anchor_process, "guard", "formal_exec_guard"
        ),
        "exec_diff_argv_manifest": process_state(
            exec_anchor_process, "argv", "formal_exec_argv"
        ),
        "exec_diff_env_manifest": process_state(
            exec_anchor_process, "env", "formal_exec_env"
        ),
        "exec_diff_stdout": exec_stdout,
        "exec_diff_stderr": exec_stderr,
    }
    manifest = make_raw_manifest(
        release,
        leg_root / "raw-manifest.kv",
        target,
        backend,
        artifacts,
    )
    receipt_lines = [
        "schema=cheng.backend2.current_source_release_leg",
        "status=PASS",
        "driver_role=production",
        "target=" + target,
        "backend=" + backend,
        "host_os=darwin",
        "host_machine=arm64",
        "native_execution=true",
        "emulation=false",
        "snapshot_manifest_sha256=" + binding["snapshot_manifest_sha256"],
        "source_closure_cid=" + binding["source_closure_cid"],
        "official_driver_sha256=" + binding["official_driver_sha256"],
        "backend_epoch_sha256=" + binding["backend_epoch_sha256"],
        "jobs_sha256=" + binding["jobs_sha256"],
        "action_ledger_sha256=" + binding["action_ledger_sha256"],
        "fragment_snapshot_sha256=" + binding["fragment_snapshot_sha256"],
        "regalloc_receipt_sha256=" + binding["regalloc_receipt_sha256"],
        "fixed_object_sha256=" + binding["fixed_object_sha256"],
        "fixed_template_count=0",
        "run_rc=0",
        "debug_status=proved",
        "orc_live=0",
        "exec_diff_miscompile_count=0",
        "body_ir_entry_count=" + str(body_count),
        "debug_section_count=" + str(debug_section_count),
        "orc_iterations=5000",
        "orc_alloc=5001",
        "orc_free=5001",
        "exec_diff_case_count=" + str(exec_case_count),
        "exec_diff_report_sha256=" + exec_report.sha256,
        "exec_diff_cases_sha256=" + exec_cases.sha256,
        "target_action_sha256=" + target_action.sha256,
        "target_fragment_sha256=" + target_fragment.sha256,
        "orc_events_sha256=" + orc_events.sha256,
        "source_bundle_raw32=" + binding["snapshot_manifest_sha256"],
        "execution_raw32=" + binding["seven_stage_execution_raw32"],
        "body_ir_raw32=" + body_raw32,
        "raw_manifest_path=" + str(published_path(manifest.path)),
        "raw_manifest_sha256=" + manifest.sha256,
    ]
    receipt = exclusive_write(
        leg_root / "receipt.kv",
        release_render(release, receipt_lines, "receipt_payload_sha256"),
        0o400,
    )
    try:
        validated, validated_artifacts, rows = release["validate_leg"](
            receipt.path,
            target,
            backend,
            binding,
            evidence_root,
        )
    except Exception as exc:
        fail("formal_leg_validation_failed:" + backend + ":" + repr(exc))
    if validated.sha256 != receipt.sha256:
        fail("formal_leg_validation_identity_mismatch")
    return receipt, validated_artifacts, rows


def produce_exec_diff(
    *,
    root: pathlib.Path,
    out: pathlib.Path,
    tree: pathlib.Path,
    tree_digest: str,
    commands: dict[str, pathlib.Path],
    tools: dict[str, dict[str, object]],
    identity: dict[str, object],
) -> tuple[FileState, FileState, FileState, dict[str, dict[str, object]]]:
    case_rows: list[dict[str, object]] = []
    aggregate_stdout = bytearray()
    aggregate_stderr = bytearray()
    anchors: dict[str, dict[str, object]] = {}
    member_map = source_member_map(identity["sourceMembers"])
    lane_contract = (
        ("primary", "official_driver", "primary"),
        ("backend2", "official_driver", "backend2"),
        ("stage3", "stage3", "backend2"),
    )
    for ordinal, relative in enumerate(identity["execDiffCases"]):
        lane_rows: dict[str, object] = {}
        lane_outputs: dict[str, tuple[bytes, bytes]] = {}
        for lane, driver_role, backend in lane_contract:
            compile_label = f"diff_{ordinal:03d}_{lane}_compile"
            compile_process, executable, report = compile_source(
                label=compile_label,
                driver_role=driver_role,
                source_relative=str(relative),
                emit="exe",
                jobs=1,
                root=root,
                out=out,
                tree=tree,
                tree_digest=tree_digest,
                commands=commands,
                tools=tools,
                link_providers=True,
                backend=backend,
            )
            published, published_root, published_digest, publication = (
                publish_executable(
                    label=f"diff_{ordinal:03d}_{lane}",
                    origin=executable,
                    source_process=compile_process,
                    out=out,
                )
            )
            run_process = run_published(
                label=f"diff_{ordinal:03d}_{lane}_run",
                command=published,
                publication_root=published_root,
                publication_digest=published_digest,
                root=root,
                out=out,
                tools=tools,
                expected_stdout=None,
            )
            stdout = process_state(
                run_process, "stdout", "exec_diff_runtime_stdout"
            )
            stderr = process_state(
                run_process, "stderr", "exec_diff_runtime_stderr"
            )
            if stderr.raw:
                fail(f"exec_diff_runtime_stderr:{ordinal}:{lane}")
            lane_outputs[lane] = (stdout.raw, stderr.raw)
            lane_rows[lane] = {
                "compilerRaw32": tools[driver_role]["sha256"],
                "backend": backend,
                "compilerReport": path_pin(
                    stable_read(report, "exec_diff_compiler_report")
                ),
                "compileGuard": compile_process["guard"],
                "executable": path_pin(
                    stable_read(
                        published,
                        "exec_diff_executable",
                        executable=True,
                    )
                ),
                "publication": path_pin(publication),
                "runGuard": run_process["guard"],
                "stdout": run_process["stdout"],
                "stderr": run_process["stderr"],
            }
            if lane in ("primary", "backend2") and lane not in anchors:
                anchors[lane] = run_process
        reference = lane_outputs["stage3"]
        if (
            lane_outputs["primary"] != reference
            or lane_outputs["backend2"] != reference
        ):
            fail("exec_diff_runtime_mismatch:" + str(ordinal))
        source = member_map[str(relative)]
        aggregate_stdout.extend(frame(os.fsencode(str(relative))))
        aggregate_stdout.extend(frame(reference[0]))
        aggregate_stderr.extend(frame(os.fsencode(str(relative))))
        aggregate_stderr.extend(frame(reference[1]))
        case_rows.append(
            {
                "ordinal": ordinal,
                "sourceRelative": relative,
                "sourceRaw32": source["sha256"],
                "sourceByteLength": source["size"],
                "primary": lane_rows["primary"],
                "backend2": lane_rows["backend2"],
                "stage3": lane_rows["stage3"],
                "stdoutRaw32": hashlib.sha256(reference[0]).hexdigest(),
                "stderrRaw32": hashlib.sha256(reference[1]).hexdigest(),
                "equivalent": True,
            }
        )
    validate_exec_case_rows(
        case_rows, tuple(str(value) for value in identity["execDiffCases"])
    )
    diff_root = out / "exec-diff"
    diff_root.mkdir(mode=0o700, parents=True)
    cases = exclusive_write(
        diff_root / "cases.json",
        canonical_json_bytes(
            {
                "schema": "cheng.backend2.current_source_exec_diff_cases",
                "status": "COMPLETE",
                "target": TARGET,
                "caseCount": len(case_rows),
                "miscompileCount": 0,
                "cases": case_rows,
            }
        ),
        0o400,
    )
    stdout = exclusive_write(
        diff_root / "stdout.bin", bytes(aggregate_stdout), 0o400
    )
    stderr = exclusive_write(
        diff_root / "stderr.bin", bytes(aggregate_stderr), 0o400
    )
    return cases, stdout, stderr, anchors


def validate_exec_case_rows(
    rows: list[dict[str, object]], authority: tuple[str, ...]
) -> None:
    if len(rows) != len(authority) or len(rows) < MIN_EXEC_DIFF_CASES:
        fail("exec_diff_case_authority_count_invalid")
    seen: set[str] = set()
    for ordinal, (row, expected) in enumerate(zip(rows, authority)):
        relative = str(row.get("sourceRelative", ""))
        if (
            row.get("ordinal") != ordinal
            or relative != expected
            or relative in seen
            or row.get("equivalent") is not True
        ):
            fail("exec_diff_case_authority_order_invalid")
        seen.add(relative)


def compile_clang_oracle(
    *,
    root: pathlib.Path,
    out: pathlib.Path,
    tree: pathlib.Path,
    tree_digest: str,
    commands: dict[str, pathlib.Path],
    tools: dict[str, dict[str, object]],
) -> tuple[dict[str, object], FileState]:
    artifact = out / "processes/clang_oracle_compile/artifact.o"
    argv = (
        str(commands["clang"]),
        "-cc1",
        "-triple",
        "arm64-apple-macosx14.0.0",
        "-O2",
        "-emit-obj",
        "-x",
        "c",
        str(commands["clang_source"]),
        "-o",
        str(artifact),
    )
    process = run_guarded(
        label="clang_oracle_compile",
        root=root,
        out=out,
        tools=tools,
        argv=argv,
        env={
            "HOME": "/nonexistent",
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin",
            "TZ": "UTC",
        },
        argv_path_roles=(
            ArgvPathRole(0, "command", "", commands["clang"]),
            ArgvPathRole(
                8,
                "source",
                "",
                commands["clang_source"],
            ),
            ArgvPathRole(10, "artifact", "", artifact),
        ),
        command_sha256=str(tools["clang"]["sha256"]),
        command_mode="private_frozen_tree_direct",
        frozen_tree=tree,
        frozen_tree_sha256=tree_digest,
        tracked=(("artifact", artifact, "regular"),),
        timeout_seconds=300,
        require_stdout_empty=True,
        require_stderr_empty=True,
    )
    return process, stable_read(artifact, "clang_oracle_object")


def performance_projection(
    report: pathlib.Path,
    object_state: FileState,
    backend: str,
    role: str,
) -> tuple[bytes, bytes]:
    body_count, body_raw32, actions, sections = compile_projection(
        report, object_state, backend
    )
    action_raw = canonical_json_bytes(
        {
            "schema": "cheng_current_performance_action_projection",
            "status": "COMPLETE",
            "role": role,
            "bodyIrEntryCount": body_count,
            "bodyIrRaw32": body_raw32,
            "compilerReportRaw32": stable_read(
                report, "performance_projection_report"
            ).sha256,
            "actions": actions,
        }
    )
    fragment_raw = canonical_json_bytes(
        {
            "schema": "cheng_current_performance_fragment_projection",
            "status": "COMPLETE",
            "role": role,
            "objectRaw32": object_state.sha256,
            "sections": sections,
        }
    )
    return action_raw, fragment_raw


def produce_performance(
    *,
    release: dict[str, Any],
    root: pathlib.Path,
    evidence_root: pathlib.Path,
    out: pathlib.Path,
    tree: pathlib.Path,
    tree_digest: str,
    commands: dict[str, pathlib.Path],
    tools: dict[str, dict[str, object]],
    identity: dict[str, object],
    binding: dict[str, str],
) -> tuple[FileState, FileState, FileState]:
    perf_root = out / "performance"
    perf_root.mkdir(mode=0o700, parents=True)
    rows: list[str] = []
    sample_processes: list[dict[str, object]] = []
    sample_objects: dict[str, list[FileState]] = {
        "candidate": [],
        "baseline": [],
    }
    sample_reports: dict[str, list[pathlib.Path]] = {
        "candidate": [],
        "baseline": [],
    }
    sample_metrics: dict[str, list[FileState]] = {
        "candidate": [],
        "baseline": [],
    }
    trace_states: list[FileState] = []
    for ordinal, (order, jobs, role) in enumerate(release["PERF_SCHEDULE"]):
        driver_role = (
            "official_driver" if role == "candidate" else "stage3"
        )
        process, object_path, report_path = compile_source(
            label=f"perf_{ordinal:02d}_{role}",
            driver_role=driver_role,
            source_relative=PERFORMANCE_SOURCE,
            emit="obj",
            jobs=jobs,
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            link_providers=False,
            backend="backend2",
            resource_trace=True,
        )
        object_state = stable_read(object_path, "performance_object")
        report_state = stable_read(report_path, "performance_report")
        metric_state = produce_object_metrics(
            label=f"perf_{ordinal:02d}_{role}_metrics",
            object_state=object_state,
            root=root,
            out=out,
            tree=tree,
            tree_digest=tree_digest,
            commands=commands,
            tools=tools,
            output=perf_root / f"sample-{ordinal:02d}.metrics.kv",
        )
        trace_state = exclusive_write(
            perf_root / f"sample-{ordinal:02d}.trace.json",
            canonical_json_bytes(
                {
                    "schema": "cheng_current_performance_sample_trace",
                    "status": "COMPLETE",
                    "ordinal": ordinal,
                    "order": order,
                    "position": ordinal % 4,
                    "jobs": jobs,
                    "role": role,
                    "hardMemoryLimitProof":
                    "not_provable_userspace_poll",
                    "samples": resource_samples(process),
                }
            ),
            0o400,
        )
        artifacts = (
            metric_state,
            object_state,
            report_state,
            process_state(process, "guard", "performance_guard"),
            process_state(process, "stdout", "performance_stdout"),
            process_state(process, "stderr", "performance_stderr"),
        )
        fields = [
            str(ordinal),
            str(ordinal // 4),
            order,
            str(ordinal % 4),
            str(jobs),
            role,
            str(process["wallNs"]),
            str(process["peakBytes"]),
            binding["performance_source_sha256"],
            str(tools[driver_role]["sha256"]),
        ]
        for artifact in artifacts:
            fields.extend((str(published_path(artifact.path)), artifact.sha256))
        rows.append("\t".join(fields))
        sample_processes.append(process)
        sample_objects[role].append(object_state)
        sample_reports[role].append(report_path)
        sample_metrics[role].append(metric_state)
        trace_states.append(trace_state)
    validate_sample_schedule(
        [
            {
                **row,
                "wallNs": sample_processes[index]["wallNs"],
                "peakBytes": sample_processes[index]["peakBytes"],
                "artifacts": [
                    {"pathFshex": os.fsencode(field).hex()}
                    for field in rows[index].split("\t")[10:22:2]
                ],
            }
            for index, row in enumerate(identity["performanceSchedule"])
        ],
        identity["performanceSchedule"],
    )
    for role in ("candidate", "baseline"):
        if len({state.sha256 for state in sample_objects[role]}) != 1:
            fail("performance_object_nondeterministic:" + role)
    raw_samples = exclusive_write(
        perf_root / "raw-samples.tsv",
        ("\n".join(rows) + "\n").encode("utf-8"),
        0o400,
    )
    _clang_process, clang_object = compile_clang_oracle(
        root=root,
        out=out,
        tree=tree,
        tree_digest=tree_digest,
        commands=commands,
        tools=tools,
    )
    clang_metrics = produce_object_metrics(
        label="clang_oracle_metrics",
        object_state=clang_object,
        root=root,
        out=out,
        tree=tree,
        tree_digest=tree_digest,
        commands=commands,
        tools=tools,
        output=perf_root / "clang.metrics.kv",
    )
    candidate = sample_objects["candidate"][0]
    baseline = sample_objects["baseline"][0]
    candidate_action_raw, candidate_fragment_raw = performance_projection(
        sample_reports["candidate"][0],
        candidate,
        "backend2",
        "candidate",
    )
    baseline_action_raw, baseline_fragment_raw = performance_projection(
        sample_reports["baseline"][0],
        baseline,
        "backend2",
        "baseline",
    )
    projection_states = {
        "candidateAction": exclusive_write(
            perf_root / "candidate-action.json",
            candidate_action_raw,
            0o400,
        ),
        "candidateFragment": exclusive_write(
            perf_root / "candidate-fragment.json",
            candidate_fragment_raw,
            0o400,
        ),
        "candidateObject": copy_state(
            candidate, perf_root / "candidate-object.o"
        ),
        "baselineAction": exclusive_write(
            perf_root / "baseline-action.json",
            baseline_action_raw,
            0o400,
        ),
        "baselineFragment": exclusive_write(
            perf_root / "baseline-fragment.json",
            baseline_fragment_raw,
            0o400,
        ),
        "baselineObject": copy_state(
            baseline, perf_root / "baseline-object.o"
        ),
        "currentTextBinary": copy_state(
            candidate, perf_root / "current-text-binary.o"
        ),
        "baselineTextBinary": copy_state(
            baseline, perf_root / "baseline-text-binary.o"
        ),
        "clangTextBinary": copy_state(
            clang_object, perf_root / "clang-text-binary.o"
        ),
    }
    command_rows: list[dict[str, object]] = []
    for index, (role, jobs) in enumerate(
        (
            ("candidate", 1),
            ("baseline", 1),
            ("candidate", 4),
            ("baseline", 4),
        )
    ):
        schedule_index = next(
            ordinal
            for ordinal, (_, sample_jobs, sample_role) in enumerate(
                release["PERF_SCHEDULE"]
            )
            if sample_jobs == jobs and sample_role == role
        )
        process = sample_processes[schedule_index]
        state = exclusive_write(
            perf_root / f"command-{index}.json",
            canonical_json_bytes(
                {
                    "schema": "cheng_current_performance_command",
                    "status": "COMPLETE",
                    "role": role,
                    "jobs": jobs,
                    "driverRaw32": (
                        binding["official_driver_sha256"]
                        if role == "candidate"
                        else binding["baseline_driver_sha256"]
                    ),
                    "argvManifestRaw32": process["argv"]["sha256"],
                    "environmentManifestRaw32": process["env"]["sha256"],
                }
            ),
            0o400,
        )
        command_rows.append(
            {"role": role, "jobs": jobs, "artifact": formal_pin(state)}
        )
    environment_rows: list[dict[str, object]] = []
    for index, jobs in enumerate((1, 4)):
        matching = next(
            process
            for schedule, process in zip(
                release["PERF_SCHEDULE"], sample_processes
            )
            if schedule[1] == jobs
        )
        state = exclusive_write(
            perf_root / f"environment-{jobs}.json",
            canonical_json_bytes(
                {
                    "schema": "cheng_current_performance_environment",
                    "status": "COMPLETE",
                    "jobs": jobs,
                    "samplingScope": "process_tree_recursive",
                    "sampleClock": "monotonic_ns",
                    "environmentManifestRaw32": matching["env"]["sha256"],
                    "hardMemoryLimitProof":
                    "not_provable_userspace_poll",
                }
            ),
            0o400,
        )
        environment_rows.append(
            {"jobs": jobs, "artifact": formal_pin(state)}
        )
    performance_evidence = exclusive_write(
        perf_root / "evidence.json",
        canonical_json_bytes(
            {
                "schema": "cheng_current_performance_evidence",
                "status": "COMPLETE",
                "sourceBundleRaw32": binding["snapshot_manifest_sha256"],
                "officialDriverRaw32": binding["official_driver_sha256"],
                "executionRaw32": binding["seven_stage_execution_raw32"],
                "jobsN": 4,
                "baselineIdentity": {
                    "sourceBundleRaw32": binding[
                        "baseline_manifest_sha256"
                    ],
                    "driverRaw32": binding["baseline_driver_sha256"],
                    "executionRaw32": binding[
                        "seven_stage_execution_raw32"
                    ],
                },
                **{
                    key: formal_pin(value)
                    for key, value in projection_states.items()
                },
                "commands": command_rows,
                "environments": environment_rows,
                "samples": [
                    {
                        "ordinal": ordinal,
                        "order": order,
                        "position": ordinal % 4,
                        "jobs": jobs,
                        "role": role,
                        "trace": formal_pin(trace_states[ordinal]),
                    }
                    for ordinal, (order, jobs, role) in enumerate(
                        release["PERF_SCHEDULE"]
                    )
                ],
            }
        ),
        0o400,
    )
    try:
        release["validate_performance_evidence"](
            performance_evidence.path,
            evidence_root,
            binding,
            binding["snapshot_manifest_sha256"],
            binding["seven_stage_execution_raw32"],
        )
        verdict_path = perf_root / "verdict.kv"
        release["produce_performance_verdict"](
            argparse.Namespace(
                evidence_root=str(evidence_root),
                raw_samples=str(raw_samples.path),
                candidate_object_metrics=str(
                    sample_metrics["candidate"][0].path
                ),
                baseline_object_metrics=str(
                    sample_metrics["baseline"][0].path
                ),
                clang_object_metrics=str(clang_metrics.path),
                out=str(verdict_path),
            )
        )
        raw_state, verdict_state = release["validate_perf"](
            raw_samples.path,
            verdict_path,
            binding,
            evidence_root,
        )
    except Exception as exc:
        fail("formal_performance_validation_failed:" + repr(exc))
    return raw_state, verdict_state, performance_evidence


def make_exec_diff_receipt(
    *,
