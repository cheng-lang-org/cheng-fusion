def copy_state(
    source: FileState,
    destination: pathlib.Path,
    *,
    executable: bool = False,
) -> FileState:
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    return exclusive_write(
        destination,
        source.raw,
        0o555 if executable else 0o400,
    )


