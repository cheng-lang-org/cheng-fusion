_PUBLICATION_PATH_PROJECTION: tuple[pathlib.Path, pathlib.Path] | None = None


def physical_publication_path(path: pathlib.Path) -> pathlib.Path:
    projection = _PUBLICATION_PATH_PROJECTION
    if projection is None or not path.is_absolute():
        return path
    work_root, publish_root = projection
    try:
        relative = path.relative_to(publish_root)
    except ValueError:
        return path
    return work_root / relative


def published_path(path: pathlib.Path) -> pathlib.Path:
    projection = _PUBLICATION_PATH_PROJECTION
    if projection is None or not path.is_absolute():
        return path
    work_root, publish_root = projection
    try:
        relative = path.relative_to(work_root)
    except ValueError:
        return path
    return publish_root / relative


@contextlib.contextmanager
def publication_path_projection(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
):
    global _PUBLICATION_PATH_PROJECTION
    if _PUBLICATION_PATH_PROJECTION is not None:
        fail("publication_path_projection_nested")
    _PUBLICATION_PATH_PROJECTION = (work_root, publish_root)
    try:
        yield
    finally:
        _PUBLICATION_PATH_PROJECTION = None


def canonical_existing(
    raw: str | pathlib.Path,
    label: str,
    *,
    directory: bool = False,
    executable: bool = False,
    single_link: bool = True,
) -> pathlib.Path:
    path = physical_publication_path(pathlib.Path(raw))
    if not path.is_absolute():
        fail(label + "_not_absolute")
    if pathlib.Path(os.path.realpath(path)) != path:
        fail(label + "_not_canonical")
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"{label}_missing:{exc}")
    if stat.S_ISLNK(info.st_mode):
        fail(label + "_symlink")
    expected = stat.S_ISDIR if directory else stat.S_ISREG
    if not expected(info.st_mode):
        fail(label + ("_not_directory" if directory else "_not_regular"))
    if not directory and single_link and info.st_nlink != 1:
        fail(label + "_not_single_link")
    if executable and info.st_mode & 0o111 == 0:
        fail(label + "_not_executable")
    return path


def file_identity(info: os.stat_result) -> dict[str, int]:
    return {
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "uid": info.st_uid,
        "gid": info.st_gid,
        "size": info.st_size,
        "mtimeNs": info.st_mtime_ns,
        "ctimeNs": info.st_ctime_ns,
    }


def same_generation(left: os.stat_result, right: os.stat_result) -> bool:
    return file_identity(left) == file_identity(right)


def stable_read(
    raw: str | pathlib.Path,
    label: str,
    *,
    executable: bool = False,
    allow_empty: bool = False,
    single_link: bool = True,
) -> FileState:
    path = canonical_existing(
        raw,
        label,
        executable=executable,
        single_link=single_link,
    )
    before = path.lstat()
    if before.st_size > MAX_FILE_BYTES:
        fail(label + "_too_large")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if not same_generation(before, opened):
            fail(label + "_changed_while_opening")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        size = 0
        while True:
            chunk = os.read(descriptor, READ_CHUNK)
            if not chunk:
                break
            size += len(chunk)
            if size > MAX_FILE_BYTES:
                fail(label + "_grew_past_limit")
            digest.update(chunk)
            chunks.append(chunk)
        after_fd = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after_path = path.lstat()
    if (
        not same_generation(before, after_fd)
        or not same_generation(after_fd, after_path)
        or size != before.st_size
    ):
        fail(label + "_changed_during_read")
    if not allow_empty and size == 0:
        fail(label + "_empty")
    return FileState(path, b"".join(chunks), digest.hexdigest(), after_path)


def require_sha(value: object, label: str) -> str:
    text = str(value)
    if SHA_RE.fullmatch(text) is None:
        fail(label + "_sha256_invalid")
    return text


def require_uint(value: object, label: str, *, positive: bool = False) -> int:
    if isinstance(value, bool):
        fail(label + "_uint_invalid")
    text = str(value)
    if not text.isdigit() or (len(text) > 1 and text.startswith("0")):
        fail(label + "_uint_invalid")
    number = int(text)
    if positive and number <= 0:
        fail(label + "_not_positive")
    return number


def canonical_json_bytes(value: object) -> bytes:
    return (
        json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
        + b"\n"
    )


def canonical_json_state(path: pathlib.Path, label: str) -> tuple[Any, FileState]:
    state = stable_read(path, label)
    try:
        value = json.loads(state.raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"{label}_json_invalid:{exc}")
    if state.raw != canonical_json_bytes(value):
        fail(label + "_json_not_canonical")
    return value, state


def exclusive_output_authority(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
    )


def unlink_created_output(
    parent_descriptor: int,
    name: str,
    descriptor: int,
    created_authority: tuple[int, ...],
) -> None:
    held = os.fstat(descriptor)
    try:
        named = os.stat(
            name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        fail("exclusive_write_cleanup_output_missing")
    if (
        exclusive_output_authority(held) != created_authority
        or exclusive_output_authority(named) != created_authority
        or not stat.S_ISREG(named.st_mode)
    ):
        fail("exclusive_write_cleanup_identity_drift")
    os.unlink(name, dir_fd=parent_descriptor)


def exclusive_write(path: pathlib.Path, raw: bytes, mode: int = 0o400) -> FileState:
    if not path.is_absolute() or pathlib.Path(os.path.realpath(path.parent)) != path.parent:
        fail("output_parent_not_canonical")
    parent_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_DIRECTORY"):
        parent_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        parent_flags |= os.O_NOFOLLOW
    parent_descriptor = os.open(path.parent, parent_flags)
    flags = os.O_RDWR | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = -1
    created_authority: tuple[int, ...] | None = None
    committed_authority: tuple[int, ...] | None = None
    committed_sha256 = ""
    completed = False
    try:
        descriptor = os.open(
            path.name,
            flags,
            mode,
            dir_fd=parent_descriptor,
        )
        os.fchmod(descriptor, mode)
        created = os.fstat(descriptor)
        if (
            not stat.S_ISREG(created.st_mode)
            or created.st_nlink != 1
            or created.st_uid != os.geteuid()
            or created.st_gid != os.getegid()
            or stat.S_IMODE(created.st_mode) != mode
        ):
            fail("exclusive_write_created_identity_invalid")
        created_authority = exclusive_output_authority(created)
        view = memoryview(raw)
        while view:
            count = os.write(descriptor, view)
            if count <= 0:
                fail("exclusive_write_no_progress")
            view = view[count:]
        os.fsync(descriptor)
        committed = os.fstat(descriptor)
        named = os.stat(
            path.name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
        if (
            exclusive_output_authority(committed) != created_authority
            or exclusive_output_authority(named) != created_authority
            or committed.st_size != len(raw)
            or named.st_size != len(raw)
        ):
            fail("exclusive_write_committed_identity_invalid")
        digest = hashlib.sha256()
        offset = 0
        while offset < committed.st_size:
            chunk = os.pread(
                descriptor,
                min(1024 * 1024, committed.st_size - offset),
                offset,
            )
            if not chunk:
                fail("exclusive_write_committed_short_read")
            digest.update(chunk)
            offset += len(chunk)
        committed_sha256 = digest.hexdigest()
        if committed_sha256 != hashlib.sha256(raw).hexdigest():
            fail("exclusive_write_committed_content_invalid")
        committed_authority = (
            *exclusive_output_authority(committed),
            committed.st_size,
        )
        completed = True
    finally:
        cleanup_error: BaseException | None = None
        if (
            not completed
            and descriptor >= 0
            and created_authority is not None
        ):
            try:
                unlink_created_output(
                    parent_descriptor,
                    path.name,
                    descriptor,
                    created_authority,
                )
            except BaseException as exc:
                cleanup_error = exc
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_descriptor)
        if cleanup_error is not None:
            raise cleanup_error
    observed = stable_read(path, "exclusive_output", allow_empty=True)
    if (
        committed_authority is None
        or (
            *exclusive_output_authority(observed.info),
            observed.info.st_size,
        )
        != committed_authority
        or observed.sha256 != committed_sha256
    ):
        fail("exclusive_write_post_close_identity_drift")
    return observed


def exclusive_copy(
    source: pathlib.Path,
    destination: pathlib.Path,
    *,
    executable: bool,
    expected_sha256: str,
    expected_size: int,
    source_single_link: bool = True,
) -> FileState:
    source_state = stable_read(
        source,
        "snapshot_source",
        executable=executable,
        single_link=source_single_link,
    )
    if (
        source_state.sha256 != expected_sha256
        or source_state.info.st_size != expected_size
    ):
        fail("snapshot_source_identity_mismatch")
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    mode = 0o555 if executable else 0o444
    copied = exclusive_write(destination, source_state.raw, mode)
    if copied.sha256 != source_state.sha256 or copied.info.st_size != expected_size:
        fail("snapshot_copy_mismatch")
    return copied


def path_pin(state: FileState) -> dict[str, object]:
    return {
        "pathFshex": os.fsencode(str(published_path(state.path))).hex(),
        "sha256": state.sha256,
        "size": state.info.st_size,
        "identity": file_identity(state.info),
    }


def logical_path_from_fshex(value: object, label: str) -> pathlib.Path:
    try:
        raw = bytes.fromhex(str(value))
        path = pathlib.Path(os.fsdecode(raw))
    except (ValueError, UnicodeError) as exc:
        fail(f"{label}_path_fshex_invalid:{exc}")
    return path


def path_from_fshex(value: object, label: str) -> pathlib.Path:
    return physical_publication_path(logical_path_from_fshex(value, label))


def validate_pin(
    pin: object,
    label: str,
    *,
    executable: bool = False,
    require_identity: bool = True,
) -> FileState:
    if not isinstance(pin, dict) or set(pin) != {
        "pathFshex",
        "sha256",
        "size",
        "identity",
    }:
        fail(label + "_pin_shape_invalid")
    path = path_from_fshex(pin["pathFshex"], label)
    state = stable_read(path, label, executable=executable, allow_empty=True)
    if (
        state.sha256 != require_sha(pin["sha256"], label)
        or state.info.st_size != require_uint(pin["size"], label + "_size")
    ):
        fail(label + "_pin_content_mismatch")
    if require_identity and pin["identity"] != file_identity(state.info):
        fail(label + "_pin_physical_identity_mismatch")
    return state


def verify_bound_file(
    path: pathlib.Path,
    expected: dict[str, object],
    label: str,
    *,
    executable: bool = False,
    single_link: bool = True,
) -> FileState:
    state = stable_read(
        path,
        label,
        executable=executable,
        allow_empty=True,
        single_link=single_link,
    )
    if (
        state.sha256 != require_sha(expected.get("sha256"), label)
        or state.info.st_size
        != require_uint(expected.get("size"), label + "_size")
        or expected.get("identity") != file_identity(state.info)
    ):
        fail(label + "_binding_mismatch")
    return state


def load_source_closure_module(root: pathlib.Path) -> Any:
    path = root / "tools/current_source_closure_manifest.py"
    spec = importlib.util.spec_from_file_location(
        "darwin_runtime_source_closure", path
    )
    if spec is None or spec.loader is None:
        fail("source_closure_module_unavailable")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def parse_source_closure(
    root: pathlib.Path, manifest_path: pathlib.Path
) -> tuple[FileState, str, list[dict[str, object]]]:
    state = stable_read(manifest_path, "source_closure")
    module = load_source_closure_module(root)
    try:
        content_cid = module.content_cid_from_manifest(state.raw)
    except RuntimeError as exc:
        fail("source_closure_invalid:" + str(exc))
    lines = state.raw.decode("ascii", "strict").splitlines()
    count_index = next(
        (index for index, row in enumerate(lines) if row.startswith("path_count=")),
        -1,
    )
    if count_index < 0 or count_index + 1 >= len(lines):
        fail("source_closure_member_header_missing")
    count = require_uint(lines[count_index].split("=", 1)[1], "source_count")
    members: list[dict[str, object]] = []
    prior = b""
    for row in lines[count_index + 2 :]:
        fields = row.split("\t")
        if len(fields) not in (2, 9):
            fail("source_closure_member_shape_invalid")
        try:
            relative_raw = bytes.fromhex(fields[0])
            relative = os.fsdecode(relative_raw)
        except (ValueError, UnicodeError) as exc:
            fail(f"source_closure_member_path_invalid:{exc}")
        if (
            relative_raw <= prior
            or relative_raw.startswith(b"/")
            or any(part in (b"", b".", b"..") for part in relative_raw.split(b"/"))
        ):
            fail("source_closure_member_order_invalid")
        prior = relative_raw
        if len(fields) == 2:
            if fields[1] != "tracked_deleted":
                fail("source_closure_deleted_state_invalid")
            members.append({"relativePathFshex": relative_raw.hex(), "state": fields[1]})
            continue
        source_path = root / relative
        source_state = stable_read(source_path, "source_member", allow_empty=True)
        expected_identity = {
            "device": int(fields[3]),
            "inode": int(fields[4]),
            "mode": int(fields[5]),
            "size": int(fields[6]),
            "mtimeNs": int(fields[7]),
            "ctimeNs": int(fields[8]),
        }
        actual_identity = file_identity(source_state.info)
        for key in ("device", "inode", "mode", "size", "mtimeNs", "ctimeNs"):
            if actual_identity[key] != expected_identity[key]:
                fail("source_closure_member_physical_identity_mismatch:" + relative)
        if source_state.sha256 != require_sha(fields[2], "source_member"):
            fail("source_closure_member_digest_mismatch:" + relative)
        members.append(
            {
                "relativePathFshex": relative_raw.hex(),
                "state": fields[1],
                "sha256": source_state.sha256,
                "size": source_state.info.st_size,
                "executable": bool(source_state.info.st_mode & 0o111),
                "identity": file_identity(source_state.info),
            }
        )
    if len(members) != count:
        fail("source_closure_member_count_mismatch")
    return state, content_cid, members


def source_member_map(members: list[dict[str, object]]) -> dict[str, dict[str, object]]:
    result: dict[str, dict[str, object]] = {}
    for member in members:
        relative = os.fsdecode(bytes.fromhex(str(member["relativePathFshex"])))
        if relative in result:
            fail("source_member_duplicate")
        result[relative] = member
    return result


def validate_case_authority(
    members: list[dict[str, object]],
) -> tuple[str, ...]:
    mapped = source_member_map(members)
    required = (ORC_SOURCE, PERFORMANCE_SOURCE, PERFORMANCE_ORACLE)
    for relative in required:
        member = mapped.get(relative)
        if member is None or member.get("state") == "tracked_deleted":
            fail("required_production_source_missing:" + relative)
    prefix = EXEC_DIFF_CORPUS + "/"
    cases = sorted(
        (
            relative
            for relative, member in mapped.items()
            if relative.startswith(prefix)
            and relative.endswith(".cheng")
            and member.get("state") != "tracked_deleted"
        ),
        key=os.fsencode,
    )
    if len(cases) < MIN_EXEC_DIFF_CASES:
        fail("exec_diff_case_count_below_formal_minimum")
    if len(cases) != len(set(cases)):
        fail("exec_diff_case_duplicate")
    return tuple(cases)


def capture_dereferenced_tree(
    source_root: pathlib.Path, label: str
) -> dict[str, object]:
    logical_root = pathlib.Path(source_root)
    if (
        not logical_root.is_absolute()
        or os.path.normpath(str(logical_root)) != str(logical_root)
    ):
        fail(label + "_logical_root_invalid")
    try:
        logical_info = logical_root.lstat()
    except OSError as exc:
        fail(label + "_logical_root_missing:" + str(exc))
    if not (
        stat.S_ISDIR(logical_info.st_mode)
        or stat.S_ISLNK(logical_info.st_mode)
    ):
        fail(label + "_logical_root_shape_invalid")
    source_root = canonical_existing(
        pathlib.Path(os.path.realpath(logical_root)),
        label + "_resolved_root",
        directory=True,
    )
    directories: list[dict[str, object]] = []
    files: list[dict[str, object]] = []

    def visit(
        logical_relative: pathlib.PurePosixPath,
        origin_directory: pathlib.Path,
        ancestry: frozenset[tuple[int, int]],
    ) -> None:
        resolved_directory = pathlib.Path(os.path.realpath(origin_directory))
        info = resolved_directory.lstat()
        identity_key = (info.st_dev, info.st_ino)
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or identity_key in ancestry
        ):
            fail(label + "_directory_cycle_or_shape_invalid")
        relative_text = (
            "."
            if str(logical_relative) in ("", ".")
            else str(logical_relative)
        )
        directories.append(
            {
                "relativePathFshex": os.fsencode(relative_text).hex(),
                "originPathFshex": os.fsencode(
                    str(resolved_directory)
                ).hex(),
                "identity": file_identity(info),
            }
        )
        try:
            entries = sorted(
                os.scandir(resolved_directory),
                key=lambda entry: os.fsencode(entry.name),
            )
        except OSError as exc:
            fail(label + "_directory_scan_failed:" + str(exc))
        for entry in entries:
            logical = logical_relative / entry.name
            entry_path = pathlib.Path(entry.path)
            resolved = pathlib.Path(os.path.realpath(entry_path))
            try:
                resolved_info = resolved.lstat()
            except OSError as exc:
                fail(label + "_dereference_failed:" + str(exc))
            if stat.S_ISDIR(resolved_info.st_mode):
                visit(logical, resolved, ancestry | {identity_key})
                continue
            if not stat.S_ISREG(resolved_info.st_mode):
                fail(label + "_non_regular_member")
            state = stable_read(
                resolved,
                label + "_file",
                allow_empty=True,
                single_link=False,
            )
            files.append(
                {
                    "relativePathFshex": os.fsencode(str(logical)).hex(),
                    "originPathFshex": os.fsencode(str(resolved)).hex(),
                    "sha256": state.sha256,
                    "size": state.info.st_size,
                    "executable": bool(state.info.st_mode & 0o111),
                    "identity": file_identity(state.info),
                }
            )

    visit(pathlib.PurePosixPath("."), source_root, frozenset())
    directories.sort(
        key=lambda item: bytes.fromhex(str(item["relativePathFshex"]))
    )
    files.sort(
        key=lambda item: bytes.fromhex(str(item["relativePathFshex"]))
    )
    logical_paths = [
        item["relativePathFshex"] for item in (*directories, *files)
    ]
    if len(logical_paths) != len(set(logical_paths)):
        fail(label + "_logical_path_duplicate")
    return {
        "rootPathFshex": os.fsencode(str(logical_root)).hex(),
        "directoryCount": len(directories),
        "fileCount": len(files),
        "directories": directories,
        "files": files,
    }


