def verify_tree_origin_manifest(
    manifest: object, label: str
) -> None:
    if not isinstance(manifest, dict) or set(manifest) != {
        "rootPathFshex",
        "directoryCount",
        "fileCount",
        "directories",
        "files",
    }:
        fail(label + "_manifest_shape_invalid")
    directories = manifest["directories"]
    files = manifest["files"]
    if (
        not isinstance(directories, list)
        or not isinstance(files, list)
        or manifest["directoryCount"] != len(directories)
        or manifest["fileCount"] != len(files)
    ):
        fail(label + "_manifest_count_invalid")
    prior = b""
    for index, item in enumerate(directories):
        if not isinstance(item, dict) or set(item) != {
            "relativePathFshex",
            "originPathFshex",
            "identity",
        }:
            fail(label + "_directory_shape_invalid")
        relative = bytes.fromhex(str(item["relativePathFshex"]))
        relative_path = pathlib.PurePosixPath(os.fsdecode(relative))
        if relative_path.is_absolute() or ".." in relative_path.parts:
            fail(label + "_directory_relative_path_invalid")
        if index > 0 and relative <= prior:
            fail(label + "_directory_order_invalid")
        prior = relative
        origin = path_from_fshex(
            item["originPathFshex"], label + "_directory_origin"
        )
        info = canonical_existing(
            origin, label + "_directory_origin", directory=True
        ).lstat()
        if file_identity(info) != item["identity"]:
            fail(label + "_directory_identity_drift")
    prior = b""
    for index, item in enumerate(files):
        if not isinstance(item, dict) or set(item) != {
            "relativePathFshex",
            "originPathFshex",
            "sha256",
            "size",
            "executable",
            "identity",
        }:
            fail(label + "_file_shape_invalid")
        if not isinstance(item["executable"], bool):
            fail(label + "_file_executable_invalid")
        relative = bytes.fromhex(str(item["relativePathFshex"]))
        relative_path = pathlib.PurePosixPath(os.fsdecode(relative))
        if (
            relative_path.is_absolute()
            or ".." in relative_path.parts
            or str(relative_path) == "."
        ):
            fail(label + "_file_relative_path_invalid")
        if index > 0 and relative <= prior:
            fail(label + "_file_order_invalid")
        prior = relative
        verify_bound_file(
            path_from_fshex(
                item["originPathFshex"], label + "_file_origin"
            ),
            item,
            label + "_file_origin",
            executable=bool(item["executable"]),
            single_link=False,
        )


def verify_lldb_origin_closure(closure: object) -> None:
    if not isinstance(closure, dict) or set(closure) != {
        "schema",
        "status",
        "xcodeRootFshex",
        "lldbPathFshex",
        "mainDylib",
        "swiftCompiler",
        "pythonFramework",
        "lldbPython",
    }:
        fail("lldb_origin_closure_shape_invalid")
    if (
        closure["schema"]
