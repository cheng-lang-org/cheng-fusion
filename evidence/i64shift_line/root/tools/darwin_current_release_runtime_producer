def load_python_tool(path: pathlib.Path, name: str) -> dict[str, Any]:
    state = stable_read(path, name)
    module_name = "darwin_runtime_" + name
    module = types.ModuleType(module_name)
    module.__file__ = str(path)
    sys.modules[module_name] = module
    namespace = module.__dict__
    try:
        exec(compile(state.raw, str(path), "exec"), namespace)
    except Exception as exc:
        fail(name + "_load_failed:" + repr(exc))
    return namespace


