def validate_guard_report(
    report_path: pathlib.Path,
    *,
    argv: tuple[str, ...],
    env: dict[str, str],
    command_sha256: str,
    command_mode: str,
    frozen_tree: pathlib.Path | None,
    frozen_tree_sha256: str | None,
    publication_argv_manifest_path: pathlib.Path,
    publication_env_manifest_path: pathlib.Path,
    stdout_path: pathlib.Path,
    stderr_path: pathlib.Path,
    tracked: tuple[tuple[str, pathlib.Path, str], ...],
    publication_argv_manifest_observed_path: pathlib.Path | None = None,
    publication_env_manifest_observed_path: pathlib.Path | None = None,
    stdout_observed_path: pathlib.Path | None = None,
    stderr_observed_path: pathlib.Path | None = None,
    frozen_tree_observed_path: pathlib.Path | None = None,
    tracked_observed: tuple[
        tuple[str, pathlib.Path, str], ...
    ] | None = None,
) -> tuple[dict[str, str], FileState]:
    rows, state = parse_kv(report_path, "guard_report")
    validate_guard_completion_rows(rows)
    required = {
        "schema": "beat_c_process_memory_guard",
        "platform": "darwin",
        "status": "completed",
        "rc": "0",
        "abort_reason": "",
        "expected_exit_code": "0",
        "actual_exit_code": "0",
        "exit_code_contract_status": "matched",
        "formal_command_identity_status": "required_verified",
        "command_execution_mode": command_mode,
        "command_sha256": command_sha256,
        "command_argv_count": str(len(argv)),
        "command_argv_sha256": command_argv_digest(argv),
        "target_env_mode": "exact",
        "target_env_requested_count": str(len(env)),
        "target_env_requested_sha256": env_digest(env),
        "memory_limit_bytes": str(LIMIT_BYTES),
        "hard_memory_limit_proof_status": "not_provable_userspace_poll",
        "memory_guard_mode": "process_tree",
        "process_tree_escape_pid": "0",
        "memory_measurement_status": "available",
        "root_identity_sampled": "1",
        "cleanup_error": "",
        "combined_output_limit_status": "within_limit",
        "stdout": str(stdout_path),
        "stderr": str(stderr_path),
        "tracked_output_count": str(len(tracked)),
    }
    for key, expected in required.items():
        if rows.get(key) != expected:
            fail("guard_report_field_invalid:" + key)
    publication_values: dict[str, dict[str, object]] = {}
    publication_states: dict[str, FileState] = {}
    for kind, raw_path, observed_path in (
        (
            "argv",
            publication_argv_manifest_path,
            publication_argv_manifest_observed_path
            or publication_argv_manifest_path,
        ),
        (
            "env",
            publication_env_manifest_path,
            publication_env_manifest_observed_path
            or publication_env_manifest_path,
        ),
    ):
        value, manifest_state = canonical_json_state(
            observed_path,
            "guard_publication_" + kind,
        )
        validate_publication_channel_manifest(value, kind=kind)
        publication_values[kind] = value
        publication_states[kind] = manifest_state
        expected_manifest = {
            "path": str(raw_path),
            "raw32": manifest_state.sha256,
            "device": str(manifest_state.info.st_dev),
            "inode": str(manifest_state.info.st_ino),
            "mode": format(manifest_state.info.st_mode, "o"),
            "nlink": str(manifest_state.info.st_nlink),
            "uid": str(manifest_state.info.st_uid),
            "gid": str(manifest_state.info.st_gid),
            "size": str(manifest_state.info.st_size),
            "mtime_ns": str(manifest_state.info.st_mtime_ns),
            "ctime_ns": str(manifest_state.info.st_ctime_ns),
        }
        for key, expected in expected_manifest.items():
            if (
                rows.get(
                    "publication_"
                    + kind
                    + "_manifest_"
                    + key
                )
                != expected
            ):
                fail(
                    "guard_publication_"
                    + kind
                    + "_manifest_invalid:"
                    + key
                )
        for key, manifest_key in (
            ("physical_sha256", "physicalDigest"),
            ("logical_sha256", "logicalDigest"),
            ("path_role_sha256", "pathRoleDigest"),
            ("support_path_role_sha256", "supportPathRoleDigest"),
        ):
            if (
                rows.get("publication_" + kind + "_" + key)
                != value[manifest_key]
            ):
                fail(
                    "guard_publication_"
                    + kind
                    + "_authority_invalid:"
                    + key
                )
    if (
        rows.get("publication_channel_schema")
        != "cheng.guard.publication_channel"
        or rows.get("publication_channel_status") != "verified"
        or rows.get("publication_channel_error") != ""
        or rows.get("publication_work_root_fshex")
        != publication_values["argv"]["workRootFshex"]
        or rows.get("publication_publish_root_fshex")
        != publication_values["argv"]["publishRootFshex"]
        or publication_values["argv"]["workRootFshex"]
        != publication_values["env"]["workRootFshex"]
        or publication_values["argv"]["publishRootFshex"]
        != publication_values["env"]["publishRootFshex"]
    ):
        fail("guard_publication_channel_invalid")
    for label, raw_path, observed_path in (
        (
            "stdout",
            stdout_path,
            stdout_observed_path or stdout_path,
        ),
        (
            "stderr",
            stderr_path,
            stderr_observed_path or stderr_path,
        ),
    ):
        output_state = stable_read(
            observed_path,
            "guard_" + label,
            allow_empty=True,
        )
        expected_output = {
            "status": "available",
            "path": str(raw_path),
            "sha256": output_state.sha256,
            "device": str(output_state.info.st_dev),
            "inode": str(output_state.info.st_ino),
            "size": str(output_state.info.st_size),
        }
        for key, expected in expected_output.items():
            if rows.get(label + "_" + key) != expected:
                fail("guard_" + label + "_identity_invalid:" + key)
    if require_uint(
        rows.get("process_tree_enforced_peak_bytes", ""),
        "guard_peak",
        positive=True,
    ) > LIMIT_BYTES:
        fail("guard_peak_exceeds_limit")
    if require_uint(rows.get("memory_sample_count", ""), "guard_samples", positive=True) <= 0:
        fail("guard_samples_empty")
    if command_mode != "private_frozen_tree_direct":
        fail("guard_command_mode_invalid")
    if (
        frozen_tree is None
        or frozen_tree_sha256 is None
        or rows.get("private_frozen_tree_direct_status") != "verified"
        or rows.get("private_frozen_tree_root") != str(frozen_tree)
        or rows.get("private_frozen_tree_expected_sha256")
        != frozen_tree_sha256
        or rows.get("private_frozen_tree_sha256") != frozen_tree_sha256
        or rows.get("private_frozen_tree_watch_status") != "verified_clean"
    ):
        fail("guard_private_frozen_tree_invalid")
    if (
        frozen_tree_observed_path is not None
        and private_tree_digest(frozen_tree_observed_path)
        != frozen_tree_sha256
    ):
        fail("guard_private_frozen_tree_published_drift")
    observed_tracked = tracked if tracked_observed is None else tracked_observed
    if len(observed_tracked) != len(tracked):
        fail("guard_tracked_output_observed_count_invalid")
    actual_tracked = tracked_output_rows(rows, len(tracked))
    for index, (label, path, kind) in enumerate(tracked):
        observed_label, observed_path, observed_kind = observed_tracked[index]
        if observed_label != label or observed_kind != kind:
            fail("guard_tracked_output_observed_order_invalid")
        item = actual_tracked[index]
        output_state = stable_read(
            observed_path,
            "tracked_output_" + label,
            executable=kind == "executable",
            allow_empty=False,
        )
        expected = {
            "label": label,
            "path": str(path),
            "status": "available_validated",
            "required_mode": kind,
            "sha256": output_state.sha256,
            "preopen_path_status": "absent_proved_by_o_excl",
            "identity_stable": "1",
            "size": str(output_state.info.st_size),
        }
        for key, value in expected.items():
            if item.get(key) != value:
                fail("guard_tracked_output_invalid:" + label + ":" + key)
    return rows, state


def run_guarded(
    *,
    label: str,
    root: pathlib.Path,
    out: pathlib.Path,
    tools: dict[str, dict[str, object]],
    argv: tuple[str, ...],
    env: dict[str, str],
    command_sha256: str,
    command_mode: str,
    frozen_tree: pathlib.Path | None,
    frozen_tree_sha256: str | None,
    argv_path_roles: tuple[ArgvPathRole, ...] = (),
    env_path_roles: tuple[EnvPathRole, ...] = (),
    tracked: tuple[tuple[str, pathlib.Path, str], ...] = (),
    timeout_seconds: int = 600,
    resource_trace: bool = False,
    require_stdout_empty: bool = False,
    require_stderr_empty: bool = True,
) -> dict[str, object]:
    if LABEL_RE.fullmatch(label) is None:
        fail("process_label_invalid")
    if command_mode != "private_frozen_tree_direct":
        fail("unsupported_command_mode")
    if frozen_tree is None or frozen_tree_sha256 is None:
        fail("private_tree_binding_missing")
    process_root = out / "processes"
    process_root.mkdir(mode=0o700, exist_ok=True)
    process_root_info = process_root.lstat()
    if (
        not stat.S_ISDIR(process_root_info.st_mode)
        or stat.S_ISLNK(process_root_info.st_mode)
        or stat.S_IMODE(process_root_info.st_mode) != 0o700
        or process_root_info.st_uid != os.geteuid()
        or process_root_info.st_gid != os.getegid()
    ):
        fail("process_root_private_owner_invalid")
    run_dir = process_root / label
    run_dir.mkdir(mode=0o700)
    report_path = run_dir / "guard.kv"
    stdout_path = run_dir / "stdout.bin"
    stderr_path = run_dir / "stderr.bin"
    resource_path = run_dir / "resource-trace.tsv"
    argv_path = run_dir / "argv.json"
    env_path = run_dir / "env.json"
    seen_tracked_labels: set[str] = set()
    support_roles = [
        SupportPathRole("argv_manifest", argv_path),
        SupportPathRole("env_manifest", env_path),
        SupportPathRole("frozen_tree", frozen_tree),
        SupportPathRole("guard_report", report_path),
        SupportPathRole("stderr", stderr_path),
        SupportPathRole("stdout", stdout_path),
    ]
    if resource_trace:
        support_roles.append(
            SupportPathRole("resource_trace", resource_path)
        )
    for tracked_label, path, _ in tracked:
        if (
            LABEL_RE.fullmatch(tracked_label) is None
            or tracked_label in seen_tracked_labels
        ):
            fail("tracked_output_label_invalid:" + tracked_label)
        seen_tracked_labels.add(tracked_label)
        support_roles.append(
            SupportPathRole("tracked_" + tracked_label, path)
        )
    argv_manifest = argv_publication_manifest(
        argv,
        argv_path_roles,
        tuple(support_roles),
    )
    env_manifest = env_publication_manifest(env, env_path_roles)
    validate_publication_channel_manifest(argv_manifest, kind="argv")
    validate_publication_channel_manifest(env_manifest, kind="env")
    argv_state = exclusive_write(
        argv_path,
        canonical_json_bytes(argv_manifest),
        0o400,
    )
    env_state = exclusive_write(
        env_path,
        canonical_json_bytes(env_manifest),
        0o400,
    )
    guard = path_from_fshex(tools["process_guard"]["pathFshex"], "guard")
    monitor = path_from_fshex(tools["monitor_python"]["pathFshex"], "monitor")
    guard_argv = [
        str(guard),
        "--require-command-identity",
        "--rss-limit:" + str(LIMIT_BYTES),
        "--timeout:" + str(timeout_seconds),
        "--combined-output-limit:" + str(LIMIT_BYTES),
        "--monitor-python:" + str(monitor),
        "--expected-monitor-runtime-sha256:"
        + str(tools["process_guard_runtime"]["sha256"]),
        "--expected-command-path:" + argv[0],
        "--expected-command-sha256:" + command_sha256,
        "--expected-exit-code:0",
        "--report-out:" + str(report_path),
        "--stdout:" + str(stdout_path),
        "--stderr:" + str(stderr_path),
        "--publication-argv-manifest:" + str(argv_path),
        "--publication-env-manifest:" + str(env_path),
    ]
    guard_argv.extend(
        (
            "--private-frozen-tree-direct",
            "--frozen-tree-root:" + str(frozen_tree),
            "--expected-frozen-tree-sha256:" + frozen_tree_sha256,
        )
    )
    if resource_trace:
        guard_argv.append("--resource-trace:" + str(resource_path))
    for tracked_label, path, kind in tracked:
        guard_argv.append(
            "--tracked-output:"
            + tracked_label
            + "="
            + str(LIMIT_BYTES)
            + ":"
            + kind
            + ":"
            + str(path)
        )
    guard_argv.append("--target-env-clear")
    guard_argv.extend(
        "--target-env:" + key + "=" + env[key] for key in sorted(env)
    )
    guard_argv.extend(("--", *argv))
    started = time.monotonic_ns()
    completed = subprocess.run(
        guard_argv,
        cwd=root,
        env=guard_launcher_env(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    ended = time.monotonic_ns()
    if completed.returncode != 0 or completed.stdout or completed.stderr:
        detail = (completed.stderr or completed.stdout)[:1024].decode(
            "utf-8", "replace"
        ).replace("\n", "_")
        fail(f"guarded_process_failed:{label}:{completed.returncode}:{detail}")
    report, report_state = validate_guard_report(
        report_path,
        argv=argv,
        env=env,
        command_sha256=command_sha256,
        command_mode=command_mode,
        frozen_tree=frozen_tree,
        frozen_tree_sha256=frozen_tree_sha256,
        publication_argv_manifest_path=argv_path,
        publication_env_manifest_path=env_path,
        stdout_path=stdout_path,
        stderr_path=stderr_path,
        tracked=tracked,
    )
    stdout_state = stable_read(stdout_path, "process_stdout", allow_empty=True)
    stderr_state = stable_read(stderr_path, "process_stderr", allow_empty=True)
    if require_stdout_empty and stdout_state.raw:
        fail("process_stdout_not_empty:" + label)
    if require_stderr_empty and stderr_state.raw:
        fail("process_stderr_not_empty:" + label)
    resource_pin = None
    if resource_trace:
        resource_state = stable_read(resource_path, "resource_trace")
        trace_rows = resource_state.raw.decode("ascii", "strict").splitlines()
        if len(trace_rows) < 2:
            fail("resource_trace_too_short:" + label)
        for row in trace_rows:
            fields = row.split("\t")
            if len(fields) != 2:
                fail("resource_trace_row_invalid:" + label)
            require_uint(fields[0], "resource_trace_time", positive=True)
            require_uint(fields[1], "resource_trace_kib")
        resource_pin = path_pin(resource_state)
    return {
        "schema": PROCESS_SCHEMA,
        "label": label,
        "commandMode": command_mode,
        "commandSha256": command_sha256,
        "argv": path_pin(argv_state),
        "env": path_pin(env_state),
        "guard": path_pin(report_state),
        "stdout": path_pin(stdout_state),
        "stderr": path_pin(stderr_state),
        "resourceTrace": resource_pin,
        "tracked": [
            {
                "label": tracked_label,
                "kind": kind,
                "artifact": path_pin(
                    stable_read(
                        path,
                        "process_tracked_" + tracked_label,
                        executable=kind == "executable",
                    )
                ),
            }
            for tracked_label, path, kind in tracked
        ],
        "wallNs": ended - started,
        "peakBytes": int(report["process_tree_enforced_peak_bytes"]),
    }


def validate_published_runtime_process_directory(
    process_dir: pathlib.Path,
    publish_root: pathlib.Path,
    frozen_digest_cache: dict[pathlib.Path, str],
) -> dict[str, str]:
    process_dir = canonical_existing(
        process_dir,
        "published_process_directory",
        directory=True,
    )
    try:
        process_dir.relative_to(publish_root)
    except ValueError:
        fail("published_process_outside_release_root")
    process_dir_info = process_dir.lstat()
    if (
        stat.S_IMODE(process_dir_info.st_mode) != 0o700
        or process_dir_info.st_uid != os.geteuid()
        or process_dir_info.st_gid != os.getegid()
    ):
        fail("published_process_directory_private_owner_invalid")
    argv_value, argv_state = canonical_json_state(
        process_dir / "argv.json",
        "published_process_argv",
    )
    env_value, env_state = canonical_json_state(
        process_dir / "env.json",
        "published_process_env",
    )
    (
        physical_argv_raw,
        logical_argv_raw,
        physical_argv_digest,
        _,
    ) = validate_publication_channel_manifest(argv_value, kind="argv")
    physical_env_raw, _, physical_env_digest, _ = (
        validate_publication_channel_manifest(env_value, kind="env")
    )
    if (
        not isinstance(argv_value, dict)
        or not isinstance(env_value, dict)
        or not isinstance(physical_argv_raw, list)
        or not isinstance(logical_argv_raw, list)
        or not isinstance(physical_env_raw, dict)
        or logical_path_from_fshex(
            argv_value["publishRootFshex"],
            "published_process_argv_root",
        )
        != publish_root
        or logical_path_from_fshex(
            env_value["publishRootFshex"],
            "published_process_env_root",
        )
        != publish_root
        or argv_value["workRootFshex"] != env_value["workRootFshex"]
        or env_value["supportPaths"] != []
    ):
        fail("published_process_manifest_roots_invalid")
    support = publication_support_path_map(argv_value, kind="argv")
    base_paths = {
        "argv_manifest": argv_state.path,
        "env_manifest": env_state.path,
        "guard_report": process_dir / "guard.kv",
        "stdout": process_dir / "stdout.bin",
        "stderr": process_dir / "stderr.bin",
    }
    for role, expected_path in base_paths.items():
        pair = support.get(role)
        if pair is None or pair[1] != expected_path:
            fail("published_process_support_path_invalid:" + role)
        observed_info = expected_path.lstat()
        if (
            not stat.S_ISREG(observed_info.st_mode)
            or stat.S_ISLNK(observed_info.st_mode)
            or observed_info.st_nlink != 1
            or stat.S_IMODE(observed_info.st_mode) != 0o400
        ):
            fail("published_process_support_mode_invalid:" + role)
    report_rows, report_state = parse_kv(
        base_paths["guard_report"],
        "published_process_guard",
    )
    validate_guard_completion_rows(report_rows)
    if (
        report_rows.get("report_path") != str(support["guard_report"][0])
        or report_rows.get("command_argv_count")
        != str(len(physical_argv_raw))
        or report_rows.get("command_argv_sha256")
        != physical_argv_digest
        or report_rows.get("target_env_requested_count")
        != str(len(physical_env_raw))
        or report_rows.get("target_env_requested_sha256")
        != physical_env_digest
    ):
        fail("published_process_guard_physical_channel_invalid")
    command_rows = [
        row
        for row in argv_value["pathRoles"]
        if isinstance(row, dict) and row.get("role") == "command"
    ]
    if (
        len(command_rows) != 1
        or command_rows[0].get("selector") != "0"
        or command_rows[0].get("prefixUtf8Hex") != ""
    ):
        fail("published_process_command_role_invalid")
    command_path = logical_path_from_fshex(
        command_rows[0]["logicalPathFshex"],
        "published_process_command",
    )
    command_state = stable_read(
        command_path,
        "published_process_command",
        executable=True,
    )
    if (
        logical_argv_raw[0] != str(command_path)
        or report_rows.get("command_sha256") != command_state.sha256
    ):
        fail("published_process_command_identity_invalid")
    frozen_pair = support.get("frozen_tree")
    if frozen_pair is None:
        fail("published_process_frozen_tree_support_missing")
    canonical_existing(
        frozen_pair[1],
        "published_process_frozen_tree",
        directory=True,
    )
    frozen_sha256 = require_sha(
        report_rows.get("private_frozen_tree_expected_sha256"),
        "published_process_frozen_tree",
    )
    observed_frozen_sha256 = frozen_digest_cache.get(frozen_pair[1])
    if observed_frozen_sha256 is None:
        observed_frozen_sha256 = private_tree_digest(frozen_pair[1])
        frozen_digest_cache[frozen_pair[1]] = observed_frozen_sha256
    if (
        observed_frozen_sha256 != frozen_sha256
        or report_rows.get("private_frozen_tree_root")
        != str(frozen_pair[0])
    ):
        fail("published_process_frozen_tree_identity_invalid")
    tracked_count = require_uint(
        report_rows.get("tracked_output_count"),
        "published_process_tracked_count",
    )
    raw_tracked: list[tuple[str, pathlib.Path, str]] = []
    observed_tracked: list[tuple[str, pathlib.Path, str]] = []
    expected_support_roles = {
        *base_paths,
        "frozen_tree",
    }
    for item in tracked_output_rows(report_rows, tracked_count):
        label = str(item.get("label", ""))
        kind = str(item.get("required_mode", ""))
        role = "tracked_" + label
        pair = support.get(role)
        if (
            LABEL_RE.fullmatch(label) is None
            or kind not in ("regular", "executable")
            or pair is None
            or item.get("path") != str(pair[0])
        ):
            fail("published_process_tracked_support_invalid:" + label)
        expected_support_roles.add(role)
        observed_info = pair[1].lstat()
        required_mode = 0o500 if kind == "executable" else 0o400
        if (
            not stat.S_ISREG(observed_info.st_mode)
            or stat.S_ISLNK(observed_info.st_mode)
            or observed_info.st_nlink != 1
            or stat.S_IMODE(observed_info.st_mode) != required_mode
        ):
            fail("published_process_tracked_mode_invalid:" + label)
        raw_tracked.append((label, pair[0], kind))
        observed_tracked.append((label, pair[1], kind))
    resource_status = report_rows.get("resource_trace_status")
    if resource_status == "available":
        resource_pair = support.get("resource_trace")
        if (
            resource_pair is None
            or report_rows.get("resource_trace_path")
            != str(resource_pair[0])
        ):
            fail("published_process_resource_support_invalid")
        expected_support_roles.add("resource_trace")
        resource_state = stable_read(
            resource_pair[1],
            "published_process_resource_trace",
        )
        if stat.S_IMODE(resource_state.info.st_mode) != 0o400:
            fail("published_process_resource_mode_invalid")
        try:
            trace_rows = resource_state.raw.decode(
                "ascii",
                "strict",
            ).splitlines()
        except UnicodeError:
            fail("published_process_resource_trace_not_ascii")
        if len(trace_rows) < 2:
            fail("published_process_resource_trace_too_short")
        for trace_row in trace_rows:
            fields = trace_row.split("\t")
            if len(fields) != 2:
                fail("published_process_resource_trace_row_invalid")
            require_uint(
                fields[0],
                "published_process_resource_trace_time",
                positive=True,
            )
            require_uint(
                fields[1],
                "published_process_resource_trace_kib",
            )
        expected_resource = {
            "sha256": resource_state.sha256,
            "device": str(resource_state.info.st_dev),
            "inode": str(resource_state.info.st_ino),
            "size": str(resource_state.info.st_size),
        }
        for key, expected in expected_resource.items():
            if report_rows.get("resource_trace_" + key) != expected:
                fail("published_process_resource_identity_invalid:" + key)
    elif (
        resource_status != "disabled"
        or report_rows.get("resource_trace_path") != ""
        or report_rows.get("resource_trace_sha256") != ""
        or report_rows.get("resource_trace_device") != "0"
        or report_rows.get("resource_trace_inode") != "0"
        or report_rows.get("resource_trace_size") != "0"
        or "resource_trace" in support
    ):
        fail("published_process_resource_disabled_invalid")
    if (
        report_rows.get("phase_trace_status") != "disabled"
        or report_rows.get("phase_trace_path") != ""
        or report_rows.get("phase_trace_sha256") != ""
        or report_rows.get("phase_trace_device") != "0"
        or report_rows.get("phase_trace_inode") != "0"
        or report_rows.get("phase_trace_size") != "0"
        or set(support) != expected_support_roles
    ):
        fail("published_process_support_authority_invalid")
    validate_guard_report(
        base_paths["guard_report"],
        argv=tuple(str(value) for value in physical_argv_raw),
        env={
            str(key): str(value)
            for key, value in physical_env_raw.items()
        },
        command_sha256=command_state.sha256,
        command_mode="private_frozen_tree_direct",
        frozen_tree=frozen_pair[0],
        frozen_tree_sha256=frozen_sha256,
        publication_argv_manifest_path=support["argv_manifest"][0],
        publication_env_manifest_path=support["env_manifest"][0],
        stdout_path=support["stdout"][0],
        stderr_path=support["stderr"][0],
        tracked=tuple(raw_tracked),
        publication_argv_manifest_observed_path=support[
            "argv_manifest"
        ][1],
        publication_env_manifest_observed_path=support[
            "env_manifest"
        ][1],
        stdout_observed_path=support["stdout"][1],
        stderr_observed_path=support["stderr"][1],
        tracked_observed=tuple(observed_tracked),
    )
    expected_direct_members = {
        pair[1].name
        for pair in support.values()
        if pair[1].parent == process_dir
    }
    observed_direct_members = {
        path.name for path in process_dir.iterdir()
    }
    if observed_direct_members != expected_direct_members:
        fail("published_process_direct_member_authority_invalid")
    for name in expected_direct_members:
        path = process_dir / name
        info = path.lstat()
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_nlink != 1
        ):
            fail("published_process_direct_member_invalid:" + name)
    return {
        "argvRaw32": argv_state.sha256,
        "envRaw32": env_state.sha256,
        "guardRaw32": report_state.sha256,
        "physicalDigest": hashlib.sha256(
            frame(bytes.fromhex(str(argv_value["physicalDigest"])))
            + frame(bytes.fromhex(str(env_value["physicalDigest"])))
        ).hexdigest(),
        "logicalDigest": hashlib.sha256(
            frame(bytes.fromhex(str(argv_value["logicalDigest"])))
            + frame(bytes.fromhex(str(env_value["logicalDigest"])))
        ).hexdigest(),
        "pathRoleDigest": hashlib.sha256(
            frame(bytes.fromhex(str(argv_value["pathRoleDigest"])))
            + frame(bytes.fromhex(str(env_value["pathRoleDigest"])))
        ).hexdigest(),
        "supportPathRoleDigest": hashlib.sha256(
            frame(bytes.fromhex(str(argv_value["supportPathRoleDigest"])))
            + frame(bytes.fromhex(str(env_value["supportPathRoleDigest"])))
        ).hexdigest(),
    }


def validate_published_runtime_process_tree(
    out: pathlib.Path,
    publish_root: pathlib.Path,
) -> tuple[int, dict[str, str]]:
    process_root = canonical_existing(
        out / "processes",
        "published_process_root",
        directory=True,
    )
    process_root_info = process_root.lstat()
    if (
        stat.S_IMODE(process_root_info.st_mode) != 0o700
        or process_root_info.st_uid != os.geteuid()
        or process_root_info.st_gid != os.getegid()
    ):
        fail("published_process_root_private_owner_invalid")
    process_dirs = sorted(
        process_root.iterdir(),
        key=lambda path: os.fsencode(path.name),
    )
    if not process_dirs:
        fail("published_process_tree_empty")
    frozen_digest_cache: dict[pathlib.Path, str] = {}
    seen: set[str] = set()
    authority_rows: list[tuple[str, dict[str, str]]] = []
    for process_dir in process_dirs:
        if (
            LABEL_RE.fullmatch(process_dir.name) is None
            or process_dir.name in seen
        ):
            fail("published_process_label_invalid")
        seen.add(process_dir.name)
        authority_rows.append(
            (
                process_dir.name,
                validate_published_runtime_process_directory(
                    process_dir,
                    publish_root,
                    frozen_digest_cache,
                ),
            )
        )
    authority: dict[str, str] = {}
    for field in (
        "argvRaw32",
        "envRaw32",
        "guardRaw32",
        "physicalDigest",
        "logicalDigest",
        "pathRoleDigest",
        "supportPathRoleDigest",
    ):
        payload = bytearray(
            frame(
                (
                    "cheng.darwin_current_release_runtime_process_"
                    + field
                ).encode("ascii")
            )
        )
        payload.extend(struct.pack(">I", len(authority_rows)))
        for label, row in authority_rows:
            payload.extend(frame(os.fsencode(label)))
            payload.extend(bytes.fromhex(row[field]))
        authority[field] = hashlib.sha256(payload).hexdigest()
    return len(process_dirs), authority


def publish_executable(
    *,
    label: str,
    origin: pathlib.Path,
    source_process: dict[str, object],
    out: pathlib.Path,
) -> tuple[pathlib.Path, pathlib.Path, str, FileState]:
    origin_state = stable_read(origin, "publication_origin", executable=True)
    publication_root = out / "published" / label
    publication_root.mkdir(mode=0o700, parents=True)
    command = publication_root / "command"
    snapshot_state = exclusive_copy(
        origin,
        command,
        executable=True,
        expected_sha256=origin_state.sha256,
        expected_size=origin_state.info.st_size,
    )
    os.chmod(publication_root, 0o555)
    digest = private_tree_digest(publication_root)
    receipt = {
        "schema": PUBLICATION_SCHEMA,
        "status": "FROZEN",
        "label": label,
        "origin": path_pin(origin_state),
        "snapshot": path_pin(snapshot_state),
        "originSnapshotRawBytesEqual": True,
        "treeRootFshex":
            os.fsencode(str(published_path(publication_root))).hex(),
        "treeSha256": digest,
        "sourceProcessGuardSha256": source_process["guard"]["sha256"],
    }
    (out / "publications").mkdir(mode=0o700, parents=True, exist_ok=True)
    receipt_state = exclusive_write(
        out / "publications" / (label + ".json"),
        canonical_json_bytes(receipt),
        0o400,
    )
    return command, publication_root, digest, receipt_state


