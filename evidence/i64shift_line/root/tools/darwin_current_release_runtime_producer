def lldb_inventory_digest(
    rows: list[dict[str, object]], shared_cache_uuid: str
) -> str:
    if re.fullmatch(r"[0-9a-f]{32}", shared_cache_uuid) is None:
        fail("lldb_shared_cache_uuid_invalid")
    payload = bytearray(frame(b"cheng.lldb.dyld_inventory"))
    payload.extend(frame(bytes.fromhex(shared_cache_uuid)))
    payload.extend(struct.pack(">I", len(rows)))
    for index, row in enumerate(rows):
        if (
            row.get("ordinal") != index
            or row.get("sharedCache") not in (0, 1)
            or isinstance(row.get("sharedCache"), bool)
        ):
            fail("lldb_inventory_row_shape_invalid")
        try:
            path_raw = bytes.fromhex(str(row.get("pathFshex")))
        except ValueError as exc:
            fail("lldb_inventory_path_fshex_invalid:" + str(exc))
        payload.extend(struct.pack(">I", index))
        payload.extend(frame(path_raw))
        payload.append(int(row["sharedCache"]))
    return hashlib.sha256(payload).hexdigest()


