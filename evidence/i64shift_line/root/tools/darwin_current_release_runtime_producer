def parse_lldb_inventory(
    stdout: bytes,
) -> tuple[list[dict[str, object]], str, str]:
    try:
        lines = stdout.decode("ascii", "strict").splitlines()
    except UnicodeError as exc:
        fail("lldb_inventory_stdout_not_ascii:" + str(exc))
    begin = "cheng_lldb_dyld_inventory_begin=1"
    end = "cheng_lldb_dyld_inventory_end=1"
    if lines.count(begin) != 1 or lines.count(end) != 1:
        fail("lldb_inventory_frame_count_invalid")
    start = lines.index(begin)
    finish = lines.index(end)
    if finish <= start:
        fail("lldb_inventory_frame_order_invalid")
    for index, line in enumerate(lines):
        if (
            (index < start or index > finish)
            and line.startswith("cheng_lldb_dyld_")
        ):
            fail("lldb_inventory_marker_outside_frame")
    block = lines[start + 1 : finish]
    cursor = 0

    def take(prefix: str) -> str:
        nonlocal cursor
        if cursor >= len(block) or not block[cursor].startswith(prefix):
            fail("lldb_inventory_field_missing:" + prefix)
        value = block[cursor][len(prefix) :]
        cursor += 1
        return value

    if (
        take("cheng_lldb_dyld_inventory_schema=")
        != LLDB_INVENTORY_SCHEMA
    ):
        fail("lldb_inventory_schema_invalid")
    shared_cache_uuid = take("cheng_lldb_dyld_shared_cache_uuid=")
    if re.fullmatch(r"[0-9a-f]{32}", shared_cache_uuid) is None:
        fail("lldb_inventory_uuid_invalid")
    image_count = require_uint(
        take("cheng_lldb_dyld_image_count="),
        "lldb_inventory_image_count",
        positive=True,
    )
    rows: list[dict[str, object]] = []
    for index in range(image_count):
        prefix = "cheng_lldb_dyld_image." + str(index) + "."
        ordinal = require_uint(
            take(prefix + "ordinal="), "lldb_inventory_ordinal"
        )
        if ordinal != index:
            fail("lldb_inventory_ordinal_invalid")
        path_fshex = take(prefix + "pathFshex=")
        try:
            path_raw = bytes.fromhex(path_fshex)
        except ValueError as exc:
            fail("lldb_inventory_path_invalid:" + str(exc))
        if not path_raw.startswith(b"/") or b"\0" in path_raw:
            fail("lldb_inventory_path_not_absolute")
        shared = require_uint(
            take(prefix + "sharedCache="), "lldb_inventory_shared_bit"
        )
        if shared not in (0, 1):
            fail("lldb_inventory_shared_bit_invalid")
        rows.append(
            {
                "ordinal": ordinal,
                "pathFshex": path_fshex,
                "sharedCache": shared,
            }
        )
    order_sha256 = take("cheng_lldb_dyld_image_order_sha256=")
    require_sha(order_sha256, "lldb_inventory_order")
    if cursor != len(block):
        fail("lldb_inventory_unexpected_field")
    if order_sha256 != lldb_inventory_digest(rows, shared_cache_uuid):
        fail("lldb_inventory_order_digest_mismatch")
    return rows, shared_cache_uuid, order_sha256


def validate_lldb_inventory_rows(
    rows: list[dict[str, object]],
    shared_cache_uuid: str,
    expected_order_sha256: str,
    private_tree: pathlib.Path,
    closure_members: set[bytes],
) -> dict[str, int]:
    if (
        lldb_inventory_digest(rows, shared_cache_uuid)
        != require_sha(expected_order_sha256, "lldb_inventory_expected_order")
    ):
        fail("lldb_inventory_expected_order_mismatch")
    private_prefix = os.fsencode(str(private_tree)) + b"/"
    original_xcode = os.fsencode(str(XCODE_ROOT))
    seen: set[bytes] = set()
    counts = {
        "private": 0,
        "shared": 0,
        "originalXcode": 0,
        "other": 0,
    }
    for index, row in enumerate(rows):
        if row.get("ordinal") != index:
            fail("lldb_inventory_order_invalid")
        path_raw = bytes.fromhex(str(row.get("pathFshex")))
        shared = row.get("sharedCache")
        if (
            path_raw in seen
            or not path_raw.startswith(b"/")
            or b"\0" in path_raw
            or shared not in (0, 1)
            or isinstance(shared, bool)
            or os.path.normpath(path_raw) != path_raw
        ):
            fail("lldb_inventory_row_invalid")
        seen.add(path_raw)
        if path_raw == original_xcode or path_raw.startswith(
            original_xcode + b"/"
        ):
            counts["originalXcode"] += 1
            fail("lldb_inventory_original_xcode_residual")
        if path_raw.startswith(private_prefix):
            counts["private"] += 1
            if shared != 0 or path_raw not in closure_members:
                fail("lldb_inventory_private_image_not_materialized")
            continue
        if path_raw.startswith((b"/usr/", b"/System/")):
            counts["shared"] += 1
            if shared != 1:
                fail("lldb_inventory_shared_image_bit_invalid")
            continue
        counts["other"] += 1
        fail("lldb_inventory_other_image")
    if counts["private"] <= 0 or counts["shared"] <= 0:
        fail("lldb_inventory_class_empty")
    return counts


def validate_lldb_evidence_receipt(
