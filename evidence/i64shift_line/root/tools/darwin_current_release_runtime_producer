        receipt["schema"] != LLDB_EVIDENCE_SCHEMA
        or receipt["status"] != "COMPLETE"
        or LABEL_RE.fullmatch(str(receipt["label"])) is None
    ):
        fail("lldb_evidence_header_invalid")
    closure_receipt = validate_pin(
        receipt["closureReceipt"], "lldb_closure_receipt"
    )
    closure, _, closure_members = validate_lldb_materialized_closure(
        closure_receipt.path,
        identity=identity,
        tools=tools,
    )
    tree = path_from_fshex(closure["treeRootFshex"], "lldb_evidence_tree")
    command = validate_pin(
        closure["command"], "lldb_evidence_command", executable=True
    )
    debug_object = validate_pin(
        closure["debugObject"], "lldb_evidence_debug_object"
    )
    argv_pin = validate_pin(
        receipt["argvManifest"], "lldb_argv_manifest"
    )
    env_pin = validate_pin(receipt["envManifest"], "lldb_env_manifest")
    argv_value, argv_state = canonical_json_state(
        argv_pin.path,
        "lldb_argv_manifest",
    )
    env_value, env_state = canonical_json_state(
        env_pin.path,
        "lldb_env_manifest",
    )
    if (
        path_pin(argv_state) != receipt["argvManifest"]
        or path_pin(env_state) != receipt["envManifest"]
        or not isinstance(argv_value, dict)
        or not isinstance(env_value, dict)
    ):
        fail("lldb_evidence_manifest_shape_invalid")
    if receipt_path != closure_receipt.path.parent / "evidence.json":
        fail("lldb_evidence_path_invalid")
    physical_argv_raw, logical_argv_raw, _, _ = (
        validate_publication_channel_manifest(argv_value, kind="argv")
    )
    physical_env_raw, logical_env_raw, _, _ = (
        validate_publication_channel_manifest(env_value, kind="env")
    )
    publication_support = publication_support_path_map(
        argv_value,
        kind="argv",
    )
    if (
        not isinstance(physical_argv_raw, list)
        or not isinstance(logical_argv_raw, list)
        or not isinstance(physical_env_raw, dict)
        or not isinstance(logical_env_raw, dict)
    ):
        fail("lldb_evidence_manifest_channel_invalid")
    argv = tuple(str(value) for value in physical_argv_raw)
    logical_argv = tuple(str(value) for value in logical_argv_raw)
    env = {str(key): str(value) for key, value in physical_env_raw.items()}
    logical_env = {
        str(key): str(value) for key, value in logical_env_raw.items()
    }
    validate_lldb_command_argv(
        logical_argv,
        published_path(command.path),
        published_path(debug_object.path),
        pathlib.Path(ORC_SOURCE).name,
    )
    if (
        logical_env != lldb_exact_env(published_path(tree))
    ):
        fail("lldb_evidence_command_binding_invalid")
    stdout = validate_pin(receipt["stdout"], "lldb_evidence_stdout")
    stderr = validate_pin(receipt["stderr"], "lldb_evidence_stderr")
    if stderr.raw:
        fail("lldb_evidence_stderr_not_empty")
    guard = validate_pin(receipt["processGuard"], "lldb_evidence_guard")
    _, validated_guard = validate_guard_report(
        guard.path,
        argv=argv,
        env=env,
        command_sha256=command.sha256,
        command_mode="private_frozen_tree_direct",
        frozen_tree=publication_support["frozen_tree"][0],
        frozen_tree_sha256=str(closure["treeSha256"]),
        publication_argv_manifest_path=publication_support[
            "argv_manifest"
        ][0],
        publication_env_manifest_path=publication_support[
            "env_manifest"
        ][0],
        stdout_path=publication_support["stdout"][0],
        stderr_path=publication_support["stderr"][0],
        tracked=(),
        publication_argv_manifest_observed_path=argv_pin.path,
        publication_env_manifest_observed_path=env_pin.path,
        stdout_observed_path=stdout.path,
        stderr_observed_path=stderr.path,
        frozen_tree_observed_path=tree,
    )
    if validated_guard.sha256 != guard.sha256:
        fail("lldb_evidence_guard_identity_mismatch")
    rows, uuid, order_sha256 = parse_lldb_inventory(stdout.raw)
    counts = validate_lldb_inventory_rows(
        rows,
        uuid,
        order_sha256,
        tree,
        closure_members,
    )
    if (
        receipt["sharedCacheUuid"] != uuid
        or receipt["imageOrderSha256"] != order_sha256
        or receipt["images"] != rows
        or receipt["imageCount"] != len(rows)
        or receipt["privateImageCount"] != counts["private"]
        or receipt["sharedImageCount"] != counts["shared"]
        or receipt["originalXcodeImageCount"] != counts["originalXcode"]
        or receipt["otherImageCount"] != counts["other"]
    ):
        fail("lldb_evidence_observation_mismatch")
    return receipt_state


def lldb_inspect(
    *,
    label: str,
    executable: pathlib.Path,
    source_process: dict[str, object],
    root: pathlib.Path,
    out: pathlib.Path,
    identity: dict[str, object],
    tools: dict[str, dict[str, object]],
) -> tuple[dict[str, object], FileState, FileState]:
    (
        command,
        debug_object,
        tree,
        tree_digest,
        closure_receipt,
    ) = materialize_lldb_command_tree(
        label=label,
        debug_origin=executable,
        source_process=source_process,
        out=out,
        identity=identity,
        tools=tools,
    )
    argv = lldb_command_argv(
        command,
        debug_object.path,
        pathlib.Path(ORC_SOURCE).name,
    )
    validate_lldb_command_argv(
        argv,
        command,
        debug_object.path,
        pathlib.Path(ORC_SOURCE).name,
    )
    env = lldb_exact_env(tree)
    command_state = stable_read(
        command, "lldb_private_command", executable=True
    )
    process = run_guarded(
        label=label,
        root=root,
        out=out,
        tools=tools,
        argv=argv,
        env=env,
        argv_path_roles=(
            ArgvPathRole(0, "command", "", command),
            ArgvPathRole(
                4,
                "debug_object",
                "target create ",
                debug_object.path,
            ),
        ),
        env_path_roles=(
            EnvPathRole(
                "PYTHONHOME",
                "python_home",
                tree_destination(tree, XCODE_PYTHON39),
            ),
            EnvPathRole(
                "PYTHONPATH",
                "python_path",
                tree_destination(tree, XCODE_LLDB_PYTHON),
            ),
        ),
        command_sha256=command_state.sha256,
        command_mode="private_frozen_tree_direct",
        frozen_tree=tree,
        frozen_tree_sha256=tree_digest,
        timeout_seconds=120,
        require_stdout_empty=False,
        require_stderr_empty=True,
    )
    stdout = validate_pin(process["stdout"], "lldb_stdout").raw
    required = (
        b"Current executable set to",
        b"__DWARF",
        b"__debug_line",
        os.fsencode(pathlib.Path(ORC_SOURCE).name),
    )
    if any(fragment not in stdout for fragment in required):
        fail("lldb_debug_proof_incomplete:" + label)
    rows, uuid, order_sha256 = parse_lldb_inventory(stdout)
    closure, _, closure_members = validate_lldb_materialized_closure(
        closure_receipt.path,
        identity=identity,
        tools=tools,
    )
    counts = validate_lldb_inventory_rows(
        rows,
        uuid,
        order_sha256,
        tree,
        closure_members,
    )
    evidence = {
        "schema": LLDB_EVIDENCE_SCHEMA,
        "status": "COMPLETE",
        "label": label,
        "closureReceipt": path_pin(closure_receipt),
        "processGuard": process["guard"],
        "argvManifest": process["argv"],
        "envManifest": process["env"],
        "stdout": process["stdout"],
        "stderr": process["stderr"],
        "sharedCacheUuid": uuid,
        "imageCount": len(rows),
        "privateImageCount": counts["private"],
        "sharedImageCount": counts["shared"],
        "originalXcodeImageCount": counts["originalXcode"],
        "otherImageCount": counts["other"],
        "imageOrderSha256": order_sha256,
        "images": rows,
    }
    evidence_state = exclusive_write(
        closure_receipt.path.parent / "evidence.json",
        canonical_json_bytes(evidence),
        0o400,
    )
    validate_lldb_evidence_receipt(
        evidence_state.path,
        identity=identity,
        tools=tools,
    )
    if closure["treeSha256"] != tree_digest:
        fail("lldb_closure_tree_digest_drift")
    return process, debug_object, evidence_state


def validate_sample_schedule(
    samples: list[dict[str, object]], schedule: list[dict[str, object]]
) -> None:
    if len(samples) != 12 or len(schedule) != 12:
        fail("performance_sample_count_invalid")
    seen_artifacts: set[str] = set()
    for index, (sample, expected) in enumerate(zip(samples, schedule)):
        for key in ("ordinal", "block", "order", "position", "jobs", "role"):
            if sample.get(key) != expected.get(key):
                fail("performance_sample_order_invalid:" + str(index) + ":" + key)
        if require_uint(sample.get("wallNs"), "performance_wall", positive=True) <= 0:
            fail("performance_wall_invalid")
        peak = require_uint(sample.get("peakBytes"), "performance_peak", positive=True)
        if peak > LIMIT_BYTES:
            fail("performance_peak_exceeds_limit")
        artifacts = sample.get("artifacts")
        if not isinstance(artifacts, list) or len(artifacts) != 6:
            fail("performance_artifact_count_invalid")
        for artifact in artifacts:
            key = str(artifact.get("pathFshex", ""))
            if key in seen_artifacts:
                fail("performance_artifact_reused")
            seen_artifacts.add(key)


def validate_process_result(
    process: dict[str, object],
    *,
    require_stderr_empty: bool,
    expected_stdout: bytes | None = None,
) -> None:
    if process.get("schema") != PROCESS_SCHEMA:
        fail("process_result_schema_invalid")
    require_uint(process.get("wallNs"), "process_wall", positive=True)
    peak = require_uint(process.get("peakBytes"), "process_peak", positive=True)
    if peak > LIMIT_BYTES:
        fail("process_peak_exceeds_limit")
    stdout = validate_pin(process.get("stdout"), "process_stdout")
    stderr = validate_pin(process.get("stderr"), "process_stderr")
    if require_stderr_empty and stderr.raw:
        fail("process_result_stderr_not_empty")
    if expected_stdout is not None and stdout.raw != expected_stdout:
        fail("process_result_stdout_mismatch")


