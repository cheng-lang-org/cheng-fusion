#!/usr/bin/env python3
"""Validate current Linux cgroup-v2 deterministic-memory receipts."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path
from typing import Any, Sequence


sys.dont_write_bytecode = True

SCHEMA = "cheng.lifetime_orc_linux_cgroup_v2_hard_memory"
LIMIT_BYTES = 805_306_368
SWAP_MAX_BYTES = 0
PROCESS_SCOPE = "cgroup_and_all_descendants"
PROOF_STATUS = "proved_linux_kernel_cgroup_v2_aggregate"
EVENT_KEYS = {"low", "high", "max", "oom", "oom_kill", "oom_group_kill"}
LIMIT_EVENT_KEYS = ("max", "oom", "oom_kill", "oom_group_kill")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
TARGETS = {
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
}
MAX_RECEIPT_BYTES = 4 * 1024 * 1024

SUCCESS_KEYS = {
    "schema", "status", "driverRole", "dynamicStatus",
    "hardMemoryProofStatus", "memoryEnforcementScope", "memoryMax",
    "memorySwapMax", "memoryAndSwapTotalLimit", "memoryOomGroup",
    "memorySwapCurrent", "vmSwapTotal", "memoryPeak",
    "memoryEventsBefore", "memoryEventsAfter", "cgroupPath",
    "cgroupMountType", "cgroupType", "cgroupMountPath", "cgroupDevice",
    "cgroupInode", "cgroupCleanupStatus", "cgroupEmptyAfter",
    "limitEventsDeltaStatus", "processTreePlacementStatus", "target",
    "sourceTreeSha256", "lifetimeDriverSha256", "orcDriverSha256",
    "lifetimeGateStdoutSha256", "orcGateStdoutSha256",
    "lifetimeRootAttachment", "orcRootAttachment", "gateEnvironmentSha256",
    "lifetimeContract", "orcContract", "contractSourceSha256",
    "userSpaceSamplingAuthority", "releaseScope", "receiptSha256",
}
FAILURE_KEYS = {
    "schema", "status", "driverRole", "dynamicStatus",
    "hardMemoryProofStatus", "memoryEnforcementScope", "memoryMax",
    "memorySwapMax", "memoryAndSwapTotalLimit", "cgroupParent", "reason",
    "hostSystem", "hostMachine", "userSpaceSamplingAuthority",
    "releaseScope", "receiptSha256",
}


class ReceiptError(RuntimeError):
    pass


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ReceiptError("duplicate_json_key:" + key)
        result[key] = value
    return result


def exact_file(path: Path) -> bytes:
    if not path.is_absolute() or path.resolve(strict=True) != path:
        raise ReceiptError("receipt_path_not_canonical")
    before = path.stat(follow_symlinks=False)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_size <= 0
        or before.st_size > MAX_RECEIPT_BYTES
    ):
        raise ReceiptError("receipt_identity_invalid")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            raise ReceiptError("receipt_open_race")
        raw = b""
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                raise ReceiptError("receipt_short_read")
            raw += chunk
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise ReceiptError("receipt_grew_while_reading")
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.stat(follow_symlinks=False)
    if identity(before) != identity(closed) or identity(before) != identity(after):
        raise ReceiptError("receipt_read_race")
    return raw


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def require_exact_int(value: Any, expected: int, label: str) -> None:
    if type(value) is not int or value != expected:
        raise ReceiptError(label + "_invalid")


def require_uint(value: Any, label: str, *, positive: bool = False) -> int:
    if type(value) is not int or value < (1 if positive else 0):
        raise ReceiptError(label + "_invalid")
    return value


def require_text(value: Any, expected: str, label: str) -> None:
    if not isinstance(value, str) or value != expected:
        raise ReceiptError(label + "_invalid")


def require_sha(value: Any, label: str) -> None:
    if (
        not isinstance(value, str)
        or not SHA256_RE.fullmatch(value)
        or value == "0" * 64
    ):
        raise ReceiptError(label + "_invalid")


def validate_common(receipt: dict[str, Any]) -> None:
    require_text(receipt.get("schema"), SCHEMA, "schema")
    require_text(receipt.get("driverRole"), "production", "driver_role")
    require_text(
        receipt.get("memoryEnforcementScope"),
        PROCESS_SCOPE,
        "memory_scope",
    )
    require_exact_int(receipt.get("memoryMax"), LIMIT_BYTES, "memory_max")
    require_exact_int(receipt.get("memorySwapMax"), SWAP_MAX_BYTES, "memory_swap_max")
    require_exact_int(
        receipt.get("memoryAndSwapTotalLimit"),
        LIMIT_BYTES,
        "memory_and_swap_total",
    )
    require_exact_int(
        receipt.get("userSpaceSamplingAuthority"),
        0,
        "user_space_sampling_authority",
    )
    require_text(
        receipt.get("releaseScope"),
        "deterministic_memory_lane_only",
        "release_scope",
    )


def validate_events(value: Any, label: str) -> dict[str, int]:
    if not isinstance(value, dict) or set(value) != EVENT_KEYS:
        raise ReceiptError(label + "_keys_invalid")
    for key, count in value.items():
        require_uint(count, label + "_" + key)
    return value


def validate_attachment(value: Any, label: str) -> str:
    expected_keys = {
        "rootPid", "membership", "initialCgroupProcs",
        "attachmentPhase", "descendantPlacement",
    }
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise ReceiptError(label + "_keys_invalid")
    root_pid = require_uint(value["rootPid"], label + "_root_pid", positive=True)
    membership = value["membership"]
    if (
        not isinstance(membership, str)
        or not membership.startswith("0::/")
        or "\n" in membership
        or "\r" in membership
    ):
        raise ReceiptError(label + "_membership_invalid")
    members = value["initialCgroupProcs"]
    if (
        not isinstance(members, list)
        or not members
        or any(type(pid) is not int or pid <= 0 for pid in members)
        or members != sorted(set(members))
        or root_pid not in members
    ):
        raise ReceiptError(label + "_initial_members_invalid")
    require_text(
        value["attachmentPhase"],
        "before_exec",
        label + "_attachment_phase",
    )
    require_text(
        value["descendantPlacement"],
        "kernel_inherited_same_leaf",
        label + "_descendant_placement",
    )
    return membership


def validate_success(receipt: dict[str, Any]) -> None:
    if set(receipt) != SUCCESS_KEYS:
        raise ReceiptError("success_field_set_invalid")
    validate_common(receipt)
    require_text(receipt["status"], "passed", "status")
    require_text(receipt["dynamicStatus"], "passed", "dynamic_status")
    require_text(
        receipt["hardMemoryProofStatus"],
        PROOF_STATUS,
        "proof_status",
    )
    require_exact_int(receipt["memoryOomGroup"], 1, "memory_oom_group")
    require_exact_int(receipt["memorySwapCurrent"], 0, "memory_swap_current")
    require_uint(receipt["vmSwapTotal"], "vm_swap_total")
    peak = require_uint(receipt["memoryPeak"], "memory_peak", positive=True)
    if peak > LIMIT_BYTES:
        raise ReceiptError("memory_peak_over_limit")
    before = validate_events(receipt["memoryEventsBefore"], "events_before")
    after = validate_events(receipt["memoryEventsAfter"], "events_after")
    for key in LIMIT_EVENT_KEYS:
        if after[key] != before[key]:
            raise ReceiptError("kernel_limit_event_delta:" + key)
    require_text(receipt["cgroupMountType"], "cgroup2", "cgroup_mount_type")
    require_text(receipt["cgroupType"], "domain", "cgroup_type")
    cgroup_path = receipt["cgroupPath"]
    mount_path = receipt["cgroupMountPath"]
    if (
        not isinstance(cgroup_path, str)
        or not isinstance(mount_path, str)
        or not cgroup_path.startswith(mount_path.rstrip("/") + "/")
        or "/cheng-lifetime-orc-current-" not in cgroup_path
    ):
        raise ReceiptError("cgroup_path_invalid")
    require_uint(receipt["cgroupDevice"], "cgroup_device", positive=True)
    require_uint(receipt["cgroupInode"], "cgroup_inode", positive=True)
    require_text(
        receipt["cgroupCleanupStatus"],
        "verified_absent",
        "cgroup_cleanup_status",
    )
    if receipt["cgroupEmptyAfter"] is not True:
        raise ReceiptError("cgroup_empty_after_invalid")
    require_text(
        receipt["limitEventsDeltaStatus"],
        "zero",
        "limit_events_delta_status",
    )
    require_text(
        receipt["processTreePlacementStatus"],
        "pre_exec_root_attached_descendants_same_leaf",
        "process_tree_placement_status",
    )
    if receipt["target"] not in TARGETS:
        raise ReceiptError("target_invalid")
    for key in (
        "sourceTreeSha256",
        "lifetimeDriverSha256",
        "orcDriverSha256",
        "lifetimeGateStdoutSha256",
        "orcGateStdoutSha256",
        "gateEnvironmentSha256",
        "contractSourceSha256",
    ):
        require_sha(receipt[key], key)
    lifetime_membership = validate_attachment(
        receipt["lifetimeRootAttachment"],
        "lifetime_attachment",
    )
    orc_membership = validate_attachment(
        receipt["orcRootAttachment"],
        "orc_attachment",
    )
    if lifetime_membership != orc_membership:
        raise ReceiptError("gate_cgroup_membership_drift")
    for key in ("lifetimeContract", "orcContract"):
        if not isinstance(receipt[key], dict) or not receipt[key]:
            raise ReceiptError(key + "_invalid")


def validate_failure(receipt: dict[str, Any]) -> None:
    if set(receipt) != FAILURE_KEYS:
        raise ReceiptError("failure_field_set_invalid")
    validate_common(receipt)
    require_text(receipt["status"], "hard_red", "status")
    require_text(receipt["dynamicStatus"], "red", "dynamic_status")
    require_text(receipt["hardMemoryProofStatus"], "not_proved", "proof_status")
    for key in ("cgroupParent", "reason", "hostSystem", "hostMachine"):
        value = receipt[key]
        if (
            not isinstance(value, str)
            or not value
            or "\n" in value
            or "\r" in value
        ):
            raise ReceiptError(key + "_invalid")


def validate_receipt(receipt: dict[str, Any]) -> str:
    if not isinstance(receipt, dict):
        raise ReceiptError("receipt_not_object")
    claimed = receipt.get("receiptSha256")
    require_sha(claimed, "receipt_sha256")
    payload = dict(receipt)
    del payload["receiptSha256"]
    actual = hashlib.sha256(canonical_json(payload)).hexdigest()
    if claimed != actual:
        raise ReceiptError("receipt_sha256_mismatch")
    status = receipt.get("status")
    if status == "passed":
        validate_success(receipt)
        return "passed"
    if status == "hard_red":
        validate_failure(receipt)
        return "hard_red"
    raise ReceiptError("status_invalid")


def validate_path(path: Path) -> str:
    raw = exact_file(path)
    if not raw.endswith(b"\n") or raw.count(b"\n") != 1 or b"\r" in raw:
        raise ReceiptError("receipt_framing_invalid")
    try:
        value = json.loads(
            raw[:-1].decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda value: (_ for _ in ()).throw(
                ReceiptError("non_finite_json:" + value)
            ),
        )
    except json.JSONDecodeError as error:
        raise ReceiptError("receipt_json_invalid") from error
    return validate_receipt(value)


def main(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Validate one current deterministic-memory hard-cap receipt"
    )
    parser.add_argument("receipt")
    args = parser.parse_args(argv)
    try:
        status = validate_path(Path(args.receipt))
        print("lifetime_orc_linux_hard_memory_receipt_validation=PASS")
        print("lifetime_orc_linux_hard_memory_receipt_status=" + status)
        return 0
    except (
        ReceiptError,
        OSError,
        ValueError,
        TypeError,
        KeyError,
        UnicodeError,
    ) as error:
        print(
            "lifetime_orc_linux_hard_memory_receipt_validation=HARD_RED",
            file=sys.stderr,
        )
        print(
            "lifetime_orc_linux_hard_memory_receipt_reason=" + str(error),
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
