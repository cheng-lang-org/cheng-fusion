    b"cheng.semantic_snapshot.acceptance.compiler_source_closure\x00"
MEMORY_LIMIT_BYTES = 1_073_741_824


def canonical_json_bytes(value: object) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True,
                       separators=(",", ":")) + "\n").encode("utf-8")


def framed_argv_cid(argv: list[str]) -> str:
    digest = hashlib.sha256()
    for argument in argv:
        raw = argument.encode("utf-8")
        digest.update(struct.pack(">Q", len(raw)))
        digest.update(raw)
    return digest.hexdigest()


def sha256_value(value: str) -> bool:
    return len(value) == 64 and all(char in "0123456789abcdef" for char in value)


def observed_cid(value: object) -> bool:
    return isinstance(value, str) and sha256_value(value) and \
        value != "0" * 64 and value != hashlib.sha256(b"").hexdigest()


def read_exact_regular(path: Path, expected_sha256: str, executable: bool = False,
                       capture: bool = False) -> tuple[str, int, bytes | None]:
    if not path.is_absolute():
        raise RuntimeError("feeder input path is not absolute")
    try:
        if path.resolve(strict=True) != path:
            raise RuntimeError("feeder input path is not canonical")
    except FileNotFoundError as error:
        raise RuntimeError("feeder input is missing") from error
    before = path.lstat()
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode) or \
       before.st_nlink != 1:
        raise RuntimeError("feeder input is not private regular data")
    if executable and before.st_mode & 0o111 == 0:
        raise RuntimeError("LSP input is not executable")
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    chunks: list[bytes] = []
    try:
        opened = os.fstat(descriptor)
        before_identity = (
            before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
            before.st_size, before.st_mtime_ns, before.st_ctime_ns,
        )
        opened_identity = (
            opened.st_dev, opened.st_ino, opened.st_mode, opened.st_nlink,
            opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns,
        )
        if before_identity != opened_identity:
            raise RuntimeError("feeder input changed before read")
        digest = hashlib.sha256()
        byte_count = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            byte_count += len(chunk)
            if capture:
                chunks.append(chunk)
        after_read = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    after_read_identity = (
        after_read.st_dev, after_read.st_ino, after_read.st_mode,
        after_read.st_nlink, after_read.st_size, after_read.st_mtime_ns,
        after_read.st_ctime_ns,
    )
    after_identity = (
        after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
        after.st_size, after.st_mtime_ns, after.st_ctime_ns,
    )
    if opened_identity != after_read_identity or \
       opened_identity != after_identity or byte_count != opened.st_size:
        raise RuntimeError("feeder input changed during read")
    observed_sha256 = digest.hexdigest()
    if not observed_cid(expected_sha256) or observed_sha256 != expected_sha256:
        raise RuntimeError("feeder input identity mismatch")
    return observed_sha256, byte_count, b"".join(chunks) if capture else None


def parse_key_value(raw: bytes, label: str) -> dict[str, str]:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError(f"{label} is not UTF-8") from error
    fields: dict[str, str] = {}
    for line in text.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or key in fields:
            raise RuntimeError(f"{label} has malformed or duplicate fields")
        fields[key] = value
    return fields


def validate_hardcap_bundle(receipt_path: Path, input_manifest_path: Path,
                            validator_path: Path, label: str) -> None:
    if receipt_path.name != "receipt.kv" or \
       input_manifest_path.name != "input-manifest.json" or \
       receipt_path.parent != input_manifest_path.parent or \
       receipt_path.parent.name != "workload":
        raise RuntimeError(f"{label} hardcap bundle paths mismatch")
    aggregate_dir = receipt_path.parent.parent / "aggregate-oom"
    completed = subprocess.run(
        [sys.executable, str(validator_path),
         "--evidence-dir", str(receipt_path.parent),
         "--aggregate-evidence-dir", str(aggregate_dir)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        timeout=120, check=False)
    if completed.returncode != 0 or \
       b"hard_gate_validation_status=passed_unique_current\n" not in \
           completed.stdout:
        raise RuntimeError(f"{label} hardcap bundle validation failed")


def validate_source_manifest(path: Path, expected_sha256: str,
                             expected_closure_cid: str) -> None:
    _, _, raw = read_exact_regular(path, expected_sha256, capture=True)
    assert raw is not None
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("compiler source manifest is not canonical JSON") from error
    if not isinstance(value, dict) or set(value) != {"schema", "sources"} or \
       value.get("schema") != SOURCE_MANIFEST_SCHEMA or \
       raw != canonical_json_bytes(value) or not isinstance(value.get("sources"), list):
        raise RuntimeError("compiler source manifest shape mismatch")
    rows = value["sources"]
    if len(rows) != len(COMPILER_SOURCE_CLOSURE):
        raise RuntimeError("compiler source closure incomplete")
    for index, row in enumerate(rows):
        if not isinstance(row, dict) or set(row) != {"name", "bytes", "sha256"} or \
           row.get("name") != COMPILER_SOURCE_CLOSURE[index] or \
           not isinstance(row.get("bytes"), int) or isinstance(row["bytes"], bool) or \
           row["bytes"] <= 0 or not observed_cid(row.get("sha256")):
            raise RuntimeError("compiler source manifest row invalid")
        _, byte_count, _ = read_exact_regular(
            (path.parent / row["name"]).absolute(), row["sha256"])
        if byte_count != row["bytes"]:
            raise RuntimeError("compiler source manifest size mismatch")
    observed_closure_cid = hashlib.sha256(
        SOURCE_CLOSURE_DOMAIN + canonical_json_bytes(rows)).hexdigest()
    if observed_closure_cid != expected_closure_cid:
        raise RuntimeError("compiler source closure identity mismatch")


def validate_build_evidence_files(value: dict[str, object], executable: Path,
                                  executable_sha256: str) -> None:
    evidence = value.get("build_evidence")
    if not isinstance(evidence, dict) or set(evidence) != BUILD_EVIDENCE_FIELDS or \
       evidence.get("schema") != "cheng.semantic_snapshot.lsp_build_evidence":
        raise RuntimeError("LSP build evidence shape mismatch")
    path_fields = (
        "lsp_executable_path", "lsp_build_report_path", "lsp_build_guard_path",
        "lsp_build_input_manifest_path",
        "compiler_executable_path", "compiler_build_report_path",
        "compiler_build_guard_path",
        "compiler_build_input_manifest_path", "compiler_source_manifest_path",
        "hardcap_validator_path", "build_exporter_path",
        "build_tool_manifest_path",
    )
    paths: dict[str, Path] = {}
    for field in path_fields:
        raw_path = evidence.get(field)
        if not isinstance(raw_path, str) or not raw_path or "\x00" in raw_path:
            raise RuntimeError(f"LSP build evidence path invalid: {field}")
        evidence_path = Path(raw_path)
        if not evidence_path.is_absolute():
            raise RuntimeError(f"LSP build evidence path is relative: {field}")
        paths[field] = evidence_path
    hash_fields = (
        "lsp_executable_sha256", "lsp_build_report_sha256",
        "lsp_build_guard_sha256", "lsp_build_input_manifest_sha256",
        "compiler_executable_sha256", "compiler_build_report_sha256",
        "compiler_build_guard_sha256",
        "compiler_build_input_manifest_sha256",
        "compiler_source_manifest_sha256", "compiler_source_closure_cid",
        "hardcap_validator_sha256", "build_exporter_sha256",
        "build_tool_manifest_sha256", "compiler_command_argv_cid",
        "compiler_build_argv_cid",
    )
    for field in hash_fields:
        if not observed_cid(evidence.get(field)):
            raise RuntimeError(f"LSP build evidence hash invalid: {field}")
    for field in ("lsp_build_argv", "compiler_build_argv"):
        argv = evidence.get(field)
        if not isinstance(argv, list) or not argv or \
           any(not isinstance(argument, str) or not argument or "\x00" in argument
               for argument in argv):
            raise RuntimeError(f"LSP build evidence argv invalid: {field}")
    lsp_build_argv = evidence["lsp_build_argv"]
    compiler_build_argv = evidence["compiler_build_argv"]
    if framed_argv_cid(lsp_build_argv) != evidence["compiler_command_argv_cid"] or \
       framed_argv_cid(compiler_build_argv) != evidence["compiler_build_argv_cid"]:
        raise RuntimeError("LSP build evidence argv CID mismatch")
    if paths["lsp_executable_path"] != executable.absolute() or \
       evidence["lsp_executable_sha256"] != executable_sha256:
        raise RuntimeError("LSP build evidence names a different executable")
    if paths["hardcap_validator_path"] != OFFICIAL_HARDCAP_VALIDATOR:
        raise RuntimeError("LSP build evidence validator is not authoritative")
    _, lsp_bytes, _ = read_exact_regular(
        executable.absolute(), executable_sha256, executable=True)
    compiler_sha256, compiler_bytes, _ = read_exact_regular(
        paths["compiler_executable_path"], evidence["compiler_executable_sha256"],
        executable=True)
    _, _, report_raw = read_exact_regular(
        paths["lsp_build_report_path"], evidence["lsp_build_report_sha256"],
        capture=True)
    _, _, lsp_guard_raw = read_exact_regular(
        paths["lsp_build_guard_path"], evidence["lsp_build_guard_sha256"],
        capture=True)
    _, _, compiler_guard_raw = read_exact_regular(
        paths["compiler_build_guard_path"], evidence["compiler_build_guard_sha256"],
        capture=True)
    _, _, compiler_report_raw = read_exact_regular(
        paths["compiler_build_report_path"],
        evidence["compiler_build_report_sha256"], capture=True)
    _, _, lsp_input_manifest_raw = read_exact_regular(
        paths["lsp_build_input_manifest_path"],
        evidence["lsp_build_input_manifest_sha256"], capture=True)
    _, _, compiler_input_manifest_raw = read_exact_regular(
        paths["compiler_build_input_manifest_path"],
        evidence["compiler_build_input_manifest_sha256"], capture=True)
    validator_sha256, validator_bytes, _ = read_exact_regular(
        paths["hardcap_validator_path"], evidence["hardcap_validator_sha256"],
        executable=True)
    exporter_sha256, exporter_bytes, exporter_raw = read_exact_regular(
        paths["build_exporter_path"], evidence["build_exporter_sha256"],
        executable=True, capture=True)
    _, _, tool_manifest_raw = read_exact_regular(
        paths["build_tool_manifest_path"], evidence["build_tool_manifest_sha256"],
        capture=True)
    assert report_raw is not None and lsp_guard_raw is not None and \
        compiler_guard_raw is not None and lsp_input_manifest_raw is not None and \
        compiler_input_manifest_raw is not None and \
        compiler_report_raw is not None and exporter_raw is not None and \
        tool_manifest_raw is not None
    validate_source_manifest(
        paths["compiler_source_manifest_path"],
        evidence["compiler_source_manifest_sha256"],
        evidence["compiler_source_closure_cid"])
    if evidence["compiler_source_closure_cid"] != \
           value["compiler_source_closure_cid"]:
        raise RuntimeError("semantic compiler source closure identity mismatch")
    try:
        tool_manifest = json.loads(tool_manifest_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("build tool manifest is not canonical JSON") from error
    expected_tool_rows = [
        {"name": "semantic-snapshot-build-exporter",
         "bytes": exporter_bytes, "sha256": exporter_sha256},
        {"name": "hardcap-receipt-validator",
         "bytes": validator_bytes, "sha256": validator_sha256},
    ]
    if not isinstance(tool_manifest, dict) or \
       set(tool_manifest) != {"schema", "tools"} or \
       tool_manifest.get("schema") != \
           "cheng.semantic_snapshot.build_tool_closure" or \
       tool_manifest.get("tools") != expected_tool_rows or \
       tool_manifest_raw != canonical_json_bytes(tool_manifest):
        raise RuntimeError("build tool manifest identity mismatch")
    for argv in (lsp_build_argv, compiler_build_argv):
        if argv[0] != "/cheng-tools/semantic-snapshot-build-exporter" or \
           f"--exporter-sha256:{exporter_sha256}" not in argv or \
           f"--tool-manifest-sha256:{evidence['build_tool_manifest_sha256']}" \
               not in argv:
            raise RuntimeError("build exporter argv identity mismatch")
    lsp_guard = parse_key_value(lsp_guard_raw, "LSP build guard")
    compiler_guard = parse_key_value(compiler_guard_raw, "compiler build guard")
    try:
        compiler_report = json.loads(compiler_report_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("compiler build report is not canonical JSON") from error
    expected_compiler_report = {
        "schema": "cheng.semantic_snapshot.compiler_build",
        "status": "completed",
        "compiler_executable_sha256": compiler_sha256,
        "compiler_source_manifest_sha256":
            evidence["compiler_source_manifest_sha256"],
        "compiler_source_closure_cid":
            evidence["compiler_source_closure_cid"],
        "compiler_toolchain_cid":
            compiler_guard.get("rootfs_tree_cid"),
    }
    if compiler_report != expected_compiler_report or \
       compiler_report_raw != canonical_json_bytes(compiler_report):
        raise RuntimeError("compiler build report identity mismatch")
    report = parse_key_value(report_raw, "LSP build report")
    if report.get("full_backend_codegen") != "1" or \
       report.get("system_link_exec") != "1" or \
       report.get("real_backend_codegen") != "1" or \
       report.get("emit") != "exe" or \
       report.get("target") != value["compiler_target_triple"]:
        raise RuntimeError("LSP build report lacks exact full backend proof")
    report_output = report.get("output", "")
    report_source = report.get("source", "")
    if not report_output or not report_source or \
       f"--out:{report_output}" not in lsp_build_argv or \
       f"--in:{report_source}" not in lsp_build_argv or \
       "--emit:exe" not in lsp_build_argv:
        raise RuntimeError("LSP build report output identity mismatch")
    input_manifest_fields = {
        "schema", "mode", "delegationManifestSha256",
        "cgroupParentPathFshex", "crunSha256", "rootfsManifestSha256",
        "rootfsTreeCid", "ociConfigSha256", "targetArgvCount",
        "targetArgvSha256", "memoryMax", "memorySwapMax", "pidsMax",
    }
    for label, input_raw, argv, guard, artifact_sha256, artifact_size, \
            bound_report_sha256, bound_report_size in (
            ("LSP build", lsp_input_manifest_raw, lsp_build_argv, lsp_guard,
             executable_sha256, lsp_bytes,
             evidence["lsp_build_report_sha256"], len(report_raw)),
            ("compiler build", compiler_input_manifest_raw, compiler_build_argv,
             compiler_guard, compiler_sha256, compiler_bytes,
             evidence["compiler_build_report_sha256"],
             len(compiler_report_raw))):
        try:
            input_manifest = json.loads(input_raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RuntimeError(
                f"{label} input manifest is not canonical JSON") from error
        if not isinstance(input_manifest, dict) or \
           set(input_manifest) != input_manifest_fields or \
           input_raw != canonical_json_bytes(input_manifest) or \
           input_manifest.get("schema") != \
               "cheng.native_linux_delegated_cgroup_v2_inputs" or \
           input_manifest.get("mode") != "workload" or \
           input_manifest.get("targetArgvCount") != len(argv) or \
           input_manifest.get("targetArgvSha256") != framed_argv_cid(argv) or \
           input_manifest.get("memoryMax") != MEMORY_LIMIT_BYTES or \
           input_manifest.get("memorySwapMax") != 0 or \
           input_manifest.get("pidsMax") != 128:
            raise RuntimeError(f"{label} input manifest identity mismatch")
        required = {
            "tool": "tools/beat_c_linux_cgroup_v2_hard_memory_gate.sh",
            "schema": "beat_c_linux_cgroup_v2_hard_memory_gate",
            "status": "completed",
            "applicability": "native_linux_delegated_cgroup_v2_only",
            "driver_role": "production",
            "hard_memory_limit_proof_status":
                "proved_linux_kernel_cgroup_v2_aggregate",
            "memory_enforcement_scope":
                "rootless_oci_process_and_all_descendants",
            "mode": "workload", "memory_limit_bytes": str(MEMORY_LIMIT_BYTES),
            "memory_swap_max_bytes": "0", "pids_max": "128",
            "execution_result": "exited_zero",
            "cgroup_mount_type": "cgroup2",
            "target_argv_count": str(len(argv)),
            "target_argv_sha256": framed_argv_cid(argv),
            "delegation_manifest_sha256":
                str(input_manifest["delegationManifestSha256"]),
            "delegation_parent_path_fshex":
                str(input_manifest["cgroupParentPathFshex"]),
            "crun_sha256": str(input_manifest["crunSha256"]),
            "rootfs_manifest_sha256":
                str(input_manifest["rootfsManifestSha256"]),
            "rootfs_tree_cid": str(input_manifest["rootfsTreeCid"]),
            "oci_config_sha256": str(input_manifest["ociConfigSha256"]),
            "stdout_sha256": artifact_sha256,
            "stdout_size": str(artifact_size),
            "stderr_sha256": bound_report_sha256,
            "stderr_size": str(bound_report_size),
        }
        if any(guard.get(field) != expected
               for field, expected in required.items()) or \
           guard.get("input_manifest_sha256") != hashlib.sha256(
               canonical_json_bytes(input_manifest)).hexdigest():
            raise RuntimeError(f"{label} guard contract mismatch")
    if f"--compiler-executable-sha256:{compiler_sha256}" not in lsp_build_argv:
        raise RuntimeError("LSP build argv compiler identity mismatch")
    if f"--compiler-source-manifest-sha256:{evidence['compiler_source_manifest_sha256']}" \
           not in compiler_build_argv or \
       f"--compiler-source-closure-cid:{evidence['compiler_source_closure_cid']}" \
           not in compiler_build_argv:
        raise RuntimeError("compiler build argv source closure identity mismatch")
    if value["compiler_driver_cid"] != compiler_sha256 or \
       value["compiler_toolchain_cid"] != \
           compiler_guard.get("rootfs_tree_cid") or \
       value["compiler_materializer_cid"] != \
           lsp_guard.get("rootfs_tree_cid") or \
       value["compiler_command_cid"] != evidence["compiler_command_argv_cid"]:
        raise RuntimeError("semantic compiler identity is not build-bound")


def validate_build_evidence(value: dict[str, object], executable: Path,
                            executable_sha256: str) -> None:
    validate_build_evidence_files(value, executable, executable_sha256)
    evidence = value["build_evidence"]
    assert isinstance(evidence, dict)
    validate_hardcap_bundle(
        Path(str(evidence["lsp_build_guard_path"])),
        Path(str(evidence["lsp_build_input_manifest_path"])),
        Path(str(evidence["hardcap_validator_path"])), "LSP build")
    validate_hardcap_bundle(
        Path(str(evidence["compiler_build_guard_path"])),
        Path(str(evidence["compiler_build_input_manifest_path"])),
        Path(str(evidence["hardcap_validator_path"])), "compiler build")
    validate_build_evidence_files(value, executable, executable_sha256)


def compiler_identity_args_files(path: Path, identity_sha256: str,
                                 executable: Path,
                                 executable_sha256: str) -> list[str]:
    _, _, raw = read_exact_regular(
        path.absolute(), identity_sha256, capture=True)
    assert raw is not None
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("compiler identity manifest is not canonical JSON") from error
    if not isinstance(value, dict) or set(value) != IDENTITY_FIELDS or \
       raw != canonical_json_bytes(value) or \
       value.get("schema") != "cheng.semantic_snapshot.lsp_compiler_identity":
        raise RuntimeError("compiler identity manifest shape mismatch")
    for field in ("compiler_case_id", "compiler_world_channel",
                  "compiler_target_triple"):
        if not isinstance(value[field], str) or not value[field] or \
           "\x00" in value[field]:
            raise RuntimeError(f"compiler identity text invalid: {field}")
    for field in IDENTITY_CID_FIELDS:
        if not observed_cid(value[field]):
            raise RuntimeError(f"compiler identity CID invalid: {field}")
    proof = value["compiler_migration_proof_cid"]
    if not isinstance(proof, str) or not sha256_value(proof) or \
       (proof != "0" * 64 and not observed_cid(proof)):
        raise RuntimeError("compiler identity CID invalid: compiler_migration_proof_cid")
    validate_build_evidence_files(value, executable, executable_sha256)
    return [
        f"--compiler-case-id={value['compiler_case_id']}",
        f"--compiler-world-channel={value['compiler_world_channel']}",
        f"--compiler-target-triple={value['compiler_target_triple']}",
        f"--compiler-source-bundle-cid={value['compiler_source_bundle_cid']}",
        f"--compiler-csg-root-cid={value['compiler_csg_root_cid']}",
        f"--compiler-export-surface-cid={value['compiler_export_surface_cid']}",
        f"--compiler-migration-proof-cid={value['compiler_migration_proof_cid']}",
        f"--compiler-materializer-cid={value['compiler_materializer_cid']}",
        f"--compiler-grammar-cid={value['compiler_grammar_cid']}",
        f"--compiler-source-closure-cid={value['compiler_source_closure_cid']}",
        f"--compiler-driver-cid={value['compiler_driver_cid']}",
        f"--compiler-toolchain-cid={value['compiler_toolchain_cid']}",
        f"--compiler-command-cid={value['compiler_command_cid']}",
    ]


def compiler_identity_args(path: Path, identity_sha256: str,
                           executable: Path,
                           executable_sha256: str) -> list[str]:
    arguments = compiler_identity_args_files(
        path, identity_sha256, executable, executable_sha256)
    _, _, raw = read_exact_regular(
        path.absolute(), identity_sha256, capture=True)
    assert raw is not None
    value = json.loads(raw.decode("utf-8"))
    evidence = value["build_evidence"]
    validate_hardcap_bundle(
        Path(evidence["lsp_build_guard_path"]),
        Path(evidence["lsp_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "LSP build")
    validate_hardcap_bundle(
        Path(evidence["compiler_build_guard_path"]),
        Path(evidence["compiler_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "compiler build")
    after_arguments = compiler_identity_args_files(
        path, identity_sha256, executable, executable_sha256)
    if after_arguments != arguments:
        raise RuntimeError("compiler build evidence changed during validation")
    return arguments


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def main() -> int:
    if len(sys.argv) != 7:
        raise RuntimeError(
            "expected payload path/hash, LSP path/hash, and compiler identity path/hash")
    payload = Path(sys.argv[1])
    payload_sha256 = sys.argv[2]
    executable = Path(sys.argv[3])
    executable_sha256 = sys.argv[4]
    identity = Path(sys.argv[5])
    identity_sha256 = sys.argv[6]
    payload = payload.absolute()
    executable = executable.absolute()
    identity = identity.absolute()
    read_exact_regular(payload, payload_sha256)
    read_exact_regular(executable, executable_sha256, executable=True)
    identity_args = compiler_identity_args(
        identity, identity_sha256, executable, executable_sha256)
    with payload.open("rb") as stream:
        completed = subprocess.run(
            [str(executable), *identity_args], stdin=stream, check=False)
    read_exact_regular(payload, payload_sha256)
    read_exact_regular(executable, executable_sha256, executable=True)
    post_identity_args = compiler_identity_args(
        identity, identity_sha256, executable, executable_sha256)
    if post_identity_args != identity_args:
        raise RuntimeError("compiler identity changed during execution")
    return completed.returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError) as error:
        sys.stderr.write(f"semantic_snapshot_lsp_feeder_error={error}\n")
        raise SystemExit(125)
