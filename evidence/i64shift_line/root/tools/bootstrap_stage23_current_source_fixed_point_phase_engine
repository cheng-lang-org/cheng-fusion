                    paths.bootstrap_manifest,
                    role_paths,
                    identities,
                    plan["lane"],
                ),
                sealed_output_authority_input(
                    "cc_deps_post_stdout", plan, planned_paths
                ),
                frozen_role_authority_input(
                    "source_pre_manifest",
                    "regular",
                    paths.output_path("source_pre_manifest"),
                    role_paths,
                    identities,
                    plan["lane"],
                ),
            ),
        )
        write_new_file(
            planned_paths["source_post_manifest"], raw, 0o400
        )


def run_phase_action(
    manifest_path: Path,
    plan_sha256: str,
    evidence: Path,
) -> bytes:
    manifest, manifest_raw = strict_stage_input_manifest(manifest_path)
    if (
        not re.fullmatch(r"[0-9a-f]{64}", plan_sha256)
        or manifest.get("phasePlanSha256") != plan_sha256
        or sha256_bytes(canonical_json(manifest.get("phasePlan")))
            != plan_sha256
    ):
        fail("stage plan hash is not exact")
    lane = canonical_lane(manifest.get("lane"))
    if evidence != evidence.resolve(strict=True) or not evidence.is_dir():
        fail("phase evidence directory is not canonical")
    role_paths, identities = manifest_role_paths(manifest)
    root = (
        Path("/cheng-stage23-source/repo")
        if lane == "linux"
        else Path(__file__).resolve(strict=True).parent.parent
    )
    cc = Path("/usr/bin/cc") if lane == "linux" else role_paths["cc"]
    paths = PhasePaths(root, evidence, cc)
    plan = phase_plan(manifest["phaseIndex"], paths, lane)
    if (
        plan != manifest.get("phasePlan")
        or manifest.get("phaseLabel") != plan["phaseLabel"]
        or manifest.get("targetTriple") != plan["targetTriple"]
        or manifest.get("machineAuthority") != plan["machineAuthority"]
        or manifest.get("phaseActions") != plan["actions"]
        or manifest.get("plannedOutputs") != plan["outputs"]
        or manifest.get("terminalRelativePath")
            != plan["terminalRelativePath"]
        or manifest.get("declaredDeltaDirectories")
            != plan["declaredDeltaDirectories"]
        or manifest.get("declaredDeltaFiles")
            != plan["declaredDeltaFiles"]
        or manifest.get("declaredOutputSetSha256")
            != plan["declaredOutputSetSha256"]
    ):
        fail("stage input does not equal canonical phase plan")
    command_identity_bindings: dict[int, dict[str, Any]] = {}
    command_action_tree_bindings: dict[int, dict[str, Any]] = {}
    if "commandActions" in plan:
        command_identities = manifest.get("commandIdentities")
        private_trees = manifest.get(
            "commandActionPrivateFrozenTrees"
        )
        if isinstance(command_identities, list):
            command_identity_bindings = {
                item.get("commandActionIndex"): item
                for item in command_identities
                if isinstance(item, dict)
            }
        if isinstance(private_trees, list):
            command_action_tree_bindings = {
                item.get("commandActionIndex"): item
                for item in private_trees
                if isinstance(item, dict)
            }
        if (
            manifest.get("phaseCommandActions")
                != plan["commandActions"]
            or manifest.get("phaseCommandActionsSha256")
                != sha256_bytes(canonical_json(plan["commandActions"]))
            or not isinstance(command_identities, list)
            or len(command_identity_bindings) != len(command_identities)
            or set(command_identity_bindings)
                != set(range(len(plan["commandActions"])))
            or not isinstance(private_trees, list)
            or len(command_action_tree_bindings) != len(private_trees)
            or set(command_action_tree_bindings)
                != set(range(len(plan["commandActions"])))
            or any(
                set(command_identity_bindings[index]) != {
                    "commandActionIndex",
                    "targetExecutableRole",
                    "identity",
                    "physicalIdentity",
                }
                or command_identity_bindings[index][
                    "targetExecutableRole"
                ] != action["targetExecutableRole"]
                or command_identity_bindings[index]["identity"]
                    != identities[action["targetExecutableRole"]]
                for index, action in enumerate(plan["commandActions"])
            )
            or "phaseCommandArgv" in manifest
            or "phaseCommandArgvSha256" in manifest
        ):
            fail("multi-action stage input binding drifted")
        for index, action in enumerate(plan["commandActions"]):
            tree_row = command_action_tree_bindings[index]
            tree_contract = action["privateFrozenTree"]
            expected_root = Path(tree_contract["root"])
            binding_mode = tree_contract["bindingMode"]
            if (
                tree_row.get("commandActionIndex") != index
                or binding_mode != "exact_prebound"
                or tree_row.get("bindingMode") != "exact_prebound"
                or tree_row.get("derivedInput") is not None
                or tree_contract["derivedInput"] is not None
            ):
                fail("command action private tree row drifted")
            if set(tree_row) != {
                "commandActionIndex",
                "bindingMode",
                "tree",
                "derivedInput",
            }:
                fail("exact command action tree fields drifted")
            tree = validate_private_tree_binding_shape(
                tree_row["tree"], expected_root
            )
            if private_frozen_tree_binding(expected_root) != tree:
                fail("exact command action tree identity drifted")
            info = os.lstat(role_paths[action["targetExecutableRole"]])
            if command_identity_bindings[index]["physicalIdentity"] != {
                "device": info.st_dev,
                "inode": info.st_ino,
                "mode": info.st_mode,
                "nlink": info.st_nlink,
                "uid": info.st_uid,
                "gid": info.st_gid,
                "size": info.st_size,
                "mtimeNs": info.st_mtime_ns,
                "ctimeNs": info.st_ctime_ns,
            }:
                fail("multi-action command physical identity drifted")
    runtime_roles = (
        {"process_guard", "process_guard_runtime"}
        if plan["phaseIndex"] != 10 else set()
    )
    command_roles = {
        action["targetExecutableRole"]
        for action in plan.get("commandActions", ())
    } or {plan["commandRole"]}
    command_roles.update(
        action["targetExecutableRole"]
        for action in plan.get("darwinCodesignActions", ())
    )
    for role in {
        *command_roles,
        *plan["boundInputRoles"],
        "bash",
        "python",
        *runtime_roles,
        "stage_gate",
        "phase_engine",
    }:
        if role not in role_paths:
            fail("phase frozen input role is absent: " + role)
        verify_frozen_identity(
            role, role_paths[role], identities[role], lane
        )
    monitor_binding = manifest.get("monitorRuntime")
    expected_monitor_runtime = (
        None
        if plan["phaseIndex"] == 10 else {
            "schema": "cheng.guard.monitor_runtime_binding",
            "scriptRole": "process_guard_runtime",
            "interpreterRole": "python",
            "loaderSourceRole": "process_guard",
            "startupFlags": ["-I", "-S", "-B"],
            "heldFd": 9,
            "expectedSha256":
                identities["process_guard_runtime"]["sha256"],
            "physicalIdentity": (
                monitor_binding.get("physicalIdentity")
                if isinstance(monitor_binding, dict) else None
            ),
        }
    )
    if manifest.get("monitorRuntime") != expected_monitor_runtime:
        fail("phase monitor runtime binding drifted")
    if lane == "darwin" and expected_monitor_runtime is not None:
        runtime_info = os.lstat(role_paths["process_guard_runtime"])
        expected_physical = expected_monitor_runtime["physicalIdentity"]
        if (
            not isinstance(expected_physical, dict)
            or expected_physical != {
                "device": runtime_info.st_dev,
                "inode": runtime_info.st_ino,
                "mode": runtime_info.st_mode,
                "nlink": runtime_info.st_nlink,
                "uid": runtime_info.st_uid,
                "gid": runtime_info.st_gid,
                "size": runtime_info.st_size,
                "mtimeNs": runtime_info.st_mtime_ns,
                "ctimeNs": runtime_info.st_ctime_ns,
            }
        ):
            fail("phase monitor runtime physical identity drifted")
    planned_paths = {
        item["role"]: Path(os.fsdecode(bytes.fromhex(
            item["pathFshex"]
        )))
        for item in plan["outputs"]
    }
    for item in plan["declaredDeltaFiles"]:
        planned_paths[item["role"]] = evidence / item["relativePath"]
    if len(planned_paths) != len(plan["declaredDeltaFiles"]):
        fail("phase output role set aliases")
    stage_input_role = "phase_stage_input_manifest"
    for role, path in planned_paths.items():
        if role == stage_input_role:
            if (
                lane != "darwin"
                or path != manifest_path
                or read_exact_regular(
                    path, "stage input manifest"
                )[1] != manifest_raw
            ):
                fail("phase stage input manifest path drifted")
            continue
        if path.exists() or path.is_symlink():
            fail("phase output existed before action")
        path.parent.mkdir(parents=True, exist_ok=True)
    command_actions = [
        action for action in plan["actions"]
        if action["kind"] == "command"
    ]
    planned_by_role = {
        item["role"]: item for item in plan["outputs"]
    }
    command_action_receipts: list[dict[str, Any]] = []
    if plan.get("commandActions"):
        for action in plan["commandActions"]:
            action_index = action["commandActionIndex"]
            tree_row = command_action_tree_bindings[action_index]
            tree_contract = action["privateFrozenTree"]
            private_tree_root = Path(tree_contract["root"])
            if tree_row["bindingMode"] != "exact_prebound":
                fail("command action tree is not exact prebound")
            private_tree = tree_row["tree"]
            if (
                private_frozen_tree_binding(private_tree_root)
                != private_tree
            ):
                fail("command action exact tree changed before launch")
            receipt_path = planned_paths[action["guardReceiptRole"]]
            stdout_path = planned_paths[action["guardStdoutRole"]]
            stderr_path = planned_paths[action["guardStderrRole"]]
            target_role = action["targetExecutableRole"]
            target_identity = identities[target_role]
            guard_argv = [
                str(role_paths["bash"]),
                str(role_paths["process_guard"]),
                "--private-frozen-tree-direct",
                "--require-command-identity",
                "--rss-limit:805306368",
                "--timeout:" + str(action["timeoutSeconds"]),
                "--combined-output-limit:1073741824",
                "--monitor-python:" + str(role_paths["python"]),
                "--expected-monitor-runtime-sha256:"
                    + identities["process_guard_runtime"]["sha256"],
                "--frozen-tree-root:" + private_tree["root"],
                "--expected-frozen-tree-sha256:"
                    + private_tree["sha256"],
                "--expected-command-path:" + action["targetArgv"][0],
                "--expected-command-sha256:"
                    + target_identity["sha256"],
                "--expected-exit-code:"
                    + str(action["expectedExitCode"]),
                "--report-out:" + str(receipt_path),
                "--stdout:" + str(stdout_path),
                "--stderr:" + str(stderr_path),
            ]
            if lane == "linux":
                guard_argv.append(
                    "--require-precreated-output-authority"
                )
            for role in action["businessOutputRoles"]:
                item = planned_by_role[role]
                guard_argv.append(
                    "--tracked-output:"
                    + role
                    + "=1073741824:"
                    + item["kind"]
                    + ":"
                    + str(planned_paths[role])
                )
            guard_argv.extend(
                "--tracked-output-fd:"
                + binding["role"]
                + "="
                + str(binding["fd"])
                for binding in action[
                    "trackedOutputFdBindings"
                ]
            )
            guard_argv.append("--target-env-clear")
            guard_argv.extend(
                "--target-env:" + item["name"] + "=" + item["value"]
                for item in plan["env"]
            )
            guard_argv.extend(("--", *action["targetArgv"]))
            old_umask = os.umask(0o277)
            try:
                completed = subprocess.run(
                    guard_argv,
                    cwd=str(root),
                    env=guard_launcher_environment(
                        lane, role_paths["python"]
                    ),
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
            finally:
                os.umask(old_umask)
            if (
                completed.returncode != 0
                or completed.stdout
                or completed.stderr
            ):
                detail = (
                    completed.stderr or completed.stdout
                ).decode(
                    "utf-8", "replace"
                ).replace("\n", "_")[:512]
                fail(
                    "private frozen-tree action failed:"
                    + str(completed.returncode)
                    + ":"
                    + detail
                )
            guard_raw = validate_private_tree_guard_report(
                report_path=receipt_path,
                action=action,
                target_identity=target_identity,
                target_physical_identity=
                    command_identity_bindings[
                        action_index
                    ]["physicalIdentity"],
                monitor_python_path=role_paths["python"],
                monitor_python_identity=identities["python"],
                monitor_runtime_path=
                    role_paths["process_guard_runtime"],
                monitor_runtime_identity=
                    identities["process_guard_runtime"],
                monitor_runtime_physical_identity=
                    manifest["monitorRuntime"]["physicalIdentity"],
                private_tree=private_tree,
                env=plan["env"],
                planned_by_role=planned_by_role,
                planned_paths=planned_paths,
            )
            if read_exact_regular(
                stderr_path, "private action stderr"
            )[1]:
                fail("private frozen-tree action stderr is not empty")
            stdout_raw = read_exact_regular(
                stdout_path, "private action stdout"
            )[1]
            command_action_receipts.append({
                "commandActionIndex": action_index,
                "targetExecutableRole": target_role,
                "targetArgvSha256": action["targetArgvSha256"],
                "guardReceiptSha256": sha256_bytes(guard_raw),
                "guardStdoutSha256": sha256_bytes(stdout_raw),
                "guardStderrSha256": sha256_bytes(b""),
                "businessOutputRoles":
                    action["businessOutputRoles"],
                "privateFrozenTree": private_tree,
            })
        execute_authority_actions(
            plan=plan,
            paths=paths,
            role_paths=role_paths,
            identities=identities,
            planned_paths=planned_paths,
        )
    elif plan["phaseIndex"] == 10:
        if command_actions or plan["argv"]:
            fail("pure fixed-point phase acquired an external command")
        execute_authority_actions(
            plan=plan,
            paths=paths,
            role_paths=role_paths,
            identities=identities,
            planned_paths=planned_paths,
        )
    else:
        if len(command_actions) != 1:
            fail("phase command action is not unique")
        command_action = command_actions[0]
        command_identity = identities[plan["commandRole"]]
        self_image_authority = command_action[
            "selfImageInputFdAuthority"
        ]
        self_image_tokens = [
            argument for argument in plan["argv"]
            if argument.startswith("--bootstrap-self-image-fd")
        ]
        validate_phase_process_umask(
            PHASE_SPECS[plan["phaseIndex"]],
            lane,
            command_action["processUmask"],
        )
        validate_phase_path_replacement_output_authority(
            PHASE_SPECS[plan["phaseIndex"]],
            paths,
            lane,
            command_action["pathReplacementOutputAuthority"],
        )
        expected_self_image_authority = (
            phase_self_image_input_fd_authority(
                PHASE_SPECS[plan["phaseIndex"]], lane
            )
        )
        if self_image_authority is None:
            if self_image_tokens:
                fail("phase command authority drifted")
        elif (
            self_image_authority != expected_self_image_authority
            or self_image_tokens
                != [self_image_authority["argvToken"]]
            or plan["argv"][-1] != self_image_authority["argvToken"]
            or command_action["processUmask"] != 0o077
        ):
            fail("phase self-image input authority drifted")
        guard_argv = [
            str(role_paths["bash"]),
            str(role_paths["process_guard"]),
            "--rss-limit:805306368",
            "--timeout:" + str(plan["timeoutSeconds"]),
            "--combined-output-limit:1073741824",
            "--monitor-python:" + str(role_paths["python"]),
            "--expected-monitor-runtime-sha256:"
                + identities["process_guard_runtime"]["sha256"],
            "--expected-exit-code:" + str(plan["expectedExitCode"]),
            "--report-out:"
                + str(planned_paths["phase_guard_receipt"]),
            "--stdout:" + str(planned_paths["phase_guard_stdout"]),
            "--stderr:" + str(planned_paths["phase_guard_stderr"]),
        ]
        if lane == "linux":
            guard_argv.append(
                "--require-precreated-output-authority"
            )
        if lane == "darwin":
            guard_argv.extend((
                "--snapshot-command",
                "--require-command-identity",
                "--expected-command-path:" + plan["argv"][0],
                "--expected-command-sha256:"
                    + command_identity["sha256"],
            ))
        if self_image_authority is not None:
            guard_argv.append(
                "--command-self-image-fd:"
                + str(self_image_authority["targetFd"])
            )
        guard_tracked_roles = (
            ()
            if self_image_authority is not None
            else command_action["businessOutputRoles"]
        )
        for role in guard_tracked_roles:
            item = planned_by_role[role]
            guard_argv.append(
                "--tracked-output:"
                + role
                + "=1073741824:"
                + item["kind"]
                + ":"
                + str(planned_paths[role])
            )
        guard_argv.append("--target-env-clear")
        guard_argv.extend(
            "--target-env:" + item["name"] + "=" + item["value"]
            for item in plan["env"]
        )
        guard_argv.extend(("--", *plan["argv"]))
        old_umask = os.umask(command_action["processUmask"])
        try:
            completed = subprocess.run(
                guard_argv,
                cwd=str(root),
                env=guard_launcher_environment(
                    lane, role_paths["python"]
                ),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
        finally:
            os.umask(old_umask)
        if (
            completed.returncode != 0
            or completed.stdout
            or completed.stderr
        ):
            detail = (
                completed.stderr or completed.stdout
            ).decode("utf-8", "replace").replace("\n", "_")[:512]
            fail(
                "canonical guarded phase command failed:"
                + str(completed.returncode)
                + ":"
                + detail
            )
        if lane == "darwin":
            self_image_authority = command_action[
                "selfImageInputFdAuthority"
            ]
            remove_verified_guard_snapshot(
                planned_paths["phase_guard_receipt"],
                (
                    planned_paths[
                        COMMAND_OUTPUT_ROLES[plan["phaseIndex"]][1]
                    ]
                    if self_image_authority is not None else None
                ),
                (
                    planned_paths[
                        COMMAND_OUTPUT_ROLES[plan["phaseIndex"]][0]
                    ]
                    if self_image_authority is not None else None
                ),
                (
                    planned_paths[
                        COMMAND_OUTPUT_ROLES[plan["phaseIndex"]][2]
                    ]
                    if self_image_authority is not None else None
                ),
            )
        for role in command_action["businessOutputRoles"]:
            artifact_payload(
                planned_paths[role],
                planned_by_role[role]["kind"],
                planned_by_role[role]["finalMode"],
            )
        execute_authority_actions(
            plan=plan,
            paths=paths,
            role_paths=role_paths,
            identities=identities,
            planned_paths=planned_paths,
        )
    execute_darwin_codesign_actions(
        plan=plan,
        root=root,
        role_paths=role_paths,
        identities=identities,
        planned_paths=planned_paths,
    )
    produced = [{
        "role": item["role"],
        "identity": artifact_payload(
            planned_paths[item["role"]],
            item["kind"],
            item["finalMode"],
        ),
    } for item in plan["outputs"]]
    actions = [{
        "actionIndex": action["actionIndex"],
        "kind": action["kind"],
        "operation": action["operation"],
        "status": (
            "PENDING_OUTER_PROOF"
            if action["kind"] == "runner_authority"
            else "PROVED"
        ),
        "outputRoles": action["outputRoles"],
    } for action in plan["actions"]]
    payload = {
        "schema": PHASE_ACTION_TERMINAL_SCHEMA,
        "status": "PROVED",
        "lane": lane,
        "targetTriple": plan["targetTriple"],
        "machineAuthority": plan["machineAuthority"],
        "phaseIndex": plan["phaseIndex"],
        "phaseLabel": plan["phaseLabel"],
        "phasePlanSha256": plan_sha256,
        "runnerArgvSha256": manifest["runnerArgvSha256"],
        **(
            {
                "phaseCommandActionsSha256":
                    manifest["phaseCommandActionsSha256"],
                "commandActionReceipts": command_action_receipts,
                "guardReceiptsAggregateSha256": sha256_bytes(
                    canonical_json(command_action_receipts)
                ),
            }
            if command_action_receipts else {
                "phaseCommandArgvSha256":
                    manifest["phaseCommandArgvSha256"],
                "guardReceiptSha256": sha256_bytes(
                    read_exact_regular(
                        planned_paths["phase_guard_receipt"],
                        "phase guard receipt",
                    )[1]
                ),
            }
        ),
        "phaseEnvSha256": manifest["phaseEnvSha256"],
        "stageInputManifestSha256": sha256_bytes(manifest_raw),
        "terminalRelativePath": plan["terminalRelativePath"],
        "declaredDeltaDirectories": plan["declaredDeltaDirectories"],
        "declaredDeltaFiles": plan["declaredDeltaFiles"],
        "declaredOutputSetSha256": plan["declaredOutputSetSha256"],
        "actions": actions,
        "produced": produced,
    }
    if set(payload) != set(phase_action_terminal_fields(
        lane, plan["phaseIndex"]
    )):
        fail("phase action terminal field set drifted")
    terminal_raw = canonical_json({
        "payload": payload,
        "payloadSha256": sha256_bytes(canonical_json(payload)),
    }) + b"\n"
    write_new_file(
        planned_paths["phase_action_terminal"], terminal_raw, 0o400
    )
    write_new_file(
        planned_paths["phase_action_stdout"], terminal_raw, 0o400
    )
    write_new_file(
        planned_paths["phase_action_stderr"], b"", 0o400
    )
    return terminal_raw


def run_phase_action_cli(argv: Sequence[str]) -> int:
    if (
        sys.flags.isolated != 1
        or sys.flags.no_site != 1
        or sys.flags.dont_write_bytecode != 1
    ):
        fail("phase engine Python runtime requires fixed -I -S -B")
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-phase-action", action="store_true")
    parser.add_argument("--stage-input-manifest", required=True)
    parser.add_argument("--stage-plan-sha256", required=True)
    parser.add_argument("--evidence-dir", required=True)
    args = parser.parse_args(argv)
    if not args.run_phase_action:
        fail("run-phase-action capability is absent")
    manifest = Path(args.stage_input_manifest)
    evidence = Path(args.evidence_dir)
    if not manifest.is_absolute() or not evidence.is_absolute():
        fail("run-phase-action path is not absolute")
    raw = run_phase_action(
        manifest,
        args.stage_plan_sha256,
        evidence,
    )
    sys.stdout.buffer.write(raw)
    return 0


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--assert-phase", action="store_true")
    action.add_argument("--describe-phase", action="store_true")
    parser.add_argument("--phase-index", required=True, type=int)
    parser.add_argument("--lane", required=True, choices=LANES)
    parser.add_argument("--phase-label")
    parser.add_argument("--expected-exit-code", type=int)
    parser.add_argument("--timeout-seconds", type=int)
    parser.add_argument("--root", required=True)
    parser.add_argument("--evidence-dir", required=True)
    parser.add_argument("--cc", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    return args


def main(argv: Sequence[str] | None = None) -> int:
    raw_argv = tuple(sys.argv[1:] if argv is None else argv)
    try:
        if "--run-phase-action" in raw_argv:
            return run_phase_action_cli(raw_argv)
        args = parse_args(raw_argv)
        paths = PhasePaths(
            root=canonical_existing_directory(args.root, "root"),
            evidence=canonical_existing_directory(
                args.evidence_dir, "evidence directory"
            ),
            cc=canonical_existing_executable(args.cc, "cc"),
        )
        plan = phase_plan(args.phase_index, paths, args.lane)
        if args.describe_phase:
            if (
                args.phase_label is not None
                or args.expected_exit_code is not None
                or args.timeout_seconds is not None
                or args.command
            ):
                fail("describe phase received assertion-only arguments")
            sys.stdout.buffer.write(canonical_json(plan) + b"\n")
            return 0
        if "commandActions" in plan:
            fail(
                "multi-action phase accepts only the canonical "
                "stage-input manifest"
            )
        if (
            args.phase_label != plan["phaseLabel"]
            or args.expected_exit_code != plan["expectedExitCode"]
            or args.timeout_seconds != plan["timeoutSeconds"]
            or args.command != plan["argv"]
        ):
            fail("phase assertion does not match the canonical plan")
        return 0
    except (OSError, PhaseEngineError) as exc:
        reason = str(exc).replace("\n", "_").replace("\r", "_")[:512]
        print(f"schema={SCHEMA}", file=sys.stderr)
        print("status=HARD_RED", file=sys.stderr)
        print(f"reason={reason}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
