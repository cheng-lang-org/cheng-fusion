def exact_regular_identity_payload(
    path: Path,
    info: os.stat_result,
    raw: bytes,
) -> dict[str, Any]:
    return {
        "pathFshex": os.fsencode(str(path)).hex(),
        "sha256": sha256_bytes(raw),
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "size": info.st_size,
        "uid": info.st_uid,
        "gid": info.st_gid,
        "mtimeNs": info.st_mtime_ns,
        "ctimeNs": info.st_ctime_ns,
    }


def seal_path_replacement_executable(
    path: Path,
    initial_mode: int,
    final_mode: int,
) -> dict[str, Any]:
    before_path = os.lstat(path)
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    stable_fields = (
        "st_dev", "st_ino", "st_nlink", "st_size",
        "st_uid", "st_gid", "st_mtime_ns",
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_size <= 0
            or stat.S_IMODE(before.st_mode) != initial_mode
            or any(
                getattr(before, field)
                    != getattr(before_path, field)
                for field in (*stable_fields, "st_mode")
            )
        ):
            fail("Darwin path-replacement executable is not exact")
        os.fchmod(descriptor, final_mode)
        os.fsync(descriptor)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after_path = os.lstat(path)
    if (
        stat.S_IMODE(after.st_mode) != final_mode
        or any(
            getattr(before, field) != getattr(other, field)
            for other in (after, after_path)
            for field in stable_fields
        )
        or after.st_mode != after_path.st_mode
    ):
        fail("Darwin path-replacement executable seal drifted")
    return artifact_payload(path, "executable", final_mode)


def unlink_exact_ephemeral(
    path: Path,
    expected: os.stat_result,
) -> None:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    fields = (
        "st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
        "st_uid", "st_gid", "st_mtime_ns", "st_ctime_ns",
    )
    try:
        held = os.fstat(descriptor)
        named = os.lstat(path)
        if (
            not stat.S_ISREG(held.st_mode)
            or held.st_nlink != 1
            or any(
                getattr(expected, field) != getattr(other, field)
                for other in (held, named)
                for field in fields
            )
        ):
            fail("Darwin path-replacement sidecar identity drifted")
        os.unlink(path)
        after = os.fstat(descriptor)
        if (
            after.st_nlink != 0
            or any(
                getattr(held, field) != getattr(after, field)
                for field in fields
                if field not in ("st_nlink", "st_ctime_ns")
            )
        ):
            fail("Darwin path-replacement sidecar unlink drifted")
    finally:
        os.close(descriptor)
    if path.exists() or path.is_symlink():
        fail("Darwin path-replacement sidecar remained named")


def finalize_darwin_t7_path_replacement(
    *,
    plan: dict[str, Any],
    paths: PhasePaths,
    planned_paths: dict[str, Path],
) -> None:
    spec = PHASE_SPECS[plan["phaseIndex"]]
    command_action = next(
        action for action in plan["actions"]
        if action["kind"] == "command"
    )
    authority = validate_phase_path_replacement_output_authority(
        spec,
        paths,
        "darwin",
        command_action["pathReplacementOutputAuthority"],
    )
    if authority is None:
        fail("Darwin T7 path-replacement authority is absent")
    output = planned_paths[authority["role"]]
    report = planned_paths[authority["reportRole"]]
    if (
        str(output) != authority["outputPath"]
        or command_action["processUmask"] != authority["processUmask"]
        or command_action["businessOutputRoles"]
            != [authority["reportRole"]]
    ):
        fail("Darwin T7 path-replacement command binding drifted")
    sidecars: list[
        tuple[Path, os.stat_result, dict[str, Any]]
    ] = []
    for item in authority["ephemeralSidecars"]:
        sidecar = Path(str(output) + item["suffix"])
        info, raw = read_exact_regular(
            sidecar, "Darwin T7 path-replacement sidecar"
        )
        if (
            info.st_nlink != 1
            or info.st_size <= 0
            or stat.S_IMODE(info.st_mode) != item["mode"]
        ):
            fail("Darwin T7 path-replacement sidecar drifted")
        sidecars.append((
            sidecar,
            info,
            {
                "suffix": item["suffix"],
                "identity":
                    exact_regular_identity_payload(sidecar, info, raw),
            },
        ))
    expected_names = {
        output.name,
        report.name,
        *(sidecar.name for sidecar, _info, _payload in sidecars),
    }
    observed_names = {
        entry.name
        for entry in os.scandir(output.parent)
        if (
            entry.name == output.name
            or entry.name.startswith(output.name + ".")
        )
    }
    if observed_names != expected_names:
        fail("Darwin T7 path-replacement closure drifted")
    output_payload = seal_path_replacement_executable(
        output,
        authority["initialMode"],
        authority["finalMode"],
    )
    report_payload = artifact_payload(report, "regular", 0o400)
    payload = {
        "schema":
            "cheng.bootstrap_stage23_darwin_path_replacement_receipt",
        "phaseIndex": spec.index,
        "role": authority["role"],
        "processUmask": authority["processUmask"],
        "commandArgvSha256": framed_vector_sha256(
            b"cheng.guard.command_argv",
            plan["argv"],
        ),
        "output": output_payload,
        "trackedReport": report_payload,
        "ephemeralSidecars": [
            sidecar_payload
            for _sidecar, _info, sidecar_payload in sidecars
        ],
        "ephemeralSidecarDisposition":
            "exact_identity_unlinked_after_receipt",
    }
    receipt = canonical_json({
        "payload": payload,
        "payloadSha256": sha256_bytes(canonical_json(payload)),
    }) + b"\n"
    for sidecar, info, _sidecar_payload in sidecars:
        unlink_exact_ephemeral(sidecar, info)
    write_new_file(
        planned_paths[authority["role"] + "_validation"],
        receipt,
        0o400,
    )


def execute_authority_actions(
    *,
