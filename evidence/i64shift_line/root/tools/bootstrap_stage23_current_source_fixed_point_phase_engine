def darwin_toolchain_regular_files(paths: PhasePaths) -> tuple[Path, ...]:
    root = paths.evidence / DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
    if not root.exists():
        return ()
    if root.is_symlink() or not root.is_dir():
        fail("Darwin toolchain snapshot root is not exact")
    files: list[Path] = []
    for current, directories, names in os.walk(
        root, topdown=True, followlinks=False
    ):
        current_path = Path(current)
        for name in directories:
            path = current_path / name
            if path.is_symlink():
                fail("Darwin toolchain snapshot contains a symlink")
        for name in names:
            path = current_path / name
            info = os.lstat(path)
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
                fail("Darwin toolchain snapshot file is not regular")
            if path in {
                root / "usr/bin/clang",
                root / "usr/bin/ld",
            }:
                continue
            files.append(path)
    return tuple(sorted(files, key=lambda item: os.fsencode(str(item))))


def phase_bound_roles_for_plan(
    index: int,
    paths: PhasePaths,
    lane: str,
) -> tuple[str, ...]:
    roles = (
        []
        if lane == "darwin" and index in (0, 1)
        else list(PHASE_BOUND_ROLES.get(index, ()))
    )
    if lane == "darwin":
        roles.insert(0, "production_gate")
    if index == 1 and lane != "darwin":
        roles.extend(
            role for role, _path in dynamic_snapshot_outputs(
                paths,
                (
                    paths.command_action_source(1, 0)
                    if lane == "darwin" else None
                ),
            )
        )
    if lane == "darwin" and index == 15:
        roles.extend(
            f"local_c_header_{offset:04d}"
            for offset, _path in enumerate(
                phase_local_c_source_closure(index, paths, lane)
            )
        )
    if lane == "darwin" and index == 15:
        roles.extend(
            f"darwin_toolchain_input_{offset:04d}"
            for offset, _path in enumerate(
                darwin_toolchain_regular_files(paths)
            )
        )
    return tuple(roles)


def framed_vector_sha256(domain: bytes, values: Sequence[str]) -> str:
    payload = bytearray(len(domain).to_bytes(4, "big") + domain)
    payload.extend(len(values).to_bytes(4, "big"))
    for value in values:
        raw = os.fsencode(value)
        payload.extend(len(raw).to_bytes(4, "big"))
        payload.extend(raw)
    return hashlib.sha256(payload).hexdigest()


