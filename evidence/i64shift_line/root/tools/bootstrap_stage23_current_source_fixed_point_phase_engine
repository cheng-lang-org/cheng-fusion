) -> tuple[str, ...]:
    lane = canonical_lane(lane)
    if spec.index == 10:
        return ()
    command = str(paths.command_path(spec.command_role))
    toolchain_snapshot = (
        paths.command_action_toolchain(spec.index, 0)
        if lane == "darwin" and spec.index in (0, 1)
        else paths.evidence / DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
    )
    darwin_resource = toolchain_snapshot / "usr/lib/clang/21"
    darwin_sdk = toolchain_snapshot / "SDKs/MacOSX.sdk"
    darwin_linker = toolchain_snapshot / "usr/bin/ld"
    darwin_cc_authority = (
        (
            "-target",
            LANE_TARGET_TRIPLE["darwin"],
            "-resource-dir",
            str(darwin_resource),
            "-isysroot",
            str(darwin_sdk),
        )
        if lane == "darwin" else ()
    )
    if spec.index in (0, 15):
        return (
            command,
            "-std=c11",
            "-O2",
            *darwin_cc_authority,
            "-M",
            "-MT",
            "cheng_bootstrap_local_closure",
            str(paths.bootstrap_source),
        )
    if spec.index == 1:
        return (
            command,
            "-std=c11",
            "-O2",
            "-Werror",
            *(("-pipe",) if lane == "linux" else ()),
            *darwin_cc_authority,
            *(
                (
                    "-B" + str(darwin_linker.parent),
                    "-fuse-ld=ld",
                )
                if lane == "darwin" else ()
            ),
            "-o",
            str(paths.cold_candidate),
            str(paths.snapshot_bootstrap),
        )
    if spec.index in (2, 4, 6, 8):
        stage_index = (spec.index - 2) // 2
        self_image_authority = phase_self_image_input_fd_authority(
            spec, lane
        )
        return (
            command,
            "compile-bootstrap",
            "--in:" + str(paths.snapshot_contract),
            "--out:" + str(paths.stage(stage_index)),
            "--report-out:" + str(paths.stage_report(stage_index)),
            *(
                (self_image_authority["argvToken"],)
                if self_image_authority is not None else ()
            ),
        )
    if spec.index in (3, 5, 7, 9):
        return (command, "self-check")
    if spec.index in (11, 13):
        stage_index = 2 if spec.index == 11 else 3
        return (
            command,
            "system-link-exec",
            "--root:" + str(paths.snapshot),
            "--in:" + str(paths.snapshot_t7),
            "--emit:exe",
            "--link-providers",
            "--target:" + LANE_TARGET_TRIPLE[lane],
            "--out:" + str(paths.t7(stage_index)),
            "--report-out:" + str(paths.t7_report(stage_index)),
        )
    if spec.index in (12, 14):
