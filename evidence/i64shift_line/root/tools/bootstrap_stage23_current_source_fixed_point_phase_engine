            (
                frozen_role_authority_input(
                    stage,
                    "executable",
                    paths.command_path(stage),
                    role_paths,
                    identities,
                    plan["lane"],
                ),
                sealed_output_authority_input(
                    "phase_guard_stdout", plan, planned_paths
                ),
