def validate_phase_action_dag(actions: Sequence[Mapping[str, Any]]) -> None:
    producers: dict[str, int] = {}
    for expected_index, action in enumerate(actions):
        input_roles = action.get("inputRoles")
        output_roles = action.get("outputRoles")
        if (
            action.get("actionIndex") != expected_index
            or not isinstance(input_roles, list)
            or not isinstance(output_roles, list)
            or any(
                not isinstance(role, str)
                or not re.fullmatch(r"[a-z][a-z0-9_]*", role)
                for role in (*input_roles, *output_roles)
            )
            or len(input_roles) != len(set(input_roles))
            or len(output_roles) != len(set(output_roles))
        ):
            fail("phase action role graph is not canonical")
        for role in output_roles:
            if role in producers:
                fail("phase output role has multiple producers")
            producers[role] = expected_index
    for action in actions:
        consumer_index = action["actionIndex"]
        for role in action["inputRoles"]:
            producer_index = producers.get(role)
            if (
                producer_index is not None
                and producer_index >= consumer_index
            ):
                fail("phase action consumes an unordered phase output")


