def canonical_existing_directory(raw: str, label: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        fail(f"{label} is not absolute")
    try:
        resolved = path.resolve(strict=True)
        info = os.lstat(path)
    except OSError as exc:
        raise PhaseEngineError(f"{label} cannot be resolved") from exc
    if (
        resolved != path
        or not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
    ):
        fail(f"{label} is not a canonical directory")
    return path


def canonical_existing_executable(raw: str, label: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        fail(f"{label} is not absolute")
    try:
        resolved = path.resolve(strict=True)
        info = os.lstat(path)
    except OSError as exc:
        raise PhaseEngineError(f"{label} cannot be resolved") from exc
    if (
        resolved != path
        or not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or not info.st_mode & 0o111
    ):
        fail(f"{label} is not a canonical executable")
    return path


def validate_configuration() -> None:
    if (
        tuple(sorted(LANE_TARGET_TRIPLE)) != tuple(sorted(LANES))
        or tuple(sorted(LANE_MACHINE_AUTHORITY)) != tuple(sorted(LANES))
        or tuple(sorted(LANE_EXECUTABLE_FORMAT)) != tuple(sorted(LANES))
        or LANE_TARGET_TRIPLE["linux"]
            != "x86_64-unknown-linux-gnu"
        or LANE_MACHINE_AUTHORITY["linux"] != "elf-e_machine-62"
        or LANE_EXECUTABLE_FORMAT["linux"]
            != "elf64-x86_64-linux"
        or LANE_TARGET_TRIPLE["darwin"] != "arm64-apple-darwin"
        or LANE_MACHINE_AUTHORITY["darwin"]
            != "macho-cputype-16777228"
        or LANE_EXECUTABLE_FORMAT["darwin"]
            != "macho64-arm64-darwin"
    ):
        fail("lane target or machine authority drifted")
    if len(PHASE_SPECS) != PHASE_COUNT:
        fail("phase count drifted")
    labels: set[str] = set()
    produced: set[str] = set()
    available = {"cc", "phase_engine"}
    for index, spec in enumerate(PHASE_SPECS):
        if (
            spec.index != index
            or spec.label in labels
            or spec.command_role not in available
            or not 0 <= spec.expected_exit_code <= 255
            or spec.timeout_seconds <= 0
            or len(set(spec.produced_roles)) != len(spec.produced_roles)
        ):
            fail("phase configuration is not a strict ordered chain")
        labels.add(spec.label)
        for role in spec.produced_roles:
            if role in produced or role in available:
                fail("phase output role has multiple producers")
            produced.add(role)
            if next(
                item.kind for item in spec.outputs if item.role == role
            ) == "executable":
                available.add(role)
    if {
        role for role in produced
        if role in {
            "cold_candidate",
            "stage0",
            "stage1",
            "stage2",
            "stage3",
            "t7_stage2",
            "t7_stage3",
        }
    } != {
        "cold_candidate",
        "stage0",
        "stage1",
        "stage2",
        "stage3",
        "t7_stage2",
        "t7_stage3",
    }:
        fail("dynamic executable role set drifted")
    if set(PHASE_BOUND_ROLES) != {
