                frozen_role_authority_input(
                    "snapshot_bootstrap",
                    "regular",
                    paths.snapshot_bootstrap,
                    role_paths,
                    identities,
                    plan["lane"],
                ),
                sealed_output_authority_input(
                    "cold_candidate", plan, planned_paths
                ),
            ),
        )
        write_new_file(planned_paths["seed_atom_manifest"], raw, 0o400)
    elif index in (3, 5, 7, 9):
        stage = f"stage{(index - 3) // 2}"
        if not guard_stdout.stat().st_size:
            fail("self-check stdout is empty")
