        write_new_file(planned_paths["fixed_point_report"], raw, 0o400)
        fixed_point_payload = {
            "schema":
                "cheng.bootstrap_stage23_pure_fixed_point_validator",
            "status": "completed",
            "phaseIndex": index,
            "operation": "verify_stage2_stage3_physical_bytes_and_hash",
            "externalExecCount": 0,
            "stage2": {
                "sha256": sha256_bytes(stage2_raw),
                "device": stage2_info.st_dev,
                "inode": stage2_info.st_ino,
                "size": stage2_info.st_size,
                "mode": stage2_info.st_mode,
                "nlink": stage2_info.st_nlink,
            },
            "stage3": {
                "sha256": sha256_bytes(stage3_raw),
                "device": stage3_info.st_dev,
                "inode": stage3_info.st_ino,
                "size": stage3_info.st_size,
                "mode": stage3_info.st_mode,
                "nlink": stage3_info.st_nlink,
            },
            "fixedPointReport": artifact_payload(
                planned_paths["fixed_point_report"], "regular"
            ),
            "byteEqualityStatus": "verified",
            "hashEqualityStatus": "verified",
        }
        fixed_point_raw = canonical_json({
            "payload": fixed_point_payload,
            "payloadSha256": sha256_bytes(
                canonical_json(fixed_point_payload)
            ),
        }) + b"\n"
        write_new_file(
            planned_paths["phase_guard_receipt"],
            fixed_point_raw,
            0o400,
        )
        write_new_file(
            planned_paths["phase_guard_stdout"], b"", 0o400
        )
        write_new_file(
            planned_paths["phase_guard_stderr"], b"", 0o400
        )
    elif index in (11, 13):
        if plan["lane"] != "darwin":
            stage = "stage2" if index == 11 else "stage3"
            executable_role = "t7_" + stage
            report_role = executable_role + "_report"
            raw = authority_manifest_bytes(
                "validate_" + stage + "_t7_report",
                index,
                (
                    sealed_output_authority_input(
                        executable_role, plan, planned_paths
                    ),
                    sealed_output_authority_input(
                        report_role, plan, planned_paths
                    ),
                ),
            )
            write_new_file(
                planned_paths[executable_role + "_validation"],
                raw,
                0o400,
            )
        else:
            finalize_darwin_t7_path_replacement(
                plan=plan,
                paths=paths,
                planned_paths=planned_paths,
            )
    elif index == 15:
        copy_new_file(
            guard_stdout, planned_paths["cc_deps_post_stdout"]
