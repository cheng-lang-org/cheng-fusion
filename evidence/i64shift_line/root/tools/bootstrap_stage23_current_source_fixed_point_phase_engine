def execute_darwin_codesign_actions(
    *,
    plan: dict[str, Any],
    root: Path,
    role_paths: dict[str, Path],
    identities: dict[str, dict[str, Any]],
    planned_paths: dict[str, Path],
) -> None:
    actions = plan.get("darwinCodesignActions", ())
    if not actions:
        return
    codesign_path = role_paths["codesign"]
    codesign_identity = identities["codesign"]
    for action in actions:
        verify_frozen_identity(
            "codesign",
            codesign_path,
            codesign_identity,
            plan["lane"],
        )
        codesign_before = os.lstat(codesign_path)
        if any(
            getattr(codesign_before, field) != codesign_identity[key]
            for field, key in (
                ("st_dev", "device"),
                ("st_ino", "inode"),
                ("st_mode", "mode"),
                ("st_nlink", "nlink"),
                ("st_size", "size"),
                ("st_uid", "uid"),
                ("st_gid", "gid"),
            )
        ):
            fail("codesign frozen physical identity drifted")
        receipt_path = planned_paths[action["guardReceiptRole"]]
        stdout_path = planned_paths[action["guardStdoutRole"]]
        stderr_path = planned_paths[action["guardStderrRole"]]
        guard_argv = [
            str(role_paths["bash"]),
            str(role_paths["process_guard"]),
            "--rss-limit:" + str(action["memoryLimitBytes"]),
            "--timeout:" + str(action["timeoutSeconds"]),
            "--combined-output-limit:1073741824",
            "--monitor-python:" + str(role_paths["python"]),
            "--expected-monitor-runtime-sha256:"
                + identities["process_guard_runtime"]["sha256"],
            "--sealed-system-volume-direct",
            "--require-command-identity",
            "--expected-command-path:" + str(codesign_path),
            "--expected-command-sha256:"
                + codesign_identity["sha256"],
            "--expected-exit-code:0",
            "--report-out:" + str(receipt_path),
            "--stdout:" + str(stdout_path),
            "--stderr:" + str(stderr_path),
            "--target-env-clear",
        ]
        guard_argv.extend(
            "--target-env:" + item["name"] + "=" + item["value"]
            for item in plan["env"]
        )
        guard_argv.extend(("--", *action["targetArgv"]))
        completed = subprocess.run(
            guard_argv,
            cwd=str(root),
            env=guard_launcher_environment(
                plan["lane"], role_paths["python"]
            ),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if (
            completed.returncode != 0
            or completed.stdout
            or completed.stderr
        ):
            detail = (
                completed.stderr or completed.stdout
            ).decode("utf-8", "replace").replace("\n", "_")[:512]
            fail(
                "guarded codesign verification failed:"
                + str(completed.returncode)
                + ":"
                + detail
            )
