) -> dict[str, Any] | None:
    expected = phase_path_replacement_output_authority(
        spec, paths, lane
    )
    if observed != expected:
        fail("phase path-replacement output authority drifted")
    return expected


def phase_plan(index: int, paths: PhasePaths, lane: str) -> dict[str, Any]:
    validate_configuration()
    lane = canonical_lane(lane)
    if index < 0 or index >= PHASE_COUNT:
        fail("phase index is outside the chain")
    spec = PHASE_SPECS[index]
    toolchain_snapshot = (
        paths.evidence / DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
    )
    darwin_sdk = toolchain_snapshot / "SDKs/MacOSX.sdk"
    action_source_root = paths.command_action_source(0, 0)
    dynamic_source_root = (
        action_source_root
        if (
            lane == "darwin"
            and index == 0
            and action_source_root.is_dir()
            and not action_source_root.is_symlink()
        )
        else paths.root
    )
    dynamic_snapshot = (
        dynamic_snapshot_outputs(
            paths,
            (
                dynamic_source_root
                if lane == "darwin" else None
            ),
        )
        if index == 0 else ()
    )
    bound_input_roles = phase_bound_roles_for_plan(index, paths, lane)
    direct_command_actions = (
        darwin_phase01_command_actions(
            spec, paths, bound_input_roles
        )
        if lane == "darwin" and index in (0, 1)
        else ()
    )
    codesign_actions = darwin_codesign_actions(spec, paths, lane)
    path_replacement_authority = (
        phase_path_replacement_output_authority(spec, paths, lane)
    )
    if direct_command_actions:
        validate_darwin_phase01_command_actions(
            spec, paths, bound_input_roles, direct_command_actions
        )
    engine_owned_phase = spec.index == 10
    actions: list[dict[str, Any]] = [{
        "actionIndex": 0,
        "kind": "precondition",
        "operation": "assert_exact_frozen_inputs",
        "ownerExecutableRole": (
            "phase_engine" if engine_owned_phase else "stage_gate"
        ),
        "inputRoles": sorted({
            *(
                role
                for action in direct_command_actions
                for role in (
                    action["launcherExecutableRole"],
                    action["targetExecutableRole"],
                )
            ),
            *(() if direct_command_actions else (spec.command_role,)),
            *(
                ("codesign",) if codesign_actions else ()
            ),
            *bound_input_roles,
        }),
        "outputRoles": [],
    }]
    command_auxiliary_roles = tuple(
        role
        for action in direct_command_actions
        for role in (
            action["guardReceiptRole"],
            action["guardStdoutRole"],
            action["guardStderrRole"],
        )
    ) or (
        "phase_guard_receipt",
        "phase_guard_stdout",
        "phase_guard_stderr",
    )
    output_producers: dict[str, int] = {}
    if direct_command_actions:
        for command_action in direct_command_actions:
            command_action_index = len(actions)
            output_roles = [
                *command_action["businessOutputRoles"],
                command_action["guardReceiptRole"],
                command_action["guardStdoutRole"],
                command_action["guardStderrRole"],
            ]
            actions.append({
                "actionIndex": command_action_index,
                "kind": "command",
                "operation":
                    "execute_private_frozen_tree_direct",
                "ownerExecutableRole":
                    command_action["launcherExecutableRole"],
                "inputRoles": command_action["inputRoles"],
                "businessOutputRoles":
                    command_action["businessOutputRoles"],
                "outputRoles": output_roles,
                **command_action,
            })
            for role in output_roles:
                output_producers[role] = command_action_index
    elif spec.index != 10:
        command_action_index = len(actions)
        path_replacement_role = (
            path_replacement_authority["role"]
            if path_replacement_authority is not None else None
        )
        tracked_output_roles = tuple(
            role for role in COMMAND_OUTPUT_ROLES[spec.index]
            if role != path_replacement_role
        )
        actions.append({
            "actionIndex": command_action_index,
            "kind": "command",
            "operation": (
                "execute_canonical_argv_with_process_guard_and_ptrace_identity"
                if lane == "linux"
                else "execute_canonical_argv_with_process_guard_snapshot"
            ),
            "ownerExecutableRole": spec.command_role,
            "inputRoles": list(bound_input_roles),
            "businessOutputRoles": list(tracked_output_roles),
            "outputRoles": [
                *COMMAND_OUTPUT_ROLES[spec.index],
                *command_auxiliary_roles,
            ],
            "argv": list(phase_argv(spec, paths, lane)),
            "selfImageInputFdAuthority":
                phase_self_image_input_fd_authority(spec, lane),
            "pathReplacementOutputAuthority":
                path_replacement_authority,
            "processUmask": phase_process_umask(spec, lane),
        })
        output_producers.update({
            role: command_action_index
            for role in COMMAND_OUTPUT_ROLES[spec.index]
        })
    post_actions = list(POST_ACTIONS.get(
        spec.index, ()
    ))
    if direct_command_actions and spec.index == 0:
        operation, input_roles, output_roles = post_actions[0]
        post_actions[0] = (
            operation,
            tuple(
                "phase_guard_00_stdout"
                if role == "phase_guard_stdout" else role
                for role in input_roles
            ),
            output_roles,
        )
    if dynamic_snapshot:
        operation, input_roles, output_roles = post_actions[0]
        post_actions[0] = (
            operation,
            (
                *input_roles,
                *(
                    f"local_c_header_{offset:04d}"
                    for offset, _path in enumerate(
                        phase_local_c_source_closure(
                            index, paths, lane
                        )
                    )
                ),
            ),
            (
                *output_roles,
                *(role for role, _path in dynamic_snapshot),
            ),
        )
    for operation, input_roles, output_roles in post_actions:
        action_index = len(actions)
        action_output_roles = (
            (*output_roles, *command_auxiliary_roles)
            if spec.index == 10 else output_roles
        )
        actions.append({
            "actionIndex": action_index,
            "kind": "authority",
            "operation": operation,
            "ownerExecutableRole": (
                "phase_engine" if engine_owned_phase else "stage_gate"
            ),
            "inputRoles": list(input_roles),
            "outputRoles": list(action_output_roles),
        })
        for role in action_output_roles:
            output_producers[role] = action_index
    codesign_auxiliary_roles: list[str] = []
    for codesign_action in codesign_actions:
        action_index = len(actions)
        action_output_roles = [
            codesign_action["guardReceiptRole"],
            codesign_action["guardStdoutRole"],
            codesign_action["guardStderrRole"],
        ]
        codesign_auxiliary_roles.extend(action_output_roles)
        actions.append({
            "actionIndex": action_index,
            "kind": "guarded_verification",
            "operation":
                "verify_darwin_codesign_with_process_guard",
            "ownerExecutableRole": "phase_engine",
            "inputRoles": [
                "codesign",
                codesign_action["verifiedOutputRole"],
                "process_guard",
                "process_guard_runtime",
            ],
            "outputRoles": action_output_roles,
            **codesign_action,
        })
        for role in action_output_roles:
            output_producers[role] = action_index
    terminal_action_index = len(actions)
    terminal_roles = (
        "phase_action_terminal",
        "phase_action_stdout",
        "phase_action_stderr",
    )
    actions.append({
        "actionIndex": terminal_action_index,
        "kind": "authority",
        "operation": "emit_canonical_phase_terminal",
        "ownerExecutableRole": (
            "phase_engine" if engine_owned_phase else "stage_gate"
        ),
        "inputRoles": [
            *spec.produced_roles,
            *(
                ("cold_candidate_object",)
                if direct_command_actions and spec.index == 1 else ()
            ),
            *(role for role, _path in dynamic_snapshot),
            *command_auxiliary_roles,
            *codesign_auxiliary_roles,
        ],
        "outputRoles": list(terminal_roles),
    })
    for role in command_auxiliary_roles:
        if role not in output_producers:
            output_producers[role] = command_action_index
    for role in terminal_roles:
        output_producers[role] = terminal_action_index
    linux_proof_roles: tuple[str, ...] = ()
    if lane == "linux" and spec.index != 10:
        linux_proof_action_index = len(actions)
        linux_proof_roles = (
            "phase_ptrace_manifest",
            "phase_ptrace_receipt",
            "phase_ptrace_validation",
            "phase_cgroup_receipt",
        )
        actions.append({
            "actionIndex": linux_proof_action_index,
            "kind": "runner_authority",
            "operation": "seal_ptrace_cgroup_phase_proof",
            "ownerExecutableRole": "linux_phase_runner",
            "inputRoles": list(terminal_roles),
            "outputRoles": list(linux_proof_roles),
        })
        for role in linux_proof_roles:
            output_producers[role] = linux_proof_action_index
    validate_phase_action_dag(actions)
    receipt_dir = Path("phase-receipts") / f"{spec.index:02d}"
    planned_outputs = [
        {
            "role": item.role,
            "kind": item.kind,
            "pathFshex": os.fsencode(
                str(paths.output_path(item.role))
            ).hex(),
            "finalMode": (
                (
                    0o555 if item.kind == "executable" else 0o444
                )
                if spec.index in (2, 4, 6, 8)
                else (
                    0o500 if item.kind == "executable" else 0o400
                )
            ),
            "producerActionIndex": output_producers[item.role],
        }
        for item in spec.outputs
    ]
    if direct_command_actions and spec.index == 1:
        planned_outputs.append({
            "role": "cold_candidate_object",
            "kind": "regular",
            "pathFshex": os.fsencode(
                str(paths.cold_candidate_object)
            ).hex(),
            "finalMode": 0o400,
            "producerActionIndex":
                output_producers["cold_candidate_object"],
        })
    planned_outputs.extend({
        "role": role,
        "kind": "regular",
        "pathFshex": os.fsencode(str(
            paths.snapshot
            / source_path.relative_to(dynamic_source_root)
        )).hex(),
        "finalMode": 0o400,
        "producerActionIndex": output_producers[role],
    } for role, source_path in dynamic_snapshot)
    planned_outputs.extend({
        "role": action["guardReceiptRole"],
        "kind": "regular",
        "pathFshex": os.fsencode(str(
            paths.evidence
            / receipt_dir
            / (
                "codesign-"
                + action["verifiedOutputRole"]
                + ".guard.kv"
            )
        )).hex(),
        "finalMode": 0o400,
        "producerActionIndex": output_producers[
            action["guardReceiptRole"]
        ],
    } for action in codesign_actions)
    terminal_relative_path = str(receipt_dir / "terminal.json")
    evidence_delta = [
        {
            "role": item["role"],
            "relativePath": str(
                Path(os.fsdecode(bytes.fromhex(item["pathFshex"])))
                .relative_to(paths.evidence)
            ),
            "kind": item["kind"],
            "finalMode": item["finalMode"],
        }
        for item in planned_outputs
    ]
    auxiliary_files = [
        ("phase_action_terminal", "terminal.json"),
        ("phase_action_stdout", "action.stdout"),
        ("phase_action_stderr", "action.stderr"),
    ]
    if direct_command_actions:
        auxiliary_files.extend(
            (
                command_action["guardReceiptRole"],
                f"action-{command_action['commandActionIndex']:02d}.guard.kv",
            )
            for command_action in direct_command_actions
        )
        auxiliary_files.extend(
            (
                command_action["guardStdoutRole"],
                f"action-{command_action['commandActionIndex']:02d}.guard.stdout",
            )
            for command_action in direct_command_actions
        )
        auxiliary_files.extend(
            (
                command_action["guardStderrRole"],
                f"action-{command_action['commandActionIndex']:02d}.guard.stderr",
            )
            for command_action in direct_command_actions
        )
    else:
        auxiliary_files.extend((
            ("phase_guard_receipt", "guard.kv"),
            ("phase_guard_stdout", "guard.stdout"),
            ("phase_guard_stderr", "guard.stderr"),
        ))
    auxiliary_files.extend(
        (
            action["guardStdoutRole"],
            "codesign-"
            + action["verifiedOutputRole"]
            + ".guard.stdout",
        )
        for action in codesign_actions
    )
    auxiliary_files.extend(
        (
            action["guardStderrRole"],
            "codesign-"
            + action["verifiedOutputRole"]
            + ".guard.stderr",
        )
        for action in codesign_actions
    )
    evidence_delta.extend({
        "role": role,
        "relativePath": str(receipt_dir / filename),
        "kind": "regular",
        "finalMode": 0o400,
        "producerActionIndex": output_producers[role],
    } for role, filename in auxiliary_files)
    if lane == "darwin":
        evidence_delta.append({
            "role": "phase_stage_input_manifest",
            "relativePath": str(
                receipt_dir / "stage-input-manifest.json"
            ),
            "kind": "regular",
            "finalMode": 0o400,
        })
    if lane == "linux" and spec.index != 10:
        evidence_delta.extend({
            "role": role,
            "relativePath": str(receipt_dir / filename),
            "kind": "regular",
            "finalMode": 0o400,
            "producerActionIndex": output_producers[role],
        } for role, filename in (
            ("phase_ptrace_manifest", "ptrace-manifest.json"),
            ("phase_ptrace_receipt", "ptrace-receipt.json"),
            ("phase_ptrace_validation", "ptrace-validation.kv"),
            ("phase_cgroup_receipt", "cgroup-receipt.kv"),
        ))
    if len({
        item["relativePath"] for item in evidence_delta
    }) != len(evidence_delta):
        fail("phase declared delta path aliases")
    evidence_delta.sort(key=lambda item: os.fsencode(item["relativePath"]))
    directory_candidates = sorted({
        str(parent)
        for item in evidence_delta
        for parent in Path(item["relativePath"]).parents
        if str(parent) != "."
    }, key=os.fsencode)
    if any(
        phase_directory_first_owner(relative) > spec.index
        for relative in directory_candidates
    ):
        fail("phase uses a directory before its first owner")
    declared_directories = validate_declared_directory_first_owner(
        spec,
        [
            relative
            for relative in directory_candidates
            if phase_directory_first_owner(relative) == spec.index
        ],
    )
    output_set_sha256 = hashlib.sha256(
        canonical_json({
            "schema": "cheng.bootstrap_stage23_declared_output_set",
            "lane": lane,
            "phaseIndex": spec.index,
            "directories": declared_directories,
            "files": evidence_delta,
        })
    ).hexdigest()
    return {
        "schema": PLAN_SCHEMA,
        "lane": lane,
        "targetTriple": LANE_TARGET_TRIPLE[lane],
        "machineAuthority": LANE_MACHINE_AUTHORITY[lane],
        "nativeExecutableFormat": LANE_EXECUTABLE_FORMAT[lane],
        "phaseIndex": spec.index,
        "phaseLabel": spec.label,
        **(
            {}
            if direct_command_actions
            else {"commandRole": spec.command_role}
        ),
        "expectedExitCode": spec.expected_exit_code,
        "timeoutSeconds": spec.timeout_seconds,
        "env": [
            {"name": name, "value": value}
            for name, value in (
                (
                    *CANONICAL_ENV,
                    (
                        "CHENG_DARWIN_CC",
                        str(toolchain_snapshot / "usr/bin/clang"),
                    ),
                    (
                        "CHENG_DARWIN_SYSROOT",
                        str(darwin_sdk),
                    ),
                    ("CHENG_DARWIN_ARCH_FLAGS", "-arch arm64"),
                    ("PATH", "/usr/bin:/bin"),
                )
                if lane == "darwin" else LINUX_CANONICAL_ENV
            )
        ],
        **(
            {"commandActions": list(direct_command_actions)}
            if direct_command_actions
            else {"argv": list(phase_argv(spec, paths, lane))}
        ),
        **(
            {"darwinCodesignActions": list(codesign_actions)}
            if codesign_actions else {}
        ),
        "boundInputRoles": list(bound_input_roles),
        "actions": actions,
        "outputs": planned_outputs,
        "terminalRelativePath": terminal_relative_path,
        "declaredDeltaDirectories": declared_directories,
        "declaredDeltaFiles": evidence_delta,
        "declaredOutputSetSha256": output_set_sha256,
    }


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def private_frozen_tree_binding(root: Path) -> dict[str, Any]:
    if (
        not root.is_absolute()
        or root.resolve(strict=True) != root
        or root.is_symlink()
        or not root.is_dir()
    ):
        fail("private frozen tree root is not canonical")
    entries: list[tuple[str, str, str, tuple[int, ...]]] = []
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        directory_path = Path(directory)
        directory_info = os.lstat(directory_path)
        if (
            stat.S_ISLNK(directory_info.st_mode)
            or not stat.S_ISDIR(directory_info.st_mode)
        ):
            fail("private frozen tree contains a non-directory")
        entries.append((
            os.path.relpath(directory_path, root).replace(os.sep, "/"),
            "directory",
            "",
            (
                directory_info.st_mode,
                directory_info.st_nlink,
                directory_info.st_uid,
                directory_info.st_gid,
                directory_info.st_size,
            ),
        ))
        for name in directory_names:
            info = os.lstat(directory_path / name)
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                fail(
                    "private frozen tree contains a directory special node"
                )
        for name in file_names:
            path = directory_path / name
            info, raw = read_exact_regular(
                path, "private frozen-tree file"
            )
            if info.st_nlink != 1:
                fail("private frozen tree contains a hard-linked file")
            entries.append((
                os.path.relpath(path, root).replace(os.sep, "/"),
                "regular",
                sha256_bytes(raw),
                (
                    info.st_mode,
                    info.st_nlink,
                    info.st_uid,
                    info.st_gid,
                    info.st_size,
                ),
            ))
    entries.sort(key=lambda item: (
        os.fsencode(item[0]),
        0 if item[1] == "directory" else 1,
    ))
    domain = b"cheng.guard.private_frozen_tree_closure"
    payload = bytearray(len(domain).to_bytes(4, "big") + domain)
    payload.extend(len(entries).to_bytes(4, "big"))
    for relative, kind, digest, identity in entries:
        relative_raw = os.fsencode(relative)
        kind_raw = kind.encode("ascii")
        payload.extend(
            len(relative_raw).to_bytes(4, "big") + relative_raw
        )
        payload.extend(len(kind_raw).to_bytes(4, "big") + kind_raw)
        for value in identity:
            payload.extend(value.to_bytes(8, "big"))
        payload.extend(
            bytes.fromhex(digest) if digest else b"\0" * 32
        )
    directory_count = sum(
        1 for item in entries if item[1] == "directory"
    )
    file_count = len(entries) - directory_count
    return {
        "schema": "cheng.guard.private_frozen_tree_binding",
        "root": str(root),
        "sha256": sha256_bytes(bytes(payload)),
        "entryCount": len(entries),
        "directoryCount": directory_count,
        "fileCount": file_count,
        "watchCount": len(entries),
        "watchCoverage":
            "root_all_directories_and_all_regular_files",
        "sameUidBoundary":
            "mutation_detected_not_malicious_same_uid_isolation",
    }


def validate_private_tree_binding_shape(
    value: Any,
    expected_root: Path,
) -> dict[str, Any]:
    if (
        not isinstance(value, dict)
        or set(value) != {
            "schema",
            "root",
            "sha256",
            "entryCount",
            "directoryCount",
            "fileCount",
            "watchCount",
            "watchCoverage",
            "sameUidBoundary",
        }
        or value.get("schema")
            != "cheng.guard.private_frozen_tree_binding"
        or value.get("root") != str(expected_root)
        or not re.fullmatch(
            r"[0-9a-f]{64}", value.get("sha256", "")
        )
        or any(
            not isinstance(value.get(key), int)
            or isinstance(value.get(key), bool)
            or value[key] <= 0
            for key in ("entryCount", "directoryCount", "fileCount")
        )
        or value.get("watchCount") != value.get("entryCount")
        or value.get("entryCount")
            != value.get("directoryCount") + value.get("fileCount")
        or value.get("watchCoverage")
            != "root_all_directories_and_all_regular_files"
        or value.get("sameUidBoundary")
            != "mutation_detected_not_malicious_same_uid_isolation"
    ):
        fail("private frozen tree binding shape drifted")
    return value


def read_exact_regular(path: Path, label: str) -> tuple[os.stat_result, bytes]:
    try:
        before_path = os.lstat(path)
    except OSError as exc:
        raise PhaseEngineError(label + " is absent") from exc
    if (
        not stat.S_ISREG(before_path.st_mode)
        or stat.S_ISLNK(before_path.st_mode)
        or before_path.st_nlink <= 0
    ):
        fail(label + " is not single-link regular")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                fail(label + " changed during read")
            chunks.append(chunk)
            remaining -= len(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after_path = os.lstat(path)
    stable_fields = (
        "st_dev",
        "st_ino",
        "st_mode",
        "st_nlink",
        "st_uid",
        "st_gid",
        "st_size",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    if any(
        getattr(before, field) != getattr(other, field)
        for other in (after, before_path, after_path)
        for field in stable_fields
    ):
        fail(label + " changed during read")
    return before, b"".join(chunks)


def executable_format(raw: bytes) -> str:
    if (
        len(raw) >= 20
        and raw[:4] == b"\x7fELF"
        and raw[4] == 2
        and raw[5] == 1
        and int.from_bytes(raw[18:20], "little") == 62
    ):
        return LANE_EXECUTABLE_FORMAT["linux"]
    if (
        len(raw) >= 12
        and raw[:4] == b"\xcf\xfa\xed\xfe"
        and int.from_bytes(raw[4:8], "little") == 0x0100000C
    ):
        return LANE_EXECUTABLE_FORMAT["darwin"]
    fail("executable output machine format is not exact")


def artifact_payload(
    path: Path,
    kind: str,
    expected_mode: int | None = None,
    include_stable_times: bool = False,
) -> dict[str, Any]:
    info, raw = read_exact_regular(path, "phase artifact")
    if not raw:
        fail("phase artifact is empty")
    allowed_modes = (
        {expected_mode}
        if expected_mode is not None else (
            {0o500, 0o555}
            if kind == "executable" else {0o400, 0o444}
        )
    )
    if (
        expected_mode not in (None, 0o400, 0o444, 0o500, 0o555)
        or stat.S_IMODE(info.st_mode) not in allowed_modes
        or info.st_nlink != 1
    ):
        fail("phase artifact final mode drifted")
    payload = {
        "pathFshex": os.fsencode(str(path)).hex(),
        "sha256": sha256_bytes(raw),
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "size": info.st_size,
        "uid": info.st_uid,
        "gid": info.st_gid,
        "format": (
            executable_format(raw)
            if kind == "executable" else "regular"
        ),
    }
    if include_stable_times:
        payload.update({
            "mtimeNs": info.st_mtime_ns,
            "ctimeNs": info.st_ctime_ns,
        })
    return payload


def write_new_file(path: Path, raw: bytes, mode: int) -> None:
    if path.exists() or path.is_symlink():
        fail("phase output already exists")
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open(path, flags, mode)
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("phase output write made no progress")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.chmod(path, mode)


def copy_new_file(source: Path, destination: Path) -> None:
    _info, raw = read_exact_regular(source, "snapshot source")
    if not raw:
        fail("snapshot source is empty")
    write_new_file(destination, raw, 0o400)


def strict_stage_input_manifest(path: Path) -> tuple[dict[str, Any], bytes]:
    _info, raw = read_exact_regular(path, "stage input manifest")
    if not raw.endswith(b"\n") or b"\r" in raw or b"\0" in raw:
        fail("stage input manifest encoding drifted")
    try:
        value = json.loads(raw[:-1].decode("utf-8", "strict"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise PhaseEngineError(
            "stage input manifest is not strict JSON"
        ) from exc
    if not isinstance(value, dict):
        fail("stage input manifest is not canonical")
    expected_fields = stage_input_manifest_fields(
        value.get("lane"), value.get("phaseIndex")
    )
    if (
        set(value) != set(expected_fields)
        or value.get("schema") != STAGE_INPUT_MANIFEST_SCHEMA
        or canonical_json(value) + b"\n" != raw
    ):
        fail("stage input manifest is not canonical")
    return value, raw


def manifest_role_paths(
    manifest: dict[str, Any],
) -> tuple[dict[str, Path], dict[str, dict[str, Any]]]:
    frozen = manifest.get("frozenRoles")
    if not isinstance(frozen, list):
        fail("stage input frozen role set is absent")
    paths: dict[str, Path] = {}
    identities: dict[str, dict[str, Any]] = {}
    lane = manifest.get("lane")
    for row in frozen:
        if (
            not isinstance(row, dict)
            or set(row) != {"role", "hostIdentity", "guestPath"}
            or not isinstance(row["role"], str)
            or row["role"] in paths
            or not isinstance(row["hostIdentity"], dict)
        ):
            fail("stage input frozen role row drifted")
        role = row["role"]
        identity = row["hostIdentity"]
        if lane == "linux":
            if not isinstance(row["guestPath"], str):
                fail("Linux frozen role lacks guest path")
            path = Path(row["guestPath"])
        else:
            if row["guestPath"] is not None:
                fail("Darwin frozen role has guest path")
            try:
                path = Path(os.fsdecode(bytes.fromhex(
                    identity["pathFshex"]
                )))
            except (KeyError, TypeError, ValueError) as exc:
                raise PhaseEngineError(
                    "frozen host path is invalid"
                ) from exc
        if not path.is_absolute():
            fail("frozen role path is not absolute")
        paths[role] = path
        identities[role] = identity
    return paths, identities


def verify_frozen_identity(
    role: str,
    path: Path,
    identity: dict[str, Any],
    lane: str,
) -> None:
    info, raw = read_exact_regular(path, "frozen role " + role)
    expected = {
        "sha256": sha256_bytes(raw),
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "size": info.st_size,
    }
    if any(identity.get(key) != value for key, value in expected.items()):
        fail("frozen role identity drifted: " + role)
    if lane == "linux":
        if info.st_uid != 1 or info.st_gid != 1:
            fail("Linux frozen role guest ownership drifted: " + role)
    elif (
        identity.get("uid") != info.st_uid
        or identity.get("gid") != info.st_gid
    ):
        fail("Darwin frozen role ownership drifted: " + role)


def authority_manifest_bytes(
    operation: str,
    phase_index: int,
    inputs: Sequence[dict[str, Any]],
) -> bytes:
    rows = list(inputs)
    roles: set[str] = set()
    for row in rows:
        if (
            not isinstance(row, dict)
            or set(row) != {
                "role",
                "authorityKind",
                "identity",
            }
            or not isinstance(row["role"], str)
            or row["role"] in roles
            or row["authorityKind"] not in {
                FROZEN_ROLE_AUTHORITY,
                SEALED_OUTPUT_AUTHORITY,
            }
            or not isinstance(row["identity"], dict)
        ):
            fail("phase authority input row drifted")
        roles.add(row["role"])
    payload = {
        "schema": PHASE_AUTHORITY_ARTIFACT_SCHEMA,
        "operation": operation,
        "phaseIndex": phase_index,
        "inputs": rows,
    }
    return canonical_json({
        "payload": payload,
        "payloadSha256": sha256_bytes(canonical_json(payload)),
    }) + b"\n"


def frozen_role_authority_input(
    role: str,
    kind: str,
    expected_path: Path,
    role_paths: dict[str, Path],
    identities: dict[str, dict[str, Any]],
    lane: str,
) -> dict[str, Any]:
    if (
        role not in role_paths
        or role not in identities
        or kind not in {"regular", "executable"}
    ):
        fail("frozen authority input role is absent")
    path = role_paths[role]
    identity = identities[role]
    required_fields = {
        "pathFshex",
        "sha256",
        "device",
        "inode",
        "mode",
        "nlink",
        "size",
        "uid",
        "gid",
        "format",
    }
    if (
        set(identity) != required_fields
        or path != expected_path
        or (
            kind == "regular"
            and identity.get("format") != "regular"
        )
        or (
            kind == "executable"
            and identity.get("format") == "regular"
        )
        or (
            lane == "darwin"
            and identity.get("pathFshex")
                != os.fsencode(str(path)).hex()
        )
    ):
        fail("frozen authority input identity shape drifted")
    verify_frozen_identity(role, path, identity, lane)
    return {
        "role": role,
        "authorityKind": FROZEN_ROLE_AUTHORITY,
        "identity": dict(identity),
    }


def sealed_output_authority_input(
    role: str,
    plan: dict[str, Any],
    planned_paths: dict[str, Path],
) -> dict[str, Any]:
    planned = [
        item for item in plan["declaredDeltaFiles"]
        if item["role"] == role
    ]
    if (
        len(planned) != 1
        or role not in planned_paths
        or planned[0]["kind"] not in {"regular", "executable"}
        or planned[0]["finalMode"]
            not in (0o400, 0o444, 0o500, 0o555)
    ):
        fail("sealed authority output role is not exact")
    item = planned[0]
    return {
        "role": role,
        "authorityKind": SEALED_OUTPUT_AUTHORITY,
        "identity": artifact_payload(
            planned_paths[role],
            item["kind"],
            item["finalMode"],
        ),
    }


def bootstrap_self_image_portable_cid(size: int, digest: str) -> str:
    if (
        size <= 0
        or not re.fullmatch(r"[0-9a-f]{64}", digest)
    ):
        fail("bootstrap self-image portable CID input is invalid")
    return sha256_bytes(
        (
            "cheng.bootstrap.self-image.portable\n"
            f"size={size}\n"
            f"sha256={digest}\n"
        ).encode("ascii")
    )


def validate_bootstrap_self_image_compile_report(
    report_path: Path,
    guard_rows: dict[str, str],
    expected_executable_format: str,
    executable_path: Path | None = None,
    generated_path: Path | None = None,
) -> None:
    if expected_executable_format not in set(
        LANE_EXECUTABLE_FORMAT.values()
    ):
        fail("bootstrap self-image executable format is unsupported")
    _info, raw = read_exact_regular(
        report_path, "bootstrap self-image compile report"
    )
    if not raw.endswith(b"\n") or b"\0" in raw or b"\r" in raw:
        fail("bootstrap self-image compile report encoding drifted")
    rows: dict[str, str] = {}
    for line in raw[:-1].split(b"\n"):
        key_raw, separator, value_raw = line.partition(b"=")
        if (
            separator != b"="
            or not re.fullmatch(rb"[a-z][a-z0-9_]*", key_raw)
        ):
            fail("bootstrap self-image compile report row drifted")
        key = key_raw.decode("ascii")
        if key in rows:
            fail("bootstrap self-image compile report key aliases")
        try:
            rows[key] = value_raw.decode("utf-8", "strict")
        except UnicodeDecodeError as exc:
            raise PhaseEngineError(
                "bootstrap self-image compile report is not UTF-8"
            ) from exc
    required = {
        "self_image_source",
        "self_image_executable_format",
        "self_image_fd",
        "self_image_pre_device",
        "self_image_pre_inode",
        "self_image_pre_mode",
        "self_image_pre_uid",
        "self_image_pre_gid",
        "self_image_pre_nlink",
        "self_image_pre_size",
        "self_image_pre_sha256",
        "self_image_pre_portable_cid",
        "self_image_copy_sha256",
        "self_image_copy_matches_pre",
        "self_image_post_device",
        "self_image_post_inode",
        "self_image_post_mode",
        "self_image_post_uid",
        "self_image_post_gid",
        "self_image_post_nlink",
        "self_image_post_size",
        "self_image_post_sha256",
        "self_image_post_portable_cid",
        "self_image_stable",
    }
    if executable_path is not None or generated_path is not None:
        required.update({
            "output",
            "bootstrap_publication_executable_path",
            "bootstrap_publication_generated_path",
            "bootstrap_publication_report_path",
            "bootstrap_generated_c_sha256",
            "bootstrap_candidate_sha256",
        })
    if not required.issubset(rows):
        fail("bootstrap self-image compile report is incomplete")
    size = int(guard_rows["self_image_source_size"])
    digest = guard_rows["self_image_source_sha256"]
    portable_cid = bootstrap_self_image_portable_cid(size, digest)
    try:
        source_mode = int(guard_rows["self_image_source_mode"], 8)
    except ValueError as exc:
        raise PhaseEngineError(
            "bootstrap self-image source mode is invalid"
        ) from exc
    source_permission_mode = format(stat.S_IMODE(source_mode), "o")
    physical_pairs = (
        ("device", "device"),
        ("inode", "inode"),
        ("uid", "uid"),
        ("gid", "gid"),
        ("nlink", "nlink"),
        ("size", "size"),
    )
    if (
        rows["self_image_source"] != "pinned_fd"
        or rows["self_image_executable_format"]
            != expected_executable_format
        or rows["self_image_fd"] != "198"
        or guard_rows["self_image_source_mode"]
            not in ("100500", "100555")
        or rows["self_image_pre_mode"] != source_permission_mode
        or rows["self_image_post_mode"] != source_permission_mode
        or rows["self_image_pre_sha256"] != digest
        or rows["self_image_copy_sha256"] != digest
        or rows["self_image_post_sha256"] != digest
        or rows["self_image_pre_portable_cid"] != portable_cid
        or rows["self_image_post_portable_cid"] != portable_cid
        or rows["self_image_copy_matches_pre"] != "1"
        or rows["self_image_stable"] != "1"
        or any(
            rows[f"self_image_pre_{report_suffix}"]
                != guard_rows[f"self_image_source_{guard_suffix}"]
            or rows[f"self_image_post_{report_suffix}"]
                != guard_rows[f"self_image_source_{guard_suffix}"]
            for report_suffix, guard_suffix in physical_pairs
        )
    ):
        fail("bootstrap self-image compile report authority drifted")
    if executable_path is not None or generated_path is not None:
        if executable_path is None or generated_path is None:
            fail("bootstrap publication output authority is incomplete")
        executable_info, executable_raw = read_exact_regular(
            executable_path, "bootstrap published executable"
        )
        generated_info, generated_raw = read_exact_regular(
            generated_path, "bootstrap published generated C"
        )
        report_info = os.stat(report_path, follow_symlinks=False)
        if (
            rows["output"] != str(executable_path)
            or rows["bootstrap_publication_executable_path"]
                != str(executable_path)
            or rows["bootstrap_publication_generated_path"]
                != str(generated_path)
            or rows["bootstrap_publication_report_path"]
                != str(report_path)
            or rows["bootstrap_candidate_sha256"]
                != sha256_bytes(executable_raw)
            or rows["bootstrap_generated_c_sha256"]
                != sha256_bytes(generated_raw)
            or stat.S_IMODE(executable_info.st_mode) != 0o555
            or stat.S_IMODE(generated_info.st_mode) != 0o444
            or stat.S_IMODE(report_info.st_mode) != 0o444
            or executable_info.st_nlink != 1
            or generated_info.st_nlink != 1
            or report_info.st_nlink != 1
        ):
            fail("bootstrap publication terminal authority drifted")


def remove_verified_guard_snapshot(
    report_path: Path,
    compile_report_path: Path | None = None,
    executable_path: Path | None = None,
    generated_path: Path | None = None,
) -> None:
    _info, raw = read_exact_regular(
        report_path, "phase guard receipt"
    )
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeDecodeError as exc:
        raise PhaseEngineError(
            "phase guard receipt is not UTF-8"
        ) from exc
    rows: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if not separator or key in rows:
            fail("phase guard receipt row drifted")
        rows[key] = value
    required = (
        "command_execution_mode",
        "command_execution_snapshot_path",
        "command_execution_snapshot_sha256",
        "command_execution_snapshot_device",
        "command_execution_snapshot_inode",
        "command_execution_snapshot_size",
        "self_image_fd_schema",
        "self_image_fd",
        "self_image_source_path",
        "self_image_source_sha256",
        "self_image_source_device",
        "self_image_source_inode",
        "self_image_source_mode",
        "self_image_source_nlink",
        "self_image_source_uid",
        "self_image_source_gid",
        "self_image_source_size",
        "self_image_source_mtime_ns",
        "self_image_source_ctime_ns",
        "self_image_argv_count",
        "self_image_argv_sha256",
        "self_image_authority_status",
        "self_image_inheritance_status",
        "self_image_identity_status",
        "self_image_source_fd_close_status",
    )
    if any(key not in rows for key in required):
        fail("phase guard snapshot identity is incomplete")
    snapshot = Path(rows["command_execution_snapshot_path"])
    parent = snapshot.parent
    if (
        rows["command_execution_mode"]
            != "private_single_link_snapshot"
        or snapshot.name != "command.snapshot"
        or parent.parent != report_path.parent
        or not re.fullmatch(r"\.beat-c-command\.[A-Za-z0-9_]+", parent.name)
    ):
        fail("phase guard snapshot path is not exact transient")
    info, snapshot_raw = read_exact_regular(
        snapshot, "phase guard command snapshot"
    )
    if (
        sha256_bytes(snapshot_raw)
            != rows["command_execution_snapshot_sha256"]
        or str(info.st_dev)
            != rows["command_execution_snapshot_device"]
        or str(info.st_ino)
            != rows["command_execution_snapshot_inode"]
        or str(info.st_size)
            != rows["command_execution_snapshot_size"]
        or tuple(parent.iterdir()) != (snapshot,)
    ):
        fail("phase guard command snapshot identity drifted")
    if rows["self_image_fd"] == "198":
        if (
            rows["self_image_fd_schema"]
                != "cheng.guard.command_self_image_fd"
            or rows["self_image_source_path"] != str(snapshot)
            or rows["self_image_source_sha256"]
                != rows["command_execution_snapshot_sha256"]
            or rows["self_image_source_device"] != str(info.st_dev)
            or rows["self_image_source_inode"] != str(info.st_ino)
            or rows["self_image_source_mode"] != format(info.st_mode, "o")
            or rows["self_image_source_nlink"] != str(info.st_nlink)
            or rows["self_image_source_uid"] != str(info.st_uid)
            or rows["self_image_source_gid"] != str(info.st_gid)
            or rows["self_image_source_size"] != str(info.st_size)
            or rows["self_image_source_mtime_ns"]
                != str(info.st_mtime_ns)
            or rows["self_image_source_ctime_ns"]
                != str(info.st_ctime_ns)
            or rows["self_image_argv_count"] != "1"
            or rows["self_image_argv_sha256"]
                != rows.get("command_argv_sha256")
            or rows["self_image_authority_status"]
                != "verified_snapshot_fd_held_through_terminal"
            or rows["self_image_inheritance_status"]
                != "verified_preexec_exact"
            or rows["self_image_identity_status"]
                != "verified_snapshot_child_preexec_and_terminal"
            or rows.get("self_image_source_fd_close_status")
                != "deferred_to_monitor_process_exit"
        ):
            fail("phase guard self-image fd authority drifted")
        if compile_report_path is None:
            fail("phase guard self-image compile report is absent")
        validate_bootstrap_self_image_compile_report(
            compile_report_path,
            rows,
            executable_format(snapshot_raw),
            executable_path,
            generated_path,
        )
    elif (
        rows["self_image_fd"] != "0"
        or rows["self_image_source_path"]
        or rows["self_image_source_sha256"]
        or rows["self_image_argv_count"] != "0"
        or rows["self_image_argv_sha256"]
        or rows["self_image_authority_status"] != "not_requested"
        or rows["self_image_inheritance_status"] != "not_requested"
        or rows["self_image_identity_status"] != "not_requested"
        or rows.get("self_image_source_fd_close_status")
            != "not_requested"
    ):
        fail("phase guard unexpected self-image fd authority")
    snapshot.unlink()
    parent.rmdir()


def strict_guard_report(path: Path) -> tuple[dict[str, str], bytes]:
    _info, raw = read_exact_regular(path, "phase guard report")
    if not raw.endswith(b"\n") or b"\0" in raw or b"\r" in raw:
        fail("phase guard report encoding drifted")
    rows: dict[str, str] = {}
    for line in raw[:-1].split(b"\n"):
        if b"=" not in line:
            fail("phase guard report row lacks separator")
        key_raw, value_raw = line.split(b"=", 1)
        try:
            key = key_raw.decode("ascii", "strict")
            value = value_raw.decode("utf-8", "strict")
        except UnicodeDecodeError as exc:
            raise PhaseEngineError(
                "phase guard report encoding is invalid"
            ) from exc
        if (
            not re.fullmatch(r"[a-z][a-z0-9_]*", key)
            or key in rows
        ):
            fail("phase guard report key drifted")
        rows[key] = value
    return rows, raw


