                    source_path
                    if action_source is not None
                    else role_paths[f"local_c_header_{offset:04d}"]
                ),
                planned_paths[role],
            )
        copy_new_file(
            guard_stdout, planned_paths["cc_deps_pre_stdout"]
        )
        closure_input_roles = [
            "snapshot_bootstrap",
            "snapshot_contract",
            "snapshot_bootstrap_manifest",
            "snapshot_package_manifest",
            "snapshot_t7",
            *(
                role
                for role, _source in dynamic_snapshot_outputs(
                    paths, action_source
                )
            ),
        ]
        raw = authority_manifest_bytes(
            "freeze_source_snapshot",
            index,
            tuple(
                sealed_output_authority_input(
                    role, plan, planned_paths
                )
                for role in closure_input_roles
