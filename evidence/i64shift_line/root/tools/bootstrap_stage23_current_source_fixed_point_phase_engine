def phase_directory_first_owner(relative: str) -> int:
    path = Path(relative)
    parts = path.parts
    if (
        not relative
        or path.is_absolute()
        or str(path) != relative
        or any(part in ("", ".", "..") for part in parts)
    ):
        fail("phase declared directory is not canonical relative")
    top_level = parts[0]
    if top_level == "phase-receipts":
        if len(parts) == 1:
            return 0
        if (
            len(parts) != 2
            or len(parts[1]) != 2
            or not parts[1].isascii()
            or not parts[1].isdigit()
        ):
            fail("phase receipt directory is not exact")
        owner = int(parts[1], 10)
        if owner < 0 or owner >= PHASE_COUNT:
            fail("phase receipt directory owner is outside the chain")
        return owner
    if top_level == "source-snapshot":
        return 0
    if len(parts) != 1 or top_level not in PHASE_DIRECTORY_FIRST_OWNER:
        fail("phase declared directory has no first-owner authority")
    return PHASE_DIRECTORY_FIRST_OWNER[top_level]


