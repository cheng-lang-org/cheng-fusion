    paths: PhasePaths,
    role_paths: dict[str, Path],
    identities: dict[str, dict[str, Any]],
    planned_paths: dict[str, Path],
) -> None:
    index = plan["phaseIndex"]
    guard_stdout_role = (
        "phase_guard_00_stdout"
        if "commandActions" in plan else "phase_guard_stdout"
    )
    guard_stdout = planned_paths[guard_stdout_role]
    if index == 0:
        action_source = (
            paths.command_action_source(0, 0)
            if "commandActions" in plan else None
        )
        copy_new_file(
            (
                action_source / "bootstrap/cheng_cold.c"
                if action_source is not None
                else role_paths["bootstrap_source"]
            ),
            planned_paths["snapshot_bootstrap"],
        )
        copy_new_file(
            (
                action_source / "bootstrap/stage1_bootstrap.cheng"
                if action_source is not None
                else role_paths["bootstrap_contract"]
            ),
            planned_paths["snapshot_contract"],
        )
        copy_new_file(
            (
                action_source / BOOTSTRAP_MANIFEST_RELATIVE
                if action_source is not None
                else role_paths["bootstrap_manifest"]
            ),
            planned_paths["snapshot_bootstrap_manifest"],
        )
        copy_new_file(
            (
                action_source / PACKAGE_MANIFEST_RELATIVE
                if action_source is not None
                else role_paths["package_manifest"]
            ),
            planned_paths["snapshot_package_manifest"],
        )
        copy_new_file(
