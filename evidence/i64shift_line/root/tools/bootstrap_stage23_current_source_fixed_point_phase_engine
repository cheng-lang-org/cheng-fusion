        )
        write_new_file(
            planned_paths[stage + "_atom_manifest"], raw, 0o400
        )
    elif index == 10:
        stage2 = role_paths["stage2"]
        stage3 = role_paths["stage3"]
        stage2_info, stage2_raw = read_exact_regular(stage2, "stage2")
        stage3_info, stage3_raw = read_exact_regular(stage3, "stage3")
        if (
            stage2_raw != stage3_raw
            or sha256_bytes(stage2_raw) != sha256_bytes(stage3_raw)
        ):
            fail("stage2 and stage3 raw bytes differ")
        raw = authority_manifest_bytes(
            "seal_stage2_stage3_fixed_point",
            index,
            (
                frozen_role_authority_input(
                    "stage2",
                    "executable",
                    paths.stage(2),
                    role_paths,
                    identities,
                    plan["lane"],
                ),
                frozen_role_authority_input(
                    "stage3",
                    "executable",
                    paths.stage(3),
                    role_paths,
                    identities,
                    plan["lane"],
                ),
            ),
