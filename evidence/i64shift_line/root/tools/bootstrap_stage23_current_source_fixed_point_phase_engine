def local_c_source_closure(
    paths: PhasePaths,
    source_root: Path | None = None,
) -> tuple[Path, ...]:
    root = paths.root if source_root is None else source_root
    bootstrap_source = (
        paths.bootstrap_source
        if source_root is None
        else source_root / "bootstrap/cheng_cold.c"
    )
    pending = [bootstrap_source]
    observed: set[Path] = set()
    include_pattern = re.compile(
        rb'^[ \t]*#[ \t]*include[ \t]*"([^"\r\n]+)"',
        re.MULTILINE,
    )
    while pending:
        path = pending.pop()
        if path in observed:
            continue
        try:
            resolved = path.resolve(strict=True)
            info = os.lstat(path)
            raw = path.read_bytes()
            resolved.relative_to(root)
        except (OSError, ValueError) as exc:
            raise PhaseEngineError(
                "local C closure input cannot be resolved"
            ) from exc
        if (
            resolved != path
            or not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_nlink != 1
        ):
            fail("local C closure input is not exact regular")
        observed.add(path)
        for match in include_pattern.finditer(raw):
            try:
                include_text = os.fsdecode(match.group(1))
            except UnicodeError as exc:
                raise PhaseEngineError(
                    "local C include path is not filesystem text"
                ) from exc
            include_path = path.parent / include_text
            try:
                include_path.resolve(strict=True).relative_to(root)
            except (OSError, ValueError) as exc:
                raise PhaseEngineError(
                    "local C include escapes source root"
                ) from exc
            pending.append(include_path)
    observed.remove(bootstrap_source)
    return tuple(sorted(
        observed,
        key=lambda item: os.fsencode(str(item.relative_to(root))),
    ))


def dynamic_snapshot_outputs(
    paths: PhasePaths,
    source_root: Path | None = None,
) -> tuple[tuple[str, Path], ...]:
    return tuple(
