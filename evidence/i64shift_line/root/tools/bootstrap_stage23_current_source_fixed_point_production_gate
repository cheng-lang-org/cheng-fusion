def validate_static_configuration() -> None:
    phase_engine.validate_configuration()
    if (
        len(PHASE_SPECS) != 16
        or phase_engine.LANE_TARGET_TRIPLE != LANE_TARGET_TRIPLE
        or phase_engine.LANE_MACHINE_AUTHORITY
            != LANE_MACHINE_AUTHORITY
        or phase_engine.LANE_EXECUTABLE_FORMAT != {
            LANE_LINUX: FORMAT_ELF64_X86_64,
            LANE_DARWIN: FORMAT_MACHO_ARM64,
        }
        or phase_engine.STAGE_INPUT_MANIFEST_SCHEMA
            != STAGE_INPUT_MANIFEST_SCHEMA
        or phase_engine.STAGE_INPUT_MANIFEST_SINGLE_COMMAND_FIELDS
            != STAGE_INPUT_MANIFEST_SINGLE_COMMAND_FIELDS
        or phase_engine.STAGE_INPUT_MANIFEST_MULTI_ACTION_FIELDS
            != STAGE_INPUT_MANIFEST_MULTI_ACTION_FIELDS
        or phase_engine.PHASE_ACTION_TERMINAL_SCHEMA
            != PHASE_ACTION_TERMINAL_SCHEMA
        or phase_engine.PHASE_ACTION_TERMINAL_SINGLE_COMMAND_FIELDS
            != PHASE_ACTION_TERMINAL_SINGLE_COMMAND_FIELDS
        or phase_engine.PHASE_ACTION_TERMINAL_MULTI_ACTION_FIELDS
            != PHASE_ACTION_TERMINAL_MULTI_ACTION_FIELDS
        or phase_engine.BOOTSTRAP_MANIFEST_RELATIVE
            != BOOTSTRAP_MANIFEST_RELATIVE
        or phase_engine.PACKAGE_MANIFEST_RELATIVE
            != PACKAGE_MANIFEST_RELATIVE
    ):
        fail("phase count, target, machine, format, or schema drifted")


def initial_phase_state(
    boundary: LaneBoundary,
    paths: Any,
    static_identities: Mapping[str, ArtifactIdentity],
    guest_paths: Mapping[str, str] | None = None,
) -> PhaseState:
    validate_static_configuration()
    roles = set(static_identities)
    if not set(STATIC_REQUIRED_ROLES).issubset(roles):
        fail("static identity roles are incomplete")
    contract_identity = static_identities["bootstrap_contract"]
    manifest_identity = static_identities["bootstrap_manifest"]
    package_manifest_identity = static_identities["package_manifest"]
    observed_contract, contract_raw = stable_artifact(
        identity_host_path(contract_identity), executable=False
    )
    observed_package_manifest, package_manifest_raw = stable_artifact(
        identity_host_path(package_manifest_identity), executable=False
    )
    if (
        observed_contract != contract_identity
        or observed_package_manifest != package_manifest_identity
        or canonical_package_manifest_authority(
            package_manifest_raw
        ) != ("pkg://cheng", "cheng")
        or bootstrap_manifest_relative_path(contract_raw)
            != BOOTSTRAP_MANIFEST_RELATIVE
        or identity_host_path(manifest_identity)
            != paths.root / BOOTSTRAP_MANIFEST_RELATIVE
        or identity_host_path(package_manifest_identity)
            != paths.root / PACKAGE_MANIFEST_RELATIVE
    ):
        fail("package or bootstrap manifest role is not exact")
    extra_roles = roles - set(STATIC_REQUIRED_ROLES)
    if any(
        not is_transitive_executable_role(role)
        and not is_linux_frozen_regular_role(role)
        and not is_darwin_frozen_executable_role(role)
        and not is_darwin_frozen_regular_role(role)
        for role in extra_roles
    ):
        fail("additional frozen role is not canonical")
    if boundary.lane == LANE_LINUX and any(
        (
            is_darwin_frozen_regular_role(role)
            and not is_linux_frozen_regular_role(role)
        )
        or is_darwin_frozen_executable_role(role)
        for role in extra_roles
    ):
        fail("Linux phase state contains Darwin frozen inputs")
    if (
        boundary.lane == LANE_DARWIN
        and "production_gate" not in roles
    ):
        fail("Darwin phase state lacks its coordinator producer")
    identity_paths = [
        item.path_fshex for item in static_identities.values()
    ]
    if len(identity_paths) != len(set(identity_paths)):
        fail("static identities alias one path")
    lane_format = expected_lane_format(boundary.lane)
    static_executable_formats = {lane_format}
    if boundary.lane == LANE_DARWIN:
        static_executable_formats.add(FORMAT_MACHO_UNIVERSAL_ARM64)
    for role in STATIC_EXECUTABLE_ROLES:
        if static_identities[role].artifact_format not in (
            static_executable_formats
        ):
            fail("static executable does not match lane target machine")
    for role in STATIC_REGULAR_ROLES:
        if static_identities[role].artifact_format != FORMAT_REGULAR:
            fail("static bound input is not regular")
    for role in extra_roles:
        if (
            is_transitive_executable_role(role)
            or is_darwin_frozen_executable_role(role)
        ):
            if static_identities[role].artifact_format not in (
                static_executable_formats
            ):
                fail(
                    "transitive executable does not match lane target machine"
                )
        elif static_identities[role].artifact_format != FORMAT_REGULAR:
            fail("Darwin frozen toolchain input is not regular")
    if not isinstance(paths, phase_engine.PhasePaths):
        fail("phase paths authority is absent")
    for path in (paths.root, paths.evidence, paths.cc):
        if not path.is_absolute():
            fail("phase paths authority is not absolute")
    normalized_guest_paths: dict[str, str] = {}
    if boundary.lane == LANE_LINUX:
        if guest_paths is None or set(guest_paths) != roles:
            fail("Linux guest path mapping is not exact")
        for role, guest_path in guest_paths.items():
            normalized_guest_paths[role] = canonical_guest_path(
                guest_path, "guest role " + role
            )
            if normalized_guest_paths[role] != expected_linux_guest_path(
                role
            ):
                fail("Linux guest role path drifted")
        if len(set(normalized_guest_paths.values())) != len(
            normalized_guest_paths
        ):
            fail("Linux guest path mapping aliases roles")
    elif guest_paths:
        fail("Darwin phase state received Linux guest paths")
    return PhaseState(
        boundary,
        paths,
        0,
        dict(static_identities),
        normalized_guest_paths,
        (),
        (),
        (),
        (),
        {},
        {},
        {},
    )


def executable_entries(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
) -> tuple[list[dict[str, Any]], str]:
    entries = []
    for role in allowlist.roles:
        identity = state.frozen.get(role)
        if identity is None or identity.artifact_format == FORMAT_REGULAR:
            fail("allowlist role is not a frozen executable")
        payload = identity.payload()
        if state.boundary.lane == LANE_LINUX:
            payload = guest_manifest_entry(
                identity,
                state.guest_paths[role],
            )
        entries.append({"role": role, "identity": payload})
    return entries, sha256_bytes(canonical_json(entries))


def phase_bound_roles(plan: Mapping[str, Any]) -> tuple[str, ...]:
    runner_roles = (
        ("phase_engine", "stage_gate")
        if plan["phaseIndex"] == 10
        else (
            "phase_engine",
            "process_guard",
            "process_guard_runtime",
            "stage_gate",
        )
    )
    return (*runner_roles, *plan["boundInputRoles"])


def identity_host_path(identity: ArtifactIdentity) -> Path:
    try:
        return Path(os.fsdecode(bytes.fromhex(identity.path_fshex)))
    except (UnicodeError, ValueError) as exc:
        raise ProductionGateError(
            "artifact host path cannot be decoded"
        ) from exc


def phase_plan_for_state(state: PhaseState) -> dict[str, Any]:
    plan = phase_engine.phase_plan(
        state.next_phase_index,
        state.paths,
        state.boundary.lane,
    )
    if state.boundary.lane == LANE_LINUX:
        return linux_guest_phase_plan(plan, state.paths)
    return plan


def linux_guest_phase_plan(
    plan: Mapping[str, Any],
    paths: Any,
) -> dict[str, Any]:
    replacements = (
        (str(paths.evidence), "/cheng-stage23-evidence"),
        (str(paths.root), "/cheng-stage23-source/repo"),
        (str(paths.cc), "/usr/bin/cc"),
    )

    def translate_text(value: str) -> str:
        prefix = ""
        candidate = value
        if value.startswith("--") and ":" in value:
            prefix, candidate = value.split(":", 1)
            prefix += ":"
        for host, guest in replacements:
            if candidate == host or candidate.startswith(host + "/"):
                return prefix + guest + candidate[len(host):]
        return value

    def translate(value: Any, key: str | None = None) -> Any:
        if isinstance(value, dict):
            return {
                item_key: translate(item_value, item_key)
                for item_key, item_value in value.items()
            }
        if isinstance(value, list):
            return [translate(item, key) for item in value]
        if isinstance(value, str):
            if key == "pathFshex":
                try:
                    decoded = os.fsdecode(bytes.fromhex(value))
                except (UnicodeError, ValueError) as exc:
                    raise ProductionGateError(
                        "phase plan fshex cannot be translated"
                    ) from exc
                return os.fsencode(translate_text(decoded)).hex()
            return translate_text(value)
        return value

    translated = translate(dict(plan))
    if not isinstance(translated, dict):
        fail("Linux guest phase plan translation failed")
    return translated


def linux_guest_path_for_host(state: PhaseState, host_path: Path) -> str:
    if state.boundary.lane != LANE_LINUX:
        fail("guest path requested for non-Linux phase")
    for role, identity in state.frozen.items():
        if identity_host_path(identity) == host_path:
            return canonical_guest_path(
                state.guest_paths[role], "frozen guest path"
            )
    if host_path == state.paths.evidence or state.paths.evidence in host_path.parents:
        return tree_guest_path(
            host_path,
            state.paths.evidence,
            "/cheng-stage23-evidence",
            "evidence artifact",
        )
    if host_path == state.paths.root or state.paths.root in host_path.parents:
        return tree_guest_path(
            host_path,
            state.paths.root,
            "/cheng-stage23-source/repo",
            "source artifact",
        )
    fail("host path has no fixed guest mapping")


def host_path_for_planned_fshex(
    state: PhaseState,
    path_fshex: str,
) -> Path:
    canonical_path_fshex(path_fshex, "planned output path")
    path = Path(os.fsdecode(bytes.fromhex(path_fshex)))
    if state.boundary.lane == LANE_DARWIN:
        return path
    for guest_root, host_root in (
        (Path("/cheng-stage23-evidence"), state.paths.evidence),
        (Path("/cheng-stage23-source/repo"), state.paths.root),
    ):
        if path == guest_root or guest_root in path.parents:
            return host_root / path.relative_to(guest_root)
    fail("Linux planned output path is outside fixed guest trees")


def lane_role_path(state: PhaseState, role: str) -> str:
    identity = state.frozen.get(role)
    if identity is None:
        fail("lane role path is not frozen")
    if state.boundary.lane == LANE_LINUX:
        return canonical_guest_path(
            state.guest_paths[role], "lane role " + role
        )
    return str(identity_host_path(identity))


def darwin_stage_input_manifest_relative_path(
    phase_index: int,
) -> str:
    if phase_index < 0 or phase_index >= len(PHASE_SPECS):
        fail("Darwin stage input manifest phase is outside the chain")
    return str(
        Path("phase-receipts")
        / f"{phase_index:02d}"
