        "compiler_device": str(compiler_identity.device),
        "compiler_inode": str(compiler_identity.inode),
        "compiler_mode": str(compiler_identity.mode),
        "compiler_nlink": str(compiler_identity.nlink),
        "compiler_size": str(compiler_identity.size),
        "compiler_uid": str(compiler_identity.uid),
        "compiler_gid": str(compiler_identity.gid),
        "compiler_format": compiler_identity.artifact_format,
        "compiler_kernel_authority":
            "linux_fs_verity_sha256_and_fs_immutable",
        "compiler_fsverity_digest": compiler_verity,
        "compiler_fs_flags": str(compiler_flags),
        "production_gate_sha256": production_identity.sha256,
        "verifier_inputs_cid": current_verifier_inputs_cid,
        "source_snapshot_cid": receipt["source_snapshot_cid"],
        "linux_target_triple": receipt["linux_target_triple"],
        "linux_machine_authority": receipt["linux_machine_authority"],
        "linux_stage_fixed_point_sha256":
            receipt["linux_stage_fixed_point_sha256"],
        "external_anchor_file_sha256":
            receipt["external_anchor_file_sha256"],
        "authority_verification_sha256":
            receipt["authority_verification_sha256"],
    }
    report = canonical_portable_report_bytes(
        values,
        PORTABLE_AUTHORITY_VERIFY_KEY_ORDER,
        "verification_sha256",
    )
    final_receipt = authenticate_linux_kernel_immutable_file(
        LINUX_PORTABLE_AUTHORITY_RECEIPT_PATH,
        "portable authority receipt",
        executable=False,
        exact_mode=0o400,
        max_bytes=MAX_AUTHORITY_BYTES,
