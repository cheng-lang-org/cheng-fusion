    produced, post_directories, post_files = (
        observed_linux_phase_tree(state, envelope)
    )
    workload = exact_linux_evidence_directory(
        cgroup_evidence_root / "workload"
    )
    exact_linux_evidence_directory(
        cgroup_evidence_root / "aggregate-oom"
    )
    control = exact_linux_evidence_directory(workload / "control")
    ledger_manifest_raw = stable_linux_evidence_raw(
        control / "exec-ledger-manifest.json", "ptrace manifest"
    )
    ledger_receipt_raw = stable_linux_evidence_raw(
        control / "exec-ledger-receipt.json", "ptrace receipt"
    )
    ledger_validation_raw = stable_linux_evidence_raw(
        control / "exec-ledger-validator.stdout", "ptrace validation"
    )
    cgroup_receipt_raw = stable_linux_evidence_raw(
        workload / "receipt.kv", "cgroup receipt"
    )
    cgroup_input_raw = stable_linux_evidence_raw(
        workload / "input-manifest.json", "cgroup input"
    )
    stage_authority_raw = stable_linux_evidence_raw(
