def verify_existing_authority_final_fence(
    bindings: ExistingAuthorityRawBindings,
    linux_root_identity: DirectoryIdentity,
    linux_closure_cid: str,
    darwin_root_identity: DirectoryIdentity,
    darwin_closure_cid: str,
    darwin_state: PhaseState,
    portable_anchor: AuthenticatedLinuxPortableAnchor,
) -> None:
    rebound = verify_existing_authority_raw_bindings()
    if rebound != bindings:
        fail("authority artifacts changed during verification")
    final_linux_identity, final_linux_cid = (
        sealed_portable_evidence_closure(
            LINUX_EVIDENCE_ROOT, LANE_LINUX
        )
    )
    final_darwin_identity, final_darwin_cid = (
        sealed_portable_evidence_closure(
            DARWIN_EVIDENCE_ROOT, LANE_DARWIN
        )
    )
    if (
        final_linux_identity != linux_root_identity
        or final_linux_cid != linux_closure_cid
        or final_darwin_identity != darwin_root_identity
        or final_darwin_cid != darwin_closure_cid
        or current_source_snapshot_cid(darwin_state)
            != bindings.composite_payload["sourceSnapshotCid"]
    ):
        fail("authority closure changed during verification")
    final_anchor = authenticate_linux_portable_anchor(
        production_sha=bindings.production_gate_identity.sha256,
        verifier_inputs_cid=bindings.verifier_inputs_cid,
        linux_evidence_closure_cid=linux_closure_cid,
        linux_receipt_sha256=bindings.linux_receipt_identity.sha256,
        darwin_evidence_closure_cid=darwin_closure_cid,
        darwin_receipt_sha256=bindings.darwin_receipt_identity.sha256,
        composite_terminal_sha256=bindings.composite_identity.sha256,
        installed_stage3_sha256=bindings.installed_stage3.sha256,
        linux_payload=bindings.linux_payload,
        darwin_payload=bindings.darwin_payload,
    )
    if final_anchor != portable_anchor:
        fail("portable anchor changed during verification")


def privileged_publisher_authority_values(
    bindings: ExistingAuthorityRawBindings,
    linux_evidence_closure_cid: str,
    darwin_evidence_closure_cid: str,
    portable_anchor: AuthenticatedLinuxPortableAnchor,
) -> dict[str, str]:
    publisher_identity, _publisher_raw = stable_artifact(
        AUTHORITY_PUBLISHER, executable=False
    )
    if publisher_identity.nlink != 1:
        fail("authority publisher is physically aliased")

    def physical(
        prefix: str,
        identity: ArtifactIdentity,
        values: dict[str, str],
        *,
        include_format: bool = False,
    ) -> None:
        values[prefix + "_path_fshex"] = identity.path_fshex
        values[prefix + "_sha256"] = identity.sha256
        values[prefix + "_device"] = str(identity.device)
        values[prefix + "_inode"] = str(identity.inode)
        values[prefix + "_mode"] = str(identity.mode)
        values[prefix + "_nlink"] = str(identity.nlink)
        values[prefix + "_size"] = str(identity.size)
        values[prefix + "_uid"] = str(identity.uid)
        values[prefix + "_gid"] = str(identity.gid)
        if include_format:
            values[prefix + "_format"] = identity.artifact_format

    values: dict[str, str] = {
        "schema": PUBLISHER_AUTHORITY_SCHEMA,
        "status": "PUBLISHED",
        "authentication_method":
            "root_fixed_path_external_immutable_anchor",
        "production_execution_status":
            "PROVED_CROSS_PLATFORM_COMPOSITE",
        "dynamic_completion_credit": "1",
        "production_gate_sha256":
            bindings.production_gate_identity.sha256,
        "authority_publisher_sha256": publisher_identity.sha256,
        "verifier_inputs_cid": bindings.verifier_inputs_cid,
    }
    physical("external_anchor", portable_anchor.identity, values)
    values["external_anchor_flags"] = str(portable_anchor.flags)
    physical("material_authority", bindings.authority_identity, values)
    physical(
        "installed_stage3",
        bindings.installed_stage3,
        values,
        include_format=True,
    )
    physical("composite_terminal", bindings.composite_identity, values)
    composite = bindings.composite_payload
    values.update({
        "linux_lane_receipt_sha256":
            bindings.linux_receipt_identity.sha256,
        "darwin_lane_receipt_sha256":
            bindings.darwin_receipt_identity.sha256,
        "linux_evidence_closure_cid":
            canonical_sha256(
                linux_evidence_closure_cid,
                "privileged publisher Linux evidence closure",
            ),
        "darwin_evidence_closure_cid":
            canonical_sha256(
                darwin_evidence_closure_cid,
                "privileged publisher Darwin evidence closure",
            ),
        "source_snapshot_cid": composite["sourceSnapshotCid"],
        "generated_c_portable_cid": composite["generatedCPortableCid"],
        "linux_stage_fixed_point_sha256":
            composite["linuxStageFixedPointSha256"],
        "darwin_stage_fixed_point_sha256":
            composite["darwinStageFixedPointSha256"],
    })
    if tuple(values) != PUBLISHER_AUTHORITY_KEY_ORDER[:-1]:
        fail("privileged publisher receipt construction order drifted")
    return values


def authenticate_privileged_publisher_authority(
    expected_values: Mapping[str, str],
) -> tuple[ArtifactIdentity, bytes]:
    if sys.platform != "darwin":
        fail("privileged publisher authority requires Darwin")
    require_root_owned_fixed_parent_chain(
        PUBLISHER_AUTHORITY_RECEIPT_PATH,
        "privileged publisher authority receipt",
    )
    identity, raw = stable_artifact(
        PUBLISHER_AUTHORITY_RECEIPT_PATH,
        executable=False,
    )
    expected_raw = publisher_authority_receipt_bytes(expected_values)
    if (
        identity.nlink != 1
        or stat.S_IMODE(identity.mode) != 0o400
        or identity.uid != 0
        or identity.gid != 0
        or raw != expected_raw
        or parse_publisher_authority_receipt_bytes(raw)
            != parse_publisher_authority_receipt_bytes(expected_raw)
    ):
        fail("privileged publisher authority receipt is not exact")
    return identity, raw


def verify_existing_authority() -> bytes:
    bindings = verify_existing_authority_raw_bindings()
    linux_root_identity, linux_closure_cid = (
        sealed_portable_evidence_closure(
            LINUX_EVIDENCE_ROOT, LANE_LINUX
        )
    )
    validate_linux_portable_evidence_closure(
        LINUX_EVIDENCE_ROOT,
        bindings.linux_receipt_raw,
        bindings.linux_payload,
    )
    darwin_root_identity, darwin_closure_cid = (
        sealed_portable_evidence_closure(
            DARWIN_EVIDENCE_ROOT, LANE_DARWIN
        )
    )
    darwin_state, darwin_receipt = reconstruct_darwin_physical_evidence(
        DARWIN_EVIDENCE_ROOT
    )
    if (
        darwin_receipt.receipt_bytes() != bindings.darwin_receipt_raw
        or completed_phase_chain_sha256(darwin_state)
            != bindings.darwin_payload["phaseChainSha256"]
        or current_source_snapshot_cid(darwin_state)
            != bindings.composite_payload["sourceSnapshotCid"]
    ):
        fail("Darwin completed-state evidence differs from lane receipt")
    rows = bindings.rows
    if (
        rows["linux_evidence_closure_cid"] != linux_closure_cid
        or rows["darwin_evidence_closure_cid"] != darwin_closure_cid
    ):
        fail("authority evidence closure CID drifted")
    portable_anchor = authenticate_linux_portable_anchor(
        production_sha=bindings.production_gate_identity.sha256,
        verifier_inputs_cid=bindings.verifier_inputs_cid,
        linux_evidence_closure_cid=linux_closure_cid,
        linux_receipt_sha256=bindings.linux_receipt_identity.sha256,
        darwin_evidence_closure_cid=darwin_closure_cid,
