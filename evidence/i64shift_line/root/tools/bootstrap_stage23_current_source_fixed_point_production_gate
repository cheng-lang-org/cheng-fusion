                or rows[prefix + "seal_status"] != "verified"
                or rows[prefix + "device"] != str(identity.device)
                or rows[prefix + "inode"] != str(identity.inode)
                or rows[prefix + "identity_stable"] != "1"
                or rows[prefix + "size"] != str(identity.size)
                or rows[prefix + "mode"] != format(identity.mode, "o")
                or rows[prefix + "nlink"] != str(identity.nlink)
                or rows[prefix + "uid"] != str(identity.uid)
                or rows[prefix + "gid"] != str(identity.gid)
                or rows[prefix + "mtime_ns"]
                    != str(output_physical["mtimeNs"])
                or rows[prefix + "ctime_ns"]
                    != str(output_physical["ctimeNs"])
                or any(
                    getattr(identity, field) != output_physical[key]
                    for field, key in (
                        ("device", "device"),
                        ("inode", "inode"),
                        ("mode", "mode"),
                        ("nlink", "nlink"),
                        ("uid", "uid"),
                        ("gid", "gid"),
                        ("size", "size"),
                    )
                )
                or rows[prefix + "target_fd"]
                    != str(
                        fd_binding["fd"]
                        if fd_binding is not None else 0
                    )
                or rows[prefix + "target_fd_path"]
                    != (
                        fd_binding["argvPath"]
                        if fd_binding is not None else ""
                    )
                or rows[prefix + "target_fd_argv_count"]
                    != ("1" if fd_binding is not None else "0")
                or rows[prefix + "target_fd_argv_sha256"]
                    != (
                        action["targetArgvSha256"]
                        if fd_binding is not None else ""
                    )
                or rows[prefix + "target_fd_inheritance_status"]
                    != (
                        "verified_preexec_exact"
                        if fd_binding is not None else "not_requested"
                    )
                or rows[prefix + "target_fd_identity_status"]
                    != (
                        "verified_held_single_link_output"
                        if fd_binding is not None else "not_requested"
                    )
            ):
                fail("private action tracked output drifted")
        receipts.append({
            "commandActionIndex": index,
            "targetExecutableRole": target_role,
            "targetArgvSha256": action["targetArgvSha256"],
            "guardReceiptSha256":
                sha256_bytes(action_evidence.guard_receipt_raw),
            "guardStdoutSha256":
                sha256_bytes(action_evidence.guard_stdout_raw),
            "guardStderrSha256":
                sha256_bytes(action_evidence.guard_stderr_raw),
            "businessOutputRoles": action["businessOutputRoles"],
            "privateFrozenTree": private_tree,
        })
    receipt_tuple = tuple(receipts)
    return receipt_tuple, sha256_bytes(canonical_json(receipt_tuple))


def validate_ledger_manifest_raw(raw: bytes) -> str:
    value = strict_canonical_json(
        raw[:-1], "ptrace ledger manifest"
    ) if raw.endswith(b"\n") else fail(
        "ptrace ledger manifest lacks newline"
    )
    if (
        not isinstance(value, dict)
        or set(value) != {
            "schema",
            "executables",
            "boundArgvFiles",
            "dynamicArgvUid",
            "dynamicArgvGid",
            "generatedArgvDirectoryPathFshex",
            "mutableOutputPathFshexes",
        }
        or value["schema"] != "cheng.linux_ptrace_exec_manifest"
        or not isinstance(value["executables"], list)
        or not value["executables"]
        or not isinstance(value["boundArgvFiles"], list)
        or not value["boundArgvFiles"]
        or value["dynamicArgvUid"] != 1
        or value["dynamicArgvGid"] != 1
        or value["generatedArgvDirectoryPathFshex"] != os.fsencode(
            phase_engine.LINUX_GENERATED_ARGV_DIRECTORY
        ).hex()
        or not isinstance(value["mutableOutputPathFshexes"], list)
        or value["mutableOutputPathFshexes"]
            != sorted(value["mutableOutputPathFshexes"])
        or len(set(value["mutableOutputPathFshexes"]))
            != len(value["mutableOutputPathFshexes"])
    ):
        fail("ptrace ledger manifest schema drifted")
    expected_fields = {
        "pathFshex", "sha256", "device", "inode", "size", "mode",
        "uid", "gid",
    }
    for label in ("executables", "boundArgvFiles"):
        rows = value[label]
        paths = []
        for row in rows:
            if (
                not isinstance(row, dict)
                or set(row) != expected_fields
                or not isinstance(row["pathFshex"], str)
            ):
                fail("ptrace ledger manifest member schema drifted")
            canonical_path_fshex(row["pathFshex"], "ptrace manifest path")
            canonical_sha256(row["sha256"], "ptrace manifest member")
            for field_name in ("device", "inode", "size", "mode", "uid", "gid"):
                canonical_uint(row[field_name], "ptrace manifest " + field_name)
            paths.append(row["pathFshex"])
        if paths != sorted(paths) or len(paths) != len(set(paths)):
            fail("ptrace ledger manifest paths are not canonical")
    bound_paths = {
        os.fsdecode(bytes.fromhex(item["pathFshex"]))
        for item in value["boundArgvFiles"]
    }
    if not {
        linux_cgroup_validator.STAGE23_EXECUTION_GUEST_PATH,
        linux_cgroup_validator.STAGE23_MANIFEST_PAIR_GUEST_PATH,
    }.issubset(bound_paths):
        fail("ptrace ledger manifest omits stage23 bound manifests")
    immutable_paths = {
        item["pathFshex"]
        for role in ("executables", "boundArgvFiles")
        for item in value[role]
    }
    for path_fshex in value["mutableOutputPathFshexes"]:
        canonical_path_fshex(path_fshex, "ptrace mutable output path")
        if path_fshex in immutable_paths:
            fail("ptrace mutable output aliases immutable authority")
    return sha256_bytes(raw)


def validate_ledger_receipt_raw(
    raw: bytes,
    envelope: Mapping[str, Any],
    manifest_sha256: str,
) -> tuple[str, int, str]:
    value = strict_canonical_json(raw[:-1], "ptrace ledger receipt") \
        if raw.endswith(b"\n") else fail("ptrace ledger lacks newline")
    if (
        not isinstance(value, dict)
        or set(value) != {"payload", "payloadSha256"}
        or not isinstance(value["payload"], dict)
    ):
        fail("ptrace ledger envelope fields drifted")
    payload = value["payload"]
    required = {
        "schema",
        "status",
        "applicability",
        "manifest",
        "commandArgvSha256",
        "expectedRootExitCode",
        "actualRootExitCode",
        "rootExitCodeContractStatus",
        "eventCount",
        "eventsSha256",
        "events",
    }
    if not required.issubset(payload):
        fail("ptrace ledger payload fields are incomplete")
    payload_sha = canonical_sha256(
        value["payloadSha256"], "ptrace ledger payload"
    )
    events = payload["events"]
    event_count = canonical_uint(payload["eventCount"], "ledger events")
    manifest = payload["manifest"]
    expected_exit = PHASE_SPECS[envelope["phaseIndex"]].expected_exit_code
    command_sha = canonical_sha256(
        payload["commandArgvSha256"], "ptrace ledger command argv"
    )
    if (
        payload_sha != sha256_bytes(canonical_json(payload))
        or payload["schema"] != "cheng.linux_ptrace_exec_ledger"
        or payload["status"] != "PROVED"
        or payload["applicability"]
            != "native_linux_parent_owned_ptrace_only"
        or not isinstance(manifest, dict)
        or manifest.get("sha256") != manifest_sha256
        or payload["expectedRootExitCode"] != expected_exit
        or payload["actualRootExitCode"] != expected_exit
        or payload["rootExitCodeContractStatus"] != "verified"
        or not isinstance(events, list)
        or event_count <= 0
        or event_count != len(events)
        or payload["eventsSha256"]
            != sha256_bytes(canonical_json(events))
    ):
        fail("ptrace ledger does not match phase runner authority")
    return payload_sha, event_count, command_sha


def validate_ledger_validation_raw(
    raw: bytes,
    ledger_raw: bytes,
    payload_sha256: str,
    manifest_sha256: str,
    expected_exit_code: int,
    event_count: int,
) -> dict[str, str]:
    rows = parse_unique_kv(raw, "ptrace standalone validation")
    expected_order = (
        "descendant_exec_ledger_receipt_validation_status",
        "receipt_sha256",
        "payload_sha256",
        "manifest_sha256",
        "producer_sha256",
        "expected_root_exit_code",
        "actual_root_exit_code",
        "event_count",
    )
    if (
        tuple(rows) != expected_order
        or rows[expected_order[0]] != "PROVED"
        or rows["receipt_sha256"] != sha256_bytes(ledger_raw)
        or rows["payload_sha256"] != payload_sha256
        or rows["manifest_sha256"] != manifest_sha256
        or rows["expected_root_exit_code"] != str(expected_exit_code)
        or rows["actual_root_exit_code"] != str(expected_exit_code)
        or rows["event_count"] != str(event_count)
    ):
        fail("ptrace standalone validation drifted")
    canonical_sha256(rows["producer_sha256"], "ptrace producer")
    return rows


