def require_root_owned_fixed_parent_chain(
    path: Path,
    label: str,
) -> None:
    if not path.is_absolute():
        fail(label + " path is not absolute")
    parent = path.parent
    while True:
        try:
            info = os.lstat(parent)
        except OSError as exc:
            raise ProductionGateError(
                label + " parent chain is absent"
            ) from exc
        if (
            parent.resolve(strict=True) != parent
            or stat.S_ISLNK(info.st_mode)
            or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != 0
            or info.st_mode & 0o022
        ):
            fail(label + " parent chain is not root-owned and fixed")
        if parent == Path("/"):
            return
        parent = parent.parent


def authenticate_darwin_system_immutable_file(
    path: Path,
    label: str,
) -> tuple[ArtifactIdentity, bytes, int]:
    if sys.platform != "darwin":
        fail(label + " authentication requires Darwin")
    if getattr(stat, "SF_IMMUTABLE", None) != SYSTEM_IMMUTABLE_FLAG:
        fail("Darwin system-immutable flag authority is unavailable")
    require_root_owned_fixed_parent_chain(path, label)
    try:
        if path.resolve(strict=True) != path or path.is_symlink():
            fail(label + " path is not canonical")
        before = os.lstat(path)
    except OSError as exc:
        raise ProductionGateError(label + " is absent") from exc
    identity, raw = stable_artifact(path, executable=False)
    after = os.lstat(path)
    before_flags = int(getattr(before, "st_flags", 0))
    after_flags = int(getattr(after, "st_flags", 0))
    fields = (
        "st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
        "st_uid", "st_gid", "st_mtime_ns", "st_ctime_ns",
    )
    if (
        identity.size > MAX_AUTHORITY_BYTES
        or identity.nlink != 1
        or stat.S_IMODE(identity.mode) != 0o400
        or identity.uid != 0
        or identity.gid != 0
        or before_flags != after_flags
        or before_flags & SYSTEM_IMMUTABLE_FLAG == 0
        or any(
            getattr(before, field) != getattr(after, field)
            for field in fields
        )
    ):
        fail(label + " lacks Darwin kernel immutability")
    return identity, raw, before_flags


def linux_inode_flags(fd: int) -> int:
    raw = bytearray(8)
    fcntl.ioctl(fd, LINUX_FS_IOC_GETFLAGS, raw, True)
    return int.from_bytes(raw, "little", signed=False)


def linux_fsverity_sha256(fd: int) -> str:
    raw = bytearray(4 + 64)
    struct.pack_into("=HH", raw, 0, 0, 64)
    fcntl.ioctl(fd, LINUX_FS_IOC_MEASURE_VERITY, raw, True)
    algorithm, digest_size = struct.unpack_from("=HH", raw, 0)
    if (
        algorithm != LINUX_FS_VERITY_HASH_ALG_SHA256
        or digest_size != 32
    ):
        fail("Linux fs-verity digest algorithm is not SHA-256")
    return bytes(raw[4:4 + digest_size]).hex()


def authenticate_linux_kernel_immutable_file(
    path: Path,
    label: str,
    *,
    executable: bool,
    exact_mode: int,
    max_bytes: int,
    capture: bool,
) -> tuple[ArtifactIdentity, bytes | None, str, int]:
    if (
        sys.platform != "linux"
        or os.uname().machine != "x86_64"
        or sys.byteorder != "little"
    ):
        fail(label + " authentication requires native little-endian x86_64 Linux")
    require_root_owned_fixed_parent_chain(path, label)
    try:
        if path.resolve(strict=True) != path or path.is_symlink():
            fail(label + " path is not canonical")
        before_path = os.lstat(path)
    except OSError as exc:
        raise ProductionGateError(label + " is absent") from exc
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    fields = (
        "st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
        "st_uid", "st_gid", "st_mtime_ns", "st_ctime_ns",
    )
    close_error: OSError | None = None
    try:
        before = os.fstat(descriptor)
        if (
            before.st_size <= 0
            or before.st_size > max_bytes
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != exact_mode
            or before.st_uid != 0
            or before.st_gid != 0
            or before.st_mode & 0o222
        ):
            fail(label + " physical identity is not fixed")
        flags_before = linux_inode_flags(descriptor)
        verity_before = linux_fsverity_sha256(descriptor)
        digest = hashlib.sha256()
        chunks: list[bytes] | None = [] if capture else None
        executable_prefix = bytearray()
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                fail(label + " short read")
            digest.update(chunk)
            if chunks is not None:
                chunks.append(chunk)
            if executable and len(executable_prefix) < 64:
                needed = 64 - len(executable_prefix)
                executable_prefix.extend(chunk[:needed])
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            fail(label + " grew during read")
        flags_after = linux_inode_flags(descriptor)
        verity_after = linux_fsverity_sha256(descriptor)
        after = os.fstat(descriptor)
    finally:
        try:
            os.close(descriptor)
        except OSError as exc:
            close_error = exc
    if close_error is not None:
        raise ProductionGateError(label + " close failed") from close_error
    after_path = os.lstat(path)
    raw = None if chunks is None else b"".join(chunks)
    artifact_format = detect_executable_format(bytes(executable_prefix))
    if not executable:
        artifact_format = FORMAT_REGULAR
    if (
        (executable and artifact_format != FORMAT_ELF64_X86_64)
        or flags_before != flags_after
        or flags_before & LINUX_FS_IMMUTABLE_FL == 0
        or verity_before != verity_after
        or any(
            getattr(before, field) != getattr(value, field)
            for value in (before_path, after, after_path)
            for field in fields
        )
    ):
        fail(label + " lacks Linux fs-verity and immutable authority")
    identity = ArtifactIdentity(
        path_fshex=os.fsencode(str(path)).hex(),
        sha256=digest.hexdigest(),
        device=before.st_dev,
        inode=before.st_ino,
        mode=before.st_mode,
        nlink=before.st_nlink,
        size=before.st_size,
        uid=before.st_uid,
        gid=before.st_gid,
        artifact_format=artifact_format,
    )
    return identity, raw, verity_before, flags_before


def authenticate_linux_portable_anchor(
    *,
    production_sha: str,
    verifier_inputs_cid: str,
    linux_evidence_closure_cid: str,
    linux_receipt_sha256: str,
    darwin_evidence_closure_cid: str,
    darwin_receipt_sha256: str,
    composite_terminal_sha256: str,
    installed_stage3_sha256: str,
    linux_payload: Mapping[str, Any],
    darwin_payload: Mapping[str, Any],
) -> AuthenticatedLinuxPortableAnchor:
    if sys.platform != "darwin":
        fail("Linux portable anchor authentication requires Darwin authority")
    if getattr(stat, "SF_IMMUTABLE", None) != SYSTEM_IMMUTABLE_FLAG:
        fail("Darwin system-immutable flag authority is unavailable")
    path = LINUX_PORTABLE_ANCHOR_PATH
    try:
        if path.resolve(strict=True) != path or path.is_symlink():
            fail("Linux portable anchor path is not canonical")
        before = os.lstat(path)
    except OSError as exc:
        raise ProductionGateError(
            "authenticated Linux portable anchor is absent"
        ) from exc
    parent = path.parent
    while True:
        info = os.lstat(parent)
        if (
            parent.resolve(strict=True) != parent
            or stat.S_ISLNK(info.st_mode)
            or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != 0
            or info.st_mode & 0o022
        ):
            fail("Linux portable anchor parent chain is not trusted")
        if parent == Path("/"):
            break
        parent = parent.parent
    identity, raw = stable_artifact(path, executable=False)
    after = os.lstat(path)
    before_flags = int(getattr(before, "st_flags", 0))
    after_flags = int(getattr(after, "st_flags", 0))
    if (
        identity.size > MAX_AUTHORITY_BYTES
        or identity.mode & 0o222
        or before_flags != after_flags
        or before_flags & SYSTEM_IMMUTABLE_FLAG == 0
        or any(
            getattr(before, field) != getattr(after, field)
            for field in (
                "st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
                "st_uid", "st_gid", "st_mtime_ns", "st_ctime_ns",
            )
        )
    ):
        fail("Linux portable anchor changed during authentication")
    rows = parse_linux_portable_anchor_bytes(raw)
    anchor = AuthenticatedLinuxPortableAnchor(
        identity=identity,
        flags=before_flags,
        fields=types.MappingProxyType(dict(rows)),
    )
    validate_authenticated_linux_portable_anchor_fields(
        anchor,
        production_sha=production_sha,
        verifier_inputs_cid=verifier_inputs_cid,
        linux_evidence_closure_cid=linux_evidence_closure_cid,
        linux_receipt_sha256=linux_receipt_sha256,
        darwin_evidence_closure_cid=darwin_evidence_closure_cid,
        darwin_receipt_sha256=darwin_receipt_sha256,
        composite_terminal_sha256=composite_terminal_sha256,
        installed_stage3_sha256=installed_stage3_sha256,
        linux_payload=linux_payload,
        darwin_payload=darwin_payload,
    )
    return anchor


def build_authority_bytes(
    composite: CompositeTerminal,
    composite_receipt_raw: bytes,
    linux_receipt_raw: bytes,
    darwin_receipt_raw: bytes,
    installed: ArtifactIdentity,
    linux_evidence_closure_cid: str,
    darwin_evidence_closure_cid: str,
    verifier_inputs_cid: str,
    portable_anchor: AuthenticatedLinuxPortableAnchor,
    production_gate_sha256: str,
) -> bytes:
    if not isinstance(composite, CompositeTerminal):
        fail("only a validated composite terminal may publish")
    validated_composite = validate_composite_bundle(
        composite,
        composite_receipt_raw,
        linux_receipt_raw,
        darwin_receipt_raw,
    )
    if (
        composite != validated_composite
        or installed.path_fshex
            != os.fsencode(str(INSTALLED_STAGE3_PATH)).hex()
        or installed.sha256 != composite.darwin_stage3.sha256
        or installed.size != composite.darwin_stage3.size
        or installed.artifact_format != FORMAT_MACHO_ARM64
        or not isinstance(
            portable_anchor, AuthenticatedLinuxPortableAnchor
        )
    ):
        fail("installed stage3 is not the composite Darwin artifact")
    linux_closure = canonical_sha256(
        linux_evidence_closure_cid, "Linux evidence closure"
    )
    darwin_closure = canonical_sha256(
        darwin_evidence_closure_cid, "Darwin evidence closure"
    )
    production_sha = canonical_sha256(
        production_gate_sha256, "production gate"
    )
    verifier_cid = canonical_sha256(
        verifier_inputs_cid, "verifier input set"
    )
    validate_authenticated_linux_portable_anchor_fields(
        portable_anchor,
        production_sha=production_sha,
        verifier_inputs_cid=verifier_cid,
        linux_evidence_closure_cid=linux_closure,
        linux_receipt_sha256=sha256_bytes(linux_receipt_raw),
        darwin_evidence_closure_cid=darwin_closure,
        darwin_receipt_sha256=sha256_bytes(darwin_receipt_raw),
        composite_terminal_sha256=sha256_bytes(composite_receipt_raw),
        installed_stage3_sha256=installed.sha256,
        linux_payload=composite._linux_lane_authority.payload(),
        darwin_payload=composite._darwin_lane_authority.payload(),
    )
    values = (
        ("schema", AUTHORITY_SCHEMA),
        ("status", "PASS"),
        ("production_execution_status", "PROVED_CROSS_PLATFORM_COMPOSITE"),
        ("composite_terminal_sha256", composite.sha256()),
        ("linux_lane_receipt_sha256", composite.linux_receipt_sha256),
        ("darwin_lane_receipt_sha256", composite.darwin_receipt_sha256),
        ("composite_terminal_path_fshex",
         os.fsencode(str(COMPOSITE_TERMINAL_PATH)).hex()),
        ("linux_lane_receipt_path_fshex",
         os.fsencode(str(LINUX_LANE_RECEIPT_PATH)).hex()),
        ("darwin_lane_receipt_path_fshex",
         os.fsencode(str(DARWIN_LANE_RECEIPT_PATH)).hex()),
        ("linux_evidence_root_path_fshex",
         os.fsencode(str(LINUX_EVIDENCE_ROOT)).hex()),
        ("linux_evidence_closure_cid", linux_closure),
        ("darwin_evidence_root_path_fshex",
         os.fsencode(str(DARWIN_EVIDENCE_ROOT)).hex()),
        ("darwin_evidence_closure_cid", darwin_closure),
        ("linux_portable_anchor_path_fshex",
         portable_anchor.identity.path_fshex),
        ("linux_portable_anchor_sha256",
         portable_anchor.identity.sha256),
        ("linux_target_triple", composite.linux_target_triple),
        ("linux_machine_authority", composite.linux_machine_authority),
        ("darwin_target_triple", composite.darwin_target_triple),
        ("darwin_machine_authority", composite.darwin_machine_authority),
        ("source_snapshot_cid", composite.source_snapshot_cid),
        ("cheng_cold_sha256", composite.cheng_cold_sha256),
        ("bootstrap_contract_sha256", composite.bootstrap_contract_sha256),
        ("self_check_contract_hash", composite.self_check_contract_hash),
        ("generated_c_portable_cid", composite.generated_c_portable_cid),
        ("linux_generated_c_raw_sha256",
         composite.linux_generated_c_raw_sha256),
        ("darwin_generated_c_raw_sha256",
         composite.darwin_generated_c_raw_sha256),
        ("linux_stage_fixed_point_sha256",
         composite.linux_stage_fixed_point_sha256),
        ("darwin_stage_fixed_point_sha256",
         composite.darwin_stage_fixed_point_sha256),
        ("installed_stage3_path_fshex", installed.path_fshex),
        ("installed_stage3_sha256", installed.sha256),
        ("installed_stage3_device", str(installed.device)),
        ("installed_stage3_inode", str(installed.inode)),
        ("installed_stage3_mode", str(installed.mode)),
        ("installed_stage3_nlink", str(installed.nlink)),
        ("installed_stage3_size", str(installed.size)),
        ("installed_stage3_uid", str(installed.uid)),
