def parse_c_string_literal(token: str, label: str) -> bytes:
    if len(token) < 2 or token[0] != '"' or token[-1] != '"':
        fail(f"{label} is not one exact C string literal")
    out = bytearray()
    index = 1
    while index < len(token) - 1:
        char = token[index]
        if char != "\\":
            code = ord(char)
            if code < 32 or code >= 127 or char == '"':
                fail(f"{label} contains noncanonical literal text")
            out.append(code)
            index += 1
            continue
        index += 1
        if index >= len(token) - 1:
            fail(f"{label} has a truncated escape")
        escaped = token[index]
        if escaped in {'\\', '"'}:
            out.append(ord(escaped))
            index += 1
        elif escaped in {"n", "r", "t"}:
            out.append({"n": 10, "r": 13, "t": 9}[escaped])
            index += 1
        elif escaped == "x":
            digits = token[index + 1:index + 3]
            if len(digits) != 2 or not re.fullmatch(r"[0-9a-f]{2}", digits):
                fail(f"{label} has a noncanonical hex escape")
            out.append(int(digits, 16))
            index += 3
        else:
            fail(f"{label} has an unsupported escape")
    if b"\0" in out:
        fail(f"{label} contains NUL")
    return bytes(out)


def encode_c_string_literal(raw: bytes) -> str:
    parts = ['"']
    for value in raw:
        char = chr(value)
        if char in {'\\', '"'}:
            parts.append("\\" + char)
        elif value == 10:
            parts.append("\\n")
        elif value == 13:
            parts.append("\\r")
        elif value == 9:
            parts.append("\\t")
        elif value < 32 or value >= 127:
            parts.append("\\x%02x" % value)
        else:
            parts.append(char)
    parts.append('"')
    return "".join(parts)


