    linux_payload: Mapping[str, Any]
    darwin_payload: Mapping[str, Any]
    linux_receipt_raw: bytes
    darwin_receipt_raw: bytes


def verify_existing_authority_raw_bindings(
) -> ExistingAuthorityRawBindings:
    authority_identity, authority_raw = stable_artifact(
        AUTHORITY_PATH, executable=False
    )
    composite_identity, composite_raw = stable_artifact(
        COMPOSITE_TERMINAL_PATH, executable=False
    )
    linux_identity, linux_raw = stable_artifact(
        LINUX_LANE_RECEIPT_PATH, executable=False
    )
    darwin_identity, darwin_raw = stable_artifact(
        DARWIN_LANE_RECEIPT_PATH, executable=False
    )
    for label, identity in (
        ("authority", authority_identity),
        ("composite", composite_identity),
        ("Linux lane", linux_identity),
        ("Darwin lane", darwin_identity),
    ):
        if (
            identity.nlink != 1
            or stat.S_IMODE(identity.mode) != 0o400
        ):
            fail("existing " + label + " receipt is mutable or aliased")
    rows = parse_authority_bytes(authority_raw)
    current_verifier_inputs_cid = verifier_input_set_cid()
    production_identity, production_raw = stable_artifact(
        PRODUCTION_GATE, executable=False
    )
    if production_identity.nlink != 1:
        fail("current production gate is physically aliased")
    production_sha = production_identity.sha256
    if rows["production_gate_sha256"] != production_sha:
        fail("authority does not bind current production gate bytes")
    if rows["verifier_inputs_cid"] != current_verifier_inputs_cid:
        fail("authority does not bind current verifier input bytes")
    installed, installed_raw = stable_artifact(
        INSTALLED_STAGE3_PATH, executable=True
    )
    if installed.artifact_format != FORMAT_MACHO_ARM64:
        fail("authority installed stage3 is not arm64 Mach-O")
    validate_darwin_macho_code_signature(installed_raw, "installed stage3")
    installed_fields = {
        "installed_stage3_path_fshex": installed.path_fshex,
        "installed_stage3_sha256": installed.sha256,
        "installed_stage3_device": str(installed.device),
        "installed_stage3_inode": str(installed.inode),
        "installed_stage3_mode": str(installed.mode),
        "installed_stage3_nlink": str(installed.nlink),
        "installed_stage3_size": str(installed.size),
        "installed_stage3_uid": str(installed.uid),
        "installed_stage3_gid": str(installed.gid),
        "installed_stage3_format": installed.artifact_format,
    }
    if any(rows[key] != value for key, value in installed_fields.items()):
        fail("authority installed stage3 physical identity drifted")
    linux_payload, linux_stage3 = strict_lane_receipt_structure(
        linux_raw, LANE_LINUX
    )
    darwin_payload, darwin_stage3 = strict_lane_receipt_structure(
        darwin_raw, LANE_DARWIN
    )
    composite, composite_stage3 = strict_composite_structure(
        composite_raw
    )
    shared = {
        "sourceSnapshotCid": "source_snapshot_cid",
        "chengColdSha256": "cheng_cold_sha256",
        "bootstrapContractSha256": "bootstrap_contract_sha256",
        "selfCheckContractHash": "self_check_contract_hash",
        "generatedCPortableCid": "generated_c_portable_cid",
    }
    if (
        rows["composite_terminal_sha256"] != composite_identity.sha256
        or rows["linux_lane_receipt_sha256"] != linux_identity.sha256
        or rows["darwin_lane_receipt_sha256"] != darwin_identity.sha256
        or composite["linuxReceiptSha256"] != linux_identity.sha256
        or composite["darwinReceiptSha256"] != darwin_identity.sha256
        or composite["linuxGeneratedCRawSha256"]
            != linux_payload["generatedCRawSha256"]
        or composite["darwinGeneratedCRawSha256"]
            != darwin_payload["generatedCRawSha256"]
        or composite["linuxStageFixedPointSha256"]
            != linux_payload["stageFixedPointSha256"]
        or composite["darwinStageFixedPointSha256"]
            != darwin_payload["stageFixedPointSha256"]
        or composite_stage3 != darwin_stage3
        or installed.sha256 != darwin_stage3.sha256
        or installed.size != darwin_stage3.size
        or linux_stage3.artifact_format != FORMAT_ELF64_X86_64
        or any(
            linux_payload[key] != darwin_payload[key]
            or composite[key] != linux_payload[key]
            or rows[row_key] != composite[key]
            for key, row_key in shared.items()
        )
    ):
        fail("authority composite/lane raw cross-binding drifted")
    return ExistingAuthorityRawBindings(
        rows=types.MappingProxyType(dict(rows)),
        verifier_inputs_cid=current_verifier_inputs_cid,
        authority_identity=authority_identity,
        production_gate_identity=production_identity,
        installed_stage3=installed,
        composite_identity=composite_identity,
        linux_receipt_identity=linux_identity,
        darwin_receipt_identity=darwin_identity,
        composite_payload=types.MappingProxyType(dict(composite)),
        linux_payload=types.MappingProxyType(dict(linux_payload)),
        darwin_payload=types.MappingProxyType(dict(darwin_payload)),
        linux_receipt_raw=linux_raw,
        darwin_receipt_raw=darwin_raw,
    )


VERIFIER_INPUT_DOMAIN = b"cheng.bootstrap.stage23.verifier.input.set"
VERIFIER_INPUT_ROLES = (
    "production_gate",
    "authority_publisher",
    "inner_gate",
    "phase_engine",
    "process_guard",
    "process_guard_runtime",
    "cgroup_runner",
    "cgroup_validator",
    "ptrace_producer",
    "ptrace_validator",
    "ptrace_wrapper",
)


def exact_tool_input_items() -> tuple[tuple[str, Path], ...]:
    paths = (
        PRODUCTION_GATE,
        AUTHORITY_PUBLISHER,
        INNER_GATE,
        PHASE_ENGINE,
        PROCESS_GUARD,
        PROCESS_GUARD_RUNTIME,
        CGROUP_RUNNER,
        CGROUP_VALIDATOR,
        PTRACE_PRODUCER,
        PTRACE_VALIDATOR,
        PTRACE_WRAPPER,
    )
    return tuple(zip(VERIFIER_INPUT_ROLES, paths))


def exact_tool_inputs() -> tuple[Path, ...]:
    return tuple(path for _role, path in exact_tool_input_items())


def verifier_input_set_cid() -> str:
    items = exact_tool_input_items()
    if tuple(role for role, _path in items) != VERIFIER_INPUT_ROLES:
        fail("verifier input role order drifted")
    rows: list[tuple[str, bytes]] = []
    observed_paths: set[str] = set()
    for index, (role, path) in enumerate(items):
        if (
            not path.is_absolute()
            or path.resolve(strict=True) != path
            or path.is_symlink()
        ):
            fail("verifier input path is not fixed and canonical")
        try:
            relative = path.relative_to(ROOT).as_posix()
        except ValueError as exc:
            raise ProductionGateError(
                "verifier input escaped the fixed source root"
            ) from exc
        if relative in observed_paths:
            fail("verifier input paths alias")
        observed_paths.add(relative)
        identity, _raw = stable_artifact(path, executable=False)
        if identity.nlink != 1:
            fail("verifier input is physically aliased")
        rows.append((
            f"entry{index:04d}",
            canonical_json({
                "role": role,
                "relativePath": relative,
                "sha256": identity.sha256,
                "size": identity.size,
            }),
        ))
    return framed_record_sha256(
        VERIFIER_INPUT_DOMAIN,
        tuple(rows),
        tuple(name for name, _raw in rows),
    )


def verify_bound_inputs() -> None:
    validate_static_configuration()
    verifier_input_set_cid()
    for path in exact_tool_inputs():
        if (
            not path.is_absolute()
            or path.is_symlink()
            or not path.is_file()
        ):
            fail("required production input is not a regular file")
    engine_raw, engine_identity = stable_source_module_bytes(
        PHASE_ENGINE, "phase engine"
    )
    if (
        engine_raw != PHASE_ENGINE_EXECUTED_RAW
        or engine_identity != PHASE_ENGINE_EXECUTED_IDENTITY
    ):
        fail("executed phase engine bytes differ from bound input")
    validator_raw, validator_identity = stable_source_module_bytes(
        CGROUP_VALIDATOR, "Linux cgroup validator"
    )
    if (
        validator_raw != LINUX_CGROUP_VALIDATOR_EXECUTED_RAW
        or validator_identity
            != LINUX_CGROUP_VALIDATOR_EXECUTED_IDENTITY
    ):
        fail("executed Linux cgroup validator differs from bound input")


def canonical_host_executable(name: str) -> Path:
    raw = shutil.which(name)
    if raw is None:
        fail("required host executable is missing: " + name)
    path = Path(os.path.realpath(raw))
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or not info.st_mode & 0o111:
        fail("required host executable is invalid: " + name)
    return path


def canonical_darwin_cc() -> Path:
    candidates = (
        Path(
            "/Applications/Xcode.app/Contents/Developer/Toolchains/"
            "XcodeDefault.xctoolchain/usr/bin/clang"
        ),
        Path(
            "/Library/Developer/CommandLineTools/usr/bin/clang"
        ),
    )
    for path in candidates:
        try:
            info = os.lstat(path)
            resolved = path.resolve(strict=True)
        except OSError:
            continue
        if (
            resolved == path
            and stat.S_ISREG(info.st_mode)
            and not stat.S_ISLNK(info.st_mode)
            and info.st_mode & 0o111
        ):
            identity, raw = stable_artifact(path, executable=True)
            if identity.artifact_format in {
                FORMAT_MACHO_ARM64,
                FORMAT_MACHO_UNIVERSAL_ARM64,
            }:
                return path
    fail("standalone Darwin clang is unavailable")


def write_exact_regular_file(
    path: Path,
    raw: bytes,
    *,
    replace: bool,
) -> ArtifactIdentity:
    if not path.is_absolute() or path.is_symlink():
        fail("exact regular output path is invalid")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name("." + path.name + ".next")
    if temporary.exists() or temporary.is_symlink():
        fail("exact regular output temporary path already exists")
    if not replace and (path.exists() or path.is_symlink()):
        fail("exact regular output already exists")
    descriptor = os.open(
        temporary,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        0o400,
    )
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("exact regular output write made no progress")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.chmod(temporary, 0o400)
    os.replace(temporary, path)
    directory = os.open(
        path.parent,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    identity, observed = stable_artifact(path, executable=False)
    if (
        observed != raw
        or stat.S_IMODE(identity.mode) != 0o400
        or identity.nlink != 1
    ):
        fail("exact regular output identity drifted")
    return identity


def open_anchored_directory(path: Path) -> int:
    if (
        not path.is_absolute()
        or path == Path("/")
        or ".." in path.parts
    ):
        fail("anchored directory path is invalid")
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptor = os.open("/", flags)
    try:
        parts = path.parts[1:]
        for offset, part in enumerate(parts):
            child = os.open(part, flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            info = os.fstat(descriptor)
            if (
                not stat.S_ISDIR(info.st_mode)
                or (
                    info.st_mode & 0o022
                    and not (
                        offset < len(parts) - 1
                        and info.st_mode & stat.S_ISVTX
                    )
                )
                or (
                    offset == len(parts) - 1
                    and info.st_uid != os.geteuid()
                )
            ):
                fail("anchored directory ownership mode drifted")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def create_exclusive_private_child_directory(
    parent: Path,
    name: str,
) -> Path:
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        fail("private child directory name is not canonical")
    parent_fd = open_anchored_directory(parent)
    try:
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError as exc:
            raise ProductionGateError(
                "private child directory already exists"
            ) from exc
        flags = (
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0)
        )
        child_fd = os.open(name, flags, dir_fd=parent_fd)
        try:
            info = os.fstat(child_fd)
            if (
                not stat.S_ISDIR(info.st_mode)
                or stat.S_IMODE(info.st_mode) != 0o700
                or info.st_uid != os.geteuid()
            ):
                fail("private child directory identity drifted")
            os.fsync(child_fd)
        finally:
            os.close(child_fd)
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)
    return parent / name


def exact_existing_private_directory(path: Path) -> Path:
    descriptor = open_anchored_directory(path)
    try:
        info = os.fstat(descriptor)
        if (
            stat.S_IMODE(info.st_mode) != 0o700
            or info.st_uid != os.geteuid()
        ):
            fail("existing private directory identity drifted")
    finally:
        os.close(descriptor)
    return path


def exact_existing_completed_evidence_directory(path: Path) -> Path:
    descriptor = open_anchored_directory(path)
    try:
        info = os.fstat(descriptor)
        if (
            stat.S_IMODE(info.st_mode) not in (0o500, 0o700)
            or info.st_uid != os.geteuid()
        ):
            fail("completed evidence directory identity drifted")
    finally:
        os.close(descriptor)
    return path


def publish_exclusive_regular(
    parent: Path,
    final_name: str,
    raw: bytes,
) -> ArtifactIdentity:
    if (
        not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", final_name)
        or "/" in final_name
    ):
        fail("exclusive publication name is not canonical")
    parent_fd = open_anchored_directory(parent)
    temporary_name = "." + final_name + ".private"
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                temporary_name,
                os.O_RDWR
                | os.O_CREAT
                | os.O_EXCL
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
                0o400,
                dir_fd=parent_fd,
            )
        except FileExistsError as exc:
            raise ProductionGateError(
                "exclusive publication private file already exists"
            ) from exc
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("exclusive publication write made no progress")
            view = view[written:]
        os.fchmod(descriptor, 0o400)
        os.fsync(descriptor)
        before = os.fstat(descriptor)
        os.lseek(descriptor, 0, os.SEEK_SET)
        observed = bytearray()
        while len(observed) < len(raw):
            chunk = os.read(descriptor, len(raw) - len(observed))
            if not chunk:
                break
            observed.extend(chunk)
        after = os.fstat(descriptor)
        stable_fields = (
            "st_dev", "st_ino", "st_mode", "st_nlink", "st_uid",
            "st_gid", "st_size", "st_mtime_ns", "st_ctime_ns",
        )
        if (
            bytes(observed) != raw
            or any(
                getattr(before, field) != getattr(after, field)
                for field in stable_fields
            )
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o400
        ):
            fail("exclusive publication private validation failed")
        os.fsync(parent_fd)
        try:
            os.link(
                temporary_name,
                final_name,
                src_dir_fd=parent_fd,
                dst_dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except FileExistsError as exc:
            raise ProductionGateError(
                "exclusive publication target already exists"
            ) from exc
        os.unlink(temporary_name, dir_fd=parent_fd)
        os.fsync(parent_fd)
    except BaseException:
        if descriptor >= 0:
            try:
                os.unlink(temporary_name, dir_fd=parent_fd)
            except OSError:
                pass
        raise
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_fd)
    final_path = parent / final_name
    identity, observed_raw = stable_artifact(
        final_path, executable=False
    )
    if (
        observed_raw != raw
        or identity.nlink != 1
        or stat.S_IMODE(identity.mode) != 0o400
    ):
        fail("exclusive publication final identity drifted")
    return identity


def validate_darwin_macho_code_signature(
    raw: bytes,
    label: str,
) -> None:
    if detect_executable_format(raw) != FORMAT_MACHO_ARM64:
        fail(label + " is not an exact thin arm64 Mach-O")
    if len(raw) < 32:
        fail(label + " Mach-O header is truncated")
    (
        _magic,
        cpu_type,
        _cpu_subtype,
        _file_type,
        command_count,
        command_bytes,
        _flags,
        _reserved,
    ) = struct.unpack_from("<IiiIIIII", raw, 0)
    if (
        cpu_type != MACHO_CPU_TYPE_ARM64
        or command_count == 0
        or command_bytes == 0
        or 32 + command_bytes > len(raw)
    ):
        fail(label + " Mach-O load-command authority drifted")
    cursor = 32
    command_end = 32 + command_bytes
    signatures: list[tuple[int, int]] = []
    for _index in range(command_count):
        if cursor + 8 > command_end:
            fail(label + " Mach-O load command is truncated")
        command, command_size = struct.unpack_from("<II", raw, cursor)
        if (
            command_size < 8
            or command_size % 4
            or cursor + command_size > command_end
        ):
            fail(label + " Mach-O load command size drifted")
        if command == 0x1D:
            if command_size != 16:
                fail(label + " code-signature command size drifted")
            data_offset, data_size = struct.unpack_from(
                "<II", raw, cursor + 8
            )
            signatures.append((data_offset, data_size))
        cursor += command_size
    if cursor != command_end or len(signatures) != 1:
        fail(label + " lacks one exact LC_CODE_SIGNATURE")
    data_offset, data_size = signatures[0]
    if (
        data_size < 20
        or data_offset < command_end
        or data_offset + data_size > len(raw)
    ):
        fail(label + " code-signature range drifted")
    signature = raw[data_offset:data_offset + data_size]
    magic, blob_length, blob_count = struct.unpack_from(
        ">III", signature, 0
    )
    if (
        magic != 0xFADE0CC0
        or blob_length > data_size
        or blob_count == 0
        or 12 + blob_count * 8 > blob_length
    ):
        fail(label + " embedded signature superblob drifted")
    slots: set[int] = set()
    has_code_directory = False
    for index in range(blob_count):
        slot_type, offset = struct.unpack_from(
            ">II", signature, 12 + index * 8
        )
        if slot_type in slots or offset + 8 > blob_length:
            fail(label + " embedded signature slot drifted")
        slots.add(slot_type)
        slot_magic, slot_length = struct.unpack_from(
            ">II", signature, offset
        )
        if slot_length < 8 or offset + slot_length > blob_length:
            fail(label + " embedded signature blob range drifted")
        if slot_type == 0 and slot_magic == 0xFADE0C02:
            has_code_directory = True
    if not has_code_directory:
        fail(label + " lacks a canonical CodeDirectory")


def darwin_phase_allowlist(state: PhaseState) -> PhaseExecutableAllowlist:
    if state.boundary.lane != LANE_DARWIN:
        fail("Darwin executable allowlist requested for another lane")
    command_role = PHASE_SPECS[state.next_phase_index].command_role
    if state.next_phase_index == 10:
        return PhaseExecutableAllowlist(("bash", "python"))
    plan = phase_plan_for_state(state)
    if "commandActions" in plan:
        action_roles = {
            role
            for action in plan["commandActions"]
            for role in (
                action["launcherExecutableRole"],
                action["targetExecutableRole"],
            )
        }
        return PhaseExecutableAllowlist(tuple(sorted({
            "bash",
            "python",
            *action_roles,
            *(
                action["targetExecutableRole"]
                for action in plan.get(
                    "darwinCodesignActions", ()
                )
            ),
        })))
    return PhaseExecutableAllowlist(tuple(sorted({
        "bash",
        "python",
        command_role,
        *(
            action["targetExecutableRole"]
            for action in plan.get("darwinCodesignActions", ())
        ),
        *(
            role for role in state.frozen
            if is_transitive_executable_role(role)
        ),
    })))


def linux_phase_allowlist(state: PhaseState) -> PhaseExecutableAllowlist:
    if state.boundary.lane != LANE_LINUX:
        fail("Linux executable allowlist requested for another lane")
    command_role = PHASE_SPECS[state.next_phase_index].command_role
    roles = {"bash", "python"}
    if state.next_phase_index != 10:
        roles.add(command_role)
    return PhaseExecutableAllowlist(tuple(sorted(roles)))


def parse_make_dependency_output(raw: bytes) -> tuple[Path, ...]:
    if not raw or b"\0" in raw or b"\r" in raw:
        fail("Darwin compiler dependency output is not canonical")
    try:
        text = raw.replace(b"\\\n", b" ").decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "Darwin compiler dependency output is not UTF-8"
        ) from exc
    _target, separator, body = text.partition(":")
    if not separator:
        fail("Darwin compiler dependency output lacks target")
    tokens: list[str] = []
    token: list[str] = []
    escaped = False
    for char in body:
        if escaped:
            token.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char.isspace():
            if token:
                tokens.append("".join(token))
                token = []
        else:
            token.append(char)
    if escaped:
        fail("Darwin compiler dependency output has a trailing escape")
    if token:
        tokens.append("".join(token))
    paths = tuple(Path(item) for item in tokens)
    if (
        not paths
        or any(not path.is_absolute() for path in paths)
        or len(paths) != len(set(paths))
    ):
        fail("Darwin compiler dependency path set is not exact")
    return paths


def canonical_darwin_dependency_rows(
    raw: bytes,
    source_root: Path,
    toolchain_root: Path,
) -> tuple[tuple[str, str, int, str], ...]:
    if (
        not source_root.is_absolute()
        or not toolchain_root.is_absolute()
        or source_root == toolchain_root
        or source_root in toolchain_root.parents
        or toolchain_root in source_root.parents
    ):
        fail("Darwin dependency canonical roots are not disjoint")
    rows: list[tuple[str, str, int, str]] = []
    seen: set[tuple[str, str]] = set()
    for path in parse_make_dependency_output(raw):
        try:
            relative = path.relative_to(source_root)
            domain = "source"
        except ValueError:
            try:
                relative = path.relative_to(toolchain_root)
                domain = "toolchain"
            except ValueError as exc:
                raise ProductionGateError(
                    "Darwin dependency escaped canonical roots"
                ) from exc
        if (
            not relative.parts
            or relative.is_absolute()
            or any(part in {"", ".", ".."} for part in relative.parts)
        ):
            fail("Darwin dependency relative identity is invalid")
        relative_fshex = os.fsencode(str(relative)).hex()
        key = (domain, relative_fshex)
        if key in seen:
            fail("Darwin dependency canonical identity aliases")
        seen.add(key)
        identity, _contents = stable_artifact(
            path, executable=False
        )
        rows.append((
            domain,
            relative_fshex,
            identity.size,
            identity.sha256,
        ))
    return tuple(rows)


def canonical_darwin_dependency_closure(
    state: PhaseState,
    raw: bytes,
    phase_index: int,
) -> tuple[tuple[str, str, int, str], ...]:
    if phase_index == 0:
        action_root = state.paths.command_action_input_root(0, 0)
        source_root = action_root / "source"
        toolchain_root = action_root / "toolchain"
    elif phase_index == 15:
        source_root = ROOT
        toolchain_root = (
            state.paths.evidence
            / phase_engine.DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
        )
    else:
        fail("Darwin dependency canonical phase is invalid")
    return canonical_darwin_dependency_rows(
        raw, source_root, toolchain_root
    )


DARWIN_XCODE_RESOURCE_ROOT = Path(
    "/Applications/Xcode.app/Contents/Developer/Toolchains/"
    "XcodeDefault.xctoolchain/usr/lib/clang/21"
