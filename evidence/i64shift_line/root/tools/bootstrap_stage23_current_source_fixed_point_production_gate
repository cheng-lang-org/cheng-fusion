def run_linux_phase(
    state: PhaseState,
    authority: LinuxAuthorityInputs,
    rootfs_binding: Any,
) -> PhaseState:
    if state.boundary.lane != LANE_LINUX:
        fail("Linux coordinator received another lane")
    verify_closed_tree_files_on_disk(state)
    observed_rootfs = recapture_linux_authority(authority)
    if observed_rootfs != rootfs_binding:
        fail("Linux rootfs binding changed before phase")
    bundle = prepare_linux_phase_manifest_bundle(
        state, authority, rootfs_binding
    )
    phase_index = state.next_phase_index
    phase_root_parent = exact_existing_private_directory(
        state.paths.evidence.parent / "phase-authority"
    )
    phase_root = phase_root_parent / f"phase-{phase_index:02d}"
    if phase_root.exists() or phase_root.is_symlink():
        fail("Linux phase cgroup evidence root already exists")
    runner_argv = linux_cgroup_runner_argv(
        bundle, authority, phase_root
    )
    spec = PHASE_SPECS[phase_index]
    completed = subprocess.run(
        list(runner_argv),
        cwd=str(ROOT),
        env=dict(CLOSED_SUBPROCESS_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=spec.timeout_seconds * 2 + 600,
    )
    if completed.returncode != 0 or completed.stderr:
        detail = (
            completed.stderr or completed.stdout
        ).decode("utf-8", "replace").replace("\n", "_")[:512]
        fail(
            "Linux cgroup phase execution failed:"
            + str(phase_index)
            + ":"
            + str(completed.returncode)
            + ":"
            + detail
        )
    validate_linux_cgroup_runner_stdout(completed.stdout, phase_root)
    validator_argv = linux_cgroup_validator_argv(bundle, phase_root)
    validated = subprocess.run(
        list(validator_argv),
        cwd=str(ROOT),
        env=dict(CLOSED_SUBPROCESS_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=spec.timeout_seconds + 300,
    )
    if validated.returncode != 0 or validated.stderr:
        detail = (
            validated.stderr or validated.stdout
        ).decode("utf-8", "replace").replace("\n", "_")[:512]
        fail("independent Linux cgroup validation failed:" + detail)
    validate_linux_cgroup_validator_stdout(validated.stdout)
    seal_linux_evidence_closure(phase_root)
    validated_after_seal = subprocess.run(
        list(validator_argv),
        cwd=str(ROOT),
        env=dict(CLOSED_SUBPROCESS_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=spec.timeout_seconds + 300,
    )
    if (
        validated_after_seal.returncode != 0
        or validated_after_seal.stderr
    ):
        detail = (
            validated_after_seal.stderr
            or validated_after_seal.stdout
        ).decode("utf-8", "replace").replace("\n", "_")[:512]
        fail("sealed Linux cgroup evidence failed validation:" + detail)
    validate_linux_cgroup_validator_stdout(
        validated_after_seal.stdout
    )
    if recapture_linux_authority(authority) != rootfs_binding:
        fail("Linux authority changed after cgroup phase")
    evidence = physical_linux_phase_raw_evidence(
        bundle.phase_state, bundle, phase_root, authority
    )
    terminal = phase_terminal_from_raw_evidence(
        bundle.phase_state,
        bundle.allowlist,
        evidence,
        bundle.envelope,
        bundle.envelope_sha256,
    )
    advanced = advance_phase(
        bundle.phase_state,
        bundle.allowlist,
        evidence,
        bundle.envelope,
        bundle.envelope_sha256,
    )
    if advanced.terminals[-1] != terminal:
        fail("Linux trusted phase advance drifted")
    advanced = linux_phase_state_without_pair_commitment(advanced)
    seal_linux_phase_inputs(bundle)
    advanced = persist_outer_phase_terminal(advanced)
    verify_closed_tree_files_on_disk(advanced)
    return advanced


def linux_physical_phase_chain_manifest_bytes(
    state: PhaseState,
) -> bytes:
    if (
        state.boundary.lane != LANE_LINUX
        or state.next_phase_index != len(PHASE_SPECS)
    ):
        fail("Linux physical phase chain is incomplete")
    lane_root = state.paths.evidence.parent
    phases = []
    for index, terminal in enumerate(state.terminals):
        terminal_relative = (
            f"phase-receipts/{index:02d}/outer-terminal.json"
        )
        terminal_row = state.closed_tree_files.get(terminal_relative)
        if (
            terminal_row is None
            or terminal_row["role"] != "outer_phase_terminal"
            or terminal.phase_index != index
        ):
            fail("Linux physical outer terminal row drifted")
        observed_terminal, terminal_raw = stable_closed_file(
            state.paths.evidence / terminal_relative,
            "outer_phase_terminal",
            terminal_relative,
        )
        if (
            observed_terminal != terminal_row
            or parse_outer_phase_terminal_bytes(terminal_raw)
                != terminal
        ):
            fail("Linux physical outer terminal bytes drifted")
        cgroup_relative = f"phase-authority/phase-{index:02d}"
        inputs_relative = f"phase-inputs/phase-{index:02d}"
        cgroup_root = lane_root / cgroup_relative
        inputs_root = lane_root / inputs_relative
        cgroup_rows = linux_evidence_closure_rows(
            cgroup_root, require_sealed=True
        )
        cgroup_cid = linux_evidence_closure_cid(cgroup_rows)
        inputs_rows = linux_evidence_closure_rows(
            inputs_root, require_sealed=True
        )
        inputs_cid = linux_evidence_closure_cid(inputs_rows)
        phases.append({
            "phaseIndex": index,
            "outerTerminalRelativePath": terminal_relative,
            "outerTerminalIdentity": terminal_row,
            "terminalPayloadSha256": state.terminal_sha256s[index],
            "cgroupEvidenceRelativePath": cgroup_relative,
            "cgroupEvidenceClosureSha256": cgroup_cid,
            "phaseInputsRelativePath": inputs_relative,
            "phaseInputsClosureSha256": inputs_cid,
        })
    payload = {
        "schema": LINUX_PHYSICAL_PHASE_CHAIN_SCHEMA,
        "lane": LANE_LINUX,
        "phaseCount": len(PHASE_SPECS),
        "phases": phases,
        "phaseChainSha256": completed_phase_chain_sha256(state),
        "preChainClosedTreeSha256": sha256_bytes(closed_tree_bytes(
            state.closed_tree_directories, state.closed_tree_files
        )),
        "sourceSnapshotCid": portable_source_snapshot_cid(state),
        "stage3": state.frozen["stage3"].payload(),
    }
    return canonical_json({
        "payload": payload,
        "payloadSha256": sha256_bytes(canonical_json(payload)),
    }) + b"\n"


def persist_linux_physical_phase_chain(state: PhaseState) -> PhaseState:
    raw = linux_physical_phase_chain_manifest_bytes(state)
    parent = create_exclusive_private_child_directory(
        state.paths.evidence,
        LINUX_PHYSICAL_PHASE_CHAIN_RELATIVE_PATH.parent.name,
    )
    identity = publish_exclusive_regular(
        parent,
        LINUX_PHYSICAL_PHASE_CHAIN_RELATIVE_PATH.name,
        raw,
    )
    if identity.sha256 != sha256_bytes(raw):
        fail("Linux physical phase chain publication drifted")
    return phase_state_with_closed_file(
        state,
        state.paths.evidence / LINUX_PHYSICAL_PHASE_CHAIN_RELATIVE_PATH,
        "physical_phase_chain_manifest",
    )


def run_linux_lane(
    lane_root: Path,
    authority: LinuxAuthorityInputs,
) -> tuple[PhaseState, LaneReceipt]:
    rootfs_binding = recapture_linux_authority(authority)
    state = linux_initial_phase_state(lane_root, authority)
    static_identities = dict(state.frozen)
    for expected_index in range(len(PHASE_SPECS)):
        if state.next_phase_index != expected_index:
            fail("Linux ordered phase index drifted")
        state = run_linux_phase(state, authority, rootfs_binding)
    if recapture_linux_authority(
        authority,
        verify_tree=True,
    ) != rootfs_binding:
        fail("Linux fs-verity rootfs changed across completed lane")
    state = persist_linux_physical_phase_chain(state)
    completed_phase_chain_sha256(state)
    verify_closed_tree_files_on_disk(state)
    if recapture_linux_authority(authority) != rootfs_binding:
        fail("Linux authority changed across completed lane")
    source_pairs = [
        ("bootstrap_source", "snapshot_bootstrap"),
        ("bootstrap_contract", "snapshot_contract"),
        ("bootstrap_manifest", "snapshot_bootstrap_manifest"),
        ("package_manifest", "snapshot_package_manifest"),
        ("t7_source", "snapshot_t7"),
    ]
    local_roles = sorted(
        role for role in static_identities
        if role.startswith("local_c_header_")
    )
    source_pairs.extend(
        (role, f"snapshot_closure_{index:04d}")
        for index, role in enumerate(local_roles)
    )
    for source_role, snapshot_role in source_pairs:
        source = state.frozen[source_role]
        snapshot = state.frozen[snapshot_role]
        if source.sha256 != snapshot.sha256 or source.size != snapshot.size:
            fail("Linux source snapshot mixed input versions")
    for role, identity in static_identities.items():
        observed = stable_artifact(
            identity_host_path(identity),
            executable=role in STATIC_EXECUTABLE_ROLES,
        )[0]
        if observed != identity:
            fail("Linux frozen static input changed: " + role)
    for role in (
        "cold_candidate",
        "stage0",
        "stage1",
        "stage2",
        "stage3",
        "t7_stage2",
        "t7_stage3",
    ):
        identity, _raw = stable_artifact(
            identity_host_path(state.frozen[role]), executable=True
        )
        if identity.artifact_format != FORMAT_ELF64_X86_64:
            fail("Linux completed executable target drifted: " + role)
    generated_identity = state.frozen["stage3_generated_c"]
    _generated, generated_raw = stable_artifact(
        identity_host_path(generated_identity), executable=False
    )
    contract_identity = state.frozen["snapshot_contract"]
    _contract, contract_raw = stable_artifact(
        identity_host_path(contract_identity), executable=False
    )
    generated_proof = generated_c_portable_proof(
        generated_raw,
        snapshot_root=state.paths.snapshot,
        impl_identity=state.frozen["snapshot_bootstrap"],
        contract_identity=contract_identity,
        normalized_contract=canonical_bootstrap_contract_bytes(
            contract_raw
        ),
    )
    receipt = lane_receipt_from_completed_state(state, generated_proof)
    parse_lane_receipt_bytes(receipt.receipt_bytes(), receipt)
    return state, receipt


def run_darwin_phase(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
) -> PhaseState:
    if state.boundary.lane != LANE_DARWIN:
        fail("Darwin coordinator received another lane")
    state = materialize_darwin_phase1_action_inputs(state)
    allowlist = darwin_phase_allowlist(state)
    validate_darwin_external_inputs(state)
    verify_closed_tree_files_on_disk(state)
    envelope = next_phase_envelope(state, allowlist)
    envelope_sha256 = sha256_bytes(canonical_json(envelope))
    manifest_raw = stage_input_manifest_raw_from_envelope(
        state, envelope
    )
    receipt_dir = prepare_darwin_phase_receipt_directory(state)
    manifest_path = receipt_dir / "stage-input-manifest.json"
    manifest_identity = publish_exclusive_regular(
        receipt_dir,
        manifest_path.name,
        manifest_raw,
    )
    expected_runner = (
        lane_role_path(state, "python"),
        "-I",
        "-S",
        "-B",
        str(PHASE_ENGINE),
        "--run-phase-action",
        "--stage-input-manifest",
        str(manifest_path),
        "--stage-plan-sha256",
        envelope["phasePlanSha256"],
        "--evidence-dir",
        str(state.paths.evidence),
    )
    if tuple(envelope["runnerArgv"]) != expected_runner:
        fail("Darwin runner argv is not the frozen explicit chain")
    spec = PHASE_SPECS[state.next_phase_index]
    completed = subprocess.run(
        list(expected_runner),
        cwd=str(ROOT),
        env=dict(CLOSED_SUBPROCESS_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=spec.timeout_seconds + 60,
    )
    terminal_path = receipt_dir / "terminal.json"
    if (
        completed.returncode != 0
        or completed.stderr
        or not terminal_path.is_file()
        or completed.stdout != terminal_path.read_bytes()
    ):
        detail = (
            completed.stderr or completed.stdout
        ).decode("utf-8", "replace").replace("\n", "_")[:512]
        fail(
            "Darwin ordered phase execution failed:"
            + str(state.next_phase_index)
            + ":"
            + str(completed.returncode)
            + ":"
            + detail
        )
    validate_darwin_external_inputs(state)
    if state.next_phase_index in (0, 15):
        validate_guarded_darwin_dependency_closure(
            state,
            (
                receipt_dir / (
                    "action-00.guard.stdout"
                    if state.next_phase_index == 0
                    else "guard.stdout"
                )
            ).read_bytes(),
        )
    produced, post_directories, post_files = observed_darwin_phase_tree(
        state, envelope
    )
    action_evidence = tuple(
        CommandActionRawEvidence(
            action["commandActionIndex"],
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.kv"
            ).read_bytes(),
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.stdout"
            ).read_bytes(),
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.stderr"
            ).read_bytes(),
        )
        for action in envelope.get("phaseCommandActions", ())
    )
    evidence = PhaseRawEvidence(
        guard_receipt_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.kv").read_bytes()
        ),
        guard_stdout_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.stdout").read_bytes()
        ),
        guard_stderr_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.stderr").read_bytes()
        ),
        ledger_receipt_raw=b"",
        ledger_validation_raw=b"",
        cgroup_receipt_raw=b"",
        phase_row_receipt_raw=terminal_path.read_bytes(),
        action_stdout_raw=(receipt_dir / "action.stdout").read_bytes(),
        action_stderr_raw=(receipt_dir / "action.stderr").read_bytes(),
        pre_closed_tree_raw=closed_tree_bytes(
            state.closed_tree_directories,
            state.closed_tree_files,
        ),
        post_closed_tree_raw=closed_tree_bytes(
            post_directories,
            post_files,
        ),
        stage_input_manifest_raw=manifest_raw,
        stage_input_manifest_identity=manifest_identity,
        rootfs_manifest_raw=b"",
        delegation_receipt_raw=b"",
        crun_identity=None,
        command_action_evidence=action_evidence,
        produced=produced,
    )
    terminal = phase_terminal_from_raw_evidence(
        state,
        allowlist,
        evidence,
        envelope,
        envelope_sha256,
    )
    advanced = advance_phase(
        state,
        allowlist,
        evidence,
        envelope,
        envelope_sha256,
    )
    if (
        advanced.terminals[-1] != terminal
        or advanced.closed_tree_directories != post_directories
        or dict(advanced.closed_tree_files) != post_files
    ):
        fail("Darwin trusted phase advance drifted")
    return persist_outer_phase_terminal(advanced)


def run_darwin_lane(evidence: Path) -> tuple[PhaseState, LaneReceipt]:
    state = darwin_initial_phase_state(evidence)
    static_identities = dict(state.frozen)
    for _index in range(len(PHASE_SPECS)):
        state = run_darwin_phase(
            state,
            darwin_phase_allowlist(state),
        )
    state = persist_physical_phase_chain(state)
    completed_phase_chain_sha256(state)
    validate_darwin_external_inputs(state)
    verify_closed_tree_files_on_disk(state)
    pre_identity = state.frozen["cc_deps_pre_stdout"]
    post_identity = state.frozen["cc_deps_post_stdout"]
    observed_pre, pre_raw = stable_artifact(
        identity_host_path(pre_identity), executable=False
    )
    observed_post, post_raw = stable_artifact(
        identity_host_path(post_identity), executable=False
    )
    if (
        observed_pre != pre_identity
        or observed_post != post_identity
        or canonical_darwin_dependency_closure(
            state, pre_raw, 0
        ) != canonical_darwin_dependency_closure(
            state, post_raw, 15
        )
    ):
        fail("Darwin source dependency closure changed across the lane")
    for source_role, snapshot_role in (
        ("bootstrap_source", "snapshot_bootstrap"),
        ("bootstrap_contract", "snapshot_contract"),
        ("bootstrap_manifest", "snapshot_bootstrap_manifest"),
        ("package_manifest", "snapshot_package_manifest"),
        ("t7_source", "snapshot_t7"),
        *(
            (
                f"local_c_header_{index:04d}",
                f"snapshot_closure_{index:04d}",
            )
            for index in range(len([
                role for role in static_identities
                if role.startswith("local_c_header_")
            ]))
        ),
    ):
        if (
            state.frozen[source_role].sha256
            != state.frozen[snapshot_role].sha256
            or state.frozen[source_role].size
            != state.frozen[snapshot_role].size
        ):
            fail("Darwin source snapshot mixed live input versions")
    for role, identity in static_identities.items():
        path = identity_host_path(identity)
        observed = stable_artifact(
            path,
            executable=role in STATIC_EXECUTABLE_ROLES
            or is_darwin_frozen_executable_role(role)
            or role.startswith("transitive_"),
        )[0]
        if observed != identity:
            fail("Darwin frozen static input changed: " + role)
    for role in (
        "cold_candidate",
        "stage0",
        "stage1",
        "stage2",
        "stage3",
        "t7_stage2",
        "t7_stage3",
    ):
        identity = state.frozen[role]
        _observed, raw = stable_artifact(
            identity_host_path(identity),
            executable=True,
        )
        validate_darwin_macho_code_signature(raw, role)
    generated_identity = state.frozen["stage3_generated_c"]
    _generated_observed, generated_raw = stable_artifact(
        identity_host_path(generated_identity),
        executable=False,
    )
    contract_identity = state.frozen["snapshot_contract"]
    _contract_observed, contract_raw = stable_artifact(
        identity_host_path(contract_identity),
        executable=False,
    )
    generated_proof = generated_c_portable_proof(
        generated_raw,
        snapshot_root=state.paths.snapshot,
        impl_identity=state.frozen["snapshot_bootstrap"],
        contract_identity=contract_identity,
        normalized_contract=canonical_bootstrap_contract_bytes(
            contract_raw
        ),
    )
    receipt = lane_receipt_from_completed_state(
        state, generated_proof
    )
    parse_lane_receipt_bytes(receipt.receipt_bytes(), receipt)
    return state, receipt


def write_darwin_lane_receipt(
    evidence_root: Path,
    state: PhaseState,
    receipt: LaneReceipt,
) -> bytes:
    if (
        state.boundary.lane != LANE_DARWIN
        or state.next_phase_index != len(PHASE_SPECS)
        or receipt.lane != LANE_DARWIN
    ):
        fail("Darwin lane receipt lacks completed-state authority")
    validate_darwin_external_inputs(state)
    verify_closed_tree_files_on_disk(state)
    raw = receipt.receipt_bytes()
    if (
        parse_lane_receipt_bytes(raw, receipt) != receipt
        or sha256_bytes(raw) != receipt.receipt_sha256()
    ):
        fail("Darwin lane receipt bytes lack completed-state authority")
    path = evidence_root / DARWIN_LANE_RECEIPT_RELATIVE_PATH
    before_files = {
        item
        for item in evidence_root.rglob("*")
        if item.is_file() and not item.is_symlink()
    }
    before_directories = {
        item
        for item in evidence_root.rglob("*")
        if item.is_dir() and not item.is_symlink()
    }
    receipt_parent = create_exclusive_private_child_directory(
        evidence_root, DARWIN_LANE_RECEIPT_RELATIVE_PATH.parent.name
    )
    identity = publish_exclusive_regular(
        receipt_parent,
        DARWIN_LANE_RECEIPT_RELATIVE_PATH.name,
        raw,
    )
    after_files = {
        item
        for item in evidence_root.rglob("*")
        if item.is_file() and not item.is_symlink()
    }
    after_directories = {
        item
        for item in evidence_root.rglob("*")
        if item.is_dir() and not item.is_symlink()
    }
    if (
        after_files != before_files.union({path})
        or after_directories
            != before_directories.union({receipt_parent})
        or identity.sha256 != receipt.receipt_sha256()
        or parse_lane_receipt_bytes(path.read_bytes(), receipt) != receipt
    ):
        fail("Darwin lane receipt publication delta drifted")
    return raw


