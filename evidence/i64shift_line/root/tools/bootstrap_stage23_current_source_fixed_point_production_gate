        authenticate_linux_kernel_immutable_file(
            LINUX_PORTABLE_AUTHORITY_RECEIPT_PATH,
            "portable authority receipt",
            executable=False,
            exact_mode=0o400,
            max_bytes=MAX_AUTHORITY_BYTES,
            capture=True,
        )
    )
    if receipt_raw is None:
        fail("portable authority receipt bytes are absent")
    receipt = parse_portable_authority_receipt_bytes(receipt_raw)
    production_identity, _production_raw = stable_artifact(
        PRODUCTION_GATE, executable=False
    )
    current_verifier_inputs_cid = verifier_input_set_cid()
