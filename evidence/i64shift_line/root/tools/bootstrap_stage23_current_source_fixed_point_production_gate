def portable_stage23_bound_file(
    value: Any,
    raw: bytes,
    label: str,
) -> Any:
    fields = linux_cgroup_validator.STAGE23_FILE_BINDING_FIELDS
    if not isinstance(value, dict) or set(value) != fields:
        fail(label + " binding fields drifted")
    path_fshex = canonical_path_fshex(value["pathFshex"], label + " path")
    for key in (
        "device", "inode", "size", "mode", "uid", "gid",
        "mtimeNs", "ctimeNs",
    ):
        canonical_uint(value[key], label + " " + key)
    if (
        value["sha256"] != sha256_bytes(raw)
        or value["size"] != len(raw)
        or not stat.S_ISREG(value["mode"])
        or value["mode"] & 0o222
        or value["device"] <= 0
        or value["inode"] <= 0
    ):
        fail(label + " binding identity drifted")
    return linux_cgroup_validator.StableFile(
        path=Path(os.fsdecode(bytes.fromhex(path_fshex))),
        raw=raw,
        sha256=value["sha256"],
        device=value["device"],
        inode=value["inode"],
        size=value["size"],
        mode=value["mode"],
        uid=value["uid"],
        gid=value["gid"],
        mtime_ns=value["mtimeNs"],
        ctime_ns=value["ctimeNs"],
    )


def portable_crun_identity(value: Any) -> ArtifactIdentity:
    fields = linux_cgroup_validator.STAGE23_FILE_BINDING_FIELDS
    if not isinstance(value, dict) or set(value) != fields:
        fail("portable crun binding fields drifted")
    for key in (
        "device", "inode", "size", "mode", "uid", "gid",
        "mtimeNs", "ctimeNs",
    ):
        canonical_uint(value[key], "portable crun " + key)
    return ArtifactIdentity(
        path_fshex=value["pathFshex"],
        sha256=value["sha256"],
        device=value["device"],
        inode=value["inode"],
        mode=value["mode"],
        nlink=1,
        size=value["size"],
        uid=value["uid"],
        gid=value["gid"],
        artifact_format=FORMAT_ELF64_X86_64,
    )


def validate_linux_portable_evidence_closure(
    evidence_root: Path,
    expected_receipt_raw: bytes,
    lane_payload: Mapping[str, Any],
) -> None:
    if (
        not evidence_root.is_absolute()
        or evidence_root.resolve(strict=True) != evidence_root
        or evidence_root.is_symlink()
        or not evidence_root.is_dir()
    ):
        fail("Linux portable evidence root is not canonical")
    lane_root = evidence_root / LANE_LINUX
    receipt_parent = evidence_root / "lane-receipts"
    receipt_path = evidence_root / LINUX_LANE_RECEIPT_RELATIVE_PATH
    if (
        set(evidence_root.iterdir()) != {lane_root, receipt_parent}
        or set(receipt_parent.iterdir()) != {receipt_path}
    ):
        fail("Linux portable evidence root file set drifted")
    receipt_raw = stable_linux_evidence_raw(
        receipt_path, "Linux portable lane receipt"
    )
    if receipt_raw != expected_receipt_raw:
        fail("Linux portable lane receipt bytes drifted")
    expected_lane_children = {
        lane_root / "stage-evidence",
        lane_root / "phase-inputs",
        lane_root / "phase-authority",
    }
    if set(lane_root.iterdir()) != expected_lane_children:
        fail("Linux portable lane closure roots drifted")
    chain_path = (
        lane_root / "stage-evidence"
        / LINUX_PHYSICAL_PHASE_CHAIN_RELATIVE_PATH
    )
    chain_raw = stable_linux_evidence_raw(
        chain_path, "Linux portable phase chain"
    )
    chain_envelope = strict_canonical_json(
        chain_raw[:-1], "Linux portable phase chain"
    )
    payload_fields = {
        "schema",
        "lane",
        "phaseCount",
        "phases",
        "phaseChainSha256",
        "preChainClosedTreeSha256",
        "sourceSnapshotCid",
        "stage3",
    }
    if (
        not isinstance(chain_envelope, dict)
        or set(chain_envelope) != {"payload", "payloadSha256"}
        or not isinstance(chain_envelope.get("payload"), dict)
        or set(chain_envelope["payload"]) != payload_fields
        or canonical_sha256(
            chain_envelope.get("payloadSha256"),
            "Linux portable chain payload",
        ) != sha256_bytes(canonical_json(chain_envelope["payload"]))
    ):
        fail("Linux portable phase chain envelope drifted")
    payload = chain_envelope["payload"]
    phases = payload["phases"]
    if (
        payload["schema"] != LINUX_PHYSICAL_PHASE_CHAIN_SCHEMA
        or payload["lane"] != LANE_LINUX
        or payload["phaseCount"] != len(PHASE_SPECS)
        or not isinstance(phases, list)
        or len(phases) != len(PHASE_SPECS)
        or payload["sourceSnapshotCid"]
            != lane_payload["sourceSnapshotCid"]
        or payload["phaseChainSha256"]
            != lane_payload["phaseChainSha256"]
        or payload["stage3"] != lane_payload["stage3"]
    ):
        fail("Linux portable phase chain lane binding drifted")
    terminals: list[PhaseTerminal] = []
    terminal_sha256s: list[str] = []
    ledger_sha256s: list[str] = []
    phase_fields = {
        "phaseIndex",
        "outerTerminalRelativePath",
        "outerTerminalIdentity",
        "terminalPayloadSha256",
        "cgroupEvidenceRelativePath",
        "cgroupEvidenceClosureSha256",
        "phaseInputsRelativePath",
        "phaseInputsClosureSha256",
    }
    for index, phase in enumerate(phases):
        if not isinstance(phase, dict) or set(phase) != phase_fields:
            fail("Linux portable phase row fields drifted")
        terminal_relative = (
            f"phase-receipts/{index:02d}/outer-terminal.json"
        )
        cgroup_relative = f"phase-authority/phase-{index:02d}"
        inputs_relative = f"phase-inputs/phase-{index:02d}"
        terminal_path = lane_root / "stage-evidence" / terminal_relative
        terminal_row, terminal_raw = stable_closed_file(
            terminal_path, "outer_phase_terminal", terminal_relative
        )
        terminal = parse_outer_phase_terminal_bytes(terminal_raw)
        cgroup_root = lane_root / cgroup_relative
        inputs_root = lane_root / inputs_relative
        cgroup_rows = linux_evidence_closure_rows(
            cgroup_root, require_sealed=True
        )
        input_rows = linux_evidence_closure_rows(
            inputs_root, require_sealed=True
        )
        authority_raw = stable_linux_evidence_raw(
            inputs_root / "phase-authority-manifest.json",
            "portable phase authority",
        )
        execution_raw = stable_linux_evidence_raw(
            inputs_root / "phase-execution-manifest.json",
            "portable phase execution",
        )
        pair_raw = stable_linux_evidence_raw(
            inputs_root / "manifest-pair-commitment.json",
            "portable phase manifest pair",
        )
        authority_value = strict_canonical_json(
            authority_raw[:-1], "portable phase authority"
        ) if authority_raw.endswith(b"\n") else fail(
            "portable phase authority lacks newline"
        )
        execution_value = strict_canonical_json(
            execution_raw[:-1], "portable phase execution"
        ) if execution_raw.endswith(b"\n") else fail(
            "portable phase execution lacks newline"
        )
        pair_value = strict_canonical_json(
            pair_raw[:-1], "portable phase manifest pair"
        ) if pair_raw.endswith(b"\n") else fail(
            "portable phase manifest pair lacks newline"
        )
        if (
            not isinstance(authority_value, dict)
            or not isinstance(execution_value, dict)
            or not isinstance(pair_value, dict)
            or execution_value.get("schema") != STAGE_INPUT_MANIFEST_SCHEMA
            or execution_value.get("lane") != LANE_LINUX
            or execution_value.get("phaseIndex") != index
            or execution_value.get("terminalRelativePath")
                != f"phase-receipts/{index:02d}/terminal.json"
            or set(execution_value) != set(
                stage_input_manifest_fields(LANE_LINUX, index)
            )
        ):
            fail("portable phase manifest schema/order drifted")
        execution_bound = portable_stage23_bound_file(
            authority_value.get("phaseExecutionManifest"),
            execution_raw,
            "portable phase execution",
        )
        pair_bound = portable_stage23_bound_file(
            authority_value.get("manifestPairCommitment"),
            pair_raw,
            "portable phase manifest pair",
        )
        authority_observed = linux_cgroup_validator.stable_read(
            inputs_root / "phase-authority-manifest.json",
            "portable phase authority",
            256 * 1024 * 1024,
        )
        try:
            linux_cgroup_validator.validate_stage23_manifest_pair(
                authority_value,
                execution_value,
                pair_value,
                authority_observed,
                execution_bound,
                pair_bound,
            )
        except linux_cgroup_validator.ValidationError as exc:
            raise ProductionGateError(
                "portable phase manifest pair validation failed"
            ) from exc
        workload = cgroup_root / "workload"
        control = workload / "control"
        copied_authority_raw = stable_linux_evidence_raw(
            workload / "stage-authority-manifest.json",
            "portable copied phase authority",
        )
        copied_execution_raw = stable_linux_evidence_raw(
            workload / "phase-execution-manifest.json",
            "portable copied phase execution",
        )
        copied_pair_raw = stable_linux_evidence_raw(
            workload / "manifest-pair-commitment.json",
            "portable copied phase manifest pair",
        )
        rootfs_raw = stable_linux_evidence_raw(
            workload / "rootfs-manifest.json",
            "portable copied rootfs manifest",
        )
        delegation_raw = stable_linux_evidence_raw(
            workload / "delegation-manifest.kv",
            "portable copied delegation manifest",
        )
        cgroup_input_raw = stable_linux_evidence_raw(
            workload / "input-manifest.json",
            "portable cgroup input manifest",
        )
        cgroup_receipt_raw = stable_linux_evidence_raw(
            workload / "receipt.kv", "portable cgroup receipt"
        )
        ledger_manifest_raw = stable_linux_evidence_raw(
            control / "exec-ledger-manifest.json",
            "portable ptrace manifest",
        )
        ledger_receipt_raw = stable_linux_evidence_raw(
            control / "exec-ledger-receipt.json",
            "portable ptrace receipt",
        )
        ledger_validation_raw = stable_linux_evidence_raw(
            control / "exec-ledger-validator.stdout",
            "portable ptrace validation",
        )
        phase_row_path = (
            lane_root / "stage-evidence"
            / execution_value["terminalRelativePath"]
        )
        phase_row_raw = stable_linux_evidence_raw(
            phase_row_path, "portable inner phase terminal"
        )
        target_stdout_raw = stable_linux_evidence_raw(
            control / "stdout.bin", "portable target stdout"
        )
        target_stderr_raw = stable_linux_evidence_raw(
            control / "stderr.bin", "portable target stderr"
        )
        portable_stage23_bound_file(
            authority_value.get("rootfsManifest"),
            rootfs_raw,
            "portable rootfs manifest",
        )
        portable_stage23_bound_file(
            authority_value.get("delegationManifest"),
            delegation_raw,
            "portable delegation manifest",
        )
        if (
            copied_authority_raw != authority_raw
            or copied_execution_raw != execution_raw
            or copied_pair_raw != pair_raw
            or target_stdout_raw != phase_row_raw
            or target_stderr_raw
        ):
            fail("portable cgroup closure differs from phase inputs/output")
        ledger_manifest_sha = validate_ledger_manifest_raw(
            ledger_manifest_raw
        )
        ledger_payload_sha, event_count, ledger_command_sha = (
            validate_ledger_receipt_raw(
                ledger_receipt_raw,
                execution_value,
                ledger_manifest_sha,
            )
        )
        validate_ledger_validation_raw(
            ledger_validation_raw,
            ledger_receipt_raw,
            ledger_payload_sha,
            ledger_manifest_sha,
            PHASE_SPECS[index].expected_exit_code,
            event_count,
        )
        validate_cgroup_receipt_raw(
            cgroup_receipt_raw,
            envelope=execution_value,
            ledger_raw=ledger_receipt_raw,
            ledger_manifest_raw=ledger_manifest_raw,
            ledger_payload_sha256=ledger_payload_sha,
            ledger_command_sha256=ledger_command_sha,
            ledger_validation_raw=ledger_validation_raw,
            phase_row_raw=phase_row_raw,
            stage_input_raw=execution_raw,
            stage_authority_raw=authority_raw,
            manifest_pair_raw=pair_raw,
            cgroup_input_raw=cgroup_input_raw,
            rootfs_raw=rootfs_raw,
            delegation_raw=delegation_raw,
            crun=portable_crun_identity(authority_value.get("crun")),
        )
        terminal_sha = phase_terminal_sha256(terminal)
        if (
            phase["phaseIndex"] != index
            or phase["outerTerminalRelativePath"] != terminal_relative
            or phase["outerTerminalIdentity"] != terminal_row
            or phase["terminalPayloadSha256"] != terminal_sha
            or phase["cgroupEvidenceRelativePath"] != cgroup_relative
            or phase["cgroupEvidenceClosureSha256"]
                != linux_evidence_closure_cid(cgroup_rows)
            or phase["phaseInputsRelativePath"] != inputs_relative
            or phase["phaseInputsClosureSha256"]
                != linux_evidence_closure_cid(input_rows)
            or sha256_bytes(cgroup_receipt_raw)
                != terminal.cgroup_receipt_sha256
            or sha256_bytes(ledger_receipt_raw)
                != terminal.ledger_receipt_sha256
            or terminal.lane != LANE_LINUX
            or terminal.phase_index != index
            or terminal.predecessor_terminal_sha256
                != (ZERO_SHA256 if index == 0 else terminal_sha256s[-1])
        ):
            fail("Linux portable phase closure binding drifted")
        terminals.append(terminal)
        terminal_sha256s.append(terminal_sha)
        ledger_sha256s.append(terminal.ledger_receipt_sha256)
    boundary_value = terminals[0].boundary
    if any(item.boundary != boundary_value for item in terminals):
        fail("Linux portable phase boundaries differ")
    replay_state = PhaseState(
        boundary=boundary_value,
        paths=None,
        next_phase_index=len(PHASE_SPECS),
        frozen={},
        guest_paths={},
        terminals=tuple(terminals),
        terminal_sha256s=tuple(terminal_sha256s),
        ledger_receipt_sha256s=tuple(ledger_sha256s),
        closed_tree_directories=(),
        closed_tree_files={},
        darwin_live_regular={},
        darwin_live_symlinks={},
    )
    if (
        completed_phase_chain_sha256(replay_state)
            != lane_payload["phaseChainSha256"]
        or aggregate_phase_field_sha256(
            b"cheng.bootstrap.stage23.linux.cgroup.receipts",
            terminals,
            "cgroup_receipt_sha256",
        ) != lane_payload["cgroupReceiptSha256"]
        or aggregate_phase_field_sha256(
            b"cheng.bootstrap.stage23.linux.ptrace.receipts",
            terminals,
            "ledger_receipt_sha256",
        ) != lane_payload["ptraceAggregateSha256"]
    ):
        fail("Linux portable phase aggregate drifted")


def lane_evidence_root_from_receipt_path(
    receipt_path: Path,
    relative_path: Path,
    label: str,
) -> Path:
    if (
        not receipt_path.is_absolute()
        or receipt_path.is_symlink()
        or receipt_path.resolve(strict=True) != receipt_path
        or not receipt_path.is_file()
    ):
        fail(label + " receipt path is not canonical")
    root = receipt_path.parent.parent
    if (
        root / relative_path != receipt_path
        or root.resolve(strict=True) != root
        or root.is_symlink()
        or not root.is_dir()
    ):
        fail(label + " receipt is outside its exact evidence root")
    return root


def compose_candidate_from_existing_lane_receipts(
    linux_receipt_path: Path,
    darwin_receipt_path: Path,
) -> tuple[CompositeTerminal, bytes, bytes, bytes]:
    """Replay two complete lanes and return their deterministic composite.

    This operation is deliberately unprivileged and has no publication side
    effects.  The returned bytes are candidate material only; the independent
    fixed-path publisher must authenticate the external anchor and commit the
    production authority receipt.
    """
    linux_root = lane_evidence_root_from_receipt_path(
        linux_receipt_path,
        LINUX_LANE_RECEIPT_RELATIVE_PATH,
        "Linux lane",
    )
    darwin_root = lane_evidence_root_from_receipt_path(
        darwin_receipt_path,
        DARWIN_LANE_RECEIPT_RELATIVE_PATH,
        "Darwin lane",
    )
    linux_identity, linux_raw = stable_artifact(
        linux_receipt_path, executable=False
    )
    darwin_identity, darwin_raw = stable_artifact(
        darwin_receipt_path, executable=False
    )
    if (
        linux_identity.nlink != 1
        or darwin_identity.nlink != 1
        or stat.S_IMODE(linux_identity.mode) not in (0o400, 0o444)
        or stat.S_IMODE(darwin_identity.mode) not in (0o400, 0o444)
    ):
        fail("lane receipt physical identity is mutable or aliased")
    linux_payload, linux_stage3 = strict_lane_receipt_structure(
        linux_raw, LANE_LINUX
    )
    darwin_payload, darwin_stage3 = strict_lane_receipt_structure(
        darwin_raw, LANE_DARWIN
    )
    validate_linux_portable_evidence_closure(
        linux_root, linux_raw, linux_payload
    )
    _darwin_state, darwin = reconstruct_darwin_physical_evidence(
        darwin_root
    )
    if (
        darwin.stage3 != darwin_stage3
        or parse_lane_receipt_bytes(darwin_raw, darwin) != darwin
    ):
        fail("Darwin lane replay differs from its receipt")
    linux = verified_lane_receipt_from_payload(
        linux_payload, linux_stage3, LANE_LINUX
    )
    if parse_lane_receipt_bytes(linux_raw, linux) != linux:
        fail("Linux lane replay differs from its receipt")
    composite = compose_terminal(linux, darwin)
    composite_raw = composite.receipt_bytes()
    validate_composite_bundle(
        composite, composite_raw, linux_raw, darwin_raw
    )
    second = compose_terminal(linux, darwin)
    if (
        second != composite
        or second.receipt_bytes() != composite_raw
        or composite.linux_receipt_sha256 != linux_identity.sha256
        or composite.darwin_receipt_sha256 != darwin_identity.sha256
    ):
        fail("composite candidate is not deterministic")
    return composite, composite_raw, linux_raw, darwin_raw


def artifact_verification_fields(
    prefix: str,
    identity: ArtifactIdentity,
    *,
    include_format: bool = False,
) -> dict[str, str]:
    values = {
        prefix + "_path_fshex": identity.path_fshex,
        prefix + "_sha256": identity.sha256,
        prefix + "_device": str(identity.device),
        prefix + "_inode": str(identity.inode),
        prefix + "_mode": str(identity.mode),
        prefix + "_nlink": str(identity.nlink),
        prefix + "_size": str(identity.size),
        prefix + "_uid": str(identity.uid),
        prefix + "_gid": str(identity.gid),
    }
    if include_format:
        values[prefix + "_format"] = identity.artifact_format
    return values


