def lane_boundary_from_payload(value: Any) -> LaneBoundary:
    if (
        not isinstance(value, dict)
        or set(value)
            != {"lane", "memoryProofStatus", "cgroupLeaf"}
        or not isinstance(value["lane"], str)
        or not isinstance(value["memoryProofStatus"], str)
    ):
        fail("physical phase boundary fields drifted")
    lane = canonical_lane(value["lane"])
    leaf_raw = value["cgroupLeaf"]
    leaf = None
    if lane == LANE_LINUX:
        keys = {
            "mountDevice",
            "mountInode",
            "namespaceInode",
            "parentDevice",
            "parentInode",
            "leafDevice",
            "leafInode",
            "leafPathFshex",
        }
        if not isinstance(leaf_raw, dict) or set(leaf_raw) != keys:
            fail("physical Linux boundary leaf fields drifted")
        leaf = CgroupLeafIdentity(
            mount_device=canonical_uint(
                leaf_raw["mountDevice"], "physical mount device"
            ),
            mount_inode=canonical_uint(
                leaf_raw["mountInode"], "physical mount inode"
            ),
            namespace_inode=canonical_uint(
                leaf_raw["namespaceInode"], "physical namespace inode"
            ),
            parent_device=canonical_uint(
                leaf_raw["parentDevice"], "physical parent device"
            ),
            parent_inode=canonical_uint(
                leaf_raw["parentInode"], "physical parent inode"
            ),
            leaf_device=canonical_uint(
                leaf_raw["leafDevice"], "physical leaf device"
            ),
            leaf_inode=canonical_uint(
                leaf_raw["leafInode"], "physical leaf inode"
            ),
            leaf_path_fshex=leaf_raw["leafPathFshex"],
        )
    elif leaf_raw is not None:
        fail("physical Darwin boundary acquired a cgroup leaf")
    return LaneBoundary(lane, value["memoryProofStatus"], leaf)


def phase_terminal_from_payload(value: Any) -> PhaseTerminal:
    if (
        not isinstance(value, dict)
        or not isinstance(value.get("lane"), str)
        or not isinstance(value.get("phaseIndex"), int)
        or isinstance(value.get("phaseIndex"), bool)
        or value.get("schema")
            != "cheng.bootstrap_stage23_platform_phase_terminal"
    ):
        fail("physical outer phase terminal fields drifted")
    lane = canonical_lane(value["lane"])
    phase_index = canonical_uint(
        value["phaseIndex"], "physical outer phase phaseIndex"
    )
    multi_action = lane == LANE_DARWIN and phase_index in (0, 1)
    expected_keys = (
        PHASE_TERMINAL_MULTI_ACTION_PAYLOAD_KEYS
        if multi_action
        else PHASE_TERMINAL_SINGLE_COMMAND_PAYLOAD_KEYS
    )
    if set(value) != set(expected_keys):
        fail("physical outer phase terminal fields drifted")
    string_fields = (
        "lane",
        "targetTriple",
        "machineAuthority",
        "phaseLabel",
        "executionProofStatus",
        "ledgerStatus",
        "guardStatus",
        "extraExecStatus",
    )
    if any(not isinstance(value[key], str) for key in string_fields):
        fail("physical outer phase terminal string field drifted")
    if (
        not multi_action
        and (
            not isinstance(value["commandRole"], str)
            or not re.fullmatch(
                r"[a-z][a-z0-9_]*", value["commandRole"]
            )
        )
    ):
        fail("physical outer phase command role drifted")
    hash_fields = [
        "phasePlanSha256",
        "manifestSha256",
        "ledgerReceiptSha256",
        "cgroupReceiptSha256",
        "ledgerValidationSha256",
        "phaseRowReceiptSha256",
        "stageInputManifestSha256",
        "rootfsManifestSha256",
        "delegationReceiptSha256",
        "crunSha256",
        "runnerArgvSha256",
        "envSha256",
        "executableClosureSha256",
        "predecessorTerminalSha256",
    ]
    hash_fields.extend(
        (
            "guardReceiptsAggregateSha256",
            "phaseCommandActionsSha256",
        )
        if multi_action
        else ("guardReportSha256", "argvSha256")
    )
    for key in hash_fields:
        if not isinstance(value[key], str):
            fail("physical outer phase hash field type drifted")
        canonical_sha256(value[key], "physical outer phase " + key)
    uint_fields = [
        "ledgerUnverifiedCount",
        "ledgerEventCount",
        "expectedExitCode",
        "liveTaskCount",
        "observedExecutableCount",
    ]
    if not multi_action:
        uint_fields.append("actualExitCode")
    integers = {
        key: canonical_uint(value[key], "physical outer phase " + key)
        for key in uint_fields
    }
    integers["phaseIndex"] = phase_index
    command_identities: list[dict[str, Any]] = []
    action_receipts: list[dict[str, Any]] = []
    actual_exit_codes: tuple[int, ...] = ()
    if multi_action:
        identity_rows = value["commandIdentities"]
        receipt_rows = value["commandActionReceipts"]
        exit_rows = value["actualExitCodes"]
        if (
            not isinstance(identity_rows, list)
            or not isinstance(receipt_rows, list)
            or not isinstance(exit_rows, list)
            or not identity_rows
            or len(identity_rows) != len(receipt_rows)
            or len(exit_rows) != len(receipt_rows)
        ):
            fail("physical outer phase command action cardinality drifted")
        actual_exit_codes = tuple(
            canonical_uint(
                item, "physical outer phase action exit code"
            )
            for item in exit_rows
        )
        physical_keys = {
            "device", "inode", "mode", "nlink", "uid", "gid", "size",
            "mtimeNs", "ctimeNs",
        }
        for index, row in enumerate(identity_rows):
            if (
                not isinstance(row, dict)
                or set(row) != {
                    "commandActionIndex",
                    "targetExecutableRole",
                    "identity",
                    "physicalIdentity",
                }
                or row["commandActionIndex"] != index
                or not isinstance(row["targetExecutableRole"], str)
                or not re.fullmatch(
                    r"[a-z][a-z0-9_]*",
                    row["targetExecutableRole"],
                )
                or not isinstance(row["physicalIdentity"], dict)
                or set(row["physicalIdentity"]) != physical_keys
            ):
                fail("physical outer phase command identity row drifted")
            identity = artifact_identity_from_payload(
                row["identity"],
                "physical outer phase action command",
            )
            physical = {
                key: canonical_uint(
                    row["physicalIdentity"][key],
                    "physical outer phase action command " + key,
                )
                for key in physical_keys
            }
            command_identities.append({
                "commandActionIndex": index,
                "targetExecutableRole": row["targetExecutableRole"],
                "identity": identity.payload(),
                "physicalIdentity": physical,
            })
        receipt_keys = {
            "commandActionIndex",
            "targetExecutableRole",
            "targetArgvSha256",
            "guardReceiptSha256",
            "guardStdoutSha256",
            "guardStderrSha256",
            "businessOutputRoles",
            "privateFrozenTree",
        }
        for index, row in enumerate(receipt_rows):
            if (
                not isinstance(row, dict)
                or set(row) != receipt_keys
                or row["commandActionIndex"] != index
                or not isinstance(row["targetExecutableRole"], str)
                or not isinstance(row["businessOutputRoles"], list)
                or not isinstance(row["privateFrozenTree"], dict)
                or set(row["privateFrozenTree"]) != {
                    "schema",
                    "root",
                    "sha256",
                    "entryCount",
                    "directoryCount",
                    "fileCount",
                    "watchCount",
                    "watchCoverage",
                    "sameUidBoundary",
                }
                or row["privateFrozenTree"].get("schema")
                    != "cheng.guard.private_frozen_tree_binding"
                or row["privateFrozenTree"].get("entryCount")
                    != row["privateFrozenTree"].get("watchCount")
                or row["privateFrozenTree"].get("entryCount")
                    != (
                        row["privateFrozenTree"].get(
                            "directoryCount", -1
                        )
                        + row["privateFrozenTree"].get(
                            "fileCount", -1
                        )
                    )
                or not isinstance(
                    row["privateFrozenTree"].get("root"), str
                )
                or not re.fullmatch(
                    r"[0-9a-f]{64}",
                    row["privateFrozenTree"].get("sha256", ""),
                )
                or any(
                    not isinstance(role, str)
                    or not re.fullmatch(r"[a-z][a-z0-9_]*", role)
                    for role in row["businessOutputRoles"]
                )
            ):
                fail("physical outer phase command receipt row drifted")
            for key in (
                "targetArgvSha256",
                "guardReceiptSha256",
                "guardStdoutSha256",
                "guardStderrSha256",
            ):
                canonical_sha256(
                    row[key],
                    "physical outer phase command receipt " + key,
                )
            action_receipts.append(dict(row))
    produced_raw = value["produced"]
    if not isinstance(produced_raw, list):
        fail("physical outer phase produced list drifted")
    produced: list[ProducedArtifact] = []
    roles: set[str] = set()
    for row in produced_raw:
        if (
            not isinstance(row, dict)
            or set(row) != {"role", "identity"}
            or not isinstance(row["role"], str)
            or not re.fullmatch(r"[a-z][a-z0-9_]*", row["role"])
            or row["role"] in roles
        ):
            fail("physical outer phase produced row drifted")
        roles.add(row["role"])
        produced.append(ProducedArtifact(
            row["role"],
            artifact_identity_from_payload(
                row["identity"],
                "physical outer phase " + row["role"],
            ),
        ))
    return PhaseTerminal(
        lane=value["lane"],
        target_triple=value["targetTriple"],
        machine_authority=value["machineAuthority"],
        phase_index=integers["phaseIndex"],
        phase_label=value["phaseLabel"],
        boundary=lane_boundary_from_payload(value["boundary"]),
        command_role=None if multi_action else value["commandRole"],
        command_identity=(
            None if multi_action else artifact_identity_from_payload(
                value["commandIdentity"],
                "physical outer phase command",
            )
        ),
        command_identities=tuple(command_identities),
        phase_plan_sha256=value["phasePlanSha256"],
        manifest_sha256=value["manifestSha256"],
        execution_proof_status=value["executionProofStatus"],
        ledger_status=value["ledgerStatus"],
        ledger_receipt_sha256=value["ledgerReceiptSha256"],
        ledger_unverified_count=integers["ledgerUnverifiedCount"],
        ledger_event_count=integers["ledgerEventCount"],
        guard_report_sha256=(
            None if multi_action else value["guardReportSha256"]
        ),
        guard_receipts_aggregate_sha256=(
            value["guardReceiptsAggregateSha256"]
            if multi_action else None
        ),
        command_action_receipts=tuple(action_receipts),
        cgroup_receipt_sha256=value["cgroupReceiptSha256"],
        ledger_validation_sha256=value["ledgerValidationSha256"],
        phase_row_receipt_sha256=value["phaseRowReceiptSha256"],
        stage_input_manifest_sha256=value["stageInputManifestSha256"],
        rootfs_manifest_sha256=value["rootfsManifestSha256"],
        delegation_receipt_sha256=value["delegationReceiptSha256"],
        crun_sha256=value["crunSha256"],
        guard_status=value["guardStatus"],
        expected_exit_code=integers["expectedExitCode"],
        actual_exit_code=(
            None if multi_action else integers["actualExitCode"]
        ),
        actual_exit_codes=actual_exit_codes,
        argv_sha256=None if multi_action else value["argvSha256"],
        phase_command_actions_sha256=(
            value["phaseCommandActionsSha256"]
            if multi_action else None
        ),
        runner_argv_sha256=value["runnerArgvSha256"],
        env_sha256=value["envSha256"],
        live_task_count=integers["liveTaskCount"],
        extra_exec_status=value["extraExecStatus"],
        executable_closure_sha256=value["executableClosureSha256"],
        observed_executable_count=integers["observedExecutableCount"],
        predecessor_terminal_sha256=
            value["predecessorTerminalSha256"],
        produced=tuple(produced),
    )


def outer_phase_terminal_bytes(terminal: PhaseTerminal) -> bytes:
    payload = terminal.payload()
    return canonical_json({
        "payload": payload,
        "payloadSha256": phase_terminal_sha256(terminal),
    }) + b"\n"


def parse_outer_phase_terminal_bytes(raw: bytes) -> PhaseTerminal:
    if not raw.endswith(b"\n"):
        fail("physical outer phase terminal lacks terminal newline")
    value = strict_canonical_json(
        raw[:-1], "physical outer phase terminal"
    )
    if (
        not isinstance(value, dict)
        or set(value) != {"payload", "payloadSha256"}
        or not isinstance(value["payloadSha256"], str)
        or canonical_sha256(
            value["payloadSha256"],
            "physical outer phase terminal payload",
        ) != sha256_bytes(canonical_json(value["payload"]))
    ):
        fail("physical outer phase terminal self hash drifted")
    terminal = phase_terminal_from_payload(value["payload"])
    if outer_phase_terminal_bytes(terminal) != raw:
        fail("physical outer phase terminal canonical bytes drifted")
    return terminal


def phase_terminal_from_raw_evidence(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    evidence: PhaseRawEvidence,
    frozen_envelope: dict[str, Any],
    frozen_envelope_sha256: str,
) -> PhaseTerminal:
    if not isinstance(evidence, PhaseRawEvidence):
        fail("phase raw evidence is absent")
    envelope = validate_frozen_phase_envelope(
        state,
        frozen_envelope,
        frozen_envelope_sha256,
    )
    spec = PHASE_SPECS[state.next_phase_index]
    planned_roles = tuple(
        item["role"] for item in envelope["plannedOutputs"]
    )
    produced = {item.role: item.identity for item in evidence.produced}
    if (
        len(produced) != len(evidence.produced)
        or tuple(item.role for item in evidence.produced)
            != planned_roles
    ):
        fail("phase raw evidence output role order drifted")
    expected_stage_input_raw = stage_input_manifest_raw_from_envelope(
        state, envelope
    )
    if (
        evidence.stage_input_manifest_raw != expected_stage_input_raw
        or evidence.stage_input_manifest_identity.sha256
            != sha256_bytes(expected_stage_input_raw)
    ):
        fail("phase raw evidence stage input manifest drifted")
    multi_action = "phaseCommandActions" in envelope
    if multi_action:
        if (
            evidence.guard_receipt_raw
            or evidence.guard_stdout_raw
            or evidence.guard_stderr_raw
            or not evidence.command_action_evidence
        ):
            fail("multi-action phase retained singleton guard authority")
        command_action_receipts, guard_aggregate = (
            validate_private_action_guard_receipts(
                state,
                envelope,
                evidence.command_action_evidence,
                produced,
            )
        )
        guard_rows = {"status": "completed"}
    else:
        if evidence.command_action_evidence:
            fail("single-command phase acquired action guard authority")
        guard_rows = validate_guard_receipt_raw(
            evidence.guard_receipt_raw,
            state,
            envelope,
            produced,
        )
        command_action_receipts = ()
        guard_aggregate = None
    manifest_sha = (
        validate_ledger_manifest_raw(evidence.ledger_manifest_raw)
        if state.boundary.lane == LANE_LINUX
        else phase_manifest_sha256_from_envelope(
            state, allowlist, envelope
        )
    )
    if state.boundary.lane == LANE_LINUX:
        if (
            not evidence.ledger_receipt_raw
            or not evidence.ledger_validation_raw
            or not evidence.cgroup_receipt_raw
            or not evidence.rootfs_manifest_raw
            or not evidence.delegation_receipt_raw
            or not evidence.cgroup_input_manifest_raw
            or not evidence.stage_authority_manifest_raw
            or not evidence.manifest_pair_commitment_raw
            or evidence.crun_identity is None
            or evidence.crun_identity.artifact_format
                != FORMAT_ELF64_X86_64
        ):
            fail("Linux phase raw authority is incomplete")
        pair_value = strict_canonical_json(
            evidence.manifest_pair_commitment_raw[:-1],
            "Linux phase manifest pair commitment",
        ) if evidence.manifest_pair_commitment_raw.endswith(b"\n") else fail(
            "Linux phase manifest pair commitment lacks newline"
        )
        pair_authority_core = (
            pair_value.get("authorityCoreSha256", "")
            if isinstance(pair_value, dict) else ""
        )
        pair_execution_core = (
            pair_value.get("executionCoreSha256", "")
            if isinstance(pair_value, dict) else ""
        )
        if (
            not isinstance(pair_value, dict)
            or set(pair_value)
                != linux_cgroup_validator.STAGE23_MANIFEST_PAIR_FIELDS
            or pair_value.get("schema")
                != linux_cgroup_validator.STAGE23_MANIFEST_PAIR_SCHEMA
            or canonical_sha256(
                pair_authority_core, "Linux authority core"
            ) != pair_authority_core
            or canonical_sha256(
                pair_execution_core, "Linux execution core"
            ) != pair_execution_core
            or pair_value.get("pairSha256")
                != linux_cgroup_validator.stage23_manifest_pair_sha256(
                    pair_authority_core,
                    pair_execution_core,
                )
        ):
            fail("Linux phase manifest pair commitment drifted")
        (
            ledger_payload_sha,
            event_count,
            ledger_command_sha,
        ) = validate_ledger_receipt_raw(
            evidence.ledger_receipt_raw,
            envelope,
            manifest_sha,
        )
        validate_ledger_validation_raw(
            evidence.ledger_validation_raw,
            evidence.ledger_receipt_raw,
            ledger_payload_sha,
            manifest_sha,
            spec.expected_exit_code,
            event_count,
        )
        validate_phase_row_receipt_raw(
            evidence.phase_row_receipt_raw,
            state=state,
            envelope=envelope,
            guard_raw=evidence.guard_receipt_raw,
            command_action_evidence=
                evidence.command_action_evidence,
            stage_input_raw=evidence.stage_input_manifest_raw,
            produced=produced,
        )
        validate_cgroup_receipt_raw(
            evidence.cgroup_receipt_raw,
            envelope=envelope,
            ledger_raw=evidence.ledger_receipt_raw,
            ledger_manifest_raw=evidence.ledger_manifest_raw,
            ledger_payload_sha256=ledger_payload_sha,
            ledger_command_sha256=ledger_command_sha,
            ledger_validation_raw=evidence.ledger_validation_raw,
            phase_row_raw=evidence.phase_row_receipt_raw,
            stage_input_raw=evidence.stage_input_manifest_raw,
            stage_authority_raw=evidence.stage_authority_manifest_raw,
            manifest_pair_raw=evidence.manifest_pair_commitment_raw,
            cgroup_input_raw=evidence.cgroup_input_manifest_raw,
            rootfs_raw=evidence.rootfs_manifest_raw,
            delegation_raw=evidence.delegation_receipt_raw,
            crun=evidence.crun_identity,
        )
        execution_status = LINUX_EXECUTION_PROOF
        ledger_status = LINUX_LEDGER_STATUS
        ledger_sha = sha256_bytes(evidence.ledger_receipt_raw)
        extra_exec_status = "PROVED_ZERO"
        cgroup_sha = sha256_bytes(evidence.cgroup_receipt_raw)
        ledger_validation_sha = sha256_bytes(
            evidence.ledger_validation_raw
        )
        rootfs_sha = sha256_bytes(evidence.rootfs_manifest_raw)
        delegation_sha = sha256_bytes(
            evidence.delegation_receipt_raw
        )
        crun_sha = evidence.crun_identity.sha256
    elif spec.index == 10:
        if (
            evidence.ledger_receipt_raw
            or evidence.ledger_validation_raw
            or evidence.cgroup_receipt_raw
            or evidence.rootfs_manifest_raw
            or evidence.delegation_receipt_raw
            or evidence.ledger_manifest_raw
            or evidence.cgroup_input_manifest_raw
            or evidence.stage_authority_manifest_raw
            or evidence.manifest_pair_commitment_raw
            or evidence.crun_identity is not None
        ):
            fail("pure fixed-point phase acquired external execution proof")
        validate_phase_row_receipt_raw(
            evidence.phase_row_receipt_raw,
            state=state,
            envelope=envelope,
            guard_raw=evidence.guard_receipt_raw,
            command_action_evidence=
                evidence.command_action_evidence,
