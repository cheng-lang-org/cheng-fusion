            identity_host_path(produced[
                next(
                    role for role in command_roles
                    if not role.endswith("_report")
                    and not role.endswith("_generated_c")
                )
            ]),
            identity_host_path(produced[
                next(
                    role for role in command_roles
                    if role.endswith("_generated_c")
                )
            ]),
        )
        final_report_identity, _final_report_raw = stable_artifact(
            report_path, executable=False
        )
        if final_report_identity != report_identity:
            fail(
                "bootstrap self-image compile report changed "
                "during validation"
            )
    return rows


def validate_private_action_guard_receipts(
    state: PhaseState,
    envelope: Mapping[str, Any],
    evidence: Sequence[CommandActionRawEvidence],
    produced: Mapping[str, ArtifactIdentity],
) -> tuple[tuple[dict[str, Any], ...], str]:
    actions = envelope.get("phaseCommandActions")
    identities = envelope.get("commandIdentities")
    private_trees = envelope.get(
        "commandActionPrivateFrozenTrees"
    )
    if (
        state.boundary.lane != LANE_DARWIN
        or state.next_phase_index not in (0, 1)
        or not isinstance(actions, list)
        or not isinstance(identities, list)
        or len(actions) != len(identities)
        or not isinstance(private_trees, list)
        or len(private_trees) != len(actions)
    ):
        fail("private action guard authority is outside Darwin phase0/1")
    private_trees_by_index = {
        item.get("commandActionIndex"): item
        for item in private_trees
        if isinstance(item, dict)
    }
    if set(private_trees_by_index) != set(range(len(actions))):
        fail("private action tree binding indices drifted")
    evidence_by_index = {
        item.command_action_index: item for item in evidence
    }
    if (
        len(evidence_by_index) != len(evidence)
        or set(evidence_by_index) != set(range(len(actions)))
    ):
        fail("private action guard evidence indices drifted")
    planned_by_role = {
        item["role"]: item for item in envelope["plannedOutputs"]
    }
    monitor_runtime = envelope["monitorRuntime"]
    monitor_runtime_identity = state.frozen["process_guard_runtime"]
    monitor_python_identity = state.frozen["python"]
    runtime_physical = monitor_runtime["physicalIdentity"]
    launcher_path = Path("/usr/bin/sandbox-exec")
    launcher_identity, launcher_raw = stable_artifact(
        launcher_path, executable=True
    )
    requested_env = {
        item["name"]: item["value"] for item in envelope["phaseEnv"]
    }
    receipts: list[dict[str, Any]] = []
    for index, action in enumerate(actions):
        tree_row = private_trees_by_index[index]
        tree_contract = action["privateFrozenTree"]
        tree_root = Path(tree_contract["root"])
        if (
            tree_row.get("commandActionIndex") != index
            or tree_row.get("bindingMode")
                != tree_contract["bindingMode"]
            or tree_row.get("derivedInput")
                != tree_contract["derivedInput"]
        ):
            fail("private action tree contract drifted")
        if (
            tree_contract["bindingMode"] != "exact_prebound"
            or tree_contract["derivedInput"] is not None
            or set(tree_row) != {
                "commandActionIndex",
                "bindingMode",
                "tree",
                "derivedInput",
            }
        ):
            fail("private action tree binding mode drifted")
        private_tree = tree_row["tree"]
        if (
            private_tree.get("root") != str(tree_root)
            or private_frozen_tree_binding(tree_root) != private_tree
        ):
            fail("private action final tree identity drifted")
        root_info = os.lstat(tree_root)
        action_evidence = evidence_by_index[index]
        identity_row = identities[index]
        target_role = action["targetExecutableRole"]
        target_identity = state.frozen[target_role]
        target_physical = identity_row["physicalIdentity"]
