def phase_zero_manifest_frozen_identity(
    state: PhaseState,
    role: str,
) -> ArtifactIdentity:
    if (
        state.boundary.lane != LANE_DARWIN
        or not state.terminals
        or state.terminals[0].phase_index != 0
    ):
        fail("phase zero frozen identity authority is absent")
    relative = "phase-receipts/00/stage-input-manifest.json"
    closed = state.closed_tree_files.get(relative)
    if (
        closed is None
        or closed.get("role") != "phase_stage_input_manifest"
    ):
        fail("phase zero stage input manifest is absent")
    observed, raw = stable_closed_file(
        state.paths.evidence / relative,
        "phase_stage_input_manifest",
        relative,
    )
    if (
        observed != closed
        or sha256_bytes(raw)
            != state.terminals[0].stage_input_manifest_sha256
        or not raw.endswith(b"\n")
    ):
        fail("phase zero stage input manifest identity drifted")
    value = strict_canonical_json(
        raw[:-1], "phase zero stage input manifest"
    )
    frozen_rows = value.get("frozenRoles")
    if not isinstance(frozen_rows, list):
        fail("phase zero frozen role authority is absent")
    matches = [
        row for row in frozen_rows
        if isinstance(row, dict) and row.get("role") == role
    ]
    if (
        len(matches) != 1
        or set(matches[0]) != {
            "role",
            "hostIdentity",
            "guestPath",
        }
        or matches[0]["guestPath"] is not None
    ):
        fail("phase zero frozen role authority drifted")
    identity = artifact_identity_from_payload(
        matches[0]["hostIdentity"],
        "phase zero frozen role " + role,
    )
    if state.frozen.get(role) != identity:
        fail("phase zero frozen role no longer matches state")
    return identity


def validate_phase15_source_post_authority(
    state: PhaseState,
    terminal: PhaseTerminal,
) -> None:
    if state.boundary.lane != LANE_DARWIN:
        return
    if terminal.phase_index != 15:
        fail("phase fifteen authority validator used out of phase")
    produced = {item.role: item.identity for item in terminal.produced}
    if len(produced) != len(terminal.produced):
        fail("phase fifteen output role aliases")
    source_post = produced.get("source_post_manifest")
    post_stdout = produced.get("cc_deps_post_stdout")
    if source_post is None or post_stdout is None:
        fail("phase fifteen authority outputs are absent")
    observed, raw = stable_artifact(
        identity_host_path(source_post), executable=False
    )
    if (
        observed != source_post
        or stat.S_IMODE(source_post.mode) != 0o400
        or stat.S_IMODE(post_stdout.mode) != 0o400
        or not raw.endswith(b"\n")
    ):
        fail("phase fifteen authority output identity drifted")
    value = strict_canonical_json(
        raw[:-1], "phase fifteen source post manifest"
    )
    if (
        not isinstance(value, dict)
        or set(value) != {"payload", "payloadSha256"}
        or not isinstance(value.get("payload"), dict)
        or value.get("payloadSha256")
            != sha256_bytes(canonical_json(value["payload"]))
    ):
        fail("phase fifteen source post manifest wrapper drifted")
    phase_zero_source = phase_zero_manifest_frozen_identity(
        state, "bootstrap_source"
    )
    phase_zero_manifest = phase_zero_manifest_frozen_identity(
        state, "bootstrap_manifest"
    )
    source_pre = state.frozen.get("source_pre_manifest")
    phase_zero_outputs = {
        item.role: item.identity for item in state.terminals[0].produced
    }
    if (
        source_pre is None
        or phase_zero_outputs.get("source_pre_manifest") != source_pre
        or stat.S_IMODE(source_pre.mode) != 0o400
    ):
        fail("phase zero source pre manifest authority drifted")
    expected_inputs = [
        {
            "role": "bootstrap_source",
            "authorityKind":
                phase_engine.FROZEN_ROLE_AUTHORITY,
            "identity": phase_zero_source.payload(),
        },
        {
            "role": "bootstrap_manifest",
            "authorityKind":
                phase_engine.FROZEN_ROLE_AUTHORITY,
            "identity": phase_zero_manifest.payload(),
        },
        {
            "role": "cc_deps_post_stdout",
            "authorityKind":
                phase_engine.SEALED_OUTPUT_AUTHORITY,
            "identity": post_stdout.payload(),
        },
        {
            "role": "source_pre_manifest",
            "authorityKind":
                phase_engine.FROZEN_ROLE_AUTHORITY,
            "identity": source_pre.payload(),
        },
    ]
    if value["payload"] != {
        "schema": phase_engine.PHASE_AUTHORITY_ARTIFACT_SCHEMA,
        "operation": "seal_source_post_manifest",
        "phaseIndex": 15,
        "inputs": expected_inputs,
    }:
        fail("phase fifteen source post authority drifted")


def advance_phase(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    evidence: PhaseRawEvidence,
    frozen_envelope: dict[str, Any],
    frozen_envelope_sha256: str,
) -> PhaseState:
    if state.next_phase_index >= len(PHASE_SPECS):
        fail("extra terminal after phase chain")
    spec = PHASE_SPECS[state.next_phase_index]
    envelope = validate_frozen_phase_envelope(
        state,
        frozen_envelope,
        frozen_envelope_sha256,
    )
    terminal = phase_terminal_from_raw_evidence(
        state,
        allowlist,
        evidence,
        frozen_envelope,
        frozen_envelope_sha256,
    )
    predecessor = (
        state.terminal_sha256s[-1]
        if state.terminal_sha256s else ZERO_SHA256
    )
    multi_action = "phaseCommandActions" in envelope
    command = state.frozen.get(spec.command_role)
    command_contract_valid = (
        (
            terminal.command_role is None
            and terminal.command_identity is None
            and terminal.command_identities
                == tuple(envelope["commandIdentities"])
            and terminal.command_action_receipts
            and terminal.guard_report_sha256 is None
            and terminal.guard_receipts_aggregate_sha256
                == sha256_bytes(canonical_json(
                    terminal.command_action_receipts
                ))
            and terminal.actual_exit_code is None
            and terminal.actual_exit_codes
                == tuple(
                    spec.expected_exit_code
                    for _item in envelope["phaseCommandActions"]
                )
            and terminal.argv_sha256 is None
            and terminal.phase_command_actions_sha256
                == envelope["phaseCommandActionsSha256"]
        )
        if multi_action
        else (
            terminal.command_role == spec.command_role
            and terminal.command_identity == command
            and not terminal.command_identities
            and not terminal.command_action_receipts
            and terminal.guard_report_sha256 is not None
            and terminal.guard_receipts_aggregate_sha256 is None
            and terminal.actual_exit_code == spec.expected_exit_code
            and not terminal.actual_exit_codes
            and terminal.argv_sha256
                == envelope["phaseCommandArgvSha256"]
            and terminal.phase_command_actions_sha256 is None
        )
    )
    if (
        terminal.lane != state.boundary.lane
        or terminal.target_triple
            != LANE_TARGET_TRIPLE[state.boundary.lane]
        or terminal.machine_authority
            != LANE_MACHINE_AUTHORITY[state.boundary.lane]
        or terminal.phase_index != spec.index
        or terminal.phase_label != spec.label
        or terminal.boundary != state.boundary
        or not command_contract_valid
        or terminal.phase_plan_sha256 != envelope["phasePlanSha256"]
        or terminal.predecessor_terminal_sha256 != predecessor
        or terminal.runner_argv_sha256 != envelope["runnerArgvSha256"]
        or terminal.env_sha256 != envelope["phaseEnvSha256"]
        or terminal.executable_closure_sha256
            != envelope["executableClosureSha256"]
        or terminal.observed_executable_count
            != (
                0
                if state.boundary.lane == LANE_DARWIN
                    and spec.index == 10
                else envelope["executableCount"]
        )
        or terminal.guard_status != "completed"
        or terminal.expected_exit_code != spec.expected_exit_code
        or terminal.live_task_count != 0
    ):
        fail("phase terminal common contract failed")
    guard_terminal_sha = (
        terminal.guard_receipts_aggregate_sha256
        if multi_action else terminal.guard_report_sha256
    )
    argv_terminal_sha = (
        terminal.phase_command_actions_sha256
        if multi_action else terminal.argv_sha256
    )
    if (
        guard_terminal_sha is None
        or guard_terminal_sha == ZERO_SHA256
        or argv_terminal_sha is None
    ):
        fail("phase terminal command aggregate is absent")
    for label, value in (
        ("manifest", terminal.manifest_sha256),
        ("ledger", terminal.ledger_receipt_sha256),
        ("guard", guard_terminal_sha),
        ("phase plan", terminal.phase_plan_sha256),
        ("argv", argv_terminal_sha),
        ("runner argv", terminal.runner_argv_sha256),
        ("env", terminal.env_sha256),
        ("phase row", terminal.phase_row_receipt_sha256),
        ("stage input", terminal.stage_input_manifest_sha256),
    ):
        canonical_sha256(value, label)
    if state.boundary.lane == LANE_LINUX:
        if (
            terminal.execution_proof_status != LINUX_EXECUTION_PROOF
            or terminal.ledger_status != LINUX_LEDGER_STATUS
            or terminal.ledger_receipt_sha256 == ZERO_SHA256
            or terminal.ledger_unverified_count != 0
            or terminal.ledger_event_count <= 0
            or terminal.extra_exec_status != "PROVED_ZERO"
            or terminal.cgroup_receipt_sha256 == ZERO_SHA256
            or terminal.ledger_validation_sha256 == ZERO_SHA256
            or terminal.phase_row_receipt_sha256 == ZERO_SHA256
            or terminal.stage_input_manifest_sha256 == ZERO_SHA256
            or terminal.rootfs_manifest_sha256 == ZERO_SHA256
            or terminal.delegation_receipt_sha256 == ZERO_SHA256
            or terminal.crun_sha256 == ZERO_SHA256
        ):
            fail("Linux phase lacks cgroup and ptrace proof")
    elif spec.index == 10:
        if (
            terminal.execution_proof_status
                != "PROVED_PURE_PHYSICAL_VALIDATOR"
            or terminal.ledger_status
                != "NOT_APPLICABLE_PURE_VALIDATOR"
            or terminal.ledger_receipt_sha256 != ZERO_SHA256
            or terminal.ledger_unverified_count != 0
            or terminal.ledger_event_count != 0
            or terminal.extra_exec_status
                != "PROVED_ZERO_EXTERNAL_EXEC"
            or terminal.cgroup_receipt_sha256 != ZERO_SHA256
            or terminal.ledger_validation_sha256 != ZERO_SHA256
            or terminal.rootfs_manifest_sha256 != ZERO_SHA256
            or terminal.delegation_receipt_sha256 != ZERO_SHA256
            or terminal.crun_sha256 != ZERO_SHA256
        ):
            fail("pure fixed-point phase execution contract drifted")
    elif (
        terminal.execution_proof_status != DARWIN_EXECUTION_PROOF
        or terminal.ledger_status != DARWIN_LEDGER_STATUS
        or terminal.ledger_receipt_sha256 != ZERO_SHA256
        or terminal.ledger_unverified_count != 0
        or terminal.ledger_event_count != 0
        or terminal.extra_exec_status != "NOT_PROVABLE_USERSPACE"
        or terminal.cgroup_receipt_sha256 != ZERO_SHA256
        or terminal.ledger_validation_sha256 != ZERO_SHA256
        or terminal.rootfs_manifest_sha256 != ZERO_SHA256
        or terminal.delegation_receipt_sha256 != ZERO_SHA256
        or terminal.crun_sha256 != ZERO_SHA256
    ):
        fail("Darwin phase overclaimed Linux execution proof")
    planned_roles = tuple(
        item["role"] for item in envelope["plannedOutputs"]
    )
    if tuple(item.role for item in terminal.produced) != planned_roles:
        fail("phase output role set or order drifted")
    frozen = dict(state.frozen)
    paths = {item.path_fshex for item in frozen.values()}
    output_kinds = {
        item["role"]: item["kind"]
        for item in envelope["plannedOutputs"]
    }
    planned_outputs = {
        item["role"]: item for item in envelope["plannedOutputs"]
    }
    native_format = expected_lane_format(state.boundary.lane)
    for item in terminal.produced:
        if item.role in frozen or item.identity.path_fshex in paths:
            fail("phase output role or path was reused")
        expected_format = (
            native_format
            if output_kinds[item.role] == "executable"
            else FORMAT_REGULAR
        )
        planned = planned_outputs[item.role]
        planned_host_path = host_path_for_planned_fshex(
            state, planned["pathFshex"]
        )
        if (
            item.identity.artifact_format != expected_format
            or identity_host_path(item.identity) != planned_host_path
            or stat.S_IMODE(item.identity.mode) != planned["finalMode"]
            or item.identity.nlink != 1
        ):
            fail("phase output has the wrong platform format")
        frozen[item.role] = item.identity
        paths.add(item.identity.path_fshex)
    if spec.index == 15:
        validate_phase15_source_post_authority(state, terminal)
    if spec.index == 0:
        for source_role, snapshot_role in (
            ("bootstrap_source", "snapshot_bootstrap"),
            ("bootstrap_contract", "snapshot_contract"),
            ("bootstrap_manifest", "snapshot_bootstrap_manifest"),
            ("package_manifest", "snapshot_package_manifest"),
            ("t7_source", "snapshot_t7"),
        ):
            source = frozen[source_role]
            snapshot = frozen[snapshot_role]
            if (
                source.sha256 != snapshot.sha256
                or source.size != snapshot.size
            ):
                fail("phase zero source snapshot bytes drifted")
    terminal_sha = phase_terminal_sha256(terminal)
    post_directories, post_files = validate_closed_tree_transition(
        state=state,
        allowlist=allowlist,
        envelope=envelope,
        evidence=evidence,
        produced={
            item.role: item.identity for item in evidence.produced
        },
    )
    guest_paths = dict(state.guest_paths)
    if state.boundary.lane == LANE_LINUX:
        for item in terminal.produced:
            guest_paths[item.role] = linux_guest_path_for_host(
                state,
                identity_host_path(item.identity),
            )
    state = PhaseState(
        boundary=state.boundary,
        paths=state.paths,
        next_phase_index=state.next_phase_index + 1,
        frozen=frozen,
        guest_paths=guest_paths,
        terminals=(*state.terminals, terminal),
        terminal_sha256s=(*state.terminal_sha256s, terminal_sha),
        ledger_receipt_sha256s=(
            *state.ledger_receipt_sha256s,
            terminal.ledger_receipt_sha256,
        ),
        closed_tree_directories=post_directories,
        closed_tree_files=post_files,
        darwin_live_regular=state.darwin_live_regular,
        darwin_live_symlinks=state.darwin_live_symlinks,
    )
    return state


