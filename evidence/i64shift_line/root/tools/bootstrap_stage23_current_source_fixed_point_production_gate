            "observedExecutableCount": self.observed_executable_count,
            "predecessorTerminalSha256": self.predecessor_terminal_sha256,
            "produced": [
                {"role": item.role, "identity": item.identity.payload()}
                for item in self.produced
            ],
        }
        if self.command_action_receipts:
            if (
                self.command_role is not None
                or self.command_identity is not None
                or self.guard_report_sha256 is not None
                or self.actual_exit_code is not None
                or self.argv_sha256 is not None
                or self.guard_receipts_aggregate_sha256 is None
                or self.phase_command_actions_sha256 is None
                or not self.command_identities
                or len(self.actual_exit_codes)
                    != len(self.command_action_receipts)
                or len(self.command_identities)
                    != len(self.command_action_receipts)
                or self.guard_receipts_aggregate_sha256
                    != sha256_bytes(canonical_json(
                        self.command_action_receipts
                    ))
                or any(
                    identity["commandActionIndex"] != index
                    or receipt["commandActionIndex"] != index
                    or identity["targetExecutableRole"]
                        != receipt["targetExecutableRole"]
                    for index, (identity, receipt) in enumerate(zip(
                        self.command_identities,
                        self.command_action_receipts,
                    ))
                )
            ):
                fail("multi-action phase terminal retained singleton authority")
            common.update({
                "commandIdentities": list(self.command_identities),
                "commandActionReceipts":
                    list(self.command_action_receipts),
                "guardReceiptsAggregateSha256":
                    self.guard_receipts_aggregate_sha256,
                "actualExitCodes": list(self.actual_exit_codes),
                "phaseCommandActionsSha256":
                    self.phase_command_actions_sha256,
            })
        else:
            if (
                self.command_role is None
                or self.command_identity is None
                or self.guard_report_sha256 is None
                or self.actual_exit_code is None
                or self.argv_sha256 is None
                or self.command_identities
                or self.guard_receipts_aggregate_sha256 is not None
                or self.actual_exit_codes
                or self.phase_command_actions_sha256 is not None
            ):
                fail("single-command phase terminal authority drifted")
            common.update({
                "commandRole": self.command_role,
                "commandIdentity": self.command_identity.payload(),
                "guardReportSha256": self.guard_report_sha256,
                "actualExitCode": self.actual_exit_code,
                "argvSha256": self.argv_sha256,
            })
        return common


def canonical_guest_path(value: str, label: str) -> str:
    if (
        not isinstance(value, str)
        or not value.startswith("/")
        or "\0" in value
        or "\n" in value
        or "\r" in value
        or Path(value).parts in ((), ("/",))
        or ".." in Path(value).parts
        or str(Path(value)) != value
    ):
        fail(label + " is not a canonical absolute guest path")
    return value


def tree_guest_path(
    host_path: Path,
    host_root: Path,
    guest_root: str,
    label: str,
) -> str:
    try:
        relative = host_path.relative_to(host_root)
    except ValueError as exc:
        raise ProductionGateError(
            label + " is outside the bound host tree"
        ) from exc
    return canonical_guest_path(
        str(Path(guest_root) / relative),
        label + " guest path",
    )


