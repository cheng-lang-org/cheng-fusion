        "bootstrap_contract_sha256",
        "generated_c_portable_cid",
        "authority_verification_sha256",
        "authority_verification_report_sha256",
    ):
        canonical_sha256(rows[key], "portable authority receipt " + key)
    if not re.fullmatch(
        r"[0-9a-f]{16}", rows["self_check_contract_hash"]
    ):
        fail("portable authority receipt self-check hash drifted")
    return rows


def canonical_portable_report_bytes(
    values: Mapping[str, str],
    key_order: tuple[str, ...],
    terminal_key: str,
) -> bytes:
    expected = key_order[:-1]
    if tuple(values) != expected:
        fail("portable authority report fields drifted")
    prefix = "".join(
        key + "=" + values[key] + "\n" for key in expected
    ).encode("utf-8")
    return prefix + (
        terminal_key + "=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")


