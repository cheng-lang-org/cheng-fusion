    tuple[ProducedArtifact, ...],
    tuple[str, ...],
    dict[str, dict[str, Any]],
]:
    declared_rows = phase_closed_tree_declared_files(
        LANE_LINUX, envelope
    )
    declared = {
        item["relativePath"]: item for item in declared_rows
    }
    if len(declared) != len(declared_rows):
        fail("Linux phase declared file paths alias")
    observed_files, observed_directories = scan_evidence_tree(
        state.paths.evidence
    )
    if observed_files != set(state.closed_tree_files).union(declared):
        fail("Linux phase evidence file set is not the declared delta")
    expected_directories = set(state.closed_tree_directories).union(
        envelope["declaredDeltaDirectories"]
    )
    if observed_directories != expected_directories:
        fail("Linux phase evidence directory set is not exact")
    post_files: dict[str, dict[str, Any]] = {}
    for relative_path, old_row in state.closed_tree_files.items():
        observed, _raw = stable_closed_file(
            state.paths.evidence / relative_path,
            old_row["role"],
            relative_path,
        )
        if observed != old_row:
            fail("Linux phase changed sealed stage evidence")
        post_files[relative_path] = observed
    for relative_path, planned in declared.items():
        row, _raw = stable_closed_file(
            state.paths.evidence / relative_path,
            planned["role"],
            relative_path,
        )
        if row["mode"] != planned["finalMode"]:
            fail("Linux phase output mode drifted")
        post_files[relative_path] = row
    produced: list[ProducedArtifact] = []
    for planned in envelope["plannedOutputs"]:
        path = host_path_for_planned_fshex(
            state, planned["pathFshex"]
        )
        identity, _raw = stable_artifact(
            path, executable=planned["kind"] == "executable"
        )
        if (
            planned["kind"] == "executable"
            and identity.artifact_format != FORMAT_ELF64_X86_64
        ):
            fail("Linux business output is not native x86_64 ELF")
        produced.append(ProducedArtifact(planned["role"], identity))
    return (
        tuple(produced),
        tuple(sorted(expected_directories, key=os.fsencode)),
        post_files,
    )


def physical_linux_phase_raw_evidence(
    state: PhaseState,
    bundle: LinuxPhaseManifestBundle,
    cgroup_evidence_root: Path,
    authority: LinuxAuthorityInputs,
) -> PhaseRawEvidence:
    envelope = bundle.envelope
    if (
