    )


def next_phase_envelope(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
) -> dict[str, Any]:
    if state.next_phase_index >= len(PHASE_SPECS):
        fail("phase chain is complete")
    spec = PHASE_SPECS[state.next_phase_index]
    plan = phase_plan_for_state(state)
    required_executables = {"bash", "python"}
    if "commandActions" in plan:
        required_executables.update(
                role
                for action in plan["commandActions"]
                for role in (
                    action["launcherExecutableRole"],
                    action["targetExecutableRole"],
                )
        )
    elif spec.index != 10:
        required_executables.add(spec.command_role)
    required_executables.update(
        action["targetExecutableRole"]
        for action in plan.get("darwinCodesignActions", ())
    )
    if not required_executables.issubset(set(allowlist.roles)):
        fail("allowlist omits a required executable")
    bound_roles = phase_bound_roles(plan)
    if any(role in allowlist.roles for role in bound_roles):
        fail("path is both executable and bound input")
    try:
        bound = {
            role: state.frozen[role].payload() for role in bound_roles
        }
        command = (
            None
            if "commandActions" in plan
            else state.frozen[spec.command_role]
        )
    except KeyError as exc:
        raise ProductionGateError("phase input is not frozen") from exc
    executables, closure_sha = executable_entries(state, allowlist)
    command_actions = tuple(plan.get("commandActions", ()))
    command_argv = tuple(plan.get("argv", ()))
    command_action_trees = []
    for action in command_actions:
        tree_contract = action["privateFrozenTree"]
        root = Path(tree_contract["root"])
        base_tree = private_frozen_tree_binding(root)
        derived_input = tree_contract["derivedInput"]
        if (
            tree_contract.get("bindingMode") != "exact_prebound"
            or derived_input is not None
        ):
            fail("non-replayable command action tree derivation")
        command_action_trees.append({
            "commandActionIndex": action["commandActionIndex"],
            "bindingMode": "exact_prebound",
            "tree": base_tree,
            "derivedInput": None,
        })
    phase_plan_sha = sha256_bytes(canonical_json(plan))
    env = {
        item["name"]: item["value"] for item in plan["env"]
    }
    if len(env) != len(plan["env"]):
        fail("phase environment names are not unique")
    if state.boundary.lane == LANE_LINUX:
        runner_argv = (
            "/bin/bash",
            (
                "/cheng-stage23-source/repo/tools/"
                "bootstrap_stage23_current_source_fixed_point_gate.sh"
            ),
            "--run-phase-action",
            "--stage-input-manifest",
            "/cheng-stage23-control/stage-input-manifest.json",
            "--stage-plan-sha256",
            phase_plan_sha,
            "--evidence-dir",
            "/cheng-stage23-evidence",
        )
    else:
        runner_argv = (
            lane_role_path(state, "python"),
            "-I",
            "-S",
            "-B",
            lane_role_path(state, "phase_engine"),
            "--run-phase-action",
            "--stage-input-manifest",
            str(
                state.paths.evidence
                / darwin_stage_input_manifest_relative_path(
                    state.next_phase_index
                )
            ),
            "--stage-plan-sha256",
            phase_plan_sha,
            "--evidence-dir",
            str(state.paths.evidence),
        )
    interpreter_invocations = (
        *(
            ({
                "scriptRole": "stage_gate",
                "interpreterRole": "bash",
                "argv": list(runner_argv),
            },)
            if state.boundary.lane == LANE_LINUX else ()
        ),
        {
            "scriptRole": "phase_engine",
            "interpreterRole": "python",
            "argv": (
                list(runner_argv)
                if state.boundary.lane == LANE_DARWIN
                else [
                    lane_role_path(state, "python"),
                    "-I",
                    "-S",
                    "-B",
                    lane_role_path(state, "phase_engine"),
                ]
            ),
        },
        *(
            ({
                "scriptRole": "process_guard",
                "interpreterRole": "bash",
                "argv": [
                    lane_role_path(state, "bash"),
                    lane_role_path(state, "process_guard"),
                ],
            },)
            if spec.index != 10 else ()
        ),
    )
    envelope = {
        "schema": PHASE_ENVELOPE_SCHEMA,
        "lane": state.boundary.lane,
        "targetTriple": LANE_TARGET_TRIPLE[state.boundary.lane],
        "machineAuthority":
            LANE_MACHINE_AUTHORITY[state.boundary.lane],
        "nativeExecutableFormat":
            phase_engine.LANE_EXECUTABLE_FORMAT[state.boundary.lane],
        "phaseIndex": spec.index,
        "phaseLabel": spec.label,
        "phasePlan": plan,
        "phasePlanSha256": phase_plan_sha,
        **(
            {
                "darwinCodesignActions":
                    plan["darwinCodesignActions"],
            }
            if "darwinCodesignActions" in plan else {}
        ),
        **(
            {
                "phaseCommandActions": list(command_actions),
                "phaseCommandActionsSha256": sha256_bytes(
                    canonical_json(command_actions)
                ),
                "commandActionPrivateFrozenTrees":
                    command_action_trees,
            }
            if command_actions else {
                "phaseCommandArgv": list(command_argv),
                "phaseCommandArgvSha256":
                    guard_argv_sha256(command_argv),
            }
        ),
        "phaseEnv": [
            {"name": key, "value": env[key]} for key in sorted(env)
        ],
        "phaseEnvSha256": guard_env_sha256(env),
        "runnerArgv": list(runner_argv),
        "runnerArgvSha256": guard_argv_sha256(runner_argv),
        "interpreterInvocations": list(interpreter_invocations),
        "monitorRuntime": (
            None
            if spec.index == 10 else {
                "schema": "cheng.guard.monitor_runtime_binding",
                "scriptRole": "process_guard_runtime",
                "interpreterRole": "python",
                "loaderSourceRole": "process_guard",
                "startupFlags": ["-I", "-S", "-B"],
                "heldFd": 9,
                "expectedSha256":
                    state.frozen["process_guard_runtime"].sha256,
                "physicalIdentity": physical_identity_payload(
                    identity_host_path(
                        state.frozen["process_guard_runtime"]
                    )
                ),
            }
        ),
        "plannedOutputs": plan["outputs"],
        "phaseActions": plan["actions"],
        "terminalRelativePath": plan["terminalRelativePath"],
        "declaredDeltaDirectories":
            plan["declaredDeltaDirectories"],
        "declaredDeltaFiles": plan["declaredDeltaFiles"],
        "declaredOutputSetSha256":
            plan["declaredOutputSetSha256"],
        "boundary": state.boundary.payload(),
        **(
            {
                "commandIdentities": [
                    {
                        "commandActionIndex":
                            action["commandActionIndex"],
                        "targetExecutableRole":
                            action["targetExecutableRole"],
                        "identity": state.frozen[
                            action["targetExecutableRole"]
                        ].payload(),
                        "physicalIdentity": physical_identity_payload(
                            identity_host_path(state.frozen[
                                action["targetExecutableRole"]
                            ])
                        ),
                    }
                    for action in command_actions
                ],
            }
            if command_actions else {
                "commandRole": spec.command_role,
                "commandIdentity": command.payload(),
            }
        ),
        "executableClosureStatus": "FROZEN_EXACT_TRANSITIVE",
        "executableClosureSha256": closure_sha,
        "executableCount": len(executables),
        "executables": executables,
        "boundArgvFiles": [
            {"role": role, "identity": bound[role]}
            for role in sorted(bound)
        ],
        "predecessorTerminalSha256": (
            state.terminal_sha256s[-1]
            if state.terminal_sha256s else ZERO_SHA256
        ),
    }
    if command_actions:
        for action in command_actions:
            target_role = action["targetExecutableRole"]
            if (
                action["targetArgv"][0]
                    != lane_role_path(state, target_role)
                or action["targetArgvSha256"]
                    != guard_argv_sha256(action["targetArgv"])
                or action["launcherExecutableRole"] != "bash"
                or action["guardScriptRole"] != "process_guard"
                or action["monitorRuntimeRole"]
                    != "process_guard_runtime"
            ):
                fail("multi-action executable identity binding drifted")
    return envelope


def guest_manifest_entry(
    identity: ArtifactIdentity,
    guest_path: str,
) -> dict[str, Any]:
    guest_path = canonical_guest_path(guest_path, "manifest guest path")
    return {
        "pathFshex": os.fsencode(guest_path).hex(),
        "sha256": identity.sha256,
        "device": identity.device,
        "inode": identity.inode,
        "size": identity.size,
        "mode": identity.mode,
        "uid": 1,
        "gid": 1,
    }


def stage_input_manifest_raw(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
) -> bytes:
    envelope = next_phase_envelope(state, allowlist)
    return stage_input_manifest_raw_from_envelope(state, envelope)


def stage_input_manifest_raw_from_envelope(
    state: PhaseState,
    envelope: Mapping[str, Any],
) -> bytes:
    frozen_roles = []
    for role in sorted(state.frozen):
        identity = state.frozen[role]
        frozen_roles.append({
            "role": role,
            "hostIdentity": identity.payload(),
            "guestPath": (
                state.guest_paths[role]
                if state.boundary.lane == LANE_LINUX else None
            ),
        })
    payload = {
        "schema": STAGE_INPUT_MANIFEST_SCHEMA,
        "lane": state.boundary.lane,
        "targetTriple": LANE_TARGET_TRIPLE[state.boundary.lane],
        "machineAuthority":
            LANE_MACHINE_AUTHORITY[state.boundary.lane],
        "phaseIndex": state.next_phase_index,
        "phaseLabel": PHASE_SPECS[state.next_phase_index].label,
        "phasePlan": envelope["phasePlan"],
        "phasePlanSha256": envelope["phasePlanSha256"],
        **(
            {
                "phaseCommandActions":
                    envelope["phaseCommandActions"],
                "phaseCommandActionsSha256":
                    envelope["phaseCommandActionsSha256"],
                "commandIdentities":
                    envelope["commandIdentities"],
                "commandActionPrivateFrozenTrees":
                    envelope["commandActionPrivateFrozenTrees"],
            }
            if "phaseCommandActions" in envelope else {
                "phaseCommandArgv": envelope["phaseCommandArgv"],
                "phaseCommandArgvSha256":
                    envelope["phaseCommandArgvSha256"],
            }
        ),
        "phaseEnv": envelope["phaseEnv"],
        "phaseEnvSha256": envelope["phaseEnvSha256"],
        "runnerArgv": envelope["runnerArgv"],
        "runnerArgvSha256": envelope["runnerArgvSha256"],
        "phaseActions": envelope["phaseActions"],
        "plannedOutputs": envelope["plannedOutputs"],
        "terminalRelativePath": envelope["terminalRelativePath"],
        "declaredDeltaDirectories":
            envelope["declaredDeltaDirectories"],
        "declaredDeltaFiles": envelope["declaredDeltaFiles"],
        "declaredOutputSetSha256":
            envelope["declaredOutputSetSha256"],
        "frozenRoles": frozen_roles,
        "nativeExecutableClosure":
            envelope["executables"],
        "nativeExecutableClosureSha256":
            envelope["executableClosureSha256"],
        "boundScripts": envelope["boundArgvFiles"],
        "monitorRuntime": envelope["monitorRuntime"],
    }
    if set(payload) != set(stage_input_manifest_fields(
        state.boundary.lane, state.next_phase_index
    )):
        fail("stage input manifest field set drifted")
    return canonical_json(payload) + b"\n"


@dataclass(frozen=True)
class LinuxPhaseManifestBundle:
    phase_state: PhaseState
    allowlist: PhaseExecutableAllowlist
    envelope: dict[str, Any]
    envelope_sha256: str
    authority_manifest: Path
    execution_manifest: Path
    manifest_pair_commitment: Path
    authority_identity: ArtifactIdentity
    execution_identity: ArtifactIdentity
    pair_identity: ArtifactIdentity
    binding: Any


LINUX_EXTERNAL_PHASE_PROOF_ROLES = frozenset({
    "phase_ptrace_manifest",
    "phase_ptrace_receipt",
    "phase_ptrace_validation",
    "phase_cgroup_receipt",
})


def phase_closed_tree_declared_files(
    lane: str,
    envelope: Mapping[str, Any],
) -> tuple[dict[str, Any], ...]:
    return tuple(
        item for item in envelope["declaredDeltaFiles"]
        if (
            lane != LANE_LINUX
            or item["role"] not in LINUX_EXTERNAL_PHASE_PROOF_ROLES
        )
    )


def linux_stage23_stable_file(
    role: str,
    identity: ArtifactIdentity,
) -> Any:
    path = identity_host_path(identity)
    file = linux_cgroup_validator.stable_read(
        path,
        "Linux stage23 frozen role " + role,
        2 * 1024 * 1024 * 1024,
    )
    if (
        file.sha256 != identity.sha256
        or file.device != identity.device
        or file.inode != identity.inode
        or file.size != identity.size
        or file.mode != identity.mode
        or file.uid != identity.uid
        or file.gid != identity.gid
    ):
        fail("Linux stage23 frozen role identity drifted: " + role)
    return file


def linux_stage23_frozen_rows(state: PhaseState) -> list[dict[str, Any]]:
    if state.boundary.lane != LANE_LINUX:
        fail("Linux frozen rows requested for another lane")
    rows = []
    for role in sorted(state.frozen):
        identity = state.frozen[role]
        file = linux_stage23_stable_file(role, identity)
        rows.append({
            "role": role,
            "kind": (
                "bound_argv_file"
                if identity.artifact_format == FORMAT_REGULAR
                else "executable"
            ),
            "pathFshex": os.fsencode(str(file.path)).hex(),
            "guestPath": state.guest_paths[role],
            "sha256": file.sha256,
            "device": file.device,
            "inode": file.inode,
            "size": file.size,
            "mode": file.mode,
            "uid": file.uid,
            "gid": file.gid,
            "mtimeNs": file.mtime_ns,
            "ctimeNs": file.ctime_ns,
        })
    return rows


def linux_stage23_source_members(
    state: PhaseState,
) -> list[dict[str, Any]]:
    by_relative: dict[str, dict[str, Any]] = {}
    for role, identity in state.frozen.items():
        path = identity_host_path(identity)
        try:
            relative = path.relative_to(state.paths.root).as_posix()
        except ValueError:
            continue
        file = linux_stage23_stable_file(role, identity)
        row = {
            "path": relative,
            "sha256": file.sha256,
            "device": file.device,
            "inode": file.inode,
            "size": file.size,
            "mode": file.mode,
            "uid": file.uid,
            "gid": file.gid,
            "mtimeNs": file.mtime_ns,
            "ctimeNs": file.ctime_ns,
        }
        previous = by_relative.get(relative)
        if previous is not None and previous != row:
            fail("Linux source member path has two identities")
        by_relative[relative] = row
    if not by_relative:
        fail("Linux source member closure is empty")
    return [
        by_relative[path]
        for path in sorted(by_relative, key=os.fsencode)
    ]


def linux_stage23_expected_files(
    envelope: Mapping[str, Any],
) -> list[dict[str, Any]]:
    terminal = envelope["terminalRelativePath"]
    rows = [
        {
            "role": item["role"],
            "relativePath": item["relativePath"],
            "kind": item["kind"],
            "mode": item["finalMode"],
        }
        for item in phase_closed_tree_declared_files(
            LANE_LINUX, envelope
        )
        if item["relativePath"] != terminal
    ]
    rows.sort(key=lambda item: item["role"])
    if (
        len(rows) != len({item["role"] for item in rows})
        or any(
            item["role"] not in {row["role"] for row in rows}
            for item in envelope["plannedOutputs"]
        )
    ):
        fail("Linux declared phase file roles are not exact")
    return rows


def linux_stage23_authority_core(
    state: PhaseState,
    envelope: Mapping[str, Any],
    authority: LinuxAuthorityInputs,
    rootfs_binding: Any,
    delegation_binding: Any,
    crun_file: Any,
) -> dict[str, Any]:
    directories = list(envelope["declaredDeltaDirectories"])
    if directories != sorted(directories, key=os.fsencode):
        fail("Linux declared phase directories are not canonical")
    if (
        delegation_binding.file.raw != authority.delegation_raw
        or delegation_binding.file.path != authority.delegation_manifest
        or delegation_binding.parent != authority.cgroup_parent
        or crun_file.path != authority.crun
        or crun_file.sha256 != authority.crun_identity.sha256
        or rootfs_binding.file.raw != authority.rootfs_manifest_raw
        or rootfs_binding.file.path != authority.rootfs_manifest
        or rootfs_binding.rootfs != authority.rootfs
        or rootfs_binding.tree_cid != authority.rootfs_tree_cid
    ):
        fail("Linux cgroup authority inputs changed before phase binding")
    parent_binding = linux_cgroup_validator.stage23_directory_binding(
        authority.cgroup_parent
    )
    leaf = authority.boundary.cgroup_leaf
    if (
        leaf is None
        or parent_binding["device"] != leaf.parent_device
        or parent_binding["inode"] != leaf.parent_inode
    ):
        fail("Linux cgroup parent identity changed before phase binding")
    return {
        "schema": linux_cgroup_validator.STAGE23_AUTHORITY_SCHEMA,
        "lane": LANE_LINUX,
        "phaseIndex": state.next_phase_index,
        "phaseLabel": PHASE_SPECS[state.next_phase_index].label,
        "phasePlanSha256": envelope["phasePlanSha256"],
        "phasePlan": envelope["phasePlan"],
        "sourceRootPathFshex": os.fsencode(str(state.paths.root)).hex(),
        "stageEvidencePathFshex":
            os.fsencode(str(state.paths.evidence)).hex(),
        "sourceMembers": linux_stage23_source_members(state),
        "frozenRoles": linux_stage23_frozen_rows(state),
        "actionArgv": list(envelope["runnerArgv"]),
        "actionEnv": list(linux_cgroup_validator.STAGE23_TARGET_ENV),
        "actionTimeoutSeconds":
            PHASE_SPECS[state.next_phase_index].timeout_seconds,
        "expectedNewDirectories": directories,
        "expectedNewFiles": linux_stage23_expected_files(envelope),
        "terminalRelativePath": envelope["terminalRelativePath"],
        "delegationManifest":
            linux_cgroup_validator.stage23_file_binding(
                delegation_binding.file
            ),
        "cgroupParent": parent_binding,
        "crun": linux_cgroup_validator.stage23_file_binding(crun_file),
        "rootfsManifest":
            linux_cgroup_validator.stage23_file_binding(
                rootfs_binding.file
            ),
        "rootfsPathFshex": os.fsencode(str(authority.rootfs)).hex(),
        "rootfsTreeCid": authority.rootfs_tree_cid,
    }


def linux_phase_state_with_pair_commitment(
    state: PhaseState,
    pair_identity: ArtifactIdentity,
) -> PhaseState:
    role = linux_cgroup_validator.STAGE23_MANIFEST_PAIR_ROLE
    if role in state.frozen or pair_identity.path_fshex in {
        item.path_fshex for item in state.frozen.values()
    }:
        fail("Linux phase pair commitment identity was reused")
    return replace(
        state,
        frozen={**state.frozen, role: pair_identity},
        guest_paths={
            **state.guest_paths,
            role: linux_cgroup_validator.STAGE23_MANIFEST_PAIR_GUEST_PATH,
        },
    )


def linux_phase_state_without_pair_commitment(
    state: PhaseState,
) -> PhaseState:
    role = linux_cgroup_validator.STAGE23_MANIFEST_PAIR_ROLE
    if role not in state.frozen or role not in state.guest_paths:
        fail("Linux phase pair commitment is absent")
    frozen = dict(state.frozen)
    guest_paths = dict(state.guest_paths)
    del frozen[role]
    del guest_paths[role]
    return replace(state, frozen=frozen, guest_paths=guest_paths)


def prepare_linux_phase_manifest_bundle(
    state: PhaseState,
    authority: LinuxAuthorityInputs,
    rootfs_binding: Any,
) -> LinuxPhaseManifestBundle:
    if state.boundary.lane != LANE_LINUX:
        fail("Linux phase manifest requested for another lane")
    delegation_binding = (
        linux_cgroup_validator.parse_delegation_manifest(
            authority.delegation_manifest,
            require_root_owner=True,
        )
    )
    linux_cgroup_validator.validate_live_delegation(
        delegation_binding, authority.cgroup_parent
    )
    crun_file = linux_cgroup_validator.stable_read(
        authority.crun, "Linux phase crun", 256 * 1024 * 1024
    )
    linux_cgroup_validator.require_unprivileged_executable(
        crun_file, "Linux phase crun"
    )
    return build_linux_phase_manifest_bundle_from_validated_authority(
        state,
        authority,
        rootfs_binding,
        delegation_binding,
        crun_file,
    )


def build_linux_phase_manifest_bundle_from_validated_authority(
    state: PhaseState,
    authority: LinuxAuthorityInputs,
    rootfs_binding: Any,
    delegation_binding: Any,
    crun_file: Any,
) -> LinuxPhaseManifestBundle:
    if state.boundary.lane != LANE_LINUX:
        fail("Linux validated manifest requested for another lane")
    allowlist = linux_phase_allowlist(state)
    core_envelope = next_phase_envelope(state, allowlist)
    execution_core_raw = stage_input_manifest_raw_from_envelope(
        state, core_envelope
    )
    execution_core = strict_canonical_json(
        execution_core_raw[:-1], "Linux phase execution core"
    )
    authority_core = linux_stage23_authority_core(
        state,
        core_envelope,
        authority,
        rootfs_binding,
        delegation_binding,
        crun_file,
    )
    authority_core_sha = sha256_bytes(canonical_json(authority_core))
    execution_core_sha = sha256_bytes(canonical_json(execution_core))
    pair_value = {
        "schema": linux_cgroup_validator.STAGE23_MANIFEST_PAIR_SCHEMA,
        "authorityCoreSha256": authority_core_sha,
        "executionCoreSha256": execution_core_sha,
        "pairSha256": linux_cgroup_validator.stage23_manifest_pair_sha256(
            authority_core_sha, execution_core_sha
        ),
    }
    lane_root = state.paths.evidence.parent
    phase_inputs_root = exact_existing_private_directory(
        lane_root / "phase-inputs"
    )
    phase_directory = create_exclusive_private_child_directory(
        phase_inputs_root, f"phase-{state.next_phase_index:02d}"
    )
    pair_path = phase_directory / "manifest-pair-commitment.json"
    pair_identity = publish_exclusive_regular(
        phase_directory,
        pair_path.name,
        canonical_json(pair_value) + b"\n",
    )
    phase_state = linux_phase_state_with_pair_commitment(
        state, pair_identity
    )
    envelope = next_phase_envelope(phase_state, allowlist)
    if (
        envelope["phasePlan"] != core_envelope["phasePlan"]
        or envelope["runnerArgv"] != core_envelope["runnerArgv"]
        or envelope["executableClosureSha256"]
            != core_envelope["executableClosureSha256"]
    ):
        fail("Linux pair commitment changed executable phase semantics")
    execution_raw = stage_input_manifest_raw_from_envelope(
        phase_state, envelope
    )
    execution_path = phase_directory / "phase-execution-manifest.json"
    execution_identity = publish_exclusive_regular(
        phase_directory, execution_path.name, execution_raw
    )
    authority_value = dict(authority_core)
    authority_value["frozenRoles"] = linux_stage23_frozen_rows(
        phase_state
    )
    execution_file = linux_cgroup_validator.stable_read(
        execution_path, "Linux phase execution manifest", 256 * 1024 * 1024
    )
    pair_file = linux_cgroup_validator.stable_read(
        pair_path, "Linux phase pair commitment", 64 * 1024
    )
    authority_value["phaseExecutionManifest"] = (
        linux_cgroup_validator.stage23_file_binding(execution_file)
    )
    authority_value["manifestPairCommitment"] = (
        linux_cgroup_validator.stage23_file_binding(pair_file)
    )
    authority_path = phase_directory / "phase-authority-manifest.json"
    authority_identity = publish_exclusive_regular(
        phase_directory,
        authority_path.name,
        canonical_json(authority_value) + b"\n",
    )
    binding = linux_cgroup_validator.validate_stage23_phase_binding(
        authority_path,
        execution_path,
        pair_path,
        envelope["phasePlanSha256"],
        rootfs_binding,
        delegation_binding,
        crun_file,
    )
    if (
        binding.authority_manifest.sha256 != authority_identity.sha256
        or binding.execution_manifest.sha256 != execution_identity.sha256
        or binding.manifest_pair_commitment.sha256 != pair_identity.sha256
        or binding.phase_index != state.next_phase_index
        or binding.action_argv != tuple(envelope["runnerArgv"])
    ):
        fail("Linux phase manifest bundle validator result drifted")
    return LinuxPhaseManifestBundle(
        phase_state=phase_state,
        allowlist=allowlist,
        envelope=envelope,
        envelope_sha256=sha256_bytes(canonical_json(envelope)),
        authority_manifest=authority_path,
        execution_manifest=execution_path,
        manifest_pair_commitment=pair_path,
        authority_identity=authority_identity,
        execution_identity=execution_identity,
        pair_identity=pair_identity,
        binding=binding,
    )


def validate_frozen_phase_envelope(
    state: PhaseState,
    frozen_envelope: dict[str, Any],
    frozen_envelope_sha256: str,
) -> dict[str, Any]:
    if not isinstance(frozen_envelope, dict):
        fail("frozen phase envelope is not an exact object")
    observed_sha256 = sha256_bytes(canonical_json(frozen_envelope))
    if (
        canonical_sha256(
            frozen_envelope_sha256,
            "frozen phase envelope",
        ) != observed_sha256
    ):
        fail("frozen phase envelope changed after pre-state capture")
    if state.next_phase_index >= len(PHASE_SPECS):
        fail("frozen phase envelope is outside the phase chain")
    spec = PHASE_SPECS[state.next_phase_index]
    predecessor = (
        state.terminal_sha256s[-1]
        if state.terminal_sha256s else ZERO_SHA256
    )
    if (
        frozen_envelope.get("schema") != PHASE_ENVELOPE_SCHEMA
        or frozen_envelope.get("lane") != state.boundary.lane
        or frozen_envelope.get("targetTriple")
            != LANE_TARGET_TRIPLE[state.boundary.lane]
        or frozen_envelope.get("machineAuthority")
            != LANE_MACHINE_AUTHORITY[state.boundary.lane]
        or frozen_envelope.get("phaseIndex") != spec.index
        or frozen_envelope.get("phaseLabel") != spec.label
        or frozen_envelope.get("boundary") != state.boundary.payload()
        or frozen_envelope.get("predecessorTerminalSha256")
            != predecessor
    ):
        fail("frozen phase envelope is not bound to the pre-state")
    return frozen_envelope


def linux_ptrace_manifest_from_envelope(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    envelope: Mapping[str, Any],
    stage_input_identity: ArtifactIdentity,
) -> dict[str, Any]:
    if state.boundary.lane != LANE_LINUX:
        fail("ptrace manifest requested for non-Linux lane")
    spec = PHASE_SPECS[state.next_phase_index]
    if (
        envelope.get("phaseIndex") != spec.index
        or envelope.get("phaseLabel") != spec.label
    ):
        fail("ptrace manifest envelope is not the current pre-state")
    expected_stage_input_path = (
        state.paths.evidence.parent
        / "phase-inputs"
        / f"phase-{state.next_phase_index:02d}"
        / "phase-execution-manifest.json"
    )
    if (
        stage_input_identity.path_fshex
            != os.fsencode(str(expected_stage_input_path)).hex()
        or stage_input_identity.sha256
            != sha256_bytes(stage_input_manifest_raw_from_envelope(
                state, envelope
            ))
        or stage_input_identity.artifact_format != FORMAT_REGULAR
        or stat.S_IMODE(stage_input_identity.mode) != 0o400
    ):
        fail("stage input manifest identity is not exact")
    bound_roles = phase_bound_roles(envelope["phasePlan"])
    bound_entries = [
        guest_manifest_entry(
            state.frozen[role],
            state.guest_paths[role],
        )
        for role in bound_roles
    ]
    if any(
        role in bound_roles
        for role in LINUX_ROOTFS_IMMUTABLE_ARGV_ROLES
    ):
        fail("rootfs immutable argv leaked into phase business inputs")
    for role in LINUX_ROOTFS_IMMUTABLE_ARGV_ROLES:
        identity = state.frozen.get(role)
        guest_path = state.guest_paths.get(role)
        if identity is None or guest_path != expected_linux_guest_path(role):
            fail("rootfs immutable argv authority is absent")
        bound_entries.append(guest_manifest_entry(identity, guest_path))
    bound_entries.append(guest_manifest_entry(
        stage_input_identity,
        "/cheng-stage23-control/stage-input-manifest.json",
    ))
    pair_role = linux_cgroup_validator.STAGE23_MANIFEST_PAIR_ROLE
    pair_identity = state.frozen.get(pair_role)
    pair_guest_path = state.guest_paths.get(pair_role)
    if pair_identity is None or pair_guest_path != (
        linux_cgroup_validator.STAGE23_MANIFEST_PAIR_GUEST_PATH
    ):
        fail("Linux ptrace manifest pair authority is absent")
    if pair_role not in bound_roles:
        bound_entries.append(guest_manifest_entry(
            pair_identity,
            pair_guest_path,
        ))
    command_actions = [
        action
        for action in envelope["phaseActions"]
        if action.get("kind") == "command"
    ]
    if not command_actions and spec.index == 10:
        business_roles = []
    elif len(command_actions) == 1:
        business_roles = command_actions[0].get("businessOutputRoles")
    else:
        fail("Linux ptrace manifest command action is not unique")
    planned_by_role = {
        item["role"]: item
        for item in envelope["plannedOutputs"]
    }
    if (
        not isinstance(business_roles, list)
        or len(set(business_roles)) != len(business_roles)
        or any(role not in planned_by_role for role in business_roles)
    ):
        fail("Linux ptrace mutable output roles are not exact")
    mutable_outputs = sorted(
        (planned_by_role[role]["pathFshex"] for role in business_roles)
    )
    return {
        "schema": "cheng.linux_ptrace_exec_manifest",
        "executables": sorted(
            (
                guest_manifest_entry(
                    state.frozen[role],
                    state.guest_paths[role],
                )
                for role in allowlist.roles
            ),
            key=lambda item: item["pathFshex"],
        ),
        "boundArgvFiles": sorted(
            bound_entries,
            key=lambda item: item["pathFshex"],
        ),
        "dynamicArgvUid": 1,
        "dynamicArgvGid": 1,
        "generatedArgvDirectoryPathFshex": os.fsencode(
            phase_engine.LINUX_GENERATED_ARGV_DIRECTORY
        ).hex(),
        "mutableOutputPathFshexes": mutable_outputs,
    }


