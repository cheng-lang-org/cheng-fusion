    }
    frozen_cold_identity, frozen_cold_raw = stable_artifact(
        role_paths["bootstrap_source"], executable=False
    )
    cc = role_paths["cc"]
    (
        clang_snapshot,
        linker_snapshot,
        live_regular,
        live_symlinks,
        discovery_identities,
    ) = materialize_darwin_toolchain_snapshot(
        evidence,
        cc,
        frozen_cold_raw,
    )
    role_paths["cc"] = clang_snapshot
    role_paths["darwin_ld"] = linker_snapshot
    identities: dict[str, ArtifactIdentity] = {
        role: stable_artifact(
            path,
            executable=(
                role in STATIC_EXECUTABLE_ROLES
                or is_darwin_frozen_executable_role(role)
            ),
        )[0]
        for role, path in role_paths.items()
    }
    identities.update(discovery_identities)
    if identities["bootstrap_source"] != frozen_cold_identity:
        fail("frozen cold source changed during toolchain capture")
    paths = phase_engine.PhasePaths(
        ROOT,
        evidence,
        role_paths["cc"],
    )
    for index, path in enumerate(
        phase_engine.local_c_source_closure(paths)
    ):
        identities[f"local_c_header_{index:04d}"] = stable_artifact(
            path, executable=False
        )[0]
    identities["transitive_0000"] = stable_artifact(
        Path("/bin/sh"), executable=True
    )[0]
    occupied_paths = {
        identity.path_fshex for identity in identities.values()
    }
    toolchain_paths = phase_engine.darwin_toolchain_regular_files(paths)
    for toolchain_index, path in enumerate(toolchain_paths):
        identity = stable_artifact(path, executable=False)[0]
        if identity.path_fshex in occupied_paths:
            fail("Darwin toolchain snapshot role path aliases")
        identities[
            f"darwin_toolchain_input_{toolchain_index:04d}"
        ] = identity
        occupied_paths.add(identity.path_fshex)
    state = initial_phase_state(
        LaneBoundary(
            LANE_DARWIN,
            DARWIN_MEMORY_PROOF,
            None,
        ),
        paths,
        identities,
    )
    baseline_files: dict[str, dict[str, Any]] = {}
    baseline_roles = {
        str(linker_snapshot.relative_to(evidence)): "darwin_ld",
        str(clang_snapshot.relative_to(evidence)): "cc",
    }
    baseline_roles.update({
        str(identity_host_path(identity).relative_to(evidence)): role
        for role, identity in discovery_identities.items()
    })
    baseline_roles.update({
        str(path.relative_to(evidence)):
            f"darwin_toolchain_input_{index:04d}"
        for index, path in enumerate(toolchain_paths)
    })
    for relative_path, role in baseline_roles.items():
        row, _raw = stable_closed_file(
            evidence / relative_path, role, relative_path
        )
        baseline_files[relative_path] = row
    baseline_directories = tuple(sorted({
        str(parent)
        for relative_path in baseline_files
        for parent in Path(relative_path).parents
        if str(parent) != "."
    }, key=os.fsencode))
    state = PhaseState(
        boundary=state.boundary,
        paths=state.paths,
        next_phase_index=state.next_phase_index,
        frozen=state.frozen,
        guest_paths=state.guest_paths,
        terminals=state.terminals,
        terminal_sha256s=state.terminal_sha256s,
        ledger_receipt_sha256s=state.ledger_receipt_sha256s,
        closed_tree_directories=baseline_directories,
        closed_tree_files=baseline_files,
        darwin_live_regular=live_regular,
        darwin_live_symlinks=live_symlinks,
    )
    return materialize_darwin_phase0_action_inputs(state)


def closed_tree_bytes(
    directories: Sequence[str],
    files: Mapping[str, Mapping[str, Any]],
) -> bytes:
    return canonical_json({
        "schema": CLOSED_EVIDENCE_TREE_SCHEMA,
        "directories": list(directories),
        "files": [
            files[path] for path in sorted(files, key=os.fsencode)
        ],
    }) + b"\n"


def stable_closed_file(
    path: Path,
    role: str,
    relative_path: str,
) -> tuple[dict[str, Any], bytes]:
    info, raw = phase_engine.read_exact_regular(
        path, "closed evidence file"
    )
    row = {
        "role": role,
        "relativePath": relative_path,
        "sha256": sha256_bytes(raw),
        "device": info.st_dev,
        "inode": info.st_ino,
        "size": info.st_size,
        "mode": stat.S_IMODE(info.st_mode),
    }
    if (
        info.st_nlink != 1
        or row["mode"] not in (0o400, 0o444, 0o500, 0o555)
    ):
        fail("closed evidence file mode or link count drifted")
    return row, raw


def scan_evidence_tree(
    root: Path,
) -> tuple[set[str], set[str]]:
    files: set[str] = set()
    directories: set[str] = set()
    for current, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        current_path = Path(current)
        for name in directory_names:
            path = current_path / name
            if path.is_symlink():
                fail("Darwin evidence contains a symlink directory")
            directories.add(str(path.relative_to(root)))
        for name in file_names:
            path = current_path / name
            if path.is_symlink() or not path.is_file():
                fail("Darwin evidence contains a non-regular file")
            files.add(str(path.relative_to(root)))
    return files, directories


def verify_closed_tree_files_on_disk(
    state: PhaseState,
) -> None:
    observed_files, observed_directories = scan_evidence_tree(
        state.paths.evidence
    )
    expected_files = set(state.closed_tree_files)
    expected_directories = set(state.closed_tree_directories)
    if (
        observed_files != expected_files
        or observed_directories != expected_directories
    ):
        fail("Darwin pre-action evidence tree is not exact")
    physical: set[tuple[int, int]] = set()
    for relative_path, row in state.closed_tree_files.items():
        path = state.paths.evidence / relative_path
        observed, _raw = stable_closed_file(
            path, row["role"], relative_path
        )
        if (
            observed != row
            or (row["device"], row["inode"]) in physical
        ):
            fail("completed closed-tree file drifted on disk")
        physical.add((row["device"], row["inode"]))


def observed_darwin_phase_tree(
    state: PhaseState,
    envelope: Mapping[str, Any],
) -> tuple[
    tuple[ProducedArtifact, ...],
    tuple[str, ...],
    dict[str, dict[str, Any]],
]:
    declared = {
        item["relativePath"]: item
        for item in envelope["declaredDeltaFiles"]
    }
    if len(declared) != len(envelope["declaredDeltaFiles"]):
        fail("Darwin phase declared file paths alias")
    expected_closed_paths = set(state.closed_tree_files).union(declared)
    observed_files, observed_directories = scan_evidence_tree(
        state.paths.evidence
    )
    if observed_files != expected_closed_paths:
        fail("Darwin phase evidence file set is not the declared delta")
    expected_directories = set(state.closed_tree_directories).union(
        envelope["declaredDeltaDirectories"],
    )
    if observed_directories != expected_directories:
        fail("Darwin phase evidence directory set is not exact")
    post_directories = tuple(sorted(
        expected_directories,
        key=os.fsencode,
    ))
    post_files: dict[str, dict[str, Any]] = {}
    for relative_path, old_row in state.closed_tree_files.items():
        observed, _raw = stable_closed_file(
            state.paths.evidence / relative_path,
            old_row["role"],
            relative_path,
        )
        if observed != old_row:
            fail("Darwin post-action changed an existing closed file")
        post_files[relative_path] = observed
    planned_business_paths = {
        str(host_path_for_planned_fshex(
            state, item["pathFshex"]
        ).relative_to(state.paths.evidence)): item
        for item in envelope["plannedOutputs"]
    }
    for relative_path, planned in declared.items():
        path = state.paths.evidence / relative_path
        row, raw = stable_closed_file(
            path, planned["role"], relative_path
        )
        business = planned_business_paths.get(relative_path)
        if business is not None:
            identity, _business_raw = stable_artifact(
                path,
                executable=business["kind"] == "executable",
            )
            if (
                identity.sha256 != row["sha256"]
                or identity.device != row["device"]
                or identity.inode != row["inode"]
                or identity.size != row["size"]
            ):
                fail("Darwin business output identity drifted")
        elif raw and planned["role"] in {
            "phase_action_stderr",
            "phase_guard_stderr",
        }:
            fail("Darwin auxiliary stderr is not empty")
        if (
            row["mode"] != planned["finalMode"]
        ):
            fail("Darwin phase output mode or link count drifted")
        post_files[relative_path] = row
    planned_outputs = {
        item["role"]: item for item in envelope["plannedOutputs"]
    }
    produced: list[ProducedArtifact] = []
    for role in (
        item["role"] for item in envelope["plannedOutputs"]
    ):
        planned = planned_outputs[role]
        path = host_path_for_planned_fshex(
            state, planned["pathFshex"]
        )
        identity, raw = stable_artifact(
            path,
            executable=planned["kind"] == "executable",
        )
        if planned["kind"] == "executable":
            validate_darwin_macho_code_signature(raw, role)
        produced.append(ProducedArtifact(role, identity))
    validate_darwin_codesign_guard_receipts(
        state,
        envelope,
        {item.role: item.identity for item in produced},
    )
    return tuple(produced), post_directories, post_files


def prepare_darwin_phase_receipt_directory(
    state: PhaseState,
) -> Path:
    parent = state.paths.evidence / "phase-receipts"
    if state.next_phase_index == 0:
        parent = create_exclusive_private_child_directory(
            state.paths.evidence, "phase-receipts"
        )
    else:
        exact_existing_private_directory(parent)
    return create_exclusive_private_child_directory(
        parent, f"{state.next_phase_index:02d}"
    )


def phase_state_with_closed_file(
    state: PhaseState,
    path: Path,
    role: str,
) -> PhaseState:
    try:
        relative_path = str(path.relative_to(state.paths.evidence))
    except ValueError as exc:
        raise ProductionGateError(
            "new closed file escaped lane evidence"
        ) from exc
    if relative_path in state.closed_tree_files:
        fail("new closed file path was already sealed")
    row, _raw = stable_closed_file(path, role, relative_path)
    if (row["device"], row["inode"]) in {
        (item["device"], item["inode"])
        for item in state.closed_tree_files.values()
    }:
        fail("new closed file physically aliases sealed evidence")
    directories = set(state.closed_tree_directories)
    for parent in Path(relative_path).parents:
        parent_text = str(parent)
        if parent_text == ".":
            break
        directories.add(parent_text)
    files = dict(state.closed_tree_files)
    files[relative_path] = row
    return PhaseState(
        boundary=state.boundary,
        paths=state.paths,
        next_phase_index=state.next_phase_index,
        frozen=state.frozen,
        guest_paths=state.guest_paths,
        terminals=state.terminals,
        terminal_sha256s=state.terminal_sha256s,
        ledger_receipt_sha256s=state.ledger_receipt_sha256s,
        closed_tree_directories=tuple(sorted(
            directories, key=os.fsencode
        )),
        closed_tree_files=files,
        darwin_live_regular=state.darwin_live_regular,
        darwin_live_symlinks=state.darwin_live_symlinks,
    )


def persist_outer_phase_terminal(state: PhaseState) -> PhaseState:
    if (
        state.next_phase_index <= 0
        or state.next_phase_index > len(PHASE_SPECS)
        or len(state.terminals) != state.next_phase_index
    ):
        fail("outer phase terminal lacks advanced-state authority")
    terminal = state.terminals[-1]
    phase_index = state.next_phase_index - 1
    if terminal.phase_index != phase_index:
        fail("outer phase terminal index drifted")
    receipt_dir = (
        state.paths.evidence
        / "phase-receipts"
        / f"{phase_index:02d}"
    )
    raw = outer_phase_terminal_bytes(terminal)
    identity = publish_exclusive_regular(
        receipt_dir, "outer-terminal.json", raw
    )
    if (
        identity.sha256 != sha256_bytes(raw)
        or parse_outer_phase_terminal_bytes(raw) != terminal
    ):
        fail("outer phase terminal publication drifted")
    return phase_state_with_closed_file(
        state,
        receipt_dir / "outer-terminal.json",
        "outer_phase_terminal",
    )


