            or rows["monitor_python_sha256"]
                != monitor_python_identity.sha256
            or rows["monitor_runtime_script_sha256"]
                != state.frozen["process_guard_runtime"].sha256
            or rows["monitor_runtime_script_stage_expected_sha256"]
                != state.frozen["process_guard_runtime"].sha256
            or rows["monitor_runtime_script_builtin_sha256"]
