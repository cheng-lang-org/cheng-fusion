def phase_manifest_sha256_from_envelope(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    envelope: Mapping[str, Any],
    stage_input_identity: ArtifactIdentity | None = None,
) -> str:
    if state.boundary.lane == LANE_LINUX:
        if stage_input_identity is None:
