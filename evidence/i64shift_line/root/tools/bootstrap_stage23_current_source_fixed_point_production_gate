def cold_darwin_framework_order(raw: bytes) -> tuple[str, ...]:
    try:
        source = raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "frozen cold source is not UTF-8"
        ) from exc
    matches = re.findall(
        r"static const char \*cold_darwin_framework_flags"
        r"\(void\) \{(?P<body>.*?)\n\}",
        source,
        flags=re.DOTALL,
    )
    if len(matches) != 1:
        fail("frozen cold framework authority is not unique")
    literals = re.findall(
        r'"(?:\\.|[^"\\])*"',
        matches[0],
    )
    decoded = tuple(
        parse_c_string_literal(token, "cold framework authority")
        for token in literals
    )
    if (
        len(decoded) < 4
        or decoded[0] != b"CHENG_DARWIN_FRAMEWORK_FLAGS"
        or decoded[1] != b"CHENG_CLT_FRAMEWORK_FLAGS"
    ):
        fail("frozen cold framework environment contract drifted")
    try:
        tokens = b"".join(decoded[2:]).decode("ascii").split()
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "frozen cold framework argv is not ASCII"
        ) from exc
    if (
        len(tokens) != 14
        or any(
            tokens[index] != "-framework"
            for index in range(0, len(tokens), 2)
        )
    ):
        fail("frozen cold framework argv shape drifted")
    names = tuple(tokens[index] for index in range(1, len(tokens), 2))
    if (
        len(names) != 7
        or len(names) != len(set(names))
        or any(
            re.fullmatch(r"[A-Z][A-Za-z0-9]*", name) is None
            for name in names
        )
    ):
        fail("frozen cold framework names are not exact")
    return names


def materialize_darwin_framework_authorities(
    snapshot: Path,
    live_regular: dict[str, ArtifactIdentity],
    live_symlinks: dict[str, tuple[Any, ...]],
    framework_order: Sequence[str],
    *,
    sdk_source_root: Path = DARWIN_XCODE_SDK_ROOT,
) -> None:
    if (
        len(framework_order) != 7
        or len(framework_order) != len(set(framework_order))
    ):
        fail("Darwin framework materialization order drifted")
    for name in framework_order:
        framework_root = (
            sdk_source_root
            / "System/Library/Frameworks"
            / f"{name}.framework"
        )
        root_entry = framework_root / f"{name}.tbd"
        current_link = framework_root / "Versions/Current"
        root_info = os.lstat(root_entry)
        current_info = os.lstat(current_link)
        if (
            not stat.S_ISLNK(root_info.st_mode)
            or not stat.S_ISLNK(current_info.st_mode)
            or os.readlink(root_entry)
                != f"Versions/Current/{name}.tbd"
            or re.fullmatch(
                r"[A-Z]",
                os.readlink(current_link),
            ) is None
        ):
            fail("Darwin framework symlink chain is non-canonical")
        materialize_live_regular(
            root_entry,
            snapshot
            / "SDKs/MacOSX.sdk"
            / root_entry.relative_to(sdk_source_root),
            live_regular,
            live_symlinks,
            source_root=sdk_source_root,
            require_symlink=True,
        )
        current_resolved = capture_live_symlink(
            current_link, live_symlinks
        )
        expected_final = current_resolved / f"{name}.tbd"
        if (
            root_entry.resolve(strict=True) != expected_final
            or not expected_final.is_file()
            or expected_final.is_symlink()
        ):
            fail("Darwin framework final target is not exact")


def darwin_framework_authority_payload(
    snapshot: Path,
    live_regular: Mapping[str, ArtifactIdentity],
    live_symlinks: Mapping[str, tuple[Any, ...]],
    name: str,
    index: int,
    *,
    sdk_source_root: Path,
) -> dict[str, Any]:
    framework_root = (
        sdk_source_root
        / "System/Library/Frameworks"
        / f"{name}.framework"
    )
    root_entry = framework_root / f"{name}.tbd"
    current_link = framework_root / "Versions/Current"
    root_record = live_symlinks.get(str(root_entry))
    current_record = live_symlinks.get(str(current_link))
    if root_record is None or current_record is None:
        fail("Darwin framework symlink authority is incomplete")
    final_path = root_entry.resolve(strict=True)
    resolved_identity = live_regular.get(str(final_path))
    snapshot_path = (
        snapshot
        / "SDKs/MacOSX.sdk"
        / root_entry.relative_to(sdk_source_root)
    )
    snapshot_identity, _snapshot_raw = stable_artifact(
        snapshot_path, executable=False
    )
    if (
        resolved_identity is None
        or resolved_identity.sha256 != snapshot_identity.sha256
        or resolved_identity.size != snapshot_identity.size
        or stat.S_IMODE(snapshot_identity.mode) != 0o400
    ):
        fail("Darwin framework regular materialization drifted")
    return {
        "frameworkIndex": index,
        "name": name,
        "argvTokens": ["-framework", name],
        "snapshotRelativePath":
            str(snapshot_path.relative_to(snapshot)),
        "sourceSymlinkChain": [
            live_symlink_authority_payload(root_entry, root_record),
            live_symlink_authority_payload(
                current_link, current_record
            ),
        ],
        "sourceResolvedIdentity": resolved_identity.payload(),
        "snapshotIdentity": snapshot_identity.payload(),
    }


def darwin_runtime_link_authority_manifest_raw(
    snapshot: Path,
    live_regular: Mapping[str, ArtifactIdentity],
    live_symlinks: Mapping[str, tuple[Any, ...]],
    framework_order: Sequence[str],
    *,
    sdk_source_root: Path = DARWIN_XCODE_SDK_ROOT,
) -> bytes:
    if (
        len(framework_order) != 7
        or len(framework_order) != len(set(framework_order))
    ):
        fail("Darwin framework manifest order drifted")
    libc_source = sdk_source_root / "usr/lib/libc.tbd"
    libsystem_source = sdk_source_root / "usr/lib/libSystem.tbd"
    libc_record = live_symlinks.get(str(libc_source))
    libsystem_record = live_symlinks.get(str(libsystem_source))
    if libc_record is None or libsystem_record is None:
        fail("Darwin runtime link symlink chain is incomplete")
    resolved = libc_source.resolve(strict=True)
    resolved_identity = live_regular.get(str(resolved))
    snapshot_path = snapshot / "SDKs/MacOSX.sdk/usr/lib/libc.tbd"
    snapshot_identity, _snapshot_raw = stable_artifact(
        snapshot_path, executable=False
    )
    if (
        resolved_identity is None
        or resolved_identity.sha256 != snapshot_identity.sha256
        or resolved_identity.size != snapshot_identity.size
        or stat.S_IMODE(snapshot_identity.mode) != 0o400
    ):
        fail("Darwin runtime link regular materialization drifted")
    libc_authority = {
        "logicalRole": "sdk_libc",
        "snapshotRelativePath":
            "SDKs/MacOSX.sdk/usr/lib/libc.tbd",
        "sourceSymlinkChain": [
            live_symlink_authority_payload(libc_source, libc_record),
            live_symlink_authority_payload(
                libsystem_source, libsystem_record
            ),
        ],
        "sourceResolvedIdentity": resolved_identity.payload(),
        "snapshotIdentity": snapshot_identity.payload(),
    }
    frameworks = [
        darwin_framework_authority_payload(
            snapshot,
            live_regular,
            live_symlinks,
            name,
            index,
            sdk_source_root=sdk_source_root,
        )
        for index, name in enumerate(framework_order)
    ]
    portable = {
        "schema":
            "cheng.bootstrap_stage23_darwin_toolchain_portable_closure",
        "runtimeLinks": [{
            "logicalRole": libc_authority["logicalRole"],
            "snapshotRelativePath":
                libc_authority["snapshotRelativePath"],
            "sourceLinkTargets": [
                item["rawTarget"]
                for item in libc_authority["sourceSymlinkChain"]
            ],
            "sourceResolvedSha256": resolved_identity.sha256,
            "sourceResolvedSize": resolved_identity.size,
            "snapshotSha256": snapshot_identity.sha256,
            "snapshotSize": snapshot_identity.size,
            "snapshotMode": stat.S_IMODE(snapshot_identity.mode),
        }],
        "frameworkOrder": list(framework_order),
        "frameworks": [
            {
                "frameworkIndex": item["frameworkIndex"],
                "name": item["name"],
                "argvTokens": item["argvTokens"],
                "snapshotRelativePath":
                    item["snapshotRelativePath"],
                "sourceLinkTargets": [
                    link["rawTarget"]
                    for link in item["sourceSymlinkChain"]
                ],
                "sourceResolvedSha256":
                    item["sourceResolvedIdentity"]["sha256"],
                "sourceResolvedSize":
                    item["sourceResolvedIdentity"]["size"],
                "snapshotSha256":
                    item["snapshotIdentity"]["sha256"],
                "snapshotSize":
                    item["snapshotIdentity"]["size"],
                "snapshotMode":
                    stat.S_IMODE(item["snapshotIdentity"]["mode"]),
            }
            for item in frameworks
        ],
    }
    portable_raw = canonical_json(portable)
    return canonical_json({
        "schema":
            "cheng.bootstrap_stage23_darwin_toolchain_source_authority",
        "materializationKind":
            "bound_symlink_chain_to_exact_regular_copy",
        "runtimeLinks": [libc_authority],
        "frameworkOrder": list(framework_order),
        "frameworks": frameworks,
        "portableClosure": portable,
        "portableClosureSha256": sha256_bytes(portable_raw),
    }) + b"\n"


def validate_darwin_runtime_link_authority_manifest(
    snapshot: Path,
