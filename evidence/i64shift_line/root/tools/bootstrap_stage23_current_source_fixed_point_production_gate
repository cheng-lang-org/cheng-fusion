def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical_sha256(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or len(value) != 64
        or any(char not in "0123456789abcdef" for char in value)
    ):
        fail(f"{label} is not canonical sha256")
    return value


def canonical_uint(value: Any, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        fail(f"{label} is not a canonical uint")
    return value


def canonical_lane(value: Any) -> str:
    if not isinstance(value, str) or value not in LANES:
        fail("lane is not canonical")
    return value


def canonical_path_fshex(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or len(value) % 2
        or any(char not in "0123456789abcdef" for char in value)
    ):
        fail(f"{label} is not canonical fshex")
    try:
        decoded = os.fsdecode(bytes.fromhex(value))
    except (UnicodeError, ValueError) as exc:
        raise ProductionGateError(f"{label} cannot be decoded") from exc
    if not decoded.startswith("/") or os.fsencode(decoded).hex() != value:
        fail(f"{label} is not an absolute round-trip fshex path")
    return value


def framed_sha256(values: Sequence[bytes]) -> str:
    digest = hashlib.sha256()
    for value in values:
        digest.update(len(value).to_bytes(8, "big"))
        digest.update(value)
    digest.update(len(values).to_bytes(8, "big"))
    return digest.hexdigest()


def framed_record_sha256(
    domain: bytes,
    fields: Sequence[tuple[str, bytes]],
    expected_order: Sequence[str],
) -> str:
    if (
        not domain
        or b"\0" in domain
        or tuple(name for name, _value in fields) != tuple(expected_order)
        or len(set(expected_order)) != len(expected_order)
    ):
        fail("domain-framed record field order drifted")
    digest = hashlib.sha256()
    digest.update(b"CHENG-CID\0")
    digest.update(len(domain).to_bytes(8, "big"))
    digest.update(domain)
    digest.update(len(fields).to_bytes(8, "big"))
    for name, value in fields:
        name_raw = name.encode("ascii", "strict")
        digest.update(len(name_raw).to_bytes(8, "big"))
        digest.update(name_raw)
        digest.update(len(value).to_bytes(8, "big"))
        digest.update(value)
    return digest.hexdigest()


def guard_text_frame(raw: bytes) -> bytes:
    return len(raw).to_bytes(4, "big") + raw


def guard_argv_sha256(argv: Sequence[str]) -> str:
    payload = bytearray(guard_text_frame(b"cheng.guard.command_argv"))
    payload.extend(len(argv).to_bytes(4, "big"))
    for value in argv:
        payload.extend(guard_text_frame(os.fsencode(value)))
    return sha256_bytes(bytes(payload))


def guard_env_sha256(env: Mapping[str, str]) -> str:
    payload = bytearray(guard_text_frame(b"cheng.guard.target_env"))
    keys = sorted(env)
    payload.extend(len(keys).to_bytes(4, "big"))
    for key in keys:
        payload.extend(guard_text_frame(os.fsencode(key)))
        payload.extend(guard_text_frame(os.fsencode(env[key])))
    return sha256_bytes(bytes(payload))


