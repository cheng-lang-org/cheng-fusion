def physical_phase_chain_manifest_bytes(state: PhaseState) -> bytes:
    phase_chain_sha = completed_phase_chain_sha256(state)
    terminals = []
    for index, terminal in enumerate(state.terminals):
        relative_path = (
            f"phase-receipts/{index:02d}/outer-terminal.json"
        )
        row = state.closed_tree_files.get(relative_path)
        if (
            row is None
            or row["role"] != "outer_phase_terminal"
            or terminal.phase_index != index
            or terminal.predecessor_terminal_sha256
                != (
                    ZERO_SHA256
                    if index == 0 else state.terminal_sha256s[index - 1]
                )
            or state.terminal_sha256s[index]
                != phase_terminal_sha256(terminal)
        ):
            fail("physical phase chain terminal row drifted")
        observed, raw = stable_closed_file(
            state.paths.evidence / relative_path,
            "outer_phase_terminal",
            relative_path,
        )
        parsed = parse_outer_phase_terminal_bytes(raw)
        if observed != row or parsed != terminal:
            fail("physical phase chain terminal bytes drifted")
        terminals.append({
            "phaseIndex": index,
            "relativePath": relative_path,
            "fileIdentity": row,
            "terminalPayloadSha256": state.terminal_sha256s[index],
        })
    payload = {
        "schema": PHYSICAL_PHASE_CHAIN_SCHEMA,
        "lane": LANE_DARWIN,
        "phaseCount": len(PHASE_SPECS),
        "terminals": terminals,
        "phaseChainSha256": phase_chain_sha,
        "preChainClosedTreeSha256": sha256_bytes(
            closed_tree_bytes(
                state.closed_tree_directories,
                state.closed_tree_files,
            )
        ),
        "sourceSnapshotCid": portable_source_snapshot_cid(state),
        "stage3": state.frozen["stage3"].payload(),
    }
    return canonical_json({
        "payload": payload,
        "payloadSha256": sha256_bytes(canonical_json(payload)),
    }) + b"\n"


def persist_physical_phase_chain(state: PhaseState) -> PhaseState:
    if (
        state.boundary.lane != LANE_DARWIN
        or state.next_phase_index != len(PHASE_SPECS)
    ):
        fail("physical phase chain lacks completed Darwin state")
    raw = physical_phase_chain_manifest_bytes(state)
    parent = create_exclusive_private_child_directory(
        state.paths.evidence,
        PHYSICAL_PHASE_CHAIN_RELATIVE_PATH.parent.name,
    )
    identity = publish_exclusive_regular(
        parent, PHYSICAL_PHASE_CHAIN_RELATIVE_PATH.name, raw
    )
    if identity.sha256 != sha256_bytes(raw):
        fail("physical phase chain publication drifted")
    return phase_state_with_closed_file(
        state,
        state.paths.evidence / PHYSICAL_PHASE_CHAIN_RELATIVE_PATH,
        "physical_phase_chain_manifest",
    )


def physical_initial_darwin_state(
    lane_evidence: Path,
    phase0_manifest: Mapping[str, Any],
) -> PhaseState:
    frozen_rows = phase0_manifest.get("frozenRoles")
    if not isinstance(frozen_rows, list):
        fail("physical phase0 frozen roles are absent")
    identities: dict[str, ArtifactIdentity] = {}
    previous_role: str | None = None
    for row in frozen_rows:
        if (
            not isinstance(row, dict)
            or set(row) != {"role", "hostIdentity", "guestPath"}
            or not isinstance(row["role"], str)
            or not re.fullmatch(r"[a-z][a-z0-9_]*", row["role"])
            or row["guestPath"] is not None
            or (
                previous_role is not None
                and row["role"] <= previous_role
            )
        ):
            fail("physical phase0 frozen role row drifted")
        role = row["role"]
        previous_role = role
        identities[role] = artifact_identity_from_payload(
            row["hostIdentity"], "physical phase0 " + role
        )
    if len(identities) != len(frozen_rows):
        fail("physical phase0 frozen roles alias")
    cc = identity_host_path(identities["cc"])
    bootstrap_source = identity_host_path(
        identities["bootstrap_source"]
    )
    if (
        bootstrap_source.name != "cheng_cold.c"
        or bootstrap_source.parent.name != "bootstrap"
    ):
        fail("physical phase0 bootstrap source path drifted")
    source_root = bootstrap_source.parent.parent
    paths = phase_engine.PhasePaths(source_root, lane_evidence, cc)
    state = initial_phase_state(
        LaneBoundary(LANE_DARWIN, DARWIN_MEMORY_PROOF, None),
        paths,
        identities,
    )
    baseline_files: dict[str, dict[str, Any]] = {}
    physical: set[tuple[int, int]] = set()
    command_action_root = lane_evidence / "command-action-inputs"
    for role, identity in identities.items():
        path = identity_host_path(identity)
        if (
            path != lane_evidence
            and lane_evidence not in path.parents
        ):
            continue
        if path == command_action_root or command_action_root in path.parents:
            continue
        relative_path = str(path.relative_to(lane_evidence))
        row, _raw = stable_closed_file(path, role, relative_path)
        if (
            row["sha256"] != identity.sha256
            or row["device"] != identity.device
            or row["inode"] != identity.inode
            or row["size"] != identity.size
            or row["mode"] != stat.S_IMODE(identity.mode)
            or (row["device"], row["inode"]) in physical
        ):
            fail("physical initial Darwin evidence identity drifted")
        physical.add((row["device"], row["inode"]))
        baseline_files[relative_path] = row
    baseline_directories = tuple(sorted({
        str(parent)
        for relative_path in baseline_files
        for parent in Path(relative_path).parents
        if str(parent) != "."
    }, key=os.fsencode))
    state = PhaseState(
        boundary=state.boundary,
        paths=state.paths,
        next_phase_index=0,
        frozen=state.frozen,
        guest_paths=state.guest_paths,
        terminals=(),
        terminal_sha256s=(),
        ledger_receipt_sha256s=(),
        closed_tree_directories=baseline_directories,
        closed_tree_files=baseline_files,
        darwin_live_regular={},
        darwin_live_symlinks={},
    )
    tree_rows = phase0_manifest.get(
        "commandActionPrivateFrozenTrees"
    )
    if (
        not isinstance(tree_rows, list)
        or len(tree_rows) != 1
        or not isinstance(tree_rows[0], dict)
        or set(tree_rows[0]) != {
            "commandActionIndex",
            "bindingMode",
            "tree",
            "derivedInput",
        }
        or tree_rows[0].get("commandActionIndex") != 0
        or tree_rows[0].get("bindingMode") != "exact_prebound"
        or tree_rows[0].get("derivedInput") is not None
    ):
        fail("physical phase0 command action tree row drifted")
    phase0_root = paths.command_action_input_root(0, 0)
    if private_frozen_tree_binding(phase0_root) != tree_rows[0]["tree"]:
        fail("physical phase0 command action tree identity drifted")
    return bind_existing_darwin_action_input_root(
        state,
        phase0_root,
        0,
        0,
        "cc_phase00_action00",
        Path("toolchain/usr/bin/clang"),
    )


def physical_phase_raw_evidence(
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    manifest_raw: bytes,
    manifest_identity: ArtifactIdentity,
) -> PhaseRawEvidence:
    envelope = next_phase_envelope(state, allowlist)
    receipt_dir = (
        state.paths.evidence
        / "phase-receipts"
        / f"{state.next_phase_index:02d}"
    )
    produced: list[ProducedArtifact] = []
    for item in envelope["plannedOutputs"]:
        path = host_path_for_planned_fshex(state, item["pathFshex"])
        identity, _raw = stable_artifact(
            path, executable=item["kind"] == "executable"
        )
        produced.append(ProducedArtifact(item["role"], identity))
    validate_darwin_codesign_guard_receipts(
        state,
        envelope,
        {item.role: item.identity for item in produced},
    )
    declared_files: dict[str, dict[str, Any]] = {}
    for item in envelope["declaredDeltaFiles"]:
        relative_path = item["relativePath"]
        row, _raw = stable_closed_file(
            state.paths.evidence / relative_path,
            item["role"],
            relative_path,
        )
        declared_files[relative_path] = row
    post_files = dict(state.closed_tree_files)
    if set(post_files).intersection(declared_files):
        fail("physical phase declared file replaced sealed evidence")
    post_files.update(declared_files)
    post_directories = tuple(sorted(
        set(state.closed_tree_directories).union(
            envelope["declaredDeltaDirectories"]
        ),
        key=os.fsencode,
    ))
    action_evidence = tuple(
        CommandActionRawEvidence(
            action["commandActionIndex"],
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.kv"
            ).read_bytes(),
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.stdout"
            ).read_bytes(),
            (
                receipt_dir
                / f"action-{action['commandActionIndex']:02d}.guard.stderr"
            ).read_bytes(),
        )
        for action in envelope.get("phaseCommandActions", ())
    )
    return PhaseRawEvidence(
        guard_receipt_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.kv").read_bytes()
        ),
        guard_stdout_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.stdout").read_bytes()
        ),
        guard_stderr_raw=(
            b"" if action_evidence else
            (receipt_dir / "guard.stderr").read_bytes()
        ),
        ledger_receipt_raw=b"",
        ledger_validation_raw=b"",
        cgroup_receipt_raw=b"",
        phase_row_receipt_raw=(receipt_dir / "terminal.json").read_bytes(),
        action_stdout_raw=(receipt_dir / "action.stdout").read_bytes(),
        action_stderr_raw=(receipt_dir / "action.stderr").read_bytes(),
        pre_closed_tree_raw=closed_tree_bytes(
            state.closed_tree_directories,
            state.closed_tree_files,
        ),
        post_closed_tree_raw=closed_tree_bytes(
            post_directories, post_files
        ),
        stage_input_manifest_raw=manifest_raw,
        stage_input_manifest_identity=manifest_identity,
        rootfs_manifest_raw=b"",
        delegation_receipt_raw=b"",
        crun_identity=None,
        command_action_evidence=action_evidence,
        produced=tuple(produced),
    )


def stable_linux_evidence_raw(
    path: Path,
    label: str,
    max_bytes: int = 256 * 1024 * 1024,
) -> bytes:
    identity, raw = stable_artifact(path, executable=False)
    if (
        identity.nlink != 1
        or identity.size > max_bytes
        or stat.S_IMODE(identity.mode) not in (0o400, 0o444)
    ):
        fail("Linux raw evidence identity drifted: " + label)
    return raw


def exact_linux_evidence_directory(path: Path) -> Path:
    descriptor = open_anchored_directory(path)
    try:
        info = os.fstat(descriptor)
        if (
            stat.S_IMODE(info.st_mode) not in (0o500, 0o700)
            or info.st_uid != os.geteuid()
        ):
            fail("Linux evidence directory identity drifted")
    finally:
        os.close(descriptor)
    return path


def phase_declared_path(
    state: PhaseState,
    envelope: Mapping[str, Any],
    role: str,
) -> Path:
    matches = [
        item for item in envelope["declaredDeltaFiles"]
        if item["role"] == role
    ]
    if len(matches) != 1:
        fail("phase declared role is not unique: " + role)
    return state.paths.evidence / matches[0]["relativePath"]


