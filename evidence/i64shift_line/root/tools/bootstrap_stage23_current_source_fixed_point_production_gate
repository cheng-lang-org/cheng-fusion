        or receipt_sha != sha256_bytes(raw[:-len(suffix)])
        or rows["external_anchor_path_fshex"]
            != os.fsencode(str(LINUX_PORTABLE_ANCHOR_PATH)).hex()
        or rows["linux_target_triple"]
            != LANE_TARGET_TRIPLE[LANE_LINUX]
