def linux_evidence_closure_rows(
    root: Path,
    *,
    require_sealed: bool,
) -> tuple[tuple[str, ...], tuple[dict[str, Any], ...]]:
    if not root.is_absolute() or root.resolve(strict=True) != root:
        fail("Linux cgroup evidence root is not canonical")
    directories: list[str] = []
    files: list[dict[str, Any]] = []
    for current, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        current_path = Path(current)
        current_info = current_path.lstat()
        if (
            not stat.S_ISDIR(current_info.st_mode)
            or current_path.is_symlink()
            or (
                require_sealed
                and stat.S_IMODE(current_info.st_mode) != 0o500
            )
        ):
            fail("Linux cgroup evidence directory is not sealed")
        if current_path != root:
            directories.append(str(current_path.relative_to(root)))
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        for name in directory_names:
            child = current_path / name
            child_info = os.lstat(child)
            if (
                stat.S_ISLNK(child_info.st_mode)
                or not stat.S_ISDIR(child_info.st_mode)
            ):
                fail("portable evidence contains a directory special node")
        for name in file_names:
            path = current_path / name
            identity, _raw = stable_artifact(path, executable=False)
            if (
                identity.nlink != 1
                or (require_sealed and identity.mode & 0o222)
                or path.is_symlink()
            ):
                fail("Linux cgroup evidence file is mutable or aliased")
            files.append({
                "path": str(path.relative_to(root)),
                "sha256": identity.sha256,
                "size": identity.size,
                "mode": stat.S_IMODE(identity.mode),
            })
    directories.sort(key=os.fsencode)
    files.sort(key=lambda item: os.fsencode(item["path"]))
    return tuple(directories), tuple(files)


def linux_evidence_closure_cid(
    rows: tuple[tuple[str, ...], tuple[dict[str, Any], ...]],
) -> str:
    return sha256_bytes(canonical_json({
        "schema": "cheng.bootstrap_stage23_linux_evidence_closure",
        "directories": list(rows[0]),
        "files": list(rows[1]),
    }))


def sealed_portable_evidence_closure(
    root: Path,
    lane: str,
) -> tuple[DirectoryIdentity, str]:
    lane = canonical_lane(lane)
    expected = (
        LINUX_EVIDENCE_ROOT if lane == LANE_LINUX
        else DARWIN_EVIDENCE_ROOT
    )
    if root != expected:
        fail("portable evidence root is not the fixed authority path")
    before = os.lstat(root)
    rows = linux_evidence_closure_rows(root, require_sealed=True)
    after = os.lstat(root)
    fields = (
        "st_dev", "st_ino", "st_mode", "st_nlink", "st_uid", "st_gid",
        "st_mtime_ns", "st_ctime_ns",
    )
    if any(
        getattr(before, field) != getattr(after, field) for field in fields
    ):
        fail("portable evidence root changed during closure hashing")
    identity = DirectoryIdentity(
        path_fshex=os.fsencode(str(root)).hex(),
        device=before.st_dev,
        inode=before.st_ino,
        mode=before.st_mode,
        nlink=before.st_nlink,
        uid=before.st_uid,
        gid=before.st_gid,
    )
    closure_cid = sha256_bytes(canonical_json({
        "schema": "cheng.bootstrap_stage23_portable_evidence_closure",
        "lane": lane,
        "directories": list(rows[0]),
        "files": list(rows[1]),
    }))
    return identity, closure_cid


def seal_linux_evidence_closure(root: Path) -> str:
    directories, before_files = linux_evidence_closure_rows(
        root, require_sealed=False
    )
    for row in before_files:
        os.chmod(root / row["path"], 0o400)
    paths = [root / item for item in directories]
    for path in sorted(paths, key=lambda item: len(item.parts), reverse=True):
        os.chmod(path, 0o500)
    os.chmod(root, 0o500)
    after_directories, after_files = linux_evidence_closure_rows(
        root, require_sealed=True
    )
    expected_after_files = tuple(
        {**row, "mode": 0o400} for row in before_files
    )
    if (
        directories != after_directories
        or expected_after_files != after_files
    ):
        fail("Linux cgroup evidence changed while sealing")
    return linux_evidence_closure_cid(
        (after_directories, after_files)
    )


def seal_linux_phase_inputs(bundle: LinuxPhaseManifestBundle) -> str:
