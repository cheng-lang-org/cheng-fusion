    linux_stage_fixed_point_sha256: str
    darwin_stage_fixed_point_sha256: str
    darwin_stage3: ArtifactIdentity
    _linux_lane_authority: LaneReceipt | None = field(
        default=None,
        repr=False,
        compare=False,
    )
    _darwin_lane_authority: LaneReceipt | None = field(
        default=None,
        repr=False,
        compare=False,
    )

    def __post_init__(self) -> None:
        if (
            self._linux_lane_authority is None
            or self._darwin_lane_authority is None
            or self._linux_lane_authority._authority_token
                is not _LANE_RECEIPT_AUTHORITY_TOKEN
            or self._darwin_lane_authority._authority_token
                is not _LANE_RECEIPT_AUTHORITY_TOKEN
        ):
            fail("composite bypassed completed lane authority")
        for label, value in (
            ("Linux lane receipt", self.linux_receipt_sha256),
            ("Darwin lane receipt", self.darwin_receipt_sha256),
            ("source snapshot", self.source_snapshot_cid),
            ("cheng cold", self.cheng_cold_sha256),
            ("bootstrap contract", self.bootstrap_contract_sha256),
            ("portable generated C", self.generated_c_portable_cid),
            ("Linux raw generated C",
             self.linux_generated_c_raw_sha256),
            ("Darwin raw generated C",
             self.darwin_generated_c_raw_sha256),
            ("Linux stage fixed point",
             self.linux_stage_fixed_point_sha256),
            ("Darwin stage fixed point",
             self.darwin_stage_fixed_point_sha256),
        ):
            canonical_sha256(value, label)
        if (
            not re.fullmatch(
                r"[0-9a-f]{16}", self.self_check_contract_hash
            )
            or self.linux_target_triple
                != LANE_TARGET_TRIPLE[LANE_LINUX]
            or self.linux_machine_authority
                != LANE_MACHINE_AUTHORITY[LANE_LINUX]
            or self.darwin_target_triple
                != LANE_TARGET_TRIPLE[LANE_DARWIN]
            or self.darwin_machine_authority
                != LANE_MACHINE_AUTHORITY[LANE_DARWIN]
            or self.darwin_stage3.artifact_format
                != FORMAT_MACHO_ARM64
        ):
            fail("composite target, machine, or install artifact drifted")

    def payload(self) -> dict[str, Any]:
        return {
            "schema": COMPOSITE_SCHEMA,
            "status": "PROVED",
            "linuxReceiptSha256": self.linux_receipt_sha256,
            "darwinReceiptSha256": self.darwin_receipt_sha256,
            "linuxTargetTriple": self.linux_target_triple,
            "linuxMachineAuthority": self.linux_machine_authority,
            "darwinTargetTriple": self.darwin_target_triple,
            "darwinMachineAuthority": self.darwin_machine_authority,
            "sourceSnapshotCid": self.source_snapshot_cid,
            "chengColdSha256": self.cheng_cold_sha256,
            "bootstrapContractSha256": self.bootstrap_contract_sha256,
            "selfCheckContractHash": self.self_check_contract_hash,
            "generatedCPortableCid": self.generated_c_portable_cid,
            "linuxGeneratedCRawSha256":
                self.linux_generated_c_raw_sha256,
            "darwinGeneratedCRawSha256":
                self.darwin_generated_c_raw_sha256,
            "linuxStageFixedPointSha256":
                self.linux_stage_fixed_point_sha256,
            "darwinStageFixedPointSha256":
                self.darwin_stage_fixed_point_sha256,
            "darwinStage3": self.darwin_stage3.payload(),
        }

    def receipt_bytes(self) -> bytes:
        payload = self.payload()
        return canonical_json({
            "payload": payload,
            "payloadSha256": sha256_bytes(canonical_json(payload)),
        }) + b"\n"

    def receipt_sha256(self) -> str:
        return sha256_bytes(self.receipt_bytes())

    def sha256(self) -> str:
        return self.receipt_sha256()


