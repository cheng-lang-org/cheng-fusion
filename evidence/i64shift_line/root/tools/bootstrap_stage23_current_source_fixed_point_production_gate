        or rows["crun_clone3_exact_flags"]
            != str(linux_cgroup_validator.CRUN_CLONE3_EXACT_FLAGS)
        or rows["crun_clone3_intercept_count"] != "1"
        or rows["crun_exec_transition_count"]
            != str(linux_cgroup_validator.CRUN_EXACT_EXEC_TRANSITIONS)
        or rows["input_manifest_sha256"]
            != sha256_bytes(cgroup_input_raw)
