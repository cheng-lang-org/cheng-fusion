        ("verifier_inputs_cid", verifier_cid),
    )
    if tuple(key for key, _value in values) != AUTHORITY_KEY_ORDER[:-1]:
        fail("authority field order drifted")
    prefix = "".join(
        f"{key}={value}\n" for key, value in values
    ).encode("utf-8")
    return prefix + (
        "receipt_sha256=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")


def parse_authority_bytes(raw: bytes) -> dict[str, str]:
    if (
        not raw
        or len(raw) > MAX_AUTHORITY_BYTES
        or not raw.endswith(b"\n")
    ):
        fail("authority encoding is invalid")
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError("authority is not UTF-8") from exc
    rows: dict[str, str] = {}
    order: list[str] = []
    for line in text.splitlines():
        if not line or "=" not in line:
            fail("authority row is invalid")
        key, value = line.split("=", 1)
        if key in rows:
            fail("authority has duplicate key")
        rows[key] = value
        order.append(key)
    if tuple(order) != AUTHORITY_KEY_ORDER:
        fail("authority key order drifted")
    receipt_sha = canonical_sha256(
        rows["receipt_sha256"], "authority self hash"
    )
    suffix = ("receipt_sha256=" + receipt_sha + "\n").encode("ascii")
    if (
        receipt_sha != sha256_bytes(raw[:-len(suffix)])
    ):
        fail("authority self hash mismatch")
    if (
        rows["schema"] != AUTHORITY_SCHEMA
        or rows["status"] != "PASS"
        or rows["production_execution_status"]
            != "PROVED_CROSS_PLATFORM_COMPOSITE"
        or rows["linux_target_triple"]
            != LANE_TARGET_TRIPLE[LANE_LINUX]
        or rows["linux_machine_authority"]
            != LANE_MACHINE_AUTHORITY[LANE_LINUX]
        or rows["darwin_target_triple"]
            != LANE_TARGET_TRIPLE[LANE_DARWIN]
        or rows["darwin_machine_authority"]
            != LANE_MACHINE_AUTHORITY[LANE_DARWIN]
        or rows["installed_stage3_format"] != FORMAT_MACHO_ARM64
    ):
        fail("authority schema, status, target, or machine drifted")
    for key in (
        "composite_terminal_sha256",
        "linux_lane_receipt_sha256",
        "darwin_lane_receipt_sha256",
        "linux_evidence_closure_cid",
        "darwin_evidence_closure_cid",
        "linux_portable_anchor_sha256",
        "source_snapshot_cid",
        "cheng_cold_sha256",
        "bootstrap_contract_sha256",
        "generated_c_portable_cid",
        "linux_generated_c_raw_sha256",
        "darwin_generated_c_raw_sha256",
        "linux_stage_fixed_point_sha256",
        "darwin_stage_fixed_point_sha256",
        "installed_stage3_sha256",
        "production_gate_sha256",
        "verifier_inputs_cid",
    ):
        canonical_sha256(rows[key], "authority " + key)
    if not re.fullmatch(
        r"[0-9a-f]{16}", rows["self_check_contract_hash"]
    ):
        fail("authority self-check contract hash is not exact")
    expected_paths = {
        "installed_stage3_path_fshex": INSTALLED_STAGE3_PATH,
        "composite_terminal_path_fshex": COMPOSITE_TERMINAL_PATH,
        "linux_lane_receipt_path_fshex": LINUX_LANE_RECEIPT_PATH,
        "darwin_lane_receipt_path_fshex": DARWIN_LANE_RECEIPT_PATH,
        "linux_evidence_root_path_fshex": LINUX_EVIDENCE_ROOT,
        "darwin_evidence_root_path_fshex": DARWIN_EVIDENCE_ROOT,
        "linux_portable_anchor_path_fshex": LINUX_PORTABLE_ANCHOR_PATH,
    }
    for key, path in expected_paths.items():
        canonical_path_fshex(rows[key], "authority " + key)
        if rows[key] != os.fsencode(str(path)).hex():
            fail("authority canonical path binding drifted")
    integers: dict[str, int] = {}
    for key in (
        "installed_stage3_device",
        "installed_stage3_inode",
        "installed_stage3_mode",
        "installed_stage3_nlink",
        "installed_stage3_size",
        "installed_stage3_uid",
        "installed_stage3_gid",
    ):
        value = rows[key]
        if (
            not re.fullmatch(r"0|[1-9][0-9]*", value)
            or int(value) < 0
        ):
            fail("authority integer field is not canonical")
        integers[key] = int(value)
    if (
        integers["installed_stage3_device"] <= 0
        or integers["installed_stage3_inode"] <= 0
        or integers["installed_stage3_nlink"] != 1
        or integers["installed_stage3_size"] <= 0
        or not stat.S_ISREG(integers["installed_stage3_mode"])
        or integers["installed_stage3_mode"] & 0o222
        or not integers["installed_stage3_mode"] & 0o111
    ):
        fail("authority installed identity is not immutable Mach-O")
    return rows


def authority_matches(
    raw: bytes,
    composite: CompositeTerminal,
    composite_receipt_raw: bytes,
    linux_receipt_raw: bytes,
    darwin_receipt_raw: bytes,
    installed: ArtifactIdentity,
    linux_evidence_closure_cid: str,
    darwin_evidence_closure_cid: str,
    verifier_inputs_cid: str,
    portable_anchor: AuthenticatedLinuxPortableAnchor,
    production_gate_sha256: str,
) -> bool:
    try:
        return raw == build_authority_bytes(
            composite,
            composite_receipt_raw,
            linux_receipt_raw,
            darwin_receipt_raw,
            installed,
            linux_evidence_closure_cid,
            darwin_evidence_closure_cid,
            verifier_inputs_cid,
            portable_anchor,
            production_gate_sha256,
        ) and parse_authority_bytes(raw)["status"] == "PASS"
    except (
        AttributeError,
        ProductionGateError,
        TypeError,
        UnicodeError,
        ValueError,
    ):
        return False


def strict_lane_receipt_structure(
    raw: bytes,
    expected_lane: str,
) -> tuple[dict[str, Any], ArtifactIdentity]:
    expected_lane = canonical_lane(expected_lane)
    if not raw.endswith(b"\n") or len(raw) > MAX_AUTHORITY_BYTES:
        fail("existing lane receipt encoding is invalid")
    envelope = strict_canonical_json(
        raw[:-1], "existing lane receipt"
    )
    if (
        not isinstance(envelope, dict)
        or set(envelope) != {"payload", "payloadSha256"}
        or not isinstance(envelope.get("payload"), dict)
        or set(envelope["payload"]) != set(LANE_RECEIPT_PAYLOAD_KEYS)
    ):
        fail("existing lane receipt fields drifted")
    payload = envelope["payload"]
    if (
        canonical_sha256(
            envelope.get("payloadSha256"),
            "existing lane receipt payload",
        ) != sha256_bytes(canonical_json(payload))
        or payload.get("schema") != LANE_RECEIPT_SCHEMA
        or payload.get("lane") != expected_lane
        or payload.get("targetTriple")
            != LANE_TARGET_TRIPLE[expected_lane]
        or payload.get("machineAuthority")
            != LANE_MACHINE_AUTHORITY[expected_lane]
    ):
        fail("existing lane receipt self/host binding drifted")
    for key in LANE_RECEIPT_PAYLOAD_KEYS:
        if key not in {"stage3", "schema"} and not isinstance(
            payload[key], str
        ):
            fail("existing lane receipt scalar type drifted")
    for key in (
        "sourceSnapshotCid",
        "chengColdSha256",
        "bootstrapContractSha256",
        "generatedCPortableCid",
        "generatedCRawSha256",
        "stageFixedPointSha256",
        "phaseChainSha256",
        "cgroupReceiptSha256",
        "ptraceAggregateSha256",
        "guardAggregateSha256",
    ):
        canonical_sha256(payload[key], "existing lane " + key)
    if not re.fullmatch(
        r"[0-9a-f]{16}", payload["selfCheckContractHash"]
    ):
        fail("existing lane self-check hash drifted")
    stage3 = artifact_identity_from_payload(
        payload["stage3"], "existing lane stage3"
    )
    if (
        payload["stageFixedPointSha256"] != stage3.sha256
        or (
            expected_lane == LANE_LINUX
            and (
                payload["status"] != "PROVED"
                or payload["memoryProofStatus"] != LINUX_MEMORY_PROOF
                or payload["cgroupReceiptSha256"] == ZERO_SHA256
                or payload["ptraceAggregateSha256"] == ZERO_SHA256
                or payload["guardAggregateSha256"] != ZERO_SHA256
                or stage3.artifact_format != FORMAT_ELF64_X86_64
            )
        )
        or (
            expected_lane == LANE_DARWIN
            and (
                payload["status"] != "VERIFIED"
                or payload["memoryProofStatus"] != DARWIN_MEMORY_PROOF
                or payload["cgroupReceiptSha256"] != ZERO_SHA256
                or payload["ptraceAggregateSha256"] != ZERO_SHA256
                or payload["guardAggregateSha256"] == ZERO_SHA256
                or stage3.artifact_format != FORMAT_MACHO_ARM64
            )
        )
    ):
        fail("existing lane receipt proof contract drifted")
    return payload, stage3


def strict_composite_structure(
    raw: bytes,
) -> tuple[dict[str, Any], ArtifactIdentity]:
    if not raw.endswith(b"\n") or len(raw) > MAX_AUTHORITY_BYTES:
        fail("existing composite encoding is invalid")
    envelope = strict_canonical_json(raw[:-1], "existing composite")
    if (
        not isinstance(envelope, dict)
        or set(envelope) != {"payload", "payloadSha256"}
        or not isinstance(envelope.get("payload"), dict)
        or set(envelope["payload"]) != set(COMPOSITE_PAYLOAD_KEYS)
    ):
        fail("existing composite fields drifted")
    payload = envelope["payload"]
    if (
        canonical_sha256(
            envelope.get("payloadSha256"), "existing composite payload"
        ) != sha256_bytes(canonical_json(payload))
        or payload.get("schema") != COMPOSITE_SCHEMA
        or payload.get("status") != "PROVED"
    ):
        fail("existing composite self hash or status drifted")
    for key in COMPOSITE_PAYLOAD_KEYS:
        if key != "darwinStage3" and not isinstance(payload[key], str):
            fail("existing composite scalar type drifted")
    for key in (
        "linuxReceiptSha256",
        "darwinReceiptSha256",
        "sourceSnapshotCid",
        "chengColdSha256",
        "bootstrapContractSha256",
        "generatedCPortableCid",
        "linuxGeneratedCRawSha256",
        "darwinGeneratedCRawSha256",
        "linuxStageFixedPointSha256",
        "darwinStageFixedPointSha256",
    ):
        canonical_sha256(payload[key], "existing composite " + key)
    if (
        payload["linuxTargetTriple"]
            != LANE_TARGET_TRIPLE[LANE_LINUX]
        or payload["linuxMachineAuthority"]
            != LANE_MACHINE_AUTHORITY[LANE_LINUX]
        or payload["darwinTargetTriple"]
            != LANE_TARGET_TRIPLE[LANE_DARWIN]
        or payload["darwinMachineAuthority"]
            != LANE_MACHINE_AUTHORITY[LANE_DARWIN]
        or not re.fullmatch(
            r"[0-9a-f]{16}", payload["selfCheckContractHash"]
        )
    ):
        fail("existing composite host/source scalar drifted")
    stage3 = artifact_identity_from_payload(
        payload["darwinStage3"], "existing composite Darwin stage3"
    )
    if (
        stage3.artifact_format != FORMAT_MACHO_ARM64
        or payload["darwinStageFixedPointSha256"] != stage3.sha256
    ):
        fail("existing composite Darwin stage3 drifted")
    return payload, stage3


def authority_verification_bytes(
    values: Mapping[str, str],
) -> bytes:
    expected = AUTHORITY_VERIFY_KEY_ORDER[:-1]
    if tuple(values) != expected:
        fail("authority verification report fields drifted")
    prefix = "".join(
        key + "=" + values[key] + "\n" for key in expected
    ).encode("utf-8")
    raw = prefix + (
        "verification_sha256=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")
    parse_authority_verification_bytes(raw)
    return raw


def parse_authority_verification_bytes(raw: bytes) -> dict[str, str]:
    if (
        not raw
        or len(raw) > MAX_AUTHORITY_BYTES
        or not raw.endswith(b"\n")
    ):
        fail("authority verification report encoding is invalid")
    try:
        text = raw.decode("ascii", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "authority verification report is not ASCII"
        ) from exc
    rows: dict[str, str] = {}
    order: list[str] = []
    for line in text.splitlines():
        if not line or "=" not in line:
            fail("authority verification report row is invalid")
        key, value = line.split("=", 1)
        if key in rows:
            fail("authority verification report has a duplicate key")
        rows[key] = value
        order.append(key)
    if tuple(order) != AUTHORITY_VERIFY_KEY_ORDER:
        fail("authority verification report key order drifted")
    verification_sha = canonical_sha256(
        rows["verification_sha256"],
        "authority verification report self hash",
    )
    suffix = (
        "verification_sha256=" + verification_sha + "\n"
    ).encode("ascii")
    if (
        rows["schema"] != AUTHORITY_VERIFY_SCHEMA
        or rows["status"] != "VERIFIED"
        or verification_sha != sha256_bytes(raw[:-len(suffix)])
    ):
        fail("authority verification report contract drifted")
    return rows


@dataclass(frozen=True)
class ExistingAuthorityRawBindings:
    rows: Mapping[str, str]
    verifier_inputs_cid: str
    authority_identity: ArtifactIdentity
    production_gate_identity: ArtifactIdentity
    installed_stage3: ArtifactIdentity
    composite_identity: ArtifactIdentity
    linux_receipt_identity: ArtifactIdentity
    darwin_receipt_identity: ArtifactIdentity
