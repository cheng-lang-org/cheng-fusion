    original_execution_raw = stable_linux_evidence_raw(
        bundle.execution_manifest, "phase execution input"
    )
    original_pair_raw = stable_linux_evidence_raw(
        bundle.manifest_pair_commitment, "manifest pair input"
    )
    terminal_raw = stable_linux_evidence_raw(
        phase_declared_path(state, envelope, "phase_action_terminal"),
        "inner phase terminal",
    )
    action_stdout_raw = stable_linux_evidence_raw(
        phase_declared_path(state, envelope, "phase_action_stdout"),
        "inner phase action stdout",
    )
    action_stderr_raw = stable_linux_evidence_raw(
        phase_declared_path(state, envelope, "phase_action_stderr"),
        "inner phase action stderr",
    )
    target_stdout_raw = stable_linux_evidence_raw(
        control / "stdout.bin", "cgroup target stdout"
    )
    target_stderr_raw = stable_linux_evidence_raw(
        control / "stderr.bin", "cgroup target stderr"
    )
    if (
        stage_authority_raw != original_authority_raw
        or execution_raw != original_execution_raw
        or pair_raw != original_pair_raw
        or rootfs_raw != authority.rootfs_manifest_raw
        or delegation_raw != authority.delegation_raw
        or target_stdout_raw != terminal_raw
        or target_stderr_raw
        or action_stdout_raw != terminal_raw
