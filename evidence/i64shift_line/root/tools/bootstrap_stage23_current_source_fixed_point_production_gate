def materialize_live_tree(
    source: Path,
    destination: Path,
    *,
    source_root: Path,
    live_regular: dict[str, ArtifactIdentity],
    live_symlinks: dict[str, tuple[Any, ...]],
    ancestry: tuple[Path, ...] = (),
) -> None:
    resolved = capture_live_symlink(source, live_symlinks)
    try:
        resolved.relative_to(source_root)
    except ValueError as exc:
        raise ProductionGateError(
            "Darwin toolchain symlink escapes its frozen root"
        ) from exc
    info = os.lstat(resolved)
    if stat.S_ISDIR(info.st_mode):
        if resolved in ancestry:
            fail("Darwin toolchain symlink cycle detected")
        destination.mkdir(parents=True, exist_ok=False, mode=0o700)
        for child in sorted(
            resolved.iterdir(), key=lambda item: os.fsencode(item.name)
        ):
            materialize_live_tree(
                child,
                destination / child.name,
                source_root=source_root,
                live_regular=live_regular,
                live_symlinks=live_symlinks,
                ancestry=(*ancestry, resolved),
            )
        os.chmod(destination, 0o500)
        return
    if not stat.S_ISREG(info.st_mode):
        fail("Darwin toolchain closure contains a non-regular node")
    identity, raw = stable_artifact(resolved, executable=False)
    live_regular[str(resolved)] = identity
    write_new_snapshot_file(destination, raw, 0o400)


def validate_darwin_live_toolchain_maps(
    live_regular: Mapping[str, ArtifactIdentity],
    live_symlinks: Mapping[str, tuple[Any, ...]],
) -> None:
    for raw_path, expected in live_regular.items():
        path = Path(raw_path)
        executable = expected.artifact_format != FORMAT_REGULAR
        observed = stable_artifact(
            path, executable=executable
        )[0]
        if observed != expected:
            fail("Darwin live toolchain regular input changed")
    for raw_path, expected in live_symlinks.items():
        path = Path(raw_path)
        try:
            info = os.lstat(path)
            raw_target = os.readlink(path)
            resolved = path.resolve(strict=True)
            target = os.lstat(resolved)
        except OSError as exc:
            raise ProductionGateError(
                "Darwin live toolchain symlink changed"
            ) from exc
        observed = (
            raw_target,
            str(resolved),
            info.st_dev,
            info.st_ino,
            info.st_mode,
            info.st_uid,
            info.st_gid,
            info.st_mtime_ns,
            info.st_ctime_ns,
            target.st_dev,
            target.st_ino,
            target.st_mode,
            target.st_uid,
            target.st_gid,
            target.st_mtime_ns,
            target.st_ctime_ns,
        )
        if observed != expected:
            fail("Darwin live toolchain symlink mapping changed")


def validate_darwin_live_toolchain(
    state: PhaseState,
) -> None:
    validate_darwin_live_toolchain_maps(
        state.darwin_live_regular,
