    state = initial_phase_state(
        authority.boundary,
        phase_engine.PhasePaths(
            source_root,
            stage_evidence,
            role_paths["cc"],
        ),
        identities,
        guest_paths,
    )
    return PhaseState(
        boundary=state.boundary,
        paths=state.paths,
        next_phase_index=0,
        frozen=state.frozen,
        guest_paths=state.guest_paths,
        terminals=(),
        terminal_sha256s=(),
        ledger_receipt_sha256s=(),
        closed_tree_directories=(),
        closed_tree_files={},
        darwin_live_regular={},
        darwin_live_symlinks={},
    )


