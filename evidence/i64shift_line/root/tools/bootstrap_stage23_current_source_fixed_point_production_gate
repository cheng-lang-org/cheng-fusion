def write_new_snapshot_file(path: Path, raw: bytes, mode: int) -> None:
    if (
        not path.is_absolute()
        or mode not in (0o400, 0o500)
        or path.exists()
        or path.is_symlink()
    ):
        fail("private snapshot file target is not exact")
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(
        path,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        mode,
    )
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("private snapshot write made no progress")
            view = view[written:]
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def capture_live_symlink(
    path: Path,
    live_symlinks: dict[str, tuple[Any, ...]],
) -> Path:
    before = os.lstat(path)
    if not stat.S_ISLNK(before.st_mode):
        return path
    raw_target = os.readlink(path)
    resolved = path.resolve(strict=True)
    target = os.lstat(resolved)
    after = os.lstat(path)
    after_target = os.readlink(path)
    after_resolved = path.resolve(strict=True)
    link_fields = (
        "st_dev",
        "st_ino",
        "st_mode",
        "st_nlink",
        "st_size",
        "st_uid",
        "st_gid",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    if (
        tuple(getattr(before, field) for field in link_fields)
        != tuple(getattr(after, field) for field in link_fields)
        or raw_target != after_target
        or resolved != after_resolved
    ):
        fail("Darwin live toolchain symlink changed during capture")
    live_symlinks[str(path)] = (
        raw_target,
        str(resolved),
        before.st_dev,
        before.st_ino,
        before.st_mode,
        before.st_uid,
        before.st_gid,
        before.st_mtime_ns,
        before.st_ctime_ns,
        target.st_dev,
        target.st_ino,
        target.st_mode,
        target.st_uid,
        target.st_gid,
        target.st_mtime_ns,
        target.st_ctime_ns,
    )
    return resolved


def materialize_live_regular(
    source: Path,
    destination: Path,
    live_regular: dict[str, ArtifactIdentity],
    live_symlinks: dict[str, tuple[Any, ...]],
    *,
    source_root: Path | None = None,
    require_symlink: bool = False,
) -> None:
    source_info = os.lstat(source)
    if require_symlink and not stat.S_ISLNK(source_info.st_mode):
        fail("Darwin toolchain source lost required symlink authority")
    resolved = capture_live_symlink(source, live_symlinks)
    if source_root is not None:
        try:
            resolved.relative_to(source_root)
        except ValueError as exc:
            raise ProductionGateError(
                "Darwin toolchain symlink escapes its frozen root"
            ) from exc
    identity, raw = stable_artifact(resolved, executable=False)
    live_regular[str(resolved)] = identity
    write_new_snapshot_file(destination, raw, 0o400)


