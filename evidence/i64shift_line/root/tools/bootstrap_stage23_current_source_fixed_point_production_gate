def canonical_bootstrap_contract_bytes(raw: bytes) -> bytes:
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "bootstrap contract is not UTF-8"
        ) from exc
    rows: list[tuple[str, str]] = []
    seen: set[str] = set()
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.count("=") < 1:
            fail("bootstrap contract row lacks separator")
        key, value = (part.strip() for part in line.split("=", 1))
        if (
            not re.fullmatch(r"[a-z][a-z0-9_]*", key)
            or key in seen
        ):
            fail("bootstrap contract key is not exact")
        seen.add(key)
        rows.append((key, value))
    if tuple(key for key, _value in rows) != BOOTSTRAP_CONTRACT_KEY_ORDER:
        fail("bootstrap contract schema or key order drifted")
    return (
        "\n".join(key + "=" + value for key, value in rows) + "\n"
    ).encode("utf-8")


def bootstrap_manifest_relative_path(raw: bytes) -> Path:
    normalized = canonical_bootstrap_contract_bytes(raw)
    values = dict(
        line.split("=", 1)
        for line in normalized.decode("utf-8").splitlines()
    )
    value = values["bootstrap_manifest"]
    path = Path(value)
    if (
        path != BOOTSTRAP_MANIFEST_RELATIVE
        or path.is_absolute()
        or any(part in {"", ".", ".."} for part in path.parts)
        or "\\" in value
        or any(ord(char) < 32 or ord(char) == 127 for char in value)
    ):
        fail("bootstrap manifest path is not the unique frozen relative role")
    return path


def canonical_package_manifest_authority(
    raw: bytes,
) -> tuple[str, str]:
    if not raw.endswith(b"\n"):
        fail("package manifest is not newline terminated")
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeDecodeError as exc:
        raise ProductionGateError(
            "package manifest is not UTF-8"
        ) from exc
    if len(lines) != 2:
        fail("package manifest schema is not exact")
    values: list[str] = []
    for line, key in zip(lines, ("package_id", "module_prefix")):
        match = re.fullmatch(
            re.escape(key) + r' = "([^"]+)"',
            line,
        )
        if match is None:
            fail("package manifest key, order, or quoting drifted")
        values.append(match.group(1))
    package_id, module_prefix = values
    if (
        not package_id.startswith("pkg://")
        or package_id[6:] != module_prefix
        or re.fullmatch(r"[a-z][a-z0-9_-]*", module_prefix) is None
    ):
        fail("package manifest identity is non-canonical")
    return package_id, module_prefix


@dataclass(frozen=True)
class GeneratedCPortableProof:
    raw_sha256: str
    portable_cid: str
    template_sha256: str
    impl_sha256: str
    contract_sha256: str
    normalized_contract_sha256: str


def generated_c_portable_proof(
    raw: bytes,
    *,
    snapshot_root: Path,
    impl_identity: ArtifactIdentity,
    contract_identity: ArtifactIdentity,
    normalized_contract: bytes,
) -> GeneratedCPortableProof:
    if not raw.endswith(b"\n"):
        fail("generated C is not newline terminated")
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ProductionGateError("generated C is not UTF-8") from exc
    lines = text.splitlines()
    if lines[:3] != [
        "/* Generated by cheng_cold compile-bootstrap.",
        " * This audit wrapper must point at bootstrap/cheng_cold.c.",
        " */",
    ] or len(lines) != 7 or lines[6] != "#include CHENG_IMPL_SOURCE_PATH":
        fail("generated C fixed template drifted")
    prefixes = (
        "#define CHENG_IMPL_SOURCE_PATH ",
        "#define CHENG_COLD_EMBEDDED_SOURCE_PATH_TEXT ",
        "#define CHENG_COLD_EMBEDDED_CONTRACT_TEXT ",
    )
    values: list[bytes] = []
    for line, prefix in zip(lines[3:6], prefixes):
        if not line.startswith(prefix):
            fail("generated C directive order or spelling drifted")
        token = line[len(prefix):]
        decoded = parse_c_string_literal(token, prefix)
        if encode_c_string_literal(decoded) != token:
            fail("generated C string literal is not writer-canonical")
        values.append(decoded)
    impl_raw, contract_raw, normalized_raw = values
    if not snapshot_root.is_absolute():
        fail("snapshot root is not absolute")
    try:
        resolved_snapshot_root = snapshot_root.resolve(strict=True)
        snapshot_info = os.lstat(snapshot_root)
    except OSError as exc:
        raise ProductionGateError(
            "snapshot root cannot be resolved"
        ) from exc
    if (
        resolved_snapshot_root != snapshot_root
        or not stat.S_ISDIR(snapshot_info.st_mode)
        or stat.S_ISLNK(snapshot_info.st_mode)
    ):
        fail("snapshot root is not a canonical directory")
    expected_impl = snapshot_root / "bootstrap/cheng_cold.c"
    expected_contract = snapshot_root / "bootstrap/stage1_bootstrap.cheng"
    observed_contract_bytes: bytes | None = None
    for raw_path, expected, identity, label in (
        (impl_raw, expected_impl, impl_identity, "impl"),
        (contract_raw, expected_contract, contract_identity, "contract"),
    ):
        path = Path(os.fsdecode(raw_path))
        if (
            not path.is_absolute()
            or path.resolve(strict=True) != expected
            or os.fsencode(str(path)).hex() != identity.path_fshex
        ):
            fail(f"generated C {label} path is not the frozen snapshot role")
        observed, observed_bytes = stable_artifact(
            path, executable=False
        )
        if observed != identity:
            fail(f"generated C {label} identity drifted")
        if label == "contract":
            observed_contract_bytes = observed_bytes
    if observed_contract_bytes is None:
        fail("generated C contract role was not observed")
    derived_normalized_contract = canonical_bootstrap_contract_bytes(
        observed_contract_bytes
    )
    if (
        normalized_raw != normalized_contract
        or normalized_raw != derived_normalized_contract
    ):
        fail("generated C normalized contract bytes drifted")
    template_sha = sha256_bytes(GENERATED_C_TEMPLATE)
    portable_cid = framed_record_sha256(
        GENERATED_C_DOMAIN,
        (
            ("schema", GENERATED_C_PORTABLE_SCHEMA.encode("ascii")),
            ("templateSha256", bytes.fromhex(template_sha)),
            ("implementationRole", GENERATED_C_IMPL_ROLE.encode("ascii")),
            (
                "implementationSha256",
                bytes.fromhex(impl_identity.sha256),
            ),
            ("contractRole", GENERATED_C_CONTRACT_ROLE.encode("ascii")),
            (
                "contractSha256",
                bytes.fromhex(contract_identity.sha256),
            ),
            ("normalizedContractBytes", normalized_raw),
        ),
        GENERATED_C_FIELD_ORDER,
    )
    return GeneratedCPortableProof(
        raw_sha256=sha256_bytes(raw),
        portable_cid=portable_cid,
        template_sha256=template_sha,
        impl_sha256=impl_identity.sha256,
        contract_sha256=contract_identity.sha256,
        normalized_contract_sha256=sha256_bytes(normalized_raw),
    )


def portable_source_snapshot_roles(state: PhaseState) -> tuple[str, ...]:
    return (
        "snapshot_bootstrap",
        "snapshot_contract",
        "snapshot_bootstrap_manifest",
        "snapshot_package_manifest",
        "snapshot_t7",
        *sorted(
            (
                role for role in state.frozen
                if role.startswith("snapshot_closure_")
            ),
        ),
    )


def portable_source_snapshot_cid(state: PhaseState) -> str:
    roles = portable_source_snapshot_roles(state)
    rows: list[tuple[str, bytes]] = []
    observed_paths: set[str] = set()
    for role in roles:
        identity = state.frozen.get(role)
        if identity is None:
            fail("portable source snapshot role is absent")
        path = identity_host_path(identity)
        try:
            relative = str(path.relative_to(state.paths.snapshot))
        except ValueError as exc:
            raise ProductionGateError(
                "portable source snapshot role escaped snapshot root"
            ) from exc
        if relative in observed_paths:
            fail("portable source snapshot path aliases")
        observed_paths.add(relative)
        rows.append((
            f"entry{len(rows):04d}",
            canonical_json({
                "relativePath": relative,
                "sha256": identity.sha256,
                "size": identity.size,
            }),
        ))
    rows.sort(
        key=lambda item: os.fsencode(
            json.loads(item[1])["relativePath"]
        )
    )
    fields = tuple(
        (f"entry{index:04d}", value)
        for index, (_old_name, value) in enumerate(rows)
    )
    return framed_record_sha256(
        b"cheng.bootstrap.stage23.portable.source.snapshot",
        fields,
        tuple(name for name, _value in fields),
    )


def current_source_snapshot_cid(state: PhaseState) -> str:
    expected_cid = portable_source_snapshot_cid(state)
    rows: list[tuple[str, bytes]] = []
    observed_paths: set[str] = set()
    for role in portable_source_snapshot_roles(state):
        snapshot_identity = state.frozen.get(role)
        if snapshot_identity is None:
            fail("current source binding lacks a snapshot role")
        snapshot_path = identity_host_path(snapshot_identity)
        try:
            relative = snapshot_path.relative_to(state.paths.snapshot)
        except (AttributeError, ValueError) as exc:
            raise ProductionGateError(
                "current source snapshot role escaped its frozen root"
            ) from exc
        relative_text = relative.as_posix()
        if relative_text in observed_paths:
            fail("current source snapshot paths alias")
        observed_paths.add(relative_text)
        current_path = ROOT / relative
        current_identity, _raw = stable_artifact(
            current_path, executable=False
        )
        if (
            current_identity.sha256 != snapshot_identity.sha256
            or current_identity.size != snapshot_identity.size
        ):
            fail("current source differs from authenticated snapshot")
        rows.append((
            f"entry{len(rows):04d}",
            canonical_json({
                "relativePath": relative_text,
                "sha256": current_identity.sha256,
                "size": current_identity.size,
            }),
        ))
    rows.sort(
        key=lambda item: os.fsencode(
            json.loads(item[1])["relativePath"]
        )
    )
    fields = tuple(
        (f"entry{index:04d}", value)
        for index, (_old_name, value) in enumerate(rows)
    )
    observed_cid = framed_record_sha256(
        b"cheng.bootstrap.stage23.portable.source.snapshot",
        fields,
        tuple(name for name, _value in fields),
    )
    if observed_cid != expected_cid:
        fail("current source snapshot CID drifted")
    return observed_cid


def self_check_contract_hash_from_completed_state(
    state: PhaseState,
) -> str:
    hashes: list[str] = []
    for phase_index in (3, 5, 7, 9):
        relative = (
            f"phase-receipts/{phase_index:02d}/guard.stdout"
        )
        row = state.closed_tree_files.get(relative)
        if row is None or row["role"] != "phase_guard_stdout":
            fail("completed state lacks self-check stdout")
        observed, raw = stable_closed_file(
            state.paths.evidence / relative,
            "phase_guard_stdout",
            relative,
        )
        if observed != row:
            fail("self-check stdout identity drifted")
        try:
            lines = raw.decode("utf-8", "strict").splitlines()
        except UnicodeDecodeError as exc:
            raise ProductionGateError(
                "self-check stdout is not UTF-8"
            ) from exc
        if (
            len(lines) != 5
            or not lines[0].startswith("bootstrap_name=")
            or not lines[1].startswith("target=")
            or not lines[2].startswith("bootstrap_manifest=")
            or not re.fullmatch(
                r"contract_hash=[0-9a-f]{16}", lines[3]
            )
            or lines[4] != "cheng_bootstrap_self_check=ok"
        ):
            fail("self-check stdout contract drifted")
        hashes.append(lines[3].split("=", 1)[1])
    if len(set(hashes)) != 1:
        fail("stage self-check contract hashes differ")
    return hashes[0]


_LANE_RECEIPT_AUTHORITY_TOKEN = object()


@dataclass(frozen=True)
class LaneReceipt:
    lane: str
    target_triple: str
    machine_authority: str
    status: str
    memory_proof_status: str
    source_snapshot_cid: str
    cheng_cold_sha256: str
    bootstrap_contract_sha256: str
    self_check_contract_hash: str
    generated_c_portable_cid: str
    generated_c_raw_sha256: str
    stage_fixed_point_sha256: str
    phase_chain_sha256: str
    cgroup_receipt_sha256: str
    ptrace_aggregate_sha256: str
    guard_aggregate_sha256: str
    stage3: ArtifactIdentity
    _authority_token: object = field(
        default=None,
        repr=False,
        compare=False,
    )

    def __post_init__(self) -> None:
        if self._authority_token is not _LANE_RECEIPT_AUTHORITY_TOKEN:
            fail("lane receipt bypassed completed phase authority")
        canonical_lane(self.lane)
        if (
            self.target_triple != LANE_TARGET_TRIPLE[self.lane]
            or self.machine_authority
                != LANE_MACHINE_AUTHORITY[self.lane]
        ):
            fail("lane target or machine receipt drifted")
        for label, value in (
            ("source snapshot", self.source_snapshot_cid),
            ("cheng cold", self.cheng_cold_sha256),
            ("bootstrap contract", self.bootstrap_contract_sha256),
            ("portable generated C", self.generated_c_portable_cid),
            ("raw generated C", self.generated_c_raw_sha256),
            ("stage fixed point", self.stage_fixed_point_sha256),
            ("phase chain", self.phase_chain_sha256),
            ("cgroup receipt", self.cgroup_receipt_sha256),
            ("ptrace aggregate", self.ptrace_aggregate_sha256),
            ("guard aggregate", self.guard_aggregate_sha256),
        ):
            canonical_sha256(value, label)
        if not re.fullmatch(
            r"[0-9a-f]{16}", self.self_check_contract_hash
        ):
            fail("self-check contract hash is not exact")
        if self.stage_fixed_point_sha256 != self.stage3.sha256:
            fail("lane fixed-point hash does not bind stage3 bytes")
        if self.lane == LANE_LINUX:
            if (
                self.status != "PROVED"
                or self.memory_proof_status != LINUX_MEMORY_PROOF
                or self.cgroup_receipt_sha256 == ZERO_SHA256
                or self.ptrace_aggregate_sha256 == ZERO_SHA256
                or self.guard_aggregate_sha256 != ZERO_SHA256
                or self.stage3.artifact_format != FORMAT_ELF64_X86_64
            ):
                fail("Linux lane receipt is not exact")
        elif (
            self.status != "VERIFIED"
            or self.memory_proof_status != DARWIN_MEMORY_PROOF
            or self.cgroup_receipt_sha256 != ZERO_SHA256
            or self.ptrace_aggregate_sha256 != ZERO_SHA256
            or self.guard_aggregate_sha256 == ZERO_SHA256
            or self.stage3.artifact_format != FORMAT_MACHO_ARM64
        ):
            fail("Darwin lane receipt is not exact")

    def payload(self) -> dict[str, Any]:
        return {
            "schema": LANE_RECEIPT_SCHEMA,
            "lane": self.lane,
            "targetTriple": self.target_triple,
            "machineAuthority": self.machine_authority,
            "status": self.status,
            "memoryProofStatus": self.memory_proof_status,
            "sourceSnapshotCid": self.source_snapshot_cid,
            "chengColdSha256": self.cheng_cold_sha256,
            "bootstrapContractSha256": self.bootstrap_contract_sha256,
            "selfCheckContractHash": self.self_check_contract_hash,
            "generatedCPortableCid": self.generated_c_portable_cid,
            "generatedCRawSha256": self.generated_c_raw_sha256,
            "stageFixedPointSha256": self.stage_fixed_point_sha256,
            "phaseChainSha256": self.phase_chain_sha256,
            "cgroupReceiptSha256": self.cgroup_receipt_sha256,
            "ptraceAggregateSha256": self.ptrace_aggregate_sha256,
            "guardAggregateSha256": self.guard_aggregate_sha256,
            "stage3": self.stage3.payload(),
        }

    def receipt_bytes(self) -> bytes:
        payload = self.payload()
        return canonical_json({
            "payload": payload,
            "payloadSha256": sha256_bytes(canonical_json(payload)),
        }) + b"\n"

    def receipt_sha256(self) -> str:
        return sha256_bytes(self.receipt_bytes())


def aggregate_phase_field_sha256(
    domain: bytes,
    terminals: Sequence[PhaseTerminal],
    field_name: str,
) -> str:
    names = tuple(
        f"phase{index:02d}" for index in range(len(terminals))
    )
    fields = tuple(
        (
            names[index],
            bytes.fromhex(getattr(terminal, field_name)),
        )
        for index, terminal in enumerate(terminals)
    )
    return framed_record_sha256(domain, fields, names)


def aggregate_phase_guard_sha256(
    domain: bytes,
    terminals: Sequence[PhaseTerminal],
) -> str:
    names = tuple(
        f"phase{index:02d}" for index in range(len(terminals))
    )
    fields: list[tuple[str, bytes]] = []
    for index, terminal in enumerate(terminals):
        value = (
            terminal.guard_receipts_aggregate_sha256
            if terminal.command_action_receipts
            else terminal.guard_report_sha256
        )
        if value is None:
            fail("phase terminal guard authority is absent")
        fields.append((names[index], bytes.fromhex(value)))
    return framed_record_sha256(
        domain, tuple(fields), names
    )


def lane_receipt_from_completed_state(
    state: PhaseState,
    generated_c_proof: GeneratedCPortableProof,
) -> LaneReceipt:
    phase_chain = completed_phase_chain_sha256(state)
    required = (
        "source_snapshot_manifest",
        "snapshot_bootstrap",
        "snapshot_contract",
        "snapshot_bootstrap_manifest",
        "snapshot_package_manifest",
        "stage2",
        "stage3",
        "stage3_generated_c",
        "stage3_atom_manifest",
    )
    if any(role not in state.frozen for role in required):
        fail("completed phase state lacks lane receipt roles")
    stage2 = state.frozen["stage2"]
    stage3 = state.frozen["stage3"]
    if (
        stage2.sha256 != stage3.sha256
        or stage2.artifact_format
            != expected_lane_format(state.boundary.lane)
        or stage3.artifact_format
            != expected_lane_format(state.boundary.lane)
        or generated_c_proof.raw_sha256
            != state.frozen["stage3_generated_c"].sha256
        or generated_c_proof.impl_sha256
            != state.frozen["snapshot_bootstrap"].sha256
        or generated_c_proof.contract_sha256
            != state.frozen["snapshot_contract"].sha256
    ):
        fail("completed phase state fixed-point or generated-C drifted")
    if state.boundary.lane == LANE_LINUX:
        cgroup_aggregate = aggregate_phase_field_sha256(
            b"cheng.bootstrap.stage23.linux.cgroup.receipts",
            state.terminals,
            "cgroup_receipt_sha256",
        )
        ptrace_aggregate = aggregate_phase_field_sha256(
            b"cheng.bootstrap.stage23.linux.ptrace.receipts",
            state.terminals,
            "ledger_receipt_sha256",
        )
        guard_aggregate = ZERO_SHA256
        status = "PROVED"
        memory_status = LINUX_MEMORY_PROOF
    else:
        cgroup_aggregate = ZERO_SHA256
        ptrace_aggregate = ZERO_SHA256
        guard_aggregate = aggregate_phase_guard_sha256(
            b"cheng.bootstrap.stage23.darwin.guard.receipts",
            state.terminals,
        )
        status = "VERIFIED"
        memory_status = DARWIN_MEMORY_PROOF
    return LaneReceipt(
        lane=state.boundary.lane,
        target_triple=LANE_TARGET_TRIPLE[state.boundary.lane],
        machine_authority=
            LANE_MACHINE_AUTHORITY[state.boundary.lane],
        status=status,
        memory_proof_status=memory_status,
        source_snapshot_cid=portable_source_snapshot_cid(state),
        cheng_cold_sha256=
            state.frozen["snapshot_bootstrap"].sha256,
        bootstrap_contract_sha256=
            state.frozen["snapshot_contract"].sha256,
        self_check_contract_hash=
            self_check_contract_hash_from_completed_state(state),
        generated_c_portable_cid=generated_c_proof.portable_cid,
        generated_c_raw_sha256=generated_c_proof.raw_sha256,
        stage_fixed_point_sha256=stage3.sha256,
        phase_chain_sha256=phase_chain,
        cgroup_receipt_sha256=cgroup_aggregate,
        ptrace_aggregate_sha256=ptrace_aggregate,
        guard_aggregate_sha256=guard_aggregate,
        stage3=stage3,
        _authority_token=_LANE_RECEIPT_AUTHORITY_TOKEN,
    )


