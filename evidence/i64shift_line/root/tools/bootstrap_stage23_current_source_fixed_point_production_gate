def phase_plan_chain_sha256(lane: str, evidence: Path) -> str:
    lane = canonical_lane(lane)
    paths = phase_engine.PhasePaths(
        ROOT,
        evidence,
        (
            canonical_darwin_cc()
            if lane == LANE_DARWIN
            else canonical_host_executable("cc")
        ),
    )
    available = set(STATIC_REQUIRED_ROLES)
    if lane == LANE_DARWIN:
        available.add("darwin_ld")
    plans = []
    for spec in PHASE_SPECS:
        plan = phase_engine.phase_plan(spec.index, paths, lane)
        if lane == LANE_LINUX:
            plan = linux_guest_phase_plan(plan, paths)
        if (
            plan["lane"] != lane
            or plan["targetTriple"] != LANE_TARGET_TRIPLE[lane]
            or plan["machineAuthority"]
                != LANE_MACHINE_AUTHORITY[lane]
            or plan["nativeExecutableFormat"]
                != phase_engine.LANE_EXECUTABLE_FORMAT[lane]
            or any(
                role not in available
                for action in plan.get("commandActions", ())
                for role in (
                    action["launcherExecutableRole"],
                    action["targetExecutableRole"],
                )
            )
            or (
                "commandRole" in plan
                and plan["commandRole"] not in available
            )
            or any(
                role not in available for role in plan["boundInputRoles"]
            )
        ):
            fail("lane phase plan is not causally frozen")
        if spec.index in (11, 13):
            expected_target = (
                "--target:" + phase_engine.LANE_TARGET_TRIPLE[lane]
            )
            if expected_target not in plan["argv"]:
                fail("lane T7 target drifted")
        plans.append(plan)
        available.update(
            item["role"] for item in plan["outputs"]
        )
    return sha256_bytes(canonical_json({
        "schema": "cheng.bootstrap_stage23_platform_phase_plan_chain",
        "lane": lane,
        "phaseCount": len(plans),
        "plans": plans,
    }))


def hard_red(
    reason: str,
    *,
    linux_plan_sha256: str | None = None,
    darwin_plan_sha256: str | None = None,
) -> int:
    reason = reason.replace("\n", "_").replace("\r", "_")[:512]
    print(
        "schema="
        "cheng.bootstrap_stage23_current_source_fixed_point_production_gate",
        file=sys.stderr,
    )
    print("status=HARD_RED", file=sys.stderr)
    print("reason=" + reason, file=sys.stderr)
    print("authority_model=cross_platform_composite", file=sys.stderr)
    if linux_plan_sha256 is not None:
        print("linux_phase_plan_sha256=" + linux_plan_sha256, file=sys.stderr)
    if darwin_plan_sha256 is not None:
        print("darwin_phase_plan_sha256=" + darwin_plan_sha256, file=sys.stderr)
    print(
        "authority_path_fshex=" + os.fsencode(str(AUTHORITY_PATH)).hex(),
        file=sys.stderr,
    )
    return 1


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--run", action="store_true")
    action.add_argument("--run-lane", choices=LANES)
    action.add_argument("--compose", action="store_true")
    action.add_argument("--verify-authority", action="store_true")
    action.add_argument(
        "--issue-portable-authority-receipt",
        action="store_true",
    )
    action.add_argument(
        "--verify-portable-authority-receipt",
        action="store_true",
    )
    action.add_argument(
        "--validate-darwin-evidence", action="store_true"
    )
    parser.add_argument("--evidence-dir")
    parser.add_argument("--linux-receipt")
    parser.add_argument("--darwin-receipt")
    parser.add_argument("--delegation-manifest")
    parser.add_argument("--cgroup-parent")
    parser.add_argument("--crun")
    parser.add_argument("--rootfs")
    parser.add_argument("--rootfs-manifest")
    args = parser.parse_args(argv)
    if args.verify_authority:
        if any(value is not None for value in (
            args.evidence_dir,
            args.linux_receipt,
            args.darwin_receipt,
            args.delegation_manifest,
            args.cgroup_parent,
            args.crun,
            args.rootfs,
            args.rootfs_manifest,
        )):
            parser.error("--verify-authority accepts no path inputs")
    elif (
        args.issue_portable_authority_receipt
        or args.verify_portable_authority_receipt
    ):
        if any(value is not None for value in (
            args.evidence_dir,
            args.linux_receipt,
            args.darwin_receipt,
            args.delegation_manifest,
            args.cgroup_parent,
            args.crun,
            args.rootfs,
            args.rootfs_manifest,
        )):
            parser.error("portable authority actions accept no path inputs")
    elif args.compose:
        if not args.linux_receipt or not args.darwin_receipt:
            parser.error(
                "--compose requires --linux-receipt and --darwin-receipt"
            )
        if args.evidence_dir is not None:
            parser.error("--compose does not accept an evidence output path")
    elif args.linux_receipt or args.darwin_receipt:
        parser.error("lane receipt paths are compose-only")
    if (
        not args.verify_authority
        and not args.issue_portable_authority_receipt
        and not args.verify_portable_authority_receipt
        and not args.compose
        and args.evidence_dir in (None, "")
    ):
        parser.error("selected action requires --evidence-dir")
    linux_authority = (
        args.delegation_manifest,
        args.cgroup_parent,
        args.crun,
        args.rootfs,
        args.rootfs_manifest,
    )
    needs_linux_authority = args.run_lane == LANE_LINUX
    if (
        not needs_linux_authority
        and any(value not in (None, "") for value in linux_authority)
    ):
        parser.error("Linux authority inputs are Linux execution-only")
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(tuple(sys.argv[1:] if argv is None else argv))
    try:
        if (
            sys.flags.isolated != 1
            or sys.flags.no_site != 1
            or sys.flags.dont_write_bytecode != 1
        ):
            fail(
                "production Python runtime requires fixed -I -S -B"
            )
        verify_bound_inputs()
        if args.verify_authority:
            report = verify_existing_authority()
            sys.stdout.buffer.write(report)
            return 0
        if args.issue_portable_authority_receipt:
            report = issue_portable_authority_receipt()
            sys.stdout.buffer.write(report)
            return 0
        if args.verify_portable_authority_receipt:
            report = verify_linux_portable_authority_receipt()
            sys.stdout.buffer.write(report)
            return 0
        if args.compose:
            _composite, composite_raw, _linux_raw, _darwin_raw = (
                compose_candidate_from_existing_lane_receipts(
                    Path(args.linux_receipt),
                    Path(args.darwin_receipt),
                )
            )
            sys.stdout.buffer.write(composite_raw)
            return 0
        evidence = Path(args.evidence_dir)
        if args.validate_darwin_evidence:
            _state, receipt = validate_darwin_physical_evidence(
                evidence
            )
            sys.stdout.buffer.write(receipt.receipt_bytes())
            return 0
        if (
            not evidence.is_absolute()
            or not evidence.exists()
            or not evidence.is_dir()
            or evidence.is_symlink()
            or any(evidence.iterdir())
        ):
            fail("evidence directory is not canonical and empty")
        if args.run_lane is not None:
            if args.run_lane == LANE_DARWIN:
                lane_evidence = evidence / LANE_DARWIN
                lane_evidence.mkdir(mode=0o700)
                state, receipt = run_darwin_lane(lane_evidence)
                raw = write_darwin_lane_receipt(
                    evidence, state, receipt
                )
                sys.stdout.buffer.write(raw)
                return 0
            if any(value in (None, "") for value in (
                args.delegation_manifest,
                args.cgroup_parent,
                args.crun,
                args.rootfs,
                args.rootfs_manifest,
            )):
                fail("Linux authority inputs are incomplete")
            authority = capture_linux_authority_inputs(
                Path(args.delegation_manifest),
                Path(args.cgroup_parent),
                Path(args.crun),
                Path(args.rootfs),
                Path(args.rootfs_manifest),
            )
            lane_evidence = evidence / LANE_LINUX
            lane_evidence.mkdir(mode=0o700)
            state, receipt = run_linux_lane(
                lane_evidence, authority
            )
            raw = write_linux_lane_receipt(
                evidence, state, receipt, authority
            )
            sys.stdout.buffer.write(raw)
            return 0
        return hard_red(
            "run_requires_explicit_platform_lanes_and_compose"
        )
    except (
        OSError,
        ProductionGateError,
        linux_cgroup_validator.ValidationError,
    ) as exc:
        return hard_red(str(exc))
    return hard_red("unreachable_production_action")


def execute_stable_production_main(argv: Sequence[str]) -> int:
    raw, identity = stable_source_module_bytes(
        PRODUCTION_GATE, "production gate"
    )
    name = "cheng_stage23_frozen_production_gate"
    module = types.ModuleType(name)
    module.__file__ = str(PRODUCTION_GATE)
    module.__package__ = ""
    sys.modules[name] = module
    code = compile(
        raw, str(PRODUCTION_GATE), "exec", dont_inherit=True
    )
    exec(code, module.__dict__)
    after_raw, after_identity = stable_source_module_bytes(
        PRODUCTION_GATE, "production gate"
    )
    if after_raw != raw or after_identity != identity:
        fail("production gate changed across compile and exec")
    frozen_main = module.__dict__.get("main")
    if not callable(frozen_main):
        fail("frozen production gate main is absent")
    return frozen_main(argv)


if __name__ == "__main__":
    raise SystemExit(
        execute_stable_production_main(tuple(sys.argv[1:]))
    )
