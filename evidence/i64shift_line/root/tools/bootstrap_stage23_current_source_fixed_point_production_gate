def stable_artifact(path: Path, *, executable: bool) -> tuple[ArtifactIdentity, bytes]:
    if not path.is_absolute():
        fail("artifact path is not absolute")
    try:
        resolved = path.resolve(strict=True)
        before_path = os.lstat(path)
    except OSError as exc:
        raise ProductionGateError("artifact cannot be resolved") from exc
    if resolved != path or not stat.S_ISREG(before_path.st_mode):
        fail("artifact path contains a symlink or is not regular")
    fd = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(fd)
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(fd, min(1024 * 1024, remaining))
            if not chunk:
                fail("artifact short read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(fd, 1):
            fail("artifact grew during read")
        after = os.fstat(fd)
    finally:
        os.close(fd)
    after_path = os.lstat(path)
    fields = (
        "st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
        "st_uid", "st_gid", "st_mtime_ns", "st_ctime_ns",
    )
    if (
        any(getattr(before, field) != getattr(after, field) for field in fields)
        or any(
            getattr(before, field) != getattr(before_path, field)
            for field in fields
        )
        or any(
            getattr(before, field) != getattr(after_path, field)
            for field in fields
        )
    ):
        fail("artifact changed during stable read")
    raw = b"".join(chunks)
    artifact_format = detect_executable_format(raw)
    if executable and artifact_format == FORMAT_REGULAR:
        fail("artifact executable format is unsupported")
    if not executable:
        artifact_format = FORMAT_REGULAR
    return ArtifactIdentity(
        path_fshex=os.fsencode(str(path)).hex(),
        sha256=sha256_bytes(raw),
        device=before.st_dev,
        inode=before.st_ino,
        mode=before.st_mode,
        nlink=before.st_nlink,
        size=before.st_size,
        uid=before.st_uid,
        gid=before.st_gid,
        artifact_format=artifact_format,
    ), raw


