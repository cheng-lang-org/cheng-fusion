        validate_phase_row_receipt_raw(
            evidence.phase_row_receipt_raw,
            state=state,
            envelope=envelope,
            guard_raw=evidence.guard_receipt_raw,
            command_action_evidence=
                evidence.command_action_evidence,
            stage_input_raw=evidence.stage_input_manifest_raw,
            produced=produced,
        )
        execution_status = DARWIN_EXECUTION_PROOF
