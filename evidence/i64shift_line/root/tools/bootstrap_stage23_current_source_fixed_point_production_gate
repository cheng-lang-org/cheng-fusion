def validate_darwin_codesign_guard_receipts(
    state: PhaseState,
    envelope: Mapping[str, Any],
    produced: Mapping[str, ArtifactIdentity],
) -> None:
    actions = envelope.get("darwinCodesignActions", ())
    if not actions:
        return
    codesign = state.frozen.get("codesign")
    codesign_path = Path("/usr/bin/codesign")
    codesign_physical = physical_identity_payload(codesign_path)
    if (
        codesign is None
        or identity_host_path(codesign) != codesign_path
        or stable_artifact(
            codesign_path, executable=True
        )[0] != codesign
        or any(
            codesign_physical[key] != expected
            for key, expected in (
                ("device", codesign.device),
                ("inode", codesign.inode),
                ("mode", codesign.mode),
                ("nlink", codesign.nlink),
                ("size", codesign.size),
                ("uid", codesign.uid),
                ("gid", codesign.gid),
            )
        )
    ):
        fail("Darwin codesign executable authority is not exact")
    for action in actions:
        verified = produced.get(action["verifiedOutputRole"])
        receipt = produced.get(action["guardReceiptRole"])
        if (
            verified is None
            or receipt is None
            or action["targetExecutableRole"] != "codesign"
            or action["targetArgv"] != [
                "/usr/bin/codesign",
                "--verify",
                "--strict",
                str(identity_host_path(verified)),
