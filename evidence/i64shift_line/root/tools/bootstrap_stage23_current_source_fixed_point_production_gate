def parse_closed_tree_raw(
    raw: bytes,
    label: str,
) -> tuple[tuple[str, ...], dict[str, dict[str, Any]]]:
    if not raw.endswith(b"\n"):
        fail(label + " lacks terminal newline")
    value = strict_canonical_json(raw[:-1], label)
    if (
        not isinstance(value, dict)
        or set(value) != {"schema", "directories", "files"}
        or value["schema"] !=
            CLOSED_EVIDENCE_TREE_SCHEMA
        or not isinstance(value["directories"], list)
        or not isinstance(value["files"], list)
    ):
        fail(label + " schema drifted")
    directories = tuple(value["directories"])
    if (
        any(
            not isinstance(item, str)
            or not item
            or item.startswith("/")
            or str(Path(item)) != item
            or ".." in Path(item).parts
            for item in directories
        )
        or tuple(sorted(directories, key=os.fsencode)) != directories
        or len(set(directories)) != len(directories)
    ):
        fail(label + " directory set is not canonical")
    files: dict[str, dict[str, Any]] = {}
    expected_keys = set(CLOSED_EVIDENCE_TREE_FILE_FIELDS)
    previous_path: bytes | None = None
    physical: set[tuple[int, int]] = set()
    for row in value["files"]:
        if (
            not isinstance(row, dict)
            or set(row) != expected_keys
            or not isinstance(row["role"], str)
            or not re.fullmatch(
                r"[a-z][a-z0-9_]*", row["role"]
            )
            or not isinstance(row["relativePath"], str)
            or not row["relativePath"]
            or row["relativePath"].startswith("/")
            or str(Path(row["relativePath"])) != row["relativePath"]
            or ".." in Path(row["relativePath"]).parts
        ):
            fail(label + " file row is not canonical")
        relative_path = row["relativePath"]
        encoded_path = os.fsencode(relative_path)
        if previous_path is not None and encoded_path <= previous_path:
            fail(label + " file rows are not uniquely sorted")
        previous_path = encoded_path
        canonical_sha256(row["sha256"], label + " file")
        device = canonical_uint(row["device"], label + " device")
        inode = canonical_uint(row["inode"], label + " inode")
        canonical_uint(row["size"], label + " size")
        mode = canonical_uint(row["mode"], label + " mode")
        if (
            device == 0
            or inode == 0
            or mode not in (0o400, 0o444, 0o500, 0o555)
            or (device, inode) in physical
            or relative_path in files
        ):
            fail(label + " file identity is not exact")
        physical.add((device, inode))
        files[relative_path] = dict(row)
    for relative_path in files:
        for parent in Path(relative_path).parents:
            parent_text = str(parent)
            if parent_text == ".":
                break
            if parent_text not in directories:
                fail(
                    label
                    + " omits parent "
                    + parent_text
                    + " for "
                    + relative_path
                )
    return directories, files


def validate_closed_tree_transition(
    *,
    state: PhaseState,
    allowlist: PhaseExecutableAllowlist,
    envelope: Mapping[str, Any],
    evidence: PhaseRawEvidence,
    produced: Mapping[str, ArtifactIdentity],
) -> tuple[tuple[str, ...], dict[str, dict[str, Any]]]:
    pre_directories, pre_files = parse_closed_tree_raw(
        evidence.pre_closed_tree_raw,
        "pre closed evidence tree",
    )
    if (
        pre_directories != state.closed_tree_directories
        or pre_files != dict(state.closed_tree_files)
    ):
        fail("pre closed evidence tree is not the completed state")
    if evidence.action_stdout_raw != evidence.phase_row_receipt_raw:
        fail("phase action stdout is not byte-identical to terminal")
    if evidence.action_stderr_raw:
        fail("phase action stderr is not empty")
    if evidence.command_action_evidence:
        if (
            evidence.guard_receipt_raw
            or evidence.guard_stdout_raw
            or evidence.guard_stderr_raw
            or any(
                item.guard_stderr_raw
                for item in evidence.command_action_evidence
            )
        ):
            fail("multi-action phase retained singleton or stderr evidence")
    elif evidence.guard_stderr_raw:
        fail("phase guard stderr is not empty")
    post_directories, post_files = parse_closed_tree_raw(
        evidence.post_closed_tree_raw,
        "post closed evidence tree",
    )
    declared_directories = tuple(
        envelope["declaredDeltaDirectories"]
    )
    expected_directories = tuple(sorted(
        set(pre_directories).union(declared_directories),
        key=os.fsencode,
    ))
    if post_directories != expected_directories:
        fail("post closed tree directory delta drifted")
    declared_rows = phase_closed_tree_declared_files(
        state.boundary.lane, envelope
    )
    declared = {
        item["relativePath"]: item
        for item in declared_rows
    }
    if len(declared) != len(declared_rows):
        fail("declared phase file delta aliases")
    if set(post_files) != set(pre_files).union(declared):
        fail("post closed tree file delta is not exact")
    for relative_path, row in pre_files.items():
        if post_files[relative_path] != row:
            fail("closed tree pre-existing file changed or was replaced")
    expected_raw_by_role = {
        "phase_action_terminal": evidence.phase_row_receipt_raw,
        "phase_action_stdout": evidence.action_stdout_raw,
        "phase_action_stderr": evidence.action_stderr_raw,
        "phase_guard_receipt": evidence.guard_receipt_raw,
        "phase_guard_stdout": evidence.guard_stdout_raw,
        "phase_guard_stderr": evidence.guard_stderr_raw,
        "phase_stage_input_manifest":
            evidence.stage_input_manifest_raw,
        "phase_ptrace_manifest": (
            canonical_json(linux_ptrace_manifest_from_envelope(
                state,
                allowlist,
                envelope,
                evidence.stage_input_manifest_identity,
            )) + b"\n"
            if state.boundary.lane == LANE_LINUX else b""
        ),
        "phase_ptrace_receipt": evidence.ledger_receipt_raw,
        "phase_ptrace_validation": evidence.ledger_validation_raw,
        "phase_cgroup_receipt": evidence.cgroup_receipt_raw,
    }
    for item in evidence.command_action_evidence:
        prefix = f"phase_guard_{item.command_action_index:02d}_"
        if any(
            role in expected_raw_by_role
            for role in (
                prefix + "receipt",
                prefix + "stdout",
                prefix + "stderr",
            )
        ):
            fail("command action evidence index aliases")
        expected_raw_by_role.update({
            prefix + "receipt": item.guard_receipt_raw,
            prefix + "stdout": item.guard_stdout_raw,
            prefix + "stderr": item.guard_stderr_raw,
        })
    for action in envelope.get("darwinCodesignActions", ()):
        expected_raw_by_role.update({
            action["guardStdoutRole"]: b"",
            action["guardStderrRole"]: b"",
        })
    produced_by_role = dict(produced)
    for relative_path, planned in declared.items():
        row = post_files[relative_path]
        if (
            row["role"] != planned["role"]
            or row["mode"] != planned["finalMode"]
        ):
            fail("closed tree role or final mode drifted")
        role = planned["role"]
        identity = produced_by_role.get(role)
        if identity is not None:
            expected_relative = str(
                identity_host_path(identity).relative_to(
                    state.paths.evidence
                )
            )
            if (
                relative_path != expected_relative
                or row["sha256"] != identity.sha256
                or row["device"] != identity.device
                or row["inode"] != identity.inode
                or row["size"] != identity.size
                or row["mode"] != stat.S_IMODE(identity.mode)
            ):
                fail("closed tree business output identity drifted")
            continue
        if role not in expected_raw_by_role:
            fail("closed tree auxiliary role is unknown")
        raw = expected_raw_by_role[role]
        if (
            row["sha256"] != sha256_bytes(raw)
            or row["size"] != len(raw)
        ):
            fail("closed tree auxiliary bytes drifted")
    terminal_path = envelope["terminalRelativePath"]
    stdout_path = str(Path(terminal_path).with_name("action.stdout"))
    if (
        post_files[terminal_path]["sha256"]
            != post_files[stdout_path]["sha256"]
        or post_files[terminal_path]["inode"]
            == post_files[stdout_path]["inode"]
    ):
        fail("terminal and action stdout are not exact independent copies")
    return post_directories, post_files


def phase_terminal_artifact_payload(
    state: PhaseState,
    identity: ArtifactIdentity,
) -> dict[str, Any]:
    payload = identity.payload()
    if state.boundary.lane == LANE_LINUX:
        guest_path = linux_guest_path_for_host(
            state, identity_host_path(identity)
        )
        payload = {
            **payload,
            "pathFshex": os.fsencode(guest_path).hex(),
            "uid": 1,
            "gid": 1,
        }
    return payload


def validate_phase_row_receipt_raw(
    raw: bytes,
    *,
    state: PhaseState,
    envelope: Mapping[str, Any],
    guard_raw: bytes,
    command_action_evidence: Sequence[CommandActionRawEvidence],
    stage_input_raw: bytes,
    produced: Mapping[str, ArtifactIdentity],
) -> str:
    if not raw.endswith(b"\n"):
        fail("phase row receipt lacks terminal newline")
    value = strict_canonical_json(raw[:-1], "phase row receipt")
    if (
        not isinstance(value, dict)
        or set(value) != {"payload", "payloadSha256"}
        or not isinstance(value["payload"], dict)
    ):
        fail("phase row receipt envelope drifted")
    payload = value["payload"]
    expected_keys = set(phase_action_terminal_fields(
        state.boundary.lane, state.next_phase_index
    ))
    if set(payload) != expected_keys:
        fail("phase row payload fields drifted")
    planned_roles = tuple(
        item["role"] for item in envelope["plannedOutputs"]
    )
    produced_payload = [
        {
            "role": role,
            "identity": phase_terminal_artifact_payload(
                state, produced[role]
            ),
        }
        for role in planned_roles
    ]
    expected_actions = []
    for action in envelope["phaseActions"]:
        expected_actions.append({
            "actionIndex": action["actionIndex"],
            "kind": action["kind"],
            "operation": action["operation"],
            "status": (
                "PENDING_OUTER_PROOF"
                if action["kind"] == "runner_authority"
                else "PROVED"
            ),
            "outputRoles": action["outputRoles"],
        })
    action_receipts = []
    if "phaseCommandActions" in envelope:
        evidence_by_index = {
            item.command_action_index: item
            for item in command_action_evidence
        }
        tree_by_index = {
            item.get("commandActionIndex"): item
            for item in envelope["commandActionPrivateFrozenTrees"]
            if isinstance(item, dict)
        }
        if (
            len(evidence_by_index) != len(command_action_evidence)
            or set(evidence_by_index)
                != set(range(len(envelope["phaseCommandActions"])))
            or set(tree_by_index)
                != set(range(len(envelope["phaseCommandActions"])))
            or guard_raw
        ):
            fail("multi-action guard evidence set drifted")
        action_receipts = [{
            "commandActionIndex": action["commandActionIndex"],
            "targetExecutableRole":
                action["targetExecutableRole"],
            "targetArgvSha256": action["targetArgvSha256"],
            "guardReceiptSha256": sha256_bytes(
                evidence_by_index[
                    action["commandActionIndex"]
                ].guard_receipt_raw
            ),
            "guardStdoutSha256": sha256_bytes(
                evidence_by_index[
                    action["commandActionIndex"]
                ].guard_stdout_raw
            ),
            "guardStderrSha256": sha256_bytes(
                evidence_by_index[
                    action["commandActionIndex"]
                ].guard_stderr_raw
            ),
            "businessOutputRoles":
                action["businessOutputRoles"],
            "privateFrozenTree": (
                tree_by_index[
                    action["commandActionIndex"]
                ]["tree"]
                if tree_by_index[
                    action["commandActionIndex"]
                ]["bindingMode"] == "exact_prebound"
                else private_frozen_tree_binding(Path(
                    action["privateFrozenTree"]["root"]
                ))
            ),
        } for action in envelope["phaseCommandActions"]]
    elif command_action_evidence:
        fail("single-command phase acquired action evidence")
    expected_payload = {
        "schema": PHASE_ACTION_TERMINAL_SCHEMA,
        "status": "PROVED",
        "lane": state.boundary.lane,
        "targetTriple": LANE_TARGET_TRIPLE[state.boundary.lane],
        "machineAuthority":
            LANE_MACHINE_AUTHORITY[state.boundary.lane],
        "phaseIndex": state.next_phase_index,
        "phaseLabel": PHASE_SPECS[state.next_phase_index].label,
        "phasePlanSha256": envelope["phasePlanSha256"],
        "runnerArgvSha256": envelope["runnerArgvSha256"],
        **(
            {
                "phaseCommandActionsSha256":
                    envelope["phaseCommandActionsSha256"],
                "commandActionReceipts": action_receipts,
                "guardReceiptsAggregateSha256": sha256_bytes(
                    canonical_json(action_receipts)
                ),
            }
            if action_receipts else {
                "phaseCommandArgvSha256":
                    envelope["phaseCommandArgvSha256"],
                "guardReceiptSha256": sha256_bytes(guard_raw),
            }
        ),
        "phaseEnvSha256": envelope["phaseEnvSha256"],
        "stageInputManifestSha256": sha256_bytes(stage_input_raw),
        "terminalRelativePath": envelope["terminalRelativePath"],
        "declaredDeltaDirectories":
            envelope["declaredDeltaDirectories"],
        "declaredDeltaFiles": envelope["declaredDeltaFiles"],
        "declaredOutputSetSha256":
            envelope["declaredOutputSetSha256"],
        "actions": expected_actions,
        "produced": produced_payload,
    }
    payload_sha = canonical_sha256(
        value["payloadSha256"], "phase row payload"
    )
    if (
        payload != expected_payload
        or payload_sha != sha256_bytes(canonical_json(payload))
    ):
        fail("phase row does not bind exact plan, actions, and outputs")
    return payload_sha


