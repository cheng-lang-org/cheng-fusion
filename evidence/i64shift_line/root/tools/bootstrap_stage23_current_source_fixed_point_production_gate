    rootfs_entry_count: int
    rootfs_delegate_uid: int
    rootfs_delegate_gid: int
    rootfs_mount_authority_raw: bytes

    def __post_init__(self) -> None:
        for path, label, directory in (
            (self.delegation_manifest, "delegation manifest", False),
            (self.cgroup_parent, "cgroup parent", True),
            (self.crun, "crun", False),
            (self.rootfs, "rootfs", True),
            (self.rootfs_manifest, "rootfs manifest", False),
        ):
            if (
                not path.is_absolute()
                or path.resolve(strict=True) != path
                or path.is_symlink()
                or (path.is_dir() if directory else path.is_file()) is False
            ):
                fail("Linux authority input is not exact: " + label)
        if (
            self.boundary.lane != LANE_LINUX
            or self.boundary.cgroup_leaf is None
            or self.crun_identity.artifact_format != FORMAT_ELF64_X86_64
            or self.rootfs_manifest_identity.artifact_format != FORMAT_REGULAR
            or self.rootfs_manifest_identity.path_fshex
                != os.fsencode(str(self.rootfs_manifest)).hex()
            or self.rootfs_manifest_identity.sha256
                != sha256_bytes(self.rootfs_manifest_raw)
            or self.rootfs_entry_count <= 0
            or self.rootfs_delegate_uid <= 0
            or self.rootfs_delegate_gid <= 0
            or not self.rootfs_mount_authority_raw
        ):
            fail("Linux authority input target or cgroup boundary drifted")
        try:
            mount_authority = json.loads(
                self.rootfs_mount_authority_raw.decode("utf-8")
            )
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ProductionFailure(
                "Linux rootfs mount authority is not canonical JSON"
            ) from exc
        if canonical_json(mount_authority) != self.rootfs_mount_authority_raw:
            fail("Linux rootfs mount authority is not canonical JSON")
        canonical_sha256(self.rootfs_tree_cid, "rootfs tree CID")


def artifact_identity_from_validator_file(
    file: Any,
    *,
    executable: bool,
) -> ArtifactIdentity:
    observed, _raw = stable_artifact(file.path, executable=executable)
    if (
        observed.sha256 != file.sha256
        or observed.device != file.device
        or observed.inode != file.inode
        or observed.size != file.size
        or observed.mode != file.mode
        or observed.uid != file.uid
        or observed.gid != file.gid
    ):
        fail("validator and production artifact identities differ")
    return observed


def capture_linux_authority_inputs(
    delegation_manifest: Path,
    cgroup_parent: Path,
    crun: Path,
    rootfs: Path,
    rootfs_manifest: Path,
    *,
    verify_tree: bool = True,
) -> LinuxAuthorityInputs:
    if sys.platform != "linux" or os.uname().machine != "x86_64":
        fail("native x86_64 Linux authority host is required")
    delegation = linux_cgroup_validator.parse_delegation_manifest(
        delegation_manifest,
        require_root_owner=True,
    )
    linux_cgroup_validator.validate_live_delegation(
        delegation, cgroup_parent
    )
    crun_file = linux_cgroup_validator.stable_read(
        crun, "Linux crun", 256 * 1024 * 1024
    )
    linux_cgroup_validator.require_unprivileged_executable(
        crun_file, "Linux crun"
    )
    crun_identity = artifact_identity_from_validator_file(
        crun_file, executable=True
    )
    rootfs_value = linux_cgroup_validator.validate_rootfs_manifest(
        rootfs_manifest,
        rootfs,
        crun_file.sha256,
        verify_tree=verify_tree,
    )
    if (
        rootfs_value.delegate_uid != int(delegation.rows["delegate_uid"])
        or rootfs_value.delegate_gid != int(delegation.rows["delegate_gid"])
    ):
        fail("Linux rootfs and cgroup delegation identities differ")
    rootfs_required = {
        "bin/bash": rootfs / "bin/bash",
        "usr/bin/python3": rootfs / "usr/bin/python3",
        "usr/bin/cc": rootfs / "usr/bin/cc",
    }
    for relative, path in rootfs_required.items():
        identity, _raw = stable_artifact(path, executable=True)
        if identity.artifact_format != FORMAT_ELF64_X86_64:
            fail("Linux rootfs executable target drifted: " + relative)
    rootfs_manifest_identity = artifact_identity_from_validator_file(
        rootfs_value.file,
        executable=False,
    )
    rows = delegation.rows
    boundary = LaneBoundary(
        LANE_LINUX,
        LINUX_MEMORY_PROOF,
        CgroupLeafIdentity(
            mount_device=int(rows["cgroup_mount_device"]),
            mount_inode=int(rows["cgroup_mount_inode"]),
            namespace_inode=int(rows["cgroup_namespace_inode"]),
            parent_device=int(rows["parent_device"]),
            parent_inode=int(rows["parent_inode"]),
            leaf_device=int(rows["controller_device"]),
            leaf_inode=int(rows["controller_inode"]),
            leaf_path_fshex=rows["controller_path_fshex"],
        ),
    )
    return LinuxAuthorityInputs(
        delegation_manifest=delegation.file.path,
        cgroup_parent=delegation.parent,
        crun=crun_file.path,
        rootfs=rootfs_value.rootfs,
        rootfs_manifest=rootfs_value.file.path,
        delegation_raw=delegation.file.raw,
        rootfs_manifest_raw=rootfs_value.file.raw,
        crun_identity=crun_identity,
        rootfs_manifest_identity=rootfs_manifest_identity,
        boundary=boundary,
        rootfs_tree_cid=rootfs_value.tree_cid,
        rootfs_entry_count=rootfs_value.entry_count,
        rootfs_delegate_uid=rootfs_value.delegate_uid,
        rootfs_delegate_gid=rootfs_value.delegate_gid,
        rootfs_mount_authority_raw=canonical_json(
            rootfs_value.mount_authority,
        ),
    )


