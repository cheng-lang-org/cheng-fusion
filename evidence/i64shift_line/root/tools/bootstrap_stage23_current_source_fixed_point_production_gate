def publisher_authority_receipt_bytes(
    values: Mapping[str, str],
) -> bytes:
    expected = PUBLISHER_AUTHORITY_KEY_ORDER[:-1]
    if tuple(values) != expected:
        fail("privileged publisher receipt fields drifted")
    prefix = "".join(
        key + "=" + values[key] + "\n" for key in expected
    ).encode("ascii", "strict")
    raw = prefix + (
        "publisher_receipt_sha256=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")
    parse_publisher_authority_receipt_bytes(raw)
    return raw


def parse_publisher_authority_receipt_bytes(
    raw: bytes,
) -> dict[str, str]:
    rows = parse_unique_kv(raw, "privileged publisher receipt")
    if tuple(rows) != PUBLISHER_AUTHORITY_KEY_ORDER:
        fail("privileged publisher receipt key order drifted")
    receipt_sha = canonical_sha256(
        rows["publisher_receipt_sha256"],
        "privileged publisher receipt self hash",
    )
    suffix = (
        "publisher_receipt_sha256=" + receipt_sha + "\n"
    ).encode("ascii")
    if (
        len(raw) > MAX_AUTHORITY_BYTES
        or rows["schema"] != PUBLISHER_AUTHORITY_SCHEMA
        or rows["status"] != "PUBLISHED"
        or rows["authentication_method"]
            != "root_fixed_path_external_immutable_anchor"
        or rows["production_execution_status"]
            != "PROVED_CROSS_PLATFORM_COMPOSITE"
        or rows["dynamic_completion_credit"] != "1"
        or receipt_sha != sha256_bytes(raw[:-len(suffix)])
        or rows["external_anchor_path_fshex"]
            != os.fsencode(str(LINUX_PORTABLE_ANCHOR_PATH)).hex()
        or rows["material_authority_path_fshex"]
            != os.fsencode(str(AUTHORITY_PATH)).hex()
        or rows["installed_stage3_path_fshex"]
            != os.fsencode(str(INSTALLED_STAGE3_PATH)).hex()
        or rows["composite_terminal_path_fshex"]
            != os.fsencode(str(COMPOSITE_TERMINAL_PATH)).hex()
        or rows["installed_stage3_format"] != FORMAT_MACHO_ARM64
    ):
        fail("privileged publisher receipt contract drifted")
    for key in (
        "production_gate_sha256",
        "authority_publisher_sha256",
        "verifier_inputs_cid",
        "external_anchor_sha256",
        "material_authority_sha256",
        "installed_stage3_sha256",
        "composite_terminal_sha256",
        "linux_lane_receipt_sha256",
        "darwin_lane_receipt_sha256",
        "linux_evidence_closure_cid",
        "darwin_evidence_closure_cid",
        "source_snapshot_cid",
        "generated_c_portable_cid",
        "linux_stage_fixed_point_sha256",
        "darwin_stage_fixed_point_sha256",
    ):
        canonical_sha256(rows[key], "privileged publisher " + key)
    integer_keys = (
        "external_anchor_device", "external_anchor_inode",
        "external_anchor_mode", "external_anchor_nlink",
        "external_anchor_size", "external_anchor_uid",
        "external_anchor_gid", "external_anchor_flags",
        "material_authority_device", "material_authority_inode",
        "material_authority_mode", "material_authority_nlink",
        "material_authority_size", "material_authority_uid",
        "material_authority_gid", "installed_stage3_device",
        "installed_stage3_inode", "installed_stage3_mode",
        "installed_stage3_nlink", "installed_stage3_size",
        "installed_stage3_uid", "installed_stage3_gid",
        "composite_terminal_device", "composite_terminal_inode",
        "composite_terminal_mode", "composite_terminal_nlink",
        "composite_terminal_size", "composite_terminal_uid",
        "composite_terminal_gid",
    )
    integers: dict[str, int] = {}
    for key in integer_keys:
        value = rows[key]
        if not re.fullmatch(r"0|[1-9][0-9]*", value):
            fail("privileged publisher integer is noncanonical")
        integers[key] = int(value)
    for prefix, mode, executable in (
        ("external_anchor", 0o400, False),
        ("material_authority", 0o400, False),
        ("installed_stage3", 0o500, True),
        ("composite_terminal", 0o400, False),
    ):
        if (
            integers[prefix + "_device"] <= 0
            or integers[prefix + "_inode"] <= 0
            or integers[prefix + "_nlink"] != 1
            or integers[prefix + "_size"] <= 0
            or integers[prefix + "_uid"] != 0
            or integers[prefix + "_gid"] != 0
            or not stat.S_ISREG(integers[prefix + "_mode"])
            or stat.S_IMODE(integers[prefix + "_mode"]) != mode
            or bool(integers[prefix + "_mode"] & 0o111)
                != executable
        ):
            fail("privileged publisher physical identity drifted")
    if integers["external_anchor_flags"] & SYSTEM_IMMUTABLE_FLAG == 0:
        fail("privileged publisher external anchor is not immutable")
    return rows
