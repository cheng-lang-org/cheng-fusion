        ),
        key=lambda item: len(item.parts),
        reverse=True,
    ):
        os.chmod(directory, 0o500)
    os.chmod(source_root, 0o500)
    os.chmod(root, 0o500)
    return with_darwin_action_input_root(
        state,
        root,
        0,
        0,
        "cc_phase00_action00",
        Path("toolchain/usr/bin/clang"),
    )


def materialize_darwin_phase1_action_inputs(
    state: PhaseState,
) -> PhaseState:
    if state.next_phase_index != 1:
        return state
    if "cc_phase01_action00" in state.frozen:
        return state
    toolchain_source = (
        state.paths.evidence
        / phase_engine.DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
    )
    root0 = state.paths.command_action_input_root(1, 0)
    copy_action_input_tree(toolchain_source, root0 / "toolchain")
    copy_action_input_tree(state.paths.snapshot, root0 / "source")
    os.chmod(root0, 0o500)
    state = with_darwin_action_input_root(
        state,
        root0,
        1,
        0,
        "cc_phase01_action00",
        Path("toolchain/usr/bin/clang"),
    )
    root1 = state.paths.command_action_input_root(1, 1)
    copy_action_input_tree(toolchain_source, root1 / "toolchain")
    os.chmod(root1, 0o500)
    state = with_darwin_action_input_root(
        state,
        root1,
        1,
        1,
        "darwin_ld_phase01_action01",
        Path("toolchain/usr/bin/ld"),
    )
    return state


def bind_existing_darwin_phase1_action_inputs(
    state: PhaseState,
) -> PhaseState:
    if state.next_phase_index != 1:
        return state
    if (
        "cc_phase01_action00" in state.frozen
        or "darwin_ld_phase01_action01" in state.frozen
    ):
        fail("physical phase1 action executable was already bound")
    bindings = (
        (
            0,
            "cc_phase01_action00",
            Path("toolchain/usr/bin/clang"),
        ),
        (
            1,
            "darwin_ld_phase01_action01",
            Path("toolchain/usr/bin/ld"),
        ),
    )
    for action_index, command_role, command_relative in bindings:
        root = state.paths.command_action_input_root(
            1, action_index
        )
        state = bind_existing_darwin_action_input_root(
            state,
            root,
            1,
            action_index,
            command_role,
            command_relative,
        )
    return state


def copy_linux_frozen_source_member(
    source: Path,
    destination: Path,
) -> None:
    source_identity, _source_raw = stable_artifact(
        source, executable=False
    )
    source_executable = bool(source_identity.mode & 0o111)
    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if destination.exists() or destination.is_symlink():
        fail("Linux frozen source destination already exists")
    shutil.copyfile(source, destination, follow_symlinks=False)
    final_mode = 0o500 if source_executable else 0o400
    os.chmod(destination, final_mode)
    destination_identity, _destination_raw = stable_artifact(
        destination, executable=False
    )
    source_after = stable_artifact(source, executable=False)[0]
    if (
        source_after != source_identity
        or destination_identity.sha256 != source_identity.sha256
        or destination_identity.size != source_identity.size
        or destination_identity.nlink != 1
        or stat.S_IMODE(destination_identity.mode) != final_mode
    ):
