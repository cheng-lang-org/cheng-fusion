            != LANE_TARGET_TRIPLE[LANE_DARWIN]
        or rows["darwin_machine_authority"]
            != LANE_MACHINE_AUTHORITY[LANE_DARWIN]
        or rows["darwin_installed_stage3_sha256"]
            != rows["darwin_stage_fixed_point_sha256"]
    ):
        fail("portable authority receipt contract drifted")
    for key in (
        "production_gate_sha256",
        "verifier_inputs_cid",
        "authority_receipt_sha256",
        "external_anchor_file_sha256",
        "external_anchor_contract_sha256",
        "linux_evidence_closure_cid",
        "linux_lane_receipt_sha256",
        "linux_phase_chain_sha256",
        "linux_cgroup_receipt_sha256",
        "linux_ptrace_aggregate_sha256",
        "linux_stage_fixed_point_sha256",
        "linux_generated_c_raw_sha256",
        "darwin_evidence_closure_cid",
        "darwin_lane_receipt_sha256",
        "darwin_phase_chain_sha256",
        "darwin_guard_aggregate_sha256",
        "darwin_stage_fixed_point_sha256",
        "darwin_generated_c_raw_sha256",
        "darwin_installed_stage3_sha256",
        "composite_terminal_sha256",
        "source_snapshot_cid",
