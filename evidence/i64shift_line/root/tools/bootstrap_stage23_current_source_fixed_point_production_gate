def private_frozen_tree_binding(root: Path) -> dict[str, Any]:
    if (
        not root.is_absolute()
        or root.resolve(strict=True) != root
        or root.is_symlink()
        or not root.is_dir()
    ):
        fail("private frozen tree root is not canonical")
    fields = (
        "st_dev",
        "st_ino",
        "st_mode",
        "st_nlink",
        "st_uid",
        "st_gid",
        "st_size",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    entries: list[tuple[str, str, str, tuple[int, ...]]] = []
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        directory_path = Path(directory)
        directory_info = os.lstat(directory_path)
        if (
            stat.S_ISLNK(directory_info.st_mode)
            or not stat.S_ISDIR(directory_info.st_mode)
        ):
            fail("private frozen tree contains a non-directory")
        entries.append((
            os.path.relpath(directory_path, root).replace(os.sep, "/"),
            "directory",
            "",
            tuple(
                int(getattr(directory_info, field)) for field in fields
            ),
        ))
        for name in directory_names:
            info = os.lstat(directory_path / name)
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                fail("private frozen tree contains a directory special node")
        for name in file_names:
            path = directory_path / name
            info, raw = phase_engine.read_exact_regular(
                path, "private frozen-tree file"
            )
            if info.st_nlink != 1:
                fail("private frozen tree contains a hard-linked file")
            named = os.lstat(path)
            entries.append((
                os.path.relpath(path, root).replace(os.sep, "/"),
                "regular",
                sha256_bytes(raw),
                tuple(int(getattr(named, field)) for field in fields),
            ))
    entries.sort(key=lambda item: (
        os.fsencode(item[0]),
        0 if item[1] == "directory" else 1,
    ))
    payload = bytearray(
        guard_text_frame(b"cheng.guard.private_frozen_tree_closure")
    )
    payload.extend(len(entries).to_bytes(4, "big"))
    for relative, kind, digest, identity in entries:
        payload.extend(guard_text_frame(os.fsencode(relative)))
        payload.extend(guard_text_frame(kind.encode("ascii")))
        payload.extend(struct.pack(
            ">QQQQQ",
            identity[2],
            identity[3],
            identity[4],
            identity[5],
            identity[6],
        ))
        payload.extend(
            bytes.fromhex(digest) if digest else b"\0" * 32
        )
    directory_count = sum(
        1 for item in entries if item[1] == "directory"
    )
    file_count = len(entries) - directory_count
    return {
        "schema": "cheng.guard.private_frozen_tree_binding",
        "root": str(root),
        "sha256": sha256_bytes(bytes(payload)),
        "entryCount": len(entries),
        "directoryCount": directory_count,
        "fileCount": file_count,
        "watchCount": len(entries),
        "watchCoverage":
            "root_all_directories_and_all_regular_files",
        "sameUidBoundary":
            "mutation_detected_not_malicious_same_uid_isolation",
    }


def physical_identity_payload(path: Path) -> dict[str, int]:
    info = os.lstat(path)
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
    ):
        fail("physical identity path is not a single-link regular file")
    return {
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "uid": info.st_uid,
        "gid": info.st_gid,
        "size": info.st_size,
        "mtimeNs": info.st_mtime_ns,
        "ctimeNs": info.st_ctime_ns,
    }


def strict_canonical_json(raw: bytes, label: str) -> Any:
    duplicate = False

    def pairs_hook(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        nonlocal duplicate
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                duplicate = True
            result[key] = value
        return result

    try:
        value = json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=pairs_hook,
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ProductionGateError(label + " is not strict JSON") from exc
    if duplicate or canonical_json(value) != raw:
        fail(label + " is not canonical JSON")
    return value


def stable_source_module_bytes(
    path: Path,
    label: str,
) -> tuple[bytes, tuple[int, ...]]:
    if not path.is_absolute():
        fail(label + " path is not absolute")
    before_path = os.lstat(path)
    if (
        not stat.S_ISREG(before_path.st_mode)
        or stat.S_ISLNK(before_path.st_mode)
        or before_path.st_nlink != 1
    ):
        fail(label + " source is not exact regular")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    fields = (
        "st_dev",
        "st_ino",
        "st_mode",
        "st_nlink",
        "st_size",
        "st_uid",
        "st_gid",
        "st_mtime_ns",
        "st_ctime_ns",
    )
    try:
        before = os.fstat(descriptor)
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(
                descriptor, min(1024 * 1024, remaining)
            )
            if not chunk:
                fail(label + " source short read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            fail(label + " source grew during read")
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after_path = os.lstat(path)
    identity = tuple(getattr(before, field) for field in fields)
    if (
        identity != tuple(getattr(after, field) for field in fields)
        or identity
            != tuple(getattr(before_path, field) for field in fields)
        or identity
            != tuple(getattr(after_path, field) for field in fields)
    ):
        fail(label + " source changed during stable read")
    raw = b"".join(chunks)
    if len(raw) != before.st_size:
        fail(label + " source size drifted")
    return raw, identity


