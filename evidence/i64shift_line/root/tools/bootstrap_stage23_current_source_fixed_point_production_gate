def is_transitive_executable_role(role: str) -> bool:
    return (
        role.startswith("transitive_")
        and role[len("transitive_"):].isdigit()
    )


def is_linux_frozen_regular_role(role: str) -> bool:
    local_source_role = (
        role.startswith("local_c_header_")
        and role[len("local_c_header_"):].isdigit()
        and int(role[len("local_c_header_"):])
            < len(LINUX_LOCAL_C_SOURCE_PATHS)
    )
    rootfs_argv_suffix = (
        role[len(LINUX_ROOTFS_IMMUTABLE_ARGV_ROLE_PREFIX):]
        if role.startswith(LINUX_ROOTFS_IMMUTABLE_ARGV_ROLE_PREFIX)
        else ""
    )
    rootfs_argv_role = (
        rootfs_argv_suffix.isdigit()
        and int(rootfs_argv_suffix)
            < len(LINUX_ROOTFS_IMMUTABLE_ARGV_ROLES)
        and role == LINUX_ROOTFS_IMMUTABLE_ARGV_ROLES[
            int(rootfs_argv_suffix)
        ]
    )
    return local_source_role or rootfs_argv_role


def is_darwin_frozen_executable_role(role: str) -> bool:
    return role in {"darwin_ld", "codesign"} or bool(re.fullmatch(
        r"(?:cc|darwin_ld)_phase(?:00|01)_action(?:00|01)",
        role,
    ))


def is_darwin_frozen_regular_role(role: str) -> bool:
    return role == "production_gate" or role in {
        "toolchain_discovery_guard_receipt",
        "toolchain_discovery_guard_stdout",
        "toolchain_discovery_guard_stderr",
    } or (
        role.startswith("local_c_header_")
        and role[len("local_c_header_"):].isdigit()
    ) or (
        role.startswith("darwin_toolchain_input_")
        and role[len("darwin_toolchain_input_"):].isdigit()
    )


