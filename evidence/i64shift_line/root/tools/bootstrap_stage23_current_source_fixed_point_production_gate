    )
    delegation_raw = stable_linux_evidence_raw(
        workload / "delegation-manifest.kv",
        "copied delegation manifest",
    )
    original_authority_raw = stable_linux_evidence_raw(
        bundle.authority_manifest, "phase authority input"
