        "darwin_phase_chain_sha256",
        "darwin_guard_aggregate_sha256",
        "darwin_stage_fixed_point_sha256",
        "darwin_generated_c_raw_sha256",
    ):
        canonical_sha256(rows[key], "Linux portable anchor " + key)
    return rows


def portable_authority_receipt_bytes(
    values: Mapping[str, str],
) -> bytes:
    expected = PORTABLE_AUTHORITY_RECEIPT_KEY_ORDER[:-1]
    if tuple(values) != expected:
        fail("portable authority receipt fields drifted")
    prefix = "".join(
        key + "=" + values[key] + "\n" for key in expected
    ).encode("utf-8")
    raw = prefix + (
        "portable_receipt_sha256=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")
    parse_portable_authority_receipt_bytes(raw)
    return raw


def parse_portable_authority_receipt_bytes(
    raw: bytes,
) -> dict[str, str]:
    if len(raw) > MAX_AUTHORITY_BYTES:
        fail("portable authority receipt exceeds the fixed byte limit")
    rows = parse_unique_kv(raw, "portable authority receipt")
    if tuple(rows) != PORTABLE_AUTHORITY_RECEIPT_KEY_ORDER:
        fail("portable authority receipt key order drifted")
    receipt_sha = canonical_sha256(
        rows["portable_receipt_sha256"],
        "portable authority receipt self hash",
    )
    suffix = (
        "portable_receipt_sha256=" + receipt_sha + "\n"
    ).encode("ascii")
    if (
        rows["schema"] != PORTABLE_AUTHORITY_RECEIPT_SCHEMA
        or rows["status"] != "CANDIDATE"
        or rows["issuer_platform"] != "darwin-arm64"
        or rows["authentication_method"]
            != "darwin_root_owned_sf_immutable_anchor_dual_lane_candidate"
        or rows["material_role"] != "candidate_material_only"
        or rows["production_authority"] != "unavailable"
        or rows["production_execution_identity_binding"] != "absent"
