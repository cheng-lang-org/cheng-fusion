def parse_lane_receipt_bytes(
    raw: bytes,
    expected: LaneReceipt,
) -> LaneReceipt:
    if (
        not isinstance(expected, LaneReceipt)
        or expected._authority_token
            is not _LANE_RECEIPT_AUTHORITY_TOKEN
    ):
        fail("lane receipt parser lacks completed phase authority")
    if not raw.endswith(b"\n") or len(raw) > MAX_AUTHORITY_BYTES:
        fail("lane receipt encoding is invalid")
    envelope = strict_canonical_json(raw[:-1], "lane receipt")
    if (
        not isinstance(envelope, dict)
        or tuple(sorted(envelope)) != ("payload", "payloadSha256")
        or not isinstance(envelope["payload"], dict)
        or tuple(sorted(envelope["payload"]))
            != tuple(sorted(LANE_RECEIPT_PAYLOAD_KEYS))
        or not isinstance(envelope["payloadSha256"], str)
    ):
        fail("lane receipt envelope fields drifted")
    payload = envelope["payload"]
    if payload["schema"] != LANE_RECEIPT_SCHEMA:
        fail("lane receipt schema drifted")
    payload_sha = canonical_sha256(
        envelope["payloadSha256"], "lane receipt payload"
    )
    if payload_sha != sha256_bytes(canonical_json(payload)):
        fail("lane receipt payload hash mismatch")
    for key in (
        "lane",
        "targetTriple",
        "machineAuthority",
        "status",
        "memoryProofStatus",
        "sourceSnapshotCid",
        "chengColdSha256",
        "bootstrapContractSha256",
        "selfCheckContractHash",
        "generatedCPortableCid",
        "generatedCRawSha256",
        "stageFixedPointSha256",
        "phaseChainSha256",
        "cgroupReceiptSha256",
        "ptraceAggregateSha256",
        "guardAggregateSha256",
    ):
        if not isinstance(payload[key], str):
            fail("lane receipt string field drifted")
    artifact_identity_from_payload(payload["stage3"], "lane stage3")
    if expected.receipt_bytes() != raw or expected.payload() != payload:
        fail("lane receipt differs from completed phase authority")
    return expected


def verified_lane_receipt_from_payload(
    payload: Mapping[str, Any],
    stage3: ArtifactIdentity,
    expected_lane: str,
) -> LaneReceipt:
    """Materialize authority only after the physical lane was replayed.

    Receipt JSON is never sufficient authority.  Callers must first replay the
    complete Darwin or Linux evidence closure, then pass the exact payload and
    artifact identity accepted by that replay through this constructor.
    """
    expected_lane = canonical_lane(expected_lane)
    if (
        not isinstance(payload, Mapping)
        or set(payload) != set(LANE_RECEIPT_PAYLOAD_KEYS)
        or payload.get("lane") != expected_lane
        or payload.get("stage3") != stage3.payload()
    ):
        fail("verified lane payload is not exact")
    return LaneReceipt(
        lane=expected_lane,
        target_triple=payload["targetTriple"],
        machine_authority=payload["machineAuthority"],
        status=payload["status"],
        memory_proof_status=payload["memoryProofStatus"],
        source_snapshot_cid=payload["sourceSnapshotCid"],
        cheng_cold_sha256=payload["chengColdSha256"],
        bootstrap_contract_sha256=payload["bootstrapContractSha256"],
        self_check_contract_hash=payload["selfCheckContractHash"],
        generated_c_portable_cid=payload["generatedCPortableCid"],
        generated_c_raw_sha256=payload["generatedCRawSha256"],
        stage_fixed_point_sha256=payload["stageFixedPointSha256"],
        phase_chain_sha256=payload["phaseChainSha256"],
        cgroup_receipt_sha256=payload["cgroupReceiptSha256"],
        ptrace_aggregate_sha256=payload["ptraceAggregateSha256"],
        guard_aggregate_sha256=payload["guardAggregateSha256"],
        stage3=stage3,
        _authority_token=_LANE_RECEIPT_AUTHORITY_TOKEN,
    )


