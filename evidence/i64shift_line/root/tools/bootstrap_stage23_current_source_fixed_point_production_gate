        **{
            f"local_c_header_{index:04d}": path
            for index, path in enumerate(LINUX_LOCAL_C_SOURCE_PATHS)
        },
    }
    role_paths = {
        "bash": authority.rootfs / "bin/bash",
        "python": authority.rootfs / "usr/bin/python3",
        "cc": authority.rootfs / "usr/bin/cc",
        **{
            role: authority.rootfs / Path(guest_path).relative_to("/")
            for role, guest_path in zip(
                LINUX_ROOTFS_IMMUTABLE_ARGV_ROLES,
                linux_cgroup_validator.ROOTFS_IMMUTABLE_ARGV_GUEST_PATHS,
            )
        },
        **{
            role: source_root / path.relative_to(ROOT)
            for role, path in source_paths.items()
        },
    }
    identities = {
        role: stable_artifact(
            path,
            executable=role in STATIC_EXECUTABLE_ROLES,
        )[0]
        for role, path in role_paths.items()
    }
    guest_paths = {
        role: expected_linux_guest_path(role) for role in identities
