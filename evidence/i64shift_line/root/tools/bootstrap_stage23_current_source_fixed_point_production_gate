def reconstruct_darwin_physical_evidence(
    evidence_root: Path,
) -> tuple[PhaseState, LaneReceipt]:
    if (
        not evidence_root.is_absolute()
        or evidence_root.resolve(strict=True) != evidence_root
        or evidence_root.is_symlink()
        or not evidence_root.is_dir()
    ):
        fail("physical evidence root is not canonical")
    lane_evidence = evidence_root / LANE_DARWIN
    exact_existing_completed_evidence_directory(lane_evidence)
    phase0_path = (
        lane_evidence
        / darwin_stage_input_manifest_relative_path(0)
    )
    _phase0_info, phase0_raw = phase_engine.read_exact_regular(
        phase0_path, "physical phase0 stage input manifest"
    )
    phase0_manifest = strict_canonical_json(
        phase0_raw[:-1], "physical phase0 stage input manifest"
    ) if phase0_raw.endswith(b"\n") else fail(
        "physical phase0 stage input manifest newline drifted"
    )
    if (
        not isinstance(phase0_manifest, dict)
        or set(phase0_manifest) != set(
            STAGE_INPUT_MANIFEST_MULTI_ACTION_FIELDS
        )
        or phase0_manifest.get("lane") != LANE_DARWIN
        or phase0_manifest.get("phaseIndex") != 0
    ):
        fail("physical phase0 stage input manifest fields drifted")
    state = physical_initial_darwin_state(
        lane_evidence, phase0_manifest
    )
    for index in range(len(PHASE_SPECS)):
        if state.next_phase_index != index:
            fail("physical Darwin phase order drifted")
        state = bind_existing_darwin_phase1_action_inputs(state)
        manifest_path = (
            lane_evidence
            / darwin_stage_input_manifest_relative_path(index)
        )
        manifest_identity, manifest_raw = stable_artifact(
            manifest_path, executable=False
        )
        allowlist = darwin_phase_allowlist(state)
        frozen_envelope = next_phase_envelope(state, allowlist)
        frozen_envelope_sha256 = sha256_bytes(
            canonical_json(frozen_envelope)
        )
        expected_manifest_raw = stage_input_manifest_raw_from_envelope(
            state, frozen_envelope
        )
        if manifest_raw != expected_manifest_raw:
            fail("physical Darwin stage input manifest drifted")
        evidence = physical_phase_raw_evidence(
            state,
            allowlist,
            manifest_raw,
            manifest_identity,
        )
        advanced = advance_phase(
            state,
            allowlist,
            evidence,
            frozen_envelope,
            frozen_envelope_sha256,
        )
        outer_path = (
            lane_evidence
            / f"phase-receipts/{index:02d}/outer-terminal.json"
        )
        _outer_identity, outer_raw = stable_artifact(
            outer_path, executable=False
        )
        outer = parse_outer_phase_terminal_bytes(outer_raw)
        if outer != advanced.terminals[-1]:
            fail("physical Darwin outer terminal authority drifted")
        state = phase_state_with_closed_file(
            advanced, outer_path, "outer_phase_terminal"
        )
    expected_chain_raw = physical_phase_chain_manifest_bytes(state)
    chain_path = lane_evidence / PHYSICAL_PHASE_CHAIN_RELATIVE_PATH
    chain_identity, chain_raw = stable_artifact(
        chain_path, executable=False
    )
    if (
        chain_raw != expected_chain_raw
        or chain_identity.sha256 != sha256_bytes(expected_chain_raw)
    ):
        fail("physical Darwin phase chain manifest drifted")
    state = phase_state_with_closed_file(
        state, chain_path, "physical_phase_chain_manifest"
    )
    observed_files, observed_directories = scan_evidence_tree(
        lane_evidence
    )
    if (
        observed_files != set(state.closed_tree_files)
        or observed_directories != set(state.closed_tree_directories)
    ):
        fail("physical Darwin final evidence tree is not exact")
    generated_identity = state.frozen["stage3_generated_c"]
    _generated_observed, generated_raw = stable_artifact(
        identity_host_path(generated_identity), executable=False
    )
    contract_identity = state.frozen["snapshot_contract"]
    _contract_observed, contract_raw = stable_artifact(
        identity_host_path(contract_identity), executable=False
    )
    generated_proof = generated_c_portable_proof(
        generated_raw,
        snapshot_root=state.paths.snapshot,
        impl_identity=state.frozen["snapshot_bootstrap"],
        contract_identity=contract_identity,
        normalized_contract=canonical_bootstrap_contract_bytes(
            contract_raw
        ),
    )
    receipt = lane_receipt_from_completed_state(
        state, generated_proof
    )
    receipt_path = (
        evidence_root / DARWIN_LANE_RECEIPT_RELATIVE_PATH
    )
    receipt_parent = receipt_path.parent
    exact_existing_completed_evidence_directory(receipt_parent)
    if set(evidence_root.iterdir()) != {
        lane_evidence, receipt_parent
    } or set(receipt_parent.iterdir()) != {receipt_path}:
        fail("physical Darwin evidence root file set drifted")
    _receipt_identity, receipt_raw = stable_artifact(
        receipt_path, executable=False
    )
    if parse_lane_receipt_bytes(receipt_raw, receipt) != receipt:
        fail("physical Darwin lane receipt drifted")
    return state, receipt


def validate_darwin_physical_evidence(
    evidence_root: Path,
) -> tuple[PhaseState, LaneReceipt]:
    return reconstruct_darwin_physical_evidence(evidence_root)


def recapture_linux_authority(
    authority: LinuxAuthorityInputs,
    *,
    verify_tree: bool = False,
) -> Any:
    delegation = linux_cgroup_validator.parse_delegation_manifest(
        authority.delegation_manifest,
        require_root_owner=True,
    )
    linux_cgroup_validator.validate_live_delegation(
        delegation,
        authority.cgroup_parent,
    )
    crun_file = linux_cgroup_validator.stable_read(
        authority.crun, "Linux authority crun", 256 * 1024 * 1024
    )
    linux_cgroup_validator.require_unprivileged_executable(
        crun_file,
        "Linux authority crun",
    )
    crun_identity = artifact_identity_from_validator_file(
        crun_file,
        executable=True,
    )
    if verify_tree:
        rootfs_binding = linux_cgroup_validator.validate_rootfs_manifest(
            authority.rootfs_manifest,
            authority.rootfs,
            crun_file.sha256,
            verify_tree=True,
        )
    else:
        rootfs_file = linux_cgroup_validator.stable_read(
            authority.rootfs_manifest,
            "Linux rootfs manifest authority",
            64 * 1024 * 1024,
        )
        mount_authority = linux_cgroup_validator.rootfs_mount_authority(
            authority.rootfs,
        )
        rootfs_binding = linux_cgroup_validator.RootfsManifest(
            file=rootfs_file,
            rootfs=authority.rootfs,
            tree_cid=authority.rootfs_tree_cid,
            crun_sha256=crun_file.sha256,
            entry_count=authority.rootfs_entry_count,
            delegate_uid=authority.rootfs_delegate_uid,
            delegate_gid=authority.rootfs_delegate_gid,
            mount_authority=mount_authority,
        )
    rootfs_manifest_identity = artifact_identity_from_validator_file(
        rootfs_binding.file,
        executable=False,
    )
    rows = delegation.rows
    boundary = LaneBoundary(
        LANE_LINUX,
        LINUX_MEMORY_PROOF,
        CgroupLeafIdentity(
            mount_device=int(rows["cgroup_mount_device"]),
            mount_inode=int(rows["cgroup_mount_inode"]),
            namespace_inode=int(rows["cgroup_namespace_inode"]),
            parent_device=int(rows["parent_device"]),
            parent_inode=int(rows["parent_inode"]),
            leaf_device=int(rows["controller_device"]),
            leaf_inode=int(rows["controller_inode"]),
            leaf_path_fshex=rows["controller_path_fshex"],
        ),
    )
    if (
        delegation.file.raw != authority.delegation_raw
        or delegation.file.path != authority.delegation_manifest
        or delegation.parent != authority.cgroup_parent
        or crun_identity != authority.crun_identity
        or rootfs_binding.file.raw != authority.rootfs_manifest_raw
        or rootfs_manifest_identity != authority.rootfs_manifest_identity
        or rootfs_binding.tree_cid != authority.rootfs_tree_cid
        or rootfs_binding.entry_count != authority.rootfs_entry_count
        or rootfs_binding.delegate_uid != authority.rootfs_delegate_uid
        or rootfs_binding.delegate_gid != authority.rootfs_delegate_gid
        or canonical_json(rootfs_binding.mount_authority)
            != authority.rootfs_mount_authority_raw
        or rootfs_binding.delegate_uid != int(rows["delegate_uid"])
        or rootfs_binding.delegate_gid != int(rows["delegate_gid"])
        or boundary != authority.boundary
    ):
        fail("Linux authority inputs changed across phase execution")
    return rootfs_binding


