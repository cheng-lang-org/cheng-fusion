def detect_executable_format(raw: bytes) -> str:
    if (
        len(raw) >= 20
        and raw[:4] == b"\x7fELF"
        and raw[4] == 2
        and raw[5] == 1
        and raw[6] == 1
        and int.from_bytes(raw[18:20], "little")
            == ELF_MACHINE_X86_64
    ):
        return FORMAT_ELF64_X86_64
    if (
        len(raw) >= 12
        and raw[:4] == b"\xcf\xfa\xed\xfe"
        and int.from_bytes(raw[4:8], "little")
            == MACHO_CPU_TYPE_ARM64
    ):
        return FORMAT_MACHO_ARM64
    if len(raw) >= 8 and raw[:4] == b"\xca\xfe\xba\xbe":
        architecture_count = int.from_bytes(raw[4:8], "big")
        if (
            0 < architecture_count <= 32
            and len(raw) >= 8 + architecture_count * 20
            and any(
                int.from_bytes(
                    raw[8 + index * 20:12 + index * 20],
                    "big",
                ) == MACHO_CPU_TYPE_ARM64
                for index in range(architecture_count)
            )
        ):
            return FORMAT_MACHO_UNIVERSAL_ARM64
    return FORMAT_REGULAR


