    create_exclusive_private_child_directory(lane_root, "phase-inputs")
    create_exclusive_private_child_directory(lane_root, "phase-authority")
    source_root = materialize_linux_lane_source_root(lane_root)
    source_paths = {
        "process_guard": PROCESS_GUARD,
        "process_guard_runtime": PROCESS_GUARD_RUNTIME,
        "stage_gate": INNER_GATE,
