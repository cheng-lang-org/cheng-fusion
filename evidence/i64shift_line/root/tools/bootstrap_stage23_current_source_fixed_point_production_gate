def parse_unique_kv(raw: bytes, label: str) -> dict[str, str]:
    if not raw or not raw.endswith(b"\n") or b"\r" in raw or b"\0" in raw:
        fail(label + " encoding is not canonical")
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeDecodeError as exc:
        raise ProductionGateError(label + " is not UTF-8") from exc
    rows: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if (
            not separator
            or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]*", key)
            or key in rows
            or "\n" in value
        ):
            fail(label + " row is malformed or duplicate")
        rows[key] = value
    return rows


def expected_command_output_roles(plan: Mapping[str, Any]) -> tuple[str, ...]:
    actions = [
        action for action in plan["actions"]
        if action["kind"] == "command"
    ]
    if plan["phaseIndex"] == 10:
        if actions or plan.get("argv") or plan.get("commandActions"):
            fail("pure fixed-point phase acquired a command action")
        return ()
    expected_count = len(plan.get("commandActions", ())) or 1
    if len(actions) != expected_count:
        fail("phase plan command action count drifted")
    business: list[str] = []
    for action in actions:
        roles = action.get("businessOutputRoles")
        if not isinstance(roles, list):
            fail("phase command business output roles are absent")
        business.extend(roles)
    if len(business) != len(set(business)):
        fail("phase command business output roles alias")
    return tuple(business)


def validate_pure_fixed_point_receipt_raw(
    raw: bytes,
    state: PhaseState,
    produced: Mapping[str, ArtifactIdentity],
) -> dict[str, str]:
    if not raw.endswith(b"\n"):
        fail("pure fixed-point receipt lacks terminal newline")
    value = strict_canonical_json(
        raw[:-1], "pure fixed-point receipt"
    )
    if (
        not isinstance(value, dict)
        or set(value) != {"payload", "payloadSha256"}
        or not isinstance(value["payload"], dict)
    ):
        fail("pure fixed-point receipt envelope drifted")
    report = produced.get("fixed_point_report")
    if report is None or set(produced) != {"fixed_point_report"}:
        fail("pure fixed-point receipt output authority drifted")
    stage2 = state.frozen["stage2"]
    stage3 = state.frozen["stage3"]

    def physical(identity: ArtifactIdentity) -> dict[str, Any]:
        return {
            "sha256": identity.sha256,
            "device": identity.device,
            "inode": identity.inode,
            "size": identity.size,
            "mode": identity.mode,
            "nlink": identity.nlink,
        }

    payload = value["payload"]
    expected_payload = {
        "schema":
            "cheng.bootstrap_stage23_pure_fixed_point_validator",
        "status": "completed",
        "phaseIndex": 10,
        "operation": "verify_stage2_stage3_physical_bytes_and_hash",
        "externalExecCount": 0,
        "stage2": physical(stage2),
        "stage3": physical(stage3),
        "fixedPointReport": report.payload(),
        "byteEqualityStatus": "verified",
        "hashEqualityStatus": "verified",
    }
    if (
        state.next_phase_index != 10
        or stage2.sha256 != stage3.sha256
        or stage2.size != stage3.size
        or payload != expected_payload
        or value["payloadSha256"]
            != sha256_bytes(canonical_json(payload))
    ):
        fail("pure fixed-point receipt authority drifted")
    return {"status": "completed"}


