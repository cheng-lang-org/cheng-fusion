def materialize_linux_lane_source_root(lane_root: Path) -> Path:
    source_root = create_exclusive_private_child_directory(
        lane_root, "frozen-source"
    )
    live_paths = {
        PROCESS_GUARD,
        PROCESS_GUARD_RUNTIME,
        INNER_GATE,
        PHASE_ENGINE,
        ROOT / "bootstrap/cheng_cold.c",
        ROOT / "bootstrap/stage1_bootstrap.cheng",
        ROOT / BOOTSTRAP_MANIFEST_RELATIVE,
        ROOT / PACKAGE_MANIFEST_RELATIVE,
        ROOT / "src/tests/t78_matrix/t7.cheng",
        *LINUX_LOCAL_C_SOURCE_PATHS,
    }
    ordered: list[tuple[Path, Path]] = []
    for source in live_paths:
        try:
            relative = source.relative_to(ROOT)
        except ValueError as exc:
            raise ProductionGateError(
                "Linux frozen source member escaped repository root"
            ) from exc
        ordered.append((relative, source))
    ordered.sort(key=lambda item: os.fsencode(item[0].as_posix()))
    if (
        not ordered
        or len(ordered) != len({relative for relative, _source in ordered})
    ):
        fail("Linux frozen source closure is empty or aliases")
    for relative, source in ordered:
        copy_linux_frozen_source_member(source, source_root / relative)
    for directory in sorted(
        (
            item for item in source_root.rglob("*")
            if item.is_dir() and not item.is_symlink()
        ),
        key=lambda item: len(item.parts),
        reverse=True,
    ):
        os.chmod(directory, 0o500)
    os.chmod(source_root, 0o500)
    frozen_paths = (source_root, *source_root.rglob("*"))
    for path in frozen_paths:
        info = os.lstat(path)
        if (
            stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode)
                != (0o500 if stat.S_ISDIR(info.st_mode) else (
                    0o500 if stat.S_ISREG(info.st_mode)
                    and info.st_mode & 0o111 else 0o400
                ))
            or (
                stat.S_ISREG(info.st_mode)
                and info.st_nlink != 1
            )
            or not (
                stat.S_ISDIR(info.st_mode)
                or stat.S_ISREG(info.st_mode)
            )
        ):
            fail("Linux frozen source closure is not owner-read-only")
    frozen_phase_engine = source_root / PHASE_ENGINE.relative_to(ROOT)
    _frozen_phase_identity, frozen_phase_raw = stable_artifact(
        frozen_phase_engine,
        executable=False,
    )
    live_phase_raw, live_phase_identity = stable_source_module_bytes(
        PHASE_ENGINE,
        "phase engine after Linux source freeze",
    )
    if (
        frozen_phase_raw != PHASE_ENGINE_EXECUTED_RAW
        or live_phase_raw != PHASE_ENGINE_EXECUTED_RAW
        or live_phase_identity != PHASE_ENGINE_EXECUTED_IDENTITY
    ):
        fail("Linux frozen phase engine differs from executed authority")
    binding = private_frozen_tree_binding(source_root)
    if (
        binding["fileCount"] != len(ordered)
        or binding["entryCount"] < binding["fileCount"]
        or binding["directoryCount"] <= 0
    ):
        fail("Linux frozen source closure materialization drifted")
    return source_root


def linux_initial_phase_state(
    lane_root: Path,
    authority: LinuxAuthorityInputs,
) -> PhaseState:
    if (
        not lane_root.is_absolute()
        or not lane_root.is_dir()
