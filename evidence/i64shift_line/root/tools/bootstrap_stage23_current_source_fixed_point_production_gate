def parse_composite_terminal_bytes(
    raw: bytes,
    expected: CompositeTerminal,
) -> CompositeTerminal:
    if not isinstance(expected, CompositeTerminal):
        fail("composite parser lacks completed lane authority")
    if not raw.endswith(b"\n") or len(raw) > MAX_AUTHORITY_BYTES:
        fail("composite terminal encoding is invalid")
    envelope = strict_canonical_json(raw[:-1], "composite terminal")
    if (
        not isinstance(envelope, dict)
        or tuple(sorted(envelope)) != ("payload", "payloadSha256")
        or not isinstance(envelope["payload"], dict)
        or tuple(sorted(envelope["payload"]))
            != tuple(sorted(COMPOSITE_PAYLOAD_KEYS))
        or not isinstance(envelope["payloadSha256"], str)
    ):
        fail("composite terminal envelope fields drifted")
    payload = envelope["payload"]
    if (
        payload["schema"] != COMPOSITE_SCHEMA
        or payload["status"] != "PROVED"
    ):
        fail("composite terminal schema or status drifted")
    if canonical_sha256(
        envelope["payloadSha256"], "composite payload"
    ) != sha256_bytes(canonical_json(payload)):
        fail("composite terminal payload hash mismatch")
    for key in COMPOSITE_PAYLOAD_KEYS:
        if key != "darwinStage3" and not isinstance(payload[key], str):
            fail("composite terminal string field drifted")
    artifact_identity_from_payload(
        payload["darwinStage3"], "composite Darwin stage3"
    )
    if expected.receipt_bytes() != raw or expected.payload() != payload:
        fail("composite differs from completed lane authority")
    return expected


def compose_terminal(
    linux: LaneReceipt,
    darwin: LaneReceipt,
) -> CompositeTerminal:
    if not isinstance(linux, LaneReceipt) or not isinstance(
        darwin, LaneReceipt
    ):
        fail("composite requires two validated lane receipts")
    if linux.lane != LANE_LINUX or darwin.lane != LANE_DARWIN:
        fail("lane receipts were missing or cross-lane exchanged")
    for shared_field in SHARED_LANE_FIELDS:
        if getattr(linux, shared_field) != getattr(
            darwin, shared_field
        ):
            fail("lane cross-binding mismatch: " + shared_field)
    if linux.stage3.artifact_format != FORMAT_ELF64_X86_64:
        fail("Linux fixed point is not native ELF")
    if darwin.stage3.artifact_format != FORMAT_MACHO_ARM64:
        fail("Darwin release stage3 is not arm64 Mach-O")
    return CompositeTerminal(
        linux_receipt_sha256=linux.receipt_sha256(),
        darwin_receipt_sha256=darwin.receipt_sha256(),
        linux_target_triple=linux.target_triple,
        linux_machine_authority=linux.machine_authority,
        darwin_target_triple=darwin.target_triple,
        darwin_machine_authority=darwin.machine_authority,
        source_snapshot_cid=linux.source_snapshot_cid,
        cheng_cold_sha256=linux.cheng_cold_sha256,
        bootstrap_contract_sha256=linux.bootstrap_contract_sha256,
        self_check_contract_hash=linux.self_check_contract_hash,
        generated_c_portable_cid=linux.generated_c_portable_cid,
        linux_generated_c_raw_sha256=linux.generated_c_raw_sha256,
        darwin_generated_c_raw_sha256=darwin.generated_c_raw_sha256,
        linux_stage_fixed_point_sha256=linux.stage_fixed_point_sha256,
        darwin_stage_fixed_point_sha256=darwin.stage_fixed_point_sha256,
        darwin_stage3=darwin.stage3,
        _linux_lane_authority=linux,
        _darwin_lane_authority=darwin,
    )


def validate_composite_bundle(
    composite: CompositeTerminal,
    composite_raw: bytes,
    linux_receipt_raw: bytes,
    darwin_receipt_raw: bytes,
) -> CompositeTerminal:
    if (
        not isinstance(composite_raw, bytes)
        or not isinstance(linux_receipt_raw, bytes)
        or not isinstance(darwin_receipt_raw, bytes)
    ):
        fail("composite raw bundle types drifted")
    if (
        not isinstance(composite, CompositeTerminal)
        or composite._linux_lane_authority is None
        or composite._darwin_lane_authority is None
    ):
        fail("composite validation lacks completed lane authority")
    linux = parse_lane_receipt_bytes(
        linux_receipt_raw,
        composite._linux_lane_authority,
    )
    darwin = parse_lane_receipt_bytes(
        darwin_receipt_raw,
        composite._darwin_lane_authority,
    )
    expected = compose_terminal(linux, darwin)
    parse_composite_terminal_bytes(composite_raw, composite)
    if (
        composite != expected
        or composite.receipt_bytes() != composite_raw
        or composite.linux_receipt_sha256
            != sha256_bytes(linux_receipt_raw)
        or composite.darwin_receipt_sha256
            != sha256_bytes(darwin_receipt_raw)
    ):
        fail("composite does not exactly bind both lane receipts")
    return composite


