def darwin_monitor_python_receipt_fields(
    path: str,
    sha256: str,
) -> dict[str, str]:
    authority = DARWIN_MONITOR_PYTHON_AUTHORITIES.get(path)
    if authority is None or authority["sha256"] != sha256:
        fail("Darwin monitor Python identity is not authorized")
    preappend = authority["preappendSysPath"]
    fields = {
        "monitor_python_authority_schema":
            "cheng.guard.monitor_python_authority",
        "monitor_python_authority_status": "verified",
        "monitor_python_implementation": authority["implementation"],
        "monitor_python_version": authority["version"],
        "monitor_python_base_prefix": authority["basePrefix"],
        "monitor_python_startup_flags_schema":
            "cheng.guard.monitor_python_startup_flags",
        "monitor_python_startup_flags_status": "verified",
        "monitor_python_flag_isolated": "1",
        "monitor_python_flag_ignore_environment": "1",
        "monitor_python_flag_no_site": "1",
        "monitor_python_flag_no_user_site": "1",
        "monitor_python_flag_dont_write_bytecode": "1",
        "monitor_python_safe_path_consistency_status": "verified",
        "monitor_python_safe_path_observed": authority["safePath"],
        "monitor_python_preappend_sys_path_schema":
            "cheng.guard.monitor_python_preappend_sys_path",
        "monitor_python_preappend_sys_path_count": str(len(preappend)),
        "monitor_python_preappend_sys_path_sha256":
            guard_string_vector_sha256(
                b"cheng.guard.monitor_python_preappend_sys_path",
                preappend,
            ),
    }
