def parse_linux_portable_anchor_bytes(raw: bytes) -> dict[str, str]:
    rows = parse_unique_kv(raw, "Linux portable anchor")
    if tuple(rows) != LINUX_PORTABLE_ANCHOR_KEY_ORDER:
        fail("Linux portable anchor key order drifted")
    anchor_sha = canonical_sha256(
        rows["anchor_sha256"], "Linux portable anchor self hash"
    )
    suffix = ("anchor_sha256=" + anchor_sha + "\n").encode("ascii")
    if (
        rows["schema"] != LINUX_PORTABLE_ANCHOR_SCHEMA
        or rows["status"] != "AUTHENTICATED"
        or rows["authentication_method"]
            != "root_owned_system_immutable_authenticated_coordinator"
        or rows["linux_evidence_root_path_fshex"]
            != os.fsencode(str(LINUX_EVIDENCE_ROOT)).hex()
        or rows["darwin_evidence_root_path_fshex"]
            != os.fsencode(str(DARWIN_EVIDENCE_ROOT)).hex()
        or anchor_sha != sha256_bytes(raw[:-len(suffix)])
        or rows["linux_target_triple"]
            != LANE_TARGET_TRIPLE[LANE_LINUX]
        or rows["linux_machine_authority"]
            != LANE_MACHINE_AUTHORITY[LANE_LINUX]
        or rows["darwin_target_triple"]
            != LANE_TARGET_TRIPLE[LANE_DARWIN]
        or rows["darwin_machine_authority"]
            != LANE_MACHINE_AUTHORITY[LANE_DARWIN]
    ):
        fail("Linux portable anchor contract drifted")
    for key in (
        "production_gate_sha256",
        "verifier_inputs_cid",
        "linux_evidence_closure_cid",
        "linux_lane_receipt_sha256",
        "darwin_evidence_closure_cid",
        "darwin_lane_receipt_sha256",
        "composite_terminal_sha256",
