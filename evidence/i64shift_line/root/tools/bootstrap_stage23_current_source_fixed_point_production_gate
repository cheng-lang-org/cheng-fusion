def issue_portable_authority_receipt() -> bytes:
    if (
        sys.platform != "darwin"
        or os.geteuid() != 0
        or os.getegid() != 0
    ):
        fail("portable authority receipt issuance requires Darwin root")
    if (
        getattr(stat, "SF_IMMUTABLE", None) != SYSTEM_IMMUTABLE_FLAG
        or not callable(getattr(os, "chflags", None))
    ):
        fail("Darwin receipt sealing authority is unavailable")
    receipt_raw, receipt_rows, anchor_identity, _anchor_flags = (
        build_portable_authority_receipt_from_verified_state()
    )
    second_raw, second_rows, second_anchor, _second_flags = (
        build_portable_authority_receipt_from_verified_state()
    )
    if (
        second_raw != receipt_raw
        or second_rows != receipt_rows
        or second_anchor != anchor_identity
    ):
        fail("portable authority state changed before receipt publication")
    path = DARWIN_PORTABLE_AUTHORITY_RECEIPT_PATH
    require_root_owned_fixed_parent_chain(
        path, "portable authority receipt"
    )
    if path.exists() or path.is_symlink():
        identity, observed, flags = authenticate_darwin_system_immutable_file(
            path, "portable authority receipt"
        )
        if observed != receipt_raw:
            fail("installed portable authority receipt differs")
    else:
        published = publish_exclusive_regular(
            path.parent, path.name, receipt_raw
        )
        if published.uid != 0 or published.gid != 0:
            fail("portable authority receipt publication owner drifted")
        os.chflags(
            path,
            SYSTEM_IMMUTABLE_FLAG,
            follow_symlinks=False,
        )
        parent_fd = open_anchored_directory(path.parent)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
        identity, observed, flags = authenticate_darwin_system_immutable_file(
            path, "portable authority receipt"
        )
        if observed != receipt_raw:
            fail("sealed portable authority receipt bytes drifted")
    values = {
        "schema": PORTABLE_AUTHORITY_ISSUE_SCHEMA,
        "status": "CANDIDATE_ISSUED",
        "material_role": "candidate_material_only",
        "production_authority": "unavailable",
        "production_execution_identity_binding": "absent",
        "dynamic_completion_credit": "0",
        "platform": "darwin-arm64",
        "receipt_path_fshex": identity.path_fshex,
        "receipt_sha256": identity.sha256,
        "receipt_flags": str(flags),
        "external_anchor_file_sha256": anchor_identity.sha256,
        "authority_verification_sha256":
            receipt_rows["authority_verification_sha256"],
        "source_snapshot_cid": receipt_rows["source_snapshot_cid"],
    }
    return canonical_portable_report_bytes(
        values,
        PORTABLE_AUTHORITY_ISSUE_KEY_ORDER,
        "issue_sha256",
    )


