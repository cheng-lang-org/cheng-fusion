def validate_guarded_darwin_dependency_closure(
    state: PhaseState,
    raw: bytes,
) -> None:
    dependencies = parse_make_dependency_output(raw)
    if state.next_phase_index == 0:
        action_root = state.paths.command_action_input_root(0, 0)
        source_root = action_root / "source"
        toolchain_root = action_root / "toolchain"
        required_sources = {
            source_root / "bootstrap/cheng_cold.c",
        }
        allowed_sources = {
            path
            for path in source_root.rglob("*")
            if path.is_file() and not path.is_symlink()
        }
        toolchain_paths = {
            path
            for path in toolchain_root.rglob("*")
            if path.is_file() and not path.is_symlink()
        }
    elif state.next_phase_index == 15:
        required_sources = {
            identity_host_path(state.frozen["bootstrap_source"]),
        }
        allowed_sources = required_sources.union({
            identity_host_path(state.frozen[role])
            for role in state.frozen
            if role.startswith("local_c_header_")
        })
        toolchain_paths = {
            identity_host_path(identity)
            for role, identity in state.frozen.items()
            if role.startswith("darwin_toolchain_input_")
        }
    else:
        fail("Darwin dependency closure phase drifted")
    observed = set(dependencies)
    if (
        not required_sources.issubset(observed)
        or not observed.issubset(allowed_sources.union(toolchain_paths))
        or not observed.intersection(toolchain_paths)
    ):
        fail(
            "guarded Darwin dependency closure escaped frozen snapshots"
        )


def run_guarded_darwin_discovery(
    evidence: Path,
    command: Path,
    argv: Sequence[str],
) -> tuple[dict[str, ArtifactIdentity], bytes]:
    discovery = create_exclusive_private_child_directory(
        evidence, "toolchain-discovery"
    )
    report_path = discovery / "clang-deps.guard.kv"
    stdout_path = discovery / "clang-deps.guard.stdout"
    stderr_path = discovery / "clang-deps.guard.stderr"
    command_identity = stable_artifact(
        command, executable=True
    )[0]
    command_physical = physical_identity_payload(command)
    runtime_identity = stable_artifact(
        PROCESS_GUARD_RUNTIME, executable=False
    )[0]
    monitor_python = Path(DARWIN_MONITOR_PYTHON_PATH)
    monitor_python_identity = stable_artifact(
        monitor_python, executable=True
    )[0]
    guard_argv = [
        "/bin/bash",
        str(PROCESS_GUARD),
        "--rss-limit:" + str(MEMORY_MAX_BYTES),
        "--timeout:" + str(PHASE_SPECS[0].timeout_seconds),
        "--combined-output-limit:" + str(MEMORY_MAX_BYTES),
        "--monitor-python:" + str(monitor_python),
        "--expected-monitor-runtime-sha256:"
            + runtime_identity.sha256,
        "--snapshot-command",
        "--require-command-identity",
        "--expected-command-path:" + str(command),
        "--expected-command-sha256:" + command_identity.sha256,
        "--expected-exit-code:0",
        "--report-out:" + str(report_path),
        "--stdout:" + str(stdout_path),
        "--stderr:" + str(stderr_path),
        "--target-env-clear",
        "--target-env:HOME=/nonexistent",
        "--target-env:LANG=C",
        "--target-env:LC_ALL=C",
        "--target-env:PATH=/usr/bin:/bin",
        "--target-env:TZ=UTC",
        "--",
        *argv,
    ]
    completed = subprocess.run(
        guard_argv,
        cwd=str(ROOT),
        env=dict(CLOSED_SUBPROCESS_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=PHASE_SPECS[0].timeout_seconds + 30,
    )
    if (
        completed.returncode != 0
        or completed.stdout
        or completed.stderr
    ):
        detail = (
            completed.stderr or completed.stdout
        ).decode("utf-8", "replace").replace("\n", "_")[:512]
        fail(
            "guarded Darwin dependency discovery failed:"
            + str(completed.returncode)
            + ":"
            + detail
        )
    if (
        stable_artifact(command, executable=True)[0] != command_identity
        or physical_identity_payload(command) != command_physical
    ):
        fail("Darwin dependency discovery command identity changed")
    _report_info, report_raw = phase_engine.read_exact_regular(
        report_path, "Darwin dependency discovery guard receipt"
    )
    rows = parse_unique_kv(
        report_raw,
        "Darwin dependency discovery guard receipt",
    )
    validate_darwin_monitor_python_receipt(
        rows,
        str(monitor_python),
        monitor_python_identity.sha256,
    )
    if (
        rows.get("schema") != "beat_c_process_memory_guard"
        or rows.get("status") != "completed"
        or rows.get("rc") != "0"
        or rows.get("abort_reason")
        or rows.get("expected_exit_code") != "0"
        or rows.get("actual_exit_code") != "0"
        or rows.get("exit_code_contract_status") != "verified"
        or rows.get("command_identity_status") != "available"
        or rows.get("command_identity_error")
        or rows.get("command_path") != str(command)
        or rows.get("command_sha256") != command_identity.sha256
        or rows.get("command_device")
            != str(command_physical["device"])
        or rows.get("command_inode")
            != str(command_physical["inode"])
        or rows.get("command_size")
            != str(command_physical["size"])
        or rows.get("command_mtime_ns")
            != str(command_physical["mtimeNs"])
        or rows.get("command_ctime_ns")
            != str(command_physical["ctimeNs"])
        or rows.get("expected_command_path") != str(command)
        or rows.get("expected_command_sha256")
            != command_identity.sha256
        or rows.get("formal_command_identity_status")
            != "required_verified"
        or rows.get("command_execution_mode")
            != "private_single_link_snapshot"
        or rows.get("command_argv_sha256")
            != guard_argv_sha256(argv)
        or rows.get("monitor_python_path") != str(monitor_python)
        or rows.get("monitor_python_sha256")
            != monitor_python_identity.sha256
        or rows.get("monitor_runtime_script_sha256")
            != runtime_identity.sha256
        or rows.get("monitor_runtime_script_stage_expected_sha256")
            != runtime_identity.sha256
        or rows.get("monitor_runtime_script_builtin_sha256")
            != runtime_identity.sha256
        or rows.get("monitor_runtime_script_expected_sha_match") != "1"
        or rows.get("tracked_output_count") != "0"
        or rows.get("hard_memory_limit_proof_status")
            != DARWIN_MEMORY_PROOF
        or rows.get("cleanup_status") != "not_required"
    ):
        fail("Darwin dependency discovery guard receipt drifted")
    phase_engine.remove_verified_guard_snapshot(report_path)
    stderr_info, stderr_raw = phase_engine.read_exact_regular(
        stderr_path, "Darwin dependency discovery stderr"
    )
    stdout_info, stdout_raw = phase_engine.read_exact_regular(
        stdout_path, "Darwin dependency discovery stdout"
    )
    if (
        stderr_raw
        or not stdout_raw
        or stderr_info.st_nlink != 1
        or stdout_info.st_nlink != 1
        or stat.S_IMODE(stderr_info.st_mode) != 0o400
        or stat.S_IMODE(stdout_info.st_mode) != 0o400
    ):
        fail("Darwin dependency discovery output drifted")
    identities = {
        "toolchain_discovery_guard_receipt":
            stable_artifact(report_path, executable=False)[0],
        "toolchain_discovery_guard_stdout":
            stable_artifact(stdout_path, executable=False)[0],
        "toolchain_discovery_guard_stderr":
            stable_artifact(stderr_path, executable=False)[0],
    }
    os.chmod(discovery, 0o500)
    return identities, stdout_raw


def materialize_darwin_toolchain_snapshot(
    evidence: Path,
    cc: Path,
    frozen_cold_source_raw: bytes,
) -> tuple[
    Path,
    Path,
    dict[str, ArtifactIdentity],
    dict[str, tuple[Any, ...]],
    dict[str, ArtifactIdentity],
]:
    snapshot = evidence / phase_engine.DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE
    clang_snapshot = snapshot / "usr/bin/clang"
    resource_snapshot = snapshot / "usr/lib/clang/21"
    sdk_snapshot = snapshot / "SDKs/MacOSX.sdk"
    linker_source = cc.parent / "ld"
    preflight_argv = (
        str(cc),
        "-std=c11",
        "-O2",
        "-target",
        LANE_TARGET_TRIPLE[LANE_DARWIN],
        "-resource-dir",
        str(DARWIN_XCODE_RESOURCE_ROOT),
        "-isysroot",
        str(DARWIN_XCODE_SDK_ROOT),
        "-M",
        "-MT",
        "cheng_bootstrap_local_closure",
        str(ROOT / "bootstrap/cheng_cold.c"),
    )
    discovery_identities, discovery_stdout = (
        run_guarded_darwin_discovery(
            evidence, cc, preflight_argv
        )
    )
    dependency_paths = parse_make_dependency_output(discovery_stdout)
    live_regular: dict[str, ArtifactIdentity] = {}
    live_symlinks: dict[str, tuple[Any, ...]] = {}
    framework_order = cold_darwin_framework_order(
        frozen_cold_source_raw
    )
    materialize_live_tree(
        DARWIN_XCODE_RESOURCE_ROOT,
        resource_snapshot,
        source_root=DARWIN_XCODE_RESOURCE_ROOT,
        live_regular=live_regular,
        live_symlinks=live_symlinks,
    )
    sdk_inputs = {
        path for path in dependency_paths
        if path == DARWIN_XCODE_SDK_ROOT
        or DARWIN_XCODE_SDK_ROOT in path.parents
    }
    sdk_inputs.update({
        DARWIN_XCODE_SDK_ROOT / "SDKSettings.json",
        DARWIN_XCODE_SDK_ROOT / "usr/lib/libc.tbd",
        DARWIN_XCODE_SDK_ROOT / "usr/lib/libSystem.tbd",
        DARWIN_XCODE_SDK_ROOT / "usr/lib/libSystem.B.tbd",
    })
    sdk_snapshot.mkdir(parents=True, mode=0o700)
    for source in sorted(sdk_inputs, key=lambda item: os.fsencode(str(item))):
        if source == DARWIN_XCODE_SDK_ROOT:
            continue
        materialize_live_regular(
            source,
            sdk_snapshot / source.relative_to(DARWIN_XCODE_SDK_ROOT),
            live_regular,
            live_symlinks,
            source_root=DARWIN_XCODE_SDK_ROOT,
            require_symlink=(
                source == DARWIN_XCODE_SDK_ROOT / "usr/lib/libc.tbd"
            ),
        )
    materialize_darwin_framework_authorities(
        snapshot,
        live_regular,
        live_symlinks,
        framework_order,
    )
    for directory in sorted(
        (
            item for item in sdk_snapshot.rglob("*")
            if item.is_dir() and not item.is_symlink()
        ),
        key=lambda item: len(item.parts),
        reverse=True,
    ):
        os.chmod(directory, 0o500)
    os.chmod(sdk_snapshot, 0o500)
    xcode_lib = cc.parent.parent / "lib"
    for name in (
        "libtapi.dylib",
        "libcodedirectory.dylib",
        "libLTO.dylib",
        "libswiftDemangle.dylib",
    ):
        materialize_live_regular(
            xcode_lib / name,
            snapshot / "usr/lib" / name,
            live_regular,
            live_symlinks,
        )
    clang_identity, clang_raw = stable_artifact(
        cc, executable=True
    )
    live_regular[str(cc)] = clang_identity
    write_new_snapshot_file(clang_snapshot, clang_raw, 0o500)
    linker_identity, linker_raw = stable_artifact(
        linker_source, executable=True
    )
    live_regular[str(linker_source)] = linker_identity
    linker_snapshot = snapshot / "usr/bin/ld"
    write_new_snapshot_file(linker_snapshot, linker_raw, 0o500)
    runtime_link_manifest_raw = (
        darwin_runtime_link_authority_manifest_raw(
            snapshot,
            live_regular,
            live_symlinks,
            framework_order,
        )
    )
    write_new_snapshot_file(
        snapshot / DARWIN_TOOLCHAIN_SOURCE_AUTHORITY_RELATIVE,
        runtime_link_manifest_raw,
        0o400,
    )
    validate_darwin_runtime_link_authority_manifest(
        snapshot,
        live_regular,
        live_symlinks,
        framework_order,
    )
    validate_darwin_live_toolchain_maps(
        live_regular, live_symlinks
    )
    return (
        clang_snapshot,
        linker_snapshot,
        live_regular,
        live_symlinks,
        discovery_identities,
    )


def copy_action_input_file(
    source: Path,
    destination: Path,
) -> None:
    source_identity, _source_raw = stable_artifact(
        source,
        executable=bool(os.lstat(source).st_mode & 0o111),
    )
    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if destination.exists() or destination.is_symlink():
        fail("command action input destination already exists")
    shutil.copyfile(source, destination, follow_symlinks=False)
    final_mode = (
        0o500
        if source_identity.artifact_format != FORMAT_REGULAR
        else 0o400
    )
    os.chmod(destination, final_mode)
    destination_identity, _destination_raw = stable_artifact(
        destination,
        executable=final_mode == 0o500,
    )
    source_after = stable_artifact(
        source,
        executable=source_identity.artifact_format != FORMAT_REGULAR,
    )[0]
    if (
        source_after != source_identity
        or destination_identity.sha256 != source_identity.sha256
        or destination_identity.size != source_identity.size
        or destination_identity.nlink != 1
        or stat.S_IMODE(destination_identity.mode) != final_mode
    ):
        fail("command action input copy identity drifted")


def copy_action_input_tree(
    source: Path,
    destination: Path,
) -> None:
    before = private_frozen_tree_binding(source)
    if destination.exists() or destination.is_symlink():
        fail("command action input tree already exists")
    destination.mkdir(parents=True, mode=0o700)
    for current, directory_names, file_names in os.walk(
        source, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        current_path = Path(current)
        relative = current_path.relative_to(source)
        target_directory = destination / relative
        if target_directory != destination:
            target_directory.mkdir(mode=0o700)
        for name in directory_names:
            path = current_path / name
            if path.is_symlink() or not path.is_dir():
                fail("command action input tree directory drifted")
        for name in file_names:
            copy_action_input_file(
                current_path / name,
                target_directory / name,
            )
    for directory in sorted(
        (
            item for item in destination.rglob("*")
            if item.is_dir() and not item.is_symlink()
        ),
        key=lambda item: len(item.parts),
        reverse=True,
    ):
        os.chmod(directory, 0o500)
    os.chmod(destination, 0o500)
    after = private_frozen_tree_binding(source)
    copied = private_frozen_tree_binding(destination)
    if (
        after != before
        or copied["entryCount"] != before["entryCount"]
        or copied["directoryCount"] != before["directoryCount"]
        or copied["fileCount"] != before["fileCount"]
    ):
        fail("command action input tree copy closure drifted")


def command_action_tree_closed_rows(
    state: PhaseState,
    root: Path,
    phase_index: int,
    action_index: int,
) -> tuple[tuple[str, ...], dict[str, dict[str, Any]]]:
    if root.parent.parent != (
        state.paths.evidence / "command-action-inputs"
    ):
        fail("command action input root path drifted")
    files = dict(state.closed_tree_files)
    directories = set(state.closed_tree_directories)
    directories.update(
        str(parent)
        for parent in root.relative_to(state.paths.evidence).parents
        if str(parent) != "."
    )
    file_index = 0
    for current, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        current_path = Path(current)
        relative_directory = str(
            current_path.relative_to(state.paths.evidence)
        )
        directories.add(relative_directory)
        for name in file_names:
            path = current_path / name
            relative_path = str(path.relative_to(state.paths.evidence))
            if relative_path in files:
                fail("command action input closed path aliases")
            role = (
                f"command_action_input_{phase_index:02d}_"
                f"{action_index:02d}_{file_index:04d}"
            )
            row, _raw = stable_closed_file(
                path, role, relative_path
            )
            files[relative_path] = row
            file_index += 1
    return (
        tuple(sorted(directories, key=os.fsencode)),
        files,
    )


def with_darwin_action_input_root(
    state: PhaseState,
    root: Path,
    phase_index: int,
    action_index: int,
    command_role: str,
    command_relative_path: Path,
) -> PhaseState:
    directories, files = command_action_tree_closed_rows(
        state, root, phase_index, action_index
    )
    frozen = dict(state.frozen)
    if command_role in frozen:
        fail("command action executable role was reused")
    command_path = root / command_relative_path
    frozen[command_role] = stable_artifact(
        command_path, executable=True
    )[0]
    return replace(
        state,
        frozen=frozen,
        closed_tree_directories=directories,
        closed_tree_files=files,
    )


def bind_existing_darwin_action_input_root(
    state: PhaseState,
    root: Path,
    phase_index: int,
    action_index: int,
    command_role: str,
    command_relative_path: Path,
) -> PhaseState:
    try:
        root_info = os.lstat(root)
    except OSError as exc:
        raise ProductionGateError(
            "physical command action input root is absent"
        ) from exc
    if (
        stat.S_ISLNK(root_info.st_mode)
        or not stat.S_ISDIR(root_info.st_mode)
        or stat.S_IMODE(root_info.st_mode) != 0o500
    ):
        fail("physical command action input root is not sealed")
    directories, files = command_action_tree_closed_rows(
        state, root, phase_index, action_index
    )
    command_identity = stable_artifact(
        root / command_relative_path, executable=True
    )[0]
    frozen = dict(state.frozen)
    existing = frozen.get(command_role)
    if existing is not None and existing != command_identity:
        fail("physical command action executable identity drifted")
    frozen[command_role] = command_identity
    return replace(
        state,
        frozen=frozen,
        closed_tree_directories=directories,
        closed_tree_files=files,
    )


def materialize_darwin_phase0_action_inputs(
    state: PhaseState,
) -> PhaseState:
    root = state.paths.command_action_input_root(0, 0)
    toolchain = root / "toolchain"
    copy_action_input_tree(
        state.paths.evidence
        / phase_engine.DARWIN_TOOLCHAIN_SNAPSHOT_RELATIVE,
        toolchain,
    )
    source_root = root / "source"
    source_files = (
        state.paths.bootstrap_source,
        ROOT / "bootstrap/stage1_bootstrap.cheng",
        ROOT / BOOTSTRAP_MANIFEST_RELATIVE,
        ROOT / PACKAGE_MANIFEST_RELATIVE,
        ROOT / "src/tests/t78_matrix/t7.cheng",
        *phase_engine.local_c_source_closure(state.paths),
    )
    for source in source_files:
        copy_action_input_file(
            source, source_root / source.relative_to(ROOT)
