#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import platform
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent


def fail(message: str) -> None:
    raise SystemExit(f"FAIL {message}")


def pass_marker(message: str) -> None:
    print(f"PASS {message}")


def host_target() -> str:
    machine = platform.machine().lower()
    system = platform.system()
    if machine in {"x86_64", "amd64"}:
        arch = "x86_64"
    elif machine in {"aarch64", "arm64"}:
        arch = "arm64"
    else:
        fail(f"unsupported_host_arch_{machine}")
    if system == "Darwin":
        return f"{arch}-apple-darwin"
    if system == "Linux":
        if arch == "arm64":
            arch = "aarch64"
        return f"{arch}-unknown-linux-gnu"
    fail(f"unsupported_host_system_{system}")
    return ""


def run(cmd: list[str], *, cwd: Path = ROOT, stdout: Any = subprocess.PIPE, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    run_env = os.environ.copy()
    if env:
        run_env.update(env)
    return subprocess.run(cmd, cwd=str(cwd), text=True, encoding="utf-8", errors="replace", stdout=stdout, stderr=subprocess.PIPE, env=run_env)


def require_ok(proc: subprocess.CompletedProcess[str], label: str) -> None:
    if proc.returncode != 0:
        tail = ((proc.stdout or "") + (proc.stderr or ""))[-4000:]
        fail(f"{label}_rc_{proc.returncode}\n{tail}")


def backend_compile(source: Path, out: Path, report: Path, target: str, *, link_providers: bool | None = None) -> None:
    cmd = [
        str(ROOT / "artifacts/backend_driver/cheng"),
        "system-link-exec",
        f"--root:{ROOT}",
        f"--in:{source}",
        "--emit:exe",
        f"--target:{target}",
        f"--out:{out}",
        f"--report-out:{report}",
    ]
    if link_providers is None:
        link_providers = "linux" in target
    if link_providers:
        cmd.append("--link-providers")
    require_ok(run(cmd), f"compile_{source.name}")


def compile_probe_tools(work: Path, target: str) -> tuple[Path, Path]:
    bin_dir = work / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)
    emitter = bin_dir / "c-csg-ast-emit-pure"
    lower = bin_dir / "cheng-csg-lower-pure"
    backend_compile(ROOT / "src/core/csg_migration/c_csg_ast_emit.cheng", emitter, bin_dir / "emit.compile.report.txt", target)
    backend_compile(ROOT / "src/core/csg_migration/cheng_csg_lower.cheng", lower, bin_dir / "lower.compile.report.txt", target)
    return emitter, lower


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")


def read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def clang_ast(source: Path, ast_out: Path, target: str) -> None:
    ast_out.parent.mkdir(parents=True, exist_ok=True)
    cmd = [
        "clang",
        "-Xclang",
        "-ast-dump=json",
        "-fsyntax-only",
        f"--target={target}",
        "-std=c11",
        str(source),
    ]
    with ast_out.open("w", encoding="utf-8") as out:
        proc = run(cmd, cwd=source.parent, stdout=out)
    require_ok(proc, f"clang_ast_{source.name}")


def clang_syntax_only(source: Path, target: str) -> None:
    cmd = [
        "clang",
        "-fsyntax-only",
        f"--target={target}",
        "-std=c11",
        "-Ibootstrap",
        str(source),
    ]
    require_ok(run(cmd), f"clang_syntax_{source.name}")


def emit_csg(emitter: Path, ast: Path, source: Path, display_path: str, target: str, out: Path, report: Path) -> dict[str, Any]:
    proc = run([
        str(emitter),
        "emit",
        "--clang-ast-json",
        str(ast),
        "--source",
        str(source),
        "--display-path",
        display_path,
        "--target",
        target,
        "--out",
        str(out),
        "--report-out",
        str(report),
        "--tool-implementation",
        "pure-cheng-c-csg-ast-emit-direct",
    ])
    require_ok(proc, f"emit_csg_{source.name}")
    return read_json(report)


def cheng_string(value: str) -> str:
    return json.dumps(value)


def lower_csg_via_harness(work: Path, facts: Path, out_dir: Path, report: Path, target: str) -> dict[str, Any]:
    lower_source = ROOT / "src/core/csg_migration/cheng_csg_lower.cheng"
    source_text = lower_source.read_text(encoding="utf-8")
    marker = "\nfn main(argc: int32, argv: str*): int32 ="
    split = source_text.rfind(marker)
    if split < 0:
        fail("lower_main_marker_not_found")
    harness_source = work / "fixture" / "cheng_csg_lower_harness.cheng"
    harness_source.write_text(
        source_text[:split]
        + "\nfn main(argc: int32, argv: str*): int32 =\n"
        + "    argc\n"
        + "    argv\n"
        + f"    return LowerRunPaths({cheng_string(facts.name)}, \"cheng-source\", {cheng_string(out_dir.name)}, {cheng_string(report.name)})\n",
        encoding="utf-8",
    )
    harness_exe = work / "fixture" / "cheng_csg_lower_harness"
    backend_compile(harness_source, harness_exe, work / "fixture" / "cheng_csg_lower_harness.compile.report.txt", target)
    proc = run([str(harness_exe)], cwd=facts.parent)
    require_ok(proc, "lower_fixture_harness")
    return read_json(report)


def probe_pure_lower(work: Path, facts: Path, out_dir: Path, report: Path, target: str) -> dict[str, Any]:
    try:
        lowered = lower_csg_via_harness(work, facts, out_dir, report, target)
        return {
            "attempted": True,
            "complete": bool(lowered.get("complete")),
            "returnCode": 0,
            "reportWritten": report.exists(),
            "closedSubset": lowered.get("closedSubset"),
        }
    except SystemExit as exc:
        return {
            "attempted": True,
            "complete": False,
            "returnCode": 1,
            "reportWritten": report.exists(),
            "error": "pure Cheng lower harness failed on this host",
            "detailTail": str(exc)[-1000:],
            "unsupportedCodes": ["cheng_csg_lower.linux_harness_failed"],
        }


def bootstrap_cheng_source(frontend: dict[str, Any]) -> str:
    lines: list[str] = []
    for fn in frontend.get("closedFunctions", []):
        name = str(fn.get("name", ""))
        params = [str(param) for param in fn.get("parameters", [])]
        typed_params = ", ".join(f"{param}: int32" for param in params)
        lines.append(f"fn {name}({typed_params}): int32 =")
        statements = fn.get("statements", [])
        for stmt in statements:
            if stmt.get("kind") == "local_i32":
                lines.append(f"    let {stmt.get('name')} = {stmt.get('expr')}")
            elif stmt.get("kind") == "stdout_line":
                fail("bootstrap_lower_stdout_not_supported_in_cold_probe")
        lines.append(f"    return {fn.get('returnExpr')}")
        lines.append("")
    return "\n".join(lines) + "\n"


def bootstrap_lower_fixture(frontend: dict[str, Any], out_dir: Path, report: Path) -> dict[str, Any]:
    out_dir.mkdir(parents=True, exist_ok=True)
    main_path = out_dir / "main.cheng"
    main_path.write_text(bootstrap_cheng_source(frontend), encoding="utf-8")
    lower_report = {
        "schema": "cold-csg-probe.bootstrap-lower.report",
        "complete": True,
        "generatorImplementation": "python-bootstrap-report-closed-functions",
        "completionScope": "fixture-roundtrip-only",
        "fullProjectTranspilationComplete": False,
        "entry": str(main_path),
        "closedSubset": "function-graph-local-return-i32.v1",
        "closedReturn": frontend.get("closedReturn"),
    }
    write_json(report, lower_report)
    return lower_report


def emit_csg_bootstrap(compile_commands: Path, target: str, out: Path, report: Path) -> dict[str, Any]:
    proc = run([
        str(ROOT / "tools/c-csg-bootstrap"),
        "emit",
        "--compile-commands",
        str(compile_commands),
        "--target",
        target,
        "--out",
        str(out),
        "--report-out",
        str(report),
    ])
    require_ok(proc, "emit_csg_bootstrap_fixture")
    return read_json(report)


def scan_cold_source(source: Path) -> list[dict[str, Any]]:
    text = source.read_text(encoding="utf-8", errors="replace")
    checks = [
        ("c.frontend.preprocessor_not_closed", ["#include", "#define", "#ifdef", "#ifndef", "#if defined"]),
        ("c.frontend.struct_union_layout_not_closed", ["typedef struct", "struct ", "union "]),
        ("c.frontend.enum_typedef_not_closed", ["typedef enum", "enum "]),
        ("c.frontend.pointer_aliasing_not_closed", ["*", "->", "&"]),
        ("c.frontend.non_i32_scalar_not_closed", ["uint64_t", "int64_t", "size_t", "double", "bool", "uint8_t"]),
        ("c.frontend.system_memory_not_closed", ["mmap", "munmap", "malloc", "free"]),
        ("c.frontend.file_process_io_not_closed", ["fopen", "fread", "fwrite", "open(", "read(", "write(", "system(", "exec"]),
        ("c.frontend.setjmp_signal_not_closed", ["setjmp", "longjmp", "signal", "SIGSEGV"]),
        ("c.frontend.threading_not_closed", ["pthread_", "thread"]),
        ("c.frontend.target_backend_object_emit_not_closed", ["Mach-O", "ELF", "COFF", "macho", "elf64", "coff"]),
    ]
    ranked: list[dict[str, Any]] = []
    for code, needles in checks:
        count = sum(text.count(needle) for needle in needles)
        if count > 0:
            ranked.append({"code": code, "count": count})
    ranked.sort(key=lambda item: (-int(item["count"]), str(item["code"])))
    return ranked


def optional_full_ast_probe(emitter: Path, cold_source: Path, target: str, work: Path) -> dict[str, Any]:
    enabled = os.environ.get("CHENG_COLD_CSG_PROBE_FULL_AST", "") == "1"
    result: dict[str, Any] = {"enabled": enabled}
    if not enabled:
        result["skippedReason"] = "set CHENG_COLD_CSG_PROBE_FULL_AST=1 to materialize the large cheng_cold.c AST"
        return result
    ast = work / "full-cold" / "cheng_cold.ast.json"
    report = work / "full-cold" / "frontend.report.json"
    facts = work / "full-cold" / "cheng_cold.csgcore"
    clang_ast(cold_source, ast, target)
    ast_bytes = ast.stat().st_size
    proc = run([
        str(emitter),
        "emit",
        "--clang-ast-json",
        str(ast),
        "--source",
        str(cold_source),
        "--display-path",
        "bootstrap/cheng_cold.c",
        "--target",
        target,
        "--out",
        str(facts),
        "--report-out",
        str(report),
        "--tool-implementation",
        "pure-cheng-c-csg-ast-emit-direct",
    ])
    result["astBytes"] = ast_bytes
    result["returnCode"] = proc.returncode
    result["stderrTail"] = (proc.stderr or "")[-4000:]
    result["reportWritten"] = report.exists()
    if report.exists():
        data = read_json(report)
        result["complete"] = bool(data.get("complete"))
        result["unsupportedCodes"] = data.get("unsupportedCodes", [])
    else:
        result["complete"] = False
        result["unsupportedCodes"] = ["c.frontend.full_cold_ast_emit_failed_before_report"]
    return result


def probe_pure_emitter(emitter: Path, ast: Path, source: Path, target: str, work: Path) -> dict[str, Any]:
    report = work / "fixture" / "pure-emitter.report.json"
    facts = work / "fixture" / "pure-emitter.csgcore"
    proc = run([
        str(emitter),
        "emit",
        "--clang-ast-json",
        str(ast),
        "--source",
        str(source),
        "--display-path",
        "cold_layout_arith.c",
        "--target",
        target,
        "--out",
        str(facts),
        "--report-out",
        str(report),
        "--tool-implementation",
        "pure-cheng-c-csg-ast-emit-direct",
    ])
    out: dict[str, Any] = {
        "returnCode": proc.returncode,
        "reportWritten": report.exists(),
        "stderrTail": (proc.stderr or "")[-4000:],
    }
    if report.exists():
        data = read_json(report)
        out["complete"] = bool(data.get("complete"))
        out["unsupportedCodes"] = data.get("unsupportedCodes", [])
    else:
        out["complete"] = False
        out["unsupportedCodes"] = ["c.frontend.pure_emitter_failed_before_report"]
    return out


def run_fixture_roundtrip(work: Path, emitter: Path, lower: Path, target: str) -> dict[str, Any]:
    fixture_dir = work / "fixture"
    fixture_dir.mkdir(parents=True, exist_ok=True)
    source = fixture_dir / "cold_layout_arith.c"
    source.write_text(
        "static int cold_probe_slot_bytes(int locals, int temps) { int slots = locals + temps; return slots * 8; }\n"
        "static int cold_probe_frame_score(int params) { return cold_probe_slot_bytes(params, 2) + 1; }\n"
        "int main(void) { int base = cold_probe_frame_score(3); return base - 1; }\n",
        encoding="utf-8",
    )
    compile_commands = fixture_dir / "compile_commands.json"
    write_json(
        compile_commands,
        [
            {
                "directory": str(fixture_dir),
                "arguments": ["/usr/bin/clang", "-std=c11", "-c", "cold_layout_arith.c", "-o", "cold_layout_arith.o"],
                "file": "cold_layout_arith.c",
            }
        ],
    )
    original = fixture_dir / "cold_layout_arith.original"
    require_ok(run(["clang", f"--target={target}", "-std=c11", str(source), "-o", str(original)], cwd=fixture_dir), "compile_original_fixture")
    original_run = run([str(original)], cwd=fixture_dir)
    original_exit = original_run.returncode
    ast = fixture_dir / "cold_layout_arith.ast.json"
    clang_ast(source, ast, target)
    pure_emitter = probe_pure_emitter(emitter, ast, source, target, work)
    facts = fixture_dir / "cold_layout_arith.csgcore"
    frontend_report = fixture_dir / "frontend.report.json"
    frontend = emit_csg_bootstrap(compile_commands, target, facts, frontend_report)
    if not frontend.get("complete"):
        fail("fixture_frontend_not_complete")
    generated_dir = fixture_dir / "generated"
    lower_report = fixture_dir / "lower.report.json"
    pure_lower = probe_pure_lower(work, facts, fixture_dir / "pure-generated", fixture_dir / "pure-lower.report.json", target)
    lowered = bootstrap_lower_fixture(frontend, generated_dir, lower_report)
    generated = generated_dir / "main.cheng"
    generated_exe = fixture_dir / "cold_layout_arith.cheng"
    generated_compile_report = fixture_dir / "generated.compile.report.txt"
    backend_compile(generated, generated_exe, generated_compile_report, target, link_providers=False)
    generated_run = run([str(generated_exe)], cwd=fixture_dir)
    generated_exit = generated_run.returncode
    if original_exit != generated_exit:
        fail(f"fixture_exit_mismatch_original_{original_exit}_cheng_{generated_exit}")
    pass_marker("cold_fixture_csg_roundtrip")
    return {
        "source": str(source),
        "originalExit": original_exit,
        "chengExit": generated_exit,
        "frontendComplete": bool(frontend.get("complete")),
        "frontendImplementation": frontend.get("extractorImplementation"),
        "frontendClosedSubset": frontend.get("closedSubset"),
        "pureEmitterProbe": pure_emitter,
        "pureLowerProbe": pure_lower,
        "bootstrapLowerComplete": bool(lowered.get("complete")),
        "bootstrapLowerClosedSubset": lowered.get("closedSubset"),
        "generatedSource": str(generated),
    }


def main() -> int:
    target = host_target()
    if shutil.which("clang") is None:
        fail("clang_not_found")
    work_arg = os.environ.get("CHENG_COLD_CSG_PROBE_WORK", "")
    if work_arg:
        work = Path(work_arg)
        if work.exists():
            shutil.rmtree(work)
        work.mkdir(parents=True)
        cleanup = False
    else:
        work = Path(tempfile.mkdtemp(prefix="cold-csg-probe.", dir=os.environ.get("TMPDIR", "/tmp")))
        cleanup = os.environ.get("CHENG_COLD_CSG_PROBE_KEEP_WORK", "") != "1"
    try:
        emitter, lower = compile_probe_tools(work, target)
        cold_source = ROOT / "bootstrap/cheng_cold.c"
        clang_syntax_only(cold_source, target)
        gap_rank = scan_cold_source(cold_source)
        if not gap_rank:
            fail("cold_gap_rank_empty")
        pass_marker("cold_source_gap_report")
        full_ast = optional_full_ast_probe(emitter, cold_source, target, work)
        fixture = run_fixture_roundtrip(work, emitter, lower, target)
        report = {
            "schema": "cold-csg-probe-smoke.v1",
            "hostTarget": target,
            "fullCold": {
                "source": "bootstrap/cheng_cold.c",
                "clangSyntaxOnly": True,
                "complete": False,
                "reason": "full cold compiler uses C semantics outside the current c-csg closed subset",
                "gapRank": gap_rank,
                "fullAstProbe": full_ast,
            },
            "fixture": fixture,
        }
        report_path = work / "cold-csg-probe.report.json"
        write_json(report_path, report)
        if cleanup:
            print("report=temporary_cleaned set CHENG_COLD_CSG_PROBE_KEEP_WORK=1 or CHENG_COLD_CSG_PROBE_WORK=<dir> to preserve")
        else:
            print(f"report={report_path}")
        pass_marker("cold_csg_probe_smoke")
        return 0
    finally:
        if cleanup:
            shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
