#!/usr/bin/env python3
"""Static contract for Linux held-exec per-message credential authority."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path


def require(condition: bool, reason: str) -> None:
    if not condition:
        raise SystemExit("held_exec_passcred_static_gate: " + reason)


def between(source: str, start: str, end: str, label: str) -> str:
    require(source.count(start) == 1, label + "_start_anchor")
    begin = source.index(start)
    require(source.count(end, begin + len(start)) >= 1, label + "_end_anchor")
    finish = source.index(end, begin + len(start))
    return source[begin:finish]


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


parser = argparse.ArgumentParser()
parser.add_argument("--root", type=Path)
args = parser.parse_args()
root = (args.root or Path(__file__).resolve(strict=True).parents[1]).resolve()
host_path = root / "src/core/runtime/program_support_host_runtime.cheng"
backend_path = root / "src/core/runtime/program_support_backend.cheng"
require(host_path.is_file(), "host_source_missing")
require(backend_path.is_file(), "backend_source_missing")
host = host_path.read_text(encoding="utf-8")
backend = backend_path.read_text(encoding="utf-8")

socketpair = between(
    host,
    'fn cheng_host_socketpair_passcred_runtime_export(',
    '@exportc("cheng_host_fork_runtime")',
    "socketpair",
)
receive = between(
    host,
    'fn cheng_host_recv_credentialed_optional_fd_runtime_export(',
    '# Darwin held-exec descriptor transport.',
    "receive",
)
cleanup = between(
    host,
    'fn cheng_host_linux_close_received_rights(',
    '# Linux credentialed one-shot receive.',
    "cleanup",
)
backend_start = '# --- production held-exec one-shot channel'
require(backend.count(backend_start) == 1, "backend_start_anchor")
held_backend = backend[backend.index(backend_start) :]

for marker in (
    "chengHostLinuxScmCredentials: int32 = 2",
    "chengHostLinuxSoPasscred: int32 = 16",
    "chengHostLinuxCmsgHeaderBytes: int32 = 16",
    "chengHostLinuxCmsgLenCredentials: uint64 = uint64(28)",
    "chengHostLinuxCmsgLenOneFd: uint64 = uint64(20)",
    "chengHostLinuxCredentialControlBytes: int32 = 1088",
):
    require(marker in host, "host_constant_missing:" + marker)

require(socketpair.count("raw_libc_setsockopt(") == 2, "passcred_not_set_both")
require(
    socketpair.count("raw_libc_getsockopt_runtime(") == 2,
    "passcred_not_verified_both",
)
for marker in (
    "chengHostLinuxSoPasscred",
    "observed0 != 1 || observed1 != 1",
    "raw_libc_close(*fd0)",
    "raw_libc_close(*fd1)",
    "*fd0 = -1",
    "*fd1 = -1",
):
    require(marker in socketpair, "socketpair_contract_missing:" + marker)

for marker in (
    "while valid && cursor < controlBytes:",
    "credentialCount != 1",
    "rightsCount > 1",
    "cursor != controlBytes",
    "if length != chengHostLinuxCmsgLenCredentials ||\n"
    "               credentialCount != 0:",
    "length != chengHostLinuxCmsgLenOneFd",
    "kind == chengHostLinuxScmCredentials",
    "kind == chengHostLinuxScmRights",
    "parsedPid <= 0",
    "chengHostLinuxMsgCtrunc | chengHostLinuxMsgTrunc",
    "chengHostLinuxMsgTrunc | chengHostLinuxMsgCmsgCloexec",
    "else:\n            valid = false",
    "ptr(&control), availableControlBytes",
    "*outPid = parsedPid",
    "*outUid = parsedUid",
    "*outGid = parsedGid",
):
    require(marker in receive, "receive_contract_missing:" + marker)
require(
    receive.count("cheng_host_linux_close_received_rights(") == 2,
    "malformed_cleanup_not_total",
)
for marker in (
    "dataBytes % int32(sizeof(int32)) == 0",
    "for fdIndex in 0..<fdCount:",
    "raw_libc_close(receivedFd)",
):
    require(marker in cleanup, "fd_cleanup_missing:" + marker)

for annotation in (
    '@exportc("cheng_host_socketpair_passcred_runtime")\n@abi_internal\nfn ',
    '@exportc("cheng_host_recv_credentialed_optional_fd_runtime")\n@abi_internal\nfn ',
):
    require(annotation in host, "host_abi_internal_missing")
for annotation in (
    '@importc("cheng_host_socketpair_passcred_runtime")\n@abi_internal\nfn ',
    '@importc("cheng_host_recv_credentialed_optional_fd_runtime")\n@abi_internal\nfn ',
):
    require(annotation in backend, "backend_abi_internal_missing")

for marker in (
    "libc_socketpair_passcred_runtime(",
    "libc_recv_credentialed_optional_fd_runtime(",
    "libc_terminal_activate_receive_owner_pid(nativeOwner)",
    "chengHeldExecChildCapsuleRoleParentPids[activateRoleRow]",
    "chengHeldExecChildParentUid = parentUid",
    "chengHeldExecChildParentGid = parentGid",
    "claimReceive.pid == childPid",
    "claimReceive.uid",
    "claimReceive.gid",
    "cheng_held_exec_receive_wire_from(",
    "cheng_held_exec_receive_wire_with_optional_fd_from(",
    "cheng_held_exec_receive_wire_or_child_exit_from(",
    "cheng_held_exec_receive_terminal_or_child_exit_from(",
    "actualUid == expectedUid &&",
    "actualGid == expectedGid",
):
    require(marker in held_backend, "backend_binding_missing:" + marker)
require("chengHeldExecSoPeerCred" not in held_backend, "so_peercred_fallback")
require("libc_recv_optional_fd_runtime(" not in held_backend, "old_recv_fallback")
require("libc_socketpair_runtime(" not in held_backend, "old_socketpair_fallback")

print("held_exec_passcred_static_gate_status=pass")
print(f"host_bytes={host_path.stat().st_size}")
print(f"host_sha256={digest(host_path)}")
print(f"backend_bytes={backend_path.stat().st_size}")
print(f"backend_sha256={digest(backend_path)}")
