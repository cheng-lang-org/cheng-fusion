#!/usr/bin/python3
"""Privileged fixed-path publisher for bootstrap stage23 authority.

The production verifier composes deterministic candidate bytes without
authority.  This executable is the only writer that may turn those bytes into
production authority.  It takes no caller-selected path, never replaces an
existing target, and publishes the fixed system receipt only after every
repository material object and both lane closures have been replayed again.
"""

from __future__ import annotations

import ctypes
import errno
import hashlib
import os
import platform
import stat
import sys
import types
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, NoReturn, Sequence

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve(strict=True).parent.parent
PUBLISHER = Path(__file__).resolve(strict=True)
PRODUCTION_GATE = (
    ROOT / "tools/bootstrap_stage23_current_source_fixed_point_production_gate"
)
REPOSITORY_CONTROL = (
    ROOT
    / "artifacts/bootstrap/.bootstrap-stage23-authority-publisher-control"
)
SYSTEM_CONTROL = Path(
    "/private/var/db/cheng/.bootstrap-stage23-authority-publisher-control"
)
DARWIN_RENAME_EXCL = 0x00000004
LINUX_RENAME_NOREPLACE = 0x00000001
STABLE_FIELDS = (
    "st_dev", "st_ino", "st_mode", "st_nlink", "st_size", "st_uid",
    "st_gid", "st_mtime_ns", "st_ctime_ns",
)


class PublisherError(RuntimeError):
    pass


def fail(reason: str) -> NoReturn:
    raise PublisherError(reason)


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def stable_source_bytes(
    path: Path,
    label: str,
) -> tuple[bytes, tuple[int, ...]]:
    if (
        not path.is_absolute()
        or path.is_symlink()
        or path.resolve(strict=True) != path
    ):
        fail(label + " path is not fixed")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                fail(label + " short read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            fail(label + " grew during read")
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    before_path = os.lstat(path)
    identity = tuple(getattr(before, key) for key in STABLE_FIELDS)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or identity != tuple(getattr(after, key) for key in STABLE_FIELDS)
        or identity
            != tuple(getattr(before_path, key) for key in STABLE_FIELDS)
    ):
        fail(label + " changed during held read")
    raw = b"".join(chunks)
    if len(raw) != before.st_size:
        fail(label + " byte count drifted")
    return raw, identity


def load_production_gate() -> tuple[Any, bytes, tuple[int, ...]]:
    raw, identity = stable_source_bytes(PRODUCTION_GATE, "production gate")
    name = "cheng_stage23_authority_publisher_production_gate"
    module = types.ModuleType(name)
    module.__file__ = str(PRODUCTION_GATE)
    module.__package__ = ""
    sys.modules[name] = module
    code = compile(raw, str(PRODUCTION_GATE), "exec", dont_inherit=True)
    exec(code, module.__dict__)
    after_raw, after_identity = stable_source_bytes(
        PRODUCTION_GATE, "production gate"
    )
    if after_raw != raw or after_identity != identity:
        fail("production gate changed across held execution")
    return module, raw, identity


gate, GATE_EXECUTED_RAW, GATE_EXECUTED_IDENTITY = load_production_gate()


@dataclass(frozen=True)
class DirectoryAuthority:
    path: Path
    device: int
    inode: int
    mode: int
    nlink: int
    uid: int
    gid: int


@dataclass(frozen=True)
class FileExpectation:
    raw: bytes
    mode: int
    uid: int
    gid: int
    executable: bool

    @property
    def sha256(self) -> str:
        return sha256_bytes(self.raw)


@dataclass(frozen=True)
class PublicationEntry:
    role: str
    staging: Path
    destination: Path
    expected: FileExpectation


@dataclass(frozen=True)
class VerifiedInputs:
    composite: Any
    composite_raw: bytes
    linux_raw: bytes
    darwin_raw: bytes
    darwin_stage3_raw: bytes
    linux_closure_cid: str
    darwin_closure_cid: str
    verifier_inputs_cid: str
    production_gate_sha256: str
    portable_anchor: Any


def directory_authority(path: Path) -> DirectoryAuthority:
    if (
        not path.is_absolute()
        or path.is_symlink()
        or path.resolve(strict=True) != path
    ):
        fail("publication directory path is not fixed")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        info = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    if not stat.S_ISDIR(info.st_mode):
        fail("publication directory is not a directory")
    return DirectoryAuthority(
        path=path,
        device=info.st_dev,
        inode=info.st_ino,
        mode=info.st_mode,
        nlink=info.st_nlink,
        uid=info.st_uid,
        gid=info.st_gid,
    )


def authority_matches_directory(
    expected: DirectoryAuthority,
    observed: os.stat_result,
) -> bool:
    return (
        expected.device == observed.st_dev
        and expected.inode == observed.st_ino
        and expected.mode == observed.st_mode
        and expected.uid == observed.st_uid
        and expected.gid == observed.st_gid
        and stat.S_ISDIR(observed.st_mode)
    )


def same_directory_authority(
    left: DirectoryAuthority,
    right: DirectoryAuthority,
) -> bool:
    return (
        left.path == right.path
        and left.device == right.device
        and left.inode == right.inode
        and left.mode == right.mode
        and left.uid == right.uid
        and left.gid == right.gid
    )


def open_held_directory(
    expected: DirectoryAuthority,
) -> int:
    descriptor = os.open(
        expected.path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    if not authority_matches_directory(expected, os.fstat(descriptor)):
        os.close(descriptor)
        fail("held publication directory identity drifted")
    return descriptor


def create_or_validate_private_directory(path: Path) -> DirectoryAuthority:
    if not path.is_absolute() or path.name in ("", ".", ".."):
        fail("private publication directory path is invalid")
    parent = directory_authority(path.parent)
    parent_fd = open_held_directory(parent)
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent_fd)
            os.fsync(parent_fd)
        except FileExistsError:
            pass
        info = os.stat(path.name, dir_fd=parent_fd, follow_symlinks=False)
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o700
            or info.st_uid != os.geteuid()
            or info.st_gid != os.getegid()
        ):
            fail("private publication directory authority drifted")
    finally:
        os.close(parent_fd)
    observed = directory_authority(path)
    if not same_directory_authority(directory_authority(path.parent), parent):
        fail("private publication parent changed during creation")
    return observed


def stable_expected_file(
    path: Path,
    expected: FileExpectation,
) -> gate.ArtifactIdentity:
    identity, raw = gate.stable_artifact(
        path, executable=expected.executable
    )
    if (
        raw != expected.raw
        or identity.sha256 != expected.sha256
        or identity.nlink != 1
        or stat.S_IMODE(identity.mode) != expected.mode
        or identity.uid != expected.uid
        or identity.gid != expected.gid
        or bool(identity.mode & 0o111) != expected.executable
    ):
        fail("publication file differs from its exact expectation")
    return identity


def stage_or_validate_file(
    path: Path,
    expected: FileExpectation,
) -> gate.ArtifactIdentity:
    parent = directory_authority(path.parent)
    parent_fd = open_held_directory(parent)
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                path.name,
                os.O_RDWR
                | os.O_CREAT
                | os.O_EXCL
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0),
                expected.mode,
                dir_fd=parent_fd,
            )
        except FileExistsError:
            descriptor = -1
        if descriptor >= 0:
            view = memoryview(expected.raw)
            while view:
                count = os.write(descriptor, view)
                if count <= 0:
                    fail("publication staging write made no progress")
                view = view[count:]
            os.fchmod(descriptor, expected.mode)
            if os.geteuid() == 0:
                os.fchown(descriptor, expected.uid, expected.gid)
            os.fsync(descriptor)
            info = os.fstat(descriptor)
            if (
                info.st_nlink != 1
                or stat.S_IMODE(info.st_mode) != expected.mode
                or info.st_uid != expected.uid
                or info.st_gid != expected.gid
            ):
                fail("publication staging identity drifted")
            os.close(descriptor)
            descriptor = -1
            os.fsync(parent_fd)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent_fd)
    if not same_directory_authority(directory_authority(path.parent), parent):
        fail("publication staging parent identity drifted")
    return stable_expected_file(path, expected)


def rename_publication_entry_exclusive(
    source_parent_descriptor: int,
    source_name: str,
    destination_parent_descriptor: int,
    destination_name: str,
) -> None:
    source = os.fsencode(source_name)
    destination = os.fsencode(destination_name)
    libc = ctypes.CDLL(None, use_errno=True)
    if platform.system() == "Darwin":
        operation = getattr(libc, "renameatx_np", None)
        if operation is None:
            fail("exclusive publication rename is unavailable")
        operation.argtypes = (
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
            ctypes.c_uint,
        )
        operation.restype = ctypes.c_int
        result = operation(
            source_parent_descriptor,
            source,
            destination_parent_descriptor,
            destination,
            DARWIN_RENAME_EXCL,
        )
    elif platform.system() == "Linux":
        operation = getattr(libc, "renameat2", None)
        if operation is None:
            fail("exclusive publication rename is unavailable")
        operation.argtypes = (
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
            ctypes.c_uint,
        )
        operation.restype = ctypes.c_int
        result = operation(
            source_parent_descriptor,
            source,
            destination_parent_descriptor,
            destination,
            LINUX_RENAME_NOREPLACE,
        )
    else:
        fail("exclusive publication rename is unavailable")
    if result == 0:
        return
    error_number = ctypes.get_errno()
    if error_number in (errno.EEXIST, errno.ENOTEMPTY):
        fail("publication destination raced")
    if error_number == errno.EXDEV:
        fail("cross-device publication is forbidden")
    fail("exclusive publication rename failed:" + str(error_number))


def entry_state(entry: PublicationEntry) -> str:
    source_exists = entry.staging.exists() or entry.staging.is_symlink()
    destination_exists = (
        entry.destination.exists() or entry.destination.is_symlink()
    )
    if source_exists and destination_exists:
        fail("publication source and destination both exist:" + entry.role)
    if not source_exists and not destination_exists:
        fail("publication entry is missing:" + entry.role)
    if source_exists:
        stable_expected_file(entry.staging, entry.expected)
        return "STAGED"
    stable_expected_file(entry.destination, entry.expected)
    return "COMMITTED"


def committed_authority_failure() -> NoReturn:
    # Returning HARD_RED after the final rename would misreport an already
    # committed authority state.  A fresh process must validate recovery.
    os.abort()


def commit_entry_exclusive(
    entry: PublicationEntry,
    abort_after_commit: bool = False,
) -> None:
    state = entry_state(entry)
    if state == "COMMITTED":
        return
    source_parent = directory_authority(entry.staging.parent)
    destination_parent = directory_authority(entry.destination.parent)
    source_fd = open_held_directory(source_parent)
    try:
        destination_fd = open_held_directory(destination_parent)
    except BaseException:
        os.close(source_fd)
        raise
    renamed = False
    try:
        try:
            source_info = os.stat(
                entry.staging.name,
                dir_fd=source_fd,
                follow_symlinks=False,
            )
            try:
                os.stat(
                    entry.destination.name,
                    dir_fd=destination_fd,
                    follow_symlinks=False,
                )
            except FileNotFoundError:
                pass
            else:
                fail("publication destination appeared before rename")
            if not stat.S_ISREG(source_info.st_mode):
                fail("publication source changed before rename")
            stable_expected_file(entry.staging, entry.expected)
            rename_publication_entry_exclusive(
                source_fd,
                entry.staging.name,
                destination_fd,
                entry.destination.name,
            )
            renamed = True
            os.fsync(destination_fd)
            if source_fd != destination_fd:
                os.fsync(source_fd)
        finally:
            os.close(destination_fd)
            os.close(source_fd)
        if (
            not same_directory_authority(
                directory_authority(entry.staging.parent), source_parent
            )
            or not same_directory_authority(
                directory_authority(entry.destination.parent),
                destination_parent,
            )
        ):
            fail("publication held directory identity changed across rename")
        installed = stable_expected_file(entry.destination, entry.expected)
        if (
            installed.device != source_info.st_dev
            or installed.inode != source_info.st_ino
        ):
            fail("publication rename did not preserve file identity")
    except BaseException:
        if renamed and abort_after_commit:
            committed_authority_failure()
        raise


def validate_transaction_before_commit(
    entries: Sequence[PublicationEntry],
    terminal_role: str = "authority_receipt",
) -> tuple[str, ...]:
    roles = tuple(entry.role for entry in entries)
    if (
        not terminal_role
        or not roles
        or len(set(roles)) != len(roles)
        or roles[-1] != terminal_role
        or terminal_role in roles[:-1]
    ):
        fail(terminal_role + " is not the unique final commit entry")
    states = tuple(entry_state(entry) for entry in entries)
    if states[-1] == "COMMITTED" and any(
        state != "COMMITTED" for state in states[:-1]
    ):
        fail(terminal_role + " was published before its prerequisites")
    return states


def commit_transaction(
    entries: Sequence[PublicationEntry],
    final_fence: Callable[[], None],
    post_commit_validation: Callable[[], None],
    terminal_role: str = "authority_receipt",
) -> None:
    states = validate_transaction_before_commit(entries, terminal_role)
    if all(state == "COMMITTED" for state in states):
        post_commit_validation()
        return
    for entry in entries[:-1]:
        commit_entry_exclusive(entry)
    final_fence()
    if entry_state(entries[-1]) != "STAGED":
        fail(terminal_role + " appeared before its atomic commit")
    is_authority_commit = terminal_role == "authority_receipt"
    commit_entry_exclusive(
        entries[-1], abort_after_commit=is_authority_commit
    )
    try:
        post_commit_validation()
    except BaseException:
        if is_authority_commit:
            committed_authority_failure()
        raise


def projected_identity(
    identity: gate.ArtifactIdentity,
    destination: Path,
) -> gate.ArtifactIdentity:
    return gate.ArtifactIdentity(
        path_fshex=os.fsencode(str(destination)).hex(),
        sha256=identity.sha256,
        device=identity.device,
        inode=identity.inode,
        mode=identity.mode,
        nlink=identity.nlink,
        size=identity.size,
        uid=identity.uid,
        gid=identity.gid,
        artifact_format=identity.artifact_format,
    )


def fixed_preflight() -> VerifiedInputs:
    if (
        sys.platform != "darwin"
        or platform.machine() != "arm64"
        or os.geteuid() != 0
        or os.getegid() != 0
    ):
        fail("authority publication requires native Darwin arm64 root")
    if gate.AUTHORITY_PUBLISHER != PUBLISHER:
        fail("production gate does not bind this authority publisher")
    gate.verify_bound_inputs()
    first = gate.compose_candidate_from_existing_lane_receipts(
        gate.LINUX_LANE_RECEIPT_PATH,
        gate.DARWIN_LANE_RECEIPT_PATH,
    )
    second = gate.compose_candidate_from_existing_lane_receipts(
        gate.LINUX_LANE_RECEIPT_PATH,
        gate.DARWIN_LANE_RECEIPT_PATH,
    )
    if (
        first[1:] != second[1:]
        or first[0] != second[0]
        or first[0].linux_stage_fixed_point_sha256
            != first[0]._linux_lane_authority.stage3.sha256
        or first[0].darwin_stage_fixed_point_sha256
            != first[0]._darwin_lane_authority.stage3.sha256
    ):
        fail("dual-lane candidate changed across replay")
    composite, composite_raw, linux_raw, darwin_raw = first
    linux_root, linux_closure = gate.sealed_portable_evidence_closure(
        gate.LINUX_EVIDENCE_ROOT, gate.LANE_LINUX
    )
    darwin_root, darwin_closure = gate.sealed_portable_evidence_closure(
        gate.DARWIN_EVIDENCE_ROOT, gate.LANE_DARWIN
    )
    if (
        linux_root.uid != 0
        or linux_root.gid != 0
        or darwin_root.uid != 0
        or darwin_root.gid != 0
    ):
        fail("lane evidence is not under privileged custody")
    stage3_source = Path(os.fsdecode(bytes.fromhex(
        composite.darwin_stage3.path_fshex
    )))
    try:
        stage3_source.relative_to(gate.DARWIN_EVIDENCE_ROOT)
    except ValueError as exc:
        raise PublisherError(
            "Darwin stage3 source escaped its fixed evidence root"
        ) from exc
    stage3_identity, stage3_raw = gate.stable_artifact(
        stage3_source, executable=True
    )
    if stage3_identity != composite.darwin_stage3:
        fail("Darwin stage3 source identity differs from lane receipt")
    gate.validate_darwin_macho_code_signature(
        stage3_raw, "privileged publisher stage3"
    )
    production_identity, production_raw = gate.stable_artifact(
        gate.PRODUCTION_GATE, executable=False
    )
    if production_raw != GATE_EXECUTED_RAW:
        fail("executed production gate bytes changed")
    verifier_cid = gate.verifier_input_set_cid()
    anchor = gate.authenticate_linux_portable_anchor(
        production_sha=production_identity.sha256,
        verifier_inputs_cid=verifier_cid,
        linux_evidence_closure_cid=linux_closure,
        linux_receipt_sha256=sha256_bytes(linux_raw),
        darwin_evidence_closure_cid=darwin_closure,
        darwin_receipt_sha256=sha256_bytes(darwin_raw),
        composite_terminal_sha256=sha256_bytes(composite_raw),
        installed_stage3_sha256=stage3_identity.sha256,
        linux_payload=composite._linux_lane_authority.payload(),
        darwin_payload=composite._darwin_lane_authority.payload(),
    )
    return VerifiedInputs(
        composite=composite,
        composite_raw=composite_raw,
        linux_raw=linux_raw,
        darwin_raw=darwin_raw,
        darwin_stage3_raw=stage3_raw,
        linux_closure_cid=linux_closure,
        darwin_closure_cid=darwin_closure,
        verifier_inputs_cid=verifier_cid,
        production_gate_sha256=production_identity.sha256,
        portable_anchor=anchor,
    )


def exact_final_or_staged_identity(
    staging: Path,
    destination: Path,
    expected: FileExpectation,
) -> gate.ArtifactIdentity:
    if destination.exists() or destination.is_symlink():
        if staging.exists() or staging.is_symlink():
            fail("publication recovery has duplicate physical objects")
        return stable_expected_file(destination, expected)
    staged = stage_or_validate_file(staging, expected)
    return projected_identity(staged, destination)


def raw_bindings_and_publisher_values() -> tuple[Any, dict[str, str]]:
    bindings = gate.verify_existing_authority_raw_bindings()
    linux_identity, linux_closure = gate.sealed_portable_evidence_closure(
        gate.LINUX_EVIDENCE_ROOT, gate.LANE_LINUX
    )
    darwin_identity, darwin_closure = gate.sealed_portable_evidence_closure(
        gate.DARWIN_EVIDENCE_ROOT, gate.LANE_DARWIN
    )
    if (
        linux_identity.uid != 0
        or linux_identity.gid != 0
        or darwin_identity.uid != 0
        or darwin_identity.gid != 0
    ):
        fail("published evidence custody drifted")
    gate.validate_linux_portable_evidence_closure(
        gate.LINUX_EVIDENCE_ROOT,
        bindings.linux_receipt_raw,
        bindings.linux_payload,
    )
    darwin_state, darwin_receipt = gate.reconstruct_darwin_physical_evidence(
        gate.DARWIN_EVIDENCE_ROOT
    )
    if (
        darwin_receipt.receipt_bytes() != bindings.darwin_receipt_raw
        or gate.current_source_snapshot_cid(darwin_state)
            != bindings.composite_payload["sourceSnapshotCid"]
    ):
        fail("published Darwin evidence replay drifted")
    anchor = gate.authenticate_linux_portable_anchor(
        production_sha=bindings.production_gate_identity.sha256,
        verifier_inputs_cid=bindings.verifier_inputs_cid,
        linux_evidence_closure_cid=linux_closure,
        linux_receipt_sha256=bindings.linux_receipt_identity.sha256,
        darwin_evidence_closure_cid=darwin_closure,
        darwin_receipt_sha256=bindings.darwin_receipt_identity.sha256,
        composite_terminal_sha256=bindings.composite_identity.sha256,
        installed_stage3_sha256=bindings.installed_stage3.sha256,
        linux_payload=bindings.linux_payload,
        darwin_payload=bindings.darwin_payload,
    )
    values = gate.privileged_publisher_authority_values(
        bindings, linux_closure, darwin_closure, anchor
    )
    return bindings, values


def publish_fixed_authority() -> bytes:
    verified = fixed_preflight()
    if gate.PUBLISHER_AUTHORITY_RECEIPT_PATH.exists() or (
        gate.PUBLISHER_AUTHORITY_RECEIPT_PATH.is_symlink()
    ):
        report = gate.verify_existing_authority()
        return report

    repository_control = create_or_validate_private_directory(
        REPOSITORY_CONTROL
    )
    repository_work = create_or_validate_private_directory(
        repository_control.path / "work"
    )
    stage3_expectation = FileExpectation(
        verified.darwin_stage3_raw, 0o500, 0, 0, True
    )
    composite_expectation = FileExpectation(
        verified.composite_raw, 0o400, 0, 0, False
    )
    stage3_staging = repository_work.path / "installed-stage3"
    composite_staging = repository_work.path / "composite-terminal.json"
    material_staging = repository_work.path / "material-authority.kv"
    installed = exact_final_or_staged_identity(
        stage3_staging,
        gate.INSTALLED_STAGE3_PATH,
        stage3_expectation,
    )
    exact_final_or_staged_identity(
        composite_staging,
        gate.COMPOSITE_TERMINAL_PATH,
        composite_expectation,
    )
    material_raw = gate.build_authority_bytes(
        verified.composite,
        verified.composite_raw,
        verified.linux_raw,
        verified.darwin_raw,
        installed,
        verified.linux_closure_cid,
        verified.darwin_closure_cid,
        verified.verifier_inputs_cid,
        verified.portable_anchor,
        verified.production_gate_sha256,
    )
    material_expectation = FileExpectation(
        material_raw, 0o400, 0, 0, False
    )
    exact_final_or_staged_identity(
        material_staging,
        gate.AUTHORITY_PATH,
        material_expectation,
    )
    repository_entries = (
        PublicationEntry(
            "installed_stage3",
            stage3_staging,
            gate.INSTALLED_STAGE3_PATH,
            stage3_expectation,
        ),
        PublicationEntry(
            "composite_terminal",
            composite_staging,
            gate.COMPOSITE_TERMINAL_PATH,
            composite_expectation,
        ),
        PublicationEntry(
            "material_receipt",
            material_staging,
            gate.AUTHORITY_PATH,
            material_expectation,
        ),
    )

    # The repository receipt is deterministic material, not the production
    # commit point.  Its final fence still replays both lanes and the external
    # anchor before the material receipt can appear.
    commit_transaction(
        repository_entries,
        lambda: fixed_preflight(),
        lambda: raw_bindings_and_publisher_values(),
        terminal_role="material_receipt",
    )

    _bindings, publisher_values = raw_bindings_and_publisher_values()
    publisher_raw = gate.publisher_authority_receipt_bytes(
        publisher_values
    )
    system_control = create_or_validate_private_directory(SYSTEM_CONTROL)
    system_work = create_or_validate_private_directory(
        system_control.path / "work"
    )
    system_staging = system_work.path / "authority-receipt.kv"
    system_expectation = FileExpectation(
        publisher_raw, 0o400, 0, 0, False
    )
    stage_or_validate_file(system_staging, system_expectation)
    final_entry = PublicationEntry(
        "authority_receipt",
        system_staging,
        gate.PUBLISHER_AUTHORITY_RECEIPT_PATH,
        system_expectation,
    )

    def final_fence() -> None:
        _latest_bindings, latest_values = raw_bindings_and_publisher_values()
        if latest_values != publisher_values:
            fail("publisher inputs changed before the atomic commit")
        stable_expected_file(system_staging, system_expectation)

    commit_transaction(
        (final_entry,),
        final_fence,
        lambda: gate.verify_existing_authority(),
    )
    return gate.verify_existing_authority()


def hard_red(reason: str) -> int:
    encoded = reason.replace("\n", "_").replace("\r", "_")[:512]
    print(
        "schema=cheng.bootstrap_stage23_privileged_authority_publisher",
        file=sys.stderr,
    )
    print("status=HARD_RED", file=sys.stderr)
    print("reason=" + encoded, file=sys.stderr)
    print("publication_target=fixed_paths_only", file=sys.stderr)
    print("dynamic_completion_credit=0", file=sys.stderr)
    return 1


def main(argv: Sequence[str] | None = None) -> int:
    args = tuple(sys.argv[1:] if argv is None else argv)
    if args != ("--publish",):
        return hard_red("exact --publish action required")
    try:
        if (
            sys.flags.isolated != 1
            or sys.flags.no_site != 1
            or sys.flags.dont_write_bytecode != 1
        ):
            fail("publisher requires fixed Python -I -S -B")
        report = publish_fixed_authority()
        sys.stdout.buffer.write(report)
        return 0
    except (OSError, PublisherError, gate.ProductionGateError) as exc:
        return hard_red(str(exc))


if __name__ == "__main__":
    raise SystemExit(main())
