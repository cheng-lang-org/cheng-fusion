class ValidationError(RuntimeError):
    pass


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValidationError("duplicate_json_key:" + key)
        result[key] = value
    return result


def identity_tuple(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def require_lexical_absolute(path: Path, label: str) -> Path:
    raw = os.fspath(path)
    if (
        not path.is_absolute()
        or "\x00" in raw
        or "\n" in raw
        or "\r" in raw
        or os.path.normpath(raw) != raw
    ):
        raise ValidationError(label + "_path_invalid")
    return path


def open_directory_nofollow(path: Path, label: str) -> int:
    require_lexical_absolute(path, label)
    parts = os.fsencode(os.fspath(path)).split(b"/")[1:]
    if any(part in (b"", b".", b"..") for part in parts):
        raise ValidationError(label + "_path_invalid")
    current = os.open(b"/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts:
            next_fd = os.open(
                part,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                dir_fd=current,
            )
            os.close(current)
            current = next_fd
        return current
    except BaseException:
        os.close(current)
        raise


def open_regular_nofollow(path: Path, label: str) -> tuple[int, os.stat_result]:
    require_lexical_absolute(path, label)
    parent_fd = open_directory_nofollow(path.parent, label + "_parent")
    try:
        before = os.stat(path.name, dir_fd=parent_fd, follow_symlinks=False)
        descriptor = os.open(
            os.fsencode(path.name),
            os.O_RDONLY | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )
    finally:
        os.close(parent_fd)
    if identity_tuple(os.fstat(descriptor)) != identity_tuple(before):
        os.close(descriptor)
        raise ValidationError(label + "_open_race")
    return descriptor, before


def stable_read(
    path: Path,
    label: str,
    max_bytes: int,
    *,
    allow_empty: bool = False,
) -> tuple[os.stat_result, bytes]:
    descriptor, before = open_regular_nofollow(path, label)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_size > max_bytes
        or (not allow_empty and before.st_size == 0)
    ):
        os.close(descriptor)
        raise ValidationError(label + "_identity_invalid")
    try:
        opened = os.fstat(descriptor)
        if identity_tuple(opened) != identity_tuple(before):
            raise ValidationError(label + "_open_race")
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise ValidationError(label + "_short_read")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise ValidationError(label + "_grew_during_read")
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = os.lstat(path)
    if identity_tuple(before) != identity_tuple(closed) or identity_tuple(
        before
    ) != identity_tuple(after):
        raise ValidationError(label + "_read_race")
    return before, b"".join(chunks)


def stream_identity(
    path: Path,
    label: str,
    max_bytes: int,
    *,
    executable: bool = False,
    allow_empty: bool = False,
) -> dict[str, Any]:
    descriptor, before = open_regular_nofollow(path, label)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_size > max_bytes
        or (not allow_empty and before.st_size == 0)
        or (executable and before.st_mode & 0o111 == 0)
    ):
        os.close(descriptor)
        raise ValidationError(label + "_identity_invalid")
    digest = hashlib.sha256()
    try:
        opened = os.fstat(descriptor)
        if identity_tuple(opened) != identity_tuple(before):
            raise ValidationError(label + "_open_race")
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise ValidationError(label + "_short_read")
            digest.update(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise ValidationError(label + "_grew_during_read")
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = os.lstat(path)
    if identity_tuple(before) != identity_tuple(closed) or identity_tuple(
        before
    ) != identity_tuple(after):
        raise ValidationError(label + "_read_race")
    return {
        "pathFshex": os.fsencode(str(path)).hex(),
        "sha256": digest.hexdigest(),
        "size": before.st_size,
        "device": before.st_dev,
        "inode": before.st_ino,
        "mode": before.st_mode,
        "uid": before.st_uid,
        "gid": before.st_gid,
        "nlink": before.st_nlink,
        "mtimeNs": before.st_mtime_ns,
        "ctimeNs": before.st_ctime_ns,
    }


def read_held_fd_bounded(descriptor: int, maximum: int) -> bytes:
    chunks: list[bytes] = []
    offset = 0
    while True:
        chunk = os.pread(
            descriptor,
            min(1024 * 1024, maximum - offset + 1),
            offset,
        )
        if not chunk:
            break
        chunks.append(chunk)
        offset += len(chunk)
        if offset > maximum:
            raise ValidationError("held_source_read_too_large")
    return b"".join(chunks)


def require_held_validator_authority(identity: dict[str, Any]) -> None:
    raw_fd = os.environ.get("CHENG_EXACT_VALIDATOR_SOURCE_FD", "")
    claimed_sha = os.environ.get("CHENG_EXACT_VALIDATOR_SOURCE_SHA256", "")
    if not raw_fd.isdigit() or claimed_sha != identity["sha256"]:
        raise ValidationError("validator_held_source_authority_missing")
    descriptor = int(raw_fd)
    info = os.fstat(descriptor)
    raw = read_held_fd_bounded(descriptor, 16 * 1024 * 1024)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
        or info.st_dev != identity["device"]
        or info.st_ino != identity["inode"]
        or info.st_mode != identity["mode"]
        or info.st_uid != identity["uid"]
        or info.st_gid != identity["gid"]
        or info.st_size != identity["size"]
        or sha256_bytes(raw) != claimed_sha
    ):
        raise ValidationError("validator_held_source_authority_invalid")


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def framed_sha256(values: Sequence[str]) -> str:
    digest = hashlib.sha256()
    digest.update(len(values).to_bytes(8, "big"))
    for value in values:
        raw = value.encode("utf-8")
        digest.update(len(raw).to_bytes(8, "big"))
        digest.update(raw)
    return digest.hexdigest()


def environment_sha256(value: dict[str, str]) -> str:
    return framed_sha256([f"{key}={value[key]}" for key in sorted(value)])


def parse_json_bytes(raw: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                ValidationError(label + "_non_finite_number:" + item)
            ),
        )
    except (ValueError, UnicodeError, ValidationError) as error:
        if isinstance(error, ValidationError):
            raise
        raise ValidationError(label + "_json_invalid") from error
    if not isinstance(value, dict):
        raise ValidationError(label + "_not_object")
    return value


def path_from_fshex(value: Any, label: str) -> Path:
    if not isinstance(value, str) or not value or len(value) % 2:
        raise ValidationError(label + "_fshex_invalid")
    try:
        raw = bytes.fromhex(value)
        decoded = os.fsdecode(raw)
    except (ValueError, UnicodeError) as error:
        raise ValidationError(label + "_fshex_invalid") from error
    if os.fsencode(decoded) != raw:
        raise ValidationError(label + "_fshex_not_roundtrip")
    return Path(decoded)


def decode_cgroup_path(value: Any, label: str) -> str:
    path = path_from_fshex(value, label)
    text = str(path)
    if CGROUP_PATH_RE.fullmatch(text) is None:
        raise ValidationError(label + "_invalid")
    return text


def require_exact_int(value: Any, expected: int, label: str) -> None:
    if type(value) is not int or value != expected:
        raise ValidationError(label + "_invalid")


def require_uint(
    value: Any,
    label: str,
    *,
    minimum: int = 0,
    maximum: int | None = None,
) -> int:
    if type(value) is not int or value < minimum:
        raise ValidationError(label + "_invalid")
    if maximum is not None and value > maximum:
        raise ValidationError(label + "_invalid")
    return value


def require_sha(value: Any, label: str, *, allow_zero: bool = False) -> str:
    if (
        not isinstance(value, str)
        or SHA256_RE.fullmatch(value) is None
        or (not allow_zero and value == "0" * 64)
    ):
        raise ValidationError(label + "_invalid")
    return value


def require_text(value: Any, expected: str, label: str) -> None:
    if not isinstance(value, str) or value != expected:
        raise ValidationError(label + "_invalid")


def public_file_identity(identity: dict[str, Any]) -> dict[str, Any]:
    return {key: identity[key] for key in FILE_IDENTITY_KEYS}


def validate_file_identity_receipt(
    value: Any,
    actual: dict[str, Any],
    label: str,
) -> None:
    if not isinstance(value, dict) or set(value) != FILE_IDENTITY_KEYS:
        raise ValidationError(label + "_shape_invalid")
    if value != public_file_identity(actual):
        raise ValidationError(label + "_mismatch")


def resolve_relative(evidence: Path, value: Any, label: str) -> Path:
    if (
        not isinstance(value, str)
        or not value
        or value.startswith("/")
        or "\\" in value
    ):
        raise ValidationError(label + "_relative_path_invalid")
    parts = value.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise ValidationError(label + "_relative_path_invalid")
    candidate = evidence.joinpath(*parts)
    require_lexical_absolute(candidate, label)
    try:
        candidate.relative_to(evidence)
    except ValueError as error:
        raise ValidationError(label + "_outside_evidence") from error
    return candidate


def validate_kernel_runner_contract(path: Path) -> dict[str, Any]:
    identity = stream_identity(
        path,
        "kernel_runner",
        4 * 1024 * 1024,
        executable=True,
    )
    _info, raw = stable_read(path, "kernel_runner", 4 * 1024 * 1024)
    source = raw.decode("utf-8", "strict")
    required = (
        "LIMIT_BYTES=805306368",
        "SWAP_BYTES=0",
        "CGROOT=/sys/fs/cgroup",
        "runner_execution_identity()",
        "open_absolute_directory_nofollow(CGROUP_ROOT)",
        "subtree_control = stable_readat(",
        'b"cgroup.subtree_control"',
        "ancestor_limit_effective = audit_ancestor_limits(",
        'stable_readat(child_fd, b"memory.events.local")',
        'writeat(child_fd, b"cgroup.kill", b"1")',
        "wait_populated_zero(child_fd, timeout_seconds)",
        "select.poll()",
        "os.rename(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)",
        "os.fsync(parent_fd)",
        "atomic_evidence_commit = ATOMIC_COMMIT",
        '"memoryEventsLocalRawBeforeFshex"',
        '"memoryEventsLocalRawAfterFshex"',
    )
    if any(fragment not in source for fragment in required):
        raise ValidationError("kernel_runner_contract_missing")
    if source.count("LIMIT_BYTES=805306368") != 1:
        raise ValidationError("kernel_runner_limit_definition_ambiguous")
    exact_counts = {
        'writeat(child_fd, b"cgroup.kill", b"1")': 3,
        "wait_populated_zero(child_fd, timeout_seconds)": 2,
        "os.fsync(parent_fd)": 1,
        "os.rename(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)": 1,
        'stable_readat(child_fd, b"memory.events.local")': 2,
        "runner_execution_identity()": 2,
    }
    if any(source.count(token) != count for token, count in exact_counts.items()):
        raise ValidationError("kernel_runner_authority_call_count_invalid")
    payload_start = source.find("<<'PY'\n")
    payload_end = source.rfind("\nPY\n")
    if payload_start < 0 or payload_end <= payload_start:
        raise ValidationError("kernel_runner_python_payload_missing")
    payload = source[payload_start + len("<<'PY'\n"):payload_end]
    try:
        tree = ast.parse(payload)
    except SyntaxError as error:
        raise ValidationError("kernel_runner_python_payload_invalid") from error
    constants = {
        node.value
        for node in ast.walk(tree)
        if isinstance(node, ast.Constant) and isinstance(node.value, (str, bytes))
    }
    if b"memory.events" in constants or "memory.events" in constants:
        raise ValidationError("kernel_runner_hierarchical_memory_events_forbidden")
    if b"memory.events.local" not in constants:
        raise ValidationError("kernel_runner_local_memory_events_missing")
    functions = {
        node.name: ast.get_source_segment(payload, node)
        for node in tree.body
        if isinstance(node, ast.FunctionDef)
    }
    main_source = functions.get("main") or ""
    spawn_source = functions.get("spawn_workload") or ""
    limit_index = main_source.find('writeat(child_fd, b"memory.max"')
    spawn_index = main_source.find("spawn_workload(child_fd, mode, command)")
    attach_index = spawn_source.find("attach_self(child_fd)")
    exec_index = spawn_source.find("os.execve(argv[0], argv, dict(os.environ))")
    if not (
        0 <= limit_index < spawn_index
        and 0 <= attach_index < exec_index
    ):
        raise ValidationError("kernel_runner_attach_not_before_exec")
    forbidden = (
        "resource.set" + "rlimit",
        "RLIMIT_" + "AS",
        "RLIMIT_" + "RSS",
        "psu" + "til",
        "get" + "rusage",
        "Vm" + "RSS",
        "/proc/self/" + "status",
        "ps -o " + "rss",
    )
    lowered = source.lower()
    if any(fragment.lower() in lowered for fragment in forbidden):
        raise ValidationError("kernel_runner_userspace_memory_authority_forbidden")
    return identity


def validate_gate_process_tree_contract(path: Path) -> dict[str, Any]:
    identity = stream_identity(
        path,
        "gate_source",
        16 * 1024 * 1024,
        executable=True,
    )
    _info, raw = stable_read(path, "gate_source", 16 * 1024 * 1024)
    source = raw.decode("utf-8", "strict")
    required = (
        "PR_SET_CHILD_SUBREAPER = 36",
        "PR_SET_NO_NEW_PRIVS = 38",
        "os.setgroups([])",
        "os.setgid(run_gid)",
        "os.setuid(run_uid)",
        "os.waitpid(-1, 0)",
        "command_adapter_identity_drop_failed",
        "open_verified_fd(identity, \"command_spec_executable_execution\")",
        'os.execve(f"/proc/self/fd/{executable_fd}", argv, env)',
        "pass_fds=(runner_fd, cwd_fd, *extra_fds)",
        "commit_existing_temp(",
        "os.rename(",
        "os.fsync(parent_fd)",
        "start_new_session=True",
        "terminate_timed_out_runner(process)",
        "os.killpg(process.pid, signal.SIGKILL)",
        "cleanup_timed_out_runner_cgroups(process.pid)",
        "wait_cgroup_populated_zero(child_fd, 10)",
        "process.wait()",
        "process.communicate()",
        "CHENG_EXACT_GATE_SOURCE_FD",
        "CHENG_EXACT_GATE_SOURCE_SHA256",
        "require_held_source_authority(",
        'PROCESS_TREE_COMPLETION = "subreaper_waits_all_descendants"',
    )
    if any(fragment not in source for fragment in required):
        raise ValidationError("gate_process_tree_contract_missing")
    exact_counts = {
        "commit_existing_temp(": 4,
        "pass_fds=(runner_fd, cwd_fd, *extra_fds)": 1,
        'os.execve(f"/proc/self/fd/{executable_fd}", argv, env)': 1,
        "os.rename(": 4,
        "os.fsync(parent_fd)": 5,
        "require_held_source_authority(": 3,
    }
    if any(source.count(token) != count for token, count in exact_counts.items()):
        raise ValidationError("gate_authority_call_count_invalid")
    try:
        tree = ast.parse(source)
    except SyntaxError as error:
        raise ValidationError("gate_source_ast_invalid") from error
    functions = {
        node.name: ast.get_source_segment(source, node) or ""
        for node in tree.body
        if isinstance(node, ast.FunctionDef)
    }
    terminate_source = functions.get("terminate_timed_out_runner", "")
    runner_source = functions.get("run_kernel_runner", "")
    kill_group = terminate_source.find("os.killpg(process.pid, signal.SIGKILL)")
    cleanup_cgroup = terminate_source.find(
        "cleanup_timed_out_runner_cgroups(process.pid)",
        kill_group,
    )
    wait_runner = terminate_source.find("process.wait()", cleanup_cgroup)
    reap_runner = terminate_source.find("process.communicate()", wait_runner)
    timeout_handler = runner_source.find("except subprocess.TimeoutExpired")
    terminate_call = runner_source.find(
        "terminate_timed_out_runner(process)",
        timeout_handler,
    )
    if not (
        0 <= kill_group < cleanup_cgroup < wait_runner < reap_runner
        and 0 <= timeout_handler < terminate_call
        and "process.kill()" not in runner_source
    ):
        raise ValidationError("gate_timeout_process_tree_cleanup_order_invalid")
    subreaper = source.find("prctl(PR_SET_CHILD_SUBREAPER")
    fork = source.find("child = os.fork()", subreaper)
    drop = source.find("os.setuid(run_uid)", fork)
    execute = source.find(
        'os.execve(f"/proc/self/fd/{executable_fd}", argv, env)',
        drop,
    )
    wait_all = source.find("os.waitpid(-1, 0)", execute)
    if not (0 <= subreaper < fork < drop < execute < wait_all):
        raise ValidationError("gate_process_tree_order_invalid")
    return identity


def parse_event_bytes(raw: bytes, label: str) -> dict[str, int]:
    if not raw.endswith(b"\n") or b"\r" in raw:
        raise ValidationError(label + "_framing_invalid")
    result: dict[str, int] = {}
    for line in raw[:-1].split(b"\n"):
        fields = line.split(b" ")
        if len(fields) != 2 or not fields[1].isdigit():
            raise ValidationError(label + "_row_invalid")
        try:
            key = fields[0].decode("ascii", "strict")
        except UnicodeError as error:
            raise ValidationError(label + "_key_invalid") from error
        if not key or key in result:
            raise ValidationError(label + "_key_invalid")
        result[key] = int(fields[1])
    if not result:
        raise ValidationError(label + "_empty")
    return result


def validate_root_identity(value: Any, label: str) -> dict[str, Any]:
    keys = {"pathFshex", "device", "inode", "mode", "uid", "gid"}
    if not isinstance(value, dict) or set(value) != keys:
        raise ValidationError(label + "_shape_invalid")
    if (
        value["pathFshex"] != os.fsencode("/sys/fs/cgroup").hex()
        or any(type(value[key]) is not int or value[key] < 0 for key in keys - {"pathFshex"})
        or value["uid"] != 0
        or stat.S_IMODE(value["mode"]) & 0o022
        or not stat.S_ISDIR(value["mode"])
    ):
        raise ValidationError(label + "_value_invalid")
    return value


def validate_authority_closure(
    value: Any,
    cgroup_path: str,
    before_raw: bytes,
    after_raw: bytes,
) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != AUTHORITY_CLOSURE_KEYS:
        raise ValidationError("authority_closure_shape_invalid")
    ancestors = value["ancestorLimitsEffective"]
    if not isinstance(ancestors, list) or len(ancestors) != 2:
        raise ValidationError("authority_ancestor_chain_invalid")
    for index, (row, expected_path) in enumerate(zip(
        ancestors,
        (cgroup_path, "/sys/fs/cgroup"),
        strict=True,
    )):
        if not isinstance(row, dict) or set(row) != {"pathFshex", "memoryMaxBytes"}:
            raise ValidationError("authority_ancestor_row_invalid")
        if row["pathFshex"] != os.fsencode(expected_path).hex():
            raise ValidationError("authority_ancestor_path_invalid")
        maximum = row["memoryMaxBytes"]
        if index == 0:
            if type(maximum) is not int or maximum != LIMIT_BYTES:
                raise ValidationError("authority_child_limit_not_exact")
        elif not (maximum == "max" or type(maximum) is int and maximum >= LIMIT_BYTES):
            raise ValidationError("authority_ancestor_limit_too_low")
    events = value["memoryEventsLocal"]
    if not isinstance(events, dict) or set(events) != {
        "source", "beforeSha256", "afterSha256", "before", "after"
    }:
        raise ValidationError("authority_local_events_shape_invalid")
    before = parse_event_bytes(before_raw, "memory_events_local_before")
    after = parse_event_bytes(after_raw, "memory_events_local_after")
    if (
        events["source"] != "memory.events.local"
        or events["beforeSha256"] != sha256_bytes(before_raw)
        or events["afterSha256"] != sha256_bytes(after_raw)
        or events["before"] != before
        or events["after"] != after
        or set(before) != set(after)
        or any(after[key] < before[key] for key in before)
    ):
        raise ValidationError("authority_local_events_binding_invalid")
    if value["cgroupKillUsed"] != 1 or value["populatedAfterKill"] != 0:
        raise ValidationError("authority_cleanup_invalid")
    root_before = validate_root_identity(value["cgroupRootIdentityBefore"], "root_before")
    root_after = validate_root_identity(value["cgroupRootIdentityAfter"], "root_after")
    if root_before != root_after or value["cgroupRootOwnershipFrozen"] != 1:
        raise ValidationError("authority_root_identity_drift")
    if value["atomicEvidenceCommit"] != ATOMIC_EVIDENCE_COMMIT:
        raise ValidationError("authority_atomic_commit_invalid")
    return value


def parse_native_receipt(
    raw: bytes,
    mode: str,
    runner_sha256: str,
    kernel_release: str,
) -> dict[str, Any]:
    if not raw.endswith(b"\n") or b"\r" in raw:
        raise ValidationError("native_receipt_framing_invalid")
    value = parse_json_bytes(raw, "native_receipt")
    if canonical_json(value) + b"\n" != raw:
        raise ValidationError("native_receipt_not_canonical")
    expected_keys = {
        "schema", "mode", "status", "enforcement", "cgroupPathFshex",
        "limitBytes", "swapBytes", "workloadRc", "oomKill",
        "memoryPeakBytes", "kernelRelease", "toolSha256",
        "runnerExecutionIdentity", "memoryEventsLocalRawBeforeFshex",
        "memoryEventsLocalRawAfterFshex", "authorityClosure",
    }
    if set(value) != expected_keys:
        raise ValidationError("native_receipt_keys_invalid")
    exact = {
        "schema": NATIVE_RECEIPT_SCHEMA,
        "mode": mode,
        "status": "pass",
        "enforcement": "kernel_cgroup_v2_native",
        "limitBytes": LIMIT_BYTES,
        "swapBytes": SWAP_BYTES,
        "kernelRelease": kernel_release,
        "toolSha256": runner_sha256,
    }
    if any(value[key] != expected for key, expected in exact.items()):
        raise ValidationError("native_receipt_contract_invalid")
    try:
        cgroup_raw = bytes.fromhex(value["cgroupPathFshex"])
        before_raw = bytes.fromhex(value["memoryEventsLocalRawBeforeFshex"])
        after_raw = bytes.fromhex(value["memoryEventsLocalRawAfterFshex"])
        cgroup_path = os.fsdecode(cgroup_raw)
    except (TypeError, ValueError, UnicodeError) as error:
        raise ValidationError("native_receipt_hex_invalid") from error
    if (
        cgroup_raw.hex() != value["cgroupPathFshex"]
        or before_raw.hex() != value["memoryEventsLocalRawBeforeFshex"]
        or after_raw.hex() != value["memoryEventsLocalRawAfterFshex"]
        or os.fsencode(cgroup_path) != cgroup_raw
        or CGROUP_PATH_RE.fullmatch(cgroup_path) is None
    ):
        raise ValidationError("native_receipt_hex_or_path_invalid")
    execution = value["runnerExecutionIdentity"]
    if not isinstance(execution, dict) or set(execution) != {
        "execution", "device", "inode", "mode", "uid", "gid", "nlink",
        "size", "sha256",
    }:
        raise ValidationError("native_runner_execution_shape_invalid")
    if (
        execution["execution"] != "held_fd"
        or execution["nlink"] != 1
        or execution["sha256"] != runner_sha256
        or any(type(execution[key]) is not int or execution[key] < 0 for key in {
            "device", "inode", "mode", "uid", "gid", "nlink", "size"
        })
    ):
        raise ValidationError("native_runner_execution_invalid")
    closure = validate_authority_closure(
        value["authorityClosure"], cgroup_path, before_raw, after_raw
    )
    workload_rc = require_uint(value["workloadRc"], "native_workload_rc")
    oom_kill = require_uint(value["oomKill"], "native_oom_kill")
    memory_peak = require_uint(value["memoryPeakBytes"], "native_memory_peak")
    if memory_peak <= 0 or memory_peak > LIMIT_BYTES:
        raise ValidationError("native_receipt_memory_peak_invalid")
    if mode == "attack":
        if workload_rc == 0 or oom_kill <= 0:
            raise ValidationError("native_receipt_aggregate_attack_not_enforced")
    elif mode == "workload":
        if workload_rc != 0 or oom_kill != 0:
            raise ValidationError("native_receipt_workload_not_clean")
    else:
        raise ValidationError("native_receipt_mode_invalid")
    return {
        "value": value,
        "workloadRc": workload_rc,
        "oomKill": oom_kill,
        "memoryPeakBytes": memory_peak,
        "cgroupPathFshex": value["cgroupPathFshex"],
        "authorityClosure": closure,
        "runnerExecutionIdentity": execution,
    }


def validate_receipt_shape(value: dict[str, Any]) -> str:
    require_text(value.get("schema"), RECEIPT_SCHEMA, "receipt_schema")
    status = value.get("status")
    if status == "passed":
        if set(value) != SUCCESS_KEYS:
            raise ValidationError("success_receipt_keys_invalid")
        require_text(value["proofStatus"], PROOF_STATUS, "proof_status")
        require_text(value["hostSystem"], "Linux", "host_system")
        if not isinstance(value["hostMachine"], str) or not value["hostMachine"]:
            raise ValidationError("host_machine_invalid")
        if not isinstance(value["kernelRelease"], str) or not value["kernelRelease"]:
            raise ValidationError("kernel_release_invalid")
        require_exact_int(value["limitBytes"], LIMIT_BYTES, "limit_bytes")
        require_exact_int(value["swapBytes"], SWAP_BYTES, "swap_bytes")
        require_text(value["memoryScope"], MEMORY_SCOPE, "memory_scope")
        require_text(
            value["kernelAuthority"],
            KERNEL_AUTHORITY,
            "kernel_authority",
        )
        require_text(
            value["processTreePlacement"],
            PROCESS_TREE_PLACEMENT,
            "process_tree_placement",
        )
        require_text(
            value["processTreeCompletion"],
            PROCESS_TREE_COMPLETION,
            "process_tree_completion",
        )
        require_exact_int(
            value["userSpacePollingAuthority"],
            0,
            "userspace_polling_authority",
        )
        require_text(
            value["atomicEvidenceCommit"],
            ATOMIC_EVIDENCE_COMMIT,
            "atomic_evidence_commit",
        )
        if not isinstance(value["authorityClosure"], dict):
            raise ValidationError("authority_closure_missing")
        for key in (
            "manifestIdentity",
            "gateSourceIdentity",
            "validatorSourceIdentity",
            "kernelRunnerSourceIdentity",
        ):
            if not isinstance(value[key], dict) or set(value[key]) != FILE_IDENTITY_KEYS:
                raise ValidationError(key + "_shape_invalid")
        require_uint(
            value["commandCount"],
            "command_count",
            minimum=1,
            maximum=MAX_COMMANDS,
        )
        for key in (
            "manifestSha256",
            "gateSha256",
            "validatorSha256",
            "kernelRunnerSha256",
            "receiptSha256",
        ):
            require_sha(value[key], key)
        if not isinstance(value["aggregateProbe"], dict):
            raise ValidationError("aggregate_probe_invalid")
        if (
            not isinstance(value["commands"], list)
            or len(value["commands"]) != value["commandCount"]
        ):
            raise ValidationError("command_results_invalid")
        return "passed"
    if status == "hard_red":
        if set(value) != FAILURE_KEYS:
            raise ValidationError("failure_receipt_keys_invalid")
        system = value["hostSystem"]
        if not isinstance(system, str) or not system:
            raise ValidationError("failure_host_system_invalid")
        expected_proof = (
            DARWIN_PROOF_STATUS
            if system == "Darwin"
            else ("not_proved" if system == "Linux" else OTHER_PROOF_STATUS)
        )
        require_text(value["proofStatus"], expected_proof, "failure_proof")
        require_exact_int(value["limitBytes"], LIMIT_BYTES, "limit_bytes")
        require_exact_int(value["swapBytes"], SWAP_BYTES, "swap_bytes")
        require_text(
            value["memoryScope"],
            "process_tree_unproved",
            "failure_memory_scope",
        )
        require_text(
            value["kernelAuthority"],
            "none",
            "failure_kernel_authority",
        )
        require_exact_int(
            value["userSpacePollingAuthority"],
            0,
            "userspace_polling_authority",
        )
        if not isinstance(value["reason"], str) or not value["reason"]:
            raise ValidationError("failure_reason_invalid")
        require_text(
            value["atomicEvidenceCommit"],
            ATOMIC_EVIDENCE_COMMIT,
            "failure_atomic_evidence_commit",
        )
        require_sha(value["receiptSha256"], "receipt_sha256")
        for key in (
            "manifestSha256",
            "gateSha256",
            "validatorSha256",
            "kernelRunnerSha256",
        ):
            require_sha(value[key], key, allow_zero=True)
        return "hard_red"
    raise ValidationError("receipt_status_invalid")


def validate_receipt_hash(value: dict[str, Any]) -> None:
    claimed = require_sha(value.get("receiptSha256"), "receipt_sha256")
    payload = dict(value)
    del payload["receiptSha256"]
    if sha256_bytes(canonical_json(payload)) != claimed:
        raise ValidationError("receipt_sha256_mismatch")


def read_receipt(path: Path) -> dict[str, Any]:
    _info, raw = stable_read(path, "receipt", MAX_SMALL_BYTES)
    value = parse_json_bytes(raw, "receipt")
    if canonical_json(value) + b"\n" != raw:
        raise ValidationError("receipt_not_canonical")
    validate_receipt_shape(value)
    validate_receipt_hash(value)
    return value


def read_manifest(path: Path) -> tuple[dict[str, Any], list[dict[str, Any]], str]:
    _info, raw = stable_read(path, "command_manifest", MAX_SMALL_BYTES)
    value = parse_json_bytes(raw, "command_manifest")
    if canonical_json(value) + b"\n" != raw:
        raise ValidationError("command_manifest_not_canonical")
    if set(value) != {
        "schema",
        "limitBytes",
        "runUid",
        "runGid",
        "commands",
    }:
        raise ValidationError("command_manifest_keys_invalid")
    require_text(value["schema"], MANIFEST_SCHEMA, "manifest_schema")
    require_exact_int(value["limitBytes"], LIMIT_BYTES, "manifest_limit")
    run_uid = require_uint(
        value["runUid"],
        "manifest_run_uid",
        minimum=1,
        maximum=2_147_483_647,
    )
    run_gid = require_uint(
        value["runGid"],
        "manifest_run_gid",
        minimum=1,
        maximum=2_147_483_647,
    )
    raw_commands = value["commands"]
    if (
        not isinstance(raw_commands, list)
        or not raw_commands
        or len(raw_commands) > MAX_COMMANDS
    ):
        raise ValidationError("manifest_commands_invalid")
    ids: set[str] = set()
    commands: list[dict[str, Any]] = []
    for index, item in enumerate(raw_commands):
        if not isinstance(item, dict) or set(item) != {
            "id",
            "argv",
            "cwd",
            "env",
            "timeoutSeconds",
        }:
            raise ValidationError(f"manifest_command_{index}_keys_invalid")
        command_id = item["id"]
        if (
            not isinstance(command_id, str)
            or ID_RE.fullmatch(command_id) is None
            or command_id in ids
        ):
            raise ValidationError(f"manifest_command_{index}_id_invalid")
        ids.add(command_id)
        argv = item["argv"]
        if (
            not isinstance(argv, list)
            or not argv
            or len(argv) > MAX_ARGV
            or any(
                not isinstance(argument, str) or not argument or "\x00" in argument
                for argument in argv
            )
        ):
            raise ValidationError(f"manifest_command_{index}_argv_invalid")
        executable = Path(argv[0])
        executable_identity = stream_identity(
            executable,
            f"manifest_command_{index}_executable",
            MAX_ARTIFACT_BYTES,
            executable=True,
        )
        cwd = Path(item["cwd"]) if isinstance(item["cwd"], str) else Path("")
        cwd_fd = open_directory_nofollow(cwd, f"manifest_command_{index}_cwd")
        os.close(cwd_fd)
        raw_env = item["env"]
        if not isinstance(raw_env, dict) or any(
            not isinstance(key, str)
            or ENV_KEY_RE.fullmatch(key) is None
            or not isinstance(entry, str)
            or not entry
            or "\x00" in entry
            for key, entry in raw_env.items()
        ):
            raise ValidationError(f"manifest_command_{index}_env_invalid")
        timeout = require_uint(
            item["timeoutSeconds"],
            f"manifest_command_{index}_timeout",
            minimum=1,
            maximum=MAX_TIMEOUT_SECONDS,
        )
        environment = dict(BASE_ENV)
        environment.update(raw_env)
        commands.append(
            {
                "id": command_id,
                "argv": argv,
                "cwd": str(cwd),
                "env": environment,
                "timeoutSeconds": timeout,
                "runUid": run_uid,
                "runGid": run_gid,
                "executable": executable_identity,
            }
        )
    return value, commands, sha256_bytes(raw)


def validate_file_binding(
    evidence: Path,
    relative: Any,
    expected_sha256: Any,
    expected_size: Any,
    label: str,
) -> Path:
    path = resolve_relative(evidence, relative, label)
    identity = stream_identity(
        path,
        label,
        MAX_ARTIFACT_BYTES,
        allow_empty=True,
    )
    if identity["sha256"] != require_sha(
        expected_sha256, label + "_sha256"
    ) or identity["size"] != require_uint(expected_size, label + "_size"):
        raise ValidationError(label + "_binding_mismatch")
    return path


def validate_aggregate(
    evidence: Path,
    value: Any,
    runner: dict[str, Any],
    kernel_release: str,
) -> None:
    if not isinstance(value, dict) or set(value) != AGGREGATE_KEYS:
        raise ValidationError("aggregate_probe_keys_invalid")
    require_exact_int(value["childCount"], ATTACK_CHILD_COUNT, "attack_count")
    require_exact_int(value["childBytes"], ATTACK_CHILD_BYTES, "attack_bytes")
    require_exact_int(
        value["aggregateBytes"],
        ATTACK_AGGREGATE_BYTES,
        "attack_aggregate",
    )
    if value["childBytes"] >= LIMIT_BYTES or value["aggregateBytes"] <= LIMIT_BYTES:
        raise ValidationError("aggregate_attack_shape_invalid")
    report = resolve_relative(
        evidence,
        value["kernelReceiptRelativePath"],
        "aggregate_kernel_receipt",
    )
    _info, raw = stable_read(
        report,
        "aggregate_kernel_receipt",
        MAX_SMALL_BYTES,
    )
    if sha256_bytes(raw) != require_sha(
        value["kernelReceiptSha256"],
        "aggregate_kernel_receipt_sha256",
    ):
        raise ValidationError("aggregate_kernel_receipt_binding_mismatch")
    parsed = parse_native_receipt(
        raw,
        "attack",
        runner["sha256"],
        kernel_release,
    )
    execution = parsed["runnerExecutionIdentity"]
    for key in ("device", "inode", "mode", "uid", "gid", "nlink", "size", "sha256"):
        if execution[key] != runner[key]:
            raise ValidationError("aggregate_runner_held_identity_mismatch")
    exact = {
        "workloadRc": parsed["workloadRc"],
        "oomKill": parsed["oomKill"],
        "memoryPeakBytes": parsed["memoryPeakBytes"],
        "cgroupPathFshex": parsed["cgroupPathFshex"],
        "authorityClosure": parsed["authorityClosure"],
    }
    if any(value[key] != expected for key, expected in exact.items()):
        raise ValidationError("aggregate_probe_receipt_mismatch")
    require_uint(value["elapsedNs"], "aggregate_elapsed", minimum=1)
    decode_cgroup_path(value["cgroupPathFshex"], "aggregate_cgroup")


def validate_command_result(
    evidence: Path,
    result: Any,
    command: dict[str, Any],
    index: int,
    runner: dict[str, Any],
    kernel_release: str,
) -> None:
    if not isinstance(result, dict) or set(result) != COMMAND_RESULT_KEYS:
        raise ValidationError(f"command_result_{index}_keys_invalid")
    executable = command["executable"]
    exact = {
        "index": index,
        "id": command["id"],
        "argvSha256": framed_sha256(command["argv"]),
        "envSha256": environment_sha256(command["env"]),
        "cwdFshex": os.fsencode(command["cwd"]).hex(),
        "timeoutSeconds": command["timeoutSeconds"],
        "runUid": command["runUid"],
        "runGid": command["runGid"],
        "executablePathFshex": executable["pathFshex"],
        "executableSha256": executable["sha256"],
        "executableSize": executable["size"],
        "executableIdentity": public_file_identity(executable),
        "workloadRc": 0,
        "oomKill": 0,
    }
    if any(result[key] != expected for key, expected in exact.items()):
        raise ValidationError(f"command_result_{index}_binding_mismatch")
    spec_path = resolve_relative(
        evidence,
        result["specRelativePath"],
        f"command_{index}_spec",
    )
    _spec_info, spec_raw = stable_read(
        spec_path,
        f"command_{index}_spec",
        MAX_SMALL_BYTES,
    )
    if sha256_bytes(spec_raw) != require_sha(
        result["specSha256"],
        f"command_{index}_spec_sha256",
    ):
        raise ValidationError(f"command_{index}_spec_binding_mismatch")
    spec = parse_json_bytes(spec_raw, f"command_{index}_spec")
    if canonical_json(spec) + b"\n" != spec_raw or set(spec) != SPEC_KEYS:
        raise ValidationError(f"command_{index}_spec_shape_invalid")
    stdout_path = validate_file_binding(
        evidence,
        result["stdoutRelativePath"],
        result["stdoutSha256"],
        result["stdoutBytes"],
        f"command_{index}_stdout",
    )
    stderr_path = validate_file_binding(
        evidence,
        result["stderrRelativePath"],
        result["stderrSha256"],
        result["stderrBytes"],
        f"command_{index}_stderr",
    )
    expected_spec = {
        "schema": COMMAND_SPEC_SCHEMA,
        "id": command["id"],
        "argv": command["argv"],
        "cwd": command["cwd"],
        "env": command["env"],
        "runUid": command["runUid"],
        "runGid": command["runGid"],
        "executablePathFshex": executable["pathFshex"],
        "executableSha256": executable["sha256"],
        "executableSize": executable["size"],
        "stdoutPathFshex": os.fsencode(
            str(stdout_path.parent / ".stdout.bin.incomplete")
        ).hex(),
        "stderrPathFshex": os.fsencode(
            str(stderr_path.parent / ".stderr.bin.incomplete")
        ).hex(),
    }
    if spec != expected_spec:
        raise ValidationError(f"command_{index}_spec_projection_mismatch")
    report = resolve_relative(
        evidence,
        result["kernelReceiptRelativePath"],
        f"command_{index}_kernel_receipt",
    )
    _report_info, raw = stable_read(
        report,
        f"command_{index}_kernel_receipt",
        MAX_SMALL_BYTES,
    )
    if sha256_bytes(raw) != require_sha(
        result["kernelReceiptSha256"],
        f"command_{index}_kernel_receipt_sha256",
    ):
        raise ValidationError(f"command_{index}_kernel_receipt_binding_mismatch")
    parsed = parse_native_receipt(
        raw,
        "workload",
        runner["sha256"],
        kernel_release,
    )
    execution = parsed["runnerExecutionIdentity"]
    for key in ("device", "inode", "mode", "uid", "gid", "nlink", "size", "sha256"):
        if execution[key] != runner[key]:
            raise ValidationError(f"command_{index}_runner_held_identity_mismatch")
    projected = {
        "workloadRc": parsed["workloadRc"],
        "oomKill": parsed["oomKill"],
        "memoryPeakBytes": parsed["memoryPeakBytes"],
        "cgroupPathFshex": parsed["cgroupPathFshex"],
        "authorityClosure": parsed["authorityClosure"],
    }
    if any(result[key] != expected for key, expected in projected.items()):
        raise ValidationError(f"command_{index}_kernel_projection_mismatch")
    require_uint(
        result["memoryPeakBytes"],
        f"command_{index}_memory_peak",
        minimum=1,
        maximum=LIMIT_BYTES,
    )
    require_uint(result["elapsedNs"], f"command_{index}_elapsed", minimum=1)
    decode_cgroup_path(
        result["cgroupPathFshex"],
        f"command_{index}_cgroup",
    )


def validate_success(
    evidence: Path,
    manifest_path: Path,
    receipt: dict[str, Any],
) -> None:
    require_text(receipt["hostSystem"], "Linux", "host_system")
    if platform.system() != "Linux":
        raise ValidationError("success_receipt_requires_linux_validation_host")
    require_text(
        receipt["hostMachine"],
        platform.machine(),
        "host_machine",
    )
    require_text(
        receipt["kernelRelease"],
        platform.release(),
        "kernel_release",
    )
    if (
        path_from_fshex(
            receipt["evidenceDirectoryFshex"],
            "evidence_directory",
        )
        != evidence
    ):
        raise ValidationError("evidence_directory_binding_mismatch")
    if (
        path_from_fshex(
            receipt["manifestPathFshex"],
            "manifest_path",
        )
        != manifest_path
    ):
        raise ValidationError("manifest_path_binding_mismatch")
    _manifest, commands, manifest_sha256 = read_manifest(manifest_path)
    if receipt["manifestSha256"] != manifest_sha256 or receipt["commandCount"] != len(
        commands
    ):
        raise ValidationError("manifest_receipt_binding_mismatch")
    manifest_identity = stream_identity(
        manifest_path,
        "command_manifest_identity",
        MAX_SMALL_BYTES,
    )
    validate_file_identity_receipt(
        receipt["manifestIdentity"],
        manifest_identity,
        "manifest_identity",
    )
    gate = validate_gate_process_tree_contract(GATE_SOURCE)
    validator = stream_identity(
        VALIDATOR_SOURCE,
        "validator_source",
        16 * 1024 * 1024,
        executable=True,
    )
    require_held_validator_authority(validator)
    runner = validate_kernel_runner_contract(KERNEL_RUNNER)
    source_exact = {
        "gatePathFshex": gate["pathFshex"],
        "gateSha256": gate["sha256"],
        "validatorPathFshex": validator["pathFshex"],
        "validatorSha256": validator["sha256"],
        "kernelRunnerPathFshex": runner["pathFshex"],
        "kernelRunnerSha256": runner["sha256"],
    }
    if any(receipt[key] != expected for key, expected in source_exact.items()):
        raise ValidationError("proof_tool_binding_mismatch")
    validate_file_identity_receipt(
        receipt["gateSourceIdentity"],
        gate,
        "gate_source_identity",
    )
    validate_file_identity_receipt(
        receipt["validatorSourceIdentity"],
        validator,
        "validator_source_identity",
    )
    validate_file_identity_receipt(
        receipt["kernelRunnerSourceIdentity"],
        runner,
        "kernel_runner_source_identity",
    )
    validate_aggregate(
        evidence,
        receipt["aggregateProbe"],
        runner,
        receipt["kernelRelease"],
    )
    if receipt["authorityClosure"] != receipt["aggregateProbe"]["authorityClosure"]:
        raise ValidationError("top_level_authority_projection_mismatch")
    for index, (result, command) in enumerate(
        zip(receipt["commands"], commands, strict=True)
    ):
        validate_command_result(
            evidence,
            result,
            command,
            index,
            runner,
            receipt["kernelRelease"],
        )


def validate_evidence(
    evidence: Path,
    manifest_path: Path,
    receipt_path: Path | None = None,
) -> str:
    evidence_fd = open_directory_nofollow(evidence, "evidence_directory")
    try:
        evidence_info = os.fstat(evidence_fd)
    finally:
        os.close(evidence_fd)
    require_lexical_absolute(manifest_path, "command_manifest")
    selected_receipt = receipt_path or evidence / "receipt.json"
    receipt = read_receipt(selected_receipt)
    status = validate_receipt_shape(receipt)
    if status == "hard_red":
        return status
    if (
        evidence_info.st_uid != 0
        or stat.S_IMODE(evidence_info.st_mode) != 0o700
    ):
        raise ValidationError("success_evidence_root_not_frozen")
    receipt_info = os.lstat(selected_receipt)
    if receipt_info.st_uid != 0 or receipt_info.st_nlink != 1:
        raise ValidationError("success_receipt_identity_not_frozen")
    validate_success(evidence, manifest_path, receipt)
    return status


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate CSG exact-1-GiB process-tree evidence",
    )
    parser.add_argument("--evidence-dir", required=True)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--receipt")
    return parser.parse_args(argv)


def main(argv: Sequence[str]) -> int:
    try:
        args = parse_args(argv)
        status = validate_evidence(
            Path(args.evidence_dir),
            Path(args.manifest),
            None if args.receipt is None else Path(args.receipt),
        )
        print("csg_core_exact_1g_receipt_validation=" + status)
        return 0 if status == "passed" else 1
    except (
        ValidationError,
        OSError,
        ValueError,
        TypeError,
        UnicodeError,
    ) as error:
        print(
            "csg_core_exact_1g_receipt_validation=failed",
            file=sys.stderr,
        )
        print(
            "csg_core_exact_1g_receipt_error="
            + str(error).replace("\r", " ").replace("\n", " "),
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
