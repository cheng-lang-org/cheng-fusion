#!/bin/bash -p
set -euo pipefail

umask 077

SCHEMA="cheng.csg_core.production_launcher_install"
ACTION=""
LAUNCHER_SOURCE=""
BINARY_SOURCE=""
LAUNCHER_SOURCE_CID=""
BINARY_SOURCE_CID=""
COMPILER_AUTHORITY_CID=""
EXTERNAL_ANCHOR_CID=""
INSTALL_TRANSACTION_ACTIVE=0
TRANSACTION_MARKER=""

hard_red() {
  printf 'schema=%s\nstatus=HARD_RED\nreason=%s\n' "$SCHEMA" "$1" >&2
  printf 'production_ready=0\ndynamic_completion_credit=0\n' >&2
  exit 1
}

for arg in "$@"; do
  case "$arg" in
    install|verify) [[ -z "$ACTION" ]] || hard_red "duplicate_action"; ACTION="$arg" ;;
    --launcher-source:*) LAUNCHER_SOURCE="${arg#*:}" ;;
    --binary-source:*) BINARY_SOURCE="${arg#*:}" ;;
    --launcher-source-cid:*) LAUNCHER_SOURCE_CID="${arg#*:}" ;;
    --binary-source-cid:*) BINARY_SOURCE_CID="${arg#*:}" ;;
    --compiler-authority-cid:*) COMPILER_AUTHORITY_CID="${arg#*:}" ;;
    --external-anchor-cid:*) EXTERNAL_ANCHOR_CID="${arg#*:}" ;;
    *) hard_red "noncanonical_argument" ;;
  esac
done
[[ -n "$ACTION" ]] || hard_red "action_missing"
[[ "$EUID" -eq 0 ]] || hard_red "root_required"

case "$(/usr/bin/uname -s):$(/usr/bin/uname -m)" in
  Darwin:arm64)
    PLATFORM="darwin-arm64"
    INSTALL_ROOT="/usr/local/libexec/cheng"
    LAUNCHER_TARGET="$INSTALL_ROOT/csg-production-launcher"
    BINARY_TARGET="$INSTALL_ROOT/csg-core-native"
    RECEIPT_ROOT="/private/var/db/cheng"
    RECEIPT_TARGET="$RECEIPT_ROOT/csg-production-launcher-install.receipt"
    ;;
  Linux:x86_64)
    PLATFORM="linux-x86_64"
    INSTALL_ROOT="/usr/libexec/cheng"
    LAUNCHER_TARGET="$INSTALL_ROOT/csg-production-launcher"
    BINARY_TARGET="$INSTALL_ROOT/csg-core-native"
    RECEIPT_ROOT="/var/lib/cheng"
    RECEIPT_TARGET="$RECEIPT_ROOT/csg-production-launcher-install.receipt"
    ;;
  *) hard_red "unsupported_platform" ;;
esac
TRANSACTION_MARKER="$INSTALL_ROOT/.csg-production-launcher.installing"

cleanup_partial_install() {
  local rc="$1"
  trap - EXIT HUP INT TERM
  if [[ "$INSTALL_TRANSACTION_ACTIVE" -eq 1 ]]; then
    for path in "$RECEIPT_TARGET" "$BINARY_TARGET" "$LAUNCHER_TARGET"; do
      if [[ -e "$path" || -L "$path" ]]; then
        case "$PLATFORM" in
          darwin-arm64) /usr/bin/chflags noschg "$path" >/dev/null 2>&1 || true ;;
          linux-x86_64) /usr/bin/chattr -i "$path" >/dev/null 2>&1 || true ;;
        esac
        /bin/rm -f "$path" >/dev/null 2>&1 || true
      fi
    done
    /bin/rm -f "$TRANSACTION_MARKER" >/dev/null 2>&1 || true
  fi
  exit "$rc"
}
trap 'cleanup_partial_install $?' EXIT
trap 'cleanup_partial_install 129' HUP
trap 'cleanup_partial_install 130' INT
trap 'cleanup_partial_install 143' TERM

valid_cid() {
  [[ "$1" =~ ^sha256:[0-9a-f]{64}$ && "$1" != "sha256:$(printf '0%.0s' {1..64})" ]]
}

raw_bytes_cid() {
  case "$PLATFORM" in
    darwin-arm64) printf 'sha256:%s' "$(/usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}')" ;;
    linux-x86_64) printf 'sha256:%s' "$(/usr/bin/sha256sum "$1" | /usr/bin/awk '{print $1}')" ;;
    *) hard_red "platform_state_invalid" ;;
  esac
}

identity_tuple() {
  case "$PLATFORM" in
    darwin-arm64) /usr/bin/stat -f '%d:%i:%p:%l:%z:%u:%g:%m:%c' "$1" ;;
    linux-x86_64) /usr/bin/stat -Lc '%d:%i:%f:%h:%s:%u:%g:%Y:%Z' "$1" ;;
    *) hard_red "platform_state_invalid" ;;
  esac
}

stable_node_tuple() {
  case "$PLATFORM" in
    darwin-arm64) /usr/bin/stat -f '%d:%i:%l:%z:%u:%g' "$1" ;;
    linux-x86_64) /usr/bin/stat -Lc '%d:%i:%h:%s:%u:%g' "$1" ;;
    *) hard_red "platform_state_invalid" ;;
  esac
}

native_image_identity() {
  local path="$1"
  local header
  header="$(/usr/bin/od -An -v -tx1 -N24 "$path" | /usr/bin/tr -d ' \n')" ||
    hard_red "native_image_header_read_failed"
  [[ "${#header}" -eq 48 ]] || hard_red "native_image_header_truncated"
  case "$PLATFORM" in
    darwin-arm64)
      [[ "${header:0:8}" == "cffaedfe" ]] || hard_red "native_image_not_macho64_le"
      [[ "${header:8:8}" == "0c000001" ]] || hard_red "native_image_not_darwin_arm64"
      [[ "${header:24:8}" == "02000000" ]] || hard_red "native_image_not_mh_execute"
      printf '%s' "macho64_le:cputype=16777228:filetype=2"
      ;;
    linux-x86_64)
      [[ "${header:0:8}" == "7f454c46" ]] || hard_red "native_image_not_elf"
      [[ "${header:8:2}" == "02" && "${header:10:2}" == "01" && "${header:12:2}" == "01" ]] ||
        hard_red "native_image_not_elf64_le_v1"
      [[ "${header:32:4}" == "0200" || "${header:32:4}" == "0300" ]] ||
        hard_red "native_image_not_et_exec_or_dyn"
      [[ "${header:36:4}" == "3e00" ]] || hard_red "native_image_not_x86_64"
      [[ "${header:40:8}" == "01000000" ]] || hard_red "native_image_elf_version_invalid"
      printf '%s' "elf64_le:machine=62:type=${header:32:4}"
      ;;
  esac
}

platform_native_image_validate() {
  local path="$1"
  case "$PLATFORM" in
    darwin-arm64)
      [[ -x /usr/bin/otool ]] || hard_red "darwin_otool_missing"
      LC_ALL=C /usr/bin/otool -hv "$path" >/dev/null 2>&1 || hard_red "darwin_macho_header_invalid"
      LC_ALL=C /usr/bin/otool -l "$path" >/dev/null 2>&1 || hard_red "darwin_macho_load_commands_invalid"
      ;;
    linux-x86_64)
      [[ -x /usr/bin/readelf ]] || hard_red "linux_readelf_missing"
      LC_ALL=C /usr/bin/readelf --file-header --wide "$path" >/dev/null 2>&1 || hard_red "linux_elf_header_invalid"
      LC_ALL=C /usr/bin/readelf --program-headers --wide "$path" >/dev/null 2>&1 || hard_red "linux_elf_program_headers_invalid"
      ;;
  esac
}

linux_fsverity_measurement() {
  local path="$1"
  local output digest measured_path extra
  output="$(/usr/bin/fsverity measure "$path")" || hard_red "linux_fsverity_measure_failed"
  read -r digest measured_path extra <<<"$output"
  valid_cid "$digest" || hard_red "linux_fsverity_measure_digest_invalid"
  [[ "$measured_path" == "$path" && -z "${extra:-}" ]] || hard_red "linux_fsverity_measure_output_invalid"
  printf '%s' "$digest"
}

linux_inode_immutable() {
  local path="$1"
  local flags
  flags="$(/usr/bin/lsattr -d "$path" | /usr/bin/awk '{print $1}')" || return 1
  [[ "$flags" == *i* ]]
}

require_fixed_root_parent() {
  local path="$1"
  local raw
  [[ -d "$path" && ! -L "$path" ]] || hard_red "fixed_parent_invalid"
  raw="$(identity_tuple "$path")" || hard_red "fixed_parent_stat_failed"
  case "$PLATFORM" in
    darwin-arm64)
      [[ "$(/usr/bin/stat -f '%u:%g' "$path")" == "0:0" ]] || hard_red "fixed_parent_owner_invalid"
      [[ $((8#$(/usr/bin/stat -f '%Lp' "$path") & 8#022)) -eq 0 ]] || hard_red "fixed_parent_writable"
      ;;
    linux-x86_64)
      [[ "$(/usr/bin/stat -Lc '%u:%g' "$path")" == "0:0" ]] || hard_red "fixed_parent_owner_invalid"
      [[ $((8#$(/usr/bin/stat -Lc '%a' "$path") & 8#022)) -eq 0 ]] || hard_red "fixed_parent_writable"
      ;;
  esac
  [[ -n "$raw" ]] || hard_red "fixed_parent_identity_empty"
}

require_fixed_root_parent_chain() {
  local current="$1"
  [[ "$current" == /* ]] || hard_red "fixed_parent_chain_not_absolute"
  while [[ "$current" != "/" ]]; do
    require_fixed_root_parent "$current"
    current="$(/usr/bin/dirname "$current")"
  done
  require_fixed_root_parent "/"
}

seal_linux_regular_file() {
  local path="$1"
  local initial_mode="$2"
  local final_mode="$3"
  local expected_raw_cid="$4"
  local node_before first_measure node_after_enable second_measure node_final
  [[ "$(/usr/bin/stat -Lc '%u:%g:%h:%a' "$path")" == "0:0:1:$initial_mode" ]] ||
    hard_red "linux_preverity_identity_invalid"
  node_before="$(stable_node_tuple "$path")"
  [[ "$(raw_bytes_cid "$path")" == "$expected_raw_cid" ]] || hard_red "linux_preverity_bytes_mismatch"
  /usr/bin/fsverity enable "$path" >/dev/null || hard_red "linux_fsverity_enable_failed"
  first_measure="$(linux_fsverity_measurement "$path")"
  node_after_enable="$(stable_node_tuple "$path")"
  [[ "$node_after_enable" == "$node_before" ]] || hard_red "linux_enable_identity_changed"
  [[ "$(raw_bytes_cid "$path")" == "$expected_raw_cid" ]] || hard_red "linux_enable_bytes_changed"
  /bin/chmod "$final_mode" "$path" || hard_red "linux_mode_drop_failed"
  [[ "$(/usr/bin/stat -Lc '%u:%g:%h:%a' "$path")" == "0:0:1:$final_mode" ]] ||
    hard_red "linux_final_mode_invalid"
  /usr/bin/chattr +i "$path" || hard_red "linux_inode_immutable_failed"
  linux_inode_immutable "$path" || hard_red "linux_inode_immutable_missing"
  second_measure="$(linux_fsverity_measurement "$path")"
  [[ "$second_measure" == "$first_measure" ]] || hard_red "linux_fsverity_measurement_changed"
  node_final="$(stable_node_tuple "$path")"
  [[ "$node_final" == "$node_before" ]] || hard_red "linux_final_identity_changed"
  [[ "$(raw_bytes_cid "$path")" == "$expected_raw_cid" ]] || hard_red "linux_final_bytes_changed"
  printf '%s' "$second_measure"
}

seal_native_object() {
  local path="$1"
  local expected_raw_cid="$2"
  local expected_native_identity="$3"
  local measurement
  [[ "$(raw_bytes_cid "$path")" == "$expected_raw_cid" ]] || hard_red "installed_bytes_changed"
  [[ "$(native_image_identity "$path")" == "$expected_native_identity" ]] || hard_red "installed_native_identity_changed"
  platform_native_image_validate "$path"
  case "$PLATFORM" in
    darwin-arm64)
      [[ "$(/usr/bin/stat -f '%u:%g:%l:%Lp' "$path")" == "0:0:1:555" ]] || hard_red "darwin_preseal_identity_invalid"
      /usr/bin/codesign --verify --strict --verbose=4 "$path" >/dev/null 2>&1 || hard_red "darwin_codesign_structure_invalid"
      /usr/bin/chflags schg "$path" || hard_red "darwin_system_immutable_failed"
      printf '%s' "not_applicable"
      ;;
    linux-x86_64)
      measurement="$(seal_linux_regular_file "$path" 700 555 "$expected_raw_cid")"
      [[ "$(native_image_identity "$path")" == "$expected_native_identity" ]] || hard_red "linux_seal_native_identity_changed"
      printf '%s' "$measurement"
      ;;
  esac
}

require_installed_identity() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" && -x "$path" ]] || hard_red "installed_object_invalid"
  native_image_identity "$path" >/dev/null
  platform_native_image_validate "$path"
  case "$PLATFORM" in
    darwin-arm64)
      [[ "$(/usr/bin/stat -f '%u:%g:%l:%Lp' "$path")" == "0:0:1:555" ]] || hard_red "installed_identity_invalid"
      /usr/bin/codesign --verify --strict --verbose=4 "$path" >/dev/null 2>&1 || hard_red "darwin_codesign_structure_invalid"
      flags="$(/usr/bin/stat -f '%f' "$path")"
      [[ $((flags & 131072)) -ne 0 ]] || hard_red "darwin_sf_immutable_missing"
      ;;
    linux-x86_64)
      [[ "$(/usr/bin/stat -Lc '%u:%g:%h:%a' "$path")" == "0:0:1:555" ]] || hard_red "installed_identity_invalid"
      linux_fsverity_measurement "$path" >/dev/null
      linux_inode_immutable "$path" || hard_red "linux_inode_immutable_missing"
      ;;
  esac
}

verify_receipt() {
  [[ -f "$RECEIPT_TARGET" && ! -L "$RECEIPT_TARGET" ]] || hard_red "install_receipt_missing"
  case "$PLATFORM" in
    darwin-arm64)
      [[ "$(/usr/bin/stat -f '%u:%g:%l:%Lp' "$RECEIPT_TARGET")" == "0:0:1:400" ]] || hard_red "install_receipt_identity_invalid"
      receipt_flags="$(/usr/bin/stat -f '%f' "$RECEIPT_TARGET")"
      [[ $((receipt_flags & 131072)) -ne 0 ]] || hard_red "install_receipt_sf_immutable_missing"
      ;;
    linux-x86_64)
      [[ "$(/usr/bin/stat -Lc '%u:%g:%h:%a' "$RECEIPT_TARGET")" == "0:0:1:400" ]] || hard_red "install_receipt_identity_invalid"
      linux_fsverity_measurement "$RECEIPT_TARGET" >/dev/null
      linux_inode_immutable "$RECEIPT_TARGET" || hard_red "install_receipt_inode_immutable_missing"
      ;;
  esac
  [[ "$(/usr/bin/grep -Fxc "schema=$SCHEMA" "$RECEIPT_TARGET")" == 1 ]] || hard_red "install_receipt_schema_invalid"
  [[ "$(/usr/bin/grep -Fxc "status=CANDIDATE_INSTALLED" "$RECEIPT_TARGET")" == 1 ]] || hard_red "install_receipt_status_invalid"
  [[ "$(/usr/bin/grep -Fxc "platform=$PLATFORM" "$RECEIPT_TARGET")" == 1 ]] || hard_red "install_receipt_platform_invalid"
  [[ "$(/usr/bin/grep -Fxc "launcher_path=$LAUNCHER_TARGET" "$RECEIPT_TARGET")" == 1 ]] || hard_red "install_receipt_launcher_path_invalid"
  [[ "$(/usr/bin/grep -Fxc "binary_path=$BINARY_TARGET" "$RECEIPT_TARGET")" == 1 ]] || hard_red "install_receipt_binary_path_invalid"
  local launcher_cid binary_cid launcher_native binary_native
  launcher_cid="$(raw_bytes_cid "$LAUNCHER_TARGET")"
  binary_cid="$(raw_bytes_cid "$BINARY_TARGET")"
  launcher_native="$(native_image_identity "$LAUNCHER_TARGET")"
  binary_native="$(native_image_identity "$BINARY_TARGET")"
  [[ "$(/usr/bin/grep -Fxc "launcher_bytes_cid=$launcher_cid" "$RECEIPT_TARGET")" == 1 ]] || hard_red "launcher_receipt_cid_mismatch"
  [[ "$(/usr/bin/grep -Fxc "binary_bytes_cid=$binary_cid" "$RECEIPT_TARGET")" == 1 ]] || hard_red "binary_receipt_cid_mismatch"
  [[ "$(/usr/bin/grep -Fxc "launcher_native_image=$launcher_native" "$RECEIPT_TARGET")" == 1 ]] || hard_red "launcher_native_receipt_mismatch"
  [[ "$(/usr/bin/grep -Fxc "binary_native_image=$binary_native" "$RECEIPT_TARGET")" == 1 ]] || hard_red "binary_native_receipt_mismatch"
  if [[ "$PLATFORM" == "darwin-arm64" ]]; then
    [[ "$(/usr/bin/grep -Fxc 'codesign_structure_verified=1' "$RECEIPT_TARGET")" == 1 ]] || hard_red "codesign_structure_receipt_missing"
    [[ "$(/usr/bin/grep -Fxc 'codesign_identity_authenticated=0' "$RECEIPT_TARGET")" == 1 ]] || hard_red "codesign_identity_receipt_invalid"
    [[ "$(/usr/bin/grep -Fxc 'designated_requirement_authenticated=0' "$RECEIPT_TARGET")" == 1 ]] || hard_red "designated_requirement_receipt_invalid"
  else
    local launcher_measure binary_measure
    launcher_measure="$(linux_fsverity_measurement "$LAUNCHER_TARGET")"
    binary_measure="$(linux_fsverity_measurement "$BINARY_TARGET")"
    [[ "$(/usr/bin/grep -Fxc "launcher_fsverity_measurement=$launcher_measure" "$RECEIPT_TARGET")" == 1 ]] || hard_red "launcher_fsverity_receipt_mismatch"
    [[ "$(/usr/bin/grep -Fxc "binary_fsverity_measurement=$binary_measure" "$RECEIPT_TARGET")" == 1 ]] || hard_red "binary_fsverity_receipt_mismatch"
  fi
}

if [[ "$ACTION" == "install" ]]; then
  [[ -n "$LAUNCHER_SOURCE" && -n "$BINARY_SOURCE" ]] || hard_red "install_source_missing"
  [[ "$LAUNCHER_SOURCE" == /* && "$BINARY_SOURCE" == /* ]] || hard_red "install_source_not_absolute"
  [[ -f "$LAUNCHER_SOURCE" && ! -L "$LAUNCHER_SOURCE" && -x "$LAUNCHER_SOURCE" ]] || hard_red "launcher_source_invalid"
  [[ -f "$BINARY_SOURCE" && ! -L "$BINARY_SOURCE" && -x "$BINARY_SOURCE" ]] || hard_red "binary_source_invalid"
  valid_cid "$LAUNCHER_SOURCE_CID" || hard_red "launcher_source_cid_invalid"
  valid_cid "$BINARY_SOURCE_CID" || hard_red "binary_source_cid_invalid"
  valid_cid "$COMPILER_AUTHORITY_CID" || hard_red "compiler_authority_cid_invalid"
  valid_cid "$EXTERNAL_ANCHOR_CID" || hard_red "external_anchor_cid_invalid"
  [[ ! -e "$LAUNCHER_TARGET" && ! -L "$LAUNCHER_TARGET" ]] || hard_red "launcher_target_already_exists"
  [[ ! -e "$BINARY_TARGET" && ! -L "$BINARY_TARGET" ]] || hard_red "binary_target_already_exists"
  [[ ! -e "$RECEIPT_TARGET" && ! -L "$RECEIPT_TARGET" ]] || hard_red "install_receipt_already_exists"
  [[ ! -e "$TRANSACTION_MARKER" && ! -L "$TRANSACTION_MARKER" ]] || hard_red "install_transaction_incomplete"
  /usr/bin/install -d -o root -g wheel -m 0755 "$INSTALL_ROOT" "$RECEIPT_ROOT" 2>/dev/null ||
    /usr/bin/install -d -o root -g root -m 0755 "$INSTALL_ROOT" "$RECEIPT_ROOT"
  require_fixed_root_parent_chain "$INSTALL_ROOT"
  require_fixed_root_parent_chain "$RECEIPT_ROOT"
  INSTALL_TRANSACTION_ACTIVE=1
  (set -o noclobber; printf 'schema=%s\nstatus=INSTALLING\n' "$SCHEMA" >"$TRANSACTION_MARKER") ||
    hard_red "install_transaction_marker_create_failed"
  /usr/sbin/chown root:wheel "$TRANSACTION_MARKER" 2>/dev/null || /usr/bin/chown root:root "$TRANSACTION_MARKER"
  /bin/chmod 0600 "$TRANSACTION_MARKER"

  launcher_source_bytes_cid="$(raw_bytes_cid "$LAUNCHER_SOURCE")"
  binary_source_bytes_cid="$(raw_bytes_cid "$BINARY_SOURCE")"
  launcher_native_image="$(native_image_identity "$LAUNCHER_SOURCE")"
  binary_native_image="$(native_image_identity "$BINARY_SOURCE")"
  platform_native_image_validate "$LAUNCHER_SOURCE"
  platform_native_image_validate "$BINARY_SOURCE"
  if [[ "$PLATFORM" == "darwin-arm64" ]]; then
    install_mode=0555
  else
    install_mode=0700
  fi
  /usr/bin/install -o root -g wheel -m "$install_mode" "$LAUNCHER_SOURCE" "$LAUNCHER_TARGET" 2>/dev/null ||
    /usr/bin/install -o root -g root -m "$install_mode" "$LAUNCHER_SOURCE" "$LAUNCHER_TARGET"
  /usr/bin/install -o root -g wheel -m "$install_mode" "$BINARY_SOURCE" "$BINARY_TARGET" 2>/dev/null ||
    /usr/bin/install -o root -g root -m "$install_mode" "$BINARY_SOURCE" "$BINARY_TARGET"
  [[ "$(raw_bytes_cid "$LAUNCHER_TARGET")" == "$launcher_source_bytes_cid" ]] || hard_red "launcher_install_bytes_changed"
  [[ "$(raw_bytes_cid "$BINARY_TARGET")" == "$binary_source_bytes_cid" ]] || hard_red "binary_install_bytes_changed"
  [[ "$(native_image_identity "$LAUNCHER_TARGET")" == "$launcher_native_image" ]] || hard_red "launcher_install_native_identity_changed"
  [[ "$(native_image_identity "$BINARY_TARGET")" == "$binary_native_image" ]] || hard_red "binary_install_native_identity_changed"
  platform_native_image_validate "$LAUNCHER_TARGET"
  platform_native_image_validate "$BINARY_TARGET"
  launcher_measurement="$(seal_native_object "$LAUNCHER_TARGET" "$launcher_source_bytes_cid" "$launcher_native_image")"
  binary_measurement="$(seal_native_object "$BINARY_TARGET" "$binary_source_bytes_cid" "$binary_native_image")"

  {
    printf 'schema=%s\nstatus=CANDIDATE_INSTALLED\nplatform=%s\n' "$SCHEMA" "$PLATFORM"
    printf 'launcher_path=%s\nbinary_path=%s\n' "$LAUNCHER_TARGET" "$BINARY_TARGET"
    printf 'launcher_identity=%s\nbinary_identity=%s\n' "$(identity_tuple "$LAUNCHER_TARGET")" "$(identity_tuple "$BINARY_TARGET")"
    printf 'launcher_bytes_cid=%s\nbinary_bytes_cid=%s\n' "$launcher_source_bytes_cid" "$binary_source_bytes_cid"
    printf 'launcher_native_image=%s\nbinary_native_image=%s\n' "$launcher_native_image" "$binary_native_image"
    printf 'launcher_source_cid=%s\nbinary_source_cid=%s\n' "$LAUNCHER_SOURCE_CID" "$BINARY_SOURCE_CID"
    printf 'compiler_authority_cid=%s\nexternal_anchor_cid=%s\n' "$COMPILER_AUTHORITY_CID" "$EXTERNAL_ANCHOR_CID"
    if [[ "$PLATFORM" == "darwin-arm64" ]]; then
      printf 'codesign_structure_verified=1\ncodesign_identity_authenticated=0\ndesignated_requirement_authenticated=0\n'
    else
      printf 'launcher_fsverity_measurement=%s\nbinary_fsverity_measurement=%s\n' "$launcher_measurement" "$binary_measurement"
    fi
  } >"$RECEIPT_TARGET"
  /usr/sbin/chown root:wheel "$RECEIPT_TARGET" 2>/dev/null || /usr/bin/chown root:root "$RECEIPT_TARGET"
  if [[ "$PLATFORM" == "darwin-arm64" ]]; then
    /bin/chmod 0400 "$RECEIPT_TARGET"
    /usr/bin/chflags schg "$RECEIPT_TARGET" || hard_red "receipt_system_immutable_failed"
  else
    receipt_raw_cid="$(raw_bytes_cid "$RECEIPT_TARGET")"
    seal_linux_regular_file "$RECEIPT_TARGET" 600 400 "$receipt_raw_cid" >/dev/null
  fi
  verify_receipt
  /bin/rm -f "$TRANSACTION_MARKER" || hard_red "install_transaction_marker_remove_failed"
  INSTALL_TRANSACTION_ACTIVE=0
fi

[[ ! -e "$TRANSACTION_MARKER" && ! -L "$TRANSACTION_MARKER" ]] ||
  hard_red "install_transaction_incomplete"
require_fixed_root_parent_chain "$INSTALL_ROOT"
require_fixed_root_parent_chain "$RECEIPT_ROOT"
require_installed_identity "$LAUNCHER_TARGET"
require_installed_identity "$BINARY_TARGET"
verify_receipt

printf 'schema=%s\nstatus=CANDIDATE_VERIFIED\nplatform=%s\n' "$SCHEMA" "$PLATFORM"
printf 'launcher_path=%s\nbinary_path=%s\n' "$LAUNCHER_TARGET" "$BINARY_TARGET"
printf 'publisher_identity_authenticated=0\nproduction_ready=0\n'
printf 'reason=runtime_execution_identity_receipt_not_issued_by_installer\n'
