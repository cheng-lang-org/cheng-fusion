#!/usr/bin/env python3
"""Fail-stop ingress for the unique current seven-stage production driver."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import stat
import sys
from dataclasses import dataclass
from typing import Any


FAIL_RC = 97
SCHEMA = "cheng_current_official_seven_stage_producer_preflight"
EMPTY_SHA256 = hashlib.sha256(b"").hexdigest()
READ_BYTES = 1024 * 1024
REPORT_KEYS = {
    "schema",
    "status",
    "reason",
    "consumerImplemented",
    "upstreamImplemented",
    "officialDriverRaw32",
    "officialBuildReceiptRaw32",
    "verifiedStageCount",
}


class PreflightError(RuntimeError):
    pass


class StrictArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise PreflightError("arguments_invalid:" + message)


@dataclass(frozen=True)
class FileState:
    raw: bytes
    sha256: str
    info: os.stat_result


def fail(reason: str) -> None:
    raise PreflightError(reason)


def canonical_json(value: Any) -> str:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        separators=(",", ":"),
        sort_keys=True,
    )


def canonical_path(path: pathlib.Path, label: str) -> pathlib.Path:
    if not path.is_absolute() or pathlib.Path(os.path.realpath(path)) != path:
        fail(label + "_path_not_canonical")
    return path


def file_identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def stable_read(
    path: pathlib.Path,
    label: str,
    *,
    executable: bool = False,
    retain: bool = False,
    max_bytes: int | None = None,
) -> FileState:
    path = canonical_path(path, label)
    before = path.lstat()
    if (
        stat.S_ISLNK(before.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_size <= 0
        or (max_bytes is not None and before.st_size > max_bytes)
        or (executable and before.st_mode & 0o111 == 0)
    ):
        fail(label + "_identity_invalid")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        opened = os.fstat(descriptor)
        if file_identity(opened) != file_identity(before):
            fail(label + "_open_race")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, READ_BYTES)
            if not chunk:
                break
            digest.update(chunk)
            total += len(chunk)
            if retain:
                chunks.append(chunk)
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    if (
        file_identity(before) != file_identity(closed)
        or file_identity(before) != file_identity(after)
    ):
        fail(label + "_read_race")
    if total != before.st_size:
        fail(label + "_short_read")
    raw = b"".join(chunks)
    raw32 = digest.hexdigest()
    if raw32 == EMPTY_SHA256:
        fail(label + "_empty")
    return FileState(raw=raw, sha256=raw32, info=before)


def hard_red(reason: str) -> dict[str, Any]:
    return {
        "schema": SCHEMA,
        "status": "HARD_RED",
        "reason": reason,
        "consumerImplemented": True,
        "upstreamImplemented": False,
        "officialDriverRaw32": "",
        "officialBuildReceiptRaw32": "",
        "verifiedStageCount": 0,
    }


def observe(
    official_driver: pathlib.Path,
    official_build_receipt: pathlib.Path,
) -> dict[str, Any]:
    try:
        driver = stable_read(
            official_driver,
            "official_driver",
            executable=True,
        )
    except FileNotFoundError:
        return hard_red("official_driver_missing")
    except PreflightError as error:
        return hard_red(str(error))
    except OSError:
        return hard_red("official_driver_observation_failed")
    try:
        receipt = stable_read(
            official_build_receipt,
            "official_build_receipt",
        )
    except FileNotFoundError:
        return hard_red("official_build_receipt_missing")
    except PreflightError as error:
        return hard_red(str(error))
    except OSError:
        return hard_red("official_build_receipt_observation_failed")
    return {
        "schema": SCHEMA,
        "status": "READY",
        "reason": "",
        "consumerImplemented": True,
        "upstreamImplemented": True,
        "officialDriverRaw32": driver.sha256,
        "officialBuildReceiptRaw32": receipt.sha256,
        "verifiedStageCount": 0,
    }


def exact_report(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != REPORT_KEYS:
        fail("report_keys_invalid")
    if (
        value["schema"] != SCHEMA
        or value["status"] not in {"READY", "HARD_RED"}
        or not isinstance(value["reason"], str)
        or value["consumerImplemented"] is not True
        or not isinstance(value["upstreamImplemented"], bool)
        or type(value["verifiedStageCount"]) is not int
        or value["verifiedStageCount"] != 0
    ):
        fail("report_header_invalid")
    hashes = (
        value["officialDriverRaw32"],
        value["officialBuildReceiptRaw32"],
    )
    if value["status"] == "HARD_RED":
        if (
            value["reason"] == ""
            or value["upstreamImplemented"]
            or any(item != "" for item in hashes)
        ):
            fail("hard_red_witness_forbidden")
    elif (
        value["reason"] != ""
        or not value["upstreamImplemented"]
        or any(
            not isinstance(item, str)
            or len(item) != 64
            or any(char not in "0123456789abcdef" for char in item)
            or item == "0" * 64
            or item == EMPTY_SHA256
            for item in hashes
        )
    ):
        fail("ready_witness_invalid")
    return value


def parse_report(path: pathlib.Path) -> dict[str, Any]:
    state = stable_read(path, "report", retain=True, max_bytes=4096)
    try:
        text = state.raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise PreflightError("report_utf8_invalid") from error
    if not text.endswith("\n") or "\n" in text[:-1]:
        fail("report_canonical_line_invalid")
    try:
        value = json.loads(text[:-1])
    except json.JSONDecodeError as error:
        raise PreflightError("report_json_invalid") from error
    if canonical_json(value) + "\n" != text:
        fail("report_canonical_json_invalid")
    return exact_report(value)


def build_parser() -> argparse.ArgumentParser:
    parser = StrictArgumentParser()
    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
        parser_class=StrictArgumentParser,
    )
    for command in ("probe", "validate"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("--official-driver", required=True)
        subparser.add_argument("--official-build-receipt", required=True)
        if command == "validate":
            subparser.add_argument("--report", required=True)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    expected = exact_report(
        observe(
            canonical_path(
                pathlib.Path(args.official_driver),
                "official_driver",
            ),
            canonical_path(
                pathlib.Path(args.official_build_receipt),
                "official_build_receipt",
            ),
        )
    )
    if args.command == "probe":
        sys.stdout.write(canonical_json(expected) + "\n")
        return 0 if expected["status"] == "READY" else FAIL_RC
    actual = parse_report(canonical_path(pathlib.Path(args.report), "report"))
    if actual != expected:
        fail("report_live_binding_drift")
    print("current_seven_stage_producer_preflight_validation=PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PreflightError as error:
        print(
            "backend2_current_source_seven_stage_preflight_error=" + str(error),
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
