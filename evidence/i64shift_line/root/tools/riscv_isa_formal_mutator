#!/usr/bin/env python3
"""Write one checker-defined ELF mutation through a guard-held output FD."""

import argparse
import os
import runpy
import struct


def write_all(descriptor: int, payload: bytes) -> None:
    offset = 0
    while offset < len(payload):
        written = os.write(descriptor, payload[offset:])
        if written <= 0:
            raise SystemExit("formal_mutator_short_write")
        offset += written
    os.fsync(descriptor)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--checker", required=True)
    parser.add_argument("--input", required=True)
    parser.add_argument(
        "--kind", required=True,
        choices=("ld", "sd", "op-imm-32", "op-32", "fmt-d"),
    )
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    if not args.output.startswith("/dev/fd/"):
        raise SystemExit("formal_mutator_output_not_fd")
    descriptor_text = args.output[len("/dev/fd/"):]
    if not descriptor_text.isdigit() or int(descriptor_text) not in range(10, 64):
        raise SystemExit("formal_mutator_output_fd_invalid")
    checker = runpy.run_path(args.checker, run_name="cheng_riscv_checker_module")
    words = {
        "ld": checker["spec_word_i"](0x03, 3, 10, 2, 0),
        "sd": checker["spec_word_s"](0x23, 3, 2, 10, 8),
        "op-imm-32": checker["spec_word_i"](0x1B, 0, 10, 10, 1),
        "op-32": checker["spec_word_r"](0x3B, 0, 0, 10, 10, 11),
        "fmt-d": checker["spec_word_r"](0x53, 0, 1, 0, 1, 2),
    }
    data, offset, size = checker["find_text_range"](args.input)
    if size < 4:
        raise SystemExit("formal_mutator_text_too_small")
    payload = bytearray(data)
    payload[offset:offset + 4] = struct.pack("<I", words[args.kind])
    write_all(int(descriptor_text), payload)
    print(
        "mutated=%s out=%s word=0x%08x"
        % (args.kind, args.output, words[args.kind])
    )


if __name__ == "__main__":
    main()
