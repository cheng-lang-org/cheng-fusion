#!/usr/bin/env python3
"""Legacy Python launcher for Clang oracle and pure Cheng C facts emitter."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import platform
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

_COMMON_PATH = Path(__file__).with_name("lang_csg_common")
_LOADER = importlib.machinery.SourceFileLoader("lang_csg_common", str(_COMMON_PATH))
_SPEC = importlib.util.spec_from_loader(_LOADER.name, _LOADER)
if _SPEC is None:
    raise SystemExit("error: failed to load lang_csg_common")
_COMMON = importlib.util.module_from_spec(_SPEC)
_LOADER.exec_module(_COMMON)

CSG_STANDARD = _COMMON.CSG_STANDARD
die = _COMMON.die
rel_display = _COMMON.rel_display
write_json = _COMMON.write_json

ROOT = Path(__file__).resolve().parent.parent


class EmitFailure(Exception):
    def __init__(
        self,
        step: str,
        message: str,
        *,
        command: list[str] | None = None,
        returncode: int | None = None,
        stdout: str = "",
        stderr: str = "",
    ):
        super().__init__(message)
        self.step = step
        self.message = message
        self.command = command or []
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr


def tail(text: str, limit: int = 4000) -> str:
    if len(text) <= limit:
        return text
    return text[-limit:]


def shell_command(parts: list[str]) -> str:
    return " ".join(shlex.quote(str(part)) for part in parts)


def run_step(step: str, cmd: list[str], *, cwd: Path = ROOT) -> subprocess.CompletedProcess[str]:
    run = subprocess.run(cmd, cwd=str(cwd), text=True, capture_output=True, env=os.environ.copy())
    if run.returncode != 0:
        raise EmitFailure(
            step,
            f"{step} failed with exit {run.returncode}",
            command=cmd,
            returncode=run.returncode,
            stdout=run.stdout,
            stderr=run.stderr,
        )
    return run


def host_target() -> str:
    env_target = os.environ.get("CHENG_CSG_HOST_TARGET") or os.environ.get("CHENG_CSG_LOWER_TARGET")
    if env_target:
        return env_target
    machine = platform.machine().lower()
    system = platform.system().lower()
    arch = "arm64" if machine in {"arm64", "aarch64"} else "x86_64" if machine in {"x86_64", "amd64"} else ""
    if not arch:
        die(f"unsupported host architecture for C CSG emit target: {machine}")
    if system == "darwin":
        return f"{arch}-apple-darwin"
    if system == "linux":
        return f"{arch}-unknown-linux-gnu"
    die(f"unsupported host system for C CSG emit target: {system}")
    return ""


def command_args(entry: dict[str, Any]) -> list[str]:
    if isinstance(entry.get("arguments"), list):
        return [str(arg) for arg in entry["arguments"]]
    if isinstance(entry.get("command"), str):
        return shlex.split(entry["command"])
    die(f"compile command for {entry.get('file', '<unknown>')} has no arguments/command")
    return []


def load_compile_commands(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        die(f"missing compile_commands.json: {path}")
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, list) or not data:
        die("compile_commands.json must be a non-empty array")
    entries: list[dict[str, Any]] = []
    for idx, item in enumerate(data):
        if not isinstance(item, dict):
            die(f"compile command entry {idx} is not an object")
        if "file" not in item:
            die(f"compile command entry {idx} missing file")
        entries.append(item)
    return entries


def sanitized_flags(entry: dict[str, Any], source: Path) -> list[str]:
    args = command_args(entry)
    if not args:
        die(f"empty compile command for {source}")
    flags: list[str] = []
    skip_next = False
    source_resolved = source.resolve()
    skip_with_value = {"-o", "-MF", "-MT", "-MQ", "-x", "-include", "-isystem", "-iquote", "-idirafter", "-target"}
    keep_with_value = {"-isystem", "-iquote", "-idirafter", "-include", "-x"}
    for idx, arg in enumerate(args[1:]):
        if skip_next:
            skip_next = False
            continue
        if arg in {"-c", "-S", "-E", "-M", "-MM", "-MD", "-MMD", "-MP"}:
            continue
        if arg in skip_with_value:
            value = args[idx + 2] if idx + 2 < len(args) else ""
            skip_next = True
            if arg in keep_with_value:
                flags.extend([arg, value])
            continue
        if arg.startswith("-o") and arg != "-ObjC":
            continue
        if arg.startswith("--target="):
            continue
        maybe_path = (Path(entry.get("directory", ".")) / arg).resolve()
        if maybe_path == source_resolved:
            continue
        if arg == str(source) or arg == source.name:
            continue
        flags.append(arg)
    return flags


def emit_clang_ast(entry: dict[str, Any], source: Path, target: str, out_ast: Path | None = None) -> str:
    clang = shutil.which("clang")
    if clang is None:
        raise EmitFailure("clang-ast", "clang is required for c-csg emit")
    if out_ast is not None:
        out_ast.parent.mkdir(parents=True, exist_ok=True)
    cmd = [
        clang,
        "-Xclang",
        "-ast-dump=json",
        "-fsyntax-only",
        f"--target={target}",
        *sanitized_flags(entry, source),
        str(source),
    ]
    run = subprocess.run(cmd, cwd=str(Path(entry.get("directory", ".")).resolve()), text=True, capture_output=True)
    if run.returncode != 0:
        raise EmitFailure(
            "clang-ast",
            f"clang rejected {source}",
            command=cmd,
            returncode=run.returncode,
            stdout=run.stdout,
            stderr=run.stderr,
        )
    if out_ast is not None:
        out_ast.write_text(run.stdout, encoding="utf-8")
    return run.stdout


def entry_source(entry: dict[str, Any], compile_commands: Path) -> Path:
    directory = Path(entry.get("directory", compile_commands.parent)).resolve()
    return (directory / str(entry["file"])).resolve()


def write_c_oracle(entries: list[dict[str, Any]], compile_commands: Path, target: str, out_path: Path) -> None:
    units: list[dict[str, Any]] = []
    for idx, entry in enumerate(sorted(entries, key=lambda item: rel_display(compile_commands.parent, entry_source(item, compile_commands)))):
        source = entry_source(entry, compile_commands)
        if not source.exists():
            raise EmitFailure("compile-commands", f"compile command source missing: {source}")
        ast_text = emit_clang_ast(entry, source, target)
        try:
            ast_json = json.loads(ast_text)
        except json.JSONDecodeError as exc:
            raise EmitFailure("clang-ast", f"clang emitted malformed AST JSON for {source}: {exc}") from exc
        units.append(
            {
                "index": idx,
                "source": str(source),
                "displayPath": rel_display(compile_commands.parent, source),
                "astJson": ast_json,
            }
        )
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(
        json.dumps(
            {
                "schema": "c-csg-clang-oracle.v1",
                "target": target,
                "translationUnits": units,
            },
            ensure_ascii=False,
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n",
        encoding="utf-8",
    )


def compile_pure_emit(target: str, out_exe: Path, report: Path) -> None:
    out_exe.parent.mkdir(parents=True, exist_ok=True)
    cmd = [
        str(ROOT / "artifacts" / "backend_driver" / "cheng"),
        "system-link-exec",
        f"--root:{ROOT}",
        f"--in:{ROOT / 'src' / 'core' / 'csg_migration' / 'c_csg_ast_emit.cheng'}",
        "--emit:exe",
        f"--target:{target}",
        f"--out:{out_exe}",
        f"--report-out:{report}",
    ]
    run_step("compile-pure-c-csg-emit", cmd)


def write_wrapper_failure(report_out: Path, failure: EmitFailure) -> None:
    report: dict[str, Any] = {
        "schema": "csg-core.report",
        "standard": CSG_STANDARD,
        "dialect": "csg_dialect::c",
        "toolImplementation": "python-clang-launcher",
        "reportControllerImplementation": "pure-cheng",
        "extractorImplementation": "pure-cheng-clang-ast-json",
        "extractorOracle": "clang-ast-dump-json",
        "pureChengToolchainComplete": False,
        "fullProjectTranspilationComplete": False,
        "complete": False,
        "failedStep": failure.step,
        "reason": failure.message,
        "counts": {"factCount": 0, "unsupported": 0, "runtimeRequirements": 0, "externalSymbols": 0},
        "unsupported": [],
        "runtimeRequirements": [],
        "externalSymbols": [],
        "entryRoots": [],
    }
    if failure.command:
        report["command"] = failure.command
        report["commandText"] = shell_command(failure.command)
    if failure.returncode is not None:
        report["returncode"] = failure.returncode
    if failure.stdout:
        report["stdoutTail"] = tail(failure.stdout)
    if failure.stderr:
        report["stderrTail"] = tail(failure.stderr)
    write_json(report_out, report)


def cmd_emit(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="c-csg emit")
    parser.add_argument("--compile-commands", required=True)
    parser.add_argument("--target", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--report-out", required=True)
    args = parser.parse_args(argv)
    report_out = Path(args.report_out).resolve()
    target = host_target()
    pure_dir = report_out.parent / ".c-csg" / "pure-emit" / target
    pure_exe = pure_dir / "c-csg-ast-emit-pure"
    compile_report = pure_dir / "compile.report.txt"
    ast_out = pure_dir / "clang.ast.json"
    oracle_out = pure_dir / "clang.project.oracle.json"
    try:
        compile_commands = Path(args.compile_commands).resolve()
        entries = load_compile_commands(compile_commands)
        compile_pure_emit(target, pure_exe, compile_report)
        if len(entries) == 1:
            source = entry_source(entries[0], compile_commands)
            if not source.exists():
                raise EmitFailure("compile-commands", f"compile command source missing: {source}")
            emit_clang_ast(entries[0], source, args.target, ast_out)
            pure_cmd = [
                str(pure_exe),
                "emit",
                "--clang-ast-json",
                str(ast_out),
                "--source",
                str(source),
                "--display-path",
                rel_display(compile_commands.parent, source),
                "--target",
                args.target,
                "--out",
                args.out,
                "--report-out",
                args.report_out,
                "--tool-implementation",
                "python-clang-launcher",
            ]
        else:
            write_c_oracle(entries, compile_commands, args.target, oracle_out)
            pure_cmd = [
                str(pure_exe),
                "emit",
                "--oracle-json",
                str(oracle_out),
                "--target",
                args.target,
                "--out",
                args.out,
                "--report-out",
                args.report_out,
                "--tool-implementation",
                "python-clang-launcher",
            ]
        run_step("pure-c-csg-ast-emit", pure_cmd)
    except EmitFailure as failure:
        if not report_out.exists():
            write_wrapper_failure(report_out, failure)
        print(f"error: c-csg emit failed at {failure.step}: {failure.message}", file=sys.stderr)
        return failure.returncode or 1
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print("error: expected command: emit", file=sys.stderr)
        return 2
    if sys.argv[1] in {"-h", "--help"}:
        print("usage: c-csg emit --compile-commands compile_commands.json --target <triple> --out out.csgcore --report-out report.json")
        return 0
    if sys.argv[1] != "emit":
        print("error: expected command: emit", file=sys.stderr)
        return 2
    return cmd_emit(sys.argv[2:])


if __name__ == "__main__":
    raise SystemExit(main())
