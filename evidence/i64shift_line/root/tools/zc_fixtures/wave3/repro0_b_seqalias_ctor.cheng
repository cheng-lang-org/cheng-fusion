# wave3 bail=0 shape B: seq 别名类型 named-args 构造 `alias(len:, cap:, buffer:)`
# 镜像 src/std/hashmaps.cheng hashMapReturnSeqInt32
type
    my_seq_int32 = int32[]

fn returnSeq(out: int32[]): int32[] =
    return my_seq_int32(len: out.len, cap: out.cap, buffer: out.buffer)

fn main(): int32 =
    var s: int32[]
    add(s, 7)
    let t = returnSeq(s)
    return t[0] - 7
