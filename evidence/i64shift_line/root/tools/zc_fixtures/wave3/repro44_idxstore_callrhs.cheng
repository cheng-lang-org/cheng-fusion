# wave3 bail=44 shape S (stmt_kind=7 Assign detail1=2): 索引赋值 RHS=跨模块调用+binop实参+限定常量实参
# 镜像 primary_object_plan.cheng:42562 words[constPos] = a64.A64EncMovz(true, a64.A64X9, op.operands[1] & 65535, 0)
import cheng/core/backend/aarch64_encode as a64

fn fillBlock(words: var int32[], offset: int32, rawValue: int32): int32 =
    var constPos = offset
    words[constPos] = a64.A64EncMovz(true, a64.A64X9, rawValue & 65535, 0)
    constPos = constPos + 1
    return constPos

fn main(): int32 =
    var words: int32[]
    add(words, 0)
    add(words, 0)
    let end = fillBlock(words, 0, 70000)
    return end - 1
