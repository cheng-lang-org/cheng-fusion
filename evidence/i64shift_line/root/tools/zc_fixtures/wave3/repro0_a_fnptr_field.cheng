# wave3 bail=0 shape A: fn-ptr field call `task.entry()` 登记成 named call target
# 镜像 src/std/thread.cheng thread_spawn_trampoline0 (detail=task.entry)
type
    SpawnTask0 = ref object
        entry: fn()

fn identityRaw(raw: ptr): ptr =
    return raw

fn materializeTask(raw: ptr): SpawnTask0 =
    return SpawnTask0(identityRaw(raw))

fn trampoline0(raw: ptr) =
    if raw == nil:
        return
    # 外层 ref 物化不得登记为 call target，内层真调用必须保留。
    let task: SpawnTask0 = SpawnTask0(identityRaw(raw))
    if task == nil:
        return
    if task.entry != nil:
        task.entry()

fn main(): int32 =
    let task = materializeTask(nil)
    if task != nil:
        return 1
    trampoline0(nil)
    return 0
