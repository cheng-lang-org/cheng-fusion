# wave3 bail=44 shape L (stmt_kind=2 LetCall): named-args 构造器 + 嵌套调用实参
# 镜像 lowering_plan.cheng:827 LoweringTypedIrFunctionHasOpKind
type
    FnRow =
        sourcePath: str
        nameLen: int32

fn pickName(items: str[], idx: int32): str =
    if idx < 0 || idx >= items.len:
        return ""
    return items[idx]

fn rowAt(items: str[], idx: int32): FnRow =
    let row = FnRow(
        sourcePath: pickName(items, idx),
        nameLen: len(pickName(items, idx)))
    return row

fn main(): int32 =
    var names: str[]
    add(names, "alpha")
    let r = rowAt(names, 0)
    return r.nameLen - 5
