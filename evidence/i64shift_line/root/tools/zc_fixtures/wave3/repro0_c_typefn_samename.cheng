# wave3 bail=0 shape C: 类型与函数同名 (CompilerRuntimeContract 形) + strutil.Join
# 镜像 src/core/tooling/compiler_runtime.cheng CompilerUsageLines (detail='' 与 detail=Join)
import std/strutils as strutil

type
    Contract =
        version: str
        entryPath: str

fn Contract(rootDir: str): Contract =
    var out: Contract
    out.version = "v1"
    out.entryPath = rootDir
    return out

fn UsageLines(rootDir: str): str[] =
    let contract = Contract(rootDir)
    var out: str[]
    out = []
    add(out, "cheng")
    add(out, strutil.Join(["compiler_entry=", contract.entryPath], ""))
    return out

fn main(): int32 =
    let lines = UsageLines("/tmp/x")
    return lines.len - 2
