# wave3 bail=44 shape L (stmt_kind=2 LetCall): let = 跨模块 named-args 构造器(实参=嵌套调用)
# 镜像 lowering_plan.cheng:827 let fnIr = texpr.TypedExprIrFunction(sourcePath: Value(...), ...)
import cheng/core/backend/object_relocs as orel

fn pickOffset(items: int64[], idx: int32): int64 =
    if idx < 0 || idx >= items.len:
        return int64(0)
    return items[idx]

fn relocAt(items: int64[], idx: int32): orel.ObjectReloc =
    let rec = orel.ObjectReloc(
        sectionIndex: idx,
        offset: pickOffset(items, idx),
        symbolIndex: idx,
        kind: orel.ObjectRelocBranch26,
        addend: pickOffset(items, idx),
        pcRelative: true)
    return rec

fn main(): int32 =
    var offs: int64[]
    add(offs, int64(24))
    let r = relocAt(offs, 0)
    return r.sectionIndex
