# wave3 bail=44 shape N (stmt_kind=4 Call detail1=4): 裸调用语句实参=嵌套跨模块调用
# (嵌套实参含跨模块枚举成员 orel.ObjectRelocBranch26 + int64 cast + bool 字面量)
# 镜像 direct_object_emit.cheng:3084 DirectObjectEmitAddBranchReloc
import cheng/core/backend/object_relocs as orel

fn requireIndex(value: int32, label: str) =
    if value < 0:
        panic(label)

fn addBranchReloc(relocs: var orel.ObjectRelocTable, byteOffset: int64, targetIndex: int32) =
    requireIndex(orel.ObjectRelocsAdd(relocs,
                                      0,
                                      byteOffset,
                                      targetIndex,
                                      orel.ObjectRelocBranch26,
                                      int64(0),
                                      true),
                 "direct object emit: add branch reloc")

fn main(): int32 =
    var relocs = orel.ObjectRelocsInit()
    addBranchReloc(relocs, int64(8), 3)
    return orel.ObjectRelocsCount(relocs) - 1
