# meter canary: FIELD_REF 大偏移语义探针 (imm12 缺陷家族, cheng_cold.c:16741 同臂)
# wave3 实测缺陷: cold arm64 BODY_OP_FIELD_REF 对 OBJECT_REF/PTR 基址臂用 a64_add_imm
# 发射字段偏移, b>4095 时 value<<10 溢进 bit22 shift 位, 偏移静默错 ~4096 倍。
# 本探针两档: tag @ 4160 (>4095, raw imm12 溢出区) / tag2 @ >65535 (hi/lo 组合区)。
# 语义校验: 经 var 形参 (PTR 基址) 写读, main 返回 55; 任何 imm12 族回归 → 值错或崩。
import std/system

type
    BigOff =
        pad: int64[520]
        tag: int32
        pad2: int64[7680]
        tag2: int32

fn setTags(b: var BigOff) =
    b.tag = 40
    b.tag2 = 15

fn readTags(b: var BigOff): int32 =
    return b.tag + b.tag2

fn main(): int32 =
    var b: BigOff
    setTags(b)
    return readTags(b)
