# 变体D: named const 实参只出现在 Ok payload 的第 1 层调用
const
    A64ZR = 31

fn regFieldI32(reg: int32, shift: int32): int32 =
    return reg << shift

fn encOne(rd: int32): Result[int32] =
    if rd < 0 || rd > 30:
        return Err[int32](" enc: register out of range")
    return Ok[int32](regFieldI32(A64ZR, 16))

fn main(): int32 =
    let r = encOne(3)
    if IsErr(r):
        return 1
    return Value(r) - 2031616
