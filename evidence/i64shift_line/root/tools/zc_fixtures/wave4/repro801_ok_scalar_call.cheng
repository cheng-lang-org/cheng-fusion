fn u32ToI32(v: uint64): int32 =
    var out = int32(v & uint64(0x7FFFFFFF))
    if (v & uint64(0x80000000)) != uint64(0):
        out = out - 2147483647
        out = out - 1
    return out

fn regField(reg: int32, shift: int32): uint64 =
    return uint64(reg) << uint64(shift)

fn encCset(rd: int32, cond: int32): Result[int32] =
    if rd < 0 || rd > 30:
        return Err[int32](" enc: register out of range")
    if cond < 0 || cond > 13:
        return Err[int32](" enc: cset condition out of range")
    return Ok[int32](u32ToI32(uint64(0x1A800400) |
                             regField(31, 16) |
                             regField(cond, 12) |
                             regField(31, 5) |
                             regField(rd, 0)))

fn main(): int32 =
    let r = encCset(3, 1)
    if IsErr(r):
        return 1
    return Value(r) - 453775459
