# 变体F: named const 直接作 Ok payload — 镜像 coffRelocTypeForTarget return Ok[uint64](IMAGE_REL_AMD64_ADDR64)
const
    IMAGE_REL_TEST = 257

fn pick(kind: int32): Result[uint64] =
    if kind == 1:
        return Ok[uint64](uint64(IMAGE_REL_TEST))
    if kind == 2:
        return Err[uint64](" unsupported kind")
    return Ok[uint64](uint64(3))

fn main(): int32 =
    let r = pick(1)
    if IsErr(r):
        return 1
    return int32(Value(r)) - 257
