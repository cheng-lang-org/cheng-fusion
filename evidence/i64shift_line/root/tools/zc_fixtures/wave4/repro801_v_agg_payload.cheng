# 变体G: 聚合局部变量作 Ok payload — 镜像 fs.stat return Ok[FileStat](out)
type
    FileInfo =
        size: int64
        mode: int32
        isDir: bool

fn build(sz: int64, mode: int32): Result[FileInfo] =
    if sz < int64(0):
        return Err[FileInfo]("bad size")
    var out: FileInfo
    out.size = sz
    out.mode = mode
    out.isDir = mode == 4
    return Ok[FileInfo](out)

fn main(): int32 =
    let r = build(int64(64), 4)
    if IsErr(r):
        return 1
    return Value(r).mode - 4
