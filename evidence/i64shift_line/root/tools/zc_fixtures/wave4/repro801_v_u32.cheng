# 变体A: 只把 helper 返回类型从 uint64 换成 uint32 (其余同 CLEAN 版)
fn u32ToI32(v: uint32): int32 =
    return int32(v)

fn regField(reg: int32, shift: int32): uint32 =
    return uint32(reg) << uint32(shift)

fn encCset(rd: int32, cond: int32): Result[int32] =
    if rd < 0 || rd > 30:
        return Err[int32](" enc: register out of range")
    if cond < 0 || cond > 13:
        return Err[int32](" enc: cset condition out of range")
    return Ok[int32](u32ToI32(uint32(0x1A800400) |
                             regField(31, 16) |
                             regField(cond, 12) |
                             regField(31, 5) |
                             regField(rd, 0)))

fn main(): int32 =
    let r = encCset(3, 1)
    if IsErr(r):
        return 1
    return Value(r) - 444596227
