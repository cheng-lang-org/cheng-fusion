# wave4 bail=801 detail1=-256 (code0): return A(x) + 3 + B(y) 多项调用算术 — 镜像 PrologueWordCount:6560
fn adjWords(frameBytes: int32): int32 =
    if frameBytes <= 0:
        return 1
    return 2

fn saveCount(n: int32): int32 =
    if n > 4:
        return 4
    return n

fn baseWords(n: int32): int32 =
    if n <= 0:
        return 0
    return 1

fn prologueWords(frameBytes: int32, params: int32, resid: int32): int32 =
    return adjWords(frameBytes) + 3 + saveCount(params) + baseWords(params) + resid

fn main(): int32 =
    return prologueWords(16, 2, 1) - 9
