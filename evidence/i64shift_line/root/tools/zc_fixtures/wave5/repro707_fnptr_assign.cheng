# 707 repro: rsaBigToBytesLocalFill (rsa.cheng:722-745) 跨模块符号维度镜像
# (rsa_pss 现役唯一 707 站点)。最小致败要素 = 类型定义在另一模块且数组维度是
# 该模块的 const 名 (`int32[reproMaxLimbs]`): 字段类型文本携带 const 名流出定义
# 模块后, 使用方 ctx 的 const 解析失败 → RhsIndexElemType badtype → rhsNodeIndex
# 建树被拒 (-1) → node 路径无入口, 文本路径不解嵌套索引读 → bail 707。
# 伴生模块: src/tests/repro707_bigmod.cheng (type ReproBig + const reproMaxLimbs)。
# 期望 (修前): bail=707 @ extra 赋值行; 期望 (修后): CLEAN + exe rc=7
import cheng/tests/repro707_bigmod as rbig

fn reproWordToU64(w: int32): uint64 =
    return uint64(uint32(w))

fn reproLowByte(value: uint64): int32 =
    return int32(value & uint64(255))

fn repro707Fill(a: rbig.ReproBig, outLen: int32): int32 =
    var aLocal: rbig.ReproBig = a
    let totalBytes: int32 = aLocal.count * 4
    if totalBytes > outLen:
        for extraIdx in outLen..<totalBytes:
            let bitIdx: int32 = extraIdx * 8
            let limbIdx: int32 = bitIdx / 32
            let shift: int32 = bitIdx % 32
            var extra: uint64
            if limbIdx < aLocal.count:
                extra = reproWordToU64(aLocal.limbs[limbIdx]) >> uint64(shift)
            if reproLowByte(extra) != 0:
                return 1
    return outLen

fn main(): int32 =
    var b: rbig.ReproBig
    b.count = 2
    b.limbs[0] = 42
    b.limbs[1] = 0
    return repro707Fill(b, 7)
