# T62-d6 RED probe (str-inner): 与 t62d5 相同结构(add(seq, Ctor(name, Value(r),
# ...))), 但内型是 str 而非标量。源函数(LookupSnap/LookupSyn)按真前沿
# CompilerWorldFixed32Value 同构——真实分支(校验+构造新值+双返回)、且
# RETURN 的是函数内部新构造的值(strutil.Join 结果), 不是把自身某个形参
# 原样透传当 payload(那是另一条独立预先缺陷的触发条件, 见 fix_t62d6.diff
# 说明, 不在本探针覆盖范围内)。
# 期望(修复前，d5 gate 关闭时): 合成槽经通用调用实参物化器传给外层调用
# 崩溃或读错值(t62d6 双探针实证: EntryMake 收到的实参寄存器是从未写入的
# 0, 被调方解引用 SIGSEGV)。
import std/result
import std/strutils as strutil

type
    Entry =
        packageId: str
        snapVal: str
        synVal: str

fn EntryMake(packageId: str, snapVal: str, synVal: str): Entry =
    var out: Entry
    out.packageId = packageId
    out.snapVal = snapVal
    out.synVal = synVal
    return out

fn LookupSnap(key: str): Result[str] =
    if key.len <= 0:
        return result.Err[str]("missing key")
    return result.Ok[str](strutil.Join(["snap-value-", key], ""))

fn LookupSyn(key: str): Result[str] =
    if key.len <= 0:
        return result.Err[str]("missing key")
    return result.Ok[str](strutil.Join(["syntax-value-", key], ""))

fn main(): int32 =
    var entries: Entry[]
    let snapshotRes = LookupSnap("11")
    let syntaxRes = LookupSyn("22")
    add(entries, EntryMake("pkg-a", Value(snapshotRes), Value(syntaxRes)))
    if entries.len != 1:
        return 1
    if entries[0].packageId != "pkg-a":
        return 2
    if entries[0].snapVal != "snap-value-11":
        return 3
    if entries[0].synVal != "syntax-value-22":
        return 4
    return 0
