# beat-c zero-C bail=712 哨兵 (C5 族, docs/beat-c-zero-c-clearing-queue-2026-07-04.md 序8)
# RED bail=712 (bool 字段 = flag && Pred(call))
# 根: bool 字段 RHS `&&` 右操作数是 call → node-eval LogAnd 非短路发射含 call 被 poison 守卫拒收
#     (compiler_csg.cheng:5923 out.mainFunctionPresent = foundEntryText && parser.ParserMainFunctionPresent(entryText))
# fix: field-assign 加 cbr-chain 短路臂 (复用 PrimaryBodyIrEmitConditionCbrChain)
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件>
#
type
    PlanStub =
        mainFunctionPresent: bool
        importEdgeCount: int32

fn Pred(s: str): bool =
    return s.len > 0

fn FormPlan(entryText: str, foundEntryText: bool, out: var PlanStub): int32 =
    out.importEdgeCount = entryText.len
    out.mainFunctionPresent = foundEntryText && Pred(entryText)
    if out.mainFunctionPresent:
        return 1
    return 0
