# beat-c zero-C bail=709 哨兵 GREEN 边界对照 (front-end 族, 序11)
# 根同 red: for 循环体; 差异: 体内是单条语句 (无 top-level `;`), 不触发未切分
# 隔离实证 (queue §709): 单条 `a=i` 绿, 加 `; b=2` 即红 709
# 验证 count=0 (不 bail)
#
fn F(x: int32): int32 =
    var a: int32 = -1
    var b: int32 = -1
    for i in 0..<x:
        a = i
        break
    return a + b
