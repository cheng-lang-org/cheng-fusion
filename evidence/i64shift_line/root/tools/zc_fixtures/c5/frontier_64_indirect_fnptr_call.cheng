# beat-c zero-C bail=64 哨兵 (序10, docs/beat-c-zero-c-clearing-queue-2026-07-04.md)
# RED bail=64 (binding.fnPtrField() 语句级间接调用)
# 根: struct 含 fn-ptr 字段, 语句级 t.entry() 无 realizer (只有整函数 bodyKind 桥) →
#     PrimaryBodyIrAppendCallOp C5 poison 守卫 (StmtCall, detail0=64) 如实 bail
# fix: CallOp SoA 加 indirectTargetSlot + AppendCallOp 真 lowering + arm64/x64 BLR/call-indirect
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件> → bail=64 count=1
#
type
    Task = ref object
        entry: fn()

fn worker() =
    return

fn RunTask(t: Task) =
    if t.entry != nil:
        t.entry()

fn main(): int32 =
    let t = new(Task)
    t.entry = &worker
    RunTask(t)
    return 0
