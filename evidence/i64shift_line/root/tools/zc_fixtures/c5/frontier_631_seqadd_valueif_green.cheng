# beat-c zero-C bail=631 GREEN 边界对照 (族 631 成员1)
# 同根形态但不 bail: value-if 抽成 assign-RHS (let v = if...) 再 add(buf, v)。
# 顶层 ?: 作 scalar-value slot 已在 12881 处理 → 不落穿 whole-call 臂 → count=0。
# 证明 631 近因确在 seq-add call-arg 位置的 value-if, 非 value-if 本身。
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件>
#
fn EncodeTriple(targetTriple: str, ttl: int32): uint8[] =
    var buf: uint8[]
    var i: int32
    i = 0
    while i < ttl:
        let v: uint8 = if i < targetTriple.len: uint8(int32(targetTriple[i])) else: uint8(0)
        add(buf, v)
        i = i + 1
    return buf
