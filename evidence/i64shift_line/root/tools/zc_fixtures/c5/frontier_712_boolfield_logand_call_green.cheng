# beat-c zero-C bail=712 哨兵 (C5 族, docs/beat-c-zero-c-clearing-queue-2026-07-04.md 序8)
# GREEN 边界对照 (bool 字段 = flag && <非call谓词>, 不 bail)
# 根: node-eval LogAnd 非短路发射的 poison 守卫仅在 NodeTreeHasCallExpr(rhs) 为真时点火;
#     RHS 右操作数是内联比较 (无 call) → 守卫不触发 → 干净发射, count=0
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件>
#
type
    PlanStub =
        mainFunctionPresent: bool
        importEdgeCount: int32

fn FormPlan(entryText: str, foundEntryText: bool, out: var PlanStub): int32 =
    out.importEdgeCount = entryText.len
    out.mainFunctionPresent = foundEntryText && entryText.len > 0
    if out.mainFunctionPresent:
        return 1
    return 0
