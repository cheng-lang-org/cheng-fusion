import std/hashmaps
import std/system

fn main(): int32 =
    let s1: str = "AB"
    let p1: uint64 = hashmaps.hashMapStrPack8(strDataPtr(s1), strLenFast(s1))
    if p1 != uint64(16961):
        return 1
    let s2: str = "AC"
    let p2: uint64 = hashmaps.hashMapStrPack8(strDataPtr(s2), strLenFast(s2))
    if p2 == p1:
        return 2
    if p2 != uint64(17217):
        return 3
    return 0
