# v8pure: T62-d2 收口的 int32 孤儿标量族 — add(seq, Value(Result[int32])) 单条直线语句
# (镜像 diag_T62/t62d_fixtures/v8_minimal.cheng 的 str 形态, 换 int32 元素验证 5a38c0ea8 扩型;
#  不用 strings.IntToStr/os.WriteLine 避开与本缺陷无关的 std/strings format Len 现存 bail)
import std/result

fn LookupNumFor(): Result[int32] =
    return Ok[int32](42)

fn main(): int32 =
    var nums: int32[]
    let numRes: Result[int32] = LookupNumFor()
    if !IsOk(numRes):
        return -1
    add(nums, Value(numRes))
    return nums.len
