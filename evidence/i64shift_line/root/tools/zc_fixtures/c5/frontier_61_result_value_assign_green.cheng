import std/result
fn LookupThing(k: int32): Result[str] =
    if k > 0:
        return result.Ok[str]("hi")
    return result.Err[str]("bad")
fn FormOrdinal(k: int32, out: var str): int32 =
    let targetFnRetRes: Result[str] = LookupThing(k)
    if !IsOk(targetFnRetRes):
        return -1
    out = Value(targetFnRetRes)
    return 0
