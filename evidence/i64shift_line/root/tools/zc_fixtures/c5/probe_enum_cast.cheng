type
    ProbeKind = enum ProbeA, ProbeB, ProbeC

    ProbeRow =
        kind: ProbeKind
        num: int32

fn ProbeRowAt(codes: int32[], i: int32): ProbeRow =
    var out: ProbeRow
    out.kind = ProbeKind(codes[i])
    out.num = codes[i] * 10
    return out

fn main(): int32 =
    var codes: int32[]
    add(codes, Int32(ProbeC))
    add(codes, Int32(ProbeA))
    add(codes, Int32(ProbeB))
    # probe 1: enum -> int32 -> enum roundtrip
    let row = ProbeRowAt(codes, 0)
    if row.kind != ProbeC:
        return 1
    # probe 2: field access on call result
    if ProbeRowAt(codes, 2).kind != ProbeB:
        return 2
    if ProbeRowAt(codes, 1).num != 0:
        return 3
    return 0
