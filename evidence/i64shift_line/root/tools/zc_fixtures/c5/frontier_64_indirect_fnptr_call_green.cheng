# beat-c zero-C bail=64 哨兵 (序10)
# GREEN 边界对照 (同根: struct 含 fn-ptr 字段, 但只读字段不做语句级间接调用 → 不 bail)
# 防过度覆盖回归: fix 只需接通语句级 t.entry(), 字段读路径本就干净
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件> → count=0
#
type
    Task = ref object
        entry: fn()

fn worker() =
    return

fn RunTask(t: Task): int32 =
    if t.entry != nil:
        return 1
    return 0

fn main(): int32 =
    let t = new(Task)
    t.entry = &worker
    return RunTask(t)
