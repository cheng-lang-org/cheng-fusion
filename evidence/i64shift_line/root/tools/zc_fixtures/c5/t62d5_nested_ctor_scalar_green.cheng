# T62-d5: 嵌套包裹调用(add(seq, Make(pkg, Value(r1), Value(r2))))归属权丢失
# 修复的 GREEN 边界 —— 只在包裹调用自身实参里每个 Value()/Error() 内型均为
# 寄存器标量(int32/int64)时安全:重建路径转投普通(非孤儿) add() 发射器
# PrimaryBodyIrAppendSeqGeneralAddBuiltin(与正常路径同一份 codegen,零新增
# 求值逻辑)。str/聚合内型仍诚实 bail=61(见 frontier_61_result_value_nested.cheng
# 消融实证:同形态但内型为 str 时,通过合成实参槽把值传给外层调用会崩溃/读错
# 值,是"合成槽经通用调用实参物化器传参"另一条独立缺陷,非本 lane 范围,不
# 在此盲修)。
import std/result

type
    Entry =
        packageId: str
        snapshotVal: int32
        syntaxVal: int32

fn EntryMake(packageId: str, snapshotVal: int32, syntaxVal: int32): Entry =
    var out: Entry
    out.packageId = packageId
    out.snapshotVal = snapshotVal
    out.syntaxVal = syntaxVal
    return out

fn MakeOk(v: int32): Result[int32] =
    return Ok[int32](v)

fn main(): int32 =
    var entries: Entry[]
    let snapshotRes = MakeOk(11)
    let syntaxRes = MakeOk(22)
    add(entries, EntryMake("pkg-a", Value(snapshotRes), Value(syntaxRes)))
    if entries.len != 1:
        return 1
    if entries[0].packageId != "pkg-a":
        return 2
    if entries[0].snapshotVal != 11:
        return 3
    if entries[0].syntaxVal != 22:
        return 4
    return 0
