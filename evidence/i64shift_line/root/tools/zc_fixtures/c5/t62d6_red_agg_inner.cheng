# T62-d6 RED probe (aggregate-inner): 内型是 32B 定长聚合(镜像
# layout.FixedBytes32 = data: uint8[32], align=1), 与真前沿
# CompilerLockSnapshotFromText 同构(CompilerWorldFixed32Value 同样按 str
# key 在函数内部新构造聚合值再返回, 不携带聚合形参、不透传自身形参当
# payload——那两态各自触发另一条独立预先缺陷, 见 fix_t62d6.diff 说明,
# 不在本探针覆盖范围)。
# 期望(修复前，d5 gate 关闭时): 合成槽经通用调用实参物化器传给外层调用
# 崩溃或读错值(t62d6 双探针实证: EntryMake 收到的聚合实参地址寄存器指向
# 从未写入的内存)。
import std/result

const
    fixed32Size: int32 = 32

type
    Fixed32 =
        data: uint8[fixed32Size]

    Entry =
        packageId: str
        snapVal: Fixed32
        synVal: Fixed32

fn Fixed32FromByte(b: uint8): Fixed32 =
    var out: Fixed32
    var i: int32
    while i < fixed32Size:
        out.data[i] = b
        i = i + 1
    return out

fn EntryMake(packageId: str, snapVal: Fixed32, synVal: Fixed32): Entry =
    var out: Entry
    out.packageId = packageId
    out.snapVal = snapVal
    out.synVal = synVal
    return out

fn LookupSnapFixed(key: str): Result[Fixed32] =
    if key.len <= 0:
        return result.Err[Fixed32]("missing key")
    return result.Ok[Fixed32](Fixed32FromByte(11))

fn LookupSynFixed(key: str): Result[Fixed32] =
    if key.len <= 0:
        return result.Err[Fixed32]("missing key")
    return result.Ok[Fixed32](Fixed32FromByte(22))

fn Fixed32AllEqual(v: Fixed32, b: uint8): bool =
    var i: int32
    while i < fixed32Size:
        if v.data[i] != b:
            return false
        i = i + 1
    return true

fn main(): int32 =
    var entries: Entry[]
    let snapshotRes = LookupSnapFixed("snap")
    let syntaxRes = LookupSynFixed("syn")
    add(entries, EntryMake("pkg-a", Value(snapshotRes), Value(syntaxRes)))
    if entries.len != 1:
        return 1
    if entries[0].packageId != "pkg-a":
        return 2
    if !Fixed32AllEqual(entries[0].snapVal, 11):
        return 3
    if !Fixed32AllEqual(entries[0].synVal, 22):
        return 4
    return 0
