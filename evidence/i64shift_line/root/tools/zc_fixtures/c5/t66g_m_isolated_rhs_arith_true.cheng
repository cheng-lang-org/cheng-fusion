# T66 family golden: 孤立(无 OR)+RHS 算术, true 方向(触发 return 1)。
# family2(无 OR 短路)分支的根因同族(997502b31): 单比较也会撞
# lineNumber==0 哨兵缺口, 落文本兜底裸造孤儿栈槽。
# 内联合成缓冲替换文件读, out.data.len 两级字段链形状保留。
import std/bytes as bytes
import std/rawmem_support as rawmem_support

type
    ProbeObject =
        path: str
        data: bytes.ByteBuffer

fn probeU32(buf: bytes.ByteBuffer, off: int32): uint32 =
    return uint32(bytes.ReadU32LEAt(buf, off))

fn setU32(buf: bytes.ByteBuffer, idx: int32, val: int32) =
    let b0 = UInt8Ptr(rawmem_support.RawmemPtrAdd(buf.data, idx))
    let b1 = UInt8Ptr(rawmem_support.RawmemPtrAdd(buf.data, idx + 1))
    let b2 = UInt8Ptr(rawmem_support.RawmemPtrAdd(buf.data, idx + 2))
    let b3 = UInt8Ptr(rawmem_support.RawmemPtrAdd(buf.data, idx + 3))
    *b0 = uint8(val & 255)
    *b1 = uint8((val >> 8) & 255)
    *b2 = uint8((val >> 16) & 255)
    *b3 = uint8((val >> 24) & 255)

fn main(): int32 =
    var out = new(ProbeObject)
    out.path = "inline_synthetic_o"
    out.data = bytes.NewByteBuffer(630)
    setU32(out.data, 16, 2)
    setU32(out.data, 20, 176)
    if out.data.data == nil || out.data.len < 32:
        return 9
    let ncmds = int32(probeU32(out.data, 16))
    let sizeofcmds = int32(probeU32(out.data, 20))
    if sizeofcmds > out.data.len - 700:
        return 1
    return 0
