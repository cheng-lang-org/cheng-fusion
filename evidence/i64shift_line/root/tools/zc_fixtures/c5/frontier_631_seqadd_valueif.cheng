# beat-c zero-C bail=631 哨兵 (族 631 成员1, docs/beat-c-zero-c-clearing-queue-2026-07-04.md 序6)
# RED bail=631 (value-form if-expr 传 builtin add)
# 根: add(buf, if c: a else: b) —— value-if 落穿 seq-add 分派链 whole-call 臂 (15988):
#     then 分支 `uint8(` 误命中 FindWholeCallOpenParen → AppendWholeCallExprToSlot 拿整个
#     if-expr 当函数调用必败 (reason=15) = bail631。镜像 primary_object_plan.cheng:53504。
# fix: whole-call 臂前插 value-if→ternary 覆盖 elif (复用 PrimaryBodyIrIfExprToTernaryText)。
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件>
#
fn EncodeTriple(targetTriple: str, ttl: int32): uint8[] =
    var buf: uint8[]
    var i: int32
    i = 0
    while i < ttl:
        add(buf, if i < targetTriple.len: uint8(int32(targetTriple[i])) else: uint8(0))
        i = i + 1
    return buf
