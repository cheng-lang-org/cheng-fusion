# beat-c zero-C bail=61 哨兵 (C5 族, docs/beat-c-zero-c-clearing-queue-2026-07-04.md 序1)
# RED bail=61 (双层嵌套 Value 实参)
# 根: 裸 Value(r)/Error(r) 作 call-arg → TypedExprIrCallArgTypesText(typed_expr.cheng:12162) 型解析返空 → InvalidOp(61)
# fix: 12180 后加 ctx-only 内征臂 (Value→抽 Result[T] 的 T); 本 lane 亲验 callarg 真 bail=61
# 验证: ZC_DRIVER=artifacts/backend_driver/cheng tools/zc_enumerate.sh <此文件>
#
import std/result
fn Fixed(k: int32): Result[str] =
    if k > 0:
        return result.Ok[str]("cid")
    return result.Err[str]("bad")
fn Make(id: str, a: str, b: str): int32 =
    return id.len + a.len + b.len
fn FormLockNested(k: int32): int32 =
    var entries: int32[]
    let snapRes: Result[str] = Fixed(k)
    let synRes: Result[str] = Fixed(k)
    add(entries, Make("cheng/std", Value(snapRes), Value(synRes)))
    return entries.len
