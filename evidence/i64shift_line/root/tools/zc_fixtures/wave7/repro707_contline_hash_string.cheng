# wave7 bail=707 主根: 续行拼接 quote-blind 注释剥离 (ParserTrimmedLineWithoutComment)
# 镜像 primary_object_plan.cheng:7593 等 15 行: 多行续行调用 + 续行字符串字面量含 '#'
# 头行 quote-aware (ParserStripLineComment) 但续行 quote-blind, '#' 被当注释截断
# 致 surfaceText 不闭合 → 节点建不出 + 文本 whole-call 括号配对失败 → 707

fn probeSlotName(tag: int32,
                 name: str): int32 =
    return len(name) + tag

fn main(): int32 =
    var resultSlot: int32
    resultSlot = probeSlotName(7,
                               Fmt"#ptr_plus_result#{3}")
    return resultSlot
