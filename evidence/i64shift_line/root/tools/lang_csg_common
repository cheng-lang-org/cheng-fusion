#!/usr/bin/env python3
"""Shared helpers for language-to-CSG migration tools."""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
from pathlib import Path
from typing import Any


CSG_STANDARD = "csg_core"


def die(message: str, code: int = 2) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def json_line(value: dict[str, Any]) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def facts_root_from_lines(lines: list[str]) -> str:
    text = "".join(f"{line}\n" for line in lines if line)
    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()


def file_sha256(path: Path) -> str:
    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()


def safe_id(text: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_.:-]+", "_", text)
    cleaned = cleaned.strip("_")
    if not cleaned:
        return "root"
    return cleaned


def ensure_parent(path: Path) -> None:
    parent = path.parent
    if str(parent):
        parent.mkdir(parents=True, exist_ok=True)


def write_text(path: Path, text: str) -> None:
    ensure_parent(path)
    path.write_text(text, encoding="utf-8")


def write_json(path: Path, value: dict[str, Any]) -> None:
    write_text(path, json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2) + "\n")


def write_facts(path: Path, facts: list[dict[str, Any]]) -> list[str]:
    lines = [json_line(fact) for fact in facts]
    write_text(path, "".join(f"{line}\n" for line in lines))
    return lines


def make_schema_fact(language: str, dialect: str) -> dict[str, Any]:
    return {
        "features": ["core-facts", "runtime-closure", dialect],
        "id": f"csg.core.schema:{language}",
        "kind": "csg.core.schema",
        "language": language,
        "schema": CSG_STANDARD,
    }


def make_module_fact(module_id: str, path: Path, display_path: str) -> dict[str, Any]:
    return {
        "id": module_id,
        "kind": "csg.module",
        "path": display_path,
        "sha256": file_sha256(path),
    }


def make_unsupported_fact(language: str, code: str, message: str) -> dict[str, Any]:
    return {
        "code": code,
        "id": f"unsupported:{language}:{safe_id(code)}",
        "kind": "csg.unsupported",
        "message": message,
    }


def complete_report(
    *,
    dialect: str,
    facts_lines: list[str],
    facts: list[dict[str, Any]],
    entry_roots: list[str],
    complete: bool,
    extra: dict[str, Any] | None = None,
) -> dict[str, Any]:
    unsupported = [fact for fact in facts if fact.get("kind") == "csg.unsupported"]
    runtime_requirements = [fact for fact in facts if fact.get("kind") == "csg.runtime_requirement"]
    external_symbols = [fact for fact in facts if fact.get("kind") == "csg.external_symbol"]
    report: dict[str, Any] = {
        "schema": "csg-core.report",
        "standard": CSG_STANDARD,
        "dialect": dialect,
        "complete": complete and not unsupported and not runtime_requirements,
        "factsRoot": facts_root_from_lines(facts_lines),
        "facts_root": facts_root_from_lines(facts_lines),
        "counts": {
            "factCount": len(facts),
            "unsupported": len(unsupported),
            "runtimeRequirements": len(runtime_requirements),
            "externalSymbols": len(external_symbols),
        },
        "unsupported": unsupported,
        "runtimeRequirements": runtime_requirements,
        "externalSymbols": external_symbols,
        "entryRoots": entry_roots,
    }
    if extra:
        report.update(extra)
    return report


def rel_display(root: Path, path: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return path.resolve().as_posix()


def tree_digest(root: Path) -> dict[str, Any]:
    files: list[dict[str, str]] = []
    if root.exists():
        for current, dirs, names in os.walk(root):
            dirs.sort()
            for name in sorted(names):
                path = Path(current) / name
                rel = path.relative_to(root).as_posix()
                files.append({"path": rel, "sha256": file_sha256(path)})
    payload = json.dumps(files, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return {"root": "sha256:" + hashlib.sha256(payload).hexdigest(), "files": files}
