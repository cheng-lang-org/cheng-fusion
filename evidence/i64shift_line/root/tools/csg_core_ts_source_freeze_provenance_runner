def identity_record_same_object(left: Any, right: Any) -> bool:
    fields = [
        "device",
        "inode",
        "mode",
        "nlink",
        "uid",
        "gid",
        "size",
        "mtime_ns",
        "ctime_ns",
    ]
    stable_fields = ("device", "inode", "mode", "nlink", "uid", "gid")
    return (
        isinstance(left, dict)
        and isinstance(right, dict)
        and list(left) == fields
        and list(right) == fields
        and all(left[field] == right[field] for field in stable_fields)
    )


def assert_published_generation_handoff(
    pending: dict[str, Any], published: dict[str, Any]
) -> None:
    fields = [
        "generation",
        "generation_cid",
        "generation_identity",
        "generation_manifest_sha256",
        "generation_manifest_identity",
        "objects_identity",
        "outputs",
        "store_identity",
    ]
    if list(pending) != fields or list(published) != fields:
        fail("admission_published_generation_fields_invalid")
    for field in (
        "generation",
        "generation_cid",
        "generation_manifest_sha256",
        "generation_manifest_identity",
        "outputs",
        "store_identity",
    ):
        if pending[field] != published[field]:
            fail(f"admission_published_generation_content_mismatch:{field}")
    if (
        not identity_record_same_object(
            pending["generation_identity"], published["generation_identity"]
        )
        or pending["generation_identity"]["size"]
        != published["generation_identity"]["size"]
        or pending["generation_identity"]["mtime_ns"]
        != published["generation_identity"]["mtime_ns"]
    ):
        fail("admission_published_generation_identity_mismatch")
    if not identity_record_same_object(
        pending["objects_identity"], published["objects_identity"]
    ):
        fail("admission_published_objects_identity_mismatch")


def admit_dynamic_manifest(
    source_path_raw: str,
    expected: dict[str, str],
    manifest_path_raw: str,
    guard_report_path_raw: str,
) -> None:
    before = verify_pending_manifest(
        source_path_raw,
        expected,
        manifest_path_raw,
        guard_report_path_raw,
    )
    package_root = before["package_root"]
    (
        store,
        _,
        store_descriptor,
        objects_descriptor,
        lock_descriptor,
    ) = acquire_generation_store(package_root)
    if os.path.lexists(store / GENERATION_CURRENT):
        load_current_generation(package_root)
    after = verify_pending_manifest(
        source_path_raw,
        expected,
        manifest_path_raw,
        guard_report_path_raw,
    )
    if (
        before["manifest_sha256"] != after["manifest_sha256"]
        or before["loaded"] != after["loaded"]
    ):
        fail("admission_inputs_or_generation_changed_under_lock")
    generation_cid = after["loaded"]["generation_cid"]
    staging_name = after["manifest"]["generation"]["staging_name"]
    publish_generation_object(
        objects_descriptor,
        staging_name,
        generation_cid,
    )
    published = load_generation_object(
        package_root,
        generation_cid,
        "admission_published_generation",
    )
    assert_published_generation_handoff(after["loaded"], published)
    pointer_sha256 = publish_current_pointer(store_descriptor, generation_cid)
    expected_pointer_sha256 = after["manifest"]["generation"]["pointer_sha256"]
    if pointer_sha256 != expected_pointer_sha256:
        fail("admission_pointer_sha256_mismatch")
    current = load_current_generation(package_root)
    if (
        current["generation_cid"] != generation_cid
        or current["generation_manifest_sha256"]
        != after["loaded"]["generation_manifest_sha256"]
        or current["outputs"] != after["loaded"]["outputs"]
    ):
        fail("admission_current_generation_mismatch")
    _ = (objects_descriptor, lock_descriptor)
    print(
        " ".join(
            (
                f"{SCHEMA}",
                "admission=PASS",
                f"generation_cid={generation_cid}",
                f"manifest_sha256={after['manifest_sha256']}",
                f"pointer_sha256={pointer_sha256}",
                "dynamic_completion_credit=1",
            )
        ),
        flush=True,
    )


def verify_admitted_manifest(
    source_path_raw: str,
    expected: dict[str, str],
    manifest_path_raw: str,
    guard_report_path_raw: str,
) -> None:
    state = verify_manifest_state(
        source_path_raw,
        expected,
        manifest_path_raw,
        guard_report_path_raw,
        admitted=True,
    )
    current = load_current_generation(state["package_root"])
    loaded = state["loaded"]
    if (
        current["generation_cid"] != loaded["generation_cid"]
        or current["generation_manifest_sha256"]
        != loaded["generation_manifest_sha256"]
        or current["outputs"] != loaded["outputs"]
        or current["pointer_sha256"]
        != state["manifest"]["generation"]["pointer_sha256"]
    ):
        fail("admitted_manifest_current_binding_mismatch")
    print(
        " ".join(
            (
                f"{SCHEMA}",
                "admitted_manifest=CURRENT_VERIFIED",
                f"generation_cid={loaded['generation_cid']}",
                f"manifest_sha256={state['manifest_sha256']}",
                "dynamic_completion_credit=1",
            )
        ),
        flush=True,
    )


def expect_failure(action: Any, label: str) -> None:
    try:
        action()
    except ProvenanceError:
        return
    fail(f"self_test_expected_failure_missing:{label}")


def self_test() -> None:
    home = pathlib.Path(pwd.getpwuid(os.geteuid()).pw_dir)
    evidence_base = home / "cheng-patches/csg-gates"
    evidence_base.mkdir(parents=True, exist_ok=True)
    work = pathlib.Path(tempfile.mkdtemp(prefix="ts-source-freeze-runner-contract.", dir=evidence_base))
    try:
        source_root = work / "source"
        source_root.mkdir()
        (source_root / "main.ts").write_text("export const value = 1;\n", encoding="utf-8")
        first = tree_snapshot(source_root, "self_test_source")
        (source_root / "main.ts").write_text("export const value = 2;\n", encoding="utf-8")
        second = tree_snapshot(source_root, "self_test_source")
        expect_failure(
            lambda: assert_input_snapshot_equal(first, second), "stale_source"
        )

        active = work / "pair/dist"
        frozen = work / "pair/dist-frozen"
        active.mkdir(parents=True)
        frozen.mkdir(parents=True)
        (active / "cli.js").write_text("export {};\n", encoding="utf-8")
        (frozen / "cli.js").write_text("export {};\n", encoding="utf-8")
        active_snapshot = tree_snapshot(active, "self_test_active")
        directories, files = manifest_tree_rows(active_snapshot)
        freeze_manifest = {
            "schema": "ts_csg_dist_freeze",
            "source_root": "dist",
            "target_root": "dist-frozen",
            "directories": directories,
            "file_count": len(files),
            "files": files,
        }
        (frozen / FREEZE_MANIFEST).write_text(
            json.dumps(freeze_manifest, indent=2) + "\n", encoding="utf-8"
        )
        verify_output_pair(work / "pair", "self_test_pair")
        (frozen / "cli.js").write_text("stale\n", encoding="utf-8")
        expect_failure(
            lambda: verify_output_pair(work / "pair", "self_test_pair"),
            "stale_dist",
        )

        symlink_root = work / "symlink"
        symlink_root.mkdir()
        (symlink_root / "target").write_text("x\n", encoding="utf-8")
        os.symlink("target", symlink_root / "link")
        expect_failure(lambda: tree_snapshot(symlink_root, "self_test_symlink"), "symlink")

        hardlink_root = work / "hardlink"
        hardlink_root.mkdir()
        (hardlink_root / "first").write_text("same inode\n", encoding="utf-8")
        os.link(hardlink_root / "first", hardlink_root / "second")
        expect_failure(
            lambda: tree_snapshot(hardlink_root, "self_test_hardlink"),
            "hardlink",
        )

        cleanup_outside = work / "cleanup-outside"
        cleanup_outside.write_text("must survive\n", encoding="utf-8")
        cleanup_root = work / "cleanup-root"
        cleanup_root.mkdir()
        (cleanup_root / "nested").mkdir()
        (cleanup_root / "nested/file").write_text("delete\n", encoding="utf-8")
        os.symlink(cleanup_outside, cleanup_root / "outside-link")
        cleanup_identity = stat_identity(
            os.stat(cleanup_root, follow_symlinks=False)
        )
        safe_remove_tree(cleanup_root, cleanup_identity, "self_test_cleanup")
        if cleanup_root.exists() or cleanup_outside.read_text(encoding="utf-8") != "must survive\n":
            fail("self_test_fd_safe_cleanup_failed")

        pointer_store = work / "pointer-store"
        pointer_store.mkdir(mode=0o700)
        pointer_descriptor = os.open(pointer_store, directory_open_flags())
        try:
            pointer_cid = "a" * 64
            pointer_sha = publish_current_pointer(pointer_descriptor, pointer_cid)
        finally:
            os.close(pointer_descriptor)
        pointer_raw, pointer_entry = stable_file_bytes(
            pointer_store / GENERATION_CURRENT,
            "self_test_pointer",
            4096,
        )
        if (
            pointer_sha != pointer_entry["sha256"]
            or parse_canonical_json(pointer_raw, "self_test_pointer")["generation_cid"]
            != pointer_cid
        ):
            fail("self_test_pointer_commit_failed")

        generation_objects = work / "generation-objects"
        generation_objects.mkdir(mode=0o700)
        staging_name = ".generation.pending." + "b" * 32
        generation_cid = "c" * 64
        generation_stage = generation_objects / staging_name
        generation_stage.mkdir(mode=0o700)
        (generation_stage / "payload").write_bytes(b"first\n")
        os.chmod(generation_stage / "payload", 0o400)
        os.chmod(generation_stage, 0o500)
        generation_objects_descriptor = os.open(
            generation_objects, directory_open_flags()
        )
        try:
            publish_generation_object(
                generation_objects_descriptor,
                staging_name,
                generation_cid,
            )
            published_before = tree_snapshot(
                generation_objects / generation_cid,
                "self_test_generation_published",
            )
            generation_stage.mkdir(mode=0o700)
            (generation_stage / "payload").write_bytes(b"replay\n")
            os.chmod(generation_stage / "payload", 0o400)
            os.chmod(generation_stage, 0o500)
            expect_failure(
                lambda: publish_generation_object(
                    generation_objects_descriptor,
                    staging_name,
                    generation_cid,
                ),
                "generation_replay",
            )
            published_after = tree_snapshot(
                generation_objects / generation_cid,
                "self_test_generation_published_after_replay",
            )
            if published_before != published_after:
                fail("self_test_generation_replay_changed_object")
        finally:
            os.close(generation_objects_descriptor)
        for generation_path, generation_label in (
            (generation_objects / generation_cid, "self_test_generation_object_cleanup"),
            (generation_stage, "self_test_generation_stage_cleanup"),
        ):
            safe_remove_tree(
                generation_path,
                stat_identity(os.stat(generation_path, follow_symlinks=False)),
                generation_label,
            )

        replacement = work / "tool"
        replacement.write_text("tool-a\n", encoding="utf-8")
        expected_sha = stable_file(replacement, "self_test_tool")["sha256"]
        replacement.write_text("tool-b\n", encoding="utf-8")
        expect_failure(
            lambda: require_expected(
                stable_file(replacement, "self_test_tool")["sha256"],
                expected_sha,
                "self_test_tool",
            ),
            "tool_replacement",
        )

        expect_failure(
            lambda: relative_name(source_root, work / "escaped"), "path_escape"
        )
        fake_manifest = work / "forged-manifest.json"
        fake_manifest.write_text(
            '{"dynamic_completion_credit":1,"schema":"csg_core_ts_source_freeze_provenance","status":"verified_in_guarded_process"}\n',
            encoding="utf-8",
        )
        expect_failure(
            lambda: verify_dynamic_manifest(
                pathlib.Path(__file__).resolve().as_posix(),
                {key: "0" * 64 for key in EXPECTED_KEYS},
                fake_manifest.as_posix(),
                fake_manifest.as_posix(),
            ),
            "forged_manifest",
        )
        print(
            f"{SCHEMA} self_test=PASS cases=10 evidence={work}",
            flush=True,
        )
    except BaseException:
        raise


def main(arguments: list[str]) -> None:
    require_python_runtime_context()
    install_fail_stop_signal_handlers()
    if arguments == ["--self-test"]:
        self_test()
        return
    mode, source_path_raw, expected, values, cli_arguments = parse_mode_arguments(
        arguments
    )
    if mode == "--audit":
        _, _, inputs, activation = audit(source_path_raw, expected)
        print(
            " ".join(
                (
                    f"{SCHEMA}_gate",
                    "STATIC_ONLY",
                    f"source_inputs_sha256={inputs['bytes_root']}",
                    "package_generation_entry=bound",
                    f"current_generation={activation['current_generation']}",
                    f"module_consumers={activation['module_consumers']}",
                    f"production_activation={activation['production_activation']}",
                    "launcher_exec_identity=HARD_RED:no_external_launcher_anchor",
                    "historical_manifest_authority=none",
                    "dynamic_completion_credit=0",
                )
            ),
            flush=True,
        )
    elif mode == "--exec-current-cli":
        raise SystemExit(
            execute_current_generation_cli(
                source_path_raw,
                expected,
                cli_arguments,
            )
        )
    elif mode == "--run":
        build_and_publish(
            source_path_raw,
            expected,
            values["manifest-fd-path"],
        )
    elif mode == "--verify-manifest":
        verify_dynamic_manifest(
            source_path_raw,
            expected,
            values["manifest-path"],
            values["guard-report-path"],
        )
    elif mode == "--admit-manifest":
        admit_dynamic_manifest(
            source_path_raw,
            expected,
            values["manifest-path"],
            values["guard-report-path"],
        )
    else:
        verify_admitted_manifest(
            source_path_raw,
            expected,
            values["manifest-path"],
            values["guard-report-path"],
        )


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except ProvenanceError as error:
        print(f"{SCHEMA}_error={error}", file=sys.stderr, flush=True)
        raise SystemExit(1)
