            "noUncheckedIndexedAccess": True,
            "outDir": "dist",
            "rootDir": "src",
            "skipLibCheck": True,
            "strict": True,
            "target": "ES2022",
        },
        "include": ["src/**/*.ts"],
    }
    if config != expected:
        fail("tsconfig_contract_not_closed")


def input_snapshot(
