    report_path = require_canonical_absolute(
        pathlib.Path(report_path_raw), "guard_report"
    )
    if (
        report_path.name != "guard.report.txt"
        or manifest_path.name != "provenance-manifest.json"
        or report_path.parent != manifest_path.parent
