        print(f"{SCHEMA} phase=tsc_file_list", flush=True)
        file_list_raw = run_visible(
            "tsc_file_list",
            [
                os.fspath(private_node),
                os.fspath(private_tsc),
                "-p",
                os.fspath(private_tsconfig),
