class ProvenanceError(RuntimeError):
    pass


def fail(reason: str) -> None:
    raise ProvenanceError(reason)


def account_home_path() -> pathlib.Path:
    account = pwd.getpwuid(os.geteuid())
    home = require_canonical_absolute(pathlib.Path(account.pw_dir), "account_home")
    info = require_real_directory(home, "account_home")
    if info.st_uid != os.geteuid() or info.st_mode & 0o022:
        fail("account_home_identity_invalid")
    return home


def node_binary_path() -> pathlib.Path:
    return require_canonical_absolute(
        account_home_path() / NODE_RELATIVE_PATH,
        "node_binary",
    )


def require_python_runtime_context() -> None:
    if pathlib.Path(sys.executable) != PYTHON_BIN:
        fail("python_executable_identity_invalid")
    if (
        not sys.flags.isolated
        or not sys.flags.no_user_site
        or not sys.flags.ignore_environment
    ):
        fail("python_isolation_flags_missing")
    current_directory = os.path.realpath(os.getcwd())
    for entry in sys.path:
        if entry in ("", ".") or os.path.realpath(entry) == current_directory:
            fail("python_import_path_polluted")
    sys.dont_write_bytecode = True
    os.umask(0o077)


def install_fail_stop_signal_handlers() -> None:
    def handle(signum: int, _: Any) -> None:
        try:
            name = signal.Signals(signum).name
        except ValueError:
            name = str(signum)
        fail(f"signal_received:{name}")

    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
        signal.signal(signum, handle)


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def stat_identity(info: os.stat_result) -> dict[str, int]:
    return {
        "device": int(info.st_dev),
        "inode": int(info.st_ino),
        "mode": int(info.st_mode),
        "nlink": int(info.st_nlink),
        "uid": int(info.st_uid),
        "gid": int(info.st_gid),
        "size": int(info.st_size),
        "mtime_ns": int(info.st_mtime_ns),
        "ctime_ns": int(info.st_ctime_ns),
    }


def identities_equal(left: os.stat_result, right: os.stat_result) -> bool:
    return stat_identity(left) == stat_identity(right)


def same_object_identity(left: os.stat_result, right: os.stat_result) -> bool:
    fields = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_uid", "st_gid")
    return all(int(getattr(left, field)) == int(getattr(right, field)) for field in fields)


def same_directory_identity(left: os.stat_result, right: os.stat_result) -> bool:
    fields = ("st_dev", "st_ino", "st_mode", "st_uid", "st_gid")
    return all(int(getattr(left, field)) == int(getattr(right, field)) for field in fields)


def require_canonical_absolute(path: pathlib.Path, label: str) -> pathlib.Path:
    if not path.is_absolute():
        fail(f"{label}_not_absolute")
    lexical = pathlib.Path(os.path.abspath(os.fspath(path)))
    try:
        resolved = pathlib.Path(os.path.realpath(os.fspath(path)))
    except OSError as error:
        fail(f"{label}_realpath_failed:{error.errno}")
    if lexical != path or resolved != path:
        fail(f"{label}_not_canonical")
    return path


def require_real_directory(path: pathlib.Path, label: str) -> os.stat_result:
    require_canonical_absolute(path, label)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        fail(f"{label}_missing")
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(f"{label}_not_real_directory")
    return info


def stable_file(path: pathlib.Path, label: str) -> dict[str, Any]:
    require_canonical_absolute(path, label)
    if not hasattr(os, "O_NOFOLLOW"):
        fail("o_nofollow_unavailable")
    try:
        lexical = pathlib.Path(os.path.abspath(os.fspath(path)))
    except OSError as error:
        fail(f"{label}_absolute_failed:{error.errno}")
    if lexical != path:
        fail(f"{label}_not_canonical")
    flags = os.O_RDONLY | os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"{label}_open_failed:{error.errno}")
    digest = hashlib.sha256()
    try:
        before = os.fstat(descriptor)
        named_before = os.stat(path, follow_symlinks=False)
        if not stat.S_ISREG(before.st_mode):
            fail(f"{label}_not_regular")
        if before.st_nlink != 1:
            fail(f"{label}_hardlink_rejected")
        if not identities_equal(before, named_before):
            fail(f"{label}_named_identity_mismatch")
        total = 0
        while True:
            chunk = os.read(descriptor, READ_SIZE)
            if not chunk:
                break
            digest.update(chunk)
            total += len(chunk)
        after = os.fstat(descriptor)
        named_after = os.stat(path, follow_symlinks=False)
        if (
            not identities_equal(before, after)
            or not identities_equal(after, named_after)
            or total != after.st_size
        ):
            fail(f"{label}_identity_drifted_during_read")
        return {
            "sha256": digest.hexdigest(),
            "identity": stat_identity(after),
        }
    finally:
        os.close(descriptor)


def stable_file_bytes(path: pathlib.Path, label: str, maximum: int) -> tuple[bytes, dict[str, Any]]:
    require_canonical_absolute(path, label)
    if not hasattr(os, "O_NOFOLLOW"):
        fail("o_nofollow_unavailable")
    flags = os.O_RDONLY | os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"{label}_open_failed:{error.errno}")
    try:
        before = os.fstat(descriptor)
        named_before = os.stat(path, follow_symlinks=False)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            fail(f"{label}_identity_invalid")
        if not identities_equal(before, named_before):
            fail(f"{label}_named_identity_mismatch")
        if before.st_size < 0 or before.st_size > maximum:
            fail(f"{label}_size_invalid")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, min(READ_SIZE, maximum + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > maximum:
                fail(f"{label}_size_invalid")
        after = os.fstat(descriptor)
        named_after = os.stat(path, follow_symlinks=False)
        if (
            not identities_equal(before, after)
            or not identities_equal(after, named_after)
            or total != after.st_size
        ):
            fail(f"{label}_identity_drifted_during_read")
        raw = b"".join(chunks)
        return raw, {"sha256": sha256_bytes(raw), "identity": stat_identity(after)}
    finally:
        os.close(descriptor)


def stable_system_executable(path: pathlib.Path, label: str) -> dict[str, Any]:
    require_canonical_absolute(path, label)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(path, flags)
    digest = hashlib.sha256()
    try:
        before = os.fstat(descriptor)
        named_before = os.stat(path, follow_symlinks=False)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != 0
            or before.st_mode & 0o022
            or not before.st_mode & 0o111
            or not identities_equal(before, named_before)
        ):
            fail(f"{label}_system_authority_invalid")
        total = 0
        while True:
            chunk = os.read(descriptor, READ_SIZE)
            if not chunk:
                break
            digest.update(chunk)
            total += len(chunk)
        after = os.fstat(descriptor)
        named_after = os.stat(path, follow_symlinks=False)
        if (
            not identities_equal(before, after)
            or not identities_equal(after, named_after)
            or total != after.st_size
        ):
            fail(f"{label}_identity_drifted_during_read")
        return {"sha256": digest.hexdigest(), "identity": stat_identity(after)}
    finally:
        os.close(descriptor)


def relative_name(root: pathlib.Path, path: pathlib.Path) -> str:
    try:
        relative = path.relative_to(root).as_posix()
    except ValueError:
        fail("path_escape_rejected")
    if (
        not relative
        or relative.startswith("../")
        or "/../" in relative
        or "\\" in relative
        or any(character in relative for character in ("\x00", "\r", "\n"))
    ):
        fail("relative_path_not_canonical")
    try:
        relative.encode("utf-8", "strict")
    except UnicodeEncodeError:
        fail("relative_path_not_utf8")
    return relative


def framed_digest(domain: str, rows: list[tuple[str, bytes]]) -> str:
    digest = hashlib.sha256()
    domain_raw = domain.encode("utf-8")
    digest.update(len(domain_raw).to_bytes(4, "big"))
    digest.update(domain_raw)
    for label, payload in rows:
        label_raw = label.encode("utf-8")
        digest.update(len(label_raw).to_bytes(4, "big"))
        digest.update(label_raw)
        digest.update(len(payload).to_bytes(8, "big"))
        digest.update(payload)
    return digest.hexdigest()


def guard_command_argv_digest(arguments: list[str]) -> str:
    digest = hashlib.sha256()

    def append_frame(raw: bytes) -> None:
        digest.update(len(raw).to_bytes(4, "big"))
        digest.update(raw)

    append_frame(b"cheng.guard.command_argv")
    digest.update(len(arguments).to_bytes(4, "big"))
    for argument in arguments:
        append_frame(os.fsencode(argument))
    return digest.hexdigest()


