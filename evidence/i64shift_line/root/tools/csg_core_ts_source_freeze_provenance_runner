def tree_snapshot(
    root: pathlib.Path,
    label: str,
    *,
    allow_internal_symlinks: bool = False,
    exclude_names: frozenset[str] = frozenset(),
) -> dict[str, Any]:
    require_canonical_absolute(root, label)
    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    directory_flags |= getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        root_descriptor = os.open(root, directory_flags)
    except OSError as error:
        fail(f"{label}_root_open_failed:{error.errno}")
    root_named = os.stat(root, follow_symlinks=False)
    root_held = os.fstat(root_descriptor)
    if (
        not stat.S_ISDIR(root_held.st_mode)
        or stat.S_ISLNK(root_named.st_mode)
        or not identities_equal(root_named, root_held)
    ):
        os.close(root_descriptor)
        fail(f"{label}_root_identity_invalid")
    directories: list[dict[str, Any]] = []
    files: list[dict[str, Any]] = []
    links: list[dict[str, Any]] = []

    def canonical_name(name: str) -> None:
        if (
            not name
            or name in (".", "..")
            or "/" in name
            or "\\" in name
            or any(character in name for character in ("\x00", "\r", "\n"))
        ):
            fail(f"{label}_entry_name_invalid")
        try:
            name.encode("utf-8", "strict")
        except UnicodeEncodeError:
            fail(f"{label}_entry_name_not_utf8")

    def stable_file_at(
        directory_descriptor: int,
        name: str,
        expected_info: os.stat_result,
        relative: str,
    ) -> dict[str, Any]:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        try:
            descriptor = os.open(name, flags, dir_fd=directory_descriptor)
        except OSError as error:
            fail(f"{label}_file_open_failed:{relative}:{error.errno}")
        digest = hashlib.sha256()
        try:
            before = os.fstat(descriptor)
            named_before = os.stat(
                name, dir_fd=directory_descriptor, follow_symlinks=False
            )
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or not identities_equal(expected_info, before)
                or not identities_equal(before, named_before)
            ):
                fail(f"{label}_file_identity_invalid:{relative}")
            total = 0
            while True:
                chunk = os.read(descriptor, READ_SIZE)
                if not chunk:
                    break
                digest.update(chunk)
                total += len(chunk)
            after = os.fstat(descriptor)
            named_after = os.stat(
                name, dir_fd=directory_descriptor, follow_symlinks=False
            )
            if (
                not identities_equal(before, after)
                or not identities_equal(after, named_after)
                or total != after.st_size
            ):
                fail(f"{label}_file_identity_drifted:{relative}")
            return {
                "path": relative,
                "size": total,
                "sha256": digest.hexdigest(),
                "identity": stat_identity(after),
            }
        finally:
            os.close(descriptor)

    def visit(directory_descriptor: int, prefix: str) -> None:
        before = os.fstat(directory_descriptor)
        try:
            names = os.listdir(directory_descriptor)
            for name in names:
                canonical_name(name)
            names.sort(key=lambda name: name.encode("utf-8", "strict"))
        except (OSError, UnicodeEncodeError) as error:
            fail(f"{label}_directory_scan_failed:{getattr(error, 'errno', 0)}")
        for name in names:
            relative = f"{prefix}/{name}" if prefix else name
            if not prefix and name in exclude_names:
                continue
            try:
                info = os.stat(
                    name, dir_fd=directory_descriptor, follow_symlinks=False
                )
            except OSError as error:
                fail(f"{label}_entry_stat_failed:{relative}:{error.errno}")
            if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
                try:
                    child_descriptor = os.open(
                        name, directory_flags, dir_fd=directory_descriptor
                    )
                except OSError as error:
                    fail(f"{label}_directory_open_failed:{relative}:{error.errno}")
                try:
                    held = os.fstat(child_descriptor)
                    if not identities_equal(info, held):
                        fail(f"{label}_directory_identity_invalid:{relative}")
                    directories.append(
                        {"path": relative, "identity": stat_identity(held)}
                    )
                    visit(child_descriptor, relative)
                    named_after = os.stat(
                        name, dir_fd=directory_descriptor, follow_symlinks=False
                    )
                    if not identities_equal(held, named_after):
                        fail(f"{label}_directory_identity_drifted:{relative}")
                finally:
                    os.close(child_descriptor)
            elif stat.S_ISREG(info.st_mode):
                files.append(stable_file_at(directory_descriptor, name, info, relative))
            elif stat.S_ISLNK(info.st_mode):
                if not allow_internal_symlinks:
                    fail(f"{label}_symlink_rejected:{relative}")
                target = os.readlink(name, dir_fd=directory_descriptor)
                if any(character in target for character in ("\x00", "\r", "\n")):
                    fail(f"{label}_symlink_target_rejected:{relative}")
                after = os.stat(
                    name, dir_fd=directory_descriptor, follow_symlinks=False
                )
                if (
                    not identities_equal(info, after)
                    or os.readlink(name, dir_fd=directory_descriptor) != target
                ):
                    fail(f"{label}_symlink_identity_drifted:{relative}")
                links.append(
                    {
                        "path": relative,
                        "target": target,
                        "identity": stat_identity(after),
                    }
                )
            else:
                fail(f"{label}_unsupported_node:{relative}")
        after = os.fstat(directory_descriptor)
        try:
            names_after = os.listdir(directory_descriptor)
            for name in names_after:
                canonical_name(name)
            names_after.sort(key=lambda name: name.encode("utf-8", "strict"))
        except (OSError, UnicodeEncodeError) as error:
            fail(f"{label}_directory_rescan_failed:{getattr(error, 'errno', 0)}")
        if not identities_equal(before, after) or names_after != names:
            fail(f"{label}_directory_identity_drifted:{prefix or '.'}")

    try:
        visit(root_descriptor, "")
        root_after = os.fstat(root_descriptor)
        root_named_after = os.stat(root, follow_symlinks=False)
        if (
            not identities_equal(root_held, root_after)
            or not identities_equal(root_after, root_named_after)
        ):
            fail(f"{label}_root_identity_drifted")
    finally:
        os.close(root_descriptor)

    for item in links:
        resolved = pathlib.Path(os.path.realpath(root / item["path"]))
        try:
            resolved.relative_to(root)
        except ValueError:
            fail(f"{label}_symlink_escape_rejected:{item['path']}")
    directories.sort(key=lambda item: item["path"].encode("utf-8"))
    files.sort(key=lambda item: item["path"].encode("utf-8"))
    links.sort(key=lambda item: item["path"].encode("utf-8"))
    byte_rows: list[tuple[str, bytes]] = []
    identity_rows: list[tuple[str, bytes]] = []
    for item in directories:
        byte_rows.append(("directory", item["path"].encode("utf-8")))
        identity_rows.append(
            (
                "directory_identity",
                json.dumps(item, sort_keys=True, separators=(",", ":")).encode("utf-8"),
            )
        )
    for item in files:
        byte_rows.append(
            (
                "file",
                json.dumps(
                    {key: item[key] for key in ("path", "size", "sha256")},
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode("utf-8"),
            )
        )
        identity_rows.append(
            (
                "file_identity",
                json.dumps(item, sort_keys=True, separators=(",", ":")).encode("utf-8"),
            )
        )
    for item in links:
        byte_rows.append(
            (
                "symlink",
                json.dumps(
                    {key: item[key] for key in ("path", "target")},
                    sort_keys=True,
                    separators=(",", ":"),
                ).encode("utf-8"),
            )
        )
        identity_rows.append(
            (
                "symlink_identity",
                json.dumps(item, sort_keys=True, separators=(",", ":")).encode("utf-8"),
            )
        )
    identity_rows.append(
        (
            "root_identity",
            json.dumps(stat_identity(root_after), sort_keys=True, separators=(",", ":")).encode("utf-8"),
        )
    )
    return {
        "bytes_root": framed_digest(f"{SCHEMA}.tree.bytes", byte_rows),
        "identity_root": framed_digest(f"{SCHEMA}.tree.identity", identity_rows),
        "directories": directories,
        "files": files,
        "links": links,
        "directory_count": len(directories),
        "file_count": len(files),
        "symlink_count": len(links),
        "root_identity": stat_identity(root_after),
    }


def require_expected(actual: str, expected: str, label: str) -> None:
    if len(expected) != 64 or any(character not in "0123456789abcdef" for character in expected):
        fail(f"{label}_expected_sha256_invalid")
    if actual != expected:
        fail(f"{label}_sha256_mismatch:{actual}")


def directory_open_flags() -> int:
    return (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0)
    )


def open_relative_directory(
    root_descriptor: int,
    relative: str,
    label: str,
    expected: dict[str, dict[str, int]] | None = None,
) -> int:
    descriptor = os.dup(root_descriptor)
    if not relative:
        return descriptor
    prefix: list[str] = []
    try:
        for segment in relative.split("/"):
            if not segment or segment in (".", ".."):
                fail(f"{label}_relative_directory_invalid")
            prefix.append(segment)
            child = os.open(
                segment,
                directory_open_flags(),
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = child
            info = os.fstat(descriptor)
            if not stat.S_ISDIR(info.st_mode):
                fail(f"{label}_not_directory:{'/'.join(prefix)}")
            if expected is not None:
                wanted = expected.get("/".join(prefix))
                if wanted is None or stat_identity(info) != wanted:
                    fail(f"{label}_directory_identity_mismatch:{'/'.join(prefix)}")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def create_relative_directory(root_descriptor: int, relative: str, label: str) -> None:
    parent_name, _, leaf = relative.rpartition("/")
    parent_descriptor = open_relative_directory(root_descriptor, parent_name, label)
    try:
        os.mkdir(leaf, 0o700, dir_fd=parent_descriptor)
        os.fsync(parent_descriptor)
    except OSError as error:
        fail(f"{label}_mkdir_failed:{relative}:{error.errno}")
    finally:
        os.close(parent_descriptor)


def copy_regular_file_from_snapshot(
    source_root_descriptor: int,
    destination_root_descriptor: int,
    item: dict[str, Any],
    source_directories: dict[str, dict[str, int]],
    label: str,
) -> None:
    relative = item["path"]
    parent_name, _, leaf = relative.rpartition("/")
    source_parent = open_relative_directory(
        source_root_descriptor,
        parent_name,
        f"{label}_source",
        source_directories,
    )
    destination_parent = open_relative_directory(
        destination_root_descriptor, parent_name, f"{label}_destination"
    )
    source_descriptor = -1
    destination_descriptor = -1
    digest = hashlib.sha256()
    try:
        source_descriptor = os.open(
            leaf,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
            dir_fd=source_parent,
        )
        before = os.fstat(source_descriptor)
        named_before = os.stat(leaf, dir_fd=source_parent, follow_symlinks=False)
        if (
            stat_identity(before) != item["identity"]
            or not identities_equal(before, named_before)
            or not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
        ):
            fail(f"{label}_source_identity_invalid:{relative}")
        destination_descriptor = os.open(
            leaf,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
            0o600,
            dir_fd=destination_parent,
        )
        total = 0
        while True:
            chunk = os.read(source_descriptor, READ_SIZE)
            if not chunk:
                break
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(destination_descriptor, view)
                if written <= 0:
                    fail(f"{label}_destination_write_failed:{relative}")
                view = view[written:]
            total += len(chunk)
        source_after = os.fstat(source_descriptor)
        source_named_after = os.stat(
            leaf, dir_fd=source_parent, follow_symlinks=False
        )
        if (
            not identities_equal(before, source_after)
            or not identities_equal(source_after, source_named_after)
            or total != item["size"]
            or digest.hexdigest() != item["sha256"]
        ):
            fail(f"{label}_source_drifted_during_copy:{relative}")
        os.fsync(destination_descriptor)
        destination_after = os.fstat(destination_descriptor)
        if (
            not stat.S_ISREG(destination_after.st_mode)
            or destination_after.st_nlink != 1
            or destination_after.st_size != total
        ):
            fail(f"{label}_destination_identity_invalid:{relative}")
        os.fsync(destination_parent)
    finally:
        if destination_descriptor >= 0:
            os.close(destination_descriptor)
        if source_descriptor >= 0:
            os.close(source_descriptor)
        os.close(destination_parent)
        os.close(source_parent)


def copy_tree_snapshot(
    source_root: pathlib.Path,
    destination_root: pathlib.Path,
    snapshot: dict[str, Any],
    label: str,
    *,
    allow_internal_symlinks: bool = False,
) -> dict[str, Any]:
    require_canonical_absolute(source_root, f"{label}_source_root")
    require_canonical_absolute(destination_root, f"{label}_destination_root")
    os.mkdir(destination_root, 0o700)
    source_descriptor = os.open(source_root, directory_open_flags())
    destination_descriptor = os.open(destination_root, directory_open_flags())
    try:
        if stat_identity(os.fstat(source_descriptor)) != snapshot["root_identity"]:
            fail(f"{label}_source_root_identity_mismatch")
        source_directories = {
            item["path"]: item["identity"] for item in snapshot["directories"]
        }
        for item in snapshot["directories"]:
            create_relative_directory(
                destination_descriptor, item["path"], f"{label}_destination"
            )
        for item in snapshot["files"]:
            copy_regular_file_from_snapshot(
                source_descriptor,
                destination_descriptor,
                item,
                source_directories,
                label,
            )
        for item in snapshot["links"]:
            if not allow_internal_symlinks:
                fail(f"{label}_unexpected_symlink:{item['path']}")
            relative = item["path"]
            parent_name, _, leaf = relative.rpartition("/")
            source_parent = open_relative_directory(
                source_descriptor,
                parent_name,
                f"{label}_source",
                source_directories,
            )
            destination_parent = open_relative_directory(
                destination_descriptor,
                parent_name,
                f"{label}_destination",
            )
            try:
                source_info = os.stat(
                    leaf, dir_fd=source_parent, follow_symlinks=False
                )
                source_target = os.readlink(leaf, dir_fd=source_parent)
                if (
                    stat_identity(source_info) != item["identity"]
                    or source_target != item["target"]
                ):
                    fail(f"{label}_source_symlink_drifted:{relative}")
                os.symlink(source_target, leaf, dir_fd=destination_parent)
                os.fsync(destination_parent)
            finally:
                os.close(destination_parent)
                os.close(source_parent)
        os.fsync(destination_descriptor)
    finally:
        os.close(destination_descriptor)
        os.close(source_descriptor)
    source_after = tree_snapshot(
        source_root, f"{label}_source_after", allow_internal_symlinks=allow_internal_symlinks
    )
    if source_after != snapshot:
        fail(f"{label}_source_changed_during_snapshot_copy")
    destination_snapshot = tree_snapshot(
        destination_root,
        f"{label}_destination_after",
        allow_internal_symlinks=allow_internal_symlinks,
    )
    if (
        destination_snapshot["bytes_root"] != snapshot["bytes_root"]
        or destination_snapshot["directory_count"] != snapshot["directory_count"]
        or destination_snapshot["file_count"] != snapshot["file_count"]
        or destination_snapshot["symlink_count"] != snapshot["symlink_count"]
    ):
        fail(f"{label}_destination_bytes_mismatch")
    return destination_snapshot


def copy_bound_file(
    source: pathlib.Path,
    destination: pathlib.Path,
    expected: dict[str, Any],
    label: str,
    mode: int,
) -> dict[str, Any]:
    require_canonical_absolute(source, f"{label}_source")
    require_canonical_absolute(destination, f"{label}_destination")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    source_descriptor = os.open(source, flags)
    destination_descriptor = -1
    digest = hashlib.sha256()
    try:
        before = os.fstat(source_descriptor)
        named_before = os.stat(source, follow_symlinks=False)
        if (
            stat_identity(before) != expected["identity"]
            or not identities_equal(before, named_before)
            or not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
        ):
            fail(f"{label}_source_identity_invalid")
        destination_descriptor = os.open(
            destination,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
            0o600,
        )
        total = 0
        while True:
            chunk = os.read(source_descriptor, READ_SIZE)
            if not chunk:
                break
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(destination_descriptor, view)
                if written <= 0:
                    fail(f"{label}_destination_write_failed")
                view = view[written:]
            total += len(chunk)
        after = os.fstat(source_descriptor)
        named_after = os.stat(source, follow_symlinks=False)
        if (
            not identities_equal(before, after)
            or not identities_equal(after, named_after)
            or total != expected["identity"]["size"]
            or digest.hexdigest() != expected["sha256"]
        ):
            fail(f"{label}_source_drifted_during_copy")
        os.fchmod(destination_descriptor, mode)
        os.fsync(destination_descriptor)
    finally:
        if destination_descriptor >= 0:
            os.close(destination_descriptor)
        os.close(source_descriptor)
    copied = stable_file(destination, f"{label}_destination")
    if copied["sha256"] != expected["sha256"]:
        fail(f"{label}_destination_sha256_mismatch")
    return copied


def seal_tree(path: pathlib.Path, label: str) -> None:
    require_canonical_absolute(path, label)
    root_descriptor = os.open(path, directory_open_flags())

    def seal_directory(descriptor: int, relative: str) -> None:
        names = os.listdir(descriptor)
        names.sort(key=lambda name: name.encode("utf-8", "strict"))
        for name in names:
            info = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            child_relative = f"{relative}/{name}" if relative else name
            if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
                child = os.open(name, directory_open_flags(), dir_fd=descriptor)
                try:
                    if not identities_equal(info, os.fstat(child)):
                        fail(f"{label}_directory_identity_drifted:{child_relative}")
                    seal_directory(child, child_relative)
                    os.fchmod(child, 0o500)
                    os.fsync(child)
                finally:
                    os.close(child)
            elif stat.S_ISREG(info.st_mode):
                child = os.open(
                    name,
                    os.O_RDONLY
                    | getattr(os, "O_NOFOLLOW", 0)
                    | getattr(os, "O_CLOEXEC", 0),
                    dir_fd=descriptor,
                )
                try:
                    if not identities_equal(info, os.fstat(child)):
                        fail(f"{label}_file_identity_drifted:{child_relative}")
                    os.fchmod(child, 0o400)
                    os.fsync(child)
                finally:
                    os.close(child)
            elif not stat.S_ISLNK(info.st_mode):
                fail(f"{label}_unsupported_node:{child_relative}")
        os.fsync(descriptor)

    try:
        seal_directory(root_descriptor, "")
        os.fchmod(root_descriptor, 0o500)
        os.fsync(root_descriptor)
    finally:
        os.close(root_descriptor)


def safe_remove_tree(path: pathlib.Path, expected_root: dict[str, int], label: str) -> None:
    require_canonical_absolute(path, label)
    parent = path.parent
    parent_descriptor = os.open(parent, directory_open_flags())
    root_descriptor = -1

    def remove_contents(descriptor: int, relative: str) -> None:
        names = os.listdir(descriptor)
        names.sort(key=lambda name: name.encode("utf-8", "strict"))
        for name in names:
            child_relative = f"{relative}/{name}" if relative else name
            info = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
                child = os.open(name, directory_open_flags(), dir_fd=descriptor)
                try:
                    if not identities_equal(info, os.fstat(child)):
                        fail(f"{label}_directory_identity_drifted:{child_relative}")
                    os.fchmod(child, 0o700)
                    remove_contents(child, child_relative)
                    named_after = os.stat(
                        name, dir_fd=descriptor, follow_symlinks=False
                    )
                    if not identities_equal(os.fstat(child), named_after):
                        fail(f"{label}_directory_renamed:{child_relative}")
                finally:
                    os.close(child)
                os.rmdir(name, dir_fd=descriptor)
            else:
                os.unlink(name, dir_fd=descriptor)
            os.fsync(descriptor)

    try:
        named = os.stat(path.name, dir_fd=parent_descriptor, follow_symlinks=False)
        if stat_identity(named) != expected_root:
            fail(f"{label}_root_identity_mismatch")
        root_descriptor = os.open(
            path.name, directory_open_flags(), dir_fd=parent_descriptor
        )
        if not identities_equal(named, os.fstat(root_descriptor)):
            fail(f"{label}_root_open_identity_mismatch")
        os.fchmod(root_descriptor, 0o700)
        remove_contents(root_descriptor, "")
        named_after = os.stat(
            path.name, dir_fd=parent_descriptor, follow_symlinks=False
        )
        if not identities_equal(os.fstat(root_descriptor), named_after):
            fail(f"{label}_root_renamed")
        os.close(root_descriptor)
        root_descriptor = -1
        os.rmdir(path.name, dir_fd=parent_descriptor)
        os.fsync(parent_descriptor)
    finally:
        if root_descriptor >= 0:
            os.close(root_descriptor)
        os.close(parent_descriptor)


def ensure_private_directory(path: pathlib.Path, label: str) -> os.stat_result:
    require_canonical_absolute(path, label)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    info = require_real_directory(path, label)
    if info.st_uid != os.geteuid() or info.st_mode & 0o077:
        fail(f"{label}_ownership_or_mode_invalid")
    return info


def acquire_generation_store(
    package_root: pathlib.Path,
) -> tuple[pathlib.Path, pathlib.Path, int, int, int]:
    store = package_root / GENERATION_STORE
    objects = store / GENERATION_OBJECTS
    ensure_private_directory(store, "generation_store")
    ensure_private_directory(objects, "generation_objects")
    fsync_directory(store)
    fsync_directory(package_root)
    store_descriptor = os.open(store, directory_open_flags())
    objects_descriptor = os.open(
        GENERATION_OBJECTS, directory_open_flags(), dir_fd=store_descriptor
    )
    if (
        not identities_equal(
            os.fstat(store_descriptor), os.stat(store, follow_symlinks=False)
        )
        or not identities_equal(
            os.fstat(objects_descriptor), os.stat(objects, follow_symlinks=False)
        )
    ):
        os.close(objects_descriptor)
        os.close(store_descriptor)
        fail("generation_store_named_identity_invalid")
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0)
    )
    lock_descriptor = os.open(
        GENERATION_LOCK, flags, 0o600, dir_fd=store_descriptor
    )
    lock_info = os.fstat(lock_descriptor)
    named_lock = os.stat(
        GENERATION_LOCK, dir_fd=store_descriptor, follow_symlinks=False
    )
    if (
        not stat.S_ISREG(lock_info.st_mode)
        or lock_info.st_nlink != 1
        or lock_info.st_uid != os.geteuid()
        or lock_info.st_mode & 0o077
        or not identities_equal(lock_info, named_lock)
    ):
        os.close(lock_descriptor)
        os.close(objects_descriptor)
        os.close(store_descriptor)
        fail("generation_lock_identity_invalid")
    os.fsync(lock_descriptor)
    os.fsync(store_descriptor)
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock_descriptor)
        os.close(objects_descriptor)
        os.close(store_descriptor)
        fail("generation_writer_active")
    return store, objects, store_descriptor, objects_descriptor, lock_descriptor


def canonical_pointer_bytes(generation_cid: str) -> bytes:
    return canonical_manifest_bytes(
        {
            "generation_cid": generation_cid,
            "schema": POINTER_SCHEMA,
        }
    )


def create_pending_directory(
    parent: pathlib.Path,
    parent_descriptor: int,
    prefix: str,
    label: str,
) -> pathlib.Path:
    for _ in range(128):
        name = prefix + secrets.token_hex(16)
        try:
            os.mkdir(name, 0o700, dir_fd=parent_descriptor)
        except FileExistsError:
            continue
        os.fsync(parent_descriptor)
        named = os.stat(name, dir_fd=parent_descriptor, follow_symlinks=False)
        path = require_canonical_absolute(parent / name, label)
        if not identities_equal(named, os.stat(path, follow_symlinks=False)):
            fail(f"{label}_named_identity_invalid")
        return path
    fail(f"{label}_name_exhausted")


def publish_current_pointer(store_descriptor: int, generation_cid: str) -> str:
    raw = canonical_pointer_bytes(generation_cid)
    pending_name = f".current.pending.{os.getpid()}.{secrets.token_hex(16)}"
    pending_descriptor = -1
    try:
        pending_descriptor = os.open(
            pending_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
            0o600,
            dir_fd=store_descriptor,
        )
        offset = 0
        while offset < len(raw):
            written = os.write(pending_descriptor, raw[offset:])
            if written <= 0:
                fail("current_pointer_write_failed")
            offset += written
        os.fchmod(pending_descriptor, 0o400)
        os.fsync(pending_descriptor)
        pending_info = os.fstat(pending_descriptor)
        if pending_info.st_size != len(raw) or pending_info.st_nlink != 1:
            fail("current_pointer_pending_identity_invalid")
        os.replace(
            pending_name,
            GENERATION_CURRENT,
            src_dir_fd=store_descriptor,
            dst_dir_fd=store_descriptor,
        )
        os.fsync(store_descriptor)
        current_info = os.stat(
            GENERATION_CURRENT,
            dir_fd=store_descriptor,
            follow_symlinks=False,
        )
        committed_info = os.fstat(pending_descriptor)
        if (
            not same_object_identity(pending_info, committed_info)
            or pending_info.st_size != committed_info.st_size
            or not identities_equal(committed_info, current_info)
        ):
            fail("current_pointer_commit_identity_invalid")
    finally:
        if pending_descriptor >= 0:
            os.close(pending_descriptor)
        try:
            os.unlink(pending_name, dir_fd=store_descriptor)
        except FileNotFoundError:
            pass
        else:
            os.fsync(store_descriptor)
    return sha256_bytes(raw)


def publish_generation_object(
    objects_descriptor: int,
    staging_name: str,
    generation_cid: str,
) -> None:
    require_generation_cid(generation_cid, "generation_publish_cid")
    require_generation_staging_name(staging_name, "generation_publish_staging_name")
    source_descriptor = os.open(
        staging_name,
        directory_open_flags(),
        dir_fd=objects_descriptor,
    )
    try:
        source_before = os.fstat(source_descriptor)
        source_named_before = os.stat(
            staging_name,
            dir_fd=objects_descriptor,
            follow_symlinks=False,
        )
        if (
            not stat.S_ISDIR(source_before.st_mode)
            or source_before.st_mode & 0o222
            or not identities_equal(source_before, source_named_before)
        ):
            fail("generation_publish_source_identity_invalid")
        try:
            os.stat(
                generation_cid,
                dir_fd=objects_descriptor,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            pass
        else:
            fail("generation_publish_destination_exists")
        if sys.platform == "darwin":
            libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
            operation = getattr(libc, "renameatx_np", None)
            flag = 0x00000004
        elif sys.platform.startswith("linux"):
            libc = ctypes.CDLL(None, use_errno=True)
            operation = getattr(libc, "renameat2", None)
            flag = 0x00000001
        else:
            fail("generation_publish_platform_unsupported")
        if operation is None:
            fail("generation_publish_atomic_rename_unavailable")
        operation.argtypes = (
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_uint,
        )
        operation.restype = ctypes.c_int
        ctypes.set_errno(0)
        result = operation(
            objects_descriptor,
            os.fsencode(staging_name),
            objects_descriptor,
            os.fsencode(generation_cid),
            flag,
        )
        if result != 0:
            error_number = ctypes.get_errno()
            if error_number in (errno.EEXIST, errno.ENOTEMPTY):
                fail("generation_publish_destination_raced")
            if error_number == errno.EXDEV:
                fail("generation_publish_cross_device_rejected")
            fail(f"generation_publish_atomic_rename_failed:{error_number}")
        os.fsync(objects_descriptor)
        destination = os.stat(
            generation_cid,
            dir_fd=objects_descriptor,
            follow_symlinks=False,
        )
        source_after = os.fstat(source_descriptor)
        if (
            not same_directory_identity(source_before, source_after)
            or not identities_equal(source_after, destination)
        ):
            fail("generation_publish_commit_identity_invalid")
        try:
            os.stat(
                staging_name,
                dir_fd=objects_descriptor,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            pass
        else:
            fail("generation_publish_staging_name_survived")
    finally:
        os.close(source_descriptor)


def parse_expected(arguments: list[str]) -> tuple[dict[str, str], list[str]]:
    expected: dict[str, str] = {}
    expected_order: list[str] = []
    expected_positions: list[int] = []
    remainder: list[str] = []
    for position, argument in enumerate(arguments):
        if argument.startswith("--expected-") and "=" in argument:
            raw_key, value = argument[11:].split("=", 1)
            key = raw_key.replace("-", "_")
            if key in expected:
                fail(f"duplicate_expected_identity:{key}")
            expected[key] = value
            expected_order.append(key)
            expected_positions.append(position)
        else:
            remainder.append(argument)
    if tuple(expected_order) != EXPECTED_KEYS:
        fail("expected_identity_set_invalid")
    expected_start = len(arguments) - len(EXPECTED_KEYS)
    if expected_positions != list(range(expected_start, len(arguments))):
        fail("expected_identity_suffix_invalid")
    return expected, remainder


def source_binding(source_path_raw: str) -> tuple[pathlib.Path, pathlib.Path, pathlib.Path]:
    source_path = require_canonical_absolute(pathlib.Path(source_path_raw), "runner_source")
    if source_path.name != RUNNER_NAME or source_path.parent.name != "tools":
        fail("runner_source_location_invalid")
    source = stable_file(source_path, "runner_source")
    executing_path = pathlib.Path(os.path.abspath(__file__))
    executing = stable_file(executing_path, "runner_execution_image")
    if source["sha256"] != executing["sha256"]:
        fail("runner_execution_image_mismatch")
    repo_root = require_canonical_absolute(source_path.parent.parent, "repo_root")
    package_root = require_canonical_absolute(repo_root / "ts-csg", "package_root")
    require_real_directory(repo_root, "repo_root")
    require_real_directory(package_root, "package_root")
    return source_path, repo_root, package_root


def validate_package_lock(package_root: pathlib.Path) -> None:
    try:
        lock_raw, _ = stable_file_bytes(
            package_root / "package-lock.json", "package_lock_json", 16 * 1024 * 1024
        )
        installed_raw, _ = stable_file_bytes(
            package_root / "node_modules/typescript/package.json",
            "typescript_package_json",
            1024 * 1024,
        )
        lock = json.loads(lock_raw.decode("utf-8"))
        installed = json.loads(installed_raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"package_metadata_invalid:{type(error).__name__}")
    packages = lock.get("packages")
    lock_typescript = packages.get("node_modules/typescript") if isinstance(packages, dict) else None
    if not isinstance(lock_typescript, dict):
        fail("package_lock_typescript_missing")
    if lock_typescript.get("version") != installed.get("version"):
        fail("installed_typescript_version_mismatch")
    integrity = lock_typescript.get("integrity")
    if not isinstance(integrity, str) or not integrity.startswith("sha512-"):
        fail("package_lock_typescript_integrity_missing")


def validate_tsconfig_contract(package_root: pathlib.Path) -> None:
    raw, _ = stable_file_bytes(
        package_root / "tsconfig.json", "tsconfig_contract", 1024 * 1024
    )
    try:
        config = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"tsconfig_contract_invalid:{type(error).__name__}")
    expected = {
