            },
            bound_trees={
                "node_modules": (private_node_modules, True),
                "sources": (private_sources, False),
            },
            cwd_mutation_expected=True,
        )
        tree_snapshot(candidate_active, "candidate_active")
        print(f"{SCHEMA} phase=freeze", flush=True)
        run_visible(
            "freeze",
            [
                os.fspath(private_node),
                os.fspath(private_package / "scripts/freeze-dist.mjs"),
                "--package-root",
                os.fspath(private_output),
            ],
            private_output,
            environment,
            events,
            bound_paths={
                "atomic_helper": private_atomic_helper,
                "freeze": private_package / "scripts/freeze-dist.mjs",
            },
            bound_system_paths={"atomic_python": ATOMIC_PYTHON_BIN},
            bound_trees={"active_dist": (candidate_active, False)},
            cwd_mutation_expected=True,
        )
        verify_output_pair(private_output, "candidate_generation")
        inputs_before_publish = input_snapshot(
            source_path, repo_root, package_root, expected
        )
        assert_input_snapshot_equal(inputs_before, inputs_before_publish)

        generation_stage = create_pending_directory(
            objects,
            objects_descriptor,
            ".generation.pending.",
            "generation_stage",
        )
        os.rename(candidate_active, generation_stage / "dist")
        os.rename(candidate_frozen, generation_stage / "dist-frozen")
        fsync_directory(private_output)
        fsync_directory(generation_stage)
        seal_tree(generation_stage / "dist", "generation_active_seal")
        seal_tree(generation_stage / "dist-frozen", "generation_frozen_seal")
        outputs = verify_output_pair(
            generation_stage,
            "generation_stage",
            require_sealed=True,
        )
        build_execution = execution_receipt(events)
        generation_manifest = {
            "build_execution": build_execution,
            "guard_parent_proof": guard_parent_proof,
            "inputs": public_input_snapshot(inputs_before),
            "inputs_before_after_equal": True,
            "legacy_directories_authority": "none",
            "outputs": output_manifest_fields(outputs),
            "schema": GENERATION_SCHEMA,
            "tsc_file_list": file_list_receipt,
        }
        generation_raw = canonical_manifest_bytes(generation_manifest)
        generation_cid = sha256_bytes(generation_raw)
        generation_manifest_file = write_new_canonical_file(
            generation_stage / "generation-manifest.json",
            generation_raw,
            "generation_manifest",
        )
        if generation_manifest_file["sha256"] != generation_cid:
            fail("generation_manifest_cid_mismatch")
        generation_stage_descriptor = os.open(
            generation_stage, directory_open_flags()
        )
        try:
            os.fchmod(generation_stage_descriptor, 0o500)
            os.fsync(generation_stage_descriptor)
            if not identities_equal(
                os.fstat(generation_stage_descriptor),
                os.stat(generation_stage, follow_symlinks=False),
            ):
                fail("generation_stage_named_identity_drifted")
        finally:
            os.close(generation_stage_descriptor)
        staging_name = generation_stage.name
        if not identities_equal(
            os.fstat(objects_descriptor), os.stat(objects, follow_symlinks=False)
        ):
            fail("generation_objects_named_identity_drifted_after_stage")
        staged_generation = load_generation_object(
            package_root,
            generation_cid,
            "staged_generation",
            staging_name=staging_name,
        )
        if (
            staged_generation["outputs"] != outputs
            or staged_generation["generation"] != generation_manifest
            or staged_generation["generation_manifest_sha256"] != generation_cid
        ):
            fail("staged_generation_binding_mismatch")
        inputs_precommit = input_snapshot(
            source_path, repo_root, package_root, expected
        )
        assert_input_snapshot_equal(inputs_before, inputs_precommit)

        candidate_identity = stat_identity(os.stat(candidate_root, follow_symlinks=False))
        safe_remove_tree(candidate_root, candidate_identity, "candidate_cleanup")
        candidate_root = None
        pointer_sha256 = sha256_bytes(canonical_pointer_bytes(generation_cid))
        manifest = {
            "dynamic_completion_credit": 0,
            "execution": execution_receipt(events),
            "generation": {
                "commit": "pending_gate_admission",
                "generation_cid": generation_cid,
                "generation_manifest_sha256": generation_cid,
                "pointer_sha256": pointer_sha256,
                "staging_name": staging_name,
            },
            "guard_parent_proof": guard_parent_proof,
            "inputs": public_input_snapshot(inputs_before),
            "inputs_before_after_equal": True,
            "legacy_directories_authority": "none",
            "outputs": output_manifest_fields(outputs),
            "schema": SCHEMA,
            "status": "guarded_process_completed_pending_admission",
            "tsc_file_list": file_list_receipt,
        }
        if not identities_equal(
            os.fstat(store_descriptor), os.stat(store, follow_symlinks=False)
        ):
            fail("generation_store_named_identity_drifted_precommit")
        write_manifest_fd(manifest_fd_path, canonical_manifest_bytes(manifest))
        print(f"{SCHEMA} runner=PENDING_ADMISSION", flush=True)
        _ = (store_descriptor, objects_descriptor, lock_descriptor)
        return
    except BaseException as original_error:
        cleanup_errors: list[str] = []
        for path, label in (
            (generation_stage, "generation_stage_cleanup"),
            (candidate_root, "candidate_cleanup"),
        ):
            if path is None or not os.path.lexists(path):
                continue
            try:
                identity = stat_identity(os.stat(path, follow_symlinks=False))
                safe_remove_tree(path, identity, label)
            except BaseException as cleanup_error:
                cleanup_errors.append(f"{label}:{cleanup_error}")
        if cleanup_errors:
            fail(f"fd_safe_cleanup_failed:{'|'.join(cleanup_errors)}:{original_error}")
        raise


