        file_list_receipt = validate_tsc_file_list(file_list_raw, private_package)

        print(f"{SCHEMA} phase=tsc_emit", flush=True)
        run_visible(
            "tsc_emit",
            [
                os.fspath(private_node),
                os.fspath(private_tsc),
                "-p",
                os.fspath(private_tsconfig),
                "--outDir",
                os.fspath(candidate_active),
            ],
            private_output,
