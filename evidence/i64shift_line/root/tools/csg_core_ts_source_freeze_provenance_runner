def verify_manifest_state(
    source_path_raw: str,
    expected: dict[str, str],
    manifest_path_raw: str,
    guard_report_path_raw: str,
    *,
    admitted: bool,
) -> dict[str, Any]:
    manifest_path = require_canonical_absolute(
        pathlib.Path(manifest_path_raw), "dynamic_manifest"
    )
    raw, manifest_file = stable_file_bytes(
        manifest_path, "dynamic_manifest", 8 * 1024 * 1024
    )
    manifest = parse_canonical_json(raw, "dynamic_manifest")
    if list(manifest) != [
        "dynamic_completion_credit",
        "execution",
        "generation",
        "guard_parent_proof",
        "inputs",
        "inputs_before_after_equal",
        "legacy_directories_authority",
        "outputs",
        "schema",
        "status",
        "tsc_file_list",
    ]:
        fail("dynamic_manifest_fields_invalid")
    if (
        manifest.get("schema") != SCHEMA
        or manifest.get("status")
        != "guarded_process_completed_pending_admission"
        or manifest.get("dynamic_completion_credit") != 0
        or manifest.get("inputs_before_after_equal") is not True
        or manifest.get("legacy_directories_authority") != "none"
    ):
        fail("dynamic_manifest_header_invalid")
    source_path, repo_root, package_root = source_binding(source_path_raw)
    inputs = input_snapshot(source_path, repo_root, package_root, expected)
    public_inputs = public_input_snapshot(inputs)
    if manifest.get("inputs") != public_inputs:
        fail("dynamic_manifest_input_binding_mismatch")
    generation_fields = manifest.get("generation")
    if not isinstance(generation_fields, dict):
        fail("dynamic_manifest_generation_missing")
    generation_cid = require_generation_cid(
        generation_fields.get("generation_cid"),
        "dynamic_manifest_generation_cid",
    )
    staging_name = generation_fields.get("staging_name")
    require_generation_staging_name(staging_name, "dynamic_manifest_staging_name")
    loaded = load_generation_object(
        package_root,
        generation_cid,
        "admitted_generation" if admitted else "pending_generation",
        staging_name=None if admitted else staging_name,
    )
    expected_generation = {
        "commit": "pending_gate_admission",
        "generation_cid": loaded["generation_cid"],
        "generation_manifest_sha256": loaded["generation_manifest_sha256"],
        "pointer_sha256": sha256_bytes(
            canonical_pointer_bytes(loaded["generation_cid"])
        ),
        "staging_name": staging_name,
    }
    if manifest.get("generation") != expected_generation:
        fail("dynamic_manifest_generation_binding_mismatch")
    if manifest.get("outputs") != output_manifest_fields(loaded["outputs"]):
        fail("dynamic_manifest_output_binding_mismatch")
    generation = loaded["generation"]
    if (
        generation.get("inputs") != public_inputs
        or generation.get("outputs") != manifest.get("outputs")
        or generation.get("tsc_file_list") != manifest.get("tsc_file_list")
        or generation.get("guard_parent_proof")
        != manifest.get("guard_parent_proof")
        or generation.get("legacy_directories_authority") != "none"
    ):
        fail("dynamic_manifest_generation_content_mismatch")
    execution = manifest.get("execution")
    if not isinstance(execution, dict):
        fail("dynamic_manifest_execution_missing")
    events = execution.get("events")
    if not isinstance(events, list) or [event.get("label") for event in events] != [
        "tsc_file_list",
        "tsc_emit",
        "freeze",
    ]:
        fail("dynamic_manifest_execution_sequence_invalid")
    if execution_receipt(events) != execution:
        fail("dynamic_manifest_execution_chain_invalid")
    build_execution = generation.get("build_execution")
    if (
        not isinstance(build_execution, dict)
        or execution_receipt(events) != build_execution
    ):
        fail("dynamic_manifest_build_execution_mismatch")
    for index, event in enumerate(events):
        if (
            event.get("ordinal") != index
            or event.get("return_code") != 0
            or not isinstance(event.get("pid"), int)
            or event["pid"] <= 1
            or event.get("stderr") != "guard_inherited_visible"
            or event.get("stdout")
            != ("guard_tee_visible" if index == 0 else "guard_inherited_visible")
        ):
            fail(f"dynamic_manifest_execution_event_invalid:{index}")
    if manifest_file["identity"]["mode"] & 0o222:
        fail("dynamic_manifest_not_sealed")
    verify_guard_report_binding(
        guard_report_path_raw,
        manifest_path,
        manifest_file,
        manifest,
        expected,
    )
    return {
        "loaded": loaded,
        "manifest": manifest,
        "manifest_sha256": manifest_file["sha256"],
        "package_root": package_root,
        "raw": raw,
    }


