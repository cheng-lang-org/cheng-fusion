def consume_darwin_injected_environment() -> None:
    key = "__CF_USER_TEXT_ENCODING"
    value = os.environ.get(key)
    if sys.platform == "darwin":
        parts = value.split(":") if value is not None else []
        expected_uid = f"0x{os.geteuid():X}"
        if (
            len(parts) != 3
            or parts[0] != expected_uid
            or any(
                len(part) <= 2
                or not part.startswith("0x")
                or any(character not in "0123456789ABCDEF" for character in part[2:])
                for part in parts
            )
        ):
            fail("darwin_injected_environment_invalid")
    elif value is not None:
        fail("foreign_injected_environment_present")
    if value is not None:
        del os.environ[key]
    if key in os.environ:
        fail("injected_environment_not_consumed")


def require_guard_context() -> dict[str, Any]:
    consume_darwin_injected_environment()
    expected_environment = {
        "HOME": pwd.getpwuid(os.geteuid()).pw_dir,
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONHASHSEED": "0",
        "TZ": "UTC",
    }
    for key, value in expected_environment.items():
        if os.environ.get(key) != value:
            fail(f"guard_environment_invalid:{key}")
    guard_keys = {
        "BEAT_C_GUARD_PARENT_CAPABILITY",
        "BEAT_C_GUARD_PARENT_LIMIT_BYTES",
        "BEAT_C_GUARD_PARENT_MONITOR_PID",
        "BEAT_C_GUARD_PARENT_PROOF_FD",
    }
    allowed = set(expected_environment) | guard_keys
    unexpected = sorted(set(os.environ) - allowed)
    if unexpected:
        fail(f"guard_environment_polluted:{unexpected[0]}")
    capability = os.environ.get("BEAT_C_GUARD_PARENT_CAPABILITY", "")
    if len(capability) != 64 or any(
        character not in "0123456789abcdef" for character in capability
    ):
        fail("guard_parent_capability_invalid")
    if os.environ.get("BEAT_C_GUARD_PARENT_LIMIT_BYTES") != "1073741824":
        fail("guard_parent_limit_invalid")
    monitor_pid = os.environ.get("BEAT_C_GUARD_PARENT_MONITOR_PID", "")
    if not monitor_pid.isdigit() or int(monitor_pid) <= 1:
        fail("guard_parent_monitor_invalid")
    if os.environ.get("BEAT_C_GUARD_PARENT_PROOF_FD") != "3":
        fail("guard_parent_proof_fd_invalid")
    try:
        proof_info = os.fstat(3)
    except OSError as error:
        fail(f"guard_parent_proof_unavailable:{error.errno}")
    if not stat.S_ISSOCK(proof_info.st_mode):
        fail("guard_parent_proof_not_socket")
    libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
    get_socket_option = libc.getsockopt
    get_socket_option.argtypes = (
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_void_p,
        ctypes.POINTER(ctypes.c_uint32),
    )
    get_socket_option.restype = ctypes.c_int

    def peer_pid() -> int:
        peer = ctypes.c_int(0)
        length = ctypes.c_uint32(ctypes.sizeof(peer))
        ctypes.set_errno(0)
        if get_socket_option(
            3, 0, 0x002, ctypes.byref(peer), ctypes.byref(length)
        ) != 0:
            fail(f"guard_parent_peer_query_failed:{ctypes.get_errno()}")
        if length.value != ctypes.sizeof(peer) or peer.value <= 1:
            fail("guard_parent_peer_invalid")
        return int(peer.value)

    peer_before = peer_pid()
    duplicate = socket.socket(fileno=os.dup(3))
    deadline = time.monotonic() + 5.0
    frame = b""
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail("guard_parent_proof_timeout")
            readable, _, _ = select.select([duplicate], [], [], remaining)
            if not readable:
                fail("guard_parent_proof_timeout")
            frame = duplicate.recv(4101, socket.MSG_PEEK)
            if not frame:
                fail("guard_parent_proof_closed")
            if len(frame) < 4:
                continue
            size = struct.unpack(">I", frame[:4])[0]
            if size <= 0 or size > 4096:
                fail("guard_parent_proof_size_invalid")
            expected_size = 4 + size
            if len(frame) < expected_size:
                continue
            if len(frame) != expected_size:
                fail("guard_parent_proof_extra_bytes")
            chunks: list[bytes] = []
            consumed = 0
            while consumed < expected_size:
                chunk = duplicate.recv(expected_size - consumed)
                if not chunk:
                    fail("guard_parent_proof_truncated")
                chunks.append(chunk)
                consumed += len(chunk)
            frame = b"".join(chunks)
            break
    finally:
        duplicate.close()
    proof_after = os.fstat(3)
    peer_after = peer_pid()
    if (
        not same_object_identity(proof_info, proof_after)
        or peer_before != peer_after
        or peer_after != int(monitor_pid)
    ):
        fail("guard_parent_proof_physical_identity_invalid")
    raw = frame[4:]
    try:
        text = raw.decode("utf-8", "strict")
        record = json.loads(text)
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"guard_parent_proof_json_invalid:{type(error).__name__}")
    keys = [
        "schema",
        "capability",
        "monitorPid",
        "monitorStartTvsec",
        "monitorStartTvusec",
        "limitBytes",
        "rootPid",
        "rootStartTvsec",
        "rootStartTvusec",
        "rootPpid",
        "rootSid",
        "rootPgid",
    ]
    if (
        not isinstance(record, dict)
        or list(record) != keys
        or not text.endswith("\n")
        or "\r" in text
        or json.dumps(record, separators=(",", ":")) + "\n" != text
    ):
        fail("guard_parent_proof_not_canonical")
    if (
        record["schema"] != "cheng.guard.parent_proof"
        or record["capability"] != capability
        or record["monitorPid"] != int(monitor_pid)
        or record["limitBytes"] != 1073741824
        or record["rootPid"] != os.getpid()
        or record["rootPpid"] != os.getppid()
        or record["rootPpid"] != int(monitor_pid)
        or record["rootSid"] != os.getsid(0)
        or record["rootPgid"] != os.getpgid(0)
    ):
        fail("guard_parent_proof_binding_invalid")
    for key in keys[2:]:
        if type(record[key]) is not int or record[key] <= 0:
            fail(f"guard_parent_proof_numeric_field_invalid:{key}")
    return {
        "limit_bytes": record["limitBytes"],
        "monitor_pid": record["monitorPid"],
        "monitor_start_tvsec": record["monitorStartTvsec"],
        "monitor_start_tvusec": record["monitorStartTvusec"],
        "proof_record_sha256": sha256_bytes(raw),
        "root_pgid": record["rootPgid"],
        "root_pid": record["rootPid"],
        "root_ppid": record["rootPpid"],
        "root_sid": record["rootSid"],
        "root_start_tvsec": record["rootStartTvsec"],
        "root_start_tvusec": record["rootStartTvusec"],
    }


def run_visible(
    label: str,
    arguments: list[str],
    cwd: pathlib.Path,
    environment: dict[str, str],
    events: list[dict[str, Any]],
    *,
    bound_paths: dict[str, pathlib.Path],
    bound_system_paths: dict[str, pathlib.Path] | None = None,
    bound_trees: dict[str, tuple[pathlib.Path, bool]] | None = None,
    capture_stdout_maximum: int = 0,
    cwd_mutation_expected: bool = False,
    system_executable: bool = False,
) -> bytes:
    if not arguments or pathlib.Path(arguments[0]) != pathlib.Path(arguments[0]).absolute():
        fail(f"{label}_executable_not_absolute")
    if any("\x00" in argument or "\n" in argument or "\r" in argument for argument in arguments):
        fail(f"{label}_argument_not_canonical")
    executable_path = pathlib.Path(arguments[0])
    executable_before = (
        stable_system_executable(executable_path, f"{label}_executable")
        if system_executable
        else stable_file(executable_path, f"{label}_executable")
    )
    bound_before = {
        name: stable_file(path, f"{label}_bound_{name}")
        for name, path in sorted(bound_paths.items())
    }
    system_bindings = bound_system_paths or {}
    bound_system_before = {
        name: stable_system_executable(path, f"{label}_bound_system_{name}")
        for name, path in sorted(system_bindings.items())
    }
    tree_bindings = bound_trees or {}
    trees_before = {
        name: tree_snapshot(
            path,
            f"{label}_bound_tree_{name}",
            allow_internal_symlinks=allow_symlinks,
        )
        for name, (path, allow_symlinks) in sorted(tree_bindings.items())
    }
    cwd_before = require_real_directory(cwd, f"{label}_cwd")
    captured = bytearray()
    process: subprocess.Popen[bytes] | None = None
    child_pid = 0
    return_code = -1
    try:
        with open(os.devnull, "rb") as stdin_file:
            process = subprocess.Popen(
                arguments,
                cwd=cwd,
                env=environment,
                stdin=stdin_file,
                close_fds=True,
                stdout=subprocess.PIPE if capture_stdout_maximum > 0 else None,
            )
            child_pid = process.pid
            if capture_stdout_maximum > 0:
                if process.stdout is None:
                    fail(f"{label}_stdout_pipe_missing")
                while True:
                    chunk = process.stdout.read(65536)
                    if not chunk:
                        break
                    captured.extend(chunk)
                    if len(captured) > capture_stdout_maximum:
                        fail(f"{label}_stdout_limit_exceeded")
                    view = memoryview(chunk)
                    while view:
                        written = os.write(1, view)
                        if written <= 0:
                            fail(f"{label}_stdout_forward_failed")
                        view = view[written:]
                process.stdout.close()
            return_code = process.wait()
    except BaseException:
        if process is not None:
            if process.stdout is not None and not process.stdout.closed:
                process.stdout.close()
            if process.poll() is None:
                process.kill()
            process.wait()
        raise
    if return_code != 0:
        fail(f"child_command_failed:{label}:{return_code}")
    executable_after = (
        stable_system_executable(executable_path, f"{label}_executable_after")
        if system_executable
        else stable_file(executable_path, f"{label}_executable_after")
    )
    bound_after = {
        name: stable_file(path, f"{label}_bound_{name}_after")
        for name, path in sorted(bound_paths.items())
    }
    bound_system_after = {
        name: stable_system_executable(
            path, f"{label}_bound_system_{name}_after"
        )
        for name, path in sorted(system_bindings.items())
    }
    trees_after = {
        name: tree_snapshot(
            path,
            f"{label}_bound_tree_{name}_after",
            allow_internal_symlinks=allow_symlinks,
        )
        for name, (path, allow_symlinks) in sorted(tree_bindings.items())
    }
    cwd_after = require_real_directory(cwd, f"{label}_cwd_after")
    if (
        executable_before != executable_after
        or bound_before != bound_after
        or bound_system_before != bound_system_after
        or trees_before != trees_after
        or (
            not same_directory_identity(cwd_before, cwd_after)
            if cwd_mutation_expected
            else not identities_equal(cwd_before, cwd_after)
        )
    ):
        fail(f"{label}_physical_identity_changed_during_execution")
    event = {
        "argv": arguments,
        "argv_sha256": framed_digest(
            f"{SCHEMA}.child.argv",
            [(str(index), value.encode("utf-8")) for index, value in enumerate(arguments)],
        ),
        "bound_files": bound_after,
        "bound_system_files": bound_system_after,
        "bound_trees": {
            name: {
                "bytes_root": snapshot["bytes_root"],
                "identity_root": snapshot["identity_root"],
            }
            for name, snapshot in sorted(trees_after.items())
        },
        "cwd": os.fspath(cwd),
        "cwd_identity": stat_identity(cwd_after),
        "cwd_mutation": "expected" if cwd_mutation_expected else "forbidden",
        "environment_sha256": framed_digest(
            f"{SCHEMA}.child.environment",
            [
                (key, value.encode("utf-8"))
                for key, value in sorted(environment.items())
            ],
        ),
        "executable": executable_after,
        "label": label,
        "ordinal": len(events),
        "pid": child_pid,
        "return_code": return_code,
        "stderr": "guard_inherited_visible",
        "stdout": (
            "guard_tee_visible" if capture_stdout_maximum > 0 else "guard_inherited_visible"
        ),
        "stdout_sha256": sha256_bytes(bytes(captured)),
        "stdout_size": len(captured),
    }
    events.append(event)
    return bytes(captured)


def fsync_directory(path: pathlib.Path) -> None:
    flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def canonical_manifest_bytes(manifest: dict[str, Any]) -> bytes:
    return (
        json.dumps(manifest, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n"
    ).encode("utf-8")


def write_manifest_fd(fd_path: str, raw: bytes) -> None:
    if fd_path != MANIFEST_FD_PATH:
        fail("manifest_fd_path_invalid")
    try:
        descriptor = int(fd_path.rsplit("/", 1)[1])
    except (ValueError, IndexError):
        fail("manifest_fd_invalid")
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size != 0:
        fail("manifest_fd_identity_invalid")
    offset = 0
    while offset < len(raw):
        offset += os.write(descriptor, raw[offset:])
    os.fsync(descriptor)
    after = os.fstat(descriptor)
    if after.st_size != len(raw):
        fail("manifest_fd_size_mismatch")


def parse_mode_arguments(
    arguments: list[str],
) -> tuple[str, str, dict[str, str], dict[str, str], list[str]]:
    if not arguments or arguments[0] not in (
        "--admit-manifest",
        "--audit",
        "--exec-current-cli",
        "--run",
        "--verify-admitted-manifest",
        "--verify-manifest",
    ):
        fail("mode_invalid")
    mode = arguments[0]
    cli_arguments: list[str] = []
    metadata_arguments = arguments[1:]
    if mode == "--exec-current-cli":
        if metadata_arguments.count("--") != 1:
            fail("exec_current_cli_separator_invalid")
        separator = metadata_arguments.index("--")
        cli_arguments = metadata_arguments[separator + 1 :]
        metadata_arguments = metadata_arguments[:separator]
    elif "--" in metadata_arguments:
        fail("argument_separator_invalid")
    expected, remainder = parse_expected(metadata_arguments)
    values: dict[str, str] = {}
    manifest_fd_flag = "--manifest-fd-path"
    if mode == "--run" and (
        len(remainder) != 3
        or not remainder[0].startswith("--source-path=")
        or remainder[1:] != [manifest_fd_flag, MANIFEST_FD_PATH]
    ):
        fail("run_argument_order_invalid")
    if manifest_fd_flag in remainder:
        if remainder.count(manifest_fd_flag) != 1:
            fail("argument_invalid:manifest-fd-path")
        manifest_fd_index = remainder.index(manifest_fd_flag)
        if manifest_fd_index + 1 >= len(remainder):
            fail("argument_invalid:manifest-fd-path")
        manifest_fd_value = remainder[manifest_fd_index + 1]
        if not manifest_fd_value or manifest_fd_value.startswith("--"):
            fail("argument_invalid:manifest-fd-path")
        values["manifest-fd-path"] = manifest_fd_value
        remainder = (
            remainder[:manifest_fd_index]
            + remainder[manifest_fd_index + 2 :]
        )
    for argument in remainder:
        if not argument.startswith("--") or "=" not in argument:
            fail("argument_invalid")
        key, value = argument[2:].split("=", 1)
        if key in values or key not in (
            "guard-report-path",
            "source-path",
            "manifest-path",
        ):
            fail(f"argument_invalid:{key}")
        values[key] = value
    required = {"source-path"}
    if mode == "--run":
        required.add("manifest-fd-path")
    if mode in (
        "--admit-manifest",
        "--verify-admitted-manifest",
        "--verify-manifest",
    ):
        required.add("manifest-path")
        required.add("guard-report-path")
    if set(values) != required:
        fail("argument_set_invalid")
    return mode, values["source-path"], expected, values, cli_arguments


def execution_receipt(events: list[dict[str, Any]]) -> dict[str, Any]:
    for index, event in enumerate(events):
        if event.get("ordinal") != index or event.get("return_code") != 0:
            fail("execution_event_sequence_invalid")
    rows = [
        (
            str(index),
            canonical_manifest_bytes(event),
        )
        for index, event in enumerate(events)
    ]
    return {
        "chain_root": framed_digest(f"{SCHEMA}.child.execution_chain", rows),
        "event_count": len(events),
        "events": events,
    }


def validate_tsc_file_list(raw: bytes, private_package: pathlib.Path) -> dict[str, Any]:
    if not raw or not raw.endswith(b"\n") or b"\x00" in raw or b"\r" in raw:
        fail("tsc_file_list_bytes_invalid")
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeDecodeError:
        fail("tsc_file_list_not_utf8")
    if not lines or len(lines) != len(set(lines)):
        fail("tsc_file_list_empty_or_duplicate")
    rows: list[tuple[str, bytes]] = []
    source_count = 0
    for index, line in enumerate(lines):
        path = pathlib.Path(line)
        require_canonical_absolute(path, f"tsc_file_list_{index}")
        try:
            relative = path.relative_to(private_package).as_posix()
        except ValueError:
            fail(f"tsc_file_list_path_outside_snapshot:{index}")
        if relative.startswith("src/"):
            source_count += 1
        entry = stable_file(path, f"tsc_file_list_{index}")
        rows.append(
            (
                relative,
                canonical_manifest_bytes(
                    {
                        "relative_path": relative,
                        "sha256": entry["sha256"],
                        "size": entry["identity"]["size"],
                    }
                ),
            )
        )
    if source_count == 0:
        fail("tsc_file_list_source_missing")
    return {
        "file_count": len(lines),
        "root": framed_digest(f"{SCHEMA}.tsc_file_list", rows),
        "source_file_count": source_count,
    }


def create_private_build_snapshot(
    candidate_root: pathlib.Path,
    package_root: pathlib.Path,
    inputs: dict[str, Any],
) -> tuple[pathlib.Path, pathlib.Path, pathlib.Path, pathlib.Path]:
    material = inputs["_material"]
    private_package = candidate_root / "package"
    private_output = candidate_root / "output"
    private_tool_root = candidate_root / "tool"
    os.mkdir(private_package, 0o700)
    os.mkdir(private_output, 0o700)
    os.mkdir(private_tool_root, 0o700)
    copy_tree_snapshot(
        package_root / "src",
        private_package / "src",
        material["sources"],
        "private_typescript_sources",
    )
    copy_tree_snapshot(
        package_root / "node_modules",
        private_package / "node_modules",
        material["node_modules"],
        "private_node_modules",
        allow_internal_symlinks=True,
    )
    private_typescript = tree_snapshot(
        private_package / "node_modules/typescript", "private_typescript_toolchain"
    )
    if private_typescript["bytes_root"] != material["typescript"]["bytes_root"]:
        fail("private_typescript_toolchain_bytes_mismatch")
    for name, material_name in (
        ("package.json", "package_json"),
        ("package-lock.json", "package_lock"),
        ("tsconfig.json", "tsconfig"),
    ):
        copy_bound_file(
            package_root / name,
            private_package / name,
            material["files"][material_name],
            f"private_{material_name}",
            0o400,
        )
    private_scripts = private_package / "scripts"
    os.mkdir(private_scripts, 0o700)
    for name, material_name in (
        ("freeze-dist.mjs", "freeze"),
        ("atomic-publish-directory", "atomic"),
    ):
        copy_bound_file(
            package_root / "scripts" / name,
            private_scripts / name,
            material["files"][material_name],
            f"private_{material_name}",
            0o400,
        )
    private_node = private_tool_root / "node"
    copy_bound_file(
        node_binary_path(),
        private_node,
        material["files"]["node"],
        "private_node",
        0o500,
    )
    seal_tree(private_package, "private_package_input_seal")
    seal_tree(private_tool_root, "private_tool_input_seal")
    private_node_descriptor = os.open(
        private_node,
        os.O_RDONLY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
    )
    try:
        os.fchmod(private_node_descriptor, 0o500)
        os.fsync(private_node_descriptor)
    finally:
        os.close(private_node_descriptor)
    require_snapshot_sealed(
        tree_snapshot(
            private_package,
            "private_package_input_snapshot",
            allow_internal_symlinks=True,
        ),
        "private_package_input",
    )
    require_snapshot_sealed(
        tree_snapshot(private_tool_root, "private_tool_input_snapshot"),
        "private_tool_input",
    )
    fsync_directory(private_output)
    fsync_directory(candidate_root)
    return (
        private_package,
        private_output,
        private_node,
        private_scripts / "atomic-publish-directory",
    )


def write_new_canonical_file(
    path: pathlib.Path, raw: bytes, label: str, mode: int = 0o400
) -> dict[str, Any]:
    require_canonical_absolute(path, label)
    descriptor = os.open(
        path,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        0o600,
    )
    try:
        offset = 0
        while offset < len(raw):
            written = os.write(descriptor, raw[offset:])
            if written <= 0:
                fail(f"{label}_write_failed")
            offset += written
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return stable_file(path, label)


def output_manifest_fields(outputs: dict[str, Any]) -> dict[str, Any]:
    return {
        "active_bytes_root": outputs["active_bytes_root"],
        "active_identity_root": outputs["active_identity_root"],
        "file_count": outputs["file_count"],
        "freeze_manifest_sha256": outputs["freeze_manifest_sha256"],
        "frozen_bytes_root": outputs["frozen_bytes_root"],
        "frozen_identity_root": outputs["frozen_identity_root"],
    }


def parse_canonical_json(raw: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"{label}_invalid:{type(error).__name__}")
    if not isinstance(value, dict) or raw != canonical_manifest_bytes(value):
        fail(f"{label}_not_canonical")
    return value


def require_generation_cid(generation_cid: Any, label: str) -> str:
    if (
        not isinstance(generation_cid, str)
        or len(generation_cid) != 64
        or any(character not in "0123456789abcdef" for character in generation_cid)
    ):
        fail(f"{label}_invalid")
    return generation_cid


def require_generation_staging_name(value: Any, label: str) -> str:
    prefix = ".generation.pending."
    if (
        not isinstance(value, str)
        or not value.startswith(prefix)
        or len(value) != len(prefix) + 32
        or any(
            character not in "0123456789abcdef"
            for character in value[len(prefix):]
        )
    ):
        fail(f"{label}_invalid")
    return value


def load_generation_object(
    package_root: pathlib.Path,
    generation_cid_raw: Any,
    label: str,
    *,
    staging_name: Any = None,
) -> dict[str, Any]:
    generation_cid = require_generation_cid(generation_cid_raw, f"{label}_cid")
    store = require_canonical_absolute(
        package_root / GENERATION_STORE, f"{label}_store"
    )
    store_info = require_real_directory(store, f"{label}_store")
    objects = require_canonical_absolute(
        store / GENERATION_OBJECTS, f"{label}_objects"
    )
    objects_info = require_real_directory(objects, f"{label}_objects")
    for info, identity_label in (
        (store_info, f"{label}_store"),
        (objects_info, f"{label}_objects"),
    ):
        if info.st_uid != os.geteuid() or info.st_mode & 0o077:
            fail(f"{identity_label}_ownership_or_mode_invalid")
    object_name = generation_cid
    if staging_name is not None:
        object_name = require_generation_staging_name(
            staging_name, f"{label}_staging_name"
        )
    generation_root = require_canonical_absolute(
        objects / object_name,
        f"{label}_root",
    )
    generation_info = require_real_directory(
        generation_root, f"{label}_root"
    )
    if (
        generation_info.st_uid != os.geteuid()
        or generation_info.st_mode & 0o277
        or generation_info.st_mode & 0o700 != 0o500
    ):
        fail(f"{label}_root_not_sealed")
    generation_manifest_path = generation_root / "generation-manifest.json"
    generation_raw, generation_file = stable_file_bytes(
        generation_manifest_path,
        f"{label}_manifest",
        16 * 1024 * 1024,
    )
    if (
        generation_file["sha256"] != generation_cid
        or generation_file["identity"]["uid"] != os.geteuid()
        or generation_file["identity"]["mode"] & 0o777 != 0o400
    ):
        fail(f"{label}_manifest_identity_invalid")
    generation = parse_canonical_json(generation_raw, f"{label}_manifest")
    if list(generation) != [
        "build_execution",
        "guard_parent_proof",
        "inputs",
        "inputs_before_after_equal",
        "legacy_directories_authority",
        "outputs",
        "schema",
        "tsc_file_list",
    ]:
        fail(f"{label}_manifest_fields_invalid")
    if (
        generation.get("schema") != GENERATION_SCHEMA
        or generation.get("inputs_before_after_equal") is not True
        or generation.get("legacy_directories_authority") != "none"
    ):
        fail(f"{label}_manifest_schema_invalid")
    proof = generation.get("guard_parent_proof")
    proof_keys = [
        "limit_bytes",
        "monitor_pid",
        "monitor_start_tvsec",
        "monitor_start_tvusec",
        "proof_record_sha256",
        "root_pgid",
        "root_pid",
        "root_ppid",
        "root_sid",
        "root_start_tvsec",
        "root_start_tvusec",
    ]
    if not isinstance(proof, dict) or list(proof) != proof_keys:
        fail(f"{label}_guard_parent_proof_fields_invalid")
    for key in proof_keys:
        value = proof[key]
        if key == "proof_record_sha256":
            if (
                not isinstance(value, str)
                or len(value) != 64
                or any(character not in "0123456789abcdef" for character in value)
            ):
                fail(f"{label}_guard_parent_proof_sha256_invalid")
        elif type(value) is not int or value <= 0:
            fail(f"{label}_guard_parent_proof_numeric_invalid:{key}")
    outputs = verify_output_pair(
        generation_root,
        label,
        require_sealed=True,
    )
    if generation.get("outputs") != output_manifest_fields(outputs):
        fail(f"{label}_output_binding_mismatch")
    store_after = os.stat(store, follow_symlinks=False)
    objects_after = os.stat(objects, follow_symlinks=False)
    generation_after = os.stat(generation_root, follow_symlinks=False)
    if (
        not identities_equal(store_info, store_after)
        or not identities_equal(objects_info, objects_after)
        or not identities_equal(generation_info, generation_after)
    ):
        fail(f"{label}_directory_identity_drifted")
    return {
        "generation": generation,
        "generation_cid": generation_cid,
        "generation_identity": stat_identity(generation_after),
        "generation_manifest_sha256": generation_file["sha256"],
        "generation_manifest_identity": generation_file["identity"],
        "objects_identity": stat_identity(objects_after),
        "outputs": outputs,
        "store_identity": stat_identity(store_after),
    }


def load_current_generation(package_root: pathlib.Path) -> dict[str, Any]:
    store = require_canonical_absolute(
        package_root / GENERATION_STORE, "current_generation_store"
    )
    pointer_path = store / GENERATION_CURRENT
    pointer_raw, pointer_file = stable_file_bytes(
        pointer_path, "current_generation_pointer", 4096
    )
    if (
        pointer_file["identity"]["uid"] != os.geteuid()
        or pointer_file["identity"]["mode"] & 0o777 != 0o400
    ):
        fail("current_generation_pointer_not_sealed")
    pointer = parse_canonical_json(pointer_raw, "current_generation_pointer")
    if list(pointer) != ["generation_cid", "schema"] or pointer["schema"] != POINTER_SCHEMA:
        fail("current_generation_pointer_fields_invalid")
    loaded = load_generation_object(
        package_root, pointer["generation_cid"], "current_generation"
    )
    pointer_raw_after, pointer_file_after = stable_file_bytes(
        pointer_path, "current_generation_pointer_after", 4096
    )
    if pointer_raw_after != pointer_raw or pointer_file_after != pointer_file:
        fail("current_generation_pointer_changed_during_read")
    if (
        loaded["store_identity"]
        != stat_identity(os.stat(store, follow_symlinks=False))
        or loaded["objects_identity"]
        != stat_identity(
            os.stat(store / GENERATION_OBJECTS, follow_symlinks=False)
        )
    ):
        fail("current_generation_store_identity_drifted")
    return dict(
        loaded,
        pointer_identity=pointer_file["identity"],
        pointer_sha256=pointer_file["sha256"],
    )


def validate_current_generation_provenance(
    current: dict[str, Any], inputs: dict[str, Any]
) -> None:
    generation = current["generation"]
    public_inputs = public_input_snapshot(inputs)
    if generation.get("inputs") != public_inputs:
        fail("current_generation_input_binding_mismatch")
    proof = generation.get("guard_parent_proof")
    if not isinstance(proof, dict) or proof.get("limit_bytes") != 1073741824:
        fail("current_generation_guard_limit_invalid")
    execution = generation.get("build_execution")
    if not isinstance(execution, dict):
        fail("current_generation_build_execution_missing")
    events = execution.get("events")
    if not isinstance(events, list) or [event.get("label") for event in events] != [
        "tsc_file_list",
        "tsc_emit",
        "freeze",
    ]:
        fail("current_generation_build_execution_sequence_invalid")
    if execution_receipt(events) != execution:
        fail("current_generation_build_execution_chain_invalid")
    for index, event in enumerate(events):
        if (
            event.get("ordinal") != index
            or event.get("return_code") != 0
            or not isinstance(event.get("pid"), int)
            or event["pid"] <= 1
            or event.get("stderr") != "guard_inherited_visible"
            or event.get("stdout")
            != ("guard_tee_visible" if index == 0 else "guard_inherited_visible")
        ):
            fail(f"current_generation_build_execution_event_invalid:{index}")
    file_list = generation.get("tsc_file_list")
    if not isinstance(file_list, dict) or list(file_list) != [
        "file_count",
        "root",
        "source_file_count",
    ]:
        fail("current_generation_tsc_file_list_fields_invalid")
    if (
        type(file_list["file_count"]) is not int
        or file_list["file_count"] <= 0
        or type(file_list["source_file_count"]) is not int
        or file_list["source_file_count"] <= 0
        or file_list["source_file_count"] > file_list["file_count"]
        or not isinstance(file_list["root"], str)
        or len(file_list["root"]) != 64
        or any(character not in "0123456789abcdef" for character in file_list["root"])
    ):
        fail("current_generation_tsc_file_list_invalid")


def validate_production_package_entry(package_root: pathlib.Path) -> None:
    raw, _ = stable_file_bytes(
        package_root / "package.json", "production_package_json", 1024 * 1024
    )
    try:
        package = json.loads(raw.decode("utf-8", "strict"))
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"production_package_json_invalid:{type(error).__name__}")
    if not isinstance(package, dict):
        fail("production_package_json_root_invalid")
    binary = package.get("bin")
    scripts = package.get("scripts")
    if (
        not isinstance(binary, dict)
        or list(binary) != ["ts-csg"]
        or binary["ts-csg"] != "scripts/" + GENERATION_CLI
    ):
        fail("production_package_bin_not_generation_authority")
    if not isinstance(scripts, dict) or scripts.get("extract") != (
        "scripts/" + GENERATION_CLI
    ):
        fail("production_package_extract_not_generation_authority")


def execute_current_generation_cli(
    source_path_raw: str,
    expected: dict[str, str],
    cli_arguments: list[str],
) -> int:
    source_path, repo_root, package_root = source_binding(source_path_raw)
    validate_production_package_entry(package_root)
    inputs_before = input_snapshot(source_path, repo_root, package_root, expected)
    current_before = load_current_generation(package_root)
    validate_current_generation_provenance(current_before, inputs_before)

    generation_root = require_canonical_absolute(
        package_root
        / GENERATION_STORE
        / GENERATION_OBJECTS
        / current_before["generation_cid"],
        "production_generation_root",
    )
    cli_path = require_canonical_absolute(
        generation_root / "dist/cli.js", "production_generation_cli"
    )
    cli_before = stable_file(cli_path, "production_generation_cli")
    if (
        cli_before["identity"]["uid"] != os.geteuid()
        or cli_before["identity"]["mode"] & 0o777 != 0o400
    ):
        fail("production_generation_cli_not_sealed")
    cwd = require_canonical_absolute(pathlib.Path(os.getcwd()), "production_cli_cwd")
    cwd_before = require_real_directory(cwd, "production_cli_cwd")

    inputs_pre_exec = input_snapshot(source_path, repo_root, package_root, expected)
    assert_input_snapshot_equal(inputs_before, inputs_pre_exec)
    current_pre_exec = load_current_generation(package_root)
    if current_pre_exec != current_before:
        fail("current_generation_changed_before_execution")
    cli_pre_exec = stable_file(cli_path, "production_generation_cli_pre_exec")
    if cli_pre_exec != cli_before:
        fail("production_generation_cli_changed_before_execution")

    process: subprocess.Popen[bytes] | None = None
    return_code: int | None = None
    execution_error: BaseException | None = None
    try:
        process = subprocess.Popen(
            [os.fspath(node_binary_path()), os.fspath(cli_path), *cli_arguments],
            cwd=os.fspath(cwd),
            env=exact_child_environment(package_root),
            close_fds=True,
        )
        return_code = process.wait()
    except BaseException as error:
        execution_error = error
        if process is not None and process.poll() is None:
            process.kill()
            process.wait()

    inputs_after = input_snapshot(source_path, repo_root, package_root, expected)
    assert_input_snapshot_equal(inputs_before, inputs_after)
    current_after = load_current_generation(package_root)
    if current_after != current_before:
        fail("current_generation_changed_during_execution")
    cli_after = stable_file(cli_path, "production_generation_cli_after")
    if cli_after != cli_before:
        fail("production_generation_cli_changed_during_execution")
    cwd_after = os.stat(cwd, follow_symlinks=False)
    if not same_directory_identity(cwd_before, cwd_after):
        fail("production_cli_cwd_identity_drifted")
    if execution_error is not None:
        fail(f"production_generation_cli_spawn_failed:{type(execution_error).__name__}")
    if return_code is None:
        fail("production_generation_cli_return_code_missing")
    if return_code < 0:
        return 128 + abs(return_code)
    return return_code


def audit(
    source_path_raw: str, expected: dict[str, str]
) -> tuple[pathlib.Path, pathlib.Path, dict[str, Any], dict[str, Any]]:
    source_path, repo_root, package_root = source_binding(source_path_raw)
    validate_production_package_entry(package_root)
    inputs = input_snapshot(source_path, repo_root, package_root, expected)
    store = package_root / GENERATION_STORE
    current_path = store / GENERATION_CURRENT
    activation = {
        "current_generation": "absent",
        "module_consumers": "HARD_RED:legacy_root_dist",
        "production_activation": "RED:no_current_generation",
    }
    if os.path.lexists(store):
        store_info = require_real_directory(store, "audit_generation_store")
        if store_info.st_uid != os.geteuid() or store_info.st_mode & 0o077:
            fail("audit_generation_store_ownership_or_mode_invalid")
    if os.path.lexists(current_path):
        current = load_current_generation(package_root)
        validate_current_generation_provenance(current, inputs)
        activation = {
            "current_generation": current["generation_cid"],
            "module_consumers": "HARD_RED:legacy_root_dist",
            "production_activation": "RED:module_consumers_unbound",
        }
    return repo_root, package_root, inputs, activation


def build_and_publish(
    source_path_raw: str,
    expected: dict[str, str],
    manifest_fd_path: str,
) -> None:
    guard_parent_proof = require_guard_context()
    source_path, repo_root, package_root = source_binding(source_path_raw)
    inputs_before = input_snapshot(source_path, repo_root, package_root, expected)
    environment = exact_child_environment(package_root)
    (
        store,
        objects,
        store_descriptor,
        objects_descriptor,
        lock_descriptor,
    ) = acquire_generation_store(package_root)
    if os.path.lexists(store / GENERATION_CURRENT):
        load_current_generation(package_root)
    candidate_root: pathlib.Path | None = None
    generation_stage: pathlib.Path | None = None
    events: list[dict[str, Any]] = []
    try:
        candidate_root = pathlib.Path(
            tempfile.mkdtemp(prefix=".csg-ts-source-freeze-candidate.", dir=package_root)
        )
        fsync_directory(package_root)
        (
            private_package,
            private_output,
            private_node,
            private_atomic_helper,
        ) = create_private_build_snapshot(candidate_root, package_root, inputs_before)
        inputs_after_snapshot = input_snapshot(
            source_path, repo_root, package_root, expected
        )
        assert_input_snapshot_equal(inputs_before, inputs_after_snapshot)
        private_tsc = private_package / "node_modules/typescript/bin/tsc"
        private_tsconfig = private_package / "tsconfig.json"
        private_sources = private_package / "src"
        private_node_modules = private_package / "node_modules"
        candidate_active = private_output / "dist"
