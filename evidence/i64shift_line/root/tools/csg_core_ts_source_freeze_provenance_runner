def public_input_snapshot(snapshot: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in snapshot.items() if key != "_material"}


def manifest_tree_rows(snapshot: dict[str, Any]) -> tuple[list[str], list[dict[str, Any]]]:
    directories = [item["path"] for item in snapshot["directories"]]
    files = [
        {key: item[key] for key in ("path", "size", "sha256")}
        for item in snapshot["files"]
    ]
    return directories, files


def validate_freeze_manifest(
    path: pathlib.Path, active: dict[str, Any]
) -> str:
    raw, raw_entry = stable_file_bytes(path, "freeze_manifest", 64 * 1024 * 1024)
    try:
        manifest = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"freeze_manifest_invalid:{type(error).__name__}")
    if list(manifest) != [
        "schema",
        "source_root",
        "target_root",
        "directories",
        "file_count",
        "files",
    ]:
        fail("freeze_manifest_fields_invalid")
    directories, files = manifest_tree_rows(active)
    if (
        manifest["schema"] != "ts_csg_dist_freeze"
        or manifest["source_root"] != "dist"
        or manifest["target_root"] != "dist-frozen"
        or manifest["directories"] != directories
        or manifest["file_count"] != len(files)
        or manifest["files"] != files
    ):
        fail("freeze_manifest_bytes_binding_invalid")
    if not raw.endswith(b"\n"):
        fail("freeze_manifest_final_lf_missing")
    return raw_entry["sha256"]


def require_snapshot_sealed(snapshot: dict[str, Any], label: str) -> None:
    for item in snapshot["directories"]:
        if item["identity"]["mode"] & 0o222:
            fail(f"{label}_directory_writable:{item['path']}")
    for item in snapshot["files"]:
        if item["identity"]["mode"] & 0o222:
            fail(f"{label}_file_writable:{item['path']}")
    if snapshot["root_identity"]["mode"] & 0o222:
        fail(f"{label}_root_writable")


def verify_output_pair(
    output_root: pathlib.Path,
    label: str,
    *,
    require_sealed: bool = False,
) -> dict[str, Any]:
    active_root = require_canonical_absolute(output_root / "dist", f"{label}_active")
    frozen_root = require_canonical_absolute(
        output_root / "dist-frozen", f"{label}_frozen"
    )
    active_info = require_real_directory(active_root, f"{label}_active")
    frozen_info = require_real_directory(frozen_root, f"{label}_frozen")
    if active_info.st_dev == frozen_info.st_dev and active_info.st_ino == frozen_info.st_ino:
        fail("active_frozen_root_identity_shared")
    active = tree_snapshot(active_root, f"{label}_active")
    frozen = tree_snapshot(
        frozen_root,
        f"{label}_frozen",
        exclude_names=frozenset({FREEZE_MANIFEST}),
    )
    if require_sealed:
        require_snapshot_sealed(active, f"{label}_active")
        require_snapshot_sealed(frozen, f"{label}_frozen")
    active_dirs, active_files = manifest_tree_rows(active)
    frozen_dirs, frozen_files = manifest_tree_rows(frozen)
    if active_dirs != frozen_dirs or active_files != frozen_files:
        fail("active_frozen_bytes_mismatch")
    active_identity = {
        item["path"]: (item["identity"]["device"], item["identity"]["inode"])
        for item in active["files"]
    }
    for item in frozen["files"]:
        identity = (item["identity"]["device"], item["identity"]["inode"])
        if active_identity.get(item["path"]) == identity:
            fail(f"active_frozen_file_identity_shared:{item['path']}")
    freeze_manifest_sha256 = validate_freeze_manifest(
        frozen_root / FREEZE_MANIFEST, active
    )
    if require_sealed:
        freeze_manifest_entry = stable_file(
            frozen_root / FREEZE_MANIFEST, f"{label}_freeze_manifest_sealed"
        )
        if freeze_manifest_entry["identity"]["mode"] & 0o222:
            fail(f"{label}_freeze_manifest_writable")
    return {
        "active_bytes_root": active["bytes_root"],
        "active_identity_root": active["identity_root"],
        "frozen_bytes_root": frozen["bytes_root"],
        "frozen_identity_root": frozen["identity_root"],
        "file_count": active["file_count"],
        "freeze_manifest_sha256": freeze_manifest_sha256,
    }


