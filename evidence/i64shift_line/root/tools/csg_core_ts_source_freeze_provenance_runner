        "node": node_binary_path(),
        "package_json": package_root / "package.json",
        "package_lock": package_root / "package-lock.json",
        "runner": source_path,
        "tsc": tsc_path,
        "tsconfig": package_root / "tsconfig.json",
    }
    files = {label: stable_file(path, label) for label, path in fixed_paths.items()}
    files["atomic_python"] = stable_system_executable(
        ATOMIC_PYTHON_BIN, "atomic_python"
    )
    files["python"] = stable_system_executable(PYTHON_BIN, "python")
    require_expected(
        files["atomic_python"]["sha256"],
        expected["atomic_python_sha256"],
        "atomic_python",
    )
    require_expected(files["atomic"]["sha256"], expected["atomic_sha256"], "atomic")
    require_expected(files["freeze"]["sha256"], expected["freeze_sha256"], "freeze")
    require_expected(
        files["generation_cli"]["sha256"],
        expected["generation_cli_sha256"],
        "generation_cli",
    )
    require_expected(
        files["guard_runtime"]["sha256"],
        expected["guard_runtime_sha256"],
        "guard_runtime",
    )
    require_expected(files["guard"]["sha256"], expected["guard_sha256"], "guard")
    require_expected(files["node"]["sha256"], expected["node_sha256"], "node")
    require_expected(files["python"]["sha256"], expected["python_sha256"], "python")
    require_expected(files["runner"]["sha256"], expected["runner_sha256"], "runner")
    require_expected(files["tsc"]["sha256"], expected["tsc_sha256"], "tsc")

    sources = tree_snapshot(package_root / "src", "typescript_sources")
    node_modules = tree_snapshot(
        package_root / "node_modules",
        "node_modules",
        allow_internal_symlinks=True,
    )
    typescript = tree_snapshot(
        package_root / "node_modules/typescript", "typescript_toolchain"
    )
    require_expected(
        node_modules["bytes_root"],
        expected["node_modules_tree_sha256"],
        "node_modules_tree",
    )
    require_expected(
        typescript["bytes_root"],
        expected["typescript_tree_sha256"],
        "typescript_tree",
    )
    validate_package_lock(package_root)
    validate_tsconfig_contract(package_root)

    byte_rows: list[tuple[str, bytes]] = []
    identity_rows: list[tuple[str, bytes]] = []
    for label in sorted(files):
        byte_rows.append((label, files[label]["sha256"].encode("ascii")))
        identity_rows.append(
            (
                label,
                json.dumps(files[label], sort_keys=True, separators=(",", ":")).encode("utf-8"),
            )
        )
    for label, tree in (
        ("node_modules", node_modules),
        ("typescript_sources", sources),
        ("typescript_toolchain", typescript),
    ):
        byte_rows.append((label, tree["bytes_root"].encode("ascii")))
        identity_rows.append((label, tree["identity_root"].encode("ascii")))
    return {
        "bytes_root": framed_digest(f"{SCHEMA}.inputs.bytes", byte_rows),
        "identity_root": framed_digest(f"{SCHEMA}.inputs.identity", identity_rows),
        "source_file_count": sources["file_count"],
        "node_modules_file_count": node_modules["file_count"],
        "toolchain": {
            "node_sha256": files["node"]["sha256"],
            "python_sha256": files["python"]["sha256"],
            "tsc_sha256": files["tsc"]["sha256"],
            "typescript_tree_sha256": typescript["bytes_root"],
            "node_modules_tree_sha256": node_modules["bytes_root"],
            "freeze_sha256": files["freeze"]["sha256"],
            "generation_cli_sha256": files["generation_cli"]["sha256"],
            "gate_sha256": files["gate"]["sha256"],
            "atomic_sha256": files["atomic"]["sha256"],
            "guard_sha256": files["guard"]["sha256"],
            "guard_runtime_sha256": files["guard_runtime"]["sha256"],
            "runner_sha256": files["runner"]["sha256"],
        },
        "_material": {
            "files": files,
            "node_modules": node_modules,
            "sources": sources,
            "typescript": typescript,
        },
    }


def assert_input_snapshot_equal(before: dict[str, Any], after: dict[str, Any]) -> None:
