#!/usr/bin/env python3
"""Validate official source authority and rebuild it without child processes."""

import argparse
import hashlib
import os
import pathlib
import runpy
import stat
import struct


def fail(message: str) -> "NoReturn":
    raise SystemExit("riscv_isa_formal_source_manifest_error=" + message)


def stable_bytes(path: pathlib.Path) -> bytes:
    path_text = str(path)
    if (
        not path.is_absolute()
        or os.path.normpath(path_text) != path_text
        or os.path.realpath(path_text) != path_text
    ):
        fail("input_not_canonical:" + path_text)
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    before = path.lstat()
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_nlink != 1
    ):
        fail("input_not_regular:" + str(path))
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if (
            before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
            before.st_uid, before.st_gid, before.st_size,
            before.st_mtime_ns, before.st_ctime_ns,
        ) != (
            opened.st_dev, opened.st_ino, opened.st_mode, opened.st_nlink,
            opened.st_uid, opened.st_gid, opened.st_size,
            opened.st_mtime_ns, opened.st_ctime_ns,
        ):
            fail("input_changed_before_read:" + str(path))
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    named = path.lstat()
    if (
        opened.st_dev, opened.st_ino, opened.st_mode, opened.st_nlink,
        opened.st_uid, opened.st_gid, opened.st_size,
        opened.st_mtime_ns, opened.st_ctime_ns,
    ) != (
        after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
        after.st_uid, after.st_gid, after.st_size,
        after.st_mtime_ns, after.st_ctime_ns,
    ) or (
        after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
        after.st_uid, after.st_gid, after.st_size,
        after.st_mtime_ns, after.st_ctime_ns,
    ) != (
        named.st_dev, named.st_ino, named.st_mode, named.st_nlink,
        named.st_uid, named.st_gid, named.st_size,
        named.st_mtime_ns, named.st_ctime_ns,
    ):
        fail("input_changed_during_read:" + str(path))
    return b"".join(chunks)


def stable_expected_bytes(path_text: str, expected_sha256: str) -> bytes:
    if (
        len(expected_sha256) != 64
        or any(character not in "0123456789abcdef" for character in expected_sha256)
    ):
        fail("enumeration_sha256_invalid")
    raw = stable_bytes(pathlib.Path(path_text))
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        fail("enumeration_sha256_mismatch")
    return raw


def require_same_execution_evidence(
    external_path: pathlib.Path,
    expected_external_path: pathlib.Path,
    frozen_path: pathlib.Path,
) -> None:
    if external_path != expected_external_path:
        fail("execution_evidence_path_mismatch")
    if stable_bytes(external_path) != stable_bytes(frozen_path):
        fail("execution_evidence_bytes_mismatch")


def parse_template(raw: bytes, module: dict) -> tuple[bytes, list[bytes], list[tuple[bytes, bool]]]:
    module["content_cid_from_manifest"](raw)
    lines = raw.splitlines(keepends=True)
    head = lines[1][len(b"head="):-1]
    scope_count = int(lines[2][len(b"scope_count="):-1])
    scopes = [
        bytes.fromhex(row[len(b"scope="):-1].decode("ascii"))
        for row in lines[3:3 + scope_count]
    ]
    count_index = 3 + scope_count
    members: list[tuple[bytes, bool]] = []
    prior = b""
    for row in lines[count_index + 2:]:
        columns = row.rstrip(b"\n").split(b"\t")
        relative = bytes.fromhex(columns[0].decode("ascii"))
        if relative <= prior:
            fail("template_member_order_invalid")
        prior = relative
        if len(columns) == 2:
            if columns[1] != b"tracked_deleted":
                fail("template_deleted_state_invalid")
            tracked = True
        elif len(columns) == 9 and columns[1] in (b"tracked", b"untracked"):
            tracked = columns[1] == b"tracked"
        else:
            fail("template_member_shape_invalid")
        members.append((relative, tracked))
    return head, scopes, members


def verified_enumeration(
    *,
    head_raw: bytes,
    tracked_raw: bytes,
    untracked_raw: bytes,
    template_head: bytes,
    template_members: list[tuple[bytes, bool]],
    module: dict,
) -> list[tuple[bytes, bool]]:
    if not head_raw.endswith(b"\n") or head_raw.count(b"\n") != 1:
        fail("enumerated_head_shape_invalid")
    enumerated_head = head_raw[:-1]
    if enumerated_head != template_head:
        fail("enumerated_head_identity_mismatch")
    tracked = module["parse_path_stream"](tracked_raw)
    untracked = module["parse_path_stream"](untracked_raw)
    tracked_set = frozenset(tracked)
    if any(relative in tracked_set for relative in untracked):
        fail("enumeration_tracked_untracked_overlap")
    actual = sorted(
        [(relative, True) for relative in tracked]
        + [(relative, False) for relative in untracked]
    )
    if actual != template_members:
        fail("enumeration_member_set_mismatch")
    return actual


def current_head(root: pathlib.Path) -> bytes:
    git = root / ".git"
    if git.is_file():
        row = stable_bytes(git).decode("utf-8", "strict").strip()
        if not row.startswith("gitdir: "):
            fail("gitdir_file_invalid")
        git = pathlib.Path(row[len("gitdir: "):])
        if not git.is_absolute():
            git = (root / git).resolve(strict=True)
    head = stable_bytes(git / "HEAD").strip()
    if head.startswith(b"ref: "):
        relative = head[len(b"ref: "):].decode("ascii", "strict")
        if relative.startswith("/") or ".." in pathlib.PurePosixPath(relative).parts:
            fail("git_head_ref_invalid")
        head = stable_bytes(git / pathlib.PurePosixPath(relative)).strip()
    if len(head) != 40 or any(byte not in b"0123456789abcdef" for byte in head):
        fail("git_head_identity_invalid")
    return head


def write_fd(path: str, payload: bytes) -> None:
    if not path.startswith("/dev/fd/") or not path[len("/dev/fd/"):].isdigit():
        fail("output_not_fd")
    descriptor = int(path[len("/dev/fd/"):])
    if descriptor < 10 or descriptor > 63:
        fail("output_fd_invalid")
    offset = 0
    while offset < len(payload):
        written = os.write(descriptor, payload[offset:])
        if written <= 0:
            fail("output_short_write")
        offset += written
    os.fsync(descriptor)


def build_source_archive(root: pathlib.Path, manifest_raw: bytes) -> bytes:
    lines = manifest_raw.splitlines()
    scope_count = int(lines[2][len(b"scope_count="):])
    member_rows = lines[5 + scope_count:]
    entries: list[tuple[bytes, int, bytes]] = []
    for row in member_rows:
        columns = row.split(b"\t")
        relative = bytes.fromhex(columns[0].decode("ascii"))
        if len(columns) == 2:
            if columns[1] != b"tracked_deleted":
                fail("archive_deleted_row_invalid")
            continue
        if len(columns) != 9:
            fail("archive_member_row_invalid")
        path = root / os.fsdecode(relative)
        info = path.lstat()
        raw = stable_bytes(path)
        expected_sha256 = columns[2].decode("ascii")
        expected_mode = int(columns[5])
        expected_size = int(columns[6])
        if (
            hashlib.sha256(raw).hexdigest() != expected_sha256
            or info.st_mode != expected_mode
            or len(raw) != expected_size
        ):
            fail("archive_member_identity_mismatch")
        entries.append((relative, 1 if info.st_mode & 0o111 else 0, raw))
    payload = bytearray(b"cheng.riscv_isa.source_archive.v1\0")
    payload.extend(struct.pack(">I", len(entries)))
    for relative, executable, raw in entries:
        payload.extend(struct.pack(">I", len(relative)))
        payload.extend(relative)
        payload.extend(struct.pack(">BQ", executable, len(raw)))
        payload.extend(hashlib.sha256(raw).digest())
        payload.extend(raw)
        if len(payload) > 1073741824 - 32:
            fail("source_archive_exceeds_1gib")
    payload.extend(hashlib.sha256(payload).digest())
    return bytes(payload)


def rebuild_manifest(
    root: pathlib.Path,
    template_raw: bytes,
    module: dict,
    head_raw: bytes,
    tracked_raw: bytes,
    untracked_raw: bytes,
) -> bytes:
    head, scopes, members = parse_template(template_raw, module)
    if scopes != [b"src"]:
        fail("official_scope_not_exact_src")
    members = verified_enumeration(
        head_raw=head_raw,
        tracked_raw=tracked_raw,
        untracked_raw=untracked_raw,
        template_head=head,
        template_members=members,
        module=module,
    )
    if current_head(root) != head:
        fail("head_identity_mismatch")
    rows: list[bytes] = []
    deleted: list[bytes] = []
    root_bytes = os.fsencode(str(root))
    for relative, tracked in members:
        row, was_deleted = module["stable_file_row"](
            root_bytes, relative, tracked
        )
        rows.append(row)
        if was_deleted:
            deleted.append(relative)
    if current_head(root) != head:
        fail("source_changed_during_manifest")
    for relative in deleted:
        if (root / os.fsdecode(relative)).exists():
            fail("deleted_member_appeared")
    payload = bytearray(b"schema=cheng.current_source_closure_manifest\n")
    payload.extend(b"head=" + head + b"\n")
    payload.extend(b"scope_count=" + str(len(scopes)).encode("ascii") + b"\n")
    for scope in scopes:
        payload.extend(b"scope=" + scope.hex().encode("ascii") + b"\n")
    payload.extend(b"path_count=" + str(len(members)).encode("ascii") + b"\n")
    payload.extend(
        b"content_cid="
        + module["content_cid"](head, scopes, rows).encode("ascii")
        + b"\n"
    )
    for row in rows:
        payload.extend(row)
    module["content_cid_from_manifest"](bytes(payload))
    return bytes(payload)


def validate_official_authority(
    *,
    receipt_path: pathlib.Path,
    expected_compiler_sha256: str,
    root: pathlib.Path,
    manifest_module: dict,
    head_raw: bytes,
    tracked_raw: bytes,
    untracked_raw: bytes,
    build_validator_path: str,
    publisher_validator_path: str,
) -> bytes:
    if (
        len(expected_compiler_sha256) != 64
        or any(character not in "0123456789abcdef" for character in expected_compiler_sha256)
    ):
        fail("expected_compiler_sha256_invalid")
    publisher = runpy.run_path(
        publisher_validator_path,
        run_name="cheng_official_publisher_validator",
    )
    official = runpy.run_path(
        build_validator_path,
        run_name="cheng_official_build_validator",
    )
    official["ROOT"] = root
    official["OFFICIAL"] = root / "artifacts/backend_driver/cheng"
    official["OFFICIAL_EVIDENCE"] = (
        root / "tools/backend2_current_source_official_evidence"
    )
    receipt_state = official["stable_read"](
        receipt_path, "official_build_receipt"
    )
    receipt_rows = official["parse_rows"](
        receipt_state, "official_build_receipt"
    )
    official["validate_payload_hash"](
        receipt_state,
        receipt_rows,
        "receipt_payload_sha256",
        "official_build_receipt",
    )
    if tuple(receipt_rows) != official["OFFICIAL_BUILD_RECEIPT_KEYS"]:
        fail("official_receipt_key_set_invalid")
    if receipt_rows.get("official_sha256") != expected_compiler_sha256:
        fail("official_compiler_sha256_mismatch")
    before_path = pathlib.Path(
        os.fsdecode(
            bytes.fromhex(receipt_rows["source_manifest_before_path_fshex"])
        )
    )
    after_path = pathlib.Path(
        os.fsdecode(
            bytes.fromhex(receipt_rows["source_manifest_after_path_fshex"])
        )
    )
    template_raw = stable_bytes(before_path)
    after_raw = stable_bytes(after_path)
    expected_manifest_sha256 = receipt_rows.get("source_manifest_sha256", "")
    if (
        after_raw != template_raw
        or hashlib.sha256(template_raw).hexdigest()
        != expected_manifest_sha256
    ):
        fail("official_manifest_template_identity_mismatch")
    rebuilt_raw = rebuild_manifest(
        root,
        template_raw,
        manifest_module,
        head_raw,
        tracked_raw,
        untracked_raw,
    )

    def manifest_without_child_processes(
        requested_root: str, requested_scopes: list[str]
    ) -> bytes:
        if pathlib.Path(requested_root) != root:
            fail("validator_requested_root_mismatch")
        del requested_scopes
        return rebuilt_raw

    official["closure"].build_manifest = manifest_without_child_processes

    def validate_publisher_without_child_processes(
        path: pathlib.Path,
    ) -> dict[str, str]:
        publisher["validate"]([str(path)])
        state = official["stable_read"](path, "official_publisher_receipt")
        return official["parse_rows"](state, "official_publisher_receipt")

    official["validate_official_receipt"] = (
        validate_publisher_without_child_processes
    )

    class CompletedValidation:
        returncode = 0
        stdout = b""
        stderr = b""

    class InProcessSubprocess:
        PIPE = object()

        @staticmethod
        def run(arguments, *, stdout, stderr, check):
            if (
                stdout is not InProcessSubprocess.PIPE
                or stderr is not InProcessSubprocess.PIPE
                or check is not False
                or len(arguments) != 7
                or arguments[1] != "validate-execution"
            ):
                fail("unexpected_subprocess_boundary")
            external_path = pathlib.Path(arguments[0])
            require_same_execution_evidence(
                external_path,
                official["OFFICIAL_EVIDENCE"],
                pathlib.Path(publisher_validator_path),
            )
            publisher["validate_execution"](arguments[2:])
            return CompletedValidation()

    official["subprocess"] = InProcessSubprocess()
    rows = official["validate_final"](receipt_path)
    if rows != receipt_rows:
        fail("official_receipt_changed_during_validation")
    if rows.get("official_sha256") != expected_compiler_sha256:
        fail("official_compiler_sha256_mismatch")
    if hashlib.sha256(template_raw).hexdigest() != expected_manifest_sha256:
        fail("embedded_template_sha256_mismatch")
    before_raw = stable_bytes(before_path)
    after_raw = stable_bytes(after_path)
    if before_raw != template_raw or after_raw != template_raw:
        fail("official_manifest_template_identity_mismatch")
    if rebuilt_raw != template_raw:
        fail("live_source_manifest_mismatch")
    return rebuilt_raw


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--module", required=True)
    parser.add_argument("--official-build-validator", required=True)
    parser.add_argument("--official-publisher-validator", required=True)
    parser.add_argument("--receipt", required=True)
    parser.add_argument("--expected-compiler-sha256", required=True)
    parser.add_argument("--enumerated-head", required=True)
    parser.add_argument("--enumerated-head-sha256", required=True)
    parser.add_argument("--enumerated-tracked", required=True)
    parser.add_argument("--enumerated-tracked-sha256", required=True)
    parser.add_argument("--enumerated-untracked", required=True)
    parser.add_argument("--enumerated-untracked-sha256", required=True)
    parser.add_argument("--root", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--archive-output", required=True)
    args = parser.parse_args()
    root = pathlib.Path(args.root)
    if not root.is_absolute() or os.path.realpath(args.root) != args.root:
        fail("root_not_canonical")
    module = runpy.run_path(args.module, run_name="cheng_source_manifest_module")
    head_raw = stable_expected_bytes(
        args.enumerated_head, args.enumerated_head_sha256
    )
    tracked_raw = stable_expected_bytes(
        args.enumerated_tracked, args.enumerated_tracked_sha256
    )
    untracked_raw = stable_expected_bytes(
        args.enumerated_untracked, args.enumerated_untracked_sha256
    )
    rebuilt_raw = validate_official_authority(
        receipt_path=pathlib.Path(args.receipt),
        expected_compiler_sha256=args.expected_compiler_sha256,
        root=root,
        manifest_module=module,
        head_raw=head_raw,
        tracked_raw=tracked_raw,
        untracked_raw=untracked_raw,
        build_validator_path=args.official_build_validator,
        publisher_validator_path=args.official_publisher_validator,
    )
    write_fd(args.output, rebuilt_raw)
    write_fd(args.archive_output, build_source_archive(root, rebuilt_raw))
    print("riscv_isa_formal_source_manifest=pass")


if __name__ == "__main__":
    main()
