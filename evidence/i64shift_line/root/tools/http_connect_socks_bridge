#!/usr/bin/env bash
# Build and run the pure Cheng HTTP CONNECT -> SOCKS5 bridge.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/src/apps/vpn_proxy/http_connect_socks_bridge_main.cheng"
SOCKS_SRC="$ROOT/src/apps/vpn_proxy/vpn_proxy_socks.cheng"
IPADDR_SRC="$ROOT/src/std/net/ipaddr.cheng"
BIN="${CHENG_HTTP_CONNECT_SOCKS_BRIDGE_BIN:-$ROOT/artifacts/apps/http-connect-socks-bridge}"
REPORT="${CHENG_HTTP_CONNECT_SOCKS_BRIDGE_REPORT:-$ROOT/.tmp-exec/app-scoped-ai-proxy/http-connect-socks-bridge.report.txt}"
COMPILER="${CHENG_COMPILER:-$ROOT/artifacts/bootstrap/cheng.stage3}"
TARGET="${CHENG_TARGET:-arm64-apple-darwin}"

needs_build=0
if [ ! -x "$BIN" ]; then
    needs_build=1
elif [ "$SRC" -nt "$BIN" ]; then
    needs_build=1
elif [ "$SOCKS_SRC" -nt "$BIN" ]; then
    needs_build=1
elif [ "$IPADDR_SRC" -nt "$BIN" ]; then
    needs_build=1
fi

if [ "$needs_build" = "1" ]; then
    [ -x "$COMPILER" ] || {
        echo "FAIL: missing Cheng compiler: $COMPILER" >&2
        exit 1
    }
    mkdir -p "$(dirname "$BIN")" "$(dirname "$REPORT")"
    TMP_BIN="$BIN.next.$$"
    rm -f "$TMP_BIN"
    "$COMPILER" system-link-exec \
        "--root:$ROOT" \
        "--in:$SRC" \
        --emit:exe \
        "--target:$TARGET" \
        "--out:$TMP_BIN" \
        "--report-out:$REPORT" \
        --link-providers
    chmod +x "$TMP_BIN"
    mv "$TMP_BIN" "$BIN"
fi

exec "$BIN" "$@"
