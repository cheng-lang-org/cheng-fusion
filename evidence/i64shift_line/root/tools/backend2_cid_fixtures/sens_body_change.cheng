# backend2_cid 敏感性矩阵夹具 — 体变更腿: 仅 neighborPure 体 x*3 → x*5。
# 断言: neighborPure cid 变; calleeAdd/callerUse/main cid 不变
# (被调方签名全部未动 → 调用方 ABI 视图不变)。

fn calleeAdd(a: int32, b: int32): int32 =
    return a + b

fn callerUse(x: int32): int32 =
    return calleeAdd(x, 7)

fn neighborPure(x: int32): int32 =
    return x * 5

fn main(): int32 =
    return callerUse(5) + neighborPure(2) - 18
