# backend2_cid 敏感性矩阵夹具 — base 腿。
# 4 函数: calleeAdd (被调方) / callerUse (调用方) / neighborPure (无关邻居) / main。
# 变体腿以同路径覆盖本文件 (sourcePathHash 恒定), 见 tools/backend2_cid_gate.sh。

fn calleeAdd(a: int32, b: int32): int32 =
    return a + b

fn callerUse(x: int32): int32 =
    return calleeAdd(x, 7)

fn neighborPure(x: int32): int32 =
    return x * 3

fn main(): int32 =
    return callerUse(5) + neighborPure(2) - 18
