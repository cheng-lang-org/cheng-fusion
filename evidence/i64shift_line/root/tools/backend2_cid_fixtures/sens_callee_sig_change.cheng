# backend2_cid 敏感性矩阵夹具 — 被调方签名变更腿: calleeAdd 第二参 int32 → int64。
# 断言: calleeAdd cid 变 (自身签名+体变); callerUse cid 变 (经 CalleeAbiView §3.4);
# neighborPure/main cid 不变 (main 的两个直接被调方 callerUse/neighborPure 签名未动)。

fn calleeAdd(a: int32, b: int64): int32 =
    return a + int32(b)

fn callerUse(x: int32): int32 =
    return calleeAdd(x, 7)

fn neighborPure(x: int32): int32 =
    return x * 3

fn main(): int32 =
    return callerUse(5) + neighborPure(2) - 18
