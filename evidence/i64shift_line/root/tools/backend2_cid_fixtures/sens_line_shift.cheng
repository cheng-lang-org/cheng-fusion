# backend2_cid 敏感性矩阵夹具 — 行号漂移腿 (spec §3.2): 顶部多 3 行注释,
# 全部函数体/签名逐字不变, 仅行号整体下移。
# 断言: 全部 4 函数 cid 与 base 腿逐个相等 (sourcePathHash 不含行号)。
# 漂移行 1
# 漂移行 2
# 漂移行 3

fn calleeAdd(a: int32, b: int32): int32 =
    return a + b

fn callerUse(x: int32): int32 =
    return calleeAdd(x, 7)

fn neighborPure(x: int32): int32 =
    return x * 3

fn main(): int32 =
    return callerUse(5) + neighborPure(2) - 18
