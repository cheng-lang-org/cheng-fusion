#!/bin/bash -p
# csg_core_successor_crash_matrix — official successor crash-consistency dynamic matrix.
#
# Caller contract (tools/csg_core_merkle_current_head_dynamic_gate.sh L24-28):
#   invoked with no arguments, CSG_CORE_CHENG_BIN set to the official stage3
#   fixed-point binary; this harness's exit code becomes the gate's verdict.
#
# Crash boundaries and semantic cells are named EXACTLY as pinned by
# tools/csg_core_merkle_transaction_crash_static_gate.sh (required-fixture
# list) and src/tests/csg_core_merkle_successor_crash_fixture.cheng:
#   boundaries: BeforeObjectCommit, AfterObjectCommitBeforeSuccessorRename,
#               AfterSuccessorRenameBeforeParentSync, AfterParentSync
#   semantics:  ExistingSuccessorConflicts, SuccessorConflict, commitRequiresReread,
#               authorityDeletionAllowed(=false)
# Transaction order under test (static gate, provider commit body):
#   object durable write(+fsync) -> successor rename(no-replace commit)
#   -> committed=1 -> root binding double-verify -> parent double fsync;
#   durability-unknown (rc=3) is re-read disambiguated, never guessed.
#
# Output protocol (stdout, one line per cell, then one summary line):
#   MATRIX <cell> <PASS|FAIL|SKIP> <evidence:comma-separated key=value>
#   CRASH_MATRIX_RESULT pass=<n> fail=<n> skip=<n>
#
# Exit-code policy (no fake PASS, SKIP is not PASS):
#   0  every cell PASS (full dynamic completion credit)
#   2  nothing runnable (official stage3 or guard missing): all cells SKIP
#   1  any FAIL, or a partial run (some PASS, some SKIP)
#
# Two-process crash machinery (boundaries):
#   writer process  : compiled from the crash-writer probe (contract below),
#                     started with CSG_SUCCESSOR_CRASH_BOUNDARY=<boundary>;
#                     the harness waits for its PARKED handshake, then kills
#                     it with SIGKILL at the exact boundary.
#   recovery process: compiled from the existing
#                     src/tests/csg_core_merkle_current_head_contract.cheng,
#                     re-opens the store and re-reads to disambiguate
#                     (read-ok / audit-ok / manifest-cid modes).
#
# Crash-writer probe contract (source
# src/tests/csg_core_merkle_successor_crash_writer.cheng, to land as a
# follow-up; until it exists every boundary cell reports SKIP):
#   env in : CSG_SUCCESSOR_CRASH_WRITER_PARENT — store parent directory
#            CSG_SUCCESSOR_CRASH_BOUNDARY     — one boundary name above
#   stdout : first "EXPECT manifest=<cid>" with the content-addressed
#            candidate head manifest CID (known before commit), then at the
#            named boundary "PARKED <boundary>" followed by an immediate
#            self-SIGSTOP; the writer must drive the production
#            csgStoreCommitHeadAtCurrent path and must not spawn children.
#   The harness sends SIGKILL only after PARKED, so the killed syscall is
#   the first syscall of the named boundary.
#
# Boundary verification profiles (derived from the fixture semantics):
#   BeforeObjectCommit / AfterObjectCommitBeforeSuccessorRename
#     predecessor_only        : generation-0 head still readable, full
#                               successor-history audit passes (authority
#                               undeleted), successor never required.
#   AfterSuccessorRenameBeforeParentSync
#     reread_disambiguated    : commitRequiresReread=1; recovery re-reads
#                               twice, both reads must succeed and agree
#                               (durability-unknown disambiguated by read).
#   AfterParentSync
#     successor_must_read     : recovered manifest CID must equal the
#                               writer's EXPECT manifest CID.
set -euo pipefail

umask 077
PATH=/usr/bin:/bin
export PATH
unset BASH_ENV CDPATH ENV GLOBIGNORE PYTHONHOME PYTHONPATH

SOURCE_PATH="${BASH_SOURCE[0]}"
case "$SOURCE_PATH" in
  /*) ;;
  *) SOURCE_PATH="$PWD/$SOURCE_PATH" ;;
esac
ROOT="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd -P)"

CHENG_BIN="${CSG_CORE_CHENG_BIN:-$ROOT/artifacts/bootstrap/cheng.stage3}"
GUARD="$ROOT/tools/beat_c_process_group_guard.sh"
FIXTURE_SRC_REL="src/tests/csg_core_merkle_successor_crash_fixture.cheng"
RECOVERY_SRC_REL="src/tests/csg_core_merkle_current_head_contract.cheng"
WRITER_SRC_REL="src/tests/csg_core_merkle_successor_crash_writer.cheng"
FIXTURE="$ROOT/$FIXTURE_SRC_REL"
RECOVERY="$ROOT/$RECOVERY_SRC_REL"
WRITER="$ROOT/$WRITER_SRC_REL"
RSS_LIMIT=1073741824
TARGET="arm64-apple-darwin"
PARK_TIMEOUT=120
# Self-SIGSTOP signal number for the writer's park seam: 17 Darwin, 19 Linux.
SIGSTOP_NUM=17
case "$(uname -s)" in
  Linux) SIGSTOP_NUM=19 ;;
esac

BOUNDARY_CELLS="BeforeObjectCommit AfterObjectCommitBeforeSuccessorRename AfterSuccessorRenameBeforeParentSync AfterParentSync"
SEMANTIC_CELLS="ExistingSuccessorConflicts SuccessorConflict commitRequiresReread authorityDeletionAllowed"

PASS_N=0
FAIL_N=0
SKIP_N=0

emit() {
  printf 'MATRIX %s %s %s\n' "$1" "$2" "$3"
  case "$2" in
    PASS) PASS_N=$((PASS_N + 1)) ;;
    FAIL) FAIL_N=$((FAIL_N + 1)) ;;
    SKIP) SKIP_N=$((SKIP_N + 1)) ;;
  esac
}

result_line() {
  printf 'CRASH_MATRIX_RESULT pass=%d fail=%d skip=%d\n' \
    "$PASS_N" "$FAIL_N" "$SKIP_N"
}

skip_all() {
  local cell
  for cell in $BOUNDARY_CELLS $SEMANTIC_CELLS; do
    emit "$cell" SKIP "$1"
  done
  result_line
}

# Hard preconditions: without the official fixed-point binary or the
# process-group guard nothing can be proven; report SKIP, never fake PASS.
if [ ! -x "$CHENG_BIN" ]; then
  skip_all "official_stage3_missing=$CHENG_BIN"
  exit 2
fi
if [ ! -x "$GUARD" ]; then
  skip_all "process_group_guard_missing=$GUARD"
  exit 2
fi

WORK_ROOT="$(cd "${TMPDIR:-/tmp}" && pwd -P)/csg_core_successor_crash_matrix.$$"
mkdir -p "$WORK_ROOT"
trap 'rm -rf "$WORK_ROOT"' EXIT

# compile_prog <label> <root-relative source> <out exe>
# Returns the guard/compiler rc; 97 when the compiler "succeeded" but left
# no executable behind (e.g. a non-functional binary must not fake a build).
compile_prog() {
  local label="$1" src_rel="$2" out="$3" rc=0
  "$GUARD" \
    --rss-limit:"$RSS_LIMIT" \
    --timeout:1800 \
    --report-out:"$WORK_ROOT/$label.compile.guard" \
    --stdout:"$WORK_ROOT/$label.compile.stdout" \
    --stderr:"$WORK_ROOT/$label.compile.stderr" \
    -- "$CHENG_BIN" system-link-exec \
    --root:"$ROOT" \
    --in:"$src_rel" \
    --emit:exe \
    --target:"$TARGET" \
    --out:"$out" \
    --report-out:"$WORK_ROOT/$label.compile.report" || rc=$?
  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi
  if [ ! -x "$out" ]; then
    return 97
  fi
  return 0
}

# run_guarded <label> [KEY=VALUE ...] <command> [args...]
run_guarded() {
  local label="$1" rc=0
  shift
  "$GUARD" \
    --rss-limit:"$RSS_LIMIT" \
    --timeout:180 \
    --report-out:"$WORK_ROOT/$label.guard" \
    --stdout:"$WORK_ROOT/$label.stdout" \
    --stderr:"$WORK_ROOT/$label.stderr" \
    -- env "$@" || rc=$?
  return "$rc"
}

first_line() {
  local line=""
  IFS= read -r line < "$1" || true
  printf '%s' "$line" | tr -d ' \t\r'
}

field_value() {
  local file="$1" prefix="$2" line=""
  while IFS= read -r line; do
    case "$line" in
      "$prefix"*)
        printf '%s' "${line#"$prefix"}" | tr -d ' \t\r'
        return 0
        ;;
    esac
  done < "$file"
  return 1
}

WRITER_EXE="$WORK_ROOT/successor_crash_writer.exe"
RECOVERY_EXE="$WORK_ROOT/successor_head_recovery.exe"
FIXTURE_EXE="$WORK_ROOT/successor_crash_fixture.exe"

# run_boundary_cell <boundary> — real two-process SIGKILL matrix cell.
run_boundary_cell() {
  local boundary="$1"
  local profile=""
  case "$boundary" in
    BeforeObjectCommit|AfterObjectCommitBeforeSuccessorRename)
      profile=predecessor_only ;;
    AfterSuccessorRenameBeforeParentSync)
      profile=reread_disambiguated ;;
    AfterParentSync)
      profile=successor_must_read ;;
  esac

  local cell_dir="$WORK_ROOT/cell_$boundary"
  mkdir -p "$cell_dir/parent"

  # Initialize the store and publish the generation-0 predecessor head
  # (the writer --init mode runs with no crash boundary armed, so it never
  # parks; a non-zero exit here means the store could not be bootstrapped).
  if ! CSG_SUCCESSOR_CRASH_WRITER_PARENT="$cell_dir/parent" \
       "$WRITER_EXE" --init >"$cell_dir/init.stdout" 2>"$cell_dir/init.stderr"; then
    emit "$boundary" FAIL "writer_init_failed"
    return
  fi

  local fifo="$cell_dir/writer.pipe"
  mkfifo "$fifo"

  CSG_SUCCESSOR_CRASH_WRITER_PARENT="$cell_dir/parent" \
  CSG_SUCCESSOR_CRASH_BOUNDARY="$boundary" \
  CSG_SUCCESSOR_CRASH_SIGSTOP_NUM="$SIGSTOP_NUM" \
    "$WRITER_EXE" >"$fifo" 2>"$cell_dir/writer.stderr" &
  local writer_pid=$!

  local parked=0 line="" expect_manifest=""
  exec 9<"$fifo"
  while IFS= read -r -t "$PARK_TIMEOUT" -u 9 line; do
    case "$line" in
      EXPECT\ manifest=*)
        expect_manifest="${line#EXPECT manifest=}"
        expect_manifest="$(printf '%s' "$expect_manifest" | tr -d ' \t\r')"
        ;;
      "PARKED $boundary")
        parked=1
        break
        ;;
    esac
  done
  exec 9<&-

  if [ "$parked" -ne 1 ]; then
    if kill -0 "$writer_pid" 2>/dev/null; then
      kill -KILL "$writer_pid" 2>/dev/null || true
      wait "$writer_pid" 2>/dev/null || true
      emit "$boundary" FAIL "writer_park_timeout,boundary=$boundary"
    else
      wait "$writer_pid" 2>/dev/null || true
      emit "$boundary" FAIL "writer_exited_before_park,boundary=$boundary"
    fi
    return
  fi

  kill -KILL "$writer_pid" 2>/dev/null || true
  wait "$writer_pid" 2>/dev/null || true
  local kill_evidence="kill=SIGKILL@PARKED_$boundary"

  case "$profile" in
    predecessor_only)
      local rc_read=0 rc_audit=0 head_cid=""
      run_guarded "$boundary.read" \
        CSG_CURRENT_HEAD_TEST_PARENT="$cell_dir/parent" \
        CSG_CURRENT_HEAD_TEST_MODE=read-ok \
        "$RECOVERY_EXE" || rc_read=$?
      run_guarded "$boundary.audit" \
        CSG_CURRENT_HEAD_TEST_PARENT="$cell_dir/parent" \
        CSG_CURRENT_HEAD_TEST_MODE=audit-ok \
        "$RECOVERY_EXE" || rc_audit=$?
      head_cid="$(field_value "$WORK_ROOT/$boundary.read.stdout" 'read_head=' || true)"
      if [ "$rc_read" -eq 0 ] && [ "$rc_audit" -eq 0 ]; then
        emit "$boundary" PASS \
          "profile=predecessor_only,$kill_evidence,read_rc=0,audit_rc=0,head=$head_cid,authority_intact=full_successor_history"
      else
        emit "$boundary" FAIL \
          "profile=predecessor_only,$kill_evidence,read_rc=$rc_read,audit_rc=$rc_audit,head=$head_cid"
      fi
      ;;
    reread_disambiguated)
      local rc1=0 rc2=0 m1="" m2="" stable=0
      run_guarded "$boundary.reread1" \
        CSG_CURRENT_HEAD_TEST_PARENT="$cell_dir/parent" \
        CSG_CURRENT_HEAD_TEST_MODE=manifest-cid \
        "$RECOVERY_EXE" || rc1=$?
      run_guarded "$boundary.reread2" \
        CSG_CURRENT_HEAD_TEST_PARENT="$cell_dir/parent" \
        CSG_CURRENT_HEAD_TEST_MODE=manifest-cid \
        "$RECOVERY_EXE" || rc2=$?
      m1="$(first_line "$WORK_ROOT/$boundary.reread1.stdout")"
      m2="$(first_line "$WORK_ROOT/$boundary.reread2.stdout")"
      if [ -n "$m1" ] && [ "$m1" = "$m2" ]; then
        stable=1
      fi
      if [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ] && [ "$stable" -eq 1 ]; then
        emit "$boundary" PASS \
          "profile=reread_disambiguated,commitRequiresReread=1,$kill_evidence,reread1_rc=0,reread2_rc=0,manifest=$m1,reread_stable=1"
      else
        emit "$boundary" FAIL \
          "profile=reread_disambiguated,commitRequiresReread=1,$kill_evidence,reread1_rc=$rc1,reread2_rc=$rc2,manifest1=$m1,manifest2=$m2,reread_stable=$stable"
      fi
      ;;
    successor_must_read)
      if [ -z "$expect_manifest" ]; then
        emit "$boundary" FAIL \
          "profile=successor_must_read,$kill_evidence,writer_expect_manifest_missing"
        return
      fi
      local rc_obs=0 observed=""
      run_guarded "$boundary.observe" \
        CSG_CURRENT_HEAD_TEST_PARENT="$cell_dir/parent" \
        CSG_CURRENT_HEAD_TEST_MODE=manifest-cid \
        "$RECOVERY_EXE" || rc_obs=$?
      observed="$(first_line "$WORK_ROOT/$boundary.observe.stdout")"
      if [ "$rc_obs" -eq 0 ] && [ "$observed" = "$expect_manifest" ]; then
        emit "$boundary" PASS \
          "profile=successor_must_read,$kill_evidence,manifest_rc=0,observed=$observed,matches_writer_expectation=1"
      else
        emit "$boundary" FAIL \
          "profile=successor_must_read,$kill_evidence,manifest_rc=$rc_obs,observed=$observed,expected=$expect_manifest"
      fi
      ;;
  esac
}

# --- boundary cells -------------------------------------------------------
writer_state=""
writer_note=""
if [ ! -f "$WRITER" ] || [ -L "$WRITER" ]; then
  writer_state=missing
  writer_note="crash_writer_probe_missing=$WRITER_SRC_REL"
elif [ ! -f "$RECOVERY" ] || [ -L "$RECOVERY" ]; then
  writer_state=missing
  writer_note="recovery_probe_missing=$RECOVERY_SRC_REL"
else
  wrc=0
  compile_prog writer "$WRITER_SRC_REL" "$WRITER_EXE" || wrc=$?
  rrc=0
  if [ "$wrc" -eq 0 ]; then
    compile_prog recovery "$RECOVERY_SRC_REL" "$RECOVERY_EXE" || rrc=$?
  fi
  if [ "$wrc" -eq 0 ] && [ "$rrc" -eq 0 ]; then
    writer_state=ready
  else
    writer_state=compile_failed
    writer_note="probe_compile_failed,writer_rc=$wrc,recovery_rc=$rrc"
  fi
fi

for boundary in $BOUNDARY_CELLS; do
  case "$writer_state" in
    ready)
      run_boundary_cell "$boundary"
      ;;
    compile_failed)
      emit "$boundary" FAIL "$writer_note"
      ;;
    *)
      emit "$boundary" SKIP "$writer_note"
      ;;
  esac
done

# --- semantic cells -------------------------------------------------------
# Real dynamic proof: compile and run the official crash fixture with the
# official stage3 fixed-point binary. The fixture's main conjunctively
# asserts exactly these four semantics, so fixture rc=0 proves each cell;
# on failure the conjunctive fixture cannot attribute a single cell, so all
# four report FAIL with the aggregate rc (no fabricated attribution).
if [ ! -f "$FIXTURE" ] || [ -L "$FIXTURE" ]; then
  for cell in $SEMANTIC_CELLS; do
    emit "$cell" SKIP "crash_fixture_missing=$FIXTURE_SRC_REL"
  done
else
  frc=0
  compile_prog fixture "$FIXTURE_SRC_REL" "$FIXTURE_EXE" || frc=$?
  if [ "$frc" -ne 0 ]; then
    for cell in $SEMANTIC_CELLS; do
      emit "$cell" FAIL "fixture_compile_failed,rc=$frc"
    done
  else
    fixture_rc=0
    run_guarded fixture-run "$FIXTURE_EXE" || fixture_rc=$?
    if [ "$fixture_rc" -eq 0 ]; then
      emit ExistingSuccessorConflicts PASS \
        "fixture_rc=0,assert=existing_predecessor_destination_always_conflicts"
      emit SuccessorConflict PASS \
        "fixture_rc=0,assert=different_writer_yields_SuccessorConflict"
      emit commitRequiresReread PASS \
        "fixture_rc=0,assert=AfterSuccessorRenameBeforeParentSync_commitRequiresReread_true"
      emit authorityDeletionAllowed PASS \
        "fixture_rc=0,assert=authorityDeletionAllowed_false_at_every_boundary"
    else
      for cell in $SEMANTIC_CELLS; do
        emit "$cell" FAIL \
          "fixture_rc=$fixture_rc,attribution=fixture_assertions_conjunctive"
      done
    fi
  fi
fi

result_line
if [ "$FAIL_N" -eq 0 ] && [ "$SKIP_N" -eq 0 ]; then
  exit 0
fi
if [ "$PASS_N" -eq 0 ] && [ "$FAIL_N" -eq 0 ]; then
  exit 2
fi
exit 1
