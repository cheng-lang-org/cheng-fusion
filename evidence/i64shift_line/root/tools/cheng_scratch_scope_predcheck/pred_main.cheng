import policy from "../..//src/apps/vpn_proxy/vpn_proxy_tun_policy.cheng"

fn main(): int32 =
    let domains: str[] = [
        "www.wikipedia.org",
        "en.wikipedia.org",
        "google.com",
        "www.gstatic.com",
        "content-autofill.googleapis.com",
        "www.youtube.com",
        "youtube.com",
        "x.com",
        "play.google.com",
        "optimizationguide-pa.googleapis.com",
        "twitter.com",
        "youtu.be"
    ]
    let n: int32 = len(domains)
    for i in 0..<n:
        let d: str = domains[i]
        if policy.VpnProxyTunShouldFakeDomain(d):
            console.PrintStr(d)
            console.PrintStr(" = HIT")
            console.PrintLine()
        else:
            console.PrintStr(d)
            console.PrintStr(" = MISS")
            console.PrintLine()
    return 0
