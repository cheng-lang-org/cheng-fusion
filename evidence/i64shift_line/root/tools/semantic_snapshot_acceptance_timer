#!/usr/bin/env python3
"""External monotonic timer for one semantic-snapshot acceptance sample."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import struct
import subprocess
import sys
import tempfile
import time
from typing import Any, Sequence


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True,
                       separators=(",", ":")) + "\n").encode("utf-8")


def text_frame(raw: bytes) -> bytes:
    return struct.pack(">I", len(raw)) + raw


def argv_digest(argv: Sequence[str]) -> str:
    payload = bytearray(text_frame(b"cheng.guard.command_argv"))
    payload.extend(struct.pack(">I", len(argv)))
    for value in argv:
        if "\x00" in value:
            raise ValueError("command argv contains NUL")
        payload.extend(text_frame(os.fsencode(value)))
    return sha256_bytes(bytes(payload))


def stable_executable_sha256(path: Path) -> str:
    if not path.is_absolute() or path.resolve() != path or not os.access(path, os.X_OK):
        raise ValueError("command executable path is not canonical")
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            raise ValueError("command executable is not private regular data")
        digest = hashlib.sha256()
        byte_count = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            byte_count += len(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    current = path.stat(follow_symlinks=False)
    identity = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
                "st_mtime_ns", "st_ctime_ns")
    if byte_count != before.st_size or any(
            getattr(before, field) != getattr(after, field) or
            getattr(before, field) != getattr(current, field)
            for field in identity):
        raise ValueError("command executable identity changed")
    return digest.hexdigest()


def atomic_write(path: Path, raw: bytes) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        if temporary.exists():
            temporary.unlink()
        raise


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--receipt-out", type=Path, required=True)
    parser.add_argument("--stdout", type=Path, required=True)
    parser.add_argument("--stderr", type=Path, required=True)
    parser.add_argument("--sample-index", type=int, required=True)
    parser.add_argument("--workload-kind", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command or args.sample_index < 0 or "\x00" in args.workload_kind:
        parser.error("an exact command, nonnegative sample, and workload are required")
    receipt_path = args.receipt_out.resolve()
    stdout_path = args.stdout.resolve()
    stderr_path = args.stderr.resolve()
    if len({receipt_path, stdout_path, stderr_path}) != 3:
        parser.error("receipt/stdout/stderr paths must be distinct")
    for path in (receipt_path, stdout_path, stderr_path):
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() or path.is_symlink():
            parser.error("output path already exists")
    command_path = Path(command[0])
    command_sha256 = stable_executable_sha256(command_path)
    timer_path = Path(__file__).resolve()
    timer_sha256 = sha256_file(timer_path)
    started = time.perf_counter_ns()
    with stdout_path.open("xb") as stdout_stream, stderr_path.open("xb") as stderr_stream:
        completed = subprocess.run(command, stdin=subprocess.DEVNULL,
                                   stdout=stdout_stream, stderr=stderr_stream,
                                   check=False)
        stdout_stream.flush()
        stderr_stream.flush()
        os.fsync(stdout_stream.fileno())
        os.fsync(stderr_stream.fileno())
    ended = time.perf_counter_ns()
    if stable_executable_sha256(command_path) != command_sha256 or \
       sha256_file(timer_path) != timer_sha256:
        raise RuntimeError("timer or command identity changed during sample")
    body = {
        "schema": "cheng.semantic_snapshot.external_wall_evidence",
        "status": "completed",
        "sample_index": args.sample_index,
        "workload_kind": args.workload_kind,
        "timer_path": str(timer_path),
        "timer_sha256": timer_sha256,
        "command_path": str(command_path),
        "command_sha256": command_sha256,
        "command_argv": command,
        "command_argv_cid": argv_digest(command),
        "started_monotonic_ns": started,
        "ended_monotonic_ns": ended,
        "wall_ns": ended - started,
        "return_code": completed.returncode,
        "stdout": {"path": str(stdout_path), "sha256": sha256_file(stdout_path),
                   "bytes": stdout_path.stat().st_size},
        "stderr": {"path": str(stderr_path), "sha256": sha256_file(stderr_path),
                   "bytes": stderr_path.stat().st_size},
    }
    receipt_cid = sha256_bytes(
        b"cheng.semantic_snapshot.external_wall_receipt\x00" +
        canonical_json_bytes(body))
    atomic_write(receipt_path, canonical_json_bytes({**body, "receipt_cid": receipt_cid}))
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
