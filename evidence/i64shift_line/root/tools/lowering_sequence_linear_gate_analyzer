#!/usr/bin/env python3
"""Prove lowering sequence append has no clone-all-before-add path."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path


OVERLOAD = re.compile(
    r"^fn\s+loweringSequenceAllocatorAdd\s*\(", re.MULTILINE
)
FUNCTION = re.compile(
    r"^fn\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(", re.MULTILINE
)
CALL = re.compile(r"\bloweringSequenceAllocatorAdd\s*\(")


def mask_noncode(text: str) -> str:
    out = list(text)
    index = 0
    while index < len(out):
        if text[index] == "#":
            while index < len(out) and text[index] != "\n":
                out[index] = " "
                index += 1
            continue
        if text.startswith('"""', index):
            out[index:index + 3] = [" ", " ", " "]
            index += 3
            while index < len(out) and not text.startswith('"""', index):
                if text[index] != "\n":
                    out[index] = " "
                index += 1
            if index < len(out):
                out[index:index + 3] = [" ", " ", " "]
                index += 3
            continue
        if text[index] == '"':
            out[index] = " "
            index += 1
            while index < len(out):
                if text[index] == "\\":
                    out[index] = " "
                    index += 1
                    if index < len(out):
                        out[index] = " "
                        index += 1
                    continue
                if text[index] == '"':
                    out[index] = " "
                    index += 1
                    break
                if text[index] != "\n":
                    out[index] = " "
                index += 1
            continue
        index += 1
    return "".join(out)


def function_ranges(masked: str) -> list[tuple[int, int, str]]:
    matches = list(FUNCTION.finditer(masked))
    ranges: list[tuple[int, int, str]] = []
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(masked)
        ranges.append((match.start(), end, match.group(1)))
    return ranges


def is_definition(masked: str, offset: int) -> bool:
    line_start = masked.rfind("\n", 0, offset) + 1
    prefix = masked[line_start:offset]
    return re.fullmatch(r"fn\s+", prefix) is not None


def owner_name(
    ranges: list[tuple[int, int, str]], offset: int
) -> str:
    for start, end, name in ranges:
        if start <= offset < end:
            return name
    return "<top-level>"


def overload_bodies(masked: str) -> list[str]:
    matches = list(OVERLOAD.finditer(masked))
    functions = list(FUNCTION.finditer(masked))
    bodies: list[str] = []
    for match in matches:
        end = len(masked)
        for candidate in functions:
            if candidate.start() > match.start():
                end = candidate.start()
                break
        bodies.append(masked[match.start():end])
    return bodies


def clone_all_before_add(body: str) -> bool:
    prior_length = r"(?:values|fnIr\.statements)\.len"
    for_scan = re.search(
        rf"\bfor\s+[A-Za-z_][A-Za-z0-9_]*\s+in\s+"
        rf"0\s*\.\.<\s*{prior_length}\s*:",
        body,
    )
    while_scan = re.search(
        rf"\bwhile\s+[A-Za-z_][A-Za-z0-9_]*\s*<\s*"
        rf"{prior_length}\s*:",
        body,
    )
    return for_scan is not None or while_scan is not None


def analyze(
    path: Path, row_count: int, element_bytes: int
) -> dict[str, object]:
    text = path.read_text(encoding="utf-8")
    masked = mask_noncode(text)
    ranges = function_ranges(masked)
    bodies = overload_bodies(masked)
    ledger_overloads = sum(
        1
        for body in bodies
        if re.search(
            r"loweringSequenceAllocatorAdd\s*\(\s*\n?\s*"
            r"ledger\s*:\s*var\s+LoweringSequenceAllocatorLedger",
            body,
        )
    )
    clone_overloads = sum(clone_all_before_add(body) for body in bodies)
    calls_by_owner: dict[str, int] = {}
    call_count = 0
    for call in CALL.finditer(masked):
        if is_definition(masked, call.start()):
            continue
        call_count += 1
        owner = owner_name(ranges, call.start())
        calls_by_owner[owner] = calls_by_owner.get(owner, 0) + 1
    top = sorted(calls_by_owner.items(), key=lambda item: (-item[1], item[0]))[:12]
    copied_elements = row_count * (row_count - 1) // 2
    return {
        "overloads": len(bodies),
        "ledger_overloads": ledger_overloads,
        "clone_overloads": clone_overloads,
        "wrapper_overloads": len(bodies) - ledger_overloads - 1,
        "call_count": call_count,
        "top": top,
        "row_count": row_count,
        "copied_elements": copied_elements,
        "element_bytes": element_bytes,
        "str_element_copy_bytes": copied_elements * element_bytes,
    }


def emit(result: dict[str, object]) -> None:
    print(f"allocator_add_overloads={result['overloads']}")
    print(f"allocator_add_ledger_overloads={result['ledger_overloads']}")
    print(f"allocator_add_call_sites={result['call_count']}")
    print(f"clone_all_before_add_overloads={result['clone_overloads']}")
    print(f"quadratic_probe_rows={result['row_count']}")
    print(f"quadratic_prior_element_copies={result['copied_elements']}")
    print(f"quadratic_str_element_bytes={result['element_bytes']}")
    print(f"quadratic_str_element_copy_bytes={result['str_element_copy_bytes']}")
    for rank, (name, count) in enumerate(result["top"], start=1):
        print(f"hot_call_{rank}_function={name}")
        print(f"hot_call_{rank}_sites={count}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source", type=Path)
    parser.add_argument(
        "--mode", choices=("require-linear", "expect-current-red"),
        default="require-linear",
    )
    parser.add_argument("--rows", type=int, default=4096)
    parser.add_argument("--element-bytes", type=int, default=24)
    args = parser.parse_args()
    if args.rows <= 1 or args.element_bytes <= 0:
        print("reason=probe_row_count_not_meaningful", file=sys.stderr)
        return 2
    result = analyze(args.source, args.rows, args.element_bytes)
    emit(result)
    if result["overloads"] != 15:
        print("reason=allocator_add_overload_count_drift", file=sys.stderr)
        return 31
    if result["ledger_overloads"] != 10:
        print("reason=allocator_add_ledger_overload_count_drift", file=sys.stderr)
        return 32
    if result["call_count"] <= 0:
        print("reason=allocator_add_call_surface_missing", file=sys.stderr)
        return 33
    if args.mode == "expect-current-red":
        if result["clone_overloads"] <= 0:
            print("reason=expected_clone_all_red_missing", file=sys.stderr)
            return 34
        print("lowering_sequence_linear_static_status=expected_red")
        return 0
    if result["clone_overloads"] != 0:
        print("reason=clone_all_before_add_present", file=sys.stderr)
        print("lowering_sequence_linear_static_status=failed", file=sys.stderr)
        return 41
    print("lowering_sequence_linear_static_status=passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
