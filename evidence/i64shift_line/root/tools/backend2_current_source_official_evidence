def raw_manifest(arguments: list[str]) -> None:
    if len(arguments) < 4 or len(arguments) % 2:
        fail("raw_manifest_arguments_invalid")
    kind = arguments[0]
    output = pathlib.Path(arguments[1])
    if not KEY_RE.fullmatch(kind):
        fail("raw_manifest_kind_invalid")
    pairs = arguments[2:]
    roles: list[tuple[str, pathlib.Path, bytes, os.stat_result]] = []
    seen_roles: set[str] = set()
    seen_inodes: set[tuple[int, int]] = set()
    for index in range(0, len(pairs), 2):
        role = pairs[index]
        path = pathlib.Path(pairs[index + 1])
        if not KEY_RE.fullmatch(role) or role in seen_roles or not path.is_absolute():
            fail(f"raw_manifest_role_invalid:{role}")
        raw, info = stable_read(path, "raw_manifest_artifact")
        inode = (info.st_dev, info.st_ino)
        if inode in seen_inodes:
            fail(f"raw_manifest_inode_alias:{role}")
        seen_roles.add(role)
        seen_inodes.add(inode)
        roles.append((role, path, raw, info))
    lines = [
        "schema=cheng.backend2.current_source_raw_manifest",
        "status=PASS",
        f"lock_kind={kind}",
        f"artifact_count={len(roles)}",
    ]
    for index, (role, path, raw, info) in enumerate(roles):
        prefix = f"artifact.{index}."
        lines.extend(
            (
                prefix + "role=" + role,
                prefix + "path_fshex=" + os.fsencode(path).hex(),
                prefix + "sha256=" + hashlib.sha256(raw).hexdigest(),
                prefix + "device=" + str(info.st_dev),
                prefix + "inode=" + str(info.st_ino),
                prefix + "size=" + str(info.st_size),
                prefix + "mode=" + format(info.st_mode, "o"),
                prefix + "mtime_ns=" + str(info.st_mtime_ns),
                prefix + "ctime_ns=" + str(info.st_ctime_ns),
            )
        )
    payload = ("\n".join(lines) + "\n").encode()
    lines.append("manifest_payload_sha256=" + hashlib.sha256(payload).hexdigest())
    exclusive_write(output, ("\n".join(lines) + "\n").encode())


def validate_raw_manifest(path: pathlib.Path, expected_kind: str) -> None:
    raw, _ = stable_read(path, "raw_manifest")
    rows, lines = parse_rows(raw, "raw_manifest")
    if (
        rows.get("schema") != "cheng.backend2.current_source_raw_manifest"
        or rows.get("status") != "PASS"
        or rows.get("lock_kind") != expected_kind
    ):
        fail("raw_manifest_header_invalid")
    if (
        not lines[-1].startswith("manifest_payload_sha256=")
        or rows.get("manifest_payload_sha256")
        != hashlib.sha256(("\n".join(lines[:-1]) + "\n").encode()).hexdigest()
    ):
        fail("raw_manifest_payload_invalid")
    count = canonical_uint(rows.get("artifact_count", ""), "raw_manifest_count")
    expected_keys = {
        "schema",
        "status",
        "lock_kind",
        "artifact_count",
        "manifest_payload_sha256",
    }
    columns = (
        "role",
        "path_fshex",
        "sha256",
        "device",
        "inode",
        "size",
        "mode",
        "mtime_ns",
        "ctime_ns",
    )
    for index in range(count):
        expected_keys.update(f"artifact.{index}.{column}" for column in columns)
    if set(rows) != expected_keys:
        fail("raw_manifest_key_set_invalid")
    roles: set[str] = set()
    paths: set[bytes] = set()
    inodes: set[tuple[int, int]] = set()
    for index in range(count):
        prefix = f"artifact.{index}."
        role = rows[prefix + "role"]
        path_raw = fshex_decode(rows[prefix + "path_fshex"], "raw_manifest_path")
        if (
            not KEY_RE.fullmatch(role)
            or role in roles
            or path_raw in paths
            or not os.path.isabs(path_raw)
        ):
            fail("raw_manifest_role_or_path_invalid")
        path = pathlib.Path(os.fsdecode(path_raw))
        artifact_raw, info = stable_read(path, "raw_manifest_artifact")
        inode = (info.st_dev, info.st_ino)
        if inode in inodes:
            fail("raw_manifest_inode_alias")
        expected = {
            "sha256": hashlib.sha256(artifact_raw).hexdigest(),
            "device": str(info.st_dev),
            "inode": str(info.st_ino),
            "size": str(info.st_size),
            "mode": format(info.st_mode, "o"),
            "mtime_ns": str(info.st_mtime_ns),
            "ctime_ns": str(info.st_ctime_ns),
        }
        for column, value in expected.items():
            if rows[prefix + column] != value:
                fail(f"raw_manifest_artifact_binding_invalid:{role}:{column}")
        roles.add(role)
        paths.add(path_raw)
        inodes.add(inode)


def enumerate_tree(
    root: pathlib.Path, excluded: set[pathlib.Path]
) -> tuple[list[pathlib.Path], dict[bytes, tuple[int, ...]]]:
    files: list[pathlib.Path] = []
    directories: dict[bytes, tuple[int, ...]] = {}
    root_real = pathlib.Path(os.path.realpath(root))
    try:
        root_info = root_real.lstat()
    except OSError as exc:
        fail(f"producer_root_missing:{exc}")
    if not stat.S_ISDIR(root_info.st_mode) or stat.S_ISLNK(root_info.st_mode):
        fail("producer_root_invalid")
    for directory, names, filenames in os.walk(root_real, topdown=True, followlinks=False):
        names.sort(key=os.fsencode)
        filenames.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        relative_directory = directory_path.relative_to(root_real)
        if relative_directory != pathlib.Path("."):
            info = directory_path.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail(f"producer_directory_invalid:{directory_path}")
            directories[os.fsencode(relative_directory)] = identity(info)
        for name in names:
            child = directory_path / name
            info = child.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail(f"producer_directory_member_invalid:{child}")
        for name in filenames:
            path = directory_path / name
            absolute = pathlib.Path(os.path.abspath(path))
            if absolute in excluded:
                continue
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail(f"producer_artifact_invalid:{path}")
            files.append(path)
    files.sort(key=lambda path: os.fsencode(path.relative_to(root_real)))
    return files, directories


def manifest_payload(
    root: pathlib.Path,
    official: pathlib.Path,
    manifest: pathlib.Path,
    receipt: pathlib.Path,
) -> tuple[bytes, list[tuple[pathlib.Path, str, os.stat_result]]]:
    excluded = {
        pathlib.Path(os.path.realpath(path.parent)) / path.name
        for path in (manifest, receipt)
    }
    first_files, first_directories = enumerate_tree(root, excluded)
    artifacts: list[tuple[pathlib.Path, str, os.stat_result]] = []
    seen_inodes: set[tuple[int, int]] = set()
    root_real = pathlib.Path(os.path.realpath(root))
    for path in first_files:
        raw, info = stable_read(path, "producer_artifact")
        inode = (info.st_dev, info.st_ino)
        if inode in seen_inodes:
            fail(f"producer_artifact_inode_alias:{path}")
        seen_inodes.add(inode)
        artifacts.append(
            (path.relative_to(root_real), hashlib.sha256(raw).hexdigest(), info)
        )
    second_files, second_directories = enumerate_tree(root, excluded)
    if (
        [os.fsencode(path.relative_to(root_real)) for path in first_files]
        != [os.fsencode(path.relative_to(root_real)) for path in second_files]
        or first_directories != second_directories
    ):
        fail("producer_tree_changed_during_scan")
    official_raw, official_info = stable_read(official, "official_driver", True)
    if (official_info.st_dev, official_info.st_ino) in seen_inodes:
        fail("official_driver_inode_alias")
    lines = [
        "schema=cheng.backend2.current_source_official_artifact_manifest",
        "status=PASS",
        "driver_role=production",
        "producer_root_fshex=" + os.fsencode(root_real).hex(),
        "official_driver_path_fshex=" + os.fsencode(pathlib.Path(os.path.realpath(official))).hex(),
        "official_driver_sha256=" + hashlib.sha256(official_raw).hexdigest(),
        "official_driver_device=" + str(official_info.st_dev),
        "official_driver_inode=" + str(official_info.st_ino),
        "official_driver_size=" + str(official_info.st_size),
        "official_driver_mode=" + format(official_info.st_mode, "o"),
        "official_driver_mtime_ns=" + str(official_info.st_mtime_ns),
        "official_driver_ctime_ns=" + str(official_info.st_ctime_ns),
        "directory_count=" + str(len(first_directories)),
    ]
    for index, relative in enumerate(sorted(first_directories)):
        current = first_directories[relative]
        prefix = f"directory.{index}."
        lines.extend(
            (
                prefix + "path_fshex=" + relative.hex(),
                prefix + "device=" + str(current[0]),
                prefix + "inode=" + str(current[1]),
                prefix + "mode=" + format(current[2], "o"),
                prefix + "nlink=" + str(current[3]),
                prefix + "mtime_ns=" + str(current[5]),
                prefix + "ctime_ns=" + str(current[6]),
            )
        )
    lines.append("artifact_count=" + str(len(artifacts)))
    for index, (relative, digest, info) in enumerate(artifacts):
        prefix = f"artifact.{index}."
        lines.extend(
            (
                prefix + "path_fshex=" + os.fsencode(relative).hex(),
                prefix + "sha256=" + digest,
                prefix + "device=" + str(info.st_dev),
                prefix + "inode=" + str(info.st_ino),
                prefix + "size=" + str(info.st_size),
                prefix + "mode=" + format(info.st_mode, "o"),
                prefix + "mtime_ns=" + str(info.st_mtime_ns),
                prefix + "ctime_ns=" + str(info.st_ctime_ns),
            )
        )
    payload = ("\n".join(lines) + "\n").encode()
    lines.append("manifest_payload_sha256=" + hashlib.sha256(payload).hexdigest())
    return ("\n".join(lines) + "\n").encode(), artifacts


def publish(arguments: list[str]) -> None:
    if len(arguments) != 5:
        fail("publish_arguments_invalid")
    root, raw_root, official, manifest, receipt = map(pathlib.Path, arguments)
    for path in (root, raw_root, official, manifest, receipt):
        if not path.is_absolute():
            fail(f"publish_path_not_absolute:{path}")
    root_real = pathlib.Path(os.path.realpath(root))
    raw_real = pathlib.Path(os.path.realpath(raw_root))
    manifest = pathlib.Path(os.path.realpath(manifest.parent)) / manifest.name
    receipt = pathlib.Path(os.path.realpath(receipt.parent)) / receipt.name
    if raw_real.parent != root_real or raw_real.name != "raw":
        fail("publish_raw_root_invalid")
    if manifest.parent != root_real or receipt.parent != root_real:
        fail("publish_output_parent_invalid")
    summary = raw_real / "summary.kv"
    postflight = raw_real / "postflight.kv"
    fixed = raw_real / "backend-driver.gen2-gen3.fixed-point.kv"
    epoch = raw_real / "backend2-epoch.raw-manifest.kv"
    jobs = raw_real / "backend2-jobs.raw-manifest.kv"
    gen2 = raw_real / "backend-driver.current"
    gen3 = raw_real / "backend-driver.gen3"
    required = (summary, postflight, fixed, epoch, jobs, gen2, gen3)
    required_values: dict[pathlib.Path, tuple[bytes, os.stat_result]] = {}
    for path in required:
        required_values[path] = stable_read(
            path, "publish_required", path in (gen2, gen3)
        )
    validate_raw_manifest(epoch, "backend2_epoch")
    validate_raw_manifest(jobs, "backend2_jobs")
    summary_rows, _ = parse_rows(required_values[summary][0], "summary")
    expected_summary = {
        "schema": "cheng.backend2.current_source_gate",
        "status": "pass",
        "source_postflight_status": "stable",
        "gen2_gen3_raw_bytes_equal": "true",
        "gen2_gen3_distinct_artifact_inodes": "true",
        "backend2_epoch_status": "pass",
        "backend2_jobs1_jobs4_raw_bytes_equal": "true",
        "backend2_jobs1_jobs4_distinct_artifact_inodes": "true",
        "exact_command_environment_guard_count": "9",
        "official_artifact_unchanged": "true",
    }
    for key, value in expected_summary.items():
        if summary_rows.get(key) != value:
            fail(f"publish_summary_not_complete:{key}")
    official_raw, official_info = stable_read(official, "official_driver", True)
    gen2_raw, gen2_info = required_values[gen2]
    gen3_raw, gen3_info = required_values[gen3]
    if gen2_raw != gen3_raw or gen2_raw != official_raw:
        fail("publish_driver_raw_bytes_mismatch")
    inodes = {
        (gen2_info.st_dev, gen2_info.st_ino),
        (gen3_info.st_dev, gen3_info.st_ino),
        (official_info.st_dev, official_info.st_ino),
    }
    if len(inodes) != 3:
        fail("publish_driver_inode_independence_invalid")
    manifest_raw, _ = manifest_payload(root_real, official, manifest, receipt)
    exclusive_write(manifest, manifest_raw)
    published_manifest_raw, manifest_info = stable_read(
        manifest, "published_artifact_manifest"
    )
    if published_manifest_raw != manifest_raw:
        fail("published_artifact_manifest_changed")
    manifest_digest = hashlib.sha256(published_manifest_raw).hexdigest()
    receipt_lines = [
        "schema=cheng.backend2.current_source_official_publisher_receipt",
        "status=PASS",
        "driver_role=production",
        "producer_root_fshex=" + os.fsencode(root_real).hex(),
        "artifact_manifest_path_fshex=" + os.fsencode(manifest).hex(),
        "artifact_manifest_sha256=" + manifest_digest,
        "artifact_manifest_device=" + str(manifest_info.st_dev),
        "artifact_manifest_inode=" + str(manifest_info.st_ino),
        "artifact_manifest_size=" + str(manifest_info.st_size),
        "artifact_manifest_mode=" + format(manifest_info.st_mode, "o"),
        "artifact_manifest_mtime_ns=" + str(manifest_info.st_mtime_ns),
        "artifact_manifest_ctime_ns=" + str(manifest_info.st_ctime_ns),
        "official_driver_path_fshex=" + os.fsencode(pathlib.Path(os.path.realpath(official))).hex(),
        "official_driver_sha256=" + hashlib.sha256(official_raw).hexdigest(),
        "official_driver_device=" + str(official_info.st_dev),
        "official_driver_inode=" + str(official_info.st_ino),
        "gen2_path_fshex=" + os.fsencode(gen2).hex(),
        "gen2_sha256=" + hashlib.sha256(gen2_raw).hexdigest(),
        "gen2_device=" + str(gen2_info.st_dev),
        "gen2_inode=" + str(gen2_info.st_ino),
        "gen3_path_fshex=" + os.fsencode(gen3).hex(),
        "gen3_sha256=" + hashlib.sha256(gen3_raw).hexdigest(),
        "gen3_device=" + str(gen3_info.st_dev),
        "gen3_inode=" + str(gen3_info.st_ino),
        "summary_sha256=" + hashlib.sha256(required_values[summary][0]).hexdigest(),
        "postflight_sha256=" + hashlib.sha256(required_values[postflight][0]).hexdigest(),
        "fixed_point_sha256=" + hashlib.sha256(required_values[fixed][0]).hexdigest(),
        "backend2_epoch_raw_manifest_sha256=" + hashlib.sha256(required_values[epoch][0]).hexdigest(),
        "backend2_jobs_raw_manifest_sha256=" + hashlib.sha256(required_values[jobs][0]).hexdigest(),
        "raw_bytes_fixed_point=true",
        "independent_driver_inodes=true",
    ]
    receipt_payload = ("\n".join(receipt_lines) + "\n").encode()
    receipt_lines.append(
        "receipt_payload_sha256=" + hashlib.sha256(receipt_payload).hexdigest()
    )
    exclusive_write(receipt, ("\n".join(receipt_lines) + "\n").encode())
    validate([str(receipt)])


def validate_receipt_state(
    receipt: pathlib.Path,
    receipt_raw: bytes,
    receipt_info: os.stat_result,
) -> None:
    if (
        stat.S_IMODE(receipt_info.st_mode) != 0o400
        or receipt_info.st_nlink != 1
        or receipt_info.st_uid != os.geteuid()
        or receipt_info.st_gid != os.getegid()
    ):
        fail("publisher_receipt_seal_invalid")
    receipt_rows, receipt_lines = parse_rows(receipt_raw, "publisher_receipt")
    if (
        receipt_rows.get("schema")
        != "cheng.backend2.current_source_official_publisher_receipt"
        or receipt_rows.get("status") != "PASS"
        or receipt_rows.get("driver_role") != "production"
        or receipt_rows.get("raw_bytes_fixed_point") != "true"
        or receipt_rows.get("independent_driver_inodes") != "true"
    ):
        fail("publisher_receipt_header_invalid")
    expected_receipt_keys = {
        "schema",
        "status",
        "driver_role",
        "producer_root_fshex",
        "artifact_manifest_path_fshex",
        "artifact_manifest_sha256",
        "artifact_manifest_device",
        "artifact_manifest_inode",
        "artifact_manifest_size",
        "artifact_manifest_mode",
        "artifact_manifest_mtime_ns",
        "artifact_manifest_ctime_ns",
        "official_driver_path_fshex",
        "official_driver_sha256",
        "official_driver_device",
        "official_driver_inode",
        "gen2_path_fshex",
        "gen2_sha256",
        "gen2_device",
        "gen2_inode",
        "gen3_path_fshex",
        "gen3_sha256",
        "gen3_device",
        "gen3_inode",
        "summary_sha256",
        "postflight_sha256",
        "fixed_point_sha256",
        "backend2_epoch_raw_manifest_sha256",
        "backend2_jobs_raw_manifest_sha256",
        "raw_bytes_fixed_point",
        "independent_driver_inodes",
        "receipt_payload_sha256",
    }
    if set(receipt_rows) != expected_receipt_keys:
        fail("publisher_receipt_key_set_invalid")
    receipt_payload = ("\n".join(receipt_lines[:-1]) + "\n").encode()
    if (
        not receipt_lines[-1].startswith("receipt_payload_sha256=")
        or receipt_rows.get("receipt_payload_sha256")
        != hashlib.sha256(receipt_payload).hexdigest()
    ):
        fail("publisher_receipt_payload_invalid")
    root = pathlib.Path(os.fsdecode(fshex_decode(receipt_rows.get("producer_root_fshex", ""), "producer_root")))
    manifest = pathlib.Path(os.fsdecode(fshex_decode(receipt_rows.get("artifact_manifest_path_fshex", ""), "artifact_manifest_path")))
    official = pathlib.Path(os.fsdecode(fshex_decode(receipt_rows.get("official_driver_path_fshex", ""), "official_driver_path")))
    root = pathlib.Path(os.path.realpath(root))
    manifest = pathlib.Path(os.path.realpath(manifest.parent)) / manifest.name
    receipt_real = pathlib.Path(os.path.realpath(receipt.parent)) / receipt.name
    if manifest.parent != root or receipt_real.parent != root:
        fail("publisher_receipt_output_parent_invalid")
    manifest_raw, manifest_info = stable_read(manifest, "artifact_manifest")
    if hashlib.sha256(manifest_raw).hexdigest() != canonical_sha(
        receipt_rows.get("artifact_manifest_sha256", ""), "artifact_manifest"
    ):
        fail("artifact_manifest_receipt_digest_mismatch")
    for key, value in (
        ("artifact_manifest_device", manifest_info.st_dev),
        ("artifact_manifest_inode", manifest_info.st_ino),
        ("artifact_manifest_size", manifest_info.st_size),
        ("artifact_manifest_mode", format(manifest_info.st_mode, "o")),
        ("artifact_manifest_mtime_ns", manifest_info.st_mtime_ns),
        ("artifact_manifest_ctime_ns", manifest_info.st_ctime_ns),
    ):
        if receipt_rows.get(key) != str(value):
            fail(f"artifact_manifest_receipt_identity_mismatch:{key}")
    manifest_rows, manifest_lines = parse_rows(manifest_raw, "artifact_manifest")
    if (
        manifest_rows.get("schema")
        != "cheng.backend2.current_source_official_artifact_manifest"
        or manifest_rows.get("status") != "PASS"
        or manifest_rows.get("driver_role") != "production"
    ):
        fail("artifact_manifest_header_invalid")
    manifest_payload_raw = ("\n".join(manifest_lines[:-1]) + "\n").encode()
    if (
        not manifest_lines[-1].startswith("manifest_payload_sha256=")
        or manifest_rows.get("manifest_payload_sha256")
        != hashlib.sha256(manifest_payload_raw).hexdigest()
    ):
        fail("artifact_manifest_payload_invalid")
    rebuilt, _ = manifest_payload(root, official, manifest, receipt)
    if rebuilt != manifest_raw:
        fail("artifact_manifest_tree_mismatch")
    raw_root = root / "raw"
    required_receipt_artifacts = {
        "summary_sha256": raw_root / "summary.kv",
        "postflight_sha256": raw_root / "postflight.kv",
        "fixed_point_sha256":
            raw_root / "backend-driver.gen2-gen3.fixed-point.kv",
        "backend2_epoch_raw_manifest_sha256":
            raw_root / "backend2-epoch.raw-manifest.kv",
        "backend2_jobs_raw_manifest_sha256":
            raw_root / "backend2-jobs.raw-manifest.kv",
    }
    for key, path in required_receipt_artifacts.items():
        raw, _ = stable_read(path, "receipt_required_artifact")
        if hashlib.sha256(raw).hexdigest() != canonical_sha(
            receipt_rows.get(key, ""), key
        ):
            fail(f"publisher_receipt_required_artifact_invalid:{key}")
    summary_raw, _ = stable_read(raw_root / "summary.kv", "summary")
    summary_rows, _ = parse_rows(summary_raw, "summary")
    expected_summary = {
        "schema": "cheng.backend2.current_source_gate",
        "status": "pass",
        "source_postflight_status": "stable",
        "gen2_gen3_raw_bytes_equal": "true",
        "gen2_gen3_distinct_artifact_inodes": "true",
        "backend2_epoch_status": "pass",
        "backend2_jobs1_jobs4_raw_bytes_equal": "true",
        "backend2_jobs1_jobs4_distinct_artifact_inodes": "true",
        "exact_command_environment_guard_count": "9",
        "official_artifact_unchanged": "true",
    }
    for key, value in expected_summary.items():
        if summary_rows.get(key) != value:
            fail(f"publisher_summary_invalid:{key}")
    validate_raw_manifest(
        raw_root / "backend2-epoch.raw-manifest.kv", "backend2_epoch"
    )
    validate_raw_manifest(
        raw_root / "backend2-jobs.raw-manifest.kv", "backend2_jobs"
    )
    for role in ("official_driver", "gen2", "gen3"):
        path = pathlib.Path(
            os.fsdecode(fshex_decode(receipt_rows.get(role + "_path_fshex", ""), role + "_path"))
        )
        raw, info = stable_read(path, role, True)
        if (
            hashlib.sha256(raw).hexdigest()
            != canonical_sha(receipt_rows.get(role + "_sha256", ""), role)
            or receipt_rows.get(role + "_device") != str(info.st_dev)
            or receipt_rows.get(role + "_inode") != str(info.st_ino)
        ):
            fail(f"{role}_receipt_binding_invalid")
    gen2 = pathlib.Path(os.fsdecode(fshex_decode(receipt_rows["gen2_path_fshex"], "gen2_path")))
    gen3 = pathlib.Path(os.fsdecode(fshex_decode(receipt_rows["gen3_path_fshex"], "gen3_path")))
    values = [stable_read(path, "fixed_driver", True) for path in (gen2, gen3, official)]
    if values[0][0] != values[1][0] or values[0][0] != values[2][0]:
        fail("fixed_driver_bytes_changed")
    if len({(value[1].st_dev, value[1].st_ino) for value in values}) != 3:
        fail("fixed_driver_inode_alias")

    terminal_raw, terminal_info = stable_read(receipt, "publisher_receipt_terminal")
    if (
        terminal_raw != receipt_raw
        or identity(terminal_info) != identity(receipt_info)
    ):
        fail("publisher_receipt_terminal_drift")


def validate(arguments: list[str]) -> None:
    if len(arguments) != 1:
        fail("validate_arguments_invalid")
    receipt = pathlib.Path(arguments[0])
    receipt_raw, receipt_info = stable_read(receipt, "publisher_receipt")
    validate_receipt_state(receipt, receipt_raw, receipt_info)


def validate_fd(arguments: list[str]) -> None:
    if len(arguments) != 2 or not arguments[0].isascii() or not arguments[0].isdigit():
        fail("validate_fd_arguments_invalid")
    descriptor = int(arguments[0])
    receipt = pathlib.Path(arguments[1])
    try:
        opened = os.fstat(descriptor)
        named = receipt.lstat()
    except OSError as exc:
        fail(f"validate_fd_open_failed:{exc}")
    if (
        not stat.S_ISREG(opened.st_mode)
        or opened.st_nlink != 1
        or identity(opened) != identity(named)
    ):
        fail("validate_fd_identity_invalid")
    digest = hashlib.sha256()
    chunks: list[bytes] = []
    offset = 0
    while offset < opened.st_size:
        chunk = os.pread(descriptor, min(1024 * 1024, opened.st_size - offset), offset)
        if not chunk:
            fail("validate_fd_short_read")
        digest.update(chunk)
        chunks.append(chunk)
        offset += len(chunk)
    terminal = os.fstat(descriptor)
    receipt_raw = b"".join(chunks)
    if (
        identity(opened) != identity(terminal)
        or len(receipt_raw) != opened.st_size
        or hashlib.sha256(receipt_raw).digest() != digest.digest()
    ):
        fail("validate_fd_read_drift")
    validate_receipt_state(receipt, receipt_raw, opened)


def main() -> None:
    if len(sys.argv) < 2:
        fail("subcommand_missing")
    command = sys.argv[1]
    arguments = sys.argv[2:]
    if command == "execution-manifests":
        write_execution_manifests(arguments)
    elif command == "validate-execution":
        validate_execution(arguments)
    elif command == "raw-manifest":
        raw_manifest(arguments)
    elif command == "validate-raw-manifest":
        if len(arguments) != 2:
            fail("validate_raw_manifest_arguments_invalid")
        validate_raw_manifest(pathlib.Path(arguments[0]), arguments[1])
    elif command == "publish":
        publish(arguments)
    elif command == "validate":
        validate(arguments)
    elif command == "validate-fd":
        validate_fd(arguments)
    else:
        fail(f"subcommand_invalid:{command}")


if __name__ == "__main__":
    try:
        main()
    except EvidenceError as error:
        print(f"backend2_current_source_official_evidence_error={error}", file=sys.stderr)
        raise SystemExit(FAIL_RC)
    except Exception as error:
        print(
            f"backend2_current_source_official_evidence_error=internal:{type(error).__name__}:{error}",
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
