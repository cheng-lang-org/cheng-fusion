#!/usr/bin/env python3
"""Exclusive evidence producer/validator for the current backend2 driver."""

from __future__ import annotations

import hashlib
import os
import pathlib
import re
import stat
import struct
import sys


FAIL_RC = 97
SHA_RE = re.compile(r"[0-9a-f]{64}")
KEY_RE = re.compile(r"[a-z0-9_.-]+")
EXECUTION_INPUT_ROLES = ("command", "monitor_runtime", "monitor_python")
EXECUTION_OUTPUT_ROLES = (
    "report",
    "stdout",
    "stderr",
    "resource_trace",
    "phase_trace",
)
EXECUTION_REQUIRED_OUTPUT_ROLES = ("report", "stdout", "stderr")
PHYSICAL_IDENTITY_FIELDS = (
    "device",
    "inode",
    "mode",
    "nlink",
    "uid",
    "gid",
    "size",
    "mtime_ns",
    "ctime_ns",
)


class EvidenceError(Exception):
    pass


def fail(message: str) -> None:
    raise EvidenceError(message)


def frame(raw: bytes) -> bytes:
    return struct.pack(">I", len(raw)) + raw


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def stable_read(path: pathlib.Path, label: str, executable: bool = False) -> tuple[bytes, os.stat_result]:
    try:
        before = path.lstat()
    except OSError as exc:
        fail(f"{label}_missing:{path}:{exc}")
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_nlink != 1
        or (executable and before.st_mode & 0o111 == 0)
    ):
        fail(f"{label}_identity_invalid:{path}")
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        fail(f"{label}_open_failed:{path}:{exc}")
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            fail(f"{label}_open_race:{path}")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            chunks.append(chunk)
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    try:
        after = path.lstat()
    except OSError as exc:
        fail(f"{label}_removed_during_read:{path}:{exc}")
    if identity(before) != identity(closed) or identity(before) != identity(after):
        fail(f"{label}_read_race:{path}")
    raw = b"".join(chunks)
    if len(raw) != before.st_size or hashlib.sha256(raw).digest() != digest.digest():
        fail(f"{label}_short_read:{path}")
    return raw, before


def exclusive_write(path: pathlib.Path, payload: bytes, mode: int = 0o400) -> None:
    if not path.is_absolute():
        fail(f"output_not_absolute:{path}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags, mode)
    except OSError as exc:
        fail(f"exclusive_output_create_failed:{path}:{exc}")
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail(f"output_short_write:{path}")
            view = view[written:]
        os.fsync(descriptor)
        current = os.fstat(descriptor)
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_nlink != 1
            or current.st_size != len(payload)
        ):
            fail(f"output_identity_invalid:{path}")
    finally:
        os.close(descriptor)
    directory_descriptor = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory_descriptor)
    finally:
        os.close(directory_descriptor)


def parse_rows(raw: bytes, label: str) -> tuple[dict[str, str], list[str]]:
    if not raw or not raw.endswith(b"\n") or b"\0" in raw or b"\r" in raw:
        fail(f"{label}_encoding_invalid")
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        fail(f"{label}_utf8_invalid:{exc}")
    rows: dict[str, str] = {}
    lines = text.splitlines()
    for line in lines:
        if "=" not in line:
            fail(f"{label}_row_invalid")
        key, value = line.split("=", 1)
        if not KEY_RE.fullmatch(key) or key in rows:
            fail(f"{label}_key_invalid_or_duplicate:{key}")
        rows[key] = value
    return rows, lines


def canonical_uint(value: str, label: str) -> int:
    if not re.fullmatch(r"0|[1-9][0-9]*", value):
        fail(f"{label}_uint_invalid")
    return int(value)


def canonical_sha(value: str, label: str) -> str:
    if not SHA_RE.fullmatch(value):
        fail(f"{label}_sha_invalid")
    return value


def canonical_octal(value: str, label: str) -> int:
    if not re.fullmatch(r"[1-7][0-7]*", value):
        fail(f"{label}_octal_invalid")
    parsed = int(value, 8)
    if format(parsed, "o") != value:
        fail(f"{label}_octal_noncanonical")
    return parsed


def physical_values(info: os.stat_result) -> dict[str, int]:
    return {
        "device": info.st_dev,
        "inode": info.st_ino,
        "mode": info.st_mode,
        "nlink": info.st_nlink,
        "uid": info.st_uid,
        "gid": info.st_gid,
        "size": info.st_size,
        "mtime_ns": info.st_mtime_ns,
        "ctime_ns": info.st_ctime_ns,
    }


def append_physical_rows(
    lines: list[str],
    prefix: str,
    path: pathlib.Path,
    raw: bytes,
    info: os.stat_result,
) -> None:
    lines.extend(
        (
            prefix + "path_fshex=" + os.fsencode(path).hex(),
            prefix + "sha256=" + hashlib.sha256(raw).hexdigest(),
            prefix + "device=" + str(info.st_dev),
            prefix + "inode=" + str(info.st_ino),
            prefix + "mode=" + format(info.st_mode, "o"),
            prefix + "nlink=" + str(info.st_nlink),
            prefix + "uid=" + str(info.st_uid),
            prefix + "gid=" + str(info.st_gid),
            prefix + "size=" + str(info.st_size),
            prefix + "mtime_ns=" + str(info.st_mtime_ns),
            prefix + "ctime_ns=" + str(info.st_ctime_ns),
        )
    )


def parse_physical_rows(
    rows: dict[str, str],
    prefix: str,
    label: str,
) -> tuple[pathlib.Path, str, dict[str, int]]:
    path = pathlib.Path(
        os.fsdecode(fshex_decode(rows.get(prefix + "path_fshex", ""), label + "_path"))
    )
    if not path.is_absolute() or str(path) != os.path.realpath(path):
        fail(f"{label}_path_not_exact")
    digest = canonical_sha(rows.get(prefix + "sha256", ""), label)
    values: dict[str, int] = {}
    for field in PHYSICAL_IDENTITY_FIELDS:
        value = rows.get(prefix + field, "")
        values[field] = (
            canonical_octal(value, label + "_mode")
            if field == "mode"
            else canonical_uint(value, label + "_" + field)
        )
    return path, digest, values


def verify_physical(
    raw: bytes,
    info: os.stat_result,
    digest: str,
    declared: dict[str, int],
    label: str,
) -> None:
    actual = physical_values(info)
    if hashlib.sha256(raw).hexdigest() != digest:
        fail(f"{label}_sha_mismatch")
    for field in PHYSICAL_IDENTITY_FIELDS:
        if declared[field] != actual[field]:
            fail(f"{label}_physical_identity_mismatch:{field}")


def fshex_decode(value: str, label: str) -> bytes:
    if not value or len(value) % 2 or not re.fullmatch(r"[0-9a-f]+", value):
        fail(f"{label}_fshex_invalid")
    try:
        return bytes.fromhex(value)
    except ValueError as exc:
        fail(f"{label}_fshex_invalid:{exc}")


def write_execution_manifests(arguments: list[str]) -> None:
    if len(arguments) < 13:
        fail("execution_manifest_arguments_missing")
    argv_path = pathlib.Path(arguments[0])
    env_path = pathlib.Path(arguments[1])
    execution_path = pathlib.Path(arguments[2])
    env_count = canonical_uint(arguments[3], "environment_count")
    tail = arguments[4:]
    if env_count > len(tail):
        fail("execution_manifest_environment_partition_invalid")
    env_pairs = tail[:env_count]
    cursor = env_count
    if (
        cursor + 4 > len(tail)
        or tail[cursor] != "--monitor-runtime"
        or tail[cursor + 2] != "--monitor-python"
    ):
        fail("execution_manifest_monitor_authority_invalid")
    monitor_runtime = pathlib.Path(tail[cursor + 1])
    monitor_python = pathlib.Path(tail[cursor + 3])
    cursor += 4
    outputs: list[tuple[str, pathlib.Path]] = []
    while cursor < len(tail) and tail[cursor] == "--output":
        if cursor + 1 >= len(tail) or "=" not in tail[cursor + 1]:
            fail("execution_manifest_output_declaration_invalid")
        role, path_text = tail[cursor + 1].split("=", 1)
        outputs.append((role, pathlib.Path(path_text)))
        cursor += 2
    if cursor >= len(tail) or tail[cursor] != "--":
        fail("execution_manifest_command_separator_missing")
    argv = tail[cursor + 1 :]
    if not argv or not os.path.isabs(argv[0]):
        fail("execution_manifest_command_invalid")
    command = pathlib.Path(argv[0])
    if str(command) != os.path.realpath(command):
        fail("execution_manifest_command_path_not_exact")
    if (
        not monitor_runtime.is_absolute()
        or str(monitor_runtime) != os.path.realpath(monitor_runtime)
        or not monitor_python.is_absolute()
        or str(monitor_python) != os.path.realpath(monitor_python)
    ):
        fail("execution_manifest_monitor_path_not_exact")
    if len({argv_path, env_path, execution_path}) != 3:
        fail("execution_manifest_output_alias")
    argv_payload = bytearray(frame(b"cheng.guard.command_argv"))
    argv_payload.extend(struct.pack(">I", len(argv)))
    for value in argv:
        argv_payload.extend(frame(os.fsencode(value)))
    argv_sha = hashlib.sha256(argv_payload).hexdigest()
    argv_lines = [
        "schema=cheng.guard.argv_manifest",
        f"count={len(argv)}",
        f"sha256={argv_sha}",
    ]
    argv_lines.extend(
        f"arg.{index}.fshex={os.fsencode(value).hex()}"
        for index, value in enumerate(argv)
    )
    env: dict[str, str] = {}
    for pair in env_pairs:
        if "=" not in pair:
            fail("execution_manifest_environment_pair_invalid")
        key, value = pair.split("=", 1)
        if (
            not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key)
            or key.startswith("BEAT_C_GUARD_")
            or key in env
        ):
            fail(f"execution_manifest_environment_key_invalid:{key}")
        env[key] = value
    keys = sorted(env, key=os.fsencode)
    env_payload = bytearray(frame(b"cheng.guard.target_env"))
    env_payload.extend(struct.pack(">I", len(keys)))
    for key in keys:
        env_payload.extend(frame(os.fsencode(key)))
        env_payload.extend(frame(os.fsencode(env[key])))
    env_sha = hashlib.sha256(env_payload).hexdigest()
    env_lines = [
        "schema=cheng.guard.env_manifest",
        f"count={len(keys)}",
        f"sha256={env_sha}",
    ]
    for index, key in enumerate(keys):
        env_lines.extend(
            (
                f"entry.{index}.key_fshex={os.fsencode(key).hex()}",
                f"entry.{index}.value_fshex={os.fsencode(env[key]).hex()}",
            )
        )

    output_roles = [role for role, _ in outputs]
    expected_order = [
        role for role in EXECUTION_OUTPUT_ROLES if role in set(output_roles)
    ]
    if (
        output_roles != expected_order
        or len(output_roles) != len(set(output_roles))
        or not set(EXECUTION_REQUIRED_OUTPUT_ROLES).issubset(output_roles)
    ):
        fail("execution_manifest_output_role_order_invalid")
    output_paths: set[pathlib.Path] = set()
    for role, output in outputs:
        if (
            role not in EXECUTION_OUTPUT_ROLES
            or not output.is_absolute()
            or str(output) != os.path.realpath(output)
            or output in output_paths
        ):
            fail(f"execution_manifest_output_path_invalid:{role}")
        try:
            output.lstat()
        except FileNotFoundError:
            pass
        except OSError as exc:
            fail(f"execution_manifest_output_preflight_failed:{role}:{exc}")
        else:
            fail(f"execution_manifest_output_not_absent:{role}")
        try:
            parent = output.parent.lstat()
        except OSError as exc:
            fail(f"execution_manifest_output_parent_missing:{role}:{exc}")
        if not stat.S_ISDIR(parent.st_mode) or stat.S_ISLNK(parent.st_mode):
            fail(f"execution_manifest_output_parent_invalid:{role}")
        output_paths.add(output)
    if (
        command in output_paths
        or monitor_runtime in output_paths
        or monitor_python in output_paths
    ):
        fail("execution_manifest_input_output_alias")

    execution_lines = ["schema=cheng.guard.execution_manifest"]
    for role, path, executable in (
        ("command", command, True),
        ("monitor_runtime", monitor_runtime, False),
        ("monitor_python", monitor_python, True),
    ):
        raw, info = stable_read(path, "execution_" + role, executable)
        append_physical_rows(
            execution_lines,
            "input." + role + ".",
            path,
            raw,
            info,
        )
    execution_lines.append(f"output_count={len(outputs)}")
    for index, (role, output) in enumerate(outputs):
        prefix = f"output.{index}."
        execution_lines.extend(
            (
                prefix + "role=" + role,
                prefix + "path_fshex=" + os.fsencode(output).hex(),
                prefix + "expected_kind=regular",
                prefix + "expected_mode=100400",
                prefix + "expected_nlink=1",
                prefix + "expected_uid=" + str(os.geteuid()),
                prefix + "expected_gid=" + str(os.getegid()),
                prefix + "pre_run_status=absent",
            )
        )
    execution_payload = ("\n".join(execution_lines) + "\n").encode()
    execution_lines.append(
        "manifest_payload_sha256=" + hashlib.sha256(execution_payload).hexdigest()
    )
    exclusive_write(argv_path, ("\n".join(argv_lines) + "\n").encode())
    exclusive_write(env_path, ("\n".join(env_lines) + "\n").encode())
    exclusive_write(execution_path, ("\n".join(execution_lines) + "\n").encode())


def load_execution_manifest(path: pathlib.Path, kind: str) -> tuple[list[bytes] | dict[bytes, bytes], str]:
    raw, _ = stable_read(path, kind + "_manifest")
    rows, _ = parse_rows(raw, kind + "_manifest")
    if kind == "argv":
        if rows.get("schema") != "cheng.guard.argv_manifest":
            fail("argv_manifest_schema_invalid")
        count = canonical_uint(rows.get("count", ""), "argv_manifest_count")
        expected = {"schema", "count", "sha256"} | {
            f"arg.{index}.fshex" for index in range(count)
        }
        if set(rows) != expected:
            fail("argv_manifest_key_set_invalid")
        values = [
            fshex_decode(rows[f"arg.{index}.fshex"], "argv_manifest_arg")
            for index in range(count)
        ]
        payload = bytearray(frame(b"cheng.guard.command_argv"))
        payload.extend(struct.pack(">I", count))
        for value in values:
            payload.extend(frame(value))
        digest = hashlib.sha256(payload).hexdigest()
        if rows["sha256"] != digest:
            fail("argv_manifest_digest_invalid")
        return values, digest
    if rows.get("schema") != "cheng.guard.env_manifest":
        fail("env_manifest_schema_invalid")
    count = canonical_uint(rows.get("count", ""), "env_manifest_count")
    expected = {"schema", "count", "sha256"}
    for index in range(count):
        expected.add(f"entry.{index}.key_fshex")
        expected.add(f"entry.{index}.value_fshex")
    if set(rows) != expected:
        fail("env_manifest_key_set_invalid")
    env: dict[bytes, bytes] = {}
    ordered: list[bytes] = []
    for index in range(count):
        key = fshex_decode(rows[f"entry.{index}.key_fshex"], "env_manifest_key")
        value = fshex_decode(rows[f"entry.{index}.value_fshex"], "env_manifest_value")
        if key in env:
            fail("env_manifest_key_duplicate")
        env[key] = value
        ordered.append(key)
    if ordered != sorted(ordered):
        fail("env_manifest_order_invalid")
    payload = bytearray(frame(b"cheng.guard.target_env"))
    payload.extend(struct.pack(">I", count))
    for key in ordered:
        payload.extend(frame(key))
        payload.extend(frame(env[key]))
    digest = hashlib.sha256(payload).hexdigest()
    if rows["sha256"] != digest:
        fail("env_manifest_digest_invalid")
    return env, digest


def load_execution_authority(path: pathlib.Path) -> dict[str, object]:
    raw, _ = stable_read(path, "execution_authority_manifest")
    rows, lines = parse_rows(raw, "execution_authority_manifest")
    if (
        rows.get("schema") != "cheng.guard.execution_manifest"
        or not lines
        or not lines[-1].startswith("manifest_payload_sha256=")
        or rows.get("manifest_payload_sha256")
        != hashlib.sha256(("\n".join(lines[:-1]) + "\n").encode()).hexdigest()
    ):
        fail("execution_authority_manifest_header_invalid")
    count = canonical_uint(
        rows.get("output_count", ""), "execution_authority_output_count"
    )
    expected_keys = {"schema", "output_count", "manifest_payload_sha256"}
    expected_order = ["schema"]
    inputs: dict[str, tuple[pathlib.Path, str, dict[str, int]]] = {}
    for role in EXECUTION_INPUT_ROLES:
        prefix = "input." + role + "."
        expected_order.extend(
            (
                prefix + "path_fshex",
                prefix + "sha256",
                *(prefix + field for field in PHYSICAL_IDENTITY_FIELDS),
            )
        )
        expected_keys.update(expected_order[-11:])
        inputs[role] = parse_physical_rows(
            rows, prefix, "execution_authority_" + role
        )
    expected_order.append("output_count")
    outputs: list[dict[str, object]] = []
    roles: list[str] = []
    paths: set[pathlib.Path] = set()
    for index in range(count):
        prefix = f"output.{index}."
        keys = (
            prefix + "role",
            prefix + "path_fshex",
            prefix + "expected_kind",
            prefix + "expected_mode",
            prefix + "expected_nlink",
            prefix + "expected_uid",
            prefix + "expected_gid",
            prefix + "pre_run_status",
        )
        expected_order.extend(keys)
        expected_keys.update(keys)
        role = rows.get(prefix + "role", "")
        path_value = pathlib.Path(
            os.fsdecode(
                fshex_decode(
                    rows.get(prefix + "path_fshex", ""),
                    "execution_authority_output_path",
                )
            )
        )
        mode = canonical_octal(
            rows.get(prefix + "expected_mode", ""),
            "execution_authority_output_mode",
        )
        nlink = canonical_uint(
            rows.get(prefix + "expected_nlink", ""),
            "execution_authority_output_nlink",
        )
        uid = canonical_uint(
            rows.get(prefix + "expected_uid", ""),
            "execution_authority_output_uid",
        )
        gid = canonical_uint(
            rows.get(prefix + "expected_gid", ""),
            "execution_authority_output_gid",
        )
        if (
            role not in EXECUTION_OUTPUT_ROLES
            or role in roles
            or not path_value.is_absolute()
            or str(path_value) != os.path.realpath(path_value)
            or path_value in paths
            or rows.get(prefix + "expected_kind") != "regular"
            or mode != stat.S_IFREG | 0o400
            or nlink != 1
            or uid != os.geteuid()
            or gid != os.getegid()
            or rows.get(prefix + "pre_run_status") != "absent"
        ):
            fail(f"execution_authority_output_invalid:{index}")
        roles.append(role)
        paths.add(path_value)
        outputs.append(
            {
                "role": role,
                "path": path_value,
                "mode": mode,
                "nlink": nlink,
                "uid": uid,
                "gid": gid,
            }
        )
    filtered_roles = [
        role for role in EXECUTION_OUTPUT_ROLES if role in set(roles)
    ]
    if (
        roles != filtered_roles
        or not set(EXECUTION_REQUIRED_OUTPUT_ROLES).issubset(roles)
    ):
        fail("execution_authority_output_role_order_invalid")
    expected_order.append("manifest_payload_sha256")
    if set(rows) != expected_keys or lines != [
        key + "=" + rows[key] for key in expected_order
    ]:
        fail("execution_authority_manifest_shape_invalid")
    return {"inputs": inputs, "outputs": outputs}


def validate_execution(arguments: list[str]) -> None:
    if len(arguments) != 5:
        fail("validate_execution_arguments_invalid")
    guard_path, argv_path, env_path, authority_path, command_path = map(
        pathlib.Path, arguments
    )
    guard_raw, guard_info = stable_read(guard_path, "guard_report")
    rows, _ = parse_rows(guard_raw, "guard_report")
    argv, argv_sha = load_execution_manifest(argv_path, "argv")
    env, env_sha = load_execution_manifest(env_path, "env")
    authority = load_execution_authority(authority_path)
    declared_inputs = authority["inputs"]
    declared_outputs = authority["outputs"]
    if not isinstance(declared_inputs, dict) or not isinstance(declared_outputs, list):
        fail("execution_authority_internal_shape_invalid")

    live_inputs: dict[str, tuple[pathlib.Path, bytes, os.stat_result]] = {}
    for role in EXECUTION_INPUT_ROLES:
        declared_path, declared_sha, declared_identity = declared_inputs[role]
        executable = role in ("command", "monitor_python")
        current_raw, current_info = stable_read(
            declared_path, "execution_" + role, executable
        )
        verify_physical(
            current_raw,
            current_info,
            declared_sha,
            declared_identity,
            "execution_" + role,
        )
        live_inputs[role] = (declared_path, current_raw, current_info)
    declared_command, command_raw, command_info = live_inputs["command"]
    command_sha = hashlib.sha256(command_raw).hexdigest()
    if command_path != declared_command:
        fail("guard_execution_command_argument_mismatch")
    expected = {
        "schema": "beat_c_process_memory_guard",
        "status": "completed",
        "rc": "0",
        "abort_reason": "",
        "expected_exit_code": "0",
        "actual_exit_code": "0",
        "exit_code_contract_status": "verified",
        "command_identity_status": "available",
        "command_identity_error": "",
        "formal_command_identity_status": "required_verified",
        "command_execution_snapshot_schema": "cheng.guard.command_snapshot",
        "command_execution_mode": "private_single_link_snapshot",
        "command_argv_schema": "cheng.guard.command_argv",
        "target_env_schema": "cheng.guard.target_env",
        "target_env_mode": "exact",
        "target_env_requested_schema": "cheng.guard.target_env.requested",
        "expected_command_sha256": command_sha,
        "command_path": str(declared_command),
        "command_sha256": command_sha,
        "command_argv_count": str(len(argv)),
        "command_argv_sha256": argv_sha,
        "target_env_requested_count": str(len(env)),
        "target_env_requested_sha256": env_sha,
        "target_env_injected_parent_schema":
