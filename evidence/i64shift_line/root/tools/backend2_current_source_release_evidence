def darwin_bootstrap_binding_projection(
    binding: dict[str, str],
    *,
    revalidate_authority: bool,
) -> dict[str, str]:
    if set(DARWIN_BOOTSTRAP_BINDING_KEYS) - set(binding):
        fail("darwin_bootstrap_binding_missing")
    if (
        binding["darwin_bootstrap_lane"] != "darwin"
        or require_uint(
            binding["darwin_bootstrap_phase_count"],
            "darwin_bootstrap_phase_count",
            positive=True,
        )
        != DARWIN_BOOTSTRAP_PHASE_COUNT
        or binding["darwin_bootstrap_stage3_sha256"]
        != binding.get("baseline_driver_sha256")
    ):
        fail("darwin_bootstrap_binding_header_invalid")
    for key in (
        "darwin_bootstrap_lane_receipt_sha256",
        "darwin_bootstrap_lane_validator_sha256",
        "darwin_bootstrap_phase_chain_sha256",
        "darwin_bootstrap_guard_aggregate_sha256",
        "darwin_bootstrap_stage3_sha256",
    ):
        value = require_sha(binding[key], key)
        if key in (
            "darwin_bootstrap_phase_chain_sha256",
            "darwin_bootstrap_guard_aggregate_sha256",
        ) and value == ZERO_SHA256:
            fail("darwin_bootstrap_binding_aggregate_zero:" + key)
    receipt_path = fs_path(
        binding["darwin_bootstrap_lane_receipt_path_fshex"],
        "darwin_bootstrap_lane_receipt",
    )
    receipt_state = stable_read(
        receipt_path, "darwin_bootstrap_lane_receipt"
    )
    physical = {
        "darwin_bootstrap_lane_receipt_sha256": receipt_state.sha256,
        "darwin_bootstrap_lane_receipt_device":
            str(receipt_state.info.st_dev),
        "darwin_bootstrap_lane_receipt_inode":
            str(receipt_state.info.st_ino),
        "darwin_bootstrap_lane_receipt_mode":
            format(receipt_state.info.st_mode, "o"),
        "darwin_bootstrap_lane_receipt_nlink":
            str(receipt_state.info.st_nlink),
        "darwin_bootstrap_lane_receipt_size":
            str(receipt_state.info.st_size),
        "darwin_bootstrap_lane_receipt_uid":
            str(receipt_state.info.st_uid),
        "darwin_bootstrap_lane_receipt_gid":
            str(receipt_state.info.st_gid),
        "darwin_bootstrap_lane_receipt_mtime_ns":
            str(receipt_state.info.st_mtime_ns),
        "darwin_bootstrap_lane_receipt_ctime_ns":
            str(receipt_state.info.st_ctime_ns),
    }
    for key, value in physical.items():
        if binding[key] != value:
            fail("darwin_bootstrap_binding_physical_invalid:" + key)
    observed_payload, _ = darwin_bootstrap_lane_receipt(receipt_path)
    expected_payload = {
        "darwin_bootstrap_phase_chain_sha256":
            str(observed_payload["phaseChainSha256"]),
        "darwin_bootstrap_guard_aggregate_sha256":
            str(observed_payload["guardAggregateSha256"]),
        "darwin_bootstrap_stage3_sha256":
            str(observed_payload["stage3"]["sha256"]),
        "darwin_bootstrap_lane_validator_sha256": stable_read(
            BOOTSTRAP_PRODUCTION_GATE,
            "darwin_bootstrap_lane_validator",
            executable=True,
        ).sha256,
    }
    for key, value in expected_payload.items():
        if binding[key] != value:
            fail("darwin_bootstrap_binding_payload_invalid:" + key)
    if revalidate_authority:
        observed = bootstrap_darwin_lane_binding(
            receipt_path, binding["baseline_driver_sha256"]
        )
        if any(binding[key] != observed[key] for key in observed):
            fail("darwin_bootstrap_binding_authority_drift")
    return {key: binding[key] for key in DARWIN_BOOTSTRAP_BINDING_KEYS}


