@dataclass(frozen=True)
class FileState:
    path: pathlib.Path
    raw: bytes
    sha256: str
    info: os.stat_result


@dataclass(frozen=True)
class PreparedPublication:
    work_root: pathlib.Path
    publish_root: pathlib.Path
    anchor: pathlib.Path
    anchor_identity: tuple[int, ...]
    parent_identity: tuple[int, ...]
    work_root_identity: tuple[int, ...]
    manifest_raw: bytes
    receipt_raw: bytes


_PUBLICATION_PATH_PROJECTION: tuple[pathlib.Path, pathlib.Path] | None = None


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def renamed_directory_identity_matches(
    before: tuple[int, ...],
    after: tuple[int, ...],
) -> bool:
    return before[:-1] == after[:-1] and after[-1] >= before[-1]


def directory_authority(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
    )


def publication_anchor_path(publish_root: pathlib.Path) -> pathlib.Path:
    if not publish_root.is_absolute() or not publish_root.name:
        fail("publication_publish_root_not_absolute")
    raw_name = os.fsencode(publish_root.name)
    try:
        raw_name.decode("utf-8", "strict")
    except UnicodeDecodeError:
        fail("publication_publish_root_name_not_utf8")
    encoded_name = raw_name.hex()
    anchor_name = (
        PUBLICATION_ANCHOR_PREFIX
        + encoded_name
        + PUBLICATION_ANCHOR_SUFFIX
    )
    try:
        name_max = os.pathconf(publish_root.parent, "PC_NAME_MAX")
    except (OSError, ValueError) as exc:
        fail("publication_anchor_name_limit_unavailable:" + str(exc))
    if len(os.fsencode(anchor_name)) > name_max:
        fail("publication_anchor_name_too_long")
    return publish_root.parent / anchor_name


def physical_publication_path(path: pathlib.Path) -> pathlib.Path:
    projection = _PUBLICATION_PATH_PROJECTION
    if projection is None or not path.is_absolute():
        return path
    work_root, publish_root = projection
    try:
        relative = path.relative_to(publish_root)
    except ValueError:
        return path
    return work_root / relative


@contextlib.contextmanager
def publication_path_projection(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
):
    global _PUBLICATION_PATH_PROJECTION
    if _PUBLICATION_PATH_PROJECTION is not None:
        fail("publication_path_projection_nested")
    _PUBLICATION_PATH_PROJECTION = (work_root, publish_root)
    try:
        yield
    finally:
        _PUBLICATION_PATH_PROJECTION = None


def canonical_existing(path: pathlib.Path, label: str, directory: bool = False) -> pathlib.Path:
    path = physical_publication_path(path)
    if not path.is_absolute():
        fail(label + "_not_absolute")
    resolved = pathlib.Path(os.path.realpath(path))
    if resolved != path:
        fail(label + "_not_canonical")
    try:
        info = path.lstat()
    except OSError as exc:
        fail(f"{label}_missing:{exc}")
    if stat.S_ISLNK(info.st_mode):
        fail(label + "_symlink")
    if directory and not stat.S_ISDIR(info.st_mode):
        fail(label + "_not_directory")
    if not directory and not stat.S_ISREG(info.st_mode):
        fail(label + "_not_regular")
    return path


def stable_read(
    path: pathlib.Path,
    label: str,
    *,
    executable: bool = False,
    single_link: bool = True,
) -> FileState:
    path = canonical_existing(path, label)
    before = path.lstat()
    if (
        (single_link and before.st_nlink != 1)
        or (executable and before.st_mode & 0o111 == 0)
    ):
        fail(label + "_identity_invalid")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(
        os, "O_NOFOLLOW", 0
    )
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            fail(label + "_open_race")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            chunks.append(chunk)
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    if identity(before) != identity(closed) or identity(before) != identity(after):
        fail(label + "_read_race")
    raw = b"".join(chunks)
    if len(raw) != before.st_size or hashlib.sha256(raw).digest() != digest.digest():
        fail(label + "_short_read")
    return FileState(path, raw, hashlib.sha256(raw).hexdigest(), before)


def exclusive_write(path: pathlib.Path, raw: bytes, mode: int = 0o400) -> None:
    if not path.is_absolute():
        fail("output_not_absolute")
    parent = canonical_existing(path.parent, "output_parent", directory=True)
    if path != parent / path.name:
        fail("output_not_canonical")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(path, flags, mode)
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail("output_short_write")
            view = view[written:]
        os.fsync(descriptor)
        current = os.fstat(descriptor)
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_nlink != 1
            or current.st_size != len(raw)
        ):
            fail("output_identity_invalid")
    finally:
        os.close(descriptor)
    directory_descriptor = os.open(parent, os.O_RDONLY)
    try:
        os.fsync(directory_descriptor)
    finally:
        os.close(directory_descriptor)


def parse_rows(raw: bytes, label: str) -> tuple[dict[str, str], list[str]]:
    if not raw or not raw.endswith(b"\n") or b"\0" in raw or b"\r" in raw:
        fail(label + "_encoding_invalid")
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as exc:
        fail(f"{label}_utf8_invalid:{exc}")
    rows: dict[str, str] = {}
    for line in lines:
        if "=" not in line:
            fail(label + "_row_invalid")
        key, value = line.split("=", 1)
        if not KEY_RE.fullmatch(key) or key in rows:
            fail(label + "_key_invalid_or_duplicate:" + key)
        rows[key] = value
    return rows, lines


def read_rows(
    path: pathlib.Path, label: str, payload_key: str | None = None
) -> tuple[dict[str, str], FileState]:
    state = stable_read(path, label)
    rows, lines = parse_rows(state.raw, label)
    if payload_key is not None:
        if not lines[-1].startswith(payload_key + "="):
            fail(label + "_payload_row_not_last")
        payload = ("\n".join(lines[:-1]) + "\n").encode()
        if rows.get(payload_key) != hashlib.sha256(payload).hexdigest():
            fail(label + "_payload_digest_invalid")
    return rows, state


def require_sha(value: str, label: str) -> str:
    if not SHA_RE.fullmatch(value):
        fail(label + "_sha_invalid")
    return value


def require_uint(value: str, label: str, *, positive: bool = False) -> int:
    if not re.fullmatch(r"0|[1-9][0-9]*", value):
        fail(label + "_uint_invalid")
    result = int(value)
    if positive and result <= 0:
        fail(label + "_must_be_positive")
    return result


def decoded_fs_path(value: str, label: str) -> pathlib.Path:
    if not value or len(value) % 2 or not re.fullmatch(r"[0-9a-f]+", value):
        fail(label + "_fshex_invalid")
    try:
        raw = bytes.fromhex(value)
    except ValueError as exc:
        fail(f"{label}_fshex_invalid:{exc}")
    return pathlib.Path(os.fsdecode(raw))


def fs_path(value: str, label: str) -> pathlib.Path:
    return physical_publication_path(decoded_fs_path(value, label))


def require_exact_keys(
    rows: dict[str, str], expected: set[str], label: str
) -> None:
    if set(rows) != expected:
        missing = sorted(expected - set(rows))
        extra = sorted(set(rows) - expected)
        fail(
            f"{label}_key_set_invalid:"
            f"missing_{','.join(missing)}:extra_{','.join(extra)}"
        )


def require_descendant(
    path: pathlib.Path, root: pathlib.Path, label: str, *, directory: bool = False
) -> pathlib.Path:
    root = physical_publication_path(root)
    path = canonical_existing(path, label, directory=directory)
    try:
        path.relative_to(root)
    except ValueError:
        fail(label + "_outside_release_root")
    return path


def rendered(lines: list[str], payload_key: str) -> bytes:
    payload = ("\n".join(lines) + "\n").encode()
    return payload + f"{payload_key}={hashlib.sha256(payload).hexdigest()}\n".encode()


def canonical_json_object(
    state: FileState, label: str
) -> dict[str, object]:
    try:
        value = json.loads(state.raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"{label}_json_invalid:{exc}")
    if not isinstance(value, dict):
        fail(label + "_json_object_required")
    canonical = (
        json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
        + b"\n"
    )
    if state.raw != canonical:
        fail(label + "_json_not_canonical")
    return value


def canonical_json_raw(value: object) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")


def darwin_bootstrap_lane_receipt(
    path: pathlib.Path,
) -> tuple[dict[str, object], FileState]:
    state = stable_read(path, "darwin_bootstrap_lane_receipt")
    expected_path = (
        path.parent.parent / DARWIN_BOOTSTRAP_LANE_RECEIPT_RELATIVE
    )
    if path != expected_path:
        fail("darwin_bootstrap_lane_receipt_location_invalid")
    envelope = canonical_json_object(
        state, "darwin_bootstrap_lane_receipt"
    )
    if set(envelope) != {"payload", "payloadSha256"}:
        fail("darwin_bootstrap_lane_envelope_shape_invalid")
    payload = envelope.get("payload")
    if not isinstance(payload, dict) or set(payload) != {
        "schema",
        "lane",
        "targetTriple",
        "machineAuthority",
        "status",
        "memoryProofStatus",
        "sourceSnapshotCid",
        "chengColdSha256",
        "bootstrapContractSha256",
        "selfCheckContractHash",
        "generatedCPortableCid",
        "generatedCRawSha256",
        "stageFixedPointSha256",
        "phaseChainSha256",
        "cgroupReceiptSha256",
        "ptraceAggregateSha256",
        "guardAggregateSha256",
        "stage3",
    }:
        fail("darwin_bootstrap_lane_payload_shape_invalid")
    payload_sha256 = require_sha(
        str(envelope.get("payloadSha256", "")),
        "darwin_bootstrap_lane_payload",
    )
    if payload_sha256 != hashlib.sha256(
        canonical_json_raw(payload)
    ).hexdigest():
        fail("darwin_bootstrap_lane_payload_digest_invalid")
    fixed = {
        "schema": DARWIN_BOOTSTRAP_LANE_SCHEMA,
        "lane": "darwin",
        "targetTriple": "arm64-apple-darwin",
        "machineAuthority": "macho-cputype-16777228",
        "status": "VERIFIED",
        "memoryProofStatus": "not_provable_userspace_poll",
        "cgroupReceiptSha256": ZERO_SHA256,
        "ptraceAggregateSha256": ZERO_SHA256,
    }
    for key, value in fixed.items():
        if payload.get(key) != value:
            fail("darwin_bootstrap_lane_field_invalid:" + key)
    for key in (
        "sourceSnapshotCid",
        "chengColdSha256",
        "bootstrapContractSha256",
        "generatedCPortableCid",
        "generatedCRawSha256",
        "stageFixedPointSha256",
        "phaseChainSha256",
        "guardAggregateSha256",
    ):
        value = require_sha(
            str(payload.get(key, "")), "darwin_bootstrap_lane_" + key
        )
        if key in ("phaseChainSha256", "guardAggregateSha256"):
            if value == ZERO_SHA256:
                fail("darwin_bootstrap_lane_aggregate_zero:" + key)
    if re.fullmatch(
        r"[0-9a-f]{16}", str(payload.get("selfCheckContractHash", ""))
    ) is None:
        fail("darwin_bootstrap_self_check_contract_hash_invalid")
    stage3 = payload.get("stage3")
    stage3_keys = {
        "pathFshex",
        "sha256",
        "device",
        "inode",
        "mode",
        "nlink",
        "size",
        "uid",
        "gid",
        "format",
    }
    if not isinstance(stage3, dict) or set(stage3) != stage3_keys:
        fail("darwin_bootstrap_stage3_shape_invalid")
    if (
        stage3.get("format") != "macho64-arm64-darwin"
        or payload["stageFixedPointSha256"] != stage3.get("sha256")
    ):
        fail("darwin_bootstrap_stage3_format_or_fixed_point_invalid")
    stage3_path = fs_path(
        str(stage3.get("pathFshex", "")), "darwin_bootstrap_stage3"
    )
    stage3_state = stable_read(
        stage3_path, "darwin_bootstrap_stage3", executable=True
    )
    stage3_expected = {
        "sha256": stage3_state.sha256,
        "device": stage3_state.info.st_dev,
        "inode": stage3_state.info.st_ino,
        "mode": stage3_state.info.st_mode,
        "nlink": stage3_state.info.st_nlink,
        "size": stage3_state.info.st_size,
        "uid": stage3_state.info.st_uid,
        "gid": stage3_state.info.st_gid,
    }
    for key, value in stage3_expected.items():
        if stage3.get(key) != value:
            fail("darwin_bootstrap_stage3_identity_invalid:" + key)
    return payload, state


def bootstrap_darwin_lane_binding(
    receipt_path: pathlib.Path,
    baseline_driver_sha256: str,
) -> dict[str, str]:
    baseline_driver_sha256 = require_sha(
        baseline_driver_sha256, "darwin_bootstrap_baseline_driver"
    )
    payload, before = darwin_bootstrap_lane_receipt(receipt_path)
    gate_state = stable_read(
        BOOTSTRAP_PRODUCTION_GATE,
        "darwin_bootstrap_lane_validator",
        executable=True,
    )
    python_state = stable_read(
        BOOTSTRAP_VALIDATOR_PYTHON,
        "darwin_bootstrap_validator_python",
        executable=True,
        single_link=False,
    )
    evidence_root = receipt_path.parent.parent
    completed = subprocess.run(
        [
            str(BOOTSTRAP_VALIDATOR_PYTHON),
            "-I",
            "-S",
            "-B",
            str(BOOTSTRAP_PRODUCTION_GATE),
            "--validate-darwin-evidence",
            "--evidence-dir",
            str(evidence_root),
        ],
        env=dict(BOOTSTRAP_VALIDATOR_ENV),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    payload_after, after = darwin_bootstrap_lane_receipt(receipt_path)
    gate_after = stable_read(
        BOOTSTRAP_PRODUCTION_GATE,
        "darwin_bootstrap_lane_validator",
        executable=True,
    )
    python_after = stable_read(
        BOOTSTRAP_VALIDATOR_PYTHON,
        "darwin_bootstrap_validator_python",
        executable=True,
        single_link=False,
    )
    if (
        completed.returncode != 0
        or completed.stderr
        or completed.stdout != before.raw
        or payload_after != payload
        or identity(before.info) != identity(after.info)
        or gate_after.sha256 != gate_state.sha256
        or identity(gate_after.info) != identity(gate_state.info)
        or python_after.sha256 != python_state.sha256
        or identity(python_after.info) != identity(python_state.info)
    ):
        fail("darwin_bootstrap_lane_physical_validation_failed")
