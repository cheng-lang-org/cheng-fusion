def main() -> None:
    args = parser().parse_args()
    if args.command == "contract":
        exclusive_write(pathlib.Path(args.out), contract_raw())
    elif args.command == "validate-contract":
        validate_contract(pathlib.Path(args.contract))
    elif args.command == "native-worker":
        produce_native_worker_receipt(args)
    elif args.command == "native-descriptor":
        produce_native_descriptor(args)
    elif args.command == "preflight":
        preflight(args)
    elif args.command == "validate":
        validate_completion(pathlib.Path(args.evidence_root))
    elif args.command == "publish":
        receipt = publish(
            pathlib.Path(args.evidence_root),
            pathlib.Path(args.publish_root),
        )
        print("publisher_receipt=" + str(receipt))
    elif args.command == "validate-published":
        validate_published(pathlib.Path(args.receipt))
    elif args.command == "seal-source-closure":
        seal_source_closure(
            pathlib.Path(args.evidence_root),
            pathlib.Path(args.source_closure),
        )
    elif args.command == "performance-verdict":
        produce_performance_verdict(args)
    else:
        fail("command_invalid")


if __name__ == "__main__":
    try:
        main()
    except (ReleaseError, OSError, ValueError, KeyError) as error:
        print(
            "backend2_current_source_release_evidence_error=" + str(error),
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
