def host_identity() -> tuple[str, str, bool]:
    host_os = platform.system().lower()
    machine = platform.machine().lower()
    translated = False
    if host_os == "darwin":
        completed = subprocess.run(
            ["/usr/sbin/sysctl", "-n", "sysctl.proc_translated"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if completed.returncode == 0:
            translated = completed.stdout.strip() == b"1"
    return host_os, machine, translated


def normalized_machine(value: str) -> str:
    machine = {
        "amd64": "x86_64",
        "x86_64": "x86_64",
        "arm64": "aarch64",
        "aarch64": "aarch64",
    }.get(value.lower())
    if machine is None:
        fail("controller_host_machine_unsupported:" + value)
    return machine


def require_native_controller_host(expected_machine: str) -> None:
    host_os, host_machine_raw, translated = host_identity()
    host_machine = normalized_machine(host_machine_raw)
    if host_os != "linux":
        fail("native_controller_host_os_invalid:" + host_os)
    if host_machine != expected_machine:
        fail(
            "native_controller_host_machine_mismatch:"
            + host_machine
            + ":"
            + expected_machine
        )
    if translated:
        fail("native_controller_host_translated")


def official_binding(receipt: pathlib.Path) -> dict[str, str]:
    completed = subprocess.run(
        [str(OFFICIAL_VALIDATOR), "validate", str(receipt)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        fail("official_publisher_receipt_invalid")
    receipt_rows, receipt_state = read_rows(
        receipt, "official_publisher_receipt", "receipt_payload_sha256"
    )
    producer_root = fs_path(
        receipt_rows["producer_root_fshex"], "official_producer_root"
    )
    raw_root = producer_root / "raw"
    summary_rows, summary_state = read_rows(raw_root / "summary.kv", "official_summary")
    fixed_rows, fixed_state = read_rows(
        raw_root / "backend-driver.gen2-gen3.fixed-point.kv",
        "official_fixed_point",
    )
    candidate_rows, candidate_state = read_rows(
        raw_root / "backend-driver.current.report.kv",
        "official_candidate_report",
    )
    required_report = (
        "regalloc_action_emission_ledger_path",
        "regalloc_action_emission_ledger_sha256",
        "regalloc_frozen_plan_snapshot_path",
        "regalloc_frozen_plan_snapshot_sha256",
        "regalloc_receipt_sha256",
        "regalloc_action_count",
        "regalloc_action_ack_count",
        "regalloc_unacknowledged_action_count",
        "regalloc_plan_function_count",
        "regalloc_frozen_plan_count",
    )
    for key in required_report:
        if key not in candidate_rows:
            fail("official_candidate_report_missing:" + key)
    action_count = require_uint(
        candidate_rows["regalloc_action_count"], "regalloc_action_count", positive=True
    )
    if (
        require_uint(
            candidate_rows["regalloc_action_ack_count"],
            "regalloc_action_ack_count",
            positive=True,
        )
        != action_count
        or candidate_rows["regalloc_unacknowledged_action_count"] != "0"
        or require_uint(
            candidate_rows["regalloc_plan_function_count"],
            "regalloc_plan_function_count",
            positive=True,
        )
        != require_uint(
            candidate_rows["regalloc_frozen_plan_count"],
            "regalloc_frozen_plan_count",
            positive=True,
        )
    ):
        fail("official_regalloc_action_fragment_balance_invalid")
    action_path = pathlib.Path(
        candidate_rows["regalloc_action_emission_ledger_path"]
    )
    fragment_path = pathlib.Path(candidate_rows["regalloc_frozen_plan_snapshot_path"])
    action_state = stable_read(action_path, "official_action_ledger")
    fragment_state = stable_read(fragment_path, "official_fragment_snapshot")
    if (
        action_state.sha256
        != require_sha(
            candidate_rows["regalloc_action_emission_ledger_sha256"],
            "official_action_ledger",
        )
        or fragment_state.sha256
        != require_sha(
            candidate_rows["regalloc_frozen_plan_snapshot_sha256"],
            "official_fragment_snapshot",
        )
    ):
        fail("official_action_fragment_artifact_mismatch")
    return {
        "_official_driver_path_fshex": receipt_rows[
            "official_driver_path_fshex"
        ],
        "official_receipt_sha256": receipt_state.sha256,
        "official_driver_sha256": require_sha(
            receipt_rows["official_driver_sha256"], "official_driver"
        ),
        "snapshot_manifest_sha256": require_sha(
            summary_rows["snapshot_manifest_sha256"], "snapshot_manifest"
        ),
        "_official_source_closure_capture_sha256": require_sha(
            summary_rows["current_source_closure_sha256"],
            "source_closure_capture",
        ),
        "backend_epoch_sha256": require_sha(
            summary_rows["backend2_epoch_raw_manifest_sha256"], "backend_epoch"
        ),
        "jobs_sha256": require_sha(
            summary_rows["backend2_jobs_raw_manifest_sha256"], "backend_jobs"
        ),
        "action_ledger_sha256": action_state.sha256,
        "fragment_snapshot_sha256": fragment_state.sha256,
        "regalloc_receipt_sha256": require_sha(
            candidate_rows["regalloc_receipt_sha256"], "regalloc_receipt"
        ),
        "fixed_point_sha256": fixed_state.sha256,
        "fixed_object_sha256": require_sha(fixed_rows["gen2_sha256"], "fixed_object"),
        "candidate_report_sha256": candidate_state.sha256,
    }


def seven_stage_binding(
    output: pathlib.Path,
    harness_manifest: pathlib.Path,
    source_manifest: pathlib.Path,
    official_driver: pathlib.Path,
    binding: dict[str, str],
) -> dict[str, str]:
    output = canonical_existing(output, "seven_stage_output", directory=True)
    evidence_root = output / "seven-stage"
    paths = {
        "parser_ingress": output / "parser-ingress-report.json",
        "parser_map": output / "parser-map.json",
        "execution_policy": output / "execution-policy.json",
        "runner_manifest": output / "runner-manifest.json",
        "runner_report": output / "runner-report.json",
    }
    source_state = stable_read(source_manifest, "seven_stage_source_manifest")
    driver_state = stable_read(
        official_driver, "seven_stage_official_driver", executable=True
    )
    stable_read(harness_manifest, "seven_stage_parser_harness")
    if (
        source_state.sha256 != binding["snapshot_manifest_sha256"]
        or driver_state.sha256 != binding["official_driver_sha256"]
    ):
        fail("seven_stage_official_source_identity_mismatch")
    command = [
        str(SEVEN_STAGE_VALIDATOR),
        "validate-runner-report",
        "--evidence-root",
        str(evidence_root),
        "--parser-ingress-report",
        str(paths["parser_ingress"]),
        "--parser-map",
        str(paths["parser_map"]),
        "--source-manifest",
        str(source_manifest),
        "--official-driver",
        str(official_driver),
        "--parser-harness-manifest",
        str(harness_manifest),
        "--execution-policy",
        str(paths["execution_policy"]),
        "--runner-manifest",
        str(paths["runner_manifest"]),
        "--report",
        str(paths["runner_report"]),
    ]
    def validate_current_inputs() -> None:
        completed = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if completed.returncode != 0:
            fail("seven_stage_runner_report_invalid")

    validate_current_inputs()
    states = {
        label: stable_read(path, "seven_stage_" + label)
        for label, path in paths.items()
    }
    validate_current_inputs()
    for label, path in paths.items():
        current = stable_read(path, "seven_stage_" + label + "_post")
        if identity(current.info) != identity(states[label].info):
            fail("seven_stage_input_changed_during_binding:" + label)
    runner = canonical_json_object(
        states["runner_manifest"], "seven_stage_runner_manifest"
    )
    if set(runner) != {
        "schema",
        "implemented",
        "status",
        "parserIngressRaw32",
        "parserMapRaw32",
        "sourceBundleRaw32",
        "compilerSourceClosureRaw32",
        "toolchainManifestRaw32",
        "officialDriverRaw32",
        "executionRaw32",
        "sevenStageRootRaw32",
        "stages",
        "manifestRaw32",
    }:
        fail("seven_stage_runner_manifest_keys_invalid")
    if (
        runner.get("schema") != "cheng_current_official_seven_stage_manifest"
        or runner.get("implemented") is not True
        or runner.get("status") != "COMPLETE"
        or runner.get("sourceBundleRaw32") != source_state.sha256
        or runner.get("compilerSourceClosureRaw32") != source_state.sha256
        or runner.get("officialDriverRaw32") != driver_state.sha256
    ):
        fail("seven_stage_runner_manifest_identity_invalid")
    execution_raw32 = require_sha(
        str(runner.get("executionRaw32", "")),
        "seven_stage_execution",
    )
    root_raw32 = require_sha(
        str(runner.get("sevenStageRootRaw32", "")),
        "seven_stage_root",
    )
    toolchain_raw32 = require_sha(
        str(runner.get("toolchainManifestRaw32", "")),
        "seven_stage_toolchain",
    )
    stages = runner.get("stages")
    stage_names = (
        "typed_expr",
        "csg",
        "lowering",
        "primary",
        "primary_regalloc",
        "backend2",
        "backend2_regalloc",
    )
    if not isinstance(stages, list) or len(stages) != len(stage_names):
        fail("seven_stage_runner_stage_count_invalid")
    receipt_roots: list[str] = []
    for index, expected_name in enumerate(stage_names):
        stage = stages[index]
        if not isinstance(stage, dict) or set(stage) != {
            "stageOrdinal",
            "stageKind",
            "executionRaw32",
            "sourceBundleRaw32",
            "compilerSourceClosureRaw32",
            "toolchainManifestRaw32",
            "ingressRaw32",
            "actionRaw32",
            "fragmentRaw32",
            "objectRaw32",
            "receiptRaw32",
        }:
            fail("seven_stage_runner_stage_keys_invalid:" + expected_name)
        if (
            type(stage["stageOrdinal"]) is not int
            or stage["stageOrdinal"] != index + 1
            or stage["stageKind"] != expected_name
            or stage["executionRaw32"] != execution_raw32
            or stage["sourceBundleRaw32"] != source_state.sha256
            or stage["compilerSourceClosureRaw32"] != source_state.sha256
            or stage["toolchainManifestRaw32"] != toolchain_raw32
        ):
            fail("seven_stage_runner_stage_identity_invalid:" + expected_name)
        for key in (
            "ingressRaw32",
            "actionRaw32",
            "fragmentRaw32",
            "objectRaw32",
            "receiptRaw32",
        ):
            require_sha(str(stage.get(key, "")), expected_name + "_" + key)
        if stage["fragmentRaw32"] != stage["receiptRaw32"]:
            fail("seven_stage_runner_fragment_receipt_mismatch:" + expected_name)
        receipt_roots.append(str(stage["receiptRaw32"]))
    if len(set(receipt_roots)) != len(receipt_roots):
        fail("seven_stage_runner_receipt_alias")
    if (
        receipt_roots[3] == receipt_roots[5]
        or receipt_roots[4] == receipt_roots[6]
    ):
        fail("seven_stage_backend_receipts_not_independent")
    report_state = states["runner_report"]
    try:
        report = json.loads(report_state.raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ReleaseError("seven_stage_runner_report_json_invalid") from exc
    if not isinstance(report, dict) or set(report) != {
        "schema",
        "status",
        "reason",
        "consumerImplemented",
        "upstreamImplemented",
        "parserIngressRaw32",
        "parserMapRaw32",
        "sourceBundleRaw32",
        "officialDriverRaw32",
        "executionRaw32",
        "sevenStageRootRaw32",
        "policyRaw32",
        "runnerManifestRaw32",
        "verifiedStageCount",
    }:
        fail("seven_stage_runner_report_keys_invalid")
    if (
        report.get("schema") != "cheng_current_official_seven_stage_runner"
        or report.get("status") != "ADMITTED"
        or report.get("reason") != ""
        or report.get("consumerImplemented") is not True
        or report.get("upstreamImplemented") is not True
        or report.get("sourceBundleRaw32") != source_state.sha256
        or report.get("officialDriverRaw32") != driver_state.sha256
        or report.get("executionRaw32") != execution_raw32
        or report.get("sevenStageRootRaw32") != root_raw32
        or report.get("policyRaw32") != states["execution_policy"].sha256
        or report.get("runnerManifestRaw32")
        != states["runner_manifest"].sha256
        or type(report.get("verifiedStageCount")) is not int
        or report.get("verifiedStageCount") != len(stage_names)
    ):
        fail("seven_stage_runner_report_identity_invalid")
    if (
        report.get("parserIngressRaw32") != states["parser_ingress"].sha256
        or report.get("parserMapRaw32") != states["parser_map"].sha256
        or runner.get("parserIngressRaw32") != states["parser_ingress"].sha256
        or runner.get("parserMapRaw32") != states["parser_map"].sha256
    ):
        fail("seven_stage_parser_identity_invalid")
    return {
        "seven_stage_parser_ingress_sha256": states[
            "parser_ingress"
        ].sha256,
        "seven_stage_parser_map_sha256": states["parser_map"].sha256,
        "seven_stage_policy_sha256": states["execution_policy"].sha256,
        "seven_stage_runner_manifest_sha256": states[
            "runner_manifest"
        ].sha256,
        "seven_stage_report_sha256": report_state.sha256,
        "seven_stage_execution_raw32": execution_raw32,
        "seven_stage_root_raw32": root_raw32,
    }


def baseline_binding(manifest: pathlib.Path) -> dict[str, str]:
    rows, state = read_rows(manifest, "baseline_manifest", "manifest_payload_sha256")
    expected = {
        "schema": "regalloc_driver_manifest",
        "role": "immutable_baseline",
        "target": "aarch64-apple-darwin",
    }
    for key, value in expected.items():
        if rows.get(key) != value:
            fail("baseline_manifest_field_invalid:" + key)
    driver = pathlib.Path(rows.get("driver_path", ""))
    driver_state = stable_read(driver, "baseline_driver", executable=True)
    if driver_state.sha256 != require_sha(
        rows.get("driver_sha256", ""), "baseline_driver"
    ):
        fail("baseline_driver_digest_mismatch")
    return {
        "baseline_manifest_sha256": state.sha256,
        "baseline_driver_sha256": driver_state.sha256,
    }


