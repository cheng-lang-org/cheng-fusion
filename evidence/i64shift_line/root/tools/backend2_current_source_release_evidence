    binding: dict[str, str],
) -> tuple[FileState, dict[str, str]]:
    rows, state = read_rows(path, "native_descriptor", "descriptor_payload_sha256")
    required = native_descriptor_required(
        expected_target=expected_target,
        expected_machine=expected_machine,
        binding=binding,
        workload_kind=expected_workload_kind,
    )
    for key, value in required.items():
        if rows.get(key) != value:
            fail(f"native_descriptor_field_invalid:{expected_target}:{key}")
    build_receipt_path = fs_path(
        rows.get("candidate_build_receipt_path_fshex", ""),
        "native_descriptor_candidate_build_receipt",
    )
    build_receipt_state, build_receipt_rows, _worker = (
        candidate_build_receipt(
            build_receipt_path,
            expected_target=expected_target,
            expected_machine=expected_machine,
            binding=binding,
        )
    )
    if (
        rows.get("candidate_build_receipt_sha256")
        != build_receipt_state.sha256
        or rows.get("source_closure_capture_sha256")
        != build_receipt_rows["source_closure_sha256"]
        or rows.get("worker_sha256")
        != build_receipt_rows["worker_sha256"]
        or rows.get("candidate_entry_path")
        != build_receipt_rows["candidate_entry_path"]
        or rows.get("candidate_entry_module_path")
        != build_receipt_rows["candidate_entry_module_path"]
        or rows.get("candidate_entry_sha256")
        != build_receipt_rows["candidate_entry_sha256"]
    ):
        fail(
            "native_descriptor_worker_receipt_binding_invalid:"
            + expected_target
        )
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", rows.get("image_id", "")):
        fail("native_descriptor_image_id_invalid:" + expected_target)
    worker_path = fs_path(
        rows.get("worker_path_in_image_fshex", ""),
        "native_worker_path_in_image",
    )
    if not worker_path.is_absolute():
        fail("native_descriptor_worker_path_not_absolute:" + expected_target)
    if (
        pathlib.PurePosixPath(str(worker_path)) != NATIVE_WORKER_PATH
    ):
        fail("native_descriptor_worker_binding_invalid:" + expected_target)
    expected_argv = native_worker_argv(
        expected_workload_kind,
        expected_target,
        build_receipt_rows["candidate_entry_path"],
    )
    expected_env = (
        DRY_LINUX_ENV
        if expected_workload_kind == WORKLOAD_DRY_COMPILE
        else FIXED_LINUX_ENV
    )
    if (
        require_uint(
            rows.get("target_argv_count", ""),
            "native_target_argv_count",
            positive=True,
        ) != len(expected_argv)
        or require_sha(
            rows.get("target_argv_sha256", ""),
            "native_target_argv",
        ) != framed_sequence_sha256(expected_argv)
        or require_uint(
            rows.get("target_env_count", ""),
            "native_target_env_count",
        ) != len(expected_env)
        or require_sha(
            rows.get("target_env_sha256", ""),
            "native_target_env",
        ) != framed_sequence_sha256(expected_env)
    ):
        fail(
            "native_descriptor_target_sequence_invalid:"
            + expected_target
            + ":"
            + expected_workload_kind
        )
    require_exact_keys(
        rows,
        set(required)
        | {
            "candidate_build_receipt_path_fshex",
            "candidate_build_receipt_sha256",
            "source_closure_capture_sha256",
            "candidate_entry_path",
            "candidate_entry_module_path",
            "candidate_entry_sha256",
            "image_id",
            "worker_path_in_image_fshex",
            "worker_sha256",
            "target_argv_count",
            "target_argv_sha256",
            "target_env_count",
            "target_env_sha256",
            "descriptor_payload_sha256",
        },
        "native_descriptor",
    )
    return state, rows


def write_native_descriptor(
    *,
    binding: dict[str, str],
    target: str,
    machine: str,
    workload_kind: str,
    image_id: str,
    build_receipt_path: pathlib.Path,
    worker_path_in_image: str,
    target_argv_manifest: pathlib.Path,
    target_env_manifest: pathlib.Path,
    out: pathlib.Path,
) -> None:
    native_target_machine(target, machine)
    require_native_controller_host(machine)
    build_receipt_state, build_receipt_rows, worker_state = (
        candidate_build_receipt(
            build_receipt_path,
            expected_target=target,
            expected_machine=machine,
            binding=binding,
        )
    )
    worker_path = pathlib.PurePosixPath(worker_path_in_image)
    if not worker_path.is_absolute() or worker_path != NATIVE_WORKER_PATH:
        fail("native_worker_path_invalid")
    argv_state, argv = read_framed_sequence(
        target_argv_manifest,
        "native_target_argv_manifest",
        positive=True,
    )
    env_state, env = read_framed_sequence(
        target_env_manifest,
        "native_target_env_manifest",
        positive=True,
    )
    if argv[0] != str(worker_path):
        fail("native_target_argv_worker_mismatch")
    entry_path = build_receipt_rows["candidate_entry_path"]
    if argv != native_worker_argv(workload_kind, target, entry_path):
        fail("native_target_argv_not_unique_for_workload")
    expected_env = (
        DRY_LINUX_ENV
        if workload_kind == WORKLOAD_DRY_COMPILE
        else FIXED_LINUX_ENV
    )
    if env != expected_env:
        fail("native_target_env_not_unique_for_workload")
    required = native_descriptor_required(
        expected_target=target,
        expected_machine=machine,
        binding=binding,
        workload_kind=workload_kind,
    )
    lines = [key + "=" + value for key, value in required.items()]
    lines.extend(
        (
            "candidate_build_receipt_path_fshex="
            + os.fsencode(str(build_receipt_state.path)).hex(),
            "candidate_build_receipt_sha256=" + build_receipt_state.sha256,
            "source_closure_capture_sha256="
            + build_receipt_rows["source_closure_sha256"],
            "candidate_entry_path=" + entry_path,
            "candidate_entry_module_path="
            + build_receipt_rows["candidate_entry_module_path"],
            "candidate_entry_sha256="
            + build_receipt_rows["candidate_entry_sha256"],
            "image_id=" + image_id,
            "worker_path_in_image_fshex="
            + os.fsencode(str(worker_path)).hex(),
            "worker_sha256=" + build_receipt_rows["worker_sha256"],
            "target_argv_count=" + str(len(argv)),
            "target_argv_sha256=" + argv_state.sha256,
            "target_env_count=" + str(len(env)),
            "target_env_sha256=" + env_state.sha256,
        )
    )
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
        fail("native_descriptor_image_id_invalid:" + target)
    exclusive_write(out, rendered(lines, "descriptor_payload_sha256"))
    native_descriptor(
        out,
        expected_target=target,
        expected_machine=machine,
        expected_workload_kind=workload_kind,
        binding=binding,
    )


def produce_native_descriptor(args: argparse.Namespace) -> None:
    binding, _official_driver_path = complete_release_input_binding(args)
    build_receipt_path = pathlib.Path(args.candidate_build_receipt)
    _build_state, build_rows, _worker_state = candidate_build_receipt(
        build_receipt_path,
        binding=binding,
    )
    target = build_rows.get("target", "")
    machine = build_rows.get("machine", "")
    native_target_machine(target, machine)
    write_native_descriptor(
        binding=binding,
        target=target,
        machine=machine,
        workload_kind=args.workload_kind,
        image_id=args.image_id,
        build_receipt_path=build_receipt_path,
        worker_path_in_image=args.worker_path_in_image,
        target_argv_manifest=pathlib.Path(args.target_argv_manifest),
        target_env_manifest=pathlib.Path(args.target_env_manifest),
        out=pathlib.Path(args.out),
    )


def preflight(args: argparse.Namespace) -> None:
    output = pathlib.Path(args.out_dir)
    publish_root = pathlib.Path(args.publish_root)
    anchor = output.parent
    parent = anchor.parent
    expected_anchor = publication_anchor_path(publish_root)
    if (
        not output.is_absolute()
        or not publish_root.is_absolute()
        or output.name != "work"
        or anchor != expected_anchor
        or anchor == publish_root
        or parent != publish_root.parent
        or anchor.exists()
        or anchor.is_symlink()
        or output.exists()
        or output.is_symlink()
        or publish_root.exists()
        or publish_root.is_symlink()
    ):
        fail("preflight_output_must_be_absent_absolute")
    canonical_existing(parent, "preflight_output_parent", directory=True)
    anchor.mkdir(mode=0o700)
    output.mkdir(mode=0o700)
    publication_roots(output, publish_root)
    contract_path = output / "contract.kv"
    exclusive_write(contract_path, contract_raw())
    reasons: list[str] = []
    binding: dict[str, str] = {}
    official_driver_path: pathlib.Path | None = None
    official_source_capture: str | None = None
    try:
        binding.update(official_binding(pathlib.Path(args.official_receipt)))
        official_driver_path = fs_path(
            binding.pop("_official_driver_path_fshex"),
            "official_driver_path",
        )
        official_source_capture = binding.pop(
            "_official_source_closure_capture_sha256"
        )
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("official=" + str(exc))
    snapshot_path = pathlib.Path(args.snapshot_manifest)
    snapshot_state: FileState | None = None
    try:
        snapshot_state = stable_read(snapshot_path, "snapshot_manifest")
        if (
            binding
            and (
                snapshot_state.sha256 != binding["snapshot_manifest_sha256"]
                or snapshot_state.sha256 != official_source_capture
            )
        ):
            fail("snapshot_manifest_official_binding_mismatch")
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("snapshot=" + str(exc))
    source_closure_path = pathlib.Path(args.source_closure)
    source_closure_state: FileState | None = None
    try:
        source_closure_state = stable_read(
            source_closure_path, "source_closure"
        )
        if binding:
            if snapshot_state is None:
                fail("snapshot_state_required_for_source_content_cid")
            snapshot_cid = (
                source_closure_manifest.content_cid_from_manifest(
                    snapshot_state.raw
                )
            )
            source_closure_cid = (
                source_closure_manifest.content_cid_from_manifest(
                    source_closure_state.raw
                )
            )
            if source_closure_cid != snapshot_cid:
                fail("source_closure_official_content_cid_mismatch")
            binding["source_closure_cid"] = source_closure_cid
    except (ReleaseError, OSError, ValueError, KeyError, RuntimeError) as exc:
        reasons.append("source_closure=" + str(exc))
    try:
        if official_driver_path is None or not binding:
            fail("official_binding_required")
        binding.update(
            seven_stage_binding(
                pathlib.Path(args.seven_stage_output),
                pathlib.Path(args.seven_stage_parser_harness_manifest),
                snapshot_path,
                official_driver_path,
                binding,
            )
        )
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("seven_stage=" + str(exc))
    performance_source_state: FileState | None = None
    try:
        performance_source_state = stable_read(
            pathlib.Path(args.performance_source),
            "performance_source",
        )
        binding["performance_source_sha256"] = (
            performance_source_state.sha256
        )
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("performance_source=" + str(exc))
    try:
        binding.update(baseline_binding(pathlib.Path(args.baseline_manifest)))
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("baseline=" + str(exc))
    try:
        if "baseline_driver_sha256" not in binding:
            fail("baseline_binding_required_for_darwin_bootstrap")
        binding.update(
            bootstrap_darwin_lane_binding(
                pathlib.Path(args.darwin_bootstrap_lane_receipt),
                binding["baseline_driver_sha256"],
            )
        )
    except (ReleaseError, OSError, ValueError, KeyError) as exc:
        reasons.append("darwin_bootstrap_lane=" + str(exc))
    host_os, machine, translated = host_identity()
    if host_os != "darwin" or machine != "arm64" or translated:
        reasons.append(
            f"darwin_native_host=required_darwin_arm64_nontranslated:"
            f"actual_{host_os}_{machine}_translated_{int(translated)}"
        )
    if binding:
        for raw_path, target, expected_machine, workload_kind in (
            (
                args.linux_aarch64_current_descriptor,
                "aarch64-unknown-linux-gnu",
                "aarch64",
                WORKLOAD_CURRENT_DRIVER,
            ),
            (
                args.linux_aarch64_dry_descriptor,
                "aarch64-unknown-linux-gnu",
                "aarch64",
                WORKLOAD_DRY_COMPILE,
            ),
            (
                args.linux_x86_64_current_descriptor,
                "x86_64-unknown-linux-gnu",
                "x86_64",
                WORKLOAD_CURRENT_DRIVER,
            ),
            (
                args.linux_x86_64_dry_descriptor,
                "x86_64-unknown-linux-gnu",
                "x86_64",
                WORKLOAD_DRY_COMPILE,
            ),
        ):
            try:
                descriptor_state, descriptor_rows = native_descriptor(
                    pathlib.Path(raw_path),
                    expected_target=target,
                    expected_machine=expected_machine,
                    expected_workload_kind=workload_kind,
                    binding=binding,
                )
                prefix = native_descriptor_binding_prefix(
                    expected_machine,
                    workload_kind,
                )
                binding[prefix + "_descriptor_sha256"] = (
                    descriptor_state.sha256
                )
                binding[prefix + "_image_id"] = descriptor_rows["image_id"]
                binding[prefix + "_target_argv_sha256"] = descriptor_rows[
                    "target_argv_sha256"
                ]
                binding[prefix + "_target_env_sha256"] = descriptor_rows[
                    "target_env_sha256"
                ]
            except (ReleaseError, OSError, ValueError, KeyError) as exc:
                reasons.append(target + "=" + str(exc))
    status = "READY" if not reasons else "RED"
    binding["publication_root_fshex"] = os.fsencode(publish_root).hex()
    lines = [
        "schema=cheng.backend2.current_source_release_preflight",
        "status=" + status,
        "driver_role=production",
        "contract_sha256=" + hashlib.sha256(contract_raw()).hexdigest(),
        "host_os=" + host_os,
        "host_machine=" + machine,
        "host_translated=" + ("true" if translated else "false"),
    ]
    for key in sorted(binding):
        lines.append(key + "=" + binding[key])
    lines.append("reason_count=" + str(len(reasons)))
    for index, reason in enumerate(reasons):
        if any(character in reason for character in "\r\n\0"):
            reason = "invalid_reason_encoding"
        lines.append(f"reason.{index}={reason}")
    exclusive_write(
        output / "preflight.kv",
        rendered(lines, "preflight_payload_sha256"),
    )
    if reasons:
        raise ReleaseError("preflight_red:" + ",".join(reasons))
    binding_lines = [
        "schema=cheng.backend2.current_source_release_binding",
        "status=PASS",
        "driver_role=production",
        "contract_sha256=" + hashlib.sha256(contract_raw()).hexdigest(),
    ]
    binding_lines.extend(key + "=" + binding[key] for key in sorted(binding))
    exclusive_write(
        output / "binding.kv",
        rendered(binding_lines, "binding_payload_sha256"),
    )
    if source_closure_state is None:
        fail("source_closure_state_missing_after_ready")
    exclusive_write(
        output / "source-closure.before",
        source_closure_state.raw,
    )
    if performance_source_state is None:
        fail("performance_source_state_missing_after_ready")
    exclusive_write(
        output / "performance-source.cheng",
        performance_source_state.raw,
    )


def validate_raw_manifest(
    path: pathlib.Path, root: pathlib.Path, target: str, backend: str
) -> tuple[dict[str, FileState], FileState]:
    rows, state = read_rows(path, "leg_raw_manifest", "manifest_payload_sha256")
    if (
        rows.get("schema") != "cheng.backend2.current_source_raw_manifest"
        or rows.get("status") != "PASS"
        or rows.get("lock_kind") != "release_target_backend"
        or rows.get("target") != target
        or rows.get("backend") != backend
    ):
        fail("leg_raw_manifest_header_invalid")
    count = require_uint(rows.get("artifact_count", ""), "leg_raw_artifact_count")
    if count != len(LEG_ROLES):
        fail("leg_raw_artifact_count_invalid")
    expected_keys = {
        "schema",
        "status",
        "lock_kind",
        "target",
        "backend",
        "artifact_count",
        "manifest_payload_sha256",
    }
    artifact_fields = (
        "role",
        "path_fshex",
        "sha256",
        "device",
        "inode",
        "size",
        "mode",
        "mtime_ns",
        "ctime_ns",
    )
    for index in range(count):
        expected_keys.update(
            f"artifact.{index}.{field}" for field in artifact_fields
        )
    require_exact_keys(rows, expected_keys, "leg_raw_manifest")
    artifacts: dict[str, FileState] = {}
    inodes: set[tuple[int, int]] = set()
    for index in range(count):
        prefix = f"artifact.{index}."
        role = rows.get(prefix + "role", "")
        if role in artifacts or role not in LEG_ROLES:
            fail("leg_raw_role_invalid:" + role)
        path_value = fs_path(rows.get(prefix + "path_fshex", ""), "leg_raw_path")
        artifact = stable_read(
            require_descendant(path_value, root, "leg_raw_artifact"),
            "leg_raw_artifact",
        )
        if artifact.sha256 != require_sha(
            rows.get(prefix + "sha256", ""), "leg_raw_artifact"
        ):
            fail("leg_raw_artifact_digest_mismatch:" + role)
        exact_identity = {
            "device": str(artifact.info.st_dev),
            "inode": str(artifact.info.st_ino),
            "size": str(artifact.info.st_size),
            "mode": format(artifact.info.st_mode, "o"),
            "mtime_ns": str(artifact.info.st_mtime_ns),
            "ctime_ns": str(artifact.info.st_ctime_ns),
        }
        for field, expected in exact_identity.items():
            if rows.get(prefix + field) != expected:
                fail(
                    "leg_raw_artifact_identity_mismatch:"
                    + role
                    + ":"
                    + field
                )
        inode = (artifact.info.st_dev, artifact.info.st_ino)
        if inode in inodes:
            fail("leg_raw_artifact_inode_alias:" + role)
        inodes.add(inode)
        artifacts[role] = artifact
    if set(artifacts) != set(LEG_ROLES):
        fail("leg_raw_role_set_invalid")
    return artifacts, state


def expected_leg(target: str, backend: str) -> tuple[str, str, str]:
    for candidate, host_os, machine, _, _ in TARGETS:
        if candidate == target:
            if backend not in BACKENDS:
                break
            return candidate, host_os, machine
    fail("release_leg_target_or_backend_invalid")


def require_binary_arch(
    state: FileState, target: str, role: str, *, executable: bool = False
) -> None:
    if executable and state.info.st_mode & 0o111 == 0:
        fail("release_leg_binary_not_executable:" + role)
    if target == "aarch64-apple-darwin":
        if len(state.raw) < 16 or state.raw[:4] != b"\xcf\xfa\xed\xfe":
            fail("release_leg_macho64_magic_invalid:" + role)
        cpu_type = int.from_bytes(state.raw[4:8], "little")
        file_type = int.from_bytes(state.raw[12:16], "little")
        expected_file_type = 2 if executable else 1
        if cpu_type != 0x0100000C or file_type != expected_file_type:
            fail("release_leg_macho_arch_invalid:" + role)
        return
    if (
        len(state.raw) < 20
        or state.raw[:4] != b"\x7fELF"
        or state.raw[4] != 2
        or state.raw[5] != 1
    ):
        fail("release_leg_elf64_header_invalid:" + role)
    machine = int.from_bytes(state.raw[18:20], "little")
    file_type = int.from_bytes(state.raw[16:18], "little")
    expected_machine = (
        183 if target == "aarch64-unknown-linux-gnu" else 62
    )
    if machine != expected_machine or (
        executable and file_type not in (2, 3)
    ) or (not executable and file_type != 1):
        fail("release_leg_elf_arch_invalid:" + role)


def validate_run_artifacts(artifacts: dict[str, FileState]) -> None:
    status_raw = artifacts["run_status"].raw
    if (
        len(status_raw) != 16
        or status_raw[:8] != b"CRSTATUS"
        or int.from_bytes(status_raw[8:12], "big", signed=True) != 0
        or int.from_bytes(status_raw[12:16], "big", signed=True) != 0
    ):
        fail("release_leg_run_status_invalid")
    for role, magic in (
        ("run_stdout", b"CROUTPUT"),
        ("run_stderr", b"CRERROR!"),
    ):
        raw = artifacts[role].raw
        if (
            len(raw) < 16
            or raw[:8] != magic
            or int.from_bytes(raw[8:16], "big") != len(raw) - 16
        ):
            fail("release_leg_run_stream_invalid:" + role)


def validate_current_target_json(
    artifacts: dict[str, FileState],
    target: str,
    architecture: str,
    backend: str,
    binding: dict[str, str],
    receipt_rows: dict[str, str],
) -> None:
    identity = {
        "driverRole": "production",
        "targetTriple": target,
        "architecture": architecture,
        "backend": backend,
        "sourceBundleRaw32": receipt_rows["source_bundle_raw32"],
        "driverRaw32": binding["official_driver_sha256"],
        "executionRaw32": receipt_rows["execution_raw32"],
    }
    for key in ("sourceBundleRaw32", "executionRaw32"):
        require_sha(str(identity[key]), "current_target_" + key)
    action = canonical_json_object(artifacts["target_action"], "target_action")
    require_exact_keys(
        {str(key): "" for key in action},
        {
            "schema",
            "status",
            *identity,
            "bodyIrRaw32",
            "actions",
        },
        "target_action",
    )
    if (
        action.get("schema") != "cheng_current_target_regalloc_action"
        or action.get("status") != "COMPLETE"
        or any(action.get(key) != value for key, value in identity.items())
        or action.get("bodyIrRaw32") != receipt_rows["body_ir_raw32"]
        or not isinstance(action.get("actions"), list)
        or not action["actions"]
    ):
        fail("target_action_identity_invalid")
    require_sha(receipt_rows["body_ir_raw32"], "target_body_ir")
    fragment = canonical_json_object(
        artifacts["target_fragment"], "target_fragment"
    )
    require_exact_keys(
        {str(key): "" for key in fragment},
        {
            "schema",
            "status",
            *identity,
            "bodyIrRaw32",
            "actionRaw32",
            "objectRaw32",
            "sections",
        },
        "target_fragment",
    )
    if (
        fragment.get("schema") != "cheng_current_target_object_fragment"
        or fragment.get("status") != "COMPLETE"
        or any(fragment.get(key) != value for key, value in identity.items())
        or fragment.get("bodyIrRaw32") != receipt_rows["body_ir_raw32"]
        or fragment.get("actionRaw32") != artifacts["target_action"].sha256
        or fragment.get("objectRaw32") != artifacts["object"].sha256
        or not isinstance(fragment.get("sections"), list)
        or not fragment["sections"]
    ):
        fail("target_fragment_identity_invalid")
    orc = canonical_json_object(artifacts["orc_events"], "orc_events")
    require_exact_keys(
        {str(key): "" for key in orc},
        {
            "schema",
            "status",
            *identity,
            "actionRaw32",
            "fragmentRaw32",
            "objectRaw32",
            "executableRaw32",
            "events",
        },
        "orc_events",
    )
    if (
        orc.get("schema") != "cheng_current_orc_event_log"
        or orc.get("status") != "COMPLETE"
        or any(orc.get(key) != value for key, value in identity.items())
        or orc.get("actionRaw32") != artifacts["target_action"].sha256
        or orc.get("fragmentRaw32") != artifacts["target_fragment"].sha256
        or orc.get("objectRaw32") != artifacts["object"].sha256
        or orc.get("executableRaw32")
        != artifacts["run_executable"].sha256
        or not isinstance(orc.get("events"), list)
        or not orc["events"]
    ):
        fail("orc_events_identity_invalid")


