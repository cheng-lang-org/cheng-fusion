def seal_source_closure(root: pathlib.Path, source_closure: pathlib.Path) -> None:
    root = canonical_existing(root, "release_evidence_root", directory=True)
    binding, _ = binding_rows(root / "binding.kv")
    before = stable_read(root / "source-closure.before", "source_closure_before")
    current = stable_read(source_closure, "source_closure_current")
    if (
        source_closure_manifest.content_cid_from_manifest(before.raw)
        != binding["source_closure_cid"]
        or source_closure_manifest.content_cid_from_manifest(current.raw)
        != binding["source_closure_cid"]
        or before.raw != current.raw
    ):
        fail("source_closure_changed_before_seal")
    exclusive_write(root / "source-closure.after", current.raw)
    after = stable_read(root / "source-closure.after", "source_closure_after")
    if (
        after.raw != before.raw
        or (after.info.st_dev, after.info.st_ino)
        == (before.info.st_dev, before.info.st_ino)
    ):
        fail("source_closure_seal_identity_invalid")


def object_metrics(
    path: pathlib.Path, root: pathlib.Path, label: str
) -> tuple[dict[str, str], FileState]:
    path = require_descendant(path, root, label)
    rows, state = read_rows(path, label)
    require_exact_keys(
        rows,
        {
            "schema",
            "object_sha256",
            "text_bytes",
            "instruction_count",
            "spill_reload_instruction_count",
            "spill_density_ppm",
        },
        label,
    )
    if rows["schema"] != "regalloc_object_metrics":
        fail(label + "_schema_invalid")
    require_sha(rows["object_sha256"], label + "_object")
    instruction_count = require_uint(
        rows["instruction_count"], label + "_instruction_count", positive=True
    )
    spill_count = require_uint(
        rows["spill_reload_instruction_count"], label + "_spill_count"
    )
    if (
        spill_count > instruction_count
        or require_uint(rows["text_bytes"], label + "_text", positive=True)
        <= 0
        or require_uint(rows["spill_density_ppm"], label + "_spill_density")
        != spill_count * 1_000_000 // instruction_count
    ):
        fail(label + "_metrics_invalid")
    return rows, state


def produce_performance_verdict(args: argparse.Namespace) -> None:
    root = canonical_existing(
        pathlib.Path(args.evidence_root),
        "release_evidence_root",
        directory=True,
    )
    binding, _ = binding_rows(root / "binding.kv")
    raw_path = require_descendant(
        pathlib.Path(args.raw_samples), root, "performance_raw_samples"
    )
    raw_state = stable_read(raw_path, "performance_raw_samples")
    if (
        not raw_state.raw.endswith(b"\n")
        or b"\r" in raw_state.raw
        or b"\0" in raw_state.raw
    ):
        fail("performance_raw_encoding_invalid")
    lines = raw_state.raw.decode("utf-8").splitlines()
    if len(lines) != 12:
        fail("performance_sample_count_invalid")
    rows: list[tuple[int, str, int, int, str]] = []
    for index, line in enumerate(lines):
        fields = line.split("\t")
        if len(fields) != 22:
            fail("performance_sample_field_count_invalid")
        ordinal = require_uint(fields[0], "performance_ordinal")
        block = require_uint(fields[1], "performance_block")
        position = require_uint(fields[3], "performance_position")
        jobs = require_uint(
            fields[4], "performance_jobs", positive=True
        )
        pattern, role = fields[2], fields[5]
        if (
            (pattern, jobs, role) != PERF_SCHEDULE[index]
            or ordinal != index
            or block != index // 4
            or position != index % 4
        ):
            fail("performance_sample_order_invalid")
        wall = require_uint(fields[6], "performance_wall", positive=True)
        peak = require_uint(fields[7], "performance_peak", positive=True)
        if peak > LIMIT_BYTES:
            fail("performance_peak_exceeds_limit")
        expected_compiler = (
            binding["official_driver_sha256"]
            if role == "candidate"
            else binding["baseline_driver_sha256"]
        )
        if (
            fields[8] != binding["performance_source_sha256"]
            or fields[9] != expected_compiler
        ):
            fail("performance_sample_identity_mismatch")
        for offset in range(10, 22, 2):
            artifact = stable_read(
                require_descendant(
                    pathlib.Path(fields[offset]),
                    root,
                    "performance_artifact",
                ),
                "performance_artifact",
            )
            if artifact.sha256 != require_sha(
                fields[offset + 1], "performance_artifact"
            ):
                fail("performance_artifact_digest_mismatch")
        rows.append((block, role, wall, peak, fields[13]))
    wall_ratios: list[int] = []
    rss_ratios: list[int] = []
    for block in (0, 1, 2):
        block_rows = [row for row in rows if row[0] == block]
        candidate = [row for row in block_rows if row[1] == "candidate"]
        baseline = [row for row in block_rows if row[1] == "baseline"]
        wall_ratios.append(
            sum(row[2] for row in candidate)
            * 1_000_000
            // sum(row[2] for row in baseline)
        )
        rss_ratios.append(
            sum(row[3] for row in candidate)
            * 1_000_000
            // sum(row[3] for row in baseline)
        )
    candidate_metrics, _ = object_metrics(
        pathlib.Path(args.candidate_object_metrics),
        root,
        "candidate_object_metrics",
    )
    baseline_metrics, _ = object_metrics(
        pathlib.Path(args.baseline_object_metrics),
        root,
        "baseline_object_metrics",
    )
    clang_metrics, _ = object_metrics(
        pathlib.Path(args.clang_object_metrics),
        root,
        "clang_object_metrics",
    )
    candidate_object_shas = {
        row[4] for row in rows if row[1] == "candidate"
    }
    baseline_object_shas = {row[4] for row in rows if row[1] == "baseline"}
    if (
        candidate_object_shas != {candidate_metrics["object_sha256"]}
        or baseline_object_shas != {baseline_metrics["object_sha256"]}
    ):
        fail("performance_object_metrics_identity_mismatch")
    candidate_spill = require_uint(
        candidate_metrics["spill_density_ppm"], "candidate_spill"
    )
    baseline_spill = require_uint(
        baseline_metrics["spill_density_ppm"], "baseline_spill"
    )
    candidate_text = require_uint(
        candidate_metrics["text_bytes"], "candidate_text", positive=True
    )
    baseline_text = require_uint(
        baseline_metrics["text_bytes"], "baseline_text", positive=True
    )
    clang_text = require_uint(
        clang_metrics["text_bytes"], "clang_text", positive=True
    )
    if (
        max(wall_ratios) > 1_050_000
        or max(rss_ratios) > 1_050_000
        or max(wall_ratios) - min(wall_ratios) > 100_000
        or max(rss_ratios) - min(rss_ratios) > 100_000
        or candidate_spill >= baseline_spill
        or candidate_spill > 250_000
        or candidate_text >= baseline_text
        or candidate_text * 1_000_000 // clang_text > 2_000_000
    ):
        fail("performance_contract_failed")
    verdict_lines = [
        "schema=cheng.backend2.current_source_performance_verdict",
        "status=PASS",
        "raw_samples_sha256=" + raw_state.sha256,
        "source_closure_cid=" + binding["source_closure_cid"],
        "performance_source_sha256=" + binding["performance_source_sha256"],
        "candidate_compiler_sha256=" + binding["official_driver_sha256"],
        "baseline_compiler_sha256=" + binding["baseline_driver_sha256"],
        "sample_count=12",
        "wall_ratio_max_ppm=" + str(max(wall_ratios)),
        "rss_ratio_max_ppm=" + str(max(rss_ratios)),
        "wall_pair_spread_ppm="
        + str(max(wall_ratios) - min(wall_ratios)),
        "rss_pair_spread_ppm="
        + str(max(rss_ratios) - min(rss_ratios)),
        "candidate_spill_density_ppm=" + str(candidate_spill),
        "baseline_spill_density_ppm=" + str(baseline_spill),
        "candidate_text_bytes=" + str(candidate_text),
        "baseline_text_bytes=" + str(baseline_text),
        "clang_text_bytes=" + str(clang_text),
        "text_clang_ratio_ppm="
        + str(candidate_text * 1_000_000 // clang_text),
    ]
    output = pathlib.Path(args.out)
    require_descendant(output.parent, root, "performance_output_parent", directory=True)
    if output != output.parent / output.name:
        fail("performance_output_not_canonical")
    exclusive_write(output, rendered(verdict_lines, "verdict_payload_sha256"))
    validate_perf(raw_path, output, binding, root)


