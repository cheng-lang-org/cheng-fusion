def validate_staged_publication(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> None:
    receipt_rows, _ = read_rows(
        work_root / "publisher-receipt.kv",
        "staged_publisher_receipt",
        "receipt_payload_sha256",
    )
    manifest_rows, _ = read_rows(
        work_root / "artifact-manifest.kv",
        "staged_artifact_manifest",
        "manifest_payload_sha256",
    )
    if (
        decoded_fs_path(
            receipt_rows.get("producer_root_fshex", ""),
            "staged_publisher_root",
        )
        != publish_root
        or decoded_fs_path(
            receipt_rows.get("artifact_manifest_path_fshex", ""),
            "staged_artifact_manifest",
        )
        != publish_root / "artifact-manifest.kv"
        or decoded_fs_path(
            manifest_rows.get("producer_root_fshex", ""),
            "staged_manifest_root",
        )
        != publish_root
    ):
        fail("staged_publication_logical_root_invalid")
    with publication_path_projection(work_root, publish_root):
        validate_published(work_root / "publisher-receipt.kv")


def prepare_publication(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> PreparedPublication:
    (
        work_root,
        publish_root,
        anchor,
        _,
        _,
        anchor_info,
        parent_info,
    ) = publication_roots(
        work_root,
        publish_root,
    )
    manifest = work_root / "artifact-manifest.kv"
    receipt = work_root / "publisher-receipt.kv"
    if manifest.exists() or manifest.is_symlink() or receipt.exists() or receipt.is_symlink():
        fail("publisher_outputs_must_be_absent")
    validate_completion(work_root, publish_root=publish_root)
    runtime_receipt = work_root / DARWIN_RUNTIME_FORMAL_RECEIPT_NAME
    if runtime_receipt.exists() or runtime_receipt.is_symlink():
        fail("darwin_runtime_formal_receipt_must_be_absent")
    with publication_path_projection(work_root, publish_root):
        _, runtime_receipt_raw = run_runtime_formal_validation(
            work_root,
            publish_root,
            staged=True,
            expected_receipt=None,
        )
    exclusive_write(runtime_receipt, runtime_receipt_raw)
    manifest_raw, artifact_count, directory_count = artifact_manifest_raw(
        work_root,
        manifest,
        receipt,
        publish_root=publish_root,
    )
    exclusive_write(manifest, manifest_raw)
    manifest_state = stable_read(manifest, "published_artifact_manifest")
    if manifest_state.raw != manifest_raw:
        fail("published_artifact_manifest_changed")
    validate_completion(work_root, publish_root=publish_root)
    receipt_raw = publisher_receipt_raw(
        work_root,
        publish_root,
        manifest_state,
        artifact_count,
        directory_count,
    )
    exclusive_write(receipt, receipt_raw)
    sync_publication_tree(work_root)
    validate_staged_publication(work_root, publish_root)
    current_work_info = work_root.lstat()
    return PreparedPublication(
        work_root=work_root,
        publish_root=publish_root,
        anchor=anchor,
        anchor_identity=directory_authority(anchor_info),
        parent_identity=identity(parent_info),
        work_root_identity=identity(current_work_info),
        manifest_raw=manifest_raw,
        receipt_raw=receipt_raw,
    )


def rename_publication_root_exclusive(
    source_parent_descriptor: int,
    work_name: str,
    destination_parent_descriptor: int,
    publish_name: str,
) -> None:
    source = os.fsencode(work_name)
    destination = os.fsencode(publish_name)
    libc = ctypes.CDLL(None, use_errno=True)
    if platform.system() == "Darwin":
        operation = getattr(libc, "renameatx_np", None)
        if operation is None:
            fail("publication_exclusive_rename_unavailable")
        operation.argtypes = (
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_uint,
        )
        operation.restype = ctypes.c_int
        result = operation(
            source_parent_descriptor,
            source,
            destination_parent_descriptor,
            destination,
            DARWIN_RENAME_EXCL,
        )
    elif platform.system() == "Linux":
        operation = getattr(libc, "renameat2", None)
        if operation is None:
            fail("publication_exclusive_rename_unavailable")
        operation.argtypes = (
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_uint,
        )
        operation.restype = ctypes.c_int
        result = operation(
            source_parent_descriptor,
            source,
            destination_parent_descriptor,
            destination,
            LINUX_RENAME_NOREPLACE,
        )
    else:
        fail("publication_exclusive_rename_unavailable")
    if result == 0:
        return
    error_number = ctypes.get_errno()
    if error_number in (errno.EEXIST, errno.ENOTEMPTY):
        fail("publication_publish_root_raced")
    if error_number == errno.EXDEV:
        fail("publication_cross_device_rename_rejected")
    fail("publication_rename_failed:" + str(error_number))


def committed_publication_fatal(reason: str) -> None:
    encoded = reason.replace("\n", " ").replace("\r", " ").replace("\0", "")
    try:
        os.write(
            2,
            (
                "backend2_current_source_release_evidence_"
                "committed_fatal="
                + encoded
                + "\n"
            ).encode("utf-8", "replace"),
        )
    finally:
        os.abort()


def validate_prepared_publication_tree(
    prepared: PreparedPublication,
) -> tuple[pathlib.Path, pathlib.Path, pathlib.Path, pathlib.Path]:
    (
        work_root,
        publish_root,
        anchor,
        parent,
        _,
        anchor_info,
        parent_info,
    ) = publication_roots(
        prepared.work_root,
        prepared.publish_root,
    )
    if (
        identity(parent_info) != prepared.parent_identity
        or directory_authority(anchor_info) != prepared.anchor_identity
        or identity(work_root.lstat()) != prepared.work_root_identity
    ):
        fail("publication_precommit_identity_drift")
    manifest_state = stable_read(
        work_root / "artifact-manifest.kv",
        "publication_precommit_manifest",
    )
    receipt_state = stable_read(
        work_root / "publisher-receipt.kv",
        "publication_precommit_receipt",
    )
    if (
        manifest_state.raw != prepared.manifest_raw
        or receipt_state.raw != prepared.receipt_raw
    ):
        fail("publication_precommit_seal_drift")
    rebuilt_manifest, _, _ = artifact_manifest_raw(
        work_root,
        work_root / "artifact-manifest.kv",
        work_root / "publisher-receipt.kv",
        publish_root=publish_root,
    )
    if rebuilt_manifest != prepared.manifest_raw:
        fail("publication_precommit_tree_drift")
    if (
        identity(parent.lstat()) != prepared.parent_identity
        or directory_authority(anchor.lstat()) != prepared.anchor_identity
        or identity(work_root.lstat()) != prepared.work_root_identity
    ):
        fail("publication_precommit_identity_drift")
    return work_root, publish_root, anchor, parent


def _commit_prepared_publication_tree(
    prepared: PreparedPublication,
) -> pathlib.Path:
    (
        work_root,
        publish_root,
        anchor,
        parent,
    ) = validate_prepared_publication_tree(prepared)
    parent_descriptor = os.open(
        parent,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        anchor_descriptor = os.open(
            anchor,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
    except BaseException:
        os.close(parent_descriptor)
        raise
    committed = False
    try:
        if (
            identity(os.fstat(parent_descriptor))
            != prepared.parent_identity
            or directory_authority(os.fstat(anchor_descriptor))
            != prepared.anchor_identity
            or identity(
                os.stat(
                    work_root.name,
                    dir_fd=anchor_descriptor,
                    follow_symlinks=False,
                )
            )
            != prepared.work_root_identity
        ):
            fail("publication_authority_open_race")
        rename_publication_root_exclusive(
            anchor_descriptor,
            work_root.name,
            parent_descriptor,
            publish_root.name,
        )
        committed = True
        try:
            os.fsync(parent_descriptor)
            if not renamed_directory_identity_matches(
                prepared.work_root_identity,
                identity(publish_root.lstat()),
            ):
                raise RuntimeError(
                    "publication_committed_root_identity_drift"
                )
            receipt = publish_root / "publisher-receipt.kv"
            validate_published(receipt)
            if os.listdir(anchor_descriptor):
                raise RuntimeError(
                    "publication_committed_anchor_not_empty"
                )
            if (
                directory_authority(os.fstat(anchor_descriptor))
                != prepared.anchor_identity
            ):
                raise RuntimeError(
                    "publication_committed_anchor_identity_drift"
                )
        except BaseException as exc:
            committed_publication_fatal(str(exc))
    finally:
        for descriptor in (anchor_descriptor, parent_descriptor):
            try:
                os.close(descriptor)
            except OSError as exc:
                if committed:
                    committed_publication_fatal(
                        "publication_committed_close_failed:"
                        + str(exc.errno)
                    )
                raise
    return publish_root / "publisher-receipt.kv"


def commit_publication(
    prepared: PreparedPublication,
) -> pathlib.Path:
    validate_staged_publication(
        prepared.work_root,
        prepared.publish_root,
    )
    sync_publication_tree(prepared.work_root)
    return _commit_prepared_publication_tree(prepared)


def resume_prepared_publication(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> PreparedPublication:
    (
        work_root,
        publish_root,
        anchor,
        _,
        _,
        anchor_info,
        parent_info,
    ) = publication_roots(work_root, publish_root)
    manifest_state = stable_read(
        work_root / "artifact-manifest.kv",
        "resumed_artifact_manifest",
    )
    receipt_state = stable_read(
        work_root / "publisher-receipt.kv",
        "resumed_publisher_receipt",
    )
    validate_staged_publication(work_root, publish_root)
    sync_publication_tree(work_root)
    return PreparedPublication(
        work_root=work_root,
        publish_root=publish_root,
        anchor=anchor,
        anchor_identity=directory_authority(anchor_info),
        parent_identity=identity(parent_info),
        work_root_identity=identity(work_root.lstat()),
        manifest_raw=manifest_state.raw,
        receipt_raw=receipt_state.raw,
    )


def recover_committed_publication(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> pathlib.Path:
    if not work_root.is_absolute() or work_root.name != "work":
        fail("committed_recovery_work_root_invalid")
    publish_root = canonical_existing(
        publish_root,
        "committed_publish_root",
        directory=True,
    )
    anchor = publication_anchor_path(publish_root)
    if (
        work_root != anchor / "work"
        or work_root.exists()
        or work_root.is_symlink()
    ):
        fail("committed_recovery_root_shape_invalid")
    canonical_existing(
        anchor,
        "committed_recovery_anchor",
        directory=True,
    )
    receipt = publish_root / "publisher-receipt.kv"
    validate_published(receipt)
    return receipt


def publish(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> pathlib.Path:
    if publish_root.exists() or publish_root.is_symlink():
        return recover_committed_publication(work_root, publish_root)
    manifest = work_root / "artifact-manifest.kv"
    receipt = work_root / "publisher-receipt.kv"
    manifest_exists = manifest.exists() or manifest.is_symlink()
    receipt_exists = receipt.exists() or receipt.is_symlink()
    if manifest_exists != receipt_exists:
        fail("publisher_partial_staging_rejected")
    prepared = (
        resume_prepared_publication(work_root, publish_root)
        if manifest_exists
        else prepare_publication(work_root, publish_root)
    )
    return commit_publication(prepared)


def validate_artifact_manifest(
    root: pathlib.Path, manifest: pathlib.Path, receipt: pathlib.Path
) -> tuple[FileState, int, int]:
    manifest_state = stable_read(manifest, "artifact_manifest")
    rows, lines = parse_rows(manifest_state.raw, "artifact_manifest")
    if (
        rows.get("schema")
        != "cheng.backend2.current_source_release_artifact_manifest"
        or rows.get("status") != "PASS"
        or rows.get("driver_role") != "production"
        or not lines[-1].startswith("manifest_payload_sha256=")
    ):
        fail("artifact_manifest_header_invalid")
    payload = ("\n".join(lines[:-1]) + "\n").encode()
    if rows.get("manifest_payload_sha256") != hashlib.sha256(payload).hexdigest():
        fail("artifact_manifest_payload_invalid")
    rebuilt, artifact_count, directory_count = artifact_manifest_raw(
        root, manifest, receipt
    )
    if rebuilt != manifest_state.raw:
        fail("artifact_manifest_tree_mismatch")
    return manifest_state, artifact_count, directory_count


def validate_publisher_physical_envelope(
    root: pathlib.Path,
    receipt_state: FileState,
) -> None:
    root = canonical_existing(
        root,
        "publisher_envelope_root",
        directory=True,
    )
    root_info = root.lstat()
    if (
        stat.S_IMODE(root_info.st_mode) != 0o700
        or root_info.st_uid != os.geteuid()
        or root_info.st_gid != os.getegid()
        or stat.S_IMODE(receipt_state.info.st_mode) != 0o400
        or receipt_state.info.st_uid != root_info.st_uid
        or receipt_state.info.st_gid != root_info.st_gid
        or receipt_state.info.st_nlink != 1
        or receipt_state.info.st_ctime_ns > root_info.st_ctime_ns
    ):
        fail("publisher_physical_envelope_invalid")


def validate_publication_anchor_control(
    logical_root: pathlib.Path,
    receipt_rows: dict[str, str],
    *,
    staged_work_root: pathlib.Path | None = None,
) -> pathlib.Path:
    expected_anchor = publication_anchor_path(logical_root)
    observed_anchor = decoded_fs_path(
        receipt_rows.get("publication_anchor_path_fshex", ""),
        "publication_anchor_path",
    )
    if observed_anchor != expected_anchor:
        fail("publication_anchor_path_invalid")
    anchor = canonical_existing(
        observed_anchor,
        "publication_anchor_control",
        directory=True,
    )
    descriptor = os.open(
        anchor,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        anchor_info = os.fstat(descriptor)
        authority = directory_authority(anchor_info)
        expected = {
            "publication_anchor_status": PUBLICATION_ANCHOR_STATUS,
            "publication_anchor_device": str(authority[0]),
            "publication_anchor_inode": str(authority[1]),
            "publication_anchor_mode": format(authority[2], "o"),
            "publication_anchor_uid": str(authority[3]),
            "publication_anchor_gid": str(authority[4]),
        }
        for key, value in expected.items():
            if receipt_rows.get(key) != value:
                fail("publication_anchor_authority_invalid:" + key)
        members = sorted(os.listdir(descriptor), key=os.fsencode)
        if staged_work_root is None:
            if members:
                fail("publication_anchor_not_empty")
        else:
            if staged_work_root != anchor / "work" or members != ["work"]:
                fail("publication_anchor_staging_shape_invalid")
            anchored_work = os.stat(
                "work",
                dir_fd=descriptor,
                follow_symlinks=False,
            )
            if identity(anchored_work) != identity(staged_work_root.lstat()):
                fail("publication_anchor_staging_identity_invalid")
    finally:
        os.close(descriptor)
    return anchor


