def produce_native_worker_receipt(args: argparse.Namespace) -> None:
    binding, _official_driver_path = complete_release_input_binding(args)
    target = args.target
    machine = args.machine
    native_target_machine(target, machine)
    require_native_controller_host(machine)
    release_source_closure = stable_read(
        pathlib.Path(args.source_closure),
        "native_worker_release_source_closure",
    )
    try:
        release_source_cid = (
            source_closure_manifest.content_cid_from_manifest(
                release_source_closure.raw
            )
        )
    except RuntimeError as exc:
        fail("native_worker_release_source_content_cid_invalid:" + str(exc))
    if release_source_cid != binding["source_closure_cid"]:
        fail("native_worker_release_source_closure_invalid")
    build_state, build_rows, worker = candidate_build_receipt(
        pathlib.Path(args.candidate_build_receipt),
        expected_target=target,
        expected_machine=machine,
        binding=binding,
    )
    candidate_state, candidate = candidate_validation_receipt(
        pathlib.Path(args.candidate_validation_receipt),
        target=target,
        machine=machine,
        worker=worker,
    )
    frozen_state, overlap_count, overlap_sha = candidate_frozen_bridge(
        fs_path(
            build_rows["frozen_manifest_path_fshex"],
            "native_worker_candidate_frozen_manifest",
        ),
        expected_sha256=str(candidate["frozenSourceToolManifestSha256"]),
        release_source_closure=release_source_closure.path,
    )
    if (
        candidate["candidateBuildReceiptSha256"] != build_state.sha256
        or candidate["candidateBuildReceiptPayloadSha256"]
        != build_rows["receipt_payload_sha256"]
    ):
        fail("native_worker_candidate_build_receipt_invalid")
    required = native_descriptor_required(
        expected_target=target,
        expected_machine=machine,
        binding=binding,
