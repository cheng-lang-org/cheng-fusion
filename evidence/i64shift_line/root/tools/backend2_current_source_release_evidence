def runtime_formal_inputs_path(root: pathlib.Path) -> pathlib.Path:
    matches: list[pathlib.Path] = []
    for directory, names, filenames in os.walk(
        root,
        topdown=True,
        followlinks=False,
    ):
        names.sort(key=os.fsencode)
        filenames.sort(key=os.fsencode)
        if "formal-inputs.kv" in filenames:
            matches.append(pathlib.Path(directory) / "formal-inputs.kv")
    if len(matches) != 1:
        fail("darwin_runtime_formal_inputs_count_invalid")
    return canonical_existing(
        matches[0],
        "darwin_runtime_formal_inputs",
    )


def runtime_formal_receipt_rows(
    raw: bytes,
    label: str,
) -> dict[str, str]:
    rows, lines = parse_rows(raw, label)
    if (
        not lines
        or not lines[-1].startswith("receipt_payload_sha256=")
        or rows.get("receipt_payload_sha256")
        != hashlib.sha256(
            ("\n".join(lines[:-1]) + "\n").encode()
        ).hexdigest()
    ):
        fail(label + "_payload_invalid")
    require_exact_keys(
        rows,
        DARWIN_RUNTIME_FORMAL_RECEIPT_KEYS,
        label,
    )
    if (
        rows["darwin_current_release_runtime_validation"] != "PASS"
        or rows["driver_role"] != "production"
        or rows["target"] != "arm64-apple-darwin"
        or require_uint(
            rows["published_process_count"],
            "darwin_runtime_published_process_count",
            positive=True,
        )
        <= 0
    ):
        fail("darwin_runtime_formal_validation_header_invalid")
    for key in DARWIN_RUNTIME_FORMAL_RECEIPT_KEYS:
        if (
            key.endswith("_sha256")
            or key.endswith("_raw32")
        ):
            require_sha(rows[key], "darwin_runtime_" + key)
    return rows


def parse_runtime_formal_receipt(
    path: pathlib.Path,
) -> tuple[dict[str, str], FileState]:
    state = stable_read(
        path,
        "darwin_runtime_formal_validation",
    )
    return (
        runtime_formal_receipt_rows(
            state.raw,
            "darwin_runtime_formal_validation",
        ),
        state,
    )


def run_runtime_formal_validation(
    root: pathlib.Path,
    publish_root: pathlib.Path,
    *,
    staged: bool,
    expected_receipt: pathlib.Path | None,
) -> tuple[dict[str, str], bytes]:
    formal_inputs_path = runtime_formal_inputs_path(root)
    formal_inputs_state = stable_read(
        formal_inputs_path,
        "darwin_runtime_formal_inputs",
    )
    formal_inputs, _ = parse_rows(
        formal_inputs_state.raw,
        "darwin_runtime_formal_inputs",
    )
    require_exact_keys(
        formal_inputs,
        DARWIN_RUNTIME_FORMAL_INPUT_KEYS,
        "darwin_runtime_formal_inputs",
    )
    validator_path = decoded_fs_path(
        formal_inputs["runtime_validator_path_fshex"],
        "darwin_runtime_validator",
    )
    validator_state = stable_read(
        validator_path,
        "darwin_runtime_validator",
        executable=True,
    )
    if (
        formal_inputs["driver_role"] != "production"
        or validator_path != DARWIN_RUNTIME_VALIDATOR
        or formal_inputs["runtime_validator_sha256"]
        != validator_state.sha256
        or stat.S_IMODE(validator_state.info.st_mode) != 0o555
        or validator_state.info.st_nlink != 1
        or validator_state.info.st_uid != os.geteuid()
        or validator_state.info.st_gid != os.getegid()
    ):
        fail("darwin_runtime_validator_authority_invalid")
    identity_logical = decoded_fs_path(
        formal_inputs["identity_manifest_path_fshex"],
        "darwin_runtime_identity_manifest",
    )
    output_logical = publish_root / formal_inputs_path.parent.relative_to(root)
    if (
        identity_logical == publish_root
        or not identity_logical.is_relative_to(publish_root)
        or output_logical == publish_root
        or not output_logical.is_relative_to(publish_root)
    ):
        fail("darwin_runtime_formal_path_authority_invalid")
    identity_physical = physical_publication_path(identity_logical)
    identity_state = stable_read(
        identity_physical,
        "darwin_runtime_identity_manifest",
    )
    if (
        identity_state.sha256
        != require_sha(
            formal_inputs["identity_manifest_sha256"],
            "darwin_runtime_identity_manifest",
        )
    ):
        fail("darwin_runtime_identity_manifest_binding_invalid")
    command = [
        str(BOOTSTRAP_VALIDATOR_PYTHON),
        "-I",
        "-S",
        "-B",
        str(validator_path),
        "validate",
        "--root",
        str(ROOT),
        "--evidence-root",
        str(root),
        "--publish-root",
        str(publish_root),
        "--identity-manifest",
        str(identity_physical),
        "--out",
        str(formal_inputs_path.parent),
    ]
    if staged:
        command.append("--staged")
    completed = subprocess.run(
        command,
        cwd=ROOT,
        env=BOOTSTRAP_VALIDATOR_ENV,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if (
        completed.returncode != 0
        or completed.stderr
        or not completed.stdout
        or len(completed.stdout) > 64 * 1024
    ):
        detail = (completed.stderr or completed.stdout)[:1024].decode(
            "utf-8",
            "replace",
        ).replace("\n", "_")
        fail(
            "darwin_runtime_formal_validation_red:"
            + str(completed.returncode)
            + ":"
            + detail
        )
    observed_rows = runtime_formal_receipt_rows(
        completed.stdout,
        "darwin_runtime_formal_observed",
    )
    if (
        decoded_fs_path(
            observed_rows["publish_root_fshex"],
            "darwin_runtime_receipt_publish_root",
        )
        != publish_root
        or decoded_fs_path(
            observed_rows["runtime_output_root_fshex"],
            "darwin_runtime_receipt_output_root",
        )
        != output_logical
        or observed_rows["runtime_validator_sha256"]
        != validator_state.sha256
        or observed_rows["identity_manifest_sha256"]
        != identity_state.sha256
        or observed_rows["formal_inputs_sha256"]
        != formal_inputs_state.sha256
    ):
        fail("darwin_runtime_formal_receipt_binding_invalid")
    if expected_receipt is not None:
        expected_rows, expected_state = parse_runtime_formal_receipt(
            expected_receipt
        )
        if (
            expected_rows != observed_rows
            or expected_state.raw != completed.stdout
        ):
            fail("darwin_runtime_formal_receipt_drift")
    return observed_rows, completed.stdout


def path_must_be_absent(path: pathlib.Path, label: str) -> None:
    try:
        path.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        fail(f"{label}_lookup_failed:{exc.errno}")
    fail(label + "_must_be_absent")


def publication_roots(
    work_root: pathlib.Path,
    publish_root: pathlib.Path,
) -> tuple[
    pathlib.Path,
    pathlib.Path,
    pathlib.Path,
    pathlib.Path,
    os.stat_result,
    os.stat_result,
    os.stat_result,
]:
    work_root = canonical_existing(
        work_root,
        "publication_work_root",
        directory=True,
    )
    anchor = canonical_existing(
        work_root.parent,
        "publication_anchor",
        directory=True,
    )
    if not publish_root.is_absolute():
        fail("publication_publish_root_not_absolute")
    parent = canonical_existing(
        publish_root.parent,
        "publication_parent",
        directory=True,
    )
    expected_anchor = publication_anchor_path(publish_root)
    if (
        work_root != anchor / "work"
        or anchor != expected_anchor
        or anchor.parent != parent
        or anchor == publish_root
        or publish_root != parent / publish_root.name
        or not publish_root.name
    ):
        fail("publication_anchor_work_final_shape_invalid")
    if pathlib.Path(os.path.realpath(publish_root)) != publish_root:
        fail("publication_publish_root_not_canonical")
    path_must_be_absent(publish_root, "publication_publish_root")
    work_info = work_root.lstat()
    anchor_info = anchor.lstat()
    parent_info = parent.lstat()
    if (
        stat.S_IMODE(work_info.st_mode) != 0o700
        or stat.S_IMODE(anchor_info.st_mode) != 0o700
        or work_info.st_uid != os.geteuid()
        or work_info.st_gid != os.getegid()
        or anchor_info.st_uid != work_info.st_uid
        or anchor_info.st_gid != work_info.st_gid
        or work_info.st_dev != anchor_info.st_dev
        or anchor_info.st_dev != parent_info.st_dev
    ):
        fail("publication_private_anchor_same_device_required")
    return (
        work_root,
        publish_root,
        anchor,
        parent,
        work_info,
        anchor_info,
        parent_info,
    )


def sync_publication_tree(root: pathlib.Path) -> None:
    root = canonical_existing(root, "publication_sync_root", directory=True)
    files, _ = enumerate_tree(root, set())
    for path in files:
        before = path.lstat()
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            opened = os.fstat(descriptor)
            if identity(opened) != identity(before):
                fail("publication_sync_file_open_race:" + str(path))
            os.fsync(descriptor)
            after_sync = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        after = path.lstat()
        if identity(before) != identity(after_sync) or identity(before) != identity(after):
            fail("publication_sync_file_drift:" + str(path))
    directories: list[pathlib.Path] = []
    for directory, names, filenames in os.walk(
        root,
        topdown=False,
        followlinks=False,
    ):
        names.sort(key=os.fsencode)
        filenames.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        for name in names:
            child = directory_path / name
            info = child.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail("publication_sync_directory_invalid:" + str(child))
        directories.append(directory_path)
    for directory in directories:
        descriptor = os.open(
            directory,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


