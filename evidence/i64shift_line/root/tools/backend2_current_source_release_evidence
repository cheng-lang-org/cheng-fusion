def read_framed_sequence(
    path: pathlib.Path,
    label: str,
    *,
    positive: bool,
) -> tuple[FileState, tuple[str, ...]]:
    state = stable_read(path, label)
    values: list[str] = []
    offset = 0
    while offset < len(state.raw):
        if len(state.raw) - offset < 8:
            fail(label + "_frame_length_truncated")
        length = struct.unpack_from(">Q", state.raw, offset)[0]
        offset += 8
        end = offset + length
        if end > len(state.raw):
            fail(label + "_frame_value_truncated")
        raw = state.raw[offset:end]
        offset = end
        if b"\0" in raw:
            fail(label + "_frame_nul")
        try:
            value = raw.decode("utf-8")
        except UnicodeDecodeError as exc:
            fail(f"{label}_frame_utf8_invalid:{exc}")
        if value.encode("utf-8") != raw:
            fail(label + "_frame_encoding_invalid")
        values.append(value)
    if positive and not values:
        fail(label + "_empty")
    return state, tuple(values)


def release_closure_members(path: pathlib.Path) -> dict[str, tuple[str, int]]:
    state = stable_read(path, "native_worker_release_source_closure")
    try:
        lines = state.raw.decode("ascii", "strict").splitlines()
    except UnicodeDecodeError as exc:
        fail(f"native_worker_release_source_closure_ascii_invalid:{exc}")
    if (
        len(lines) < 5
        or lines[0] != "schema=cheng.current_source_closure_manifest"
    ):
        fail("native_worker_release_source_closure_schema_invalid")
    count_rows = [row for row in lines if row.startswith("path_count=")]
    if len(count_rows) != 1:
        fail("native_worker_release_source_closure_count_invalid")
    count = require_uint(
        count_rows[0].split("=", 1)[1],
        "native_worker_release_source_closure_count",
    )
    count_index = lines.index(count_rows[0])
    if (
        count_index + 1 >= len(lines)
        or not lines[count_index + 1].startswith("content_cid=")
    ):
        fail("native_worker_release_source_closure_content_cid_absent")
    try:
        source_closure_manifest.content_cid_from_manifest(state.raw)
    except RuntimeError as exc:
        fail(
            "native_worker_release_source_closure_content_cid_invalid:"
            + str(exc)
        )
    member_rows = lines[count_index + 2 :]
    if len(member_rows) != count:
        fail("native_worker_release_source_closure_member_count_invalid")
    result: dict[str, tuple[str, int]] = {}
    prior = b""
    for row in member_rows:
        fields = row.split("\t")
        if len(fields) not in (2, 9):
            fail("native_worker_release_source_closure_member_invalid")
        try:
            path_raw = bytes.fromhex(fields[0])
            relative = os.fsdecode(path_raw)
        except (ValueError, UnicodeError) as exc:
            fail(f"native_worker_release_source_closure_path_invalid:{exc}")
        if path_raw <= prior or relative in result:
            fail("native_worker_release_source_closure_order_invalid")
        prior = path_raw
        if len(fields) == 2:
            if fields[1] != "tracked_deleted":
                fail("native_worker_release_source_closure_delete_invalid")
            continue
        digest = require_sha(
            fields[2],
            "native_worker_release_source_closure_member",
        )
        size = require_uint(
            fields[6],
            "native_worker_release_source_closure_member_size",
        )
        result[relative] = (digest, size)
    return result


def candidate_frozen_bridge(
    path: pathlib.Path,
    *,
    expected_sha256: str,
    release_source_closure: pathlib.Path,
) -> tuple[FileState, int, str]:
    state = stable_read(path, "candidate_frozen_manifest")
    if state.sha256 != require_sha(
        expected_sha256,
        "candidate_frozen_manifest",
    ):
        fail("candidate_frozen_manifest_digest_mismatch")
    try:
        value = json.loads(state.raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail(f"candidate_frozen_manifest_json_invalid:{exc}")
    canonical = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8") + b"\n"
    if state.raw != canonical or not isinstance(value, dict):
        fail("candidate_frozen_manifest_not_canonical")
    if set(value) != {
        "schema",
        "sourceEntryCount",
        "sourceClosureSha256",
        "sourceEntries",
        "toolEntryCount",
        "toolClosureSha256",
        "toolEntries",
    }:
        fail("candidate_frozen_manifest_key_set_invalid")
    if value.get("schema") != "cheng.cid_linux_current_source_closure":
        fail("candidate_frozen_manifest_schema_invalid")
    release_members = release_closure_members(release_source_closure)
    overlap: list[tuple[str, str, int]] = []
    critical = {
        "bootstrap/cheng_cold.c",
        "bootstrap/cold_parser.c",
        "src/core/tooling/backend_driver_dispatch_min.cheng",
        "src/core/tooling/backend_driver_main.cheng",
        "tools/backend2_version_manifest.rec",
        "tools/cid_linux_current_source_candidate_builder.py",
        "tools/cid_linux_current_source_candidate_gate.sh",
        "tools/cid_linux_current_source_candidate_validate.py",
        "tools/cid_linux_current_source_candidate_workload.sh",
    }
    seen: set[str] = set()
    for entries_key, count_key in (
        ("sourceEntries", "sourceEntryCount"),
        ("toolEntries", "toolEntryCount"),
    ):
        entries = value.get(entries_key)
        if (
            not isinstance(entries, list)
            or value.get(count_key) != len(entries)
            or not entries
        ):
            fail("candidate_frozen_manifest_entry_count_invalid")
        prior = b""
        for entry in entries:
            if not isinstance(entry, dict) or set(entry) != {
                "path",
                "size",
                "sha256",
            }:
                fail("candidate_frozen_manifest_entry_invalid")
            relative = entry.get("path")
            size = entry.get("size")
            digest = entry.get("sha256")
            if (
                not isinstance(relative, str)
                or not relative
                or relative.startswith("/")
                or any(part in ("", ".", "..") for part in relative.split("/"))
                or relative in seen
            ):
                fail("candidate_frozen_manifest_entry_path_invalid")
            encoded = relative.encode("utf-8")
            if encoded <= prior:
                fail("candidate_frozen_manifest_entry_order_invalid")
            prior = encoded
            seen.add(relative)
            if (
                not isinstance(size, int)
                or isinstance(size, bool)
                or size < 0
            ):
                fail("candidate_frozen_manifest_entry_size_invalid")
            digest = require_sha(
                str(digest),
                "candidate_frozen_manifest_entry",
            )
            release_identity = release_members.get(relative)
            in_release_scope = (
                relative == ".gitignore"
                or relative in (
                    "cheng-package.toml",
                    "cheng.lock.toml",
                    "docs/cheng-formal-spec.md",
                )
                or relative.startswith(("bootstrap/", "src/", "tools/"))
            )
            if in_release_scope:
                if release_identity != (digest, size):
                    fail(
                        "candidate_frozen_release_member_mismatch:"
                        + relative
                    )
                overlap.append((relative, digest, size))
    if not critical.issubset(seen) or len(overlap) < len(critical):
        fail("candidate_frozen_release_critical_bridge_missing")
    payload = bytearray()
    for relative, digest, size in sorted(
        overlap,
        key=lambda row: row[0].encode("utf-8"),
    ):
        raw = relative.encode("utf-8")
        payload.extend(struct.pack(">Q", len(raw)))
        payload.extend(raw)
        payload.extend(bytes.fromhex(digest))
        payload.extend(struct.pack(">Q", size))
    return state, len(overlap), hashlib.sha256(payload).hexdigest()


