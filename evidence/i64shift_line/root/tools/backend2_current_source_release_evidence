def validate_leg(
    receipt: pathlib.Path,
    target: str,
    backend: str,
    binding: dict[str, str],
    root: pathlib.Path,
) -> tuple[FileState, dict[str, FileState], dict[str, str]]:
    target, expected_os, expected_machine = expected_leg(target, backend)
    receipt = require_descendant(receipt, root, "release_leg")
    rows, state = read_rows(receipt, "release_leg", "receipt_payload_sha256")
    required = {
        "schema": "cheng.backend2.current_source_release_leg",
        "status": "PASS",
        "driver_role": "production",
        "target": target,
        "backend": backend,
        "host_os": expected_os,
        "host_machine": expected_machine,
        "native_execution": "true",
        "emulation": "false",
        "snapshot_manifest_sha256": binding["snapshot_manifest_sha256"],
        "source_closure_cid": binding["source_closure_cid"],
        "official_driver_sha256": binding["official_driver_sha256"],
        "backend_epoch_sha256": binding["backend_epoch_sha256"],
        "jobs_sha256": binding["jobs_sha256"],
        "action_ledger_sha256": binding["action_ledger_sha256"],
        "fragment_snapshot_sha256": binding["fragment_snapshot_sha256"],
        "regalloc_receipt_sha256": binding["regalloc_receipt_sha256"],
        "fixed_object_sha256": binding["fixed_object_sha256"],
        "fixed_template_count": "0",
        "run_rc": "0",
        "debug_status": "proved",
        "orc_live": "0",
        "exec_diff_miscompile_count": "0",
    }
    for key, value in required.items():
        if rows.get(key) != value:
            fail(f"release_leg_field_invalid:{target}:{backend}:{key}")
    exact_keys = set(required) | {
        "body_ir_entry_count",
        "debug_section_count",
        "orc_iterations",
        "orc_alloc",
        "orc_free",
        "exec_diff_case_count",
        "exec_diff_report_sha256",
        "exec_diff_cases_sha256",
        "target_action_sha256",
        "target_fragment_sha256",
        "orc_events_sha256",
        "source_bundle_raw32",
        "execution_raw32",
        "body_ir_raw32",
        "raw_manifest_path",
        "raw_manifest_sha256",
        "receipt_payload_sha256",
    }
    require_exact_keys(rows, exact_keys, "release_leg")

    validate_release_leg_identity(rows, binding)
    if require_uint(rows.get("body_ir_entry_count", ""), "body_ir_entry_count", positive=True) <= 0:
        fail("release_leg_body_ir_empty")
    debug_sections = require_uint(
        rows.get("debug_section_count", ""), "debug_section_count", positive=True
    )
    if debug_sections <= 0:
        fail("release_leg_debug_sections_empty")
    iterations = require_uint(rows.get("orc_iterations", ""), "orc_iterations")
    allocations = require_uint(rows.get("orc_alloc", ""), "orc_alloc")
    frees = require_uint(rows.get("orc_free", ""), "orc_free")
    if iterations != 5000 or allocations != frees or allocations < iterations:
        fail("release_leg_orc_balance_invalid")
    if require_uint(
        rows.get("exec_diff_case_count", ""), "exec_diff_case_count"
    ) < 209:
        fail("release_leg_exec_diff_case_count_invalid")
    raw_manifest = require_descendant(
        pathlib.Path(rows.get("raw_manifest_path", "")),
        root,
        "leg_raw_manifest",
    )
    artifacts, raw_state = validate_raw_manifest(
        raw_manifest, root, target, backend
    )
    if raw_state.sha256 != require_sha(
        rows.get("raw_manifest_sha256", ""), "leg_raw_manifest"
    ):
        fail("release_leg_raw_manifest_digest_mismatch")
    if artifacts["object"].info.st_size <= 0:
        fail("release_leg_object_empty")
    for role, executable in (
        ("object", False),
        ("run_executable", True),
        ("debug_object", False),
        ("orc_executable", True),
    ):
        require_binary_arch(
            artifacts[role], target, role, executable=executable
        )
    validate_run_artifacts(artifacts)
    for role in ("target_action", "target_fragment", "orc_events"):
        if artifacts[role].sha256 != require_sha(
            rows.get(role + "_sha256", ""), role
        ):
            fail("release_leg_current_raw_artifact_mismatch:" + role)
    validate_current_target_json(
        artifacts,
        target,
        expected_machine,
        backend,
        binding,
        rows,
    )
    if (
        artifacts["action_ledger"].sha256 != binding["action_ledger_sha256"]
        or artifacts["fragment_snapshot"].sha256
        != binding["fragment_snapshot_sha256"]
    ):
        fail("release_leg_action_fragment_identity_mismatch")
    if (
        artifacts["exec_diff_report"].sha256
        != require_sha(
            rows.get("exec_diff_report_sha256", ""), "exec_diff_report"
        )
        or artifacts["exec_diff_cases"].sha256
        != require_sha(
            rows.get("exec_diff_cases_sha256", ""), "exec_diff_cases"
        )
        or artifacts["exec_diff_cases"].info.st_size <= 0
    ):
        fail("release_leg_exec_diff_artifact_mismatch")
    validate_leg_reports(artifacts, target, backend, binding, rows)
    return state, artifacts, rows


def validate_cgroup_workload(
    evidence_dir: pathlib.Path,
    target: str,
    workload_kind: str,
    binding: dict[str, str],
    root: pathlib.Path,
) -> FileState:
    machine = {
        "aarch64-unknown-linux-gnu": "aarch64",
        "x86_64-unknown-linux-gnu": "x86_64",
    }.get(target)
    if machine is None or workload_kind not in NATIVE_DESCRIPTOR_WORKLOADS:
        fail("cgroup_workload_identity_invalid")
    evidence_dir = require_descendant(
        evidence_dir,
        root,
        "cgroup_workload_evidence_dir",
        directory=True,
    )
    cgroup_receipt = stable_read(
        evidence_dir / "receipt.kv",
        "cgroup_workload_receipt",
    )
    cgroup_rows, _ = read_rows(
        evidence_dir / "receipt.kv",
        "cgroup_workload_receipt",
        "receipt_sha256",
    )
    descriptor_path = fs_path(
        cgroup_rows.get("native_descriptor_path_fshex", ""),
        "cgroup_workload_native_descriptor",
    )
    descriptor_state, descriptor_rows = native_descriptor(
        descriptor_path,
        expected_target=target,
        expected_machine=machine,
        expected_workload_kind=workload_kind,
        binding=binding,
    )
    descriptor_prefix = native_descriptor_binding_prefix(
        machine,
        workload_kind,
    )
    if (
        descriptor_state.sha256
        != binding[descriptor_prefix + "_descriptor_sha256"]
    ):
        fail("cgroup_workload_native_descriptor_digest_mismatch")
    build_receipt_path = fs_path(
        descriptor_rows["candidate_build_receipt_path_fshex"],
        "cgroup_workload_candidate_build_receipt",
    )
    build_receipt_state, build_receipt_rows, worker_state = (
        candidate_build_receipt(
            build_receipt_path,
            expected_target=target,
            expected_machine=machine,
            binding=binding,
        )
    )
    source_closure_path = fs_path(
        build_receipt_rows["release_source_closure_path_fshex"],
        "cgroup_workload_source_closure",
    )
    completed = subprocess.run(
        [
            sys.executable,
            str(CGROUP_VALIDATOR),
            "--evidence-dir",
            str(evidence_dir),
            "--aggregate-evidence-dir",
            str(evidence_dir.parent / "aggregate-oom"),
            "--workspace-root",
            str(ROOT),
            "--source-closure",
            str(source_closure_path),
            "--driver",
            str(worker_state.path),
            "--build-receipt",
            str(build_receipt_state.path),
            "--native-descriptor",
            str(descriptor_state.path),
            "--native-descriptor-sha256",
            descriptor_state.sha256,
            "--workload-kind",
            workload_kind,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        fail(
            "cgroup_workload_receipt_invalid:"
            + target
            + ":"
            + workload_kind
            + ":"
            + completed.stderr.decode("utf-8", "replace").strip()
        )
    cgroup_expected = {
        "workload_kind": workload_kind,
        "image_id": binding[descriptor_prefix + "_image_id"],
        "native_descriptor_sha256": descriptor_state.sha256,
        "native_descriptor_candidate_build_receipt_sha256":
            build_receipt_state.sha256,
        "target_argv_sha256":
            binding[descriptor_prefix + "_target_argv_sha256"],
        "target_env_sha256":
            binding[descriptor_prefix + "_target_env_sha256"],
        "vm_architecture": machine,
        "memory_limit_bytes": str(LIMIT_BYTES),
        "memory_swap_max_bytes": "0",
        "status": "completed",
    }
    for key, value in cgroup_expected.items():
        if cgroup_rows.get(key) != value:
            fail(
                "cgroup_workload_binding_invalid:"
                + target
                + ":"
                + workload_kind
                + ":"
                + key
            )
    return cgroup_receipt


def validate_perf(
    raw_path: pathlib.Path,
    verdict_path: pathlib.Path,
    binding: dict[str, str],
    root: pathlib.Path,
) -> tuple[FileState, FileState]:
    raw_path = require_descendant(raw_path, root, "performance_raw_samples")
    verdict_path = require_descendant(
        verdict_path, root, "performance_verdict"
    )
    raw_state = stable_read(raw_path, "performance_raw_samples")
    if (
        not raw_state.raw.endswith(b"\n")
        or b"\r" in raw_state.raw
        or b"\0" in raw_state.raw
    ):
        fail("performance_raw_encoding_invalid")
    try:
        lines = raw_state.raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as exc:
        fail(f"performance_raw_utf8_invalid:{exc}")
    if len(lines) != 12:
        fail("performance_sample_count_invalid")
    rows: list[dict[str, int | str]] = []
    artifact_paths: set[pathlib.Path] = set()
    artifact_inodes: set[tuple[int, int]] = set()
    for index, line in enumerate(lines):
        fields = line.split("\t")
        if len(fields) != 22:
            fail("performance_sample_field_count_invalid")
        ordinal, block, pattern, position, jobs, role = (
            require_uint(fields[0], "performance_ordinal"),
            require_uint(fields[1], "performance_block"),
            fields[2],
            require_uint(fields[3], "performance_position"),
            require_uint(fields[4], "performance_jobs", positive=True),
            fields[5],
        )
        if (
            (pattern, jobs, role) != PERF_SCHEDULE[index]
            or ordinal != index
            or block != index // 4
            or position != index % 4
        ):
            fail("performance_sample_order_invalid")
        wall = require_uint(fields[6], "performance_wall", positive=True)
        peak = require_uint(fields[7], "performance_peak", positive=True)
        if peak > LIMIT_BYTES:
            fail("performance_peak_exceeds_limit")
        expected_compiler = (
            binding["official_driver_sha256"]
            if role == "candidate"
            else binding["baseline_driver_sha256"]
        )
        if (
            fields[8] != binding["performance_source_sha256"]
            or fields[9] != expected_compiler
        ):
            fail("performance_sample_identity_mismatch")
        for offset in range(10, 22, 2):
            path = pathlib.Path(fields[offset])
            state = stable_read(
                require_descendant(path, root, "performance_artifact"),
                "performance_artifact",
            )
            if state.sha256 != require_sha(
                fields[offset + 1], "performance_artifact"
            ):
                fail("performance_artifact_digest_mismatch")
            if path in artifact_paths:
                fail("performance_artifact_path_reused")
            inode = (state.info.st_dev, state.info.st_ino)
            if inode in artifact_inodes:
                fail("performance_artifact_inode_reused")
            artifact_paths.add(path)
            artifact_inodes.add(inode)
        rows.append(
            {
                "block": block,
                "role": role,
                "wall": wall,
                "peak": peak,
                "object_sha": fields[13],
            }
        )
    wall_ratios: list[int] = []
    rss_ratios: list[int] = []
    for block in (0, 1, 2):
        block_rows = [row for row in rows if row["block"] == block]
        candidate = [
            row for row in block_rows if row["role"] == "candidate"
        ]
        baseline = [
            row for row in block_rows if row["role"] == "baseline"
        ]
        wall_ratios.append(
            sum(int(row["wall"]) for row in candidate)
            * 1_000_000
            // sum(int(row["wall"]) for row in baseline)
        )
        rss_ratios.append(
            sum(int(row["peak"]) for row in candidate)
            * 1_000_000
            // sum(int(row["peak"]) for row in baseline)
        )
    if (
        max(wall_ratios) > 1_050_000
        or max(rss_ratios) > 1_050_000
        or max(wall_ratios) - min(wall_ratios) > 100_000
        or max(rss_ratios) - min(rss_ratios) > 100_000
    ):
        fail("performance_wall_or_rss_contract_failed")
    if len(
        {
            row["object_sha"]
            for row in rows
            if row["role"] == "candidate"
        }
    ) != 1:
        fail("performance_candidate_object_nondeterministic")
    if len({row["object_sha"] for row in rows if row["role"] == "baseline"}) != 1:
        fail("performance_baseline_object_nondeterministic")
    verdict_rows, verdict_state = read_rows(
        verdict_path, "performance_verdict", "verdict_payload_sha256"
    )
    required = {
        "schema": "cheng.backend2.current_source_performance_verdict",
        "status": "PASS",
        "raw_samples_sha256": raw_state.sha256,
        "source_closure_cid": binding["source_closure_cid"],
        "performance_source_sha256": binding["performance_source_sha256"],
        "candidate_compiler_sha256": binding["official_driver_sha256"],
        "baseline_compiler_sha256": binding["baseline_driver_sha256"],
        "sample_count": "12",
    }
    for key, value in required.items():
        if verdict_rows.get(key) != value:
            fail("performance_verdict_field_invalid:" + key)
    verdict_keys = set(required) | {
        "wall_ratio_max_ppm",
        "rss_ratio_max_ppm",
        "wall_pair_spread_ppm",
        "rss_pair_spread_ppm",
        "candidate_spill_density_ppm",
        "baseline_spill_density_ppm",
        "candidate_text_bytes",
        "baseline_text_bytes",
        "clang_text_bytes",
        "text_clang_ratio_ppm",
        "verdict_payload_sha256",
    }
    require_exact_keys(verdict_rows, verdict_keys, "performance_verdict")
    exact_metrics = {
        "wall_ratio_max_ppm": max(wall_ratios),
        "rss_ratio_max_ppm": max(rss_ratios),
        "wall_pair_spread_ppm": max(wall_ratios) - min(wall_ratios),
        "rss_pair_spread_ppm": max(rss_ratios) - min(rss_ratios),
    }
    for key, value in exact_metrics.items():
        if require_uint(verdict_rows.get(key, ""), key) != value:
            fail("performance_verdict_derived_metric_invalid:" + key)
    candidate_spill = require_uint(
        verdict_rows.get("candidate_spill_density_ppm", ""),
        "candidate_spill",
    )
    baseline_spill = require_uint(
        verdict_rows.get("baseline_spill_density_ppm", ""), "baseline_spill"
    )
    candidate_text = require_uint(
        verdict_rows.get("candidate_text_bytes", ""),
        "candidate_text",
        positive=True,
    )
    baseline_text = require_uint(
        verdict_rows.get("baseline_text_bytes", ""), "baseline_text", positive=True
    )
    clang_text = require_uint(
        verdict_rows.get("clang_text_bytes", ""), "clang_text", positive=True
    )
    if (
        candidate_spill >= baseline_spill
        or candidate_spill > 250_000
        or candidate_text >= baseline_text
        or candidate_text * 1_000_000 // clang_text > 2_000_000
    ):
        fail("performance_object_shape_contract_failed")
    if require_uint(
        verdict_rows.get("text_clang_ratio_ppm", ""),
        "text_clang_ratio",
    ) != candidate_text * 1_000_000 // clang_text:
        fail("performance_text_clang_ratio_invalid")
    return raw_state, verdict_state


def validate_performance_evidence(
    path: pathlib.Path,
    root: pathlib.Path,
    binding: dict[str, str],
    source_bundle_raw32: str,
    execution_raw32: str,
) -> FileState:
    path = require_descendant(path, root, "performance_evidence")
    state = stable_read(path, "performance_evidence")
    evidence = canonical_json_object(state, "performance_evidence")
    exact_keys = {
        "schema",
        "status",
        "sourceBundleRaw32",
        "officialDriverRaw32",
        "executionRaw32",
        "jobsN",
        "baselineIdentity",
        "candidateAction",
        "candidateFragment",
        "candidateObject",
        "baselineAction",
        "baselineFragment",
        "baselineObject",
        "currentTextBinary",
        "baselineTextBinary",
        "clangTextBinary",
        "commands",
        "environments",
        "samples",
    }
    require_exact_keys(
        {str(key): "" for key in evidence},
        exact_keys,
        "performance_evidence",
    )
    if (
        evidence.get("schema") != "cheng_current_performance_evidence"
        or evidence.get("status") != "COMPLETE"
        or evidence.get("sourceBundleRaw32") != source_bundle_raw32
        or evidence.get("officialDriverRaw32")
        != binding["official_driver_sha256"]
        or evidence.get("executionRaw32") != execution_raw32
        or evidence.get("jobsN") != PERF_JOBS_N
    ):
        fail("performance_evidence_identity_invalid")
    seen_paths: set[pathlib.Path] = set()

    def pin(value: object, label: str) -> tuple[FileState, dict[str, object]]:
        if not isinstance(value, dict) or set(value) != {
            "path",
            "byteLength",
            "bytesRaw32",
        }:
            fail(label + "_pin_invalid")
        raw_path = value.get("path")
        if not isinstance(raw_path, str):
            fail(label + "_pin_path_invalid")
        artifact_path = require_descendant(
            pathlib.Path(raw_path), root, label + "_pin"
        )
        artifact = stable_read(artifact_path, label + "_pin")
        if (
            artifact_path in seen_paths
            or value.get("byteLength") != artifact.info.st_size
            or value.get("bytesRaw32") != artifact.sha256
        ):
            fail(label + "_pin_drift")
        seen_paths.add(artifact_path)
        return artifact, value

    for key in (
        "candidateAction",
        "candidateFragment",
        "candidateObject",
        "baselineAction",
        "baselineFragment",
        "baselineObject",
        "currentTextBinary",
        "baselineTextBinary",
        "clangTextBinary",
    ):
        pin(evidence.get(key), "performance_" + key)
    baseline_identity = evidence.get("baselineIdentity")
    if not isinstance(baseline_identity, dict) or set(baseline_identity) != {
        "sourceBundleRaw32",
        "driverRaw32",
        "executionRaw32",
    }:
        fail("performance_baseline_identity_invalid")
    for key, value in baseline_identity.items():
        require_sha(str(value), "performance_baseline_" + key)
    commands = evidence.get("commands")
    expected_commands = (
        ("candidate", 1),
        ("baseline", 1),
        ("candidate", PERF_JOBS_N),
        ("baseline", PERF_JOBS_N),
    )
    if not isinstance(commands, list) or len(commands) != 4:
        fail("performance_command_set_invalid")
    for index, expected in enumerate(expected_commands):
        row = commands[index]
        if (
            not isinstance(row, dict)
            or set(row) != {"role", "jobs", "artifact"}
            or (row.get("role"), row.get("jobs")) != expected
        ):
            fail("performance_command_order_invalid")
        command_state, _ = pin(
            row.get("artifact"), f"performance_command_{index}"
        )
        command = canonical_json_object(
            command_state, f"performance_command_{index}"
        )
        if (
            command.get("schema") != "cheng_current_performance_command"
            or command.get("status") != "COMPLETE"
            or command.get("role") != expected[0]
            or command.get("jobs") != expected[1]
        ):
            fail("performance_command_identity_invalid")
    environments = evidence.get("environments")
    if not isinstance(environments, list) or len(environments) != 2:
        fail("performance_environment_set_invalid")
    for index, jobs in enumerate((1, PERF_JOBS_N)):
        row = environments[index]
        if (
            not isinstance(row, dict)
            or set(row) != {"jobs", "artifact"}
            or row.get("jobs") != jobs
        ):
            fail("performance_environment_order_invalid")
        environment_state, _ = pin(
            row.get("artifact"), f"performance_environment_{index}"
        )
        environment = canonical_json_object(
            environment_state, f"performance_environment_{index}"
        )
        if (
            environment.get("schema")
            != "cheng_current_performance_environment"
            or environment.get("status") != "COMPLETE"
            or environment.get("jobs") != jobs
            or environment.get("samplingScope") != "process_tree_recursive"
            or environment.get("sampleClock") != "monotonic_ns"
        ):
            fail("performance_environment_identity_invalid")
    samples = evidence.get("samples")
    if not isinstance(samples, list) or len(samples) != 12:
        fail("performance_trace_set_invalid")
    for index, (order, jobs, role) in enumerate(PERF_SCHEDULE):
        row = samples[index]
        if (
            not isinstance(row, dict)
            or set(row)
            != {"ordinal", "order", "position", "jobs", "role", "trace"}
            or row.get("ordinal") != index
            or row.get("order") != order
            or row.get("position") != index % 4
            or row.get("jobs") != jobs
            or row.get("role") != role
        ):
            fail("performance_trace_order_invalid")
        trace_state, _ = pin(
            row.get("trace"), f"performance_trace_{index}"
        )
        trace = canonical_json_object(
            trace_state, f"performance_trace_{index}"
        )
        if (
            trace.get("schema")
            != "cheng_current_performance_sample_trace"
            or trace.get("status") != "COMPLETE"
            or trace.get("ordinal") != index
            or trace.get("order") != order
            or trace.get("position") != index % 4
            or trace.get("jobs") != jobs
            or trace.get("role") != role
            or not isinstance(trace.get("samples"), list)
            or len(trace["samples"]) < 2
        ):
            fail("performance_trace_identity_invalid")
    return state


def binding_rows(path: pathlib.Path) -> tuple[dict[str, str], FileState]:
    rows, state = read_rows(path, "release_binding", "binding_payload_sha256")
    if (
        rows.get("schema") != "cheng.backend2.current_source_release_binding"
        or rows.get("status") != "PASS"
        or rows.get("driver_role") != "production"
    ):
        fail("release_binding_header_invalid")
    descriptor_digest_keys = tuple(
        prefix + "_" + suffix
        for prefix in NATIVE_DESCRIPTOR_BINDING_PREFIXES
        for suffix in (
            "descriptor_sha256",
            "target_argv_sha256",
            "target_env_sha256",
        )
    )
    digest_keys = (
        "contract_sha256",
        "snapshot_manifest_sha256",
        "source_closure_cid",
        "official_receipt_sha256",
        "official_driver_sha256",
        "backend_epoch_sha256",
        "jobs_sha256",
        "action_ledger_sha256",
        "fragment_snapshot_sha256",
        "regalloc_receipt_sha256",
        "fixed_point_sha256",
        "fixed_object_sha256",
        "candidate_report_sha256",
        "seven_stage_parser_ingress_sha256",
        "seven_stage_parser_map_sha256",
        "seven_stage_policy_sha256",
        "seven_stage_runner_manifest_sha256",
        "seven_stage_report_sha256",
        "seven_stage_execution_raw32",
        "seven_stage_root_raw32",
        "baseline_manifest_sha256",
        "baseline_driver_sha256",
        "performance_source_sha256",
        "darwin_bootstrap_lane_receipt_sha256",
        "darwin_bootstrap_lane_validator_sha256",
        "darwin_bootstrap_phase_chain_sha256",
        "darwin_bootstrap_guard_aggregate_sha256",
        "darwin_bootstrap_stage3_sha256",
        *descriptor_digest_keys,
    )
    for key in digest_keys:
        require_sha(rows.get(key, ""), "release_binding_" + key)
    require_exact_keys(
        rows,
        {
            "schema",
            "status",
            "driver_role",
            "publication_root_fshex",
            *digest_keys,
            *DARWIN_BOOTSTRAP_BINDING_KEYS,
            *(
                prefix + "_image_id"
                for prefix in NATIVE_DESCRIPTOR_BINDING_PREFIXES
            ),
            "binding_payload_sha256",
        },
        "release_binding",
    )
    for key in (
        prefix + "_image_id"
        for prefix in NATIVE_DESCRIPTOR_BINDING_PREFIXES
    ):
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", rows.get(key, "")):
            fail("release_binding_image_id_invalid:" + key)
    publication_root = decoded_fs_path(
        rows.get("publication_root_fshex", ""),
        "release_binding_publication_root",
    )
    if (
        not publication_root.is_absolute()
        or publication_root != publication_root.parent / publication_root.name
        or pathlib.Path(os.path.realpath(publication_root.parent))
        != publication_root.parent
    ):
        fail("release_binding_publication_root_invalid")
    darwin_bootstrap_binding_projection(
        rows,
        revalidate_authority=True,
    )
    return rows, state


def validate_exec_diff_receipt(
    path: pathlib.Path,
    target: str,
    binding: dict[str, str],
    root: pathlib.Path,
    primary_leg_sha256: str,
    backend2_leg_sha256: str,
    primary_artifacts: dict[str, FileState],
    backend2_artifacts: dict[str, FileState],
) -> FileState:
    for role in (
        "run_stdout",
        "run_stderr",
        "orc_stdout",
        "orc_stderr",
        "exec_diff_cases",
    ):
        if primary_artifacts[role].raw != backend2_artifacts[role].raw:
            fail("exec_diff_backend_output_mismatch:" + target + ":" + role)
    path = require_descendant(path, root, "exec_diff_receipt")
    rows, state = read_rows(
        path, "exec_diff_receipt", "receipt_payload_sha256"
    )
    required = {
        "schema": "cheng.backend2.current_source_exec_diff",
        "status": "PASS",
        "driver_role": "production",
        "target": target,
        "source_closure_cid": binding["source_closure_cid"],
        "official_driver_sha256": binding["official_driver_sha256"],
        "backend_epoch_sha256": binding["backend_epoch_sha256"],
        "jobs_sha256": binding["jobs_sha256"],
        "action_ledger_sha256": binding["action_ledger_sha256"],
        "fragment_snapshot_sha256": binding["fragment_snapshot_sha256"],
        "primary_leg_receipt_sha256": primary_leg_sha256,
        "backend2_leg_receipt_sha256": backend2_leg_sha256,
        "miscompile_count": "0",
        "debug_mismatch_count": "0",
        "run_equivalent": "true",
        "debug_equivalent": "true",
        "orc_equivalent": "true",
        "primary_run_stdout_sha256": primary_artifacts[
            "run_stdout"
        ].sha256,
        "backend2_run_stdout_sha256": backend2_artifacts[
            "run_stdout"
        ].sha256,
        "primary_run_stderr_sha256": primary_artifacts[
            "run_stderr"
        ].sha256,
        "backend2_run_stderr_sha256": backend2_artifacts[
            "run_stderr"
        ].sha256,
        "primary_orc_stdout_sha256": primary_artifacts[
            "orc_stdout"
        ].sha256,
        "backend2_orc_stdout_sha256": backend2_artifacts[
            "orc_stdout"
        ].sha256,
        "primary_orc_stderr_sha256": primary_artifacts[
            "orc_stderr"
        ].sha256,
        "backend2_orc_stderr_sha256": backend2_artifacts[
            "orc_stderr"
        ].sha256,
        "primary_cases_sha256": primary_artifacts[
            "exec_diff_cases"
        ].sha256,
        "backend2_cases_sha256": backend2_artifacts[
            "exec_diff_cases"
        ].sha256,
    }
    for key, value in required.items():
        if rows.get(key) != value:
            fail("exec_diff_receipt_field_invalid:" + target + ":" + key)
    require_exact_keys(
        rows,
        set(required)
        | {
            "case_count",
            "debug_case_count",
            "report_path_fshex",
            "report_sha256",
            "cases_path_fshex",
            "cases_sha256",
            "receipt_payload_sha256",
        },
        "exec_diff_receipt",
    )
    if require_uint(rows.get("case_count", ""), "exec_diff_case_count") < 209:
        fail("exec_diff_receipt_case_count_invalid:" + target)
    if require_uint(
        rows.get("debug_case_count", ""),
        "exec_diff_debug_case_count",
        positive=True,
    ) <= 0:
        fail("exec_diff_receipt_debug_case_count_invalid:" + target)
    for role in ("report", "cases"):
        artifact_path = fs_path(
            rows.get(role + "_path_fshex", ""), "exec_diff_" + role
        )
        artifact = stable_read(
            require_descendant(
                artifact_path, root, "exec_diff_" + role
            ),
            "exec_diff_" + role,
        )
        if artifact.sha256 != require_sha(
            rows.get(role + "_sha256", ""), "exec_diff_" + role
        ):
            fail("exec_diff_receipt_artifact_mismatch:" + target + ":" + role)
        if role == "cases" and artifact.info.st_size <= 0:
            fail("exec_diff_receipt_cases_empty:" + target)
    return state


def _validate_completion(root: pathlib.Path) -> None:
    root = canonical_existing(root, "release_evidence_root", directory=True)
    contract_state = validate_contract(root / "contract.kv")
    binding, binding_state = binding_rows(root / "binding.kv")
    logical_root = root
    if (
        _PUBLICATION_PATH_PROJECTION is not None
        and root == _PUBLICATION_PATH_PROJECTION[0]
    ):
        logical_root = _PUBLICATION_PATH_PROJECTION[1]
    if decoded_fs_path(
        binding["publication_root_fshex"],
        "completion_binding_root",
    ) != logical_root:
        fail("completion_binding_root_mismatch")
    index, _ = read_rows(
        root / "completion-index.kv",
        "completion_index",
        "index_payload_sha256",
    )
    if binding["contract_sha256"] != contract_state.sha256:
        fail("release_binding_contract_mismatch")
    performance_source = stable_read(
        root / "performance-source.cheng", "performance_source"
    )
    if performance_source.sha256 != binding["performance_source_sha256"]:
        fail("performance_source_binding_mismatch")
    if (
        index.get("schema")
        != "cheng.backend2.current_source_release_completion_index"
        or index.get("status") != "PASS"
        or index.get("driver_role") != "production"
        or index.get("contract_sha256") != contract_state.sha256
        or index.get("binding_sha256") != binding_state.sha256
        or index.get("leg_count") != "6"
        or index.get("exec_diff_count") != "3"
        or index.get("linux_hard_memory_leg_count") != "4"
    ):
        fail("completion_index_header_invalid")
    index_keys = {
        "schema",
        "status",
        "driver_role",
        "contract_sha256",
        "binding_sha256",
        "source_closure_before_path_fshex",
        "source_closure_before_sha256",
        "source_closure_after_path_fshex",
        "source_closure_after_sha256",
        "leg_count",
        "exec_diff_count",
        "linux_hard_memory_leg_count",
        "performance_raw_path_fshex",
        "performance_raw_sha256",
        "performance_verdict_path_fshex",
        "performance_verdict_sha256",
        "performance_evidence_path_fshex",
        "performance_evidence_sha256",
        "index_payload_sha256",
    }
    for leg_index in range(6):
        index_keys.update(
            {
                f"leg.{leg_index}.target",
                f"leg.{leg_index}.backend",
                f"leg.{leg_index}.receipt_path_fshex",
                f"leg.{leg_index}.receipt_sha256",
            }
        )
    for diff_index in range(3):
        index_keys.update(
            {
                f"exec_diff.{diff_index}.target",
                f"exec_diff.{diff_index}.receipt_path_fshex",
                f"exec_diff.{diff_index}.receipt_sha256",
            }
        )
    for cgroup_index in range(4):
        index_keys.update(
            {
                f"cgroup.{cgroup_index}.target",
                f"cgroup.{cgroup_index}.workload_kind",
                f"cgroup.{cgroup_index}.evidence_dir_fshex",
                f"cgroup.{cgroup_index}.receipt_sha256",
            }
        )
    require_exact_keys(index, index_keys, "completion_index")
    source_states: list[FileState] = []
    for timing in ("before", "after"):
        closure_path = fs_path(
            index.get(f"source_closure_{timing}_path_fshex", ""),
            "source_closure_" + timing,
        )
        closure_state = stable_read(
            require_descendant(
                closure_path, root, "source_closure_" + timing
            ),
            "source_closure_" + timing,
        )
        if closure_state.sha256 != require_sha(
            index.get(f"source_closure_{timing}_sha256", ""),
            "source_closure_" + timing,
        ):
            fail("source_closure_index_digest_mismatch:" + timing)
        source_states.append(closure_state)
    if (
        source_states[0].raw != source_states[1].raw
        or source_closure_manifest.content_cid_from_manifest(
            source_states[0].raw
        ) != binding["source_closure_cid"]
        or (source_states[0].info.st_dev, source_states[0].info.st_ino)
        == (source_states[1].info.st_dev, source_states[1].info.st_ino)
    ):
        fail("source_closure_pre_post_identity_invalid")
    leg_states: dict[tuple[str, str], FileState] = {}
    leg_rows: dict[tuple[str, str], dict[str, str]] = {}
    leg_artifacts: dict[tuple[str, str], dict[str, FileState]] = {}
    leg_index = 0
    for target, _, _, _, _ in TARGETS:
        for backend in BACKENDS:
            prefix = f"leg.{leg_index}."
            if (
                index.get(prefix + "target") != target
                or index.get(prefix + "backend") != backend
            ):
                fail("completion_index_leg_order_invalid")
            receipt = fs_path(index.get(prefix + "receipt_path_fshex", ""), "leg_receipt")
            state, artifacts, rows = validate_leg(
                receipt, target, backend, binding, root
            )
            if state.sha256 != require_sha(
                index.get(prefix + "receipt_sha256", ""), "leg_receipt"
            ):
                fail("completion_index_leg_digest_invalid")
            leg_states[(target, backend)] = state
            leg_rows[(target, backend)] = rows
            leg_artifacts[(target, backend)] = artifacts
            leg_index += 1
    leg_receipt_inodes = {
        (state.info.st_dev, state.info.st_ino)
        for state in leg_states.values()
    }
    if len(leg_receipt_inodes) != len(TARGETS) * len(BACKENDS):
        fail("completion_leg_receipt_inode_alias")
    for diff_index, (target, _, _, _, _) in enumerate(TARGETS):
        prefix = f"exec_diff.{diff_index}."
        if index.get(prefix + "target") != target:
            fail("completion_index_exec_diff_order_invalid")
        receipt = fs_path(
            index.get(prefix + "receipt_path_fshex", ""),
            "exec_diff_receipt",
        )
        state = validate_exec_diff_receipt(
            receipt,
            target,
            binding,
            root,
            leg_states[(target, "primary")].sha256,
            leg_states[(target, "backend2")].sha256,
            leg_artifacts[(target, "primary")],
            leg_artifacts[(target, "backend2")],
        )
        if state.sha256 != require_sha(
            index.get(prefix + "receipt_sha256", ""),
            "exec_diff_receipt",
        ):
            fail("completion_index_exec_diff_digest_invalid")
    source_bundle_values = {
        rows["source_bundle_raw32"] for rows in leg_rows.values()
    }
    execution_values = {
        rows["execution_raw32"] for rows in leg_rows.values()
    }
    if (
        source_bundle_values != {binding["snapshot_manifest_sha256"]}
        or execution_values != {binding["seven_stage_execution_raw32"]}
    ):
        fail("completion_target_identity_drift")
    cgroup_index = 0
    cgroup_receipt_inodes: set[tuple[int, int]] = set()
    for target, host_os, _, _, _ in TARGETS:
        if host_os != "linux":
            continue
        for workload_kind in NATIVE_DESCRIPTOR_WORKLOADS:
            prefix = f"cgroup.{cgroup_index}."
            if (
                index.get(prefix + "target") != target
                or index.get(prefix + "workload_kind") != workload_kind
            ):
                fail("completion_index_cgroup_order_invalid")
            evidence_dir = fs_path(
                index.get(prefix + "evidence_dir_fshex", ""),
                "completion_cgroup_evidence_dir",
            )
            receipt_state = validate_cgroup_workload(
                evidence_dir,
                target,
                workload_kind,
                binding,
                root,
            )
            if index.get(prefix + "receipt_sha256") != receipt_state.sha256:
                fail("completion_index_cgroup_receipt_mismatch")
            receipt_identity = (
                receipt_state.info.st_dev,
                receipt_state.info.st_ino,
            )
            if receipt_identity in cgroup_receipt_inodes:
                fail("completion_cgroup_receipt_inode_alias")
            cgroup_receipt_inodes.add(receipt_identity)
            cgroup_index += 1
    if cgroup_index != 4 or len(cgroup_receipt_inodes) != 4:
        fail("completion_cgroup_workload_count_invalid")
    raw_path = fs_path(
        index.get("performance_raw_path_fshex", ""), "performance_raw"
    )
    verdict_path = fs_path(
        index.get("performance_verdict_path_fshex", ""), "performance_verdict"
    )
    raw_state, verdict_state = validate_perf(
        raw_path, verdict_path, binding, root
    )
    if (
        raw_state.sha256
        != require_sha(index.get("performance_raw_sha256", ""), "performance_raw")
        or verdict_state.sha256
        != require_sha(
            index.get("performance_verdict_sha256", ""), "performance_verdict"
        )
    ):
        fail("completion_index_performance_digest_invalid")
    performance_evidence_path = fs_path(
        index.get("performance_evidence_path_fshex", ""),
        "performance_evidence",
    )
    performance_evidence_state = validate_performance_evidence(
        performance_evidence_path,
        root,
        binding,
        next(iter(source_bundle_values)),
        next(iter(execution_values)),
    )
    if performance_evidence_state.sha256 != require_sha(
        index.get("performance_evidence_sha256", ""),
        "performance_evidence",
    ):
        fail("completion_index_performance_evidence_digest_invalid")


def validate_completion(
    root: pathlib.Path,
    *,
    publish_root: pathlib.Path | None = None,
) -> None:
    if publish_root is None:
        _validate_completion(root)
        return
    with publication_path_projection(root, publish_root):
        _validate_completion(root)


def enumerate_tree(
    root: pathlib.Path, excluded: set[pathlib.Path]
) -> tuple[list[pathlib.Path], dict[bytes, tuple[int, ...]]]:
    files: list[pathlib.Path] = []
    directories: dict[bytes, tuple[int, ...]] = {}
    root = canonical_existing(root, "publisher_root", directory=True)
    for directory, names, filenames in os.walk(
        root, topdown=True, followlinks=False
    ):
        names.sort(key=os.fsencode)
        filenames.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        relative_directory = directory_path.relative_to(root)
        if relative_directory != pathlib.Path("."):
            info = directory_path.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail("publisher_directory_invalid:" + str(directory_path))
            directories[os.fsencode(relative_directory)] = identity(info)
        for name in names:
            child = directory_path / name
            info = child.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail("publisher_directory_member_invalid:" + str(child))
        for name in filenames:
            path = directory_path / name
            if path in excluded:
                continue
            info = path.lstat()
            if (
                not stat.S_ISREG(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_nlink != 1
            ):
                fail("publisher_artifact_invalid:" + str(path))
            files.append(path)
    files.sort(key=lambda path: os.fsencode(path.relative_to(root)))
    return files, directories


def artifact_manifest_raw(
    root: pathlib.Path,
    manifest: pathlib.Path,
    receipt: pathlib.Path,
    *,
    publish_root: pathlib.Path | None = None,
) -> tuple[bytes, int, int]:
    excluded = {manifest, receipt}
    first_files, first_directories = enumerate_tree(root, excluded)
    artifacts: list[tuple[pathlib.Path, FileState]] = []
    seen_inodes: set[tuple[int, int]] = set()
    for path in first_files:
        state = stable_read(path, "publisher_artifact")
        inode = (state.info.st_dev, state.info.st_ino)
        if inode in seen_inodes:
            fail("publisher_artifact_inode_alias:" + str(path))
        seen_inodes.add(inode)
        artifacts.append((path.relative_to(root), state))
    second_files, second_directories = enumerate_tree(root, excluded)
    if (
        [os.fsencode(path.relative_to(root)) for path in first_files]
        != [os.fsencode(path.relative_to(root)) for path in second_files]
        or first_directories != second_directories
    ):
        fail("publisher_tree_changed_during_scan")
    logical_root = publish_root
    if (
        logical_root is None
        and _PUBLICATION_PATH_PROJECTION is not None
        and root == _PUBLICATION_PATH_PROJECTION[0]
    ):
        logical_root = _PUBLICATION_PATH_PROJECTION[1]
    if logical_root is None:
        logical_root = root
    lines = [
        "schema=cheng.backend2.current_source_release_artifact_manifest",
        "status=PASS",
        "driver_role=production",
        "producer_root_fshex=" + os.fsencode(logical_root).hex(),
        "directory_count=" + str(len(first_directories)),
    ]
    for index, relative in enumerate(sorted(first_directories)):
        current = first_directories[relative]
        prefix = f"directory.{index}."
        lines.extend(
            (
                prefix + "path_fshex=" + relative.hex(),
                prefix + "device=" + str(current[0]),
                prefix + "inode=" + str(current[1]),
                prefix + "mode=" + format(current[2], "o"),
                prefix + "nlink=" + str(current[3]),
                prefix + "uid=" + str(current[4]),
                prefix + "gid=" + str(current[5]),
                prefix + "mtime_ns=" + str(current[7]),
                prefix + "ctime_ns=" + str(current[8]),
            )
        )
    lines.append("artifact_count=" + str(len(artifacts)))
    for index, (relative, state) in enumerate(artifacts):
        prefix = f"artifact.{index}."
        lines.extend(
            (
                prefix + "path_fshex=" + os.fsencode(relative).hex(),
                prefix + "sha256=" + state.sha256,
                prefix + "device=" + str(state.info.st_dev),
                prefix + "inode=" + str(state.info.st_ino),
                prefix + "size=" + str(state.info.st_size),
                prefix + "mode=" + format(state.info.st_mode, "o"),
                prefix + "nlink=" + str(state.info.st_nlink),
                prefix + "uid=" + str(state.info.st_uid),
                prefix + "gid=" + str(state.info.st_gid),
                prefix + "mtime_ns=" + str(state.info.st_mtime_ns),
                prefix + "ctime_ns=" + str(state.info.st_ctime_ns),
            )
        )
    return (
        rendered(lines, "manifest_payload_sha256"),
        len(artifacts),
        len(first_directories),
    )


