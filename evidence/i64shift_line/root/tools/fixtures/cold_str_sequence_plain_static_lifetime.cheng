@borrows
fn ColdStaticStrSequenceVerify(values: str[], expected: str): int32 =
    if values.len != 2:
        return 10
    if values[0] != expected || values[1] != expected:
        return 11
    return 0

fn ColdStaticStrSequenceBuild(): str[] =
    var source = "alpha"
    let values = [source, source]
    source = source
    source = "overwritten"
    return values

@borrows
fn ColdStaticStrLoopRead(value: str): int32 =
    return len(value)

@borrows
fn ColdStaticStrLoopAppend(out: var str,
                           suffix: str) =
    let next = out + suffix
    out = next

fn ColdStaticStrLoopReset(rounds: int32): int32 =
    var currentLiteral = ""
    var total: int32
    var i: int32
    while i < rounds:
        ColdStaticStrLoopAppend(currentLiteral, "x")
        total = total + len(currentLiteral)
        total = total + ColdStaticStrLoopRead(currentLiteral)
        currentLiteral = currentLiteral
        currentLiteral = ""
        i = i + 1
    return total

fn main(): int32 =
    var empty: str[]
    if empty.len != 0:
        return 20
    let emptyText = ""
    let emptyValues = [emptyText, emptyText]
    let emptyResult = ColdStaticStrSequenceVerify(emptyValues, "")
    if emptyResult != 0:
        return 21 + emptyResult
    var values = ColdStaticStrSequenceBuild()
    let first = ColdStaticStrSequenceVerify(values, "alpha")
    if first != 0:
        return first
    if values[0] != "alpha" || values[1] != "alpha":
        return 30
    let second = ColdStaticStrSequenceVerify(values, "alpha")
    if second != 0:
        return 40 + second
    if ColdStaticStrLoopReset(2) != 4:
        return 50
    return 0
