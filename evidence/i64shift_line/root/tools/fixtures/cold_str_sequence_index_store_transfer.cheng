import std/seqs as seqs
import std/strings as strings

@borrows
fn ColdStrStoreVerify(values: str[]): int32 =
    if values.len != 3:
        return 10
    if values[0] != "shared":
        return 11
    if values[1] != "owned":
        return 12
    if values[2] != "owned":
        return 13
    return 0

@borrows
fn ColdStrStoreShared(values: var str[],
                      index: int32,
                      value: str) =
    values[index] = share(value)

fn main(): int32 =
    var values: str[]
    seqs.setLen(values, 3)
    values[0] = ""
    values[0] = "first"
    values[0] = values[0]
    values[0] = "overwritten"
    let owned = strings.CloneStr("owned")
    values[1] = share(owned)
    values[2] = owned
    ColdStrStoreShared(values, 0, "shared")
    let result = ColdStrStoreVerify(values)
    if result != 0:
        return result
    return 0
