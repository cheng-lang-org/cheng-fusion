const
    CsgCoreBaseProfile: str = "csg_core"

@borrows
fn csgProfileNameSupported(profile: str): bool =
    return profile == CsgCoreBaseProfile ||
        profile == "csg_dialect::c" ||
        profile == "csg_dialect::cheng_compiler" ||
        profile == "csg_dialect::finance" ||
        profile == "csg_dialect::native" ||
        profile == "csg_dialect::oracle_asset" ||
        profile == "csg_dialect::python" ||
        profile == "csg_dialect::unimaker_product" ||
        profile == "csg_dialect::vexa" ||
        profile == "csg_dialect::web"

@borrows
fn csgDialectProfileKind(kind: str): int32 =
    if csgStartsWith(kind, "csg_dialect::c::"):
        return 1
    if csgStartsWith(kind, "csg_dialect::cheng_compiler::"):
        return 2
    if csgStartsWith(kind, "csg_dialect::finance::"):
        return 3
    if csgStartsWith(kind, "csg_dialect::native::"):
        return 4
    if csgStartsWith(kind, "csg_dialect::oracle_asset::"):
        return 5
    if csgStartsWith(kind, "csg_dialect::python::"):
        return 6
    if csgStartsWith(kind, "csg_dialect::unimaker_product::"):
        return 7
    if csgStartsWith(kind, "csg_dialect::vexa::"):
        return 8
    if csgStartsWith(kind, "csg_dialect::web::"):
        return 9
    return 0

@borrows
fn csgRootBindingProfiles(lines: str[], profiles: var str[], schemaCid: var str): str =
    var hasC: bool
    var hasChengCompiler: bool
    var hasFinance: bool
    var hasNative: bool
    var hasOracleAsset: bool
    var hasPython: bool
    var hasUnimakerProduct: bool
    var hasVexa: bool
    var hasWeb: bool
    let kindValue = CsgFixtureKindValue()
    let profileKind = csgDialectProfileKind(kindValue.value)
    if profileKind == 1:
        hasC = true
    elif profileKind == 2:
        hasChengCompiler = true
    elif profileKind == 3:
        hasFinance = true
    elif profileKind == 4:
        hasNative = true
    elif profileKind == 5:
        hasOracleAsset = true
    elif profileKind == 6:
        hasPython = true
        elif profileKind == 7:
            hasUnimakerProduct = true
        elif profileKind == 8:
            hasVexa = true
        elif profileKind == 9:
        hasWeb = true
    elif csgStartsWith(kindValue.value, "csg_dialect::"):
        return csgCat("root_binding_unknown_profile ", kindValue.value)
    add(profiles, CsgCoreBaseProfile)
    if hasC:
        add(profiles, "csg_dialect::c")
    if hasChengCompiler:
        add(profiles, "csg_dialect::cheng_compiler")
    if hasFinance:
        add(profiles, "csg_dialect::finance")
    if hasNative:
        add(profiles, "csg_dialect::native")
    if hasOracleAsset:
        add(profiles, "csg_dialect::oracle_asset")
    if hasPython:
        add(profiles, "csg_dialect::python")
    if hasUnimakerProduct:
        add(profiles, "csg_dialect::unimaker_product")
    if hasVexa:
        add(profiles, "csg_dialect::vexa")
    if hasWeb:
        add(profiles, "csg_dialect::web")
    return ""

@borrows
fn csgRequireCMigrationFactFields(result: var CsgCoreValidationResult, lineNo: int32, raw: str, kind: str) =
    if kind == "csg_dialect::c::translation_unit":
        let expected: str[] = [
            "functionCount", "id", "kind", "module", "path", "target"]
        csgRequireExactJsonObjectFields(result, lineNo, raw, kind, expected)
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "functionCount")
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "path")
        csgRequireStringField(result, lineNo, raw, kind, "target")
    elif kind == "csg_dialect::c::function":
        let expected: str[] = [
            "id", "kind", "module", "name", "qualType"]
        csgRequireExactJsonObjectFields(result, lineNo, raw, kind, expected)
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "name")
        csgRequireStringField(result, lineNo, raw, kind, "qualType")
    else:
        csgAddError(result, csgCat("unsupported C migration fact kind: ", kind))

@borrows
fn csgRequirePythonMigrationFactFields(result: var CsgCoreValidationResult, lineNo: int32, raw: str, kind: str) =
    if kind == "csg_dialect::python::module":
        let expected: str[] = [
            "bytecode", "entry", "id", "kind", "module",
            "pythonVersion", "symbolCount"]
        csgRequireExactJsonObjectFields(result, lineNo, raw, kind, expected)
        csgRequireRawField(result, lineNo, raw, kind, "bytecode")
        csgRequireStringField(result, lineNo, raw, kind, "entry")
        csgRequireStringField(result, lineNo, raw, kind, "id")
        csgRequireStringField(result, lineNo, raw, kind, "module")
        csgRequireStringField(result, lineNo, raw, kind, "pythonVersion")
        csgRequireNonnegativeInt32Field(result, lineNo, raw, kind, "symbolCount")
    else:
        csgAddError(result, csgCat("unsupported Python migration fact kind: ", kind))

@borrows
fn csgCoreValidateFactLinesInto(lines: str[], result: var CsgCoreValidationResult) =
    let kind = CsgFixtureKind()
    if kind == "csg.core.schema":
        discard
    elif csgStartsWith(kind, "csg_dialect::c::"):
        csgRequireCMigrationFactFields(result, 1, lines[0], kind)
    elif csgStartsWith(kind, "csg_dialect::python::"):
        csgRequirePythonMigrationFactFields(result, 1, lines[0], kind)
    else:
        csgAddError(result, csgCat("unsupported fact kind: ", kind))
