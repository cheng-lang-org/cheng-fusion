# Contract-only static specimen. It proves the focused parser and is never a
# production compiler implementation or dynamic completion proof.
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/csg_core/csgc_authority as csgc_authority
import cheng/core/tooling/compiler_snapshot_builder as builder
import std/rawbytes

@borrows
fn compilerSnapshotLoweringBridgeCsgcAuthorityConsumeInto(
        tables: var schema.CsgCompilerSnapshotTables,
        manifestBytes: rawbytes.Bytes,
        err: var str): bool =
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    defer:
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    if !cargo.ok || cargo.factCount <= 0:
        err = cargo.error
        return false
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        cargo.csgcBytes, cargo.factsRootCid)
    if !verified.ok ||
       verified.factCount != cargo.factCount ||
       verified.factsRoot != cargo.factsRoot:
        err = verified.error
        return false
    let productionPolicy =
        csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    let trustAnchor =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
            productionPolicy)
    let anchorError =
        csgc_authority.CsgCoreCsgcUpstreamTrustAnchorError(trustAnchor)
    if anchorError.len != 0:
        err = anchorError
        return false
    let authoritySeal =
        csgc_authority.CsgCoreCsgcAuthorityVerifyAndSeal(
            trustAnchor,
            manifestBytes,
            cargo.csgcBytes)
    if !csgc_authority.CsgCoreCsgcAuthorityIsValid(authoritySeal):
        err = csgc_authority.CsgCoreCsgcAuthorityError(
            authoritySeal)
        return false
    let authorizedFacts =
        csgc_authority.CsgCoreCsgcDecodeFactKindAuthorized(
            cargo.csgcBytes,
            "csg.core.schema",
            authoritySeal)
    if !authorizedFacts.ok ||
       authorizedFacts.totalFactCount != cargo.factCount ||
       authorizedFacts.lines.len != 1:
        err = authorizedFacts.error
        return false
    err = ""
    return true

fn CompilerSnapshotForLoweringBuildLatestInto(
        linkPlan: var LinkPlan,
        csg: var CompilerCsg,
        universe: LocalUniverse,
        compilerExecution: CompilerExecution,
        tables: var schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    var admission: builder.CompilerSnapshotProductionAdmissionReceipt
    if !builder.CompilerSnapshotProductionCandidateBuildUnsealedInto(
           csg,
           linkPlan.canonicalDocumentCids,
           linkPlan.canonicalSourceByProducer,
           linkPlan.canonicalSourceTexts,
           linkPlan.eventState,
           universe.worldHead.headCid,
           compilerExecution.executionRaw32,
           linkPlan.predecessorReceiptCid,
           tables,
           admission,
           err):
        return false
    if !admission.admissionBlocked || admission.missingFactBitmap == 0:
        return false
    if !builder.CompilerSnapshotProductionCandidateSealInto(
           csg,
           linkPlan.canonicalDocumentCids,
           linkPlan.canonicalSourceByProducer,
           tables,
           admission,
           err):
        return false
    if admission.admissionBlocked || admission.missingFactBitmap != 0:
        return false
    if !schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err):
        return false
    if !compilerSnapshotLoweringBridgeCsgcAuthorityConsumeInto(
           tables,
           linkPlan.csgMerkleManifestBytes,
           err):
        return false
    err = ""
    return true
