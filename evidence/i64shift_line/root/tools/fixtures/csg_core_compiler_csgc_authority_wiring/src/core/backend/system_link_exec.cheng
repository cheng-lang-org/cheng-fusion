# Contract-only static specimen. The production gate never selects this file.
import cheng/core/tooling/compiler_snapshot_lowering_bridge as snapshot_bridge

fn BuildSystemLinkExecPlanWithWorldAndChannelInto(
        linkPlan: var LinkPlan,
        compilerCsg: var CompilerCsg,
        localUniverse: LocalUniverse,
        compilerExecution: CompilerExecution,
        sourceBundleOwner: var SourceBundleOwner,
        loweringPlan: var LoweringPlan,
        err: var str): bool =
    var semanticSnapshotTables: CsgCompilerSnapshotTables
    if !snapshot_bridge.CompilerSnapshotForLoweringBuildLatestInto(
           linkPlan,
           compilerCsg,
           localUniverse,
           compilerExecution,
           semanticSnapshotTables,
           err):
        return false
    let loweringPlanOk =
        lower.BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
            linkPlan,
            sourceBundleOwner,
            semanticSnapshotTables,
            compilerCsg,
            loweringPlan,
            err)
    snapshot_bridge.CompilerSnapshotForLoweringRelease(
        semanticSnapshotTables)
    if !loweringPlanOk:
        return false
    return true
