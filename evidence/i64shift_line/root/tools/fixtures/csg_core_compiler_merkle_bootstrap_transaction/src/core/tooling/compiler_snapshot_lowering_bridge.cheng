type
    compilerSnapshotLoweringBridgeMerklePolicy =
        expectedHeadCid: str
        expectedManifestCid: str

fn compilerSnapshotLoweringBridgeMerklePolicyBindingCid(
        policy: compilerSnapshotLoweringBridgeMerklePolicy): str =
    append(policy.expectedManifestCid)
    return "cid"

fn compilerSnapshotLoweringBridgeMerklePolicyValid(
        policy: compilerSnapshotLoweringBridgeMerklePolicy): bool =
    return valid(policy.expectedManifestCid)

fn compilerSnapshotLoweringBridgeMerkleHeadMatchesVerified(
        current: Head,
        verified: Verified,
        expectedManifestCid: str): bool =
    if current.head.manifestCid != expectedManifestCid ||
       current.manifest.standard != verified.standard ||
       current.manifest.profileSetCid != verified.profileSetCid ||
       current.manifest.schemaCid != verified.schemaCid ||
       current.manifest.factsRoot != verified.factsRoot ||
       current.manifest.factCount != verified.factCount:
        return false
    return true

fn compilerSnapshotLoweringBridgeMerkleBootstrapInto(
        canonicalWorkspaceRoot: str,
        cargo: Cargo,
        out: var Transaction,
        err: var str): bool =
    let verified = snapshot_cargo.CsgCompilerSnapshotCargoVerify(
        cargo.bytes, cargo.root)
    let closure = merkle_builder.CsgCoreMerkleBuildClosure(
        verified.standard, verified.profiles, [], [])
    let genesis =
        merkle_store_pipeline.CsgCoreMerkleStoreBootstrapExclusive(
            canonicalWorkspaceRoot, StoreName, closure)
    if genesis.head.generation != int64(0): return false
    let reread = ReadHead(canonicalWorkspaceRoot, StoreName)
    let applied =
        snapshot_cargo.CsgCompilerSnapshotCargoMerkleApply(
            canonicalWorkspaceRoot, StoreName, genesis.head.headCid, cargo)
    if reread.head.generation == int64(0): return false
    let committed = ReadHead(canonicalWorkspaceRoot, StoreName)
    if committed.head.generation != int64(1): return false
    out = applied
    return true

fn compilerSnapshotLoweringBridgeMerklePolicyIssueInto(
        canonicalWorkspaceRoot: str,
        cargo: Cargo,
        bootstrapReceipt: var Transaction,
        bootstrapApplied: var bool): bool =
    var current = merkle_store.CsgCoreMerkleStoreReadHead(
        canonicalWorkspaceRoot, StoreName)
    if !current.present:
        var bootstrap: Transaction
        if !compilerSnapshotLoweringBridgeMerkleBootstrapInto(
               canonicalWorkspaceRoot, cargo, bootstrap, err):
            return false
        bootstrapReceipt = bootstrap
        bootstrapApplied = true
        current = merkle_store.CsgCoreMerkleStoreReadHead(
            canonicalWorkspaceRoot, StoreName)
    return current.present

fn compilerSnapshotLoweringBridgeBootstrapReceiptCurrent(
        policy: compilerSnapshotLoweringBridgeMerklePolicy,
        bootstrapReceipt: Transaction): bool =
    let current = ReadHead(policy.expectedHeadCid)
    return current.head.receiptCid ==
        bootstrapReceipt.receiptCid

fn compilerSnapshotLoweringBridgeMerkleCommitInto(
        bootstrapReceipt: Transaction,
        bootstrapApplied: bool,
        receipt: var Transaction): bool =
    if bootstrapApplied:
        if !compilerSnapshotLoweringBridgeBootstrapReceiptCurrent(
               policy, bootstrapReceipt):
            return false
        receipt = bootstrapReceipt
        return true
    return false
