import std/fs
import std/os

fn csgCoreMerkleStoreBootstrap(
        parentPath: str,
        storeName: str,
        closure: Closure,
        requireAbsent: bool): Result =
    let storeRoot = os.JoinPath(parentPath, storeName)
    if requireAbsent && fs.Exists(storeRoot): return Result()
    let opened = StoreInit(parentPath, storeName, closure.cid)
    if requireAbsent && opened.reused: return Result()
    let published = Publish(parentPath, storeName, closure.cid)
    if requireAbsent && published.reused: return Result()
    return Result()

fn CsgCoreMerkleStoreBootstrap(
        parentPath: str,
        storeName: str,
        closure: Closure): Result =
    return csgCoreMerkleStoreBootstrap(
        parentPath, storeName, closure, false)

fn CsgCoreMerkleStoreBootstrapExclusive(
        parentPath: str,
        storeName: str,
        closure: Closure): Result =
    return csgCoreMerkleStoreBootstrap(
        parentPath,
        storeName,
        closure,
        true)
