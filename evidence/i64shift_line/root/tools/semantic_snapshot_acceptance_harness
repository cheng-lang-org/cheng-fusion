def validate_external_wall_evidence(
        output_root: Path, row: dict[str, Any], label: str,
        identities: dict[str, str], artifact_paths: set[Path]) -> dict[str, Any]:
    receipt_path, _ = safe_artifact(output_root, row.get("wall_evidence"), label)
    if receipt_path in artifact_paths:
        raise AcceptanceError(f"{label}: wall receipt reused")
    receipt_raw = receipt_path.read_bytes()
    try:
        receipt = json.loads(receipt_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError(f"{label}: wall receipt is not JSON") from exc
    fields = {
        "schema", "status", "sample_index", "workload_kind", "timer_path",
        "timer_sha256", "command_path", "command_sha256", "command_argv",
        "command_argv_cid", "started_monotonic_ns", "ended_monotonic_ns",
        "wall_ns", "return_code", "stdout", "stderr", "receipt_cid",
    }
    if not isinstance(receipt, dict) or set(receipt) != fields or \
       receipt_raw != canonical_json_bytes(receipt) or \
       receipt.get("schema") != "cheng.semantic_snapshot.external_wall_evidence" or \
       receipt.get("status") != "completed" or \
       receipt.get("sample_index") != row.get("sample_index") or \
       receipt.get("workload_kind") != row.get("workload_kind") or \
       receipt.get("timer_path") != str(ACCEPTANCE_TIMER.resolve()) or \
       receipt.get("timer_sha256") != identities["measurement_timer_sha256"] or \
       receipt.get("command_sha256") != identities["compiler_sha256"] or \
       receipt.get("return_code") != 0:
        raise AcceptanceError(f"{label}: wall receipt identity drift")
    command_argv = receipt.get("command_argv")
    if not isinstance(command_argv, list) or not command_argv or \
       any(not isinstance(argument, str) or "\x00" in argument
           for argument in command_argv) or \
       command_argv[0] != receipt.get("command_path") or \
       read_trace_argv_digest(command_argv) != receipt.get("command_argv_cid"):
        raise AcceptanceError(f"{label}: timed child argv invalid")
    workload = row["workload_kind"]
    implementation = "baseline" if workload.startswith("baseline") else "candidate"
    build_mode = "cold_full" if workload.endswith("_cold") else "development_loop"
    expected_child_prefix = [
        receipt["command_path"],
        "semantic-snapshot-acceptance-sample",
        f"--implementation:{implementation}",
        f"--build-mode:{build_mode}",
        f"--trace-sha256:{identities['trace_sha256']}",
        f"--sample-index:{row['sample_index']}",
    ]
    cache_mode = ("disabled" if build_mode == "cold_full" else
                  ("legacy_full_rebuild" if implementation == "baseline" else
                   "snapshot_incremental"))
    if command_argv[:len(expected_child_prefix)] != expected_child_prefix or \
       command_argv.count(f"--cache-mode:{cache_mode}") != 1:
        raise AcceptanceError(f"{label}: timed workload command is not exact")
    started = receipt.get("started_monotonic_ns")
    ended = receipt.get("ended_monotonic_ns")
    wall_ns = receipt.get("wall_ns")
    if not is_exact_int(started) or not is_exact_int(ended) or \
       not is_exact_int(wall_ns) or started <= 0 or ended <= started or \
       wall_ns != ended - started or wall_ns != row.get("wall_ns"):
        raise AcceptanceError(f"{label}: external monotonic wall time mismatch")
    stdout_path, stdout_sha256 = safe_artifact(
        output_root, receipt.get("stdout"), label + ".stdout")
    stderr_path, stderr_sha256 = safe_artifact(
        output_root, receipt.get("stderr"), label + ".stderr")
    if stdout_path in artifact_paths or stderr_path in artifact_paths or \
       stdout_path == stderr_path or \
       receipt["stdout"].get("bytes") != stdout_path.stat().st_size or \
       receipt["stderr"].get("bytes") != stderr_path.stat().st_size:
        raise AcceptanceError(f"{label}: timed output evidence reused or incomplete")
    artifact_paths.update((receipt_path, stdout_path, stderr_path))
    body = dict(receipt)
    receipt_cid = body.pop("receipt_cid", None)
    expected_receipt_cid = sha256_bytes(
        b"cheng.semantic_snapshot.external_wall_receipt\x00" +
        canonical_json_bytes(body))
    if receipt_cid != expected_receipt_cid:
        raise AcceptanceError(f"{label}: wall receipt CID mismatch")
    measured_argv = [
        str(ACCEPTANCE_TIMER.resolve()),
        "--receipt-out", str(receipt_path),
        "--stdout", str(stdout_path),
        "--stderr", str(stderr_path),
        "--sample-index", str(row["sample_index"]),
        "--workload-kind", workload,
        "--", *command_argv,
    ]
    return {
        "measured_argv": measured_argv,
        "child_command_sha256": receipt["command_sha256"],
        "child_command_argv_cid": receipt["command_argv_cid"],
        "stdout_sha256": stdout_sha256,
        "stderr_sha256": stderr_sha256,
        "receipt_cid": expected_receipt_cid,
    }


def stable_external_executable_sha256(path: Path, label: str) -> str:
    if not path.is_absolute() or path.resolve() != path or not os.access(path, os.X_OK):
        raise AcceptanceError(f"{label}: executable path is not canonical")
    flags = os.O_RDONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise AcceptanceError(f"{label}: executable is not regular")
        digest = hashlib.sha256()
        byte_count = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            byte_count += len(chunk)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    identity_fields = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size",
                       "st_mtime_ns", "st_ctime_ns")
    path_after = path.stat(follow_symlinks=False)
    if any(getattr(before, field) != getattr(after, field) or
           getattr(before, field) != getattr(path_after, field)
           for field in identity_fields) or byte_count != before.st_size:
        raise AcceptanceError(f"{label}: executable identity changed during audit")
    return digest.hexdigest()


def expected_trace_tool(method: str, label: str) -> Path:
    if method == READ_TRACE_DARWIN_METHOD:
        if platform.system() != "Darwin":
            raise AcceptanceError(f"{label}: Darwin trace claimed on another platform")
        raw = "/usr/sbin/dtrace"
    elif method == READ_TRACE_LINUX_METHOD:
        if platform.system() != "Linux":
            raise AcceptanceError(f"{label}: Linux trace claimed on another platform")
        raw = shutil.which("strace") or ""
    else:
        raise AcceptanceError(f"{label}: untrusted read measurement")
    if not raw:
        raise AcceptanceError(f"{label}: required trace tool is unavailable")
    return Path(raw).resolve()


def validate_trace_tool_argv(receipt: dict[str, Any], command_argv: list[str],
                             label: str) -> None:
    method = receipt["method"]
    tool = receipt["trace_tool_path"]
    trace_argv = receipt.get("trace_tool_argv")
    if not isinstance(trace_argv, list) or any(
            not isinstance(value, str) or "\x00" in value for value in trace_argv):
        raise AcceptanceError(f"{label}: trace tool argv invalid")
    if method == READ_TRACE_LINUX_METHOD:
        prefix = [tool, "-f", "-qq", "-e", READ_TRACE_LINUX_FILTER,
                  "-e", "signal=none", "-o"]
        if len(trace_argv) != len(prefix) + 2 + len(command_argv) or \
           trace_argv[:len(prefix)] != prefix or \
           trace_argv[len(prefix) + 1] != "--" or \
           trace_argv[len(prefix) + 2:] != command_argv:
            raise AcceptanceError(f"{label}: strace argv contract drift")
        raw_temporary = Path(trace_argv[len(prefix)])
        if not raw_temporary.is_absolute() or raw_temporary.name != "raw.trace" or \
           not raw_temporary.parent.name.startswith(".semantic-read-trace."):
            raise AcceptanceError(f"{label}: strace raw path contract drift")
    else:
        if len(trace_argv) != 8 or trace_argv[0:3] != [tool, "-q", "-s"] or \
           trace_argv[4] != "-o" or trace_argv[6] != "-c" or \
           trace_argv[7] != shlex.join(command_argv):
            raise AcceptanceError(f"{label}: dtrace argv contract drift")
        script_temporary = Path(trace_argv[3])
        raw_temporary = Path(trace_argv[5])
        if not script_temporary.is_absolute() or not raw_temporary.is_absolute() or \
           script_temporary.parent != raw_temporary.parent or \
           script_temporary.name != "read-trace.d" or raw_temporary.name != "raw.trace" or \
           not script_temporary.parent.name.startswith(".semantic-read-trace."):
            raise AcceptanceError(f"{label}: dtrace script/raw path contract drift")
    if read_trace_argv_digest(trace_argv) != receipt.get("trace_tool_argv_cid"):
        raise AcceptanceError(f"{label}: trace tool argv CID mismatch")


def validate_read_trace_evidence(
        output_root: Path, row: dict[str, Any], label: str,
        identities: dict[str, str], artifact_paths: set[Path],
        expected_measured_argv: list[str] | None) -> dict[str, Any]:
    receipt_path, _ = safe_artifact(output_root, row.get("read_evidence"), label)
    if receipt_path in artifact_paths:
        raise AcceptanceError(f"{label}: read receipt reused")
    receipt_raw = receipt_path.read_bytes()
    try:
        receipt = json.loads(receipt_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError(f"{label}: read receipt is not canonical JSON") from exc
    if not isinstance(receipt, dict) or set(receipt) != READ_TRACE_RECEIPT_FIELDS or \
       receipt_raw != read_trace_canonical_json_bytes(receipt) or \
       receipt.get("schema") != "cheng.semantic_snapshot.read_trace_evidence" or \
       receipt.get("status") != "captured":
        raise AcceptanceError(f"{label}: read receipt envelope invalid")
    if not is_exact_int(receipt.get("sample_index")) or \
       receipt.get("sample_index") != row.get("sample_index") or \
       receipt.get("workload_kind") != row.get("workload_kind"):
        raise AcceptanceError(f"{label}: read receipt sample identity drift")
    for identity_field, expected in identities.items():
        if identity_field == "measurement_timer_sha256":
            continue
        if receipt.get(identity_field) != expected:
            raise AcceptanceError(f"{label}: read receipt {identity_field} drift")
    method = row.get("read_measurement_method")
    if method not in (READ_TRACE_DARWIN_METHOD, READ_TRACE_LINUX_METHOD) or \
       receipt.get("method") != method or \
       receipt.get("trace_contract_sha256") != trace_contract_sha256(method):
        raise AcceptanceError(f"{label}: read measurement method drift")
    if not is_exact_int(receipt.get("trace_tool_return_code")) or \
       receipt["trace_tool_return_code"] != 0:
        raise AcceptanceError(f"{label}: trace tool did not complete")

    command_path_value = receipt.get("command_path")
    command_argv = receipt.get("command_argv")
    if not isinstance(command_path_value, str) or \
       not isinstance(command_argv, list) or not command_argv or any(
           not isinstance(value, str) or "\x00" in value for value in command_argv):
        raise AcceptanceError(f"{label}: measured command receipt invalid")
    command_path = Path(command_path_value)
    timer_sha256 = identities.get("measurement_timer_sha256")
    if (expected_measured_argv is not None and command_argv != expected_measured_argv) or \
       command_argv[0] != command_path_value or \
       stable_external_executable_sha256(command_path, label + ".command") != \
           receipt.get("command_sha256") or \
       (timer_sha256 is not None and receipt.get("command_sha256") != timer_sha256) or \
       read_trace_argv_digest(command_argv) != receipt.get("command_argv_cid") or \
       receipt.get("command_sha256") != row.get("command_sha256") or \
       receipt.get("command_argv_cid") != row.get("command_argv_cid"):
        raise AcceptanceError(f"{label}: measured command identity drift")

    tool_path_value = receipt.get("trace_tool_path")
    if not isinstance(tool_path_value, str):
        raise AcceptanceError(f"{label}: trace tool path missing")
    tool_path = Path(tool_path_value)
    if tool_path != expected_trace_tool(method, label) or \
       stable_external_executable_sha256(tool_path, label + ".tool") != \
           receipt.get("trace_tool_sha256"):
        raise AcceptanceError(f"{label}: trace tool identity drift")
    validate_trace_tool_argv(receipt, command_argv, label)

    raw_path, raw_sha256 = safe_artifact(
        output_root, receipt.get("raw_trace"), label + ".raw")
    if raw_path in artifact_paths or raw_path == receipt_path:
        raise AcceptanceError(f"{label}: raw read trace reused")
    raw = raw_path.read_bytes()
    if not is_exact_int(receipt.get("raw_trace_bytes")) or \
       receipt.get("raw_trace_bytes") < 0 or \
       receipt.get("raw_trace_bytes") != len(raw):
        raise AcceptanceError(f"{label}: raw read trace size drift")
    try:
        counts = parse_read_trace(raw, method)
    except ReadTraceError as exc:
        raise AcceptanceError(f"{label}: {exc}") from exc
    if not is_exact_int(receipt.get("read_syscalls")) or \
       not is_exact_int(receipt.get("read_bytes")) or \
       receipt.get("read_syscalls") < 0 or receipt.get("read_bytes") < 0 or \
       counts.read_syscalls != receipt.get("read_syscalls") or \
       counts.read_bytes != receipt.get("read_bytes") or \
       counts.read_syscalls != row.get("read_syscalls") or \
       counts.read_bytes != row.get("read_bytes"):
        raise AcceptanceError(f"{label}: metric differs from raw read trace")
    if not is_sha256(receipt.get("measurement_receipt_cid")):
        raise AcceptanceError(f"{label}: read receipt CID malformed")
    try:
        expected_receipt_cid = read_trace_receipt_cid(receipt)
    except ReadTraceError as exc:
        raise AcceptanceError(f"{label}: read receipt CID invalid") from exc
    if receipt.get("measurement_receipt_cid") != expected_receipt_cid or \
       row.get("measurement_receipt_cid") != expected_receipt_cid:
        raise AcceptanceError(f"{label}: read receipt CID mismatch")
    artifact_paths.update((receipt_path, raw_path))
    return {
        "method": method,
        "trace_tool_sha256": receipt["trace_tool_sha256"],
        "raw_sha256": raw_sha256,
    }


def metric_summary(rows: list[dict[str, Any]], label: str,
                   output_root: Path, identities: dict[str, str],
                   artifact_paths: set[Path], measurement_receipts: set[str]) -> dict[str, Any]:
    if len(rows) < MIN_RANDOM_EDITS:
        raise AcceptanceError(f"{label}: fewer than 30 metric samples")
    fields = ("wall_ns", "read_syscalls", "read_bytes", "rss_bytes")
    values: dict[str, list[int]] = {field: [] for field in fields}
    command_sha256: str | None = None
    child_command_sha256: str | None = None
    command_argv_cids: list[str] = []
    child_command_argv_cids: list[str] = []
    stdout_sha256s: list[str] = []
    stderr_sha256s: list[str] = []
    read_method: str | None = None
    trace_tool_sha256: str | None = None
    requires_external_wall = "measurement_timer_sha256" in identities
    for index, row in enumerate(rows):
        if not isinstance(row, dict) or not is_exact_int(row.get("sample_index")) or \
           row.get("sample_index") != index or \
           row.get("workload_kind") != label:
            raise AcceptanceError(f"{label}[{index}]: sample identity drift")
        for identity_field, expected in identities.items():
            if row.get(identity_field) != expected:
                raise AcceptanceError(f"{label}[{index}]: {identity_field} drift")
        current_command = row.get("command_sha256")
        current_argv = row.get("command_argv_cid")
        receipt = row.get("measurement_receipt_cid")
        if not is_sha256(current_command) or not is_sha256(current_argv) or \
           not is_sha256(receipt) or \
           receipt in measurement_receipts:
            raise AcceptanceError(f"{label}[{index}]: measurement identity invalid")
        measurement_receipts.add(receipt)
        if command_sha256 is None:
            command_sha256 = current_command
        elif command_sha256 != current_command:
            raise AcceptanceError(f"{label}[{index}]: measured command changed")
        if requires_external_wall and current_argv in command_argv_cids:
            raise AcceptanceError(f"{label}[{index}]: measured argv receipt reused")
        command_argv_cids.append(current_argv)
        for field in fields:
            value = row.get(field)
            if not is_exact_int(value) or value < 0 or \
               (field in ("wall_ns", "rss_bytes") and value == 0):
                raise AcceptanceError(f"{label}[{index}]: invalid {field}")
            values[field].append(value)
        if row["rss_bytes"] > MEMORY_LIMIT_BYTES:
            raise AcceptanceError(f"{label}[{index}]: RSS exceeds 1GiB")
        wall_identity: dict[str, Any] | None = None
        if requires_external_wall:
            wall_identity = validate_external_wall_evidence(
                output_root, row, f"{label}[{index}].wall", identities,
                artifact_paths)
            if wall_identity["receipt_cid"] in measurement_receipts:
                raise AcceptanceError(f"{label}[{index}]: wall receipt reused")
            measurement_receipts.add(wall_identity["receipt_cid"])
            if child_command_sha256 is None:
                child_command_sha256 = wall_identity["child_command_sha256"]
            elif child_command_sha256 != wall_identity["child_command_sha256"]:
                raise AcceptanceError(f"{label}[{index}]: timed child command changed")
            child_argv_cid = wall_identity["child_command_argv_cid"]
            if child_argv_cid in child_command_argv_cids:
                raise AcceptanceError(f"{label}[{index}]: timed child argv receipt reused")
            child_command_argv_cids.append(child_argv_cid)
            stdout_sha256s.append(wall_identity["stdout_sha256"])
            stderr_sha256s.append(wall_identity["stderr_sha256"])
        read_identity = validate_read_trace_evidence(
            output_root, row, f"{label}[{index}].read", identities,
            artifact_paths,
            wall_identity["measured_argv"] if wall_identity is not None else None)
        if read_method is None:
            read_method = read_identity["method"]
            trace_tool_sha256 = read_identity["trace_tool_sha256"]
        elif read_method != read_identity["method"] or \
             trace_tool_sha256 != read_identity["trace_tool_sha256"]:
            raise AcceptanceError(f"{label}[{index}]: trace tool changed within workload")
        guard_path, _ = safe_artifact(
            output_root, row.get("memory_guard_evidence"), f"{label}[{index}].guard")
        if guard_path in artifact_paths:
            raise AcceptanceError(f"{label}[{index}]: measurement evidence reused")
        artifact_paths.add(guard_path)
        guard_fields = parse_guard_evidence(
            guard_path, f"{label}[{index}]", row["rss_bytes"],
            require_hard_limit_proof=requires_external_wall)
        if guard_fields.get("command_identity_status") != "available" or \
           guard_fields.get("command_identity_error") != "" or \
           guard_fields.get("command_sha256") != current_command or \
           guard_fields.get("command_execution_snapshot_sha256") != \
               current_command or \
           guard_fields.get("command_argv_sha256") != current_argv or \
           not guard_fields.get("command_argv_count", "").isdigit() or \
           int(guard_fields["command_argv_count"]) <= 0:
            raise AcceptanceError(
                f"{label}[{index}]: metric command or argv differs from guard")
    summary = {
        field: {"median": int(statistics.median(values[field])),
                "p95": percentile(values[field], 0.95)}
        for field in fields
    }
    summary["command_sha256"] = command_sha256
    summary["child_command_sha256"] = child_command_sha256
    summary["command_argv_root_cid"] = sha256_bytes(
        canonical_json_bytes(command_argv_cids))
    summary["child_command_argv_root_cid"] = sha256_bytes(
        canonical_json_bytes(child_command_argv_cids))
    summary["stdout_root_cid"] = sha256_bytes(canonical_json_bytes(stdout_sha256s))
    summary["stderr_root_cid"] = sha256_bytes(canonical_json_bytes(stderr_sha256s))
    summary["read_measurement_method"] = read_method
    summary["trace_tool_sha256"] = trace_tool_sha256
    return summary


def reduction(baseline: int, candidate: int) -> float:
    if baseline <= 0:
        raise AcceptanceError("baseline metric is zero")
    return (baseline - candidate) / baseline


def validate_incremental_work(value: Any, trace: dict[str, Any], output_root: Path,
                              cold_oracle_sha256: str, trace_sha256: str,
                              manifest_sha256: str,
                              artifact_paths: set[Path]) -> list[dict[str, Any]]:
    if not isinstance(value, list) or len(value) != trace["random_edit_count"]:
        raise AcceptanceError("incremental work sample count differs from trace")
    validated: list[dict[str, Any]] = []
    for edit_index, row in enumerate(value):
        if not isinstance(row, dict) or row.get("edit_index") != edit_index:
            raise AcceptanceError(f"incremental work {edit_index}: edit index drift")
        body_changed = exact_int_set(
            row.get("changed_body_function_ids"),
            f"incremental work {edit_index}.changed body")
        interface_changed = exact_int_set(
            row.get("changed_interface_function_ids"),
            f"incremental work {edit_index}.changed interface")
        if not body_changed and not interface_changed:
            raise AcceptanceError(f"incremental work {edit_index}: no changed function")
        expected_category = "interface" if edit_index % 3 == 0 else "body"
        if expected_category == "interface" and not interface_changed:
            raise AcceptanceError(f"incremental work {edit_index}: interface edit not classified")
        if expected_category == "body" and interface_changed:
            raise AcceptanceError(f"incremental work {edit_index}: body edit changed interface")

        edges = row.get("read_dependency_edges")
        if not isinstance(edges, list):
            raise AcceptanceError(f"incremental work {edit_index}: dependency edges missing")
        exact_edges: set[tuple[int, int]] = set()
        for edge in edges:
            if not isinstance(edge, dict):
                raise AcceptanceError(f"incremental work {edit_index}: invalid dependency edge")
            reader = edge.get("reader_function_id")
            target = edge.get("target_function_id")
            if not is_exact_int(reader) or reader < 0 or \
               not is_exact_int(target) or target < 0:
                raise AcceptanceError(f"incremental work {edit_index}: invalid dependency identity")
            pair = (reader, target)
            if pair in exact_edges:
                raise AcceptanceError(f"incremental work {edit_index}: duplicate dependency edge")
            exact_edges.add(pair)

        dependency_closure = set(interface_changed)
        changed = True
        while changed:
            changed = False
            for reader, target in exact_edges:
                if target in dependency_closure and reader not in dependency_closure:
                    dependency_closure.add(reader)
                    changed = True
        expected_rebuilt = body_changed | dependency_closure
        rebuilt = exact_int_set(
            row.get("rebuilt_function_ids"),
            f"incremental work {edit_index}.rebuilt")
        if rebuilt != expected_rebuilt:
            raise AcceptanceError(
                f"incremental work {edit_index}: rebuilt set is not the exact dependency closure")

        change_identities = row.get("change_identities")
        if not isinstance(change_identities, list) or \
           len(change_identities) != len(body_changed | interface_changed):
            raise AcceptanceError(f"incremental work {edit_index}: change identities missing")
        identity_function_ids: set[int] = set()
        for identity in change_identities:
            if not isinstance(identity, dict):
                raise AcceptanceError(f"incremental work {edit_index}: change identity invalid")
            function_id = identity.get("function_id")
            if not is_exact_int(function_id) or function_id not in body_changed | interface_changed or \
               function_id in identity_function_ids:
                raise AcceptanceError(f"incremental work {edit_index}: changed function identity drift")
            identity_function_ids.add(function_id)
            for field in ("before_source_content_cid", "after_source_content_cid",
                          "before_interface_cid", "after_interface_cid"):
                if not is_sha256(identity.get(field)):
                    raise AcceptanceError(
                        f"incremental work {edit_index}: {field} missing")
            if identity["before_source_content_cid"] == identity["after_source_content_cid"]:
                raise AcceptanceError(f"incremental work {edit_index}: unchanged source content accepted")
            interface_drift = identity["before_interface_cid"] != identity["after_interface_cid"]
            if interface_drift != (function_id in interface_changed):
                raise AcceptanceError(
                    f"incremental work {edit_index}: interface classification differs from hash")
        decoded = row.get("decoded_fragment_cids")
        if not isinstance(decoded, list) or any(not is_sha256(item) for item in decoded) or \
           len(decoded) != len(set(decoded)):
            raise AcceptanceError(f"incremental work {edit_index}: fragment decoded more than once")
        visited = exact_int_set(
            row.get("reachability_visited_function_ids"),
            f"incremental work {edit_index}.reachability")
        if visited != expected_rebuilt:
            raise AcceptanceError(
                f"incremental work {edit_index}: reachability traversal rescanned outside exact closure")

        oracle_path, oracle_evidence_sha256 = safe_artifact(
            output_root, row.get("cold_oracle_evidence"),
            f"incremental work {edit_index}.cold oracle")
        if oracle_path in artifact_paths:
            raise AcceptanceError(
                f"incremental work {edit_index}: cold oracle evidence reused")
        artifact_paths.add(oracle_path)
        oracle_raw = oracle_path.read_bytes()
        try:
            oracle = json.loads(oracle_raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise AcceptanceError(
                f"incremental work {edit_index}: cold oracle evidence invalid") from exc
        oracle_fields = {
            "schema", "edit_index", "producer_sha256", "trace_sha256",
            "source_manifest_sha256", "changed_body_function_ids",
            "changed_interface_function_ids", "read_dependency_edges",
            "rebuilt_function_ids", "oracle_receipt_cid",
        }
        if not isinstance(oracle, dict) or set(oracle) != oracle_fields or \
           oracle_raw != canonical_json_bytes(oracle) or \
           oracle.get("schema") != "cheng.semantic_snapshot.incremental_cold_oracle" or \
           oracle.get("edit_index") != edit_index or \
           oracle.get("producer_sha256") != cold_oracle_sha256 or \
           oracle.get("trace_sha256") != trace_sha256 or \
           oracle.get("source_manifest_sha256") != manifest_sha256:
            raise AcceptanceError(
                f"incremental work {edit_index}: cold oracle identity drift")
        oracle_body = exact_int_set(
            oracle.get("changed_body_function_ids"),
            f"incremental work {edit_index}.oracle body")
        oracle_interface = exact_int_set(
            oracle.get("changed_interface_function_ids"),
            f"incremental work {edit_index}.oracle interface")
        oracle_rebuilt = exact_int_set(
            oracle.get("rebuilt_function_ids"),
            f"incremental work {edit_index}.oracle rebuilt")
        oracle_edges_value = oracle.get("read_dependency_edges")
        if not isinstance(oracle_edges_value, list):
            raise AcceptanceError(
                f"incremental work {edit_index}: cold oracle edges missing")
        oracle_edges: set[tuple[int, int]] = set()
        for edge in oracle_edges_value:
            if not isinstance(edge, dict) or set(edge) != {
                    "reader_function_id", "target_function_id"} or \
               not is_exact_int(edge["reader_function_id"]) or \
               not is_exact_int(edge["target_function_id"]) or \
               edge["reader_function_id"] < 0 or edge["target_function_id"] < 0:
                raise AcceptanceError(
                    f"incremental work {edit_index}: cold oracle edge invalid")
            oracle_edges.add((edge["reader_function_id"], edge["target_function_id"]))
        if len(oracle_edges) != len(oracle_edges_value) or \
           oracle_body != body_changed or oracle_interface != interface_changed or \
           oracle_rebuilt != rebuilt or oracle_edges != exact_edges:
            raise AcceptanceError(
                f"incremental work {edit_index}: production result differs from cold oracle")
        oracle_receipt_fields = [(key, oracle[key]) for key in sorted(
            oracle_fields - {"oracle_receipt_cid"})]
        expected_oracle_receipt = canonical_receipt_cid(
            "cheng.semantic_snapshot.incremental_cold_oracle",
            oracle_receipt_fields)
        if oracle.get("oracle_receipt_cid") != expected_oracle_receipt:
            raise AcceptanceError(
                f"incremental work {edit_index}: cold oracle receipt mismatch")

        cache_decisions = row.get("cache_decisions")
        if not isinstance(cache_decisions, list) or not cache_decisions:
            raise AcceptanceError(f"incremental work {edit_index}: cache decisions missing")
        cache_function_ids: set[int] = set()
        hit_count = 0
        for decision in cache_decisions:
            if not isinstance(decision, dict):
                raise AcceptanceError(f"incremental work {edit_index}: invalid cache decision")
            function_id = decision.get("function_id")
            if not is_exact_int(function_id) or function_id < 0 or function_id in cache_function_ids:
                raise AcceptanceError(f"incremental work {edit_index}: cache function identity invalid")
            cache_function_ids.add(function_id)
            hit = decision.get("hit")
            if not isinstance(hit, bool):
                raise AcceptanceError(f"incremental work {edit_index}: cache decision is not exact")
            for field in ("source_content_cid", "interface_cid", "read_set_cid",
                          "fragment_cid", "compiler_cid", "target_cid", "proof_cid"):
                if not is_sha256(decision.get(field)):
                    raise AcceptanceError(
                        f"incremental work {edit_index}: cache {field} missing")
            if hit:
                hit_count += 1
                if decision.get("validation_status") != "validated" or \
                   decision.get("previous_fragment_cid") != decision.get("fragment_cid") or \
                   function_id in rebuilt:
                    raise AcceptanceError(
                        f"incremental work {edit_index}: unproved cache hit")
        validated.append({
            "edit_index": edit_index,
            "changed_function_count": len(body_changed | interface_changed),
            "rebuilt_function_count": len(rebuilt),
            "dependency_edge_count": len(exact_edges),
            "decoded_fragment_count": len(decoded),
            "reachability_visit_count": len(visited),
            "cold_oracle_evidence_sha256": oracle_evidence_sha256,
            "cold_oracle_receipt_cid": expected_oracle_receipt,
            "cache_decision_count": len(cache_decisions),
            "proved_cache_hit_count": hit_count,
        })
    return validated


def validate_cycle_report(report_path: Path, output_root: Path,
                          trace: dict[str, Any], trace_sha256: str, manifest_sha256: str,
                          runner_sha256: str, cold_oracle_sha256: str = "",
                          workspace_input_closure_cid: str = "") -> dict[str, Any]:
    value = json.loads(report_path.read_text(encoding="utf-8"))
    if value.get("schema") != "cheng.semantic_snapshot.acceptance.runner":
        raise AcceptanceError("cycle runner schema mismatch")
    if value.get("trace_sha256") != trace_sha256 or \
       value.get("source_manifest_sha256") != manifest_sha256 or \
       value.get("runner_sha256") != runner_sha256:
        raise AcceptanceError("cycle runner input identity mismatch")
    if value.get("status") == "MISSING":
        capability = value.get("missing_capability")
        if capability not in (READ_TRACE_DARWIN_METHOD, READ_TRACE_LINUX_METHOD):
            raise AcceptanceError("cycle runner missing capability is not exact")
        raise AcceptanceMissing(f"required read trace unavailable: {capability}")
    if value.get("status") != "GREEN":
        raise AcceptanceError("cycle runner is not GREEN")
    if not is_observed_sha256(value.get("compiler_sha256")) or \
       value.get("compiler_sha256") != runner_sha256 or \
       not is_observed_sha256(value.get("toolchain_manifest_sha256")):
        raise AcceptanceError("cycle runner compiler identity missing")
    if value.get("cold_oracle_sha256") != cold_oracle_sha256 or \
       value.get("workspace_input_closure_cid") != workspace_input_closure_cid or \
       value.get("measurement_timer_sha256") != sha256_file(ACCEPTANCE_TIMER):
        raise AcceptanceError("cycle runner independent input closure identity missing")
    if value.get("target") != "arm64-apple-darwin":
        raise AcceptanceError("cycle runner target mismatch")
    toolchain_manifest_path, toolchain_manifest_sha256 = safe_artifact(
        output_root, value.get("toolchain_manifest"), "toolchain manifest")
    if toolchain_manifest_sha256 != value["toolchain_manifest_sha256"]:
        raise AcceptanceError("toolchain manifest bytes differ from identity")
    toolchain_raw = toolchain_manifest_path.read_bytes()
    try:
        toolchain = json.loads(toolchain_raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError("toolchain manifest is not canonical JSON") from exc
    toolchain_fields = {
        "schema", "compiler_sha256", "runner_sha256", "cold_oracle_sha256",
        "workspace_input_closure_cid", "source_manifest_sha256", "target",
        "measurement_timer_sha256", "manifest_receipt_cid",
    }
    if not isinstance(toolchain, dict) or set(toolchain) != toolchain_fields or \
       toolchain_raw != canonical_json_bytes(toolchain) or \
       toolchain.get("schema") != "cheng.semantic_snapshot.toolchain_manifest" or \
       toolchain.get("compiler_sha256") != runner_sha256 or \
       toolchain.get("runner_sha256") != runner_sha256 or \
       toolchain.get("cold_oracle_sha256") != cold_oracle_sha256 or \
       toolchain.get("workspace_input_closure_cid") != workspace_input_closure_cid or \
       toolchain.get("source_manifest_sha256") != manifest_sha256 or \
       toolchain.get("measurement_timer_sha256") != sha256_file(ACCEPTANCE_TIMER) or \
       toolchain.get("target") != value["target"]:
        raise AcceptanceError("toolchain manifest identity drift")
    toolchain_receipt_fields = [(key, toolchain[key]) for key in sorted(
        toolchain_fields - {"manifest_receipt_cid"})]
    expected_toolchain_receipt = canonical_receipt_cid(
        "cheng.semantic_snapshot.toolchain_manifest", toolchain_receipt_fields)
    if toolchain.get("manifest_receipt_cid") != expected_toolchain_receipt:
        raise AcceptanceError("toolchain manifest receipt mismatch")

    event_rows = value.get("accepted_events")
    if not isinstance(event_rows, list) or len(event_rows) != len(trace["events"]):
        raise AcceptanceError("cycle runner accepted event rows missing")
    source_versions: list[int] = []
    binding_receipts: set[str] = set()
    document_cids: list[str] = []
    client_versions: list[int] = []
    document_open_states: list[int] = []
    document_rows: dict[str, int] = {}
    stable_world_head_cid: str | None = None
    stable_compiler_cid: str | None = None
    for index, row in enumerate(event_rows):
        if not isinstance(row, dict):
            raise AcceptanceError(f"accepted event {index}: row missing")
        expected_event = trace["events"][index]
        version = row.get("source_version")
        if not is_exact_int(version) or version <= 0:
            raise AcceptanceError(f"accepted event {index}: invalid sourceVersion")
        source_versions.append(version)
        if row.get("event_kind") != expected_event["kind"]:
            raise AcceptanceError(f"accepted event {index}: kind drift")
        if row.get("document_cid") != expected_event["document_cid"]:
            raise AcceptanceError(f"accepted event {index}: document CID drift")
        if expected_event["kind"] != "didClose" and \
           (not is_exact_int(row.get("client_version")) or
            row.get("client_version") != expected_event["client_version"]):
            raise AcceptanceError(f"accepted event {index}: client version drift")
        event_document_cid = expected_event["document_cid"]
        if expected_event["kind"] == "didOpen":
            if event_document_cid in document_rows:
                raise AcceptanceError(f"accepted event {index}: duplicate open in trace")
            document_rows[event_document_cid] = len(document_cids)
            document_cids.append(event_document_cid)
            client_versions.append(expected_event["client_version"])
            document_open_states.append(1)
        elif expected_event["kind"] == "didChange":
            document_row = document_rows.get(event_document_cid, -1)
            if document_row < 0 or document_open_states[document_row] != 1:
                raise AcceptanceError(f"accepted event {index}: invalid change state")
            client_versions[document_row] = expected_event["client_version"]
        else:
            document_row = document_rows.get(event_document_cid, -1)
            if document_row < 0 or document_open_states[document_row] != 1:
                raise AcceptanceError(f"accepted event {index}: invalid close state")
            document_open_states[document_row] = 0
        if row.get("document_cids") != document_cids or \
           row.get("client_versions") != client_versions or \
           row.get("document_open_states") != document_open_states:
            raise AcceptanceError(
                f"accepted event {index}: binding document state differs from trace")
        for field in ("source_identity_receipt_cid", "workspace_session_cid") + \
                     CID_FIELDS + VALIDATION_CID_FIELDS:
            if not is_observed_sha256(row.get(field)):
                raise AcceptanceError(f"accepted event {index}: invalid {field}")
        if row.get("canonical_root_cid") != row.get("csg_root_cid"):
            raise AcceptanceError(f"accepted event {index}: canonical root is not csgRootCid")
        if semantic_identity_cid(row, f"accepted event {index}") != \
           row.get("semantic_snapshot_cid"):
            raise AcceptanceError(f"accepted event {index}: semantic identity CID mismatch")
        if semantic_binding_cid(row, f"accepted event {index}") != \
           row.get("binding_receipt_cid"):
            raise AcceptanceError(f"accepted event {index}: binding receipt CID mismatch")
        if semantic_validation_cid(row, f"accepted event {index}") != \
           row.get("validation_receipt_cid"):
            raise AcceptanceError(f"accepted event {index}: validation receipt CID mismatch")
        if stable_world_head_cid is None:
            stable_world_head_cid = row["world_head_cid"]
            stable_compiler_cid = row["compiler_cid"]
        elif row["world_head_cid"] != stable_world_head_cid or \
             row["compiler_cid"] != stable_compiler_cid:
            raise AcceptanceError(f"accepted event {index}: world/compiler identity drift")
        if row.get("validation_state") != "validated" or \
           row.get("candidate_state") != "published" or \
           row.get("published_source_version") != version or \
           row.get("validation_completed_before_publish") is not True or \
           row.get("publish_allocation_count") != 0 or \
           row.get("publish_io_operation_count") != 0:
            raise AcceptanceError(
                f"accepted event {index}: publication preceded complete validation")
        fingerprint_before = row.get("published_fingerprint_before")
        fingerprint_after = row.get("published_fingerprint_after")
        if not is_sha256(fingerprint_before) or \
           not is_observed_sha256(fingerprint_after) or \
           fingerprint_before == fingerprint_after:
            raise AcceptanceError(f"accepted event {index}: publish fingerprint did not advance")
        receipt = row["binding_receipt_cid"]
        if receipt in binding_receipts:
            raise AcceptanceError("binding receipt reused across accepted events")
        binding_receipts.add(receipt)
    if source_versions != list(range(1, len(source_versions) + 1)):
        raise AcceptanceError("sourceVersion sequence is not unique and contiguous")

    event_by_version = {row["source_version"]: row for row in event_rows}
    artifact_paths: set[Path] = {toolchain_manifest_path}
    coverage = value.get("coverage")
    if not isinstance(coverage, dict) or \
       set(coverage) != {"lsp", "incremental", "debug"}:
        raise AcceptanceError("production coverage matrix missing")
    coverage_rows = {
        "lsp": validate_coverage_matrix(
            coverage["lsp"], REQUIRED_LSP_CASES, "lsp", output_root,
            event_by_version, value["compiler_sha256"], trace_sha256,
            manifest_sha256, artifact_paths),
        "incremental": validate_coverage_matrix(
            coverage["incremental"], REQUIRED_INCREMENTAL_CASES,
            "incremental", output_root, event_by_version,
            value["compiler_sha256"], trace_sha256, manifest_sha256,
            artifact_paths),
        "debug": validate_coverage_matrix(
            coverage["debug"], REQUIRED_DEBUG_CASES, "debug", output_root,
            event_by_version, value["compiler_sha256"], trace_sha256,
            manifest_sha256, artifact_paths),
    }

    incremental_work = validate_incremental_work(
        value.get("incremental_work_samples"), trace, output_root,
        cold_oracle_sha256, trace_sha256, manifest_sha256, artifact_paths)

    comparisons = value.get("equivalence_samples")
    if not isinstance(comparisons, list) or \
       len(comparisons) != trace["random_edit_count"]:
        raise AcceptanceError("cold equivalence sample count differs from trace")
    edit_indexes = [comparison.get("edit_index") for comparison in comparisons
                    if isinstance(comparison, dict)]
    if edit_indexes != list(range(len(comparisons))):
        raise AcceptanceError("cold equivalence edit indexes are not exact")
    comparison_rows: list[dict[str, Any]] = []
    for index, comparison in enumerate(comparisons):
        if not isinstance(comparison, dict):
            raise AcceptanceError(f"equivalence {index}: comparison row missing")
        incremental = comparison.get("incremental")
        cold = comparison.get("cold")
        if not isinstance(incremental, dict) or not isinstance(cold, dict):
            raise AcceptanceError(f"equivalence {index}: build rows missing")
        source_version = trace["random_edit_event_indexes"][index] + 1
        event = event_by_version[source_version]
        if comparison.get("source_version") != source_version or \
           incremental.get("source_version") != source_version or \
           cold.get("source_version") != source_version or \
           incremental.get("build_mode") != "incremental" or \
           incremental.get("cache_enabled") is not True or \
           cold.get("build_mode") != "cold_full" or \
           cold.get("cache_enabled") is not False or \
           incremental.get("compiler_sha256") != value["compiler_sha256"] or \
           cold.get("compiler_sha256") != value["compiler_sha256"] or \
           incremental.get("toolchain_manifest_sha256") != \
               value["toolchain_manifest_sha256"] or \
           cold.get("toolchain_manifest_sha256") != \
               value["toolchain_manifest_sha256"]:
            raise AcceptanceError(f"equivalence {index}: build mode or identity drift")
        hashes: dict[str, str] = {}
        for artifact in EQUIVALENCE_ARTIFACTS:
            incremental_path, incremental_hash = validate_bound_artifact(
                output_root, incremental.get(artifact),
                f"equivalence[{index}].incremental.{artifact}", artifact,
                source_version, event, "incremental", artifact_paths)
            cold_path, cold_hash = validate_bound_artifact(
                output_root, cold.get(artifact),
                f"equivalence[{index}].cold.{artifact}", artifact,
                source_version, event, "cold_full", artifact_paths)
            if incremental_path == cold_path:
                raise AcceptanceError(f"equivalence {index}: artifact path reused")
            if incremental_hash != cold_hash:
                raise AcceptanceError(f"equivalence {index}: {artifact} bytes differ")
            hashes[artifact] = incremental_hash
            if artifact == "runtime_stdout" and incremental_path.stat().st_size == 0:
                raise AcceptanceError(f"equivalence {index}: empty runtime output")
            if artifact == "debug_receipt" and cold_path.stat().st_size == 0:
                raise AcceptanceError(f"equivalence {index}: empty debug receipt")
            if artifact not in ("runtime_stderr",) and \
               (incremental_path.stat().st_size == 0 or cold_path.stat().st_size == 0):
                raise AcceptanceError(f"equivalence {index}: empty {artifact}")
            if artifact in ("primary_object", "backend2_object"):
                validate_macho_arm64_object(
                    incremental_path, f"equivalence[{index}].incremental.{artifact}")
                validate_macho_arm64_object(
                    cold_path, f"equivalence[{index}].cold.{artifact}")
        if incremental.get("run_exit_code") != cold.get("run_exit_code") or \
           not is_exact_int(incremental.get("run_exit_code")) or \
           incremental.get("run_exit_code") != 0:
            raise AcceptanceError(f"equivalence {index}: runtime exit differs")
        incremental_orc_path, _ = validate_bound_artifact(
            output_root, incremental.get("orc_report"),
            f"equivalence[{index}].incremental.orc", "orc_report",
            source_version, event, "incremental", artifact_paths)
        cold_orc_path, _ = validate_bound_artifact(
            output_root, cold.get("orc_report"),
            f"equivalence[{index}].cold.orc", "orc_report",
            source_version, event, "cold_full", artifact_paths)
        if incremental_orc_path == cold_orc_path:
            raise AcceptanceError(f"equivalence {index}: ORC evidence reused")
        guard_peaks: dict[str, int] = {}
        for build_label, build in (("incremental", incremental), ("cold", cold)):
            build_guard, _ = safe_artifact(
                output_root, build.get("memory_guard_evidence"),
                f"equivalence[{index}].{build_label}.guard")
            if build_guard in artifact_paths:
                raise AcceptanceError(
                    f"equivalence {index}: {build_label} guard evidence reused")
            artifact_paths.add(build_guard)
            build_guard_fields: dict[str, str] = {}
            for line in build_guard.read_text(
                    encoding="utf-8", errors="strict").splitlines():
                key, separator, field_value = line.partition("=")
                if not separator or key in build_guard_fields:
                    raise AcceptanceError(
                        f"equivalence {index}: {build_label} guard invalid")
                build_guard_fields[key] = field_value
            raw_peak = build_guard_fields.get("process_tree_enforced_peak_bytes", "")
            if not raw_peak.isdigit():
                raise AcceptanceError(
                    f"equivalence {index}: {build_label} guard peak missing")
            guard_peaks[build_label] = int(raw_peak)
            parse_guard_evidence(
                build_guard, f"equivalence[{index}].{build_label}",
                guard_peaks[build_label])
        incremental_orc = parse_orc(
            incremental_orc_path, f"equivalence[{index}].incremental",
            event, source_version, "incremental")
        cold_orc = parse_orc(
            cold_orc_path, f"equivalence[{index}].cold",
            event, source_version, "cold_full")
        if incremental_orc != cold_orc:
            raise AcceptanceError(f"equivalence {index}: ORC ledger differs")
        comparison_rows.append({"edit_index": comparison.get("edit_index"),
                                "artifact_sha256": hashes, "orc": incremental_orc,
                                "process_tree_peak_bytes": guard_peaks})

    attacks = value.get("tamper_attacks")
    if not isinstance(attacks, list) or len(attacks) != len(ATTACK_KINDS):
        raise AcceptanceError("tamper attack rows missing")
    attack_by_kind = {row.get("kind"): row for row in attacks if isinstance(row, dict)}
    if len(attack_by_kind) != len(ATTACK_KINDS) or set(attack_by_kind) != set(ATTACK_KINDS):
        raise AcceptanceError("tamper attack identities are not exact")
    attack_rows: list[dict[str, Any]] = []
    for kind in ATTACK_KINDS:
        row = attack_by_kind.get(kind)
        if not isinstance(row, dict) or row.get("status") != "hard_fail":
            raise AcceptanceError(f"tamper attack escaped: {kind}")
        if not isinstance(row.get("return_code"), int) or row["return_code"] == 0:
            raise AcceptanceError(f"tamper attack returned success: {kind}")
        before = row.get("published_fingerprint_before")
        after = row.get("published_fingerprint_after")
        if not is_sha256(before) or before != after:
            raise AcceptanceError(f"tamper attack mutated published state: {kind}")
        attack_guard, _ = safe_artifact(
            output_root, row.get("guard_evidence"), f"attack.{kind}.guard")
        mutation, _ = safe_artifact(
            output_root, row.get("mutation_evidence"), f"attack.{kind}.mutation")
        if attack_guard in artifact_paths or mutation in artifact_paths:
            raise AcceptanceError(f"tamper attack evidence reused: {kind}")
        artifact_paths.update((attack_guard, mutation))
        guard_fields: dict[str, str] = {}
        for line in attack_guard.read_text(encoding="utf-8", errors="strict").splitlines():
            key, separator, field_value = line.partition("=")
            if not separator or key in guard_fields:
                raise AcceptanceError(f"tamper attack guard invalid: {kind}")
            guard_fields[key] = field_value
        if guard_fields.get("status") != "completed" or \
           guard_fields.get("rc") != str(row["return_code"]) or \
           guard_fields.get("memory_limit_bytes") != str(MEMORY_LIMIT_BYTES) or \
           guard_fields.get("observed_sample_limit_status") != "proved" or \
           guard_fields.get("hard_memory_limit_proof_status") != \
               "proved_linux_kernel_cgroup_v2_aggregate" or \
           guard_fields.get("memory_measurement_status") != "available" or \
           not guard_fields.get("process_tree_enforced_peak_bytes", "").isdigit() or \
           int(guard_fields["process_tree_enforced_peak_bytes"]) > MEMORY_LIMIT_BYTES:
            raise AcceptanceError(f"tamper attack guard did not prove hard failure: {kind}")
        mutation_value = json.loads(mutation.read_text(encoding="utf-8"))
        mutation_fields = {
            "schema", "kind", "control_artifact", "mutated_artifact",
            "changed_byte_offsets", "before_value_sha256", "after_value_sha256",
            "mutation_receipt_cid",
        }
        if not isinstance(mutation_value, dict) or set(mutation_value) != mutation_fields or \
           canonical_json_bytes(mutation_value) != mutation.read_bytes() or \
           mutation_value.get("schema") != "cheng.semantic_snapshot.tamper_mutation" or \
           mutation_value.get("kind") != kind:
            raise AcceptanceError(f"tamper mutation identity invalid: {kind}")
        control_path, control_sha256 = safe_artifact(
            output_root, mutation_value.get("control_artifact"),
            f"attack.{kind}.control")
        mutated_path, mutated_sha256 = safe_artifact(
            output_root, mutation_value.get("mutated_artifact"),
            f"attack.{kind}.mutated")
        if control_path in artifact_paths or mutated_path in artifact_paths or \
           control_path == mutated_path:
            raise AcceptanceError(f"tamper payload evidence reused: {kind}")
        artifact_paths.update((control_path, mutated_path))
        control_raw = control_path.read_bytes()
        mutated_raw = mutated_path.read_bytes()
        changed_offsets = [offset for offset in range(max(len(control_raw), len(mutated_raw)))
                           if (control_raw[offset] if offset < len(control_raw) else None) !=
                              (mutated_raw[offset] if offset < len(mutated_raw) else None)]
        if not changed_offsets or len(changed_offsets) > 64 or \
           mutation_value.get("changed_byte_offsets") != changed_offsets or \
           mutation_value.get("before_value_sha256") != control_sha256 or \
           mutation_value.get("after_value_sha256") != mutated_sha256 or \
           control_sha256 == mutated_sha256:
            raise AcceptanceError(f"tamper mutation bytes are not exact: {kind}")
        mutation_receipt_fields = [(key, mutation_value[key]) for key in sorted(
            mutation_fields - {"mutation_receipt_cid"})]
        expected_mutation_receipt = canonical_receipt_cid(
            "cheng.semantic_snapshot.tamper_mutation", mutation_receipt_fields)
        if mutation_value.get("mutation_receipt_cid") != expected_mutation_receipt:
            raise AcceptanceError(f"tamper mutation receipt mismatch: {kind}")
        command_argv = row.get("command_argv")
        if not isinstance(command_argv, list) or not command_argv or \
           any(not isinstance(argument, str) or "\x00" in argument
               for argument in command_argv) or \
           str(mutated_path) not in command_argv or \
           row.get("command_sha256") != value["compiler_sha256"] or \
           row.get("command_argv_cid") != read_trace_argv_digest(command_argv) or \
           guard_fields.get("command_identity_status") != "available" or \
           guard_fields.get("command_sha256") != value["compiler_sha256"] or \
           guard_fields.get("command_execution_snapshot_sha256") != \
               value["compiler_sha256"] or \
           guard_fields.get("command_argv_sha256") != row.get("command_argv_cid"):
            raise AcceptanceError(f"tamper attack did not execute the mutated payload: {kind}")
        stderr_path, stderr_sha256 = safe_artifact(
            output_root, row.get("stderr_evidence"), f"attack.{kind}.stderr")
        rejection_path, rejection_sha256 = safe_artifact(
            output_root, row.get("rejection_evidence"), f"attack.{kind}.rejection")
        if stderr_path in artifact_paths or rejection_path in artifact_paths:
            raise AcceptanceError(f"tamper rejection evidence reused: {kind}")
        artifact_paths.update((stderr_path, rejection_path))
        diagnostic_code = f"semantic_snapshot_tamper_{kind}"
        stderr_raw = stderr_path.read_bytes()
        if not stderr_raw or diagnostic_code.encode("ascii") not in stderr_raw or \
           guard_fields.get("stderr_path") != str(stderr_path) or \
           guard_fields.get("stderr_sha256") != stderr_sha256:
            raise AcceptanceError(f"tamper attack failed for an unproved reason: {kind}")
        rejection_raw = rejection_path.read_bytes()
        try:
            rejection = json.loads(rejection_raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise AcceptanceError(f"tamper rejection receipt invalid: {kind}") from exc
        rejection_fields = {
            "schema", "kind", "diagnostic_code", "mutated_sha256",
            "compiler_sha256", "return_code", "published_fingerprint_before",
            "published_fingerprint_after", "rejection_receipt_cid",
        }
        if not isinstance(rejection, dict) or set(rejection) != rejection_fields or \
           rejection_raw != canonical_json_bytes(rejection) or \
           rejection.get("schema") != "cheng.semantic_snapshot.tamper_rejection" or \
           rejection.get("kind") != kind or \
           rejection.get("diagnostic_code") != diagnostic_code or \
           rejection.get("mutated_sha256") != mutated_sha256 or \
           rejection.get("compiler_sha256") != value["compiler_sha256"] or \
           rejection.get("return_code") != row["return_code"] or \
           rejection.get("published_fingerprint_before") != before or \
           rejection.get("published_fingerprint_after") != after:
            raise AcceptanceError(f"tamper rejection receipt identity drift: {kind}")
        rejection_receipt_fields = [(key, rejection[key]) for key in sorted(
            rejection_fields - {"rejection_receipt_cid"})]
        expected_rejection_receipt = canonical_receipt_cid(
            "cheng.semantic_snapshot.tamper_rejection",
            rejection_receipt_fields)
        if rejection.get("rejection_receipt_cid") != expected_rejection_receipt:
            raise AcceptanceError(f"tamper rejection receipt mismatch: {kind}")
        attack_rows.append({"kind": kind, "return_code": row["return_code"],
                            "published_fingerprint": before,
                            "mutation_receipt_cid": expected_mutation_receipt,
                            "rejection_evidence_sha256": rejection_sha256,
                            "rejection_receipt_cid": expected_rejection_receipt})

    metrics = value.get("metrics")
    if not isinstance(metrics, dict):
        raise AcceptanceError("cycle runner metrics missing")
    metric_identities = {
        "trace_sha256": trace_sha256,
        "source_manifest_sha256": manifest_sha256,
        "compiler_sha256": value["compiler_sha256"],
        "toolchain_manifest_sha256": value["toolchain_manifest_sha256"],
        "target": value["target"],
        "measurement_timer_sha256": value["measurement_timer_sha256"],
    }
    measurement_receipts: set[str] = set()
    summaries = {
        label: metric_summary(metrics.get(label), label, output_root, metric_identities,
                              artifact_paths, measurement_receipts)
        for label in ("baseline", "candidate", "baseline_cold", "candidate_cold")
        if isinstance(metrics.get(label), list)
    }
    if set(summaries) != {"baseline", "candidate", "baseline_cold", "candidate_cold"}:
        raise AcceptanceError("cycle runner metric groups incomplete")
    baseline = summaries["baseline"]
    candidate = summaries["candidate"]
    baseline_cold = summaries["baseline_cold"]
    candidate_cold = summaries["candidate_cold"]
    if baseline["child_command_argv_root_cid"] == \
           candidate["child_command_argv_root_cid"] or \
       baseline_cold["child_command_argv_root_cid"] == \
           candidate_cold["child_command_argv_root_cid"]:
        raise AcceptanceError("baseline and candidate measured identical command argv")
    if baseline["stdout_root_cid"] != candidate["stdout_root_cid"] or \
       baseline["stderr_root_cid"] != candidate["stderr_root_cid"] or \
       baseline_cold["stdout_root_cid"] != candidate_cold["stdout_root_cid"] or \
       baseline_cold["stderr_root_cid"] != candidate_cold["stderr_root_cid"]:
        raise AcceptanceError("performance workloads produced different observable bytes")
    wall_median_reduction = reduction(baseline["wall_ns"]["median"],
                                      candidate["wall_ns"]["median"])
    wall_p95_reduction = reduction(baseline["wall_ns"]["p95"],
                                   candidate["wall_ns"]["p95"])
    read_count_reduction = reduction(baseline["read_syscalls"]["median"],
                                     candidate["read_syscalls"]["median"])
    read_bytes_reduction = reduction(baseline["read_bytes"]["median"],
                                     candidate["read_bytes"]["median"])
    cold_median_overhead = (candidate_cold["wall_ns"]["median"] /
                            baseline_cold["wall_ns"]["median"] - 1.0)
    cold_p95_overhead = (candidate_cold["wall_ns"]["p95"] /
                         baseline_cold["wall_ns"]["p95"] - 1.0)
    if wall_median_reduction < 0.40 or wall_p95_reduction < 0.40:
        raise AcceptanceError("development loop wall reduction is below 40%")
    if read_count_reduction < 0.50 or read_bytes_reduction < 0.50:
        raise AcceptanceError("file reads reduction is below 50%")
    if cold_median_overhead > 0.01 or cold_p95_overhead > 0.01:
        raise AcceptanceError("cold build overhead exceeds 1%")
    return {
        "status": "GREEN",
        "report_sha256": sha256_file(report_path),
        "compiler_sha256": value["compiler_sha256"],
        "toolchain_manifest_sha256": value["toolchain_manifest_sha256"],
        "accepted_event_count": len(event_rows),
        "source_version_first": source_versions[0],
        "source_version_last": source_versions[-1],
        "coverage": coverage_rows,
        "equivalence_sample_count": len(comparisons),
        "equivalence": comparison_rows,
        "incremental_work": incremental_work,
        "tamper_attack_count": len(attack_rows),
        "tamper_attacks": attack_rows,
        "metric_summaries": summaries,
        "wall_median_reduction": wall_median_reduction,
        "wall_p95_reduction": wall_p95_reduction,
        "read_syscall_median_reduction": read_count_reduction,
        "read_bytes_median_reduction": read_bytes_reduction,
        "cold_median_overhead": cold_median_overhead,
        "cold_p95_overhead": cold_p95_overhead,
    }


def run_cycle_runner(runner: Path, trace: dict[str, Any], trace_path: Path, trace_sha256: str,
                     manifest_sha256: str, seed: int, edit_count: int,
                     evidence_parent: Path, cold_oracle_sha256: str,
                     workspace_input_closure_cid: str) -> dict[str, Any]:
    runner_sha256 = sha256_file(runner)
    output_root = evidence_parent / "cycle-runner-output"
    output_root.mkdir(mode=0o700)
    persistent_trace_path = output_root / "acceptance-trace.json"
    persistent_trace_path.write_bytes(trace_path.read_bytes())
    report_path = output_root / "cycle-report.json"
    completed = run_captured_process_group(
        [
            str(runner), "semantic-snapshot-acceptance",
            f"--trace:{persistent_trace_path}",
            f"--source-manifest-sha256:{manifest_sha256}",
            f"--seed:{seed}", f"--sample-count:{edit_count}",
            f"--cold-oracle-sha256:{cold_oracle_sha256}",
            f"--workspace-input-closure-cid:{workspace_input_closure_cid}",
            f"--measurement-timer:{ACCEPTANCE_TIMER.resolve()}",
            f"--measurement-timer-sha256:{sha256_file(ACCEPTANCE_TIMER)}",
            f"--artifact-root:{output_root}", f"--report-out:{report_path}",
        ],
        cwd=ROOT,
        timeout_seconds=43_200,
    )
    if output_root.is_symlink() or not output_root.is_dir():
        raise AcceptanceError("production cycle runner replaced its output root")
    stdout_path = output_root / "runner.stdout.txt"
    stderr_path = output_root / "runner.stderr.txt"
    for path, raw in ((stdout_path, completed.stdout), (stderr_path, completed.stderr)):
        with path.open("xb") as stream:
            stream.write(raw)
    if not report_path.is_file():
        raise AcceptanceError("production cycle runner report missing")
    report_stat = report_path.lstat()
    if not stat.S_ISREG(report_stat.st_mode) or report_stat.st_nlink != 1:
        raise AcceptanceError("production cycle runner report is not private regular data")
    try:
        result = validate_cycle_report(report_path, output_root, trace, trace_sha256,
                                       manifest_sha256, runner_sha256,
                                       cold_oracle_sha256,
                                       workspace_input_closure_cid)
    except AcceptanceMissing:
        if completed.returncode != 3:
            raise AcceptanceError(
                "cycle runner MISSING report did not return capability exit 3")
        raise
    if completed.returncode != 0:
        raise AcceptanceError(
            "production cycle runner failed rc=%d stderr=%s" %
            (completed.returncode, completed.stderr.decode("utf-8", errors="replace")[-4000:]))
    result.update({
        "runner_path": str(runner), "runner_sha256": runner_sha256,
        "output_root": str(output_root), "report_path": str(report_path),
        "stdout_path": str(stdout_path), "stderr_path": str(stderr_path),
        "stdout_sha256": sha256_bytes(completed.stdout),
        "stderr_sha256": sha256_bytes(completed.stderr),
    })
    return result


def git_identity() -> dict[str, str]:
    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                          text=True, stdout=subprocess.PIPE, check=True).stdout.strip()
    status = subprocess.run(
        ["git", "status", "--porcelain", "-z", "--untracked-files=all",
         "--ignore-submodules=none"], cwd=ROOT, stdout=subprocess.PIPE, check=True).stdout
    return {"head": head, "worktree_status_sha256": sha256_bytes(status)}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--lsp", type=Path)
    parser.add_argument("--lsp-compiler-identity", type=Path)
    parser.add_argument("--lsp-unavailable-reason", default="")
    parser.add_argument("--cycle-runner", type=Path)
    parser.add_argument("--evidence-root", type=Path)
    parser.add_argument("--component-mode", choices=("run", "static"), default="run")
    parser.add_argument("--seed", type=int, default=8_420_731)
    parser.add_argument("--sample-count", type=int, default=30)
    parser.add_argument("--trace-out", type=Path)
    parser.add_argument("--report", type=Path, required=True)
    parser.add_argument("--run-nonce", required=True)
    args = parser.parse_args()
    if args.sample_count < MIN_RANDOM_EDITS:
        parser.error("--sample-count must be at least 30")

    report_path = args.report if args.report.is_absolute() else ROOT / args.report
    report_path.parent.mkdir(parents=True, exist_ok=True)
    gaps: list[str] = []
    started = time.perf_counter_ns()
    workspace_inputs_start: dict[str, Any] | None = None
    workspace_inputs_end: dict[str, Any] | None = None
    compiler_inventory: dict[str, Any] | None = None
    with tempfile.TemporaryDirectory(prefix="cheng-semantic-acceptance-") as temporary:
        work = Path(temporary)
        try:
            evidence_parent: Path | None = None
            if args.evidence_root:
                evidence_parent = args.evidence_root if args.evidence_root.is_absolute() \
                    else ROOT / args.evidence_root
                if not evidence_parent.exists():
                    evidence_parent.mkdir(parents=True, mode=0o700)
            else:
                evidence_parent = Path(tempfile.mkdtemp(
                    prefix="semantic-snapshot-acceptance-evidence.",
                    dir=report_path.parent))
            if evidence_parent is not None:
                evidence_metadata = evidence_parent.lstat()
                if evidence_parent.is_symlink() or \
                   not stat.S_ISDIR(evidence_metadata.st_mode) or \
                   stat.S_IMODE(evidence_metadata.st_mode) & 0o077:
                    raise AcceptanceError("evidence root is not a private directory")
            workspace_inputs_start = workspace_input_closure(
                "start", evidence_parent)
            compiler_inventory = compiler_identity_inventory()
            manifest, manifest_sha256, texts = source_manifest()
            trace = make_trace(args.seed, args.sample_count, texts, manifest_sha256)
            trace_contract = validate_random_edit_trace_contract(trace)
            trace_raw = canonical_json_bytes(trace)
            trace_path = work / "semantic-snapshot-trace.json"
            trace_path.write_bytes(trace_raw)
            trace_sha256 = sha256_bytes(trace_raw)
            if args.trace_out:
                trace_out = args.trace_out if args.trace_out.is_absolute() else ROOT / args.trace_out
                trace_out.parent.mkdir(parents=True, exist_ok=True)
                atomic_write(trace_out, trace_raw)

            integrity_attacks = run_integrity_attacks(
                evidence_parent, trace_raw, trace_sha256, args.run_nonce)

            if evidence_parent is not None:
                component_work = evidence_parent / "component-gates"
                component_work.mkdir(mode=0o700)
            else:
                component_work = work
            component_rows, component_gaps = run_component_gates(
                component_work, args.component_mode, workspace_inputs_start)
            gaps.extend(component_gaps)

            lsp_result: dict[str, Any]
            lsp_build_evidence: dict[str, Any] = {"status": "MISSING"}
            trusted_compiler_path: Path | None = None
            if args.lsp and args.lsp.is_file() and os.access(args.lsp, os.X_OK) and \
               args.lsp_compiler_identity and args.lsp_compiler_identity.is_file():
                if evidence_parent is None:
                    raise AcceptanceError("lsp evidence root missing")
                try:
                    lsp_identity, lsp_identity_sha256, lsp_build_evidence = \
                        load_lsp_compiler_identity(
                            args.lsp_compiler_identity.absolute(),
                            args.lsp.absolute())
                    trusted_compiler_path = Path(
                        lsp_identity["build_evidence"]
                        ["compiler_executable_path"])
                    lsp_result = run_lsp(
                        args.lsp.absolute(),
                        args.lsp_compiler_identity.absolute(),
                        lsp_identity, lsp_identity_sha256, trace,
                        evidence_parent)
                    if lsp_result["status"] != "GREEN":
                        gaps.append(
                            "lsp_stdio_candidate_producer_or_exact_query_incomplete")
                    metrics = lsp_result.get("metrics")
                    if isinstance(metrics, dict):
                        if metrics.get("candidateAttemptCount") == 0:
                            gaps.append("lsp_stdio_candidate_producer_not_observed")
                        if metrics.get("parserBuildObserved") is False or \
                           metrics.get("compilerCsgBuildObserved") is False:
                            gaps.append(
                                "lsp_parser_or_compiler_csg_build_not_observed")
                except (AcceptanceError, OSError) as exc:
                    lsp_result = {
                        "status": "RED",
                        "reason": f"lsp_build_identity_invalid: {exc}",
                    }
                    lsp_build_evidence = {
                        "status": "RED", "reason": str(exc),
                    }
                    gaps.append("lsp_build_evidence_invalid")
            else:
                identity_reason = ""
                if args.lsp and not args.lsp_compiler_identity:
                    identity_reason = "lsp_compiler_identity_not_provided"
                elif args.lsp and args.lsp_compiler_identity and \
                     not args.lsp_compiler_identity.is_file():
                    identity_reason = "lsp_compiler_identity_not_regular"
                reason = args.lsp_unavailable_reason or identity_reason or \
                    "fresh_lsp_not_provided"
                lsp_result = {"status": "MISSING", "reason": reason}
                gaps.append(f"lsp_missing:{reason}")
            if args.lsp and lsp_build_evidence.get("status") != "GREEN" and \
               lsp_build_evidence.get("status") != "RED":
                gaps.append("lsp_build_evidence_missing")
            require_workspace_input_closure(
                workspace_inputs_start, "lsp-phase-end", evidence_parent)

            cycle_result: dict[str, Any]
            if args.cycle_runner and args.cycle_runner.is_file() and \
               os.access(args.cycle_runner, os.X_OK):
                if evidence_parent is None:
                    raise AcceptanceError("cycle evidence root missing")
                try:
                    if lsp_build_evidence.get("status") != "GREEN" or \
                       trusted_compiler_path is None:
                        raise AcceptanceMissing(
                            "trusted current-source cold oracle missing")
                    cycle_result = run_cycle_runner(
                        args.cycle_runner.resolve(), trace, trace_path, trace_sha256,
                        manifest_sha256, args.seed, args.sample_count, evidence_parent,
                        sha256_file(trusted_compiler_path),
                        workspace_inputs_start["closure_cid"])
                except AcceptanceMissing as exc:
                    cycle_result = {"status": "MISSING", "reason": str(exc),
                                    "evidence_root": str(evidence_parent)}
                    gaps.extend((
                        "trusted_current_source_cold_oracle_missing",
                        "independent_file_read_measurement_missing",
                        "wall_read_cold_threshold_proof_missing",
                    ))
                except (AcceptanceError, json.JSONDecodeError, OSError) as exc:
                    cycle_result = {"status": "RED", "reason": str(exc),
                                    "evidence_root": str(evidence_parent)}
                    gaps.append("production_cycle_runner_failed_validation")
            else:
                cycle_result = {"status": "MISSING",
                                "reason": "production_cycle_runner_not_connected"}
                gaps.extend((
                    "production_cycle_runner_missing",
                    "random_incremental_cold_equivalence_missing",
                    "cache_cid_dependency_attack_matrix_missing",
                    "snapshot_orc_balance_missing",
                    "independent_file_read_measurement_missing",
                    "valid_current_source_performance_baseline_missing",
                    "wall_read_cold_threshold_proof_missing",
                ))

            workspace_inputs_end = workspace_input_closure(
                "end", evidence_parent)
            workspace_inputs_stable = workspace_inputs_start["closure_cid"] == \
                workspace_inputs_end["closure_cid"] and \
                workspace_inputs_start["file_count"] == \
                workspace_inputs_end["file_count"]
            if not workspace_inputs_stable:
                gaps.append("workspace_input_closure_changed_during_acceptance")
            red = lsp_result.get("status") == "RED" or \
                lsp_build_evidence.get("status") == "RED" or \
                cycle_result.get("status") == "RED" or \
                any(row.get("status") == "RED" for row in component_rows) or \
                not workspace_inputs_stable
            status = "GREEN" if not gaps else ("RED" if red else "MISSING")
            report = {
                "schema": "cheng.semantic_snapshot.acceptance",
                "run_nonce": args.run_nonce,
                "status": status,
                "strict_gate_passed": status == "GREEN",
                "gaps": sorted(set(gaps)),
                "repo": git_identity(),
                "workspace_inputs": {
                    "status": "GREEN" if workspace_inputs_stable else "RED",
                    "stable": workspace_inputs_stable,
                    "start": workspace_inputs_start,
                    "end": workspace_inputs_end,
                },
                "platform": platform.platform(),
                "python": sys.version.split()[0],
                "harness_path": str(HARNESS),
                "harness_sha256": sha256_file(HARNESS),
                "source_manifest": manifest,
                "source_manifest_sha256": manifest_sha256,
                "compiler_identity_inventory": compiler_inventory,
                "source_file_count": len(manifest),
                "source_bytes": sum(int(row["bytes"]) for row in manifest),
                "source_lines": sum(int(row["lines"]) for row in manifest),
                "trace_sha256": trace_sha256,
                "trace_event_count": len(trace["events"]),
                "random_edit_count": trace["random_edit_count"],
                **trace_contract,
                "component_gates": component_rows,
                "lsp": lsp_result,
                "lsp_build_evidence": lsp_build_evidence,
                "production_cycle": cycle_result,
                "integrity_attacks": integrity_attacks,
                "thresholds": {
                    "memory_limit_bytes": MEMORY_LIMIT_BYTES,
                    "minimum_samples": MIN_RANDOM_EDITS,
                    "minimum_wall_reduction": 0.40,
                    "minimum_file_read_reduction": 0.50,
                    "maximum_cold_overhead": 0.01,
                },
                "elapsed_ns": time.perf_counter_ns() - started,
            }
        except (AcceptanceError, OSError, subprocess.SubprocessError,
                json.JSONDecodeError) as exc:
            report = {
                "schema": "cheng.semantic_snapshot.acceptance",
                "run_nonce": args.run_nonce,
                "status": "RED",
                "strict_gate_passed": False,
                "gaps": [f"harness_error:{exc}"],
                "repo": git_identity(),
                "workspace_inputs": {
                    "status": "RED",
                    "stable": False,
                    "start": workspace_inputs_start,
                    "end": workspace_inputs_end,
                },
                "platform": platform.platform(),
                "python": sys.version.split()[0],
                "harness_path": str(HARNESS),
                "harness_sha256": sha256_file(HARNESS),
                "compiler_identity_inventory": compiler_inventory,
                "elapsed_ns": time.perf_counter_ns() - started,
            }
    validate_report_envelope(report, args.run_nonce)
    rendered = (json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) +
                "\n").encode("utf-8")
    atomic_write(report_path, rendered)
    sys.stdout.buffer.write(rendered)
    if report["strict_gate_passed"]:
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
