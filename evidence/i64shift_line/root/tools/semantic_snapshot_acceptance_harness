class AcceptanceError(RuntimeError):
    pass


class AcceptanceMissing(AcceptanceError):
    pass


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_json_bytes(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True,
                       separators=(",", ":")) + "\n").encode("utf-8")


def framed_argv_cid(argv: list[str]) -> str:
    digest = hashlib.sha256()
    for argument in argv:
        raw = argument.encode("utf-8")
        digest.update(struct.pack(">Q", len(raw)))
        digest.update(raw)
    return digest.hexdigest()


def exact_regular_snapshot(path: Path, label: str, expected_sha256: str,
                           executable: bool = False,
                           capture: bool = False) -> dict[str, Any]:
    if not path.is_absolute():
        raise AcceptanceError(f"{label} path is not absolute")
    try:
        if path.resolve(strict=True) != path:
            raise AcceptanceError(f"{label} path is not canonical")
    except FileNotFoundError as exc:
        raise AcceptanceError(f"{label} is missing") from exc
    try:
        before = path.lstat()
    except FileNotFoundError as exc:
        raise AcceptanceError(f"{label} is missing") from exc
    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode) or \
       before.st_nlink != 1:
        raise AcceptanceError(f"{label} is not private regular data")
    if executable and before.st_mode & 0o111 == 0:
        raise AcceptanceError(f"{label} is not executable")
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    chunks: list[bytes] = []
    try:
        opened = os.fstat(descriptor)
        before_identity = (
            before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
            before.st_size, before.st_mtime_ns, before.st_ctime_ns,
        )
        opened_identity = (
            opened.st_dev, opened.st_ino, opened.st_mode, opened.st_nlink,
            opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns,
        )
        if before_identity != opened_identity:
            raise AcceptanceError(f"{label} changed before read")
        digest = hashlib.sha256()
        byte_count = 0
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            byte_count += len(chunk)
            if capture:
                chunks.append(chunk)
        after_read = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    after_read_identity = (
        after_read.st_dev, after_read.st_ino, after_read.st_mode,
        after_read.st_nlink, after_read.st_size, after_read.st_mtime_ns,
        after_read.st_ctime_ns,
    )
    after_identity = (
        after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
        after.st_size, after.st_mtime_ns, after.st_ctime_ns,
    )
    if opened_identity != after_read_identity or \
       opened_identity != after_identity or byte_count != opened.st_size:
        raise AcceptanceError(f"{label} changed during read")
    observed_sha256 = digest.hexdigest()
    if not is_observed_sha256(expected_sha256) or \
       observed_sha256 != expected_sha256:
        raise AcceptanceError(f"{label} hash mismatch")
    return {
        "path": str(path), "sha256": observed_sha256, "bytes": byte_count,
        "identity": opened_identity,
        "raw": b"".join(chunks) if capture else None,
    }


def compiler_source_closure_cid(rows: list[dict[str, Any]]) -> str:
    return sha256_bytes(
        COMPILER_SOURCE_CLOSURE_DOMAIN + canonical_json_bytes(rows))


def load_compiler_source_manifest(path: Path, expected_sha256: str) \
        -> tuple[list[dict[str, Any]], str]:
    snapshot = exact_regular_snapshot(
        path, "compiler source manifest", expected_sha256, capture=True)
    raw = snapshot["raw"]
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError(
            "compiler source manifest is not canonical JSON") from exc
    if not isinstance(value, dict) or set(value) != COMPILER_SOURCE_MANIFEST_FIELDS or \
       raw != canonical_json_bytes(value) or \
       value.get("schema") != COMPILER_SOURCE_MANIFEST_SCHEMA or \
       not isinstance(value.get("sources"), list):
        raise AcceptanceError("compiler source manifest shape mismatch")
    rows = value["sources"]
    if len(rows) != len(COMPILER_SOURCE_CLOSURE):
        raise AcceptanceError("compiler source closure incomplete")
    names: list[str] = []
    for row in rows:
        if not isinstance(row, dict) or set(row) != COMPILER_SOURCE_ROW_FIELDS or \
           not isinstance(row.get("name"), str) or not row["name"] or \
           "/" in row["name"] or "\\" in row["name"] or \
           not isinstance(row.get("bytes"), int) or isinstance(row["bytes"], bool) or \
           row["bytes"] <= 0 or not is_observed_sha256(row.get("sha256")):
            raise AcceptanceError("compiler source manifest row invalid")
        names.append(row["name"])
    if tuple(names) != COMPILER_SOURCE_CLOSURE:
        raise AcceptanceError("compiler source closure order or membership drift")
    for row in rows:
        source_path = path.parent / row["name"]
        source_snapshot = exact_regular_snapshot(
            source_path.absolute(),
            f"compiler source {row['name']}", row["sha256"], capture=False)
        if source_snapshot["bytes"] != row["bytes"]:
            raise AcceptanceError(
                f"compiler source size mismatch: {row['name']}")
    return rows, compiler_source_closure_cid(rows)


def parse_exact_key_value(raw: bytes, label: str) -> dict[str, str]:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise AcceptanceError(f"{label} is not UTF-8") from exc
    fields: dict[str, str] = {}
    for line in text.splitlines():
        key, separator, field_value = line.partition("=")
        if not separator or not key or key in fields:
            raise AcceptanceError(f"{label} has malformed or duplicate fields")
        fields[key] = field_value
    return fields


def validate_hardcap_bundle(receipt_path: Path, input_manifest_path: Path,
                            validator_path: Path, label: str) -> None:
    if receipt_path.name != "receipt.kv" or \
       input_manifest_path.name != "input-manifest.json" or \
       receipt_path.parent != input_manifest_path.parent or \
       receipt_path.parent.name != "workload":
        raise AcceptanceError(f"{label} hardcap bundle paths mismatch")
    aggregate_dir = receipt_path.parent.parent / "aggregate-oom"
    completed = subprocess.run(
        [sys.executable, str(validator_path),
         "--evidence-dir", str(receipt_path.parent),
         "--aggregate-evidence-dir", str(aggregate_dir)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        timeout=120, check=False)
    if completed.returncode != 0 or \
       b"hard_gate_validation_status=passed_unique_current\n" not in \
           completed.stdout:
        raise AcceptanceError(f"{label} hardcap bundle validation failed")


def atomic_write(path: Path, raw: bytes) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, path)
    except BaseException:
        if temporary_path.exists():
            temporary_path.unlink()
        raise


def workspace_input_closure(label: str, evidence_root: Path) -> dict[str, Any]:
    listed = subprocess.run(
        ["git", "ls-files", "-co", "--exclude-standard", "-z", "--",
         *WORKSPACE_INPUT_PATHS],
        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    ).stdout
    try:
        relative_paths = sorted({
            item.decode("utf-8") for item in listed.split(b"\x00") if item
        })
    except UnicodeDecodeError as exc:
        raise AcceptanceError("workspace input path is not UTF-8") from exc
    if not relative_paths:
        raise AcceptanceError("workspace input closure is empty")
    input_paths = [(relative, ROOT / relative) for relative in relative_paths]
    compiler_raw = os.environ.get(
        "CHENG_SEMANTIC_SNAPSHOT_COMPILER", WORKSPACE_DEFAULT_GATE_COMPILER)
    compiler_path = Path(compiler_raw)
    if not compiler_path.is_absolute():
        compiler_path = ROOT / compiler_path
    compiler_path = compiler_path.absolute()
    try:
        compiler_label = str(compiler_path.relative_to(ROOT))
    except ValueError:
        compiler_label = str(compiler_path)
    if compiler_label not in {row[0] for row in input_paths}:
        input_paths.append((compiler_label, compiler_path))
        input_paths.sort(key=lambda row: row[0])
    rows: list[dict[str, Any]] = []
    for relative, path in input_paths:
        relative_path = Path(relative)
        if not relative_path.is_absolute() and ".." in relative_path.parts:
            raise AcceptanceError("workspace input path escapes repository")
        try:
            before = path.lstat()
        except FileNotFoundError:
            rows.append({
                "path": relative,
                "kind": "missing",
                "size": 0,
                "sha256": sha256_bytes(
                    b"cheng.semantic_snapshot.workspace_input_missing\x00" +
                    relative.encode("utf-8")),
            })
            continue
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            raise AcceptanceError(
                f"workspace input is not private regular data: {relative}")
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            opened = os.fstat(descriptor)
            if not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1 or \
               (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
                raise AcceptanceError(
                    f"workspace input identity changed before read: {relative}")
            digest = hashlib.sha256()
            byte_count = 0
            while True:
                chunk = os.read(descriptor, 1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)
                byte_count += len(chunk)
            after_read = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        after = path.lstat()
        identity_before = (
            before.st_dev, before.st_ino, before.st_mode, before.st_nlink,
            before.st_size, before.st_mtime_ns, before.st_ctime_ns,
        )
        identity_opened = (
            opened.st_dev, opened.st_ino, opened.st_mode, opened.st_nlink,
            opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns,
        )
        identity_after_read = (
            after_read.st_dev, after_read.st_ino, after_read.st_mode,
            after_read.st_nlink, after_read.st_size, after_read.st_mtime_ns,
            after_read.st_ctime_ns,
        )
        identity_after = (
            after.st_dev, after.st_ino, after.st_mode, after.st_nlink,
            after.st_size, after.st_mtime_ns, after.st_ctime_ns,
        )
        if identity_before != identity_opened or \
           identity_before != identity_after_read or \
           identity_before != identity_after or byte_count != before.st_size:
            raise AcceptanceError(
                f"workspace input changed during read: {relative}")
        rows.append({
            "path": relative,
            "kind": "regular",
            "device": str(before.st_dev),
            "inode": str(before.st_ino),
            "mode": stat.S_IMODE(before.st_mode),
            "link_count": before.st_nlink,
            "mtime_ns": str(before.st_mtime_ns),
            "ctime_ns": str(before.st_ctime_ns),
            "size": byte_count,
            "sha256": digest.hexdigest(),
        })
    closure_body = {
        "schema": "cheng.semantic_snapshot.workspace_input_closure",
        "roots": list(WORKSPACE_INPUT_PATHS),
        "component_gate_compiler": compiler_label,
        "files": rows,
    }
    closure_cid = sha256_bytes(canonical_json_bytes(closure_body))
    manifest_value = {
        **closure_body,
        "file_count": len(rows),
        "closure_cid": closure_cid,
    }
    manifest_path = evidence_root / f"workspace-inputs-{label}.json"
    manifest_raw = canonical_json_bytes(manifest_value)
    atomic_write(manifest_path, manifest_raw)
    return {
        "closure_cid": closure_cid,
        "file_count": len(rows),
        "manifest": {
            "path": str(manifest_path),
            "sha256": sha256_bytes(manifest_raw),
        },
    }


def is_sha256(value: Any) -> bool:
    if not isinstance(value, str) or len(value) != 64:
        return False
    return all(character in "0123456789abcdef" for character in value)


def is_observed_sha256(value: Any) -> bool:
    return is_sha256(value) and value not in ("0" * 64, EMPTY_SHA256)


def append_u32(raw: bytearray, value: int) -> None:
    if value < 0 or value > 0xffff_ffff:
        raise AcceptanceError("receipt u32 is outside canonical range")
    raw.extend(value.to_bytes(4, "big", signed=False))


def append_i32(raw: bytearray, value: int) -> None:
    if value < -0x8000_0000 or value > 0x7fff_ffff:
        raise AcceptanceError("receipt i32 is outside canonical range")
    append_u32(raw, 4)
    raw.extend((value & 0xffff_ffff).to_bytes(4, "big", signed=False))


def append_i64(raw: bytearray, value: int) -> None:
    if value < -0x8000_0000_0000_0000 or value > 0x7fff_ffff_ffff_ffff:
        raise AcceptanceError("receipt i64 is outside canonical range")
    append_u32(raw, 8)
    raw.extend((value & 0xffff_ffff_ffff_ffff).to_bytes(8, "big", signed=False))


def append_text(raw: bytearray, value: str) -> None:
    encoded = value.encode("utf-8")
    append_u32(raw, len(encoded))
    raw.extend(encoded)


def append_cid(raw: bytearray, value: Any, label: str) -> None:
    if not is_observed_sha256(value):
        raise AcceptanceError(f"{label}: unobserved CID")
    append_u32(raw, 32)
    raw.extend(bytes.fromhex(value))


def semantic_identity_cid(row: dict[str, Any], label: str) -> str:
    raw = bytearray()
    append_text(raw, SEMANTIC_IDENTITY_DOMAIN)
    for field in ("source_identity_receipt_cid", "world_head_cid", "compiler_cid",
                  "source_bundle_cid", "csg_root_cid"):
        append_cid(raw, row.get(field), f"{label}.{field}")
    return sha256_bytes(bytes(raw))


def semantic_binding_cid(row: dict[str, Any], label: str) -> str:
    documents = row.get("document_cids")
    client_versions = row.get("client_versions")
    open_states = row.get("document_open_states")
    if not isinstance(documents, list) or not isinstance(client_versions, list) or \
       not isinstance(open_states, list) or \
       len(documents) != len(client_versions) or len(documents) != len(open_states):
        raise AcceptanceError(f"{label}: binding document columns are not exact")
    raw = bytearray()
    append_text(raw, SEMANTIC_BINDING_DOMAIN)
    append_cid(raw, row.get("workspace_session_cid"), label + ".workspace_session_cid")
    append_i64(raw, row.get("source_version"))
    append_i32(raw, len(documents))
    seen: set[str] = set()
    for index, document_cid_value in enumerate(documents):
        if document_cid_value in seen:
            raise AcceptanceError(f"{label}: duplicate binding document CID")
        seen.add(document_cid_value)
        append_cid(raw, document_cid_value, f"{label}.document_cids[{index}]")
        client_version = client_versions[index]
        open_state = open_states[index]
        if not is_exact_int(client_version) or client_version < 0 or \
           not is_exact_int(open_state) or open_state not in (0, 1):
            raise AcceptanceError(f"{label}: invalid binding document state")
        append_i64(raw, client_version)
        append_i32(raw, open_state)
    for field in ("semantic_snapshot_cid", "world_head_cid", "compiler_cid",
                  "source_bundle_cid", "csg_root_cid"):
        append_cid(raw, row.get(field), f"{label}.{field}")
    return sha256_bytes(bytes(raw))


def semantic_validation_cid(row: dict[str, Any], label: str) -> str:
    raw = bytearray()
    append_text(raw, SEMANTIC_VALIDATION_DOMAIN)
    for field in ("binding_receipt_cid", "semantic_snapshot_cid",
                  "parser_root_cid", "type_root_cid", "ownership_root_cid",
                  "call_root_cid", "layout_root_cid", "dependency_root_cid",
                  "read_set_root_cid", "reachability_root_cid",
                  "canonical_root_cid", "lifecycle_root_cid"):
        append_cid(raw, row.get(field), f"{label}.{field}")
    return sha256_bytes(bytes(raw))


def canonical_receipt_cid(domain: str, fields: list[tuple[str, Any]]) -> str:
    body = {"domain": domain, **{key: value for key, value in fields}}
    return sha256_bytes(canonical_json_bytes(body))


def is_exact_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def exact_int_set(value: Any, label: str) -> set[int]:
    if not isinstance(value, list) or any(not is_exact_int(item) or item < 0 for item in value):
        raise AcceptanceError(f"{label}: invalid function ids")
    if len(value) != len(set(value)):
        raise AcceptanceError(f"{label}: duplicate function id")
    return set(value)


def source_manifest() -> tuple[list[dict[str, Any]], str, dict[str, str]]:
    rows: list[dict[str, Any]] = []
    texts: dict[str, str] = {}
    for relative in SOURCE_FILES:
        path = ROOT / relative
        if not path.is_file():
            raise AcceptanceError(f"source file missing: {relative}")
        raw = path.read_bytes()
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as exc:
            raise AcceptanceError(f"source is not UTF-8: {relative}") from exc
        texts[relative] = text
        rows.append({
            "path": relative,
            "bytes": len(raw),
            "lines": text.count("\n") + (0 if text.endswith("\n") else 1),
            "sha256": sha256_bytes(raw),
        })
    if len(rows) < MIN_SOURCE_FILES:
        raise AcceptanceError("representative source file count shrank")
    if sum(int(row["bytes"]) for row in rows) < MIN_SOURCE_BYTES:
        raise AcceptanceError("representative source byte count shrank")
    if sum(int(row["lines"]) for row in rows) < MIN_SOURCE_LINES:
        raise AcceptanceError("representative source line count shrank")
    return rows, sha256_bytes(canonical_json_bytes(rows)), texts


def compiler_identity_inventory() -> dict[str, Any]:
    source_rows: list[dict[str, Any]] = []
    for source_name in COMPILER_SOURCE_CLOSURE:
        path = ROOT / "bootstrap" / source_name
        if not path.is_file() or path.is_symlink():
            raise AcceptanceError(
                f"compiler source closure entry missing: {source_name}")
        metadata = path.stat()
        if not stat.S_ISREG(metadata.st_mode):
            raise AcceptanceError(
                f"compiler source closure entry is not regular: {source_name}")
        source_rows.append({
            "name": source_name,
            "bytes": metadata.st_size,
            "sha256": sha256_file(path),
        })
    source_closure_cid = compiler_source_closure_cid(source_rows)

    candidates: list[dict[str, Any]] = []
    for relative in COMPILER_CANDIDATE_PATHS:
        path = ROOT / relative
        if not path.is_file() or path.is_symlink() or not os.access(path, os.X_OK):
            continue
        metadata = path.stat()
        if not stat.S_ISREG(metadata.st_mode):
            continue
        candidates.append({
            "path": relative,
            "bytes": metadata.st_size,
            "sha256": sha256_file(path),
            "production_semantic_snapshot_capability": "unproved",
        })
    return {
        "schema": "cheng.semantic_snapshot.acceptance.compiler_identity_inventory",
        "compiler_source_closure_cid": source_closure_cid,
        "compiler_source_count": len(source_rows),
        "compiler_source_bytes": sum(row["bytes"] for row in source_rows),
        "compiler_sources": source_rows,
        "installed_candidate_count": len(candidates),
        "installed_candidates": candidates,
        "production_semantic_snapshot_producer": "MISSING",
    }


def workspace_package_identity() -> tuple[str, str]:
    manifest_path = ROOT / "cheng-package.toml"
    try:
        manifest = tomllib.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        raise AcceptanceError("workspace package manifest is unavailable") from exc
    if set(manifest) != {"package_id", "module_prefix"}:
        raise AcceptanceError("workspace package manifest shape changed")
    package_uri = manifest.get("package_id")
    module_prefix = manifest.get("module_prefix")
    if not isinstance(package_uri, str) or not package_uri.startswith("pkg://") or \
       package_uri.count("pkg://") != 1:
        raise AcceptanceError("workspace package id is not canonical")
    package_id = package_uri[len("pkg://"):]
    if not package_id or not isinstance(module_prefix, str) or \
       module_prefix != package_id or "/" in module_prefix:
        raise AcceptanceError("workspace module prefix is not canonical")
    return package_id, module_prefix


def source_module_path(relative: str, module_prefix: str) -> str:
    if not relative.startswith("src/") or not relative.endswith(".cheng") or \
       "//" in relative or "/./" in relative or "/../" in relative:
        raise AcceptanceError(f"acceptance source path is not canonical: {relative}")
    tail = relative[len("src/"):-len(".cheng")]
    if not tail:
        raise AcceptanceError("acceptance source module path is empty")
    return f"{module_prefix}/{tail}"


def document_cid(package_id: str, module_path: str) -> str:
    payload = bytearray()
    for text in (
            "cheng.compiler.document_identity", package_id, module_path):
        raw = text.encode("utf-8")
        payload.extend(struct.pack(">I", len(raw)))
        payload.extend(raw)
    return sha256_bytes(bytes(payload))


def byte_offset_position(text: str, byte_offset: int) -> dict[str, int]:
    raw = text.encode("utf-8")
    if byte_offset < 0 or byte_offset > len(raw):
        raise AcceptanceError("byte offset outside source")
    prefix = raw[:byte_offset].decode("utf-8")
    line = prefix.count("\n")
    line_text = prefix.rsplit("\n", 1)[-1]
    character = len(line_text.encode("utf-16-le")) // 2
    return {"line": line, "character": character}


def find_utf8_range(text: str, needle: str) -> tuple[dict[str, int], dict[str, int]]:
    raw = text.encode("utf-8")
    needle_raw = needle.encode("utf-8")
    start = raw.find(needle_raw)
    if start < 0 or raw.find(needle_raw, start + 1) >= 0:
        raise AcceptanceError(f"edit anchor is not unique: {needle!r}")
    return byte_offset_position(text, start), byte_offset_position(text, start + len(needle_raw))


def apply_unique(text: str, old: str, new: str) -> str:
    if text.count(old) != 1:
        raise AcceptanceError(f"edit anchor is not unique: {old!r}")
    return text.replace(old, new, 1)


def lsp_range_change(text: str, old: str, new: str) -> tuple[dict[str, Any], str]:
    start, end = find_utf8_range(text, old)
    change = {
        "range": {"start": start, "end": end},
        "rangeLength": len(old.encode("utf-16-le")) // 2,
        "text": new,
    }
    return change, apply_unique(text, old, new)


def deterministic_random_edit_schedule(
        seed: int, edit_count: int) -> list[tuple[str, str]]:
    if edit_count < MIN_RANDOM_EDITS:
        raise AcceptanceError("random edit count must be at least 30")
    body_sources = list(SOURCE_FILES[1:])
    body_edit_count = sum(
        edit_index % 3 != 0 for edit_index in range(edit_count))
    if body_edit_count < len(body_sources):
        raise AcceptanceError(
            "random edit trace cannot cover every non-interface source")
    schedule_rng = random.Random(seed)
    body_schedule: list[str] = []
    while len(body_schedule) < body_edit_count:
        cycle = list(body_sources)
        schedule_rng.shuffle(cycle)
        body_schedule.extend(cycle)
    next_body = 0
    schedule: list[tuple[str, str]] = []
    for edit_index in range(edit_count):
        if edit_index % 3 == 0:
            schedule.append((IDENTITY_SOURCE, "interface"))
        else:
            schedule.append((body_schedule[next_body], "body"))
            next_body += 1
    return schedule


def make_trace(seed: int, edit_count: int, texts: dict[str, str],
               manifest_sha256: str) -> dict[str, Any]:
    if edit_count < MIN_RANDOM_EDITS:
        raise AcceptanceError("random edit count must be at least 30")
    rng = random.Random(seed)
    workspace_root = ROOT.resolve().as_uri()
    workspace_path = str(ROOT.resolve())
    package_id, module_prefix = workspace_package_identity()
    documents: list[dict[str, Any]] = []
    events: list[dict[str, Any]] = []
    live_texts = dict(texts)
    client_versions = {relative: 0 for relative in SOURCE_FILES}

    for relative in SOURCE_FILES:
        source_path = str((ROOT / relative).resolve())
        uri = Path(source_path).as_uri()
        module_path = source_module_path(relative, module_prefix)
        cid = document_cid(package_id, module_path)
        documents.append({
            "path": relative,
            "uri": uri,
            "source_path": source_path,
            "module_path": module_path,
            "document_cid": cid,
            "entry": relative == CONSUMER_SOURCE,
        })
        client_versions[relative] = 1
        events.append({
            "kind": "didOpen",
            "path": relative,
            "uri": uri,
            "document_cid": cid,
            "client_version": 1,
            "text": live_texts[relative],
        })

    identity_source = IDENTITY_SOURCE
    consumer_source = CONSUMER_SOURCE
    if "import cheng/core/tooling/semantic_snapshot as snapshot_core" not in \
       live_texts[consumer_source]:
        raise AcceptanceError(
            "cross-module acceptance consumer lacks exact snapshot_core import")
    const_marker = "SnapshotAcceptanceEpoch: int32 = 700000001"
    identity_append = (
        "\n# Acceptance-only overlay declaration; never written to the workspace.\n"
        f"const {const_marker}\n"
    )
    consumer_marker = "snapshot_core.SnapshotAcceptanceEpoch + 1"
    consumer_append = (
        "\n# Acceptance-only overlay consumer; never written to the workspace.\n"
        "fn SnapshotAcceptanceReadEpoch(): int32 =\n"
        "    let ignored = \"SnapshotAcceptanceEpoch\"\n"
        "    # SnapshotAcceptanceEpoch\n"
        f"    return {consumer_marker}\n"
    )
    for relative, appended, category in (
        (identity_source, identity_append, "interface"),
        (consumer_source, consumer_append, "body"),
    ):
        old_text = live_texts[relative]
        eof = byte_offset_position(old_text, len(old_text.encode("utf-8")))
        client_versions[relative] += 1
        events.append({
            "kind": "didChange",
            "category": category,
            "path": relative,
            "uri": (ROOT / relative).resolve().as_uri(),
            "document_cid": document_cid(
                package_id, source_module_path(relative, module_prefix)),
            "client_version": client_versions[relative],
            "content_changes": [{
                "range": {"start": eof, "end": eof},
                "rangeLength": 0,
                "text": appended,
            }],
            "reusable_prefix_bytes": len(old_text.encode("utf-8")),
            "result_text_bytes": len((old_text + appended).encode("utf-8")),
        })
        live_texts[relative] = old_text + appended

    body_sources = list(SOURCE_FILES[1:])
    body_markers: dict[str, tuple[str, int]] = {}
    for body_source_index, relative in enumerate(body_sources):
        marker_name = f"snapshotAcceptanceBody{body_source_index}"
        marker_value = 710000001 + body_source_index
        appended = (
            "\n# Acceptance-only overlay body; never written to the workspace.\n"
            f"fn {marker_name}(): int32 =\n"
            f"    return {marker_value}\n"
        )
        old_text = live_texts[relative]
        eof = byte_offset_position(old_text, len(old_text.encode("utf-8")))
        client_versions[relative] += 1
        events.append({
            "kind": "didChange",
            "category": "body",
            "path": relative,
            "uri": (ROOT / relative).resolve().as_uri(),
            "document_cid": document_cid(
                package_id, source_module_path(relative, module_prefix)),
            "client_version": client_versions[relative],
            "content_changes": [{
                "range": {"start": eof, "end": eof},
                "rangeLength": 0,
                "text": appended,
            }],
            "reusable_prefix_bytes": len(old_text.encode("utf-8")),
            "result_text_bytes": len((old_text + appended).encode("utf-8")),
        })
        live_texts[relative] = old_text + appended
        body_markers[relative] = (marker_name, marker_value)

    edit_schedule = deterministic_random_edit_schedule(seed, edit_count)

    epoch = 700000001
    edit_events: list[int] = []
    random_edit_paths: list[str] = []
    for edit_index in range(edit_count):
        relative, category = edit_schedule[edit_index]
        if category == "interface":
            next_epoch = epoch
            while next_epoch == epoch:
                next_epoch = 700000002 + rng.randrange(0, 99_999_990)
            old = f"SnapshotAcceptanceEpoch: int32 = {epoch}"
            new = f"SnapshotAcceptanceEpoch: int32 = {next_epoch}"
            epoch = next_epoch
        else:
            marker_name, body_value = body_markers[relative]
            next_body = body_value
            while next_body == body_value:
                next_body = 1 + rng.randrange(0, 999_999)
            old = (f"fn {marker_name}(): int32 =\n"
                   f"    return {body_value}")
            new = (f"fn {marker_name}(): int32 =\n"
                   f"    return {next_body}")
            category = "body"
            body_markers[relative] = (marker_name, next_body)
        old_text = live_texts[relative]
        reusable_prefix_bytes = old_text.encode("utf-8").find(old.encode("utf-8"))
        if reusable_prefix_bytes < 0:
            raise AcceptanceError("random edit source hash prefix missing")
        change, next_text = lsp_range_change(old_text, old, new)
        client_versions[relative] += 1
        events.append({
            "kind": "didChange",
            "category": category,
            "random_edit_index": edit_index,
            "path": relative,
            "uri": (ROOT / relative).resolve().as_uri(),
            "document_cid": document_cid(
                package_id, source_module_path(relative, module_prefix)),
            "client_version": client_versions[relative],
            "content_changes": [change],
            "reusable_prefix_bytes": reusable_prefix_bytes,
            "result_text_bytes": len(next_text.encode("utf-8")),
        })
        live_texts[relative] = next_text
        edit_events.append(len(events) - 1)
        random_edit_paths.append(relative)

    if set(random_edit_paths) != set(SOURCE_FILES):
        raise AcceptanceError("random edit trace did not cover every source")

    use_needle = "SnapshotAcceptanceEpoch"
    use_raw = live_texts[consumer_source].encode("utf-8")
    qualified = b"snapshot_core.SnapshotAcceptanceEpoch"
    use_start = use_raw.rfind(qualified)
    if use_start < 0:
        raise AcceptanceError("acceptance use anchor missing")
    use_position = byte_offset_position(
        live_texts[consumer_source], use_start + len(b"snapshot_core."))
    declaration_raw = live_texts[identity_source].encode("utf-8")
    declaration_start = declaration_raw.rfind(use_needle.encode("utf-8"))
    declaration_position = byte_offset_position(live_texts[identity_source], declaration_start)
    completion_position = {"line": use_position["line"], "character": 4}

    close_sources = (SOURCE_FILES[-1], SOURCE_FILES[-2])
    for relative in close_sources:
        events.append({
            "kind": "didClose",
            "path": relative,
            "uri": (ROOT / relative).resolve().as_uri(),
            "document_cid": document_cid(
                package_id, source_module_path(relative, module_prefix)),
        })
    closed_set = set(close_sources)
    final_documents = [{
        "path": relative,
        "open": relative not in closed_set,
        "text_bytes": len(live_texts[relative].encode("utf-8"))
        if relative not in closed_set else 0,
        "line_start_count": live_texts[relative].count("\n") + 1
        if relative not in closed_set else 0,
    } for relative in SOURCE_FILES]

    trace = {
        "schema": "cheng.semantic_snapshot.acceptance.trace",
        "seed": seed,
        "random_edit_count": edit_count,
        "source_manifest_sha256": manifest_sha256,
        "workspace_root_uri": workspace_root,
        "workspace_identity": {
            "workspace_root": workspace_path,
            "package_root": workspace_path,
            "package_id": package_id,
            "module_prefix": module_prefix,
        },
        "documents": documents,
        "events": events,
        "random_edit_event_indexes": edit_events,
        "random_edit_paths": random_edit_paths,
        "random_edit_unique_path_count": len(set(random_edit_paths)),
        "queries": {
            "definition": {"path": consumer_source, "position": use_position},
            "references": {"path": identity_source, "position": declaration_position},
            "rename": {"path": identity_source, "position": declaration_position,
                       "new_name": "SnapshotAcceptanceEpochRenamed"},
            "hover": {"path": identity_source, "position": declaration_position},
            "completion": {"path": consumer_source, "position": completion_position},
            "diagnostics": [identity_source, consumer_source],
        },
        "closed_paths": list(close_sources),
        "final_documents": final_documents,
    }
    validate_random_edit_trace_contract(trace)
    return trace


def validate_random_edit_trace_contract(trace: dict[str, Any]) -> dict[str, int]:
    package_id, module_prefix = workspace_package_identity()
    workspace_path = str(ROOT.resolve())
    expected_workspace_identity = {
        "workspace_root": workspace_path,
        "package_root": workspace_path,
        "package_id": package_id,
        "module_prefix": module_prefix,
    }
    if trace.get("workspace_root_uri") != ROOT.resolve().as_uri() or \
       trace.get("workspace_identity") != expected_workspace_identity:
        raise AcceptanceError("random edit workspace identity contract invalid")
    documents = trace.get("documents")
    if not isinstance(documents, list) or len(documents) != len(SOURCE_FILES):
        raise AcceptanceError("random edit document identity count invalid")
    expected_documents: dict[str, dict[str, Any]] = {}
    for relative in SOURCE_FILES:
        source_path = str((ROOT / relative).resolve())
        module_path = source_module_path(relative, module_prefix)
        expected_documents[relative] = {
            "path": relative,
            "uri": Path(source_path).as_uri(),
            "source_path": source_path,
            "module_path": module_path,
            "document_cid": document_cid(package_id, module_path),
            "entry": relative == CONSUMER_SOURCE,
        }
    for index, document in enumerate(documents):
        relative = SOURCE_FILES[index]
        if document != expected_documents[relative]:
            raise AcceptanceError("random edit compiler document identity mismatch")
    if sum(bool(document["entry"]) for document in documents) != 1:
        raise AcceptanceError("random edit compiler entry identity mismatch")
    seed = trace.get("seed")
    edit_count = trace.get("random_edit_count")
    if not is_exact_int(seed) or not is_exact_int(edit_count):
        raise AcceptanceError("random edit seed/count contract invalid")
    expected_schedule = deterministic_random_edit_schedule(seed, edit_count)
    events = trace.get("events")
    event_indexes = trace.get("random_edit_event_indexes")
    if not isinstance(events, list) or not isinstance(event_indexes, list) or \
       len(event_indexes) != edit_count:
        raise AcceptanceError("random edit event index contract invalid")
    for event in events:
        if not isinstance(event, dict) or event.get("path") not in expected_documents:
            raise AcceptanceError("random edit event document path invalid")
        expected_document = expected_documents[event["path"]]
        if event.get("uri") != expected_document["uri"] or \
           event.get("document_cid") != expected_document["document_cid"]:
            raise AcceptanceError("random edit event document identity mismatch")
    rows: list[dict[str, Any]] = []
    for random_index, event_index in enumerate(event_indexes):
        if not is_exact_int(event_index) or event_index < 0 or \
           event_index >= len(events):
            raise AcceptanceError("random edit event index out of bounds")
        event = events[event_index]
        if not isinstance(event, dict) or \
           event.get("random_edit_index") != random_index:
            raise AcceptanceError("random edit event order contract invalid")
        expected_path, expected_category = expected_schedule[random_index]
        if event.get("path") != expected_path or \
           event.get("category") != expected_category or \
           event.get("kind") != "didChange":
            raise AcceptanceError("seeded random edit schedule mismatch")
        rows.append(event)
    indexed_rows = [
        event for event in events
        if isinstance(event, dict) and "random_edit_index" in event
    ]
    if len(indexed_rows) != edit_count or indexed_rows != rows:
        raise AcceptanceError("random edit event set contract invalid")
    paths = [row["path"] for row in rows]
    if trace.get("random_edit_paths") != paths or \
       trace.get("random_edit_unique_path_count") != len(set(paths)) or \
       set(paths) != set(SOURCE_FILES):
        raise AcceptanceError("random edit source coverage contract invalid")
    body_paths = {
        row["path"] for row in rows if row["category"] == "body"
    }
    interface_paths = {
        row["path"] for row in rows if row["category"] == "interface"
    }
    if body_paths != set(SOURCE_FILES[1:]) or \
       interface_paths != {IDENTITY_SOURCE}:
        raise AcceptanceError("body/interface edit coverage contract invalid")
    return {
        "body_edit_count": sum(row["category"] == "body" for row in rows),
        "interface_edit_count": sum(
            row["category"] == "interface" for row in rows),
        "random_edit_unique_path_count": len(set(paths)),
    }


def rpc(payload: dict[str, Any]) -> bytes:
    raw = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    return f"Content-Length: {len(raw)}\r\n\r\n".encode("ascii") + raw


def parse_frames(raw: bytes) -> list[dict[str, Any]]:
    frames: list[dict[str, Any]] = []
    cursor = 0
    while cursor < len(raw):
        header_end = raw.find(b"\r\n\r\n", cursor)
        if header_end < 0:
            raise AcceptanceError(f"truncated LSP header at byte {cursor}")
        length: int | None = None
        for line in raw[cursor:header_end].decode("ascii").split("\r\n"):
            key, separator, value = line.partition(":")
            if separator and key.lower() == "content-length":
                length = int(value.strip())
        if length is None:
            raise AcceptanceError("LSP frame has no Content-Length")
        body_start = header_end + 4
        body_end = body_start + length
        if body_end > len(raw):
            raise AcceptanceError("truncated LSP body")
        frames.append(json.loads(raw[body_start:body_end]))
        cursor = body_end
    return frames


def lsp_messages(trace: dict[str, Any], target_triple: str) \
        -> tuple[list[dict[str, Any]], dict[int, dict[str, Any]]]:
    if not target_triple or "\x00" in target_triple:
        raise AcceptanceError("LSP target triple is invalid")
    messages: list[dict[str, Any]] = [{
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"processId": None, "rootUri": trace["workspace_root_uri"],
                   "capabilities": {}},
    }, {"jsonrpc": "2.0", "method": "initialized", "params": {}}]
    workspace_identity = trace.get("workspace_identity")
    if not isinstance(workspace_identity, dict) or \
       set(workspace_identity) != {
           "workspace_root", "package_root", "package_id", "module_prefix"}:
        raise AcceptanceError("LSP workspace identity is invalid")
    for document in trace["documents"]:
        messages.append({
            "jsonrpc": "2.0", "method": "cheng/configureCompilerSource",
            "params": {
                "uri": document["uri"],
                "workspaceRoot": workspace_identity["workspace_root"],
                "packageRoot": workspace_identity["package_root"],
                "packageId": workspace_identity["package_id"],
                "targetTriple": target_triple,
                "sourcePath": document["source_path"],
                "modulePath": document["module_path"],
                "entry": document["entry"],
            },
        })
    uri_by_path = {document["path"]: document["uri"] for document in trace["documents"]}
    requested: dict[int, dict[str, Any]] = {}
    next_id = 100
    source_version = 0
    query_spec = trace["queries"]
    for event in trace["events"]:
        source_version += 1
        if event["kind"] == "didOpen":
            messages.append({
                "jsonrpc": "2.0", "method": "textDocument/didOpen",
                "params": {"textDocument": {
                    "uri": event["uri"], "languageId": "cheng",
                    "version": event["client_version"], "text": event["text"]}},
            })
        elif event["kind"] == "didChange":
            messages.append({
                "jsonrpc": "2.0", "method": "textDocument/didChange",
                "params": {"textDocument": {"uri": event["uri"],
                                                "version": event["client_version"]},
                           "contentChanges": event["content_changes"]},
            })
            if "random_edit_index" not in event:
                continue
            query_rows = (
                ("textDocument/definition", "definition", {}),
                ("textDocument/references", "references",
                 {"context": {"includeDeclaration": True}}),
                ("textDocument/hover", "hover", {}),
                ("textDocument/completion", "completion", {}),
            )
            for method, key, extra in query_rows:
                spec = query_spec[key]
                params: dict[str, Any] = {
                    "textDocument": {"uri": uri_by_path[spec["path"]]},
                    "position": spec["position"],
                }
                params.update(extra)
                messages.append({"jsonrpc": "2.0", "id": next_id,
                                 "method": method, "params": params})
                requested[next_id] = {"kind": key, "source_version": source_version}
                next_id += 1
            if int(event["random_edit_index"]) == len(trace["random_edit_event_indexes"]) // 2:
                spec = query_spec["rename"]
                messages.append({
                    "jsonrpc": "2.0", "id": next_id,
                    "method": "textDocument/rename",
                    "params": {"textDocument": {"uri": uri_by_path[spec["path"]]},
                               "position": spec["position"], "newName": spec["new_name"]},
                })
                requested[next_id] = {"kind": "rename", "source_version": source_version}
                next_id += 1
            for diagnostic_path in query_spec["diagnostics"]:
                messages.append({
                    "jsonrpc": "2.0", "id": next_id,
                    "method": "textDocument/diagnostic",
                    "params": {"textDocument": {"uri": uri_by_path[diagnostic_path]}},
                })
                requested[next_id] = {"kind": "diagnostics", "source_version": source_version}
                next_id += 1
        elif event["kind"] == "didClose":
            messages.append({
                "jsonrpc": "2.0", "method": "textDocument/didClose",
                "params": {"textDocument": {"uri": event["uri"]}},
            })
            spec = query_spec["definition"]
            messages.append({
                "jsonrpc": "2.0", "id": next_id,
                "method": "textDocument/definition",
                "params": {"textDocument": {"uri": uri_by_path[spec["path"]]},
                           "position": spec["position"]},
            })
            requested[next_id] = {"kind": "definition", "source_version": source_version}
            next_id += 1
        else:
            raise AcceptanceError(f"unknown trace event: {event['kind']}")
    messages.append({"jsonrpc": "2.0", "id": 8999,
                     "method": "cheng/snapshotMetrics", "params": {}})
    messages.append({"jsonrpc": "2.0", "id": 9000, "method": "shutdown", "params": {}})
    messages.append({"jsonrpc": "2.0", "method": "exit", "params": {}})
    return messages, requested


def exact_binding_fields(value: Any) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if isinstance(value, dict):
        required = ("chengSourceVersion", "chengSemanticSnapshotCid",
                    "chengBindingReceiptCid", "chengCsgRootCid",
                    "chengQueryProjectionCid", "chengQueryIndexCid",
                    "chengCompilerFactProjectionCid")
        if any(key in value for key in required):
            rows.append({key: value.get(key) for key in required})
        for child in value.values():
            rows.extend(exact_binding_fields(child))
    elif isinstance(value, list):
        for child in value:
            rows.extend(exact_binding_fields(child))
    return rows


def lsp_semantic_result_valid(kind: str, result: Any,
                              trace: dict[str, Any]) -> bool:
    uri_by_path = {document["path"]: document["uri"] for document in trace["documents"]}
    identity_uri = uri_by_path[IDENTITY_SOURCE]
    consumer_uri = uri_by_path[CONSUMER_SOURCE]
    if kind == "definition":
        return isinstance(result, dict) and result.get("uri") == identity_uri and \
            is_observed_sha256(result.get("chengDocumentCid")) and \
            is_exact_int(result.get("chengTargetSymbolId")) and \
            result["chengTargetSymbolId"] >= 0 and \
            is_observed_sha256(result.get("chengTargetSymbolCid"))
    if kind == "references":
        if not isinstance(result, list) or len(result) != 2:
            return False
        if any(not isinstance(item, dict) or
               not is_observed_sha256(item.get("chengDocumentCid")) or
               not is_exact_int(item.get("chengTargetSymbolId")) or
               item["chengTargetSymbolId"] < 0 or
               not is_observed_sha256(item.get("chengTargetSymbolCid"))
               for item in result):
            return False
        uris = sorted(item.get("uri") for item in result if isinstance(item, dict))
        identities = {
            (item.get("chengTargetSymbolId"), item.get("chengTargetSymbolCid"))
            for item in result
        }
        return uris == sorted((identity_uri, consumer_uri)) and \
            len(identities) == 1
    if kind == "rename":
        if not isinstance(result, dict) or \
           not is_exact_int(result.get("chengTargetSymbolId")) or \
           result["chengTargetSymbolId"] < 0 or \
           not is_observed_sha256(result.get("chengTargetSymbolCid")):
            return False
        changes = result.get("documentChanges")
        if not isinstance(changes, list) or len(changes) != 2:
            return False
        uris: list[str] = []
        edit_count = 0
        for change in changes:
            if not isinstance(change, dict) or not isinstance(change.get("textDocument"), dict):
                return False
            document = change["textDocument"]
            if not is_exact_int(document.get("version")) or \
               not is_observed_sha256(document.get("chengDocumentCid")):
                return False
            uris.append(document.get("uri"))
            edits = change.get("edits")
            if not isinstance(edits, list):
                return False
            edit_count += len(edits)
            if any(not isinstance(edit, dict) or
                   edit.get("newText") != "SnapshotAcceptanceEpochRenamed" or
                   edit.get("chengSymbolId") != result["chengTargetSymbolId"]
                   for edit in edits):
                return False
        return sorted(uris) == sorted((identity_uri, consumer_uri)) and edit_count == 2
    if kind == "hover":
        return isinstance(result, dict) and isinstance(result.get("contents"), dict) and \
            result["contents"].get("kind") == "plaintext" and \
            isinstance(result["contents"].get("value"), str) and \
            "SnapshotAcceptanceEpoch" in result["contents"]["value"] and \
            is_exact_int(result.get("chengSymbolId")) and \
            result["chengSymbolId"] >= 0 and \
            is_observed_sha256(result.get("chengSymbolCid")) and \
            is_observed_sha256(result.get("chengDocumentCid"))
    if kind == "completion":
        if not isinstance(result, dict) or result.get("isIncomplete") is not False:
            return False
        items = result.get("items")
        return isinstance(items, list) and any(
            isinstance(item, dict) and item.get("label") == "SnapshotAcceptanceEpoch" and
            isinstance(item.get("data"), dict) and
            is_exact_int(item["data"].get("symbolId")) and
            item["data"]["symbolId"] >= 0 and
            is_observed_sha256(item["data"].get("symbolCid")) and
            is_observed_sha256(item["data"].get("documentCid")) and
            is_exact_int(item["data"].get("compilerSymbolKind"))
            for item in items)
    if kind == "diagnostics":
        if not isinstance(result, dict) or result.get("kind") != "full" or \
           not is_observed_sha256(result.get("resultId")):
            return False
        items = result.get("items")
        if not isinstance(items, list):
            return False
        diagnostic_ids = [item.get("chengDiagnosticId") for item in items
                          if isinstance(item, dict)]
        return len(diagnostic_ids) == len(items) and \
            all(is_exact_int(diagnostic_id) and diagnostic_id >= 0
                for diagnostic_id in diagnostic_ids) and \
            len(set(diagnostic_ids)) == len(diagnostic_ids) and all(
                isinstance(item, dict) and
                is_exact_int(item.get("chengProducerKind")) and
                is_observed_sha256(item.get("chengDocumentCid")) for item in items)
    return False


def lsp_target_identity(kind: str, result: Any) -> tuple[int, str] | None:
    if kind == "definition" and isinstance(result, dict):
        symbol_id = result.get("chengTargetSymbolId")
        symbol_cid = result.get("chengTargetSymbolCid")
    elif kind == "references" and isinstance(result, list) and result:
        first = result[0] if isinstance(result[0], dict) else {}
        symbol_id = first.get("chengTargetSymbolId")
        symbol_cid = first.get("chengTargetSymbolCid")
    elif kind == "rename" and isinstance(result, dict):
        symbol_id = result.get("chengTargetSymbolId")
        symbol_cid = result.get("chengTargetSymbolCid")
    elif kind == "hover" and isinstance(result, dict):
        symbol_id = result.get("chengSymbolId")
        symbol_cid = result.get("chengSymbolCid")
    elif kind == "completion" and isinstance(result, dict):
        matching = [item for item in result.get("items", [])
                    if isinstance(item, dict) and
                    item.get("label") == "SnapshotAcceptanceEpoch" and
                    isinstance(item.get("data"), dict)]
        if len(matching) != 1:
            return None
        symbol_id = matching[0]["data"].get("symbolId")
        symbol_cid = matching[0]["data"].get("symbolCid")
    else:
        return None
    if not is_exact_int(symbol_id) or symbol_id < 0 or not is_observed_sha256(symbol_cid):
        return None
    return symbol_id, symbol_cid


def expected_lsp_source_hash_metrics(trace: dict[str, Any]) -> dict[str, int]:
    text_bytes: dict[str, int] = {}
    open_paths: set[str] = set()
    cache_hit_count = 0
    cache_cold_count = 0
    reused_block_count = 0
    compressed_block_count = 0
    for event in trace["events"]:
        path = event["path"]
        if event["kind"] == "didOpen":
            next_bytes = len(event["text"].encode("utf-8"))
            reused = 0
            cache_cold_count += 1
            open_paths.add(path)
            text_bytes[path] = next_bytes
        elif event["kind"] == "didChange":
            next_bytes = event["result_text_bytes"]
            reusable_prefix = event["reusable_prefix_bytes"]
            previous_bytes = text_bytes[path]
            reused = min(reusable_prefix // 64, previous_bytes // 64, next_bytes // 64)
            if reused > 0:
                cache_hit_count += 1
            else:
                cache_cold_count += 1
            text_bytes[path] = next_bytes
        elif event["kind"] == "didClose":
            open_paths.remove(path)
            text_bytes[path] = 0
            continue
        else:
            raise AcceptanceError("source hash metric trace event invalid")
        full_blocks = next_bytes // 64
        padding_blocks = 1 if next_bytes % 64 < 56 else 2
        reused_block_count += reused
        compressed_block_count += full_blocks - reused + padding_blocks
    return {
        "sourceHashCacheHitCount": cache_hit_count,
        "sourceHashCacheColdCount": cache_cold_count,
        "sourceHashReusedBlockCount": reused_block_count,
        "sourceHashCompressedBlockCount": compressed_block_count,
        "sourceHashCacheBytes": sum((text_bytes[path] // 64) * 128
                                    for path in open_paths),
    }


def validate_lsp_metrics(value: Any, trace: dict[str, Any], query_count: int,
                         message_count_at_metrics: int) -> str:
    if not isinstance(value, dict) or value.get("schema") != \
       "cheng.lsp.semantic_snapshot.metrics":
        return "metrics response schema mismatch"
    integer_fields = (
        "eventAttemptCount", "eventAcceptedCount", "eventRejectedCount",
        "didOpenAcceptedCount", "didChangeAcceptedCount", "didCloseAcceptedCount",
        "didOpenAttemptWallNs", "didChangeAttemptWallNs", "didCloseAttemptWallNs",
        "eventAttemptWallNs", "acceptedEventWallNs", "sourceEventAcceptanceWallNs",
        "sourceContentHashWallNs", "lineIndexBuildWallNs", "contentChangeApplyWallNs",
        "sourceHashCacheHitCount", "sourceHashCacheColdCount",
        "sourceHashReusedBlockCount", "sourceHashCompressedBlockCount",
        "messageReadCount", "messageReadWallNs", "jsonParseWallNs", "dispatchWallNs",
        "candidateAttemptCount",
        "candidatePublishedCount", "candidateRejectedCount",
        "candidateAdmissionPublishWallNs", "queryAttemptCount", "queryWallNs",
        "definitionQueryCount", "definitionQueryWallNs", "referencesQueryCount",
        "referencesQueryWallNs", "renameQueryCount", "renameQueryWallNs",
        "hoverQueryCount", "hoverQueryWallNs", "completionQueryCount",
        "completionQueryWallNs", "diagnosticsQueryCount", "diagnosticsQueryWallNs",
        "currentSourceVersion", "publishedSourceVersion", "openDocumentCount",
        "livePayloadCount", "releasedPayloadCount", "overlaySourceBytes",
        "overlayLineIndexBytes", "sourceHashCacheBytes", "payloadCsgcBytes",
        "inputBufferBytes", "accountedRetainedBytes",
        "explicitSourceFileReadCount",
        "explicitSourceFileReadBytes", "parserBuildWallNs", "compilerCsgBuildWallNs",
    )
    if any(not is_exact_int(value.get(field)) or value[field] < 0
           for field in integer_fields):
        return "metrics integer field invalid"
    expected_events = len(trace["events"])
    expected_open = sum(event["kind"] == "didOpen" for event in trace["events"])
    expected_change = sum(event["kind"] == "didChange" for event in trace["events"])
    expected_close = sum(event["kind"] == "didClose" for event in trace["events"])
    if value["eventAttemptCount"] != expected_events or \
       value["eventAcceptedCount"] != expected_events or \
       value["eventRejectedCount"] != 0:
        return "source event counters differ from trace"
    if (value["didOpenAcceptedCount"], value["didChangeAcceptedCount"],
            value["didCloseAcceptedCount"]) != \
       (expected_open, expected_change, expected_close):
        return "didOpen/didChange/didClose counters differ from trace"
    if value["currentSourceVersion"] != expected_events or \
       value["openDocumentCount"] != expected_open - expected_close:
        return "workspace source version or open-document count drift"
    expected_overlay_bytes = sum(row["text_bytes"] for row in trace["final_documents"])
    expected_line_index_bytes = sum(
        row["line_start_count"] * 4 for row in trace["final_documents"])
    if value["overlaySourceBytes"] != expected_overlay_bytes or \
       value["overlayLineIndexBytes"] != expected_line_index_bytes:
        return "overlay byte accounting differs from exact trace"
    if value["queryAttemptCount"] != query_count:
        return "semantic query counter differs from requests"
    if value["messageReadCount"] != message_count_at_metrics:
        return "message read counter differs from framed trace"
    expected_query_counts = {
        "definitionQueryCount": trace["random_edit_count"] + len(trace["closed_paths"]),
        "referencesQueryCount": trace["random_edit_count"],
        "renameQueryCount": 1,
        "hoverQueryCount": trace["random_edit_count"],
        "completionQueryCount": trace["random_edit_count"],
        "diagnosticsQueryCount": trace["random_edit_count"] *
        len(trace["queries"]["diagnostics"]),
    }
    if any(value[field] != expected for field, expected in expected_query_counts.items()) or \
       sum(value[field] for field in expected_query_counts) != query_count:
        return "per-method semantic query counters differ from requests"
    if value["candidateAttemptCount"] != \
       value["candidatePublishedCount"] + value["candidateRejectedCount"]:
        return "candidate counters are unbalanced"
    if value["candidatePublishedCount"] == 0 and value["publishedSourceVersion"] != 0:
        return "published sourceVersion exists without a candidate publication"
    if value["accountedRetainedBytes"] != \
       value["overlaySourceBytes"] + value["overlayLineIndexBytes"] + \
       value["sourceHashCacheBytes"] + value["inputBufferBytes"] + \
       value["payloadCsgcBytes"]:
        return "retained-byte accounting is unbalanced"
    if value["inputBufferBytes"] != 65_536:
        return "LSP input buffer capacity differs from the exact implementation"
    expected_hash_metrics = expected_lsp_source_hash_metrics(trace)
    if any(value[field] != expected for field, expected in expected_hash_metrics.items()):
        return "source hash cache work differs from exact trace"
    if value["eventAttemptWallNs"] != value["didOpenAttemptWallNs"] + \
       value["didChangeAttemptWallNs"] + value["didCloseAttemptWallNs"]:
        return "per-method source event wall times are unbalanced"
    if value["queryWallNs"] != sum(value[field] for field in (
            "definitionQueryWallNs", "referencesQueryWallNs", "renameQueryWallNs",
            "hoverQueryWallNs", "completionQueryWallNs", "diagnosticsQueryWallNs")):
        return "per-method semantic query wall times are unbalanced"
    if value["dispatchWallNs"] < value["eventAttemptWallNs"] + value["queryWallNs"]:
        return "dispatch wall time is smaller than measured handlers"
    if value["acceptedEventWallNs"] > value["eventAttemptWallNs"]:
        return "accepted event wall time exceeds attempted event wall time"
    if sum(value[field] for field in (
            "sourceEventAcceptanceWallNs", "sourceContentHashWallNs",
            "lineIndexBuildWallNs", "contentChangeApplyWallNs")) > \
       value["acceptedEventWallNs"]:
        return "source event phase wall times exceed accepted event wall time"
    if value["explicitSourceFileReadCount"] == 0 and \
       value["explicitSourceFileReadBytes"] != 0:
        return "source read byte count exists without a read operation"
    if not isinstance(value.get("parserBuildObserved"), bool) or \
       not isinstance(value.get("compilerCsgBuildObserved"), bool):
        return "producer observation flags invalid"
    if not value["parserBuildObserved"] and value["parserBuildWallNs"] != 0:
        return "parser wall time exists without an observed build"
    if not value["compilerCsgBuildObserved"] and value["compilerCsgBuildWallNs"] != 0:
        return "CompilerCSG wall time exists without an observed build"
    return ""


def validate_lsp_build_evidence_files(identity: dict[str, Any],
                                      expected_lsp: Path) -> dict[str, Any]:
    evidence = identity.get("build_evidence")
    if not isinstance(evidence, dict) or set(evidence) != LSP_BUILD_EVIDENCE_FIELDS or \
       evidence.get("schema") != "cheng.semantic_snapshot.lsp_build_evidence":
        raise AcceptanceError("LSP build evidence shape mismatch")
    path_fields = (
        "lsp_executable_path", "lsp_build_report_path", "lsp_build_guard_path",
        "lsp_build_input_manifest_path",
        "compiler_executable_path", "compiler_build_report_path",
        "compiler_build_guard_path",
        "compiler_build_input_manifest_path",
        "compiler_source_manifest_path", "hardcap_validator_path",
        "build_exporter_path", "build_tool_manifest_path",
    )
    paths: dict[str, Path] = {}
    for field in path_fields:
        raw_path = evidence.get(field)
        if not isinstance(raw_path, str) or not raw_path or "\x00" in raw_path:
            raise AcceptanceError(f"LSP build evidence path invalid: {field}")
        evidence_path = Path(raw_path)
        if not evidence_path.is_absolute():
            raise AcceptanceError(f"LSP build evidence path is relative: {field}")
        paths[field] = evidence_path
    hash_fields = (
        "lsp_executable_sha256", "lsp_build_report_sha256",
        "lsp_build_guard_sha256", "lsp_build_input_manifest_sha256",
        "compiler_executable_sha256", "compiler_build_report_sha256",
        "compiler_build_guard_sha256",
        "compiler_build_input_manifest_sha256",
        "compiler_source_manifest_sha256",
        "compiler_source_closure_cid",
        "hardcap_validator_sha256", "build_exporter_sha256",
        "build_tool_manifest_sha256", "compiler_command_argv_cid",
        "compiler_build_argv_cid",
    )
    for field in hash_fields:
        if not is_observed_sha256(evidence.get(field)):
            raise AcceptanceError(f"LSP build evidence hash invalid: {field}")
    for field in ("lsp_build_argv", "compiler_build_argv"):
        argv = evidence.get(field)
        if not isinstance(argv, list) or not argv or \
           any(not isinstance(argument, str) or not argument or "\x00" in argument
               for argument in argv):
            raise AcceptanceError(f"LSP build evidence argv invalid: {field}")
    lsp_build_argv = evidence["lsp_build_argv"]
    compiler_build_argv = evidence["compiler_build_argv"]
    if framed_argv_cid(lsp_build_argv) != evidence["compiler_command_argv_cid"] or \
       framed_argv_cid(compiler_build_argv) != evidence["compiler_build_argv_cid"]:
        raise AcceptanceError("LSP build evidence argv CID mismatch")
    expected_lsp_absolute = expected_lsp.absolute()
    if paths["lsp_executable_path"] != expected_lsp_absolute:
        raise AcceptanceError("LSP build evidence names a different executable")
    if paths["hardcap_validator_path"] != OFFICIAL_HARDCAP_VALIDATOR:
        raise AcceptanceError("LSP build evidence validator is not authoritative")

    lsp_snapshot = exact_regular_snapshot(
        paths["lsp_executable_path"], "LSP executable",
        evidence["lsp_executable_sha256"], executable=True)
    compiler_snapshot = exact_regular_snapshot(
        paths["compiler_executable_path"], "LSP compiler executable",
        evidence["compiler_executable_sha256"], executable=True)
    report_snapshot = exact_regular_snapshot(
        paths["lsp_build_report_path"], "LSP build report",
        evidence["lsp_build_report_sha256"], capture=True)
    lsp_guard_snapshot = exact_regular_snapshot(
        paths["lsp_build_guard_path"], "LSP build guard",
        evidence["lsp_build_guard_sha256"], capture=True)
    compiler_guard_snapshot = exact_regular_snapshot(
        paths["compiler_build_guard_path"], "compiler build guard",
        evidence["compiler_build_guard_sha256"], capture=True)
    compiler_report_snapshot = exact_regular_snapshot(
        paths["compiler_build_report_path"], "compiler build report",
        evidence["compiler_build_report_sha256"], capture=True)
    lsp_input_manifest_snapshot = exact_regular_snapshot(
        paths["lsp_build_input_manifest_path"], "LSP build input manifest",
        evidence["lsp_build_input_manifest_sha256"], capture=True)
    compiler_input_manifest_snapshot = exact_regular_snapshot(
        paths["compiler_build_input_manifest_path"],
        "compiler build input manifest",
        evidence["compiler_build_input_manifest_sha256"], capture=True)
    validator_snapshot = exact_regular_snapshot(
        paths["hardcap_validator_path"], "hardcap receipt validator",
        evidence["hardcap_validator_sha256"], executable=True)
    exporter_snapshot = exact_regular_snapshot(
        paths["build_exporter_path"], "build exporter",
        evidence["build_exporter_sha256"], executable=True, capture=True)
    tool_manifest_snapshot = exact_regular_snapshot(
        paths["build_tool_manifest_path"], "build tool manifest",
        evidence["build_tool_manifest_sha256"], capture=True)
    source_rows, source_closure_cid = load_compiler_source_manifest(
        paths["compiler_source_manifest_path"],
        evidence["compiler_source_manifest_sha256"])
    if source_closure_cid != evidence["compiler_source_closure_cid"] or \
       source_closure_cid != identity["compiler_source_closure_cid"]:
        raise AcceptanceError("compiler source closure identity mismatch")
    try:
        tool_manifest = json.loads(tool_manifest_snapshot["raw"].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError("build tool manifest is not canonical JSON") from exc
    expected_tool_rows = [
        {"name": "semantic-snapshot-build-exporter",
         "bytes": exporter_snapshot["bytes"],
         "sha256": exporter_snapshot["sha256"]},
        {"name": "hardcap-receipt-validator",
         "bytes": validator_snapshot["bytes"],
         "sha256": validator_snapshot["sha256"]},
    ]
    if not isinstance(tool_manifest, dict) or \
       set(tool_manifest) != {"schema", "tools"} or \
       tool_manifest.get("schema") != \
           "cheng.semantic_snapshot.build_tool_closure" or \
       tool_manifest.get("tools") != expected_tool_rows or \
       tool_manifest_snapshot["raw"] != canonical_json_bytes(tool_manifest):
        raise AcceptanceError("build tool manifest identity mismatch")
    for argv in (lsp_build_argv, compiler_build_argv):
        if argv[0] != "/cheng-tools/semantic-snapshot-build-exporter" or \
           f"--exporter-sha256:{exporter_snapshot['sha256']}" not in argv or \
           f"--tool-manifest-sha256:{tool_manifest_snapshot['sha256']}" \
               not in argv:
            raise AcceptanceError("build exporter argv identity mismatch")
    lsp_guard_fields = parse_exact_key_value(
        lsp_guard_snapshot["raw"], "LSP build guard")
    compiler_guard_fields = parse_exact_key_value(
        compiler_guard_snapshot["raw"], "compiler build guard")
    try:
        compiler_report = json.loads(
            compiler_report_snapshot["raw"].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError("compiler build report is not canonical JSON") from exc
    expected_compiler_report = {
        "schema": "cheng.semantic_snapshot.compiler_build",
        "status": "completed",
        "compiler_executable_sha256": compiler_snapshot["sha256"],
        "compiler_source_manifest_sha256":
            evidence["compiler_source_manifest_sha256"],
        "compiler_source_closure_cid": source_closure_cid,
        "compiler_toolchain_cid":
            compiler_guard_fields.get("rootfs_tree_cid"),
    }
    if compiler_report != expected_compiler_report or \
       compiler_report_snapshot["raw"] != canonical_json_bytes(compiler_report):
        raise AcceptanceError("compiler build report identity mismatch")

    report_fields = parse_exact_key_value(
        report_snapshot["raw"], "LSP build report")
    if report_fields.get("full_backend_codegen") != "1" or \
       report_fields.get("system_link_exec") != "1" or \
       report_fields.get("real_backend_codegen") != "1" or \
       report_fields.get("emit") != "exe":
        raise AcceptanceError("LSP build report lacks exact full backend proof")
    if report_fields.get("target") != identity["compiler_target_triple"]:
        raise AcceptanceError("LSP build target identity mismatch")
    report_output = report_fields.get("output", "")
    report_source = report_fields.get("source", "")
    if not report_output or \
       not report_source or \
       f"--out:{report_output}" not in lsp_build_argv or \
       f"--in:{report_source}" not in lsp_build_argv or \
       "--emit:exe" not in lsp_build_argv:
        raise AcceptanceError("LSP build report output identity mismatch")

    input_manifest_fields = {
        "schema", "mode", "delegationManifestSha256",
        "cgroupParentPathFshex", "crunSha256", "rootfsManifestSha256",
        "rootfsTreeCid", "ociConfigSha256", "targetArgvCount",
        "targetArgvSha256", "memoryMax", "memorySwapMax", "pidsMax",
    }
    for label, snapshot, argv, guard_fields, bound_report in (
            ("LSP build", lsp_input_manifest_snapshot, lsp_build_argv,
             lsp_guard_fields, report_snapshot),
            ("compiler build", compiler_input_manifest_snapshot,
             compiler_build_argv, compiler_guard_fields,
             compiler_report_snapshot)):
        raw = snapshot["raw"]
        try:
            input_manifest = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise AcceptanceError(
                f"{label} input manifest is not canonical JSON") from exc
        if not isinstance(input_manifest, dict) or \
           set(input_manifest) != input_manifest_fields or \
           raw != canonical_json_bytes(input_manifest) or \
           input_manifest.get("schema") != \
               "cheng.native_linux_delegated_cgroup_v2_inputs" or \
           input_manifest.get("mode") != "workload" or \
           input_manifest.get("targetArgvCount") != len(argv) or \
           input_manifest.get("targetArgvSha256") != framed_argv_cid(argv) or \
           input_manifest.get("memoryMax") != MEMORY_LIMIT_BYTES or \
           input_manifest.get("memorySwapMax") != 0 or \
           input_manifest.get("pidsMax") != 128:
            raise AcceptanceError(f"{label} input manifest identity mismatch")
        required_guard = {
            "tool": "tools/beat_c_linux_cgroup_v2_hard_memory_gate.sh",
            "schema": "beat_c_linux_cgroup_v2_hard_memory_gate",
            "status": "completed",
            "applicability": "native_linux_delegated_cgroup_v2_only",
            "driver_role": "production",
            "hard_memory_limit_proof_status":
                "proved_linux_kernel_cgroup_v2_aggregate",
            "memory_enforcement_scope":
                "rootless_oci_process_and_all_descendants",
            "mode": "workload", "memory_limit_bytes": str(MEMORY_LIMIT_BYTES),
            "memory_swap_max_bytes": "0", "pids_max": "128",
            "execution_result": "exited_zero",
            "cgroup_mount_type": "cgroup2",
            "target_argv_count": str(len(argv)),
            "target_argv_sha256": framed_argv_cid(argv),
            "delegation_manifest_sha256":
                str(input_manifest["delegationManifestSha256"]),
            "delegation_parent_path_fshex":
                str(input_manifest["cgroupParentPathFshex"]),
            "crun_sha256": str(input_manifest["crunSha256"]),
            "rootfs_manifest_sha256":
                str(input_manifest["rootfsManifestSha256"]),
            "rootfs_tree_cid": str(input_manifest["rootfsTreeCid"]),
            "oci_config_sha256": str(input_manifest["ociConfigSha256"]),
            "stdout_sha256": lsp_snapshot["sha256"] if label == "LSP build"
                else compiler_snapshot["sha256"],
            "stdout_size": str(lsp_snapshot["bytes"] if label == "LSP build"
                else compiler_snapshot["bytes"]),
        }
        required_guard["stderr_sha256"] = bound_report["sha256"]
        required_guard["stderr_size"] = str(bound_report["bytes"])
        for field, expected in required_guard.items():
            if guard_fields.get(field) != expected:
                raise AcceptanceError(f"{label} guard invalid field: {field}")
        manifest_payload_sha256 = sha256_bytes(
            canonical_json_bytes(input_manifest))
        if guard_fields.get("input_manifest_sha256") != \
           manifest_payload_sha256:
            raise AcceptanceError(f"{label} guard input manifest mismatch")
    if f"--compiler-executable-sha256:{compiler_snapshot['sha256']}" not in \
           lsp_build_argv:
        raise AcceptanceError("LSP build argv compiler identity mismatch")
    if f"--compiler-source-manifest-sha256:{evidence['compiler_source_manifest_sha256']}" \
           not in compiler_build_argv or \
       f"--compiler-source-closure-cid:{source_closure_cid}" not in \
           compiler_build_argv:
        raise AcceptanceError("compiler build argv source closure identity mismatch")
    if identity["compiler_driver_cid"] != compiler_snapshot["sha256"] or \
       identity["compiler_toolchain_cid"] != \
           compiler_guard_fields.get("rootfs_tree_cid") or \
       identity["compiler_materializer_cid"] != \
           lsp_guard_fields.get("rootfs_tree_cid") or \
       identity["compiler_command_cid"] != evidence["compiler_command_argv_cid"]:
        raise AcceptanceError("semantic compiler identity is not build-bound")
    return {
        "status": "STRUCTURAL",
        "lsp_executable_sha256": lsp_snapshot["sha256"],
        "lsp_build_report_sha256": report_snapshot["sha256"],
        "lsp_build_guard_sha256": lsp_guard_snapshot["sha256"],
        "compiler_executable_sha256": compiler_snapshot["sha256"],
        "compiler_build_report_sha256": compiler_report_snapshot["sha256"],
        "compiler_build_guard_sha256": compiler_guard_snapshot["sha256"],
        "compiler_source_manifest_sha256":
            evidence["compiler_source_manifest_sha256"],
        "compiler_source_closure_cid": source_closure_cid,
        "compiler_source_count": len(source_rows),
        "compiler_toolchain_cid": identity["compiler_toolchain_cid"],
        "compiler_command_argv_cid": evidence["compiler_command_argv_cid"],
        "compiler_build_argv_cid": evidence["compiler_build_argv_cid"],
        "build_exporter_sha256": exporter_snapshot["sha256"],
        "build_tool_manifest_sha256": tool_manifest_snapshot["sha256"],
        **{field: str(value) for field, value in paths.items()},
    }


def validate_lsp_build_evidence(identity: dict[str, Any],
                                expected_lsp: Path) -> dict[str, Any]:
    evidence = validate_lsp_build_evidence_files(identity, expected_lsp)
    validate_hardcap_bundle(
        Path(evidence["lsp_build_guard_path"]),
        Path(evidence["lsp_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "LSP build")
    validate_hardcap_bundle(
        Path(evidence["compiler_build_guard_path"]),
        Path(evidence["compiler_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "compiler build")
    after = validate_lsp_build_evidence_files(identity, expected_lsp)
    if after != evidence:
        raise AcceptanceError("LSP build evidence changed during validation")
    evidence["status"] = "GREEN"
    return evidence


def load_lsp_compiler_identity_files(path: Path,
                                     expected_lsp: Path | None = None) \
        -> tuple[dict[str, Any], str, dict[str, Any]]:
    snapshot = exact_regular_snapshot(
        path.absolute(), "LSP compiler identity",
        sha256_file(path.absolute()), capture=True)
    raw = snapshot["raw"]
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AcceptanceError("LSP compiler identity is not canonical JSON") from exc
    if not isinstance(value, dict) or set(value) != LSP_COMPILER_IDENTITY_FIELDS or \
       raw != canonical_json_bytes(value) or \
       value.get("schema") != "cheng.semantic_snapshot.lsp_compiler_identity":
        raise AcceptanceError("LSP compiler identity manifest shape mismatch")
    for field in ("compiler_case_id", "compiler_world_channel",
                  "compiler_target_triple"):
        if not isinstance(value[field], str) or not value[field] or \
           "\x00" in value[field]:
            raise AcceptanceError(f"LSP compiler identity text invalid: {field}")
    for field in LSP_COMPILER_IDENTITY_CID_FIELDS:
        if not is_observed_sha256(value[field]):
            raise AcceptanceError(f"LSP compiler identity CID invalid: {field}")
    proof = value["compiler_migration_proof_cid"]
    if not isinstance(proof, str) or not is_sha256(proof) or \
       (proof != "0" * 64 and not is_observed_sha256(proof)):
        raise AcceptanceError(
            "LSP compiler identity CID invalid: compiler_migration_proof_cid")
    if expected_lsp is None:
        evidence_path = value.get("build_evidence", {}).get("lsp_executable_path")
        if not isinstance(evidence_path, str) or not evidence_path:
            raise AcceptanceError("LSP build evidence executable path missing")
        expected_lsp = Path(evidence_path)
    build_evidence = validate_lsp_build_evidence_files(value, expected_lsp)
    return value, sha256_bytes(raw), build_evidence


def load_lsp_compiler_identity(path: Path, expected_lsp: Path | None = None) \
        -> tuple[dict[str, Any], str, dict[str, Any]]:
    value, identity_sha256, evidence = load_lsp_compiler_identity_files(
        path, expected_lsp)
    validate_hardcap_bundle(
        Path(evidence["lsp_build_guard_path"]),
        Path(evidence["lsp_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "LSP build")
    validate_hardcap_bundle(
        Path(evidence["compiler_build_guard_path"]),
        Path(evidence["compiler_build_input_manifest_path"]),
        Path(evidence["hardcap_validator_path"]), "compiler build")
    after_value, after_identity_sha256, after_evidence = \
        load_lsp_compiler_identity_files(path, expected_lsp)
    if after_value != value or after_identity_sha256 != identity_sha256 or \
       after_evidence != evidence:
        raise AcceptanceError("LSP compiler identity changed during validation")
    evidence["status"] = "GREEN"
    return value, identity_sha256, evidence


def run_lsp(executable: Path, compiler_identity_path: Path,
            compiler_identity: dict[str, Any], compiler_identity_sha256: str,
            trace: dict[str, Any], evidence_parent: Path) -> dict[str, Any]:
    target_triple = compiler_identity.get("compiler_target_triple")
    if not isinstance(target_triple, str):
        raise AcceptanceError("LSP compiler target triple is missing")
    messages, requested = lsp_messages(trace, target_triple)
    payload = b"".join(rpc(message) for message in messages)
    evidence_root = evidence_parent / "lsp-stdio"
    evidence_root.mkdir(mode=0o700)
    payload_path = evidence_root / "payload.bin"
    with payload_path.open("xb") as stream:
        stream.write(payload)
    payload_sha256 = sha256_file(payload_path)
    executable_sha256 = sha256_file(executable)
    guard_path = evidence_root / "guard.txt"
    stdout_path = evidence_root / "stdout.bin"
    stderr_path = evidence_root / "stderr.txt"
    started = time.perf_counter_ns()
    completed = run_captured_process_group(
        [str(GUARD), f"--rss-limit:{MEMORY_LIMIT_BYTES}", "--timeout:300",
         f"--report-out:{guard_path}", f"--stdout:{stdout_path}",
         f"--stderr:{stderr_path}", "--", str(LSP_FEEDER),
         str(payload_path), payload_sha256, str(executable), executable_sha256,
         str(compiler_identity_path), compiler_identity_sha256],
        cwd=ROOT,
        timeout_seconds=330,
    )
    elapsed_ns = time.perf_counter_ns() - started
    raw_stdout = stdout_path.read_bytes() if stdout_path.is_file() else b""
    raw_stderr = stderr_path.read_bytes() if stderr_path.is_file() else completed.stderr
    guard_valid = False
    guard_error = ""
    guard_peak_bytes = 0
    if guard_path.is_file():
        try:
            guard_fields: dict[str, str] = {}
            for line in guard_path.read_text(encoding="utf-8", errors="strict").splitlines():
                key, separator, value = line.partition("=")
                if separator:
                    guard_fields[key] = value
            raw_peak = guard_fields.get("process_tree_enforced_peak_bytes", "")
            if not raw_peak.isdigit():
                raise AcceptanceError("lsp guard peak missing")
            guard_peak_bytes = int(raw_peak)
            parse_guard_evidence(guard_path, "lsp stdio", guard_peak_bytes)
            guard_valid = True
        except (AcceptanceError, UnicodeDecodeError) as exc:
            guard_error = str(exc)
    else:
        guard_error = "lsp guard report missing"
    response_by_id: dict[int, dict[str, Any]] = {}
    parse_error = ""
    try:
        for frame in parse_frames(raw_stdout):
            if is_exact_int(frame.get("id")):
                response_id = int(frame["id"])
                if response_id in response_by_id:
                    raise AcceptanceError(f"duplicate LSP response id: {response_id}")
                response_by_id[response_id] = frame
    except (AcceptanceError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        parse_error = str(exc)
    missing = [request_id for request_id in requested if request_id not in response_by_id]
    metrics_frame = response_by_id.get(8999)
    metrics = metrics_frame.get("result") if isinstance(metrics_frame, dict) and \
        "error" not in metrics_frame else None
    metrics_error = validate_lsp_metrics(
        metrics, trace, len(requested), len(messages) - 2)
    control_valid = all(
        isinstance(response_by_id.get(response_id), dict) and
        "error" not in response_by_id[response_id]
        for response_id in (1, 8999, 9000))
    error_codes: dict[str, int] = {}
    exact_rows: list[dict[str, Any]] = []
    successful = 0
    semantic_failures: list[int] = []
    binding_failures: list[int] = []
    binding_identity_by_version: dict[int, tuple[Any, ...]] = {}
    target_identity_by_version: dict[int, tuple[int, str]] = {}
    for request_id, request_spec in requested.items():
        frame = response_by_id.get(request_id)
        if frame is None:
            continue
        if "error" in frame:
            code = str(frame["error"].get("code"))
            error_codes[code] = error_codes.get(code, 0) + 1
            continue
        successful += 1
        if not lsp_semantic_result_valid(request_spec["kind"], frame.get("result"), trace):
            semantic_failures.append(request_id)
        target_identity = lsp_target_identity(request_spec["kind"], frame.get("result"))
        if request_spec["kind"] != "diagnostics":
            if target_identity is None:
                semantic_failures.append(request_id)
            elif request_spec["source_version"] in target_identity_by_version and \
                 target_identity_by_version[request_spec["source_version"]] != target_identity:
                semantic_failures.append(request_id)
            else:
                target_identity_by_version[request_spec["source_version"]] = target_identity
        response_rows = exact_binding_fields(frame)
        if not response_rows:
            binding_failures.append(request_id)
        response_identity: tuple[Any, ...] | None = None
        for row in response_rows:
            identity = tuple(row[key] for key in (
                "chengSourceVersion", "chengSemanticSnapshotCid",
                "chengBindingReceiptCid", "chengCsgRootCid",
                "chengQueryProjectionCid", "chengQueryIndexCid",
                "chengCompilerFactProjectionCid"))
            if row["chengSourceVersion"] != request_spec["source_version"]:
                binding_failures.append(request_id)
            if response_identity is None:
                response_identity = identity
            elif identity != response_identity:
                binding_failures.append(request_id)
            exact_rows.append(row)
        if response_identity is not None:
            source_version = request_spec["source_version"]
            if source_version in binding_identity_by_version and \
               binding_identity_by_version[source_version] != response_identity:
                binding_failures.append(request_id)
            else:
                binding_identity_by_version[source_version] = response_identity
    binding_valid = bool(exact_rows) and not binding_failures
    for row in exact_rows:
        if not is_exact_int(row["chengSourceVersion"]) or \
           row["chengSourceVersion"] <= 0:
            binding_valid = False
        for key in ("chengSemanticSnapshotCid", "chengBindingReceiptCid",
                    "chengCsgRootCid", "chengQueryProjectionCid",
                    "chengQueryIndexCid", "chengCompilerFactProjectionCid"):
            if not is_observed_sha256(row[key]):
                binding_valid = False
    return {
        "status": "GREEN" if completed.returncode == 0 and guard_valid and control_valid
                  and not parse_error and not missing
                  and not metrics_error
                  and successful == len(requested) and binding_valid and not semantic_failures
                  else "RED",
        "executable_path": str(executable),
        "executable_sha256": executable_sha256,
        "feeder_path": str(LSP_FEEDER),
        "feeder_sha256": sha256_file(LSP_FEEDER),
        "compiler_identity_path": str(compiler_identity_path),
        "compiler_identity_sha256": compiler_identity_sha256,
        "compiler_identity": compiler_identity,
        "payload_path": str(payload_path),
        "payload_sha256": payload_sha256,
        "payload_bytes": len(payload),
        "return_code": completed.returncode,
        "elapsed_ns": elapsed_ns,
        "process_tree_peak_bytes": guard_peak_bytes,
        "memory_limit_bytes": MEMORY_LIMIT_BYTES,
        "guard_valid": guard_valid,
        "guard_error": guard_error,
        "guard_path": str(guard_path),
        "guard_sha256": sha256_file(guard_path) if guard_path.is_file() else "",
        "requested_query_count": len(requested),
        "metrics": metrics,
        "metrics_valid": not metrics_error,
        "metrics_error": metrics_error,
        "control_responses_valid": control_valid,
        "independent_file_read_measurement_status": "MISSING",
        "comparative_wall_baseline_status": "MISSING",
        "successful_query_count": successful,
        "missing_response_ids": missing,
        "semantic_failure_ids": sorted(set(semantic_failures)),
        "binding_failure_ids": sorted(set(binding_failures)),
        "error_code_counts": error_codes,
        "exact_binding_row_count": len(exact_rows),
        "exact_binding_valid": binding_valid,
        "version_binding_identity_count": len(binding_identity_by_version),
        "version_symbol_identity_count": len(target_identity_by_version),
        "stdout_path": str(stdout_path),
        "stderr_path": str(stderr_path),
        "stdout_sha256": sha256_bytes(raw_stdout),
        "stderr_sha256": sha256_bytes(raw_stderr),
        "stderr_excerpt": raw_stderr.decode("utf-8", errors="replace")[-4000:],
        "parse_error": parse_error,
    }


def component_gate_result(relative: str, path_sha256: str, return_code: int,
                          elapsed_ns: int, stdout: bytes, stderr: bytes,
                          stdout_path: Path, stderr_path: Path) \
        -> tuple[dict[str, Any], bool]:
    row: dict[str, Any] = {
        "path": relative,
        "sha256": path_sha256,
        "status": "GREEN" if return_code == 0 else "RED",
        "return_code": return_code,
        "elapsed_ns": elapsed_ns,
        "stdout_sha256": sha256_bytes(stdout),
        "stderr_sha256": sha256_bytes(stderr),
        "stdout_path": str(stdout_path),
        "stderr_path": str(stderr_path),
    }
    evidence: dict[str, str] = {}
    evidence_error = ""
    try:
        for line in stdout.decode("utf-8").splitlines():
            key, separator, value = line.partition("=")
            if not separator:
                continue
            if key in evidence:
                raise AcceptanceError(f"duplicate component evidence field: {key}")
            evidence[key] = value
        if return_code == 0 and not any(
                key.endswith("_gate_status") and value == "pass"
                for key, value in evidence.items()):
            raise AcceptanceError("component gate pass marker missing")
        for key, value in evidence.items():
            if key.endswith("_sha256") and not is_sha256(value):
                raise AcceptanceError(f"invalid component evidence hash: {key}")
    except (AcceptanceError, UnicodeDecodeError) as exc:
        evidence_error = str(exc)
    row["evidence"] = evidence
    if evidence_error:
        row["status"] = "RED"
        row["evidence_error"] = evidence_error
    failed = return_code != 0 or bool(evidence_error)
    if failed:
        row["stderr_excerpt"] = stderr.decode(
            "utf-8", errors="replace")[-4000:]
    return row, failed


def run_captured_process_group(argv: list[str], cwd: Path,
                               timeout_seconds: float) \
        -> subprocess.CompletedProcess[bytes]:
    process = subprocess.Popen(
        argv,
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout_seconds)
    except subprocess.TimeoutExpired as exc:
        descendant_pids: list[int] = []
        process_table: subprocess.CompletedProcess[str] | None = None
        try:
            process_table = subprocess.run(
                ["/bin/ps", "-axo", "pid=,ppid="],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            process_table = None
        if process_table is not None and process_table.returncode == 0:
            children: dict[int, list[int]] = {}
            for line in process_table.stdout.splitlines():
                fields = line.split()
                if len(fields) != 2 or \
                   not fields[0].isdigit() or not fields[1].isdigit():
                    continue
                child_pid = int(fields[0])
                parent_pid = int(fields[1])
                children.setdefault(parent_pid, []).append(child_pid)
            pending = list(children.get(process.pid, ()))
            seen: set[int] = set()
            while pending:
                child_pid = pending.pop()
                if child_pid in seen:
                    continue
                seen.add(child_pid)
                descendant_pids.append(child_pid)
                pending.extend(children.get(child_pid, ()))
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        for child_pid in reversed(descendant_pids):
            try:
                os.kill(child_pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        stdout, stderr = process.communicate()
        raise subprocess.TimeoutExpired(
            exc.cmd, exc.timeout, output=stdout, stderr=stderr) from exc
    return subprocess.CompletedProcess(
        argv, process.returncode, stdout, stderr)


def require_workspace_input_closure(expected: dict[str, Any], label: str,
                                    evidence_root: Path) -> dict[str, Any]:
    observed = workspace_input_closure(label, evidence_root)
    if observed["closure_cid"] != expected["closure_cid"] or \
       observed["file_count"] != expected["file_count"]:
        raise AcceptanceError(
            "workspace input closure changed at component boundary: "
            f"{label}")
    return observed


def run_component_gates(work: Path, mode: str,
                        expected_workspace_inputs: dict[str, Any],
                        timeout_seconds: float = 900) \
        -> tuple[list[dict[str, Any]], list[str]]:
    rows: list[dict[str, Any]] = []
    gaps: list[str] = []
    require_workspace_input_closure(
        expected_workspace_inputs, "component-gates-start", work)
    for gate_index, relative in enumerate(COMPONENT_GATES):
        path = ROOT / relative
        if not path.is_file() or not os.access(path, os.X_OK):
            rows.append({"path": relative, "status": "MISSING"})
            gaps.append(f"component_gate_missing:{relative}")
            continue
        path_sha256 = sha256_file(path)
        row: dict[str, Any] = {"path": relative, "sha256": path_sha256}
        if mode == "static":
            row["status"] = "MISSING"
            gaps.append(f"component_gate_not_run:{relative}")
            rows.append(row)
            continue
        require_workspace_input_closure(
            expected_workspace_inputs,
            f"component-gate-{gate_index:02d}-start", work)
        stdout_path = work / (path.stem + ".stdout.txt")
        stderr_path = work / (path.stem + ".stderr.txt")
        started = time.perf_counter_ns()
        completed = run_captured_process_group(
            ["/bin/bash", str(path)], cwd=ROOT,
            timeout_seconds=timeout_seconds,
        )
        elapsed_ns = time.perf_counter_ns() - started
        stdout_path.write_bytes(completed.stdout)
        stderr_path.write_bytes(completed.stderr)
        row, failed = component_gate_result(
            relative, path_sha256, completed.returncode, elapsed_ns,
            completed.stdout, completed.stderr, stdout_path, stderr_path)
        if failed:
            gaps.append(f"component_gate_failed:{relative}")
        rows.append(row)
        require_workspace_input_closure(
            expected_workspace_inputs,
            f"component-gate-{gate_index:02d}-end", work)
    return rows, gaps


def safe_artifact(root: Path, value: Any, label: str) -> tuple[Path, str]:
    if not isinstance(value, dict):
        raise AcceptanceError(f"{label}: artifact row missing")
    raw_path = value.get("path")
    expected = value.get("sha256")
    if not isinstance(raw_path, str) or not is_sha256(expected):
        raise AcceptanceError(f"{label}: artifact identity invalid")
    root_input = root.absolute()
    root = root.resolve()
    raw = Path(raw_path)
    if raw.is_absolute():
        relative: Path | None = None
        for anchor in (root_input, root):
            try:
                relative = raw.absolute().relative_to(anchor)
                break
            except ValueError:
                continue
        if relative is None:
            raise AcceptanceError(f"{label}: artifact is outside runner output")
    else:
        relative = raw
    if ".." in relative.parts:
        raise AcceptanceError(f"{label}: artifact path contains parent traversal")
    path = (root / relative).absolute()
    current = path
    while current != root:
        if current.is_symlink():
            raise AcceptanceError(f"{label}: artifact path contains symlink")
        parent = current.parent
        if parent == current:
            raise AcceptanceError(f"{label}: artifact is outside runner output")
        current = parent
    path = path.resolve()
    try:
        path.relative_to(root.resolve())
    except ValueError as exc:
        raise AcceptanceError(f"{label}: artifact escapes runner output") from exc
    artifact_stat = path.stat()
    if not stat.S_ISREG(artifact_stat.st_mode) or artifact_stat.st_nlink != 1:
        raise AcceptanceError(f"{label}: artifact is not a regular file")
    actual = sha256_file(path)
    if actual != expected:
        raise AcceptanceError(f"{label}: artifact hash mismatch")
    return path, actual


def validate_coverage_matrix(value: Any, required_cases: tuple[str, ...],
                             domain: str, output_root: Path,
                             event_by_version: dict[int, dict[str, Any]],
                             compiler_sha256: str, trace_sha256: str,
                             manifest_sha256: str,
                             artifact_paths: set[Path]) -> list[dict[str, Any]]:
    if not isinstance(value, list) or len(value) != len(required_cases):
        raise AcceptanceError(f"{domain}: coverage rows missing")
    by_case = {row.get("case"): row for row in value if isinstance(row, dict)}
    if set(by_case) != set(required_cases) or len(by_case) != len(required_cases):
        raise AcceptanceError(f"{domain}: coverage identities are not exact")
    validated: list[dict[str, Any]] = []
    for case in required_cases:
        row = by_case[case]
        source_version = row.get("source_version")
        event = event_by_version.get(source_version)
        if row.get("status") != "proved" or event is None or \
           row.get("producer_sha256") != compiler_sha256 or \
           row.get("binding_receipt_cid") != event["binding_receipt_cid"] or \
           row.get("semantic_snapshot_cid") != event["semantic_snapshot_cid"] or \
           row.get("csg_root_cid") != event["csg_root_cid"]:
            raise AcceptanceError(f"{domain}.{case}: production binding missing")
        evidence_path, evidence_sha256 = safe_artifact(
            output_root, row.get("evidence"), f"{domain}.{case}.evidence")
        if evidence_path in artifact_paths:
            raise AcceptanceError(f"{domain}.{case}: evidence reused")
        artifact_paths.add(evidence_path)
        evidence_raw = evidence_path.read_bytes()
        try:
            evidence = json.loads(evidence_raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise AcceptanceError(f"{domain}.{case}: evidence is not JSON") from exc
        required_fields = {
            "schema", "domain", "case", "result", "source_version",
            "binding_receipt_cid", "semantic_snapshot_cid", "csg_root_cid",
            "compiler_sha256", "trace_sha256", "source_manifest_sha256",
            "assertion_count", "production_fact_row_count", "witness_kind",
            "coverage_receipt_cid",
        }
        if not isinstance(evidence, dict) or set(evidence) != required_fields or \
           evidence_raw != canonical_json_bytes(evidence) or \
           evidence.get("schema") != "cheng.semantic_snapshot.acceptance.coverage_evidence" or \
           evidence.get("domain") != domain or evidence.get("case") != case or \
           evidence.get("result") != "pass" or \
           evidence.get("source_version") != source_version or \
           evidence.get("binding_receipt_cid") != row["binding_receipt_cid"] or \
           evidence.get("semantic_snapshot_cid") != row["semantic_snapshot_cid"] or \
           evidence.get("csg_root_cid") != row["csg_root_cid"] or \
           evidence.get("compiler_sha256") != compiler_sha256 or \
           evidence.get("trace_sha256") != trace_sha256 or \
           evidence.get("source_manifest_sha256") != manifest_sha256 or \
           not is_exact_int(evidence.get("assertion_count")) or \
           evidence["assertion_count"] <= 0 or \
           not is_exact_int(evidence.get("production_fact_row_count")) or \
           evidence["production_fact_row_count"] <= 0 or \
           evidence.get("witness_kind") != f"{domain}.{case}":
            raise AcceptanceError(f"{domain}.{case}: evidence contract invalid")
        receipt_fields = [(key, evidence[key]) for key in sorted(
            required_fields - {"coverage_receipt_cid"})]
        expected_receipt = canonical_receipt_cid(COVERAGE_RECEIPT_DOMAIN,
                                                 receipt_fields)
        if evidence.get("coverage_receipt_cid") != expected_receipt:
            raise AcceptanceError(f"{domain}.{case}: evidence receipt mismatch")
        validated.append({
            "case": case,
            "source_version": source_version,
            "evidence_sha256": evidence_sha256,
            "coverage_receipt_cid": expected_receipt,
        })
    return validated


def validate_bound_artifact(output_root: Path, descriptor: Any, label: str,
                            kind: str, source_version: int,
                            event: dict[str, Any], producer_kind: str,
                            artifact_paths: set[Path]) -> tuple[Path, str]:
    required = {
        "path", "sha256", "kind", "source_version", "binding_receipt_cid",
        "semantic_snapshot_cid", "csg_root_cid", "source_bundle_cid",
        "compiler_cid", "target", "producer_kind", "artifact_receipt_cid",
    }
    if not isinstance(descriptor, dict) or set(descriptor) != required:
        raise AcceptanceError(f"{label}: bound artifact descriptor incomplete")
    if descriptor.get("kind") != kind or \
       descriptor.get("source_version") != source_version or \
       descriptor.get("binding_receipt_cid") != event["binding_receipt_cid"] or \
       descriptor.get("semantic_snapshot_cid") != event["semantic_snapshot_cid"] or \
       descriptor.get("csg_root_cid") != event["csg_root_cid"] or \
       descriptor.get("source_bundle_cid") != event["source_bundle_cid"] or \
       descriptor.get("compiler_cid") != event["compiler_cid"] or \
       descriptor.get("target") != "arm64-apple-darwin" or \
       descriptor.get("producer_kind") != producer_kind:
        raise AcceptanceError(f"{label}: artifact snapshot binding drift")
    receipt_fields = [(key, descriptor[key]) for key in sorted(
        required - {"path", "artifact_receipt_cid"})]
    expected_receipt = canonical_receipt_cid(ARTIFACT_RECEIPT_DOMAIN,
                                             receipt_fields)
    if descriptor.get("artifact_receipt_cid") != expected_receipt:
        raise AcceptanceError(f"{label}: artifact receipt mismatch")
    path, actual_sha256 = safe_artifact(output_root, descriptor, label)
    if path in artifact_paths:
        raise AcceptanceError(f"{label}: artifact path reused")
    artifact_paths.add(path)
    return path, actual_sha256


def validate_macho_arm64_object(path: Path, label: str) -> None:
    raw = path.read_bytes()
    if len(raw) < 32 or raw[:4] != b"\xcf\xfa\xed\xfe":
        raise AcceptanceError(f"{label}: object is not Mach-O 64-bit")
    cpu_type = int.from_bytes(raw[4:8], "little", signed=True)
    file_type = int.from_bytes(raw[12:16], "little", signed=False)
    if cpu_type != 0x0100000c or file_type != 1:
        raise AcceptanceError(f"{label}: object machine or file type mismatch")


def validate_report_envelope(value: Any, run_nonce: str) -> None:
    if not isinstance(value, dict) or \
       value.get("schema") != "cheng.semantic_snapshot.acceptance" or \
       value.get("run_nonce") != run_nonce:
        raise AcceptanceError("acceptance report envelope identity mismatch")
    status = value.get("status")
    if status not in ("GREEN", "RED", "MISSING") or \
       value.get("strict_gate_passed") is not (status == "GREEN"):
        raise AcceptanceError("acceptance report status is inconsistent")


def run_integrity_attacks(evidence_parent: Path, trace_raw: bytes,
                          trace_sha256: str, run_nonce: str) -> dict[str, Any]:
    root = evidence_parent / "integrity-attacks"
    root.mkdir(mode=0o700)
    rows: list[dict[str, Any]] = []

    def write_attack_input(kind: str, artifact: dict[str, str]) -> Path:
        path = root / (kind + ".input.json")
        raw = canonical_json_bytes({
            "schema": "cheng.semantic_snapshot.integrity_attack_input",
            "kind": kind,
            "artifact": artifact,
        })
        with path.open("xb") as stream:
            stream.write(raw)
        return path

    def validate_attack_input(path: Path, label: str) -> tuple[Path, str]:
        value = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(value, dict) or \
           value.get("schema") != "cheng.semantic_snapshot.integrity_attack_input" or \
           not isinstance(value.get("artifact"), dict):
            raise AcceptanceError(f"{label}: attack input envelope invalid")
        return safe_artifact(root, value["artifact"], label)

    def expect_rejection(kind: str, operation: Any, mutation_sha256: str,
                         mutation_path: Path | None = None) -> None:
        reason = ""
        try:
            operation()
        except AcceptanceError as exc:
            reason = str(exc)
        if not reason:
            raise AcceptanceError(f"integrity attack escaped: {kind}")
        rows.append({"kind": kind, "status": "GREEN", "result": "hard_fail",
                     "mutation_path": str(mutation_path) if mutation_path else "",
                     "mutation_sha256": mutation_sha256, "reason": reason})

    content_path = root / "trace-control.json"
    with content_path.open("xb") as stream:
        stream.write(trace_raw)
    content_sha256 = sha256_file(content_path)
    if content_sha256 != trace_sha256:
        raise AcceptanceError("integrity control trace identity drift")
    control_path, control_sha256 = safe_artifact(
        root, {"path": str(content_path), "sha256": content_sha256},
        "integrity.control")
    if control_path != content_path.resolve() or control_sha256 != content_sha256:
        raise AcceptanceError("integrity control artifact identity drift")
    content_input = write_attack_input(
        "artifact_content_hash",
        {"path": str(content_path), "sha256": "0" * 64})
    expect_rejection(
        "artifact_content_hash",
        lambda: validate_attack_input(content_input, "integrity.content"),
        sha256_file(content_input), content_input)

    symlink_path = root / "content-link.bin"
    os.symlink(content_path.name, symlink_path)
    symlink_input = write_attack_input(
        "artifact_symlink",
        {"path": str(symlink_path), "sha256": content_sha256})
    expect_rejection(
        "artifact_symlink",
        lambda: validate_attack_input(symlink_input, "integrity.symlink"),
        sha256_file(symlink_input), symlink_input)

    hardlink_source = root / "hardlink-source.bin"
    with hardlink_source.open("xb") as stream:
        stream.write(trace_raw)
    hardlink_path = root / "hardlink-alias.bin"
    os.link(hardlink_source, hardlink_path)
    hardlink_sha256 = sha256_file(hardlink_source)
    hardlink_input = write_attack_input(
        "artifact_hardlink",
        {"path": str(hardlink_path), "sha256": hardlink_sha256})
    expect_rejection(
        "artifact_hardlink",
        lambda: validate_attack_input(hardlink_input, "integrity.hardlink"),
        sha256_file(hardlink_input), hardlink_input)

    external_path = evidence_parent / "integrity-trace-external.json"
    with external_path.open("xb") as stream:
        stream.write(trace_raw)
    escape_input = write_attack_input(
        "artifact_path_escape",
        {"path": str(external_path), "sha256": trace_sha256})
    expect_rejection(
        "artifact_path_escape",
        lambda: validate_attack_input(escape_input, "integrity.escape"),
        sha256_file(escape_input), escape_input)

    trailing_path = root / "trace-trailing.bin"
    with trailing_path.open("xb") as stream:
        stream.write(trace_raw + b"\x00")
    trailing_input = write_attack_input(
        "trace_trailing_bytes",
        {"path": str(trailing_path), "sha256": trace_sha256})
    expect_rejection(
        "trace_trailing_bytes",
        lambda: validate_attack_input(trailing_input, "integrity.trailing"),
        sha256_file(trailing_input), trailing_input)

    valid_envelope = {
        "schema": "cheng.semantic_snapshot.acceptance",
        "run_nonce": run_nonce,
        "status": "RED",
        "strict_gate_passed": False,
    }
    invalid_schema = dict(valid_envelope)
    invalid_schema["schema"] = "cheng.semantic_snapshot.acceptance.invalid"
    invalid_schema_path = root / "report-schema.json"
    invalid_schema_raw = canonical_json_bytes(invalid_schema)
    with invalid_schema_path.open("xb") as stream:
        stream.write(invalid_schema_raw)
    expect_rejection(
        "report_schema_identity",
        lambda: validate_report_envelope(
            json.loads(invalid_schema_path.read_text(encoding="utf-8")), run_nonce),
        sha256_bytes(invalid_schema_raw), invalid_schema_path)
    invalid_nonce = dict(valid_envelope)
    invalid_nonce["run_nonce"] = run_nonce + "-invalid"
    invalid_nonce_path = root / "report-run-nonce.json"
    invalid_nonce_raw = canonical_json_bytes(invalid_nonce)
    with invalid_nonce_path.open("xb") as stream:
        stream.write(invalid_nonce_raw)
    expect_rejection(
        "report_run_nonce",
        lambda: validate_report_envelope(
            json.loads(invalid_nonce_path.read_text(encoding="utf-8")), run_nonce),
        sha256_bytes(invalid_nonce_raw), invalid_nonce_path)
    invalid_status = dict(valid_envelope)
    invalid_status["strict_gate_passed"] = True
    invalid_status_path = root / "report-status.json"
    invalid_status_raw = canonical_json_bytes(invalid_status)
    with invalid_status_path.open("xb") as stream:
        stream.write(invalid_status_raw)
    expect_rejection(
        "report_status_consistency",
        lambda: validate_report_envelope(
            json.loads(invalid_status_path.read_text(encoding="utf-8")), run_nonce),
        sha256_bytes(invalid_status_raw), invalid_status_path)
    return {"status": "GREEN",
            "scope": "acceptance_harness_evidence_integrity_only",
            "production_snapshot_tamper_coverage": "MISSING",
            "control_status": "GREEN",
            "control_path": str(control_path), "control_sha256": control_sha256,
            "evidence_root": str(root),
            "attack_count": len(rows), "attacks": rows}


def parse_orc(path: Path, label: str, event: dict[str, Any],
              source_version: int, producer_kind: str) -> dict[str, Any]:
    raw = path.read_bytes()
    value = json.loads(raw.decode("utf-8"))
    required_fields = {
        "schema", "source_version", "binding_receipt_cid",
        "semantic_snapshot_cid", "csg_root_cid", "compiler_cid",
        "producer_kind", "retain_count", "release_count", "alloc_count",
        "free_count", "live_count", "scenario_counts", "ledger_receipt_cid",
    }
    if not isinstance(value, dict) or set(value) != required_fields or \
       raw != canonical_json_bytes(value) or \
       value.get("schema") != "cheng.semantic_snapshot.orc_ledger":
        raise AcceptanceError(f"{label}: ORC ledger schema mismatch")
    if value.get("source_version") != source_version or \
       value.get("binding_receipt_cid") != event["binding_receipt_cid"] or \
       value.get("semantic_snapshot_cid") != event["semantic_snapshot_cid"] or \
       value.get("csg_root_cid") != event["csg_root_cid"] or \
       value.get("compiler_cid") != event["compiler_cid"] or \
       value.get("producer_kind") != producer_kind:
        raise AcceptanceError(f"{label}: ORC snapshot binding mismatch")
    required = ("retain_count", "release_count", "alloc_count", "free_count", "live_count")
    out: dict[str, int] = {}
    for key in required:
        count = value.get(key)
        if not is_exact_int(count) or count < 0:
            raise AcceptanceError(f"{label}: ORC {key} invalid")
        out[key] = count
    if out["retain_count"] != out["release_count"]:
        raise AcceptanceError(f"{label}: ORC retain/release imbalance")
    if out["alloc_count"] != out["free_count"] or out["live_count"] != 0:
        raise AcceptanceError(f"{label}: ORC alloc/free/live imbalance")
    if out["retain_count"] <= 0 or out["alloc_count"] <= 0:
        raise AcceptanceError(f"{label}: ORC workload did not exercise managed ownership")
    scenarios = value.get("scenario_counts")
    if not isinstance(scenarios, dict) or set(scenarios) != set(REQUIRED_ORC_SCENARIOS) or \
       any(not is_exact_int(scenarios[name]) or scenarios[name] <= 0
           for name in REQUIRED_ORC_SCENARIOS):
        raise AcceptanceError(f"{label}: ORC scenario coverage incomplete")
    receipt_fields = [(key, value[key]) for key in sorted(
        required_fields - {"ledger_receipt_cid"})]
    expected_receipt = canonical_receipt_cid(ORC_RECEIPT_DOMAIN, receipt_fields)
    if value.get("ledger_receipt_cid") != expected_receipt:
        raise AcceptanceError(f"{label}: ORC ledger receipt mismatch")
    return {**out, "scenario_counts": scenarios,
            "ledger_receipt_cid": expected_receipt}


def percentile(values: list[int], fraction: float) -> int:
    ordered = sorted(values)
    index = min(len(ordered) - 1,
                max(0, int((len(ordered) - 1) * fraction + 0.999999)))
    return ordered[index]


def parse_guard_evidence(path: Path, label: str,
                         reported_rss: int,
                         require_hard_limit_proof: bool = True) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8", errors="strict").splitlines():
        key, separator, value = line.partition("=")
        if not separator:
            raise AcceptanceError(f"{label}: invalid memory guard line")
        if key in fields:
            raise AcceptanceError(f"{label}: duplicate memory guard field")
        fields[key] = value
    required = {
        "status": "completed",
        "rc": "0",
        "memory_guard_scope": "identity_history_union_group_and_descendants",
        "memory_limit_bytes": str(MEMORY_LIMIT_BYTES),
        "observed_sample_limit_status": "proved",
        "memory_measurement_status": "available",
        "cleanup_status": "not_required",
    }
    if require_hard_limit_proof:
        required["hard_memory_limit_proof_status"] = \
            "proved_linux_kernel_cgroup_v2_aggregate"
    for key, expected in required.items():
        if fields.get(key) != expected:
            raise AcceptanceError(f"{label}: invalid memory guard {key}")
    enforced = fields.get("process_tree_enforced_peak_bytes")
    if enforced is None or not enforced.isdigit() or int(enforced) != reported_rss or \
       int(enforced) > MEMORY_LIMIT_BYTES:
        raise AcceptanceError(f"{label}: memory guard peak differs from metric")
    return fields


