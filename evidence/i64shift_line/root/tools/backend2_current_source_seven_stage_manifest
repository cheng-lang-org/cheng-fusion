class ManifestError(RuntimeError):
    pass


class CurrentArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise ManifestError("arguments_invalid:" + message)


@dataclass(frozen=True)
class FileState:
    path: pathlib.Path
    raw: bytes
    sha256: str
    info: os.stat_result


def fail(reason: str) -> None:
    raise ManifestError(reason)


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def canonical_path(path: pathlib.Path, label: str, *, directory: bool = False) -> pathlib.Path:
    if not path.is_absolute() or pathlib.Path(os.path.realpath(path)) != path:
        fail(label + "_not_canonical")
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode):
        fail(label + "_symlink")
    if directory and not stat.S_ISDIR(info.st_mode):
        fail(label + "_not_directory")
    if not directory and not stat.S_ISREG(info.st_mode):
        fail(label + "_not_regular")
    return path


def stable_read(path: pathlib.Path, label: str, *, nonempty: bool = True) -> FileState:
    path = canonical_path(path, label)
    before = path.lstat()
    if before.st_nlink != 1 or (nonempty and before.st_size <= 0):
        fail(label + "_identity_invalid")
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        opened = os.fstat(descriptor)
        if identity(opened) != identity(before):
            fail(label + "_open_race")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, READ_BYTES)
            if not chunk:
                break
            digest.update(chunk)
            chunks.append(chunk)
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.lstat()
    if identity(before) != identity(closed) or identity(before) != identity(after):
        fail(label + "_read_race")
    raw = b"".join(chunks)
    if len(raw) != before.st_size:
        fail(label + "_short_read")
    return FileState(path, raw, digest.hexdigest(), before)


def canonical_json(value: Any) -> str:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        separators=(",", ":"),
        sort_keys=True,
    )


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            fail("json_duplicate_key:" + key)
        result[key] = value
    return result


def parse_json(state: FileState, label: str, *, canonical_line: bool = False) -> Any:
    try:
        text = state.raw.decode("utf-8")
        value = json.loads(text, object_pairs_hook=reject_duplicate_keys)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ManifestError(label + "_json_invalid") from error
    if canonical_line and state.raw != (canonical_json(value) + "\n").encode("utf-8"):
        fail(label + "_canonical_json_invalid")
    return value


def unique_manifest_value(state: FileState, key: str, label: str) -> str:
    try:
        text = state.raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ManifestError(label + "_utf8_invalid") from error
    prefix = key + "="
    values = [
        line[len(prefix) :]
        for line in text.splitlines()
        if line.startswith(prefix)
    ]
    if len(values) != 1 or not values[0]:
        fail(label + "_key_missing_or_duplicate:" + key)
    return values[0]


def canonical_runner_report(value: dict[str, Any]) -> bytes:
    return (
        json.dumps(
            value,
            ensure_ascii=False,
            allow_nan=False,
            indent=2,
            separators=(",", ": "),
        )
        + "\n"
    ).encode("utf-8")


def framed(raw: bytes) -> bytes:
    return struct.pack(">I", len(raw)) + raw


def framed_text(value: Any, label: str) -> bytes:
    if not isinstance(value, str):
        fail(label + "_text_invalid")
    return framed(value.encode("utf-8"))


def framed_i32(value: Any, label: str) -> bytes:
    if not isinstance(value, int) or isinstance(value, bool) or not 0 <= value < 2**31:
        fail(label + "_i32_invalid")
    return framed(struct.pack(">I", value))


def framed_i64(value: Any, label: str) -> bytes:
    if not isinstance(value, int) or isinstance(value, bool) or not 0 <= value < 2**63:
        fail(label + "_i64_invalid")
    return framed(struct.pack(">Q", value))


def framed_raw32(value: Any, label: str) -> bytes:
    return framed(bytes.fromhex(observed_sha(value, label)))


def digest_parts(parts: list[bytes]) -> str:
    digest = hashlib.sha256()
    for part in parts:
        digest.update(part)
    return digest.hexdigest()


def execution_raw32(identity_row: dict[str, Any]) -> str:
    return digest_parts(
        [
            framed_text(IDENTITY_DOMAIN, "identity_domain"),
            framed_text(identity_row["caseId"], "identity_case"),
            framed_raw32(identity_row["sourceBundleRaw32"], "identity_source"),
            framed_raw32(
                identity_row["materializerBytesRaw32"], "identity_materializer"
            ),
            framed_raw32(
                identity_row["grammarObligationRootRaw32"], "identity_grammar"
            ),
            framed_raw32(
                identity_row["compilerSourceClosureRaw32"], "identity_closure"
            ),
            framed_raw32(identity_row["driverBytesRaw32"], "identity_driver"),
            framed_raw32(
                identity_row["toolchainManifestRaw32"], "identity_toolchain"
            ),
            framed_raw32(
                identity_row["commandManifestRaw32"], "identity_command"
            ),
            framed_text(identity_row["targetTriple"], "identity_target"),
        ]
    )


def stage_raw32(stage: dict[str, Any]) -> str:
    return digest_parts(
        [
            framed_text(STAGE_DOMAIN, "stage_domain"),
            framed_i32(stage["stageOrdinal"], "stage_ordinal"),
            framed_text(stage["stageKind"], "stage_kind"),
            framed_text(stage["laneKind"], "stage_lane"),
            framed_raw32(stage["producerSourceRaw32"], "stage_producer"),
            framed_raw32(stage["executionRaw32"], "stage_execution"),
            framed_text(stage["predecessorStageKind"], "stage_predecessor"),
            framed_raw32(
                stage["predecessorReceiptRaw32"], "stage_predecessor_receipt"
            ),
            framed_raw32(stage["inputSemanticRaw32"], "stage_input"),
            framed_raw32(stage["outputSemanticRaw32"], "stage_output"),
            framed_text(stage["sidecarSchema"], "stage_sidecar_schema"),
            framed_text(stage["sidecarPath"], "stage_sidecar_path"),
            framed_i64(stage["sidecarByteLength"], "stage_sidecar_length"),
            framed_raw32(stage["sidecarBytesRaw32"], "stage_sidecar"),
            framed_text(stage["artifactKind"], "stage_artifact_kind"),
            framed_text(stage["artifactPath"], "stage_artifact_path"),
            framed_i64(stage["artifactByteLength"], "stage_artifact_length"),
            framed_raw32(stage["artifactBytesRaw32"], "stage_artifact"),
        ]
    )


def seven_stage_raw32(receipt: dict[str, Any]) -> str:
    stages = receipt["stages"]
    if not isinstance(stages, list):
        fail("seven_stage_rows_invalid")
    parts = [
        framed_text(SEVEN_STAGE_DOMAIN, "seven_stage_domain"),
        framed_raw32(receipt["identity"]["executionRaw32"], "seven_stage_execution"),
        framed_raw32(receipt["parserReceiptRaw32"], "seven_stage_parser_receipt"),
        framed_raw32(receipt["parserSemanticRaw32"], "seven_stage_parser_semantic"),
        framed_i32(len(stages), "seven_stage_count"),
    ]
    for index, stage in enumerate(stages):
        if not isinstance(stage, dict):
            fail("seven_stage_row_invalid:" + str(index))
        parts.extend(
            [
                framed_raw32(
                    stage["receiptRaw32"], "seven_stage_receipt_" + str(index)
                ),
                framed_raw32(
                    stage["outputSemanticRaw32"],
                    "seven_stage_semantic_" + str(index),
                ),
            ]
        )
    return digest_parts(parts)


def exact_keys(value: Any, expected: set[str], label: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != expected:
        fail(label + "_keys_invalid")
    return value


def observed_sha(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or len(value) != 64
        or any(character not in "0123456789abcdef" for character in value)
        or value in ("0" * 64, EMPTY_SHA256)
    ):
        fail(label + "_sha256_invalid")
    return value


def relative_path(value: Any, label: str) -> pathlib.PurePosixPath:
    if not isinstance(value, str) or not value or "\\" in value or ":" in value:
        fail(label + "_path_invalid")
    path = pathlib.PurePosixPath(value)
    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
        fail(label + "_path_invalid")
    return path


def evidence_file(root: pathlib.Path, value: Any, label: str) -> tuple[str, FileState]:
    relative = relative_path(value, label)
    path = root.joinpath(*relative.parts)
    if pathlib.Path(os.path.realpath(path)) != path:
        fail(label + "_path_not_canonical")
    return str(relative), stable_read(path, label)


def pin(root: pathlib.Path, relative: str, expected: Any, label: str) -> dict[str, str]:
    path_text, state = evidence_file(root, relative, label)
    if state.sha256 != observed_sha(expected, label):
        fail(label + "_bytes_drift")
    return {"path": path_text, "bytesRaw32": state.sha256}


def exclusive_json(path: pathlib.Path, value: Any) -> FileState:
    if not path.is_absolute() or pathlib.Path(os.path.realpath(path.parent)) != path.parent:
        fail("output_parent_not_canonical")
    try:
        path.lstat()
    except FileNotFoundError:
        pass
    else:
        fail("output_must_be_absent")
    raw = (canonical_json(value) + "\n").encode("utf-8")
    descriptor = os.open(
        path,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        0o400,
    )
    try:
        view = memoryview(raw)
        while view:
            count = os.write(descriptor, view)
            if count <= 0:
                fail("output_write_failed")
            view = view[count:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return stable_read(path, "output")


def build(args: argparse.Namespace) -> None:
    root = canonical_path(pathlib.Path(args.evidence_root), "evidence_root", directory=True)
    receipt_state = stable_read(root / "execution-stage-receipt.json", "receipt")
    receipt = exact_keys(
        parse_json(receipt_state, "receipt", canonical_line=True),
        {
            "schema",
            "runnerKind",
            "identity",
            "observedIdentityPaths",
            "parserReceiptRaw32",
            "parserSemanticRaw32",
            "stages",
            "sevenStageRootRaw32",
            "receiptSha256",
        },
        "receipt",
    )
    if (
        receipt["schema"] != "cheng.compiler.execution_stage_bundle"
        or receipt["runnerKind"] != "cheng-real-source-bound-seven-stage-pipeline"
    ):
        fail("receipt_header_invalid")
    payload = dict(receipt)
    receipt_payload_sha = observed_sha(payload.pop("receiptSha256"), "receipt_payload")
    if hashlib.sha256(canonical_json(payload).encode("utf-8")).hexdigest() != receipt_payload_sha:
        fail("receipt_payload_hash_invalid")
    identity_row = exact_keys(
        receipt["identity"],
        {
            "caseId",
            "sourceBundleRaw32",
            "materializerBytesRaw32",
            "grammarObligationRootRaw32",
            "compilerSourceClosureRaw32",
            "driverBytesRaw32",
            "toolchainManifestRaw32",
            "commandManifestRaw32",
            "targetTriple",
            "executionRaw32",
        },
        "receipt_identity",
    )
    if identity_row["executionRaw32"] != execution_raw32(identity_row):
        fail("receipt_execution_self_hash_invalid")
    observed_paths = exact_keys(
        receipt["observedIdentityPaths"],
        {
            "sourceBundlePath",
            "materializerBytesPath",
            "grammarObligationPath",
            "compilerSourceClosurePath",
            "driverBytesPath",
            "toolchainManifestPath",
            "commandManifestPath",
        },
        "receipt_identity_paths",
    )
    path_keys = {
        "sourceBundle": ("sourceBundlePath", "sourceBundleRaw32"),
        "materializerBytes": ("materializerBytesPath", "materializerBytesRaw32"),
        "grammarObligation": ("grammarObligationPath", "grammarObligationRootRaw32"),
        "compilerSourceClosure": (
            "compilerSourceClosurePath",
            "compilerSourceClosureRaw32",
        ),
        "driverBytes": ("driverBytesPath", "driverBytesRaw32"),
        "toolchainManifest": ("toolchainManifestPath", "toolchainManifestRaw32"),
        "commandManifest": ("commandManifestPath", "commandManifestRaw32"),
    }
    identity_pins: dict[str, dict[str, str]] = {}
    for key, (path_key, raw_key) in path_keys.items():
        if observed_paths[path_key] != IDENTITY_PATHS[key]:
            fail("receipt_identity_path_invalid:" + key)
        identity_pins[key] = pin(
            root,
            IDENTITY_PATHS[key],
            identity_row[raw_key],
            "identity_" + key,
        )
    source_manifest = stable_read(pathlib.Path(args.source_manifest), "source_manifest")
    official = stable_read(pathlib.Path(args.official_driver), "official_driver")
    harness = stable_read(
        pathlib.Path(args.parser_harness_manifest), "parser_harness_manifest"
    )
    source_closure = observed_sha(
        unique_manifest_value(
            source_manifest, "closure_sha256", "source_manifest"
        ),
        "source_manifest_closure",
    )
    if (
        source_manifest.raw
        != stable_read(
            root / IDENTITY_PATHS["compilerSourceClosure"],
            "compiler_source_identity",
        ).raw
        or official.raw
        != stable_read(root / IDENTITY_PATHS["driverBytes"], "driver_identity").raw
        or identity_row["sourceBundleRaw32"] != source_manifest.sha256
    ):
        fail("current_identity_input_drift")
    ingress_state = stable_read(pathlib.Path(args.parser_ingress_report), "parser_ingress")
    parser_map = stable_read(pathlib.Path(args.parser_map), "parser_map")
    ingress = exact_keys(
        parse_json(ingress_state, "parser_ingress"),
        {
            "schema",
            "status",
            "reason",
            "sourceSnapshotManifestPath",
            "sourceSnapshotManifestSha256",
            "sourceSnapshotClosureSha256",
            "officialDriverPath",
            "officialDriverSha256",
            "harnessManifestPath",
            "harnessManifestSha256",
            "productionCount",
            "requiredObligationCount",
            "witnessedObligationCount",
            "missingObligationCount",
            "receiptCount",
            "admittedMapSha256",
        },
        "parser_ingress",
    )
    if (
        ingress["schema"] != "cheng_current_parser_receipt_ingress"
        or ingress["status"] != "ADMITTED"
        or ingress["reason"] != ""
        or ingress["sourceSnapshotManifestPath"] != str(source_manifest.path)
        or ingress["officialDriverPath"] != str(official.path)
        or ingress["harnessManifestPath"] != str(harness.path)
        or type(ingress["productionCount"]) is not int
        or ingress["productionCount"] <= 0
        or type(ingress["requiredObligationCount"]) is not int
        or ingress["requiredObligationCount"] <= 0
        or type(ingress["witnessedObligationCount"]) is not int
        or ingress["witnessedObligationCount"]
        != ingress["requiredObligationCount"]
        or type(ingress["missingObligationCount"]) is not int
        or ingress["missingObligationCount"] != 0
        or type(ingress["receiptCount"]) is not int
        or ingress["receiptCount"] <= 0
        or ingress["sourceSnapshotManifestSha256"] != source_manifest.sha256
        or ingress["sourceSnapshotClosureSha256"] != source_closure
        or ingress["officialDriverSha256"] != official.sha256
        or ingress["harnessManifestSha256"] != harness.sha256
        or ingress["admittedMapSha256"] != parser_map.sha256
        or receipt["parserReceiptRaw32"] != ingress_state.sha256
        or receipt["parserSemanticRaw32"] != parser_map.sha256
    ):
        fail("parser_current_identity_drift")
    stages_value = receipt["stages"]
    if not isinstance(stages_value, list) or len(stages_value) != len(STAGES):
        fail("receipt_stage_count_invalid")
    policy_stages: list[dict[str, Any]] = []
    runner_stages: list[dict[str, Any]] = []
    for index, kind in enumerate(STAGES):
        lane, predecessor, predecessor_index, sidecar_schema, artifact_kind = (
            STAGE_PLAN[index]
        )
        stage = exact_keys(
            stages_value[index],
            {
                "stageOrdinal",
                "stageKind",
                "laneKind",
                "producerSourcePath",
                "producerSourceRaw32",
                "executionRaw32",
                "predecessorStageKind",
                "predecessorReceiptRaw32",
                "inputSemanticRaw32",
                "outputSemanticRaw32",
                "sidecarSchema",
                "sidecarPath",
                "sidecarByteLength",
                "sidecarBytesRaw32",
                "artifactKind",
                "artifactPath",
                "artifactByteLength",
                "artifactBytesRaw32",
                "receiptRaw32",
            },
            "stage_" + str(index),
        )
        if (
            stage["stageOrdinal"] != index + 1
            or stage["stageKind"] != kind
            or stage["executionRaw32"] != identity_row["executionRaw32"]
            or stage["laneKind"] != lane
            or stage["predecessorStageKind"] != predecessor
            or stage["sidecarSchema"] != sidecar_schema
            or stage["artifactKind"] != artifact_kind
        ):
            fail("receipt_stage_order_or_identity_invalid:" + kind)
        expected_predecessor = (
            receipt["parserReceiptRaw32"]
            if predecessor_index < 0
            else stages_value[predecessor_index]["receiptRaw32"]
        )
        expected_ingress = (
            receipt["parserSemanticRaw32"]
            if predecessor_index < 0
            else stages_value[predecessor_index]["outputSemanticRaw32"]
        )
        if (
            stage["predecessorReceiptRaw32"] != expected_predecessor
            or stage["inputSemanticRaw32"] != expected_ingress
        ):
            fail("receipt_stage_transition_invalid:" + kind)
        producer_pin = pin(
            root,
            stage["producerSourcePath"],
            stage["producerSourceRaw32"],
            "stage_producer_" + kind,
        )
        sidecar_path, sidecar = evidence_file(
            root, stage["sidecarPath"], "stage_sidecar_" + kind
        )
        artifact_path, artifact = evidence_file(
            root, stage["artifactPath"], "stage_artifact_" + kind
        )
        if (
            sidecar.sha256 != observed_sha(stage["sidecarBytesRaw32"], "stage_sidecar")
            or artifact.sha256
            != observed_sha(stage["artifactBytesRaw32"], "stage_artifact")
            or stage["sidecarByteLength"] != len(sidecar.raw)
            or stage["artifactByteLength"] != len(artifact.raw)
            or stage["outputSemanticRaw32"] != sidecar.sha256
        ):
            fail("receipt_stage_bytes_invalid:" + kind)
        stage_ingress = observed_sha(
            stage["inputSemanticRaw32"], "stage_ingress_" + kind
        )
        stage_receipt = observed_sha(
            stage["receiptRaw32"], "stage_receipt_" + kind
        )
        if stage_receipt != stage_raw32(stage):
            fail("receipt_stage_self_hash_invalid:" + kind)
        policy_stages.append(
            {
                "stageKind": kind,
                "producerSource": producer_pin,
                "sidecarPath": sidecar_path,
                "sidecarBytesRaw32": sidecar.sha256,
                "artifactPath": artifact_path,
                "artifactBytesRaw32": artifact.sha256,
            }
        )
        runner_stages.append(
            {
                "stageOrdinal": index + 1,
                "stageKind": kind,
                "executionRaw32": identity_row["executionRaw32"],
                "sourceBundleRaw32": identity_row["sourceBundleRaw32"],
                "compilerSourceClosureRaw32":
                    identity_row["compilerSourceClosureRaw32"],
                "toolchainManifestRaw32":
                    identity_row["toolchainManifestRaw32"],
                "ingressRaw32": stage_ingress,
                "actionRaw32": sidecar.sha256,
                "fragmentRaw32": stage_receipt,
                "objectRaw32": artifact.sha256,
                "receiptRaw32": stage_receipt,
            }
        )
    if receipt["sevenStageRootRaw32"] != seven_stage_raw32(receipt):
        fail("receipt_seven_stage_self_hash_invalid")
    policy = {
        "schema": "cheng_fusion.execution_stage_receipt_policy",
        "evidenceRoot": str(root),
        "receipt": {
            "path": "execution-stage-receipt.json",
            "bytesRaw32": receipt_state.sha256,
        },
        "caseId": identity_row["caseId"],
        "targetTriple": identity_row["targetTriple"],
        "identityInputs": identity_pins,
        "parserReceiptRaw32": ingress_state.sha256,
        "parserSemanticRaw32": parser_map.sha256,
        "stages": policy_stages,
    }
    runner_payload = {
        "schema": "cheng_current_official_seven_stage_manifest",
        "implemented": True,
        "status": "COMPLETE",
        "parserIngressRaw32": ingress_state.sha256,
        "parserMapRaw32": parser_map.sha256,
        "sourceBundleRaw32": observed_sha(
            identity_row["sourceBundleRaw32"], "source_bundle"
        ),
        "compilerSourceClosureRaw32": source_manifest.sha256,
        "toolchainManifestRaw32": identity_row["toolchainManifestRaw32"],
        "officialDriverRaw32": official.sha256,
        "executionRaw32": observed_sha(
            identity_row["executionRaw32"], "execution"
        ),
        "sevenStageRootRaw32": observed_sha(
            receipt["sevenStageRootRaw32"], "seven_stage_root"
        ),
        "stages": runner_stages,
    }
    runner = dict(runner_payload)
    runner["manifestRaw32"] = hashlib.sha256(
        canonical_json(runner_payload).encode("utf-8")
    ).hexdigest()
    policy_path = pathlib.Path(args.policy_out)
    runner_path = pathlib.Path(args.runner_out)
    if policy_path == runner_path:
        fail("output_paths_alias")
    for path in (policy_path, runner_path):
        if (
            not path.is_absolute()
            or pathlib.Path(os.path.realpath(path.parent)) != path.parent
        ):
            fail("output_parent_not_canonical")
        try:
            path.lstat()
        except FileNotFoundError:
            pass
        else:
            fail("output_must_be_absent")
    policy_state = exclusive_json(policy_path, policy)
    runner_state = exclusive_json(runner_path, runner)
    print("execution_policy_sha256=" + policy_state.sha256)
    print("runner_manifest_sha256=" + runner_state.sha256)


def validate_runner_report(args: argparse.Namespace) -> None:
    root = canonical_path(pathlib.Path(args.evidence_root), "evidence_root", directory=True)
    receipt_state = stable_read(root / "execution-stage-receipt.json", "receipt")
    receipt = exact_keys(
        parse_json(receipt_state, "receipt", canonical_line=True),
        {
            "schema",
            "runnerKind",
            "identity",
            "observedIdentityPaths",
            "parserReceiptRaw32",
            "parserSemanticRaw32",
            "stages",
            "sevenStageRootRaw32",
            "receiptSha256",
        },
        "receipt",
    )
    if (
        receipt["schema"] != "cheng.compiler.execution_stage_bundle"
        or receipt["runnerKind"] != "cheng-real-source-bound-seven-stage-pipeline"
    ):
        fail("receipt_header_invalid")
    receipt_payload = dict(receipt)
    receipt_payload_sha = observed_sha(
        receipt_payload.pop("receiptSha256"), "receipt_payload"
    )
    if (
        hashlib.sha256(canonical_json(receipt_payload).encode("utf-8")).hexdigest()
        != receipt_payload_sha
    ):
        fail("receipt_payload_hash_invalid")
    identity_row = exact_keys(
        receipt["identity"],
        {
            "caseId",
            "sourceBundleRaw32",
            "materializerBytesRaw32",
            "grammarObligationRootRaw32",
            "compilerSourceClosureRaw32",
            "driverBytesRaw32",
            "toolchainManifestRaw32",
            "commandManifestRaw32",
            "targetTriple",
            "executionRaw32",
        },
        "receipt_identity",
    )
    if identity_row["executionRaw32"] != execution_raw32(identity_row):
        fail("receipt_execution_self_hash_invalid")
    observed_paths = exact_keys(
        receipt["observedIdentityPaths"],
        {
            "sourceBundlePath",
            "materializerBytesPath",
            "grammarObligationPath",
            "compilerSourceClosurePath",
            "driverBytesPath",
            "toolchainManifestPath",
            "commandManifestPath",
        },
        "receipt_identity_paths",
    )
    path_keys = {
        "sourceBundle": ("sourceBundlePath", "sourceBundleRaw32"),
        "materializerBytes": ("materializerBytesPath", "materializerBytesRaw32"),
        "grammarObligation": ("grammarObligationPath", "grammarObligationRootRaw32"),
        "compilerSourceClosure": (
            "compilerSourceClosurePath",
            "compilerSourceClosureRaw32",
        ),
        "driverBytes": ("driverBytesPath", "driverBytesRaw32"),
        "toolchainManifest": ("toolchainManifestPath", "toolchainManifestRaw32"),
        "commandManifest": ("commandManifestPath", "commandManifestRaw32"),
    }
    identity_pins: dict[str, dict[str, str]] = {}
    for key, (path_key, raw_key) in path_keys.items():
        if observed_paths[path_key] != IDENTITY_PATHS[key]:
            fail("receipt_identity_path_invalid:" + key)
        identity_pins[key] = pin(
            root,
            IDENTITY_PATHS[key],
            identity_row[raw_key],
            "identity_" + key,
        )
    source_manifest = stable_read(pathlib.Path(args.source_manifest), "source_manifest")
    official = stable_read(pathlib.Path(args.official_driver), "official_driver")
    harness = stable_read(
        pathlib.Path(args.parser_harness_manifest), "parser_harness_manifest"
    )
    source_closure = observed_sha(
        unique_manifest_value(
            source_manifest, "closure_sha256", "source_manifest"
        ),
        "source_manifest_closure",
    )
    ingress_state = stable_read(pathlib.Path(args.parser_ingress_report), "parser_ingress")
    parser_map = stable_read(pathlib.Path(args.parser_map), "parser_map")
    ingress = exact_keys(
        parse_json(ingress_state, "parser_ingress"),
        {
            "schema",
            "status",
            "reason",
            "sourceSnapshotManifestPath",
            "sourceSnapshotManifestSha256",
            "sourceSnapshotClosureSha256",
            "officialDriverPath",
            "officialDriverSha256",
            "harnessManifestPath",
            "harnessManifestSha256",
            "productionCount",
            "requiredObligationCount",
            "witnessedObligationCount",
            "missingObligationCount",
            "receiptCount",
            "admittedMapSha256",
        },
        "parser_ingress",
    )
    if (
        source_manifest.raw
        != stable_read(
            root / IDENTITY_PATHS["compilerSourceClosure"],
            "compiler_source_identity",
        ).raw
        or official.raw
        != stable_read(root / IDENTITY_PATHS["driverBytes"], "driver_identity").raw
        or identity_row["sourceBundleRaw32"] != source_manifest.sha256
        or ingress["schema"] != "cheng_current_parser_receipt_ingress"
        or ingress["status"] != "ADMITTED"
        or ingress["reason"] != ""
        or ingress["sourceSnapshotManifestPath"] != str(source_manifest.path)
        or ingress["sourceSnapshotManifestSha256"] != source_manifest.sha256
        or ingress["sourceSnapshotClosureSha256"] != source_closure
        or ingress["officialDriverPath"] != str(official.path)
        or ingress["officialDriverSha256"] != official.sha256
        or ingress["harnessManifestPath"] != str(harness.path)
        or ingress["harnessManifestSha256"] != harness.sha256
        or ingress["admittedMapSha256"] != parser_map.sha256
        or receipt["parserReceiptRaw32"] != ingress_state.sha256
        or receipt["parserSemanticRaw32"] != parser_map.sha256
        or type(ingress["productionCount"]) is not int
        or ingress["productionCount"] <= 0
        or type(ingress["requiredObligationCount"]) is not int
        or ingress["requiredObligationCount"] <= 0
        or type(ingress["witnessedObligationCount"]) is not int
        or ingress["witnessedObligationCount"]
        != ingress["requiredObligationCount"]
        or type(ingress["missingObligationCount"]) is not int
        or ingress["missingObligationCount"] != 0
        or type(ingress["receiptCount"]) is not int
        or ingress["receiptCount"] <= 0
    ):
        fail("current_input_identity_drift")
    stages_value = receipt["stages"]
    if not isinstance(stages_value, list) or len(stages_value) != len(STAGES):
        fail("receipt_stage_count_invalid")
    policy_stages: list[dict[str, Any]] = []
    runner_stages: list[dict[str, Any]] = []
    receipt_roots: list[str] = []
    semantic_roots: list[str] = []
    for index, kind in enumerate(STAGES):
        lane, predecessor, predecessor_index, sidecar_schema, artifact_kind = (
            STAGE_PLAN[index]
        )
        stage = exact_keys(
            stages_value[index],
            {
                "stageOrdinal",
                "stageKind",
                "laneKind",
                "producerSourcePath",
                "producerSourceRaw32",
                "executionRaw32",
                "predecessorStageKind",
                "predecessorReceiptRaw32",
                "inputSemanticRaw32",
                "outputSemanticRaw32",
                "sidecarSchema",
                "sidecarPath",
                "sidecarByteLength",
                "sidecarBytesRaw32",
                "artifactKind",
                "artifactPath",
                "artifactByteLength",
                "artifactBytesRaw32",
                "receiptRaw32",
            },
            "stage_" + str(index),
        )
        expected_predecessor = (
            receipt["parserReceiptRaw32"]
            if predecessor_index < 0
            else receipt_roots[predecessor_index]
        )
        expected_ingress = (
            receipt["parserSemanticRaw32"]
            if predecessor_index < 0
            else semantic_roots[predecessor_index]
        )
        if (
            stage["stageOrdinal"] != index + 1
            or stage["stageKind"] != kind
            or stage["laneKind"] != lane
            or stage["executionRaw32"] != identity_row["executionRaw32"]
            or stage["predecessorStageKind"] != predecessor
            or stage["predecessorReceiptRaw32"] != expected_predecessor
            or stage["inputSemanticRaw32"] != expected_ingress
            or stage["sidecarSchema"] != sidecar_schema
            or stage["artifactKind"] != artifact_kind
        ):
            fail("receipt_stage_binding_invalid:" + kind)
        producer_pin = pin(
            root,
            stage["producerSourcePath"],
            stage["producerSourceRaw32"],
            "stage_producer_" + kind,
        )
        sidecar_path, sidecar = evidence_file(
            root, stage["sidecarPath"], "stage_sidecar_" + kind
        )
        artifact_path, artifact = evidence_file(
            root, stage["artifactPath"], "stage_artifact_" + kind
        )
        stage_receipt = observed_sha(stage["receiptRaw32"], "stage_receipt_" + kind)
        if stage_receipt != stage_raw32(stage):
            fail("receipt_stage_self_hash_invalid:" + kind)
        if (
            sidecar.sha256
            != observed_sha(stage["sidecarBytesRaw32"], "stage_sidecar_" + kind)
            or artifact.sha256
            != observed_sha(stage["artifactBytesRaw32"], "stage_artifact_" + kind)
            or stage["sidecarByteLength"] != len(sidecar.raw)
            or stage["artifactByteLength"] != len(artifact.raw)
            or stage["outputSemanticRaw32"] != sidecar.sha256
        ):
            fail("receipt_stage_bytes_invalid:" + kind)
        policy_stages.append(
            {
                "stageKind": kind,
                "producerSource": producer_pin,
                "sidecarPath": sidecar_path,
                "sidecarBytesRaw32": sidecar.sha256,
                "artifactPath": artifact_path,
                "artifactBytesRaw32": artifact.sha256,
            }
        )
        runner_stages.append(
            {
                "stageOrdinal": index + 1,
                "stageKind": kind,
                "executionRaw32": identity_row["executionRaw32"],
                "sourceBundleRaw32": identity_row["sourceBundleRaw32"],
                "compilerSourceClosureRaw32":
                    identity_row["compilerSourceClosureRaw32"],
                "toolchainManifestRaw32":
                    identity_row["toolchainManifestRaw32"],
                "ingressRaw32": stage["inputSemanticRaw32"],
                "actionRaw32": sidecar.sha256,
                "fragmentRaw32": stage_receipt,
                "objectRaw32": artifact.sha256,
                "receiptRaw32": stage_receipt,
            }
        )
        receipt_roots.append(stage_receipt)
        semantic_roots.append(sidecar.sha256)
    if receipt["sevenStageRootRaw32"] != seven_stage_raw32(receipt):
        fail("receipt_seven_stage_self_hash_invalid")
    expected_policy = {
        "schema": "cheng_fusion.execution_stage_receipt_policy",
        "evidenceRoot": str(root),
        "receipt": {
            "path": "execution-stage-receipt.json",
            "bytesRaw32": receipt_state.sha256,
        },
        "caseId": identity_row["caseId"],
        "targetTriple": identity_row["targetTriple"],
        "identityInputs": identity_pins,
        "parserReceiptRaw32": ingress_state.sha256,
        "parserSemanticRaw32": parser_map.sha256,
        "stages": policy_stages,
    }
    policy_state = stable_read(pathlib.Path(args.execution_policy), "execution_policy")
    policy = parse_json(policy_state, "execution_policy", canonical_line=True)
    if policy != expected_policy:
        fail("execution_policy_binding_drift")
    runner_payload = {
        "schema": "cheng_current_official_seven_stage_manifest",
        "implemented": True,
        "status": "COMPLETE",
        "parserIngressRaw32": ingress_state.sha256,
        "parserMapRaw32": parser_map.sha256,
        "sourceBundleRaw32": observed_sha(
            identity_row["sourceBundleRaw32"], "source_bundle"
        ),
        "compilerSourceClosureRaw32": source_manifest.sha256,
        "toolchainManifestRaw32": identity_row["toolchainManifestRaw32"],
        "officialDriverRaw32": official.sha256,
        "executionRaw32": observed_sha(identity_row["executionRaw32"], "execution"),
        "sevenStageRootRaw32": observed_sha(
            receipt["sevenStageRootRaw32"], "seven_stage_root"
        ),
        "stages": runner_stages,
    }
    expected_runner = dict(runner_payload)
    expected_runner["manifestRaw32"] = hashlib.sha256(
        canonical_json(runner_payload).encode("utf-8")
    ).hexdigest()
    runner_state = stable_read(pathlib.Path(args.runner_manifest), "runner_manifest")
    runner = parse_json(runner_state, "runner_manifest", canonical_line=True)
    if runner != expected_runner:
        fail("runner_manifest_binding_drift")
    report_state = stable_read(pathlib.Path(args.report), "runner_report")
    report = exact_keys(
        parse_json(report_state, "runner_report"),
        {
            "schema",
            "status",
            "reason",
            "consumerImplemented",
            "upstreamImplemented",
            "parserIngressRaw32",
            "parserMapRaw32",
            "sourceBundleRaw32",
            "officialDriverRaw32",
            "executionRaw32",
            "sevenStageRootRaw32",
            "policyRaw32",
            "runnerManifestRaw32",
            "verifiedStageCount",
        },
        "runner_report",
    )
    expected_report = {
        "schema": "cheng_current_official_seven_stage_runner",
        "status": "ADMITTED",
        "reason": "",
        "consumerImplemented": True,
        "upstreamImplemented": True,
        "parserIngressRaw32": ingress_state.sha256,
        "parserMapRaw32": parser_map.sha256,
        "sourceBundleRaw32": identity_row["sourceBundleRaw32"],
        "officialDriverRaw32": official.sha256,
        "executionRaw32": identity_row["executionRaw32"],
        "sevenStageRootRaw32": receipt["sevenStageRootRaw32"],
        "policyRaw32": policy_state.sha256,
        "runnerManifestRaw32": runner_state.sha256,
        "verifiedStageCount": len(STAGES),
    }
    for key in (
        "parserIngressRaw32",
        "parserMapRaw32",
        "sourceBundleRaw32",
        "officialDriverRaw32",
        "executionRaw32",
        "sevenStageRootRaw32",
        "policyRaw32",
        "runnerManifestRaw32",
    ):
        observed_sha(report[key], "runner_report_" + key)
    if report != expected_report or report_state.raw != canonical_runner_report(
        expected_report
    ):
        fail("runner_report_binding_drift")
    print("current_seven_stage_runner_report_sha256=" + report_state.sha256)


def parser() -> argparse.ArgumentParser:
    result = CurrentArgumentParser()
    commands = result.add_subparsers(
        dest="command",
        required=True,
        parser_class=CurrentArgumentParser,
    )
    build_parser = commands.add_parser("build")
    build_parser.set_defaults(run=build)
    build_parser.add_argument("--evidence-root", required=True)
    build_parser.add_argument("--parser-ingress-report", required=True)
    build_parser.add_argument("--parser-map", required=True)
    build_parser.add_argument("--source-manifest", required=True)
    build_parser.add_argument("--official-driver", required=True)
    build_parser.add_argument("--parser-harness-manifest", required=True)
    build_parser.add_argument("--policy-out", required=True)
    build_parser.add_argument("--runner-out", required=True)
    validate_parser = commands.add_parser("validate-runner-report")
    validate_parser.set_defaults(run=validate_runner_report)
    validate_parser.add_argument("--evidence-root", required=True)
    validate_parser.add_argument("--parser-ingress-report", required=True)
    validate_parser.add_argument("--parser-map", required=True)
    validate_parser.add_argument("--source-manifest", required=True)
    validate_parser.add_argument("--official-driver", required=True)
    validate_parser.add_argument("--parser-harness-manifest", required=True)
    validate_parser.add_argument("--execution-policy", required=True)
    validate_parser.add_argument("--runner-manifest", required=True)
    validate_parser.add_argument("--report", required=True)
    return result


if __name__ == "__main__":
    try:
        arguments = parser().parse_args()
        arguments.run(arguments)
    except (ManifestError, OSError, ValueError, KeyError) as error:
        print(
            "backend2_current_source_seven_stage_manifest_error=" + str(error),
            file=sys.stderr,
        )
        raise SystemExit(FAIL_RC)
