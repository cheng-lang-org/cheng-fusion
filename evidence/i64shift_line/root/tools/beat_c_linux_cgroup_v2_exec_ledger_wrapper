        "full_compile_theory_time_guard_recommended_ms",
    ):
        if canonical_uint(rows.get(key, ""), "dry compile report " + key) != \
                budget_ns // 1_000_000:
            fail("full compile theory time guard ms mismatch: " + key)
    if canonical_positive_uint(
        rows.get("full_compile_theory_rss_modeled_guard_estimate_bytes", ""),
        "full compile modeled RSS guard",
    ) <= 0:
        fail("full compile modeled RSS guard is not positive")
    validate_dry_compile_dynamic_manifest(
        rows,
        files,
        import_edges,
        expected_entry_path,
        expected_entry_sha256,
        expected_source_bundle_cid,
    )
    authority = (
        load_dry_compile_schema_authority()
        if schema_authority is None
        else schema_authority
    )
    validate_dry_compile_exact_key_authority(
        rows,
        files,
        import_edges,
        authority,
    )
    return rows


def run_logged(
    argv: Sequence[str],
    stdout_path: Path,
    stderr_path: Path,
    timeout: int,
    environment: dict[str, str],
) -> int:
    exact_absent_file(stdout_path, "subprocess stdout")
    exact_absent_file(stderr_path, "subprocess stderr")
    stdout_fd = os.open(
        stdout_path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o400,
    )
    stderr_fd = os.open(
        stderr_path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o400,
    )
    try:
        completed = subprocess.run(
            list(argv),
            stdin=None,
            stdout=stdout_fd,
            stderr=stderr_fd,
            env=environment,
            timeout=timeout,
            check=False,
            close_fds=True,
        )
    finally:
        os.fsync(stdout_fd)
        os.fsync(stderr_fd)
        os.close(stdout_fd)
        os.close(stderr_fd)
    return completed.returncode


def framed_sha256(values: Iterable[bytes]) -> str:
    digest = hashlib.sha256()
    count = 0
    for value in values:
        count += 1
        digest.update(len(value).to_bytes(8, "big"))
        digest.update(value)
    digest.update(count.to_bytes(8, "big"))
    return digest.hexdigest()


def dry_compile_key_order_sha256(values: Sequence[str]) -> str:
    digest = hashlib.sha256()
    for value in values:
        raw = value.encode("utf-8")
        digest.update(len(raw).to_bytes(8, "big"))
        digest.update(raw)
    return digest.hexdigest()


def write_receipt(path: Path, rows: Sequence[tuple[str, str]]) -> None:
    if tuple(key for key, _value in rows) != RECEIPT_KEYS[:-1]:
        fail("wrapper receipt row order drift")
    prefix = "".join(f"{key}={value}\n" for key, value in rows).encode("utf-8")
    raw = prefix + (
        "receipt_sha256=" + sha256_bytes(prefix) + "\n"
    ).encode("ascii")
    write_exclusive(path, raw)


def parse_exit_code(raw: str) -> int:
    if (
        not raw
        or not raw.isascii()
        or not raw.isdigit()
        or (len(raw) > 1 and raw.startswith("0"))
    ):
        raise argparse.ArgumentTypeError("expected exit code must be 0..255")
    value = int(raw)
    if value > 255:
        raise argparse.ArgumentTypeError("expected exit code must be 0..255")
    return value


