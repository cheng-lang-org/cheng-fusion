def main(argv: Sequence[str] | None = None) -> int:
    try:
        run(parse_args(sys.argv[1:] if argv is None else argv))
        return 0
    except (
        WrapperError,
        OSError,
        subprocess.SubprocessError,
        ValueError,
    ) as exc:
        print("exec_ledger_wrapper_status=HARD_RED", file=sys.stderr)
        print(
            "exec_ledger_wrapper_error="
            + str(exc).replace("\n", " ")[:4096],
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
