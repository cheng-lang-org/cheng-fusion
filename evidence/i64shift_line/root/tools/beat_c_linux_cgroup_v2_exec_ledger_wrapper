def command_option(command: Sequence[str], prefix: str) -> str:
    matches = [
        value[len(prefix):] for value in command if value.startswith(prefix)
    ]
    if len(matches) != 1 or not matches[0]:
        fail("traced command option mismatch: " + prefix)
    return matches[0]


def current_command_backend_role(command: Sequence[str]) -> str:
    matches = [
        value[len("--backend:"):]
        for value in command
        if value.startswith("--backend:")
    ]
    if len(matches) != 1 or matches[0] not in ("primary", "backend2"):
        fail("current driver backend command authority mismatch")
    return matches[0]


def canonical_positive_uint(raw: str, label: str) -> int:
    if (
        not raw
        or not raw.isascii()
        or not raw.isdigit()
        or (len(raw) > 1 and raw.startswith("0"))
        or int(raw) <= 0
    ):
        fail(f"{label} is not a canonical positive integer")
    return int(raw)


def canonical_uint(raw: str, label: str) -> int:
    if (
        not raw
        or not raw.isascii()
        or not raw.isdigit()
        or (len(raw) > 1 and raw.startswith("0"))
    ):
        fail(f"{label} is not a canonical integer")
    return int(raw)


def canonical_int32(raw: str, label: str) -> int:
    if (
        not raw
        or raw in ("+", "-")
        or (raw[0] == "-" and not raw[1:].isdigit())
        or (raw[0] != "-" and not raw.isdigit())
    ):
        fail(f"{label} is not a signed integer")
    value = int(raw)
    if raw != str(value) or not -(1 << 31) <= value < (1 << 31):
        fail(f"{label} is not canonical int32")
    return value


def lower_hex_bytes(
    raw: str,
    label: str,
    *,
    allow_empty: bool,
) -> bytes:
    if (
        (not raw and not allow_empty)
        or len(raw) % 2
        or raw != raw.lower()
        or any(ch not in "0123456789abcdef" for ch in raw)
    ):
        fail(f"{label} is not canonical lower hex")
    return bytes.fromhex(raw)


def append_u32_be(out: bytearray, value: int) -> None:
    out.extend((value & 0xFFFF_FFFF).to_bytes(4, "big"))


def append_u64_be(out: bytearray, value: int) -> None:
    out.extend((value & 0xFFFF_FFFF_FFFF_FFFF).to_bytes(8, "big"))


def append_framed_bytes(out: bytearray, value: bytes) -> None:
    append_u32_be(out, len(value))
    out.extend(value)


def source_raw_bytes_cid(value: bytes) -> str:
    payload = bytearray()
    append_framed_bytes(payload, b"cheng.compiler.source_raw_bytes")
    append_u32_be(payload, len(value))
    payload.extend(value)
    return hashlib.sha256(payload).hexdigest()


def parser_path_content_hash(value: bytes) -> int:
    result = 0
    for byte in value:
        result = (result * 131 + byte) & 0xFFFF_FFFF
        if result >= 0x8000_0000:
            result -= 0x1_0000_0000
    if result < 0:
        result = (-result) & 0xFFFF_FFFF
        if result >= 0x8000_0000:
            result -= 0x1_0000_0000
    return result


def parser_ident_prefix_bytes(value: bytes) -> bytes:
    stop = 0
    for byte in value:
        if (
            ord("0") <= byte <= ord("9")
            or ord("A") <= byte <= ord("Z")
            or ord("a") <= byte <= ord("z")
            or byte == ord("_")
        ):
            stop += 1
        else:
            break
    return value[:stop]


def canonical_nonzero_sha256(raw: str, label: str) -> str:
    value = canonical_sha256(raw, label)
    if value == ZERO_SHA256:
        fail(f"{label} is zero")
    return value


