def fail(message: str) -> NoReturn:
    raise WrapperError(message)


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def stage23_guard_text_frame(raw: bytes) -> bytes:
    return len(raw).to_bytes(4, "big") + raw


def stage23_guard_argv_sha256(values: Sequence[str]) -> str:
    payload = bytearray(
        stage23_guard_text_frame(b"cheng.guard.command_argv")
    )
    payload.extend(len(values).to_bytes(4, "big"))
    for value in values:
        payload.extend(stage23_guard_text_frame(os.fsencode(value)))
    return sha256_bytes(bytes(payload))


def stage23_guard_env_sha256(rows: Sequence[dict[str, Any]]) -> str:
    env: dict[str, str] = {}
    for row in rows:
        if (
            not isinstance(row, dict)
            or set(row) != {"name", "value"}
            or not isinstance(row.get("name"), str)
            or not isinstance(row.get("value"), str)
            or row["name"] in env
        ):
            fail("stage23 phase environment is not exact")
        env[row["name"]] = row["value"]
    payload = bytearray(
        stage23_guard_text_frame(b"cheng.guard.target_env")
    )
    keys = sorted(env)
    payload.extend(len(keys).to_bytes(4, "big"))
    for key in keys:
        payload.extend(stage23_guard_text_frame(os.fsencode(key)))
        payload.extend(stage23_guard_text_frame(os.fsencode(env[key])))
    return sha256_bytes(bytes(payload))


def stage23_executable_format(raw: bytes) -> str:
    if (
        len(raw) >= 20
        and raw[:4] == b"\x7fELF"
        and raw[4] == 2
        and raw[5] == 1
        and int.from_bytes(raw[18:20], "little") == 62
    ):
        return "elf64-x86_64-linux"
    fail("stage23 executable output machine format is not exact")


def canonical_sha256(raw: str, label: str) -> str:
    if (
        len(raw) != 64
        or any(char not in "0123456789abcdef" for char in raw)
    ):
        fail(f"{label} is not canonical sha256")
    return raw


def exact_existing_file(path: Path, label: str) -> Path:
    if not path.is_absolute():
        fail(f"{label} is not absolute")
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise WrapperError(f"{label} cannot be resolved") from exc
    if resolved != path:
        fail(f"{label} contains a symlink or alias")
    info = os.stat(path, follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode):
        fail(f"{label} is not a regular file")
    return path


def exact_absent_file(path: Path, label: str) -> Path:
    if (
        not path.is_absolute()
        or path.exists()
        or path.is_symlink()
        or path.parent.resolve(strict=True) != path.parent
    ):
        fail(f"{label} is not an absent canonical path")
    return path


def stat_signature(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def stable_read(path: Path, label: str, maximum: int) -> StableFile:
    exact_existing_file(path, label)
    before_path = os.stat(path, follow_symlinks=False)
    if before_path.st_size < 0 or before_path.st_size > maximum:
        fail(f"{label} size exceeds contract")
    if not hasattr(os, "O_NOFOLLOW"):
        fail("O_NOFOLLOW is unavailable")
    fd = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW,
    )
    try:
        before = os.fstat(fd)
        if stat_signature(before) != stat_signature(before_path):
            fail(f"{label} changed before open")
        digest = hashlib.sha256()
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(fd, min(1024 * 1024, remaining))
            if not chunk:
                fail(f"{label} short read")
            chunks.append(chunk)
            digest.update(chunk)
            remaining -= len(chunk)
        if os.read(fd, 1):
            fail(f"{label} grew during read")
        after = os.fstat(fd)
    finally:
        os.close(fd)
    after_path = os.stat(path, follow_symlinks=False)
    if (
        stat_signature(before) != stat_signature(after)
        or stat_signature(before) != stat_signature(after_path)
    ):
        fail(f"{label} changed during read")
    return StableFile(
        raw=b"".join(chunks),
        sha256=digest.hexdigest(),
        size=before.st_size,
        mode=before.st_mode,
        device=before.st_dev,
        inode=before.st_ino,
        uid=before.st_uid,
        gid=before.st_gid,
    )


def load_dry_compile_schema_authority() -> Any:
    path = CANDIDATE_VALIDATOR_PATH
    before = stable_read(
        path,
        "dry compile schema authority",
        16 * 1024 * 1024,
    )
    spec = importlib.util.spec_from_file_location(
        "cheng_exec_ledger_dry_compile_schema_authority",
        path,
    )
    if spec is None or spec.loader is None:
        fail("dry compile schema authority cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    try:
        spec.loader.exec_module(module)
    except Exception as exc:
        raise WrapperError(
            "dry compile schema authority execution failed",
        ) from exc
    after = stable_read(
        path,
        "dry compile schema authority",
        16 * 1024 * 1024,
    )
    if (
        before != after
        or not callable(
            getattr(module, "dry_compile_report_exact_key_order", None)
        )
    ):
        fail("dry compile schema authority drift/API mismatch")
    return module


def fixed_identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
    )


def open_held_file(
    path: Path,
    label: str,
    *,
    require_empty: bool,
    require_executable: bool = False,
) -> HeldFile:
    exact_existing_file(path, label)
    if not hasattr(os, "O_NOFOLLOW"):
        fail("O_NOFOLLOW is unavailable")
    before_path = os.stat(path, follow_symlinks=False)
    fd = os.open(
        path,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW,
    )
    try:
        opened = os.fstat(fd)
        if stat_signature(opened) != stat_signature(before_path):
            fail(f"{label} changed before held open")
        if require_empty and opened.st_size != 0:
            fail(f"{label} is not initially empty")
        if require_executable and (
            not opened.st_mode & stat.S_IXUSR
            or opened.st_mode & (stat.S_ISUID | stat.S_ISGID)
        ):
            fail(f"{label} executable mode mismatch")
        return HeldFile(
            path=path,
            fd=fd,
            mode=opened.st_mode,
            device=opened.st_dev,
            inode=opened.st_ino,
            uid=opened.st_uid,
            gid=opened.st_gid,
        )
    except BaseException:
        os.close(fd)
        raise


def stable_read_held(
    held: HeldFile,
    label: str,
    maximum: int,
) -> StableFile:
    before = os.fstat(held.fd)
    if fixed_identity(before) != (
        held.device,
        held.inode,
        held.mode,
        held.uid,
        held.gid,
    ):
        fail(f"{label} held identity drifted")
    exact_existing_file(held.path, label)
    before_path = os.stat(held.path, follow_symlinks=False)
    if fixed_identity(before_path) != fixed_identity(before):
        fail(f"{label} terminal path identity mismatch")
    if before.st_size < 0 or before.st_size > maximum:
        fail(f"{label} size exceeds contract")
    os.lseek(held.fd, 0, os.SEEK_SET)
    digest = hashlib.sha256()
    chunks: list[bytes] = []
    remaining = before.st_size
    while remaining:
        chunk = os.read(held.fd, min(1024 * 1024, remaining))
        if not chunk:
            fail(f"{label} short held read")
        chunks.append(chunk)
        digest.update(chunk)
        remaining -= len(chunk)
    if os.read(held.fd, 1):
        fail(f"{label} grew during held read")
    after = os.fstat(held.fd)
    exact_existing_file(held.path, label)
    after_path = os.stat(held.path, follow_symlinks=False)
    if (
        stat_signature(before) != stat_signature(after)
        or stat_signature(before) != stat_signature(after_path)
    ):
        fail(f"{label} changed during held read")
    return StableFile(
        raw=b"".join(chunks),
        sha256=digest.hexdigest(),
        size=before.st_size,
        mode=before.st_mode,
        device=before.st_dev,
        inode=before.st_ino,
        uid=before.st_uid,
        gid=before.st_gid,
    )


def close_held_files(files: Sequence[HeldFile]) -> None:
    first: OSError | None = None
    for file in files:
        try:
            os.close(file.fd)
        except OSError as exc:
            if first is None:
                first = exc
    if first is not None:
        raise first


def atomic_copy_bytes(
    destination: Path,
    source: StableFile,
    label: str,
    mode: int = 0o400,
) -> StableFile:
    if mode not in (0o400, 0o500):
        fail(f"{label} copy mode is outside contract")
    exact_absent_file(destination, label)
    temporary = destination.with_name(destination.name + ".partial")
    exact_absent_file(temporary, label + " temporary")
    write_exclusive(temporary, source.raw, mode)
    try:
        temporary_file = stable_read(
            temporary,
            label + " temporary",
            MAX_TARGET_OUTPUT_BYTES,
        )
        if (
            temporary_file.sha256 != source.sha256
            or temporary_file.size != source.size
        ):
            fail(f"{label} temporary copy mismatch")
        os.link(temporary, destination, follow_symlinks=False)
        os.unlink(temporary)
        directory_fd = os.open(
            destination.parent,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except BaseException:
        if temporary.exists() and not temporary.is_symlink():
            os.unlink(temporary)
        raise
    copied = stable_read(destination, label, MAX_TARGET_OUTPUT_BYTES)
    if (
        copied.raw != source.raw
        or copied.sha256 != source.sha256
        or stat.S_IMODE(copied.mode) != mode
        or copied.mode & (stat.S_ISUID | stat.S_ISGID)
    ):
        fail(f"{label} authority copy mismatch")
    return copied


def validate_closed_work_tree(
    root: Path,
    expected_files: set[Path],
) -> None:
    if not root.is_absolute() or root.resolve(strict=True) != root:
        fail("target work root is not absolute and canonical")
    if any(path.parent != root for path in expected_files):
        fail("target work tree authority escapes its root")
    if set(root.iterdir()) != expected_files:
        fail("target work tree contains a stray artifact")
    for path in expected_files:
        info = os.stat(path, follow_symlinks=False)
        if not stat.S_ISREG(info.st_mode):
            fail("target work tree contains a non-regular artifact")


def write_exclusive(path: Path, raw: bytes, mode: int = 0o400) -> None:
    exact_absent_file(path, "output")
    flags = (
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | os.O_NOFOLLOW
    )
    fd = os.open(path, flags, mode)
    try:
        os.fchmod(fd, mode)
        offset = 0
        while offset < len(raw):
            written = os.write(fd, raw[offset:])
            if written <= 0:
                fail("output short write")
            offset += written
        os.fsync(fd)
    finally:
        os.close(fd)


def parse_canonical_json(
    file: StableFile,
    label: str,
) -> dict[str, Any]:
    if not file.raw.endswith(b"\n"):
        fail(f"{label} lacks terminal newline")
    try:
        value = json.loads(file.raw.decode("utf-8", "strict"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise WrapperError(f"{label} is not strict JSON") from exc
    if not isinstance(value, dict) or canonical_json(value) + b"\n" != file.raw:
        fail(f"{label} is not canonical JSON")
    return value


def canonical_stage23_relative_path(raw: Any, label: str) -> str:
    if (
        not isinstance(raw, str)
        or not raw
        or "\x00" in raw
        or "\n" in raw
        or "\r" in raw
    ):
        fail(f"{label} is invalid")
    path = Path(raw)
    if (
        path.is_absolute()
        or path.as_posix() != raw
        or any(part in ("", ".", "..") for part in raw.split("/"))
    ):
        fail(f"{label} is not canonical")
    return raw


def stage23_declared_file_mode_valid(kind: Any, mode: Any) -> bool:
    if not isinstance(mode, int) or isinstance(mode, bool):
        return False
    if kind == "executable":
        return mode in (0o500, 0o555)
    if kind == "regular":
        return mode in (0o400, 0o444)
    return False


def parse_stage23_action_binding(
    manifest_path: Path,
    manifest_pair_commitment_path: Path,
    expected_authority_manifest_sha256: str,
    expected_manifest_sha256: str,
    expected_manifest_pair_commitment_sha256: str,
    expected_plan_sha256: str,
    evidence_root: Path,
) -> Stage23ActionBinding:
    manifest = stable_read(
        manifest_path,
        "stage23 action input manifest",
        256 * 1024 * 1024,
    )
    if manifest.sha256 != canonical_nonzero_sha256(
        expected_manifest_sha256,
        "stage23 action input manifest",
    ):
        fail("stage23 action input manifest identity mismatch")
    manifest_pair_commitment = stable_read(
        manifest_pair_commitment_path,
        "stage23 manifest pair commitment",
        64 * 1024,
    )
    if manifest_pair_commitment.sha256 != canonical_nonzero_sha256(
        expected_manifest_pair_commitment_sha256,
        "stage23 manifest pair commitment",
    ):
        fail("stage23 manifest pair commitment identity mismatch")
    authority_manifest_sha256 = canonical_nonzero_sha256(
        expected_authority_manifest_sha256,
        "stage23 authority manifest",
    )
    plan_sha = canonical_nonzero_sha256(
        expected_plan_sha256,
        "stage23 phase plan",
    )
    value = parse_canonical_json(manifest, "stage23 action input manifest")
    phase_index = value.get("phaseIndex")
    phase_label = value.get("phaseLabel")
    plan = value.get("phasePlan")
    if (
        set(value) != STAGE23_INPUT_FIELDS
        or value.get("schema") != STAGE23_INPUT_SCHEMA
        or value.get("lane") != STAGE23_LANE
        or value.get("targetTriple") != STAGE23_TARGET_TRIPLE
        or value.get("machineAuthority") != STAGE23_MACHINE_AUTHORITY
        or value.get("phasePlanSha256") != plan_sha
        or not isinstance(plan, dict)
        or sha256_bytes(canonical_json(plan)) != plan_sha
        or not isinstance(phase_index, int)
        or isinstance(phase_index, bool)
        or not 0 <= phase_index < 16
        or not isinstance(phase_label, str)
        or not phase_label
        or plan.get("lane") != STAGE23_LANE
        or plan.get("targetTriple") != STAGE23_TARGET_TRIPLE
        or plan.get("machineAuthority") != STAGE23_MACHINE_AUTHORITY
        or plan.get("phaseIndex") != phase_index
        or plan.get("phaseLabel") != phase_label
    ):
        fail("stage23 action input scalar contract mismatch")
    if (
        not evidence_root.is_absolute()
        or evidence_root.resolve(strict=True) != evidence_root
        or evidence_root.is_symlink()
        or not evidence_root.is_dir()
        or evidence_root != STAGE23_EVIDENCE_GUEST_PATH
    ):
        fail("stage23 action evidence root mismatch")
    action_argv_raw = value.get("runnerArgv")
    action_argv = (
        "/bin/bash",
        str(STAGE23_INNER_GUEST_PATH),
        "--run-phase-action",
        "--stage-input-manifest",
        str(STAGE23_INPUT_GUEST_PATH),
        "--stage-plan-sha256",
        plan_sha,
        "--evidence-dir",
        str(STAGE23_EVIDENCE_GUEST_PATH),
    )
    action_env = (
        "HOME=/nonexistent",
        "LANG=C",
        "LC_ALL=C",
        "PATH=/usr/bin:/bin",
        "TZ=UTC",
    )
    phase_command_argv = value.get("phaseCommandArgv")
    phase_env = value.get("phaseEnv")
    runner_argv_sha256 = canonical_nonzero_sha256(
        value.get("runnerArgvSha256"),
        "stage23 runner argv",
    )
    phase_command_argv_sha256 = canonical_nonzero_sha256(
        value.get("phaseCommandArgvSha256"),
        "stage23 phase command argv",
    )
    phase_env_sha256 = canonical_nonzero_sha256(
        value.get("phaseEnvSha256"),
        "stage23 phase environment",
    )
    if (
        not isinstance(action_argv_raw, list)
        or tuple(action_argv_raw) != action_argv
        or runner_argv_sha256
            != stage23_guard_argv_sha256(action_argv)
        or not isinstance(phase_command_argv, list)
        or not all(isinstance(item, str) for item in phase_command_argv)
        or phase_command_argv != plan.get("argv")
        or phase_command_argv_sha256
            != stage23_guard_argv_sha256(phase_command_argv)
        or not isinstance(phase_env, list)
        or phase_env != plan.get("env")
        or phase_env_sha256 != stage23_guard_env_sha256(phase_env)
    ):
        fail("stage23 action argv/env mismatch")
    directories_raw = value.get("declaredDeltaDirectories")
    files_raw = value.get("declaredDeltaFiles")
    if not isinstance(directories_raw, list) or not isinstance(files_raw, list):
        fail("stage23 declared delta is absent")
    directories = tuple(
        canonical_stage23_relative_path(item, "stage23 expected directory")
        for item in directories_raw
    )
    if (
        directories != tuple(sorted(directories, key=os.fsencode))
        or len(set(directories)) != len(directories)
    ):
        fail("stage23 expected directories are not sorted and unique")
    declared_files: list[dict[str, Any]] = []
    roles: set[str] = set()
    file_paths: set[str] = set()
    declared_file_schemas = (
        frozenset(("role", "relativePath", "kind", "finalMode")),
        frozenset((
            "role",
            "relativePath",
            "kind",
            "finalMode",
            "producerActionIndex",
        )),
    )
    for item in files_raw:
        if not isinstance(item, dict) or set(item) not in declared_file_schemas:
            fail("stage23 expected file schema mismatch")
        role = item["role"]
        relative = canonical_stage23_relative_path(
            item["relativePath"],
            "stage23 expected file",
        )
        kind = item["kind"]
        mode = item["finalMode"]
        producer_index = item.get("producerActionIndex")
        if (
            not isinstance(role, str)
            or not re.fullmatch(r"[a-z][a-z0-9_]*", role)
            or role in roles
            or not stage23_declared_file_mode_valid(kind, mode)
            or relative in file_paths
            or (
                producer_index is not None
                and (
                    not isinstance(producer_index, int)
                    or isinstance(producer_index, bool)
                    or producer_index < 0
                )
            )
        ):
            fail("stage23 expected file identity mismatch")
        roles.add(role)
        file_paths.add(relative)
        declared_files.append(dict(item))
    terminal_relative = canonical_stage23_relative_path(
        value.get("terminalRelativePath"),
        "stage23 terminal",
    )
    if (
        terminal_relative
        != f"phase-receipts/{phase_index:02d}/terminal.json"
        or terminal_relative not in file_paths
        or plan.get("terminalRelativePath") != terminal_relative
        or plan.get("declaredDeltaDirectories") != directories_raw
        or plan.get("declaredDeltaFiles") != files_raw
        or plan.get("outputs") != value.get("plannedOutputs")
        or plan.get("actions") != value.get("phaseActions")
    ):
        fail("stage23 terminal path mismatch")
    declared_output_set_sha256 = canonical_nonzero_sha256(
        value.get("declaredOutputSetSha256"),
        "stage23 declared output set",
    )
    if plan.get("declaredOutputSetSha256") != declared_output_set_sha256:
        fail("stage23 declared output set mismatch")
    planned_outputs_raw = value.get("plannedOutputs")
    phase_actions_raw = value.get("phaseActions")
    if (
        not isinstance(planned_outputs_raw, list)
        or not isinstance(phase_actions_raw, list)
        or any(not isinstance(item, dict) for item in planned_outputs_raw)
        or any(not isinstance(item, dict) for item in phase_actions_raw)
    ):
        fail("stage23 action/output plan is absent")
    declared_by_role = {item["role"]: item for item in declared_files}
    planned_roles: set[str] = set()
    for item in planned_outputs_raw:
        if set(item) != {
            "role",
            "pathFshex",
            "kind",
            "finalMode",
            "producerActionIndex",
        }:
            fail("stage23 planned output schema mismatch")
        role = item["role"]
        try:
            guest_path = Path(os.fsdecode(bytes.fromhex(item["pathFshex"])))
            relative = guest_path.relative_to(
                STAGE23_EVIDENCE_GUEST_PATH
            ).as_posix()
        except (TypeError, ValueError, UnicodeError) as exc:
            raise WrapperError(
                "stage23 planned output path is invalid"
            ) from exc
        declared = declared_by_role.get(role)
        if (
            role in planned_roles
            or declared is None
            or declared["relativePath"] != relative
            or declared["kind"] != item["kind"]
            or declared["finalMode"] != item["finalMode"]
            or not isinstance(item["producerActionIndex"], int)
            or isinstance(item["producerActionIndex"], bool)
        ):
            fail("stage23 planned output identity mismatch")
        planned_roles.add(role)
    action_count = len(phase_actions_raw)
    for expected_index, item in enumerate(phase_actions_raw):
        if (
            item.get("actionIndex") != expected_index
            or not isinstance(item.get("kind"), str)
            or not isinstance(item.get("operation"), str)
            or not isinstance(item.get("outputRoles"), list)
            or any(
                not isinstance(role, str)
                for role in item.get("outputRoles", ())
            )
        ):
            fail("stage23 phase action identity mismatch")
    if any(
        item.get("producerActionIndex") is not None
        and item["producerActionIndex"] >= action_count
        for item in declared_files
    ):
        fail("stage23 producer action index is out of range")
    files = sorted(
        (
            {
                "role": item["role"],
                "relativePath": item["relativePath"],
                "kind": item["kind"],
                "mode": item["finalMode"],
            }
            for item in declared_files
            if item["relativePath"] != terminal_relative
            and item["role"] not in STAGE23_EXTERNAL_PROOF_ROLES
        ),
        key=lambda item: item["role"],
    )
    delta = {
        "directories": list(directories),
        "files": files,
    }
    return Stage23ActionBinding(
        manifest=manifest,
        manifest_pair_commitment=manifest_pair_commitment,
        authority_manifest_sha256=authority_manifest_sha256,
        phase_plan_sha256=plan_sha,
        phase_index=phase_index,
        phase_label=phase_label,
        target_triple=STAGE23_TARGET_TRIPLE,
        machine_authority=STAGE23_MACHINE_AUTHORITY,
        evidence_root=evidence_root,
        action_argv=action_argv,
        action_env=action_env,
        runner_argv_sha256=runner_argv_sha256,
        phase_command_argv_sha256=phase_command_argv_sha256,
        phase_env_sha256=phase_env_sha256,
        expected_directories=directories,
        expected_files=tuple(files),
        declared_delta_files=tuple(declared_files),
        declared_output_set_sha256=declared_output_set_sha256,
        phase_actions=tuple(phase_actions_raw),
        planned_outputs=tuple(planned_outputs_raw),
        terminal_relative_path=terminal_relative,
        declared_delta_sha256=sha256_bytes(canonical_json(delta)),
    )


def stage23_tree_snapshot(
    root: Path,
    *,
    excluded_relative_path: str,
) -> tuple[dict[str, Any], str]:
    excluded = root / excluded_relative_path
    directories: list[dict[str, Any]] = []
    files: list[dict[str, Any]] = []
    inode_keys: set[tuple[int, int]] = set()
    pending = [root]
    while pending:
        directory = pending.pop()
        relative_directory = directory.relative_to(root).as_posix()
        if relative_directory != ".":
            info = os.stat(directory, follow_symlinks=False)
            if not stat.S_ISDIR(info.st_mode):
                fail("stage23 evidence tree directory changed type")
            directories.append({
                "relativePath": relative_directory,
                "device": info.st_dev,
                "inode": info.st_ino,
                "mode": stat.S_IMODE(info.st_mode),
            })
        with os.scandir(directory) as iterator:
            children = sorted(
                list(iterator),
                key=lambda item: os.fsencode(item.name),
                reverse=True,
            )
        for child in children:
            path = directory / child.name
            if path == excluded:
                continue
            info = os.stat(child, follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode):
                pending.append(path)
                continue
            if not stat.S_ISREG(info.st_mode):
                fail("stage23 evidence tree contains non-regular entry")
            file = stable_read(
                path,
                "stage23 evidence file",
                MAX_TARGET_OUTPUT_BYTES,
            )
            after = os.stat(path, follow_symlinks=False)
            inode_key = (file.device, file.inode)
            if inode_key in inode_keys:
                fail("stage23 evidence tree contains a hard-link alias")
            inode_keys.add(inode_key)
            files.append({
                "relativePath": path.relative_to(root).as_posix(),
                "sha256": file.sha256,
                "size": file.size,
                "device": file.device,
                "inode": file.inode,
                "mode": stat.S_IMODE(file.mode),
                "mtimeNs": after.st_mtime_ns,
                "ctimeNs": after.st_ctime_ns,
            })
    directories.sort(key=lambda item: os.fsencode(item["relativePath"]))
    files.sort(key=lambda item: os.fsencode(item["relativePath"]))
    value = {"directories": directories, "files": files}
    return value, sha256_bytes(canonical_json(value))


def validate_stage23_action_result(
    binding: Stage23ActionBinding,
    before: dict[str, Any],
    before_sha256: str,
    target_stdout: StableFile,
    target_stderr: StableFile,
) -> tuple[StableFile, dict[str, Any]]:
    terminal_path = binding.evidence_root / binding.terminal_relative_path
    terminal = stable_read(
        terminal_path,
        "stage23 phase terminal",
        MAX_TARGET_OUTPUT_BYTES,
    )
    if stat.S_IMODE(terminal.mode) != 0o400:
        fail("stage23 phase terminal mode mismatch")
    after, after_sha256 = stage23_tree_snapshot(
        binding.evidence_root,
        excluded_relative_path=binding.terminal_relative_path,
    )
    before_directories = {
        item["relativePath"]: item for item in before["directories"]
    }
    after_directories = {
        item["relativePath"]: item for item in after["directories"]
    }
    before_files = {item["relativePath"]: item for item in before["files"]}
    after_files = {item["relativePath"]: item for item in after["files"]}
    expected_directories = set(binding.expected_directories)
    expected_files = {
        item["relativePath"]: item for item in binding.expected_files
    }
    if (
        not set(before_directories).isdisjoint(expected_directories)
        or not set(before_files).isdisjoint(expected_files)
        or set(after_directories) - set(before_directories)
        != expected_directories
        or set(after_files) - set(before_files) != set(expected_files)
        or set(before_directories) - set(after_directories)
        or set(before_files) - set(after_files)
    ):
        fail("stage23 phase evidence tree delta mismatch")
    if any(
        after_directories[path] != row
        for path, row in before_directories.items()
    ) or any(after_files[path] != row for path, row in before_files.items()):
        fail("stage23 phase replaced or modified prior evidence")
    outputs: list[dict[str, Any]] = []
    for expected in binding.expected_files:
        observed = after_files[expected["relativePath"]]
        if (
            observed["mode"] != expected["mode"]
            or (
                expected["kind"] == "executable"
                and not observed["mode"] & 0o100
            )
            or (
                expected["kind"] == "regular"
                and observed["mode"] & 0o111
            )
        ):
            fail("stage23 phase output kind/mode mismatch")
        outputs.append({
            "role": expected["role"],
            "relativePath": expected["relativePath"],
            "kind": expected["kind"],
            "sha256": observed["sha256"],
            "size": observed["size"],
            "mode": observed["mode"],
            "device": observed["device"],
            "inode": observed["inode"],
        })
    output_set_sha256 = sha256_bytes(canonical_json(outputs))
    value = parse_canonical_json(terminal, "stage23 phase terminal")
    payload = value.get("payload")
    payload_sha256 = value.get("payloadSha256")
    produced: list[dict[str, Any]] = []
    for planned in binding.planned_outputs:
        guest_path = Path(os.fsdecode(bytes.fromhex(planned["pathFshex"])))
        relative = guest_path.relative_to(
            STAGE23_EVIDENCE_GUEST_PATH
        ).as_posix()
        path = binding.evidence_root / relative
        artifact = stable_read(
            path,
            "stage23 planned output " + planned["role"],
            MAX_TARGET_OUTPUT_BYTES,
        )
        info = os.stat(path, follow_symlinks=False)
        expected_mode = planned["finalMode"]
        if (
            artifact.size <= 0
            or stat.S_IMODE(artifact.mode) != expected_mode
            or info.st_nlink != 1
        ):
            fail("stage23 planned output final identity mismatch")
        produced.append({
            "role": planned["role"],
            "identity": {
                "pathFshex": planned["pathFshex"],
                "sha256": artifact.sha256,
                "device": artifact.device,
                "inode": artifact.inode,
                "mode": artifact.mode,
                "nlink": info.st_nlink,
                "size": artifact.size,
                "uid": artifact.uid,
                "gid": artifact.gid,
                "format": (
                    stage23_executable_format(artifact.raw)
                    if planned["kind"] == "executable" else "regular"
                ),
            },
        })
    actions = [{
        "actionIndex": item["actionIndex"],
        "kind": item["kind"],
        "operation": item["operation"],
        "status": (
            "PENDING_OUTER_PROOF"
            if item["kind"] == "runner_authority" else "PROVED"
        ),
        "outputRoles": item["outputRoles"],
    } for item in binding.phase_actions]
    guard_rows = [
        item for item in binding.expected_files
        if item["role"] == "phase_guard_receipt"
    ]
    if len(guard_rows) != 1:
        fail("stage23 guard receipt output is not unique")
    guard_receipt = stable_read(
        binding.evidence_root / guard_rows[0]["relativePath"],
        "stage23 phase guard receipt",
        MAX_TARGET_OUTPUT_BYTES,
    )
    expected_payload = {
        "schema": STAGE23_TERMINAL_SCHEMA,
        "status": STATUS,
        "lane": STAGE23_LANE,
        "targetTriple": binding.target_triple,
        "machineAuthority": binding.machine_authority,
        "phaseIndex": binding.phase_index,
        "phaseLabel": binding.phase_label,
        "phasePlanSha256": binding.phase_plan_sha256,
        "runnerArgvSha256": binding.runner_argv_sha256,
        "phaseCommandArgvSha256":
            binding.phase_command_argv_sha256,
        "guardReceiptSha256": guard_receipt.sha256,
        "phaseEnvSha256": binding.phase_env_sha256,
        "stageInputManifestSha256": binding.manifest.sha256,
        "terminalRelativePath": binding.terminal_relative_path,
        "declaredDeltaDirectories":
            list(binding.expected_directories),
        "declaredDeltaFiles": list(binding.declared_delta_files),
        "declaredOutputSetSha256":
            binding.declared_output_set_sha256,
        "actions": actions,
        "produced": produced,
    }
    if (
        set(value) != {"payload", "payloadSha256"}
        or not isinstance(payload, dict)
        or set(payload) != STAGE23_TERMINAL_FIELDS
        or payload != expected_payload
        or payload_sha256 != sha256_bytes(canonical_json(payload))
        or target_stdout.raw != terminal.raw
        or target_stderr.raw
    ):
        fail("stage23 phase terminal receipt mismatch")
    return terminal, {
        "pre_tree_sha256": before_sha256,
        "post_tree_sha256": after_sha256,
        "declared_delta_sha256": binding.declared_delta_sha256,
        "output_set_sha256": output_set_sha256,
        "output_count": str(len(outputs)),
        "terminal_receipt_sha256": str(payload_sha256),
    }


def parse_exact_lines(
    raw: bytes,
    keys: Sequence[str],
    label: str,
) -> dict[str, str]:
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeDecodeError as exc:
        raise WrapperError(f"{label} is not UTF-8") from exc
    rows: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if not separator or not key or key in rows:
            fail(f"{label} row is invalid")
        rows[key] = value
    if tuple(rows) != tuple(keys):
        fail(f"{label} field order is not exact")
    return rows


def parse_unique_report(raw: bytes, label: str) -> dict[str, str]:
    if not raw or raw.endswith(b"\n"):
        fail(f"{label} terminal newline contract mismatch")
    try:
        lines = raw.decode("utf-8", "strict").split("\n")
    except UnicodeDecodeError as exc:
        raise WrapperError(f"{label} is not UTF-8") from exc
    rows: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if (
            not separator
            or not REPORT_KEY_RE.fullmatch(key)
            or key in rows
            or "\r" in value
        ):
            fail(f"{label} malformed or duplicate row")
        rows[key] = value
    return rows


def parse_unique_dry_report(raw: bytes) -> dict[str, str]:
    if not raw or raw.endswith(b"\n"):
