#!/usr/bin/env bash
set -euo pipefail

repo_root=${1:-$(cd "$(dirname "$0")/.." && pwd -P)}

/usr/bin/python3 - "$repo_root" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
files = {
    "system": root / "src/std/system.cheng",
    "backend": root / "src/core/runtime/program_support_backend.cheng",
    "provider": root / "src/core/runtime/production_held_exec_provider.cheng",
    "launcher": root / "src/core/csg_core/production_launcher.cheng",
    "capability": root / "src/core/runtime/production_system_link_capability.cheng",
}
for path in files.values():
    if not path.is_file() or path.is_symlink() or path.stat().st_nlink != 1:
        raise SystemExit("four-frame gate: invalid input: " + str(path))
src = {name: path.read_text(encoding="utf-8") for name, path in files.items()}

def fail(reason: str) -> None:
    raise SystemExit("four-frame gate: " + reason)

def fn(text: str, name: str) -> str:
    match = re.search(r"(?m)^(?:@[A-Za-z_]+(?:\([^\n]*\))?\n)*fn\s+" + re.escape(name) + r"\(", text)
    if match is None:
        fail("function missing: " + name)
    following = re.search(r"(?m)^(?:@[A-Za-z_]+(?:\([^\n]*\))?\n)*fn\s+", text[match.end():])
    end = len(text) if following is None else match.end() + following.start()
    return text[match.start():end]

def ordered(text: str, markers: tuple[str, ...], label: str) -> None:
    cursor = -1
    for marker in markers:
        cursor = text.find(marker, cursor + 1)
        if cursor < 0:
            fail(label + ":" + marker)

def held_wire_call_census(text: str) -> dict[str, list[str]]:
    starts = list(re.finditer(
        r"(?m)^(?:@[A-Za-z_]+(?:\([^\n]*\))?\n)*fn\s+([A-Za-z0-9_]+)\(",
        text))
    out: dict[str, list[str]] = {}
    for index, match in enumerate(starts):
        end = starts[index + 1].start() if index + 1 < len(starts) else len(text)
        body = text[match.start():end]
        calls = re.findall(
            r"\b(cheng_held_exec_(?:send_wire(?:_with_fd)?|receive_[A-Za-z0-9_]+))\(",
            body)
        if calls and calls[0] == match.group(1):
            calls = calls[1:]
        if calls:
            out[match.group(1)] = calls
    return out

for name in (
    "RuntimeHeldExecParentBeginClaim",
    "RuntimeHeldExecParentActivateAfterOwnerClaim",
    "RuntimeHeldExecParentFinish",
    "RuntimeHeldExecParentResolve",
):
    body = fn(src["system"], name)
    if "Bridge(" not in body:
        fail("system bridge missing: " + name)

backend = src["backend"]
wire_census = held_wire_call_census(backend)
expected_wire_census = {
    "cheng_held_exec_receive_wire": [
        "cheng_held_exec_receive_wire_with_optional_fd"],
    "cheng_held_exec_receive_wire_from": [
        "cheng_held_exec_receive_wire"],
    "cheng_held_exec_receive_wire_with_optional_fd_from": [
        "cheng_held_exec_receive_wire_with_optional_fd"],
    "cheng_held_exec_receive_wire_or_child_exit": [
        "cheng_held_exec_receive_wire"],
    "cheng_held_exec_receive_wire_or_child_exit_from": [
        "cheng_held_exec_receive_wire_or_child_exit"],
    "cheng_held_exec_receive_terminal_or_child_exit_from": [
        "cheng_held_exec_receive_wire_with_optional_fd_from"],
    "cheng_held_exec_child_import_export": [
        "cheng_held_exec_send_wire",
        "cheng_held_exec_receive_wire_with_optional_fd"],
    "cheng_held_exec_child_finish_export": [
        "cheng_held_exec_send_wire_with_fd",
        "cheng_held_exec_send_wire",
        "cheng_held_exec_receive_wire"],
    "cheng_held_exec_parent_begin_claim_export": [
        "cheng_held_exec_receive_wire_or_child_exit"],
    "cheng_held_exec_parent_activate_after_owner_claim_export": [
        "cheng_held_exec_send_wire_with_fd"],
    "cheng_held_exec_parent_finish_export": [
        "cheng_held_exec_receive_terminal_or_child_exit_from"],
    "cheng_held_exec_parent_resolve_export": [
        "cheng_held_exec_send_wire"],
}
if wire_census != expected_wire_census:
    fail("held wire callsite census drift:" + repr(wire_census))
low_level = {
    "libc_send_fd_runtime(": "cheng_held_exec_send_wire_with_fd",
    "libc_recv_credentialed_optional_fd_runtime(":
        "cheng_held_exec_receive_wire_with_optional_fd",
}
for token, owner in low_level.items():
    if backend.count(token) != 2 or token not in fn(backend, owner):
        fail("held wire low-level owner drift:" + token)
if "sendmsg(" in backend or "recvmsg(" in backend:
    fail("raw sendmsg/recvmsg bypass")
kind_names = re.findall(r"(?m)^    (chengHeldExecKind[A-Za-z0-9_]+): uint64 =", backend)
if kind_names != [
    "chengHeldExecKindClaim",
    "chengHeldExecKindActivate",
    "chengHeldExecKindFinished",
    "chengHeldExecKindCommitted",
    "chengHeldExecKindAborted",
]:
    fail("extra or reordered wire kind:" + ",".join(kind_names))
for state in (
    "chengHeldExecParentSessionBuilding",
    "chengHeldExecParentSessionClaimed",
    "chengHeldExecParentSessionActivated",
    "chengHeldExecParentSessionFinished",
    "chengHeldExecParentSessionCommitted",
    "chengHeldExecParentSessionAborted",
):
    if state not in backend:
        fail("backend state missing: " + state)
for export in (
    'cheng_held_exec_parent_begin_claim_export(',
    'cheng_held_exec_parent_activate_after_owner_claim_export(',
    'cheng_held_exec_parent_finish_export(',
    'cheng_held_exec_parent_resolve_export(',
):
    if backend.count(export) != 1:
        fail("backend frame export drift: " + export)
plan_bind = fn(backend, "cheng_held_exec_child_bind_plan_receipt_export")
if re.findall(r"\bcheng_held_exec_(?:send_wire(?:_with_fd)?|receive_[A-Za-z0-9_]+)\(", plan_bind):
    fail("plan binding performed wire I/O")
child_import = fn(backend, "cheng_held_exec_child_import_export")
parent_begin = fn(backend, "cheng_held_exec_parent_begin_claim_export")
parent_activate = fn(
    backend, "cheng_held_exec_parent_activate_after_owner_claim_export")
child_finish = fn(backend, "cheng_held_exec_child_finish_export")
parent_resolve = fn(backend, "cheng_held_exec_parent_resolve_export")
def send_calls(text: str) -> list[str]:
    return re.findall(r"\bcheng_held_exec_send_wire(?:_with_fd)?\(", text)
def receive_calls(text: str) -> list[str]:
    return re.findall(r"\bcheng_held_exec_receive_[A-Za-z0-9_]+\(", text)
if send_calls(child_import) != ["cheng_held_exec_send_wire("] or \
   receive_calls(child_import) != [
       "cheng_held_exec_receive_wire_with_optional_fd("]:
    fail("CLAIM/ACTIVATE child wire positions drift")
if receive_calls(parent_begin) != [
       "cheng_held_exec_receive_wire_or_child_exit("] or send_calls(parent_begin):
    fail("CLAIM parent wire position drift")
if send_calls(parent_activate) != ["cheng_held_exec_send_wire_with_fd("] or \
   receive_calls(parent_activate):
    fail("ACTIVATE parent wire position drift")
if send_calls(child_finish) != [
       "cheng_held_exec_send_wire_with_fd(",
       "cheng_held_exec_send_wire("] or \
   receive_calls(child_finish) != ["cheng_held_exec_receive_wire("] or \
   "terminal, 416, chengHeldExecChildPlanEvidenceDigest" not in child_finish or \
   "416 + fieldIndex" in child_finish or \
   "chengHeldExecChildPlanWire" in child_finish:
    fail("FINISHED plan receipt projection drift")
parent_finish = fn(backend, "cheng_held_exec_parent_finish_export")
if receive_calls(parent_finish) != [
       "cheng_held_exec_receive_terminal_or_child_exit_from("] or \
   send_calls(parent_finish):
    fail("parent consumed more than FINISHED")
if send_calls(parent_resolve) != ["cheng_held_exec_send_wire("] or \
   receive_calls(parent_resolve):
    fail("terminal decision wire position drift")
if "let planReceipt = cheng_held_exec_plan_binding_receipt(" not in parent_finish or \
   "!cheng_fixed32_equal(planReceipt, claimedPlanReceipt)" not in parent_finish or \
   "let planReceipt = claimedPlanReceipt" in parent_finish:
    fail("FINISHED plan receipt is not joined to authenticated claim")

provider = src["provider"]
if "fn CsgCoreProductionAdmittedInputClaimInto(" in provider:
    fail("independent claim edge restored")
issue = fn(provider, "CsgCoreProductionHeldExecProviderIssueAdmittedInputInto")
ordered(issue, (
    "productionPreExecInputOwnerAcquireInto(",
    "CsgCoreProductionPreExecActivationBundleDecodeStrictInto(",
    "productionAdmittedInputSlotHeldBundleCids[slot] =",
    "productionPreExecInputOwnerCommitConsumed(ownerHandle)",
    "CsgCoreProductionAdmittedInputStateIssued",
), "ISSUED")
claim = fn(provider, "CsgCoreProductionAdmittedInputClaimAndActivateInto")
ordered(claim, (
    "RuntimeHeldExecParentClaimEvidence(parentSession)",
    "productionAdmittedInputSlotClaimOwners[slot], 0, 1",
    "productionAdmittedInputSlotChildProcessPids[slot] = claim.childPid",
    "productionAdmittedInputSlotClaimReceiptCids[slot] =",
    "CsgCoreProductionAdmittedInputStateClaimed",
    "RuntimeHeldExecParentActivateAfterOwnerClaim(",
), "CLAIM/ACTIVATE")
prepare = fn(provider, "CsgCoreProductionAdmittedInputPrepareCommitInto")
ordered(prepare, (
    "RuntimeHeldExecParentClaimEvidence(parentSession)",
    "RuntimeHeldExecParentPhaseFinished",
    "CsgCoreProductionAdmittedInputStateClaimed",
    "CsgCoreProductionAdmittedInputStateFinished",
), "FINISHED")
finalize = fn(provider, "CsgCoreProductionAdmittedInputFinalizeCommitInto")
ordered(finalize, (
    "RuntimeHeldExecParentClaimEvidence(parentSession)",
    "RuntimeHeldExecParentPhaseCommitted",
    "CsgCoreProductionAdmittedInputStateFinished",
    "CsgCoreProductionAdmittedInputStateCommitted",
), "COMMITTED")
abort = fn(provider, "CsgCoreProductionAdmittedInputAbortInto")
for required in (
    "RuntimeHeldExecParentPhaseAborted",
    "CsgCoreProductionAdmittedInputStateAborted",
):
    if required not in abort:
        fail("ABORTED path missing: " + required)

parent = fn(src["launcher"], "CsgCoreProductionLauncherRunAdmittedSystemLinkExecParentInto")
ordered(parent, (
    "CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(",
    "CsgCoreProductionHeldExecBeginClaimInto(",
    "CsgCoreProductionAdmittedInputClaimAndActivateInto(",
    "CsgCoreProductionHeldExecFinishInto(",
    "CsgCoreProductionAdmittedInputPrepareCommitInto(",
    "CsgCoreProductionHeldExecResolveInto(",
    "CsgCoreProductionAdmittedInputFinalizeCommitInto(",
), "parent four frames")
if parent.count("CsgCoreProductionHeldExecResolveInto(") != 8:
    fail("terminal decision count drift")
if "CsgCoreProductionPreExecInputChildTakeAndImportInto(" not in provider:
    fail("child local import missing")
if "CsgCoreProductionPreExecInputChildValidateAndConsumeInto(" not in src["capability"]:
    fail("child local consume missing")

print("four-frame gate: PASS")
print("frame_positions=4:CLAIM->ACTIVATE->FINISHED->COMMITTED|ABORTED")
print("legal_tags=5:CLAIM,ACTIVATE,FINISHED,COMMITTED,ABORTED")
print("child_local_owner=int32_soa_single_consume")
print("plan_evidence_handle_status=pass")
print("finished_plan_projection=receipt_only")
print("persistent_terminal_journal_status=HARD_RED")
PY
