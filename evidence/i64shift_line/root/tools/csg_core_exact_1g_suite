def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        allow_nan=False,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise SuiteError("duplicate_json_key:" + key)
        result[key] = value
    return result


def parse_json(raw: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8", "strict"),
            object_pairs_hook=strict_object,
            parse_constant=lambda item: (_ for _ in ()).throw(
                SuiteError(label + "_non_finite:" + item)
            ),
        )
    except (UnicodeError, ValueError) as error:
        raise SuiteError(label + "_json_invalid") from error
    if not isinstance(value, dict):
        raise SuiteError(label + "_not_object")
    return value


def require_text(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or "\x00" in value
        or len(value.encode("utf-8")) > MAX_TEXT_BYTES
    ):
        raise SuiteError(label + "_invalid")
    return value


def require_id(value: Any, label: str) -> str:
    text = require_text(value, label)
    if ID_RE.fullmatch(text) is None:
        raise SuiteError(label + "_invalid")
    return text


def require_uint(
    value: Any,
    label: str,
    *,
    minimum: int = 0,
    maximum: int | None = None,
) -> int:
    if type(value) is not int or value < minimum:
        raise SuiteError(label + "_invalid")
    if maximum is not None and value > maximum:
        raise SuiteError(label + "_invalid")
    return value


def require_sha(value: Any, label: str) -> str:
    if not isinstance(value, str) or SHA_RE.fullmatch(value) is None:
        raise SuiteError(label + "_invalid")
    return value


def identity_tuple(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def require_canonical_absolute(path: Path, label: str) -> Path:
    if not path.is_absolute():
        raise SuiteError(label + "_not_absolute")
    try:
        resolved = path.resolve(strict=True)
    except OSError as error:
        raise SuiteError(label + "_missing") from error
    if resolved != path:
        raise SuiteError(label + "_not_physical")
    return path


def file_snapshot(
    path: Path,
    label: str,
    *,
    executable: bool = False,
    allow_empty: bool = False,
    max_bytes: int = MAX_ARTIFACT_BYTES,
    capture: bool = False,
) -> tuple[dict[str, Any], bytes | None]:
    require_canonical_absolute(path, label)
    before = path.stat(follow_symlinks=False)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or before.st_size > max_bytes
        or (not allow_empty and before.st_size == 0)
        or (executable and before.st_mode & 0o111 == 0)
    ):
        raise SuiteError(label + "_identity_invalid")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    digest = hashlib.sha256()
    chunks: list[bytes] | None = [] if capture else None
    try:
        opened = os.fstat(descriptor)
        if identity_tuple(opened) != identity_tuple(before):
            raise SuiteError(label + "_open_race")
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise SuiteError(label + "_short_read")
            digest.update(chunk)
            if chunks is not None:
                chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise SuiteError(label + "_grew_during_read")
        closed = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    after = path.stat(follow_symlinks=False)
    if (
        identity_tuple(before) != identity_tuple(opened)
        or identity_tuple(before) != identity_tuple(closed)
        or identity_tuple(before) != identity_tuple(after)
    ):
        raise SuiteError(label + "_read_race")
    identity = {
        "path": str(path),
        "pathFshex": os.fsencode(str(path)).hex(),
        "sha256": digest.hexdigest(),
        "size": before.st_size,
        "device": before.st_dev,
        "inode": before.st_ino,
        "mode": before.st_mode,
        "mtimeNs": before.st_mtime_ns,
        "ctimeNs": before.st_ctime_ns,
    }
    return identity, None if chunks is None else b"".join(chunks)


def file_identity(
    path: Path,
    label: str,
    *,
    executable: bool = False,
    allow_empty: bool = False,
    max_bytes: int = MAX_ARTIFACT_BYTES,
) -> dict[str, Any]:
    identity, _raw = file_snapshot(
        path,
        label,
        executable=executable,
        allow_empty=allow_empty,
        max_bytes=max_bytes,
    )
    return identity


def read_canonical(path: Path, label: str, max_bytes: int) -> tuple[dict[str, Any], dict[str, Any]]:
    identity, raw = file_snapshot(
        path,
        label,
        max_bytes=max_bytes,
        capture=True,
    )
    if raw is None:
        raise SuiteError(label + "_capture_missing")
    value = parse_json(raw, label)
    if canonical_json(value) + b"\n" != raw:
        raise SuiteError(label + "_not_canonical")
    return value, identity


def binding_identity(value: Any, command_id: str, index: int) -> dict[str, Any]:
    label = f"command_{command_id}_binding_{index}"
    if not isinstance(value, dict) or set(value) != {"id", "path", "roles", "sha256"}:
        raise SuiteError(label + "_keys_invalid")
    binding_id = require_id(value["id"], label + "_id")
    roles = value["roles"]
    if (
        not isinstance(roles, list)
        or not roles
        or roles != sorted(set(roles))
        or any(role not in PATH_ROLES for role in roles)
    ):
        raise SuiteError(label + "_roles_invalid")
    path = Path(require_text(value["path"], label + "_path"))
    identity = file_identity(
        path,
        label,
        executable=("executable" in roles or "compiler" in roles),
    )
    claimed = require_sha(value["sha256"], label + "_sha256")
    if identity["sha256"] != claimed:
        raise SuiteError(label + "_hash_mismatch")
    return {"id": binding_id, "roles": roles, **identity}


def artifact_contract(
    value: Any,
    command_id: str,
    index: int,
    *,
    allow_existing: bool,
) -> dict[str, Any]:
    label = f"command_{command_id}_artifact_{index}"
    expected = {"comparisonGroup", "id", "kind", "metricKeys", "path"}
    if not isinstance(value, dict) or set(value) != expected:
        raise SuiteError(label + "_keys_invalid")
    artifact_id = require_id(value["id"], label + "_id")
    kind = require_text(value["kind"], label + "_kind")
    if kind not in ARTIFACT_KINDS:
        raise SuiteError(label + "_kind_invalid")
    group = value["comparisonGroup"]
    if not isinstance(group, str) or "\x00" in group:
        raise SuiteError(label + "_comparison_group_invalid")
    if group and ID_RE.fullmatch(group) is None:
        raise SuiteError(label + "_comparison_group_invalid")
    metric_keys = value["metricKeys"]
    if (
        not isinstance(metric_keys, list)
        or metric_keys != sorted(set(metric_keys))
        or any(ID_RE.fullmatch(item) is None for item in metric_keys)
    ):
        raise SuiteError(label + "_metric_keys_invalid")
    path_text = value["path"]
    if kind in {"gate_stdout", "gate_stderr"}:
        if path_text != "" or metric_keys or group:
            raise SuiteError(label + "_stream_contract_invalid")
    else:
        path = Path(require_text(path_text, label + "_path"))
        if not path.is_absolute():
            raise SuiteError(label + "_path_not_absolute")
        if not allow_existing and (path.exists() or path.is_symlink()):
            raise SuiteError(label + "_path_must_not_exist")
        if allow_existing and path.is_symlink():
            raise SuiteError(label + "_path_symlink_forbidden")
        parent = require_canonical_absolute(path.parent, label + "_parent")
        if parent != path.parent:
            raise SuiteError(label + "_parent_not_physical")
        if kind == "performance":
            if not metric_keys or group:
                raise SuiteError(label + "_performance_contract_invalid")
        elif metric_keys:
            raise SuiteError(label + "_nonperformance_metrics_invalid")
    return {
        "id": artifact_id,
        "kind": kind,
        "path": path_text,
        "comparisonGroup": group,
        "metricKeys": metric_keys,
    }


def embedded_absolute_path(argument: str) -> Path | None:
    candidates = [argument]
    for separator in ("=", ":"):
        if separator in argument:
            candidates.append(argument.split(separator, 1)[1])
    for candidate in candidates:
        if candidate.startswith("/"):
            return Path(candidate)
    return None


def validate_command(
    value: Any,
    index: int,
    *,
    allow_existing_artifacts: bool,
) -> tuple[dict[str, Any], dict[str, Any]]:
    expected = {
        "argv",
        "bindings",
        "cwd",
        "env",
        "expectedArtifacts",
        "id",
        "obligation",
        "timeoutSeconds",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise SuiteError(f"command_{index}_keys_invalid")
    command_id = require_id(value["id"], f"command_{index}_id")
    obligation = require_id(value["obligation"], f"command_{index}_obligation")
    argv = value["argv"]
    if (
        not isinstance(argv, list)
        or not argv
        or len(argv) > MAX_ARGV
        or any(
            not isinstance(item, str)
            or not item
            or "\x00" in item
            or len(item.encode("utf-8")) > MAX_TEXT_BYTES
            for item in argv
        )
    ):
        raise SuiteError(f"command_{command_id}_argv_invalid")
    cwd = Path(require_text(value["cwd"], f"command_{command_id}_cwd"))
    require_canonical_absolute(cwd, f"command_{command_id}_cwd")
    if not cwd.is_dir():
        raise SuiteError(f"command_{command_id}_cwd_not_directory")
    raw_env = value["env"]
    if not isinstance(raw_env, dict) or len(raw_env) > 1024:
        raise SuiteError(f"command_{command_id}_env_invalid")
    env: dict[str, str] = {}
    for key, item in raw_env.items():
        if not isinstance(key, str) or ENV_RE.fullmatch(key) is None:
            raise SuiteError(f"command_{command_id}_env_key_invalid")
        env[key] = require_text(item, f"command_{command_id}_env_{key}")
    timeout = require_uint(
        value["timeoutSeconds"],
        f"command_{command_id}_timeout",
        minimum=1,
        maximum=MAX_TIMEOUT_SECONDS,
    )
    raw_bindings = value["bindings"]
    if not isinstance(raw_bindings, list) or not raw_bindings:
        raise SuiteError(f"command_{command_id}_bindings_invalid")
    bindings = [
        binding_identity(item, command_id, binding_index)
        for binding_index, item in enumerate(raw_bindings)
    ]
    binding_ids = [item["id"] for item in bindings]
    if binding_ids != sorted(set(binding_ids)):
        raise SuiteError(f"command_{command_id}_binding_ids_invalid")
    binding_paths = [item["path"] for item in bindings]
    if len(binding_paths) != len(set(binding_paths)):
        raise SuiteError(f"command_{command_id}_binding_paths_duplicate")
    executables = [item for item in bindings if "executable" in item["roles"]]
    if len(executables) != 1 or executables[0]["path"] != argv[0]:
        raise SuiteError(f"command_{command_id}_executable_binding_invalid")
    declared_paths = set(binding_paths)
    raw_artifacts = value["expectedArtifacts"]
    if not isinstance(raw_artifacts, list) or not raw_artifacts:
        raise SuiteError(f"command_{command_id}_artifacts_invalid")
    artifacts = [
        artifact_contract(
            item,
            command_id,
            artifact_index,
            allow_existing=allow_existing_artifacts,
        )
        for artifact_index, item in enumerate(raw_artifacts)
    ]
    artifact_ids = [item["id"] for item in artifacts]
    if artifact_ids != sorted(set(artifact_ids)):
        raise SuiteError(f"command_{command_id}_artifact_ids_invalid")
    output_paths = {item["path"] for item in artifacts if item["path"]}
    bindings_by_path = {item["path"]: item for item in bindings}
    for argument_index, argument in enumerate(argv):
        candidate = embedded_absolute_path(argument)
        if candidate is None or str(candidate) in output_paths:
            continue
        if candidate.exists() and candidate.is_file() and str(candidate) not in declared_paths:
            raise SuiteError(f"command_{command_id}_argv_file_unbound")
        if candidate.exists() and candidate.is_file() and argument_index > 0:
            bound = bindings_by_path.get(str(candidate))
            if bound is None or not (
                {"compiler", "input", "script", "source", "tool"}
                & set(bound["roles"])
            ):
                raise SuiteError(f"command_{command_id}_argv_file_role_invalid")
    for item in env.values():
        candidate = embedded_absolute_path(item)
        if (
            candidate is not None
            and candidate.exists()
            and candidate.is_file()
            and str(candidate) not in declared_paths
        ):
            raise SuiteError(f"command_{command_id}_env_file_unbound")
    manifest_command = {
        "id": command_id,
        "argv": argv,
        "cwd": str(cwd),
        "env": env,
        "timeoutSeconds": timeout,
    }
    plan_command = {
        "id": command_id,
        "obligation": obligation,
        "argv": argv,
        "cwd": str(cwd),
        "env": env,
        "timeoutSeconds": timeout,
        "bindings": bindings,
        "expectedArtifacts": artifacts,
    }
    return manifest_command, plan_command


def canonical_source_path(obligation: str) -> Path:
    if obligation in PURE_SOURCES:
        return PURE_SOURCES[obligation]
    if obligation in REQUIRED_OBLIGATIONS:
        return WORKLOAD_SOURCE
    raise SuiteError("suite_config_unknown_obligation:" + obligation)


def canonical_artifact_shape(
    obligation: str,
    artifacts: list[dict[str, Any]],
) -> tuple[str, dict[str, Any]]:
    if len(artifacts) != 1:
        raise SuiteError(
            "suite_config_artifact_cardinality_invalid:" + obligation
        )
    artifact = artifacts[0]
    if obligation in PURE_OBLIGATIONS:
        expected = {
            "id": "stdout",
            "kind": "gate_stdout",
            "path": "",
            "comparisonGroup": "",
            "metricKeys": [],
        }
        if artifact != expected:
            raise SuiteError(
                "suite_config_artifact_contract_invalid:" + obligation
            )
        return "", expected

    path = Path(artifact["path"])
    if obligation in {
        "deterministic-export-a",
        "deterministic-export-b",
    }:
        expected = {
            "id": "csgc",
            "kind": "file",
            "path": str(path),
            "comparisonGroup": "deterministic-export",
            "metricKeys": [],
        }
        suffix = ".csgc"
    elif obligation in NEGATIVE_OBLIGATIONS:
        expected = {
            "id": "rejection",
            "kind": "negative",
            "path": str(path),
            "comparisonGroup": "",
            "metricKeys": [],
        }
        suffix = ".negative.json"
    elif obligation == "performance":
        expected = {
            "id": "measurement",
            "kind": "performance",
            "path": str(path),
            "comparisonGroup": "",
            "metricKeys": PERFORMANCE_METRICS,
        }
        suffix = ".performance.json"
    elif obligation == "canonical-conformance":
        expected = {
            "id": "receipt",
            "kind": "workload",
            "path": str(path),
            "comparisonGroup": "",
            "metricKeys": [],
        }
        suffix = ".receipt.json"
    else:
        raise SuiteError(
            "suite_config_artifact_contract_unknown:" + obligation
        )
    if artifact != expected or path.name != obligation + suffix:
        raise SuiteError(
            "suite_config_artifact_contract_invalid:" + obligation
        )
    return str(path), expected


def validate_canonical_command(command: dict[str, Any]) -> None:
    obligation = command["obligation"]
    if command["id"] != obligation:
        raise SuiteError(
            "suite_config_command_id_not_obligation:" + obligation
        )
    source_path = canonical_source_path(obligation)
    artifact_path, _artifact = canonical_artifact_shape(
        obligation,
        command["expectedArtifacts"],
    )
    expected_bindings = [
        {
            "id": "cheng-compiler",
            "path": str(CANONICAL_COMPILER),
            "roles": ["compiler"],
        },
        {
            "id": "workload-entrypoint",
            "path": str(WORKLOAD_ENTRYPOINT),
            "roles": ["executable", "script", "tool"],
        },
        {
            "id": "workload-source",
            "path": str(source_path),
            "roles": ["input", "source"],
        },
    ]
    actual_bindings = [
        {
            "id": item["id"],
            "path": item["path"],
            "roles": item["roles"],
        }
        for item in command["bindings"]
    ]
    if actual_bindings != expected_bindings:
        raise SuiteError(
            "suite_config_canonical_bindings_invalid:" + obligation
        )
    expected_argv = [
        str(WORKLOAD_ENTRYPOINT),
        "--compiler",
        str(CANONICAL_COMPILER),
        "--obligation",
        obligation,
    ]
    if artifact_path:
        expected_argv.extend(["--artifact", artifact_path])
    if command["argv"] != expected_argv:
        raise SuiteError(
            "suite_config_canonical_argv_invalid:" + obligation
        )
    if command["cwd"] != str(ROOT):
        raise SuiteError(
            "suite_config_canonical_cwd_invalid:" + obligation
        )
    if command["env"] != CANONICAL_WORKLOAD_ENV:
        raise SuiteError(
            "suite_config_canonical_env_invalid:" + obligation
        )
    if command["timeoutSeconds"] != COMMAND_TIMEOUT_SECONDS:
        raise SuiteError(
            "suite_config_canonical_timeout_invalid:" + obligation
        )


def validate_suite_config(
    value: dict[str, Any],
    *,
    allow_existing_artifacts: bool = False,
) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    if set(value) != {
        "commands",
        "limitBytes",
        "runGid",
        "runUid",
        "schema",
    }:
        raise SuiteError("suite_config_keys_invalid")
    if value["schema"] != CONFIG_SCHEMA:
        raise SuiteError("suite_config_schema_invalid")
    if type(value["limitBytes"]) is not int or value["limitBytes"] != LIMIT_BYTES:
        raise SuiteError("suite_config_limit_bytes_invalid")
    run_uid = require_uint(
        value["runUid"],
        "suite_config_run_uid",
        minimum=1,
        maximum=2_147_483_647,
    )
    run_gid = require_uint(
        value["runGid"],
        "suite_config_run_gid",
        minimum=1,
        maximum=2_147_483_647,
    )
    raw_commands = value["commands"]
    if (
        not isinstance(raw_commands, list)
        or not raw_commands
        or len(raw_commands) > MAX_COMMANDS
    ):
        raise SuiteError("suite_config_commands_invalid")
    manifest_commands: list[dict[str, Any]] = []
    plan_commands: list[dict[str, Any]] = []
    for index, item in enumerate(raw_commands):
        manifest_command, plan_command = validate_command(
            item,
            index,
            allow_existing_artifacts=allow_existing_artifacts,
        )
        manifest_commands.append(manifest_command)
        plan_commands.append(plan_command)
    command_ids = [item["id"] for item in plan_commands]
    if command_ids != sorted(set(command_ids)):
        raise SuiteError("suite_config_command_ids_not_unique_sorted")
    obligations = [item["obligation"] for item in plan_commands]
    missing = sorted(set(REQUIRED_OBLIGATIONS) - set(obligations))
    duplicate_required = sorted(
        item for item in REQUIRED_OBLIGATIONS if obligations.count(item) != 1
    )
    extra = sorted(set(obligations) - set(REQUIRED_OBLIGATIONS))
    if (
        missing
        or duplicate_required
        or extra
        or len(obligations) != len(REQUIRED_OBLIGATIONS)
    ):
        raise SuiteError(
            "suite_config_required_obligations_invalid:"
            + ",".join(missing + duplicate_required + extra)
        )
    for command in plan_commands:
        validate_canonical_command(command)
        for artifact in command["expectedArtifacts"]:
            if not artifact["path"]:
                continue
            parent = Path(artifact["path"]).parent
            info = parent.stat(follow_symlinks=False)
            if (
                not stat.S_ISDIR(info.st_mode)
                or info.st_uid != run_uid
                or info.st_gid != run_gid
                or info.st_mode & 0o077 != 0
                or info.st_mode & 0o700 != 0o700
            ):
                raise SuiteError(
                    "suite_config_artifact_parent_authority_invalid:"
                    + command["id"]
                )
    compiler_paths = {
        binding["path"]
        for command in plan_commands
        for binding in command["bindings"]
        if "compiler" in binding["roles"]
    }
    if compiler_paths != {str(CANONICAL_COMPILER)}:
        raise SuiteError("suite_config_compiler_binding_invalid")
    source_count = sum(
        1
        for command in plan_commands
        for binding in command["bindings"]
        if "source" in binding["roles"]
    )
    if source_count == 0:
        raise SuiteError("suite_config_source_binding_missing")
    groups: dict[str, list[tuple[str, dict[str, Any]]]] = {}
    artifact_paths: list[str] = []
    for command in plan_commands:
        for artifact in command["expectedArtifacts"]:
            if artifact["path"]:
                artifact_paths.append(artifact["path"])
            if artifact["comparisonGroup"]:
                groups.setdefault(artifact["comparisonGroup"], []).append(
                    (command["obligation"], artifact)
                )
    deterministic = groups.get("deterministic-export", [])
    if len(deterministic) != 2 or {
        item[0] for item in deterministic
    } != {"deterministic-export-a", "deterministic-export-b"} or any(
        item[1]["kind"] != "file" for item in deterministic
    ):
        raise SuiteError("suite_config_deterministic_pair_invalid")
    if len(artifact_paths) != len(set(artifact_paths)):
        raise SuiteError("suite_config_artifact_paths_duplicate")
    performance_commands = [
        item for item in plan_commands if item["obligation"] == "performance"
    ]
    if not any(
        artifact["kind"] == "performance"
        for command in performance_commands
        for artifact in command["expectedArtifacts"]
    ):
        raise SuiteError("suite_config_performance_artifact_missing")
    for command in plan_commands:
        if command["obligation"] in NEGATIVE_OBLIGATIONS and not any(
            artifact["kind"] == "negative"
            for artifact in command["expectedArtifacts"]
        ):
            raise SuiteError("suite_config_negative_receipt_missing:" + command["id"])
    manifest = {
        "schema": GATE_MANIFEST_SCHEMA,
        "limitBytes": LIMIT_BYTES,
        "runUid": run_uid,
        "runGid": run_gid,
        "commands": manifest_commands,
    }
    return manifest, plan_commands


def binding_set(
    commands: list[dict[str, Any]],
    role: str,
) -> list[dict[str, Any]]:
    by_identity: dict[tuple[str, str], dict[str, Any]] = {}
    for command in commands:
        for binding in command["bindings"]:
            if role not in binding["roles"]:
                continue
            key = (binding["path"], binding["sha256"])
            by_identity[key] = {
                key_name: binding[key_name]
                for key_name in (
                    "path",
                    "pathFshex",
                    "sha256",
                    "size",
                    "device",
                    "inode",
                    "mode",
                    "mtimeNs",
                    "ctimeNs",
                )
            }
    return [by_identity[key] for key in sorted(by_identity)]


def canonical_semantic_source_set() -> list[dict[str, Any]]:
    paths = [
        ROOT / "cheng-package.toml",
        CSGC_STRICT_NEGATIVE_SOURCE,
    ]
    for directory in (
        ROOT / "src/core/csg_core",
        ROOT / "src/core/runtime",
        ROOT / "src/std",
    ):
        paths.extend(
            path
            for path in directory.rglob("*.cheng")
            if path.is_file()
        )
    by_path = {
        str(path): file_identity(
            path,
            "canonical_semantic_source",
        )
        for path in sorted(set(paths))
    }
    return [by_path[key] for key in sorted(by_path)]


def framed_identity_sha256(items: list[dict[str, Any]]) -> str:
    digest = hashlib.sha256()
    digest.update(len(items).to_bytes(8, "big"))
    for item in items:
        raw = canonical_json(item)
        digest.update(len(raw).to_bytes(8, "big"))
        digest.update(raw)
    return digest.hexdigest()


def build_plan(
    config_path: Path,
    config_identity: dict[str, Any],
    commands: list[dict[str, Any]],
) -> dict[str, Any]:
    source_map = {
        (item["path"], item["sha256"]): item
        for item in (
            binding_set(commands, "source")
            + canonical_semantic_source_set()
        )
    }
    sources = [
        source_map[key] for key in sorted(source_map)
    ]
    compilers = binding_set(commands, "compiler")
    tools = (
        binding_set(commands, "tool")
        + binding_set(commands, "script")
        + binding_set(commands, "executable")
    )
    automatic_tools = [
        file_identity(SUITE_SOURCE, "suite_source", executable=True),
        file_identity(GATE, "suite_gate", executable=True),
        file_identity(GATE_VALIDATOR, "suite_gate_validator", executable=True),
        file_identity(
            COMPILER_AUTHORITY_VERIFIER,
            "compiler_authority_verifier",
            executable=True,
        ),
        file_identity(
            COMPILER_AUTHORITY_PRODUCTION_GATE,
            "compiler_authority_production_gate",
            executable=True,
        ),
    ]
    tool_map = {
        (item["path"], item["sha256"]): item for item in tools + automatic_tools
    }
    plan = {
        "schema": PLAN_SCHEMA,
        "limitBytes": LIMIT_BYTES,
        "compilerAuthorityVerifier": file_identity(
            COMPILER_AUTHORITY_VERIFIER,
            "plan_compiler_authority_verifier",
            executable=True,
        ),
        "configPathFshex": os.fsencode(str(config_path)).hex(),
        "configIdentity": config_identity,
        "sourceSetSha256": framed_identity_sha256(sources),
        "compilerSetSha256": framed_identity_sha256(compilers),
        "toolSetSha256": framed_identity_sha256(
            [tool_map[key] for key in sorted(tool_map)]
        ),
        "sources": sources,
        "compilers": compilers,
        "tools": [tool_map[key] for key in sorted(tool_map)],
        "commands": commands,
    }
    plan["planSha256"] = hashlib.sha256(canonical_json(plan)).hexdigest()
    return plan


def build_gate_manifest(
    run_uid: int,
    run_gid: int,
    commands: list[dict[str, Any]],
    plan_path: Path,
    plan_sha256: str,
) -> dict[str, Any]:
    return {
        "schema": GATE_MANIFEST_SCHEMA,
        "limitBytes": LIMIT_BYTES,
        "runUid": run_uid,
        "runGid": run_gid,
        "commands": [
            {
                "id": command["id"],
                "argv": [
                    str(SUITE_SOURCE),
                    "--execute-suite-command",
                    "--plan",
                    str(plan_path),
                    "--expected-plan-sha256",
                    plan_sha256,
                    "--command-id",
                    command["id"],
                ],
                "cwd": command["cwd"],
                "env": command["env"],
                "timeoutSeconds": command["timeoutSeconds"],
            }
            for command in commands
        ],
    }


def load_config(
    path: Path,
    *,
    allow_existing_artifacts: bool = False,
) -> tuple[dict[str, Any], dict[str, Any], list[dict[str, Any]]]:
    value, identity = read_canonical(path, "suite_config", MAX_CONFIG_BYTES)
    manifest, commands = validate_suite_config(
        value,
        allow_existing_artifacts=allow_existing_artifacts,
    )
    return manifest, identity, commands


def write_exclusive(path: Path, raw: bytes, label: str) -> None:
    if not path.is_absolute():
        raise SuiteError(label + "_not_absolute")
    require_canonical_absolute(path.parent, label + "_parent")
    descriptor = os.open(
        path,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def produce(config_path: Path, manifest_out: Path, plan_out: Path) -> dict[str, Any]:
    require_canonical_absolute(config_path, "suite_config")
    if manifest_out == plan_out:
        raise SuiteError("suite_outputs_alias")
    config_manifest, config_identity, commands = load_config(config_path)
    plan = build_plan(
        config_path,
        config_identity,
        commands,
    )
    gate_manifest = build_gate_manifest(
        config_manifest["runUid"],
        config_manifest["runGid"],
        commands,
        plan_out,
        plan["planSha256"],
    )
    manifest_raw = canonical_json(gate_manifest) + b"\n"
    write_exclusive(plan_out, canonical_json(plan) + b"\n", "plan_out")
    try:
        os.chmod(plan_out, 0o444)
        write_exclusive(manifest_out, manifest_raw, "manifest_out")
    except BaseException:
        plan_out.unlink()
        raise
    return plan


def read_and_revalidate_plan(
    config_path: Path,
    manifest_path: Path,
    plan_path: Path,
) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    plan, _plan_identity = read_canonical(plan_path, "suite_plan", MAX_CONFIG_BYTES)
    if set(plan) != PLAN_KEYS or plan["schema"] != PLAN_SCHEMA:
        raise SuiteError("suite_plan_shape_invalid")
    claimed_plan_sha = require_sha(plan["planSha256"], "suite_plan_sha256")
    unsealed = dict(plan)
    del unsealed["planSha256"]
    if hashlib.sha256(canonical_json(unsealed)).hexdigest() != claimed_plan_sha:
        raise SuiteError("suite_plan_sha256_mismatch")
    config_fshex = require_text(plan["configPathFshex"], "suite_plan_config_path")
    try:
        bound_config = Path(os.fsdecode(bytes.fromhex(config_fshex)))
    except (ValueError, UnicodeError) as error:
        raise SuiteError("suite_plan_config_path_invalid") from error
    if bound_config != config_path:
        raise SuiteError("suite_plan_config_path_mismatch")
    config_manifest, config_identity, commands = load_config(
        config_path,
        allow_existing_artifacts=True,
    )
    expected = build_plan(
        config_path,
        config_identity,
        commands,
    )
    if expected != plan:
        raise SuiteError("suite_plan_projection_or_identity_drift")
    expected_manifest = build_gate_manifest(
        config_manifest["runUid"],
        config_manifest["runGid"],
        commands,
        plan_path,
        plan["planSha256"],
    )
    manifest_raw = canonical_json(expected_manifest) + b"\n"
    manifest_identity = file_identity(
        manifest_path,
        "suite_manifest",
        max_bytes=MAX_CONFIG_BYTES,
    )
    if (
        manifest_identity["sha256"] != hashlib.sha256(manifest_raw).hexdigest()
        or manifest_identity["size"] != len(manifest_raw)
    ):
        raise SuiteError("suite_manifest_binding_mismatch")
    _manifest_identity, captured_manifest = file_snapshot(
        manifest_path,
        "suite_manifest_bytes",
        max_bytes=MAX_CONFIG_BYTES,
        capture=True,
    )
    if captured_manifest != manifest_raw:
        raise SuiteError("suite_manifest_bytes_mismatch")
    return plan, commands


def validate_plan_seal(plan: dict[str, Any], expected_sha256: str) -> None:
    if set(plan) != PLAN_KEYS or plan.get("schema") != PLAN_SCHEMA:
        raise SuiteError("suite_adapter_plan_shape_invalid")
    claimed = require_sha(plan.get("planSha256"), "suite_adapter_plan_sha256")
    if claimed != require_sha(expected_sha256, "suite_adapter_expected_plan_sha256"):
        raise SuiteError("suite_adapter_plan_expected_hash_mismatch")
    payload = dict(plan)
    del payload["planSha256"]
    if hashlib.sha256(canonical_json(payload)).hexdigest() != claimed:
        raise SuiteError("suite_adapter_plan_seal_invalid")
    if plan.get("limitBytes") != LIMIT_BYTES:
        raise SuiteError("suite_adapter_limit_invalid")


def validate_bound_command_files(command: dict[str, Any], phase: str) -> None:
    bindings = command.get("bindings")
    if not isinstance(bindings, list) or not bindings:
        raise SuiteError("suite_adapter_bindings_invalid")
    for index, binding in enumerate(bindings):
        if not isinstance(binding, dict):
            raise SuiteError("suite_adapter_binding_invalid")
        roles = binding.get("roles")
        if not isinstance(roles, list):
            raise SuiteError("suite_adapter_binding_roles_invalid")
        current = file_identity(
            Path(require_text(binding.get("path"), "suite_adapter_binding_path")),
            f"suite_adapter_{phase}_binding_{index}",
            executable=("executable" in roles or "compiler" in roles),
        )
        expected = {
            key: binding.get(key)
            for key in (
                "path",
                "pathFshex",
                "sha256",
                "size",
                "device",
                "inode",
                "mode",
                "mtimeNs",
                "ctimeNs",
            )
        }
        if current != expected:
            raise SuiteError(
                "suite_adapter_binding_identity_drift:"
                + phase
                + ":"
                + str(binding.get("id", index))
            )


def validate_plan_file_sets(plan: dict[str, Any], phase: str) -> None:
    for set_name, executable in (
        ("compilers", True),
        ("sources", False),
        ("tools", False),
    ):
        items = plan.get(set_name)
        if not isinstance(items, list) or not items:
            raise SuiteError(
                "suite_adapter_plan_file_set_invalid:"
                + set_name
            )
        for index, expected in enumerate(items):
            if not isinstance(expected, dict):
                raise SuiteError(
                    "suite_adapter_plan_file_invalid:"
                    + set_name
                )
            current = file_identity(
                Path(
                    require_text(
                        expected.get("path"),
                        "suite_adapter_plan_file_path",
                    )
                ),
                "suite_adapter_"
                + phase
                + "_"
                + set_name
                + "_"
                + str(index),
                executable=executable,
            )
            if current != expected:
                raise SuiteError(
                    "suite_adapter_plan_file_identity_drift:"
                    + phase
                    + ":"
                    + set_name
                    + ":"
                    + str(index)
                )


def validate_adapter_artifacts(command: dict[str, Any], *, before: bool) -> None:
    artifacts = command.get("expectedArtifacts")
    if not isinstance(artifacts, list) or not artifacts:
        raise SuiteError("suite_adapter_artifacts_invalid")
    for artifact in artifacts:
        path_text = artifact.get("path") if isinstance(artifact, dict) else None
        if path_text == "":
            continue
        path = Path(require_text(path_text, "suite_adapter_artifact_path"))
        if before:
            if path.exists() or path.is_symlink():
                raise SuiteError("suite_adapter_output_preexists")
            continue
        if artifact.get("kind") == "performance":
            read_performance(path, artifact.get("metricKeys"))
        elif artifact.get("kind") == "negative":
            read_negative(path, command["obligation"])
        elif artifact.get("kind") == "workload":
            read_workload(path, command["obligation"])
        else:
            file_identity(path, "suite_adapter_output", allow_empty=True)


def csgc_strict_negative_target() -> str:
    if sys.platform != "linux":
        raise SuiteError("csgc_strict_negative_linux_required")
    machine = os.uname().machine
    if machine == "x86_64":
        return "x86_64-unknown-linux-gnu"
    if machine in {"aarch64", "arm64"}:
        return "aarch64-unknown-linux-gnu"
    raise SuiteError("csgc_strict_negative_arch_unsupported:" + machine)


def compile_csgc_strict_negative_entry(
    compiler: Path,
    source: Path,
    executable: Path,
    report: Path,
    target: str,
    env: dict[str, str],
) -> None:
    result = subprocess.run(
        [
            str(compiler),
            "system-link-exec",
            "--root:" + str(ROOT),
            "--in:" + str(source.relative_to(ROOT)),
            "--emit:exe",
            "--target:" + target,
            "--out:" + str(executable),
            "--report-out:" + str(report),
        ],
        cwd=ROOT,
        env=env,
        check=False,
    )
    if result.returncode != 0:
        raise SuiteError(
            "csgc_strict_negative_compile_failed:"
            + source.name
            + ":"
            + str(result.returncode)
        )
    file_identity(
        executable,
        "csgc_strict_negative_executable",
        executable=True,
    )
    file_identity(report, "csgc_strict_negative_compile_report")


def csgc_strict_negative_cli_argv(
    executable: Path,
    operation: str,
    carrier: Path,
    output: Path,
) -> list[str]:
    if operation == "validate":
        return [
            str(executable),
            "validate",
            "--mode",
            "strict",
            str(carrier),
        ]
    if operation == "unpack":
        return [
            str(executable),
            "unpack",
            "--out",
            str(output),
            str(carrier),
        ]
    if operation == "edit":
        return [
            str(executable),
            "edit",
            "delete",
            "--id",
            "a",
            "--out",
            str(output),
            str(carrier),
        ]
    raise SuiteError(
        "csgc_strict_negative_operation_unknown:" + operation
    )


def run_csgc_strict_negative_obligation(
    command: dict[str, Any],
) -> None:
    case = CSGC_STRICT_NEGATIVE_OBLIGATION_CASES.get(
        command["obligation"]
    )
    if case is None:
        return
    case_name, expected_error = case
    compiler_bindings = [
        item
        for item in command["bindings"]
        if "compiler" in item["roles"]
    ]
    if len(compiler_bindings) != 1:
        raise SuiteError("csgc_strict_negative_compiler_binding_invalid")
    compiler = Path(compiler_bindings[0]["path"])
    env = command["env"]
    target = csgc_strict_negative_target()
    with tempfile.TemporaryDirectory(
        prefix="csg-core-csgc-strict-negative-",
        dir=env["TMPDIR"],
    ) as raw_work_root:
        work_root = Path(raw_work_root)
        fixture_executable = work_root / "fixture"
        fixture_report = work_root / "fixture.report"
        cli_executable = work_root / "csg"
        cli_report = work_root / "csg.report"
        compile_csgc_strict_negative_entry(
            compiler,
            CSGC_STRICT_NEGATIVE_SOURCE,
            fixture_executable,
            fixture_report,
            target,
            env,
        )
        compile_csgc_strict_negative_entry(
            compiler,
            CSGC_CLI_SOURCE,
            cli_executable,
            cli_report,
            target,
            env,
        )

        carrier = work_root / (case_name + ".csgc")
        generated = subprocess.run(
            [str(fixture_executable), case_name, str(carrier)],
            cwd=ROOT,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        expected_fixture_stdout = (
            "csg_core_csgc_strict_negative_fixture ok case="
            + case_name
            + " error="
            + expected_error
            + "\n"
        ).encode("utf-8")
        if (
            generated.returncode != 0
            or generated.stdout != expected_fixture_stdout
            or generated.stderr != b""
        ):
            raise SuiteError(
                "csgc_strict_negative_fixture_failed:"
                + case_name
                + ":"
                + str(generated.returncode)
            )
        file_identity(
            carrier,
            "csgc_strict_negative_carrier",
            max_bytes=MAX_SMALL_BYTES,
        )

        expected_stderr = ("error: " + expected_error + "\n").encode(
            "utf-8"
        )
        for operation in ("validate", "unpack", "edit"):
            observations: list[tuple[int, bytes, bytes]] = []
            for attempt in range(2):
                output = work_root / (
                    operation + "." + str(attempt) + ".output"
                )
                result = subprocess.run(
                    csgc_strict_negative_cli_argv(
                        cli_executable,
                        operation,
                        carrier,
                        output,
                    ),
                    cwd=ROOT,
                    env=env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                observation = (
                    result.returncode,
                    result.stdout,
                    result.stderr,
                )
                observations.append(observation)
                if (
                    observation != (1, b"", expected_stderr)
                    or output.exists()
                    or output.is_symlink()
                ):
                    raise SuiteError(
                        "csgc_strict_negative_cli_rejection_invalid:"
                        + case_name
                        + ":"
                        + operation
                        + ":"
                        + str(attempt)
                    )
            if observations[0] != observations[1]:
                raise SuiteError(
                    "csgc_strict_negative_cli_rejection_unstable:"
                    + case_name
                    + ":"
                    + operation
                )
    print(
        "csgc_strict_negative_cli=passed"
        + " case="
        + case_name
        + " error="
        + expected_error
    )


def execute_suite_command(
    plan_path: Path,
    expected_plan_sha256: str,
    command_id: str,
) -> int:
    plan, identity = read_canonical(plan_path, "suite_adapter_plan", MAX_CONFIG_BYTES)
    if identity["sha256"] != expected_plan_sha256:
        raise SuiteError("suite_adapter_plan_file_hash_mismatch")
    validate_plan_seal(plan, expected_plan_sha256)
    commands = plan["commands"]
    if not isinstance(commands, list):
        raise SuiteError("suite_adapter_commands_invalid")
    matches = [
        command
        for command in commands
        if isinstance(command, dict) and command.get("id") == command_id
    ]
    if len(matches) != 1:
        raise SuiteError("suite_adapter_command_id_invalid")
    command = matches[0]
    if Path.cwd().resolve(strict=True) != Path(command["cwd"]):
        raise SuiteError("suite_adapter_cwd_mismatch")
    validate_plan_file_sets(plan, "before")
    validate_bound_command_files(command, "before")
    validate_adapter_artifacts(command, before=True)
    argv = command.get("argv")
    if not isinstance(argv, list) or not argv:
        raise SuiteError("suite_adapter_argv_invalid")
    result = subprocess.run(
        argv,
        cwd=command["cwd"],
        env=command["env"],
        check=False,
    )
    if result.returncode != 0:
        return result.returncode
    run_csgc_strict_negative_obligation(command)
    validate_adapter_artifacts(command, before=False)
    validate_bound_command_files(command, "after")
    validate_plan_file_sets(plan, "after")
    return 0


def read_performance(path: Path, metric_keys: list[str]) -> dict[str, Any]:
    value, identity = read_canonical(path, "performance_artifact", MAX_SMALL_BYTES)
    if set(value) != {"metrics", "schema"} or value["schema"] != PERFORMANCE_SCHEMA:
        raise SuiteError("performance_artifact_shape_invalid")
    metrics = value["metrics"]
    if not isinstance(metrics, dict) or sorted(metrics) != metric_keys:
        raise SuiteError("performance_artifact_metric_keys_invalid")
    for key, metric in metrics.items():
        if (
            not isinstance(key, str)
            or ID_RE.fullmatch(key) is None
            or isinstance(metric, bool)
            or not isinstance(metric, (int, float))
            or not math.isfinite(metric)
            or metric < 0
        ):
            raise SuiteError("performance_artifact_metric_invalid:" + str(key))
    return {"identity": identity, "metrics": metrics}


def read_workload(path: Path, obligation: str) -> dict[str, Any]:
    value, identity = read_canonical(path, "workload_artifact", MAX_SMALL_BYTES)
    if set(value) != {
        "factsRoot",
        "obligation",
        "schema",
        "status",
    } or value["schema"] != WORKLOAD_SCHEMA:
        raise SuiteError("workload_artifact_shape_invalid")
    if (
        value["obligation"] != obligation
        or value["status"] != "passed"
        or not isinstance(value["factsRoot"], str)
        or CID_RE.fullmatch(value["factsRoot"]) is None
    ):
        raise SuiteError("workload_artifact_contract_invalid")
    return {
        "identity": identity,
        "factsRoot": value["factsRoot"],
    }


def read_negative(path: Path, obligation: str) -> dict[str, Any]:
    value, identity = read_canonical(path, "negative_artifact", MAX_SMALL_BYTES)
    if set(value) != {
        "firstErrorCode",
        "obligation",
        "rejected",
        "schema",
        "secondErrorCode",
    } or value["schema"] != NEGATIVE_SCHEMA:
        raise SuiteError("negative_artifact_shape_invalid")
    if value["obligation"] != obligation or value["rejected"] is not True:
        raise SuiteError("negative_artifact_obligation_or_status_invalid")
    first = require_text(value["firstErrorCode"], "negative_first_error_code")
    second = require_text(value["secondErrorCode"], "negative_second_error_code")
    if first != second:
        raise SuiteError("negative_artifact_rejection_not_stable")
    return {"identity": identity, "errorCode": first}


def validate_pure_stdout(
    evidence: Path,
    gate_result: dict[str, Any],
    obligation: str,
) -> None:
    relative = Path(
        require_text(
            gate_result.get("stdoutRelativePath"),
            "pure_stdout_relative_path",
        )
    )
    if relative.is_absolute() or ".." in relative.parts:
        raise SuiteError("pure_stdout_path_invalid")
    path = (evidence / relative).resolve(strict=True)
    commands_root = (evidence / "commands").resolve(
        strict=True
    )
    if (
        commands_root not in path.parents
        or path.name != "stdout.bin"
    ):
        raise SuiteError("pure_stdout_path_outside_evidence")
    identity, raw = file_snapshot(
        path,
        "pure_stdout",
        max_bytes=MAX_SMALL_BYTES,
        capture=True,
    )
    if (
        identity["sha256"]
        != gate_result.get("stdoutSha256")
        or identity["size"]
        != gate_result.get("stdoutBytes")
        or raw is None
    ):
        raise SuiteError("pure_stdout_gate_binding_mismatch")
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeError as error:
        raise SuiteError("pure_stdout_utf8_invalid") from error
    pattern = PURE_STDOUT_PATTERNS.get(obligation)
    if pattern is None or pattern.fullmatch(text) is None:
        raise SuiteError(
            "pure_stdout_contract_invalid:" + obligation
        )


def finalize_receipt(
    config_path: Path,
    manifest_path: Path,
    plan_path: Path,
    evidence: Path,
    receipt_out: Path,
    authority_witness: tuple[object, dict[str, Any]],
) -> dict[str, Any]:
    raise SuiteError(PRODUCTION_EXECUTION_IDENTITY_HARD_RED)
    if (
        len(authority_witness) != 2
        or authority_witness[0] is not _AUTHORITY_WITNESS
        or not isinstance(authority_witness[1], dict)
    ):
        raise SuiteError("compiler_authority_witness_invalid")
    require_canonical_absolute(evidence, "suite_evidence")
    if not evidence.is_dir():
        raise SuiteError("suite_evidence_not_directory")
    plan, commands = read_and_revalidate_plan(config_path, manifest_path, plan_path)
    authority = authority_witness[1]
    if (
        authority.get("verifier") != plan["compilerAuthorityVerifier"]
        or authority.get("compiler") not in plan["compilers"]
        or authority.get("productionGate") not in plan["tools"]
        or not isinstance(authority.get("portableReceipt"), dict)
        or SHA_RE.fullmatch(
            authority.get("verificationSha256", "")
        ) is None
        or SHA_RE.fullmatch(
            authority.get("sourceSnapshotCid", "")
        ) is None
    ):
        raise SuiteError("compiler_authority_plan_binding_mismatch")
    validator = subprocess.run(
        [
            str(GATE_VALIDATOR),
            "--evidence-dir",
            str(evidence),
            "--manifest",
            str(manifest_path),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if validator.returncode != 0:
        detail = validator.stderr.decode("utf-8", "replace")[:4096]
        raise SuiteError("gate_evidence_validation_failed:" + detail)
    gate_receipt, gate_identity = read_canonical(
        evidence / "receipt.json",
        "gate_receipt",
        MAX_SMALL_BYTES,
    )
    if (
        gate_receipt.get("schema") != GATE_RECEIPT_SCHEMA
        or gate_receipt.get("status") != "passed"
        or gate_receipt.get("proofStatus")
        != "proved_linux_kernel_cgroup_v2_aggregate"
        or gate_receipt.get("hostSystem") != "Linux"
        or gate_receipt.get("limitBytes") != LIMIT_BYTES
        or gate_receipt.get("swapBytes") != 0
        or gate_receipt.get("memoryScope")
        != "cgroup_and_all_descendants"
        or gate_receipt.get("kernelAuthority")
        != "linux_cgroup_v2_memory.max"
        or gate_receipt.get("processTreePlacement")
        != "attach_before_exec_kernel_inherited"
        or gate_receipt.get("processTreeCompletion")
        != "subreaper_waits_all_descendants"
        or gate_receipt.get("userSpacePollingAuthority") != 0
    ):
        raise SuiteError("gate_receipt_authority_invalid")
    command_results = gate_receipt.get("commands")
    if not isinstance(command_results, list) or len(command_results) != len(commands):
        raise SuiteError("gate_receipt_command_count_invalid")
    artifacts: list[dict[str, Any]] = []
    comparison_groups: dict[str, list[str]] = {}
    performance: list[dict[str, Any]] = []
    resource_measurements: list[dict[str, Any]] = []
    unfinished_obligations: list[dict[str, str]] = []
    for index, (command, gate_result) in enumerate(
        zip(commands, command_results, strict=True)
    ):
        if gate_result.get("id") != command["id"] or gate_result.get("index") != index:
            raise SuiteError("gate_receipt_command_projection_invalid")
        if (
            gate_result.get("workloadRc") != 0
            or gate_result.get("oomKill") != 0
            or gate_result.get("stderrBytes") != 0
            or type(gate_result.get("memoryPeakBytes"))
            is not int
            or gate_result["memoryPeakBytes"] < 0
            or gate_result["memoryPeakBytes"] > LIMIT_BYTES
            or type(gate_result.get("elapsedNs")) is not int
            or gate_result["elapsedNs"] < 0
        ):
            raise SuiteError(
                "gate_receipt_command_execution_invalid:"
                + command["id"]
            )
        resource_measurements.append(
            {
                "commandId": command["id"],
                "elapsedNs": gate_result["elapsedNs"],
                "memoryPeakBytes":
                    gate_result["memoryPeakBytes"],
            }
        )
        if command["obligation"] in PURE_OBLIGATIONS:
            validate_pure_stdout(
                evidence,
                gate_result,
                command["obligation"],
            )
            if command["obligation"] == STAGED_MANIFEST_HARD_RED_OBLIGATION:
                unfinished_obligations.append(
                    {
                        "id": STAGED_MANIFEST_HARD_RED_OBLIGATION,
                        "reason": STAGED_MANIFEST_HARD_RED_REASON,
                    }
                )
        elif gate_result.get("stdoutBytes") != 0:
            raise SuiteError(
                "gate_receipt_unexpected_stdout:"
                + command["id"]
            )
        for contract in command["expectedArtifacts"]:
            kind = contract["kind"]
            row: dict[str, Any] = {
                "commandId": command["id"],
                "id": contract["id"],
                "kind": kind,
            }
            if kind in {"gate_stdout", "gate_stderr"}:
                prefix = "stdout" if kind == "gate_stdout" else "stderr"
                row["relativePath"] = gate_result[prefix + "RelativePath"]
                row["sha256"] = gate_result[prefix + "Sha256"]
                row["size"] = gate_result[prefix + "Bytes"]
            else:
                artifact_path = Path(contract["path"])
                if kind == "performance":
                    measured = read_performance(
                        artifact_path,
                        contract["metricKeys"],
                    )
                    identity = measured["identity"]
                elif kind == "negative":
                    rejected = read_negative(
                        artifact_path,
                        command["obligation"],
                    )
                    identity = rejected["identity"]
                elif kind == "workload":
                    workload = read_workload(
                        artifact_path,
                        command["obligation"],
                    )
                    identity = workload["identity"]
                else:
                    identity = file_identity(
                        artifact_path,
                        "suite_artifact_" + command["id"] + "_" + contract["id"],
                        allow_empty=True,
                    )
                row["pathFshex"] = identity["pathFshex"]
                row["sha256"] = identity["sha256"]
                row["size"] = identity["size"]
                if contract["comparisonGroup"]:
                    comparison_groups.setdefault(
                        contract["comparisonGroup"], []
                    ).append(identity["sha256"])
                if kind == "performance":
                    row["metrics"] = measured["metrics"]
                    performance.append(
                        {
                            "commandId": command["id"],
                            "artifactId": contract["id"],
                            "artifactSha256": identity["sha256"],
                            "metrics": measured["metrics"],
                        }
                    )
                elif kind == "negative":
                    row["rejected"] = True
                    row["errorCode"] = rejected["errorCode"]
                elif kind == "workload":
                    row["factsRoot"] = workload["factsRoot"]
            artifacts.append(row)
    for group, hashes in comparison_groups.items():
        if len(hashes) < 2 or len(set(hashes)) != 1:
            raise SuiteError("deterministic_artifact_mismatch:" + group)
    receipt = {
        "schema": RECEIPT_SCHEMA,
        "status": "hard_red" if unfinished_obligations else "passed",
        "linuxExecution": "completed_under_linux_kernel_cgroup_v2",
        "limitBytes": LIMIT_BYTES,
        "planSha256": plan["planSha256"],
        "manifestSha256": file_identity(
            manifest_path,
            "suite_receipt_manifest",
            max_bytes=MAX_CONFIG_BYTES,
        )["sha256"],
        "gateReceiptSha256": gate_identity["sha256"],
        "sourceSetSha256": plan["sourceSetSha256"],
        "compilerSetSha256": plan["compilerSetSha256"],
        "compilerAuthorityStatus": "verified_before_evidence_allocation",
        "compilerAuthorityVerifierSha256": authority["verifier"]["sha256"],
        "compilerAuthorityProductionGateSha256":
            authority["productionGate"]["sha256"],
        "compilerAuthorityPortableReceiptSha256":
            authority["portableReceipt"]["sha256"],
        "compilerAuthorityVerificationSha256":
            authority["verificationSha256"],
        "compilerAuthoritySourceSnapshotCid":
            authority["sourceSnapshotCid"],
        "toolSetSha256": plan["toolSetSha256"],
        "artifacts": artifacts,
        "performance": performance,
        "resourceMeasurements": resource_measurements,
        "unfinishedObligations": unfinished_obligations,
    }
    receipt["receiptSha256"] = hashlib.sha256(canonical_json(receipt)).hexdigest()
    write_exclusive(receipt_out, canonical_json(receipt) + b"\n", "suite_receipt")
    return receipt


def run_suite(
    config_path: Path,
    manifest_path: Path,
    plan_path: Path,
    evidence: Path,
    receipt_out: Path,
) -> dict[str, Any]:
    authority_witness = require_external_compiler_authority()
    raise LinuxExecutionNotRun(PRODUCTION_EXECUTION_IDENTITY_HARD_RED)
    _plan, commands = read_and_revalidate_plan(
        config_path,
        manifest_path,
        plan_path,
    )
    for command in commands:
        for artifact in command["expectedArtifacts"]:
            if artifact["path"]:
                artifact_path = Path(artifact["path"])
                if artifact_path.exists() or artifact_path.is_symlink():
                    raise SuiteError(
                        "suite_output_preexists:"
                        + command["id"]
                        + ":"
                        + artifact["id"]
                    )
    if evidence.exists() or evidence.is_symlink():
        raise SuiteError("suite_evidence_must_not_exist")
    result = subprocess.run(
        [
            str(GATE),
            "--manifest",
            str(manifest_path),
            "--evidence-dir",
            str(evidence),
        ],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace")[:4096]
        raise SuiteError("exact_1g_gate_hard_red:" + detail)
    receipt = finalize_receipt(
        config_path,
        manifest_path,
        plan_path,
        evidence,
        receipt_out,
        authority_witness,
    )
    if receipt["status"] != "passed":
        raise LinuxExecutionHardRed(
            "staged_manifest_production_hard_red:"
            + STAGED_MANIFEST_HARD_RED_REASON,
            receipt["receiptSha256"],
        )
    return receipt


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Produce or run the formal CSG exact-1-GiB suite",
    )
    subparsers = parser.add_subparsers(dest="action", required=True)
    produce_parser = subparsers.add_parser("produce")
    produce_parser.add_argument("--config", required=True)
    produce_parser.add_argument("--manifest-out", required=True)
    produce_parser.add_argument("--plan-out", required=True)
    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("--config", required=True)
    run_parser.add_argument("--manifest", required=True)
    run_parser.add_argument("--plan", required=True)
    run_parser.add_argument("--evidence-dir", required=True)
    run_parser.add_argument("--receipt-out", required=True)
    return parser.parse_args(argv)


def main(argv: Sequence[str]) -> int:
    if argv and argv[0] == "--execute-suite-command":
        adapter_parser = argparse.ArgumentParser(add_help=False)
        adapter_parser.add_argument("--execute-suite-command", action="store_true")
        adapter_parser.add_argument("--plan", required=True)
        adapter_parser.add_argument("--expected-plan-sha256", required=True)
        adapter_parser.add_argument("--command-id", required=True)
        try:
            adapter_args = adapter_parser.parse_args(argv)
            return execute_suite_command(
                Path(adapter_args.plan),
                adapter_args.expected_plan_sha256,
                adapter_args.command_id,
            )
        except (
            SuiteError,
            OSError,
            ValueError,
            TypeError,
            UnicodeError,
            subprocess.SubprocessError,
        ) as error:
            print(
                "csg_core_exact_1g_suite_adapter_error="
                + str(error).replace("\r", " ").replace("\n", " "),
                file=sys.stderr,
            )
            return 126
    try:
        args = parse_args(argv)
        if args.action == "produce":
            plan = produce(
                Path(args.config),
                Path(args.manifest_out),
                Path(args.plan_out),
            )
            print("csg_core_exact_1g_suite_status=produced")
            print("plan_sha256=" + plan["planSha256"])
            print(
                "manifest_sha256="
                + file_identity(
                    Path(args.manifest_out),
                    "produced_manifest",
                    max_bytes=MAX_CONFIG_BYTES,
                )["sha256"]
            )
            return 0
        receipt = run_suite(
            Path(args.config),
            Path(args.manifest),
            Path(args.plan),
            Path(args.evidence_dir),
            Path(args.receipt_out),
        )
        print("csg_core_exact_1g_suite_status=passed")
        print("receipt_sha256=" + receipt["receiptSha256"])
        return 0
    except LinuxExecutionNotRun as error:
        print("csg_core_exact_1g_suite_status=hard_red", file=sys.stderr)
        print("linux_execution=not_run", file=sys.stderr)
        print("production_authority=unavailable", file=sys.stderr)
        print("launcher_exec_identity=HARD_RED", file=sys.stderr)
        print("dynamic_completion_credit=0", file=sys.stderr)
        print(
            "csg_core_exact_1g_suite_error="
            + str(error).replace("\r", " ").replace("\n", " "),
            file=sys.stderr,
        )
        return 1
    except LinuxExecutionHardRed as error:
        print("csg_core_exact_1g_suite_status=hard_red", file=sys.stderr)
        print(
            "linux_execution=completed_under_linux_kernel_cgroup_v2",
            file=sys.stderr,
        )
        print(
            "receipt_sha256=" + error.receipt_sha256,
            file=sys.stderr,
        )
        print(
            "csg_core_exact_1g_suite_error="
            + str(error).replace("\r", " ").replace("\n", " "),
            file=sys.stderr,
        )
        return 1
    except (
        SuiteError,
        OSError,
        ValueError,
        TypeError,
        UnicodeError,
        subprocess.SubprocessError,
    ) as error:
        print("csg_core_exact_1g_suite_status=hard_red", file=sys.stderr)
        print(
            "csg_core_exact_1g_suite_error="
            + str(error).replace("\r", " ").replace("\n", " "),
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
