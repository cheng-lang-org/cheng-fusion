def parse_portable_authority_candidate_report(raw: bytes) -> dict[str, str]:
    if (
        not raw
        or len(raw) > MAX_TEXT_BYTES
        or not raw.endswith(b"\n")
        or b"\r" in raw
        or b"\0" in raw
    ):
        raise SuiteError("portable_authority_report_encoding_invalid")
    try:
        lines = raw.decode("ascii", "strict").splitlines()
    except UnicodeDecodeError as error:
        raise SuiteError("portable_authority_report_ascii_invalid") from error
    rows: dict[str, str] = {}
    order: list[str] = []
    for line in lines:
        key, separator, value = line.partition("=")
        if (
            not separator
            or not key
            or not value
            or "=" in value
            or key in rows
        ):
            raise SuiteError("portable_authority_report_row_invalid")
        rows[key] = value
        order.append(key)
    if tuple(order) != PORTABLE_AUTHORITY_REPORT_KEYS:
        raise SuiteError("portable_authority_report_order_invalid")
    terminal = rows["verification_sha256"]
    suffix = ("verification_sha256=" + terminal + "\n").encode("ascii")
    if (
        SHA_RE.fullmatch(terminal) is None
        or hashlib.sha256(raw[:-len(suffix)]).hexdigest() != terminal
        or rows["schema"] != PORTABLE_AUTHORITY_REPORT_SCHEMA
        or rows["status"] != "CANDIDATE_VERIFIED"
        or rows["material_role"] != "candidate_material_only"
        or rows["production_authority"] != "unavailable"
        or rows["production_execution_identity_binding"] != "absent"
        or rows["dynamic_completion_credit"] != "0"
        or rows["platform"] != "linux-x86_64"
        or rows["receipt_path_fshex"]
            != os.fsencode(str(PORTABLE_AUTHORITY_RECEIPT)).hex()
        or rows["compiler_path_fshex"]
            != os.fsencode(str(CANONICAL_COMPILER)).hex()
        or rows["receipt_kernel_authority"]
            != "linux_fs_verity_sha256_and_fs_immutable"
        or rows["compiler_kernel_authority"]
            != "linux_fs_verity_sha256_and_fs_immutable"
        or rows["compiler_format"] != "elf64-x86_64-linux"
        or rows["linux_target_triple"]
            != "x86_64-unknown-linux-gnu"
        or rows["linux_machine_authority"] != "elf-e_machine-62"
    ):
        raise SuiteError("portable_authority_report_contract_invalid")
    for key in (
        "receipt_sha256",
        "receipt_fsverity_digest",
        "compiler_sha256",
        "compiler_fsverity_digest",
        "production_gate_sha256",
        "verifier_inputs_cid",
        "source_snapshot_cid",
        "linux_stage_fixed_point_sha256",
        "external_anchor_file_sha256",
        "authority_verification_sha256",
    ):
        if SHA_RE.fullmatch(rows[key]) is None:
            raise SuiteError("portable_authority_report_digest_invalid:" + key)
    integers: dict[str, int] = {}
    for key in (
        "receipt_device",
        "receipt_inode",
        "receipt_mode",
        "receipt_nlink",
        "receipt_size",
        "receipt_uid",
        "receipt_gid",
        "receipt_fs_flags",
        "compiler_device",
        "compiler_inode",
        "compiler_mode",
        "compiler_nlink",
        "compiler_size",
        "compiler_uid",
        "compiler_gid",
        "compiler_fs_flags",
    ):
        value = rows[key]
        if re.fullmatch(r"0|[1-9][0-9]*", value) is None:
            raise SuiteError("portable_authority_report_uint_invalid:" + key)
        integers[key] = int(value)
    if (
        integers["receipt_device"] <= 0
        or integers["receipt_inode"] <= 0
        or integers["receipt_nlink"] != 1
        or integers["receipt_size"] <= 0
        or integers["receipt_uid"] != 0
        or integers["receipt_gid"] != 0
        or stat.S_IMODE(integers["receipt_mode"]) != 0o400
        or integers["receipt_fs_flags"] & 0x10 == 0
        or integers["compiler_device"] <= 0
        or integers["compiler_inode"] <= 0
        or integers["compiler_nlink"] != 1
        or integers["compiler_size"] <= 0
        or integers["compiler_uid"] != 0
        or integers["compiler_gid"] != 0
        or stat.S_IMODE(integers["compiler_mode"]) != 0o500
        or integers["compiler_fs_flags"] & 0x10 == 0
        or rows["compiler_sha256"]
            != rows["linux_stage_fixed_point_sha256"]
    ):
        raise SuiteError("portable_authority_report_physical_identity_invalid")
    return rows


