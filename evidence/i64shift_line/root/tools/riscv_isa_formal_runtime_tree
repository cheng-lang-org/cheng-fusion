#!/usr/bin/env python3
"""Materialize and verify the private CPython closure used by the RISC-V gate."""

import argparse
import hashlib
import os
import pathlib
import stat
import struct
import sys


SCHEMA = "cheng.riscv_isa.formal_runtime_tree.v2"
IDENTITY_FIELDS = (
    "st_dev",
    "st_ino",
    "st_mode",
    "st_nlink",
    "st_uid",
    "st_gid",
    "st_size",
    "st_mtime_ns",
    "st_ctime_ns",
)


def fail(message: str) -> "NoReturn":
    raise SystemExit("riscv_isa_formal_runtime_tree_error=" + message)


def frame(raw: bytes) -> bytes:
    return struct.pack(">I", len(raw)) + raw


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb", buffering=0) as source:
        while True:
            chunk = source.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def canonical_existing_directory(path_text: str, label: str) -> pathlib.Path:
    path = pathlib.Path(path_text)
    if not path.is_absolute() or os.path.normpath(path_text) != path_text:
        fail(label + "_path_not_canonical")
    try:
        info = path.lstat()
    except OSError as exc:
        fail(label + "_stat_failed:" + str(exc))
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(label + "_not_plain_directory")
    if os.path.realpath(path_text) != path_text:
        fail(label + "_ancestry_not_canonical")
    return path


def canonical_new_path(path_text: str, label: str) -> pathlib.Path:
    path = pathlib.Path(path_text)
    if not path.is_absolute() or os.path.normpath(path_text) != path_text:
        fail(label + "_path_not_canonical")
    parent = path.parent
    if os.path.realpath(str(parent)) != str(parent):
        fail(label + "_parent_not_canonical")
    if path.exists() or path.is_symlink():
        fail(label + "_already_exists")
    return path


def source_closure(root: pathlib.Path) -> tuple[list[tuple], str]:
    rows: list[tuple] = []
    root_text = str(root)

    def visit(logical: pathlib.Path, relative: str, ancestry: tuple[str, ...]) -> None:
        try:
            named = logical.lstat()
            resolved_text = os.path.realpath(str(logical))
            resolved = pathlib.Path(resolved_text)
            resolved_info = resolved.stat()
        except OSError as exc:
            fail("source_member_stat_failed:" + relative + ":" + str(exc))
        try:
            inside = os.path.commonpath((root_text, resolved_text)) == root_text
        except ValueError:
            inside = False
        if not inside:
            fail("source_symlink_escapes_root:" + relative)
        is_link = stat.S_ISLNK(named.st_mode)
        if stat.S_ISDIR(resolved_info.st_mode):
            if resolved_text in ancestry:
                fail("source_directory_cycle:" + relative)
            rows.append((relative, "symlink_directory" if is_link else "directory", 0, "", int(resolved_info.st_mode & 0o777)))
            children = sorted(resolved.iterdir(), key=lambda item: os.fsencode(item.name))
            for child in children:
                child_relative = child.name if relative == "." else relative + "/" + child.name
                visit(child, child_relative, ancestry + (resolved_text,))
            return
        if not stat.S_ISREG(resolved_info.st_mode):
            fail("source_special_member:" + relative)
        digest = sha256_file(resolved)
        rows.append((
            relative,
            "symlink_regular" if is_link else "regular",
            int(resolved_info.st_size),
            digest,
            int(resolved_info.st_mode & 0o777),
        ))

    visit(root, ".", ())
    rows.sort(key=lambda row: (os.fsencode(row[0]), row[1].encode("ascii")))
    payload = bytearray(frame(b"cheng.riscv_isa.source_runtime_closure.v1"))
    payload.extend(struct.pack(">I", len(rows)))
    for relative, kind, size, digest, mode in rows:
        payload.extend(frame(os.fsencode(relative)))
        payload.extend(frame(kind.encode("ascii")))
        payload.extend(struct.pack(">QQ", size, mode))
        payload.extend(bytes.fromhex(digest) if digest else b"\0" * 32)
    return rows, sha256_bytes(bytes(payload))


def copy_source_tree(source: pathlib.Path, destination: pathlib.Path) -> int:
    source_text = str(source)
    copied = 0

    def copy_node(logical: pathlib.Path, target: pathlib.Path, ancestry: tuple[str, ...]) -> None:
        nonlocal copied
        resolved_text = os.path.realpath(str(logical))
        try:
            if os.path.commonpath((source_text, resolved_text)) != source_text:
                fail("copy_source_escape:" + str(logical))
        except ValueError:
            fail("copy_source_escape:" + str(logical))
        resolved = pathlib.Path(resolved_text)
        info = resolved.stat()
        if stat.S_ISDIR(info.st_mode):
            if resolved_text in ancestry:
                fail("copy_source_cycle:" + str(logical))
            target.mkdir(mode=0o700)
            for child in sorted(resolved.iterdir(), key=lambda item: os.fsencode(item.name)):
                copy_node(child, target / child.name, ancestry + (resolved_text,))
            return
        if not stat.S_ISREG(info.st_mode):
            fail("copy_source_special:" + str(logical))
        raw = resolved.read_bytes()
        descriptor = os.open(
            target,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC,
            0o700 if info.st_mode & 0o111 else 0o600,
        )
        try:
            offset = 0
            while offset < len(raw):
                written = os.write(descriptor, raw[offset:])
                if written <= 0:
                    fail("copy_short_write:" + str(target))
                offset += written
            os.fsync(descriptor)
            os.fchmod(descriptor, 0o555 if info.st_mode & 0o111 else 0o444)
        finally:
            os.close(descriptor)
        copied += 1

    copy_node(source, destination, ())
    return copied


def verify_materialized_source(rows: list[tuple], tree: pathlib.Path) -> None:
    for relative, kind, size, digest, source_mode in rows:
        target = tree if relative == "." else tree / pathlib.PurePosixPath(relative)
        info = target.lstat()
        if kind in ("directory", "symlink_directory"):
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                fail("materialized_directory_invalid:" + relative)
            continue
        if (
            kind not in ("regular", "symlink_regular")
            or not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_nlink != 1
            or info.st_size != size
            or sha256_file(target) != digest
            or bool(info.st_mode & 0o111) != bool(source_mode & 0o111)
        ):
            fail("materialized_regular_mismatch:" + relative)


def copy_embedded_files(
    tree: pathlib.Path, specs: list[str]
) -> tuple[list[tuple[str, str, str, int, int]], str]:
    rows: list[tuple[str, str, str, int, int]] = []
    seen: set[str] = set()
    for spec in specs:
        if "=" not in spec:
            fail("embed_spec_invalid")
        relative, source_text = spec.split("=", 1)
        if (
            not relative
            or relative.startswith("/")
            or pathlib.PurePosixPath(relative).as_posix() != relative
            or ".." in pathlib.PurePosixPath(relative).parts
            or relative in seen
        ):
            fail("embed_relative_invalid:" + relative)
        seen.add(relative)
        source = pathlib.Path(source_text)
        if (
            not source.is_absolute()
            or os.path.normpath(source_text) != source_text
            or os.path.realpath(source_text) != source_text
        ):
            fail("embed_source_not_canonical:" + relative)
        info = source.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_nlink < 1:
            fail("embed_source_not_regular:" + relative)
        target = tree / relative
        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        raw = source.read_bytes()
        after = source.lstat()
        if tuple(int(getattr(info, field)) for field in IDENTITY_FIELDS) != tuple(
            int(getattr(after, field)) for field in IDENTITY_FIELDS
        ):
            fail("embed_source_identity_drift:" + relative)
        target_mode = 0o555 if info.st_mode & 0o111 else 0o444
        descriptor = os.open(
            target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600
        )
        try:
            if os.write(descriptor, raw) != len(raw):
                fail("embed_short_write:" + relative)
            os.fsync(descriptor)
            os.fchmod(descriptor, target_mode)
        finally:
            os.close(descriptor)
        rows.append((relative, source_text, sha256_bytes(raw), len(raw), target_mode))
    rows.sort(key=lambda row: os.fsencode(row[0]))
    payload = bytearray(frame(b"cheng.riscv_isa.embedded_inputs.v1"))
    payload.extend(struct.pack(">I", len(rows)))
    for relative, source, digest, size, mode in rows:
        payload.extend(frame(os.fsencode(relative)))
        payload.extend(frame(os.fsencode(source)))
        payload.extend(struct.pack(">QQ", size, mode))
        payload.extend(bytes.fromhex(digest))
    return rows, sha256_bytes(bytes(payload))


def freeze_directories(tree: pathlib.Path) -> None:
    for directory, _names, _files in os.walk(tree, topdown=False):
        os.chmod(directory, 0o555, follow_symlinks=False)


def private_tree_closure(root: pathlib.Path) -> tuple[int, int, int, str]:
    entries: list[tuple] = []
    for directory, directory_names, file_names in os.walk(
        root, topdown=True, followlinks=False
    ):
        directory_names.sort(key=os.fsencode)
        file_names.sort(key=os.fsencode)
        directory_path = pathlib.Path(directory)
        info = directory_path.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            fail("tree_non_directory_node")
        identity = tuple(int(getattr(info, field)) for field in IDENTITY_FIELDS)
        relative = os.path.relpath(directory, root).replace(os.sep, "/")
        entries.append((relative, "directory", "", identity))
        for name in directory_names:
            child_info = (directory_path / name).lstat()
            if stat.S_ISLNK(child_info.st_mode) or not stat.S_ISDIR(child_info.st_mode):
                fail("tree_directory_symlink_or_special")
        for name in file_names:
            path = directory_path / name
            file_info = path.lstat()
            if stat.S_ISLNK(file_info.st_mode) or not stat.S_ISREG(file_info.st_mode):
                fail("tree_file_symlink_or_special")
            if file_info.st_nlink != 1:
                fail("tree_hard_link")
            identity = tuple(int(getattr(file_info, field)) for field in IDENTITY_FIELDS)
            relative = os.path.relpath(path, root).replace(os.sep, "/")
            entries.append((relative, "regular", sha256_file(path), identity))
    entries.sort(key=lambda item: (os.fsencode(item[0]), 0 if item[1] == "directory" else 1))
    payload = bytearray(frame(b"cheng.guard.private_frozen_tree_closure"))
    payload.extend(struct.pack(">I", len(entries)))
    for relative, kind, digest, identity in entries:
        payload.extend(frame(os.fsencode(relative)))
        payload.extend(frame(kind.encode("ascii")))
        payload.extend(struct.pack(">QQQQQ", identity[2], identity[3], identity[4], identity[5], identity[6]))
        payload.extend(bytes.fromhex(digest) if digest else b"\0" * 32)
    directory_count = sum(1 for item in entries if item[1] == "directory")
    file_count = len(entries) - directory_count
    return len(entries), directory_count, file_count, sha256_bytes(bytes(payload))


def rows_bytes(rows: list[tuple[str, str]]) -> bytes:
    return b"".join((key + "=" + value + "\n").encode("utf-8") for key, value in rows)


def parse_receipt(path: pathlib.Path) -> tuple[dict[str, str], bytes]:
    path_text = str(path)
    if (
        not path.is_absolute()
        or os.path.normpath(path_text) != path_text
        or os.path.realpath(path_text) != path_text
    ):
        fail("receipt_path_not_canonical")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o400
            or before.st_uid != os.geteuid()
            or before.st_gid != os.getegid()
        ):
            fail("receipt_identity_invalid")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(descriptor)
    except OSError as exc:
        fail("receipt_read_failed:" + str(exc))
    finally:
        if "descriptor" in locals():
            os.close(descriptor)
    named = path.lstat()
    if (
        tuple(int(getattr(before, field)) for field in IDENTITY_FIELDS)
        != tuple(int(getattr(after, field)) for field in IDENTITY_FIELDS)
        or tuple(int(getattr(after, field)) for field in IDENTITY_FIELDS)
        != tuple(int(getattr(named, field)) for field in IDENTITY_FIELDS)
    ):
        fail("receipt_identity_drift")
    raw = b"".join(chunks)
    try:
        lines = raw.decode("utf-8", "strict").splitlines()
    except UnicodeError as exc:
        fail("receipt_utf8_invalid:" + str(exc))
    values: dict[str, str] = {}
    for line in lines:
        if "=" not in line:
            fail("receipt_row_invalid")
        key, value = line.split("=", 1)
        if not key or key in values:
            fail("receipt_key_invalid:" + key)
        values[key] = value
    return values, raw


def prepare(args: argparse.Namespace) -> None:
    source = canonical_existing_directory(args.source_root, "source_root")
    tree = canonical_new_path(args.tree, "tree")
    receipt = canonical_new_path(args.receipt, "receipt")
    source_rows, source_digest = source_closure(source)
    copied = copy_source_tree(source, tree)
    verify_materialized_source(source_rows, tree)
    source_rows_after, source_digest_after = source_closure(source)
    if source_rows_after != source_rows or source_digest_after != source_digest:
        fail("source_identity_changed_during_materialization")
    embedded_rows, embedded_digest = copy_embedded_files(tree, args.embed)
    freeze_directories(tree)
    command = tree / args.command_relative
    if not command.is_file() or command.is_symlink() or command.stat().st_mode & 0o111 == 0:
        fail("snapshot_command_invalid")
    entry_count, directory_count, file_count, tree_digest = private_tree_closure(tree)
    if copied + len(embedded_rows) != file_count:
        fail("materialized_member_count_mismatch")
    rows = [
        ("schema", SCHEMA),
        ("status", "FROZEN"),
        ("source_root_fshex", os.fsencode(str(source)).hex()),
        ("source_closure_sha256", source_digest),
        ("source_entry_count", str(len(source_rows))),
        ("embedded_input_count", str(len(embedded_rows))),
        ("embedded_input_manifest_sha256", embedded_digest),
        ("tree_root_fshex", os.fsencode(str(tree)).hex()),
        ("tree_sha256", tree_digest),
        ("tree_entry_count", str(entry_count)),
        ("tree_directory_count", str(directory_count)),
        ("tree_file_count", str(file_count)),
        ("command_relative_fshex", os.fsencode(args.command_relative).hex()),
        ("command_sha256", sha256_file(command)),
    ]
    payload_digest = sha256_bytes(rows_bytes(rows))
    rows.append(("receipt_payload_sha256", payload_digest))
    raw = rows_bytes(rows)
    descriptor = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o400)
    try:
        if os.write(descriptor, raw) != len(raw):
            fail("receipt_short_write")
        os.fsync(descriptor)
        os.fchmod(descriptor, 0o400)
    finally:
        os.close(descriptor)
    print("riscv_isa_formal_runtime_tree_status=prepared")
    print("tree_sha256=" + tree_digest)
    print("command_sha256=" + sha256_file(command))


def verify(args: argparse.Namespace) -> None:
    tree = canonical_existing_directory(args.tree, "tree")
    receipt = pathlib.Path(args.receipt)
    values, raw = parse_receipt(receipt)
    required = {
        "schema", "status", "source_root_fshex", "source_closure_sha256",
        "source_entry_count", "embedded_input_count", "embedded_input_manifest_sha256",
        "tree_root_fshex", "tree_sha256", "tree_entry_count",
        "tree_directory_count", "tree_file_count", "command_relative_fshex",
        "command_sha256", "receipt_payload_sha256",
    }
    if set(values) != required or values["schema"] != SCHEMA or values["status"] != "FROZEN":
        fail("receipt_shape_invalid")
    terminal = ("receipt_payload_sha256=" + values["receipt_payload_sha256"] + "\n").encode()
    if not raw.endswith(terminal) or sha256_bytes(raw[:-len(terminal)]) != values["receipt_payload_sha256"]:
        fail("receipt_payload_invalid")
    if os.fsdecode(bytes.fromhex(values["tree_root_fshex"])) != str(tree):
        fail("receipt_tree_path_mismatch")
    source = canonical_existing_directory(args.source_root, "source_root")
    if os.fsdecode(bytes.fromhex(values["source_root_fshex"])) != str(source):
        fail("receipt_source_path_mismatch")
    source_rows, source_digest = source_closure(source)
    if (
        source_digest != values["source_closure_sha256"]
        or str(len(source_rows)) != values["source_entry_count"]
    ):
        fail("source_identity_drift")
    if str(len(args.embed)) != values["embedded_input_count"]:
        fail("embedded_input_count_mismatch")
    if args.embed:
        rows: list[tuple[str, str, str, int, int]] = []
        for spec in args.embed:
            if "=" not in spec:
                fail("embed_spec_invalid")
            relative, source_text = spec.split("=", 1)
            source = pathlib.Path(source_text)
            if os.path.realpath(source_text) != source_text or not source.is_file():
                fail("embed_source_not_canonical:" + relative)
            source_info = source.stat()
            rows.append((
                relative,
                source_text,
                sha256_file(source),
                source_info.st_size,
                0o555 if source_info.st_mode & 0o111 else 0o444,
            ))
        rows.sort(key=lambda row: os.fsencode(row[0]))
        payload = bytearray(frame(b"cheng.riscv_isa.embedded_inputs.v1"))
        payload.extend(struct.pack(">I", len(rows)))
        for relative, source_text, digest, size, mode in rows:
            payload.extend(frame(os.fsencode(relative)))
            payload.extend(frame(os.fsencode(source_text)))
            payload.extend(struct.pack(">QQ", size, mode))
            payload.extend(bytes.fromhex(digest))
        if (
            str(len(rows)) != values["embedded_input_count"]
            or sha256_bytes(bytes(payload)) != values["embedded_input_manifest_sha256"]
        ):
            fail("embedded_input_identity_drift")
    entry_count, directory_count, file_count, digest = private_tree_closure(tree)
    if (
        digest != values["tree_sha256"]
        or str(entry_count) != values["tree_entry_count"]
        or str(directory_count) != values["tree_directory_count"]
        or str(file_count) != values["tree_file_count"]
    ):
        fail("tree_identity_drift")
    relative = os.fsdecode(bytes.fromhex(values["command_relative_fshex"]))
    command = tree / relative
    if sha256_file(command) != values["command_sha256"]:
        fail("command_identity_drift")
    print("riscv_isa_formal_runtime_tree_status=verified")
    print("tree_sha256=" + digest)
    print("command_sha256=" + values["command_sha256"])


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="operation", required=True)
    prepare_parser = subparsers.add_parser("prepare")
    prepare_parser.add_argument("--source-root", required=True)
    prepare_parser.add_argument("--tree", required=True)
    prepare_parser.add_argument("--command-relative", required=True)
    prepare_parser.add_argument("--receipt", required=True)
    prepare_parser.add_argument("--embed", action="append", default=[])
    verify_parser = subparsers.add_parser("verify")
    verify_parser.add_argument("--tree", required=True)
    verify_parser.add_argument("--receipt", required=True)
    verify_parser.add_argument("--source-root", required=True)
    verify_parser.add_argument("--embed", action="append", default=[])
    args = parser.parse_args()
    if args.operation == "prepare":
        prepare(args)
    else:
        verify(args)


if __name__ == "__main__":
    main()
