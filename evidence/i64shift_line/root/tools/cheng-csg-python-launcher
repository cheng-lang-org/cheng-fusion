def cmd_lower(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="cheng-csg lower")
    parser.add_argument("--in", dest="in_path", required=True)
    parser.add_argument("--emit", required=True)
    parser.add_argument("--out-dir", required=True)
    parser.add_argument("--report-out", required=True)
    parser.add_argument("--target")
    args = parser.parse_args(argv)
    in_path = Path(args.in_path).resolve()
    out_dir = Path(args.out_dir).resolve()
    report_out = Path(args.report_out).resolve()
    target = args.target or host_target()
    pure_lower_dir = out_dir / ".cheng-csg" / "pure-lower" / target
    pure_lower_exe = pure_lower_dir / "cheng-csg-lower-pure"
    pure_lower_compile_report = pure_lower_dir / "compile.report.txt"
    try:
        compile_pure_lower(target, pure_lower_exe, pure_lower_compile_report)
        run_step(
            "lower",
            [
                str(pure_lower_exe),
                "lower",
                "--in",
                str(in_path),
                "--emit",
                args.emit,
                "--out-dir",
                str(out_dir),
                "--report-out",
                str(report_out),
            ],
        )
    except MigrationFailure as failure:
        if not report_out.exists():
            write_lower_wrapper_failure(report_out, failure)
        print(f"error: lower failed at {failure.step}: {failure.message}", file=sys.stderr)
        return failure.returncode or 1
    return 0


def cmd_prove(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="cheng-csg prove")
    parser.add_argument("--original", required=True)
    parser.add_argument("--cheng", required=True)
    parser.add_argument("--tests", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--target")
    args = parser.parse_args(argv)
    out_path = Path(args.out).resolve()
    target = args.target or host_target()
    pure_prove_dir = out_path.parent / ".cheng-csg" / "pure-prove" / target
    pure_prove_exe = pure_prove_dir / "cheng-csg-prove-pure"
    pure_prove_compile_report = pure_prove_dir / "compile.report.txt"
    try:
        compile_pure_prove(target, pure_prove_exe, pure_prove_compile_report)
        run_step(
            "prove",
            [
                str(pure_prove_exe),
                "prove",
                "--original",
                args.original,
                "--cheng",
                args.cheng,
                "--tests",
                str(Path(args.tests).resolve()),
                "--out",
                str(out_path),
            ],
        )
    except MigrationFailure as failure:
        if not out_path.exists():
            write_prove_wrapper_failure(out_path, failure)
        print(f"error: prove failed at {failure.step}: {failure.message}", file=sys.stderr)
        return failure.returncode or 1
    return 0


def cmd_migrate(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="cheng-csg migrate")
    parser.add_argument("--language", choices=["c", "python"], required=True)
    parser.add_argument("--target", required=True)
    parser.add_argument("--out-dir", required=True)
    parser.add_argument("--tests", required=True)
    parser.add_argument("--report-out", required=True)
    parser.add_argument("--original")
    parser.add_argument("--compile-commands")
    parser.add_argument("--root")
    parser.add_argument("--python-version")
    parser.add_argument("--entry")
    args = parser.parse_args(argv)
    out_dir = Path(args.out_dir).resolve()
    report_out = Path(args.report_out).resolve()
    bin_dir = out_dir / "bin"
    host = host_target()
    pure_migrate_exe = bin_dir / "cheng-csg-migrate-pure"
    pure_migrate_compile_report = out_dir / "reports" / "pure-migrate.compile.report.txt"
    try:
        bin_dir.mkdir(parents=True, exist_ok=True)
        compile_pure_migrate(host, pure_migrate_exe, pure_migrate_compile_report)
        forwarded = [
            str(pure_migrate_exe),
            "migrate",
            "--tool-root",
            str(ROOT),
            "--host-target",
            host,
            *argv,
        ]
        run_step(
            "migrate",
            forwarded,
        )
    except MigrationFailure as failure:
        if not report_out.exists():
            write_migrate_wrapper_failure(report_out, failure)
        print(f"error: migrate failed at {failure.step}: {failure.message}", file=sys.stderr)
        return failure.returncode or 1
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print("error: expected command: lower|prove|migrate", file=sys.stderr)
        return 2
    command = sys.argv[1]
    rest = sys.argv[2:]
    if command in {"-h", "--help"}:
        print("usage: cheng-csg {lower,prove,migrate} ...")
        return 0
    if command == "lower":
        return cmd_lower(rest)
    if command == "prove":
        return cmd_prove(rest)
    if command == "migrate":
        return cmd_migrate(rest)
    print("error: expected command: lower|prove|migrate", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
