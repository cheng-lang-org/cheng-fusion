def host_target() -> str:
    env_target = os.environ.get("CHENG_CSG_HOST_TARGET") or os.environ.get("CHENG_CSG_LOWER_TARGET")
    if env_target:
        return env_target
    machine = platform.machine().lower()
    system = platform.system().lower()
    if machine in {"arm64", "aarch64"}:
        arch = "arm64"
    elif machine in {"x86_64", "amd64"}:
        arch = "x86_64"
    else:
        die(f"unsupported host architecture for Cheng lower target: {machine}")
    if system == "darwin":
        return f"{arch}-apple-darwin"
    if system == "linux":
        return f"{arch}-unknown-linux-gnu"
    die(f"unsupported host system for Cheng lower target: {system}")
    return ""


def write_lower_wrapper_failure(report_out: Path, failure: MigrationFailure) -> None:
    report: dict[str, Any] = {
        "schema": "cheng-csg.lower.report",
        "standard": CSG_STANDARD,
        "toolImplementation": "python-bootstrap-dispatch",
        "generatorImplementation": "pure-cheng",
        "pureChengGenerator": True,
        "completionScope": "closed-subset-cheng-source-only",
        "fullProjectTranspilationComplete": False,
        "complete": False,
        "failedStep": failure.step,
        "reason": failure.message,
    }
    if failure.command:
        report["command"] = failure.command
        report["commandText"] = shell_command(failure.command)
    if failure.returncode is not None:
        report["returncode"] = failure.returncode
    if failure.stdout:
        report["stdoutTail"] = tail(failure.stdout)
    if failure.stderr:
        report["stderrTail"] = tail(failure.stderr)
    write_json(report_out, report)


