#!/usr/bin/env python3
"""Legacy Python launcher for CSG-Core lowering and equivalence proof."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import platform
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Any

_COMMON_PATH = Path(__file__).with_name("lang_csg_common")
_LOADER = importlib.machinery.SourceFileLoader("lang_csg_common", str(_COMMON_PATH))
_SPEC = importlib.util.spec_from_loader(_LOADER.name, _LOADER)
if _SPEC is None:
    raise SystemExit("error: failed to load lang_csg_common")
_COMMON = importlib.util.module_from_spec(_SPEC)
_LOADER.exec_module(_COMMON)

CSG_STANDARD = _COMMON.CSG_STANDARD
die = _COMMON.die
write_json = _COMMON.write_json


ROOT = Path(__file__).resolve().parent.parent


class MigrationFailure(Exception):
    def __init__(
        self,
        step: str,
        message: str,
        *,
        command: list[str] | None = None,
        returncode: int | None = None,
        stdout: str = "",
        stderr: str = "",
    ):
        super().__init__(message)
        self.step = step
        self.message = message
        self.command = command or []
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr


def tail(text: str, limit: int = 4000) -> str:
    if len(text) <= limit:
        return text
    return text[-limit:]


def shell_command(parts: list[str]) -> str:
    return " ".join(shlex.quote(str(part)) for part in parts)


def run_step(step: str, cmd: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    run_env = os.environ.copy()
    if env:
        run_env.update(env)
    run = subprocess.run(cmd, cwd=str(cwd), text=True, capture_output=True, env=run_env)
    if run.returncode != 0:
        raise MigrationFailure(
            step,
            f"{step} failed with exit {run.returncode}",
            command=cmd,
            returncode=run.returncode,
            stdout=run.stdout,
            stderr=run.stderr,
        )
    return run


def compile_pure_lower(target: str, out_exe: Path, report: Path) -> None:
    out_exe.parent.mkdir(parents=True, exist_ok=True)
    cmd = [
        str(ROOT / "artifacts" / "backend_driver" / "cheng"),
        "system-link-exec",
        f"--root:{ROOT}",
        f"--in:{ROOT / 'src' / 'core' / 'csg_migration' / 'cheng_csg_lower.cheng'}",
        "--emit:exe",
        f"--target:{target}",
        f"--out:{out_exe}",
        f"--report-out:{report}",
    ]
    run_step("compile-pure-lower", cmd)


