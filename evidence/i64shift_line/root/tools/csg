#!/bin/bash
set -euo pipefail

# CSG production entry (capability atomic switch, domains D+F wave).
#
# The just-in-time CLI compile path and the generation cache are retired.  The only production entry is the fixed installed launcher placed
# by tools/csg_core_production_launcher_install.  When the launcher is
# missing this wrapper fails closed with HARD_RED:production_launcher_missing
# BEFORE any source, cache, or compiler state is touched.  No fallback, no
# recompile-on-miss, no fake-green.

fail() {
  printf 'csg: %s\n' "$1" >&2
  exit 2
}

case "$(/usr/bin/uname -s):$(/usr/bin/uname -m)" in
  Darwin:arm64)
    INSTALL_ROOT="/usr/local/libexec/cheng"
    RECEIPT_ROOT="/private/var/db/cheng"
    PLATFORM="darwin-arm64"
    ;;
  Linux:x86_64)
    INSTALL_ROOT="/usr/libexec/cheng"
    RECEIPT_ROOT="/var/db/cheng"
    PLATFORM="linux-x86_64"
    ;;
  *)
    printf 'HARD_RED:production_launcher_missing\n' >&2
    exit 2
    ;;
esac

LAUNCHER="$INSTALL_ROOT/csg-production-launcher"
RECEIPT="$RECEIPT_ROOT/csg-production-launcher-install.receipt"

launcher_missing() {
  printf 'HARD_RED:production_launcher_missing\n' >&2
  exit 2
}

# Existence first: nothing in the repository is read before this point.
[[ -e "$LAUNCHER" && ! -L "$LAUNCHER" ]] || launcher_missing
[[ -x "$LAUNCHER" ]] || launcher_missing

# Identity: the installed launcher must be the exact artifact the installer
# sealed -- root-owned, single-link, mode 555, regular file.
case "$PLATFORM" in
  darwin-arm64)
    [[ "$(/usr/bin/stat -f '%u:%g:%l:%Lp' "$LAUNCHER")" == "0:0:1:555" ]] ||
      fail "HARD_RED:production_launcher_identity_invalid"
    ;;
  linux-x86_64)
    [[ "$(/usr/bin/stat -Lc '%u:%g:%h:%a' "$LAUNCHER")" == "0:0:1:555" ]] ||
      fail "HARD_RED:production_launcher_identity_invalid"
    ;;
esac

# Install receipt must exist and name this exact launcher path.
[[ -f "$RECEIPT" && ! -L "$RECEIPT" ]] ||
  fail "HARD_RED:production_launcher_receipt_missing"
[[ "$(/usr/bin/grep -Fxc 'schema=cheng.csg_core.production_launcher_install' "$RECEIPT")" == 1 ]] ||
  fail "HARD_RED:production_launcher_receipt_invalid"
[[ "$(/usr/bin/grep -Fxc "launcher_path=$LAUNCHER" "$RECEIPT")" == 1 ]] ||
  fail "HARD_RED:production_launcher_receipt_invalid"

exec "$LAUNCHER" "$@"
