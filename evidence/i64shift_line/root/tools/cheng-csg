#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
ROOT=$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)

machine=$(uname -m)
system=$(uname -s)
case "$machine" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x86_64 ;;
  *) echo "error: unsupported host architecture for cheng-csg: $machine" >&2; exit 2 ;;
esac
case "$system" in
  Darwin) host_target="$arch-apple-darwin" ;;
  Linux) host_target="$arch-unknown-linux-gnu" ;;
  *) echo "error: unsupported host system for cheng-csg: $system" >&2; exit 2 ;;
esac

if [ "$#" -lt 1 ]; then
  echo "usage: cheng-csg {lower,prove,migrate} ..." >&2
  exit 2
fi
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "usage: cheng-csg {lower,prove,migrate} ..."
  exit 0
fi

cmd=$1
shift

cache_root=${CHENG_CSG_TOOL_CACHE:-"$ROOT/.tmp-exec/csg-tools"}
bin_dir="$cache_root/$host_target"
bin="$bin_dir/cheng-csg-cli"
report="$bin_dir/cheng-csg-cli.compile.report.txt"
src="$ROOT/src/core/csg_migration/cheng_csg_cli.cheng"
compiler=${CHENG_CSG_COMPILER:-"$ROOT/artifacts/bootstrap/cheng.stage3"}

case "$compiler" in
  /*) ;;
  *) echo "error: CHENG_CSG_COMPILER must be absolute: $compiler" >&2; exit 2 ;;
esac
[ -f "$compiler" ] && [ ! -L "$compiler" ] && [ -x "$compiler" ] || {
  echo "error: Cheng migration compiler is missing or invalid: $compiler" >&2
  exit 2
}

if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
  mkdir -p "$bin_dir"
  "$compiler" system-link-exec \
    "--root:$ROOT" \
    "--in:$src" \
    --emit:exe \
    "--target:$host_target" \
    --runtime-provider-bundle:codex-app-server \
    "--out:$bin" \
    "--report-out:$report" >/dev/null
fi

exec "$bin" "$cmd" --tool-root "$ROOT" --host-target "$host_target" "$@"
