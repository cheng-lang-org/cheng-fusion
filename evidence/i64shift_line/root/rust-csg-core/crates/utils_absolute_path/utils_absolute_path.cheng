# Port of codex-rs/utils/absolute-path normalization logic to Cheng.
# Core path normalization: remove . and .. components, handle root.
# Unix-only (no Windows device path / prefix / verbatim handling).

import std/seqs
import std/strings
import std/strutils as strutil
import std/os

# ------------------------------------------------------------------
# normalize_path(path)  —  remove `.` and `..` components
#
#   ""          → "."
#   "."         → "."
#   ".."        → "."
#   "/"         → "/"
#   "/foo/.."   → "/"
#   "/../foo"   → "/foo"
#   "a/b/../c"  → "a/c"
#   "/a/./b"    → "/a/b"
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathNormalize(path: str): str =
    let isAbsolute = strutil.StartsWith(path, "/")
    let parts = strutil.Split(path, '/')
    var result: str[]

    # Own loop var so we can use `parts.len` inside.
    var idx: int32
    for idx in idx..<parts.len:
        let part = parts[idx]
        if part == "":
            continue
        elif part == ".":
            continue
        elif part == "..":
            if result.len > 0:
                seqs.SetLen(result, result.len - 1)
        else:
            seqs.Add(result, part)

    if result.len == 0:
        if isAbsolute:
            return "/"
        else:
            return "."

    let joined = strutil.Join(result, "/")
    if isAbsolute:
        return strutil.Join(["/", joined], "")
    else:
        return joined


# ------------------------------------------------------------------
# path_with_base(path, base_path)
#
# If path is absolute → return path as-is.
# Otherwise → join base_path / path (normalize will clean later).
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathPathWithBase(path: str, basePath: str): str =
    if strutil.StartsWith(path, "/"):
        return path
    else:
        return strutil.Join([basePath, path], "/")


# ------------------------------------------------------------------
# absolutize_from(path, base_path)
#
# Resolve path against base_path, then normalize.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathAbsolutizeFrom(path: str, basePath: str): str =
    let withBase = RustCsgUtilsAbsolutePathPathWithBase(path, basePath)
    return RustCsgUtilsAbsolutePathNormalize(withBase)


# ------------------------------------------------------------------
# expand_home(path, outExpanded)
#
# Expand `~` or `~/...` to the user's HOME directory.
# `~foo` is NOT expanded (POSIX user-directory shorthand).
# Returns true when expansion happened, false otherwise.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathExpandHome(path: str, outExpanded: var str): bool =
    if strutil.StartsWith(path, "~"):
        let rest = strutil.SliceStr(path, 1, path.len - 1)
        let home = os.GetEnv("HOME")
        if home == "":
            return false
        if rest == "":
            #  "~" alone → home
            outExpanded = home
            return true
        elif strutil.StartsWith(rest, "/"):
            #  "~/..." → home + "/..."
            outExpanded = strutil.Join([home, rest], "")
            return true
    return false


# ------------------------------------------------------------------
# resolve_against_base(path, base_path)
#
# Expand home directory, then absolutize against base.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathResolveAgainstBase(path: str, basePath: str): str =
    var expanded: str
    if RustCsgUtilsAbsolutePathExpandHome(path, expanded):
        return RustCsgUtilsAbsolutePathAbsolutizeFrom(expanded, basePath)
    else:
        return RustCsgUtilsAbsolutePathAbsolutizeFrom(path, basePath)


# ------------------------------------------------------------------
# from_absolute_path(path, cwd)
#
# Make path absolute:
#   1. Expand home directory if present.
#   2. If the result is absolute → normalize it.
#   3. If relative → resolve against the provided cwd.
# ------------------------------------------------------------------
fn RustCsgUtilsAbsolutePathFromAbsolutePath(path: str, cwd: str): str =
    var expanded: str
    let actualPath = RustCsgUtilsAbsolutePathExpandHome(path, expanded) ? expanded : path
    return RustCsgUtilsAbsolutePathAbsolutizeFrom(actualPath, cwd)
