import std/strings
import std/strutils as strutil

fn RustCsgUtilsElapsedFormatDurationMillis(duration_ms: int64): str =
    if duration_ms < 1000:
        return strutil.Join([strings.Int64ToStr(duration_ms), "ms"], "")
    elif duration_ms < 60000:
        let secondsHundredths = float64(duration_ms) * 100.0 / 1000.0
        let hundredths = int64(secondsHundredths + 0.5)
        let whole = hundredths / 100
        let frac = hundredths % 100
        let fracStr = (frac < 10) ? strutil.Join(["0", strings.Int64ToStr(frac)], "")
                                 : strings.Int64ToStr(frac)
        return strutil.Join([strings.Int64ToStr(whole), ".", fracStr, "s"], "")
    else:
        let minutes = duration_ms / 60000
        let seconds = (duration_ms % 60000) / 1000
        let secStr = (seconds < 10) ? strutil.Join(["0", strings.Int64ToStr(seconds)], "")
                                   : strings.Int64ToStr(seconds)
        return strutil.Join([strings.Int64ToStr(minutes), "m ", secStr, "s"], "")

fn format_duration(duration_ms: int64): str =
    return RustCsgUtilsElapsedFormatDurationMillis(duration_ms)
