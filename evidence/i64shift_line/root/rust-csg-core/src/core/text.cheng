import std/strings
import std/strutils as strutil

fn CsgCoreEndsWith(text: str, suffix: str): bool =
    let n = strings.Len(text)
    let m = strings.Len(suffix)
    if m == 0:
        return true
    if n < m:
        return false
    let start = n - m
    return strings.SliceBytes(text, start, m) == suffix

fn CsgCoreContains(text: str, needle: str): bool =
    return strutil.Contains(text, needle)

fn CsgCoreBoolText(value: bool): str =
    return value ? "true" : "false"

fn CsgCoreNormalizeName(raw: str): str =
    let step1 = strutil.Replace(raw, "-", "_")
    return strutil.Replace(step1, "/", "_")

fn CsgCoreInt32Text(value: int32): str =
    return strings.Int64ToStr(int64(value))
