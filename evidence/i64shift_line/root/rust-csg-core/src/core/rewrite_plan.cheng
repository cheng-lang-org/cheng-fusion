import std/strutils as strutil
import cheng/rust-csg-core/core/types
import cheng/rust-csg-core/core/module_map
import cheng/rust-csg-core/core/text

const
    CsgCoreRewriteFactsHeader: str = "RUST_CSG_PROJECT_REWRITE"
    CsgCoreRewriteFactsSchema: str = "project_rewrite"
    CsgCoreRewriteNotReadyStatus: str = "project rewrite is not one-click equivalent yet"

fn CsgCoreRewritePlanValidate(units: var types.CsgCoreMigrationUnit[], expectedCount: int32, outReason: var str): bool =
    outReason = ""
    if units.len != expectedCount:
        outReason = strutil.Join([
            "rewrite_unit_count=",
            text.CsgCoreInt32Text(int32(units.len)),
            " expected=",
            text.CsgCoreInt32Text(expectedCount)
        ], "")
        return false
    for i in 0..<units.len:
        var unit = units[i]
        if !module_map.CsgCoreMigrationUnitOk(unit, outReason):
            outReason = strutil.Join([
                "rewrite_unit[",
                text.CsgCoreInt32Text(int32(i)),
                "] ",
                outReason
            ], "")
            return false
    return true

fn CsgCoreRewritePlanFirstBlocked(units: var types.CsgCoreMigrationUnit[]): str =
    for i in 0..<units.len:
        if units[i].status == module_map.CsgCoreExplicitlyBlocked:
            return strutil.Join([
                units[i].sourcePath,
                ": ",
                units[i].reason
            ], "")
    return ""

fn CsgCoreRewritePlanOneClickReady(units: var types.CsgCoreMigrationUnit[], expectedCount: int32, outReason: var str): bool =
    if !CsgCoreRewritePlanValidate(units, expectedCount, outReason):
        return false
    let firstBlocked = CsgCoreRewritePlanFirstBlocked(units)
    if firstBlocked != "":
        outReason = strutil.Join([CsgCoreRewriteNotReadyStatus, ": ", firstBlocked], "")
        return false
    outReason = ""
    return true

fn CsgCoreRewritePlanStatusCount(units: var types.CsgCoreMigrationUnit[], status: str): int32 =
    var count: int32
    for i in 0..<units.len:
        if units[i].status == status:
            count = count + 1
    return count

fn CsgCoreRewritePlanUnitFact(index: int32, unit: var types.CsgCoreMigrationUnit): str =
    return strutil.Join([
        "unit\t",
        text.CsgCoreInt32Text(index),
        "\t",
        unit.sourcePath,
        "\t",
        unit.chengModule,
        "\t",
        unit.status,
        "\t",
        unit.reason
    ], "")

fn CsgCoreRewritePlanFacts(units: var types.CsgCoreMigrationUnit[], sourceRoot: str): str =
    var out = strutil.Join([
        CsgCoreRewriteFactsHeader,
        "\nschema\t",
        CsgCoreRewriteFactsSchema,
        "\nsource_root\t",
        sourceRoot,
        "\nunit_count\t",
        text.CsgCoreInt32Text(int32(units.len)),
        "\nported_count\t",
        text.CsgCoreInt32Text(CsgCoreRewritePlanStatusCount(units, "ported")),
        "\nblocked_count\t",
        text.CsgCoreInt32Text(CsgCoreRewritePlanStatusCount(units, module_map.CsgCoreExplicitlyBlocked))
    ], "")
    for i in 0..<units.len:
        out = strutil.Join([
            out,
            "\n",
            CsgCoreRewritePlanUnitFact(int32(i), units[i])
        ], "")
    return out
