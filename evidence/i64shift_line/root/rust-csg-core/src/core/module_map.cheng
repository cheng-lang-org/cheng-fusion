import std/strutils as strutil
import cheng/rust-csg-core/core/types
import cheng/rust-csg-core/core/text

const
    CsgCoreExplicitlyBlocked: str = "explicitly_blocked"

fn CsgCoreNormalizeSourceName(sourceName: str): str =
    return text.CsgCoreNormalizeName(sourceName)

fn CsgCoreCargoMemberModule(memberName: str, crateModulePrefix: str): str =
    return strutil.Join([
        crateModulePrefix,
        CsgCoreNormalizeSourceName(memberName)
    ], "")

fn CsgCoreBuildMigrationUnit(
    memberName: str,
    crateModulePrefix: str,
    status: str,
    reason: str
): types.CsgCoreMigrationUnit =
    var out: types.CsgCoreMigrationUnit
    out.sourcePath = memberName
    out.chengModule = CsgCoreCargoMemberModule(memberName, crateModulePrefix)
    out.status = status
    out.reason = reason
    return out

fn CsgCoreMigrationUnitOk(unit: var types.CsgCoreMigrationUnit, outReason: var str): bool =
    outReason = ""
    if unit.sourcePath == "":
        outReason = "empty_source_path"
        return false
    if unit.chengModule == "":
        outReason = "empty_cheng_module"
        return false
    if unit.status != "ported" &&
       unit.status != "non-runtime asset" &&
       unit.status != CsgCoreExplicitlyBlocked:
        outReason = strutil.Join(["invalid_status=", unit.status], "")
        return false
    if unit.status == CsgCoreExplicitlyBlocked && unit.reason == "":
        outReason = "blocked_unit_missing_reason"
        return false
    return true
