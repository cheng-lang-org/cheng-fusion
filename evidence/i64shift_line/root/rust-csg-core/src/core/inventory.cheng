import std/os
import std/strutils as strutil
import cheng/rust-csg-core/core/types
import cheng/rust-csg-core/core/text

fn CsgCorePathUnder(path: str, prefix: str): bool =
    if path == prefix:
        return true
    return strutil.StartsWith(path, strutil.Join([prefix, "/"], ""))

fn CsgCoreSkipVendoredPackageJson(path: str): bool =
    if text.CsgCoreContains(path, "/node_modules/"):
        return true
    if text.CsgCoreContains(path, "/target/"):
        return true
    if text.CsgCoreContains(path, "/.cargo-home/"):
        return true
    if text.CsgCoreContains(path, "/.cargo/"):
        return true
    return false

fn CsgCoreCargoMemberLineName(lineRaw: str): str =
    let line = strutil.Strip(lineRaw)
    if line.len < 2:
        return ""
    if line[0] != '"':
        return ""
    var stop = line.len - 1
    if line[stop] == ',':
        stop = stop - 1
    if stop <= 0 || line[stop] != '"':
        return ""
    return strutil.SliceStr(line, 1, stop - 1)

fn CsgCoreCollectCargoMembers(cargoTomlPath: str): str[] =
    let body = os.ReadFile(cargoTomlPath)
    let lines = strutil.Split(body, '\n')
    var out: str[]
    var inside: bool
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if line == "members = [":
            inside = true
            continue
        if inside && line == "]":
            break
        if inside:
            let name = CsgCoreCargoMemberLineName(line)
            if name != "":
                add(out, name)
    return out

fn CsgCoreStringSeqContainsExact(items: str[], needle: str): bool =
    for i in 0..<items.len:
        if items[i] == needle:
            return true
    return false

fn CsgCoreCollectSourceStats(workspaceDir: str, projectDir: str): types.CsgCoreSourceStats =
    var out: types.CsgCoreSourceStats
    let cargoToml = os.JoinPath(workspaceDir, "Cargo.toml")
    out.cargoMemberCount = int32(CsgCoreCollectCargoMembers(cargoToml).len)
    let workspaceFiles = os.WalkDirRec(workspaceDir)
    for i in 0..<workspaceFiles.len:
        let path = workspaceFiles[i]
        if strutil.Contains(path, "/target/"):
            continue
        if strutil.Contains(path, "/node_modules/"):
            continue
        if strutil.Contains(path, "/.cargo/"):
            continue
        if text.CsgCoreEndsWith(path, ".rs"):
            out.rustSourceFileCount = out.rustSourceFileCount + 1
        elif text.CsgCoreEndsWith(path, ".ts"):
            out.typeScriptFileCount = out.typeScriptFileCount + 1
        elif text.CsgCoreEndsWith(path, ".snap"):
            out.tuiSnapshotCount = out.tuiSnapshotCount + 1
        if CsgCorePathUnder(path, os.JoinPath(workspaceDir, "tui/frames")) &&
           text.CsgCoreEndsWith(path, ".txt"):
            out.tuiFrameCount = out.tuiFrameCount + 1
    let projectFiles = os.WalkDirRec(projectDir)
    for i in 0..<projectFiles.len:
        let path = projectFiles[i]
        if text.CsgCoreEndsWith(path, "package.json") && !CsgCoreSkipVendoredPackageJson(path):
            out.productPackageJsonCount = out.productPackageJsonCount + 1
    return out

fn CsgCoreCargoMembersOk(found: str[], expected: str[], outReason: var str): bool =
    outReason = ""
    if found.len != expected.len:
        outReason = strutil.Join([
            "cargo_member_name_count=",
            text.CsgCoreInt32Text(int32(found.len)),
            " expected=",
            text.CsgCoreInt32Text(int32(expected.len))
        ], "")
        return false
    for i in 0..<found.len:
        for j in i + 1..<found.len:
            if found[i] == found[j]:
                outReason = strutil.Join(["duplicate_cargo_member=", found[i]], "")
                return false
        if found[i] != expected[i]:
            outReason = strutil.Join([
                "cargo_member[",
                text.CsgCoreInt32Text(int32(i)),
                "]=",
                found[i],
                " expected=",
                expected[i]
            ], "")
            return false
        if !CsgCoreStringSeqContainsExact(expected, found[i]):
            outReason = strutil.Join(["unknown_cargo_member=", found[i]], "")
            return false
    return true

fn CsgCoreInventoryOk(
    stats: var types.CsgCoreSourceStats,
    expectations: types.CsgCoreCountExpectations,
    outReason: var str
): bool =
    outReason = ""
    if stats.cargoMemberCount != expectations.cargoMemberCount:
        outReason = strutil.Join(["cargo_member_count=", text.CsgCoreInt32Text(stats.cargoMemberCount)], "")
        return false
    if stats.rustSourceFileCount != expectations.rustSourceFileCount:
        outReason = strutil.Join(["rust_source_file_count=", text.CsgCoreInt32Text(stats.rustSourceFileCount)], "")
        return false
    if stats.typeScriptFileCount != expectations.typeScriptFileCount:
        outReason = strutil.Join(["typescript_file_count=", text.CsgCoreInt32Text(stats.typeScriptFileCount)], "")
        return false
    if stats.tuiSnapshotCount != expectations.tuiSnapshotCount:
        outReason = strutil.Join(["tui_snapshot_count=", text.CsgCoreInt32Text(stats.tuiSnapshotCount)], "")
        return false
    if stats.tuiFrameCount != expectations.tuiFrameCount:
        outReason = strutil.Join(["tui_frame_count=", text.CsgCoreInt32Text(stats.tuiFrameCount)], "")
        return false
    if stats.productPackageJsonCount != expectations.productPackageJsonCount:
        outReason = strutil.Join(["product_package_json_count=", text.CsgCoreInt32Text(stats.productPackageJsonCount)], "")
        return false
    return true

fn CsgCoreStatsText(stats: types.CsgCoreSourceStats): str =
    return Lines([
        strutil.Join(["cargo_members=", text.CsgCoreInt32Text(stats.cargoMemberCount)], ""),
        strutil.Join(["rust_files=", text.CsgCoreInt32Text(stats.rustSourceFileCount)], ""),
        strutil.Join(["typescript_files=", text.CsgCoreInt32Text(stats.typeScriptFileCount)], ""),
        strutil.Join(["tui_snapshots=", text.CsgCoreInt32Text(stats.tuiSnapshotCount)], ""),
        strutil.Join(["tui_frames=", text.CsgCoreInt32Text(stats.tuiFrameCount)], ""),
        strutil.Join(["product_package_json=", text.CsgCoreInt32Text(stats.productPackageJsonCount)], "")
    ])
