module toml_parse_test

import std/result
import std/strutils as strutil
import cheng/core/tooling/toml_parse as toml

fn test(name: str, ok: bool, failures: var int32): bool =
    if !ok:
        failures = failures + 1
    return ok

fn main(): int32 =
    var failures: int32 = 0

    // Test 1: Parse cheng-package.toml format
    let fixture = "[package]\nname = \"myapp\"\nversion = \"0.1.0\"\n\n[dependencies]\nstdlib = \"1.0.0\"\n"
    let root = toml.TomlParse(fixture)

    // Root should be a table
    test("root_is_table", root.kind == toml.TomlTable, failures)

    // Check [package] section exists
    let pkgRes = toml.TomlNodeFindChild(root, "package")
    test("has_package_section", !IsErr(pkgRes), failures)

    if !IsErr(pkgRes):
        let pkg = Value(pkgRes)
        test("package_is_table", pkg.kind == toml.TomlTable, failures)

        // Check package.name
        let nameRes = toml.TomlNodeGetString(pkg, "name")
        test("pkg_name_found", !IsErr(nameRes), failures)
        if !IsErr(nameRes):
            let pkgName = Value(nameRes)
            test("pkg_name_myapp", pkgName == "myapp", failures)

        // Check package.version
        let verRes = toml.TomlNodeGetString(pkg, "version")
        test("pkg_version_found", !IsErr(verRes), failures)
        if !IsErr(verRes):
            let pkgVersion = Value(verRes)
            test("pkg_version_0.1.0", pkgVersion == "0.1.0", failures)

    // Check [dependencies] section exists
    let depsRes = toml.TomlNodeFindChild(root, "dependencies")
    test("has_deps_section", !IsErr(depsRes), failures)

    if !IsErr(depsRes):
        let deps = Value(depsRes)
        // Check dependencies.stdlib
        let stdlibRes = toml.TomlNodeGetString(deps, "stdlib")
        test("stdlib_found", !IsErr(stdlibRes), failures)
        if !IsErr(stdlibRes):
            let stdlibVer = Value(stdlibRes)
            test("stdlib_version_1.0.0", stdlibVer == "1.0.0", failures)

    // Test 2: Integer parsing
    let intFixture = "count = 42\nnegative = -10\npositive = +7\n"
    let intRoot = toml.TomlParse(intFixture)

    let countRes = toml.TomlNodeGetInt(intRoot, "count")
    test("int_count_42", !IsErr(countRes), failures)
    if !IsErr(countRes):
        test("int_count_val", Value(countRes) == 42, failures)

    let negRes = toml.TomlNodeGetInt(intRoot, "negative")
    test("int_neg_10", !IsErr(negRes), failures)
    if !IsErr(negRes):
        test("int_neg_val", Value(negRes) == -10, failures)

    let posRes = toml.TomlNodeGetInt(intRoot, "positive")
    test("int_pos_7", !IsErr(posRes), failures)
    if !IsErr(posRes):
        test("int_pos_val", Value(posRes) == 7, failures)

    // Test 3: Boolean parsing
    let boolFixture = "enabled = true\ndisabled = false\n"
    let boolRoot = toml.TomlParse(boolFixture)

    let enabledRes = toml.TomlNodeGetBool(boolRoot, "enabled")
    test("bool_enabled_found", !IsErr(enabledRes), failures)
    if !IsErr(enabledRes):
        test("bool_enabled_true", Value(enabledRes) == true, failures)

    let disabledRes = toml.TomlNodeGetBool(boolRoot, "disabled")
    test("bool_disabled_found", !IsErr(disabledRes), failures)
    if !IsErr(disabledRes):
        test("bool_disabled_false", Value(disabledRes) == false, failures)

    // Test 4: Array parsing
    let arrFixture = "nums = [1, 2, 3]\nnames = [\"a\", \"b\"]\n"
    let arrRoot = toml.TomlParse(arrFixture)

    let numsRes = toml.TomlNodeFindChild(arrRoot, "nums")
    test("arr_nums_found", !IsErr(numsRes), failures)
    if !IsErr(numsRes):
        let nums = Value(numsRes)
        test("arr_nums_kind", nums.kind == toml.TomlArray, failures)

    let namesRes = toml.TomlNodeFindChild(arrRoot, "names")
    test("arr_names_found", !IsErr(namesRes), failures)
    if !IsErr(namesRes):
        let names = Value(namesRes)
        test("arr_names_kind", names.kind == toml.TomlArray, failures)
        test("arr_names_count", names.childCount == 2, failures)

    // Test 5: Root-level key-value pairs (no section)
    let rootFixture = "key1 = \"hello\"\nkey2 = \"world\"\n"
    let rootParsed = toml.TomlParse(rootFixture)

    let k1Res = toml.TomlNodeFindChild(rootParsed, "key1")
    test("root_kv_key1", !IsErr(k1Res), failures)

    let k2Res = toml.TomlNodeFindChild(rootParsed, "key2")
    test("root_kv_key2", !IsErr(k2Res), failures)

    // Test 6: Comments are ignored
    let commentFixture = "# this is a comment\nkey = \"value\"\n# another comment\n"
    let commentRoot = toml.TomlParse(commentFixture)

    let commentValRes = toml.TomlNodeFindChild(commentRoot, "key")
    test("comment_ignored", !IsErr(commentValRes), failures)

    // Test 7: Empty document produces empty table
    let emptyDoc = ""
    let emptyRoot = toml.TomlParse(emptyDoc)
    test("empty_doc", emptyRoot.childCount == 0, failures)

    // Return results
    if failures > 0:
        return failures
    echo(" toml_parse_test: all tests passed")
    return 0

main()
