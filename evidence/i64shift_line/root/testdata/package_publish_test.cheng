module package_publish_test

import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/world_resolver as wresolver
import cheng/core/tooling/registry as reg
import cheng/core/tooling/cheng_lock as clock

// Test helpers
fn test(name: str, ok: bool, failures: var int32): bool =
    if !ok:
        failures = failures + 1
    return ok

fn main(): int32 =
    var failures: int32 = 0

    // Test setup: temp directories
    let tmpBase = "/tmp/package_publish_test"
    let pkgDir = strutil.Join([tmpBase, "/publish-pkg"], "")
    let regDir = strutil.Join([tmpBase, "/registry"], "")

    // Create package structure
    if !chengpath.PathCreateDirAll(os.JoinPath(pkgDir, "src")):
        return 1

    // Write cheng-package.toml
    var pkgToml = ""
    pkgToml = strutil.Join([pkgToml, "package_id = \"test/publish-pkg\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "version = \"0.2.0\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "module_prefix = \"test\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "channel = \"stable\"\n"], "")
    if !chengpath.WriteTextFile("", os.JoinPath(pkgDir, "cheng-package.toml"), pkgToml):
        return 2

    // Write src/main.cheng
    var mainSrc = ""
    mainSrc = strutil.Join([mainSrc, "module test/publish-pkg\n"], "")
    mainSrc = strutil.Join([mainSrc, "\n"], "")
    mainSrc = strutil.Join([mainSrc, "fn hello(): str =\n"], "")
    mainSrc = strutil.Join([mainSrc, "    return \"hello from published package\"\n"], "")
    if !chengpath.WriteTextFile("", os.JoinPath(os.JoinPath(pkgDir, "src"), "main.cheng"), mainSrc):
        return 3

    // Compute expected receipt CID from source content (before publishing)
    let contentCid = wresolver.WorldResolveContentCid(mainSrc)
    let contentHash = wresolver.WorldResolveContentHash(mainSrc)
    let relPath = "src/main.cheng"
    var snapshotEntries: wresolver.WorldSnapshotEntry[]
    add(snapshotEntries, wresolver.WorldSnapshotEntryMake(relPath, contentCid, contentHash))
    let snapshotCid = wresolver.WorldResolveSnapshotCid(snapshotEntries)
    var worldHeadCid = layout.FixedBytes32()
    var receiptEntries: wresolver.WorldReceiptEntry[]
    add(receiptEntries, wresolver.WorldReceiptEntryMake("test/publish-pkg", "test", "stable", "0.2.0", snapshotCid, ""))
    let expectedReceiptCid = wresolver.WorldResolveReceiptCid(worldHeadCid, snapshotCid, receiptEntries)

    // Create registry directory
    if !chengpath.PathCreateDirAll(regDir):
        return 4

    // Test 1: RegistrySearch on empty registry
    let searchEmptyRes = reg.RegistrySearch(strutil.Join(["file://", regDir], ""), "")
    test("search_empty", !IsErr(searchEmptyRes), failures)
    if !IsErr(searchEmptyRes):
        test("search_empty_count", Value(searchEmptyRes).len == 0, failures)

    // Test 2: RegistryPublishPackage
    let pubVerRes = reg.RegistryPublishPackage(pkgDir, strutil.Join(["file://", regDir], ""))
    test("publish_ok", !IsErr(pubVerRes), failures)
    if !IsErr(pubVerRes):
        test("publish_version", Value(pubVerRes) == "0.2.0", failures)

    // Test 3: RegistrySearch after publish
    let searchRes = reg.RegistrySearch(strutil.Join(["file://", regDir], ""), "")
    test("search_after_publish", !IsErr(searchRes), failures)
    if !IsErr(searchRes):
        let results = Value(searchRes)
        test("search_count", results.len == 1, failures)
        if results.len == 1:
            test("search_result_name", strutil.Contains(results[0], "test/publish-pkg"), failures)
            test("search_result_version", strutil.Contains(results[0], "0.2.0"), failures)

    // Test 4: RegistrySearch with query filter
    let searchQueryRes = reg.RegistrySearch(strutil.Join(["file://", regDir], ""), "publish")
    test("search_query_match", !IsErr(searchQueryRes), failures)
    if !IsErr(searchQueryRes):
        test("search_query_count", Value(searchQueryRes).len == 1, failures)
    let searchNoMatchRes = reg.RegistrySearch(strutil.Join(["file://", regDir], ""), "nonexistent")
    test("search_query_no_match", !IsErr(searchNoMatchRes), failures)
    if !IsErr(searchNoMatchRes):
        test("search_query_zero", Value(searchNoMatchRes).len == 0, failures)

    // Test 5: RegistryFetch back and verify CID
    let fetchRes = reg.RegistryFetch("test/publish-pkg", "0.2.0", strutil.Join(["file://", regDir], ""))
    test("fetch_ok", !IsErr(fetchRes), failures)
    if !IsErr(fetchRes):
        let fetchedReceipt = Value(fetchRes)
        // Verify receipt CID matches expected (deterministic from content)
        let fetchCid = fetchedReceipt.receiptCid
        test("fetch_cid_match", layout.FixedBytes32Equal(fetchCid, expectedReceiptCid), failures)
        // Verify receipt self-validates
        test("fetch_self_verify", wresolver.WorldVerify(fetchedReceipt), failures)
        // Verify entry metadata
        test("fetch_entry_count", fetchedReceipt.entryCount == 1, failures)
        if fetchedReceipt.entryCount > 0:
            test("fetch_entry_id", fetchedReceipt.entries[0].packageId == "test/publish-pkg", failures)
            test("fetch_entry_version", fetchedReceipt.entries[0].version == "0.2.0", failures)

    // Return failure count
    if failures > 0:
        return failures
    return 0

main()
