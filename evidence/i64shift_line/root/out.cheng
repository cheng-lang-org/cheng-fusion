import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_react_runtime as react

fn main(): int32 =
    var runtime: react.ReactRuntime
    react.ReactRuntimeInit(runtime)
    react.ReactRuntimeBeginRender(runtime)

    var __csgElement0: react.ReactElement
    if !react.CreateText(runtime, "", __csgElement0):
        return 1
    var __csgElement1: react.ReactElement
    if !react.CreateText(runtime, "", __csgElement1):
        return 2
    var __csgElement2: react.ReactElement
    if !react.CreateText(runtime, "", __csgElement2):
        return 3
    var __csgElement3Props: react.ReactProp[]
    var __csgElement4Children: react.ReactElement[]
    add(__csgElement4Children, __csgElement0)
    add(__csgElement4Children, __csgElement1)
    add(__csgElement4Children, __csgElement2)
    var __csgElement5: react.ReactElement
    if !react.CreateElement(runtime, "div", __csgElement3Props, __csgElement4Children, __csgElement5):
        return 4

    var document: web.WebDocument
    web.WebDocumentInit(document)
    let documentNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode = 0
    if !react.Reconcile(runtime, document, __csgElement5, rootNode):
        return 5
    if rootNode == 0:
        return 6
    if !web.WebDocumentAppendChild(document, documentNode, rootNode):
        return 7
    echo("csg_web_materializer ok")
    return 0
