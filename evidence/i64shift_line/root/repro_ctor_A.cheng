import std/rawbytes
import std/buffer as bytebuffer

type
    Chunk =
        used: bool
        offset: int64
        data: rawbytes.Bytes

    Stream =
        chunks: Chunk[4]

const N = 4

fn makeChunk(): Chunk =
    var c: Chunk
    c.used = false
    c.offset = 0
    return c

fn initStream(out: var Stream) =
    var i: int32
    i = 0
    while i < N:
        out.chunks[i] = makeChunk()
        i = i + 1

fn main(): int32 =
    var s: Stream
    initStream(s)
    return s.chunks[1].used.int32
