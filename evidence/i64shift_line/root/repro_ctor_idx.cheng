import std/rawbytes
import std/buffer as bytebuffer

type
    Chunk =
        used: bool
        offset: int64
        data: rawbytes.Bytes

    Stream =
        nextOffset: int64
        pendingCount: int32
        chunks: Chunk[4]
        ready: bytebuffer.GrowByteBuffer

const N = 4

fn emptyBytes(): rawbytes.Bytes =
    var b: rawbytes.Bytes
    return b

fn initStream(out: var Stream) =
    out.nextOffset = 0
    out.pendingCount = 0
    out.ready = bytebuffer.NewByteBuffer()
    var i: int32
    i = 0
    while i < N:
        out.chunks[i] = Chunk(used: false, offset: 0, data: emptyBytes())
        i = i + 1

fn main(): int32 =
    var s: Stream
    initStream(s)
    return s.chunks[1].used.int32
